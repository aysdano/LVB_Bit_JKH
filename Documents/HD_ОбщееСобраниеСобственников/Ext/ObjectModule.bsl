//HD+
// Возвращает ФИО представителя собственников в дательном падеже (макет ПФ_MXL_БланкРешения: только параметры *_Дательный в области ОбластьПодвал).
// Исходное значение — как в реквизите документа (именительный / представление); падеж 3 по подсистеме склонения БСП.
// Если склонение недоступно, возвращает исходную строку.
//
Функция ПолучитьПредставителяСобственниковВДательномПадеже(Знач ПредставительСобственников)
	
	ЗначениеСтрокой = ?(ЗначениеЗаполнено(ПредставительСобственников), Строка(ПредставительСобственников), "");
	Если НЕ ЗначениеЗаполнено(ЗначениеСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		РезультатСклонения = СклонениеПредставленийОбъектов.ПросклонятьФИО(ЗначениеСтрокой, 3);
		Если ЗначениеЗаполнено(РезультатСклонения) Тогда
			Возврат СокрЛП(РезультатСклонения);
		КонецЕсли;
	Исключение
		// Если склонение недоступно, используем исходное значение.
	КонецПопытки;
	
	Возврат СокрЛП(ЗначениеСтрокой);
	
