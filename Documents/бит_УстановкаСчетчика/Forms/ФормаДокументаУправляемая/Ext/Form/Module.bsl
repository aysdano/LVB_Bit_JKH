// Процедура - обработчик события "ПередЗаписью" формы.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ЗадатьВопрос = Ложь;
	Текст        = "Конечные показания меньше Начальных. Переход через 0";
	
	Если НЕ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.СнятиеСчетчика Тогда
		
		Если НЕ Объект.Многотарифный Тогда
			
			Если Объект.НачальныеПоказания > Объект.КонечныеПоказания Тогда
				
				ЗадатьВопрос = Истина;
				
			КонецЕсли;
			
		Иначе
			
			Услуги = "";
			
			Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
				
				Если СтрокаТаблицы.НачальныеПоказания > СтрокаТаблицы.КонечныеПоказания Тогда
					
					Услуги = Услуги + " " + СтрокаТаблицы.Услуга;
					ЗадатьВопрос = Истина;
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Текст = "Для услуг: " + Услуги + " " + Текст;
			
		КонецЕсли;
		
		Если ЗадатьВопрос Тогда
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Текст);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика") 
		И Объект.СчетчикСЗависимымиУслугами Тогда
		
		Поиск = Объект.Услуги.НайтиСтроки(Новый Структура("ОсновнаяУслуга", Истина));
		
		Если Поиск.Количество() = 0 Тогда
			
			Отказ = Истина;

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Укажите основную услугу.");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ВыбранноеЗначение = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая" Тогда
		
		Если ИсточникВыбора.СписокЗданий.Количество() > 0 Тогда
			
			ОбработатьВыбранныеЗначения(ВыбранноеЗначение);
		Иначе
			
			ОбработатьВыбранныеЗначенияУслуга(ВыбранноеЗначение);
			
		КонецЕсли;
		
	КонецЕсли;
	РазвернутьВсеУровни();
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

// Процедура - обработчик события "Нажатие" кнопки "Подбор".
//
&НаКлиенте
Процедура Подбор(Команда)
	
	// БИТ_ЖКХ 03.10.2014
	Объект.ПодборРазныеЗдания = Ложь;
	Элементы.ПодборРазныеЗдания.Видимость = Ложь;
	// БИТ_ЖКХ 03.10.2014
	
	Если Объект.Проведен Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ проведен. Изменения невозможны!");
			
	ИначеЕсли Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.СнятиеСчетчика Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("При снятии счетчика изменения невозможны!");
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация"       , Объект.Организация);
		ПараметрыФормы.Вставить("Дата"              , Объект.Дата);
		ПараметрыФормы.Вставить("ОткрытоИзДокумента", Истина);
		
		СписокУслуг = Новый СписокЗначений;
		
		Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
		
		Для каждого СтрокаТаблицы Из Корень Цикл
			Если СписокУслуг.НайтиПоЗначению(СтрокаТаблицы.Услуга) = Неопределено Тогда
				СписокУслуг.Добавить(СтрокаТаблицы.Услуга);
			КонецЕсли; 
		КонецЦикла; 
		
		ПараметрыФормы.Вставить("СписокУслуг", СписокУслуг);
		
		ТекСтрока = Элементы.ДеревоОбъектовУчета.ТекущиеДанные;
		
		Если ТекСтрока = Неопределено Тогда
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Укажите строку содержащую здание для подбора лицевых счетов.");
			
			Возврат;
			
		КонецЕсли; 
		
		Здание    = ТекСтрока.Здание;
		
		ПараметрыФормы.Вставить("Здание", Здание);
		
		// БИТ_ЖКХ 10.09.2014
		Улица = УлицаНаСервере(Здание);
		// ПараметрыФормы.Вставить("Улица" , Здание.Улица);.
		ПараметрыФормы.Вставить("Улица" , Улица);
		
		СписокУлиц   = Новый СписокЗначений;
		СписокЗданий = Новый СписокЗначений;
		
		Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
		
		Для каждого СтрокаДерева Из Корень Цикл
			
			СписокЗданий.Добавить(СтрокаДерева.Здание);
			
			Улица = УлицаНаСервере(СтрокаДерева.Здание);
			// СписокУлиц.Добавить(СтрокаДерева.Здание.Улица);.
			СписокУлиц.Добавить(Улица);
			// БИТ_ЖКХ 10.09.2014
			
		КонецЦикла;
		
		ПараметрыФормы.Вставить("СписокЗданий", СписокЗданий);
		ПараметрыФормы.Вставить("СписокУлиц"  , СписокУлиц);
		
		Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
			ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик // БИТ_ЖКХ 02.12.2015 17:39:44 
			ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьЛицевыеСчетаСоСчетчика
			ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик 
			ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьУслугиСоСчетчика Тогда
			
			ПараметрыФормы.Вставить("СписокЛС"  , мКэшЗначений.СписокЛС);
			ПараметрыФормы.Вставить("ВСписке "  , (НЕ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
													И НЕ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик)); // БИТ_ЖКХ 03.12.2015 13:17:27 
			
		КонецЕсли; 
		
		ОткрытьФорму("Обработка.бит_ПодборЛицевыхСчетов.Форма", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция УлицаНаСервере(Здание)
	
	Возврат Здание.Улица;
	
КонецФункции	

