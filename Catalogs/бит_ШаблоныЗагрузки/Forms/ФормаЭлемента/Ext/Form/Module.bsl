&НаКлиенте
Процедура ПоляЗагрузкиНомерПозицииПриИзменении(Элемент)

	// Проверка повторного выбора.
	НомерПозиции =  Элементы.ПоляЗагрузки.ТекущиеДанные.НомерПозиции;
	Если Объект.ПоляЗагрузки.НайтиСтроки(Новый Структура("НомерПозиции", НомерПозиции)).Количество() > 1 Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Выбранный номер позиции ""%1"" уже настроен для другого поля!'"),
																				НомерПозиции);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Элементы.ПоляЗагрузки.ТекущиеДанные.НомерПозиции = 0;	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПоляЗагрузкиПолеОплатыКУОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	// Проверка повторного выбора.
	Если Объект.ПоляЗагрузки.НайтиСтроки(Новый Структура("ПолеОплатыКУ", ВыбранноеЗначение)).Количество() > 0 Тогда
		СтандартнаяОбработка = Ложь;
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'Выбранное значение ""%1"" уже используется!'"),
																				ВыбранноеЗначение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти
