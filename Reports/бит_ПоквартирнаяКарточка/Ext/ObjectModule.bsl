	//КонецЦикла;   
	//
	//ТЗ_Наниматели.Свернуть("ФизЛицо, ДатаРождения, СтатусФизЛица, РодственнаяСвязь, СтатусПроживания, ДатаРегистрации, ДатаСнятияРУ, ФИО, ДоляПлощади, ДоляПлощадиСтрокой");
	
	//Удаление проживающих если стоит галка Проживающие только на данный момент
	МассивСтрокДляУдаления = Новый Массив;
	
