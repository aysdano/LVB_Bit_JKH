	|					ИЛИ ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель))) КАК ОтветственныеЛицаОрганизацийСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОбластьПодвал.Параметры.Заполнить(Выборка);
		
	КонецЕсли; 
	
	ОбластьПодвал.Параметры.СуммаИтогоПрописью = ЧислоПрописью(СуммаОтчета,"Л = ru_RU","рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2");
	ДокументРезультат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

// Функция получает общую площадь.
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//  <Параметр2>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//
// Возвращаемое значение:
//   <Тип.Вид>   - <описание возвращаемого значения>.
//
Функция ПолучитьОбщуюПлощадь(Квартира)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_СведенияОКвартиреСрезПоследних.Квартира,
	|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь, 0) КАК ОбщаяПлощадь
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&КонецПериода, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(КонецПериода));
	Запрос.УстановитьПараметр("Квартира"    , Квартира);
	
	Если Запрос.Выполнить().Пустой() Тогда
		
		Возврат 0;
	Иначе
		Результат = ЗАпрос.Выполнить().Выгрузить();
		Возврат ?(Результат[0].ОбщаяПлощадь = 0, 0, Результат[0].ОбщаяПлощадь);
	КонецЕсли; 
	
	
КонецФункции // ()

