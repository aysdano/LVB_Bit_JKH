			ДанныеПечати.ВидДокументаПред          = ВРег(Строка(Источник.ВидДокументаПред));
		КонецЕсли;
	КонецЕсли;
	
	ДанныеПечати.СерияДокументаПред        = ВРег(Строка(Источник.СерияДокументаПред));
	ДанныеПечати.НомерДокументаПред        = ВРег(Строка(Источник.НомерДокументаПред));
	ДанныеПечати.ВыданДокументПред         = ВРег(Строка(Источник.ВыданДокументПред));
	ДанныеПечати.Фамилия                   = ВРег(Источник.Фамилия);
	ДанныеПечати.Имя                       = ВРег(Источник.Имя);
	ДанныеПечати.Отчество                  = ВРег(Источник.Отчество);
	
	Если Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаФамилии Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 2
		|	бит_ФИОПроживающих.Период КАК Период,
		|	бит_ФИОПроживающих.ФизЛицо,
		|	бит_ФИОПроживающих.Фамилия,
		|	бит_ФИОПроживающих.Имя,
