				Квитанция.Присоединить(ИнфОПлатежеПустаяСтрока);
				
			КонецЕсли;
			
			СчетчикСтрокУс = СчетчикСтрокУс + 1;
			
		КонецЦикла;
	КонецЕсли;
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		
		Квитанция.Вывести(ЛеваяЧастьПустаяСтрока);
		
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "ПроцентОтОплаты", мСтруктураДанных.ПроцентОтОплаты);
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "Процент"        , Процент);
		
		Квитанция.Присоединить(ОбластьКассовыйСбор);
		
		Если КоличествоСтрокУс < 13 Тогда
			
			СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
			Квитанция.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
			
			СчетчикСтрокУс = СчетчикСтрокУс + 1;
			
		Иначе
			
			Квитанция.Присоединить(ИнфОПлатежеПустаяСтрока);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если СчетчикСтрокУс < 13 Тогда
		
		Квитанция.Вывести(ЛеваяЧастьПустаяСтрока);
		
		ТаблицаУслугИтого.Параметры.Заполнить(мСтруктураДанных);
		Квитанция.Присоединить(ТаблицаУслугИтого);
		
		СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
		Квитанция.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
		
		СчетчикСтрокУс = СчетчикСтрокУс + 1;
		
		Для Значение = СчетчикСтрокУс По 13  Цикл
			
			Квитанция.Вывести(ЛеваяЧастьПустаяСтрока);
			Квитанция.Присоединить(ТаблицаУслугПустаяСтрока);
			
			СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
			Квитанция.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
			
			СчетчикСтрокУс = СчетчикСтрокУс + 1;
			
		КонецЦикла;
		
		ЛеваяЧастьПодвал.Параметры.Заполнить(мСтруктураДанных);
		Квитанция.Вывести(ЛеваяЧастьПодвал);
		Квитанция.Присоединить(ТаблицаУслугПодвал);
		Квитанция.Присоединить(ИнфОПлатежеПодвал);
		
	Иначе
		
		Если СчетчикСтрокУс = 13 Тогда
			
			Квитанция.Вывести(ЛеваяЧастьПустаяСтрока);
			
			ТаблицаУслугИтого.Параметры.Заполнить(мСтруктураДанных);
			Квитанция.Присоединить(ТаблицаУслугИтого);
			
			СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
			Квитанция.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
			
			ЛеваяЧастьПодвал.Параметры.Заполнить(мСтруктураДанных);
			Квитанция.Вывести(ЛеваяЧастьПодвал);
			Квитанция.Присоединить(ТаблицаУслугПодвал);
			Квитанция.Присоединить(ИнфОПлатежеПодвал);
			
		Иначе
			
			ЛеваяЧастьПодвал.Параметры.Заполнить(мСтруктураДанных);
			Квитанция.Вывести(ЛеваяЧастьПодвал);
			
			ТаблицаУслугИтого.Параметры.Заполнить(мСтруктураДанных);
			Квитанция.Присоединить(ТаблицаУслугИтого);
			
			Квитанция.Присоединить(ИнфОПлатежеПодвал);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Обращение) Тогда
		
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли; 
	
	
	Квитанция.Вывести(Разделитель);
	
	Если ИспользоватьQR = Истина Тогда
		
		//Попытка	
		//	ОбластьШтрихкодQR                   = мМакет.ПолучитьОбласть("ШтрихкодQR");
		//Исключение
		//КонецПопытки;
		
        НапечататьQRКод(Квитанция);
	Иначе
		УбратьQRКод(Квитанция)
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Счет - извещение №6.
//
Функция ПечатьСчетИзвещение6() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьПолучатель       = мМакет.ПолучитьОбласть("Получатель");
	ОбластьПлательщик       = мМакет.ПолучитьОбласть("Плательщик");
	ОбластьШтрихКод         = мМакет.ПолучитьОбласть("ШтрихКод");
	ОбластьПлательщикПодвал = мМакет.ПолучитьОбласть("ПлательщикПодвал");
	
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого"); 
	СтрокаПриборовУчета = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ШапкаПриборыУчета   = мМакет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	ОбластьКассовыйСбор     = мМакет.ПолучитьОбласть("КассовыйСбор");
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате + мСтруктураДанных.ПроцентОтОплаты;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	СчВывода = ?(мТаблицаПечатиСчетчиков.Количество() > 0, 4, 5);
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
		
		Квитанция.Вывести(ОбластьПолучатель);
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШтрихКод.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
			Квитанция.Вывести(ОбластьШтрихКод);
		Иначе
			ОбластьШапка.Рисунки.очистить();
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьПлательщик);
		
		Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
			СчВывода = 4;
		КонецЕсли;
		
		Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
			
			Если СчВывода = 0 Тогда
				Прервать;
			КонецЕсли; 
			
			СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(ОбластьПлательщик, "Услуга", СтрокаТаблицы.СокрНаименование);
			Квитанция.Вывести(СтрокаПриборовУчета);
			
			СчВывода = СчВывода - 1;
			
		КонецЦикла; 
		
		Пока НЕ СчВывода = 0 Цикл
			
			Квитанция.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
			
		КонецЦикла;
		
		Квитанция.Вывести(ОбластьПлательщикПодвал);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьШапка);
	
	Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
		Квитанция.Вывести(ШапкаПриборыУчета);
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
		
		СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
		ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);
		Квитанция.Вывести(СтрокаПриборовУчета);
		
		СчВывода = СчВывода - 1;
		
	КонецЦикла;
	
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
		
		Если НеПечататьУслугиБезНачислений(СтрокаТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
		Квитанция.Вывести(СтрокаРасшифровки);
		
	КонецЦикла; 
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		
		// Вывод информации о кассовом сборе.
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "ПроцентОтОплаты", мСтруктураДанных.ПроцентОтОплаты);
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "Процент", Процент);
		
		Если мСтруктураДанных.КОплатеЗаМесяц = мСтруктураДанных.КОплате Тогда
			мСтруктураДанных.КОплатеЗаМесяц = мСтруктураДанных.КОплатеЗаМесяц + мСтруктураДанных.ПроцентОтОплаты;
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьКассовыйСбор);
		
	КонецЕсли;
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьИтого);
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли; 
	
	Возврат Квитанция;
	
КонецФункции

Функция ПечатьСчетИзвещениеРСК() Экспорт
	
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого"); 
	СтрокаПриборовУчета = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ШапкаПриборыУчета   = мМакет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	ЗаполнитьПараметр(ОбластьШапка, "Сальдо", мСтруктураДанных.Сальдо);
	ЗаполнитьПараметр(ОбластьШапка, "ИтогоКОплатеСУчетомПредоплаты", мСтруктураДанных.Сальдо + мСтруктураДанных.Начислено - мСтруктураДанных.Оплата);
	ЗаполнитьПараметр(ОбластьШапка, "ИтогоКОплатеСУчетомПени", мСтруктураДанных.Сальдо + мСтруктураДанных.Начислено + мСтруктураДанных.ИтогПени - мСтруктураДанных.Оплата);
	
	Квитанция.Вывести(ОбластьШапка);
	
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
		
		СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
		
		ЗаполнитьПараметр(СтрокаРасшифровки, "ЕдИзм", Строка(СтрокаТаблицы.количество)+" "+Строка(СтрокаТаблицы.ЕдИзм));
		
		тмпРазовые = 0;
		тмпВозврат = 0;
		
		Если СтрокаТаблицы.Разовые > 0 Тогда
			тмпРазовые = СтрокаТаблицы.Разовые;
			ЗаполнитьПараметр(СтрокаРасшифровки, "Разовые", тмпРазовые);
		ИначеЕсли СтрокаТаблицы.Разовые < 0 Тогда
			тмпВозврат = СтрокаТаблицы.Разовые;
			ЗаполнитьПараметр(СтрокаРасшифровки, "Разовые", 0);
			ЗаполнитьПараметр(СтрокаРасшифровки, "Возврат", тмпВозврат);
		Иначе
			ЗаполнитьПараметр(СтрокаРасшифровки, "Разовые", 0);
			ЗаполнитьПараметр(СтрокаРасшифровки, "Возврат", 0);
		КонецЕсли;
		
		Если СтрокаТаблицы.НачисленоОбщДом > 0 Тогда
			
			тмпРазовые = тмпРазовые + СтрокаТаблицы.НачисленоОбщДом;
			ЗаполнитьПараметр(СтрокаРасшифровки, "Разовые", тмпРазовые);
			мСтруктураДанных.Разовые             = мСтруктураДанных.Разовые + СтрокаТаблицы.НачисленоОбщДом;
			
		ИначеЕсли СтрокаТаблицы.НачисленоОбщДом < 0 Тогда
			
			тмпВозврат = тмпВозврат + СтрокаТаблицы.НачисленоОбщДом;
			ЗаполнитьПараметр(СтрокаРасшифровки, "Разовые", тмпВозврат);
			мСтруктураДанных.Разовые = мСтруктураДанных.Разовые + СтрокаТаблицы.НачисленоОбщДом;
			
		КонецЕсли;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Услуга", СтрокаТаблицы.Услуга);
		Посик = мТаблицаПечатиСчетчиков.НайтиСтроки(Отбор);
		
		Если Посик.количество() = 1 Тогда
			
			ЗаполнитьПараметр(СтрокаРасшифровки, "Нач", Посик[0].ОтПоказаний);
			ЗаполнитьПараметр(СтрокаРасшифровки, "Кон", Посик[0].ДоПоказаний);
			
			Квитанция.Вывести(СтрокаРасшифровки);
			
		ИначеЕсли Посик.количество() > 1 Тогда
			
			Для ЭлемМасс = 0 ПО Посик.количество() - 1 Цикл
				
				Если ЭлемМасс = 0 Тогда
					
					ЗаполнитьПараметр(СтрокаРасшифровки, "Нач", Посик[ЭлемМасс].ОтПоказаний);
					ЗаполнитьПараметр(СтрокаРасшифровки, "Кон", Посик[ЭлемМасс].ДоПоказаний);
					Квитанция.Вывести(СтрокаРасшифровки);
					
				Иначе
					
					ЗаполнитьПараметр(СтрокаРасшифровки, "Нач", Посик[ЭлемМасс].ОтПоказаний);
					ЗаполнитьПараметр(СтрокаРасшифровки, "Кон", Посик[ЭлемМасс].ДоПоказаний);
					
					ЗаполнитьПараметр(СтрокаРасшифровки, "Разовые", 0);
					ЗаполнитьПараметр(СтрокаРасшифровки, "Возврат", 0);
					ЗаполнитьПараметр(СтрокаРасшифровки, "ЕдИзм", 0);
					ЗаполнитьПараметр(СтрокаРасшифровки, "Норматив", 0);
					ЗаполнитьПараметр(СтрокаРасшифровки, "НастройкаСтавки", 0);
					ЗаполнитьПараметр(СтрокаРасшифровки, "Начислено", 0);
					
					Квитанция.Вывести(СтрокаРасшифровки);
					
				КонецЕсли;
				
			КонецЦикла;
			
		Иначе 
			
			ЗаполнитьПараметр(СтрокаРасшифровки, "Нач", 0);
			ЗаполнитьПараметр(СтрокаРасшифровки, "Кон", 0);
			Квитанция.Вывести(СтрокаРасшифровки);
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	
	Если мСтруктураДанных.Разовые > 0 Тогда
		ЗаполнитьПараметр(ОбластьИтого, "Разовые", мСтруктураДанных.Разовые);
	ИначеЕсли мСтруктураДанных.Разовые < 0 Тогда
		ЗаполнитьПараметр(ОбластьИтого, "Разовые", 0);
		ЗаполнитьПараметр(ОбластьИтого, "Возврат", мСтруктураДанных.Разовые);
	Иначе
		ЗаполнитьПараметр(ОбластьИтого, "Разовые", 0);
		ЗаполнитьПараметр(ОбластьИтого, "Возврат", 0);
	КонецЕсли;
	
	Квитанция.Вывести(ОбластьИтого);
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли; 
	
	Если ИспользоватьQR = Истина Тогда
		
		Попытка	
			ОбластьШтрихкодQR                   = мМакет.ПолучитьОбласть("ШтрихкодQR");
		Исключение
		КонецПопытки;
		
		НапечататьQRКод(Квитанция, ОбластьШтрихкодQR);
	Иначе
		УбратьQRКод(Квитанция)
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Платежный документ РК 354.
//
Функция ПечатьПлатежныйДокумент() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьЗаголовок = мМакет.ПолучитьОбласть("Заголовок");
	ОбластьШапка     = мМакет.ПолучитьОбласть("Шапка");
	ОбластьСтрока    = мМакет.ПолучитьОбласть("Строка");
	ОбластьИтог      = мМакет.ПолучитьОбласть("Итого");
	ОбластьУказания  = мМакет.ПолучитьОбласть("Указания");
	
	ОбластьПустаяСтрока  = мМакет.ПолучитьОбласть("ПустаяСтрока");
	
	ОбластьРаздел5Заголовок  = мМакет.ПолучитьОбласть("Раздел5Заголовок");
	ОбластьРаздел5Шапка      = мМакет.ПолучитьОбласть("Раздел5Шапка");
	ОбластьРаздел5НомКолонок = мМакет.ПолучитьОбласть("Раздел5НомКолонок");
	ОбластьРаздел5Строка     = мМакет.ПолучитьОбласть("Раздел5Строка");
	
	ОбластьРаздел6Шапка    = мМакет.ПолучитьОбласть("Раздел6Шапка");
	ОбластьРаздел6Строка   = мМакет.ПолучитьОбласть("Раздел6Строка");
	ОбластьРаздел6Итого    = мМакет.ПолучитьОбласть("Раздел6Итого");
	
	Попытка
		
		ОбластьСправочнаяИнформацияСтрока    = мМакет.ПолучитьОбласть("СправочнаяИнформацияСтрока");
		
	Исключение
		
	КонецПопытки;
	
	мСтруктураДанных.ПереплатаНаНачало = мСтруктураДанных.ПереплатаНаНачало + мСтруктураДанных.Оплата;
	
	Квитанция.Вывести(ОбластьЗаголовок);
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	ОбластьШапка.Параметры.Заполнить(мКэшПолучателяПлатежа);
	
	//14.12.2018
	ОбластьШапка.Параметры.ПолучательКоррСчет = мКэшПолучателяПлатежа.ПолучательКоррСчетБИК;

	Организация_1 = "";
	Организация_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательПредставление, 59, Организация_1 , Организация_2 );
	
	ЗаполнитьПараметр(ОбластьШапка, "Организация_1", Организация_1);
	ЗаполнитьПараметр(ОбластьШапка, "Организация_2", Организация_2);
	
	АдресОрганизация_1 = "";
	АдресОрганизация_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательАдрес, 65, АдресОрганизация_1 , АдресОрганизация_2 );
	
	ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизация_1", АдресОрганизация_1);
	ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизация_2", АдресОрганизация_2);
	
	ДопИнформацияОрганизация_1 = "";
	ДопИнформацияОрганизация_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательДопИнформация, 20, ДопИнформацияОрганизация_1 , ДопИнформацияОрганизация_2);
	
	ЗаполнитьПараметр(ОбластьШапка, "ДопИнформацияОрганизация_1", ДопИнформацияОрганизация_1);
	ЗаполнитьПараметр(ОбластьШапка, "ДопИнформацияОрганизация_2", ДопИнформацияОрганизация_2);
	
	Квитанция.Вывести(ОбластьШапка);
	
	Для каждого СтрокаПечати Из мТаблицаПечати Цикл
		
		Если НеПечататьУслугиБезНачислений(СтрокаПечати) Тогда 
			Продолжить;
		КонецЕсли;
		ОбластьСтрока.Параметры.Заполнить(СтрокаПечати);
		Квитанция.Вывести(ОбластьСтрока);
		
	КонецЦикла; 
	
	ОбластьИтог.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьИтог);
	
	Квитанция.Вывести(ОбластьУказания);
	
	Если мТаблицаПерерасчетов.Количество() > 0 Тогда
		
		Квитанция.Вывести(ОбластьПустаяСтрока);
		Квитанция.Вывести(ОбластьРаздел5Заголовок);
		Квитанция.Вывести(ОбластьРаздел5Шапка);
		Квитанция.Вывести(ОбластьРаздел5НомКолонок);
		
		Для каждого СтрокаСведений Из мТаблицаПерерасчетов Цикл
			
			ОбластьРаздел5Строка.Параметры.Заполнить(СтрокаСведений);
			Если ИспользоватьКомментарийКакОснование Тогда
				ОбластьРаздел5Строка.Параметры.Основание = СтрокаСведений.Комментарий;
			КонецЕсли; 
			Квитанция.Вывести(ОбластьРаздел5Строка);
			
		КонецЦикла;
		
	КонецЕсли;
	
	Попытка
		
		Для каждого строка из мТаблицаПечати Цикл
			
			Если строка.ИтогоОбъемОбщедомовых <> 0  Тогда
				ОбластьСправочнаяИнформацияСтрока.Параметры.Услуга = строка.Услуга;
				
				ОбластьСправочнаяИнформацияСтрока.Параметры.ЕдИзм = строка.ЕдИзм;
				
				ОбластьСправочнаяИнформацияСтрока.Параметры.ИтогоОбъемИндИПУ = строка.ИтогоОбъемИндИПУ;
				ОбластьСправочнаяИнформацияСтрока.Параметры.ИтогоОбъемИндНорматив = строка.ИтогоОбъемИндНорматив;
				ОбластьСправочнаяИнформацияСтрока.Параметры.ДоПоказаний = 0;
				
				Запрос = Новый Запрос;
				Запрос.УстановитьПараметр("Дата"   ,КонецДня(Период));
				
				Запрос.УстановитьПараметр("Здание",мСтруктураДанных.ЛицевойСчет.Здание);
				Запрос.УстановитьПараметр("Услуга", строка.Услуга);
				Запрос.УстановитьПараметр("Групповой", ПредопределенноеЗначение("Перечисление.бит_ТипСчетчика.Групповой"));
				
