Процедура ПолучитьДанныеДляПечати(СсылкаДокумент)	
	
	Если ТипЗнч(СсылкаДокумент) = Тип("ДанныеФормыЭлементКоллекции") Тогда
		СтрокаТаблицы = СсылкаДокумент;
		
	    если ТипЗнч(СсылкаДокумент.Документ) <> Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда	
		 ФормаДок = ПолучитьФорму("Документ."+СтрокаТаблицы.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",СтрокаТаблицы.Документ));
	    иначе 
		 ФормаДок = ПолучитьФорму("Документ."+СтрокаТаблицы.ИмяДок+".Форма.ФормаДокументаОбщая",Новый Структура("Ключ",СтрокаТаблицы.Документ));
		конецесли; 
		
		//25.09.2019
		//если ТипЗнч(СсылкаДокумент.Документ) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") тогда 
		// ФормаДок = ПолучитьФорму("Документ."+СтрокаТаблицы.ИмяДок+".Форма.ФормаДокументаОднострочная",Новый Структура("Ключ",СтрокаТаблицы.Документ));
		//иначе
		// ФормаДок = ПолучитьФорму("Документ."+СтрокаТаблицы.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",СтрокаТаблицы.Документ));
		//конецесли;  	
		
		ПолучитьПараметры(ФормаДок);
		
		СтрокаТаблицы.ПараметрыДокумента = ПараметрСтроки;
		
		ПараметрСтроки = Неопределено;			
	Иначе
		
		Для каждого стр	из Объект.Документы.НайтиСтроки(Новый Структура("Документ",СсылкаДокумент)) Цикл 
			
			ФормаДок = ПолучитьФорму("Документ."+стр.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",стр.Документ));
			
			ПолучитьПараметры(ФормаДок);
			
			стр.ПараметрыДокумента = ПараметрСтроки;
			
			ПараметрСтроки = Неопределено;		
			
		КонецЦикла;
		
	КонецЕсли;

