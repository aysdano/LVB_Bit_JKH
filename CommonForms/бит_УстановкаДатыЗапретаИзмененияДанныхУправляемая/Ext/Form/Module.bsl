&НаКлиенте
Процедура УдалитьСтроку(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоДаты.ТекущаяСтрока;
	
	Если ТекущаяСтрока = Неопределено тогда
		Возврат;
	КонецЕсли;	
	
	Если НЕ ТекущаяСтрока.ПравоНаИзменение тогда
		СтрокаОрганизации = ?(ТекущаяСтрока.Уровень() = 0, ТекущаяСтрока, ТекущаяСтрока.Родитель);

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("У Вас нет права на удаление данных по организации " + СокрЛП(СтрокаОрганизации.ОрганизацияПользователь.Наименование));
		
		Возврат;
	КонецЕсли;	                           
	
	Если ТекущаяСтрока.Уровень() = 0 Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Удаление организации невозможно. Вы можете удалить пользователя или группу пользователей.");
		
		Возврат;        
	КонецЕсли;
	
	ТекущаяСтрока.Родитель.Строки.Удалить(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОК(Команда)
	
	Отказ = Ложь;
	СохранитьДанные(Отказ);
	Если Не Отказ Тогда
		Закрыть();
	КонецЕсли;
	
КонецПроцедуры

