Функция СписокРегистраторов(СписокЛС)
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("СписокЛС",СписокЛС);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_РегистрацияПроживающихПоЛС.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ Регистраторы
		|ИЗ
		|	Документ.бит_РегистрацияПроживающихПоЛС КАК бит_РегистрацияПроживающихПоЛС
		|ГДЕ
		|	бит_РегистрацияПроживающихПоЛС.ЛицевойСчет В(&СписокЛС)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	бит_СвидетельствоОРегистрацииПоМестуПребывания.Ссылка
		|ИЗ
		|	Документ.бит_СвидетельствоОРегистрацииПоМестуПребывания КАК бит_СвидетельствоОРегистрацииПоМестуПребывания
		|ГДЕ
		|	бит_СвидетельствоОРегистрацииПоМестуПребывания.ЛицевойСчет В(&СписокЛС)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	бит_СвидетельствоОРегистрацииПоМестуПроживания.Ссылка
		|ИЗ
		|	Документ.бит_СвидетельствоОРегистрацииПоМестуПроживания КАК бит_СвидетельствоОРегистрацииПоМестуПроживания
		|ГДЕ
		|	бит_СвидетельствоОРегистрацииПоМестуПроживания.ЛицевойСчет В(&СписокЛС)
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	бит_ПроживающиеПоЛС.Регистратор
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
		|ГДЕ
		|	бит_ПроживающиеПоЛС.Регистратор ССЫЛКА Документ.ОперацияБух
		|	И бит_ПроживающиеПоЛС.ЛицевойСчет В(&СписокЛС)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Регистраторы.Ссылка КАК Ссылка
		|ИЗ
		|	Регистраторы КАК Регистраторы
		|
		|СГРУППИРОВАТЬ ПО
		|	Регистраторы.Ссылка";
	СписокДокументов = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	возврат СписокДокументов;
	
КонецФункции	


