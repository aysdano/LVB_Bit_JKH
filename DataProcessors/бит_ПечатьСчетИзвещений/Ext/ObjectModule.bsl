// Устаревшая функция. Присутствует в пользовательских макетах.
// Процедуры печати QR штрихкода.
Процедура НапечататьQRШтрихкод(ОбластьШтрихкодQR, Результат)
	
	НапечататьQRКод(Результат, ОбластьШтрихкодQR);
	
КонецПроцедуры


Процедура УбратьQRКод(ТабДок)
	
	РисункиQR = Новый Массив;
	Для Каждого Рис Из ТабДок.Рисунки Цикл
		Если НЕ СтрНайти(НРег(Рис.Имя), "qrкод") = 0 Тогда
			РисункиQR.Добавить(Рис);
		КонецЕсли;
	КонецЦикла;
	Если РисункиQR.Количество() > 0 Тогда
		Для Каждого РисQR Из РисункиQR Цикл
			ТабДок.Рисунки.Удалить(РисQR);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Функция НеПечататьУслугиБезНачислений(СтрПечати) 
	
	Если НеПечататьУслугиБезНачислений
		И СтрПечати.НачисленоИНД = 0
		И СтрПечати.НачисленоОбщДом = 0
		И СтрПечати.Начислено = 0
		И СтрПечати.Разовые = 0
		И СтрПечати.Льгота = 0 
		И (СтрПечати.Оплата = 0 ИЛИ НЕ ПечататьУслугиСОплатой) Тогда
		
		Возврат Истина;	
	КонецЕсли;

	Возврат Ложь;
	
КонецФункции

Функция РазбитьСтроку(Строка, МаксДлина, ИмяСтр1, ИмяСтр2)
	
	ДлинаСтроки = СтрДлина(Строка);
	Если ДлинаСтроки < МаксДлина Тогда
		
		Стр_1 = Строка;
		Стр_2 = "";
		
	Иначе
		// Разбиваем строку на две подстроки, таким образом чтобы первая строка была не более Длина символов
		// Для этого ищем очередной пробел и проверяем длину строк в предположении, что перенос будет выполнен по найденной позиции.
		Стр_2 = Строка;
		ПозицияПоиска = СтрНайти(Стр_2," ")+1;
		
		// Если найден очередной пробел и длина первой строки после операции будет менее Длина символов, то выполняем еще одну итерацию.
		Пока ПозицияПоиска > 1 И ДлинаСтроки - СтрДлина(Стр_2) + ПозицияПоиска < МаксДлина Цикл
			
			Стр_2 = Сред(Стр_2, ПозицияПоиска);
			ПозицияПоиска       = СтрНайти(Стр_2," ")+1;
			
		КонецЦикла; 
		
		Стр_1 = Лев(Строка,ДлинаСтроки - СтрДлина(Стр_2));
		
	КонецЕсли; 
	
	СтруктураАдресаПолучателя = Новый Структура;
	СтруктураАдресаПолучателя.Вставить(ИмяСтр1, Стр_1);
	СтруктураАдресаПолучателя.Вставить(ИмяСтр2, Стр_2);
	
	Возврат СтруктураАдресаПолучателя;
	
КонецФункции

#КонецОбласти

#КонецЕсли
