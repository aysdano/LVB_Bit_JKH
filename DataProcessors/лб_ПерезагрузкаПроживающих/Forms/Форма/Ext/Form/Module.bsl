	ЗамерВремени(Д1,"Обрезка строк");
			
	//обрежем строки и найдем ФИО, цикл в одной строке
	//
	//Для каждого Запись Из Табл цикл 		
	//	Запись.КлючЖильца = сокрЛП(Запись.FIO)+ " "+сокрЛП(Запись.NAME)+ " "+сокрЛП(Запись.OTCH);
	//  Запись.ЭтоСобственник = Запись.PR_SOB=1; ЭтоОтветственный = Запись.KV_K =1 
	//КонецЦикла;	
	Для каждого Запись Из Табл цикл Запись.КлючЖильца = сокрЛП(Запись.FIO)+ " "+сокрЛП(Запись.NAME)+ " "+сокрЛП(Запись.OTCH);Запись.ЭтоСобственник = Запись.PR_SOB=1; ЭтоОтветственный = Запись.KV_K =1  КонецЦикла;	
	
	ЗамерВремени(Д1,"Расчет ФИО");
	//Подобрать ЛС и жильцов
	
	
	
	
