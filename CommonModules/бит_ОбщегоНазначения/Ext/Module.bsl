				ИтогНачисления = СписокКУОтбор.Итог("Начислено");
				Для Каждого ТекСтрокаКУ Из СписокКУОтбор Цикл 
					// БИТ_ЖКХ 11.12.2015 10:39:48 Начало правки... Решено распределять на все Услуги с положительным ТекСтрока.Сальдо + ТекСтрока.Начислено
					//Если ТекСтрокаКУ.Сальдо >= 0 Тогда
					//	ТекСтрокаКУ.Сумма = ?(ИтогНачисления = 0 ,0 ,ТекСтрокаКУ.Начислено/ИтогНачисления) * СуммаДокумента;
					//КонецЕсли;
					ТекСтрокаКУ.Сумма = ?(ИтогНачисления = 0 ,0 ,ТекСтрокаКУ.Начислено/ИтогНачисления) * СуммаДокумента;
					// БИТ_ЖКХ 11.12.2015 10:39:51 Конец правки. 
