				НомерСубкното = СтрокаСубконтоНЦС.НомерСтроки;
				
			КонецЕсли;
			
		Иначе
			
			Источник      = "РегистрСведений.бит_СтатьиОборотов_НоменклатурныеГруппы";
			НомерСубкното = СтрокаСубконтоНГ.НомерСтроки;
			
