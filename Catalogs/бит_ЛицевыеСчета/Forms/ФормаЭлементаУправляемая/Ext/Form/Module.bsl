	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСчетчиков.Счетчик КАК Счетчик,
	|	ТаблицаСчетчиков.Услуга,
	|	ТаблицаСчетчиков.Услуга.НаименованиеСокращенное КАК СокрНаименование,
	|	ТаблицаСчетчиков.Услуга.ОбщедомовыеНачисления КАК ОбщедомовыеНачисления,
	|	ТаблицаСчетчиков.Приоритет,
	|	ТаблицаСчетчиков.ДоПоказаний,
	|	ТаблицаСчетчиков.ОтПоказаний,
	|	ТаблицаСчетчиков.КоличествоЕдиницПоЛС КАК КоличествоЕдиниц,
	|	ТаблицаСчетчиков.Многотарифный КАК Многотарифный,
	|	ТаблицаСчетчиков.Норматив
	|ИЗ
	|	ТаблицаСчетчиков КАК ТаблицаСчетчиков
	|ГДЕ
	|	ТаблицаСчетчиков.СпособРасчета = Значение(Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам)
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ
	|	МАКСИМУМ(Многотарифный)
	|ПО
	|	Счетчик";
	
	ВыборкаСЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСЧ.Следующий() Цикл
		
		Выборка = ВыборкаСЧ.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = мТаблицаПечатиСчетчиков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			Если НЕ ВыборкаСЧ.Многотарифный Тогда
				Прервать;
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("КонецПериода" , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация"  , Объект.Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.Дата,
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.ВидОперации КАК Основание,
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Услуга КАК Услуга,
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Услуга.Приоритет КАК Приоритет,
	|	СУММА(бит_РазовыеПоУслугамЖКХСписокУслуг.Сумма) КАК Сумма
	|ИЗ
	|	Документ.бит_РазовыеПоУслугамЖКХ.СписокУслуг КАК бит_РазовыеПоУслугамЖКХСписокУслуг
	|ГДЕ
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.Организация = &Организация
	|	И бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.Проведен
	|	И (бит_РазовыеПоУслугамЖКХСписокУслуг.ЛицевойСчет = &ЛицевойСчет
	|			ИЛИ бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.ЛицевойСчет = &ЛицевойСчет)
	|	И бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.Дата,
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.ВидОперации,
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Услуга,
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Услуга.Приоритет
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Ссылка.Дата,
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Ссылка.ВидОперации,
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Услуга,
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Услуга.Приоритет,
	|	СУММА(бит_РазовыеПоУслугамЖКХЛицевыеСчета.Сумма)
	|ИЗ
	|	Документ.бит_РазовыеПоУслугамЖКХ.ЛицевыеСчета КАК бит_РазовыеПоУслугамЖКХЛицевыеСчета
	|ГДЕ
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Ссылка.Проведен
	|	И бит_РазовыеПоУслугамЖКХЛицевыеСчета.Ссылка.Организация = &Организация
	|	И (бит_РазовыеПоУслугамЖКХЛицевыеСчета.ЛицевойСчет = &ЛицевойСчет
	|			ИЛИ бит_РазовыеПоУслугамЖКХЛицевыеСчета.Ссылка.ЛицевойСчет = &ЛицевойСчет)
	|	И бит_РазовыеПоУслугамЖКХЛицевыеСчета.Ссылка.Дата МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Ссылка.Дата,
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Ссылка.ВидОперации,
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Услуга,
	|	бит_РазовыеПоУслугамЖКХЛицевыеСчета.Услуга.Приоритет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Основание,
	|	Приоритет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = мТаблицаПерерасчетов.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла; 
	
	АдресСтруктурыВХранилище = ПоместитьСтруктуруВХранилище(мКэшЗначений.мСтруктураДанных,мТаблицаПечати,мТаблицаПечатиСчетчиков,мТаблицаПерерасчетов,мТаблицаСвойств,мТаблицаОбщедомовыхСчетчиков);
	
КонецПроцедуры // () 

//  Процедура - обработчик события "Нажатие" кнопки "Пени".
// 
&НаКлиенте
Процедура КнопкаПениНажатие(Команда)
	
