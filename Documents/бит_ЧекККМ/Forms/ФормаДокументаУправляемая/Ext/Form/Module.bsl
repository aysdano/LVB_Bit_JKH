Функция ТекстЗапросаТаблицаТоваров(НомераТаблиц)
	
	НомераТаблиц.Вставить("ВТ_АгентскиеУслуги",              НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТ_ТаблицаЧека",                  НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТ_ТаблицаЧекаПеня",              НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаДокумента",                НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаОплат",                    НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаКомитенты",                НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаДоговораПлатежногоАгента", НомераТаблиц.Количество());
	               
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаУслуги.Услуга КАК Номенклатура,
	|	"""" КАК Содержание,
	|	1 КАК Количество,
	|	ТаблицаУслуги.Сумма КАК Цена,
	|	ТаблицаУслуги.Сумма,
	|	ТаблицаУслуги.СуммаПени КАК ЦенаПени,
	|	ТаблицаУслуги.СуммаПени КАК СуммаПени,
	|	ТаблицаУслуги.СтавкаНДС,
	|	ТаблицаУслуги.СуммаНДС,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ВТ_АгентскиеУслуги
	|ИЗ
	|	&ТаблицаУслуги КАК ТаблицаУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУслуги.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(ТаблицаУслуги.Номенклатура КАК Справочник.бит_УслугиЖКХ).НаименованиеПолное КАК Содержание,
	|	ТаблицаУслуги.Количество,
	|	ТаблицаУслуги.Цена,
	|	ТаблицаУслуги.Сумма,
	|	ТаблицаУслуги.ЦенаПени,
	|	ТаблицаУслуги.СуммаПени,
	|	ТаблицаУслуги.СтавкаНДС,
	|	ТаблицаУслуги.СуммаНДС,
	|	ЗНАЧЕНИЕ(Перечисление.ПризнакиПредметаРасчета.Услуга) КАК ПризнакПредметаРасчета,
	|	ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой) КАК ПризнакСпособаРасчета,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ДоговорыКонтрагентов.ПлатежныйАгент, ЛОЖЬ)
	|			ТОГДА ТаблицаУслуги.ДоговорКонтрагента
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	КОНЕЦ КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ТаблицаЧека
	|ИЗ
	|	ВТ_АгентскиеУслуги КАК ТаблицаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ТаблицаУслуги.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""Пеня"" КАК Наименование,
	|	ЗНАЧЕНИЕ(Справочник.бит_УслугиЖКХ.Пеня) КАК Номенклатура,
	|	"""" КАК Артикул,
	|	"""" КАК Штрихкод,
	|	ТаблицаЧека.Количество КАК Количество,
	|	ТаблицаЧека.ЦенаПени КАК ЦенаПени,
	|	ТаблицаЧека.СуммаПени КАК СуммаПени,
	|	НЕОПРЕДЕЛЕНО КАК СтавкаНДС,
	|	0 КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|			ТОГДА ТаблицаЧека.ПризнакСпособаРасчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПризнакСпособаРасчета,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|			ТОГДА ТаблицаЧека.ПризнакПредметаРасчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПризнакПредметаРасчета,
	|	1 КАК НомерСекции,
	|	ТаблицаЧека.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ТаблицаЧекаПеня
	|ИЗ
	|	ТаблицаЧека КАК ТаблицаЧека
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаЧека.Содержание КАК СТРОКА(1000)) КАК Наименование,
	|	ТаблицаЧека.Номенклатура КАК Номенклатура,
	|	"""" КАК Артикул,
	|	"""" КАК Штрихкод,
	|	ТаблицаЧека.Количество,
	|	ВЫБОР
	|		КОГДА &СуммаВключаетНДС
	|			ТОГДА ТаблицаЧека.Цена
	|		КОГДА ТаблицаЧека.Количество <> 0
	|			ТОГДА ВЫРАЗИТЬ((ТаблицаЧека.Сумма + ТаблицаЧека.СуммаНДС) / ТаблицаЧека.Количество КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ ТаблицаЧека.Сумма + ТаблицаЧека.СуммаНДС
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА &СуммаВключаетНДС
	|			ТОГДА ТаблицаЧека.Сумма
	|		ИНАЧЕ ТаблицаЧека.Сумма + ТаблицаЧека.СуммаНДС
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|				И ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20_120)
	|			ТОГДА 120
	|		КОГДА ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20)
	|				ИЛИ ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС20_120)
	|			ТОГДА 20
	|		КОГДА &ЭтоВерсия105
	|				И ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18_118)
	|			ТОГДА 118
	|		КОГДА ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18)
	|				ИЛИ ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС18_118)
	|			ТОГДА 18
	|		КОГДА &ЭтоВерсия105
	|				И ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10_110)
	|			ТОГДА 110
	|		КОГДА ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10)
	|				ИЛИ ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.НДС10_110)
	|			ТОГДА 10
	|		КОГДА ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтавкаНДС,
	|	ТаблицаЧека.СуммаНДС,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|			ТОГДА ТаблицаЧека.ПризнакСпособаРасчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПризнакСпособаРасчета,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|			ТОГДА ТаблицаЧека.ПризнакПредметаРасчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПризнакПредметаРасчета,
	|	1 КАК НомерСекции,
	|	ТаблицаЧека.ДоговорКонтрагента
	|ИЗ
	|	ТаблицаЧека КАК ТаблицаЧека
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаЧекаПеня.Наименование,
	|	ТаблицаЧекаПеня.Номенклатура,
	|	ТаблицаЧекаПеня.Артикул,
	|	ТаблицаЧекаПеня.Штрихкод,
	|	МАКСИМУМ(ТаблицаЧекаПеня.Количество),
	|	СУММА(ТаблицаЧекаПеня.ЦенаПени),
	|	СУММА(ТаблицаЧекаПеня.СуммаПени),
	|	ТаблицаЧекаПеня.СтавкаНДС,
	|	СУММА(ТаблицаЧекаПеня.СуммаНДС),
	|	ТаблицаЧекаПеня.ПризнакСпособаРасчета,
	|	ТаблицаЧекаПеня.ПризнакПредметаРасчета,
	|	ТаблицаЧекаПеня.НомерСекции,
	|	ТаблицаЧекаПеня.ДоговорКонтрагента
	|ИЗ
	|	ТаблицаЧекаПеня КАК ТаблицаЧекаПеня
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЧекаПеня.Наименование,
	|	ТаблицаЧекаПеня.Номенклатура,
	|	ТаблицаЧекаПеня.Артикул,
	|	ТаблицаЧекаПеня.Штрихкод,
	|	ТаблицаЧекаПеня.СтавкаНДС,
	|	ТаблицаЧекаПеня.ПризнакСпособаРасчета,
	|	ТаблицаЧекаПеня.ПризнакПредметаРасчета,
	|	ТаблицаЧекаПеня.НомерСекции,
	|	ТаблицаЧекаПеня.ДоговорКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ТипыОплатыККТ.ПустаяСсылка) КАК ТипОплаты,
	|	0 КАК Сумма
	|ГДЕ
	|	ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_АгентскиеУслуги.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_АгентскиеУслуги.ДоговорКонтрагента) КАК КоличествоДоговоров
	|ИЗ
	|	ВТ_АгентскиеУслуги КАК ВТ_АгентскиеУслуги
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_АгентскиеУслуги.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
	|	АгентскиеУслуги.ДоговорКонтрагента
	|ИЗ
	|	ВТ_АгентскиеУслуги КАК АгентскиеУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО АгентскиеУслуги.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|ГДЕ
	|	ДоговорыКонтрагентов.ПлатежныйАгент";
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();
	
КонецФункции

&НаСервере
Функция ТекстЗапросаТаблицаТоваровНДС2019(НомераТаблиц)
	
	НомераТаблиц.Вставить("ВТ_АгентскиеУслуги",              НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТ_ТаблицаЧека",                  НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ВТ_ТаблицаЧекаПеня",              НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаДокумента",                НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаОплат",                    НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаКомитенты",                НомераТаблиц.Количество());
	НомераТаблиц.Вставить("ТаблицаДоговораПлатежногоАгента", НомераТаблиц.Количество());
	               
	ТекстЗапроса = 
	"ВЫБРАТЬ
	|	ТаблицаУслуги.Услуга КАК Номенклатура,
	|	"""" КАК Содержание,
	|	1 КАК Количество,
	|	ТаблицаУслуги.Сумма КАК Цена,
	|	ТаблицаУслуги.Сумма,
	|	ТаблицаУслуги.СуммаПени КАК ЦенаПени,
	|	ТаблицаУслуги.СуммаПени КАК СуммаПени,
	|	ТаблицаУслуги.СтавкаНДС,
	|	ТаблицаУслуги.СуммаНДС,
	|	ЗНАЧЕНИЕ(Справочник.Контрагенты.ПустаяСсылка) КАК Контрагент,
	|	ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка) КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ВТ_АгентскиеУслуги
	|ИЗ
	|	&ТаблицаУслуги КАК ТаблицаУслуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаУслуги.Номенклатура КАК Номенклатура,
	|	ВЫРАЗИТЬ(ТаблицаУслуги.Номенклатура КАК Справочник.бит_УслугиЖКХ).НаименованиеПолное КАК Содержание,
	|	ТаблицаУслуги.Количество,
	|	ТаблицаУслуги.Цена,
	|	ТаблицаУслуги.Сумма,
	|	ТаблицаУслуги.ЦенаПени,
	|	ТаблицаУслуги.СуммаПени,
	|	ТаблицаУслуги.СтавкаНДС,
	|	ТаблицаУслуги.СуммаНДС,
	|	ЗНАЧЕНИЕ(Перечисление.ПризнакиПредметаРасчета.Услуга) КАК ПризнакПредметаРасчета,
	|	ЗНАЧЕНИЕ(Перечисление.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой) КАК ПризнакСпособаРасчета,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ДоговорыКонтрагентов.ПлатежныйАгент, ЛОЖЬ)
	|			ТОГДА ТаблицаУслуги.ДоговорКонтрагента
	|		ИНАЧЕ ЗНАЧЕНИЕ(Справочник.ДоговорыКонтрагентов.ПустаяСсылка)
	|	КОНЕЦ КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ТаблицаЧека
	|ИЗ
	|	ВТ_АгентскиеУслуги КАК ТаблицаУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО ТаблицаУслуги.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	""Пеня"" КАК Наименование,
	|	ЗНАЧЕНИЕ(Справочник.бит_УслугиЖКХ.Пеня) КАК Номенклатура,
	|	"""" КАК Артикул,
	|	"""" КАК Штрихкод,
	|	ТаблицаЧека.Количество КАК Количество,
	|	ТаблицаЧека.ЦенаПени КАК ЦенаПени,
	|	ТаблицаЧека.СуммаПени КАК СуммаПени,
	|	НЕОПРЕДЕЛЕНО КАК СтавкаНДС,
	|	0 КАК СуммаНДС,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|			ТОГДА ТаблицаЧека.ПризнакСпособаРасчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПризнакСпособаРасчета,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|			ТОГДА ТаблицаЧека.ПризнакПредметаРасчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПризнакПредметаРасчета,
	|	1 КАК НомерСекции,
	|	ТаблицаЧека.ДоговорКонтрагента КАК ДоговорКонтрагента
	|ПОМЕСТИТЬ ТаблицаЧекаПеня
	|ИЗ
	|	ТаблицаЧека КАК ТаблицаЧека
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫРАЗИТЬ(ТаблицаЧека.Содержание КАК СТРОКА(1000)) КАК Наименование,
	|	ТаблицаЧека.Номенклатура КАК Номенклатура,
	|	"""" КАК Артикул,
	|	"""" КАК Штрихкод,
	|	ТаблицаЧека.Количество,
	|	ВЫБОР
	|		КОГДА &СуммаВключаетНДС
	|			ТОГДА ТаблицаЧека.Цена
	|		КОГДА ТаблицаЧека.Количество <> 0
	|			ТОГДА ВЫРАЗИТЬ((ТаблицаЧека.Сумма + ТаблицаЧека.СуммаНДС) / ТаблицаЧека.Количество КАК ЧИСЛО(15, 2))
	|		ИНАЧЕ ТаблицаЧека.Сумма + ТаблицаЧека.СуммаНДС
	|	КОНЕЦ КАК Цена,
	|	ВЫБОР
	|		КОГДА &СуммаВключаетНДС
	|			ТОГДА ТаблицаЧека.Сумма
	|		ИНАЧЕ ТаблицаЧека.Сумма + ТаблицаЧека.СуммаНДС
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|				И ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.ОбщаяРасчетная)
	|			ТОГДА 120
	|		КОГДА ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.Общая)
	|				ИЛИ ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.ОбщаяРасчетная)
	|			ТОГДА 20
	|		КОГДА &ЭтоВерсия105
	|				И ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.Пониженная)
	|			ТОГДА 118
	|		КОГДА ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.Пониженная)
	|				ИЛИ ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.ПониженнаяРасчетная)
	|			ТОГДА 18
	//|		КОГДА &ЭтоВерсия105
	//|				И ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.НДС10_110)
	//|			ТОГДА 110
	//|		КОГДА ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.НДС10)
	//|				ИЛИ ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.НДС10_110)
	//|			ТОГДА 10
	|		КОГДА ТаблицаЧека.СтавкаНДС = ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.БезНДС)
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СтавкаНДС,
	|	ТаблицаЧека.СуммаНДС,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|			ТОГДА ТаблицаЧека.ПризнакСпособаРасчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПризнакСпособаРасчета,
	|	ВЫБОР
	|		КОГДА &ЭтоВерсия105
	|			ТОГДА ТаблицаЧека.ПризнакПредметаРасчета
	|		ИНАЧЕ НЕОПРЕДЕЛЕНО
	|	КОНЕЦ КАК ПризнакПредметаРасчета,
	|	1 КАК НомерСекции,
	|	ТаблицаЧека.ДоговорКонтрагента
	|ИЗ
	|	ТаблицаЧека КАК ТаблицаЧека
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаЧекаПеня.Наименование,
	|	ТаблицаЧекаПеня.Номенклатура,
	|	ТаблицаЧекаПеня.Артикул,
	|	ТаблицаЧекаПеня.Штрихкод,
	|	МАКСИМУМ(ТаблицаЧекаПеня.Количество),
	|	СУММА(ТаблицаЧекаПеня.ЦенаПени),
	|	СУММА(ТаблицаЧекаПеня.СуммаПени),
	|	ТаблицаЧекаПеня.СтавкаНДС,
	|	СУММА(ТаблицаЧекаПеня.СуммаНДС),
	|	ТаблицаЧекаПеня.ПризнакСпособаРасчета,
	|	ТаблицаЧекаПеня.ПризнакПредметаРасчета,
	|	ТаблицаЧекаПеня.НомерСекции,
	|	ТаблицаЧекаПеня.ДоговорКонтрагента
	|ИЗ
	|	ТаблицаЧекаПеня КАК ТаблицаЧекаПеня
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаЧекаПеня.Наименование,
	|	ТаблицаЧекаПеня.Номенклатура,
	|	ТаблицаЧекаПеня.Артикул,
	|	ТаблицаЧекаПеня.Штрихкод,
	|	ТаблицаЧекаПеня.СтавкаНДС,
	|	ТаблицаЧекаПеня.ПризнакСпособаРасчета,
	|	ТаблицаЧекаПеня.ПризнакПредметаРасчета,
	|	ТаблицаЧекаПеня.НомерСекции,
	|	ТаблицаЧекаПеня.ДоговорКонтрагента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ТипыОплатыККТ.ПустаяСсылка) КАК ТипОплаты,
	|	0 КАК Сумма
	|ГДЕ
	|	ЛОЖЬ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_АгентскиеУслуги.Контрагент,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_АгентскиеУслуги.ДоговорКонтрагента) КАК КоличествоДоговоров
	|ИЗ
	|	ВТ_АгентскиеУслуги КАК ВТ_АгентскиеУслуги
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_АгентскиеУслуги.Контрагент
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 2
	|	АгентскиеУслуги.ДоговорКонтрагента
	|ИЗ
	|	ВТ_АгентскиеУслуги КАК АгентскиеУслуги
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|		ПО АгентскиеУслуги.ДоговорКонтрагента = ДоговорыКонтрагентов.Ссылка
	|ГДЕ
	|	ДоговорыКонтрагентов.ПлатежныйАгент";
	
	Возврат ТекстЗапроса + ОбщегоНазначенияБПВызовСервера.ТекстРазделителяЗапросовПакета();
	
КонецФункции


