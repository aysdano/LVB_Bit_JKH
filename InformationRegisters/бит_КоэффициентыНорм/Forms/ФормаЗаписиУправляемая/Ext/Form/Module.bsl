
#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	
	Если Параметры.Свойство("ЗаполнитьИзСправочникаРаботы") Тогда	
		
		Если Не Параметры.ЗаполнитьИзСправочникаРаботы.Работа = Справочники.бит_Работы.ПустаяСсылка() Тогда
			
		Запись.Период        = Параметры.ЗаполнитьИзСправочникаРаботы.Период;
		Запись.Работа        = Параметры.ЗаполнитьИзСправочникаРаботы.Работа;
		Запись.ЕдиницаИзмерения = ?(Параметры.ЗаполнитьИзСправочникаРаботы.ЕдиницаИзмерения = Справочники.КлассификаторЕдиницИзмерения.ПустаяСсылка(),
							Параметры.ЗаполнитьИзСправочникаРаботы.Работа.ОсновнаяЕдиницаИзмерения, Параметры.ЗаполнитьИзСправочникаРаботы.ЕдиницаИзмерения);
			
		Запись.ВидОбъекта	  =	Перечисления.бит_ВидыОбъектовУчета.Здание;
			
			ВывестиАктуальные(Запись.Работа, Запись.ЕдиницаИзмерения, Запись.ВидОбъекта, Запись.Подразделение);
			
		КонецЕсли;
		
	КонецЕсли;
	
	ТаблицаНормТруда.Сортировать("Норма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ТекстСообщения = "Элемент не может быть записан!";
	
	Если НЕ ЗначениеЗаполнено(Запись.Работа) Тогда
		ТекстСообщения = ТекстСообщения + " Не заполнена работа.";
		Отказ = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(Запись.ЕдиницаИзмерения) Тогда
		ТекстСообщения = ТекстСообщения + " Не заполнена единица измерения по работе.";
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запись.ВидОбъекта) Тогда
		ТекстСообщения  = ТекстСообщения + " Не заполнен вид объекта.";
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Запись.Подразделение) Тогда
		ТекстСообщения  = ТекстСообщения + " Не заполнено Подразделение.";
		Отказ = Истина;
	КонецЕсли;

	Если Отказ Тогда
		бит_ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения,Отказ);
	КонецЕсли;
	
	Если Отказ = Ложь Тогда 
		ДобавитьЗаписиНаСервере();
		
		Отказ = Истина;
		ЭтаФорма.Закрыть();	
	КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ДобавитьЗаписиНаСервере()

	ТЗТаблицаНормТруда = ДанныеФормыВЗначение(ТаблицаНормТруда,Тип("ТаблицаЗначений"));
	
	Для Каждого Строка из ТЗТаблицаНормТруда Цикл
		ДобавитьЗапись(Запись.Период, Запись.Работа, Запись.ЕдиницаИзмерения, Запись.ВидОбъекта, Запись.Подразделение, Строка);
	КонецЦикла;
	
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Процедура выводит существующие записи регистра с отбором.
// По услуге, способу расчета, типу и статусу квартиры.
// Или выводит существующие режимы потребеления для услуги, если записей нет.
//
&НаСервере
Процедура ВывестиАктуальные (Работа, ЕдиницаИзмерения, ВидОбъекта, Подразделение)
	
	ТаблицаНормТруда.Очистить();	
	
	ВыборкаНорм = Справочники.бит_НормыТруда.Выбрать(, Работа);
	СписокНорм = Новый СписокЗначений;
	Пока ВыборкаНорм.Следующий() Цикл
		СписокНорм.Добавить(ВыборкаНорм.Ссылка);
	КонецЦикла;
	
	
	Запрос = Новый Запрос;

	Запрос.УстановитьПараметр("Дата"          		 ,Запись.Период);
	Запрос.УстановитьПараметр("Работа"        		 ,Работа);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения"  	 ,ЕдиницаИзмерения);
	Запрос.УстановитьПараметр("ВидОбъекта"   		 ,ВидОбъекта);
	Запрос.УстановитьПараметр("Подразделение"		 ,Подразделение);
	Запрос.УстановитьПараметр("СписокНорм"			 ,СписокНорм);
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_НормыТруда.Ссылка КАК Норма,
	               |	МАКСИМУМ(бит_КоэффициентыНормСрезПоследних.Коэффициент) КАК Коэффициент
	               |ИЗ
	               |	Справочник.бит_НормыТруда КАК бит_НормыТруда
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_КоэффициентыНорм.СрезПоследних(
	               |				&Дата,
	               |				ЕдиницаИзмерения = &ЕдиницаИзмерения
	               |					И ВидОбъекта = &ВидОбъекта
	               |					И Работа = Работа
	               |					И Подразделение = &Подразделение) КАК бит_КоэффициентыНормСрезПоследних
	               |		ПО бит_НормыТруда.Ссылка = бит_КоэффициентыНормСрезПоследних.Норма
	               |ГДЕ
	               |	бит_НормыТруда.Ссылка В(&СписокНорм)
	               |	И бит_НормыТруда.ЕдиницаИзмерения = &ЕдиницаИзмерения
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	бит_НормыТруда.Ссылка";
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписей.Количество() > 0 Тогда                      
		ТаблицаНормТруда.Загрузить(ТаблицаЗаписей.Скопировать());
	КонецЕсли;
	
	ТаблицаНормТруда.Сортировать("Норма");
	Модифицированность = Ложь;
	
КонецПроцедуры // ВывестиАктуальные()

// Процедура  добавляет записи в регистр.
//
&НаСервере
Процедура ДобавитьЗапись(Период, Работа, ЕдиницаИзмерения, ВидОбъекта, Подразделение, Данные)
	
	НовЗапись                                 = ДанныеФормыВЗначение(Запись,Тип("РегистрСведенийМенеджерЗаписи.бит_КоэффициентыНорм"));

	НовЗапись.Период                          = Период;
	НовЗапись.Работа                          = Работа;
	НовЗапись.ЕдиницаИзмерения		          = ЕдиницаИзмерения;
	НовЗапись.ВидОБъекта                      = ВидОбъекта;
	НовЗапись.Подразделение	                  = Подразделение;
	НовЗапись.Норма				              = Данные.Норма;
	НовЗапись.Коэффициент                     = Данные.Коэффициент;
	НовЗапись.Записать();
	
КонецПроцедуры // ДобавитьЗапись()

&НаКлиенте
Процедура ТаблицаНормТрудаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Отказ = Истина;

	бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нормы не могут быть изменены. Они определяются из справочника ""Нормы труда""");
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНормТрудаПередНачаломИзменения(Элемент, Отказ)
	
	Если Элемент.ТекущийЭлемент.Заголовок = "Норма труда" Тогда
		
		Отказ = Истина;

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нормы не могут быть изменены. Они определяются из справочника ""Нормы труда""");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаНормТрудаПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;

	бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нормы не могут быть изменены. Они определяются из справочника ""Нормы труда""");
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокПодразделений = ПодразделенияНаСервере();
	
	ФормаВыбора = ОткрытьФорму("Справочник.бит_ПодразделенияОрганизаций.Форма.ФормаВыбораУправляемая",,Элемент);
	
	ФормаВыбора.Список.Отбор.Элементы.Очистить();
	
	Эл = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Ссылка");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
	Эл.ПравоеЗначение   = СписокПодразделений;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры

&НаСервере
Функция ПодразделенияНаСервере()
	
	СписокПодразделений = Новый СписокЗначений;
	
	Для Каждого ТекСтрока Из Запись.Работа.Подразделения Цикл
		СписокПодразделений.Добавить(ТекСтрока.Подразделение);
	КонецЦикла;
	
	Возврат СписокПодразделений;
	
КонецФункции	

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	ВывестиАктуальные(Запись.Работа, Запись.ЕдиницаИзмерения, Запись.ВидОбъекта, Запись.Подразделение);
	
КонецПроцедуры

