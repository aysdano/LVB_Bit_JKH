
#Область ПроцедурыОбработчикиСобытийФормы

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ОпределитьСпособУказанияДаты();
	ПриИзмененииСпособаУказания();	    
	
	ЗаполнитьДеревоДат();
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	// БИТ_ЖКХ 09.09.2016 11:55:28 Начало правки...
	Если ЗавершениеРаботы И Модифицированность Тогда
		Возврат;
	КонецЕсли;
	// БИТ_ЖКХ 09.09.2016 11:55:28 Конец правки.

	Если Модифицированность Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Отказ",Отказ);
		
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершение", ЭтотОбъект,ДополнительныеПараметры);
		
		ПоказатьВопрос(Оповещение, "Данные были изменены. Сохранить изменения?", РежимДиалогаВопрос.ДаНет);	
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СпособУказанияДатыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Элементы.СписокСпособУказанияДаты.СписокВыбора.Очистить();
	Элементы.СписокСпособУказанияДаты.СписокВыбора.Добавить(1,"Общая дата",,);
	Элементы.СписокСпособУказанияДаты.СписокВыбора.Добавить(2,"По организациям",,);
	Элементы.СписокСпособУказанияДаты.СписокВыбора.Добавить(3,"По организациям и пользователям",,);
	
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("СпособУказанияДатыНачалоВыбораЗавершение", ЭтотОбъект), Элементы.СписокСпособУказанияДаты.СписокВыбора);
	
КонецПроцедуры

&НаКлиенте
Процедура СпособУказанияДатыНачалоВыбораЗавершение(ВыбранныйЭлемент,ДополнительныеПараметры) Экспорт
	
	Если ВыбранныйЭлемент = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;	
	
	Если Строка(ВыбранныйЭлемент) = "Общая дата" Тогда
		
		СпособУказанияДатыНаСервере(1);
		
		
	ИначеЕсли Строка(ВыбранныйЭлемент) = "По организациям" Тогда
		
		СпособУказанияДатыНаСервере(2);
		
		
	ИначеЕсли Строка(ВыбранныйЭлемент) = "По организациям и пользователям" Тогда
		
		СпособУказанияДатыНаСервере(3);
		
	КонецЕсли;
	
	ПриИзмененииСпособаУказания();	
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСпособУказанияДатыПриИзменении(Элемент)
	
	Если Элемент.ТекстРедактирования  = "Общая дата" Тогда
		СпособУказанияДаты = 1;
		
	ИначеЕсли Элемент.ТекстРедактирования  = "По организациям" Тогда
		
		СпособУказанияДаты = 2;
	ИначеЕсли Элемент.ТекстРедактирования  = "По организациям и пользователям" Тогда
		
		СпособУказанияДаты = 3;
		
	КонецЕсли;
	
	ПриИзмененииСпособаУказания();	
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура управляет визуальным поведением элементов формы в зависимости от реквизита "Способ указания даты".
//
&НаКлиенте
Процедура УстановитьВидимость()
	
	Если СпособУказанияДаты = 2 Тогда
		
		Элементы.ДатыПоОрганизациям.Видимость = Истина;
		Элементы.ОбщаяДата.Видимость = Ложь;
		Элементы.ДеревоДаты.Видимость = Истина;
		Элементы.ДеревоДаты.КоманднаяПанель.Видимость = Ложь;
		Элементы.ДеревоДаты.КоманднаяПанель.ПодчиненныеЭлементы.Добавить.Видимость = Ложь;
		
	ИначеЕсли СпособУказанияДаты = 3 Тогда
		
		Элементы.ДатыПоОрганизациям.Видимость = Истина;
		Элементы.ОбщаяДата.Видимость = Ложь;
		Элементы.ДеревоДаты.КоманднаяПанель.Видимость = Истина;
		Элементы.ДеревоДаты.КоманднаяПанель.ПодчиненныеЭлементы.Добавить.Видимость = Истина;
		
	КонецЕсли;                           
	
КонецПроцедуры // УстановитьВидимость

&НаСервере
Процедура СпособУказанияДатыНаСервере(ВыбранныйЭлемент)
	
	СпособУказанияДаты = ВыбранныйЭлемент;
	
КонецПроцедуры

#КонецОбласти

