&НаКлиенте
Процедура ПоказанияПоСчетчикамСчетчикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.ПоказанияПоСчетчикам.ТекущиеДанные;
	
	СписокИсключений = Новый Массив;
	
	Для каждого СтрокаТаблицы Из Объект.ПоказанияПоСчетчикам Цикл
		
		Если НЕ СтрокаТаблицы.Многотарифный Тогда
			
			СписокИсключений.Добавить(СтрокаТаблицы.Счетчик);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	СписокЛС = ПолучитьСписокЛС(СписокИсключений, ?( НЕ ТекСтрока = Неопределено, ТекСтрока.Дом, Объект.Дом) , ?( НЕ ТекСтрока = Неопределено, ТекСтрока.ЛицевойСчет, Объект.ЛицевойСчет));
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("Ссылка", СписокЛС);
	
	ОткрытьФорму("Справочник.бит_Счетчики.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамСчетчикОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ПоказанияПоСчетчикам.ТекущиеДанные;
	
	СтандартнаяОбработка = Ложь;
	
	Если ТекСтрока = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ТекСтрока.Счетчик = ВыбранноеЗначение Тогда
		
		Дом            = ТекСтрока.Дом;
		ЛицевойСчет    = ТекСтрока.ЛицевойСчет;
		Квартира       = ТекСтрока.ЛицевойСчет.Квартира;
		НомерСтроки    = ТекСтрока.ПолучитьИдентификатор();
		СтароеЗначение = ТекСтрока.Счетчик;
		Многотарифный  = ТекСтрока.Многотарифный;
		
		ПоказанияНаСчетчикеСчетчикОбработкаВыбораНаСервере(ВыбранноеЗначение, Дом, ЛицевойСчет, Квартира, НомерСтроки, СтароеЗначение, Многотарифный);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамТекущиеПоказанияОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные      = Элементы.ПоказанияПоСчетчикам.ТекущиеДанные;
	
	КонечныеПоказания   = Число(Текст);
	Разность             = КонечныеПоказания - ТекущиеДанные.ПредыдущиеПоказания;
	
	ПереходЧерезНоль   = Ложь;
	Заполнить          = Истина;
	
	// СтандартнаяОбработка           = Ложь;.
	
	Если КонечныеПоказания < ТекущиеДанные.ПредыдущиеПоказания Тогда
		
		// БИТ_ЖКХ 07.11.2014
		//Разрядность = РазрядностьНаСервере(ТекущиеДанные.Счетчик);
		Разрядность = ЗначениеРеквизитаНаСервере(ТекущиеДанные.Счетчик, "Разрядность");
		
		// Разность = ТекущиеДанные.Счетчик.Разрядность - ТекущиеДанные.ПредыдущиеПоказания + 1 + Число(Текст);.
		Разность = Разрядность - ТекущиеДанные.ПредыдущиеПоказания + 1 + Число(Текст);
		Ответ = Неопределено;

		ПоказатьВопрос(Новый ОписаниеОповещения("ПоказанияПоСчетчикамТекущиеПоказанияОкончаниеВводаТекстаЗавершение", ЭтотОбъект, Новый Структура("КонечныеПоказания, Разность, ТекущиеДанные, ПереходЧерезНоль, Заполнить", КонечныеПоказания, Разность, ТекущиеДанные, ПереходЧерезНоль, Заполнить)), "Произойдет переход через 0 на разность: " + Разность +" Ввести?",РежимДиалогаВопрос.ДаНетОтмена);
        Возврат;
		
	КонецЕсли;
	
	ПоказанияПоСчетчикамТекущиеПоказанияОкончаниеВводаТекстаФрагмент(Заполнить, КонечныеПоказания, ПереходЧерезНоль, Разность, ТекущиеДанные);

	 ДанныеВыбора = КонечныеПоказания;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамТекущиеПоказанияОкончаниеВводаТекстаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	КонечныеПоказания = ДополнительныеПараметры.КонечныеПоказания; 
	
    Разность = ДополнительныеПараметры.Разность;
    ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
    
	ПереходЧерезНоль   = ДополнительныеПараметры.ПереходЧерезНоль;
	Заполнить          = ДополнительныеПараметры.Заполнить;
	
    // БИТ_ЖКХ 07.11.2014
    
    Ответ = РезультатВопроса;
	
	СтандартнаяОбработка = Ложь;

    Если Ответ = КодВозвратаДиалога.Нет Тогда
        
        // СтандартнаяОбработка           = Ложь;
        тмпКонечныеПоказания = Формат(ТекущиеДанные.ТекущиеПоказания, "ЧДЦ=4; ЧН=");
        
        Заполнить = ложь;
        
    ИначеЕсли Ответ = КодВозвратаДиалога.Отмена Тогда
        
        // СтандартнаяОбработка = Ложь;
        Разность             = 0;
        КонечныеПоказания   = 0;
    Иначе
        
        ПереходЧерезНоль = Истина;
        
    КонецЕсли;
    
    
    ПоказанияПоСчетчикамТекущиеПоказанияОкончаниеВводаТекстаФрагмент(Заполнить, КонечныеПоказания, ПереходЧерезНоль, Разность, ТекущиеДанные);

КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамТекущиеПоказанияОкончаниеВводаТекстаФрагмент(Знач Заполнить, Знач КонечныеПоказания, Знач ПереходЧерезНоль, Знач Разность, Знач ТекущиеДанные)
    
    Перем СтрокаТаблицы, СтрокиПоиска;
    
    Если Заполнить Тогда
        
        Если НЕ ТекущиеДанные.Многотарифный Тогда
            
            СтрокиПоиска = Объект.ПоказанияПоСчетчикам.НайтиСтроки(Новый Структура("Счетчик", ТекущиеДанные.Счетчик));
            
            Для каждого СтрокаТаблицы Из СтрокиПоиска Цикл
                
                СтрокаТаблицы.ТекущиеПоказания           = КонечныеПоказания;
                СтрокаТаблицы.КоличествоЕдиницПоСчетчику = Разность;
                СтрокаТаблицы.ПереходЧерезНоль           = ПереходЧерезНоль;
                
            КонецЦикла;
            
        Иначе
            
            СтрокиПоиска = Объект.ПоказанияПоСчетчикам.НайтиСтроки(Новый Структура("Счетчик, Услуга", ТекущиеДанные.Счетчик, ТекущиеДанные.Услуга));
            
            Для каждого СтрокаТаблицы Из СтрокиПоиска Цикл
                
                СтрокаТаблицы.ТекущиеПоказания           = КонечныеПоказания;
                СтрокаТаблицы.КоличествоЕдиницПоСчетчику = Разность;
                СтрокаТаблицы.ПереходЧерезНоль           = ПереходЧерезНоль;
                
            КонецЦикла;
            
        КонецЕсли;
        
    КонецЕсли;

КонецПроцедуры

