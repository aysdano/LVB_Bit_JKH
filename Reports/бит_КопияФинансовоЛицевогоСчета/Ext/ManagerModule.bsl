
#Область ПроцедурыПечати

// Процедура формирования отчета.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура СформироватьОтчет(ПараметрыОтчета, АдресХранилища) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	// БИТ_ЖКХ 15.03.2017 11:07:12 Начало правки... 
	Если ПараметрыОтчета.Свойство("НачалоПериода") И ПараметрыОтчета.Свойство("КонецПериода")
		И ПараметрыОтчета.НачалоПериода > ПараметрыОтчета.КонецПериода Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Период построения отчета указан с ошибкой!");
		
	Иначе
		
		Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Выписка Тогда
			ЗаполнитьМакетВыписки(ПараметрыОтчета, ТабличныйДокумент);
		ИначеЕсли ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Справка Тогда
			ЗаполнитьМакетСправки(ПараметрыОтчета, ТабличныйДокумент);
		ИначеЕсли ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.СправкаБалашиха Тогда
			ЗаполнитьМакетСправки(ПараметрыОтчета, ТабличныйДокумент, "МакетСправкиБалашиха");
		ИначеЕсли ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Остатки Тогда
			ЗаполнитьМакетОстатки(ПараметрыОтчета, ТабличныйДокумент);
		//28.08.2019	
		ИначеЕсли ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСПеня Тогда
			ЗаполнитьМакетПолныйСПеня(ПараметрыОтчета, ТабличныйДокумент);
		ИначеЕсли ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный
			ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Основной
			 ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСтр2
			 ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСПеняСтр2 Тогда
			ЗаполнитьМакетПолный(ПараметрыОтчета, ТабличныйДокумент);
		КонецЕсли;
		
	КонецЕсли;
	// БИТ_ЖКХ 15.03.2017 11:07:14 Конец правки. 
	
	ПоместитьВоВременноеХранилище(ТабличныйДокумент, АдресХранилища);
	
КонецПроцедуры // ()

// Процедура заполнения макета выписки.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьМакетВыписки(ПараметрыОтчета, ТабличныйДокумент)
	
	ТабличныйДокумент.Очистить();
	
	СведенияОбЛС = ПолучитьСведенияОбЛицевомСчете(ПараметрыОтчета);
	
	Если СведенияОбЛС = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	КоличествоПроживающих = 0;
	
	ТаблицаПроживающих    = ПолучитьТаблицуПроживающих(КонецДня(ПараметрыОтчета.КонецПериода), ПараметрыОтчета.ЛицевойСчет);
	
	// БИТ_ЖКХ 18.07.2014
	// КоличествоПроживающих = ТаблицаПроживающих.Количество();.
	Для каждого СтрокаПроживающий из ТаблицаПроживающих Цикл 
		
		Если СтрокаПроживающий.СтатусФизЛица.ПроживаниеВДанныйМомент Тогда
			КоличествоПроживающих = КоличествоПроживающих + 1;
		КонецЕсли; 
		
	КонецЦикла;
	// БИТ_ЖКХ 18.07.2014	
	
	Макет = ПолучитьМакет("МакетВыписка");
	
	ОбластьЗаголовок    = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока       = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог         = Макет.ПолучитьОбласть("Итог");
	ОбластьПодвал       = Макет.ПолучитьОбласть("Подвал");
	
	ТаблицаРасчетов = Новый ТаблицаЗначений;
	ТаблицаРасчетов.Колонки.Добавить("Услуга");
	ТаблицаРасчетов.Колонки.Добавить("Объем");
	ТаблицаРасчетов.Колонки.Добавить("Тариф");
	ТаблицаРасчетов.Колонки.Добавить("БезЛьгот");
	ТаблицаРасчетов.Колонки.Добавить("СУчетомЛьгот");
	ТаблицаРасчетов.Колонки.Добавить("Льготы");
	ТаблицаРасчетов.Колонки.Добавить("ЕдИзм");
	ТаблицаРасчетов.Колонки.Добавить("Площадь");
	ТаблицаРасчетов.Колонки.Добавить("ОсновнаяСтавка");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода" , КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет"  , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("СписокУслуг"  , СведенияОбЛС.СписокУслуг);
	Запрос.Текст = ПолучитьТекстЗапросаВыписка_Список();
	
	Результат = Запрос.Выполнить();
	ВыборкаЛС = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВхСальдо     = 0;
	ИсхСальдо    = 0;
	Оплата       = 0;
	Разовые      = 0;
	Льгота       = 0;
	БезЛьгот     = 0;
	СУчетомЛьгот = 0;
	
	Если ВыборкаЛС.Следующий() Тогда
		
		Льгота    = ВыборкаЛС.Льгота;
		Оплата    = ВыборкаЛС.Оплата;
		Разовые   = ВыборкаЛС.Разовые;
		ВхСальдо  = ВыборкаЛС.ВхСальдо;
		ИсхСальдо = ВыборкаЛС.ИсхСальдо;
		
		Выборка = ВыборкаЛС.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если НЕ ПараметрыОтчета.ВыводитьВсеУслугиВСправку Тогда
				
				Если (ПараметрыОтчета.ЗаполненоГЦЖС И Выборка.ГрафаОтчетаГЦЖС.Пустая())
					ИЛИ (НЕ ПараметрыОтчета.ЗаполненоГЦЖС И Выборка.Начислено = 0) Тогда
					Продолжить;
				КонецЕсли; 
				
			КонецЕсли; 
			
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.Услуга         = Выборка.Услуга;
			НоваяСтрока.Объем          = Выборка.Объем;
			НоваяСтрока.Тариф          = Выборка.Тариф; 
			НоваяСтрока.БезЛьгот       = Выборка.Начислено;
			НоваяСтрока.СУчетомЛьгот   = Выборка.Начислено  - Выборка.Льгота;
			НоваяСтрока.Льготы         = Выборка.Льгота;
			НоваяСтрока.ЕдИзм          = Выборка.ЕдИзм;
			НоваяСтрока.ОсновнаяСтавка = Выборка.ОсновнаяСтавка;
			
			Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда
				НоваяСтрока.Площадь = СведенияОбЛС.ОбщаяПлощадь;
			ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда
				НоваяСтрока.Площадь = СведенияОбЛС.ЖилаяПлощадь;
			ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади Тогда
				НоваяСтрока.Площадь = СведенияОбЛС.ОтапливаемаяПлощадь;
			КонецЕсли; 
			
			БезЛьгот     = БезЛьгот     + НоваяСтрока.БезЛьгот;
			СУчетомЛьгот = СУчетомЛьгот + НоваяСтрока.СУчетомЛьгот;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ИтогЛьготыСтр     = Формат(Льгота      , "Л=ru; ЧДЦ=2; ЧН=0,00; ЧГ=3,0") + " руб.";
	ИтогоБезЛьготСтр  = Формат(БезЛьгот    , "Л=ru; ЧДЦ=2; ЧН=0,00; ЧГ=3,0") + " руб.";
	ИтогСоЛьготамиСтр = Формат(СУчетомЛьгот, "Л=ru; ЧДЦ=2; ЧН=0,00; ЧГ=3,0") + " руб.";
	
	// Вывод Шапки отчета.
	ОбластьШапка.Параметры.Отвественный = Строка(СведенияОбЛС.Ответственный);
	
	АдресЛС = Строка(СведенияОбЛС.Улица) + ", дом "+ Строка(СведенияОбЛС.Здание)
	+ ?(ЗначениеЗаполнено(СведенияОбЛС.Корпус),", корп." + Строка(СведенияОбЛС.Корпус),"");
	
	Если ПараметрыОтчета.ВыводитьПочтовыйАдрес И ЗначениеЗаполнено(СведенияОбЛС.ПочтовыйАдрес) Тогда
		АдресЛС = СведенияОбЛС.ПочтовыйАдрес;
	Иначе

	КонецЕсли;
	
	ОбластьШапка.Параметры.АдресЛС      = "" + АдресЛС + ?(ЗначениеЗаполнено(СведенияОбЛС.Квартира),", кв." + Строка(СведенияОбЛС.Квартира),"");
	ОбластьШапка.Параметры.ЛицевойСчет  = СведенияОбЛС.НаименованиеЛС;
	ОбластьШапка.Параметры.ЖилаяПлощадь = СведенияОбЛС.ЖилаяПлощадь;
	ОбластьШапка.Параметры.ОбщаяПлощадь = СведенияОбЛС.ОбщаяПлощадь;
	
	ОбластьШапка.Параметры.КоличествоПроживающих = КоличествоПроживающих;
	
	ОбластьШапка.Параметры.СуммаОплаты = ИтогСоЛьготамиСтр + "  "+Формат(ПараметрыОтчета.НачалоПериода,"ДФ='""(на"" MMMM yyyy""г.)""'");
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	ТабличныйДокумент.Вывести(ОбластьШапка);
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	// Вывод строк отчета.
	Для каждого СтрокаТаблицы Из ТаблицаРасчетов Цикл
		
		ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
		
		Если СтрокаТаблицы.Услуга.ТипыНачислений = Перечисления.бит_ТипыНачисленийПоЖКХ.Эксплуатационная тогда
			ОбластьСтрока.Параметры.Объем_ЕдИзм = Строка(СтрокаТаблицы.Площадь) + " " + Строка(СтрокаТаблицы.ЕдИзм);
			ОбластьСтрока.Параметры.Тариф       = СтрокаТаблицы.ОсновнаяСтавка;
		иначе                                     
			ОбластьСтрока.Параметры.Объем_ЕдИзм = Строка(СтрокаТаблицы.Объем) + " " + Строка(СтрокаТаблицы.ЕдИзм);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла; 
	
	// Вывод итога.
	ОбластьИтог.Параметры.ИтогоБезЛьгот  = БезЛьгот;
	ОбластьИтог.Параметры.ИтогСоЛьготами = СУчетомЛьгот;
	
	ТабличныйДокумент.Вывести(ОбластьИтог);
	
	// Вывод подвала.
	ВХСальдо = ВХСальдо - Оплата - Разовые;
	
	Если ВХСальдо <= 0 тогда
		ВХСальдоСтр = "Задолженности нет"; 
	Иначе
		ВХСальдоСтр = Формат(ВХСальдо, "Л=ru; ЧДЦ=2; ЧГ=3,0") + " руб."; 
	КонецЕсли;
	
	ОбластьПодвал.Параметры.ВХСальдо = ВХСальдоСтр;
	
	ОбластьПодвал.Параметры.Организация = Строка(ПараметрыОтчета.ЛицевойСчет.Организация);
	ОбластьПодвал.Параметры.Дата = Формат(ПараметрыОтчета.Период,"ДЛФ=DD");
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры // () 

// Процедура заполнения макета справки.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьМакетСправки(ПараметрыОтчета, ТабличныйДокумент, ИмяМакета = "")
	
	ТабличныйДокумент.Очистить();
	
	СведенияОбЛС = ПолучитьСведенияОбЛицевомСчете(ПараметрыОтчета);
	
	Если СведенияОбЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	КоличествоПроживающих = 0;
	
	ТаблицаПроживающих    = ПолучитьТаблицуПроживающих(КонецДня(ПараметрыОтчета.КонецПериода), ПараметрыОтчета.ЛицевойСчет);
	
	// БИТ_ЖКХ 18.07.2014
	// КоличествоПроживающих = ТаблицаПроживающих.Количество();.
	Для каждого СтрокаПроживающий из ТаблицаПроживающих Цикл 
		
		Если СтрокаПроживающий.СтатусФизЛица.ПроживаниеВДанныйМомент Тогда
			КоличествоПроживающих = КоличествоПроживающих + 1;
		КонецЕсли; 
		
	КонецЦикла;
	// БИТ_ЖКХ 18.07.2014	
	
	если ИмяМакета = "" тогда 
	 Макет = ПолучитьМакет("МакетСправки");
    иначе 
	 Макет = ПолучитьМакет(ИмяМакета);
	конецесли; 
	
	ОбластьЗаголовок    = Макет.ПолучитьОбласть("Заголовок");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаТаблицы = Макет.ПолучитьОбласть("ШапкаТаблицы");
	ОбластьСтрока       = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог         = Макет.ПолучитьОбласть("Итог");
	ОбластьПодвал       = Макет.ПолучитьОбласть("Подвал");
	
	ТаблицаРасчетов = Новый ТаблицаЗначений;
	ТаблицаРасчетов.Колонки.Добавить("Услуга");
	ТаблицаРасчетов.Колонки.Добавить("Объем");
	ТаблицаРасчетов.Колонки.Добавить("Тариф");
	ТаблицаРасчетов.Колонки.Добавить("БезЛьгот");
	ТаблицаРасчетов.Колонки.Добавить("СУчетомЛьгот");
	ТаблицаРасчетов.Колонки.Добавить("Льготы");
	ТаблицаРасчетов.Колонки.Добавить("ЕдИзм");
	ТаблицаРасчетов.Колонки.Добавить("Площадь");
	ТаблицаРасчетов.Колонки.Добавить("ОсновнаяСтавка");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода" , КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет"  , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("СписокУслуг"  , СведенияОбЛС.СписокУслуг);
	Запрос.Текст = ПолучитьТекстЗапросаВыписка_Список();
	
	Результат = Запрос.Выполнить();
	ВыборкаЛС = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ВхСальдо     = 0;
	ИсхСальдо    = 0;
	Оплата       = 0;
	Разовые      = 0;
	Льгота       = 0;
	БезЛьгот     = 0;
	СУчетомЛьгот = 0;
	
	Если ВыборкаЛС.Следующий() Тогда
		
		Льгота    = ВыборкаЛС.Льгота;
		Оплата    = ВыборкаЛС.Оплата;
		Разовые   = ВыборкаЛС.Разовые;
		ВхСальдо  = ВыборкаЛС.ВхСальдо;
		ИсхСальдо = ВыборкаЛС.ИсхСальдо;
		
		Выборка = ВыборкаЛС.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если НЕ ПараметрыОтчета.ВыводитьВсеУслугиВСправку Тогда
				
				Если (ПараметрыОтчета.ЗаполненоГЦЖС И Выборка.ГрафаОтчетаГЦЖС.Пустая())
					ИЛИ (НЕ ПараметрыОтчета.ЗаполненоГЦЖС И Выборка.Начислено = 0) Тогда
					Продолжить;
				КонецЕсли; 
				
			КонецЕсли; 
			
			НоваяСтрока = ТаблицаРасчетов.Добавить();
			НоваяСтрока.Услуга         = Выборка.Услуга;
			НоваяСтрока.Объем          = Выборка.Объем;
			НоваяСтрока.Тариф          = Выборка.Тариф; 
			НоваяСтрока.БезЛьгот       = Выборка.Начислено;
			НоваяСтрока.СУчетомЛьгот   = Выборка.Начислено  - Выборка.Льгота;
			НоваяСтрока.Льготы         = Выборка.Льгота;
			НоваяСтрока.ЕдИзм          = Выборка.ЕдИзм;
			НоваяСтрока.ОсновнаяСтавка = Выборка.ОсновнаяСтавка;
			
			Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда
				НоваяСтрока.Площадь = СведенияОбЛС.ОбщаяПлощадь;
			ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда
				НоваяСтрока.Площадь = СведенияОбЛС.ЖилаяПлощадь;
			ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади Тогда
				НоваяСтрока.Площадь = СведенияОбЛС.ОтапливаемаяПлощадь;
			КонецЕсли; 
			
			БезЛьгот     = БезЛьгот     + НоваяСтрока.БезЛьгот;
			СУчетомЛьгот = СУчетомЛьгот + НоваяСтрока.СУчетомЛьгот;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ИтогЛьготыСтр     = Формат(Льгота      , "Л=ru; ЧДЦ=2; ЧН=0,00; ЧГ=3,0") + " руб.";
	ИтогоБезЛьготСтр  = Формат(БезЛьгот    , "Л=ru; ЧДЦ=2; ЧН=0,00; ЧГ=3,0") + " руб.";
	ИтогСоЛьготамиСтр = Формат(СУчетомЛьгот, "Л=ru; ЧДЦ=2; ЧН=0,00; ЧГ=3,0") + " руб.";
	
	// Вывод Шапки отчета.
	ОбластьШапка.Параметры.Отвественный = Строка(СведенияОбЛС.Ответственный) + " - " + СведенияОбЛС.НаименованиеЛС;
	
	АдресЛС = Строка(СведенияОбЛС.Улица) + ", дом "+ Строка(СведенияОбЛС.Здание)
	+ ?(ЗначениеЗаполнено(СведенияОбЛС.Корпус),", корп." + Строка(СведенияОбЛС.Корпус),"");
	
	Если ПараметрыОтчета.ВыводитьПочтовыйАдрес И ЗначениеЗаполнено(СведенияОбЛС.ПочтовыйАдрес) Тогда
		АдресЛС = СведенияОбЛС.ПочтовыйАдрес;
	Иначе

	КонецЕсли;
	
	ОбластьШапка.Параметры.АдресЛС      = "" + АдресЛС + ?(ЗначениеЗаполнено(СведенияОбЛС.Квартира),", кв." + Строка(СведенияОбЛС.Квартира),"");
	ОбластьШапка.Параметры.ЛицевойСчет  = СведенияОбЛС.НаименованиеЛС;
	ОбластьШапка.Параметры.ЖилаяПлощадь = СведенияОбЛС.ЖилаяПлощадь;
	ОбластьШапка.Параметры.ОбщаяПлощадь = СведенияОбЛС.ОбщаяПлощадь;
	
	ОбластьШапка.Параметры.КоличествоПроживающих = КоличествоПроживающих;
	
	ОбластьШапка.Параметры.СуммаОплаты = ИтогСоЛьготамиСтр + "  "+Формат(ПараметрыОтчета.НачалоПериода,"ДФ='""(на"" MMMM yyyy""г.)""'");
	
	ТабличныйДокумент.Вывести(ОбластьЗаголовок);
	ТабличныйДокумент.Вывести(ОбластьШапка);
	ТабличныйДокумент.Вывести(ОбластьШапкаТаблицы);
	
	// Вывод строк отчета.
	Для каждого СтрокаТаблицы Из ТаблицаРасчетов Цикл
		
		ОбластьСтрока.Параметры.Заполнить(СтрокаТаблицы);
		
		Если СтрокаТаблицы.Услуга.ТипыНачислений = Перечисления.бит_ТипыНачисленийПоЖКХ.Эксплуатационная тогда
			ОбластьСтрока.Параметры.Объем_ЕдИзм = Строка(СтрокаТаблицы.Площадь) + " " + Строка(СтрокаТаблицы.ЕдИзм);
			ОбластьСтрока.Параметры.Тариф       = СтрокаТаблицы.ОсновнаяСтавка;
		иначе                                     
			ОбластьСтрока.Параметры.Объем_ЕдИзм = Строка(СтрокаТаблицы.Объем) + " " + Строка(СтрокаТаблицы.ЕдИзм);
		КонецЕсли;
		
		ТабличныйДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла; 
	
	// Вывод итога.
	ОбластьИтог.Параметры.ИтогоБезЛьгот  = БезЛьгот;
	ОбластьИтог.Параметры.ИтогСоЛьготами = СУчетомЛьгот;
	
	ТабличныйДокумент.Вывести(ОбластьИтог);
	
	// Вывод подвала.
	ВХСальдо = ВХСальдо - Оплата - Разовые;
	
	Если ВХСальдо <= 0 тогда
		ВХСальдоСтр = "Задолженности нет"; 
	Иначе
		ВХСальдоСтр = Формат(ВХСальдо, "Л=ru; ЧДЦ=2; ЧГ=3,0") + " руб."; 
	КонецЕсли;
	
	ОбластьПодвал.Параметры.ВХСальдо                 = ВХСальдоСтр;
	ОбластьПодвал.Параметры.ТипЗапирающегоУстройства = СведенияОбЛС.ТипЗапирающегоУстройства;
	ОбластьПодвал.Параметры.ИтогоБезЛьгот            = ИтогоБезЛьготСтр;
	ОбластьПодвал.Параметры.ИтогЛьготы               = ИтогЛьготыСтр;
	ОбластьПодвал.Параметры.СтатусКвартиры           = ВРег(Строка(СведенияОбЛС.СтатусКвартиры));
	
	ОбластьПодвал.Параметры.Организация = Строка(ПараметрыОтчета.ЛицевойСчет.Организация);
	ОбластьПодвал.Параметры.Дата = Формат(ПараметрыОтчета.Период,"ДЛФ=DD");
	ТабличныйДокумент.Вывести(ОбластьПодвал);
	
КонецПроцедуры // () 

// Процедура заполняет макет остатки.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьМакетОстатки(ПараметрыОтчета, ТабличныйДокумент)
	
	ТабличныйДокумент.Очистить();
	
	СведенияОбЛС = ПолучитьСведенияОбЛицевомСчете(ПараметрыОтчета);
	
	Если СведенияОбЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Макет = ПолучитьМакет("ФинансовоЛицевойСчет_Остатки");
	
	ПодвалОборот        = Макет.ПолучитьОбласть("ПодвалОборот");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	СтрокаМесяцГод      = Макет.ПолучитьОбласть("СтрокаМесяцГод");
	СтрокаМесяцГодКол   = Макет.ПолучитьОбласть("СтрокаМесяцГодКол");
	ШапкаУслуги         = Макет.ПолучитьОбласть("ШапкаУслуги");
	ШапкаУслуга         = Макет.ПолучитьОбласть("ШапкаУслуга");
	ШапкаУслуг          = Макет.ПолучитьОбласть("ШапкаУслуг");
	СтрокаУслуга        = Макет.ПолучитьОбласть("СтрокаУслуга");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода"  , ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода"   , КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет"    , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("ТаблицаОстатков", ПолучитьТаблицуОстатков(ПараметрыОтчета));
	Запрос.Текст = ПолучитьТекстЗапросаОстатки();
	
	ОбластьШапка.Параметры.НомерЛС       = СведенияОбЛС.ЛицевойСчет;
	ОбластьШапка.Параметры.Организация   = СведенияОбЛС.Организация;
	// БИТ_ЖКХ_05082013_начало_изменений
	// ОбластьШапка.Параметры.Улица         = СведенияОбЛС.Улица;. 
	Если ПараметрыОтчета.ВыводитьПочтовыйАдрес Тогда
		Если ЗначениеЗаполнено(ПараметрыОтчета.ЛицевойСчет.Здание.ПочтовыйАдрес) Тогда
			АдресСтруктура = бит_ПаспортныйСтолСервер.ПолучитьСтруктуруАдресаИзКонтактнойИнформации(ПараметрыОтчета.ЛицевойСчет.Здание,
			Перечисления.бит_ТипыКонтактнойИнформации.Адрес,Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания);
			АдресЛС = ?(ЗначениеЗаполнено(АдресСтруктура.Индекс),АдресСтруктура.Индекс + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.Регион),АдресСтруктура.Регион + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.Район),АдресСтруктура.Район + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.Город),АдресСтруктура.Город + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.НасПункт),АдресСтруктура.НасПункт + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.Улица),АдресСтруктура.Улица, "");			
		Иначе

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните почтовый адрес у здания");
			
			АдресЛС = Строка(ПараметрыОтчета.ЛицевойСчет.УлицаЛицевогоСчета);			
		КонецЕсли;
	Иначе
		АдресЛС = Строка(ПараметрыОтчета.ЛицевойСчет.УлицаЛицевогоСчета);
	КонецЕсли;
	ОбластьШапка.Параметры.Улица         = АдресЛС;
	// БИТ_ЖКХ_05082013_окончание_изменений
	ОбластьШапка.Параметры.Дом           = СведенияОбЛС.Здание;
	ОбластьШапка.Параметры.Квартира      = СведенияОбЛС.Квартира;
	ОбластьШапка.Параметры.Корпус        = СведенияОбЛС.Корпус;
	ОбластьШапка.Параметры.Этаж          = СведенияОбЛС.Этаж;
	ОбластьШапка.Параметры.ДД            = Формат(ПараметрыОтчета.КонецПериода,"ДФ=dd");
	ОбластьШапка.Параметры.месяц         = Формат(ПараметрыОтчета.КонецПериода,"ДФ=ММMM");
	ОбластьШапка.Параметры.ГГГГ          = Формат(ПараметрыОтчета.КонецПериода,"ДФ=yyyy");
	ОбластьШапка.Параметры.Ответственный = СведенияОбЛС.Ответственный;
	ОбластьШапка.Параметры.Телефон       = бит_ОбщегоНазначения.ПолучитьТелефонИзКонтактнойИнформацииФизЛица(СведенияОбЛС.Ответственный);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаУслуга = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Услуга");
	// БИТ_ЖКХ_05082013_начало_изменений
	ТаблицаУслуг = Результат.Выгрузить();
	// БИТ_ЖКХ_05082013_окончание_изменений
	ТабличныйДокумент.Вывести(ШапкаУслуги);
	
	СписокУслуг = Новый Массив;
	
	Пока ВыборкаУслуга.Следующий() Цикл
		
		// БИТ_ЖКХ_05082013_начало_изменений
		ОтборУслуг = Новый Структура("Услуга",ВыборкаУслуга.Услуга);
		МассивУслуг = ТаблицаУслуг.НайтиСтроки(ОтборУслуг);
		ВыводитьУслугу = Ложь;
		Для Каждого ЭлементМассива Из МассивУслуг Цикл
			Если ЭлементМассива.Сумма <> 0 Тогда
				ВыводитьУслугу = Истина;
			КонецЕсли;
		КонецЦикла;

		Если ВыводитьУслугу Тогда
			// БИТ_ЖКХ_05082013_окончание_изменений
			
			ШапкаУслуга.Параметры.Заполнить(ВыборкаУслуга);
			ТабличныйДокумент.Присоединить(ШапкаУслуга );
			
			СписокУслуг.Добавить(ВыборкаУслуга.Услуга);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ТабличныйДокумент.Присоединить(ШапкаУслуг);
	
	ВыборкаМесяцГод = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаМесяцГод.Следующий() Цикл
		
		ИсхСальдо = ?(ПараметрыОтчета.СУчетомПереплаты, ВыборкаМесяцГод.ИсхСальдо, ВыборкаМесяцГод.КОплате);
		
		Если НЕ ЗначениеЗаполнено(ВыборкаМесяцГод.Сумма) И НЕ ЗначениеЗаполнено(ВыборкаМесяцГод.Оплата) Тогда
			Продолжить;
		КонецЕсли; 
		
		ТаблицаПроживающих = ПолучитьТаблицуПроживающих(КонецМесяца(Дата(ВыборкаМесяцГод.МесяцГод)), ПараметрыОтчета.ЛицевойСчет);
		Ответственный         = Справочники.бит_Проживающие.ПустаяСсылка();
		КоличествоПроживающих = 0;
		
		Для каждого СтрокаТабилцы Из ТаблицаПроживающих Цикл
			
			Если СтрокаТабилцы.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
				Ответственный = СтрокаТабилцы.ФизЛицо;
			КонецЕсли; 
			
			Если СтрокаТабилцы.СтатусФизЛица.ПроживаниеВДанныйМомент Тогда
				КоличествоПроживающих = КоличествоПроживающих + 1;
			КонецЕсли; 
			
		КонецЦикла; 
		
		СтрокаМесяцГод.Параметры.Заполнить(ВыборкаМесяцГод);
		СтрокаМесяцГод.Параметры.Ответственный = Ответственный;
		ТабличныйДокумент.Вывести(СтрокаМесяцГод,ВыборкаМесяцГод.Уровень(), "МесяцГод");
		
		ВыборкаУслуга = ВыборкаМесяцГод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Услуга", "ВСЕ");
		
		Пока ВыборкаУслуга.Следующий() Цикл
			
			Если НЕ СписокУслуг.Найти(ВыборкаУслуга.Услуга) = Неопределено Тогда
				
				СтрокаУслуга.Параметры.Заполнить(ВыборкаУслуга);
				
				ТабличныйДокумент.Присоединить(СтрокаУслуга);
				
			КонецЕсли;
			
		КонецЦикла;
		СтрокаМесяцГодКол.Параметры.Заполнить(ВыборкаМесяцГод);
		СтрокаМесяцГодКол.Параметры.Начислено  = ВыборкаМесяцГод.Сумма;
		СтрокаМесяцГодКол.Параметры.Количество = КоличествоПроживающих;
		ТабличныйДокумент.Присоединить(СтрокаМесяцГодКол);
		
	КонецЦикла;
	
	ПодвалОборот.Параметры.ДатаФормОтчета = Формат(ПараметрыОтчета.КонецПериода,"ДФ=dd.MM.yyyy");
	ПодвалОборот.Параметры.Сумма = ИсхСальдо;
	
	// Kordo-sysoev 17.01.2014 
	ОтветственныеЛица = бит_ОбщегоНазначения.бит_ОтветственныеЛица(СведенияОбЛС.Организация, КонецДня(ПараметрыОтчета.КонецПериода));
	ПодвалОборот.Параметры.РуководительРасчетнойСлужбы = ?(ОтветственныеЛица.РуководительРасчетнойСлужбы = Неопределено, "",ОтветственныеЛица.РуководительРасчетнойСлужбы);
	ПодвалОборот.Параметры.Специалист = ?(ОтветственныеЛица.Специалист = Неопределено, "",ОтветственныеЛица.Специалист);
	ПодвалОборот.Параметры.РуководительРасчетнойСлужбыДолжность = ?(ОтветственныеЛица.РуководительРасчетнойСлужбыДолжность = Неопределено, "Руководитель расчетной службы",ОтветственныеЛица.РуководительРасчетнойСлужбыДолжность);
	ПодвалОборот.Параметры.СпециалистДолжность   = ?(ОтветственныеЛица.СпециалистДолжность = Неопределено, "Специалист",ОтветственныеЛица.СпециалистДолжность);
	// Kordo-sysoev 17.01.2014
	
	ТабличныйДокумент.Вывести(ПодвалОборот);
	
КонецПроцедуры // () 

// Процедура заполняет полный макет.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьМакетПолный(ПараметрыОтчета, ТабличныйДокумент)
	
	ТабличныйДокумент.Очистить();
	
	СведенияОбЛС = ПолучитьСведенияОбЛицевомСчете(ПараметрыОтчета);
	
	Если СведенияОбЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный
		ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Основной Тогда
		
		ПолныйСтраница1(ПараметрыОтчета, ТабличныйДокумент, СведенияОбЛС);
		
	КонецЕсли;
	
	Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный Тогда
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли; 
	
	Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный
		ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСтр2 Тогда
		
		ПолныйСтраница2(ПараметрыОтчета, ТабличныйДокумент, СведенияОбЛС);
		
	КонецЕсли; 
	
	//29.08.2019
	Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСПеня
		ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСПеняСтр2 Тогда
		
		ПолныйСтраница2СПеня(ПараметрыОтчета, ТабличныйДокумент, СведенияОбЛС);
		
	КонецЕсли; 

	
КонецПроцедуры // ()

//28.08.2019
// Процедура заполняет полный макет.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьМакетПолныйСПеня(ПараметрыОтчета, ТабличныйДокумент)
	
	ТабличныйДокумент.Очистить();
	
	СведенияОбЛС = ПолучитьСведенияОбЛицевомСчете(ПараметрыОтчета);
	
	Если СведенияОбЛС = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный
		ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Основной Тогда
		
		ПолныйСтраница1(ПараметрыОтчета, ТабличныйДокумент, СведенияОбЛС);
		
	КонецЕсли;
	
	Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный Тогда
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли; 
	
	Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный
		ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСтр2 Тогда
		
		ПолныйСтраница2(ПараметрыОтчета, ТабличныйДокумент, СведенияОбЛС);
		
	КонецЕсли; 
	
	//29.08.2019
	Если ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСПеня
		ИЛИ ПараметрыОтчета.ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСПеняСтр2 Тогда
		
		ПолныйСтраница2СПеня(ПараметрыОтчета, ТабличныйДокумент, СведенияОбЛС);
		
	КонецЕсли; 

	
КонецПроцедуры // ()


// Процедура заполняет страницу 1.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ПолныйСтраница1(ПараметрыОтчета, ТабличныйДокумент, СведенияОбЛС)
	
	Макет = ПолучитьМакет("ФинансовоЛицевойСчет");
	
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ОбластьУслуги       = Макет.ПолучитьОбласть("ОбластьУслуги");
	ОбластьУслугиПустая	= Макет.ПолучитьОбласть("ОбластьУслугиПустая");
	ОбластьХарКвартиры  = Макет.ПолучитьОбласть("ОбластьХарКвартиры");
	ОбластьКомнаты      = Макет.ПолучитьОбласть("ОбластьКомнаты");
	
	ОбластьШапка.Параметры.НомерЛС       = СведенияОбЛС.ЛицевойСчет;
	ОбластьШапка.Параметры.Организация   = СведенияОбЛС.Организация;
	// БИТ_ЖКХ_05082013_начало_изменений
	// ОбластьШапка.Параметры.Улица         = СведенияОбЛС.Улица;.
	Если ПараметрыОтчета.ВыводитьПочтовыйАдрес Тогда
		Если ЗначениеЗаполнено(ПараметрыОтчета.ЛицевойСчет.Здание.ПочтовыйАдрес) Тогда
			АдресСтруктура = бит_ПаспортныйСтолСервер.ПолучитьСтруктуруАдресаИзКонтактнойИнформации(ПараметрыОтчета.ЛицевойСчет.Здание,
			Перечисления.бит_ТипыКонтактнойИнформации.Адрес,Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания);
			АдресЛС = ?(ЗначениеЗаполнено(АдресСтруктура.Индекс),АдресСтруктура.Индекс + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.Регион),АдресСтруктура.Регион + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.Район),АдресСтруктура.Район + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.Город),АдресСтруктура.Город + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.НасПункт),АдресСтруктура.НасПункт + ", ","")
			+ ?(ЗначениеЗаполнено(АдресСтруктура.Улица),АдресСтруктура.Улица, "");			
		Иначе

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните почтовый адрес у здания");
			
			АдресЛС = Строка(ПараметрыОтчета.ЛицевойСчет.УлицаЛицевогоСчета);			
		КонецЕсли;
	Иначе
		АдресЛС = Строка(ПараметрыОтчета.ЛицевойСчет.УлицаЛицевогоСчета);
	КонецЕсли;
	ОбластьШапка.Параметры.Улица         = АдресЛС;
	// БИТ_ЖКХ_05082013_окончание_изменений
	ОбластьШапка.Параметры.Дом           = СведенияОбЛС.Здание;
	ОбластьШапка.Параметры.Квартира      = СведенияОбЛС.Квартира;
	ОбластьШапка.Параметры.Корпус        = СведенияОбЛС.Корпус;
	ОбластьШапка.Параметры.Этаж          = СведенияОбЛС.Этаж;
	ОбластьШапка.Параметры.ДД            = Формат(ПараметрыОтчета.КонецПериода,"ДФ=dd");
	ОбластьШапка.Параметры.месяц         = Формат(ПараметрыОтчета.КонецПериода,"ДФ=ММMM");
	ОбластьШапка.Параметры.ГГГГ          = Формат(ПараметрыОтчета.КонецПериода,"ДФ=yyyy");
	ОбластьШапка.Параметры.Ответственный = СведенияОбЛС.Ответственный;
	ОбластьШапка.Параметры.Телефон       = бит_ОбщегоНазначения.ПолучитьТелефонИзКонтактнойИнформацииФизЛица(СведенияОбЛС.Ответственный);
	
	ТабличныйДокумент.Вывести(ОбластьШапка);
	
	// Правоустанавливающие документы.
	ТаблицаСписокДокументов = ПолучитьТаблицуПравоустанавливающихДокументов(КонецДня(ПараметрыОтчета.КонецПериода), ПараметрыОтчета.ЛицевойСчет);
	
	// Сведения о комнатах квартиры.
	ТаблицаКомнат =  ПолучитьТаблицуКомнат(КонецДня(ПараметрыОтчета.КонецПериода), СведенияОбЛС.Квартира);
	
	ПлощадьКухни = 0;
	
	Для каждого СтрокаКухня Из ТаблицаКомнат Цикл
		
		Если СтрокаКухня.Комната = Справочники.бит_НазначениеЧастейПомещения.Кухня Тогда
			ПлощадьКухни = ПлощадьКухни + СтрокаКухня.ПлощадьКомнаты;
		КонецЕсли;
		
	КонецЦикла;
	
	СтруктураПлощадьКухни = Новый Структура;
	СтруктураПлощадьКухни.Вставить("ПлощадьКухни",ПлощадьКухни);
	
	мНомерСтроки = 7;
	
	Индекс       = 0;
	ИндексКомнат = 0;
	
	ТаблицаПроживающих    = ПолучитьТаблицуПроживающих(КонецДня(ПараметрыОтчета.КонецПериода), ПараметрыОтчета.ЛицевойСчет);
	КоличествоПроживающих = 0;
	
	// БИТ_ЖКХ 18.07.2014
	// КоличествоПроживающих = ТаблицаПроживающих.Количество();.
	Для каждого СтрокаПроживающий из ТаблицаПроживающих Цикл 
		
		Если СтрокаПроживающий.СтатусФизЛица.ПроживаниеВДанныйМомент Тогда
			КоличествоПроживающих = КоличествоПроживающих + 1;
		КонецЕсли; 
		
	КонецЦикла;
	// БИТ_ЖКХ 18.07.2014	
	
	Для каждого СтрокаТаблицы Из СведенияОбЛС.СписокУслуг Цикл
		
		Если СтрокаТаблицы.РежимПотребления = Справочники.бит_РежимыПотребленияУслуг.Нет Тогда
			Продолжить;
		КонецЕсли;
		
		Если ПараметрыОтчета.ЗаполненоГЦЖС И СтрокаТаблицы.ГрафаОтчетаГЦЖС.Пустая() Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Индекс < 16 Тогда
			Индекс = Индекс + 1;
			ОбластьУслуги.Параметры.Заполнить(СтрокаТаблицы);
			ТабличныйДокумент.Вывести(ОбластьУслуги);  
			
			Секция = Макет.ПолучитьОбласть("R"+мНомерСтроки+"C36:R"+мНомерСтроки+"C69");
			Секция.Параметры.Заполнить(СведенияОбЛС);
			
			Если Индекс > 7 Тогда                                 
				Если ТаблицаКомнат.Количество()> 0 И ИндексКомнат < ТаблицаКомнат.Количество() Тогда
					Если ТаблицаКомнат[Индекс - 8].Комната <> Справочники.бит_НазначениеЧастейПомещения.Кухня  Тогда
						
						Попытка	
							Секция.Параметры.НомерКомнаты = ИндексКомнат+1;
							Секция.Параметры.Заполнить(ТаблицаКомнат[Индекс - 8]);
						Исключение
						КонецПопытки;	
					КонецЕсли; 
					
					ИндексКомнат = ИндексКомнат + 1;
				КонецЕсли; 
				
			КонецЕсли;
			
			Попытка
				Секция.Параметры.КоличествоПроживающих = КоличествоПроживающих;
			Исключение
			КонецПопытки; 
			
			ТабличныйДокумент.Присоединить(Секция);
			
			ТабличныйДокумент.Присоединить(Секция);
			
		КонецЕсли;
		
		мНомерСтроки = мНомерСтроки + 1;
		
	КонецЦикла;
	
	Пока мНомерСтроки < 22 Цикл 
		
		ТабличныйДокумент.Вывести(ОбластьУслугиПустая);
		Секция = Макет.ПолучитьОбласть("R"+мНомерСтроки+"C36:R"+мНомерСтроки+"C69");
		Секция.Параметры.Заполнить(СведенияОбЛС);
		
		Индекс = Индекс + 1;
		
		Если Индекс > 7 Тогда                                 
			Если ТаблицаКомнат.Количество()> 0 И ИндексКомнат < ТаблицаКомнат.Количество() Тогда
				Если ТаблицаКомнат[Индекс - 8].Комната <> Справочники.бит_НазначениеЧастейПомещения.Кухня  Тогда
					
					Попытка
						Секция.Параметры.НомерКомнаты = ИндексКомнат+1;
						Секция.Параметры.Заполнить(ТаблицаКомнат[Индекс - 8]);
					Исключение
						
					КонецПопытки;
				КонецЕсли; 
				
				ИндексКомнат = ИндексКомнат + 1;
			КонецЕсли;
		КонецЕсли;
		
		Попытка
			Секция.Параметры.КоличествоПроживающих = КоличествоПроживающих;
		Исключение
		КонецПопытки;
		Секция.Параметры.Заполнить(СтруктураПлощадьКухни);
		ТабличныйДокумент.Присоединить(Секция);
		мНомерСтроки = мНомерСтроки + 1;
		
	КонецЦикла;
	
	// Формирование блока - заполнение документов-оснований, до 6 док-тов.
	Секция = Макет.ПолучитьОбласть("R7C70:R7C103");
	ТабличныйДокумент.ВставитьОбласть(Секция.Область(), ТабличныйДокумент.Область("R7C70:R7C103"),,Истина);
	
	СчетчикСтрок = 8;
	
	Если ТаблицаСписокДокументов.Количество()>0 Тогда
		// Формирование строк с данными документов.
		Для каждого СтрокаДокументов Из ТаблицаСписокДокументов Цикл
			Адрес 	= Строка("R" + СчетчикСтрок + "C70:R" + (СчетчикСтрок+1) + "C103");
			Секция 	= Макет.ПолучитьОбласть(Адрес);
			Секция.Параметры.Заполнить(СтрокаДокументов);
			Секция.Параметры.ДатаДокумента = Формат(СтрокаДокументов.ДатаДокумента,"ДФ=dd.MM.yy");
			Если ЗначениеЗаполнено(СтрокаДокументов.ОрганизацияВыдавшаяДокумент.НаименованиеПолное) Тогда
				Секция.Параметры.ОрганизацияВыдавшаяДокумент =  СтрокаДокументов.ОрганизацияВыдавшаяДокумент.НаименованиеПолное;
			КонецЕсли; 
			ТабличныйДокумент.ВставитьОбласть(Секция.Область(), ТабличныйДокумент.Область(Адрес),,Истина);
			СчетчикСтрок  = СчетчикСтрок + 2;
		КонецЦикла;
	КонецЕсли;
	
	// Формирование строк в списке документов без данных.
	Если СчетчикСтрок < 20 Тогда
		Пока СчетчикСтрок < 20 Цикл
			Адрес = Строка("R" + СчетчикСтрок + "C70:R" + (СчетчикСтрок+1) + "C103");
			Секция = Макет.ПолучитьОбласть(Адрес);
			ТабличныйДокумент.ВставитьОбласть(Секция.Область(), ТабличныйДокумент.Область(Адрес),,Истина);
			СчетчикСтрок  = СчетчикСтрок + 2;
			
		КонецЦикла; 
	КонецЕсли;
	
	// Вывод строки после списка документов.
	Если СчетчикСтрок = 20 Тогда
		
		Секция = Макет.ПолучитьОбласть("R" + СчетчикСтрок + "C70:R" + СчетчикСтрок + "C103");
		ТабличныйДокумент.ВставитьОбласть(Секция.Область(), ТабличныйДокумент.Область("R" + СчетчикСтрок + "C70:R" + СчетчикСтрок + "C103"),,Ложь);
		
	КонецЕсли;
	
	ТаблицаПроживающихИстория = ПолучитьТаблицуПроживающих(КонецДня(ПараметрыОтчета.КонецПериода)
	, ПараметрыОтчета.ЛицевойСчет
	, ПараметрыОтчета.ИсторияПроживающих);
	
	ШапкаПровающие    = Макет.ПолучитьОбласть("ШапкаПровающие");
	СтрокаПроживающие = Макет.ПолучитьОбласть("СтрокаПроживающие");
	
	ТабличныйДокумент.Вывести(ШапкаПровающие);
	
	Для Каждого СтрокаТаблицы Из ТаблицаПроживающихИстория Цикл 
		
		СтрокаПроживающие.Параметры.Заполнить(СтрокаТаблицы);
		
		Если ПараметрыОтчета.СтатусФизЛица Тогда
			Если СтрокаТаблицы.СтатусФизЛица <> Справочники.бит_СтатусФизЛица.Выписан 
				И СтрокаТаблицы.СтатусФизЛица.ПроживаниеВДанныйМомент = Ложь Тогда
				
				СтрокаПроживающие.Параметры.ДатаСнятияСРегистрации = "бронь";
			Иначе
				СтрокаПроживающие.Параметры.ДатаСнятияСРегистрации =  Формат(СтрокаТаблицы.ДатаСнятияСРегистрации,"ДФ=dd.MM.yyyy");
				
			КонецЕсли; 
			
		Иначе
			СтрокаПроживающие.Параметры.ДатаСнятияСРегистрации =  Формат(СтрокаТаблицы.ДатаСнятияСРегистрации,"ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		СтрокаПроживающие.Параметры.ФИО = СтрокаТаблицы.ФизЛицо;
		
		// БИТ_ЖКХ 28.05.2014
		// ТабличныйДокумент.Вывести(СтрокаПроживающие);.
		
		Если НЕ ПараметрыОтчета.НеВыводитьНеПроживающих Тогда
			
			ТабличныйДокумент.Вывести(СтрокаПроживающие);
			
		Иначе
			
			Если НЕ СтрокаПроживающие.Параметры.СтатусПроживания = ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.НеПроживает") Тогда
				
				ТабличныйДокумент.Вывести(СтрокаПроживающие);
				
			КонецЕсли;
			
		КонецЕсли;
		// БИТ_ЖКХ 28.05.2014
		
	КонецЦикла;
	
	// Заполнения таблицы "Льготы".
	Если НЕ ПараметрыОтчета.СведенияОЛьготах Тогда
		
		ТаблицаЛьготников = ПолучитьТаблицуИнформацииОЛьготниках(КонецДня(ПараметрыОтчета.КонецПериода)
		, ПараметрыОтчета.ЛицевойСчет);
		
		ШапкаЛьготы   = Макет.ПолучитьОбласть("ШапкаЛьготы");
		СтрокаЛьготы  = Макет.ПолучитьОбласть("СтрокаЛьготы");
		
		ТабличныйДокумент.Вывести(ШапкаЛьготы);
		
		Для каждого СтрокаТаблицы Из ТаблицаЛьготников Цикл
			
			СтрокаЛьготы.Параметры.Заполнить(СтрокаТаблицы);
			СтрокаЛьготы.Параметры.ДокументНаЛьготу = ""+СтрокаТаблицы.ДокументНаЛьготу+Формат(СтрокаТаблицы.ДатаВыдачи,"ДФ=dd.MM.yyyy"); 
			
			ТабличныйДокумент.Вывести(СтрокаЛьготы);
			
		КонецЦикла;
		
	КонецЕсли; 
	
