					МассивСтруктур = Новый Массив;
					Для каждого СтрокаРезультат Из Результат Цикл
						СтруктураДанных = Новый Структура("Тип,Вид,Представление,Индекс,Регион,
						|Район,Город,НасПункт,Улица,Дом,Корпус,Квартира,Страна,Комментарий,
