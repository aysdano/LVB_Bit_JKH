&НаСервере
Процедура ЗаполнитьКвартирыПоказанийПоСчетчикам(СортироватьПоНомеруКвартиры = ложь)
	
	ТаблицаПС = Объект.ПоказанияПоСчетчикам.Выгрузить();
	
	
	ТаблицаНомеров = ПолучитьТаблицуКвартирПоказанияПоСчетчикам(ТаблицаПС, СортироватьПоНомеруКвартиры);	
	Объект.ПоказанияПоСчетчикам.Загрузить(ТаблицаНомеров);
  	 
	
КонецПроцедуры

// Функция возвращает таблицу значений с квартирами лицевых счетов.
//
// Параметры
//  ТаблицаПС   - Таблица значений со списком списком показаний счетчиков.
//
// Возвращаемое значение:
//   ТаблицаЗначений - Таблица показаний счетчиков с квартирами. Колонки: НомерСтроки, ОсновноеСредство, ИнвентарныйНомер.
//
Функция ПолучитьТаблицуКвартирПоказанияПоСчетчикам(ТаблицаПС, СортироватьПоНомеруКвартиры = ложь)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("МассивЛС", ТаблицаПС.ВыгрузитьКолонку("ЛицевойСчет"));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Квартира КАК Квартира,
	|	бит_ЛицевыеСчета.Квартира.НомерКвартиры КАК НомерКвартиры
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка В(&МассивЛС)";
	
	ТаблицаЗапроса = Запрос.Выполнить().Выгрузить();;
	
	ТаблицаРезультата = ТаблицаПС.Скопировать();
	Если ТаблицаРезультата.Колонки.Найти("Квартира") = Неопределено Тогда 
		ТаблицаРезультата.Колонки.Добавить("Квартира", Новый ОписаниеТипов("СправочникСсылка.бит_Квартиры"));
	КонецЕсли;
	
	Для Каждого СтрокаЗапроса Из ТаблицаЗапроса Цикл
		
		СтрокиРезультата = ТаблицаРезультата.НайтиСтроки(Новый Структура("ЛицевойСчет", СтрокаЗапроса.ЛицевойСчет));
		
		Если СтрокиРезультата.Количество() > 0 Тогда
			Для Каждого Стр Из СтрокиРезультата Цикл
				Стр.Квартира = СтрокаЗапроса.Квартира;
				Стр.НомерКвартиры = СтрокаЗапроса.Квартира.НомерКвартиры;
			КонецЦикла;
		КонецЕсли;
	
	КонецЦикла;
	// БИТ ЖКХ 27.10.2020
	если СортироватьПоНомеруКвартиры = истина тогда
	 //ТаблицаРезультата.Сортировать("НомерКвартиры");
	 ТаблицаРезультата.Сортировать("Дом Возр, НомерКвартиры Возр, ЛицевойСчет Возр, Счетчик Возр, Услуга Возр");	
	конецесли;
	Возврат ТаблицаРезультата;

КонецФункции

