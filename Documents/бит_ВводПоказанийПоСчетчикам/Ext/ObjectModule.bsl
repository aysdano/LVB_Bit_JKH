	|			И ВТ_ПоказанияПодкруткиИтого.УслугаЖКХ = ВТ_КолЕдиницПоСчетчикам.УслугаЖКХ
	|			И ВТ_ПоказанияПодкруткиИтого.Счетчик = ВТ_КолЕдиницПоСчетчикам.Счетчик
	|;
