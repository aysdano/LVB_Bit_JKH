
#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура управляет показом в форме периода построения отчета.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ПоказатьПериод(Форма)
	
	НомерМесяца = Месяц(Форма.мДатаКонцаПериодаОтчета);
	флКвартал = (НомерМесяца=3 ИЛИ НомерМесяца = 6 ИЛИ НомерМесяца = 9 ИЛИ НомерМесяца = 12);
	
	Если НачалоМесяца(Форма.мДатаКонцаПериодаОтчета) = Форма.мДатаНачалаПериодаОтчета Тогда
		СтрПериодОтчета = Формат(Форма.мДатаКонцаПериодаОтчета, "ДФ = 'ММММ гггг'") + " г.";
	Иначе
		Если флКвартал Тогда
			СтрПериодОтчета = ПредставлениеПериода( НачалоДня(Форма.мДатаНачалаПериодаОтчета), КонецДня(Форма.мДатаКонцаПериодаОтчета), "ФП = Истина" );	
		Иначе		
			СтрПериодОтчета = "Январь - " + Формат(Форма.мДатаКонцаПериодаОтчета, "ДФ = 'ММММ гггг'") + " г.";
		КонецЕсли;
	КонецЕсли;
	
	// Покажем период в диалоге
	Форма.НадписьПериодСоставленияОтчета = СтрПериодОтчета;
	
КонецПроцедуры // ПоказатьПериод()

// Процедура устанавливает границы периода построения отчета.
//
// Параметры:
//  Шаг          - число, количество стандартных периодов, на которое необходимо.
//                 Сдвигать период построения отчета.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьПериод(Форма, Шаг)
	
	Форма.мДатаКонцаПериодаОтчета  = ДобавитьМесяц(Форма.мДатаКонцаПериодаОтчета, Шаг);
	Форма.мДатаКонцаПериодаОтчета  = КонецМесяца(Форма.мДатаКонцаПериодаОтчета);
	Форма.мДатаНачалаПериодаОтчета = НачалоМесяца(Форма.мДатаКонцаПериодаОтчета);
	
	ПоказатьПериод(Форма);
	
	ОбновитьТекстЗаголовка(Форма);
	
КонецПроцедуры // ИзменитьПериод()

#КонецОбласти

#Область ПроцедурыДействияКомандныхПанелейФормы

&НаКлиенте
Процедура ПанельНастроек(Команда)
	
	Элементы.ГруппаНастройки.Видимость = НЕ Элементы.ГруппаНастройки.Видимость;
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура УстановитьПредыдущийПериод(Команда)
	
	// Бухгалтерская отчетность составляется помесячно.
	ИзменитьПериод(ЭтаФорма, -1);
	
КонецПроцедуры // УстановитьПредыдущийПериод()

&НаКлиенте
Процедура УстановитьСледующийПериод(Команда)
	
	// Бухгалтерская отчетность составляется помесячно.
	ИзменитьПериод(ЭтаФорма, 1);
	
КонецПроцедуры // УстановитьСледующийПериод()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	бит_ОтчетыВызовСервера.ПриСозданииНаСервере(ЭтаФорма, Отказ, СтандартнаяОбработка);
	
	Параметры.Свойство("ГруппаУслуги", Отчет.ГруппаУслуги);
	Параметры.Свойство("Организация", Отчет.Организация);
	// БИТ_ЖКХ_13012014_начало_изменений
	Параметры.Свойство("ТарифНаГВС_НеУтвержден", Отчет.ТарифНаГВС_НеУтвержден);
	// БИТ_ЖКХ_13012014_окончание_изменений
	
	// Устнавливаем границы периода построения отчета как месяц.
	// Предшествующий текущему, нарастающим итогом с начала года.
	Если НЕ ЗначениеЗаполнено(мДатаНачалаПериодаОтчета) И НЕ ЗначениеЗаполнено(мДатаКонцаПериодаОтчета) Тогда
		
		мДатаКонцаПериодаОтчета  = КонецМесяца(ДобавитьМесяц(КонецМесяца(ТекущаяДатаСеанса()), -1));
		мДатаНачалаПериодаОтчета = НачалоМесяца(мДатаКонцаПериодаОтчета);
		
	КонецЕсли;
	
	ИзменитьПериод(ЭтаФорма, 0);
	
	ПоказатьПериод(ЭтаФорма);
	
КонецПроцедуры

