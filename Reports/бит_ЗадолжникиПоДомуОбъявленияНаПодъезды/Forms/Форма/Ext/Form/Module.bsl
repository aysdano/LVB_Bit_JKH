&НаСервере
Процедура ИнициализироватьЭлементы()
	
	ГруппаВыгрузка = ЭтаФорма.Элементы.Добавить("ГруппаОбычная", Тип("ГруппаФормы"));
	ГруппаВыгрузка.Вид = ВидГруппыФормы.ОбычнаяГруппа;
	ГруппаВыгрузка.Отображение = ОтображениеОбычнойГруппы.Нет;
	ГруппаВыгрузка.ОтображатьЗаголовок = ЛОЖЬ;
	ГруппаВыгрузка.Группировка = ГруппировкаПодчиненныхЭлементовФормы.ГоризонтальнаяВсегда;
	Элементы.Переместить(ГруппаВыгрузка, ЭтаФорма, Элементы.Объявление);
	
	ДобавляемыеРеквизиты = Новый Массив;
	НовыйРеквизит = Новый РеквизитФормы("Каталог",Новый ОписаниеТипов("Строка",,));
	ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("Каталог", Тип("ПолеФормы"), ГруппаВыгрузка);
	НовыйЭлемент.Вид = ВидПоляФормы.ПолеВвода;
	НовыйЭлемент.КнопкаВыбора = Истина;
	НовыйЭлемент.ПутьКДанным = "Каталог";
	НовыйЭлемент.УстановитьДействие("НачалоВыбора", "КаталогНачалоВыбора");
	
	НоваяКоманда = ЭтаФорма.Команды.Добавить("СохранитьВФайлы");
	НоваяКоманда.Заголовок = "Сохранить в файлы";
	НоваяКоманда.Действие = "СохранитьВФайлы";
	
	НовыйЭлемент = ЭтаФорма.Элементы.Добавить("СохранитьВФайлы", Тип("КнопкаФормы"), ГруппаВыгрузка);
	НовыйЭлемент.Заголовок = "Сохранить в файлы";
	НовыйЭлемент.ИмяКоманды = "СохранитьВФайлы";
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбораКаталогаИмпорта = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталогаИмпорта.Заголовок = "Выберите каталог для выгрузки ";
	ДиалогВыбораКаталогаИмпорта.ПроверятьСуществованиеФайла = Истина;
	ДиалогВыбораКаталогаИмпорта.Каталог = ЭтаФорма.Каталог;
	
	Оповещение = Новый ОписаниеОповещения("ВыборКаталогаЗавершение", ЭтотОбъект);
	ДиалогВыбораКаталогаИмпорта.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКаталогаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено Тогда
		Каталог = Результат[0];
	Иначе
		ПоказатьПредупреждение(,"Каталог не выбран!");
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИмя(С)
	
	Рез = С;
	Рез = СтрЗаменить(Рез, "\", "");
	Рез = СтрЗаменить(Рез, "/", "");
	Рез = СтрЗаменить(Рез, ":", "");
	Рез = СтрЗаменить(Рез, "*", "");
	Рез = СтрЗаменить(Рез, "?", "");
	Рез = СтрЗаменить(Рез, """", "");
	Рез = СтрЗаменить(Рез, "<", "");
	Рез = СтрЗаменить(Рез, ">", "");
	Рез = СтрЗаменить(Рез, "|", "");
	Рез = СтрЗаменить(Рез, "+", "");
	
	Имя = СокрЛП(Рез);
	
	Возврат Имя;
	
КонецФункции

&НаКлиенте
Процедура СохранитьВФайлы(Команда)
	
	Если ЗначениеЗаполнено(Период) Тогда
		
		ПолучитьТабличныеДокументыПоАдресам();
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru='Файлы сформированы.'");
		Сообщение.Сообщить();
		
	Иначе
		
	 	Сообщить("Для формирования отчета необходимо установить отбор на период. И либо отбор на адрес, либо на подходящий участок");
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура ПолучитьТабличныеДокументыПоАдресам()
	
	КаталогСохранения = СтрШаблон("%1\%2-%3", ЭтаФорма.Каталог, Формат(Период.ДатаНачала, "ДФ=yyyyMMdd"), Формат(Период.ДатаОкончания, "ДФ=yyyyMMdd"));
	УчастокВПамяти = Участок;
	АдресВПамяти = Адрес;
	Участок = Справочники.бит_ТехническиеУчастки.ПустаяСсылка();
	Адрес = Справочники.бит_СписокЗданий.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ТехническиеУчастки.Ссылка КАК Участок,
	               |	бит_СписокЗданий.Ссылка КАК Здание,
				   |	бит_СписокЗданий.Код КАК КодЗдания
	               |ИЗ
	               |	Справочник.бит_ТехническиеУчастки КАК бит_ТехническиеУчастки
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	               |		ПО бит_ТехническиеУчастки.Ссылка = бит_СписокЗданий.Участок
	               |ГДЕ
	               |	бит_ТехническиеУчастки.Наименование ПОДОБНО ""[0-9][0-9][0-9]""
				   |	И #УсловиеУчасток
				   |	И #УсловиеЗдание
	               |ИТОГИ ПО
	               |	Участок";
				   
	Если ЗначениеЗаполнено(УчастокВПамяти) И УчастокПодходит(УчастокВПамяти) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УсловиеУчасток", "бит_ТехническиеУчастки.Ссылка В (&Участки)");
		Запрос.УстановитьПараметр("Участки", УчастокВПамяти);
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УсловиеУчасток", "ИСТИНА");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(АдресВПамяти) Тогда
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УсловиеЗдание", "бит_СписокЗданий.Ссылка В (&Адреса)");
		Запрос.УстановитьПараметр("Адреса", АдресВПамяти);
		
	Иначе
		
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "#УсловиеЗдание", "ИСТИНА");
		
	КонецЕсли;
	
	ВыборкаПоУчасткам = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоУчасткам.Следующий() Цикл
		
		КаталогСохраненияУчасток = СтрШаблон("%1\%2", КаталогСохранения, Строка(ВыборкаПоУчасткам.Участок));
		Выборка = ВыборкаПоУчасткам.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		СоздатьКаталог(КаталогСохраненияУчасток);
		
		Пока Выборка.Следующий() Цикл
			
			Адрес = Выборка.Здание;
			ТабличныйДокумент = СформироватьНаСервере();
			Если Не ТабличныйДокумент.ВысотаТаблицы = 0 Тогда
				
				Путь = СтрШаблон("%1\%2.pdf", КаталогСохраненияУчасток, ПолучитьИмя(Выборка.КодЗдания));
				ТабличныйДокумент.Записать(Путь, ТипФайлаТабличногоДокумента.PDF);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Участок = УчастокВПамяти;
	Адрес = АдресВПамяти;
	
КонецПроцедуры

//shevtsov 24.02.26 Окончание