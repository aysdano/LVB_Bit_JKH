&НаКлиенте
Процедура ИсточникиДанныхДеревоПередУдалением(Элемент, Отказ)
	
	Модифицированность = Истина;
	
	ТекущиеДанные = Элементы.ИсточникиДанныхДерево.ТекущиеДанные;
	
	Корень = ТекущиеДанные.ПолучитьРодителя();
	
	Если НЕ Корень = Неопределено Тогда
		
		мИдентификаторРодитель = Корень.ПолучитьИдентификатор();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникиДанныхДеревоПослеУдаления(Элемент)
	
	Если НЕ мИдентификаторРодитель = Неопределено Тогда
		
		ЗаполнитьПроцентыВДереве(мИдентификаторРодитель);
		мИдентификаторРодитель = Неопределено;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СводнаяТаблицаПослеУдаления(Элемент)
	
	ТекущиеДанные = Элементы.ФактическиеДанные.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СпособРаспределения) Тогда
		
		ЗаполнитьПроцентСводнаяТаблица(ТекущиеДанные.Сумма);
		
	КонецЕсли; 
	
КонецПроцедуры

