//HD+
// Обработчик завершения выбора собственника в табличной части УчастникиСобрания
//
&НаКлиенте
Процедура УчастникиСобранияСобственникОбработкаВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекущаяСтрока = Элементы.УчастникиСобрания.ТекущаяСтрока;
	Если ТекущаяСтрока = Неопределено ИЛИ ТекущаяСтрока < 0 Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Неопределено;
	Если ТипЗнч(Результат) = Тип("СправочникСсылка.бит_Проживающие") Тогда
		ВыбранноеЗначение = Результат;
	ИначеЕсли ТипЗнч(Результат) = Тип("Массив") Тогда
		Если Результат.Количество() > 0 Тогда
			ВыбранноеЗначение = Результат[0];
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		УчастникиСобранияСобственникОбработкаВыбораНаСервере(ТекущаяСтрока, ВыбранноеЗначение);
	КонецЕсли;
	
