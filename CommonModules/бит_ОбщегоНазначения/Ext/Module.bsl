//  Процедура выполняет получение настроек ЖКХ.
//
// Параметры: 
//  Дата                - Дата             - Дата на которую получить настройки, 
//  Организация         - СправочникСсылка - Огранизация по которой получить настройки,
//  СтруктураПараметров - Структура        - Заполненая структура Настроек жкх.
//                                           (Ключ - имя настройки, Значение - стандартное значение настройки),
// Возвращаемое значение:
//  СтруктураПараметров.
//
Процедура ПолучитьНастройкиЖКХ(Дата, Организация, СтруктураПараметров) Экспорт
	
	ТекстЗапроса = "";
	
	Для Каждого Настройка Из СтруктураПараметров Цикл
		
		ТекстЗапроса  = ТекстЗапроса + ",
		|	бит_НастройкаПараметровЖКХСрезПоследних." + СокрЛП(Настройка.Ключ);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|бит_НастройкаПараметровЖКХСрезПоследних.Организация " + ТекстЗапроса + "
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураПараметров, Выборка); 
		
	Иначе
		
		Если ЗначениеЗаполнено(Организация) И ЗначениеЗаполнено(Дата) Тогда

			ТекстСообщения = НСтр("ru = 'Настройки ЖКХ для организации: %1 на %2 не заданы!'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Строка(Организация), Формат(Дата, "ДФ=dd.MM.yyyy"));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	//Дата = КонецДня(Дата);
	//ДатаИзмененийНастроекЖКХ = бит_ОбщегоНазначенияПовтИсп.ПоследняяДатаИзмененийНастроекЖКХ(Организация);
	//Если ЗначениеЗаполнено(ДатаИзмененийНастроекЖКХ)
	//	И ДатаИзмененийНастроекЖКХ < Дата Тогда // Сокращаем число выполнений запросов с произвольной датой.
	//	ЗаполнитьЗначенияСвойств(СтруктураПараметров, бит_ОбщегоНазначенияПовтИсп.ПолучитьНастройкиЖКХ(КонецДня(ДатаИзмененийНастроекЖКХ) + 1, Организация));
	//Иначе
	//	ЗаполнитьЗначенияСвойств(СтруктураПараметров, бит_ОбщегоНазначенияПовтИсп.ПолучитьНастройкиЖКХ(Дата, Организация));
	//КонецЕсли;
	
КонецПроцедуры // ПолучитьНастройкиЖКХ()

// Процедура предназначена для заполнения общих реквизитов документов,
// Вызывается в обработчиках событий "ПриОткрытии" в модулех форм всех документов.
//
// Параметры:
//  ДокументОбъект            - объект редактируемого документа.
//  ТекПользователь           - ссылка на справочник, определяет текущего пользователя.
//  ПараметрОбъектКопирования - указывает что документ создан копированием.
//
//  ВидСтатьи        		  - Строка, вид статьи оборотов, по умолчанию "";
//                                      принимаемые значения: ПоступлениеБДДС/РасходованиеБДДС/.
//                                                            ПоступлениеБДР/РасходованиеБДР.
//
Процедура ЗаполнитьШапкуДокумента(ДокументОбъект, ТекПользователь, ПараметрОбъектКопирования = Неопределено) Экспорт
	
	МетаданныеДокумента = ДокументОбъект.Метаданные();
	
	Если ЕстьРеквизитДокумента("ВидОперации", МетаданныеДокумента) 
		И НЕ ЗначениеЗаполнено(ДокументОбъект.ВидОперации)  Тогда
		ДокументОбъект.ВидОперации = Перечисления[ДокументОбъект.ВидОперации.Метаданные().Имя][0];
	КонецЕсли;	
	
	Если ЕстьРеквизитДокумента("Организация", МетаданныеДокумента) 
		И (НЕ ЗначениеЗаполнено(ДокументОбъект.Организация)) Тогда
		
		// БИТ_ЖКХ 31.01.2014
		ДокументОбъект.Организация = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");//глЗначениеПеременной("ОсновнаяОрганизация");
		
	КонецЕсли;
	
	Если ЕстьРеквизитДокумента("Ответственный", МетаданныеДокумента) Тогда
		
		Попытка		
			
			ДокументОбъект.Ответственный = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию(ТекПользователь, "ОсновнойОтветственный");
			
		Исключение
			
			ДокументОбъект.Ответственный = ТекПользователь;
			
		КонецПопытки;
		// БИТ_ЖКХ 31.01.2014
		
	КонецЕсли;
	
	Если ЕстьРеквизитДокумента("Касса", МетаданныеДокумента) Тогда
		ДокументОбъект.Ответственный = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию(ТекПользователь, "ОсновнаяКассаККМ");
	КонецЕсли;
	
