		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_ПоверкаСчетчиковСрезПоследних.Счетчик КАК Счетчик,
	бит_ПоверкаСчетчиковСрезПоследних.ДатаПоверки КАК ДатаПоверки
ПОМЕСТИТЬ ПоверкаСчетчика
ИЗ
	РегистрСведений.бит_ПоверкаСчетчиков.СрезПоследних КАК бит_ПоверкаСчетчиковСрезПоследних
ГДЕ
	НЕ бит_ПоверкаСчетчиковСрезПоследних.СнятНаПоверку

ИНДЕКСИРОВАТЬ ПО
	Счетчик
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга КАК Услуга,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик КАК Счетчик,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.УлицаЛицевогоСчета КАК Улица,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Здание КАК Здание,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Здание.Участок КАК Участок,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект КАК ЛицевойСчет,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.Разрядность КАК КоличествоРазрядовСчетчика,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.КоэффициентУмножения КАК МасштабныйКоэффициент,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Период КАК Период,
	ПоверкаСчетчика.ДатаПоверки КАК ДатаПоверки
ПОМЕСТИТЬ ВТ_РеестрИндСчетчиков
{ВЫБРАТЬ
	Услуга.*,
	Счетчик.*,
	Улица.*,
	Здание.*,
	Участок.*,
	ЛицевойСчет.*,
	КоличествоРазрядовСчетчика,
	МасштабныйКоэффициент}
ИЗ
	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
			&amp;КонецПериода {(&amp;КонецПериода)},
			ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
				И Объект ССЫЛКА Справочник.бит_ЛицевыеСчета) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ ПоверкаСчетчика КАК ПоверкаСчетчика
		ПО бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = ПоверкаСчетчика.Счетчик
ГДЕ
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
{ГДЕ
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга.*,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.*,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.УлицаЛицевогоСчета.* КАК Улица,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Здание.* КАК Здание,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Здание.Участок.* КАК Участок,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.* КАК ЛицевойСчет}

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет,
	Счетчик,
	Услуга
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	&amp;Период КАК Период,
	бит_ПоказанияСчетчиковОстатки.Объект КАК ЛицевойСчет,
	бит_ПоказанияСчетчиковОстатки.Услуга КАК Услуга,
	бит_ПоказанияСчетчиковОстатки.Счетчик КАК Счетчик,
	бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток КАК НачальноеПоказание
ПОМЕСТИТЬ ВТ_ОстатокНаНачало
{ВЫБРАТЬ
	Период,
	ЛицевойСчет.*,
	Услуга.*,
	Счетчик.*,
	НачальноеПоказание}
ИЗ
	РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
			&amp;НачалоПериода,
			(ВЫРАЗИТЬ(Объект КАК Справочник.бит_ЛицевыеСчета), Счетчик, Услуга) В
				(ВЫБРАТЬ
					ВТ_РеестрИндСчетчиков.ЛицевойСчет,
					ВТ_РеестрИндСчетчиков.Счетчик,
					ВТ_РеестрИндСчетчиков.Услуга
				ИЗ
					ВТ_РеестрИндСчетчиков)) КАК бит_ПоказанияСчетчиковОстатки
{ГДЕ
	(&amp;Период) КАК Период,
	бит_ПоказанияСчетчиковОстатки.Объект.* КАК ЛицевойСчет,
	бит_ПоказанияСчетчиковОстатки.Услуга.*,
	бит_ПоказанияСчетчиковОстатки.Счетчик.*}

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет,
	Счетчик,
	Услуга
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_ПоказанияСчетчиковОстатки.Объект КАК ЛицевойСчет,
	бит_ПоказанияСчетчиковОстатки.Услуга КАК Услуга,
	бит_ПоказанияСчетчиковОстатки.Счетчик КАК Счетчик,
	бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток КАК КонечноеПоказание
ПОМЕСТИТЬ ВТ_ОстатокНаКонец
{ВЫБРАТЬ
	ЛицевойСчет.*,
	Услуга.*,
	Счетчик.*,
	КонечноеПоказание}
ИЗ
	РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
			&amp;КонецПериода,
			(ВЫРАЗИТЬ(Объект КАК Справочник.бит_ЛицевыеСчета), Счетчик, Услуга) В
				(ВЫБРАТЬ
					ВТ_РеестрИндСчетчиков.ЛицевойСчет,
					ВТ_РеестрИндСчетчиков.Счетчик,
					ВТ_РеестрИндСчетчиков.Услуга
				ИЗ
					ВТ_РеестрИндСчетчиков)) КАК бит_ПоказанияСчетчиковОстатки
{ГДЕ
	бит_ПоказанияСчетчиковОстатки.Объект.* КАК ЛицевойСчет,
	бит_ПоказанияСчетчиковОстатки.Услуга.*,
	бит_ПоказанияСчетчиковОстатки.Счетчик.*}

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет,
	Счетчик,
	Услуга
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_ПоказанияСчетчиковОстаткиИОбороты.Объект КАК ЛицевойСчет,
	бит_ПоказанияСчетчиковОстаткиИОбороты.Услуга КАК Услуга,
	бит_ПоказанияСчетчиковОстаткиИОбороты.Счетчик КАК Счетчик,
	СУММА(бит_ПоказанияСчетчиковОстаткиИОбороты.ПоследниеПоказанияПриход) КАК ПоказаниеСчетчикаПриУстановке
