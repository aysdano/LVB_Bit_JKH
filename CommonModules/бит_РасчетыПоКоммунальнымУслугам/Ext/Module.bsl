	ТаблицаНачислений.Колонки.Добавить("СтавкаНДС"                 , Новый ОписаниеТипов("ПеречислениеСсылка.ВидыСтавокНДС"));

	// БИТ_ЖКХ 14.07.2017 11:49:52 Конец правки.
	ТаблицаНачислений.Колонки.Добавить("Приоритет"                 , ОбщегоНазначения.ОписаниеТипаЧисло(2,0));
	ТаблицаНачислений.Колонки.Добавить("СпособРасчета"             , Новый ОписаниеТипов("ПеречислениеСсылка.бит_СпособыРасчетаПоУслугам"));
	ТаблицаНачислений.Колонки.Добавить("Ставка"                    , ОбщегоНазначения.ОписаниеТипаЧисло(17,4));
