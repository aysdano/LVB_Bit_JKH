		"ВЫБРАТЬ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
		|ГДЕ
		|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата
		|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
		
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		
		Момент = Объект.Дата;
		
	Иначе
		
		Момент = ТекущаяДата();
		
	КонецЕсли;
	
	Если Объект.СправкаПоСмерти Тогда
		Если ЗначениеЗаполнено(Объект.ДатаСмерти) Тогда
			
			Момент  = Объект.ДатаСмерти + 10*24*60*60;
			
		Иначе
			Момент = Объект.Дата;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Момент));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	
	СписокФизЛиц = Запрос.Выполнить().Выгрузить();
	
	ЭтаФорма.Элементы.ФизЛицо.СписокВыбора.ЗагрузитьЗначения(СписокФизЛиц.ВыгрузитьКолонку("ФизическоеЛицо"));
	
	мСписокФизЛиц = СписокФизЛиц;
	
	АдресВХранилище = ПоместитьВоВременноеХранилище(СписокФизЛиц,УникальныйИдентификатор);

КонецПроцедуры

&НаСервере
Процедура ЗагрузкаТабЧасти(СписокЗначенийФизЛиц, Дата = Неопределено)
	Если ЗначениеЗаполнено(Дата) Тогда
		
		мТаблицаФизЛиц.Загрузить(ФормированиеДанныхТабЧасти(СписокЗначенийФизЛиц, Дата));
		Объект.ФизическиеЛица.Загрузить(мТаблицаФизЛиц.Выгрузить());
		
	КонецЕсли; 
	
КонецПроцедуры	

&НаСервере

// Процедура формирования данных физ лиц
// Для заполнения таб части документа
// Параметры
//   СписокЗначенийФизЛиц - <список значений, таблица значений> - список физлиц.
//
Функция ФормированиеДанныхТабЧасти(СписокЗначенийФизЛиц, Момент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК РодственныеОтношения,
	|	бит_ПроживающиеПоЛССрезПоследних.ОткудаПрибыл,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаПрибытия,
	|	бит_ПроживающиеПоЛССрезПоследних.КудаВыписан,
	|	ВЫБОР
	|		КОГДА бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Метка,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПравоНаЛьготы КАК ПравоНаЛьготы,
	|	ВЫБОР
	|		КОГДА бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|				ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПрописанНаМомент
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ФизЛицо В (&ФизЛицо)
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Метка";
	
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("ФизЛицо", СписокЗначенийФизЛиц);
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Возврат Таблица;
КонецФункции

Функция ПолучитьТабличнуюЧасть()
	ТабЗначений =  Объект.ФизическиеЛица.Выгрузить();	
	Возврат ТабЗначений;
КонецФункции

&НаСервере
Функция Сформировать()
	
	Если Объект.ФизЛицо = Неопределено ИЛИ Объект.ЛицевойСчет = Неопределено ИЛИ Объект.Организация = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если Объект.СправкаПоСмерти И НЕ ЗначениеЗаполнено(Объект.ДатаСмерти) Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните поле ""Дата смерти""!!!";
		Сообщение.Сообщить();
		
		Возврат Результат;
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		Момент = Объект.Дата;
	Иначе
		Момент = ТекущаяДата();
	КонецЕсли;
	
	Если Объект.СправкаПоСмерти Тогда
		Если ЗначениеЗаполнено(Объект.ДатаСмерти) Тогда
			
			Момент  = Объект.ДатаСмерти + 10*24*60*60;
			
		Иначе
			Момент = Объект.Дата;
		КонецЕсли;
		
	КонецЕсли;
	
	ФизЛицо     = Объект.ФизЛицо;
	ЛицевойСчет = Объект.ЛицевойСчет;
	Организация = Объект.Организация;
	ЗаполнятьПаспортныеДанные = Объект.ЗаполнятьПаспортныеДанные;
	
	// Список физ диц из табличной части  ФизическиеЛица.
	ФизЛицаТЧ = Объект.ФизическиеЛица.Выгрузить(,"ФизическоеЛицо");
	
	// Добавление в таблицу строки из поля ФизЛицо.
	Если ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		ФизЛицоИзШапки = ФизЛицаТЧ.Найти(ФизЛицо);
		
		Если ФизЛицоИзШапки = Неопределено Тогда
			Индекс = ФизЛицаТЧ.Количество()-1; 
			Строка = ФизЛицаТЧ.Вставить(Индекс);
			Строка.ФизическоеЛицо = ФизЛицо;
		КонецЕсли; 
		
	КонецЕсли;
	// Полные личные данные о всех физ лицах документа из запроса, прописанных по ЛС.
	ТаблицаФизЛиц = ФормированиеДанныхТабЧасти(ФизЛицаТЧ, Момент);
	
	Результат.Очистить();                   
	
	Макет = Документы.бит_ЕдиныйЖилДокумент.ПолучитьМакет("ЕдиныйЖилищныйДокумент");
	
	ОбластьШапка        			= Макет.ПолучитьОбласть("Шапка");
	ОбластьШапкаСобственников  		= Макет.ПолучитьОбласть("ШапкаСобственников");
	ОбластьСтрокаСобственников 		= Макет.ПолучитьОбласть("СтрокаСобственников");
	ОбластьПодвалСобственников  	= Макет.ПолучитьОбласть("ПодвалСобственников");
	ОбластьХарактеристикаКв1   		= Макет.ПолучитьОбласть("ХарактеристикаКв1");
	ОбластьШапкаКомнат   			= Макет.ПолучитьОбласть("ШапкаКомнат");
	ОбластьСтрокаКомнат   			= Макет.ПолучитьОбласть("СтрокаКомнат");
	ОбластьХарактеристикаКв2   		= Макет.ПолучитьОбласть("ХарактеристикаКв2");
	ОбластьЗаголовокПроживающих 	= Макет.ПолучитьОбласть("ЗаголовокПроживающих");
	ОбластьШапкаПроживающихТЧ 		= Макет.ПолучитьОбласть("ШапкаПроживающихТЧ");
	ОбластьСтрокаПроживающих 		= Макет.ПолучитьОбласть("СтрокаПроживающих");
	ОбластьШапкаПребывающих 		= Макет.ПолучитьОбласть("ШапкаПребывающих");
	ОбластьСтрокаЗарегистрированных = Макет.ПолучитьОбласть("СтрокаЗарегистрированных");
	ОбластьНаличиеДрЖилья 			= Макет.ПолучитьОбласть("НаличиеДрЖилья");
	ОбластьШапкаЛьгот 				= Макет.ПолучитьОбласть("ШапкаЛьгот");
	ОбластьСтрокаЛьгот 				= Макет.ПолучитьОбласть("СтрокаЛьгот");
	ОбластьСтрокаСоцЗащита 			= Макет.ПолучитьОбласть("СтрокаСоцЗащита");
	ОбластьСтрокаПриборовУчета 		= Макет.ПолучитьОбласть("СтрокаПриборовУчета");
	ОбластьСтрокаДолгов 			= Макет.ПолучитьОбласть("СтрокаДолгов");
	
	ОбластьСтрокаУслугДолгов 		= Макет.ПолучитьОбласть("СтрокаУслугДолгов");
	
	ОбластьШапкаКоммунальныхКв 		= Макет.ПолучитьОбласть("ШапкаКоммунальныхКв");
	ОбластьШапкаКоммунальныхКвТЧ 	= Макет.ПолучитьОбласть("ШапкаКоммунальныхКвТЧ");
	ОбластьСтрокаКоммунальныхКв 	= Макет.ПолучитьОбласть("СтрокаКоммунальныхКв");
	
	ОбластьСтрокаКоммунальныхКвТЧ 	= Макет.ПолучитьОбласть("СтрокаКоммунальныхКвТЧ");
	ОбластьПодвал 					= Макет.ПолучитьОбласть("Подвал");
	
	ОбластьПустаяСтрока 			= Макет.ПолучитьОбласть("ПустаяСтрока");
	
	// Создание зачеркнутого шрифта.
	ЗачеркнутыйШрифт = Новый Шрифт(Макет.Область("непригодна").Шрифт,,,,,,Истина);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.Район КАК Район,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.Улица КАК УлицаЛС,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.Ссылка КАК ДомЛС,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.Корпус КАК КорпусЛС,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира КАК КвартираЛС,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.Строение КАК СтроениеЛС,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Этаж КАК ЭтажКв,
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ТипПлиты,
	|	бит_СведенияОКвартиреСрезПоследних.ТипЗапирающегоУстройства,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.Организация.НаименованиеПолное КАК ПолноеНаименованиеОрганизации,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.КоличествоКомнат КАК КолвоКомнат,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.Улица.СтароеНаименование КАК УлицаЛСБыв,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.КонструкцияСтен КАК Стены,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.ДатаВводаВЭксплуатацию КАК ГодПостройки,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец.ВидБлагоустройстваЗданий КАК ЛифтНаличие,
	|	ВложенныйЗапрос.МаксЭтажЗдания
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета КАК ОбъектУчета,
	|			МАКСИМУМ(ВЫБОР
	|					КОГДА бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.КоличествоЭтажей)
	|						ТОГДА ЕСТЬNULL(бит_ЗначениеСвойствОбъектовУчета.Значение, 0)
	|					ИНАЧЕ 0
	|				КОНЕЦ) КАК МаксЭтажЗдания
	|		ИЗ
	|			РегистрСведений.бит_ЗначениеСвойствОбъектовУчета КАК бит_ЗначениеСвойствОбъектовУчета
	|		ГДЕ
	|			бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета = &ОбъектУчета
	|		
	|		СГРУППИРОВАТЬ ПО
	|			бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета) КАК ВложенныйЗапрос
	|		ПО бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец = ВложенныйЗапрос.ОбъектУчета";
	
	Запрос.УстановитьПараметр("Квартира"   , ЛицевойСчет.Квартира);
	Запрос.УстановитьПараметр("Момент"     , Момент);
	Запрос.УстановитьПараметр("ОбъектУчета", ЛицевойСчет.Здание);
	
	ДанныеЛС = Запрос.Выполнить().Выгрузить();
	
	ДанныеИтогЛС = Неопределено;
	
	Если ДанныеЛС.Количество() > 0 Тогда
		
		ДанныеИтогЛС = ДанныеЛС[0];
		ОбластьШапка.Параметры.Заполнить(ДанныеИтогЛС);
		
		Если ЗначениеЗаполнено(ДанныеИтогЛС.УлицаЛСБыв) Тогда
			ОбластьШапка.Параметры.ДомЛСБыв 	= ДанныеИтогЛС.ДомЛС;
			ОбластьШапка.Параметры.КорпусЛСБыв 	= ДанныеИтогЛС.КорпусЛС;
			ОбластьШапка.Параметры.СтроениеЛСБыв = ДанныеИтогЛС.СтроениеЛС;
			ОбластьШапка.Параметры.КвартираЛСБыв = ДанныеИтогЛС.КвартираЛС;
		КонецЕсли; 
		
		ОбластьХарактеристикаКв1.Параметры.Заполнить(ДанныеИтогЛС);
		ОбластьХарактеристикаКв1.Параметры.ПлощадьЖилаяИвнешняя = ДанныеИтогЛС.ЖилаяПлощадь;
		ОбластьХарактеристикаКв2.Параметры.Заполнить(ДанныеИтогЛС);
		
		ОбластьШапка.Параметры.Заполнить(Объект);
		
		Если Объект.СправкаПоСмерти Тогда
			
			ОбластьШапка.Параметры.НачалоПериода = Момент - 40*24*60*60;
			ОбластьШапка.Параметры.КонецПериода  = Момент ;
			
			ОбластьШапка.Параметры.Дата = Дата(0001,01,01);
			ОбластьШапка.Область("ПоСостоянию").Шрифт = ЗачеркнутыйШрифт;
			
		Иначе
			
			ОбластьШапка.Параметры.Дата = Момент;
			ОбластьШапка.Область("ЗаПериод").Шрифт = ЗачеркнутыйШрифт;
			ОбластьШапка.Параметры.НачалоПериода 	= Дата(0001,01,01);
			ОбластьШапка.Параметры.КонецПериода 	= Дата(0001,01,01) ;
			
		КонецЕсли; 
	КонецЕсли;
	
	ФИОЗаявителя   = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(ФизЛицо, Момент, Ложь);
	
	ТелефонФизЛица = бит_ПаспортныйСтолСервер.ПолучитьТелефонИзКонтактнойИнформации(ФизЛицо);
	
	Если ЗначениеЗаполнено(ФИОЗаявителя) Тогда
		ФИОЗаявителя  = ФИОЗаявителя + ?(ЗначениеЗаполнено(ТелефонФизЛица),", тел." + Строка(ТелефонФизЛица),"");
	Иначе
		ФИОЗаявителя  = Строка(Объект.ФизЛицо)+ ?(ЗначениеЗаполнено(ТелефонФизЛица),", тел." + Строка(ТелефонФизЛица),"");
	КонецЕсли; 
	
	ОбластьШапка.Параметры.ФизЛицо = ФИОЗаявителя;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Вид",ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ЮрАдресОрганизации"));
	
	Адрес = Организация.КонтактнаяИнформация.НайтиСтроки(Отбор);
	
	Если Адрес.количество() > 0 Тогда
		ЮрАдресОрганизацииТЗ = Адрес[0].Представление;	
	Иначе
		ЮрАдресОрганизацииТЗ = "";	
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Вид",ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонОрганизации"));
	
	Телефон = Организация.КонтактнаяИнформация.НайтиСтроки(Отбор);
	
	Если Телефон.количество() > 0 Тогда
		ТелефонОрганизации = Телефон[0].Представление;	
	Иначе
		ТелефонОрганизации = "";	
	КонецЕсли;
	
	ПолныеДанныеОрганизации = Объект.Организация.НаименованиеПолное 
	+ ?(ЗначениеЗаполнено(ЮрАдресОрганизацииТЗ),", " + ЮрАдресОрганизацииТЗ ,"")
	+ ?(ЗначениеЗаполнено(ТелефонОрганизации),", тел." + ТелефонОрганизации,"");
	ОбластьШапка.Параметры.ПолныеДанныеОрганизации = ПолныеДанныеОрганизации;
	
	// Заполнение паспортных данных. 
	Если ЗаполнятьПаспортныеДанные И ЗначениеЗаполнено(ФизЛицо) Тогда
		ДанныеПаспорта_1 = "";
		ДанныеПаспорта_2 = "";
		ДанныеПаспортаПредыд = "";
		ПричинаЗаменыПаспорта = "";
		
		ТекущийДокФизЛица 	= бит_ПаспортныйСтолСервер.ПолучитьПаспортныеДанныеСтрокой(ФизЛицо,Момент);
		
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ТекущийДокФизЛица, 55, ДанныеПаспорта_1, ДанныеПаспорта_2);
		
		ДокФизЛица 			= бит_ПаспортныйСтолСервер.ПолучитьДанныеРанееВыданногоДокументаФизЛица(ФизЛицо, Момент);
		Если ЗначениеЗаполнено(ДокФизЛица.ДокументВид) Тогда
			ДанныеПаспортаПредыд = бит_ПаспортныйСтолСервер.ПолучитьПаспортныеДанныеСтрокойИзСтруктуры(ДокФизЛица);
			Если ЗначениеЗаполнено(ТекущийДокФизЛица) Тогда
				
				ПричинаЗаменыПаспортаСтрукт = бит_ПаспортныйСтолСервер.ПолучитьДанныеДокументаФизЛица(ФизЛицо, Момент);
				ПричинаЗаменыПаспорта 		= ПричинаЗаменыПаспортаСтрукт.ДокументПричинаЗамены;	
				
			КонецЕсли; 
		КонецЕсли;
		
		// Создание структуры для заполнения данных.
		СтруктураДанных = Новый Структура("ДанныеПаспорта_1, ДанныеПаспорта_2,ДанныеПаспортаПредыд,ПричинаЗаменыПаспорта"
		,ДанныеПаспорта_1,ДанныеПаспорта_2,ДанныеПаспортаПредыд, ПричинаЗаменыПаспорта);
		
		ОбластьШапка.Параметры.Заполнить(СтруктураДанных);
		
	КонецЕсли; 
	
	Ответственный = ОтветственныйНаЛС(ЛицевойСчет,Момент);
	
	ОтветственныйЛС = "";

	Попытка
		ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(Строка(Ответственный),2,Ответственный.Пол,ОтветственныйЛС);
	Исключение
		ИсходСклонения = Ложь;
	КонецПопытки;
	
	Если НЕ ИсходСклонения Тогда
		ОтветственныйЛС = Строка(Ответственный);
	КонецЕсли; 
	ОбластьШапка.Параметры.ОтветственныйЛС = ОтветственныйЛС;
	
	Результат.Вывести(ОбластьШапка);
	
	// Список владельцев квартиры.
	МассивВладельцевПолн = Неопределено;
	
	ТаблицаПроживающихПоЛС = бит_ПаспортныйСтолСервер.ПолучитьСписокПроживающихПоЛС(ЛицевойСчет, Момент, Ложь);
	Если ТаблицаПроживающихПоЛС.Количество() > 0 Тогда 
		Отбор = Новый Структура();
		Отбор.Вставить("ВладелецКвартиры",Перечисления.ДаНет.Да);
		
		МассивВладельцевПолн = ТаблицаПроживающихПоЛС.НайтиСтроки(Отбор);
	КонецЕсли;
	
	МассивВладельцев = Новый Массив;
	Индекс = 0;
	
	Если НЕ МассивВладельцевПолн = Неопределено Тогда
		
		Для каждого Строка Из МассивВладельцевПолн Цикл
			
			Если Строка.СтатусФизЛица <> Справочники.бит_СтатусФизЛица.Выписан Тогда
				МассивВладельцев.Вставить(Индекс,Строка);
				Индекс = Индекс + 1;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если МассивВладельцев.Количество()> 0 Тогда
		
		Счетчик = 1;
		Пока Счетчик < 3 Цикл 
			Для каждого СтрокаВладелец Из МассивВладельцев Цикл
				
				СокращенноеФИО  			= бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(СтрокаВладелец.ФизЛицо, Момент,,Ложь);
				Если НЕ ЗначениеЗаполнено(СокращенноеФИО) Тогда
					СокращенноеФИО 		= Строка(СтрокаВладелец.ФизЛицо);
				КонецЕсли;
				
				Если Счетчик = 1 Тогда
					
					ОбластьШапкаСобственников.Параметры.ФиоСобственника_1 = СокращенноеФИО;
					ОбластьШапкаСобственников.Параметры.Доля_1 = СтрокаВладелец.ДоляПлощади;
					
				КонецЕсли;
				
				Если Счетчик = 2 и МассивВладельцев.Количество()> 1 Тогда
					
					ОбластьШапкаСобственников.Параметры.НомСобственника = Строка(Счетчик) + ".";
					ОбластьШапкаСобственников.Параметры.ФиоСобственника_2 = СтрокаВладелец.ФизЛицо;
					ОбластьШапкаСобственников.Параметры.Доля_2 = СтрокаВладелец.ДоляПлощади;
					
				КонецЕсли;
				
				Счетчик = Счетчик + 1;
				
			КонецЦикла;
		КонецЦикла;
		
		Результат.Вывести(ОбластьШапкаСобственников);
	КонецЕсли; 
	
	Если МассивВладельцев.Количество()> 2 Тогда
		Счетчик = 1;
		Для каждого СтрокаВладелец Из МассивВладельцев Цикл
			
			
			Если Счетчик > 2 Тогда
				
				СокращенноеФИО  			= бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(СтрокаВладелец.ФизЛицо, Момент, ,Ложь);
				
				Если НЕ ЗначениеЗаполнено(СокращенноеФИО) Тогда
					
					СокращенноеФИО 		= Строка(СтрокаВладелец.ФизЛицо);
					
				КонецЕсли;
				
				ОбластьСтрокаСобственников.Параметры.НомСобственника = Строка(Счетчик) + ".";
				ОбластьСтрокаСобственников.Параметры.ФиоСобственника = СокращенноеФИО;
				ОбластьСтрокаСобственников.Параметры.Доля			 = СтрокаВладелец.ДоляПлощади;
				Результат.Вывести(ОбластьСтрокаСобственников);
				
			КонецЕсли; 
			
			Счетчик = Счетчик + 1;
			
			
		КонецЦикла; 
	КонецЕсли; 
	
	ДокументОснование_1 = "";
	ДокументОснование_2 = "";
	ДокументОснование = "";
	ОтветственныйСтрока = ТаблицаПроживающихПоЛС.Найти(Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо,"СтепеньРодства");
	Если ОтветственныйСтрока <> Неопределено Тогда
		
		ДанныеДокумента  	= ОтветственныйСтрока.ПравоустанавливающиеДокументы;
		ДокументОснование 	= ДанныеДокумента.Наименование + " " +  ДанныеДокумента.НомерДокумента
		+ " от " + Формат(ДанныеДокумента.ДатаДокумента,"ДФ='dd.MM.yyyy ""г.""'")
		+ ?(ЗначениеЗаполнено(ДанныеДокумента.ОрганизацияВыдавшаяДокумент),", выд. " + Строка(ДанныеДокумента.ОрганизацияВыдавшаяДокумент),"");
	КонецЕсли;
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ДокументОснование,70,ДокументОснование_1,ДокументОснование_2);
	ОбластьПодвалСобственников.Параметры.ДокументОснование_1 = ДокументОснование_1;
	ОбластьПодвалСобственников.Параметры.ДокументОснование_2 = ДокументОснование_2;
	Результат.Вывести(ОбластьПодвалСобственников);
	
	// Заполнение характеристик квартиры.
	КомнатыКвартиры = бит_ПаспортныйСтолСервер.ПолучитьДанныеКомнатКвартиры(ЛицевойСчет.Квартира, Момент);
	Если КомнатыКвартиры.Количество() > 0 Тогда
		
		ПлощадьКухни 	= бит_ПаспортныйСтолСервер.ПолучитьПлощадьКухни(КомнатыКвартиры);
		ПлощадиКомнат 	= бит_ПаспортныйСтолСервер.ПолучитьПлощадиКвартирыИзКомнат(КомнатыКвартиры);
		
		ОбластьХарактеристикаКв1.Параметры.ПлощадьКухни 	= ПлощадьКухни;
		ОбластьХарактеристикаКв1.Параметры.ПлощадьВнешняя 	= ПлощадиКомнат[5];
		ОбластьХарактеристикаКв1.Параметры.ПлощадьЖилаяИвнешняя 	= ПлощадиКомнат[5]+ПлощадиКомнат[1];
		
	КонецЕсли; 
	Результат.Вывести(ОбластьХарактеристикаКв1);
	Результат.Вывести(ОбластьШапкаКомнат);
	
	// Заполнение списка комнат.
	Если КомнатыКвартиры.Количество()>0 Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("ТипКомнаты",Справочники.бит_ТипыКомнат.Жилая);
		ЖилыеКомнаты = КомнатыКвартиры.НайтиСтроки(Отбор);
		Индекс = 1;
		Для каждого Комната Из ЖилыеКомнаты Цикл
			ОбластьСтрокаКомнат.Параметры.НомерКомнаты = Индекс;
			ОбластьСтрокаКомнат.Параметры.ПлощадьКомнаты = Комната.Площадь;
			
			Если Комната.ЧастьПомещения.Ссылка = Справочники.бит_НазначениеЧастейПомещения.Комната Тогда
				ОбластьСтрокаКомнат.Параметры.ТипЖилойКомнаты = Строка(Комната.ЧастьПомещения.Ссылка);
			КонецЕсли; 
			
			Если Комната.ЧастьПомещения.Ссылка = Справочники.бит_НазначениеЧастейПомещения.КомнатаЗапроходная Тогда
				ОбластьСтрокаКомнат.Параметры.ТипЖилойКомнаты = Строка(Комната.ЧастьПомещения.Ссылка);
			КонецЕсли; 
			
			Если Комната.ЧастьПомещения.Ссылка = Справочники.бит_НазначениеЧастейПомещения.КомнатаПроходная Тогда
				ОбластьСтрокаКомнат.Параметры.ТипЖилойКомнаты = Строка(Комната.ЧастьПомещения.Ссылка);
			КонецЕсли; 
			Индекс = Индекс +1;
			Результат.Вывести(ОбластьСтрокаКомнат);
		КонецЦикла; 
	КонецЕсли;                 
	
	// Заполнение услугами.
	ОбластьХарактеристикаКв2.Параметры.СерияДома = Объект.СерияДома;
	СписокУслуг = бит_ПаспортныйСтолСервер.ПолучитьСписокУслугПоЛС(ЛицевойСчет,Момент);
	
	Отопление 				= Перечисления.ДаНет.Нет;
	Водопровод 				= Перечисления.ДаНет.Нет;
	Электроэнергия 			= Перечисления.ДаНет.Нет;
	Газ 					= Перечисления.ДаНет.Нет;
	ГорячееВодоснобжение 	= Перечисления.ДаНет.Нет;
	
	Если СписокУслуг.Количество() > 0 Тогда
		
		Для каждого Строка Из СписокУслуг Цикл
			Если Строка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Водопровод Тогда
				Водопровод 				= Перечисления.ДаНет.Да;
			КонецЕсли; 
			
			Если Строка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Отопление Тогда
				Отопление 				= Перечисления.ДаНет.Да;
			КонецЕсли; 
			
			Если Строка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Электроэнергия Тогда
				Электроэнергия			= Перечисления.ДаНет.Да;
			КонецЕсли;
			
			Если Строка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Газ Тогда
				Газ		 				= Перечисления.ДаНет.Да;
			КонецЕсли; 
			
			Если Строка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ГорячееВодоснобжение Тогда
				ГорячееВодоснобжение	= Перечисления.ДаНет.Да;
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Если ДанныеИтогЛС <> Неопределено Тогда
		
		Если ДанныеИтогЛС.ТипПлиты = Справочники.бит_ТипыПлиты.ГазоваяПлита Тогда
			
			Газ		 				= Перечисления.ДаНет.Да;
			
		ИначеЕсли ДанныеИтогЛС.ТипПлиты = Справочники.бит_ТипыПлиты.ЭлектрическаяПлита Тогда
			
			Электроэнергия			= Перечисления.ДаНет.Да;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Лифт = Перечисления.ДаНет.Нет;
	Если ЗначениеЗаполнено(ЛицевойСчет.Здание)И ЗначениеЗаполнено(ЛицевойСчет.Здание.ВидБлагоустройстваЗданий) Тогда
		Если ЛицевойСчет.Здание.ВидБлагоустройстваЗданий = Справочники.бит_ВидыБлагоустройстваЗданий.СЛифтами Тогда
			Лифт = Перечисления.ДаНет.Да;
		КонецЕсли;
		
	КонецЕсли; 
	Благоустройство = Объект.СоответствиеСтандартамБлагоустройства;
	Если Объект.ТипСистемыГВС Тогда
		
		ТипГВС = "открытая";
		
	Иначе
		
		ТипГВС = "закрытая";
		
	КонецЕсли;
	
	СтруктураУслуг = Новый Структура("Отопление, Водопровод,Электроэнергия,Газ,ГорячееВодоснобжение,Лифт,ТипГВС,Благоустройство",
	Отопление, Водопровод,Электроэнергия,Газ,ГорячееВодоснобжение,Лифт,ТипГВС,Благоустройство);
	ЗаполнитьЗначенияСвойств( ОбластьХарактеристикаКв2.Параметры,СтруктураУслуг);
	
	Если Объект.ПригодностьДляЖилья Тогда
		
		ОбластьХарактеристикаКв2.Область("непригодна").Шрифт = ЗачеркнутыйШрифт;
		
	Иначе
		
		ОбластьХарактеристикаКв2.Область("пригодна").Шрифт = ЗачеркнутыйШрифт;
		
	КонецЕсли; 
	
	Результат.Вывести(ОбластьХарактеристикаКв2);
	
	Если Объект.Новостройка Тогда
		
		ОбластьЗаголовокПроживающих.Область("неновостройка").Шрифт = ЗачеркнутыйШрифт;
		
	Иначе
		ОбластьЗаголовокПроживающих.Область("новостройка1").Шрифт = ЗачеркнутыйШрифт;
		ОбластьЗаголовокПроживающих.Область("новостройка2").Шрифт = ЗачеркнутыйШрифт;
		
	КонецЕсли; 
	
	Результат.Вывести(ОбластьЗаголовокПроживающих);
	
	Результат.Вывести(ОбластьШапкаПроживающихТЧ);
	
	// Заполнение данных по проживающим.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизЛицо", Объект.ФизическиеЛица.Выгрузить(,"ФизическоеЛицо").ВыгрузитьКолонку("ФизическоеЛицо"));
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(, ФизЛицо В (&ФизЛицо)) КАК бит_ПроживающиеПоЛССрезПоследних";

	ТЗДатаРегистрации = Запрос.Выполнить().Выгрузить();
	
	Для каждого Строка Из Объект.ФизическиеЛица Цикл
		
		Если  Строка.СтатусПроживания = Перечисления.бит_СтатусПроживания.Постоянно  Тогда
			
			ОбластьСтрокаПроживающих.Параметры.Заполнить(Строка);
			
			// Требование отображать полностью.
			//СокращенноеФИО  			= бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(Строка.ФизическоеЛицо, Момент, ,Ложь);
			//Если НЕ ЗначениеЗаполнено(СокращенноеФИО) Тогда
			//	СокращенноеФИО 		= Строка(Строка.ФизическоеЛицо);
			//КонецЕсли;
			//ОбластьСтрокаПроживающих.Параметры.ФизическоеЛицо = СокращенноеФИО;	
			ОбластьСтрокаПроживающих.Параметры.ФизическоеЛицо = Строка(Строка.ФизическоеЛицо);	
			
			Если ЗначениеЗаполнено(Строка.ФизическоеЛицо.МестоРождения) Тогда
				МестоРождения = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(Строка.ФизическоеЛицо.МестоРождения);
			Иначе
				МестоРождения = "";
			КонецЕсли;
			ОбластьСтрокаПроживающих.Параметры.МестоРождения = МестоРождения;
			
			
			ТекущийДокФизЛица 	= бит_ПаспортныйСтолСервер.ПолучитьПаспортныеДанныеСтрокой(Строка.ФизическоеЛицо,Момент);

			ОбластьСтрокаПроживающих.Параметры.ПаспортныеДанные = ТекущийДокФизЛица;
			
			ДокФизЛица 			= бит_ПаспортныйСтолСервер.ПолучитьДанныеРанееВыданногоДокументаФизЛица(Строка.ФизическоеЛицо, Момент);
			Если ЗначениеЗаполнено(ДокФизЛица.ДокументВид) Тогда
				ДанныеПаспортаПредыд = бит_ПаспортныйСтолСервер.ПолучитьПаспортныеДанныеСтрокойИзСтруктуры(ДокФизЛица);
			Иначе
				ДанныеПаспортаПредыд = "";
			КонецЕсли;
			ОбластьСтрокаПроживающих.Параметры.ПаспортДанныеПрежние = ДанныеПаспортаПредыд;
			
			ДанныеПоСрокуПрописки = ТЗДатаРегистрации.НайтиСтроки(Новый Структура("ФизЛицо",Строка.ФизическоеЛицо));
			Если ДанныеПоСрокуПрописки.Количество()> 0 Тогда
				СрокПроживания = ДанныеПоСрокуПрописки[0].ДатаРегистрации
			Иначе
				СрокПроживания = Дата(0001,01,01);
			КонецЕсли;
			
			//Отбор = Новый Структура;
			//Отбор.Вставить("ФизЛицо",Строка.ФизическоеЛицо);
			//ДанныеПоСрокуПрописки = РегистрыСведений.бит_ПроживающиеПоЛС.СрезПоследних(Дата(0001,01,02),Отбор);
			//Если ДанныеПоСрокуПрописки.Количество()> 0 Тогда
			//	
			//	СрокПроживания = ДанныеПоСрокуПрописки[0].ДатаРегистрации
			//	
			//Иначе
			//	
			//	СрокПроживания = Дата(0001,01,01);
			//	
			//КонецЕсли;
			ОбластьСтрокаПроживающих.Параметры.СрокПроживания = СрокПроживания;
			// Данные по тем физ лицам, по которым есть записи по регистрам в базе.
			СтрокаПоиска = ТаблицаФизЛиц.Найти(Строка.ФизическоеЛицо, "ФизическоеЛицо");
			Если ЗначениеЗаполнено(СтрокаПоиска) Тогда
				ОбластьСтрокаПроживающих.Параметры.КудаВыписан 		= СтрокаПоиска.КудаВыписан;
				ОбластьСтрокаПроживающих.Параметры.ОткудаПрибыл 	= СтрокаПоиска.ОткудаПрибыл;
				
			КонецЕсли; 
			
			Разделитель = Новый Массив;
			
			Разделитель.Добавить(ОбластьСтрокаПроживающих);
			
			Если Не ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(Результат, Разделитель) Тогда
				
				Результат.ВывестиГоризонтальныйРазделительСтраниц();
				
			КонецЕсли;
			
			Результат.Вывести(ОбластьСтрокаПроживающих);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если Объект.ФизическиеЛица.Количество() = 0 Тогда
		
		Результат.Вывести(ОбластьСтрокаПроживающих);
		
	КонецЕсли; 
	
	Результат.Вывести(ОбластьШапкаПребывающих);
	
	
	Для каждого Строка Из  Объект.ФизическиеЛица Цикл
		
		Если  Строка.СтатусПроживания = Перечисления.бит_СтатусПроживания.Временно  Тогда
			
			СокращенноеФИО  			= бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(Строка.ФизическоеЛицо, Момент, ,Ложь);
			Если НЕ ЗначениеЗаполнено(СокращенноеФИО) Тогда
				СокращенноеФИО 		= Строка(Строка.ФизическоеЛицо);
			КонецЕсли;
			ОбластьСтрокаЗарегистрированных.Параметры.ФизическоеЛицо = СокращенноеФИО;	
			Результат.Вывести(ОбластьСтрокаЗарегистрированных);
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если Объект.НаличиеДругогоЖилья Тогда
		
		ОбластьНаличиеДрЖилья.Параметры.НаличиеДрЖилья = "имеют";
	Иначе
		
		ОбластьНаличиеДрЖилья.Параметры.НаличиеДрЖилья = "не имеют";
		
	КонецЕсли;
	Результат.Вывести(ОбластьНаличиеДрЖилья);
	
	// Заполнения данных по льготам.
	Результат.Вывести(ОбластьШапкаЛьгот);
	ТаблицаЛьготников = бит_ПаспортныйСтолСервер.ПолучитьСписокЛьготниковПоЛС(ЛицевойСчет, Момент);
	Если ТаблицаЛьготников.Количество() > 0 Тогда
		СоцЗащитаФИО = "";
		Отбор = Новый Структура();
		Отбор.Вставить("ПравоНаЛьготы",Истина);
		ВременныйСписок = мТаблицаФизЛиц.НайтиСтроки(Отбор);
		
		Если ВременныйСписок.Количество()> 0 Тогда
			Для каждого СтрокаМассива Из ВременныйСписок Цикл
				Отбор = Новый Структура();
				Отбор.Вставить("ФизЛицо",СтрокаМассива.ФизическоеЛицо);
				СписокЛьготников = ТаблицаЛьготников.НайтиСтроки(Отбор);
				
				Если СписокЛьготников.Количество() = 0 Тогда
					СокращенноеФИО 			= бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(СтрокаМассива.ФизическоеЛицо, Момент, ,Ложь);
					Если НЕ ЗначениеЗаполнено(СокращенноеФИО) Тогда
						СокращенноеФИО 		= Строка(СтрокаМассива.ФизическоеЛицо);
					КонецЕсли;
					
					СоцЗащитаФИО = ?(ЗначениеЗаполнено(СоцЗащитаФИО), СоцЗащитаФИО+ ", " + Строка(СокращенноеФИО),Строка(СокращенноеФИО));
					
				КонецЕсли;
				
			КонецЦикла; 
			
		КонецЕсли; 
		
		НачалоПериода = НачалоМесяца(ДобавитьМесяц(Момент, -1));
		КонецПериода = КонецМесяца(ДобавитьМесяц(Момент,-1));
		Для каждого Строка  Из ТаблицаЛьготников Цикл
			
			ОбластьСтрокаЛьгот.Параметры.Заполнить(Строка);
			
			СокращенноеФИО  			= бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(Строка.ФизЛицо, Момент, ,Ложь);
			Если ЗначениеЗаполнено(СокращенноеФИО) Тогда
				
				ОбластьСтрокаЛьгот.Параметры.ФизЛицо	= СокращенноеФИО;
				
			Иначе	
				ОбластьСтрокаЛьгот.Параметры.ФизЛицо	= Строка.ФизЛицо;
				
			КонецЕсли;
			ОбластьСтрокаЛьгот.Параметры.ЛьготДокДень  	= День(Строка.Период);
			ОбластьСтрокаЛьгот.Параметры.ЛьготДокМесяц 	= Месяц(Строка.Период);
			ОбластьСтрокаЛьгот.Параметры.ЛьготДокГод   	= Формат(Строка.Период,"ДФ=yy");
			
			// Заполнение размера льготын скидок.
			РазмерЛьгот =  бит_ПаспортныйСтолСервер.ПолучитьРазмерЛьготыПоФизЛицу(Строка.ФизЛицо,Строка.Льгота, Момент);
			Если РазмерЛьгот.Количество() > 0 Тогда
				
				ЛьготаРазмер = РазмерЛьгот[0].СуммаЛьготы;
			Иначе
				ЛьготаРазмер = "";
			КонецЕсли;
			ОбластьСтрокаЛьгот.Параметры.ЛьготаРазмер = ЛьготаРазмер;
			
			Результат.Вывести(ОбластьСтрокаЛьгот);
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(СоцЗащитаФИО) Тогда
			
			ОбластьСтрокаСоцЗащита.Параметры.СоцЗащитаФИО = СоцЗащитаФИО;
			
		Иначе
			
			ОбластьСтрокаСоцЗащита.Параметры.СоцЗащитаФИО = Перечисления.ДаНет.Нет;
			
		КонецЕсли; 
		
		Результат.Вывести(ОбластьСтрокаСоцЗащита);
	КонецЕсли; 
	
	// Заполнение списка счетчиков.
	ПриборыУчета = "";
	ДанныеПоСчетчикам = бит_ПаспортныйСтолСервер.ПолучитьСписокСчетчиковНаЛС(ЛицевойСчет,Момент);
	Если ДанныеПоСчетчикам.Количество() > 0 Тогда
		
		ТаблицаУслуг = ДанныеПоСчетчикам.Скопировать(,"Услуга,ТипСчетчика");
		ТаблицаУслуг.Свернуть("Услуга,ТипСчетчика");
		СписокТипов = ДанныеПоСчетчикам.Скопировать(,"ТипСчетчика");
		СписокТипов.Свернуть("ТипСчетчика");
		
		Для каждого СтрокаТипов Из СписокТипов Цикл
			Отбор = Новый Структура();
			
			Отбор.Вставить("ТипСчетчика",СтрокаТипов.ТипСчетчика);
			МассивУслуг = ТаблицаУслуг.НайтиСтроки(Отбор);
			СписокУслуг = "";
			Для каждого СтрокаУслуг Из МассивУслуг Цикл
				
				СписокУслуг = ?(ЗначениеЗаполнено(СписокУслуг),СписокУслуг + ", " + Строка(СтрокаУслуг.Услуга),Строка(СтрокаУслуг.Услуга));
				
			КонецЦикла; 
			ПриборыУчета = ?(ЗначениеЗаполнено(ПриборыУчета),ПриборыУчета +"; "+ Строка(СтрокаТипов.ТипСчетчика)+ " - " + СписокУслуг,Строка(СтрокаТипов.ТипСчетчика)+ " - " + СписокУслуг);
		КонецЦикла; 
	КонецЕсли;
	Если ЗначениеЗаполнено(ПриборыУчета) Тогда
		
		ПриборыУчета = ПриборыУчета + ".";
		
	КонецЕсли; 
	ОбластьСтрокаПриборовУчета.Параметры.ПриборыУчета = ПриборыУчета;
	Результат.Вывести(ОбластьСтрокаПриборовУчета);
	
	// Заполнение задолжности.
	ДанныеНачальногоСальдо 	= бит_ПаспортныйСтолСервер.ПолучитьОстаткиПоУслугам(ЛицевойСчет, Момент);
	СуммаДолга 				= ДанныеНачальногоСальдо.Итог("СуммаОстаток");
	ДатаДолга = Формат(Момент,"ДЛФ=DD");
	ОбластьСтрокаДолгов.Параметры.ДатаДолга = ДатаДолга;
	
	Если НЕ Объект.СправкаПоСмерти Тогда
		Если СуммаДолга > 0 Тогда
			
			ОбластьСтрокаДолгов.Параметры.ДолгНаличие = "имеется";
			СписокУслугДолгов = "";
			Для каждого Строка Из ДанныеНачальногоСальдо Цикл
				Если Строка.СуммаОстаток > 0 Тогда
					
					СписокУслугДолгов = ?(ЗначениеЗаполнено(СписокУслугДолгов),СписокУслугДолгов + ", " + Строка(Строка.УслугаЖКХ),СписокУслугДолгов + Строка(Строка.УслугаЖКХ));
					
				КонецЕсли; 
				
			КонецЦикла;
			СписокУслугДолгов = ?(ЗначениеЗаполнено(СписокУслугДолгов),СписокУслугДолгов + ".",СписокУслугДолгов);
			Результат.Вывести(ОбластьСтрокаДолгов);     
			
			ОбластьСтрокаУслугДолгов.Параметры.СписокУслугДолгов = СписокУслугДолгов;
			Результат.Вывести(ОбластьСтрокаУслугДолгов);
			
		Иначе
			
			ОбластьСтрокаДолгов.Параметры.ДолгНаличие = "не имеется";
			Результат.Вывести(ОбластьСтрокаДолгов);                       
			
		КонецЕсли; 
		
	Иначе
		Результат.Вывести(ОбластьСтрокаДолгов);                       
		
	КонецЕсли; 
	
	// Вывод данных по куммунальной квартире.
	ПризнакКоммунальной = ПолучитьПризнакТипаКвартиры();	
	Если ПризнакКоммунальной Тогда		
		ОбластьШапкаКоммунальныхКв.Параметры.ПризнакКоммунальной = Перечисления.ДаНет.Да;	
		Результат.Вывести(ОбластьШапкаКоммунальныхКв);
		Результат.Вывести(ОбластьСтрокаКоммунальныхКв);
		Результат.Вывести(ОбластьШапкаКоммунальныхКвТЧ);
		
		Для каждого Строка Из Объект.Коммунальные Цикл
			ОбластьСтрокаКоммунальныхКвТЧ.Параметры.Заполнить(Строка);
			Если ЗначениеЗаполнено(Строка.Ответственный) Тогда
				
				СокращенноеФИО 	= бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(Строка.Ответственный, Момент, ,Ложь);
				
			Иначе
				
				СокращенноеФИО 	= "свободная";
				
			КонецЕсли; 
			Если ЗначениеЗаполнено(СокращенноеФИО) Тогда
				
				ОбластьСтрокаКоммунальныхКвТЧ.Параметры.Ответственный = СокращенноеФИО;
				
			КонецЕсли;	
			Результат.Вывести(ОбластьСтрокаКоммунальныхКвТЧ);
		КонецЦикла; 
		
	Иначе
		
		ОбластьШапкаКоммунальныхКв.Параметры.ПризнакКоммунальной  = Перечисления.ДаНет.Нет; 
		
		Результат.Вывести(ОбластьШапкаКоммунальныхКв);
		Результат.Вывести(ОбластьПустаяСтрока);
		Результат.Вывести(ОбластьШапкаКоммунальныхКвТЧ);
		Результат.Вывести(ОбластьСтрокаКоммунальныхКвТЧ);
		
	КонецЕсли; 
	Результат.Вывести(ОбластьПустаяСтрока);
	
	// Вывод подвала.
	Если ЗначениеЗаполнено(Объект.ОтветственноеЛицоОрганизации) Тогда
		Отбор = Новый Структура;
		Отбор.Вставить("СтруктурнаяЕдиница",Организация);
		Отбор.Вставить("ОтветственноеЛицо",Объект.ОтветственноеЛицоОрганизации);
		ОтветственноеЛицо = РегистрыСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(Момент, Отбор);
		
		Если ОтветственноеЛицо.Количество() > 0 Тогда
			ДанныеОтветственного =  ОтветственноеЛицо[0];
			ЗаполнитьЗначенияСвойств(ОбластьПодвал.Параметры,ДанныеОтветственного);
			
			СокращенноеФИО 			= бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(ДанныеОтветственного.ФизическоеЛицо, Момент, ,Ложь);
			
			Если ЗначениеЗаполнено(СокращенноеФИО) Тогда
				
				ОбластьПодвал.Параметры.ФизическоеЛицо = СокращенноеФИО;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;
	
	// Дата через 60 дней со дня выдачи док-та.
	ДатаДействияДокумента = Объект.Дата + 60*24*60*60;
	
	ОбластьПодвал.Параметры.День   	= День(ДатаДействияДокумента);
	ДатаМесяц 						= Формат(ДатаДействияДокумента,"ДФ='дд.MMMM'");
	ОбластьПодвал.Параметры.Месяц 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ОбластьПодвал.Параметры.Год     = Формат(ДатаДействияДокумента,"ДФ=yyyy");
	
	Результат.Вывести(ОбластьПодвал);
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура СправкаПоСмертиПриИзменении(Элемент)
	
	Если Объект.СправкаПоСмерти Тогда
		ЭтаФорма.Элементы.ДатаСмерти.Видимость 		= Истина;
		ЭтаФорма.Элементы.ДатаСмерти.Доступность 	= Истина;
	Иначе
		ЭтаФорма.Элементы.ДатаСмерти.Видимость 		= Ложь;
		ЭтаФорма.Элементы.ДатаСмерти.Доступность 	= Ложь;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВыводитьВесьСписокПриИзменении(Элемент)
	
	Если Объект.ФизическиеЛица.Количество() > 0 Тогда
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ВыводитьВесьСписокПриИзмененииЗавершение", ЭтотОбъект), "Изменены настройки вывода списка проживающих. Табличная часть ""Проживающие"" будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ВыводитьВесьСписокПриИзмененииФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ВыводитьВесьСписокПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса ;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	
	ВыводитьВесьСписокПриИзмененииФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыводитьВесьСписокПриИзмененииФрагмент()
	
	Если Объект.ВыводитьВесьСписок Тогда
		
		СписокПроживающихЛиц(Объект.ЛицевойСчет, Истина);
		
	Иначе

		СписокПроживающихЛиц(Объект.ЛицевойСчет);
		
	КонецЕсли; 
	
	ЗаполнитьТабличнуюЧасть();
	
КонецПроцедуры

&НаСервере
Процедура ДобавитьФизическоеЛицоНаСервере(Знач ВыбранноеЗначение)
	
	ВременаяТабФизЛиц = ПолучитьТабличнуюЧасть();
	
	СтрокаТабличнойЧасти = ВременаяТабФизЛиц.Найти(ВыбранноеЗначение, "ФизическоеЛицо");
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		
		Если мТаблицаФизЛиц.Количество() > 0 Тогда	
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("ФизическоеЛицо", ВыбранноеЗначение);
			
			НайденныйМассив = мТаблицаФизЛиц.НайтиСтроки(Отбор);
			
			Если НайденныйМассив.Количество() > 0 Тогда
				
				НоваяСтрока = Объект.ФизическиеЛица.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныйМассив[0]);
				
			Иначе
				
				НоваяСтрока = Объект.ФизическиеЛица.Добавить();
				
				НоваяСтрока.ФизическоеЛицо = ВыбранноеЗначение;
				НоваяСтрока.ДатаРождения   = ВыбранноеЗначение.ДатаРождения;
				
			КонецЕсли; 
			
		Иначе
			
			НоваяСтрока = Объект.ФизическиеЛица.Добавить();
			
			НоваяСтрока.ФизическоеЛицо = ВыбранноеЗначение;
			НоваяСтрока.ДатаРождения   = ВыбранноеЗначение.ДатаРождения;
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДатуРожденияНаСервере(Знач ФизЛицо)
	
	Возврат ФизЛицо.ДатаРождения;
	
КонецФункции

&НаСервере
Функция ОтветственныйНаЛС(ЛицевойСчет,Момент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					ЛицевыеСчета.Ссылка
	|				ИЗ
	|					Справочник.бит_ЛицевыеСчета КАК ЛицевыеСчета
	|				ГДЕ
	|					ЛицевыеСчета.Ссылка = &ЛицевойСчет)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица <> &Удален
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизЛицо";
	
	Запрос.УстановитьПараметр("Момент", 	 Момент);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Удален", ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан"));
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	Если РезультатЗапроса.Количество()> 0 Тогда
		
		РезультатФизЛицо = РезультатЗапроса[0].ФизЛицо
	Иначе
		РезультатФизЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФизЛицо;
	
КонецФункции

#КонецОбласти