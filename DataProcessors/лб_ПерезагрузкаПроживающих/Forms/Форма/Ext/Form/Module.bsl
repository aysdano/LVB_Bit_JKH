Функция ПолучитьМассивСтруктурСоответствия()
	ТабДок = ЭтаФорма.ТабДокСоответствияРО;
	Массив = новый массив;
	Для НомСтр=2 по Табдок.ВысотаТаблицы цикл
		ИсхРО = СокрЛП(Табдок.Область(НомСтр,1).Текст);
		НовРО = СокрЛП(Табдок.Область(НомСтр,2).Текст);
		Если НЕ ПустаяСтрока(ИсхРО) тогда
			Стру = новый структура("ИсхРО,НовРО",ИсхРО,НовРО);
			Массив.Добавить(Стру);
		КонецЕсли;	
	КонецЦикла;	
	возврат Массив;
	
