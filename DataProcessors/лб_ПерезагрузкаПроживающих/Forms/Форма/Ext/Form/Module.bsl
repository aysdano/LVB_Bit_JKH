			ПодъездОбъект = Справочники.бит_Подъезды.СоздатьЭлемент();
			ПодъездОбъект.Владелец = Здание; 			
			ПодъездОбъект.КоличествоЭтажей = Этаж;			
			ПодъездОбъект.Наименование = ИмяПодъезда;
			ПодъездОбъект.Записать();
			Подъезд = ПодъездОбъект.Ссылка;
