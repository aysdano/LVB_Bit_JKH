&НаКлиенте
Процедура ДеревоПКОСчетУчетаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	МассивОтбора = Новый Массив;
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
		
		МассивОтбора.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.РасчетныеСчета"));
		МассивОтбора.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ВалютныеСчета"));
		МассивОтбора.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.СпециальныеСчета"));
		
	КонецЕсли;
	
	СписокВыбора = бит_РаботаСДиалогамиСервер.ЗаполнитьСписокВыбораСчетовДенежныхСредств(МассивОтбора);
	
	ВыбранныйЭлемент = Неопределено;
	
	
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ДеревоПКОСчетУчетаНачалоВыбораИзСпискаЗавершение", ЭтотОбъект), СписокВыбора, Элементы.ДеревоПКОСчетУчета);
	
