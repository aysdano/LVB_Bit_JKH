&НаСервере
Процедура ОпределениеПола();
	
	Строка = Строка(Отчество);
        Строка = СокрЛП(Прав(Строка, 2));  
     Если Строка = "ич" Тогда
	   Объект.Пол = Перечисления.ПолФизическогоЛица.Мужской;
      Иначе
	Объект.Пол =  Перечисления.ПолФизическогоЛица.Женский;
	
КонецЕсли;
   
				   
КонецПроцедуры

&НаКлиенте
Процедура ОтчествоПриИзменении(Элемент)
	ОпределениеПола();
КонецПроцедуры
