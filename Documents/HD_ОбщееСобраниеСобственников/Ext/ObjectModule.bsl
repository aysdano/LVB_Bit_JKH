//HD+
// Возвращает наименование месяца в родительном падеже (1 — "января", 2 — "февраля", ..., 12 — "декабря").
//
Функция МесяцВРодительномПадеже(НомерМесяца)
	МесяцыРодительный = Новый Массив;
	МесяцыРодительный.Добавить("января");
	МесяцыРодительный.Добавить("февраля");
	МесяцыРодительный.Добавить("марта");
	МесяцыРодительный.Добавить("апреля");
	МесяцыРодительный.Добавить("мая");
	МесяцыРодительный.Добавить("июня");
	МесяцыРодительный.Добавить("июля");
	МесяцыРодительный.Добавить("августа");
	МесяцыРодительный.Добавить("сентября");
	МесяцыРодительный.Добавить("октября");
	МесяцыРодительный.Добавить("ноября");
	МесяцыРодительный.Добавить("декабря");
	Если НомерМесяца >= 1 И НомерМесяца <= 12 Тогда
		Возврат МесяцыРодительный[НомерМесяца - 1];
	КонецЕсли;
	Возврат "";
