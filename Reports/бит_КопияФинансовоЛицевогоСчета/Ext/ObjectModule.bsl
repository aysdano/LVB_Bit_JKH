			ДокументРезультат.Вывести(ОбластьПодвал2);
			
			Если  ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Справка Тогда
				ОбластьПодвал3 = Макет.ПолучитьОбласть("Подвал2Справка");
				ОбластьПодвал3.Параметры.ИтогоБезЛьгот = ИтогоБезЛьготСтр;
				ОбластьПодвал3.Параметры.ИтогЛьготы = ИтогЛьготыСтр;
				ОбластьПодвал3.Параметры.СтатусКвартиры = ВРег(Строка(ВыборкаХар.СтатусКвартиры));
				
				ДокументРезультат.Вывести(ОбластьПодвал3);
			Иначе
				ДокументРезультат.Вывести(ОбластьПустаяСтрока);
				
			КонецЕсли;
			
			ОбластьПодвал4.Параметры.Организация = Строка(ЛицевойСчет.Здание.Организация);
			ОбластьПодвал4.Параметры.Дата = Формат(НачалоПериода,"ДЛФ=DD");
			ДокументРезультат.Вывести(ОбластьПодвал4);
			
			ДокументРезультат.АвтоМасштаб = Истина;
			ДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
			
			// БИТ_ЖКХ добавление кода конец : 14.06.2012   
			
		КонецЕсли;
		// БИТ_ЖКХ добавление кода конец
		
	КонецПроцедуры
	
#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Функция формирует структуру данных.
//
// Параметры:
//  <ДатаСреза>  – <Дата> – Дата среза последнего.
//
// Возвращаемое значение:
//   <Структура>   – содержит ответсвенного и кол. проживающих.
//
//
Функция ПолучитьОтветственногоИКоличество(ДатаСреза)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(Проживающие.КоличествоПроживающих, 0) КАК КоличествоПроживающих,
	|	ЕСТЬNULL(Проживающие.КоличчествоПоНорме, 0) КАК мКоличествоПоНорме,
	|	Отвественный.ФизЛицо КАК Ответственный
	|ИЗ
	|	(ВЫБРАТЬ
	|		СУММА(ВЫБОР
	|				КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПроживаниеВДанныйМомент
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК КоличествоПроживающих,
	|		СУММА(ВЫБОР
	|				КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.НачислятьПоНорме
	|					ТОГДА 1
	|				ИНАЧЕ 0
	|			КОНЕЦ) КАК КоличчествоПоНорме,
	|		бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	|	ИЗ
	|		РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевыеСчета) КАК бит_ПроживающиеПоЛССрезПоследних
	|	ГДЕ
	|		(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|				ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	
	|	СГРУППИРОВАТЬ ПО
	|		бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет) КАК Проживающие
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|			ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	|		ИЗ
	|			РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевыеСчета) КАК ПроживающиеПоЛССрезПоследних
	|		ГДЕ
	|			(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|					ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|			И ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)) КАК Отвественный
	|		ПО Проживающие.ЛицевойСчет = Отвественный.ЛицевойСчет";
	Запрос.УстановитьПараметр("Момент", ДатаСреза);
	Запрос.УстановитьПараметр("ЛицевыеСчета",ЛицевойСчет);
	СтруктураДанных = Новый Структура;
	СтруктураДанных.Вставить("Количество");
	СтруктураДанных.Вставить("Ответственный");
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		СтруктураДанных.Вставить("Количество",Выборка.КоличествоПроживающих);
		СтруктураДанных.Вставить("Ответственный",Выборка.Ответственный);
		
	КонецЕсли;
	Возврат  СтруктураДанных;
КонецФункции

// Функция формирует таблицу значений. 
//
// Параметры:
// 		Нет.
//
// Возвращаемое значение:
//   <ТаблицаЗначений>   - Содержит значения долга.
//
Функция ДолгОстаток()
	
	ДолгОстаток = Новый Запрос;
	ДолгОстаток.УстановитьПараметр("ЛицевойСчет"  , ЛицевойСчет);
	ДолгОстаток.УстановитьПараметр("КонецПериода" , КонецМесяца(КонецПериода));
	ДолгОстаток.УстановитьПараметр("НачалоПериода", НачалоМесяца(КонецПериода));
	ДолгОстаток.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК МесяцГод,
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
	|	СУММА(ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)) КАК Сумма,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Оплата,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|					ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|					ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Начисления,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Льгота
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ЛицевойСчет = &ЛицевойСчет) КАК НачисленияПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ),
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток КАК Остаток,
	|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&НачалоПериода, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(Остатки.Остаток, 0) + ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ВЫБОР
	|					КОГДА ЕСТЬNULL(Обороты.Оплата, 0) < 0
	|						ТОГДА ЕСТЬNULL(Обороты.Оплата, 0) * -1
	|					ИНАЧЕ ЕСТЬNULL(Обороты.Оплата, 0)
	|				КОНЕЦ - ВЫБОР
	|					КОГДА ЕСТЬNULL(Обороты.Льгота, 0) < 0
	|						ТОГДА ЕСТЬNULL(Обороты.Льгота, 0) * -1
	|					ИНАЧЕ ЕСТЬNULL(Обороты.Льгота, 0)
	|				КОНЕЦ > 0
	|				ТОГДА ЕСТЬNULL(Остатки.Остаток, 0) + ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ВЫБОР
	|						КОГДА ЕСТЬNULL(Обороты.Оплата, 0) < 0
	|							ТОГДА ЕСТЬNULL(Обороты.Оплата, 0) * -1
	|						ИНАЧЕ ЕСТЬNULL(Обороты.Оплата, 0)
	|					КОНЕЦ - ВЫБОР
	|						КОГДА ЕСТЬNULL(Обороты.Льгота, 0) < 0
	|							ТОГДА ЕСТЬNULL(Обороты.Льгота, 0) * -1
	|						ИНАЧЕ ЕСТЬNULL(Обороты.Льгота, 0)
	|					КОНЕЦ
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КОплате,
	|	Остатки.ЛицевойСчет
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
	|		ПО Остатки.УслугаЖКХ = Обороты.Услуга
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки";
	
	РезультатТаблицы = ДолгОстаток.Выполнить().Выгрузить();
	Если НЕ ДолгОстаток.Выполнить().Пустой() Тогда
		
		Долг = РезультатТаблицы.Получить(РезультатТаблицы.Количество()-1).КОплате;
		
	Иначе
		
		Долг = 0;
		
	КонецЕсли;
	
	
	Возврат Долг;
	
КонецФункции // ()

Функция ПолучитьТаблицуОстатков()
	
	Запрос = Новый Запрос;
	
	УстановитьПараметрыЗапроса(Запрос, Истина);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период, МЕСЯЦ) КАК МесяцГод,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток, 0) КАК СуммаНачальныйОстаток,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток, 0) КАК СуммаКонечныйОстаток,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Месяц, , ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.МесяцГод КАК МесяцГод,
	|	Остатки.УслугаЖКХ КАК Услуга,
	|	Остатки.СуммаНачальныйОстаток КАК ВхСальдо,
	|	Остатки.СуммаКонечныйОстаток КАК ИсхСальдо,
	|	Остатки.Приоритет КАК Приоритет
	|ИЗ
	|	Остатки КАК Остатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	МесяцГод,
	|	Приоритет
	|ИТОГИ
	|	СУММА(ВхСальдо),
	|	СУММА(ИсхСальдо)
	|ПО
	|	Услуга,
	|	МесяцГод ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки";
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("МесяцГод" , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Таблица.Колонки.Добавить("Услуга"   , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	Таблица.Колонки.Добавить("ВхСальдо" , ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Таблица.Колонки.Добавить("ИсхСальдо", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		ВыборкаУС = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "МесяцГод", "ВСЕ");
		
		Пока ВыборкаУС.Следующий() Цикл
			
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаУС);
			
		КонецЦикла; 
		
	КонецЦикла;               
	
	Возврат Таблица;
	
КонецФункции // ()         

// Функция получения тарифов и единиц измерения услуг.
Функция ПолучитьТарифыУслуг()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь
	|ПОМЕСТИТЬ СписокУслугНаЛС
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_СведенияПоУслугамЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокУслугНаЛС.ЛицевойСчет,
	|	СписокУслугНаЛС.Услуга,
	|	СписокУслугНаЛС.Услуга.ТипыНачислений КАК ТипыНачислений,
	|	СписокУслугНаЛС.РежимПотребления,
	|	ВЫБОР
	|		КОГДА СписокУслугНаЛС.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийПоЖКХ.Эксплуатационная)
