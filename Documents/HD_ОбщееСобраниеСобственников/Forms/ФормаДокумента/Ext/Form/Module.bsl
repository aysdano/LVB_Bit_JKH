	// Получаем номер строки из текущих данных формы
	НомерСтроки = Неопределено;
	Попытка
		НомерСтроки = Элементы.ПовесткаДня.ТекущиеДанные.НомерСтроки;
	Исключение
		Возврат;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(НомерСтроки) Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем индекс строки из объекта документа по номеру строки
	ИндексСтроки = ПолучитьИндексСтрокиПоНомеруСтроки(НомерСтроки);
	Если ИндексСтроки >= 0 Тогда
		ПовесткаДняВопросПриИзмененииНаСервере(ИндексСтроки);
	КонецЕсли;
	
