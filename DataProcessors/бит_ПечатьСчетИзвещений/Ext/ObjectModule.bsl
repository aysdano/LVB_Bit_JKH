		СтруктураДанных.ПереплатаНаНачало = ИтогоПереплатаНаНачало;
		СтруктураДанных.ПроцентОтОплаты   = ПроцентОтОплаты;
		СтруктураДанных.КОплатеЗаМесяц    = ИтогоКОплатеЗаМесяц;
		СтруктураДанных.Сальдо            = ИтогоТекСальдо;
		СтруктураДанных.НачисленоИнд      = ТаблицаПечати.Итог("НачисленоИнд");
		СтруктураДанных.НачисленоОбщДом   = ТаблицаПечати.Итог("НачисленоОбщДом");
		
		СтруктураДанных.ИтогоКОплатеСУчетомПредоплаты = ИтогоКОплате + ПроцентОтОплаты;
		СтруктураДанных.ИтогоКОплатеСУчетомПени       = СтруктураДанных.ИтогоКОплатеСУчетомПредоплаты + СтруктураДанных.ИтогПени;
		
		//19.03.2019
		если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтруктураДанных, "ЛьготаСубсидия") = истина тогда
			СтруктураДанных.ЛьготаСубсидия = СтруктураДанных.Льгота + СтруктураДанных.СубсидияПИ;
		конецесли;		
		
		Если ИтогоЗакрытиеВхДолга >= 0 Тогда
			СтруктураДанных.ДолгСУчетомОплаты = ИтогоЗакрытиеВхДолга;
		Иначе
			СтруктураДанных.Авансы = ИтогоЗакрытиеВхДолга * -1;
		КонецЕсли;
		
		Если ИтогоЗакрытиеВхДолгаБезШаблона >= 0 Тогда
			СтруктураДанных.ДолгСУчетомОплатыБезШаблона = ИтогоЗакрытиеВхДолгаБезШаблона;
		КонецЕсли;
		
		Если ИтогоТекСальдо < 0 Тогда
			СтруктураДанных.СальдоЗнак = "переплата";
			СтруктураДанных.СальдоСоЗнаком = СтруктураДанных.Сальдо * -1;
		Иначе
			СтруктураДанных.СальдоЗнак = "долг";
			СтруктураДанных.СальдоСоЗнаком = СтруктураДанных.Сальдо;
		КонецЕсли; 
		
		Если  Строка(ЭтотОбъект.ДатаПечатиКвитанций) <> "01.01.0001 0:00:00"  Тогда
			ДатаПечатиКв          = ЭтотОбъект.ДатаПечатиКвитанций;
		Иначе
			ДатаПечатиКв              = ТекущаяДата();
		КонецЕсли;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ОплатаКУ.Ссылка,
		|	бит_ОплатаКУ.СуммаДокумента,
		|	бит_ОплатаКУ.Дата,
		|	бит_ОплатаКУСписокЛС.ЛицевойСчет,
		|	бит_ОплатаКУСписокЛС.Сумма
		|ИЗ
		|	Документ.бит_ОплатаКУ.СписокЛС КАК бит_ОплатаКУСписокЛС
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОплатаКУ КАК бит_ОплатаКУ
		|		ПО бит_ОплатаКУСписокЛС.Ссылка = бит_ОплатаКУ.Ссылка
		|ГДЕ
		|	бит_ОплатаКУ.Дата > &КонецМесяца
		|	И бит_ОплатаКУ.Дата < &ДатаПечатиКвитанций
		|	И бит_ОплатаКУСписокЛС.ЛицевойСчет = &ЛицевойСчет";
		
		Запрос.УстановитьПараметр("ДатаПечатиКвитанций", ДатаПечатиКв);
		Запрос.УстановитьПараметр("КонецМесяца", КонецМесяца(Период));
		Запрос.УстановитьПараметр("ЛицевойСчет", ВыборкаЛС.ЛицевойСчет);
		
		Рез = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = Рез.Выбрать();
		
		СуммаОплат = 0;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			СуммаОплат = СуммаОплат + ВыборкаДетальныеЗаписи.Сумма;
			
		КонецЦикла;
		
		СтруктураДанных.КОплатеНаМоментПечати = СтруктураДанных.КОплате - СуммаОплат;
		
		Если СтруктураДанных.КОплатеНаМоментПечати < 0 Тогда
			
			СтруктураДанных.КОплатеНаМоментПечати = 0;
			
		КонецЕсли;	
		
		СтруктураДанных.ИтогоКОплатеСУчетомПредоплатыНаМоментПечати = СтруктураДанных.ИтогоКОплатеСУчетомПредоплаты - СуммаОплат;
		
		Если СтруктураДанных.ИтогоКОплатеСУчетомПредоплатыНаМоментПечати < 0 Тогда
			
			СтруктураДанных.ИтогоКОплатеСУчетомПредоплатыНаМоментПечати = 0;
			
		КонецЕсли;	
		
		СтруктураДанных.ИтогоКОплатеСУчетомПениНаМоментПечати = СтруктураДанных.ИтогоКОплатеСУчетомПени - СуммаОплат;
		
		Если СтруктураДанных.ИтогоКОплатеСУчетомПениНаМоментПечати < 0 Тогда
			
			СтруктураДанных.ИтогоКОплатеСУчетомПениНаМоментПечати = 0;
			
		КонецЕсли;	
		
		Попытка
			СуммаШтрихКода = СтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
		Исключение
			СуммаШтрихКода = 0;
		КонецПопытки;
		
		СтруктураДанных.ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
																						ВыборкаЛС.Наименование,
																						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонИзвещений, "Идентификатор"),
																						ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ВыборкаЛС.ЛицевойСчет, "Идентификатор"),
																						мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
																						мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);

		//БИТ ЖКХ 13.05.2020
		СтруктураДанных.СальдоСПени                      =  СтруктураДанных.ВходящееСальдоПени + СтруктураДанных.Сальдо;//СтруктураДанных.Долг;    
        //БИТ ЖКХ 26.02.2021
		СтруктураДанных.КОплатеЗаМесяцСПени =  СтруктураДанных.КОплатеЗаМесяц + СтруктураДанных.НачисленоПениЗаПериод;    
		
		Если ТаблицаПечати.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		ДанныеПоЛС = Новый Структура;
		ДанныеПоЛС.Вставить("СтруктураДанных"       , СтруктураДанных);
		ДанныеПоЛС.Вставить("ТаблицаПечати"         , ТаблицаПечати);
		ДанныеПоЛС.Вставить("ТаблицаПечатиСчетчиков", ПолучитьТаблицуПечатиСчетчиков());
		ДанныеПоЛС.Вставить("ТаблицаПерерасчетов"   , ПолучитьТаблицуПерерасчетов());
		ДанныеПоЛС.Вставить("ТаблицаСвойств"   , ЗначенияСвойств);
		ДанныеПоЛС.Вставить("ТаблицаОбщедомовыхСчетчиков"   , ТаблицаОбщедомовыхСчетчиков);
		
		СтрокаДанных = ТаблицаДанных.Добавить();
		СтрокаДанных.ЛицевойСчет = ВыборкаЛС.ЛицевойСчет;
		СтрокаДанных.ВладелецЛС  = ВыборкаЛС.ВладелецЛС;
		СтрокаДанных.Значение    = ДанныеПоЛС;
		
	КонецЦикла; 
	
	// Заполнение счетчиков.
	ВыборкаЛС = РезультатЗапроса[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		ТаблицаПечатиСчетчиков = ПолучитьТаблицуПечатиСчетчиков();
		
		ВыборкаСЧ = ВыборкаЛС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСЧ.Следующий() Цикл
			
			Выборка = ВыборкаСЧ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока Выборка.Следующий() Цикл
				
				НоваяСтрока = ТаблицаПечатиСчетчиков.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				
				Если ЗначениеЗаполнено(Выборка.Счетчик.КоэффициентУмножения) Тогда
					ОтПоказаний             = Выборка.ДоПоказаний - Выборка.КоличествоЕдиниц/Выборка.Счетчик.КоэффициентУмножения;
				Иначе
					ОтПоказаний             = Выборка.ДоПоказаний - Выборка.КоличествоЕдиниц;
				КонецЕсли;
				
				НоваяСтрока.ОтПоказаний = ?(ОтПоказаний < 0, ОтПоказаний + Выборка.Разрядность + 1, ОтПоказаний);
				
				НоваяСтрока.ДатаПоверки = ?(ЗначениеЗаполнено(Выборка.ДатаПоверки),Формат(Выборка.ДатаПоверки,"ДФ=dd.MM.yyyy"),"");
				
				НоваяСтрока.УслугаПредставление = ?(мНастройкиМакета.ИспользоватьСокращенноеНаименованиеУслуги,
													Выборка.СокрНаименование,
													Выборка.НаименованиеПолное);
				
				Если НЕ Выборка.Многотарифный Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла;
		
		СтрокаТаблицыДанных = ТаблицаДанных.Найти(ВыборкаЛС.ЛицевойСчет, "ЛицевойСчет");
		
		Если НЕ СтрокаТаблицыДанных = Неопределено Тогда
			
			СтрокаТаблицыДанных.Значение.ТаблицаПечатиСчетчиков = ТаблицаПечатиСчетчиков;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	// Заполнение информации о перерасчетах.
	ВыборкаЛС = РезультатЗапроса[2].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		ТаблицаПерерасчетов = ПолучитьТаблицуПерерасчетов();
		Выборка = ВыборкаЛС.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = ТаблицаПерерасчетов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЦикла;
		
		СтрокаТаблицыДанных = ТаблицаДанных.Найти(ВыборкаЛС.ЛицевойСчет, "ЛицевойСчет");
		
		Если НЕ СтрокаТаблицыДанных = Неопределено Тогда
			
			СтрокаТаблицыДанных.Значение.ТаблицаПерерасчетов = ТаблицаПерерасчетов;
			
		КонецЕсли;
		
	КонецЦикла;
	
	МВТ.Закрыть();
	
	Возврат ТаблицаДанных;
	
КонецФункции

