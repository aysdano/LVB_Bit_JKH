<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных2</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЛицевойСчет</dataPath>
			<field>ЛицевойСчет</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УслугаЖКХ</dataPath>
			<field>УслугаЖКХ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Сумма</dataPath>
			<field>Сумма</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдентификаторЖКУ</dataPath>
			<field>ИдентификаторЖКУ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПлатежныйДокумент</dataPath>
			<field>ПлатежныйДокумент</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Платежный документ</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ИдентификаторПД</dataPath>
			<field>ИдентификаторПД</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ДатаВнесения</dataPath>
			<field>ДатаВнесения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Дата внесения</v8:content>
				</v8:item>
			</title>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	бит_ЛицевыеСчета.КапРемИдентификаторЖКУ КАК ИдентификаторЖКУ
ПОМЕСТИТЬ ВТ_ЛицевыеСчетаОбщая
ИЗ
	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
ГДЕ
	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	И НЕ бит_СписокЗданий.ПометкаУдаления
{ГДЕ
	(бит_ЛицевыеСчета.Ссылка В (&amp;СписокЛС)),
	(бит_ЛицевыеСчета.Организация = &amp;ОтборОрганизация),
	(бит_СписокЗданий.Улица В (&amp;СписокУлиц)),
	(бит_ЛицевыеСчета.Здание В (&amp;СписокЗданий)),
	(ВЫБОР
			КОГДА &amp;ТипДомаГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.МКД)
				ТОГДА бит_СписокЗданий.ТипыДомовГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.МКД)
						ИЛИ бит_СписокЗданий.ТипыДомовГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.ПустаяСсылка)
			ИНАЧЕ бит_СписокЗданий.ТипыДомовГИСЖКХ В (&amp;ТипДомаГИСЖКХ)
		КОНЕЦ)}

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_ПлатежныеДокументыГИСЖКХ.Ссылка КАК ПлатежныйДокумент,
	бит_ПлатежныеДокументыГИСЖКХ.ЛицевойСчет КАК ЛицевойСчет,
	бит_ПлатежныеДокументыГИСЖКХ.ИдентификаторПД КАК ИдентификаторПД
ПОМЕСТИТЬ ВТ_ВсеПлатежныеДокументы
ИЗ
	Справочник.бит_ПлатежныеДокументыГИСЖКХ КАК бит_ПлатежныеДокументыГИСЖКХ
ГДЕ
	НЕ бит_ПлатежныеДокументыГИСЖКХ.Отозван
	И НЕ бит_ПлатежныеДокументыГИСЖКХ.ПометкаУдаления
	И НЕ бит_ПлатежныеДокументыГИСЖКХ.ЭтоГруппа
	И бит_ПлатежныеДокументыГИСЖКХ.ШаблонИзвещений = &amp;ШаблонИзвещений
	И бит_ПлатежныеДокументыГИСЖКХ.РасчетныйПериод МЕЖДУ НАЧАЛОПЕРИОДА(&amp;Период, МЕСЯЦ) И КОНЕЦПЕРИОДА(&amp;Период, МЕСЯЦ)
{ГДЕ
	(бит_ПлатежныеДокументыГИСЖКХ.ЛицевойСчет В (&amp;СписокЛС))}

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ЛицевыеСчетаОбщая.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_ЛицевыеСчетаОбщая.ИдентификаторЖКУ КАК ИдентификаторЖКУ,
	ВТ_ВсеПлатежныеДокументы.ПлатежныйДокумент КАК ПлатежныйДокумент,
	ВТ_ВсеПлатежныеДокументы.ИдентификаторПД КАК ИдентификаторПД
ПОМЕСТИТЬ ВТ_ПлатежныеДокументыИтого
ИЗ
	ВТ_ВсеПлатежныеДокументы КАК ВТ_ВсеПлатежныеДокументы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЛицевыеСчетаОбщая КАК ВТ_ЛицевыеСчетаОбщая
		ПО ВТ_ВсеПлатежныеДокументы.ЛицевойСчет = ВТ_ЛицевыеСчетаОбщая.ЛицевойСчет

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	бит_НачисленияПоУслугамЖКХОбороты.Период КАК ДатаВнесения,
	бит_НачисленияПоУслугамЖКХОбороты.СуммаРасход КАК Сумма
ПОМЕСТИТЬ ВТ_ВсеОплаты
ИЗ
	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
			НАЧАЛОПЕРИОДА(&amp;Период, МЕСЯЦ),
			КОНЕЦПЕРИОДА(&amp;Период, МЕСЯЦ),
			Регистратор,
			ЛицевойСчет В
				(ВЫБРАТЬ
					ВТ_ПлатежныеДокументыИтого.ЛицевойСчет
				ИЗ
					ВТ_ПлатежныеДокументыИтого КАК ВТ_ПлатежныеДокументыИтого)) КАК бит_НачисленияПоУслугамЖКХОбороты
ГДЕ
	бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ВсеОплаты.Сумма КАК Сумма,
	ВТ_ВсеОплаты.ДатаВнесения КАК ДатаВнесения,
	ВТ_ПлатежныеДокументыИтого.ИдентификаторПД КАК ИдентификаторПД,
	ВТ_ПлатежныеДокументыИтого.ИдентификаторЖКУ КАК ИдентификаторЖКУ,
	ВТ_ПлатежныеДокументыИтого.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_ПлатежныеДокументыИтого.ПлатежныйДокумент КАК ПлатежныйДокумент
ИЗ
	ВТ_ПлатежныеДокументыИтого КАК ВТ_ПлатежныеДокументыИтого
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВсеОплаты КАК ВТ_ВсеОплаты
		ПО ВТ_ПлатежныеДокументыИтого.ЛицевойСчет = ВТ_ВсеОплаты.ЛицевойСчет</query>
	</dataSet>
	<calculatedField>
		<dataPath>ДатаВнесения</dataPath>
		<expression>Формат(ДатаВнесения, "ДФ=dd.MM.yyyy")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Дата внесения</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>ПериодОплаты</dataPath>
		<expression>Формат(ДатаВнесения, "ДФ=MM.yyyy")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период оплаты</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>НачалоПериода</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
