			ТабДок = СформироватьНаСервере();
			ТабДок.Показать();
		Иначе 
			Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияПредупреждение", ЭтотОбъект);	
			ПоказатьПредупреждение(Оповещение, "Выбирете пол!",,"Предупреждение");
		КонецЕсли; 
		
	Иначе
		
		Оповещение = Новый ОписаниеОповещения("ПослеЗакрытияПредупреждение", ЭтотОбъект);	
		ПоказатьПредупреждение(Оповещение, "Заполните тип отчета!",,"Предупреждение");
		
	КонецЕсли; 
	
