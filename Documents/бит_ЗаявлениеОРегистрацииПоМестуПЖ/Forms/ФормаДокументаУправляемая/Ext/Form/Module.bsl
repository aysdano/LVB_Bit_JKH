		ШапкаОбласть.Параметры.ДомРег 			  = 	 СтруктураОткудаПрибыл.Дом;
		ШапкаОБласть.Параметры.Корпусрег 		  = 	 СтруктураОткудаПрибыл.Корпус;
		ШапкаОбласть.Параметры.КвартираРег	      = СтруктураОткудаПрибыл.Квартира;
		
	КонецЕсли;
	
	// Смена фамилии.
	Если Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаФамилии Тогда
		
		Если МакетНовогоОбразца Тогда
			
			ШапкаОбласть.Параметры.ФамилияСмена       = ДанныеПечати.ФамилияСмена;
			ШапкаОбласть.Параметры.ИмяСмена           = ДанныеПечати.ИмяСмена;
			ШапкаОбласть.Параметры.ОтчествоСмена      = ДанныеПечати.ОтчествоСмена;
			ШапкаОбласть.Параметры.ДеньРожденияСмена  = Формат(ДанныеПечати.ДатаРождения,"ДФ='дд'");
			ДатаМесяц							 	  = Формат(ДанныеПечати.ДатаРождения,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРожденияСмена = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодРожденияСмена   = Формат(ДанныеПечати.ДатаРождения,"ДФ='yyyy'");
			
			ШапкаОбласть.Параметры.РегионВыб          = ШапкаОбласть.Параметры.РегионРег;
