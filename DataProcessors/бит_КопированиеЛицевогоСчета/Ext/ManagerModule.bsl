
#Область ПроцедурыЗаполнения

// Процедура Заполнияе объект обработки по лицевому счету.
//
// Параметры:
//  Объект      – ДанныеФормыКоллекция - объект формы документа для заполнения.
//  ЛицевойСчет - СправочникСсылка     - ссылка на справочник Лицевые счета.
//                                       как основание для заполнения данных формы.
//
Процедура ЗаполнитьОбъект(Объект, ЛицевойСчет, ЗаполнятьИнформациюОКВ = Ложь, ЗаполнятьИнформациюПоУс = Ложь ) Экспорт
	
	Если НЕ ТипЗнч(ЛицевойСчет) = Тип("СправочникСсылка.бит_ЛицевыеСчета") ИЛИ ЛицевойСчет.Пустая() Тогда
		Возврат;
	КонецЕсли; 
	
	Объект.Улица    = ЛицевойСчет.УлицаЛицевогоСчета;
	Объект.Здание   = ЛицевойСчет.Здание;
	Объект.Квартира = ЛицевойСчет.Квартира;
	
	Если ЗаполнятьИнформациюОКВ Тогда
		ЗаполнитьСведенияОКвартире(Объект, ЛицевойСчет.Квартира);
	КонецЕсли; 
	
	Если ЗаполнятьИнформациюПоУс Тогда
		ЗаполнитьСведенияПоУслугам(Объект, ЛицевойСчет);
	КонецЕсли; 
	
КонецПроцедуры // ()

// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьСведенияОКвартире(Объект, Квартира) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"    , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Квартира", Квартира);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ТипПлиты,
	|	бит_СведенияОКвартиреСрезПоследних.ТипЗапирающегоУстройства
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(Объект, Выборка);
	КонецЕсли; 
	
КонецПроцедуры // ()

// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьСведенияПоУслугам(Объект, ЛицевойСчет) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик,
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга.ОсновнойСпособРасчета КАК ОсновнойСпособРасчета
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.Услуги.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
			ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению Тогда
			НоваяСтрока.СпособРасчета = Выборка.ОсновнойСпособРасчета;
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры // () 

#КонецОбласти