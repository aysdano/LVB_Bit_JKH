////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	вт2.VID КАК VID,
	вт2.Период КАК Период,
	СУММА(ЕСТЬNULL(вт2.Сумма, 0)) КАК Сумма,
	СУММА(ЕСТЬNULL(вт2.СуммаПени, 0)) КАК СуммаПени,
	ВложенныйЗапрос.Услуга КАК Услуга,
	ВложенныйЗапрос.Порядок1 КАК Порядок
ИЗ
	(ВЫБРАТЬ
		бит_УслугиЖКХ.Ссылка КАК Услуга,
		ВЫБОР
			КОГДА бит_УслугиЖКХ.Ссылка.Код = "00-000001"
				ТОГДА "010"
			КОГДА бит_УслугиЖКХ.Ссылка.Код = "00-000010"
				ТОГДА "020"
			КОГДА бит_УслугиЖКХ.Ссылка.Код = "00-000011"
				ТОГДА "030"
			КОГДА бит_УслугиЖКХ.Ссылка.Код = "00-000012"
				ТОГДА "040"
			КОГДА бит_УслугиЖКХ.Ссылка.Код = "00-000015"
				ТОГДА "050"
			КОГДА бит_УслугиЖКХ.Ссылка.Код = "00-000007"
				ТОГДА "060"
			КОГДА бит_УслугиЖКХ.Ссылка.Код = "00-000018"
				ТОГДА "070"
			КОГДА бит_УслугиЖКХ.Ссылка.Код = "00-000009"
				ТОГДА "080"
