#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура  проверки уникальности заполнения номера комнаты. 
// В пределах одной квартиры.
Процедура ПроверитьУникальностьНомераКомнаты(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_Комнаты.Ссылка
		|ИЗ
		|	Справочник.бит_Комнаты КАК бит_Комнаты
		|ГДЕ
		|	бит_Комнаты.Владелец = &Владелец
		|	И бит_Комнаты.НомерКомнаты = &НомерКомнаты
		|	И (НЕ бит_Комнаты.Ссылка = &Ссылка)";

	Запрос.УстановитьПараметр("Владелец"		, Владелец);
	Запрос.УстановитьПараметр("НомерКомнаты"	, НомерКомнаты);
	Запрос.УстановитьПараметр("Ссылка"		    , Ссылка);

	Если Не Запрос.Выполнить().Пустой() тогда
		бит_ОбщегоНазначения.СообщитьОбОшибке("Введенный номер комнаты в квартире уже существует!",Отказ,,СтатусСообщения.Важное);
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ПроверитьУникальностьНомераКомнаты(Отказ);
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли