&НаСервере
Процедура ЗагрузитьЖильцовНаЛСНаСервере()
	// Вставить содержимое обработчика.

	ЗаполнитьКэшКвартирЛицевыхСчетов();
	ЗаполнитьКэшПроживающих();
	ПодготовитьМассивСтруДляПроживающих();
	
	//Получим списокЛС
	СписокЛС = новый массив;
	ТекЛС = неопределено;	
	Для каждого Стру из МассивСтру цикл						
		Если ТекЛС<>Стру.ЛС тогда
			СписокЛС.Добавить(Стру.ЛС);
			ТекЛС = Стру.ЛС;
		КонецЕсли;			
	КонецЦикла;	
	
	УдалитьДокиРегистрацииЖильцов(СписокЛС);
	
	
	
	
	ТекЛС = Неопределено;
	МассивСтруЛицевогоСчета = новый массив;	
	ДокиРегистрации = Новый Массив;        	
	Для ТекИндекс = 0 по МассивСтру.ВГраница() цикл		
	     Стру = МассивСтру[ТекИндекс];	
		 Если стру.ЛС = ТекЛС тогда
			 МассивСтруЛицевогоСчета.Добавить(Стру);
		 Иначе
			 РегистрацияЖильцовЛС(ТекЛС,МассивСтруЛицевогоСчета);
			 МассивСтруЛицевогоСчета = новый массив(1);;
			 МассивСтруЛицевогоСчета[0] = Стру;
			 ТекЛС = Стру.ЛС;
		 КонецЕсли;	    
	КонецЦикла;
	 
	 
	РегистрацияЖильцовЛС(ТекЛС,МассивСтруЛицевогоСчета);
	
КонецПроцедуры

&НаСервере
Функция РодственныеОтношения(знач СтрокаРО)
	СтрокаРО = СокрЛП(СтрокаРО);
	Если ПустаяСтрока(СтрокаРО) тогда
		возврат Справочники.бит_СтепениРодстваФизЛиц.бит_НеУказано;
	ИначеЕсли СтрокаРО = "Ответственный" тогда
		возврат Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо;		
	КонецЕсли;	
	
	если мТаблицаИменРО= неопределено тогда
		мТаблицаИменРО = новый ТаблицаЗначений;
		мТаблицаИменРО.Колонки.Добавить("ИмяИсх",Новый ОписаниеТипов("Строка"));
		мТаблицаИменРО.Колонки.Добавить("Имя",Новый ОписаниеТипов("Строка"));
		ОбрОбъект = РеквизитФормыВЗначение("Объект");
		Макет = ОбрОбъект.ПолучитьМакет("МакетРО");
		Высота = Макет.ВысотаТаблицы;
		Для номСтроки = 2 по Высота цикл
			НовСтрока = мТаблицаИменРО.Добавить();
			НовСтрока.ИмяИсх = Макет.Область(НомСтроки,1).Текст;
			НовСтрока.Имя	 = Макет.Область(НомСтроки,2).Текст;
		КонецЦикла;	                                    
		мТаблицаИменРО.Индексы.Добавить("ИмяИсх");
	КонецЕсли;	
	
	СтрокаИменРО = мТаблицаИменРО.Найти(СтрокаРО,"ИмяИсх");
	Если СтрокаИменРО <> Неопределено тогда
		СтрокаРО = СтрокаИменРО.Имя
	КонецЕсли;	
	
	
	
	если мСтепениРодства = неопределено тогда
		мСтепениРодства = новый Соответствие;		
	КонецЕсли;	
	
	СтепеньРО = мСтепениРодства[СтрокаРО];
	Если СтепеньРО <> неопределено тогда
		возврат СтепеньРО
	КонецЕсли;
	
	СтепеньРО = Справочники.бит_СтепениРодстваФизЛиц.НайтиПоНаименованию(СтрокаРО,истина);
	Если Не ЗначениеЗаполнено(СтепеньРО) тогда
		СтепеньРО = Справочники.бит_СтепениРодстваФизЛиц.бит_НеУказано;
		//СпрОбъект = Справочники.бит_СтепениРодстваФизЛиц.СоздатьЭлемент();
		//СпрОбъект.Наименование = СтрокаРО;
		//СпрОбъект.Записать();
		//СтепеньРО = СпрОбъект.Ссылка
	КонецЕсли;	
	мСтепениРодства.Вставить(СтрокаРО,СтепеньРО);
	возврат СтепеньРО;   
КонецФункции	
	


&НаСервере
Процедура УдалитьДокиРегистрацииЖильцов(СписокЛС)
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("СписокЛС",СписокЛС);
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_РегистрацияПроживающихПоЛС.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.бит_РегистрацияПроживающихПоЛС КАК бит_РегистрацияПроживающихПоЛС
	               |ГДЕ
	               |	бит_РегистрацияПроживающихПоЛС.ЛицевойСчет В(&СписокЛС)";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() цикл		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Если Ложь тогда ДокОбъект = Документы.бит_РегистрацияПроживающихПоЛС.СоздатьДокумент() КонецЕсли;
		ДокОбъект.УстановитьПометкуУдаления(истина);
		ДокОбъект.Удалить();		 
	КонецЦикла;
	
КонецПроцедуры	
	
&НаСервере
Процедура РегистрацияЖильцовЛС(ЛС,МассивСтруЛС)
	Если ложь тогда МассивСтруЛС = новый массив КонецЕсли;
	Если не ЗначениеЗаполнено(ЛС) тогда
		возврат
	КонецЕсли;
	Если МассивСтруЛС.Количество() = 0 тогда
		возврат
	КонецЕсли;
	          	
	//коррекция даты выписки - за один день до прописки на том же ЛС
	Для Индекс = 0 по МассивСтруЛС.ВГраница()-1 цикл
		Стру1 = МассивСтруЛС[Индекс];
		Стру2 = МассивСтруЛС[Индекс+1];
		Если  Стру1.ФЛ = Стру2.ФЛ и 
				ЗначениеЗаполнено(Стру2.ДПрописки) и 
				(Стру1.ДВыписки>=Стру2.ДПрописки) тогда
				
			Стру1.ДВыписки = Стру2.ДПрописки - 24*3600; 
		КонецЕсли;	
	КонецЦикла;	
	
	//коррекция Ответственого,
	ОтвСтру		 = Неопределено;
	ОтвДВыписки  = '0001-01-01';
	Для Индекс = 0 по МассивСтруЛС.ВГраница() цикл
		Стру = МассивСтруЛС[Индекс];        
		ЭтоСобственник = стру.PR_SOB =1;		
		Если Стру.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо и 
			 			Стру.ДВыписки>ОтвДВыписки  
						и НЕ ЭтоСобственник тогда
			 ОтвСтру = Стру;
			 ОтвДВыписки = Стру.ДВыписки;
		КонецЕсли;	
	КонецЦикла;	
	
	Если ОтвДВыписки < '2500-01-01' и ОтвСтру<> Неопределено тогда
		
		НовОтв = новый структура;
		Для каждого КЗ из ОтвСтру цикл			
			НовОтв.Вставить(КЗ.Ключ,ОтвСтру[КЗ.Ключ]);
		КонецЦикла;	
		НовОтв.ДВыписки = '3000-01-01';
		НовОтв.Вставить("НетОтветственногоНаЛС",истина);
		МассивСтруЛС.Добавить(НовОтв);
	КонецЕсли;	
		
	
	
	
	
	
	СоотвДоковФЛ = новый Соответствие;  //в обном доке не более одной записи об каждом из ФЛ
	ЧислоДоков = 0;
	Для каждого Стру из МассивСтруЛС цикл
		ФЛ = Стру.ФЛ;
		ДоковДляФЛ = СоотвДоковФЛ[ФЛ];
		Если ДоковДляФЛ=неопределено тогда
			ДоковДляФЛ =1;			
		иначе
			ДоковДляФЛ = ДоковДляФЛ + 1;//увеличиваем счетчик на 1
		КонецЕсли;	
		СоотвДоковФЛ[ФЛ] = ДоковДляФЛ;
		Стру.Вставить("НомерДока",ДоковДляФЛ);
		ЧислоДоков = Макс(ЧислоДоков, ДоковДляФЛ);
	КонецЦикла;	
	
	//Сейчас все строки пронумерованы по номеру документа	
	Для НомерДока = 1 по ЧислоДоков цикл
		ДокОбъект = Документы.бит_РегистрацияПроживающихПоЛС.СоздатьДокумент();	
		ДокОбъект.Дата = Дата(2018,12,НомерДока);
		ДокОбъект.ЛицевойСчет = ЛС;
		ДокОбъект.СписокЛицевыхСчетов = Стру.ИмяЛС;
		Для каждого Стру из МассивСтруЛС цикл
			Если Стру.НомерДока<>НомерДока тогда
				продолжить
			КонецЕсли;	
								
			СтрокаЖ = ДокОбъект.СписокПроживающих.Добавить();
			//СтрокаЖ.ДатаЗаписи ='0001-01-01'; //Дата окончания статуса
			СтрокаЖ.Физлицо = Стру.ФЛ;
			СтрокаЖ.ДатаРегистрации = Стру.ДПрописки;
			СтрокаЖ.ДатаСнятияСРегистрации = ?(Стру.ДВыписки>'2500-01-01','0001-01-01',Стру.ДВыписки);
			Строкаж.ВладелецКвартиры = ?(Стру.PR_SOB=1,Перечисления.ДаНет.Да,Перечисления.ДаНет.Нет);
			СтрокаЖ.ДоляПлощади = ?(Стру.D2=0,0,Стру.D1/Стру.D2);
			СтрокаЖ.лб_ДоляПлощадиСтрокой = СокрЛП(Стру.SOBST);
			//Контрагент
			//КудаВыписан
			//КудаВыписанАдрес
			//ОткудаПрибыл
			//ОткудаПрибылАдрес
			//ПравоустанавливающиеДокументы
			//ПричинаВыписки
			//ПричинаПрописки
			СтатусПрож = Стру.STATYS;
			ЭтоСобственник = Стру.PR_SOB=1;
			НетОтветственногоЛС = Стру.Свойство("НетОтветственногоНаЛС");
			Если НетОтветственногоЛС =истина тогда
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.НайтиПоНаименованию("Ответственный не проживает");
			ИначеЕсли СтатусПрож = "постоянная" тогда
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.Постоянно;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.ПостояннаяРегистрация;
			ИначеЕсли 	СтатусПрож = "временная" тогда
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.Временно;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.ВременнаяРегистрация;
				
				//Человек не проживает. Варианты - Собственник не проживает, либо человек убран с ЛС
			иначеЕсли  ЭтоСобственник тогда
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.НайтиПоНаименованию("Владелец не проживает");
			иначе	
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.Выписан;				
			КонецЕсли;	
			///*** - добавить статусы для Саобственник не проживает - на него
			// Если собственник и выписан - меняем на Собственник не проживает
			// если не собственник и выписан - то меняем на Уделен с лицевого счета
			
			СтрокаЖ.СтепеньРодства = Стру.СтепеньРодства;
			
			
			
		КонецЦикла;	
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
	КонецЦикла;	
	
	
	
КонецПроцедуры	




	


&НаСервере
Процедура ПодготовитьМассивСтруДляПроживающих()
	Если мКэшКвартирЛС = Неопределено тогда
		ЗаполнитьКэшКвартирЛицевыхСчетов();
	КонецЕсли;
	Если мКэшПроживающих = Неопределено тогда
		ЗаполнитьКэшПроживающих();
	КонецЕсли;	
	
	//Инд = 0;
	Инд = ЭтаФорма.СтартЗапись;
	МаксИнд = МассивСтру.Вграница();
	Для Инд = 0 по МаксИнд цикл
		Стру = МассивСтру[Инд];
		Если Стру = Неопределено тогда
			продолжить
		КонецЕсли;	
		ИмяЛС = сокрЛП(Стру.LS);
		Фам = сокрЛП(Стру.FIO);
		Имя = сокрЛП(Стру.NAME);
		Отч = сокрЛП(Стру.OTCH);
		ДР  = ДатаИзСтроки(Стру.D_R);
		ДПрописки = ДатаИзСтроки(Стру.D_PR);
		ДВыписки  = ДатаИзСтроки(Стру.D_V);		
		СНИЛС = сокрЛП(Стру.SNILS);		
		Родств = сокрЛП(стру.RODOTN);
		СогласиеСтрокой = сокрЛП(Стру.SOGL);
		
			
		Стру.Вставить("ИмяЛС",ИмяЛС);
		Стру.Вставить("Фам",Фам);
		Стру.Вставить("Имя",Имя);
        Стру.Вставить("Отч",Отч);
		Стру.Вставить("ДР",ДР);
		Стру.Вставить("СНИЛС",СНИЛС);
		
		СтрокаКэшаЛС = ДанныеЛС(ИмяЛС);
		Если СтрокаКэшаЛС<>Неопределено тогда		
			Стру.Вставить("ЛС",СтрокаКэшаЛС.ЛС);
			Стру.Вставить("ЗданиеКод",СтрокаКэшаЛС.ЗданиеКод);
			Стру.Вставить("Здание",СтрокаКэшаЛС.Здание);
		иначе
			Стру.Вставить("ЛС",Неопределено);
			Стру.Вставить("ЗданиеКод",Неопределено);
			Стру.Вставить("Здание",Неопределено);

		КонецЕсли;
		
		СтрокаКэшаПрожив = ПолучитьСтрокуПроживающегоИзКэша(Фам,Имя,Отч,ДР,СНИЛС);		
		Если СтрокаКэшаПрожив<> Неопределено тогда
			Стру.Вставить("ФЛ",СтрокаКэшаПрожив.Физлицо);
			Стру.Вставить("СогласиеПД",СтрокаКэшаПрожив.СогласиеПД);
		иначе
			//Ищем запросом и добавляем в строку
			создатьОбновитьПроживающего(Стру);	
			
			СтрокаКэшаПрожив = ПолучитьСтрокуПроживающегоИзКэша(Фам,Имя,Отч,ДР,СНИЛС);
			Стру.Вставить("ФЛ",СтрокаКэшаПрожив.Физлицо);
			Стру.Вставить("СогласиеПД",СтрокаКэшаПрожив.СогласиеПД);			
			//Стру.Вставить("ФЛ",Справочники.бит_Проживающие.ПустаяСсылка());
			//Стру.Вставить("СогласиеПД",Перечисления.лб_ВидСогласияНаОбработкуПД.ПустаяСсылка());
		КонецЕсли;	

		
		
			
		
		Стру.Вставить("ДПрописки",ДПрописки);
		Стру.Вставить("ДВыписки",?(ЗначениеЗаполнено(ДВыписки),ДВыписки,'3000-01-01'));
		Стру.Вставить("СтепеньРодства",РодственныеОтношения(Родств));
		Стру.Вставить("лб_СтрокаРодствДляФЛС",Родств);              
		
		
		
				
		Если СогласиеСтрокой = "п" тогда 
			Стру.Вставить("НовСогласиеПД",Перечисления.лб_ВидСогласияНаОбработкуПД.ЕстьПаспортныйСтол)
		ИначеЕсли СогласиеСтрокой = "з" тогда 
			Стру.Вставить("НовСогласиеПД",Перечисления.лб_ВидСогласияНаОбработкуПД.ЕстьАбонентскийОтдел)
		ИначеЕсли СогласиеСтрокой = "о" или СогласиеСтрокой = "o" тогда
			Стру.Вставить("НовСогласиеПД",Перечисления.лб_ВидСогласияНаОбработкуПД.Отказ)
		иначе	
	        Стру.Вставить("НовСогласиеПД",Перечисления.лб_ВидСогласияНаОбработкуПД.ПустаяСсылка())
		КонецЕсли;
				
		
		
	КонецЦикла;	
	
	//удаляем данные по ЛС, которых нет в базе
	ЧислоУдл =0;
	ЧислоСтру = МассивСтру.Количество();
	ИндОшибки = ЧислоСтру;
	Для СчетВниз=1 по ЧислоСтру цикл
		Инд = ЧислоСтру - СчетВниз;
		Стру = МассивСтру[инд];
		Если Стру = Неопределено тогда 
			продолжить
		КонецЕсли;	
		
		Если Не ЗначениеЗаполнено(Стру.ЛС) или не ЗначениеЗаполнено(Стру.ФЛ) тогда
			//МассивСтру.Удалить(Инд); 
			МассивСтру[Инд] = неопределено;
			ЧислоУдл = ЧислоУдл+1;
