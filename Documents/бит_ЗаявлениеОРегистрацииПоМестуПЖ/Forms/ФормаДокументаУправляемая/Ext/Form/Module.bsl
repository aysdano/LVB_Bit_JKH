&НаСервере
Процедура СнимаемыеСРегУчетаПриИзмененииНаСервере()
	
	Если Объект.СнимаемыеСРегУчета.Количество() > 0 Тогда 
		Объект.РегистрируемоеЛицо = Объект.СнимаемыеСРегУчета[0].Проживающий;
		УстановитьДатуСнятия(Объект.ЛицевойСчет, Объект.РегистрируемоеЛицо);
		
		Если Объект.ЗаконныйПредставительВСвязиСНедееспособностью ИЛИ ПроверитьВозраст(Объект.РегистрируемоеЛицо) тогда
		
			ЗаконныйПредставительЗаполнить(Объект.РегистрируемоеЛицо);
			ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Истина;
			ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Истина;
		
		Иначе 
			
			Объект.ЗаконныйПредставитель = Справочники.бит_Проживающие.ПустаяСсылка();
			ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Ложь;
			ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Истина;
		
		КонецЕсли;
	
	Иначе
		Объект.РегистрируемоеЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
		
		Объект.ЗаконныйПредставитель = Справочники.бит_Проживающие.ПустаяСсылка();
		ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Ложь;
		ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Истина;

	КонецЕсли;
	
КонецПроцедуры

