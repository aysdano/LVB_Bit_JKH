	Запрос        = Новый HTTPЗапрос("/api/v8/auth?login=admin@mobsted.com&password=21e7d7d567b6f3f23e3a3018b1b2b48d");
	
	ЖурналЗапросБезКодировки   = Строка(АдресСервисаСтр)+Строка("/api/v8/auth?login=admin@mobsted.com&password=21e7d7d567b6f3f23e3a3018b1b2b48d");
	
	
