
#Область ПроцедурыИФункцииОбщегоНазначения

Процедура УдалитьЗначениеКэша(Ключ) Экспорт
	
	Если бит_ОбщегоНазначения.ЭтоСемействоБП() Тогда
		
		// В БП нет данной глобальной переменной.
		глОбщиеЗначения = Новый Структура;
		
	КонецЕсли; 
	
	Если ТипЗнч(глОбщиеЗначения) = Тип("Структура") Тогда
		
		Если глОбщиеЗначения.Свойство(Ключ) Тогда
			
			глОбщиеЗначения.Удалить(Ключ);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры // УдалитьЗначениеКэша()

Процедура ДействияПриНачалеРаботыСистемы()  Экспорт
	
	// БИТ_ЖКХ 06.09.2016 12:47:18 Начало правки... 
	//// Инициализация клиента лицензирования.
	//бит_сл_клиент.ИнициализацияКлиентаЛицензирования();
	// БИТ_ЖКХ 06.09.2016 12:47:22 Конец правки. 
	
	ПарамСтарта = бит_ПолныеПрава.ПолучитьПараметрыДляСтартаСистемы();
	
	Если ПарамСтарта.НеобходимоОбновитьИБ Тогда
		
		Если НЕ ПарамСтарта.ЕстьПраваДляОбновления Тогда
			
			ТекстСообщения =  НСтр("ru = 'Недостаточно прав для выполнения обновления конфигурации ""%1%""! Обратитесь к Администратору системы.'");
			ТекстСообщения = бит_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыСтроки(ТекстСообщения, ПарамСтарта.Сведения.Синоним_БИТ);
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ДействияПриНачалеРаботыСистемыЗавершение", ЭтотОбъект), ТекстСообщения, 60);
			Возврат;
			
		КонецЕсли; 
		
		Если ПарамСтарта.ПервыйЗапуск Тогда
			
			ТекстСообщения =  НСтр("ru = 'Будет произведено первоначальное заполнение параметров решения ""%1%"". Продолжить?'");
			ТекстСообщения = бит_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыСтроки(ТекстСообщения, ПарамСтарта.Сведения.Синоним_БИТ);	
			
			ТекстСостояния =  НСтр("ru = 'БИТ.ЖКХ. Выполняется первоначальное заполнение системы. Пожалуйста, подождите...'");
			
		Иначе	
			
			ТекстСообщения =  НСтр("ru = 'Изменился номер версии конфигурации ""%1%"". Будет выполнено обновление информационной базы на релиз ""%2%"". Продолжить?'");
			ТекстСообщения = бит_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыСтроки(ТекстСообщения
			, ПарамСтарта.Сведения.Синоним_БИТ
			, ПарамСтарта.НомерРелизаБИТ);  
			ТекстСостояния =  НСтр("ru = 'БИТ.ЖКХ. Выполняется обновление информационной базы. Пожалуйста, подождите...'");			
			
		КонецЕсли; 
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("ПарамСтарта",ПарамСтарта);
		ДополнительныеПараметры.Вставить("ТекстСостояния",ТекстСостояния);
		ДополнительныеПараметры.Вставить("ТекстСообщения",ТекстСообщения);
		
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершение", ЭтотОбъект,ДополнительныеПараметры);
		
		ПоказатьВопрос(Оповещение, ТекстСообщения, РежимДиалогаВопрос.ДаНет);	
		// БИТ_ЖКХ 11.02.2015{{
		
	Иначе           		
		
		бит_ОбщегоНазначения.ОбработкаПроверкиЗаполнения();		
		
	КонецЕсли; // Необходимо обновить ИБ.
	
КонецПроцедуры

Процедура ДействияПриНачалеРаботыСистемыЗавершение(ДополнительныеПараметры1) Экспорт
    
    ЗавершитьРаботуСистемы(Ложь);

КонецПроцедуры // ДействияПриНачалеРаботыСистемы()

Процедура ВопросЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
		
	КонецЕсли;
	
	Состояние(ДополнительныеПараметры.ТекстСостояния);
	
	РезДействий = бит_ОбщегоНазначения.ДействияПриНачалеРаботыСистемы(ДополнительныеПараметры.ПарамСтарта);		
	
	Если РезДействий.ВыполненоОбновлениеИБ Тогда
		
		// Устанавливаем заголовок.
		// БИТ_ЖКХ 01.04.2015{{
		ЗаголовокПриложения = бит_ОбщегоНазначения.ПолучитьКонстантуЗаголовокСистемы();
		
		УстановитьЗаголовокКлиентскогоПриложения(ЗаголовокПриложения);
		// БИТ_ЖКХ 01.04.2015}}
		
		Если ДополнительныеПараметры.ПарамСтарта.ПервыйЗапуск Тогда
			
		КонецЕсли; 
		
		// Откроем форму обработки обновления ИБ для выполнения опциональных действий при обновлении и отображения протокола.
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Протокол"    , РезДействий.ПротоколОбновлениеИБ);
		ПараметрыФормы.Вставить("ПервыйЗапуск", ДополнительныеПараметры.ПарамСтарта.ПервыйЗапуск);
		ОткрытьФорму("Обработка.бит_ОбновлениеИнформационнойБазы.Форма.ОписаниеОбновленийУправляемая", ПараметрыФормы, , ,);
		
	Иначе	
		
		// Обновление не удалось выполнить - предложим завершить работу.
		
		ТекстВопроса =  НСтр("ru = 'Не удалось выполнить %1%. Завершить работу системы?'");
		СтрДействие  = ?(ДополнительныеПараметры.ПарамСтарта.ПервыйЗапуск,  НСтр("ru = 'первоначальное заполнение параметров'"),  НСтр("ru = 'обновление информационной базы'"));
		ТекстВопроса = бит_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыСтроки(ТекстВопроса, СтрДействие);
		
		Оповещение = Новый ОписаниеОповещения("ВопросЗавершение2", ЭтотОбъект);
		
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);	
		// БИТ_ЖКХ 11.02.2015}}
		
	КонецЕсли; 
	
	// БИТ_ЖКХ 10.07.2014{{
	бит_ОбщегоНазначения.ОбработкаПроверкиЗаполнения();			
	
	Если ДополнительныеПараметры.ПарамСтарта.ВыполнитьДопДействия Тогда 		
		РезДействий = бит_ОбщегоНазначения.ДействияПриНачалеРаботыСистемы(ДополнительныеПараметры.ПарамСтарта); 		
	КонецЕсли;
	
	// Окно дополнительной информации БИТ
	Если ДополнительныеПараметры.ПарамСтарта.ОткрытьДополнительнуюИнформациюБИТ Тогда
		ОткрытьФорму("Обработка.бит_ДополнительнаяИнформация.Форма.ФормаУправляемая");    		
	КонецЕсли; 	
	
КонецПроцедуры

Процедура ВопросЗавершение2(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		
		ЗавершитьРаботуСистемы(Ложь);
		Возврат;
		
		// БИТ_ЖКХ_11082015_начало_изменений
	ИначеЕсли Результат = КодВозвратаДиалога.Да Тогда
		
		ЗавершитьРаботуСистемы(Ложь, Истина);
		Возврат;		
		// БИТ_ЖКХ_11082015_окончание_изменений
		
	КонецЕсли;
	
КонецПроцедуры	

// Возвращает клиентский общий модуль по имени.
//
Функция КлиентскийОбщийМодуль(Имя) Экспорт
	
	Модуль = Вычислить(Имя);
	
#Если НЕ ВебКлиент Тогда
	Если ТипЗнч(Модуль) <> Тип("ОбщийМодуль") Тогда
		ВызватьИсключение бит_ОбщегоНазначенияКлиентСервер.ПодставитьПараметрыСтроки(НСтр("ru = 'Общий модуль ""%1"" не найден.'"), Имя);
	КонецЕсли;
#КонецЕсли
	
	Возврат Модуль;
	
КонецФункции

#Если ТолстыйКлиентОбычноеПриложение ИЛИ ТолстыйКлиентУправляемоеПриложение Тогда
	
Процедура АктивироватьПриложение(ИмяПриложения, ЖдатьЗавершения = Ложь, ВыводитьОшибки = Истина) Экспорт
	
	// Готовим текст скрипта активации.
	Путь         = ПолучитьИмяВременногоФайла("vbs");
	Скрипт       = ПолучитьОбщийМакет("бит_мпд_АктивироватьПриложение");
	ТекстСкрипта = Скрипт.ПолучитьТекст();
	ТекстСкрипта = СтрЗаменить(ТекстСкрипта,"%AppID%",ИмяПриложения);
	Скрипт.УстановитьТекст(ТекстСкрипта);
	
	флЕстьОшибки = Ложь;
	
	// Записываем скрипт.
	Попытка
		
		Скрипт.Записать(Путь, КодировкаТекста.ANSI);
		
	Исключение
		
		флЕстьОшибки = Истина;
		
		Если ВыводитьОшибки Тогда
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = НСтр("ru = 'Не удалось записать скрипт активации внешнего окна %1!
										|%2'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Путь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
		КонецЕсли; 
			
	КонецПопытки;
		
	// Выполняем скрипт.
	Если НЕ флЕстьОшибки Тогда
			
		Попытка
				
			ЗапуститьПриложение(""""+Путь+"""", , ЖдатьЗавершения);
				
		Исключение
				
			Если ВыводитьОшибки Тогда
					
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстСообщения = НСтр("ru = 'Не удалось выполнить скрипт активации внешнего окна %1!
											|%2'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, Путь, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					
			КонецЕсли; 
				
		КонецПопытки;
			
	КонецЕсли; 
		
КонецПроцедуры // АктивироватьПриложение()
	
#КонецЕсли 

#КонецОбласти