
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьУчастки();
	
КонецПроцедуры

&НаСервере
Функция СформироватьНаСервере()
	
	ТабДокумент = Новый ТабличныйДокумент;
	ТекОбъект = РеквизитФормыВЗначение("Отчет");
	НачДата = Формат(Период.ДатаНачала, "ДФ=dd.MM.yyyy");
	КонДата = Формат(Период.ДатаОкончания, "ДФ=dd.MM.yyyy");
	
	Если ЗначениеЗаполнено(ДатаРождения) Тогда
		нДатаРождения = Формат(ДатаРождения.ДатаНачала, "ДФ=dd.MM.yyyy");
		кДатаРождения = Формат(ДатаРождения.ДатаОкончания, "ДФ=dd.MM.yyyy");	
	КонецЕсли; 
	
	Макет = ТекОбъект.ПолучитьМакет("Макет");
	
	ОбластьЗаголовок = Макет.ПолучитьОбласть("Заголовок");
	Если Военнообязанные Тогда
		ОбластьЗаголовок.Параметры.ЗаголовокОтчета = ТипОтчета;
	Иначе
		ОбластьЗаголовок.Параметры.ЗаголовокОтчета = СтрЗаменить(ТипОтчета, "Военнообязанные", "Проживающие");
	КонецЕсли; 	
	
	ОбластьЗаголовок.Параметры.ДатаНачала = НачДата; 
	ОбластьЗаголовок.Параметры.ДатаОкончания = КонДата; 
	ТабДокумент.Вывести(ОбластьЗаголовок);
	
	Если ТипОтчета = "Военнообязанные, зарегистрированные по месту жительства" И НЕ ВыводитьПаспортныеДанные Тогда
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаПоМестуЖительства");
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПоМестуЖительства");
	ИначеЕсли ТипОтчета = "Военнообязанные, зарегистрированные по месту жительства" И ВыводитьПаспортныеДанные Тогда
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаПоМестуЖительстваПаспорт");
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПоМестуЖительстваПаспорт");
	ИначеЕсли ТипОтчета = "Военнообязанные, зарегистрированные по месту пребывания" И НЕ ВыводитьПаспортныеДанные Тогда
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаПоМестуПребывания");
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПоМестуПребывания");	
	ИначеЕсли ТипОтчета = "Военнообязанные, зарегистрированные по месту пребывания" И ВыводитьПаспортныеДанные Тогда
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаПоМестуПребыванияПаспорт");
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаПоМестуПребыванияПаспорт");
	ИначеЕсли ТипОтчета = "Военнообязанные, снятые с регистрационного учета" И НЕ ВыводитьПаспортныеДанные Тогда
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаСнятыеСУчета");
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаСнятыеСУчета");	
	ИначеЕсли ТипОтчета = "Военнообязанные, снятые с регистрационного учета" И ВыводитьПаспортныеДанные Тогда	
		ОбластьШапка = Макет.ПолучитьОбласть("ШапкаСнятыеСУчетаПаспорт");
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаСнятыеСУчетаПаспорт");	
	КонецЕсли; 
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	ДанныеДляЗаполнения = ПолучитьДанныеДляЗаполненияНаСервере();
	НомерСтроки = 1;
	
	Если Военнообязанные Тогда
		
		Для каждого Стр Из ДанныеДляЗаполнения Цикл
			
			нВоеннообязанный = ПроверитьВоеннообязанный(Стр.ФИО);
			
			Если нВоеннообязанный Тогда
				
				ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Стр);
				
				Попытка
					ОбластьСтрока.Параметры.ДатаРождения = Формат(Стр.ДатаРождения, "ДЛФ=Д");	
				Исключение
					//ОписаниеОшибки()
				КонецПопытки; 
				Попытка
					ОбластьСтрока.Параметры.ДатаРегистрации = Формат(Стр.ДатаРегистрации, "ДЛФ=Д");
				Исключение
					//ОписаниеОшибки()
				КонецПопытки;
				
				Если ВыводитьПаспортныеДанные Тогда
					ТекстПаспорт = "Паспорт: Выдан " + Стр.ДокументКемВыдан + " " + стр.ДокументКодПодразделения + " от " + Формат(стр.ДокументДатаВыдачи, "ДЛФ=Д") + " серия "  + стр.ДокументСерия + " номер " + стр.ДокументНомер;
					ОбластьСтрока.Параметры.ПаспортныеДанные = ТекстПаспорт;
				КонецЕсли; 
				
				АдресПроживания = Стр.ЛицевойСчет.Здание.ПочтовыйАдрес + ?(ЗначениеЗаполнено(Стр.ЛицевойСчет.Квартира), ", кв." + Строка(Стр.ЛицевойСчет.Квартира),"");
				ОбластьСтрока.Параметры.АдресПроживания = АдресПроживания;
				
				ОбластьСтрока.Параметры.НомерПункта = НомерСтроки;
				НомерСтроки = НомерСтроки + 1;
				
				ТабДокумент.Вывести(ОбластьСтрока);
				
			КонецЕсли; 
			
		КонецЦикла; 	
		
	Иначе
		
		Для каждого Стр Из ДанныеДляЗаполнения Цикл
			
			ЗаполнитьЗначенияСвойств(ОбластьСтрока.Параметры, Стр);
			
			Попытка
				ОбластьСтрока.Параметры.ДатаРождения = Формат(Стр.ДатаРождения, "ДЛФ=Д");	
			Исключение
				//ОписаниеОшибки()
			КонецПопытки; 
			Попытка
				ОбластьСтрока.Параметры.ДатаРегистрации = Формат(Стр.ДатаРегистрации, "ДЛФ=Д");
			Исключение
				//ОписаниеОшибки()
			КонецПопытки;
			
			
			Если ВыводитьПаспортныеДанные Тогда
				ТекстПаспорт = "Паспорт: Выдан " + Стр.ДокументКемВыдан + " " + стр.ДокументКодПодразделения + " от " + Формат(стр.ДокументДатаВыдачи, "ДЛФ=Д") + " серия "  + стр.ДокументСерия + " номер " + стр.ДокументНомер;
				ОбластьСтрока.Параметры.ПаспортныеДанные = ТекстПаспорт;
			КонецЕсли; 
			
			АдресПроживания = Стр.ЛицевойСчет.Здание.ПочтовыйАдрес + ?(ЗначениеЗаполнено(Стр.ЛицевойСчет.Квартира), ", кв." + Строка(Стр.ЛицевойСчет.Квартира),"");
			ОбластьСтрока.Параметры.АдресПроживания = АдресПроживания;
			
			ОбластьСтрока.Параметры.НомерПункта = НомерСтроки;
			НомерСтроки = НомерСтроки + 1;
			
			ТабДокумент.Вывести(ОбластьСтрока);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
	//ТабДокумент.Вывести(ОбластьПодвал);
	
	//Пока ТабДокумент.ПроверитьВывод(ОбластьПодвал) Цикл
	ТабДокумент.Вывести(ОбластьПустаяСтрока); 
	//КонецЦикла;
	
	ТабДокумент.Вывести(ОбластьПодвал); 
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт; 
	ТабДокумент.ОтображатьСетку = Ложь;
	ТабДокумент.ПовторятьПриПечатиСтроки = ТабДокумент.Область(4, ,4);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Функция ПроверитьВоеннообязанный(Проживающий)
	
	ЗапросВоеннообязанный = Новый Запрос;
	ЗапросВоеннообязанный.УстановитьПараметр("ФизЛицо", Проживающий);
	ЗапросВоеннообязанный.УстановитьПараметр("Момент", КонецДня(Период.ДатаОкончания));
	
	ЗапросВоеннообязанный.Текст = "ВЫБРАТЬ
	|	бит_ВоинскийУчетСрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ВоинскийУчетСрезПоследних.ОтношениеКВоинскойОбязанности КАК ОтношениеКВоинскойОбязанности
	|ИЗ
	|	РегистрСведений.бит_ВоинскийУчет.СрезПоследних(&Момент, ФизЛицо  = &ФизЛицо) КАК бит_ВоинскийУчетСрезПоследних";
	
	ВыборкаВоеннообязанный = ЗапросВоеннообязанный.Выполнить().Выбрать();
	
	Если ВыборкаВоеннообязанный.Количество() > 0 Тогда
		
		ВыборкаВоеннообязанный.Следующий();
		
		Если ВыборкаВоеннообязанный.ОтношениеКВоинскойОбязанности = Перечисления.бит_ОтношениеКВоинскойОбязанности.НеВоеннообязанный Тогда
			Возврат Ложь;
		Иначе			
			Возврат Истина;
		КонецЕсли; 
		
	Иначе
		Возврат Истина;
	КонецЕсли; 
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеДляЗаполненияНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент", ТекущаяДата());
	//Запрос.УстановитьПараметр("ЛицевойСчет", Справочники.бит_ЛицевыеСчета.ПолучитьСсылку(Новый УникальныйИдентификатор("ceaf245c-1d93-11e9-ba8d-ac1f6b0f1d47")));//76141061835 (Справочник.бит_ЛицевыеСчета)
	Запрос.УстановитьПараметр("ДокументВид", Справочники.бит_ДокументыУдостоверяющиеЛичность.ПолучитьСсылку(Новый УникальныйИдентификатор("d0e846ea-daa6-11e9-ba98-ac1f6b0f1d47")));//Паспорт РФ  (Справочник.бит_ДокументыУдостоверяющиеЛичность)
	
	Если ТипОтчета = "Военнообязанные, зарегистрированные по месту жительства" Тогда		
		ПараметрТипОтчета = Новый СписокЗначений;
		ПараметрТипОтчета.Добавить(Справочники.бит_СтатусФизЛица.ПостояннаяРегистрация);
		Запрос.УстановитьПараметр("СтатусФизЛица", ПараметрТипОтчета);
		
		ЗапросДатаРегистрации = "
		|	И ПроживающиеПоЛССрезПоследних.лб_ДатаРегистрацииДляФЛС МЕЖДУ &нДатаРегистрации И &кДатаРегистрации";
		
		Запрос.УстановитьПараметр("нДатаРегистрации", Период.ДатаНачала);
		Запрос.УстановитьПараметр("кДатаРегистрации", Период.ДатаОкончания);
		
	ИначеЕсли ТипОтчета = "Военнообязанные, зарегистрированные по месту пребывания" Тогда
		ПараметрТипОтчета = Новый СписокЗначений;
		ПараметрТипОтчета.Добавить(Справочники.бит_СтатусФизЛица.ВременнаяРегистрация);
		Запрос.УстановитьПараметр("СтатусФизЛица", ПараметрТипОтчета);
		
		ЗапросДатаРегистрации = "
		|	И ПроживающиеПоЛССрезПоследних.лб_ДатаРегистрацииДляФЛС МЕЖДУ &нДатаРегистрации И &кДатаРегистрации";
		
		Запрос.УстановитьПараметр("нДатаРегистрации", Период.ДатаНачала);
		Запрос.УстановитьПараметр("кДатаРегистрации", Период.ДатаОкончания);
		
	ИначеЕсли ТипОтчета = "Военнообязанные, снятые с регистрационного учета" Тогда
		ПараметрТипОтчета = Новый СписокЗначений;
		ПараметрТипОтчета.Добавить(Справочники.бит_СтатусФизЛица.Выписан);
		ПараметрТипОтчета.Добавить(Справочники.бит_СтатусФизЛица.ПолучитьСсылку(Новый УникальныйИдентификатор("57d2081b-66eb-11ec-bac1-ac1f6b0f1d47")));// Окончание времен.рег. (Справочник.бит_СтатусФизЛица)
		ПараметрТипОтчета.Добавить(Справочники.бит_СтатусФизЛица.ПолучитьСсылку(Новый УникальныйИдентификатор("23ea2e17-191c-11e9-ba8d-ac1f6b0f1d47")));// Ответственный не проживает (Справочник.бит_СтатусФизЛица)

		Запрос.УстановитьПараметр("СтатусФизЛица", ПараметрТипОтчета);			
		
		//ЗапросДатаРегистрации = "
		//|	И ПроживающиеПоЛССрезПоследних.лб_ДатаВыпискиДляФЛС МЕЖДУ &нДатаРегистрации И &кДатаРегистрации";
		//
		//Запрос.УстановитьПараметр("нДатаРегистрации", Период.ДатаНачала);
		//Запрос.УстановитьПараметр("кДатаРегистрации", Период.ДатаОкончания);
		//
		ЗапросДатаРегистрации = "
		|	";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаРождения) Тогда
		
		нДатаРождения = ДатаРождения.ДатаНачала;
		кДатаРождения = ДатаРождения.ДатаОкончания;
		
		ЗапросДатаРождения = "
		|	И ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения МЕЖДУ &нДатаРождения И &кДатаРождения";
		
		Запрос.УстановитьПараметр("нДатаРождения", нДатаРождения);
		Запрос.УстановитьПараметр("кДатаРождения", кДатаРождения);
	Иначе
		ЗапросДатаРождения = "";
	КонецЕсли; 
	
	Если Мужчины И Женщины Тогда	
		
		ПараметрПол = Новый СписокЗначений;
		ПараметрПол.Добавить(Перечисления.ПолФизическогоЛица.Мужской);
		ПараметрПол.Добавить(Перечисления.ПолФизическогоЛица.Женский);
		Запрос.УстановитьПараметр("Пол", ПараметрПол);
		
		ЗапросПолОбщий = " 	
		|	И ПроживающиеПоЛССрезПоследних.ФизЛицо.Пол В (&Пол)";
		
		ЗапросПолМужчины = "";
		ЗапросПолЖенщины = "";
		
		
		Если Военнообязанные Тогда
			ЗапросВоеннообязанные = "
			|И ВЫБОР
			|			КОГДА ПроживающиеПоЛССрезПоследних.ФизЛицо.Пол = ЗНАЧЕНИЕ(Перечисление.ПолФизическогоЛица.Женский)
			|				ТОГДА РАЗНОСТЬДАТ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения, &Момент, ГОД) - ВЫБОР
			|						КОГДА МЕСЯЦ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) > МЕСЯЦ(&Момент)
			|							ТОГДА 1
			|						КОГДА МЕСЯЦ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) = МЕСЯЦ(&Момент)
			|								И ДЕНЬ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) > ДЕНЬ(&Момент)
			|							ТОГДА 1
			|						ИНАЧЕ 0
			|					КОНЕЦ Между 15 И 51
			|			ИНАЧЕ РАЗНОСТЬДАТ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения, &Момент, ГОД) - ВЫБОР
			|					КОГДА МЕСЯЦ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) > МЕСЯЦ(&Момент)
			|						ТОГДА 1
			|					КОГДА МЕСЯЦ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) = МЕСЯЦ(&Момент)
			|							И ДЕНЬ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) > ДЕНЬ(&Момент)
			|						ТОГДА 1
			|					ИНАЧЕ 0
			|				КОНЕЦ Между 15 И 56
			|		КОНЕЦ";
			
			Запрос.УстановитьПараметр("Момент", ТекущаяДата());
		Иначе
			ЗапросВоеннообязанные = "";
		КонецЕсли; 
		
		
	ИначеЕсли Мужчины Тогда
		
		ПараметрПол = Новый СписокЗначений;
		ПараметрПол.Добавить(Перечисления.ПолФизическогоЛица.Мужской);
		//Параметр.Добавить(Перечисления.ПолФизическогоЛица.Женский);
		Запрос.УстановитьПараметр("Пол", ПараметрПол);
		
		ЗапросПолМужчины = " 	
		|	И ПроживающиеПоЛССрезПоследних.ФизЛицо.Пол В (&Пол)";
		
		ЗапросПолОбщий = "";
		ЗапросПолЖенщины = "";
		
		Если Военнообязанные Тогда
			ЗапросВоеннообязанные = "
			|	И РАЗНОСТЬДАТ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения, &Момент, ГОД) - ВЫБОР
			|			КОГДА МЕСЯЦ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) > МЕСЯЦ(&Момент)
			|				ТОГДА 1
			|			КОГДА МЕСЯЦ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) = МЕСЯЦ(&Момент)
			|					И ДЕНЬ(ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения) > ДЕНЬ(&Момент)
			|				ТОГДА 1
			|			ИНАЧЕ 0
			|		КОНЕЦ Между 15 И 56";
			
			Запрос.УстановитьПараметр("Момент", ТекущаяДата());
		Иначе
