				КонецЕсли;
			КонецЕсли;
			
			ЗаконныйПредставитель = "" + Выборка.ЗаконныйПредставитель
			+?(ЗначениеЗаполнено(Выборка.ЗаконныйПредставитель.ДатаРождения), ", " + Формат(Выборка.ЗаконныйПредставитель.ДатаРождения, "ДФ=dd.MM.yyyy") + " г.р.", "")
			+?(ЗначениеЗаполнено(Выборка.СтепеньРодстваЗаконногоПредставителя),НРег(", " + Строка(Выборка.СтепеньРодстваЗаконногоПредставителя)), "")
			+?(ЗначениеЗаполнено(ВидДокументаПред),", " + Строка(ВидДокументаПред), "") 
			+?(ЗначениеЗаполнено(Выборка.СерияДокументаПред), ", сер. "+Строка(Выборка.СерияДокументаПред), "")
			+?(ЗначениеЗаполнено(Выборка.НомерДокументаПред), ", № "+ Строка(Выборка.НомерДокументаПред), "")
			+?(ЗначениеЗаполнено(Выборка.ДатаВыдачиПред), ", выдан: "+ Формат(Выборка.ДатаВыдачиПред,"ДФ='dd.MM.yyyy ""г.""'"), "")
			+?(ЗначениеЗаполнено(Выборка.ВыданДокументПред)," " + Строка(Выборка.ВыданДокументПред),"")
			+?(ЗначениеЗаполнено(Выборка.ДокументКодПодразделенияПред), ", код: "+ Строка(Выборка.ДокументКодПодразделенияПред),"");
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ЗаконныйПредставитель, 70, ЗаконныйПредставитель_1 , ЗаконныйПредставитель_2 );
			ЗаконныйПредставительОбласть.Параметры.ЗаконныйПредставитель1 = ЗаконныйПредставитель_1;
			ЗаконныйПредставительОбласть.Параметры.ЗаконныйПредставитель2 = ЗаконныйПредставитель_2;
			
			ТабДокумент.Вывести(ЗаконныйПредставительОбласть);
			
		КонецЕсли; 
		
		//ЧислоРег, ЧислоСнят
		Шапка1Область.Параметры.ЧислоРег  = Формат(Выборка.ДатаРегистрации,"ДФ=dd");
		Шапка1Область.Параметры.МесяцРег  = Формат(Выборка.ДатаРегистрации,"ДФ=MM");
		Шапка1Область.Параметры.ГодРег    = Формат(Выборка.ДатаРегистрации,"ДФ=yy");
		
		Шапка1Область.Параметры.ЧислоСнят = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=dd");
		Шапка1Область.Параметры.МесяцСнят = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=MM");
		Шапка1Область.Параметры.ГодСнят   = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=yy");
		
		//Ответственные
		ЗапросОтветственные = Новый Запрос;
		ЗапросОтветственные.Текст =   "ВЫБРАТЬ
		|	бит_ЗаявлениеОРегистрацииПоМестуПЖОтветственныеЗаРегистрацию.Ответственный КАК Ответственный,
		|	бит_ЗаявлениеОРегистрацииПоМестуПЖОтветственныеЗаРегистрацию.СтепеньРодства КАК СтепеньРодства
		|ПОМЕСТИТЬ ОтветственныйСтепеньРодства
		|ИЗ
		|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныеЗаРегистрацию КАК бит_ЗаявлениеОРегистрацииПоМестуПЖОтветственныеЗаРегистрацию
		|ГДЕ
		|	бит_ЗаявлениеОРегистрацииПоМестуПЖОтветственныеЗаРегистрацию.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК ДокументСерия,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК ДокументНомер,
		|	ОтветственныйСтепеньРодства.Ответственный КАК Ответственный,
		|	ОтветственныйСтепеньРодства.СтепеньРодства КАК СтепеньРодства,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ДокументВид,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи
		|ИЗ
		|	ОтветственныйСтепеньРодства КАК ОтветственныйСтепеньРодства
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Период, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
		|		ПО ОтветственныйСтепеньРодства.Ответственный = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо";
		ЗапросОтветственные.УстановитьПараметр("Ссылка", Объект.Ссылка);
		ЗапросОтветственные.УстановитьПараметр("Период", КонецДня(Объект.Дата));
		
		ВыборкаОтветственные = ЗапросОтветственные.Выполнить().Выбрать();
		Ответственные = ВыборкаОтветственные;
		СтрокаОтветственные = "";
		мОтветственные = Новый Массив;
		
		ДатаВыдачиДокументаПред		  = "";
		
		Пока ВыборкаОтветственные.Следующий() Цикл
			СтрокаОтветственные = "" +  СтрокаОтветственные + Ответственные.Ответственный 
			+?(ЗначениеЗАполнено(Ответственные.Ответственный.ДатаРождения), ", " + Формат(Ответственные.Ответственный.ДатаРождения,"ДФ=dd.MM.yyyy" ) + " г.р; ", "");
			
			ДатаВыдачиДокументаПред		  = ВыборкаОтветственные.ДокументДатаВыдачи;
			
			СтруктураОтветственные = Новый Структура;
			СтруктураОтветственные.Вставить("ОтветственноеЛицо", ПолучитьИнициалы(ВыборкаОтветственные.Ответственный)); 
			СтруктураОтветственные.Вставить("ДокументВид", ВыборкаОтветственные.ДокументВид);
			СтруктураОтветственные.Вставить("ДокументСерия", ВЫборкаОтветственные.ДокументСерия);
			СтруктураОтветственные.Вставить("ДокументНомер", ВЫборкаОтветственные.ДокументНомер);
			СтруктураОтветственные.Вставить("ДокументКемВыдан", ВыборкаОтветственные.ДокументКемВыдан);
			СтруктураОтветственные.Вставить("ДокументКодПодразделения", ВыборкаОтветственные.ДокументКодПодразделения);
			СтруктураОтветственные.Вставить("ДокументДатаВыдачи", ВыборкаОтветственные.ДокументДатаВыдачи);
			
			мОтветственные.Добавить(СтруктураОтветственные);
			
		КонецЦикла;
		
		СтрокаОтветственные = УбратьПоследнийСимвол(СтрокаОтветственные, ";");
		
		Ответственные1 = "";
		Ответственные2 = "";
		
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаОтветственные, 60, Ответственные1 , Ответственные2 );
		
		Шапка1Область.Параметры.Ответственные1 =  Ответственные1;
		ТабДокумент.Вывести(Шапка1Область);			
		
		ДлиннаОтветственные = СтрДлина(СтрокаОтветственные);
		ДлиннаТекСтроки = 60;
		
		Пока ДлиннаТекСтроки < ДлиннаОтветственные  Цикл
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Ответственные2, 95, Ответственные1 , Ответственные2 );
			ОтветственныеСтрокаОбласть.Параметры.Ответственные2 = Ответственные1;
			ДлиннаТекСтроки = ДлиннаТекСтроки + 95;
			ТабДокумент.Вывести(ОтветственныеСтрокаОбласть);
			
		КонецЦикла;
		
		//Подвал	
		//Даты
		ПодвалПослеОбласть.Параметры.ЧислоТек = Формат(Выборка.Дата,"ДФ=dd");
		ПодвалПослеОбласть.Параметры.МесяцТек = Формат(Выборка.Дата,"ДФ=MM");
		ПодвалПослеОбласть.Параметры.ГодТек   = Формат(Выборка.Дата,"ДФ=yy");
		
		ПодвалДоОбласть.Параметры.ЧислоВыдачи = Формат(Выборка.ДатаВыдачи ,"ДФ=dd");
		ПодвалДоОбласть.Параметры.МесяцВыдачи = Формат(Выборка.ДатаВыдачи ,"ДФ=MM");
		ПодвалДоОбласть.Параметры.ГодВыдачи   = Формат(Выборка.ДатаВыдачи ,"ДФ=yyyy");
		
		ПодвалДоОбласть.Параметры.ЧислоТек =   Формат(Выборка.Дата,"ДФ=dd");
		ПодвалДоОбласть.Параметры.МесяцТек =  Формат(Выборка.Дата,"ДФ=MM");
		ПодвалДоОбласть.Параметры.ГодТек =   Формат(Выборка.Дата,"ДФ=yy");
		
		//ПаспортныеДанныеРегЛица
		ПодвалДоОбласть.Параметры.ВидДокумента = Выборка.ВидДокумента;
		ПодвалДоОбласть.Параметры.СерияДокумента = Выборка.СерияДокумента;
		ПодвалДоОбласть.Параметры.НомерДокумента = Выборка.НомерДокумента;
		ПодвалДоОбласть.Параметры.ВыданДокумент = Выборка.ВыданДокумент;
		ПодвалДоОбласть.Параметры.ДокументКодПодразделения = Выборка.ДокументКодПодразделения;	
		
		//ДокументОснование		
		ОбластьДокОснование = Макет.ПолучитьОбласть("Основание");
		
		Если ЗначениеЗаполнено(Выборка.ДокументОснование) Тогда
			
			ОбластьДокОснование.Параметры.ДокументОснование1 = Выборка.ДокументОснование;	
			
		КонецЕсли;
		
		ПодвалПослеОбласть.Параметры.ДолжностноеЛицоОрганизации = Выборка.ОрганФМСКудаПрибылРуководитель;
		
		ПравоустанавливающиеДокуемнты1 = "";
		ПравоустанавливающиеДокуемнты2 = "";
		
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрПДок,60, ПравоустанавливающиеДокуемнты1, ПравоустанавливающиеДокуемнты2);	
		
		ОбластьДокОснование.Параметры.ПравоустанавливающиеДокументы = ПравоустанавливающиеДокуемнты1;
		ТабДокумент.Вывести(ОбластьДокОснование);	
			
		ОбластьПравоустанавливающиеДокументыСтрока = Макет.ПолучитьОбласть("ПравоустанавлиающиеДокументыСтрока");
		
		Пока СтрДлина(ПравоустанавливающиеДокуемнты2) > 0 Цикл
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ПравоустанавливающиеДокуемнты2,90, ПравоустанавливающиеДокуемнты1, ПравоустанавливающиеДокуемнты2);
			
			ОбластьПравоустанавливающиеДокументыСтрока.Параметры.ПравоустанавливающиеДокументы2 = ПравоустанавливающиеДокуемнты1;
			
			ТабДокумент.Вывести(ОбластьПравоустанавливающиеДокументыСтрока);
					
		КонецЦикла;
		
		//ПринятоеРешение
		ПринятоеРешение_1 = "";
		ПринятоеРешение_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ПринятоеРешениеНаименование, 80, ПринятоеРешение_1, ПринятоеРешение_2);
		ПодвалПослеОбласть.Параметры.ПринятоеРешение = ПринятоеРешение_1;
		
		//Адреса
		НаборЗаписей = НЕОПРЕДЕЛЕНО;
		бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
		ИскомаяСтрока = Неопределено;
		Для каждого СтрокаНабор Из НаборЗаписей  Цикл
			Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
				И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
				Тогда 
				ИскомаяСтрока = СтрокаНабор;
			КонецЕсли;	
			
		КонецЦикла;
		
		ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
		
		Если ЗначениеЗаполнено(ЗаписьАдрес) Тогда
			СтруктураАдресРегистрации = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
			
			Если НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
				
				НасПунктАдрес = ?(ЗначениеЗаполнено(СтруктураАдресРегистрации.НаселенныйПункт),"нас.п. "+СтруктураАдресРегистрации.НаселенныйПункт+", ","")
				+ ?(ЗначениеЗаполнено(СтруктураАдресРегистрации.Город),"г. "+СтруктураАдресРегистрации.Город+", ","")
				+ ?(ЗначениеЗаполнено(СтруктураАдресРегистрации.Район),"р-н "+СтруктураАдресРегистрации.Район+", ","")
				+ ?(ЗначениеЗаполнено(СтруктураАдресРегистрации.Регион),"рег. "+СтруктураАдресРегистрации.Регион,"");
				
				//ПодвалДоОбласть.Параметры.НаселенныйПунктРег 	= НасПунктАдрес; 
				ПодвалДоОбласть.Параметры.УлицаРег 			= СтруктураАдресРегистрации.Улица;
				ПодвалДоОбласть.Параметры.ДомРег				= СтруктураАдресРегистрации.Дом;
				ПодвалДоОбласть.Параметры.КорпусРег 			= СтруктураАдресРегистрации.Корпус;
				
			КонецЕсли; 
		КонецЕсли;
		
		ДолжностноеЛицоОрганизации = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Выборка.Организация, Выборка.ДолжностноеЛицо,Выборка.Дата);
		
		ПодвалПослеОбласть.Параметры.ДолжностноеЛицоОрганизации = ДолжностноеЛицоОрганизации;	
		
		//ПодвалПослеОбласть.Параметры.ДолжностьДЛО_1 = Выборка.ДолжностьДЛО;
		ПодвалПослеОбласть.Параметры.ДолжностьДЛО_1 = ?(ЗначениеЗаполнено(Выборка.ОрганФМСКудаПрибыл), "Начальник " + Выборка.ОрганФМСКудаПрибыл, "");
		
		ТабДокумент.Вывести(ПодвалДоОбласть);
		ОбластьПаспортныеДанныеОтветственных = Макет.ПолучитьОбласть("ПаспортныеДанныеОтветственных");
		
		Для Каждого Ответственный Из мОтветственные Цикл
			
			ОбластьПаспортныеДанныеОтветственных.Параметры.ОтветственноеЛицо = Ответственный.ОтветственноеЛицо;
			ОбластьПаспортныеДанныеОтветственных.Параметры.ВидДокументаПред =Ответственный.ДокументВид;
			ОбластьПаспортныеДанныеОтветственных.Параметры.СерияДокументаПред = Ответственный.ДокументСерия;
			ОбластьПаспортныеДанныеОтветственных.Параметры.НомерДокументаПред =  Ответственный.ДокументНомер;
			ОбластьПаспортныеДанныеОтветственных.Параметры.ВыданДокументПред = Ответственный.ДокументКемВыдан;
			ОбластьПаспортныеДанныеОтветственных.Параметры.ДокументКодПодразделенияПред =  Ответственный.ДокументКодПодразделения;
			
			ОбластьПаспортныеДанныеОтветственных.Параметры.ЧислоВыдачиПред = Формат(Ответственный.ДокументДатаВыдачи ,"ДФ=dd");
			ОбластьПаспортныеДанныеОтветственных.Параметры.МесяцВыдачиПред = Формат(Ответственный.ДокументДатаВыдачи ,"ДФ=MM");
			ОбластьПаспортныеДанныеОтветственных.Параметры.ГодВыдачиПред   = Формат(Ответственный.ДокументДатаВыдачи ,"ДФ=yyyy");
			
			ТабДокумент.Вывести(ОбластьПаспортныеДанныеОтветственных);
		КонецЦикла;
		
		
		ПодвалПослеОбласть.Параметры.ДолжностноеЛицо = ПолучитьИнициалы(Выборка.ДолжностноеЛицо);
		ПодвалПослеОбласть.Параметры.ДолжностноеЛицоОрганизации = получитьинициалы(Выборка.ОрганФМСКудаПрибыл.Руководитель);
		ТабДокумент.Вывести(ПодвалПослеОбласть);
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните обязательные поля - Лицевой счет и Регистрируемое лицо и запишите документ";
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ с печатной формой приказа о проведении.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьКР()
	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий КАК Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо КАК РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование КАК ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл КАК ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации КАК ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия КАК Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя КАК Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество КАК Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдрес КАК ОткудаПрибылАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдрес КАК КудаВыписанАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаПрибытия КАК ДатаПрибытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаУбытия КАК ДатаУбытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдресЗапятые КАК ОткудаПрибылАдресЗапятые,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдресЗапятые КАК КудаВыписанАдресЗапятые,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата КАК Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПериодРегистрацииПоПрежнемуАдресуС КАК ПериодРегистрацииПоПрежнемуАдресуС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПериодРегистрацииПоПрежнемуАдресуПо КАК ПериодРегистрацииПоПрежнемуАдресуПо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации КАК ДатаРегистрации1,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДанныеОПрибытии.Наименование КАК ДанныеОПрибытииНаименование,
	|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК КвартираРег
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие КАК бит_Проживающие
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_Проживающие.Ссылка
	|			И бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_Проживающие.Ссылка
	|			И бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЗаконныйПредставитель = бит_Проживающие.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) И ЗначениеЗаполнено(Выборка.ЛицевойСчет) Тогда
		
		ТабДокумент   = Новый ТабличныйДокумент();
		ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
		
		Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("КР_New");
		
		Шапка1Область  = Макет.ПолучитьОбласть("Шапка1");
		СтрокаПаспорт  = Макет.ПолучитьОбласть("СтрокаПаспорт");
		Шапка2Область  = Макет.ПолучитьОбласть("Шапка2");
		Шапка3Область  = Макет.ПолучитьОбласть("Шапка3");
		Шапка4Область  = Макет.ПолучитьОбласть("Шапка4");
		
		ТаблицаПаспорт = ПолучитьТаблицуДокументов();
		
		СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.МестоРождения);
		
		Шапка1Область.Параметры.Страна              = СтруктураМестоРождения.Страна;
		Шапка1Область.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
		Шапка1Область.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
		Шапка1Область.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
		Шапка1Область.Параметры.НаселенныйПунктРожд = СтруктураМестоРождения.Село;
		
		Если Объект.КонтактнаяИнформация.Количество() > 0 Тогда
			Отбор = Новый Структура();
			Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ОткудаПрибылПредставление);
			Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
			Если Строки.Количество() = 0 И ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) Тогда
				СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
			ИначеЕсли НЕ Строки.количество() = 0 Тогда
				//  15.10.2018
				Если ЗначениеЗаполнено(Строки[0].Значение) Тогда					
					
					АдресПрибытияПредставление = Строки[0].Представление;
					СтруктураАдресПрибытия = ПолучитьМуниципальныйАдресБСП(Строки[0].Значение);
					//---
				ИначеЕсли ЗначениеЗаполнено(Выборка.ОткудаПрибылАдресЗапятые) Тогда
					СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдресЗапятые);
				ИначеЕсли ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) Тогда
					Если Объект.ОткудаПрибылИзЛС Тогда
						Если НЕ ПустаяСтрока(Объект.ОткудаПрибылАдрес) Тогда
							ОткудаПрибылПредставление = бит_УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдресаПоСтрока(Объект.ОткудаПрибылАдрес);
							ОткудаПрибылКонтактнаяИнформацияНаСервере();	
						КонецЕсли;
						Если ЗначениеЗаполнено(ОткудаПрибылПредставлениеЗапятые) Тогда
							СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ОткудаПрибылПредставлениеЗапятые);
						КонецЕсли; 
					Иначе
						Попытка
							СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Объект.ОткудаПрибылАдрес);
						Исключение
							Сообщение = Новый СообщениеПользователю();
							Сообщение.Текст = "Перезаполните откуда прибыл адрес";
							Сообщение.Сообщить();
							СтруктураАдресПрибытия = Неопределено;
						КонецПопытки;
					КонецЕсли; 
				Иначе
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Заполните откуда прибыл адрес";
					Сообщение.Сообщить();
					СтруктураАдресПрибытия = Неопределено;
				КонецЕсли;
			КонецЕсли;			
		Иначе
			СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
		КонецЕсли;		
		
		НаборЗаписей = НЕОПРЕДЕЛЕНО;
		Если Выборка.РегистрируемоеЛицо.КонтактнаяИнформация.Количество() > 0 Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.АдресПрибытияДрРегион);
			Строки = Выборка.РегистрируемоеЛицо.КонтактнаяИнформация.НайтиСтроки(Отбор);
			
			
			Если Строки.количество() = 0 и ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.АдресПрибытияДрРегион) Тогда
				
				СтруктураАдресПрибИзДрРегиона = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.РегистрируемоеЛицо.АдресПрибытияДрРегион);
				
			ИначеЕсли НЕ Строки.количество() = 0 Тогда
				
				//  15.10.2018
				Если ЗначениеЗаполнено(Строки[0].Значение) Тогда
					
					АдресПрибытияДрРегионПредставление = Строки[0].Представление;
					СтруктураАдресПрибИзДрРегиона = ПолучитьМуниципальныйАдресБСП(Строки[0].Значение);
					//-----
				ИначеЕсли ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.АдресПрибытияДрРегион) Тогда
					
					СтруктураАдресПрибИзДрРегиона = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.РегистрируемоеЛицо.АдресПрибытияДрРегион);
					Если СтруктураАдресПрибИзДрРегиона.Свойство("Регион") = Ложь Тогда
						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перезаполните адрес прибытия из другого региона");
						СтруктураАдресПрибИзДрРегиона = Неопределено;
					КонецЕсли;	
					
				ИначеЕсли НЕ ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.АдресПрибытияДрРегион) Тогда
					
					бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.РегистрируемоеЛицо);
					ИскомаяСтрока = Неопределено;
					Для каждого СтрокаНабор Из НаборЗаписей  Цикл
						Если СтрокаНабор.Тип  = Перечисления.бит_ТипыКонтактнойИнформации.Адрес
							И СтрокаНабор.Вид = Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытияДрРегион
							Тогда 
							ИскомаяСтрока = СтрокаНабор;
							Прервать;
						КонецЕсли;
					КонецЦикла;
					ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
					СтруктураАдресПрибИзДрРегиона = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
					
				Иначе
					
					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перезаполните адрес прибытия из другого региона");
					СтруктураАдресПрибИзДрРегиона = Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;			
			
		КонецЕсли;
		
		Если Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СДругогоГорода Тогда
			
			// Левый блок.
			Если СтруктураАдресПрибытия <> Неопределено Тогда
				
				Шапка1Область.Параметры.РегионПрибДГ		  = СтруктураАдресПрибытия.Регион;
				Шапка1Область.Параметры.РайонПрибДГ           = СтруктураАдресПрибытия.Район;
				Шапка1Область.Параметры.ГородПрибДГ           = СтруктураАдресПрибытия.Город;
				Шапка1Область.Параметры.НаселенныйПунктПрибДГ = СтруктураАдресПрибытия.НаселенныйПункт;
				Шапка1Область.Параметры.УлицаПрибТГ  		  = СтруктураАдресПрибытия.Улица;
				Шапка1Область.Параметры.ДомПрибТГ      		  = СтруктураАдресПрибытия.Дом;
				Шапка1Область.Параметры.КорпусПрибТГ   		  = СтруктураАдресПрибытия.Корпус;
				Шапка1Область.Параметры.КвартираПрибТГ		  = СтруктураАдресПрибытия.Квартира;
				
			ИначеЕсли СтруктураАдресПрибИзДрРегиона <> Неопределено	Тогда
				
				Шапка1Область.Параметры.РегионПрибДГ          = СтруктураАдресПрибИзДрРегиона.Регион;
				Шапка1Область.Параметры.РайонПрибДГ           = СтруктураАдресПрибИзДрРегиона.Район;
				Шапка1Область.Параметры.ГородПрибДГ           = СтруктураАдресПрибИзДрРегиона.Город;
				Шапка1Область.Параметры.НаселенныйПунктПрибДГ = СтруктураАдресПрибИзДрРегиона.НаселенныйПункт;
				Шапка1Область.Параметры.УлицаПрибТГ   		  = СтруктураАдресПрибытия.Улица;
				Шапка1Область.Параметры.ДомПрибТГ      = СтруктураАдресПрибытия.Дом;
				Шапка1Область.Параметры.КорпусПрибТГ   = СтруктураАдресПрибытия.Корпус;
				Шапка1Область.Параметры.КвартираПрибТГ = СтруктураАдресПрибытия.Квартира;
				
			КонецЕсли;
			
			Шапка1Область.Параметры.ДеньПрибТГ     = Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуС,"ДФ=dd");
			ДатаМесяц							   = Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуС,"ДФ='дд.MMMM'");
			Шапка1Область.Параметры.МесяцПрибТГ    = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			Шапка1Область.Параметры.ГодПрибТГ      = Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуС,"ДФ=yyyy");
			Шапка1Область.Параметры.ДеньСнятия     = Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуПо,"ДФ=dd");
			ДатаМесяц							   = Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуПо,"ДФ='дд.MMMM'");
