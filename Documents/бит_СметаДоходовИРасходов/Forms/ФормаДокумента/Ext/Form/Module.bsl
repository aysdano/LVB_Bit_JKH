// Функция вычисляет разность дат исходя из заданной периодичности
//
// Параметры:
//  ДатаНачала    – Дата,
//  ДатаОкончания - Дата,
//  Периодичность - Строка.
//
// Возвращаемое значение:
//   Разность   – Число.
//
Функция РазностьДат(ДатаНачала,ДатаОкончания,Периодичность) 
	
	Разность = 0;
	Если ВРег(Периодичность) = "ДЕКАДА" Тогда
		
		// Язык запросов декады не воспринимает в функции разность дат... посчитаем так.
		РазностьМесяцев = РазностьДат(ДатаНачала,ДатаОкончания,"Месяц");
		НомерДекадыНач  = НомерДекады(ДатаНачала);
		НомерДекадыКон  = НомерДекады(ДатаОкончания);		 
		Разность = РазностьМесяцев*3+НомерДекадыКон-НомерДекадыНач;
		
	ИначеЕсли ВРег(Периодичность) = "НЕДЕЛЯ" Тогда
		
		// Язык запросов декады не воспринимает в функции разность дат... посчитаем так.
		РазностьЛет = РазностьДат(ДатаНачала,ДатаОкончания,"Год");
		Разность    = РазностьЛет*53+НеделяГода(ДатаОкончания)-НеделяГода(ДатаНачала);
		
	ИначеЕсли ВРег(Периодичность) = "ПОЛУГОДИЕ" Тогда
		
		// Язык запросов полугодие не воспринимает в функции разность дат... посчитаем так.
		РазностьМесяцев = РазностьДат(ДатаНачала,ДатаОкончания,"Месяц");
		Разность		 = Цел(РазностьМесяцев / 6);
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		|	РАЗНОСТЬДАТ(&ДатаНачала, &ДатаОкончания,"+Периодичность+") КАК Разность";
		
		Запрос.УстановитьПараметр("ДатаНачала",ДатаНачала);
		Запрос.УстановитьПараметр("ДатаОкончания",ДатаОкончания);
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Разность = Выборка.Разность;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат Разность;
	
КонецФункции

&НаСервере
// Функция вычисляет номер декады в месяце
//
// Параметры:
//  ТекущаяДата  – Дата.
//
// Возвращаемое значение:
//   НомерДекады   – Число.
//
Функция НомерДекады(ТекущаяДата) 
	
	НомерДня = День(ТекущаяДата);
	Если НомерДня>=1 И НомерДня<=10 Тогда
		НомерДекады = 1;
	ИначеЕсли НомерДня>=11 И НомерДня<=20 Тогда
		НомерДекады = 2;
	Иначе
		НомерДекады = 3;
	КонецЕсли; 
	
	Возврат НомерДекады;
	
КонецФункции

&НаСервере
// Функция получает период по сдвигу исходя из текущего периода и периодичности
//
// Параметры:
//  ДатаНачала  	   – Дата,
//  Сдвиг       	   – Число,
//  Периодичность      - ПеречислениеСсылка.бит_ПериодичностьПланирования,
//  НеприводитьКНачалу - Булево, по умолчанию Ложь.
//
// Возвращаемое значение:
//  ТекущийПериод   – Дата.
//
Функция ПолучитьПериодПоСдвигу(ДатаНачала,Сдвиг,Периодичность,НеприводитьКНачалу = Ложь) 
	
	Если Не НеприводитьКНачалу Тогда
		ТекущийПериод = ПолучитьНачалоПериода(ДатаНачала,Периодичность);
	Иначе
		ТекущийПериод = ДатаНачала;
	КонецЕсли;
	
	Если Сдвиг >= 0 Тогда
		
		Для Значение = 1 По Сдвиг Цикл
			
			КонецПериода  = ПолучитьКонецПериода(ТекущийПериод  ,Периодичность);
			ТекущийПериод = ПолучитьНачалоПериода(КонецПериода+1,Периодичность);
			
		КонецЦикла;
		
	Иначе
		
		КоличествоПериодов = бит_ОбщегоНазначения.МодульЧисла(Сдвиг);
		Для Значение = 1 По КоличествоПериодов Цикл
			
			НачалоПериода = ПолучитьНачалоПериода(ТекущийПериод  ,Периодичность);
			ТекущийПериод = ПолучитьНачалоПериода(ТекущийПериод-1,Периодичность);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	Возврат ТекущийПериод;
	
КонецФункции

