&НаСервере
Процедура СформироватьНаСервере()  	
	
  Для каждого ТекСтрока Из Объект.ТаблицаУслуг Цикл	
	  
	// БИТ ЖКХ 30.04.2020  
	МенеджерЗаписи = РегистрыСведений.бит_ПениПоУслугамЖКХ.СоздатьМенеджерЗаписи();
			
	МенеджерЗаписи.Период		     = Объект.Дата;
	МенеджерЗаписи.Организация       = Объект.Организация;			
	МенеджерЗаписи.ПериодНачисления  = Объект.ПериодНачисления; 
			
	ЗаполнитьЗначенияСвойств(МенеджерЗаписи, ТекСтрока);
			
	// Попытаемся записать менеджер записи.
	ОтказЗаписи = Ложь;
	
	Попытка
		МенеджерЗаписи.Записать();
	Исключение
		ТекстСообщения = "Не удалось записать значение настройки """ + ТекСтрока.Настройка + """: ";
		бит_ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения + ОписаниеОшибки(), ОтказЗаписи);
	КонецПопытки;
	
  конеццикла;	

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧасть()
	
	Объект.ТаблицаУслуг.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"        , Объект.Дата);        
	Запрос.УстановитьПараметр("Организация" , Объект.Организация);
	Запрос.УстановитьПараметр("ПериодНачисления" , Объект.ПериодНачисления);
	
	Запрос.Текст = "ВЫБРАТЬ 
	               |	бит_ПениПоУслугамЖКХСрезПоследних.Период КАК Период,
	               |	бит_ПениПоУслугамЖКХСрезПоследних.Организация КАК Организация,
	               |	бит_ПениПоУслугамЖКХСрезПоследних.Услуга КАК Услуга,
	               |	бит_ПениПоУслугамЖКХСрезПоследних.Начислять КАК Начислять,
	               |	бит_ПениПоУслугамЖКХСрезПоследних.Процент КАК Процент,
	               |	бит_ПениПоУслугамЖКХСрезПоследних.ПериодНачисления КАК ПериодНачисления
	               |ИЗ
	               |	РегистрСведений.бит_ПениПоУслугамЖКХ.СрезПоследних (&Дата,
	               |	                             Организация = &Организация ) КАК бит_ПениПоУслугамЖКХСрезПоследних";
			
	Результат = Запрос.Выполнить().Выгрузить();
	периодНачисления = справочники.бит_ПериодыНачисленияПени.НайтиПоНаименованию("1 месяц");
	Объект.ПериодНачисления = периодНачисления;
	если Результат.Количество() > 0 тогда 
	 Результат.Сортировать("Период");
	 если Результат[0].ПериодНачисления <> справочники.бит_ПериодыНачисленияПени.ПустаяСсылка() тогда
	  периодНачисления = Результат[0].ПериодНачисления;
	  Объект.ПериодНачисления = периодНачисления;
	 конецесли; 
	конецесли;   	

	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_УслугиЖКХ.Ссылка КАК Услуга,
	               |	ЕСТЬNULL(бит_ПениПоУслугамЖКХСрезПоследних.Начислять, ЛОЖЬ) КАК Начислять,
	               |	ЕСТЬNULL(бит_ПениПоУслугамЖКХСрезПоследних.Процент, 0) КАК Процент,
	               |	ЛОЖЬ КАК НовЗначение,
	               |	ЕСТЬNULL(бит_ПениПоУслугамЖКХСрезПоследних.Начислять, ЛОЖЬ) КАК НачислятьДо,
	               |	ЕСТЬNULL(бит_ПениПоУслугамЖКХСрезПоследних.Процент, 0) КАК ПроцентДо
	               |ИЗ
	               |	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПениПоУслугамЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_ПениПоУслугамЖКХСрезПоследних
	               |		ПО бит_УслугиЖКХ.Ссылка = бит_ПениПоУслугамЖКХСрезПоследних.Услуга
	               |ГДЕ
	               |	НЕ бит_УслугиЖКХ.Ссылка = ЗНАЧЕНИЕ(Справочник.бит_УслугиЖКХ.Пеня)
	               |	И бит_ПениПоУслугамЖКХСрезПоследних.ПериодНачисления = &ПериодНачисления";
	
	Запрос.УстановитьПараметр("ПериодНачисления", ПериодНачисления);
	Результат = Запрос.Выполнить().Выгрузить();

	
	для каждого стр из Результат цикл
		НоваяСтрока = Объект.ТаблицаУслуг.Добавить();
				
		НоваяСтрока.Услуга = стр.Услуга;
		НоваяСтрока.Начислять = стр.Начислять;
				
		ставкаПроцент = ПолучитьСтавкуРефинансирования(Объект.Дата, Объект.ПериодНачисления);  	
		НоваяСтрока.Процент = ставкаПроцент.Процент;
		НоваяСтрока.Ставка = ставкаПроцент.Ставка;
	конеццикла;		
		
КонецПроцедуры


