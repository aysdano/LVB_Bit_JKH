		ТекущиеДанные.Здание              = ВыбранноеЗначение;
		ТекущиеДанные.ЗданиеПредставление = "ул." + Улица + " ,д" + ВыбранноеЗначение;
		
		Если ЗначениеЗаполнено(Объект.СпособРаспределения) Тогда
			ЗаполнитьПроцентыСписокЗданий();
		КонецЕсли; 
		
	КонецЕсли;
	
