				 НовЗапись.Период 		 = НаборП.Отбор.Регистратор.Значение.Дата;
				 НовЗапись.Активность = Истина;
				 НовЗапись.ВладелецКвартиры 	= Перечисления.ДаНет.Нет;
				 НовЗапись.СтатусФизЛица		= ОтветственныйНеПроживает;					
				 НовЗапись.СтепеньРодства       = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо;
				 НовЗапись.СтатусПроживания     = Перечисления.бит_СтатусПроживания.НеПроживает;
				 НовЗапись.ДатаРегистрации      = '0001-01-01';
				 НовЗапись.ДатаСнятияСРегистрации = '0001-01-01';
				 //НовЗапись.ДатаЗаписи             =  //дата окнчания действия 
				 НовЗапись.ДоляПлощади            = 0;
				 НовЗапись.лб_ДоляПлощадиСтрокой  = 0;
				 НовЗапись.лб_СтрокаРодствДляФЛС  = "л/с закрыт"							   
				
			 иначе
				//Найдем строку ответственного с самой большой датой
				СтрокаТекОтветственного = неопределено;
				ДатаПропискиОтветственного = '0001-01-01';			
				Для Индекс=0 по ТаблИсхЛС.Количество()-1 цикл
					ТекСтрока = ТаблИсхЛС[Индекс];
					Если ложь тогда ТекСтрока = РегистрыСведений.лб_Тест_Жильцы.СоздатьМенеджерЗаписи();  КонецЕсли;					
					Если ТекСтрока.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо и 
						 ТекСтрока.ДатаПрописки >=ДатаПропискиОтветственного 
					тогда
						 СтрокаТекОтветственного = ТекСтрока;
						 ДатаПропискиОтветственного = ТекСтрока.ДатаПрописки;
					КонецЕсли;	 
				КонецЦикла;	
				Если СтрокаТекОтветственного = неопределено тогда
					//вообще нет ответственного - добавляем ответственного сразу в регистр
					 НовЗапись = ТаблП.Добавить();
					 НовЗапись.ЛицевойСчет   = Выборка.ЛС;
