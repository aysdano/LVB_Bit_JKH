КонецФункции // ПолучитьСписокУслугПоЛС()

// Функция получает таблицу значений счетчиков услуг, подключенных на ЛС на Момент времени.
Функция ПолучитьСписокСчетчиковНаЛС(ЛицевойСчет,Момент)Экспорт
	Если Момент = Неопределено  Тогда
		
		Момент = ТекущаяДата();
		
	КонецЕсли; 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет,
	|	бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик КАК Счетчики,
	|	бит_ГрупповыеСчетчикиСрезПоследних.Услуга,
	|	бит_ГрупповыеСчетчикиСрезПоследних.Использовать,
	|	бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик.ТипСчетчика КАК ТипСчетчика
	|ИЗ
	|	РегистрСведений.бит_ГрупповыеСчетчики.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_ГрупповыеСчетчикиСрезПоследних
	|ГДЕ
	|	бит_ГрупповыеСчетчикиСрезПоследних.Использовать = ИСТИНА
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.ТипСчетчика
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Момент, Объект = &ЛицевойСчет) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
