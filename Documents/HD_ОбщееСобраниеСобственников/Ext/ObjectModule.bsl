//HD+
// Возвращает части даты реквизита документа по пути вида «Объект.<ИмяРеквизита>».
//
Функция ПолучитьЧастиДатыРеквизитаДокументаПоПути(Знач ПутьРеквизита)
	
	ПутьСтрокой = СокрЛП(Строка(ПутьРеквизита));
	Если НЕ ЗначениеЗаполнено(ПутьСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Префикс = "Объект.";
	Если Лев(ПутьСтрокой, СтрДлина(Префикс)) = Префикс Тогда
		ИмяРеквизита = Сред(ПутьСтрокой, СтрДлина(Префикс) + 1);
	Иначе
		ИмяРеквизита = ПутьСтрокой;
	КонецЕсли;
	
	ИмяРеквизита = СокрЛП(ИмяРеквизита);
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МетаданныеРеквизита = Метаданные.Документы.HD_ОбщееСобраниеСобственников.Реквизиты.Найти(ИмяРеквизита);
	Если МетаданныеРеквизита = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеТипов = МетаданныеРеквизита.Тип;
	Если НЕ ОписаниеТипов.СодержитТип(Тип("Дата")) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
	
КонецФункции //HD-

//HD+
// Формирует строковое представление значения пользовательского параметра для печати (без склонения).
//
Функция ПредставлениеЗначенияПользовательскогоПараметраДляПечати(СтрокаПараметра)
	
	ИмяПараметра = СокрЛП(Строка(СтрокаПараметра.Параметр));
	ПутьСвязиПараметра = СокрЛП(Строка(СтрокаПараметра.ОбъектДляСвязи));
	ТипПараметраСтрокой = НормализоватьТипПараметраПользовательскогоПараметра(Строка(СтрокаПараметра.ТипПараметра));
	ЗначениеПараметра = СтрокаПараметра.Значение;
	
	Если ПутьСвязиПараметра = "Объект.ВладелецСчетаКР"
		ИЛИ ВРег(ИмяПараметра) = ВРег("ВладелецСчетаКР") Тогда
		Возврат ПредставлениеВладельцаСчетаКРДляПечати(ЗначениеПараметра);
	КонецЕсли;
	
	//HD+ Если это Организация, выводим её сокращенное наименование
	Если ПутьСвязиПараметра = "Объект.Организация"
		ИЛИ ВРег(ИмяПараметра) = ВРег("Организация") Тогда
		Возврат ПредставлениеОрганизацииДляПечати(ЗначениеПараметра);
	КонецЕсли; //HD-
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипПараметраСтрокой = "Число" И ТипЗнч(ЗначениеПараметра) = Тип("Число") Тогда
		Возврат Формат(ЗначениеПараметра, "ЧГ=");
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Дата") Тогда
		ЧастиДатыРеквизита = ПолучитьЧастиДатыРеквизитаДокументаПоПути(ПутьСвязиПараметра);
		Если ТипПараметраСтрокой = "Дата" ИЛИ ЧастиДатыРеквизита = ЧастиДаты.Дата Тогда
			Возврат Формат(ЗначениеПараметра, "ДЛФ=D");
		ИначеЕсли ЧастиДатыРеквизита = ЧастиДаты.ДатаВремя Тогда
			Возврат ФорматироватьДатуВремяБезЛидирующегоНуля(ЗначениеПараметра);
		Иначе
			Если Час(ЗначениеПараметра) = 0 И Минута(ЗначениеПараметра) = 0 И Секунда(ЗначениеПараметра) = 0 Тогда
				Возврат Формат(ЗначениеПараметра, "ДЛФ=D");
			Иначе
				Возврат ФорматироватьДатуВремяБезЛидирующегоНуля(ЗначениеПараметра);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	ПрефиксМетаданныхСправочника = "Справочник.";
	Если ЗначениеЗаполнено(ТипПараметраСтрокой)
		И Лев(ТипПараметраСтрокой, СтрДлина(ПрефиксМетаданныхСправочника)) = ПрефиксМетаданныхСправочника Тогда
		
		// Если это банк, выводим только его наименование без БИК
		Если ТипПараметраСтрокой = "Справочник.Банки" Тогда
			Возврат СокрЛП(ЗначениеПараметра.Наименование);
		//HD+ Если это Организация, выводим её сокращенное наименование
		ИначеЕсли ТипПараметраСтрокой = "Справочник.Организации" Тогда
			Попытка
				Возврат СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеПараметра, "НаименованиеСокращенное")));
			Исключение
			КонецПопытки;
		//HD-
		КонецЕсли;
		
		Возврат СокрЛП(Строка(ЗначениеПараметра));
	КонецЕсли;
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЗначениеПараметра)) Тогда
		Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Банки") Тогда
			Возврат СокрЛП(ЗначениеПараметра.Наименование);
		//HD+ Если это Организация, выводим её сокращенное наименование
		ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Организации") Тогда
			Возврат СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеПараметра, "НаименованиеСокращенное")));
		//HD-
		КонецЕсли;
		
		Возврат СокрЛП(Строка(ЗначениеПараметра));
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеПараметра));
	
КонецФункции //HD-

//HD+
// Определяет, нужно ли склонять значение параметра при печати (только строковые / ФИО).
//
Функция НужноСклонятьЗначениеПользовательскогоПараметраДляПечати(СтрокаПараметра)
	
	ПутьСвязиПараметра = СокрЛП(Строка(СтрокаПараметра.ОбъектДляСвязи));
	ИмяПараметра = СокрЛП(Строка(СтрокаПараметра.Параметр));
	
	Если ПутьСвязиПараметра = "Объект.ВладелецСчетаКР"
		ИЛИ ВРег(ИмяПараметра) = ВРег("ВладелецСчетаКР") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//HD+ Если это Организация, не склоняем
	Если ПутьСвязиПараметра = "Объект.Организация"
		ИЛИ ВРег(ИмяПараметра) = ВРег("Организация") Тогда
		Возврат Ложь;
	КонецЕсли; //HD-
	
	//HD+ Составной список членов совета / предложенный председатель не склоняем целиком
	Если ЭтоИмяИлиПутьСпискаПредложенныхЧленовСоветаДляПечати(ИмяПараметра, ПутьСвязиПараметра)
		ИЛИ ЭтоИмяИлиПутьПредложенногоПредседателяДляПечати(ИмяПараметра, ПутьСвязиПараметра) Тогда
		Возврат Ложь;
	КонецЕсли;
	//HD-
	
	ТипПараметраСтрокой = НормализоватьТипПараметраПользовательскогоПараметра(Строка(СтрокаПараметра.ТипПараметра));
	
	Если Лев(ВРег(ИмяПараметра), СтрДлина("АРЕНДАТОР")) = "АРЕНДАТОР" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипПараметраСтрокой = "Число" ИЛИ ТипПараметраСтрокой = "Дата" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ЧастьТипа Из ПолучитьЧастиТипаПользовательскогоПараметраДляПечати(СтрокаПараметра.ТипПараметра) Цикл
		
		Если ЧастьТипа = "Число" ИЛИ ЧастьТипа = "Дата" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧастьТипа = "Строка"
			ИЛИ ЧастьТипа = "Справочник.бит_Проживающие"
			ИЛИ ЧастьТипа = "Справочник.ФизическиеЛица" Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	ПрефиксМетаданныхСправочника = "Справочник.";
	Если ЗначениеЗаполнено(ТипПараметраСтрокой)
		И Лев(ТипПараметраСтрокой, СтрДлина(ПрефиксМетаданныхСправочника)) = ПрефиксМетаданныхСправочника
		И СтрНайти(ТипПараметраСтрокой, ",") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//HD+ Тип «Строка» — склоняем и при ссылочном значении из ОбъектДляСвязи (например, бит_Проживающие → ФИО)
	Если ТипПараметраСтрокой = "Строка" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СтрокаПараметра.Значение)) Тогда
		ТипЗначения = ТипЗнч(СтрокаПараметра.Значение);
		Если ТипЗначения = Тип("СправочникСсылка.бит_Проживающие")
			ИЛИ ТипЗначения = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТипПараметраСтрокой)
		И ТипЗнч(СтрокаПараметра.Значение) = Тип("Строка") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции //HD-

//HD+
// Применяет падеж к строковому значению для печати через ПросклонятьФИО.
// При падеже КакЕсть (и Именительный) возвращает исходную строку без склонения.
//
Функция ПрименитьПадежКСтроковомуЗначениюДляПечати(Знач ЗначениеСтрокой, Падеж)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ПадежТребуетСклоненияДляПечати(Падеж) Тогда
		Возврат СокрЛП(ЗначениеСтрокой);
	КонецЕсли;
	
	НомерПадежа = ПолучитьНомерПадежаДляСклонения(Падеж);
	
	Попытка
		РезультатСклонения = СклонениеПредставленийОбъектов.ПросклонятьФИО(ЗначениеСтрокой, НомерПадежа);
		Если ЗначениеЗаполнено(РезультатСклонения) Тогда
			Возврат СокрЛП(РезультатСклонения);
		КонецЕсли;
	Исключение
		// Оставляем исходное представление
	КонецПопытки;
	
	Возврат СокрЛП(ЗначениеСтрокой);
	
КонецФункции //HD-

//HD+
// Формирует соответствие имя параметра → значение для печати с учётом падежа из ТЧ ПользовательскиеПараметры.
//
Функция ПолучитьСоответствиеПользовательскихПараметровДляПечати()
	
	Результат = Новый Соответствие;
	
	Если ПользовательскиеПараметры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаПараметра Из ПользовательскиеПараметры Цикл
		
		ИмяПараметра = СокрЛП(Строка(СтрокаПараметра.Параметр));
		ПутьСвязиПараметра = СокрЛП(Строка(СтрокаПараметра.ОбъектДляСвязи));
		
		//HD+ Составные параметры органов собрания — пересобираем из ТЧ на момент печати
		Если ЭтоИмяИлиПутьСпискаПредложенныхЧленовСоветаДляПечати(ИмяПараметра, ПутьСвязиПараметра) Тогда
			ЗначениеПараметра = СформироватьСписокПредложенныхЧленовСоветаДляПечати();
			СтрокаПараметра.Значение = ЗначениеПараметра;
		ИначеЕсли ЭтоИмяИлиПутьПредложенногоПредседателяДляПечати(ИмяПараметра, ПутьСвязиПараметра) Тогда
			ЗначениеПараметра = СформироватьПредложенногоПредседателяДляПечати();
			СтрокаПараметра.Значение = ЗначениеПараметра;
		Иначе
			ЗначениеПараметра = ПредставлениеЗначенияПользовательскогоПараметраДляПечати(СтрокаПараметра);
			
			Если НужноСклонятьЗначениеПользовательскогоПараметраДляПечати(СтрокаПараметра)
				И ПадежТребуетСклоненияДляПечати(СтрокаПараметра.Падеж) Тогда
				ЗначениеПараметра = ПрименитьПадежКСтроковомуЗначениюДляПечати(ЗначениеПараметра, СтрокаПараметра.Падеж);
			КонецЕсли;
			
			//HD+ В шаблонах повестки адрес часто содержит слово «Улица» (например, МКД_Улица из Объект.МКД_Улица)
			ЗначениеПараметра = УбратьСловоУлицаИзСтрокиАдресаДляПечати(ЗначениеПараметра);
		КонецЕсли;
		//HD-
		
		Если ЗначениеЗаполнено(ИмяПараметра) И ЗначениеЗаполнено(ЗначениеПараметра) Тогда
			Если Результат.Получить(ИмяПараметра) = Неопределено Тогда
				Результат.Вставить(ИмяПараметра, ЗначениеПараметра);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Признак параметра/пути составного списка предложенных членов совета (для печати).
//
Функция ЭтоИмяИлиПутьСпискаПредложенныхЧленовСоветаДляПечати(Знач ИмяПараметра, Знач ПутьСвязи)
	
	ИмяЭталон = ВРег("СписокПредложенныхЧленовСовета");
	ПутьЭталон = ВРег("Объект.СписокПредложенныхЧленовСовета");
	
	Если ЗначениеЗаполнено(ИмяПараметра) И ВРег(СокрЛП(Строка(ИмяПараметра))) = ИмяЭталон Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПутьСтрокой = ВРег(СокрЛП(Строка(ПутьСвязи)));
	Если НЕ ЗначениеЗаполнено(ПутьСтрокой) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПутьСтрокой = ПутьЭталон ИЛИ ПутьСтрокой = ИмяЭталон;
	
КонецФункции //HD-

//HD+
// Признак параметра/пути составного предложенного председателя (для печати).
//
Функция ЭтоИмяИлиПутьПредложенногоПредседателяДляПечати(Знач ИмяПараметра, Знач ПутьСвязи)
	
	ИмяЭталон = ВРег("ПредложенныйПредседатель");
	ПутьЭталон = ВРег("Объект.ПредложенныйПредседатель");
	
	Если ЗначениеЗаполнено(ИмяПараметра) И ВРег(СокрЛП(Строка(ИмяПараметра))) = ИмяЭталон Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПутьСтрокой = ВРег(СокрЛП(Строка(ПутьСвязи)));
	Если НЕ ЗначениеЗаполнено(ПутьСтрокой) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ПутьСтрокой = ПутьЭталон ИЛИ ПутьСтрокой = ИмяЭталон;
	
КонецФункции //HD-

//HD+
// Собирает список «ФИО кв.N» (каждый с новой строки) только по заполненным ролям ПредложенныйЧленСовета_1.._5 (для печати).
//
Функция СформироватьСписокПредложенныхЧленовСоветаДляПечати()
	
	ЧастиСписка = Новый Массив;
	
	Для НомерРоли = 1 По 5 Цикл
		
		ИмяРоли = "ПредложенныйЧленСовета_" + Формат(НомерРоли, "ЧГ=");
		РольУчастника = Неопределено;
		Попытка
			РольУчастника = Перечисления.HD_РолиУчастников[ИмяРоли];
		Исключение
			РольУчастника = Неопределено;
		КонецПопытки;
		
		Если НЕ ЗначениеЗаполнено(РольУчастника) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаУчастника = Неопределено;
		Для Каждого СтрокаОрганов Из ПредседательСекретарьСчетнаяКомиссия Цикл
			Если СтрокаОрганов.Роль = РольУчастника Тогда
				СтрокаУчастника = СтрокаОрганов;
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если СтрокаУчастника = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
			Продолжить;
		КонецЕсли;
		
		ФИО = СокрЛП(Строка(СтрокаУчастника.Собственник));
		Если НЕ ЗначениеЗаполнено(ФИО) Тогда
			Продолжить;
		КонецЕсли;
		
		Квартира = СокрЛП(Строка(СтрокаУчастника.НомерКвартиры));
		Если ЗначениеЗаполнено(Квартира) Тогда
			ЧастиСписка.Добавить(ФИО + " кв." + Квартира);
		Иначе
			ЧастиСписка.Добавить(ФИО);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СобратьМногострочныйСписокЧленовСоветаСРазделителямиДляПечати(ЧастиСписка);
	
КонецФункции //HD-

//HD+
// Собирает строку «ФИО кв.N» по заполненной роли ПредложенныйПредседатель из ТЧ органов собрания (для печати).
//
Функция СформироватьПредложенногоПредседателяДляПечати()
	
	РольУчастника = Неопределено;
	Попытка
		РольУчастника = Перечисления.HD_РолиУчастников["ПредложенныйПредседатель"];
	Исключение
		РольУчастника = Неопределено;
	КонецПопытки;
	
	Если НЕ ЗначениеЗаполнено(РольУчастника) Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаУчастника = Неопределено;
	Для Каждого СтрокаОрганов Из ПредседательСекретарьСчетнаяКомиссия Цикл
		Если СтрокаОрганов.Роль = РольУчастника Тогда
			СтрокаУчастника = СтрокаОрганов;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	Если СтрокаУчастника = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
		Возврат "";
	КонецЕсли;
	
	ФИО = СокрЛП(Строка(СтрокаУчастника.Собственник));
	Если НЕ ЗначениеЗаполнено(ФИО) Тогда
		Возврат "";
	КонецЕсли;
	
	Квартира = СокрЛП(Строка(СтрокаУчастника.НомерКвартиры));
	Если ЗначениеЗаполнено(Квартира) Тогда
		Возврат ФИО + " кв." + Квартира;
	КонецЕсли;
	
	Возврат ФИО;
	
КонецФункции //HD-

//HD+
// Собирает многострочный список: у всех строк кроме последней — запятая, у последней — точка.
//
Функция СобратьМногострочныйСписокЧленовСоветаСРазделителямиДляПечати(ЧастиСписка)
	
	Если ЧастиСписка = Неопределено ИЛИ ЧастиСписка.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокиСРазделителями = Новый Массив;
	КоличествоЧастей = ЧастиСписка.Количество();
	
	Для Индекс = 0 По КоличествоЧастей - 1 Цикл
		Если Индекс < КоличествоЧастей - 1 Тогда
			СтрокиСРазделителями.Добавить(ЧастиСписка[Индекс] + ",");
		Иначе
			СтрокиСРазделителями.Добавить(ЧастиСписка[Индекс] + ".");
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(СтрокиСРазделителями, Символы.ПС);
	
КонецФункции //HD-

//HD+
// Признак заполненности параметра для опционального блока [?Имя]…[/?Имя].
// Пустое значение на форме представлено плейсхолдером [Имя]; при печати пустые параметры в соответствие не попадают.
//
Функция ПараметрЗаполненДляОпциональногоБлокаПечати(Знач ИмяПараметра, СоответствиеПараметров)
	
	ИмяПараметра = СокрЛП(Строка(ИмяПараметра));
	Если НЕ ЗначениеЗаполнено(ИмяПараметра) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СоответствиеПараметров = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначениеПараметра = СоответствиеПараметров.Получить(ИмяПараметра);
	Если ЗначениеПараметра = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Строка(ЗначениеПараметра) = "[" + ИмяПараметра + "]" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции //HD-

//HD+
// Обрабатывает опциональные фрагменты вида [?ИмяПараметра]…[/?ИмяПараметра]:
// при заполненном параметре оставляет содержимое блока, при пустом — удаляет блок целиком.
//
Функция ОбработатьОпциональныеБлокиПараметровВТекстеДляПечати(Знач ИсходныйТекст, СоответствиеПараметров)
	
	Если НЕ ЗначениеЗаполнено(ИсходныйТекст) Тогда
		Возврат ИсходныйТекст;
	КонецЕсли;
	
	ТекстРезультат = Строка(ИсходныйТекст);
	ПрефиксОткрытия = "[?";
	СмещениеПоиска = 1;
	ЗащитаОтЗацикливания = 0;
	
	Пока ЗащитаОтЗацикливания < 1000 Цикл
		
		ЗащитаОтЗацикливания = ЗащитаОтЗацикливания + 1;
		
		ПозицияОткрытия = СтрНайти(ТекстРезультат, ПрефиксОткрытия, НаправлениеПоиска.СНачала, СмещениеПоиска);
		Если ПозицияОткрытия = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПозицияПослеПрефикса = ПозицияОткрытия + СтрДлина(ПрефиксОткрытия);
		ПозицияКонцаИмени = СтрНайти(ТекстРезультат, "]", НаправлениеПоиска.СНачала, ПозицияПослеПрефикса);
		Если ПозицияКонцаИмени = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ИмяПараметра = СокрЛП(Сред(ТекстРезультат, ПозицияПослеПрефикса, ПозицияКонцаИмени - ПозицияПослеПрефикса));
		Если НЕ ЗначениеЗаполнено(ИмяПараметра) ИЛИ Лев(ИмяПараметра, 1) = "/" Тогда
			СмещениеПоиска = ПозицияОткрытия + 1;
			Продолжить;
		КонецЕсли;
		
		МаркерОткрытия = "[?" + ИмяПараметра + "]";
		МаркерЗакрытия = "[/?" + ИмяПараметра + "]";
		
		Если Сред(ТекстРезультат, ПозицияОткрытия, СтрДлина(МаркерОткрытия)) <> МаркерОткрытия Тогда
			СмещениеПоиска = ПозицияОткрытия + 1;
			Продолжить;
		КонецЕсли;
		
		ПозицияЗакрытия = СтрНайти(ТекстРезультат, МаркерЗакрытия, НаправлениеПоиска.СНачала,
			ПозицияОткрытия + СтрДлина(МаркерОткрытия));
		Если ПозицияЗакрытия = 0 Тогда
			СмещениеПоиска = ПозицияОткрытия + 1;
			Продолжить;
		КонецЕсли;
		
		ПозицияНачалаСодержимого = ПозицияОткрытия + СтрДлина(МаркерОткрытия);
		СодержимоеБлока = Сред(ТекстРезультат, ПозицияНачалаСодержимого, ПозицияЗакрытия - ПозицияНачалаСодержимого);
		
		Если ПараметрЗаполненДляОпциональногоБлокаПечати(ИмяПараметра, СоответствиеПараметров) Тогда
			ТекстЗамены = СодержимоеБлока;
		Иначе
			ТекстЗамены = "";
		КонецЕсли;
		
		ТекстРезультат = Лев(ТекстРезультат, ПозицияОткрытия - 1)
			+ ТекстЗамены
			+ Сред(ТекстРезультат, ПозицияЗакрытия + СтрДлина(МаркерЗакрытия));
		
		СмещениеПоиска = ПозицияОткрытия;
		
	КонецЦикла;
	
	Возврат ТекстРезультат;
	
КонецФункции //HD-

//HD+
// Подставляет значения параметров в текст. Плейсхолдеры: [ИмяПараметра].
// Сначала обрабатываются опциональные блоки [?Имя]…[/?Имя].
//
Функция ПодставитьПользовательскиеПараметрыВТекстДляПечати(Текст, СоответствиеПараметров)
	
	Результат = Текст;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ОбработатьОпциональныеБлокиПараметровВТекстеДляПечати(Результат, СоответствиеПараметров);
	
	Если СоответствиеПараметров = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Пара Из СоответствиеПараметров Цикл
		Плейсхолдер = "[" + Пара.Ключ + "]";
		Результат = СтрЗаменить(Результат, Плейсхолдер, Пара.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Тексты пункта справочника HD_ПовесткиСобранийСобственников для печати. Реквизит Приложение читается только если есть в метаданных.
//
Функция ПолучитьДанныеПунктаПовесткиСправочникаДляПечати(Знач СсылкаПовестки)
	
	Результат = Новый Структура;
	Результат.Вставить("Вопрос", "");
	Результат.Вставить("ФормулировкаПредложенияРешенияВопроса", "");
	Результат.Вставить("Приложение", "");
	Результат.Вставить("ЭтоПриложение", Ложь);
	
	Если НЕ ЗначениеЗаполнено(СсылкаПовестки)
		ИЛИ ТипЗнч(СсылкаПовестки) <> Тип("СправочникСсылка.HD_ПовесткиСобранийСобственников") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИменаРеквизитов = Новый Массив;
	МетаданныеСправочника = Метаданные.Справочники.HD_ПовесткиСобранийСобственников;
	
	Если МетаданныеСправочника.Реквизиты.Найти("Вопрос") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("Вопрос");
	КонецЕсли;
	Если МетаданныеСправочника.Реквизиты.Найти("ФормулировкаПредложенияРешенияВопроса") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("ФормулировкаПредложенияРешенияВопроса");
	КонецЕсли;
	Если МетаданныеСправочника.Реквизиты.Найти("Приложение") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("Приложение");
	КонецЕсли;
	Если МетаданныеСправочника.Реквизиты.Найти("ЭтоПриложение") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("ЭтоПриложение");
	КонецЕсли;
	
	Если ИменаРеквизитов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаПовестки, СтрСоединить(ИменаРеквизитов, ","));
	Если ТипЗнч(ЗначенияРеквизитов) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначенияРеквизитов.Свойство("Вопрос") Тогда
		Результат.Вопрос = Строка(ЗначенияРеквизитов.Вопрос);
	КонецЕсли;
	Если ЗначенияРеквизитов.Свойство("ФормулировкаПредложенияРешенияВопроса") Тогда
		Результат.ФормулировкаПредложенияРешенияВопроса = Строка(ЗначенияРеквизитов.ФормулировкаПредложенияРешенияВопроса);
	КонецЕсли;
	Если ЗначенияРеквизитов.Свойство("Приложение") Тогда
		Результат.Приложение = Строка(ЗначенияРеквизитов.Приложение);
	КонецЕсли;
	Если ЗначенияРеквизитов.Свойство("ЭтоПриложение")
		И ТипЗнч(ЗначенияРеквизитов.ЭтоПриложение) = Тип("Булево") Тогда
		Результат.ЭтоПриложение = ЗначенияРеквизитов.ЭтоПриложение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Текст реквизита Приложение строки ТЧ ПовесткаДня, если реквизит есть.
//
Функция ПолучитьТекстПриложенияСтрокиПовесткиДляПечати(СтрокаПовестки)
	
	Если СтрокаПовестки = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	РеквизитПриложение = Метаданные.Документы.HD_ОбщееСобраниеСобственников.ТабличныеЧасти.ПовесткаДня.Реквизиты.Найти("Приложение");
	Если РеквизитПриложение = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		Возврат Строка(СтрокаПовестки.Приложение);
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Возвращает исходные шаблоны текстов повестки (из справочника или текущих значений ТЧ).
// Ключ: «ИндексСтроки_ИмяПоля».
//
Функция ПолучитьШаблоныТекстаПовесткиДляПечати()
	
	ШаблоныТекста = Новый Соответствие;
	
	Если НЕ ЗначениеЗаполнено(ШаблонПовестки) Тогда
		ИндексСтроки = 0;
		Для Каждого СтрокаПовестки Из ПовесткаДня Цикл
			Если ЗначениеЗаполнено(СтрокаПовестки.Вопрос) Тогда
				ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_Вопрос", Строка(СтрокаПовестки.Вопрос));
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса) Тогда
				ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса",
					Строка(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса));
			КонецЕсли;
			ТекстПриложения = ПолучитьТекстПриложенияСтрокиПовесткиДляПечати(СтрокаПовестки);
			Если ЗначениеЗаполнено(ТекстПриложения) Тогда
				ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_Приложение", ТекстПриложения);
			КонецЕсли;
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
		Возврат ШаблоныТекста;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ШаблонПовестки.СписокПевесток)
		ИЛИ ШаблонПовестки.СписокПевесток.Количество() = 0 Тогда
		ИндексСтроки = 0;
		Для Каждого СтрокаПовестки Из ПовесткаДня Цикл
			Если ЗначениеЗаполнено(СтрокаПовестки.Вопрос) Тогда
				ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_Вопрос", Строка(СтрокаПовестки.Вопрос));
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса) Тогда
				ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса",
					Строка(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса));
			КонецЕсли;
			ТекстПриложения = ПолучитьТекстПриложенияСтрокиПовесткиДляПечати(СтрокаПовестки);
			Если ЗначениеЗаполнено(ТекстПриложения) Тогда
				ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_Приложение", ТекстПриложения);
			КонецЕсли;
			ИндексСтроки = ИндексСтроки + 1;
		КонецЦикла;
		Возврат ШаблоныТекста;
	КонецЕсли;
	
	ИндексСтроки = 0;
	Для Каждого СтрокаТЧ Из ШаблонПовестки.СписокПевесток Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Повестка) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеПунктаПовестки = ПолучитьДанныеПунктаПовесткиСправочникаДляПечати(СтрокаТЧ.Повестка);
		Если ЗначениеЗаполнено(ДанныеПунктаПовестки.Вопрос) Тогда
			ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_Вопрос", ДанныеПунктаПовестки.Вопрос);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеПунктаПовестки.ФормулировкаПредложенияРешенияВопроса) Тогда
			ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса",
				ДанныеПунктаПовестки.ФормулировкаПредложенияРешенияВопроса);
		КонецЕсли;
		Если ЗначениеЗаполнено(ДанныеПунктаПовестки.Приложение) Тогда
			ШаблоныТекста.Вставить(Формат(ИндексСтроки, "ЧГ=") + "_Приложение", ДанныеПунктаПовестки.Приложение);
		КонецЕсли;
		ИндексСтроки = ИндексСтроки + 1;
		
	КонецЦикла;
	
	Возврат ШаблоныТекста;
	
КонецФункции //HD-

//HD+
// Формирует текст поля строки повестки для печати: подстановка параметров с учётом падежа из исходного шаблона.
//
Функция ПолучитьТекстПоляПовесткиДляПечати(ИндексСтроки, ИмяПоля, ШаблоныТекста, СоответствиеПараметров)
	
	Ключ = Формат(ИндексСтроки, "ЧГ=") + "_" + ИмяПоля;
	ШаблонТекста = ШаблоныТекста.Получить(Ключ);
	
	Если ШаблонТекста = Неопределено Тогда
		Если ИндексСтроки >= 0 И ИндексСтроки < ПовесткаДня.Количество() Тогда
			СтрокаПовестки = ПовесткаДня[ИндексСтроки];
			Если ИмяПоля = "Вопрос" Тогда
				ШаблонТекста = Строка(СтрокаПовестки.Вопрос);
			ИначеЕсли ИмяПоля = "Приложение" Тогда
				ШаблонТекста = Строка(СтрокаПовестки.Приложение);
			Иначе
				ШаблонТекста = Строка(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса);
			КонецЕсли;
		Иначе
			ШаблонТекста = "";
		КонецЕсли;
	КонецЕсли;
	
	ТекстРезультат = ПодставитьПользовательскиеПараметрыВТекстДляПечати(Строка(ШаблонТекста), СоответствиеПараметров);
	ТекстРезультат = УдалитьНезаполненныеПлейсхолдерыПараметровИзТекстаПечати(ТекстРезультат);
	
	Возврат ТекстРезультат;
	
КонецФункции //HD-

//HD+
// Дополняет структуру данных печати значениями пользовательских параметров (с падежом).
// Существующие ключи не перезаписываются.
//
Процедура ДополнитьДанныеПечатиПользовательскимиПараметрами(Данные)
	
	Если Данные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеПараметров = ПолучитьСоответствиеПользовательскихПараметровДляПечати();
	
	Для Каждого Пара Из СоответствиеПараметров Цикл
		Если НЕ Данные.Свойство(Пара.Ключ) Тогда
			Данные.Вставить(Пара.Ключ, Пара.Значение);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Удаляет из текста незаполненные плейсхолдеры пользовательских параметров вида [Параметр].
//
Функция УдалитьНезаполненныеПлейсхолдерыПараметровИзТекстаПечати(Знач ИсходныйТекст)
	
	Если НЕ ЗначениеЗаполнено(ИсходныйТекст) Тогда
		Возврат ИсходныйТекст;
	КонецЕсли;
	
	ТекстРезультат = Строка(ИсходныйТекст);
	
	ПозицияОткрывающейСкобки = СтрНайти(ТекстРезультат, "[");
	Пока ПозицияОткрывающейСкобки > 0 Цикл
		ХвостПослеОткрывающейСкобки = Сред(ТекстРезультат, ПозицияОткрывающейСкобки + 1);
		ПозицияЗакрывающейСкобкиВХвосте = СтрНайти(ХвостПослеОткрывающейСкобки, "]");
		Если ПозицияЗакрывающейСкобкиВХвосте > 0 Тогда
			ПозицияЗакрывающейСкобки = ПозицияОткрывающейСкобки + ПозицияЗакрывающейСкобкиВХвосте;
		Иначе
			ПозицияЗакрывающейСкобки = 0;
		КонецЕсли;
		Если ПозицияЗакрывающейСкобки = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ТекстРезультат = Лев(ТекстРезультат, ПозицияОткрывающейСкобки - 1)
			+ Сред(ТекстРезультат, ПозицияЗакрывающейСкобки + 1);
		
		ПозицияОткрывающейСкобки = СтрНайти(ТекстРезультат, "[");
	КонецЦикла;
	
	Возврат ТекстРезультат;
	
КонецФункции //HD-

//HD+
// Признак строки-приложения в ТЧ ПовесткаДня. Реквизит ЭтоПриложение может ещё отсутствовать в выгрузке метаданных.
//
Функция СтрокаПовесткиЭтоПриложение(СтрокаПовестки)
	
	Если СтрокаПовестки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РеквизитЭтоПриложение = Метаданные.Документы.HD_ОбщееСобраниеСобственников.ТабличныеЧасти.ПовесткаДня.Реквизиты.Найти("ЭтоПриложение");
	Если РеквизитЭтоПриложение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначениеФлага = СтрокаПовестки.ЭтоПриложение;
	Если ТипЗнч(ЗначениеФлага) <> Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЗначениеФлага;
	
КонецФункции //HD-

//HD+
// Собирает [ВопросыПовесткиДня]: п.1 программный, далее нумерованные вопросы; строки-приложения — без номера в конце.
//
Функция СобратьСтрокуВопросовПовесткиДляПечати(ШаблоныТекстаПовестки, СоответствиеПараметровПечати)
	
	СтрокаВопросов = "1. Выбор председателя собрания, секретаря собрания, счетной комиссии.";
	СтрокиПриложений = Новый Массив;
	НомерПункта = 1;
	ИндексСтрокиПовестки = 0;
	
	Для Каждого СтрокаПовестки Из ПовесткаДня Цикл
		
		Если СтрокаПовесткиЭтоПриложение(СтрокаПовестки) Тогда
			ТекстПриложения = ПолучитьТекстПоляПовесткиДляПечати(ИндексСтрокиПовестки, "Приложение", ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
			Если НЕ ЗначениеЗаполнено(ТекстПриложения) Тогда
				ТекстПриложения = ПолучитьТекстПоляПовесткиДляПечати(ИндексСтрокиПовестки, "Вопрос", ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
			КонецЕсли;
			ТекстПриложения = НормализоватьПереносыСтрокДляWord(ТекстПриложения);
			Если ЗначениеЗаполнено(ТекстПриложения) Тогда
				СтрокиПриложений.Добавить(ТекстПриложения);
			КонецЕсли;
		Иначе
			НомерПункта = НомерПункта + 1;
			ТекстВопроса = ПолучитьТекстПоляПовесткиДляПечати(ИндексСтрокиПовестки, "Вопрос", ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
			ТекстВопроса = НормализоватьПереносыСтрокДляWord(ТекстВопроса);
			СтрокаВопросов = СтрокаВопросов + Символ(13) + Символ(13) + Формат(НомерПункта, "ЧГ=") + ". " + ТекстВопроса;
		КонецЕсли;
		
		ИндексСтрокиПовестки = ИндексСтрокиПовестки + 1;
		
	КонецЦикла;
	
	Для Каждого ТекстПриложения Из СтрокиПриложений Цикл
		СтрокаВопросов = СтрокаВопросов + Символ(13) + Символ(13) + ТекстПриложения;
	КонецЦикла;
	
	Возврат СтрокаВопросов;
	
КонецФункции //HD-

//HD+
// Истина, если в шаблоне повестки (Справочники.HD_ФиксированныйСписокПовесток) установлен флаг ИнициаторУК.
//
Функция ШаблонПовесткиСИнициаторомУК()
	
	Если НЕ ЗначениеЗаполнено(ШаблонПовестки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(ШаблонПовестки) <> Тип("СправочникСсылка.HD_ФиксированныйСписокПовесток") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РеквизитИнициаторУК = Метаданные.Справочники.HD_ФиксированныйСписокПовесток.Реквизиты.Найти("ИнициаторУК");
	Если РеквизитИнициаторУК = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначениеФлага = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонПовестки, "ИнициаторУК");
	Если ТипЗнч(ЗначениеФлага) <> Тип("Булево") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат ЗначениеФлага;
	
КонецФункции //HD-

//HD+
// Представление вида КИ организации документа (юридический адрес, e-mail, телефон).
//
Функция ПолучитьПредставлениеКИОрганизации(Знач ВидКонтактнойИнформации)
	
	Если НЕ ЗначениеЗаполнено(Организация)
		ИЛИ ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации")
		ИЛИ НЕ ЗначениеЗаполнено(ВидКонтактнойИнформации)
		ИЛИ ТипЗнч(ВидКонтактнойИнформации) <> Тип("СправочникСсылка.ВидыКонтактнойИнформации") Тогда
		Возврат "";
	КонецЕсли;
	
	ДатаКИ = ?(ЗначениеЗаполнено(Дата), Дата, ТекущаяДатаСеанса());
	ПредставлениеКИ = "";
	
	Попытка
		ПредставлениеКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Организация, ВидКонтактнойИнформации, ДатаКИ, Истина);
	Исключение
		ПредставлениеКИ = УправлениеКонтактнойИнформацией.КонтактнаяИнформацияОбъекта(
			Организация, ВидКонтактнойИнформации, Неопределено, Истина);
	КонецПопытки;
	
	Если ТипЗнч(ПредставлениеКИ) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СокрЛП(ПредставлениеКИ);
	
КонецФункции //HD-

//HD+
// Полное наименование, юридический адрес, e-mail и телефон организации документа для печати инициатора-УК.
//
Функция ПолучитьРеквизитыОрганизацииИнициатораДляПечати()
	
	Результат = Новый Структура;
	Результат.Вставить("НаименованиеПолное", "");
	Результат.Вставить("ЮридическийАдрес", "");
	Результат.Вставить("Email", "");
	Результат.Вставить("Телефон", "");
	
	Если НЕ ЗначениеЗаполнено(Организация)
		ИЛИ ТипЗнч(Организация) <> Тип("СправочникСсылка.Организации") Тогда
		Возврат Результат;
	КонецЕсли;
	
	РеквизитыОрганизации = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
		Организация, "НаименованиеПолное, НаименованиеСокращенное, Наименование");
	
	НаименованиеПолное = СокрЛП(Строка(РеквизитыОрганизации.НаименованиеПолное));
	Если НЕ ЗначениеЗаполнено(НаименованиеПолное) Тогда
		НаименованиеПолное = СокрЛП(Строка(РеквизитыОрганизации.НаименованиеСокращенное));
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(НаименованиеПолное) Тогда
		НаименованиеПолное = СокрЛП(Строка(РеквизитыОрганизации.Наименование));
	КонецЕсли;
	Результат.НаименованиеПолное = НаименованиеПолное;
	
	Результат.ЮридическийАдрес = ПолучитьПредставлениеКИОрганизации(
		Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
	Результат.Email = ПолучитьПредставлениеКИОрганизации(
		Справочники.ВидыКонтактнойИнформации.EmailОрганизации);
	Результат.Телефон = ПолучитьПредставлениеКИОрганизации(
		Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации);
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Заполняет в структуре печати Word поля инициатора: физлицо и/или УК по флагу шаблона повестки.
// Ключи ТекстИнициатораФизЛицо / ТекстИнициатораУК — флаги опциональных блоков [?…]/[/?…] в макете.
//
Процедура ЗаполнитьДанныеИнициатораДляПечатиWord(Данные, НастройкиДлиныПрочерков, Знач ИспользоватьРодительныйПадежФИО = Ложь)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ИнициаторУК = ШаблонПовесткиСИнициаторомУК();
	Данные.Вставить("ТекстИнициатораУК", ?(ИнициаторУК, "1", ""));
	Данные.Вставить("ТекстИнициатораФизЛицо", ?(ИнициаторУК, "", "1"));
	
	Если ИспользоватьРодительныйПадежФИО Тогда
		ЗначениеПараметра = ПолучитьИнициаторФИОВРодительномПадеже();
	Иначе
		ЗначениеПараметра = ПолучитьИнициаторФИО();
	КонецЕсли;
	Данные.Вставить("ИнициаторФИО", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторФИО")));
	
	ЗначениеПараметра = НормализоватьСериюНомерПаспорта(ИнициаторПаспортСерия);
	Данные.Вставить("ИнициаторПаспортСерия", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторПаспортСерия")));
	ЗначениеПараметра = НормализоватьСериюНомерПаспорта(ИнициаторПаспортНомер);
	Данные.Вставить("ИнициаторПаспортНомер", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторПаспортНомер")));
	ЗначениеПараметра = ИнициаторСНИЛС;
	Данные.Вставить("ИнициаторСНИЛС", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "Общий")));
	ЗначениеПараметра = ИнициаторАдресРегистрации;
	Данные.Вставить("ИнициаторАдресРегистрации", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторАдресРегистрации")));
	ЗначениеПараметра = ИнициаторТелефон;
	Данные.Вставить("ИнициаторТелефон", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторТелефон")));
	
	РеквизитыУК = ПолучитьРеквизитыОрганизацииИнициатораДляПечати();
	Данные.Вставить("ИнициаторОрганизацияНаименование", ?(ЗначениеЗаполнено(РеквизитыУК.НаименованиеПолное), РеквизитыУК.НаименованиеПолное, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторОрганизацияНаименование")));
	Данные.Вставить("ИнициаторОрганизацияЮрАдрес", ?(ЗначениеЗаполнено(РеквизитыУК.ЮридическийАдрес), РеквизитыУК.ЮридическийАдрес, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторОрганизацияЮрАдрес")));
	Данные.Вставить("ИнициаторОрганизацияEmail", ?(ЗначениеЗаполнено(РеквизитыУК.Email), РеквизитыУК.Email, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторОрганизацияEmail")));
	Данные.Вставить("ИнициаторОрганизацияТелефон", ?(ЗначениеЗаполнено(РеквизитыУК.Телефон), РеквизитыУК.Телефон, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторОрганизацияТелефон")));
	
	ЗаполнитьДанныеПредставителяУКДляПечатиWord(Данные, НастройкиДлиныПрочерков);
	
КонецПроцедуры //HD-

//HD+
// Значение реквизита документа по имени, если реквизит есть в метаданных.
//
Функция ПолучитьРеквизитДокументаПоИмени(Знач ИмяРеквизита)
	
	ИмяРеквизитаСтрокой = СокрЛП(Строка(ИмяРеквизита));
	Если НЕ ЗначениеЗаполнено(ИмяРеквизитаСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МетаданныеРеквизита = Метаданные.Документы.HD_ОбщееСобраниеСобственников.Реквизиты.Найти(ИмяРеквизитаСтрокой);
	Если МетаданныеРеквизита = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЭтотОбъект[ИмяРеквизитаСтрокой];
	
КонецФункции //HD-

//HD+
// ФИО, должность и основание представителя УК для печати Word.
// Ключ ТекстПредставителяУК — флаг опционального блока [?ТекстПредставителяУК]…[/?ТекстПредставителяУК].
//
Процедура ЗаполнитьДанныеПредставителяУКДляПечатиWord(Данные, НастройкиДлиныПрочерков)
	
	Если ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ФИОПредставителя = "";
	ЗначениеПредставителя = ПолучитьРеквизитДокументаПоИмени("ПредставительУК");
	Если ТипЗнч(ЗначениеПредставителя) = Тип("СправочникСсылка.ФизическиеЛица")
		И ЗначениеЗаполнено(ЗначениеПредставителя) Тогда
		ФИОПредставителя = СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеПредставителя, "Наименование")));
	КонецЕсли;
	
	ДолжностьПредставителя = "";
	ЗначениеДолжности = ПолучитьРеквизитДокументаПоИмени("ПредставительУКДолжность");
	Если ТипЗнч(ЗначениеДолжности) = Тип("Строка") Тогда
		ДолжностьПредставителя = СокрЛП(ЗначениеДолжности);
	КонецЕсли;
	
	ОснованиеПредставителя = "";
	ЗначениеОснования = ПолучитьРеквизитДокументаПоИмени("ПредставительУКОснование");
	Если ТипЗнч(ЗначениеОснования) = Тип("Строка") Тогда
		ОснованиеПредставителя = НормализоватьТекстОснованияПредставителяУКДляПечати(ЗначениеОснования);
	КонецЕсли;
	
	Данные.Вставить("ТекстПредставителяУК", ?(ЗначениеЗаполнено(ФИОПредставителя), "1", ""));
	Данные.Вставить("ПредставительУКФИО", ?(ЗначениеЗаполнено(ФИОПредставителя), ФИОПредставителя, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительУКФИО")));
	Данные.Вставить("ПредставительУКДолжность", ?(ЗначениеЗаполнено(ДолжностьПредставителя), ДолжностьПредставителя, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительУКДолжность")));
	Данные.Вставить("ПредставительУКОснование", ?(ЗначениеЗаполнено(ОснованиеПредставителя), ОснованиеПредставителя, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительУКОснование")));
	
КонецПроцедуры //HD-

//HD+
// Основание представителя УК для печати — строчными буквами (карточка физлица хранит «На основании Доверенности…»).
//
Функция НормализоватьТекстОснованияПредставителяУКДляПечати(Знач ТекстОснования)
	
	Возврат НРег(СокрЛП(Строка(ТекстОснования)));
	
КонецФункции //HD-

//HD+
// Формирует структуру «имя закладки → значение» для заполнения макета Word на клиенте (вариант А).
// Используется для макетов ПФ_DOC_Протокол, ПФ_DOC_ИтогиГолосования, ПФ_DOC_СообщениеОСобрании (заполнение через Word на клиенте). Бланк решения — отдельно, через ПолучитьМассивДанныхДляБланкРешенияПоУчастникам() (один документ на участника).
// Пустые значения подменяются прочерками. Проверка типов реквизитов — в вызывающем коде.
//
Функция ПолучитьДанныеДляЗаполненияПечатнойФормыWord(ИмяШаблона) Экспорт
	
	//HD+ Данные только для макета ПФ_DOC_СообщениеОСобрании (заполнение через Word на клиенте)
	Если ИмяШаблона = "ПФ_DOC_СообщениеОСобрании" Тогда
		НастройкиДлиныПрочерков = ПолучитьНастройкиДлиныПрочерков();
		Данные = Новый Структура;
		ЗаполнитьДанныеИнициатораДляПечатиWord(Данные, НастройкиДлиныПрочерков, Истина);
		ЗначениеПараметра = ПолучитьФормаПроведенияСобранияВРодительномПадеже();
		Данные.Вставить("ФормаПроведенияСобрания", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ФормаПроведенияСобрания")));
		//HD+ [ВидСобрания_Предложный] — предложный падеж; [ВидСобрания] — именительный (нижний регистр). Длинное имя вставляем первым.
		ЗначениеПараметра = ПолучитьВидСобранияВПредложномПадеже();
		Данные.Вставить("ВидСобрания_Предложный", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВидСобрания_Предложный")));
		ЗначениеПараметра = ПолучитьВидСобранияСтрокой();
		Данные.Вставить("ВидСобрания", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВидСобрания")));
		ЗначениеПараметра = ПолучитьМКДУлица();
		Данные.Вставить("МКД_Улица", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Улица")));
		ЗначениеПараметра = ПолучитьМКДДом();
		Данные.Вставить("МКД_Дом", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Дом")));
		ЗначениеПараметра = ?(ЗначениеЗаполнено(МестоПроведения), Строка(МестоПроведения), "");
		Данные.Вставить("МестоПроведенияСобрания", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МестоПроведенияСобрания")));
		ЗначениеПараметра = ПолучитьВремяПроведенияОчногоГолосования();
		Данные.Вставить("ВремяПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияОчногоГолосования")));
		ЗначениеПараметра = ПолучитьМесяцПроведенияОчногоГолосования();
		Данные.Вставить("МесяцПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияОчногоГолосования")));
		ЗначениеПараметра = ПолучитьГодПроведенияОчногоГолосования();
		Данные.Вставить("ГодПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияОчногоГолосования")));
		ЗначениеПараметра = ПолучитьВремяПроведенияЗаочногоГолосования_Начало();
		Данные.Вставить("ВремяПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Нач")));
		ЗначениеПараметра = ПолучитьМесяцПроведенияЗаочногоГолосования_Начало();
		Данные.Вставить("МесяцПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияЗаочногоГолосования_Нач")));
		ЗначениеПараметра = ПолучитьГодПроведенияЗаочногоГолосования_Начало();
		Данные.Вставить("ГодПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияЗаочногоГолосования_Нач")));
		ЗначениеПараметра = ПолучитьВремяПроведенияЗаочногоГолосования_Окончание();
		Данные.Вставить("ВремяПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Кон")));
		ЗначениеПараметра = ПолучитьМесяцПроведенияЗаочногоГолосования_Окончание();
		Данные.Вставить("МесяцПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияЗаочногоГолосования_Кон")));
		ЗначениеПараметра = ПолучитьГодПроведенияЗаочногоГолосования_Окончание();
		Данные.Вставить("ГодПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияЗаочногоГолосования_Кон")));
		//HD+ [ТекстПроведенияГолосования] — очное/заочное по ФормаПроведения (формулировки «состоится» / «будет проведено»)
		Данные.Вставить("ТекстПроведенияГолосования", ПолучитьТекстПроведенияГолосованияДляПечати(НастройкиДлиныПрочерков, "СообщениеОСобрании"));
		ШаблоныТекстаПовестки = ПолучитьШаблоныТекстаПовесткиДляПечати();
		СоответствиеПараметровПечати = ПолучитьСоответствиеПользовательскихПараметровДляПечати();
		Данные.Вставить("ВопросыПовесткиДня", СобратьСтрокуВопросовПовесткиДляПечати(ШаблоныТекстаПовестки, СоответствиеПараметровПечати));
		ДополнитьДанныеПечатиПользовательскимиПараметрами(Данные);
		Возврат Данные;
	КонецЕсли;
	
	НастройкиДлиныПрочерков = ПолучитьНастройкиДлиныПрочерков();
	
	Данные = Новый Структура;
	
	// Шапка: для ПФ_DOC_ИтогиГолосования — Итоги* из Дата_ИтогиГолосования, для остальных — Протокол* из Дата_Протокол
	ЗначениеПараметра = ПолучитьМКДУлица();
	Данные.Вставить("МКД_Улица", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Улица")));
	ЗначениеПараметра = ПолучитьМКДДом();
	Данные.Вставить("МКД_Дом", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Дом")));
	Если ИмяШаблона = "ПФ_DOC_ИтогиГолосования" Тогда
		ЗначениеПараметра = ?(ЗначениеЗаполнено(Дата_ИтогиГолосования), Формат(День(Дата_ИтогиГолосования), "ЧГ="), "");
		Данные.Вставить("ИтогиДень", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколДата")));
		ЗначениеПараметра = ?(ЗначениеЗаполнено(Дата_ИтогиГолосования), МесяцВРодительномПадеже(Месяц(НачалоДня(Дата_ИтогиГолосования))), "");
		Данные.Вставить("ИтогиМесяц", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколМесяц")));
		ЗначениеПараметра = ?(ЗначениеЗаполнено(Дата_ИтогиГолосования), Прав("00" + Формат(Год(Дата_ИтогиГолосования), "ЧГ="), 2), "");
		Данные.Вставить("ИтогиГод", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколГод")));
	Иначе
		ЗначениеПараметра = ?(ЗначениеЗаполнено(Дата_Протокол), Формат(Дата_Протокол, "ДФ=dd"), "");
		Данные.Вставить("ПротоколДень", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколДата")));
		ЗначениеПараметра = ?(ЗначениеЗаполнено(Дата_Протокол), МесяцВРодительномПадеже(Месяц(НачалоДня(Дата_Протокол))), "");
		Данные.Вставить("ПротоколМесяц", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколМесяц")));
		ЗначениеПараметра = ?(ЗначениеЗаполнено(Дата_Протокол), Прав("00" + Формат(Год(Дата_Протокол), "ЧГ="), 2), "");
		Данные.Вставить("ПротоколГод", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколГод")));
	КонецЕсли;
	ЗначениеПараметра = НомерПротокола;
	Данные.Вставить("НомерПротокола", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколГод")));
	
	// ОбластьДанныеИнициатораМКД
	ЗначениеПараметра = ПолучитьВидСобранияСтрокой();
	Данные.Вставить("ВидСобрания", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВидСобрания")));
	ЗначениеПараметра = ПолучитьФормаПроведенияСобрания();
	Данные.Вставить("ФормаПроведенияСобрания", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ФормаПроведенияСобрания")));
	ЗаполнитьДанныеИнициатораДляПечатиWord(Данные, НастройкиДлиныПрочерков, Ложь);
	
	// ОбластьСообщениеОСобрании
	ЗначениеПараметра = ?(ЗначениеЗаполнено(ОбщаяПлощадьМКД), Формат(ОбщаяПлощадьМКД, "ЧЦ=10; ЧДЦ=2"), "");
	Данные.Вставить("ОбщаяПлощадьМКД", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ОбщаяПлощадьМКД")));
	ЗначениеПараметра = ?(ЗначениеЗаполнено(ВсегоСобственников), Формат(ВсегоСобственников, "ЧГ="), "");
	Данные.Вставить("ВсегоСобственников", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВсегоСобственников")));
	ЗначениеПараметра = ?(ЗначениеЗаполнено(МестоПроведения), Строка(МестоПроведения), "");
	Данные.Вставить("МестоПроведенияСобрания", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МестоПроведенияСобрания")));
	ЗначениеПараметра = ПолучитьВремяПроведенияОчногоГолосования();
	Данные.Вставить("ВремяПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияОчногоГолосования")));
	ЗначениеПараметра = ПолучитьГодПроведенияОчногоГолосования();
	Данные.Вставить("ГодПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияОчногоГолосования")));
	ЗначениеПараметра = ПолучитьМесяцПроведенияОчногоГолосования();
	Данные.Вставить("МесяцПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияОчногоГолосования")));
	ЗначениеПараметра = ПолучитьВремяПроведенияЗаочногоГолосования_Начало();
	Данные.Вставить("ВремяПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Нач")));
	ЗначениеПараметра = ПолучитьГодПроведенияЗаочногоГолосования_Начало();
	Данные.Вставить("ГодПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияЗаочногоГолосования_Нач")));
	ЗначениеПараметра = ПолучитьМесяцПроведенияЗаочногоГолосования_Начало();
	Данные.Вставить("МесяцПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияЗаочногоГолосования_Нач")));
	ЗначениеПараметра = ПолучитьВремяПроведенияЗаочногоГолосования_Окончание();
	Данные.Вставить("ВремяПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Кон")));
	ЗначениеПараметра = ПолучитьГодПроведенияЗаочногоГолосования_Окончание();
	Данные.Вставить("ГодПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияЗаочногоГолосования_Кон")));
	ЗначениеПараметра = ПолучитьМесяцПроведенияЗаочногоГолосования_Окончание();
	Данные.Вставить("МесяцПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияЗаочногоГолосования_Кон")));
	//HD+ [ТекстПроведенияГолосования] — очное/заочное по ФормаПроведения для ПФ_DOC_Протокол и ПФ_DOC_ИтогиГолосования
	Данные.Вставить("ТекстПроведенияГолосования", ПолучитьТекстПроведенияГолосованияДляПротокола(НастройкиДлиныПрочерков));
	//HD+ [ТекстКворума] — инициатор УК или очная форма: «кворум отсутствует»; иначе «кворум имеется»
	Данные.Вставить("ТекстКворума", ПолучитьТекстКворумаДляПечати());
	
	// Участники собрания (председатель, секретарь, счетная комиссия)
	ДанныеУчастников = ПолучитьДанныеУчастниковСобрания();
	ЗначениеПараметра = ДанныеУчастников.Председатель;
	Данные.Вставить("Председатель", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ""));
	ЗначениеПараметра = ДанныеУчастников.ПредседательКвартира;
	Данные.Вставить("Председатель_Кв", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ""));
	ЗначениеПараметра = ДанныеУчастников.Секретарь;
	Данные.Вставить("Секретарь", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ""));
	ЗначениеПараметра = ДанныеУчастников.СекретарьКвартира;
	Данные.Вставить("Секретарь_Кв", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ""));
	
	СчКомУчастники = ДанныеУчастников.СчКомУчастники;
	СчКомКв = ДанныеУчастников.СчКомУчастникиКвартиры;
	Для Индекс = 1 По 5 Цикл
		ИмяУчастник = "СчетнаяКомиссия_" + Формат(Индекс, "ЧГ=");
		ИмяКв = ИмяУчастник + "_Кв";
		УчастникЗначение = "";
		КвЗначение = "";
		Если СчКомУчастники.Количество() >= Индекс Тогда
			УчастникЗначение = СчКомУчастники[Индекс - 1];
			КвЗначение = СчКомКв[Индекс - 1];
		КонецЕсли;
		Данные.Вставить(ИмяУчастник, ?(ЗначениеЗаполнено(УчастникЗначение), УчастникЗначение, ""));
		Данные.Вставить(ИмяКв, ?(ЗначениеЗаполнено(КвЗначение), КвЗначение, ""));
	КонецЦикла;
	
	ЗначениеПараметра = ?(ЗначениеЗаполнено(ПредставительСобственников_1), Строка(ПредставительСобственников_1), "");
	Данные.Вставить("ПредставительСобственников_1", ЗначениеПараметра);
	ЗначениеПараметра = ?(ЗначениеЗаполнено(ПредставительСобственников_2), Строка(ПредставительСобственников_2), "");
	Данные.Вставить("ПредставительСобственников_2", ЗначениеПараметра);
	
	//HD+ Список вопросов и предложений: п.1 — фиксированный (выбор председателя/секретаря/счетной комиссии), остальные — из ПовесткаДня с нумерацией
	ТекстВопросП1 = "Выбор председателя собрания, секретаря собрания, счетной комиссии.";
	//HD+ П.1 [ПредложенияПовесткиДня] для ПФ_DOC_Протокол и ПФ_DOC_ИтогиГолосования: текст «Выбрать» + состав органов (данные уже в Данные); префикс «1. » добавляется ниже
	ТекстПредложенияП1 = "Предложено выбрать:";
	Если ЗначениеЗаполнено(ДанныеУчастников.Председатель) Тогда
		ТекстПредложенияП1 = ТекстПредложенияП1 + Символ(13) + "председателем собрания: " + Строка(ДанныеУчастников.Председатель)
			+ ?(ЗначениеЗаполнено(ДанныеУчастников.ПредседательКвартира), " кв. " + Строка(ДанныеУчастников.ПредседательКвартира), "");
	КонецЕсли;
	Если ЗначениеЗаполнено(ДанныеУчастников.Секретарь) Тогда
		ТекстПредложенияП1 = ТекстПредложенияП1 + Символ(13) + "секретарем собрания: " + Строка(ДанныеУчастников.Секретарь)
			+ ?(ЗначениеЗаполнено(ДанныеУчастников.СекретарьКвартира), " кв. " + Строка(ДанныеУчастников.СекретарьКвартира), "");
	КонецЕсли;
	ЕстьСоставСчетнойКомиссии = Ложь;
	Для ИндексСчКом = 0 По ДанныеУчастников.СчКомУчастники.Количество() - 1 Цикл
		Если НЕ ЗначениеЗаполнено(ДанныеУчастников.СчКомУчастники[ИндексСчКом]) Тогда
			Продолжить;
		КонецЕсли;
		Если НЕ ЕстьСоставСчетнойКомиссии Тогда
			ТекстПредложенияП1 = ТекстПредложенияП1 + Символ(13) + "счетная комиссия в составе:";
			ЕстьСоставСчетнойКомиссии = Истина;
		КонецЕсли;
		КвартираСчКом = "";
		Если ДанныеУчастников.СчКомУчастникиКвартиры.Количество() > ИндексСчКом Тогда
			КвартираСчКом = ДанныеУчастников.СчКомУчастникиКвартиры[ИндексСчКом];
		КонецЕсли;
		ТекстПредложенияП1 = ТекстПредложенияП1 + Символ(13)
			+ Строка(ДанныеУчастников.СчКомУчастники[ИндексСчКом])
			+ ?(ЗначениеЗаполнено(КвартираСчКом), " кв. " + Строка(КвартираСчКом), "");
	КонецЦикла;
	//HD+ Блок итогов голосования выводим отдельным абзацем после списка (как Enter с отступом от основного текста)
	ТекстПредложенияП1 = ТекстПредложенияП1
		+ Символ(13) + Символ(13) + "Итоги голосования по данному вопросу: «за» - ___ % голосов; «против» - ___ % голосов; «воздержались» - ___ % голосов."
		+ Символ(13) + "Решение по 1 вопросу повестки дня принято.";
	ТекстПредложенияП1 = НормализоватьПереносыСтрокДляWord(ТекстПредложенияП1);
	
	ШаблоныТекстаПовестки = ПолучитьШаблоныТекстаПовесткиДляПечати();
	СоответствиеПараметровПечати = ПолучитьСоответствиеПользовательскихПараметровДляПечати();
	СтрокаВопросов = СобратьСтрокуВопросовПовесткиДляПечати(ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
	СтрокаПредложений = "";
	ЕстьПредложенияИзПовестки = Ложь;
	НомерПункта = 1;
	ИндексСтрокиПовестки = 0;
	Для Каждого СтрокаПовестки Из ПовесткаДня Цикл
		Если СтрокаПовесткиЭтоПриложение(СтрокаПовестки) Тогда
			ИндексСтрокиПовестки = ИндексСтрокиПовестки + 1;
			Продолжить;
		КонецЕсли;
		НомерПункта = НомерПункта + 1;
		ТекстПредложения = ПолучитьТекстПоляПовесткиДляПечати(ИндексСтрокиПовестки, "ФормулировкаПредложенияРешенияВопроса", ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
		ТекстПредложения = НормализоватьПереносыСтрокДляWord(ТекстПредложения);
		Если ЗначениеЗаполнено(ТекстПредложения) Тогда
			Если НЕ ЕстьПредложенияИзПовестки Тогда
				СтрокаПредложений = "1. " + ТекстПредложенияП1;
				ЕстьПредложенияИзПовестки = Истина;
			КонецЕсли;
			СтрокаПредложений = СтрокаПредложений + Символ(13) + Символ(13) + Формат(НомерПункта, "ЧГ=") + ". Предложено: " + ТекстПредложения;
		КонецЕсли;
		ИндексСтрокиПовестки = ИндексСтрокиПовестки + 1;
	КонецЦикла;
	Данные.Вставить("ВопросыПовесткиДня", СтрокаВопросов);
	Данные.Вставить("ПредложенияПовесткиДня", СтрокаПредложений);
	
	ДополнитьДанныеПечатиПользовательскимиПараметрами(Данные);
	
	Возврат Данные;
	
КонецФункции //HD-

//HD+
// Возвращает массив структур данных для печати бланка решения: один элемент на каждого участника собрания (Word: ПФ_DOC_БланкРешения; MXL: ПФ_MXL_БланкРешения).
//
Функция ПолучитьМассивДанныхДляБланкРешенияПоУчастникам() Экспорт
	
	НастройкиДлиныПрочерков = ПолучитьНастройкиДлиныПрочерков();
	ПрочеркМКДУлица = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Улица");
	ПрочеркМКДДом = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Дом");
	
	//HD+ Предложения для строк макета бланка: без синтетического п.1 (органы собрания — отдельными областями макета); только формулировки из ПовесткаДня
	МассивНомерСтроки = Новый Массив;
	МассивПредложения = Новый Массив;
	ШаблоныТекстаПовестки = ПолучитьШаблоныТекстаПовесткиДляПечати();
	СоответствиеПараметровПечати = ПолучитьСоответствиеПользовательскихПараметровДляПечати();
	НомерПункта = 1;
	ИндексСтрокиПовестки = 0;
	//HD+ Обходим табличную часть ПовесткаДня и погружаем в массив каждый пункт (ФормулировкаПредложенияРешенияВопроса) отдельно — один элемент = один пункт
	Для Каждого СтрокаПредложение Из ЭтотОбъект.ПовесткаДня Цикл
		Если СтрокаПовесткиЭтоПриложение(СтрокаПредложение) Тогда
			ИндексСтрокиПовестки = ИндексСтрокиПовестки + 1;
			Продолжить;
		КонецЕсли;
		НомерПункта = НомерПункта + 1;
		МассивНомерСтроки.Добавить(Формат(НомерПункта, "ЧГ="));
		ТекстПункта = ПолучитьТекстПоляПовесткиДляПечати(ИндексСтрокиПовестки, "ФормулировкаПредложенияРешенияВопроса", ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
		//HD+ Убираем типовой хвост из макета протокола — в бланке решения не печатается
		ТекстПункта = УбратьШаблонИтоговГолосованияИзФормулировкиДляБланкаРешения(ТекстПункта);
		ТекстПункта = НормализоватьПереносыСтрокДляWord(ТекстПункта);
		МассивПредложения.Добавить(ТекстПункта);
		ИндексСтрокиПовестки = ИндексСтрокиПовестки + 1;
	КонецЦикла;
	МассивДанных = Новый Массив;
	
	РеквизитыУК = ПолучитьРеквизитыОрганизацииИнициатораДляПечати();
	ПолноеНаименованиеОрганизации = ?(ЗначениеЗаполнено(РеквизитыУК.НаименованиеПолное), РеквизитыУК.НаименованиеПолное, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторОрганизацияНаименование"));
	
	Для Каждого СтрокаУчастника Из УчастникиСобрания Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
			Продолжить;
		КонецЕсли;
		
		Данные = Новый Структура;
		ЗначениеПараметра = ПолучитьМКДУлица();
		Данные.Вставить("МКД_Улица", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПрочеркМКДУлица));
		ЗначениеПараметра = ПолучитьМКДДом();
		Данные.Вставить("МКД_Дом", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПрочеркМКДДом));
		//HD+ Строка адреса для макета ПФ_MXL_БланкРешения ([АдресМКД]): улица и дом через ПолучитьМКДУлица / ПолучитьМКДДом
		Если Данные.МКД_Улица = ПрочеркМКДУлица И Данные.МКД_Дом = ПрочеркМКДДом Тогда
			Данные.Вставить("АдресМКД", ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "Общий"));
		Иначе
			ЧастиАдресаМКД = Новый Массив;
			Если Данные.МКД_Улица <> ПрочеркМКДУлица Тогда
				ЧастиАдресаМКД.Добавить(Данные.МКД_Улица);
			КонецЕсли;
			Если Данные.МКД_Дом <> ПрочеркМКДДом Тогда
				ЧастиАдресаМКД.Добавить("д. " + Данные.МКД_Дом);
			КонецЕсли;
			Данные.Вставить("АдресМКД", СтрСоединить(ЧастиАдресаМКД, ", "));
		КонецЕсли;
		ЗначениеПараметра = ПолучитьИнициаторФИО();
		Данные.Вставить("ИнициаторФИО", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторФИО")));
		Данные.Вставить("ПолноеНаименованиеОрганизации", ПолноеНаименованиеОрганизации);
		ЗначениеПараметра = ИнициаторНомерКвартиры;
		Данные.Вставить("Инициатор_Кв", ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "Председатель_Кв")));
		Данные.Вставить("ИнициаторНомерКвартиры", Данные.Инициатор_Кв);
		ЗначениеПараметра = ?(ЗначениеЗаполнено(ПредставительСобственников_1), Строка(ПредставительСобственников_1), "");
		Данные.Вставить("ПредставительСобственников_1", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительСобственников_1")));
		ЗначениеПараметра = ?(ЗначениеЗаполнено(ПредставительСобственников_2), Строка(ПредставительСобственников_2), "");
		Данные.Вставить("ПредставительСобственников_2", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительСобственников_2")));
		//HD+ Дательный падеж только для блока «Доверенность» в макете ПФ_MXL_БланкРешения (параметры *_Дательный)
		ЗначениеПараметра = ПолучитьПредставителяСобственниковВДательномПадеже(ПредставительСобственников_1);
		Данные.Вставить("ПредставительСобственников_1_Дательный", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительСобственников_1")));
		ЗначениеПараметра = ПолучитьПредставителяСобственниковВДательномПадеже(ПредставительСобственников_2);
		Данные.Вставить("ПредставительСобственников_2_Дательный", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительСобственников_2")));
		//HD-
		ЗначениеПараметра = ?(ЗначениеЗаполнено(КвартираПредставителя_1), Строка(КвартираПредставителя_1), "");
		Данные.Вставить("КвартираПредставителя_1", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "КвартираПредставителя_1")));
		ЗначениеПараметра = ?(ЗначениеЗаполнено(КвартираПредставителя_2), Строка(КвартираПредставителя_2), "");
		Данные.Вставить("КвартираПредставителя_2", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "КвартираПредставителя_2")));
		ЗначениеПараметра = ПолучитьДатуВремяПроведенияОчногоГолосования();
		Данные.Вставить("ДатаОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияОчногоГолосования")));
		ЗначениеПараметра = ПолучитьПериодПроведенияЗаочногоГолосования();
		Данные.Вставить("ПериодЗаочногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Кон")));
		//HD+ [ВидСобрания] — из реквизита ВидСобрания
		ЗначениеПараметра = ПолучитьВидСобранияСтрокой();
		Данные.Вставить("ВидСобрания", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВидСобрания")));
		ЗначениеПараметра = ПолучитьФормаПроведенияСобранияВРодительномПадеже();
		Данные.Вставить("ФормаПроведенияСобрания", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ФормаПроведенияСобрания")));
		ЗначениеПараметра = ПолучитьВремяПроведенияОчногоГолосования();
		Данные.Вставить("ВремяПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияОчногоГолосования")));
		ЗначениеПараметра = ПолучитьМесяцПроведенияОчногоГолосования();
		Данные.Вставить("МесяцПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияОчногоГолосования")));
		ЗначениеПараметра = ПолучитьГодПроведенияОчногоГолосования();
		Данные.Вставить("ГодПроведенияОчногоГолосования", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияОчногоГолосования")));
		ЗначениеПараметра = ПолучитьВремяПроведенияЗаочногоГолосования_Начало();
		Данные.Вставить("ВремяПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Нач")));
		ЗначениеПараметра = ПолучитьМесяцПроведенияЗаочногоГолосования_Начало();
		Данные.Вставить("МесяцПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияЗаочногоГолосования_Нач")));
		ЗначениеПараметра = ПолучитьГодПроведенияЗаочногоГолосования_Начало();
		Данные.Вставить("ГодПроведенияЗаочногоГолосования_Нач", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияЗаочногоГолосования_Нач")));
		ЗначениеПараметра = ПолучитьВремяПроведенияЗаочногоГолосования_Окончание();
		Данные.Вставить("ВремяПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Кон")));
		ЗначениеПараметра = ПолучитьМесяцПроведенияЗаочногоГолосования_Окончание();
		Данные.Вставить("МесяцПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияЗаочногоГолосования_Кон")));
		ЗначениеПараметра = ПолучитьГодПроведенияЗаочногоГолосования_Окончание();
		Данные.Вставить("ГодПроведенияЗаочногоГолосования_Кон", ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияЗаочногоГолосования_Кон")));
		
		ПредставлениеСобственника = "";
		Если ТипЗнч(СтрокаУчастника.Собственник) = Тип("СправочникСсылка.бит_Проживающие") Тогда
			ПредставлениеСобственника = ?(ЗначениеЗаполнено(СтрокаУчастника.Собственник.Наименование), Строка(СтрокаУчастника.Собственник.Наименование), Строка(СтрокаУчастника.Собственник));
		Иначе
			ПредставлениеСобственника = ?(ЗначениеЗаполнено(СтрокаУчастника.Собственник), Строка(СтрокаУчастника.Собственник), "");
		КонецЕсли;
		Данные.Вставить("УчастникиСобранияСобственник", ПредставлениеСобственника);
		СерияПаспортаУчастника = НормализоватьСериюНомерПаспорта(СтрокаУчастника.ПаспортСерия);
		НомерПаспортаУчастника = НормализоватьСериюНомерПаспорта(СтрокаУчастника.ПаспортНомер);
		Данные.Вставить("УчастникиСобранияПаспортСерия", СерияПаспортаУчастника);
		Данные.Вставить("УчастникиСобранияПаспортНомер", НомерПаспортаУчастника);
		Данные.Вставить("ПаспортСерия", СерияПаспортаУчастника);
		Данные.Вставить("ПаспортНомер", НомерПаспортаУчастника);
		Данные.Вставить("УчастникиСобранияСНИЛС", ?(ЗначениеЗаполнено(СтрокаУчастника.СНИЛС), Строка(СтрокаУчастника.СНИЛС), ""));
		Данные.Вставить("УчастникиСобранияДоляСобственности", ?(ЗначениеЗаполнено(СтрокаУчастника.ДоляСобственности), ОчиститьДолюОтБукв(СтрокаУчастника.ДоляСобственности), ""));
		Данные.Вставить("УчастникиСобранияКвартира", ?(ЗначениеЗаполнено(СтрокаУчастника.НомерКвартиры), Строка(СтрокаУчастника.НомерКвартиры), ""));
		Данные.Вставить("УчастникиСобранияПлощадь", ?(ЗначениеЗаполнено(СтрокаУчастника.Площадь), Формат(СтрокаУчастника.Площадь, "ЧЦ=10; ЧДЦ=2"), ""));
		ДокументПраваУчастника = "";
		Если ТипЗнч(СтрокаУчастника.Собственник) = Тип("СправочникСсылка.бит_Проживающие") Тогда
			ДокументПраваУчастника = ПолучитьПравоустанавливающиеДокументыСтрокой(СтрокаУчастника.Собственник, СтрокаУчастника.ЛицевойСчет);
		ИначеЕсли ЗначениеЗаполнено(СтрокаУчастника.ДокументПрава) Тогда
			ДокументПраваУчастника = Строка(СтрокаУчастника.ДокументПрава);
		КонецЕсли;
		Данные.Вставить("УчастникиСобранияДокументПрава", ДокументПраваУчастника);
		Данные.Вставить("ПредложенияПовесткиДняНомерСтроки", МассивНомерСтроки);
		Данные.Вставить("ПредложенияПовесткиДня", МассивПредложения);
		
		ДополнитьДанныеПечатиПользовательскимиПараметрами(Данные);
		
		МассивДанных.Добавить(Данные);
		
	КонецЦикла;
	
	Возврат МассивДанных;
	
КонецФункции //HD-

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

//HD+
// Обработчик изменения инициатора
//
Процедура ИнициаторФИОПриИзменении() Экспорт
	
	ЗаполнитьДанныеИнициатора();
	
КонецПроцедуры //HD-

//HD+
// Обработчик изменения МКД
//
Процедура МКДПриИзменении() Экспорт
	
	ЗаполнитьДоговорУправленияПоМКД();
	ЗаполнитьОбщуюПлощадьМКД();
	ЗаполнитьУчастниковСобранияИзМКД();
	
КонецПроцедуры //HD-

//HD+
// Заполняет реквизиты ДоговорУправленияНомер и ДоговорУправленияДатаНачУпр
// из регистра сведений РегистрСведений.бит_ЗначениеСвойствОбъектовУчета по выбранному МКД.
//
Процедура ЗаполнитьДоговорУправленияПоМКД() Экспорт
	
	ДоговорУправленияНомер = "";
	ДоговорУправленияДатаНачУпр = Дата(1, 1, 1);
	
	Если НЕ ЗначениеЗаполнено(МКД) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ЗначениеСвойствОбъектовУчета.ВидСвойства КАК ВидСвойства,
	|	бит_ЗначениеСвойствОбъектовУчета.Значение КАК Значение
	|ИЗ
	|	РегистрСведений.бит_ЗначениеСвойствОбъектовУчета КАК бит_ЗначениеСвойствОбъектовУчета
	|ГДЕ
	|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета = &МКД
	|	И бит_ЗначениеСвойствОбъектовУчета.ВидСвойства В (
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияНомер),
	|		ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияДатаНачУпр))";
	
	Запрос.УстановитьПараметр("МКД", МКД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ВидСвойства = ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияНомер Тогда
			ДоговорУправленияНомер = СокрЛП(Строка(Выборка.Значение));
		ИначеЕсли Выборка.ВидСвойства = ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияДатаНачУпр Тогда
			ДоговорУправленияДатаНачУпр = Выборка.Значение;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Обработчик изменения участника собрания
//
Процедура УчастникиСобранияПриИзменении(Элемент) Экспорт
	
	Если ЗначениеЗаполнено(Элемент) И ЗначениеЗаполнено(Элемент.Собственник) Тогда
		
		ЗаполнитьДанныеУчастника(Элемент);
		// Заполняем номер квартиры, если он не заполнен
		ЗаполнитьНомерКвартирыДляУчастникаСобрания(Элемент);
		
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Обработчик изменения собственника в табличной части ПредседательСекретарьСчетнаяКомиссия
//
Процедура ПредседательСекретарьСчетнаяКомиссияСобственникПриИзменении(Элемент) Экспорт
	
	Если ЗначениеЗаполнено(Элемент) И ЗначениеЗаполнено(Элемент.Собственник) Тогда
		
		ЗаполнитьНомерКвартирыДляУчастникаСобрания(Элемент);
		
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Заполняет номер квартиры для участника собрания из лицевых счетов
//
Процедура ЗаполнитьНомерКвартирыДляУчастникаСобрания(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Элемент) ИЛИ НЕ ЗначениеЗаполнено(Элемент.Собственник) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(МКД) Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Элемент.Собственник) <> Тип("СправочникСсылка.бит_Проживающие") Тогда
		Возврат;
	КонецЕсли;
	
	КвартираСобственника = ПолучитьКвартируСобственникаПоМКД(МКД, Элемент.Собственник);
	Если ЗначениеЗаполнено(КвартираСобственника) Тогда
		Элемент.НомерКвартиры = ПолучитьПредставлениеКвартирыИзРегистра(КвартираСобственника);
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Получает данные участников собрания (председатель, секретарь, счетная комиссия) из табличной части
// Возвращает структуру с данными участников
//
Функция ПолучитьДанныеУчастниковСобрания()
	
	Результат = Новый Структура;
	Результат.Вставить("Председатель", "");
	Результат.Вставить("ПредседательКвартира", "");
	Результат.Вставить("Секретарь", "");
	Результат.Вставить("СекретарьКвартира", "");
	Результат.Вставить("ЕстьУчастники", Ложь);
	//HD+ Массивы для участников счетной комиссии (максимум 5)
	Результат.Вставить("СчКомУчастники", Новый Массив);
	Результат.Вставить("СчКомУчастникиКвартиры", Новый Массив);
	
	// Проверяем, заполнена ли табличная часть
	Если НЕ ЗначениеЗаполнено(ПредседательСекретарьСчетнаяКомиссия) 
		ИЛИ ПредседательСекретарьСчетнаяКомиссия.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат.ЕстьУчастники = Истина;
	
	//HD+ Счетчик участников счетной комиссии (максимум 5)
	СчетчикСчетнойКомиссии = 0;
	
	// Перебираем строки табличной части
	Для Каждого СтрокаУчастника Из ПредседательСекретарьСчетнаяКомиссия Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаУчастника.Роль) 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
			Продолжить;
		КонецЕсли;
		
		//HD+ Представление собственника (как для печатных форм): Наименование, иначе Строка(Ссылка)
		ИмяСобственника = "";
		Попытка
			Если ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
				ИмяСобственника = СокрЛП(Строка(СтрокаУчастника.Собственник.Наименование));
				Если НЕ ЗначениеЗаполнено(ИмяСобственника) Тогда
					ИмяСобственника = СокрЛП(Строка(СтрокаУчастника.Собственник));
				КонецЕсли;
			КонецЕсли;
		Исключение
			ИмяСобственника = СокрЛП(Строка(СтрокаУчастника.Собственник));
		КонецПопытки;
		НомерКвартиры = "";
		Если ЗначениеЗаполнено(СтрокаУчастника.НомерКвартиры) Тогда
			НомерКвартиры = СокрЛП(Строка(СтрокаУчастника.НомерКвартиры));
		КонецЕсли;
		
		// Проверяем тип значения роли
		Если ТипЗнч(СтрокаУчастника.Роль) = Тип("ПеречислениеСсылка.HD_РолиУчастников") Тогда
			
			Если СтрокаУчастника.Роль = Перечисления.HD_РолиУчастников.Председатель Тогда
				Результат.Председатель = ИмяСобственника;
				Результат.ПредседательКвартира = НомерКвартиры;
			ИначеЕсли СтрокаУчастника.Роль = Перечисления.HD_РолиУчастников.Секретарь Тогда
				Результат.Секретарь = ИмяСобственника;
				Результат.СекретарьКвартира = НомерКвартиры;
			ИначеЕсли СтрокаУчастника.Роль = Перечисления.HD_РолиУчастников.СчетнаяКомиссия Тогда
				//HD+ Добавляем участника в массив (максимум 5)
				Если СчетчикСчетнойКомиссии < 5 Тогда
					Результат.СчКомУчастники.Добавить(ИмяСобственника);
					Результат.СчКомУчастникиКвартиры.Добавить(НомерКвартиры);
					СчетчикСчетнойКомиссии = СчетчикСчетнойКомиссии + 1;
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Заполняет параметры участников счетной комиссии в области
// Параметры:
//  ПараметрыОбласти - ПараметрыОбластиМакета - параметры области макета
//  ДанныеУчастников - Структура - данные участников собрания
//
Процедура ЗаполнитьПараметрыУчастниковСчетнойКомиссии(ПараметрыОбласти, ДанныеУчастников)
	
	Если ПараметрыОбласти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		//HD+ Заполняем параметры для участников счетной комиссии (максимум 5)
		Для Индекс = 0 По 4 Цикл
			
			НомерУчастника = Индекс + 1;
			ИмяПараметраУчастника = "СчКомУчастник_" + Формат(НомерУчастника, "ЧГ=");
			ИмяПараметраКвартиры = "СчКомУчастник_" + Формат(НомерУчастника, "ЧГ=") + "_кв";
			
			ЗначениеУчастника = "";
			ЗначениеКвартиры = "";
			
			Если ДанныеУчастников.СчКомУчастники.Количество() > Индекс Тогда
				ЗначениеУчастника = ДанныеУчастников.СчКомУчастники[Индекс];
				ЗначениеКвартиры = ДанныеУчастников.СчКомУчастникиКвартиры[Индекс];
			КонецЕсли;
			
			//HD+ Заполняем параметры участника
			Попытка
				ПараметрыОбласти[ИмяПараметраУчастника] = ЗначениеУчастника;
			Исключение
				// Параметр не найден в области - пропускаем
			КонецПопытки;
			
			Попытка
				ПараметрыОбласти[ИмяПараметраКвартиры] = ЗначениеКвартиры;
			Исключение
				// Параметр не найден в области - пропускаем
			КонецПопытки;
			
		КонецЦикла;
	Исключение
		// Ошибка при заполнении параметров - ничего не делаем
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Выводит в табличный документ области макета ПФ_MXL_БланкРешения с данными вкладки «Органы собрания»:
// ОбластьПредседатель, ОбластьСекретарь, ОбластьСчКом_1..5. Источник — ПолучитьДанныеУчастниковСобрания().
//
Процедура ВывестиОбластиОргановСобранияДляБланкаРешенияMXL(ТабличныйДокумент, Макет, ДанныеОрганов, Прочерк)
	
	Если ТабличныйДокумент = Неопределено ИЛИ Макет = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(ДанныеОрганов) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("ОбластьПредседатель");
	Если ОбластьМакета <> Неопределено
		И (ЗначениеЗаполнено(ДанныеОрганов.Председатель) ИЛИ ЗначениеЗаполнено(ДанныеОрганов.ПредседательКвартира)) Тогда
		Попытка
			ПараметрыОбласти = ОбластьМакета.Параметры;
			ПараметрыОбласти.Председатель = ?(ЗначениеЗаполнено(ДанныеОрганов.Председатель), Строка(ДанныеОрганов.Председатель), "");
			ПараметрыОбласти.ПредседательКвартира = ?(ЗначениеЗаполнено(ДанныеОрганов.ПредседательКвартира), Строка(ДанныеОрганов.ПредседательКвартира), "");
		Исключение
		КонецПопытки;
		ТабличныйДокумент.Вывести(ОбластьМакета);
	КонецЕсли;
	
	ОбластьМакета = Макет.ПолучитьОбласть("ОбластьСекретарь");
	Если ОбластьМакета <> Неопределено
		И (ЗначениеЗаполнено(ДанныеОрганов.Секретарь) ИЛИ ЗначениеЗаполнено(ДанныеОрганов.СекретарьКвартира)) Тогда
		Попытка
			ПараметрыОбласти = ОбластьМакета.Параметры;
			ПараметрыОбласти.Секретарь = ?(ЗначениеЗаполнено(ДанныеОрганов.Секретарь), Строка(ДанныеОрганов.Секретарь), "");
			ПараметрыОбласти.СекретарьКвартира = ?(ЗначениеЗаполнено(ДанныеОрганов.СекретарьКвартира), Строка(ДанныеОрганов.СекретарьКвартира), "");
		Исключение
		КонецПопытки;
		ТабличныйДокумент.Вывести(ОбластьМакета);
	КонецЕсли;
	
	Для НомерСчКом = 1 По 5 Цикл
		ИмяОбластиСчКом = "ОбластьСчКом_" + Формат(НомерСчКом, "ЧГ=");
		ОбластьМакета = Макет.ПолучитьОбласть(ИмяОбластиСчКом);
		Если ОбластьМакета = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ИмяПараметраУчастник = "СчКомУчастник_" + Формат(НомерСчКом, "ЧГ=");
		ИмяПараметраКвартира = ИмяПараметраУчастник + "_кв";
		ЗначениеУчастник = "";
		ЗначениеКвартира = "";
		ИндексВМассиве = НомерСчКом - 1;
		Если ДанныеОрганов.СчКомУчастники.Количество() > ИндексВМассиве И ЗначениеЗаполнено(ДанныеОрганов.СчКомУчастники[ИндексВМассиве]) Тогда
			ЗначениеУчастник = Строка(ДанныеОрганов.СчКомУчастники[ИндексВМассиве]);
		КонецЕсли;
		Если ДанныеОрганов.СчКомУчастникиКвартиры.Количество() > ИндексВМассиве И ЗначениеЗаполнено(ДанныеОрганов.СчКомУчастникиКвартиры[ИндексВМассиве]) Тогда
			ЗначениеКвартира = Строка(ДанныеОрганов.СчКомУчастникиКвартиры[ИндексВМассиве]);
		КонецЕсли;
		Если НЕ ЗначениеЗаполнено(ЗначениеУчастник) И НЕ ЗначениеЗаполнено(ЗначениеКвартира) Тогда
			Продолжить;
		КонецЕсли;
		Попытка
			ПараметрыОбласти = ОбластьМакета.Параметры;
			ПараметрыОбласти[ИмяПараметраУчастник] = ЗначениеУчастник;
			ПараметрыОбласти[ИмяПараметраКвартира] = ЗначениеКвартира;
		Исключение
		КонецПопытки;
		ТабличныйДокумент.Вывести(ОбластьМакета);
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Заполняет параметры участников счетной комиссии в области макета Word (СчетнаяКомиссия_1..5, СчетнаяКомиссия_1_Кв..5_Кв). Пустые — пустой строкой.
//
Процедура ЗаполнитьПараметрыСчетнойКомиссииWord(ПараметрыОбласти, ДанныеУчастников, Прочерк_1, Прочерк_1_Кв, Прочерк_2, Прочерк_2_Кв, Прочерк_3, Прочерк_3_Кв, Прочерк_4, Прочерк_4_Кв, Прочерк_5, Прочерк_5_Кв)
	
	Если ПараметрыОбласти = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИменаПараметров = Новый Массив;
	ИменаПараметров.Добавить(Новый Структура("Участник, Кв", "СчетнаяКомиссия_1", "СчетнаяКомиссия_1_Кв"));
	ИменаПараметров.Добавить(Новый Структура("Участник, Кв", "СчетнаяКомиссия_2", "СчетнаяКомиссия_2_Кв"));
	ИменаПараметров.Добавить(Новый Структура("Участник, Кв", "СчетнаяКомиссия_3", "СчетнаяКомиссия_3_Кв"));
	ИменаПараметров.Добавить(Новый Структура("Участник, Кв", "СчетнаяКомиссия_4", "СчетнаяКомиссия_4_Кв"));
	ИменаПараметров.Добавить(Новый Структура("Участник, Кв", "СчетнаяКомиссия_5", "СчетнаяКомиссия_5_Кв"));
	
	Попытка
		Для Индекс = 0 По 4 Цикл
			ЗначУчастник = "";
			ЗначКв = "";
			Если ДанныеУчастников.СчКомУчастники.Количество() > Индекс Тогда
				ЗначУчастник = ДанныеУчастников.СчКомУчастники[Индекс];
				ЗначКв = ДанныеУчастников.СчКомУчастникиКвартиры[Индекс];
			КонецЕсли;
			ПараметрыОбласти[ИменаПараметров[Индекс].Участник] = ?(ЗначениеЗаполнено(ЗначУчастник), ЗначУчастник, "");
			ПараметрыОбласти[ИменаПараметров[Индекс].Кв] = ?(ЗначениеЗаполнено(ЗначКв), ЗначКв, "");
		КонецЦикла;
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Обработчик изменения площади участника
//
Процедура УчастникиСобранияПлощадьПриИзменении(Элемент) Экспорт
	
	ПересчитатьПлощадьИПроцентУчастников();
	
КонецПроцедуры //HD-

//HD+
// Обработчик изменения квартиры участника
//
Процедура УчастникиСобранияКвартираПриИзменении(Элемент) Экспорт
	
	Если ЗначениеЗаполнено(Элемент) И ЗначениеЗаполнено(Элемент.Собственник) Тогда
		
		ЗаполнитьДанныеУчастника(Элемент);
		
	КонецЕсли;
	
КонецПроцедуры //HD-

#КонецОбласти

#Область РаботаСШаблонамиОбщихОбластей

//HD+
// Получает список общих областей, которые есть в указанном макете
// Параметры:
//  ИмяШаблона - Строка - имя макета печатной формы
// Возвращает:
//  Массив - массив строк с именами областей, которые есть в макете
//
Функция ПолучитьСписокОбщихОбластейВМакете(ИмяШаблона) Экспорт
	
	СписокОбластей = Новый Массив;
	
	Попытка
		
		Макет = ПолучитьМакет(ИмяШаблона);
		
		// Список возможных общих областей
		ВозможныеОбласти = Новый Массив;
		ВозможныеОбласти.Добавить("ОбластьОглавлениеВопрос");
		ВозможныеОбласти.Добавить("ОбластьСтрокаВопрос");
		ВозможныеОбласти.Добавить("ОбластьОглавлениеПредложение");
		ВозможныеОбласти.Добавить("ОбластьСтрокаПредложение");
		
		// Проверяем наличие каждой области в макете
		Для Каждого ИмяОбласти Из ВозможныеОбласти Цикл
			
			Попытка
			Область = Макет.ПолучитьОбласть(ИмяОбласти);
			Если Область <> Неопределено Тогда
				СписокОбластей.Добавить(ИмяОбласти);
			КонецЕсли;
			Исключение
				// Область не найдена в макете - пропускаем её
			КонецПопытки;
			
		КонецЦикла;
		
	Исключение
		
		// Если макет не найден или ошибка - возвращаем пустой массив
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при получении списка общих областей из макета """ + ИмяШаблона + """: " + ОписаниеОшибки());
		
	КонецПопытки;
	
	Возврат СписокОбластей;
	
КонецФункции //HD-

//HD+
// Извлекает содержимое общих областей из макета и формирует табличный документ для редактирования
// Параметры:
//  ИмяШаблона - Строка - имя макета печатной формы
// Возвращает:
//  ТабличныйДокумент - табличный документ с областями для редактирования
//
Функция ИзвлечьОбщиеОбластиИзМакета(ИмяШаблона) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	Попытка
		
		Макет = ПолучитьМакет(ИмяШаблона);
		СписокОбластей = ПолучитьСписокОбщихОбластейВМакете(ИмяШаблона);
		
		Если СписокОбластей.Количество() = 0 Тогда
			Возврат ТабличныйДокумент;
		КонецЕсли;
		
		// Извлекаем каждую область и добавляем в табличный документ
		Для Каждого ИмяОбласти Из СписокОбластей Цикл
			
			Область = Макет.ПолучитьОбласть(ИмяОбласти);
			Если Область <> Неопределено Тогда
				
				// Создаем временный табличный документ для области
				ВременныйДокумент = Новый ТабличныйДокумент;
				ВременныйДокумент.Вывести(Область);
				
				// Области будут идентифицироваться по порядку следования
				// Комментарии не используются, так как у ячеек нет такого свойства
				
				// Запоминаем номер строки начала области в основном документе
				НачалоОбласти = ТабличныйДокумент.ВысотаТаблицы;
				
				// Добавляем область в основной документ
				ТабличныйДокумент.Вывести(ВременныйДокумент);
				
				// Пустая строка для разделения не требуется - области будут разделены автоматически
				
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при извлечении общих областей из макета """ + ИмяШаблона + """: " + ОписаниеОшибки());
		ВызватьИсключение;
		
	КонецПопытки;
	
	Возврат ТабличныйДокумент;
	
КонецФункции //HD-

//HD+
// Извлекает общие области из макета с заполнением данными из документа
// Параметры:
//  ИмяШаблона - Строка - имя макета печатной формы
// Возвращает:
//  ТабличныйДокумент - табличный документ с заполненными областями
//
Функция ИзвлечьОбщиеОбластиИзМакетаСДанными(ИмяШаблона) Экспорт
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	// Инициализируем таблицу значений для хранения координат областей
	КоординатыОбластей = Новый ТаблицаЗначений;
	КоординатыОбластей.Колонки.Добавить("ИмяОбласти", Новый ОписаниеТипов("Строка"));
	КоординатыОбластей.Колонки.Добавить("ПорядковыйНомер", Новый ОписаниеТипов("Число"));
	КоординатыОбластей.Колонки.Добавить("НачалоСтроки", Новый ОписаниеТипов("Число"));
	КоординатыОбластей.Колонки.Добавить("КонецСтроки", Новый ОписаниеТипов("Число"));
	
	// Счетчики для определения порядкового номера каждой области
	СчетчикиОбластейДляКоординат = Новый Соответствие;
	
	Попытка
		
		Макет = ПолучитьМакет(ИмяШаблона);
		СписокОбластей = ПолучитьСписокОбщихОбластейВМакете(ИмяШаблона);
		
		Если СписокОбластей.Количество() = 0 Тогда
			Возврат ТабличныйДокумент;
		КонецЕсли;
		
		//HD+ Проверяем, есть ли области участников собрания перед вопросами
		ДанныеУчастников = ПолучитьДанныеУчастниковСобрания();
		ШаблоныТекстаПовестки = ПолучитьШаблоныТекстаПовесткиДляПечати();
		СоответствиеПараметровПечати = ПолучитьСоответствиеПользовательскихПараметровДляПечати();
		ОбластьУчастниковВыведена = Ложь;
		Если ДанныеУчастников.ЕстьУчастники Тогда
			// Проверяем, есть ли в списке областей области участников собрания перед ОбластьСтрокаВопрос
			Для Каждого ИмяОбластиПроверка Из СписокОбластей Цикл
				Если ИмяОбластиПроверка = "ОбластьСтрокаВопрос" Тогда
					Прервать;
				КонецЕсли;
				Если ИмяОбластиПроверка = "ОбластьУчастникиСобрания" 
					ИЛИ ИмяОбластиПроверка = "ОбластьСтрокаПредложениеУчастникиСобрания"
					ИЛИ ИмяОбластиПроверка = "ОбластьСтрокаФормулировкаВопросовУчастникиСобрания"
					ИЛИ ИмяОбластиПроверка = "ОбластьПредседатель"
					ИЛИ ИмяОбластиПроверка = "ОбластьСекретарь"
					ИЛИ (СтрДлина(ИмяОбластиПроверка) >= 14 И Лев(ИмяОбластиПроверка, 13) = "ОбластьСчКом_") Тогда
					ОбластьУчастниковВыведена = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Извлекаем каждую область и добавляем в табличный документ
		Для Каждого ИмяОбласти Из СписокОбластей Цикл
			
			Область = Макет.ПолучитьОбласть(ИмяОбласти);
			Если Область <> Неопределено Тогда
				
				// Для областей с данными заполняем их из документа
				Если ИмяОбласти = "ОбластьСтрокаВопрос" Тогда
					
					// Заполняем области вопросами из табличной части ПовесткаДня
					//HD+ Начинаем нумерацию вопросов с 1, если выведена область участников собрания (чтобы первый вопрос был номер 2), иначе с 0 (чтобы первый вопрос был номер 1)
					НомерВопроса = ?(ОбластьУчастниковВыведена, 1, 0);
					ИндексСтрокиПовестки = 0;
					Для Каждого СтрокаПовестки Из ЭтотОбъект.ПовесткаДня Цикл
						
						НомерВопроса = НомерВопроса + 1;
						
						// Получаем новую копию области для каждой строки
						ОбластьСтрокаВопрос = Макет.ПолучитьОбласть("ОбластьСтрокаВопрос");
						Если ОбластьСтрокаВопрос <> Неопределено Тогда
							
							ОбластьСтрокаВопрос.Параметры.НомерВопроса = Формат(НомерВопроса, "ЧГ=");
							ОбластьСтрокаВопрос.Параметры.Вопрос = ПолучитьТекстПоляПовесткиДляПечати(ИндексСтрокиПовестки, "Вопрос", ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
							
							// Создаем временный табличный документ для области
							ВременныйДокумент = Новый ТабличныйДокумент;
							ВременныйДокумент.Вывести(ОбластьСтрокаВопрос);
							
							// Запоминаем координаты области перед выводом
							НачалоСтроки = ТабличныйДокумент.ВысотаТаблицы;
							
							// Добавляем область в основной документ
							ТабличныйДокумент.Вывести(ВременныйДокумент);
							
							// Запоминаем координаты области после вывода
							КонецСтроки = ТабличныйДокумент.ВысотаТаблицы - 1;
							
							// Определяем порядковый номер для этой области
							Если СчетчикиОбластейДляКоординат.Получить("ОбластьСтрокаВопрос") = Неопределено Тогда
								СчетчикиОбластейДляКоординат.Вставить("ОбластьСтрокаВопрос", 0);
							КонецЕсли;
							ПорядковыйНомер = СчетчикиОбластейДляКоординат.Получить("ОбластьСтрокаВопрос");
							СчетчикиОбластейДляКоординат.Вставить("ОбластьСтрокаВопрос", ПорядковыйНомер + 1);
							
							// Сохраняем координаты области
							НоваяСтрокаКоординат = КоординатыОбластей.Добавить();
							НоваяСтрокаКоординат.ИмяОбласти = "ОбластьСтрокаВопрос";
							НоваяСтрокаКоординат.ПорядковыйНомер = ПорядковыйНомер;
							НоваяСтрокаКоординат.НачалоСтроки = НачалоСтроки;
							НоваяСтрокаКоординат.КонецСтроки = КонецСтроки;
							
						КонецЕсли;
						
						ИндексСтрокиПовестки = ИндексСтрокиПовестки + 1;
						
					КонецЦикла;
					
				ИначеЕсли ИмяОбласти = "ОбластьУчастникиСобрания" 
					ИЛИ ИмяОбласти = "ОбластьСтрокаПредложениеУчастникиСобрания"
					ИЛИ ИмяОбласти = "ОбластьСтрокаФормулировкаВопросовУчастникиСобрания"
					ИЛИ ИмяОбласти = "ОбластьПредседатель"
					ИЛИ ИмяОбласти = "ОбластьСекретарь"
					ИЛИ (СтрДлина(ИмяОбласти) >= 14 И Лев(ИмяОбласти, 13) = "ОбластьСчКом_") Тогда
					
					//HD+ Заполняем параметры областей органов собрания (одна область или раздельно: Председатель / Секретарь / СчКом_1..5)
					Если ДанныеУчастников.ЕстьУчастники Тогда
						Попытка
							Если Область.Параметры.Количество() <> 0 Тогда
								Если ИмяОбласти = "ОбластьПредседатель" Тогда
									Область.Параметры.Председатель = ДанныеУчастников.Председатель;
									Область.Параметры.ПредседательКвартира = ДанныеУчастников.ПредседательКвартира;
								ИначеЕсли ИмяОбласти = "ОбластьСекретарь" Тогда
									Область.Параметры.Секретарь = ДанныеУчастников.Секретарь;
									Область.Параметры.СекретарьКвартира = ДанныеУчастников.СекретарьКвартира;
								ИначеЕсли СтрДлина(ИмяОбласти) >= 14 И Лев(ИмяОбласти, 13) = "ОбластьСчКом_" Тогда
									Попытка
										НомерСчКомОбласти = Число(Сред(ИмяОбласти, 14));
									Исключение
										НомерСчКомОбласти = 0;
									КонецПопытки;
									Если НомерСчКомОбласти >= 1 И НомерСчКомОбласти <= 5 Тогда
										ИндексОргана = НомерСчКомОбласти - 1;
										ИмяПараметраУчастникСК = "СчКомУчастник_" + Формат(НомерСчКомОбласти, "ЧГ=");
										ИмяПараметраКвартираСК = ИмяПараметраУчастникСК + "_кв";
										ЗначениеУчастникСК = "";
										ЗначениеКвартираСК = "";
										Если ДанныеУчастников.СчКомУчастники.Количество() > ИндексОргана Тогда
											ЗначениеУчастникСК = ДанныеУчастников.СчКомУчастники[ИндексОргана];
										КонецЕсли;
										Если ДанныеУчастников.СчКомУчастникиКвартиры.Количество() > ИндексОргана Тогда
											ЗначениеКвартираСК = ДанныеУчастников.СчКомУчастникиКвартиры[ИндексОргана];
										КонецЕсли;
										Попытка
											Область.Параметры[ИмяПараметраУчастникСК] = ЗначениеУчастникСК;
											Область.Параметры[ИмяПараметраКвартираСК] = ЗначениеКвартираСК;
										Исключение
										КонецПопытки;
									КонецЕсли;
								Иначе
									Область.Параметры.Председатель = ДанныеУчастников.Председатель;
									Область.Параметры.ПредседательКвартира = ДанныеУчастников.ПредседательКвартира;
									Область.Параметры.Секретарь = ДанныеУчастников.Секретарь;
									Область.Параметры.СекретарьКвартира = ДанныеУчастников.СекретарьКвартира;
									ЗаполнитьПараметрыУчастниковСчетнойКомиссии(Область.Параметры, ДанныеУчастников);
								КонецЕсли;
							КонецЕсли;
						Исключение
							// Параметров нет - ничего не делаем
						КонецПопытки;
					КонецЕсли;
					
					ТабличныйДокумент.Вывести(Область);
					
				ИначеЕсли ИмяОбласти = "ОбластьСтрокаПредложение" Тогда
					
					// Заполняем области предложениями из табличной части ПовесткаДня
					НомерПредложения = 0;
					ИндексСтрокиПовестки = 0;
					Для Каждого СтрокаПовестки Из ЭтотОбъект.ПовесткаДня Цикл
						
						ТекстПредложения = ПолучитьТекстПоляПовесткиДляПечати(ИндексСтрокиПовестки, "ФормулировкаПредложенияРешенияВопроса", ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
						ИндексСтрокиПовестки = ИндексСтрокиПовестки + 1;
						
						Если НЕ ЗначениеЗаполнено(ТекстПредложения) Тогда
							Продолжить;
						КонецЕсли;
						
						НомерПредложения = НомерПредложения + 1;
						
						// Получаем новую копию области для каждой строки
						ОбластьСтрокаПредложение = Макет.ПолучитьОбласть("ОбластьСтрокаПредложение");
						Если ОбластьСтрокаПредложение <> Неопределено Тогда
							
							ОбластьСтрокаПредложение.Параметры.НомерПредложения = Формат(НомерПредложения, "ЧГ=");
							ОбластьСтрокаПредложение.Параметры.Предложение = ТекстПредложения;
							
							// Создаем временный табличный документ для области
							ВременныйДокумент = Новый ТабличныйДокумент;
							ВременныйДокумент.Вывести(ОбластьСтрокаПредложение);
							
							// Запоминаем координаты области перед выводом
							НачалоСтроки = ТабличныйДокумент.ВысотаТаблицы;
							
							// Добавляем область в основной документ
							ТабличныйДокумент.Вывести(ВременныйДокумент);
							
							// Запоминаем координаты области после вывода
							КонецСтроки = ТабличныйДокумент.ВысотаТаблицы - 1;
							
							// Определяем порядковый номер для этой области
							Если СчетчикиОбластейДляКоординат.Получить("ОбластьСтрокаПредложение") = Неопределено Тогда
								СчетчикиОбластейДляКоординат.Вставить("ОбластьСтрокаПредложение", 0);
							КонецЕсли;
							ПорядковыйНомер = СчетчикиОбластейДляКоординат.Получить("ОбластьСтрокаПредложение");
							СчетчикиОбластейДляКоординат.Вставить("ОбластьСтрокаПредложение", ПорядковыйНомер + 1);
							
							// Сохраняем координаты области
							НоваяСтрокаКоординат = КоординатыОбластей.Добавить();
							НоваяСтрокаКоординат.ИмяОбласти = "ОбластьСтрокаПредложение";
							НоваяСтрокаКоординат.ПорядковыйНомер = ПорядковыйНомер;
							НоваяСтрокаКоординат.НачалоСтроки = НачалоСтроки;
							НоваяСтрокаКоординат.КонецСтроки = КонецСтроки;
							
						КонецЕсли;
						
					КонецЦикла;
					
				Иначе
					
					// Для остальных областей просто извлекаем из макета
					ВременныйДокумент = Новый ТабличныйДокумент;
					ВременныйДокумент.Вывести(Область);
					
					// Запоминаем координаты области перед выводом
					НачалоСтроки = ТабличныйДокумент.ВысотаТаблицы;
					
					// Добавляем область в основной документ
					ТабличныйДокумент.Вывести(ВременныйДокумент);
					
					// Запоминаем координаты области после вывода
					КонецСтроки = ТабличныйДокумент.ВысотаТаблицы - 1;
					
					// Определяем порядковый номер для этой области (для одиночных областей всегда 0)
					Если СчетчикиОбластейДляКоординат.Получить(ИмяОбласти) = Неопределено Тогда
						СчетчикиОбластейДляКоординат.Вставить(ИмяОбласти, 0);
					КонецЕсли;
					ПорядковыйНомер = СчетчикиОбластейДляКоординат.Получить(ИмяОбласти);
					СчетчикиОбластейДляКоординат.Вставить(ИмяОбласти, ПорядковыйНомер + 1);
					
					// Сохраняем координаты области
					НоваяСтрокаКоординат = КоординатыОбластей.Добавить();
					НоваяСтрокаКоординат.ИмяОбласти = ИмяОбласти;
					НоваяСтрокаКоординат.ПорядковыйНомер = ПорядковыйНомер;
					НоваяСтрокаКоординат.НачалоСтроки = НачалоСтроки;
					НоваяСтрокаКоординат.КонецСтроки = КонецСтроки;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
		
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при извлечении общих областей из макета с данными """ + ИмяШаблона + """: " + ОписаниеОшибки());
		ВызватьИсключение;
		
	КонецПопытки;
	
	// Сохраняем координаты областей во временное хранилище для последующего использования при сохранении
	Если КоординатыОбластей <> Неопределено И КоординатыОбластей.Количество() > 0 Тогда
		Попытка
			АдресКоординат = ПоместитьВоВременноеХранилище(КоординатыОбластей);
			// Сохраняем адрес координат в переменную модуля для использования при сохранении
			АдресКоординатОбластейВоХранилище = АдресКоординат;
			ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
				"Координаты областей сохранены во временное хранилище. Количество областей: " + Формат(КоординатыОбластей.Количество(), "ЧГ=") + 
				". Адрес: " + АдресКоординат);
			
			// Логируем содержимое координат для отладки
			Для Каждого СтрокаКоординат Из КоординатыОбластей Цикл
				ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
					"  Область: " + СтрокаКоординат.ИмяОбласти + 
					", Порядковый номер: " + Формат(СтрокаКоординат.ПорядковыйНомер, "ЧГ=") + 
					", Строки: " + Формат(СтрокаКоординат.НачалоСтроки, "ЧГ=") + "-" + Формат(СтрокаКоординат.КонецСтроки, "ЧГ="));
			КонецЦикла;
		Исключение
			ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
				"Ошибка при сохранении координат областей во временное хранилище: " + ОписаниеОшибки());
			АдресКоординатОбластейВоХранилище = "";
		КонецПопытки;
	Иначе
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Предупреждение, , , 
			"Координаты областей не были сохранены (пусто или неопределено)");
		АдресКоординатОбластейВоХранилище = "";
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции //HD-

//HD+
// Сохраняет отредактированный табличный документ во временное хранилище
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - табличный документ с отредактированными областями
//  ИмяШаблона - Строка - имя макета печатной формы
// Возвращает:
//  Строка - адрес во временном хранилище
//
Функция СохранитьШаблоныОбщихОбластей(ТабличныйДокумент, ИмяШаблона) Экспорт
	
	Попытка
		
		// Получаем список областей, которые должны быть в макете
		СписокОбластей = ПолучитьСписокОбщихОбластейВМакете(ИмяШаблона);
		
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
			"Начало сохранения шаблонов. Имя шаблона: " + ИмяШаблона + 
			". Количество областей в макете: " + Формат(СписокОбластей.Количество(), "ЧГ=") + 
			". Высота документа: " + Формат(ТабличныйДокумент.ВысотаТаблицы, "ЧГ=") + 
			". Ширина документа: " + Формат(ТабличныйДокумент.ШиринаТаблицы, "ЧГ="));
		
		Если СписокОбластей.Количество() = 0 Тогда
			ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Предупреждение, , , 
				"Список общих областей пуст для шаблона: " + ИмяШаблона);
			Возврат "";
		КонецЕсли;
		
		// Извлекаем текст из областей и сохраняем с именами областей
		// Используем соответствие: ключ - имя шаблона, значение - соответствие (ключ - имя области, значение - текст области)
		// Сначала загружаем существующие шаблоны (если есть адрес в документе)
		ШаблоныВсехФорм = Новый Соответствие;
		
		// Создаем таблицу значений для хранения текстов областей
		// Колонки: ИмяОбласти, ТекстОбласти, ПорядковыйНомер
		ТаблицаТекстовОбластей = Новый ТаблицаЗначений;
		ТаблицаТекстовОбластей.Колонки.Добавить("ИмяОбласти", Новый ОписаниеТипов("Строка"));
		ТаблицаТекстовОбластей.Колонки.Добавить("ТекстОбласти", Новый ОписаниеТипов("Строка"));
		ТаблицаТекстовОбластей.Колонки.Добавить("ПорядковыйНомер", Новый ОписаниеТипов("Число"));
		
		ВысотаДокумента = ТабличныйДокумент.ВысотаТаблицы;
		КоличествоОбластей = СписокОбластей.Количество();
		
		Если ВысотаДокумента > 0 И КоличествоОбластей > 0 Тогда
			
			// Загружаем координаты областей из временного хранилища, если они были сохранены
			ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
				"Попытка загрузить координаты областей. Адрес: " + ?(ЗначениеЗаполнено(АдресКоординатОбластейВоХранилище), АдресКоординатОбластейВоХранилище, "не задан"));
			
			Если ЗначениеЗаполнено(АдресКоординатОбластейВоХранилище) И НЕ ПустаяСтрока(АдресКоординатОбластейВоХранилище) Тогда
				Попытка
					КоординатыОбластей = ПолучитьИзВременногоХранилища(АдресКоординатОбластейВоХранилище);
					ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
						"Координаты областей загружены из временного хранилища. Количество областей: " + Формат(КоординатыОбластей.Количество(), "ЧГ="));
				Исключение
					ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Предупреждение, , , 
						"Не удалось загрузить координаты областей из временного хранилища: " + ОписаниеОшибки());
					КоординатыОбластей = Неопределено;
				КонецПопытки;
			Иначе
				ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Предупреждение, , , 
					"Адрес координат областей не задан или пуст. Будет использован fallback алгоритм.");
				КоординатыОбластей = Неопределено;
			КонецЕсли;
			
			// Используем сохраненные координаты областей для точного извлечения текста
			Если КоординатыОбластей <> Неопределено И КоординатыОбластей.Количество() > 0 Тогда
				
				ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
					"Используются сохраненные координаты областей. Количество областей: " + Формат(КоординатыОбластей.Количество(), "ЧГ="));
				
				// Проходим по всем сохраненным координатам и извлекаем текст
				Для Каждого СтрокаКоординат Из КоординатыОбластей Цикл
					
					Попытка
						
						НачалоСтроки = СтрокаКоординат.НачалоСтроки;
						КонецСтроки = СтрокаКоординат.КонецСтроки;
						ИмяОбласти = СтрокаКоординат.ИмяОбласти;
						ПорядковыйНомер = СтрокаКоординат.ПорядковыйНомер;
						
						// Проверяем, что координаты в пределах документа
						Если НачалоСтроки >= 0 И КонецСтроки < ВысотаДокумента И НачалоСтроки <= КонецСтроки Тогда
							
							// Извлекаем текст области по точным координатам
							ТекстОбласти = "";
							МассивСтрокТекста = Новый Массив;
							
							Для НомерСтрокиОбласти = НачалоСтроки По КонецСтроки Цикл
								МассивКолонокТекста = Новый Массив;
								
								Для НомерКолонки = 0 По ТабличныйДокумент.ШиринаТаблицы - 1 Цикл
									Попытка
										Ячейка = ТабличныйДокумент.Область(НомерСтрокиОбласти, НомерКолонки, НомерСтрокиОбласти, НомерКолонки);
										Если Ячейка <> Неопределено Тогда
											ТекстЯчейки = Ячейка.Текст;
											МассивКолонокТекста.Добавить(?(ЗначениеЗаполнено(ТекстЯчейки), ТекстЯчейки, ""));
										Иначе
											МассивКолонокТекста.Добавить("");
										КонецЕсли;
									Исключение
										МассивКолонокТекста.Добавить("");
									КонецПопытки;
					КонецЦикла;
					
								// Объединяем колонки через табуляцию
								СтрокаТекста = СтрСоединить(МассивКолонокТекста, Символы.Таб);
								МассивСтрокТекста.Добавить(СтрокаТекста);
							КонецЦикла;
							
							// Объединяем строки через перевод строки
							ТекстОбласти = СтрСоединить(МассивСтрокТекста, Символы.ПС);
							
							// Добавляем строку в таблицу значений
							НоваяСтрока = ТаблицаТекстовОбластей.Добавить();
							НоваяСтрока.ИмяОбласти = ИмяОбласти;
							НоваяСтрока.ТекстОбласти = ТекстОбласти;
							НоваяСтрока.ПорядковыйНомер = ПорядковыйНомер;
							
							ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
								"Извлечен и сохранен текст области: " + ИмяОбласти + 
								" (порядковый номер: " + Формат(ПорядковыйНомер, "ЧГ=") + 
								", строки: " + Формат(НачалоСтроки, "ЧГ=") + "-" + Формат(КонецСтроки, "ЧГ=") + 
								"). Длина текста: " + Формат(СтрДлина(ТекстОбласти), "ЧГ="));
							
						Иначе
							ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Предупреждение, , , 
								"Координаты области выходят за пределы документа: " + ИмяОбласти + 
								" (строки: " + Формат(НачалоСтроки, "ЧГ=") + "-" + Формат(КонецСтроки, "ЧГ=") + 
								", высота документа: " + Формат(ВысотаДокумента, "ЧГ=") + ")");
						КонецЕсли;
						
					Исключение
						ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
							"Ошибка при извлечении текста области по координатам: " + СтрокаКоординат.ИмяОбласти + 
							". Ошибка: " + ОписаниеОшибки());
					КонецПопытки;
					
				КонецЦикла;
				
			Иначе
				
				// Fallback: используем старый алгоритм, если координаты не были сохранены
				ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Предупреждение, , , 
					"Координаты областей не найдены, используется алгоритм определения по высоте");
				
				// Восстанавливаем границы областей: проходим по областям в том же порядке,
				// в котором они были добавлены в документ
				// Для этого нужно получить макет и определить высоту каждой области
						Попытка
					Макет = ПолучитьМакет(ИмяШаблона);
						Исключение
					Макет = Неопределено;
						КонецПопытки;
						
				ТекущаяСтрока = 0;
				
				// Определяем высоты всех областей из макета
				ВысотыОбластей = Новый Соответствие;
				Если Макет <> Неопределено Тогда
					Для Каждого ИмяОбласти Из СписокОбластей Цикл
						Попытка
							ОбластьМакета = Макет.ПолучитьОбласть(ИмяОбласти);
							Если ОбластьМакета <> Неопределено Тогда
								ВременныйДокумент = Новый ТабличныйДокумент;
								ВременныйДокумент.Вывести(ОбластьМакета);
								ВысотыОбластей.Вставить(ИмяОбласти, ВременныйДокумент.ВысотаТаблицы);
							Иначе
								ВысотыОбластей.Вставить(ИмяОбласти, 1);
							КонецЕсли;
						Исключение
							ВысотыОбластей.Вставить(ИмяОбласти, 1);
						КонецПопытки;
						КонецЦикла;
					КонецЕсли;
					
				// Счетчики для определения порядкового номера каждой области
				СчетчикиОбластей = Новый Соответствие; // Ключ - имя области, значение - порядковый номер
				
				// Определяем порядок областей в документе (знаем структуру из кода формирования)
				// Для шаблонов "Протокол" и "Итоги голосования" порядок:
				// 1. ОбластьОглавлениеВопрос (один раз)
				// 2. ОбластьСтрокаВопрос (повторяется)
				// 3. ОбластьОглавлениеПредложение (один раз)
				// 4. ОбластьСтрокаПредложение (повторяется)
				
				ПорядокОбластей = Новый Массив;
				Если СписокОбластей.Найти("ОбластьОглавлениеВопрос") >= 0 Тогда
					ПорядокОбластей.Добавить("ОбластьОглавлениеВопрос");
				КонецЕсли;
				Если СписокОбластей.Найти("ОбластьСтрокаВопрос") >= 0 Тогда
					ПорядокОбластей.Добавить("ОбластьСтрокаВопрос");
				КонецЕсли;
				Если СписокОбластей.Найти("ОбластьОглавлениеПредложение") >= 0 Тогда
					ПорядокОбластей.Добавить("ОбластьОглавлениеПредложение");
				КонецЕсли;
				Если СписокОбластей.Найти("ОбластьСтрокаПредложение") >= 0 Тогда
					ПорядокОбластей.Добавить("ОбластьСтрокаПредложение");
				КонецЕсли;
				
				// Проходим по документу последовательно, извлекая области по порядку
				Пока ТекущаяСтрока < ВысотаДокумента Цикл
				
						Попытка
					
					НайденаОбласть = Ложь;
					
					// Проходим по порядку областей и пытаемся найти следующую область
					Для Каждого ИмяОбласти Из ПорядокОбластей Цикл
						
						ВысотаОбласти = ВысотыОбластей.Получить(ИмяОбласти);
						Если ВысотаОбласти = Неопределено Тогда
							ВысотаОбласти = 1;
			КонецЕсли;
			
						// Проверяем, может ли текущая строка быть началом этой области
						// Для этого получаем область по координатам
						КонецОбласти = Мин(ТекущаяСтрока + ВысотаОбласти - 1, ВысотаДокумента - 1);
						
						Если КонецОбласти >= ТекущаяСтрока Тогда
							
							ОбластьДокумента = ТабличныйДокумент.Область(ТекущаяСтрока, 0, КонецОбласти, ТабличныйДокумент.ШиринаТаблицы - 1);
							
							// Извлекаем текст области вручную, проходя по ячейкам
							// ОбластьЯчеекТабличногоДокумента.Текст может не работать, поэтому извлекаем вручную
							ТекстОбласти = "";
							МассивСтрокТекста = Новый Массив;
							
							Для НомерСтрокиОбласти = ТекущаяСтрока По КонецОбласти Цикл
								МассивКолонокТекста = Новый Массив;
								
								Для НомерКолонки = 0 По ТабличныйДокумент.ШиринаТаблицы - 1 Цикл
				Попытка
										Ячейка = ТабличныйДокумент.Область(НомерСтрокиОбласти, НомерКолонки, НомерСтрокиОбласти, НомерКолонки);
										Если Ячейка <> Неопределено Тогда
											ТекстЯчейки = Ячейка.Текст;
											МассивКолонокТекста.Добавить(?(ЗначениеЗаполнено(ТекстЯчейки), ТекстЯчейки, ""));
										Иначе
											МассивКолонокТекста.Добавить("");
										КонецЕсли;
				Исключение
										МассивКолонокТекста.Добавить("");
				КонецПопытки;
								КонецЦикла;
								
								// Объединяем колонки через табуляцию
								СтрокаТекста = СтрСоединить(МассивКолонокТекста, Символы.Таб);
								МассивСтрокТекста.Добавить(СтрокаТекста);
							КонецЦикла;
							
							// Объединяем строки через перевод строки
							ТекстОбласти = СтрСоединить(МассивСтрокТекста, Символы.ПС);
							
							// Проверяем, не пустая ли область
							// Для повторяющихся областей (ОбластьСтрокаВопрос, ОбластьСтрокаПредложение) 
							// всегда извлекаем, так как они могут быть пустыми
							// Для одиночных областей проверяем, что текст не пустой
							ИзвлекатьОбласть = Ложь;
							
							Если ИмяОбласти = "ОбластьСтрокаВопрос" Или ИмяОбласти = "ОбластьСтрокаПредложение" Тогда
								// Для повторяющихся областей извлекаем всегда (даже если пустые)
								ИзвлекатьОбласть = Истина;
							Иначе
								// Для одиночных областей проверяем, что текст не пустой
								Если ЗначениеЗаполнено(ТекстОбласти) И НЕ ПустаяСтрока(СокрЛП(ТекстОбласти)) Тогда
									ИзвлекатьОбласть = Истина;
								КонецЕсли;
			КонецЕсли;
			
							Если ИзвлекатьОбласть Тогда
								
								// Определяем порядковый номер для этой области
								Если СчетчикиОбластей.Получить(ИмяОбласти) = Неопределено Тогда
									СчетчикиОбластей.Вставить(ИмяОбласти, 0);
		КонецЕсли;
								ПорядковыйНомер = СчетчикиОбластей.Получить(ИмяОбласти);
								СчетчикиОбластей.Вставить(ИмяОбласти, ПорядковыйНомер + 1);
								
								// Добавляем строку в таблицу значений
								НоваяСтрока = ТаблицаТекстовОбластей.Добавить();
								НоваяСтрока.ИмяОбласти = ИмяОбласти;
								НоваяСтрока.ТекстОбласти = ТекстОбласти;
								НоваяСтрока.ПорядковыйНомер = ПорядковыйНомер;
								
								ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
									"Извлечен и сохранен текст области: " + ИмяОбласти + 
									" (порядковый номер: " + Формат(ПорядковыйНомер, "ЧГ=") + 
									", строка: " + Формат(ТекущаяСтрока, "ЧГ=") + "-" + Формат(КонецОбласти, "ЧГ=") + 
									"). Длина текста: " + Формат(СтрДлина(ТекстОбласти), "ЧГ="));
								
								// Переходим к следующей строке после этой области
								ТекущаяСтрока = КонецОбласти + 1;
								НайденаОбласть = Истина;
								
								// Для одиночных областей (Оглавление) переходим к следующей области в порядке
								// Для повторяющихся областей продолжаем искать ту же область
								Если ИмяОбласти <> "ОбластьСтрокаВопрос" И ИмяОбласти <> "ОбластьСтрокаПредложение" Тогда
									Прервать; // Переходим к следующей области в порядке
			КонецЕсли;
								// Для повторяющихся областей продолжаем цикл, чтобы найти следующий экземпляр
			
							КонецЕсли;
		
						КонецЕсли;
			
			КонецЦикла;
			
					// Если область не найдена, переходим к следующей строке
					Если НЕ НайденаОбласть Тогда
						ТекущаяСтрока = ТекущаяСтрока + 1;
					КонецЕсли;
					
				Исключение
					// Пропускаем строку, если не удалось обработать
					ТекущаяСтрока = ТекущаяСтрока + 1;
				КонецПопытки;
				
			КонецЦикла; // Пока ТекущаяСтрока < ВысотаДокумента
				
			КонецЕсли; // Если координаты не были сохранены (fallback)
			
			// Сохраняем таблицу значений в соответствие
			ТекстыОбластей = Новый Соответствие;
			ТекстыОбластей.Вставить("ТаблицаТекстовОбластей", ТаблицаТекстовОбластей);
			
		КонецЕсли; // Если ВысотаДокумента > 0 И КоличествоОбластей > 0
		
		// Сохраняем соответствие текстов областей для текущего шаблона
		ШаблоныВсехФорм.Вставить(ИмяШаблона, ТекстыОбластей);
		
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
			"Сохранены тексты областей для шаблона: " + ИмяШаблона + 
			". Количество строк в таблице: " + Формат(ТаблицаТекстовОбластей.Количество(), "ЧГ="));
		
		// Сохраняем во временное хранилище
		УникальныйИдентификатор = Новый УникальныйИдентификатор;
		АдресВоХранилище = ПоместитьВоВременноеХранилище(ШаблоныВсехФорм, УникальныйИдентификатор);
		
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
			"Шаблоны сохранены во временное хранилище. Адрес: " + АдресВоХранилище + 
			". Шаблон: " + ИмяШаблона);
		
		Возврат АдресВоХранилище;
		
	Исключение
		
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при сохранении шаблонов общих областей: " + ОписаниеОшибки());
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Получает сохраненные тексты областей для шаблона из временного хранилища
// Параметры:
//  АдресВоХранилище - Строка - адрес во временном хранилище
//  ИмяШаблона - Строка - имя шаблона
// Возвращает:
//  Соответствие - соответствие (ключ - имя области, значение - текст области) или Неопределено
//
Функция ПолучитьШаблоныОбщихОбластей(АдресВоХранилище, ИмяШаблона = "") Экспорт
	
	Если НЕ ЗначениеЗаполнено(АдресВоХранилище) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		
		ШаблоныВсехФорм = ПолучитьИзВременногоХранилища(АдресВоХранилище);
		
		Если ТипЗнч(ШаблоныВсехФорм) = Тип("Соответствие") Тогда
			
			Если НЕ ЗначениеЗаполнено(ИмяШаблона) Тогда
				// Если имя шаблона не указано, возвращаем первое значение (для обратной совместимости)
				Если ШаблоныВсехФорм.Количество() > 0 Тогда
					Для Каждого Элемент Из ШаблоныВсехФорм Цикл
						Если ТипЗнч(Элемент.Значение) = Тип("Соответствие") Тогда
							Возврат Элемент.Значение;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				Возврат Неопределено;
			КонецЕсли;
			
			ТекстыОбластей = ШаблоныВсехФорм.Получить(ИмяШаблона);
			Если ТекстыОбластей <> Неопределено И ТипЗнч(ТекстыОбластей) = Тип("Соответствие") Тогда
				ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
					"Загружены тексты областей для шаблона: " + ИмяШаблона + 
					". Количество областей: " + Формат(ТекстыОбластей.Количество(), "ЧГ="));
				Возврат ТекстыОбластей;
		Иначе
				ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Предупреждение, , , 
					"Шаблон " + ИмяШаблона + " не найден в хранилище или имеет неверный тип. Адрес: " + АдресВоХранилище);
				Возврат Неопределено;
			КонецЕсли;
		Иначе
			ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Предупреждение, , , 
				"Загруженный объект не является соответствием. Тип: " + Строка(ТипЗнч(ШаблоныВсехФорм)));
			Возврат Неопределено;
		КонецЕсли;
		
	Исключение
		
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при получении шаблонов общих областей из хранилища. Адрес: " + АдресВоХранилище + ". Ошибка: " + ОписаниеОшибки());
		Возврат Неопределено;
		
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Получает область из сохраненного шаблона или из макета
// Параметры:
//  ИмяОбласти - Строка - имя области
//  Макет - Макет - макет печатной формы
// Возвращает:
//  ОбластьЯчеекТабличногоДокумента - область для вывода
//
Функция ПолучитьОбластьСШаблономИлиИзМакета(ИмяОбласти, Макет)
	
	// Всегда получаем область из макета (чтобы сохранить параметры)
	Попытка
	Область = Макет.ПолучитьОбласть(ИмяОбласти);
	Исключение
		// Если область не найдена в макете, возвращаем Неопределено
		Возврат Неопределено;
	КонецПопытки;
	
	Если Область = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	// Если есть сохраненный шаблон, достаем текст по порядку и заменяем в области
	Если ЗначениеЗаполнено(АдресШаблоновОбщихОбластейВоХранилище) И ЗначениеЗаполнено(ИмяТекущегоШаблона) Тогда
		
		Попытка
			
		// Получаем соответствие текстов областей для текущего шаблона
		ТекстыОбластей = ПолучитьШаблоныОбщихОбластей(АдресШаблоновОбщихОбластейВоХранилище, ИмяТекущегоШаблона);
		
		Если ТекстыОбластей <> Неопределено Тогда
			
			// Получаем таблицу значений из соответствия
			ТаблицаТекстовОбластей = ТекстыОбластей.Получить("ТаблицаТекстовОбластей");
			
			// Обратная совместимость: если это не таблица значений, используем старый формат
			Если ТипЗнч(ТаблицаТекстовОбластей) <> Тип("ТаблицаЗначений") Тогда
				// Старый формат - используем соответствие с массивами
				МассивТекстовОбласти = ТекстыОбластей.Получить(ИмяОбласти);
				Если МассивТекстовОбласти <> Неопределено Тогда
					Если СчетчикиОбластей.Получить(ИмяОбласти) = Неопределено Тогда
						СчетчикиОбластей.Вставить(ИмяОбласти, 0);
					КонецЕсли;
					ТекущийИндекс = СчетчикиОбластей.Получить(ИмяОбласти);
					Если ТипЗнч(МассивТекстовОбласти) = Тип("Массив") Тогда
						Если ТекущийИндекс < МассивТекстовОбласти.Количество() Тогда
							ТекстОбласти = МассивТекстовОбласти[ТекущийИндекс];
							СчетчикиОбластей.Вставить(ИмяОбласти, ТекущийИндекс + 1);
						Иначе
							Если МассивТекстовОбласти.Количество() > 0 Тогда
								ТекстОбласти = МассивТекстовОбласти[МассивТекстовОбласти.Количество() - 1];
							Иначе
								ТекстОбласти = "";
							КонецЕсли;
						КонецЕсли;
					Иначе
						ТекстОбласти = МассивТекстовОбласти;
					КонецЕсли;
				Иначе
					ТекстОбласти = "";
				КонецЕсли;
			Иначе
				// Новый формат - используем таблицу значений
				// Определяем текущий индекс для этой области
				Если СчетчикиОбластей.Получить(ИмяОбласти) = Неопределено Тогда
					СчетчикиОбластей.Вставить(ИмяОбласти, 0);
				КонецЕсли;
				
				ПорядковыйНомер = СчетчикиОбластей.Получить(ИмяОбласти);
				
				// Ищем строку в таблице по имени области и порядковому номеру
				ТекстОбласти = "";
				ПоследняяСтрокаДляОбласти = Неопределено;
				
				Для Каждого СтрокаТаблицы Из ТаблицаТекстовОбластей Цикл
					Если СтрокаТаблицы.ИмяОбласти = ИмяОбласти Тогда
						ПоследняяСтрокаДляОбласти = СтрокаТаблицы;
						Если СтрокаТаблицы.ПорядковыйНомер = ПорядковыйНомер Тогда
							ТекстОбласти = СтрокаТаблицы.ТекстОбласти;
							// Увеличиваем счетчик для следующего вызова
							СчетчикиОбластей.Вставить(ИмяОбласти, ПорядковыйНомер + 1);
							Прервать;
						КонецЕсли;
					КонецЕсли;
				КонецЦикла;
				
				// Если не нашли строку с нужным порядковым номером, используем последнюю для этой области
				Если ПустаяСтрока(ТекстОбласти) И ПоследняяСтрокаДляОбласти <> Неопределено Тогда
					ТекстОбласти = ПоследняяСтрокаДляОбласти.ТекстОбласти;
				КонецЕсли;
			КонецЕсли;
			
			// Применяем текст к области (общий блок для обоих форматов)
			Если ЗначениеЗаполнено(ТекстОбласти) Тогда
				
					// Заменяем текст в области, сохраняя параметры
					// Парсим текст и заполняем ячейки вручную
					// НЕ очищаем область, чтобы сохранить параметры
					
					// Разбиваем текст на строки
					МассивСтрок = СтрРазделить(ТекстОбласти, Символы.ПС, Ложь);
					
					Для НомерСтроки = 0 По МассивСтрок.Количество() - 1 Цикл
						СтрокаТекста = МассивСтрок[НомерСтроки];
						
						// Разбиваем строку на колонки по символу табуляции
						МассивКолонок = СтрРазделить(СтрокаТекста, Символы.Таб, Ложь);
						
						Для НомерКолонки = 0 По МассивКолонок.Количество() - 1 Цикл
							Попытка
								// Получаем область одной ячейки по адресу в формате "R1C1"
								// Номера строк и колонок в адресе начинаются с 1
								АдресЯчейки = "R" + Формат(НомерСтроки + 1, "ЧГ=") + "C" + Формат(НомерКолонки + 1, "ЧГ=");
								ЯчейкаОбласти = Область.Область(АдресЯчейки);
								Если ЯчейкаОбласти <> Неопределено Тогда
									ЯчейкаОбласти.Текст = МассивКолонок[НомерКолонки];
								КонецЕсли;
							Исключение
								// Пропускаем ячейку, если не удалось установить
							КонецПопытки;
						КонецЦикла;
					КонецЦикла;
					
					// Формируем строку для логирования
					СтрокаИндекса = "";
					Попытка
						Если ТипЗнч(ТаблицаТекстовОбластей) = Тип("ТаблицаЗначений") Тогда
							СтрокаИндекса = " (порядковый номер: " + Формат(ПорядковыйНомер, "ЧГ=") + ")";
						ИначеЕсли ТипЗнч(МассивТекстовОбласти) = Тип("Массив") Тогда
							СтрокаИндекса = " (индекс: " + Формат(ТекущийИндекс, "ЧГ=") + ")";
				КонецЕсли;
					Исключение
						// Если переменные не определены, просто не добавляем индекс
					КонецПопытки;
					
					ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Информация, , , 
						"Заменен текст области: " + ИмяОбласти + СтрокаИндекса +
						". Длина текста: " + Формат(СтрДлина(ТекстОбласти), "ЧГ=") + 
						". Строк: " + Формат(МассивСтрок.Количество(), "ЧГ="));
				
			КонецЕсли; // Если ЗначениеЗаполнено(ТекстОбласти)
			
		КонецЕсли; // Если ТекстыОбластей <> Неопределено
			
		Исключение
			
		// Если ошибка при работе с шаблоном, используем область из макета
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при получении текста области из сохраненного шаблона. Имя области: " + ИмяОбласти + ". Ошибка: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Область;
	
КонецФункции //HD-

#КонецОбласти

//HD+
// Проверяет наличие подчеркиваний в тексте (любой длины)
// Параметры:
//  Текст - Строка - текст для проверки
// Возвращает:
//  Булево - Истина, если в тексте есть подчеркивания
//
Функция ЕстьПодчеркиванияВТексте(Текст)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	// Ищем хотя бы одно подчеркивание (любой длины)
	// Достаточно проверить наличие символа "_" в тексте
	Возврат СтрНайти(Текст, "_") > 0;
	
КонецФункции //HD-

//HD+
// Формирует строку с правоустанавливающими документами для физического лица по лицевому счёту (квартире).
// При пустых Номер/Дата/Вид/Организация берётся лб_Архив; иначе — реквизиты документа.
// Если у проживающего документов нет — берутся документы ответственного лица того же лицевого счёта.
// Параметры:
//  Проживающий - СправочникСсылка.бит_Проживающие - ссылка на физическое лицо
//  ЛицевойСчет - СправочникСсылка.бит_ЛицевыеСчета - лицевой счёт участника (основной отбор)
// Возвращает:
//  Строка - строка с перечислением документов через "; "
//
Функция ПолучитьПравоустанавливающиеДокументыСтрокой(Проживающий, ЛицевойСчет = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(Проживающий) И НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Возврат "";
	КонецЕсли;
	
	ТекстДокументов = ПолучитьПравоустанавливающиеДокументыСтрокойПоОтбору(Проживающий, ЛицевойСчет);
	
	// Если у проживающего документов нет — подтягиваем документы ответственного лица по этому ЛС
	Если НЕ ЗначениеЗаполнено(ТекстДокументов)
		И ЗначениеЗаполнено(ЛицевойСчет)
		И ЗначениеЗаполнено(Проживающий) Тогда
		
		ОтветственноеЛицо = ПолучитьОтветственноеЛицоПоЛицевомуСчету(ЛицевойСчет);
		Если ЗначениеЗаполнено(ОтветственноеЛицо)
			И ТипЗнч(ОтветственноеЛицо) = Тип("СправочникСсылка.бит_Проживающие")
			И ОтветственноеЛицо <> Проживающий Тогда
			
			ТекстДокументов = ПолучитьПравоустанавливающиеДокументыСтрокойПоОтбору(ОтветственноеЛицо, ЛицевойСчет);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ТекстДокументов;
	
КонецФункции //HD-

//HD+
// Выполняет отбор правоустанавливающих документов по проживающему и/или лицевому счёту
// и формирует строку представления.
//
Функция ПолучитьПравоустанавливающиеДокументыСтрокойПоОтбору(Проживающий, ЛицевойСчет)
	
	Запрос = Новый Запрос;
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	бит_ПравоустанавливающиеДокументы.Ссылка КАК ПравоустанавливающийДокумент,
	|	бит_ПравоустанавливающиеДокументы.Наименование КАК Наименование,
	|	бит_ПравоустанавливающиеДокументы.НомерДокумента КАК НомерДокумента,
	|	бит_ПравоустанавливающиеДокументы.ДатаДокумента КАК ДатаДокумента,
	|	бит_ПравоустанавливающиеДокументы.ВидДокумента КАК ВидДокумента,
	|	бит_ПравоустанавливающиеДокументы.ОрганизацияВыдавшаяДокумент КАК ОрганизацияВыдавшаяДокумент,
	|	бит_ПравоустанавливающиеДокументы.лб_Архив КАК лб_Архив,
	|	бит_ПравоустанавливающиеДокументы.лб_ИспользоватьАрхивДляФЛС КАК лб_ИспользоватьАрхивДляФЛС
	|ИЗ
	|	Справочник.бит_ПравоустанавливающиеДокументы КАК бит_ПравоустанавливающиеДокументы
	|ГДЕ
	|	НЕ бит_ПравоустанавливающиеДокументы.ПометкаУдаления
	|	И бит_ПравоустанавливающиеДокументы.бит_Архивный = ЛОЖЬ";
	
	Если ЗначениеЗаполнено(ЛицевойСчет) И ЗначениеЗаполнено(Проживающий) Тогда
		ТекстЗапроса = ТекстЗапроса + "
	|	И бит_ПравоустанавливающиеДокументы.бит_ЛицевойСчет = &ЛицевойСчет
	|	И (бит_ПравоустанавливающиеДокументы.бит_Проживающий = &Проживающий
	|		ИЛИ бит_ПравоустанавливающиеДокументы.бит_Проживающий = ЗНАЧЕНИЕ(Справочник.бит_Проживающие.ПустаяСсылка))";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
		Запрос.УстановитьПараметр("Проживающий", Проживающий);
	ИначеЕсли ЗначениеЗаполнено(ЛицевойСчет) Тогда
		ТекстЗапроса = ТекстЗапроса + "
	|	И бит_ПравоустанавливающиеДокументы.бит_ЛицевойСчет = &ЛицевойСчет";
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Иначе
		ТекстЗапроса = ТекстЗапроса + "
	|	И бит_ПравоустанавливающиеДокументы.бит_Проживающий = &Проживающий";
		Запрос.УстановитьПараметр("Проживающий", Проживающий);
	КонецЕсли;
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	//HD+ Если среди документов есть «Ордер» — информацию о правоустанавливающих документах не выводим
	Для Каждого Строка Из Результат Цикл
		Если ПравоустанавливающийДокументСодержитОрдер(Строка) Тогда
			Возврат "";
		КонецЕсли;
	КонецЦикла;
	//HD-
	
	МассивДокументов = Новый Массив;
	
	Для Каждого Строка Из Результат Цикл
		
		ТекстДокумента = СформироватьТекстПравоустанавливающегоДокумента(Строка);
		Если ЗначениеЗаполнено(ТекстДокумента) Тогда
			МассивДокументов.Добавить(ТекстДокумента);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СтрСоединить(МассивДокументов, "; ");
	
КонецФункции //HD-

//HD+
// Признак того, что правоустанавливающий документ является ордером (слово «Ордер» в реквизитах).
// В этом случае сведения о правоустанавливающих документах пользователю не выводятся.
//
Функция ПравоустанавливающийДокументСодержитОрдер(СтрокаДокумента)
	
	МаркерОрдера = ВРег("Ордер");
	
	ПоляДляПроверки = Новый Массив;
	ПоляДляПроверки.Добавить(Строка(СтрокаДокумента.Наименование));
	ПоляДляПроверки.Добавить(Строка(СтрокаДокумента.ВидДокумента));
	ПоляДляПроверки.Добавить(Строка(СтрокаДокумента.лб_Архив));
	ПоляДляПроверки.Добавить(Строка(СтрокаДокумента.НомерДокумента));
	ПоляДляПроверки.Добавить(Строка(СтрокаДокумента.ОрганизацияВыдавшаяДокумент));
	
	Если ЗначениеЗаполнено(СтрокаДокумента.ПравоустанавливающийДокумент) Тогда
		ПоляДляПроверки.Добавить(Строка(СтрокаДокумента.ПравоустанавливающийДокумент));
	КонецЕсли;
	
	Для Каждого ТекстПоля Из ПоляДляПроверки Цикл
		Если СтрНайти(ВРег(СокрЛП(ТекстПоля)), МаркерОрдера) > 0 Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции //HD-

//HD+
// Возвращает ответственное лицо по лицевому счёту из регистра бит_ПроживающиеПоЛС
// (степень родства бит_ОтветственноеЛицо).
// Параметры:
//  ЛицевойСчет - СправочникСсылка.бит_ЛицевыеСчета
// Возвращает:
//  СправочникСсылка.бит_Проживающие
//
Функция ПолучитьОтветственноеЛицоПоЛицевомуСчету(ЛицевойСчет)
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Возврат Справочники.бит_Проживающие.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизЛицо";
	
	Запрос.УстановитьПараметр("Момент", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.ФизЛицо) Тогда
		Возврат Выборка.ФизЛицо;
	КонецЕсли;
	
	Возврат Справочники.бит_Проживающие.ПустаяСсылка();
	
КонецФункции //HD-

//HD+
// Формирует текст одного правоустанавливающего документа для подстановки в документ собрания.
// Если заполнен флаг лб_ИспользоватьАрхивДляФЛС — берётся лб_Архив.
// Если не заполнены НомерДокумента, ДатаДокумента, ВидДокумента и ОрганизацияВыдавшаяДокумент —
// берётся лб_Архив (полное описание), а не обрезанное Наименование.
//
Функция СформироватьТекстПравоустанавливающегоДокумента(СтрокаДокумента)
	
	Если СтрокаДокумента.лб_ИспользоватьАрхивДляФЛС Тогда
		Возврат СокрЛП(Строка(СтрокаДокумента.лб_Архив));
	КонецЕсли;
	
	ЕстьРеквизитыДокумента = ЗначениеЗаполнено(СтрокаДокумента.НомерДокумента)
		ИЛИ ЗначениеЗаполнено(СтрокаДокумента.ДатаДокумента)
		ИЛИ ЗначениеЗаполнено(СтрокаДокумента.ВидДокумента)
		ИЛИ ЗначениеЗаполнено(СтрокаДокумента.ОрганизацияВыдавшаяДокумент);
	
	// Реквизиты пустые — полный текст из архива (Наименование ограничено 100 символами)
	Если НЕ ЕстьРеквизитыДокумента Тогда
		
		ТекстАрхива = СокрЛП(Строка(СтрокаДокумента.лб_Архив));
		Если ЗначениеЗаполнено(ТекстАрхива) Тогда
			Возврат ТекстАрхива;
		КонецЕсли;
		
		НаименованиеДокумента = СокрЛП(Строка(СтрокаДокумента.Наименование));
		Если ЗначениеЗаполнено(НаименованиеДокумента) Тогда
			Возврат НаименованиеДокумента;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(СтрокаДокумента.ПравоустанавливающийДокумент) Тогда
			Возврат СокрЛП(Строка(СтрокаДокумента.ПравоустанавливающийДокумент));
		КонецЕсли;
		
		Возврат "";
		
	КонецЕсли;
	
	ЧастиТекста = Новый Массив;
	
	ВидДокумента = СокрЛП(Строка(СтрокаДокумента.ВидДокумента));
	Если ЗначениеЗаполнено(ВидДокумента) Тогда
		ЧастиТекста.Добавить(ВидДокумента);
	Иначе
		НаименованиеДокумента = СокрЛП(Строка(СтрокаДокумента.Наименование));
		Если ЗначениеЗаполнено(НаименованиеДокумента) Тогда
			ЧастиТекста.Добавить(НаименованиеДокумента);
		КонецЕсли;
	КонецЕсли;
	
	НомерДокумента = СокрЛП(Строка(СтрокаДокумента.НомерДокумента));
	Если ЗначениеЗаполнено(НомерДокумента) Тогда
		ЧастиТекста.Добавить(НомерДокумента);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаДокумента.ДатаДокумента) Тогда
		ЧастиТекста.Добавить("от " + Формат(СтрокаДокумента.ДатаДокумента, "ДЛФ=Д") + " г.");
	КонецЕсли;
	
	ОрганизацияВыдавшаяДокумент = СокрЛП(Строка(СтрокаДокумента.ОрганизацияВыдавшаяДокумент));
	Если ЗначениеЗаполнено(ОрганизацияВыдавшаяДокумент) Тогда
		ЧастиТекста.Добавить(ОрганизацияВыдавшаяДокумент);
	КонецЕсли;
	
	Возврат СокрЛП(СтрСоединить(ЧастиТекста, " "));
	
КонецФункции //HD-

//HD+
// Сохраняет шаблоны текста в структуре для защиты от изменений
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент - табличный документ для обработки
// Возвращает:
//  Соответствие - структура с ключом "Строка_Колонка" и значением - шаблон текста
//
Функция СохранитьШаблоныТекста(ТабличныйДокумент) Экспорт
	
	ШаблоныТекста = Новый Соответствие;
	
	// Проходим по всем ячейкам табличного документа
	Для НомерСтроки = 0 По ТабличныйДокумент.ВысотаТаблицы - 1 Цикл
		
		Для НомерКолонки = 0 По ТабличныйДокумент.ШиринаТаблицы - 1 Цикл
			
			Попытка
				
				Ячейка = ТабличныйДокумент.Область(НомерСтроки, НомерКолонки, НомерСтроки, НомерКолонки);
				
				ТекстЯчейки = Ячейка.Текст;
				
				// Сохраняем шаблон текста для всех ячеек с текстом
				// Ячейки с подчеркиваниями будут частично редактируемыми,
				// ячейки без подчеркиваний будут полностью заблокированы
				Если ЗначениеЗаполнено(ТекстЯчейки) Тогда
					
					// Сохраняем шаблон текста в структуре
					// Ключ: "Строка_Колонка", Значение: шаблон текста
					КлючЯчейки = Формат(НомерСтроки, "ЧГ=") + "_" + Формат(НомерКолонки, "ЧГ=");
					ШаблоныТекста.Вставить(КлючЯчейки, ТекстЯчейки);
					
				КонецЕсли;
				
			Исключение
				// Ячейка не существует или недоступна - пропускаем
			КонецПопытки;
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ШаблоныТекста;
	
КонецФункции //HD-

#КонецЕсли
