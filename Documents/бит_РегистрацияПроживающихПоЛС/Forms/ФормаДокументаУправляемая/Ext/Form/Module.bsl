&НаКлиенте
Процедура СписокПроживающихВладелецКвартирыПриИзменении(Элемент)
	
	ТекДанные = Элементы.СписокПроживающих.ТекущиеДанные;
	
	Если ТекДанные.ВладелецКвартиры = ПредопределенноеЗначение("Перечисление.ДаНет.Нет") Тогда
		
		ТекДанные.ДоляПлощади = 0;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПроживающихДоляПлощадиПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокПроживающих.ТекущиеДанные;
	
	СуммаДолей = РассчитатьСуммуДолейНаСервере(ТекущиеДанные.Физлицо, ТекущиеДанные.ДоляПлощади); 
	
	Если СуммаДолей > 1 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Суммарная доля площади превышает максимальную (1) на " + Строка(СуммаДолей - 1) + ". Посмотрите список долей, нажав кнопку с рисунком ""Список проживающих и их доли площади"".");
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПроживающихДатаРегистрацииПриИзменении(Элемент)
	
	Если НачислениеСУчетомДнейПроживания Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	ТекДанные = Элементы.СписокПроживающих.ТекущиеДанные;
	
	Ответ = ПолучитьСтруктуруРегистрации(КонецМесяца(Объект.Дата), Объект.ЛицевойСчет, ТекДанные.ФизЛицо, ТекДанные.ДатаРегистрации, ТекДанные.ДатаРегистрации);
	
	Если Ответ Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Дата регистрации "+ ТекДанные.ФизЛицо+" входит в прошлый период регистрации.");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПричинуИСтатусВыписки() 
	Возврат Новый Структура("Статус, Причина", Справочники.бит_СтатусФизЛица.НайтиПоКоду("00-000002"), Справочники.бит_ПричиныВыписки.НайтиПоКоду(00-000005));
КонецФункции

&НаКлиенте
Процедура СписокПроживающихДатаСнятияСРегистрацииПриИзменении(Элемент)
	
	ТекСтрока = Элементы.СписокПроживающих.ТекущиеДанные;
	ПричинаИСтатусВыписки = ПолучитьПричинуИСтатусВыписки();
	// БИТ_ЖКХ 23.09.2014
	Если ЗначениеЗаполнено(ТекСтрока.ДатаСнятияСРегистрации) Тогда
		
		ТекСтрока.ПричинаВыписки = ПричинаИСтатусВыписки.Причина;
		
	КонецЕсли;
	// БИТ_ЖКХ 23.09.2014
	
	// БИТ_ЖКХ 19.09.2014
	Если ЗначениеЗаполнено(ТекСтрока.ДатаСнятияСРегистрации) И НачалоДня(ТекСтрока.ДатаСнятияСРегистрации) <= НачалоДня(Объект.Дата) Тогда
		
		Если ЗначениеЗаполнено(ТекСтрока.ДатаСнятияСРегистрации) И НачалоДня(ТекСтрока.ДатаСнятияСРегистрации) <= НачалоДня(ТекущаяДата()) Тогда
			
			ТекСтрока.СтатусФизЛица = ПричинаИСтатусВыписки.Статус;
			
			#Если Клиент Тогда
				
				ПоказатьПредупреждение(Новый ОписаниеОповещения("СписокПроживающихДатаСнятияСРегистрацииПриИзмененииЗавершение1", ЭтотОбъект), "Статус физ лица " + ТекСтрока.ФизЛицо + " изменен на ""Удален с лицевого счета""!",,"Изменен статус физ лица");
				
			#КонецЕсли 
			
		КонецЕсли;
		// БИТ_ЖКХ 19.09.2014
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекСтрока.ДатаСнятияСРегистрации) ИЛИ (ТекСтрока.ДатаСнятияСРегистрации >= ТекущаяДата()
		И ТекСтрока.СтатусФизЛица = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан")) Тогда
		
		ТекСтрока.СтатусФизЛица = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.ПустаяСсылка");
		
		#Если Клиент Тогда
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("СписокПроживающихДатаСнятияСРегистрацииПриИзмененииЗавершение", ЭтотОбъект), "Заполните статус физ лица : " + ТекСтрока.ФизЛицо + "!",,"Изменен статус физ лица");
			
		#КонецЕсли  
		
	КонецЕсли;
	
КонецПроцедуры

