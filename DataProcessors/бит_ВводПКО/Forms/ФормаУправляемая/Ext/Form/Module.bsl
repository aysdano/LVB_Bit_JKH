&НаСервере
Процедура ПровестиДеревоПКОНаСервере(ПрименениеУСН, СуммаПринимаемых)
	
	ДеревоПКОМ = РеквизитФормыВЗначение("ДеревоПКО");
	
	
	Для каждого ПервыйУровень Из ДеревоПКОМ.Строки Цикл
		
		Для каждого ВторойУровень Из ПервыйУровень.Строки Цикл
			
			Если ВторойУровень.Выбор Тогда
				
				ПолучитьИЗаписатьПриходныйКассовыйОрдерНаСервере(ВторойУровень.ПриходныйКассовыйОредер, ПрименениеУСН, СуммаПринимаемых);
				
				Если ВторойУровень.ПриходныйКассовыйОредер.ПометкаУдаления Тогда
					
					ВторойУровень.НомерКартинки = 1;
					
				ИначеЕсли ВторойУровень.ПриходныйКассовыйОредер.Проведен Тогда
					
					ВторойУровень.НомерКартинки = 0;
				Иначе 
					ВторойУровень.НомерКартинки = 2;
				КонецЕсли;	
				
				Для каждого ТретийУровень Из ВторойУровень.Строки Цикл
					
					Если ТретийУровень.Выбор Тогда
						ПолучитьИЗаписатьПриходныйКассовыйОрдерНаСервере(ТретийУровень.ПриходныйКассовыйОредер, ПрименениеУСН, СуммаПринимаемых);
						
						Если ТретийУровень.ПриходныйКассовыйОредер.ПометкаУдаления Тогда
							
							ТретийУровень.НомерКартинки = 1;
							
						ИначеЕсли ТретийУровень.ПриходныйКассовыйОредер.Проведен Тогда
							
							ТретийУровень.НомерКартинки = 0;
						Иначе 
							ТретийУровень.НомерКартинки = 2;
						КонецЕсли;	
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоПКОМ, "ДеревоПКО");
	
КонецПроцедуры

