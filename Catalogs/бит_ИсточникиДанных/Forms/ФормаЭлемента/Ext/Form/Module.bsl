
#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.НаименованиеПолное) Тогда
		
		Объект.НаименованиеПолное = Объект.Наименование;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СчетПриИзменении(Элемент)
	
	ПриИзмененииСчетаНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура СчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Объект.Счет Тогда
		СтандартнаяОбработка = Ложь;
	ИначеЕсли ЗначениеЗаполнено(Объект.Счет) Тогда
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПолеСуммыПриИзменении(Элемент)
	
	Если Элементы.ПолеСуммы.СписокВыбора.НайтиПоЗначению(Объект.ПолеСуммы) = Неопределено Тогда
		
		Объект.ПолеСуммы = "";

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Неверно указанно поле суммы");
		
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	бит_ЗакрытыйСлужебныйСервер.ПроверитьВозможностьРаботы(Отказ, Истина);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли;
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	Если ЗначениеЗаполнено(Объект.Счет) Тогда
		
		ИнициализироватьНастройкиКомпановщика(Истина);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	СтркутураНастроек = Новый Структура("КомпоновщикНастроек", КомпоновщикНастроек.ПолучитьНастройки());
	ТекущийОбъект.СохранитьНастройки(СтркутураНастроек);
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	ПоляОтчета = Новый Структура("Счет,
	|Период,
	|Регистратор,
	|Субконто1,
	|Субконто2,
	|Субконто3,
	|КорСчет,
	|КорСубконто1,
	|КорСубконто2,
	|КорСубконто3,
	|Подразделение,
	|ПодразделениеКор,
	|Валюта,
	|ВалютаКор,
	|СуммаОборот,
	|СуммаОборотДт,
	|СуммаОборотКт");
	
	КэшированныеЗначения.Вставить("ПоляОтчета", ПоляОтчета);
	
	РесурсыОтчета = Новый Структура("СуммаОборот,
	|СуммаОборотДт,
	|СуммаОборотКт");
	
	КэшированныеЗначения.Вставить("РесурсыОтчета", РесурсыОтчета);
	
	ОбязательныеПоля = Новый Массив();
	ОбязательныеПоля.Добавить("СтатьяОборотов");
	ОбязательныеПоля.Добавить("Счет");
	ОбязательныеПоля.Добавить("Период");
	ОбязательныеПоля.Добавить("Регистратор");
	ОбязательныеПоля.Добавить("Субконто1");
	ОбязательныеПоля.Добавить("Субконто2");
	ОбязательныеПоля.Добавить("Субконто3");
	ОбязательныеПоля.Добавить("Подразделение");
	ОбязательныеПоля.Добавить("СуммаОборот");
	ОбязательныеПоля.Добавить("СуммаОборотДт");
	ОбязательныеПоля.Добавить("СуммаОборотКт");
	
	КэшированныеЗначения.Вставить("ОбязательныеПоля", ОбязательныеПоля);
	
	ПоляОграниченияУсловия = Новый Массив();
	ПоляОграниченияУсловия.Добавить("Счет");
	ПоляОграниченияУсловия.Добавить("Валюта");
	ПоляОграниченияУсловия.Добавить("ВалютаКор");
	ПоляОграниченияУсловия.Добавить("Организация");
	ПоляОграниченияУсловия.Добавить("СуммаОборот");
	ПоляОграниченияУсловия.Добавить("СуммаОборотКТ");
	ПоляОграниченияУсловия.Добавить("СуммаОборотДт");
	
	КэшированныеЗначения.Вставить("ПоляОграниченияУсловия", ПоляОграниченияУсловия);
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

&НаСервере
Функция СформироватьТекстЗапроса()
	
	СтрокаСубконтоСЗ  = Объект.Счет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтатьиЗатрат            , "ВидСубконто");
	СтрокаСубконтоНГ  = Объект.Счет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.НоменклатурныеГруппы    , "ВидСубконто");
	СтрокаСубконтоНЦС = Объект.Счет.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.НазначениеЦелевыхСредств, "ВидСубконто");
	
	НомерСубкното = "";
	Источник      = "";
	
	Если СтрокаСубконтоСЗ = Неопределено  тогда
		
		Если СтрокаСубконтоНГ = Неопределено  Тогда 
			
			Если НЕ СтрокаСубконтоНЦС = Неопределено Тогда 
				
