&НаСервере
Функция РасчетГоспошлины()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СведенияОРазмерахГоспошлиныСрезПоследних.Период КАК Период,
	|	СведенияОРазмерахГоспошлиныСрезПоследних.НачальнаяСуммаДолга КАК НачальнаяСуммаДолга,
	|	СведенияОРазмерахГоспошлиныСрезПоследних.КонечнаяСуммаДолга КАК КонечнаяСуммаДолга,
	|	СведенияОРазмерахГоспошлиныСрезПоследних.ПроцентПошлины/100 КАК Процент,
	|	СведенияОРазмерахГоспошлиныСрезПоследних.ФиксированнаяЧастьПошлины КАК ФиксированнаяЧастьПошлины,
	|	СведенияОРазмерахГоспошлиныСрезПоследних.МинимальныйРазмерПошлины КАК МинимальныйРазмерПошлины,
	|	СведенияОРазмерахГоспошлиныСрезПоследних.МаксимальныйРазмерПошлины КАК МаксимальныйРазмерПошлины
	|ИЗ
	|	РегистрСведений.СведенияОРазмерахГоспошлины.СрезПоследних(&Период, ТипДокумента = &ТипДокумента) КАК СведенияОРазмерахГоспошлиныСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	НачальнаяСуммаДолга";
	
	Запрос.УстановитьПараметр("Период", Объект.Дата);
	Запрос.УстановитьПараметр("ТипДокумента", Объект.ТипДокумента);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

