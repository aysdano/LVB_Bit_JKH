			ТаблИсхЛС.Сортировать("Жилец,ДатаПрописки");
			
			
			
			
			ЧислоСтрок = ТаблИсхЛС.Количество();
			Если Выборка.TAR = 0 тогда
				//Выбираем только ответственного и ставим ему "Ответственный не проживает"
				//без указания прописки и выписки
				
