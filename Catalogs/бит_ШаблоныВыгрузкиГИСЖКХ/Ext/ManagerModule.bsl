// Функция возвращает последний загруженный пользователем макет Excel для платежных документов.
// У каждого юр. лица свой уникальный макет платежных документов.
// Пользователь должен выполнять обновление макета платежных документов самостоятельно.
Функция ПолучитьПредыдущийМакетСтраницыПД();
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ШаблоныВыгрузкиГИСЖКХ.Ссылка КАК Ссылка,
	|	бит_ШаблоныВыгрузкиГИСЖКХ.МакетСтраницы КАК МакетСтраницы
	|ИЗ
	|	Справочник.бит_ШаблоныВыгрузкиГИСЖКХ КАК бит_ШаблоныВыгрузкиГИСЖКХ
	|ГДЕ
	|	бит_ШаблоныВыгрузкиГИСЖКХ.ИмяМакета = ""МакетПД""
	|	И бит_ШаблоныВыгрузкиГИСЖКХ.Наименование = ""Шаблон импорт платежных документов""
	|	И НЕ бит_ШаблоныВыгрузкиГИСЖКХ.ПометкаУдаления
	|	И НЕ бит_ШаблоныВыгрузкиГИСЖКХ.ПользовательскийШаблон
	|
	|УПОРЯДОЧИТЬ ПО
	|	бит_ШаблоныВыгрузкиГИСЖКХ.Код УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Попытка
			ДвДанные = Выборка.МакетСтраницы.Получить();
			Возврат ДвДанные;
		Исключение
			Возврат Неопределено
		КонецПопытки;
	Иначе	
		Возврат Неопределено;
	КонецЕсли;
	
КонецФункции

