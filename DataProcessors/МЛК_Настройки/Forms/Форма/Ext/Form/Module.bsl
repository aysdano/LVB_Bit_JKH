// Мобильные личные кабинеты


&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Если Не ЗначениеКонстанты() Тогда
		Элементы.СправочникНастроек.Видимость = Ложь;
	Иначе
		Объект.ИспользоватьИнтеграциюСМобильнымиЛичнымиКабинетами = Истина;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьИнтеграциюСМобильнымиЛичнымиКабинетамиПриИзменении(Элемент)
	Если Не Объект.ИспользоватьИнтеграциюСМобильнымиЛичнымиКабинетами Тогда
		Элементы.СправочникНастроек.Видимость = Ложь;
		УстановитьЗначениеКонстанты(Ложь);
	Иначе
		УстановитьЗначениеКонстанты(Истина);
		Элементы.СправочникНастроек.Видимость = Истина;
		ОтправитьЗапросНаСозданиеМобильныхЛичныхКабинетов();
	КонецЕсли;	
КонецПроцедуры

Процедура ОтправитьЗапросНаСозданиеМобильныхЛичныхКабинетов()
	Выб = Справочники.МЛК_Настройки.Выбрать();
	Пока Выб.Следующий() Цикл
		 //Сообщить(ЗначениеВСтрокуВнутр(Выб.Организация));   Идентификатор организации
	КонецЦикла;	
КонецПроцедуры	

Процедура УстановитьЗначениеКонстанты(Значение)
	 Константы.МЛК_ИспользоватьИнтеграциюСМобильнымиЛичнымиКабинетами.Установить(Значение);
КонецПроцедуры	

Функция ЗначениеКонстанты()
	возврат Константы.МЛК_ИспользоватьИнтеграциюСМобильнымиЛичнымиКабинетами.Получить();
КонецФункции


