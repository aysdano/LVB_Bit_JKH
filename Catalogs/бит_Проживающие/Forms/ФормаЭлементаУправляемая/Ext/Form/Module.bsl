	|	бит_СвидетельстваОСмерти.ФизЛицо = &ФизЛицо";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(мНаборЗаписейСвидетельстваОСмерти.Добавить(), Выборка);
		
	КонецЕсли; 
	
	Запрос.Текст =
