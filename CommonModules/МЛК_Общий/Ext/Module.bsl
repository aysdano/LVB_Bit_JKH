#Область История_Оплат
Функция ОтправитьИсториюОплат()
	Если Не ПроверитьЕстьЛиИнтернетСоединение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл
		Если Настройки.НеИспользоватьИнтеграцию Тогда Продолжить; КонецЕсли;
		// 1. Лицевые счета
		Если НачалоДня(Настройки.ДатаПоследнейВыгрузкиПоОплатам) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Возврат Истина;
		КонецЕсли;
		
		ТаблицаЛС = ПолучитьТаблицуЛицевыхСчетов(Настройки);
		Если ЗначениеЗаполнено(Настройки.ДатаПоследнейВыгрузкиПоОплатам) Тогда
			ДатаС = Настройки.ДатаПоследнейВыгрузкиПоОплатам - (60*60*24*30);
		Иначе
			ДатаС = ТекущаяДатаСеанса() - (60*60*24*365);
		КонецЕсли;
		
		Если ОтправитьВСистемуИсториюОплат(Настройки,ТаблицаЛС,ДатаС) Тогда
			
			ОбъектНастройки = Настройки.ПолучитьОбъект();
			ОбъектНастройки.Прочитать();
			ОбъектНастройки.ДатаПоследнейВыгрузкиПоОплатам   = ТекущаяДатаСеанса();
			Попытка
				ОбъектНастройки.Записать();
			Исключение
			КонецПопытки;
			
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;	
	КонецЦикла;
	Возврат Ложь;
КонецФункции
Функция ОтправитьВСистемуИсториюОплат(Настройки,ТаблицаЛС,ДатаС)
	СтрокаСобытий = "";
	СтрокаПараметров="";	
	ТаблицаОплат = ПолучитьДанныеПоОплатам(ТаблицаЛС,ДатаС,ТекущаяДатаСеанса());
	Сч=0;
	Если ТаблицаОплат.Количество() = 0 Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого СтрЛС Из ТаблицаОплат Цикл
		ИдОбъекта = ПолучитьИДЛицевогоСчета(СтрЛС.ЛицевойСчет);
		Если ИдОбъекта = "" Тогда Продолжить; КонецЕсли;
		
		Если Найти(СтрЛС.Регистратор,"Оплата КУ")=0 Тогда Продолжить; КонецЕсли;
		
		ИдентификаторПлатежа = СтрЛС.Регистратор.УникальныйИдентификатор();
		ИдентификаторПлатежа = СтрЗаменить(ИдентификаторПлатежа,"-","");
		Запрос1="";
		Запрос1 = Запрос1 + """"+"PaymentDocNumber"+""""+":"+""""+ИдентификаторПлатежа+""""+","+
		""""+"ActionName"+""""+":"+""""+"Оплата"+""""+","+
		""""+"ObjectId"+""""+":"+""""+Строка(ИдОбъекта)+""""+","+
		""""+"НомерЛицевогоСчета"+""""+":"+""""+Строка(СтрЛС.ЛицевойСчет.Наименование)+"""";
		Запрос1 = "{"+Запрос1+"}"; 
		СтрокаПараметров = СтрокаПараметров + "&create"+Строка(Сч)+"="+Строка(Запрос1);
		
		Запрос2="";
