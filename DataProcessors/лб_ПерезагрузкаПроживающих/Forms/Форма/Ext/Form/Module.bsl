&НаСервере
Процедура ЗагрузитьКвартирыНаСервере()
	МассивСтру = ЗагрузитьДБФВМассивСтруктур();
	ЗаполнитьКэшЗданий();
	ЗаполнитьКэшКвартирЛицевыхСчетов();	
	СоздатьТаблицуДляРазделенныхКвартир();
	
	ЧислоКвартир = МассивСтру.ВГраница();	
	Для Инд = ЭтаФорма.СтартЗапись по ЧислоКвартир  цикл
 		Стру = МассивСтру[Инд];
		ЗагрузитьКвартируИзСтруктуры(Стру);
	КонецЦикла;	    	
КонецПроцедуры	


&НаСервере
Процедура ЗагрузитьКвартируИзСтруктуры(Стру)
		  
	ИмяЛС = сокрЛП(Стру.LS);
	Если СтрДлина(ИмяЛС)=10 или СтрДлина(ИмяЛС)=11 тогда
		ИмяЛС = лев(ИмяЛС,10)+ лб_Сервер.КонтрольныйРазряд(ИмяЛС);
	иначе
		сообщить("Неверный формат ЛС: "+ИмяЛС)
	КонецЕсли;	
	ИмяКвартиры = сокрЛП(Стру.KVARTIRA);  
	
	Если СтрДлина(ИмяЛС)<>11 тогда
		возврат
	КонецЕсли;	
	
	ИмяДома = сокрЛП(Стру.DOM);
	Если лев(ИмяЛС,3)="714" тогда
		ИмяДома = ИмяДома+".";
	КонецЕсли;	

	
	ЧислоРазделенныхЛС = стру.K_LS;
	Если ЧислоРазделенныхЛС>1 тогда
		ИмяКвартиры = ИмяКвартиры+ДополнениеИмениРазделеннойКвартиры(ИмяДома+","+ИмяКвартиры);
	КонецЕсли;	
	
	
	
	Если Стру.Свойство("POD") тогда
		НомерПодъезда = Стру.POD;		
	иначе                        		
		НомерПодъезда =1;		
	КонецЕсли;	
	
	ИмяПодъезда    = сокрЛП(НомерПодъезда);
	
	Этаж = ?(Стру.Свойство("ET"),Стру.ET,0);
	КоличествоКомнат = ?(Стру.Свойство("K_KOM"),стру.K_KOM,0);
	КадастровыйНомер = ?(Стру.Свойство("KAD_N"),стру.KAD_N,"");
	
	КвартираУникГИСЖКХ = "";
	КодПоБТИ = "";
	
	
	Если Стру.Свойство("ELS") тогда
		ЕЛСГИСЖКХ 				= СокрЛП(Стру.ELS);
		ИдентификаторЖКУ 		= СокрЛП(Стру.KOD_JKY);
	иначе
		ЕЛСГИСЖКХ = "";
		ИдентификаторЖКУ ="";
	КонецЕсли;	
		
	//КапРемЕЛСГИСЖКХ	 		= "";
	//КапРемИдентификаторЖКУ	= "";
	//КапРемПрефикс			= "";
	
	
	
	ОбъектКвартира  = неопределено;
	ОбъектЛС        = неопределено;
	ОбъектПодъезд   = неопределено;

	;
	
	
	ДанныеЛС = ДанныеЛС(ИмяЛС);	
	
	Если ДанныеЛС = неопределено тогда	
		Если ЭтаФорма.ИмяФайлаКл = "C:\1bit_Exchange\Бородина 41\ls_jil.dbf" тогда
			Здание = Справочники.бит_СписокЗданий.НайтиПоКоду("БОР41",истина);
		ИначеЕсли ИмяДома = "УЛ.ЭНЕРГЕТИКОВ,66 А" тогда
			Здание = Справочники.бит_СписокЗданий.НайтиПоКоду("Э66А",истина);      			
		ИначеЕсли ИмяДома = "УЛ.БЛЮХЕРА,22 КОРП.1"	и СтрНайти(ЭтаФорма.ИмяФайлаКл,"\ЛБ\")>0  тогда
			Здание = Справочники.бит_СписокЗданий.НайтиПоКоду("БЛ221",истина);      			
		иначе	
			Здание = ЗданиеИзКэша(ИмяДома);
		КонецЕсли;	
		Если не ЗначениеЗаполнено(Здание) тогда
			Сообщить(" Не найдено здание " + ИмяДома);
			возврат;
		КонецЕсли;	
		
		Подъезд = Справочники.бит_Подъезды.НайтиПоНаименованию(ИмяПодъезда,истина,,Здание);
		Если Не ЗначениеЗаполнено(Подъезд) тогда
			ПодъездОбъект = Справочники.бит_Подъезды.СоздатьЭлемент();
			ПодъездОбъект.Владелец = Здание; 			
			ПодъездОбъект.КоличествоЭтажей = Этаж;			
			ПодъездОбъект.Наименование = ИмяПодъезда;
			ПодъездОбъект.Записать();
			Подъезд = ПодъездОбъект.Ссылка;
		ИначеЕсли ПустаяСтрока(""+Подъезд) тогда
			ПодъездОбъект = Подъезд.ПолучитьОбъект();
			ПодъездОбъект.Наименование = ИмяПодъезда;
			ПодъездОбъект.Записать();
		КонецЕсли;	
		
		
		ИмяКвартиры = СокрЛП(ИмяКвартиры);
		СтруктураНомера = СтруктураНомераКвартиры(ИмяКвартиры);
		НаимКвартиры = ""+СтруктураНомера.НомерКвартиры + СтруктураНомера.ПрефиксКвартиры;
		Квартира = Справочники.бит_Квартиры.НайтиПоНаименованию(НаимКвартиры,Истина,,Здание);
		Если Не ЗначениеЗаполнено(Квартира) тогда
			ОбъектКвартира = Справочники.бит_Квартиры.СоздатьЭлемент();
			ОбъектКвартира.Наименование = НаимКвартиры;
			ОбъектКвартира.Владелец = Здание;
			ОбъектКвартира.Подъезд = Подъезд;
			ОбъектКвартира.Этаж  = Этаж;						
			ЗаполнитьЗначенияСвойств(ОбъектКвартира,СтруктураНомера);
			ОбъектКвартира.Записать();
			Квартира = ОбъектКвартира.Ссылка;
		КонецЕсли;	
	
		
		ЛС = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(ИмяЛС);
		Если Не ЗначениеЗаполнено(ЛС) тогда
			ОбъектЛС = Справочники.бит_ЛицевыеСчета.СоздатьЭлемент();
			ОбъектЛС.Наименование = ИмяЛС;
			ОбъектЛС.Здание = Здание;
			ОбъектЛС.Квартира = Квартира;
			ОбъектЛС.Организация = ЛС.Организация;
			ОбъектЛС.УлицаЛицевогоСчета = Здание.Улица;
			ОбъектЛС.Записать();			
			ЛС = ОбъектЛС.Ссылка;
		КонецЕсли;	
		
		
		ДанныеЛС = мКэшКвартирЛС.Добавить();
		ДанныеЛС.ЛС = ЛС;
		ДанныеЛС.ИмяЛС = ИмяЛС;
		ДанныеЛС.Здание = Здание;
		ДанныеЛС.Квартира = Квартира;
		ДанныеЛС.Подъезд = Подъезд;	
		ДанныеЛС.Улица = ЛС.УлицаЛицевогоСчета;	
		
	КонецЕсли;
	
	
	Если ОбъектПодъезд = Неопределено тогда
		ОбъектПодъезд = ДанныеЛС.Подъезд.ПолучитьОбъект();		
	КонецЕсли;
	Если ложь тогда ОбъектПодъезд = Справочники.бит_Подъезды.СоздатьЭлемент() КонецЕсли;
	ЗаменитьЕслиНовое(ОбъектПодъезд.Наименование,ИмяПодъезда);
	Если ОбъектПодъезд.КоличествоЭтажей < Этаж тогда
		ОбъектПодъезд.КоличествоЭтажей = Этаж
	КонецЕсли;	
	
	Если ТипЗнч(ОбъектПодъезд) = тип("СправочникОбъект.бит_Квартиры") и ОбъектПодъезд.Модифицированность() тогда
		ОбъектПодъезд.Записать();
	КонецЕсли;	
	
	
	
	// проверка и коррекция данных квартиры
	ЭтоНоваяКвартира = ложь;
	Если ОбъектКвартира = неопределено тогда
		ОбъектКвартира = ДанныеЛС.Квартира.ПолучитьОбъект();
		ЭтоНоваяКвартира = истина;
	КонецЕсли;	
	
	Если ложь тогда ОбъектКвартира = Справочники.бит_Квартиры.СоздатьЭлемент() КонецЕсли;
	
	Если ЭтоНоваяКвартира или не Объект.ТолькоНовыеОбъекты  тогда
		ЗаменитьЕслиНовое(ОбъектКвартира.Наименование,ИмяКвартиры);
		СтруктураНомера = СтруктураНомераКвартиры(ИмяКвартиры);
		ЗаменитьЕслиНовое(ОбъектКвартира.НомерКвартиры,СтруктураНомера.НомерКвартиры);
		ЗаменитьЕслиНовое(ОбъектКвартира.ПрефиксКвартиры,СтруктураНомера.ПрефиксКвартиры);
		ЗаменитьЕслиНовое(ОбъектКвартира.КоличествоКомнат,КоличествоКомнат);
		ЗаменитьЕслиНовое(ОбъектКвартира.КадастровыйНомер,КадастровыйНомер);
		ЗаменитьЕслиНовое(ОбъектКвартира.Подъезд,ДанныеЛС.Подъезд);
		ЗаменитьЕслиНовое(ОбъектКвартира.Владелец,ДанныеЛС.Здание);
		ЗаменитьЕслиНовое(ОбъектКвартира.НомерПодъезда,НомерПодъезда); 
	КонецЕсли;
	Если ТипЗнч(ОбъектКвартира)=тип("СправочникОбъект.бит_Квартиры") и  ОбъектКвартира.Модифицированность()=Истина тогда
		ОбъектКвартира.Записать();
	КонецЕсли;
	
	//Проверка и коррекция данных ЛС
	Если ОбъектЛС= неопределено тогда
		ОбъектЛС = ДанныеЛС.ЛС.ПолучитьОбъект();
	КонецЕсли;	
	Если ложь тогда ОбъектЛС = Справочники.бит_ЛицевыеСчета.СоздатьЭлемент() КонецЕсли;
	
	
	ЗаменитьЕслиНовое(ОбъектЛС.ЕЛСГИСЖКХ,ЕЛСГИСЖКХ);
	ЗаменитьЕслиНовое(ОбъектЛС.Здание,ДанныеЛС.Здание);
	ЗаменитьЕслиНовое(ОбъектЛС.ИдентификаторЖКУ,ИдентификаторЖКУ);
	ЗаменитьЕслиНовое(ОбъектЛС.Квартира,ДанныеЛС.Квартира);
	ЗаменитьЕслиНовое(ОбъектЛС.Организация,Объект.Организация);
	ЗаменитьЕслиНовое(ОбъектЛС.ТипЛицевогоСчетаГИСЖКХ,Перечисления.бит_ТипЛицевогоСчетаГИСЖКХ.ЛСУО);
	ЗаменитьЕслиНовое(ОбъектЛС.УлицаЛицевогоСчета,ДанныеЛС.Улица);
	
	
	Если ТипЗнч(ОбъектЛС)=тип("СправочникОбъект.бит_ЛицевыеСчета") и  ОбъектЛС.Модифицированность()=Истина тогда
		ОбъектЛС.Записать();
	КонецЕсли;
	
	
	//дапись данных квартиры в регистры
	
	ЗагрузитьПериодическиеРеквизитыКвартирыЛС(Стру,ДанныеЛС.Квартира,ДанныеЛС.ЛС);	
	
	
	
	
	
		

	
	                                                                  
	
КонецПроцедуры	                                           


&НаСервере
Процедура ЗагрузитьПериодическиеРеквизитыКвартирыЛС(Стру, Квартира, ЛС)
	Если Не ЗначениеЗаполнено(Квартира) 
		 		или не ЗначениеЗаполнено(ЛС) 
		 		или (ТипЗнч(Стру)<>Тип("Структура") и (ТипЗнч(Стру)<>Тип("СтрокаТаблицыЗначений"))) 
	тогда				
		возврат  		
	КонецЕсли;	
	                                     
	
	
	КодТипаКвартиры				= Стру.TIP;
	КодСтатусаКвартиры          = Стру.STATYS;
	ОбщаяПлощадь				= Стру.PL_OB;					  
	ЖилаяПлощадь				= Стру.PL_JIL;					  
//	МОП								  
//	ОтапливаемаяПлощадь									  
//	СовокупнаяПлощадь									  
//	ТипКвартиры									  
//	СтатусКвартиры									  
//	ТипПлиты									  
//	ТипЗапирающегоУстройства									  
//	ЖилоеПомещениеСпециализированногоЖилищногоФонда									  
//	ПлощадьОДНСОИЭлектроснаб									  
//	ПлощадьОДНСОИВодоснаб									  
	ВысотаПотолков				= ?(Стру.Свойство("V_POT"),Стру.V_POT,0);					  
	лб_ПредставлениеКвартиры	= ?(Стру.Свойство("KVARTIRA"),сокрЛП(Стру.KVARTIRA),"");
	лб_ИгнорироватьНачисления	= ?(Стру.Свойство("NE_V_NACH"),(Стру.NE_V_NACH = 1),ложь);								  
	лб_ИгнорироватьСальдо		= ?(Стру.Свойство("NE_V_SUM"),(Стру.NE_V_SUM = 1),ложь);	
	лб_ПлощадьКапремонта		= ?(Стру.Свойство("PL_KAP"),Стру.PL_KAP,0);
	//лб_ВысотаПотолка			= Стру.V_POT;									  
	лб_ВысотаПотолка	        = ВысотаПотолков;
	ЗамечаниеЛС 				= ?(Стру.Свойство("PR"),сокрЛП(Стру.PR),"");	
	
	//КодТипаКвартиры 
	// 1 - Отдельная, 2 - Коммунальная, 3 - Нежилое помещение, 4 - Общежитие (покомнатное заселение)

	
	Если КодТипаКвартиры = 1 тогда
		ТипКвартиры = Справочники.бит_ТипыКвартиры.Отдельная
	ИначеЕсли КодТипаКвартиры = 2 тогда
		ТипКвартиры = Справочники.бит_ТипыКвартиры.Коммунальная
	ИначеЕсли КодТипаКвартиры = 3 тогда
		ТипКвартиры = Справочники.бит_ТипыКвартиры.НежилоеПомещение
	ИначеЕсли КодТипаКвартиры = 4 тогда
		ТипКвартиры = Справочники.бит_ТипыКвартиры.ОбщежитиеПоквартирноеИлиПокомнатноеЗаселение
	иначе	
		ТипКвартиры	= Справочники.бит_ТипыКвартиры.ПустаяСсылка()
	КонецЕсли;	
	
	//КодСтатусаКвартиры 
	// 1 - Частная собственность, 2 - Муниципальная, 3 - Государственная

	Если КодСтатусаКвартиры =1 тогда
		СтатусКвартиры = Справочники.бит_СтатусыКвартиры.Приватизированная
	ИначеЕсли КодСтатусаКвартиры =2 тогда
		СтатусКвартиры = Справочники.бит_СтатусыКвартиры.Неприватизированная
	ИначеЕсли КодСтатусаКвартиры = 3 тогда
		СтатусКвартиры = Справочники.бит_СтатусыКвартиры.Государственный
	КонецЕсли;
	
	
	Запись = РегистрыСведений.бит_СведенияОКвартире.СоздатьМенеджерЗаписи();
	Запись.Активность =истина;
	Запись.Период = Объект.Дата;
	
	Запись.Квартира = Квартира;
	Запись.лб_ПредставлениеКвартиры = лб_ПредставлениеКвартиры;
	Запись.ВысотаПотолков = ВысотаПотолков;
	Запись.ЖилаяПлощадь = ЖилаяПлощадь;
	Запись.ОбщаяПлощадь = ОбщаяПлощадь;
	Запись.лб_ПлощадьКапремонта = лб_ПлощадьКапремонта;
	Запись.ВысотаПотолков = лб_ВысотаПотолка;
	Запись.лб_ИгнорироватьСальдоСвоихУслуг = лб_ИгнорироватьНачисления;
	Запись.лб_НеВыводитьСтрокуДомофон = лб_ИгнорироватьСальдо;
	Запись.ТипКвартиры = ТипКвартиры;
	Запись.СтатусКвартиры = СтатусКвартиры;
	Запись.Записать(истина);
	
	
	
	 Если Не ПустаяСтрока(ЗамечаниеЛС) тогда
		 Запись = РегистрыСведений.бит_ЗамечанияПоЛС.СоздатьМенеджерЗаписи();
		 Запись.Активность = истина;
		 Запись.ЛицевойСчет = ЛС;
		 Запись.ДатаЗаписи = Объект.Дата;
		 Запись.Наименование ="-";
		 Запись.ТекстЗамечания = ЗамечаниеЛС;
		 Запись.Записать(истина);
	 КонецЕсли;
	
	           	
	
		
КонецПроцедуры	

&НаСервере
Функция  СтруктураНомераКвартиры(знач ИмяКвартиры)
	
	ИмяКвартиры = сокрЛП(ИмяКвартиры)+"  ";
	
	Ст = новый структура("НомерКвартиры,ПрефиксКвартиры","0","");
	
	Символ = лев(ИмяКвартиры,1);
	ЕстьПрефикс = СтрНайти("0123456789",Символ)=0;
	Пока ЕстьПрефикс и СтрДлина(ИмяКвартиры)>0 цикл
		Символ = лев(ИмяКвартиры,1);
		Если СтрНайти("0123456789",Символ)=0 тогда; 
			Ст.ПрефиксКвартиры = Ст.ПрефиксКвартиры +  Символ;
			ИмяКвартиры = сред(ИмяКвартиры,2)
		иначе
			ЕстьПрефикс = ложь;
		КонецЕсли;	
			
	КонецЦикла;
	
	Если ИмяКвартиры = "" тогда
		ИмяКвартиры = " ";
	КонецЕсли;	
	Символ = лев(ИмяКвартиры,1);
	НачЦифры = СтрНайти("0123456789",Символ)>0;	 
	Для Ном=1 по СтрДлина(ИмяКвартиры) цикл		
		
		Символ = сред(ИмяКвартиры,Ном,1);
		Если НачЦифры и СтрНайти("0123456789",Символ)>0 тогда
			Ст.НомерКвартиры = Ст.НомерКвартиры + Символ;
		иначе
			Ст.ПрефиксКвартиры = Ст.ПрефиксКвартиры  + Символ;
			НачЦифры = ложь;
		КонецЕсли;	
	КонецЦикла;	
	
	Ст.ПрефиксКвартиры = сокрЛП(Ст.ПрефиксКвартиры);
	
	Ст.НомерКвартиры = Число(Ст.НомерКвартиры);
	Если Ст.НомерКвартиры=0 и Ст.ПрефиксКвартиры<>"-" тогда
		Ст.НомерКвартиры = 1
	КонецЕсли;	
	
	возврат Ст;
	
КонецФункции

	
