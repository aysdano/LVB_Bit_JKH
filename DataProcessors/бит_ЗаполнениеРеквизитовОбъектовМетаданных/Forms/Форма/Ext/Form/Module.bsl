	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ФайлЧтения) Тогда
		ТекстСообщения = НСтр("ru = 'Файл загрузки не выбран!'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		Возврат;	
	КонецЕсли;
	
	ФайлНаДиске = Новый Файл(ФайлЧтения);
	Если нРег(ФайлНаДиске.Расширение) = ".xls"
		ИЛИ нРег(ФайлНаДиске.Расширение) = ".xlsx" Тогда
		ПрочитатьТабличныйДокументИзExcel(ТабДок, ФайлЧтения, НомерСтраницы);
	КонецЕсли;
	
КонецПроцедуры

