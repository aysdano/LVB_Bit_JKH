
#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	КэшированныеЗначения.Вставить("ЦветЛинииОтчета", ЦветаСтиля.ЦветЛинииОтчета);
	КэшированныеЗначения.Вставить("ЦветФонаКнопки" , ЦветаСтиля.ЦветФонаКнопки);
	
	КэшированныеЗначения.Вставить("КвартираПустаяСсылка", Справочники.бит_Квартиры.ПустаяСсылка());
	КэшированныеЗначения.Вставить("ЗданиеПустаяСсылка"   , Справочники.бит_СписокЗданий.ПустаяСсылка());
	
КонецПроцедуры

// БИТ_ЖКХ 04.10.2011
//
&НаСервере
Процедура ВыполнитьПроверкуИЗапись(Записать = Ложь)
	
	Корень = СписокУслуг.ПолучитьЭлементы();
	
	Для каждого СтрокаГруппы Из Корень Цикл
		
		НаборЗаписей = РегистрыСведений.бит_НастройкиУслугВыгрузкиГЦЖС.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Услуга.Установить(СтрокаГруппы.Услуга, Истина);
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, СтрокаГруппы);
		
		Группа = СтрокаГруппы.ПолучитьЭлементы();
		
		Для каждого СтрокаТаблицы Из Группа Цикл
			
			Запись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(Запись, СтрокаТаблицы);
			Запись.Услуга = СтрокаГруппы.Услуга;
			
		КонецЦикла; 
		
		НаборЗаписей.Записать(Истина);
		
	КонецЦикла; 
	
	Для каждого Строка Из СписокРайонов Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Районы и/или города"": ";
			
			ЭлСправочника = Строка.Район.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого Строка Из СписокЛьгот Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС 
			ИЛИ НЕ Строка.НовоеФиксированноеКоличествоЧеловекПользующихсяЛьготой = Строка.СтароеФиксированноеКоличествоЧеловекПользующихсяЛьготой Тогда
			
			Заголовок = "Справочник ""Список льгот"": ";
			
			ЭлСправочника = Строка.Льгота.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			ЭлСправочника.ФиксированноеКоличествоЧеловекПользующихсяЛьготой = Строка.НовоеФиксированноеКоличествоЧеловекПользующихсяЛьготой;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого Строка Из СписокУлиц Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС
			ИЛИ НЕ Строка.НовыйКодГЦЖСБТИ = Строка.СтарыйКодГЦЖСБТИ Тогда
			
			Заголовок = "Справочник ""Список улиц"": ";
			
			ЭлСправочника = Строка.Улица.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС    = Строка.НовыйКодГЦЖС;
			ЭлСправочника.КодПоГУГЦЖСБТИ = Строка.НовыйКодГЦЖСБТИ;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла;
	
	Для каждого Строка Из СписокТиповУлицы Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС  Тогда
			
			Заголовок = "Справочник ""Типы улицы"": ";
			
			ЭлСправочника = Строка.ТипУлицы.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС    = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла;
	
	Для каждого Строка Из СписокУдостовиренийЛичности Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Документы удостоверяющие личность"": ";
			
			ЭлСправочника = Строка.ВидДокумента.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла;
	
	Для каждого Строка Из СписокДокументовНаЛьготу Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Документы подтверждающие льготу"": ";
			
			ЭлСправочника = Строка.ВидДокумента.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого Строка Из СписокЖилишныхФондов Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Документы подтверждающие льготу"": ";
			
			ЭлСправочника = Строка.ТипЖилищногоФонда.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла;
	
	Для каждого Строка Из СписокСтатусовКвартиры Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС ИЛИ НЕ Строка.НовыйПредставлениеПоГУГЦЖС = Строка.СтарыйПредставлениеПоГУГЦЖС Тогда
			
			Заголовок = "Справочник ""Статусы квартиры"": ";
			
			ЭлСправочника = Строка.СтатусКвартиры.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС           = Строка.НовыйКодГЦЖС;
			ЭлСправочника.ПредставлениеПоГУГЦЖС = Строка.НовыйПредставлениеПоГУГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого Строка Из СписокТиповКвартиры Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Типы квартиры"": ";
			
			ЭлСправочника = Строка.ТипКвартиры.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого Строка Из СписокКодовПлательщиков Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Лицевые счета"": ";
			
			ЭлСправочника = Строка.ЛицевойСчет.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла;
	
	Для каждого Строка Из СписокПоставщиков Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Поставщики услуг"": ";
			
			ЭлСправочника = Строка.Поставщик.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла; 
	
	Для каждого Строка Из СписокСтепениРодстваФизЛиц Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Степени родства физлиц"": ";
			
			ЭлСправочника = Строка.СтепеньРодства.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла;
	
	// БИТ_ЖКХ 10.04.2014
	Для каждого Строка Из СписокСтатусовФизическихЛиц Цикл
		Если НЕ Строка.НовыйКодГЦЖС = Строка.СтарыйКодГЦЖС Тогда
			
			Заголовок = "Справочник ""Статусы физлиц"": ";
			
			ЭлСправочника = Строка.СтатусФизическогоЛица.ПолучитьОбъект();
			ЭлСправочника.КодПоГУГЦЖС = Строка.НовыйКодГЦЖС;
			бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлСправочника,Заголовок,,Истина);
			
		КонецЕсли; 
	КонецЦикла;
	// БИТ_ЖКХ 10.04.2014
	
КонецПроцедуры

// БИТ_ЖКХ 04.10.2011
//
&НаСервере
Процедура ОбновитьТаблицы()
	
	СписокДокументовНаЛьготу.Очистить();
	СписокЖилишныхФондов.Очистить();
	СписокРайонов.Очистить();
	СписокСтатусовКвартиры.Очистить();
	СписокТиповКвартиры.Очистить();
	СписокУдостовиренийЛичности.Очистить();
	СписокУлиц.Очистить();
	СписокУслуг.ПолучитьЭлементы().Очистить();
	СписокПоставщиков.Очистить();
	СписокСтепениРодстваФизЛиц.Очистить();
	СписокТиповУлицы.Очистить();
	
	// БИТ_ЖКХ 12.07.2013 Начало
	СписокСтатусовФизическихЛиц.Очистить();
	// БИТ_ЖКХ 12.07.2013 Окончание
	
	Запрос = Новый Запрос;
	
	// Районы.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_АдминистративныеОкруга.Ссылка КАК Район,
	|	бит_АдминистративныеОкруга.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_АдминистративныеОкруга.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_АдминистративныеОкруга КАК бит_АдминистративныеОкруга";
	
	СписокРайонов.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Типы улицы.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ТипыУлицы.Ссылка КАК ТипУлицы,
	|	бит_ТипыУлицы.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_ТипыУлицы.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_ТипыУлицы КАК бит_ТипыУлицы";
	
	СписокТиповУлицы.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Улицы.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СписокУлиц.Ссылка КАК Улица,
	|	бит_СписокУлиц.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_СписокУлиц.КодПоГУГЦЖС КАК СтарыйКодГЦЖС,
	|	бит_СписокУлиц.КодПоГУГЦЖСБТИ КАК СтарыйКодГЦЖСБТИ,
	|	бит_СписокУлиц.КодПоГУГЦЖСБТИ КАК НовыйКодГЦЖСБТИ
	|ИЗ
	|	Справочник.бит_СписокУлиц КАК бит_СписокУлиц";
	
	СписокУлиц.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Жилищные фонды.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ТипыЖилогоФонда.Ссылка КАК ТипЖилищногоФонда,
	|	бит_ТипыЖилогоФонда.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_ТипыЖилогоФонда.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_ТипыЖилогоФонда КАК бит_ТипыЖилогоФонда";
	
	СписокЖилишныхФондов.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Типы квартир.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ТипыКвартиры.Ссылка КАК ТипКвартиры,
	|	бит_ТипыКвартиры.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_ТипыКвартиры.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_ТипыКвартиры КАК бит_ТипыКвартиры";
	
	СписокТиповКвартиры.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Статусы квартир.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СтатусыКвартиры.Ссылка КАК СтатусКвартиры,
	|	бит_СтатусыКвартиры.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_СтатусыКвартиры.КодПоГУГЦЖС КАК СтарыйКодГЦЖС,
	|	бит_СтатусыКвартиры.ПредставлениеПоГУГЦЖС КАК НовыйПредставлениеПоГУГЦЖС,
	|	бит_СтатусыКвартиры.ПредставлениеПоГУГЦЖС КАК СтарыйПредставлениеПоГУГЦЖС
	|ИЗ
	|	Справочник.бит_СтатусыКвартиры КАК бит_СтатусыКвартиры";
	
	СписокСтатусовКвартиры.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Документы удостоверяющие личность.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ДокументыУдостоверяющиеЛичность.Ссылка КАК ВидДокумента,
	|	ДокументыУдостоверяющиеЛичность.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	ДокументыУдостоверяющиеЛичность.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_ДокументыУдостоверяющиеЛичность КАК ДокументыУдостоверяющиеЛичность";
	
	СписокУдостовиренийЛичности.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Документы подтверждающие льготу.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ДокументыПодтверждающиеЛьготу.Ссылка КАК ВидДокумента,
	|	бит_ДокументыПодтверждающиеЛьготу.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_ДокументыПодтверждающиеЛьготу.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_ДокументыПодтверждающиеЛьготу КАК бит_ДокументыПодтверждающиеЛьготу";
	
	СписокДокументовНаЛьготу.Загрузить(Запрос.Выполнить().Выгрузить());
	
	//  Список льгот.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СписокЛьгот.Ссылка КАК Льгота,
	|	бит_СписокЛьгот.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_СписокЛьгот.КодПоГУГЦЖС КАК СтарыйКодГЦЖС,
	|	бит_СписокЛьгот.ФиксированноеКоличествоЧеловекПользующихсяЛьготой КАК НовоеФиксированноеКоличествоЧеловекПользующихсяЛьготой,
	|	бит_СписокЛьгот.ФиксированноеКоличествоЧеловекПользующихсяЛьготой КАК СтароеФиксированноеКоличествоЧеловекПользующихсяЛьготой
	|ИЗ
	|	Справочник.бит_СписокЛьгот КАК бит_СписокЛьгот";
	
	СписокЛьгот.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Услуги.
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_УслугиЖКХ.Ссылка КАК Услуга,
	|	бит_УслугиЖКХРежимыПотребленияУслуг.РежимПотребленияУслуг КАК РежимПотребления,
	|	бит_УслугиЖКХ.ОсновнойРежимПотребления
	|ПОМЕСТИТЬ СписокУслуг
	|ИЗ
	|	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_УслугиЖКХ.РежимыПотребленияУслуг КАК бит_УслугиЖКХРежимыПотребленияУслуг
	|		ПО бит_УслугиЖКХ.Ссылка = бит_УслугиЖКХРежимыПотребленияУслуг.Ссылка
	|ГДЕ
	|	НЕ бит_УслугиЖКХ.Предопределенный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокУслуг.Услуга КАК Услуга,
	|	СписокУслуг.РежимПотребления,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖСОбщеДом,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_КПУ,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_ДПУ,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_Разовые,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.ИспользоватьТариф,
	|	СписокУслуг.Услуга.Приоритет КАК Приоритет,
	|	СписокУслуг.ОсновнойРежимПотребления КАК ОсновнойРежимПотребления,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.УчетВременноПроживающих
	|ИЗ
	|	СписокУслуг КАК СписокУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НастройкиУслугВыгрузкиГЦЖС КАК бит_НастройкиУслугВыгрузкиГЦЖС
	|		ПО СписокУслуг.Услуга = бит_НастройкиУслугВыгрузкиГЦЖС.Услуга
	|			И СписокУслуг.РежимПотребления = бит_НастройкиУслугВыгрузкиГЦЖС.РежимПотребления
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ ПО
	|	Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СписокУслуг";
	
	ВыборкаУС = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Корень = СписокУслуг.ПолучитьЭлементы();
	
	Пока ВыборкаУС.Следующий() Цикл
		
		Если ВыборкаУС.Услуга.РежимыПотребленияУслуг.Количество() > 0 Тогда 
			
			ГруппаУслуги = Корень.Добавить();
			
			Выборка = ВыборкаУС.Выбрать();
			
			Услуга = ГруппаУслуги.ПолучитьЭлементы();
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.РежимПотребления = Выборка.ОсновнойРежимПотребления Тогда
					ЗаполнитьЗначенияСвойств(ГруппаУслуги, Выборка);
					Продолжить;
				КонецЕсли; 
				
				СтрокаУслуги =  Услуга.Добавить();
				ЗаполнитьЗначенияСвойств(СтрокаУслуги, Выборка);
				СтрокаУслуги.Услуга = Неопределено;
				
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЦикла; 
	
	// Поставщики услуг.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПоставщикиУслуг.Ссылка КАК Поставщик,
	|	бит_ПоставщикиУслуг.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_ПоставщикиУслуг.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_ПоставщикиУслуг КАК бит_ПоставщикиУслуг";
	
	СписокПоставщиков.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Степени родства физлиц.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СтепениРодстваФизЛиц.Ссылка КАК СтепеньРодства,
	|	бит_СтепениРодстваФизЛиц.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_СтепениРодстваФизЛиц.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_СтепениРодстваФизЛиц КАК бит_СтепениРодстваФизЛиц";
	
	СписокСтепениРодстваФизЛиц.Загрузить(Запрос.Выполнить().Выгрузить());
	
	// Статусы физических лиц.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СтатусФизЛица.Ссылка КАК СтатусФизическогоЛица,
	|	бит_СтатусФизЛица.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_СтатусФизЛица.КодПоГУГЦЖС КАК СтарыйКодГЦЖС
	|ИЗ
	|	Справочник.бит_СтатусФизЛица КАК бит_СтатусФизЛица";
	
	СписокСтатусовФизическихЛиц.Загрузить(Запрос.Выполнить().Выгрузить());
	
	ПолучитьТаблицуЛицевыхСчетов();	
	
КонецПроцедуры

#КонецОбласти

