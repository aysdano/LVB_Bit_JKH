&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовка(Форма)
	
	Отчет = Форма.Отчет;
	
	ЗаголовокОтчета = "История начислений за период с " + Формат(Отчет.НачалоПериода,"ДФ=dd.MM.yyyy") + " по " + Формат(Отчет.КонецПериода,"ДФ=dd.MM.yyyy");
	
	Форма.Заголовок = ЗаголовокОтчета;
	
КонецПроцедуры

#КонецОбласти