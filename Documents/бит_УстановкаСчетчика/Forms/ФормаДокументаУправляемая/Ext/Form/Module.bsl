// Процедура - обработчик события "НачалоВыбора" поля ввода "Счетчик".
//
&НаКлиенте
Процедура СчетчикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Объект.ВидОперации.Пустая() Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не выбран вид операции!");
		
		Возврат;
	КонецЕсли;
	
	ПараметрыФормыВыбора = Новый Структура;
	
	ПараметрыФормыВыбора.Вставить("Дата"       , КонецДня(Объект.Дата));
	
	Установлен = (Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.СнятиеСчетчика 
	ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
	ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьЛицевыеСчетаСоСчетчика
	ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик
	ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик  // БИТ_ЖКХ 27.11.2015 15:47:15 
	ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьУслугиСоСчетчика); 
	
	ТипСчетчика = ?(ЗначениеЗаполнено(Объект.Объект),
	мКэшЗначений.Перечисления.бит_ТипСчетчика.Индивидуальный,
	мКэшЗначений.Перечисления.бит_ТипСчетчика.Групповой);
	
	Если (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.УдалитьУслугиСоСчетчика"))
		И ЗначениеЗаполнено(Объект.Объект) Тогда
		
		ПараметрыФормыВыбора.Вставить("ОбъектУчета", Объект.Объект);
		
	КонецЕсли;
	
	ПараметрыФормыВыбора.Вставить("Установлен" , Установлен);
	ПараметрыФормыВыбора.Вставить("ТипСчетчика", ТипСчетчика);
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	
	ОткрытьФорму("Справочник.бит_Счетчики.Форма.ФормаВыбораСчетчиков", ПараметрыФормыВыбора, Элемент);
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "Счетчик".
//
&НаКлиенте
Процедура СчетчикПриИзменении(Элемент)
	
	Объект.Услуги.Очистить();
	Объект.ЛицевыеСчета.Очистить();
	Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
	Корень.Очистить();
	
	Объект.НачальныеПоказания = 0;
	Объект.КонечныеПоказания  = 0;
	Объект.Приоритет          = 0;
	Объект.СпособРасчета      = Неопределено;
	
	ПриИзмененииСчетчикаНаСервере();
	
	// БИТ_ЖКХ 04.12.2014{{
	СпособыПоГрупповым();
	// БИТ_ЖКХ 04.12.2014}}
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "НачальныеПоказания".
//
&НаКлиенте
Процедура НачальныеПоказанияПриИзменении(Элемент)
	
	ПриИзмененииПоказаний(Объект.НачальныеПоказания, Элемент.Имя);
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "НачальныеПоказания".
//
&НаКлиенте
Процедура КонечныеПоказанияПриИзменении(Элемент)
	
	Отказ = Ложь;
	
	ПриИзмененииПоказаний(Объект.КонечныеПоказания, Элемент.Имя, Отказ);
	
	Если Объект.КонечныеПоказания < Объект.НачальныеПоказания И НЕ Отказ Тогда
		
		// Разность = Объект.Счетчик.Разрядность - Объект.НачальныеПоказания + 1 + Объект.КонечныеПоказания;.
		Разность = мКэшЗначений.Разрядность - Объект.НачальныеПоказания + 1 + Объект.КонечныеПоказания;
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("КонечныеПоказанияПриИзмененииЗавершение", ЭтотОбъект), "Произойдет переход через 0 на разность: " + Разность +". Продолжить?",РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонечныеПоказанияПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Объект.КонечныеПоказания = 0;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиРазовыеНажатие(Элемент)
	
	Если Элемент.Заголовок = "Ввести разовые начисления по тарифу" Тогда   // вводим разовые начисления
		
		Если НЕ Объект.Проведен Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Проведите документ!");
			
			Возврат;
		КонецЕсли;
		
		РазовыеПоСчетчикам();
		
	Иначе // Открываем разовые начисления.
		
		ДокументРазовые = ПолучитьДокументРазовые();
		
		Если НЕ ДокументРазовые = Неопределено Тогда
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ",ДокументРазовые);
			Форма = ОткрытьФорму("Документ.бит_РазовыеПоУслугамЖКХ.Форма.ФормаДокументаУправляемая",ПараметрыФормы,ЭтаФорма);
			
		Иначе
			
			РазовыеПоСчетчикам();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазовыеПоСчетчикам()
	
	Ссылка = Неопределено;
	СоздатьДокумент(Ссылка);
	
	Если НЕ Ссылка = Неопределено Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ",Ссылка);
		Форма = ОткрытьФорму("Документ.бит_РазовыеПоУслугамЖКХ.Форма.ФормаДокументаУправляемая",ПараметрыФормы,ЭтаФорма);
		
		// БИТ_ЖКХ 28.05.2014
		ДокументРазовыеНомер = ПолучитьНомерНаСервере(Ссылка);
		ДокументРазовыеДата = ПолучитьДатуНаСервере(Ссылка);
		
		// Элементы.ВвестиРазовые.Заголовок = "Разовые № " + Строка(Ссылка.Номер) + " от:" + Строка(Ссылка.Дата);.
		Элементы.ВвестиРазовые.Заголовок = "Разовые № " + Строка(ДокументРазовыеНомер) + " от:" + Строка(ДокументРазовыеДата);
		// БИТ_ЖКХ 28.05.2014
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СпособРасчетаПриИзменении(Элемент)
	
	Объект.ЛицевыеСчета.Очистить();
	ДеревоОбъектовУчета.ПолучитьЭлементы().Очистить();
	
	
	Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
		
		Если Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных 
			ИЛИ (Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам и Объект.ИспользоватьПравилоУменьшения) Тогда
			
			СтрокаТаблицы.СпособРаспределения           = мКэшЗначений.Перечисления.бит_СпособыРаспределения.ПоСчетчикам;
			СтрокаТаблицы.СпособРаспределенияУменьшения = мКэшЗначений.Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаНачисления;

		КонецЕсли; 
		
	КонецЦикла; 
	
	Если НЕ Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных 
		
		// БИТ_ЖКХ 02.12.2014{{	
		и НЕ Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам Тогда
		// БИТ_ЖКХ 02.12.2014}}	
		
		Объект.Приоритет = 0;
		
		Объект.ИспользоватьСтавкуПоСчетчику = Ложь;
		
		Объект.ИспользоватьПравилоУменьшения = Ложь;
		
	КонецЕсли;
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляУслуги

&НаКлиенте
Процедура УслугиПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если НЕ ЗначениеЗаполнено(Объект.Счетчик) Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не выбран счетчик!");
		
		Отказ = Истина;
		Возврат
	КонецЕсли;
	
	Если Копирование Тогда
		
		Отказ = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПередУдалением(Элемент, Отказ)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	ТипСчетчика = ПолучитьТипСчетчика(Объект.Счетчик); 

	Если ТипСчетчика = ПредопределенноеЗначение("Перечисление.бит_ТипСчетчика.Групповой") Тогда
	
		Если ТекДанные <> Неопределено Тогда
			
			Ответ = Неопределено;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("УслугиПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("Отказ, ТекДанные", Отказ, ТекДанные)), "При удалении услуги список лицевых счетов будет очищен по удаляемой услуге. Продолжить?", РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Отказ = ДополнительныеПараметры.Отказ;
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	
	Ответ = РезультатВопроса; 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		УдалитьСтрокиДерева(ТекДанные.Услуга);
	Иначе
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьУслугиСоСчетчика Тогда
		СписокУслуг = Новый СписокЗначений;
		МассивУсулг = мКэшЗначений.СписокУС.ВыгрузитьЗначения();
		СписокУслуг.ЗагрузитьЗначения(МассивУсулг);
	Иначе
		СписокУслуг = ПолучитьСписокУслуг();
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
		
		Поиск = СписокУслуг.НайтиПоЗначению(СтрокаТаблицы.Услуга);
		
		Если НЕ Поиск = Неопределено Тогда
			
			СписокУслуг.Удалить(Поиск);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик Тогда
		
		Для каждого Услуга Из мКэшЗначений.СписокУС Цикл
			
			ЭлементСписка = СписокУслуг.НайтиПоЗначению(Услуга.Значение);
			
			Если НЕ ЭлементСписка = Неопределено Тогда
				СписокУслуг.Удалить(ЭлементСписка);
			КонецЕсли; 
			
		КонецЦикла; 
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ссылка", СписокУслуг);
	
	ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая",Новый Структура("Отбор", Отбор),Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ТекДанные = Элементы.Услуги.ТекущиеДанные;
		
		Если НЕ ТекДанные.Услуга = ВыбранноеЗначение Тогда
			
			Отказ = Ложь;
			
			ПроверитьВозможностьУстановкиСчетчикаПоУслуге(ВыбранноеЗначение, Отказ);
			
			Если Отказ Тогда
				Возврат;
			КонецЕсли; 

			ТипСчетчика = ПолучитьТипСчетчика(Объект.Счетчик); 
			Если ТипСчетчика = ПредопределенноеЗначение("Перечисление.бит_ТипСчетчика.Групповой") Тогда

				УдалитьСтрокиДерева(ТекДанные.Услуга);
				РазвернутьВсеУровни();
			КонецЕсли; 
			
			ТекДанные.Услуга = ВыбранноеЗначение;
			
			Если Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных Тогда
				ТекДанные.СпособРаспределения           = мКэшЗначений.Перечисления.бит_СпособыРаспределения.ПоСчетчикам;
				ТекДанные.СпособРаспределенияУменьшения = мКэшЗначений.Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаНачисления;
				
				// БИТ_ЖКХ 02.12.2014{{	
			ИначеЕсли Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам Тогда
				ТекДанные.СпособРаспределения           = мКэшЗначений.Перечисления.бит_СпособыРаспределения.ПоСчетчикам;
				ТекДанные.СпособРаспределенияУменьшения = мКэшЗначений.Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаНачисления;
				ТекДанные.СпособРасчетаУменьшения       = Неопределено;
				// БИТ_ЖКХ 02.12.2014}}
				
			Иначе
				ТекДанные.СпособРаспределения           = мКэшЗначений.Перечисления.бит_СпособыРаспределения.НеИспользуется;
				ТекДанные.СпособРаспределенияУменьшения = мКэшЗначений.Перечисления.бит_СпособыРаспределения.НеИспользуется;
			КонецЕсли;
			
		КонецЕсли; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьТипСчетчика(Счетчик)
	возврат Счетчик.ТипСчетчика; 
КонецФункции

&НаКлиенте
Процедура УслугиНачальныеПоказанияПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	ПриИзмененииПоказаний(ТекДанные.НачальныеПоказания, Элемент.Имя);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКонечныеПоказанияПриИзменении(Элемент)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Отказ = Ложь;
	
	ПриИзмененииПоказаний(ТекДанные.КонечныеПоказания, Элемент.Имя, Отказ);
	
	Если ТекДанные.КонечныеПоказания < ТекДанные.НачальныеПоказания И НЕ Отказ Тогда
		
		Разность = мКэшЗначений.Разрядность - ТекДанные.НачальныеПоказания + 1 + ТекДанные.КонечныеПоказания;
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("УслугиКонечныеПоказанияПриИзмененииЗавершение", ЭтотОбъект, Новый Структура("ТекДанные", ТекДанные)), "Произойдет переход через 0 на разность: " + Разность +". Продолжить?",РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиКонечныеПоказанияПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекДанные = ДополнительныеПараметры.ТекДанные;
	
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		ТекДанные.КонечныеПоказания = 0;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляЛицевыеСчета

&НаКлиенте
Процедура ЛицевыеСчетаУслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	СписокУслуг = Новый СписокЗначений;
	Для Каждого СтрокаТаблицы из Объект.Услуги Цикл
		СписокУслуг.Добавить(СтрокаТаблицы.Услуга);
	КонецЦикла;
	
	ФормаВыбора = ПолучитьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая",,Элемент);
	
	ОтборУслуг = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУслуг.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
	ОтборУслуг.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	ОтборУслуг.ПравоеЗначение = СписокУслуг;
	
	ФормаВыбора.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	СписокЛС = Новый СписокЗначений;
	
	Для каждого СтрокаТаблицы_Лицевыесчета Из Объект.ЛицевыеСчета Цикл
		
		СписокЛС.Добавить(СтрокаТаблицы_Лицевыесчета.ЛицевойСчет);
		
	КонецЦикла; 
	
	ФормаВыбора = ПолучитьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая",,Элемент);
	
	ОтборУслуг = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУслуг.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Здание");
	ОтборУслуг.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУслуг.ПравоеЗначение = Объект.Объект;
	
	Если СписокЛС.Количество() > 0 Тогда
		
		ОтборЛС = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЛС.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
		ОтборЛС.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеВСписке;
		ОтборЛС.ПравоеЗначение = СписокЛС;
		
	КонецЕсли; 
	
	ФормаВыбора.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекСтрока.Услуга) Тогда
		
		Отказ = Ложь;
		
		ПроверитьВозможностьУстановкиСчетчикаНаЛицевойСчет(Объект.Объект, 
		ВыбранноеЗначение, 
		ТекСтрока.Услуга, 
		ТекСтрока.Адрес, 
		ТекСтрока.ОтветственноеЛицо, 
		ТекСтрока.Индивидуальный, 
		ТекСтрока.УстановленныйСчетчик,
		Отказ);
		
		Если ОТказ Тогда
			
			СтандартнаяОбработка = Ложь;
			
		КонецЕсли;
		
	Иначе
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не указана услуга!");
		
		СтандартнаяОбработка = Ложь;
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	Документ       = Метаданные.Документы.бит_УстановкаСчетчика;
	ПравоИзменения = ПравоДоступа("Изменение", Документ);
	
	КэшированныеЗначения = Новый Структура;
	
	// Перечисления.
	КэшПеречисления = Новый Структура;
	КэшПеречисления.Вставить("бит_ВидыОпераций"            , бит_ОбщегоНазначения.КэшироватьЗначенияПеречисления(Перечисления.бит_ВидыОперацийУстановкаСчетчика));
	КэшПеречисления.Вставить("бит_ТипСчетчика"             , бит_ОбщегоНазначения.КэшироватьЗначенияПеречисления(Перечисления.бит_ТипСчетчика));
	КэшПеречисления.Вставить("бит_СпособыРасчетаПоУслугам" , бит_ОбщегоНазначения.КэшироватьЗначенияПеречисления(Перечисления.бит_СпособыРасчетаПоУслугам));
	КэшПеречисления.Вставить("бит_СпособыРаспределения"    , бит_ОбщегоНазначения.КэшироватьЗначенияПеречисления(Перечисления.бит_СпособыРаспределения));
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	
	тмпТаблицаУслуг = Объект.Услуги.Выгрузить();
	
	КэшированныеЗначения.Вставить("ПравоИзменения", ПравоИзменения);
	КэшированныеЗначения.Вставить("Перечисления"  , КэшПеречисления);
	КэшированныеЗначения.Вставить("Услуга"        , Неопределено);
	
	КэшированныеЗначения.Вставить("Разрядность"                  , 0);
	КэшированныеЗначения.Вставить("ДатаПоверки"                  , Дата("00010101000000"));
	КэшированныеЗначения.Вставить("МестоУстановкиСчетчика"       , Справочники.бит_Комнаты.ПустаяСсылка());
	КэшированныеЗначения.Вставить("ИспользоватьСтавкуПоСчетчику" , Ложь);
	КэшированныеЗначения.Вставить("СчетчикСЗависимымиУслугами"   , Ложь);
	КэшированныеЗначения.Вставить("ИспользоватьПравилоУменьшения", Ложь);
	КэшированныеЗначения.Вставить("ТипСчетчика"                  , Перечисления.бит_ТипСчетчика.ПустаяСсылка());
	КэшированныеЗначения.Вставить("Квартира"                     , Справочники.бит_Квартиры.ПустаяСсылка());
	КэшированныеЗначения.Вставить("Улица"                        , Справочники.бит_СписокУлиц.ПустаяСсылка());
	КэшированныеЗначения.Вставить("Приоритет"                    , 0);
	КэшированныеЗначения.Вставить("СписокЛС"                     , Новый СписокЗначений);
	КэшированныеЗначения.Вставить("СписокУС"                     , Новый СписокЗначений);
	КэшированныеЗначения.Вставить("СписокЗданий"                 , Новый СписокЗначений);
	
	// БИТ_ЖКХ 06.11.2014
	КэшированныеЗначения.СчетчикСЗависимымиУслугами = Объект.СчетчикСЗависимымиУслугами;
	// БИТ_ЖКХ 06.11.2014
	
	КэшированныеЗначения.Вставить("ЗаполнитьИзОбработкиПоверки" , Ложь);
	Если Параметры.Свойство("ЗаполнитьИзОбработкиПоверки") Тогда
		КэшированныеЗначения.ЗаполнитьИзОбработкиПоверки = Истина;
	Иначе
		КэшированныеЗначения.ЗаполнитьИзОбработкиПоверки = Ложь;
	КонецЕсли;
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

&НаСервере
Функция ПолучитьСписокУслуг()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент"     , КонецМесяца(Объект.Дата));
	Запрос.УстановитьПараметр("Объект"     , Объект.Объект);
	Запрос.УстановитьПараметр("ПоСчетчикам", Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам);
	
	Если ЗначениеЗаполнено(Объект.Объект) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
		|ИЗ
		|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
		|			&Момент,
		|			ЛицевойСчет = &Объект
		|				И Услуга.СпособыРасчета.СпособРасчета = &ПоСчетчикам) КАК бит_СведенияПоУслугамЛССрезПоследних";
		
	Иначе
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_УслугиЖКХСпособыРасчета.Ссылка КАК Услуга
		|ИЗ
		|	Справочник.бит_УслугиЖКХ.СпособыРасчета КАК бит_УслугиЖКХСпособыРасчета
		|ГДЕ
		|	бит_УслугиЖКХСпособыРасчета.СпособРасчета = &ПоСчетчикам
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_УслугиЖКХСпособыРасчета.Ссылка";
		
	КонецЕсли;
	
	СписокУслуг = Новый СписокЗначений;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокУслуг.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Услуга"));
	
	Возврат СписокУслуг;
	
КонецФункции // ()

&НаСервере
Процедура ПроверитьВозможностьУстановкиСчетчикаПоУслуге(Услуга, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"  , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.УстановитьПараметр("Объект", Объект.Объект);
	
	ТЗРаспределений = Новый ТаблицаЗначений;
	ТЗРаспределений.Колонки.Добавить("Услуга",Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ")); 
	ТЗРаспределений.Колонки.Добавить("ЛицевойСчет",Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета")); 
	
	НоваяСтрока = ТЗРаспределений.Добавить();
	НоваяСтрока.Услуга      = Услуга;
	НоваяСтрока.ЛицевойСчет = Объект.Объект;
	
	Запрос.УстановитьПараметр("ТЗРаспределений"       , ТЗРаспределений);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗРаспределений.Услуга,
	|	ТЗРаспределений.ЛицевойСчет
	|ПОМЕСТИТЬ ТЗ
	|ИЗ
	|	&ТЗРаспределений КАК ТЗРаспределений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_РаспределенияНаУслугахСрезПоследних.Услуга,
	|	бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет,
	|	бит_РаспределенияНаУслугахСрезПоследних.Распределение
	|ИЗ
	|	ТЗ КАК ТЗ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_РаспределенияНаУслугах.СрезПоследних(&Дата, ) КАК бит_РаспределенияНаУслугахСрезПоследних
	|		ПО ТЗ.Услуга = бит_РаспределенияНаУслугахСрезПоследних.Услуга
	|			И ТЗ.ЛицевойСчет = бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет
	|ГДЕ
	|	бит_РаспределенияНаУслугахСрезПоследних.Использовать
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_РаспределенияНаУслугахСрезПоследних.Услуга,
	|	бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет,
	|	бит_РаспределенияНаУслугахСрезПоследних.Распределение";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("На лицевом счете №" + Выборка.ЛицевойСчет + " на услуге:""" + Выборка.Услуга + """ установлено распределение " + Выборка.Распределение 
		+ " требуется его снять ");
		
		Отказ = Истина;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьВозможностьУстановкиСчетчикаНаЛицевойСчет(Здание, ЛицевойСчет, Услуга, Адрес = "", ОтветственноеЛицо, Индивидуальный = "", УстановленныйСчетчик, Отказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Услуга"     , Услуга);
	Запрос.УстановитьПараметр("Объект"     , Здание);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&Дата,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Если Запрос.Выполнить().Пустой() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("На лицевом счете №" + ЛицевойСчет + " не установлена услуга: """+ Услуга + """.");
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_РаспределенияНаУслугахСрезПоследних.Услуга,
	|	бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет,
	|	бит_РаспределенияНаУслугахСрезПоследних.Распределение
	|ИЗ
	|	РегистрСведений.бит_РаспределенияНаУслугах.СрезПоследних(
	|			&Дата,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И Услуга = &Услуга
	|				И Объект = &Объект) КАК бит_РаспределенияНаУслугахСрезПоследних
	|ГДЕ
	|	бит_РаспределенияНаУслугахСрезПоследних.Использовать";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("На лицевом счете №" + ЛицевойСчет + " на услуге:""" + Выборка.Услуга + """ установлено распределение " + Выборка.Распределение 
		+ " требуется его снять ");
		
		Отказ = Истина;
		Возврат;
		
	КонецЦикла;
		
	ОтветственноеЛицо    = ПолучитьОтвЛицо(ЛицевойСчет);
	Адрес                = Строка(ЛицевойСчет.УлицаЛицевогоСчета) + ", " + Строка(ЛицевойСчет.Здание);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьОтвЛицо(ЛицевойСчет)
	
	Запрос= Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , Объект.Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|	И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	
	ОтвЛицо = Неопределено;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОтвЛицо = Выборка.ФизЛицо;
		
	КонецЕсли;
	
	Возврат ОтвЛицо;
	
КонецФункции

&НаСервере
// Функция возвращает таблицу значений, которая содержит данные об услугах и начислениях по тарифам.
//
Функция НачисленияПоТарифам(СписокУслуг)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛС.ЛицевойСчет,
	|	ЛС.Квартира,
	|	ЛС.РежимПотребления,
	|	ЛС.Поставщик,
	|	ЛС.Услуга.ОсновнойСпособРасчета КАК СпособРасчета,
	|	ЛС.КоличествоЕдиницПотребления,
	|	ЛС.Услуга,
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры
	|ПОМЕСТИТЬ ЛицевыеСчета
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
