// Процедура - обработчик события "Выбор" табличного поля ТаблицаНачислений.
//
&НаКлиенте
Процедура ТаблицаНачисленийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаНачисленийУслуга"
		Или Поле.Имя = "ТаблицаНачисленийСтавка" 
		Или Поле.Имя = "ТаблицаНачисленийНачислено" Тогда
		
		АдресТаблицыРасшифровкиВХранилище = ПоместитьТаблицуРасшифровкиВХранилище();
		
		ПараметрыФормы = Новый Структура("АдресТаблицыРасшифровкиВХранилище", АдресТаблицыРасшифровкиВХранилище);
		
		ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаРасшифровкиСтавкиУправляемая", ПараметрыФормы, Элемент);
		
	ИначеЕсли Поле.Имя = "ТаблицаНачисленийРазовые" Тогда 
		
		ТекСтрока = Элементы.ТаблицаНачислений.ТекущиеДанные;
		
		РасшифровкаРазовых = ЗапросДляРасшифровкиРазовыхНаСервере(ТекСтрока.Услуга);
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("РасшифровкаРазовых",РасшифровкаРазовых);
		
		ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаРасшифровкиРазовыхУправляемая", ПараметрыФормы, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

//  Процедура - обработчик события "Выбор" дерева значений "ДеревоНачислений".
//
&НаКлиенте
Процедура ДеревоНачисленийВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекСтрока = Элемент.ТекущиеДанные;
	
	ДочерниеЭлементы = ТекСтрока.ПолучитьЭлементы();
	
	Если (Поле.Имя = "ДеревоНачисленийУслуга"
		Или Поле.Имя = "ДеревоНачисленийСтавка" 
		Или Поле.Имя = "ДеревоНачисленийНачислено") И ДочерниеЭлементы.Количество() = 0 Тогда
		
		АдресТаблицыРасшифровкиВХранилище = ПоместитьТаблицуРасшифровкиВХранилище();
		
		ПараметрыФормы = Новый Структура("АдресТаблицыРасшифровкиВХранилище", АдресТаблицыРасшифровкиВХранилище);
		
		ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаРасшифровкиСтавкиУправляемая", ПараметрыФормы, Элемент);
		
	ИначеЕсли Поле.Имя = "ДеревоНачисленийРазовые" Тогда  
		
		
		ТекСтрока = Элементы.ДеревоНачислений.ТекущиеДанные;
		
		РасшифровкаРазовых = ЗапросДляРасшифровкиРазовыхНаСервере(ТекСтрока.Услуга);
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("РасшифровкаРазовых",РасшифровкаРазовых);
		
		ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаРасшифровкиРазовыхУправляемая", ПараметрыФормы, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

