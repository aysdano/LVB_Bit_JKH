&НаСервере
Функция МассивСобственников(Лс)
	
	МассивСобственников = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади КАК ДоляПлощади,
	|	бит_ПроживающиеПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК лб_ДоляПлощадиСтрокой
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(, ЛицевойСчет = &ЛС) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади > 0";
	
	Запрос.УстановитьПараметр("ЛС", ЛС);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивСобственников = РезультатЗапроса.Выгрузить();
	Возврат МассивСобственников.Количество();
	
КонецФункции

&НаСервере
Функция ПолучитьПравоустанавливающиеДокументы(Проживающий, ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("бит_ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("бит_Проживающий", Проживающий);
	
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ПравоустанавливающиеДокументы.Ссылка КАК Ссылка,
	|	бит_ПравоустанавливающиеДокументы.ВерсияДанных КАК ВерсияДанных,
	|	бит_ПравоустанавливающиеДокументы.ПометкаУдаления КАК ПометкаУдаления,
	|	бит_ПравоустанавливающиеДокументы.Код КАК Код,
	|	бит_ПравоустанавливающиеДокументы.Наименование КАК Наименование,
	|	бит_ПравоустанавливающиеДокументы.НомерДокумента КАК НомерДокумента,
	|	бит_ПравоустанавливающиеДокументы.ДатаДокумента КАК ДатаДокумента,
	|	бит_ПравоустанавливающиеДокументы.ОрганизацияВыдавшаяДокумент КАК ОрганизацияВыдавшаяДокумент,
	|	бит_ПравоустанавливающиеДокументы.ВидДокумента КАК ВидДокумента,
	|	бит_ПравоустанавливающиеДокументы.лб_Архив КАК лб_Архив,
	|	бит_ПравоустанавливающиеДокументы.лб_ИспользоватьАрхивДляФЛС КАК лб_ИспользоватьАрхивДляФЛС,
	|	бит_ПравоустанавливающиеДокументы.лб_НомерЛС10 КАК лб_НомерЛС10,
	|	бит_ПравоустанавливающиеДокументы.бит_Проживающий КАК бит_Проживающий,
	|	бит_ПравоустанавливающиеДокументы.бит_ЛицевойСчет КАК бит_ЛицевойСчет,
	|	бит_ПравоустанавливающиеДокументы.бит_Архивный КАК бит_Архивный,
	|	бит_ПравоустанавливающиеДокументы.бит_ДатаВнесенияДокументов КАК бит_ДатаВнесенияДокументов,
	|	бит_ПравоустанавливающиеДокументы.Предопределенный КАК Предопределенный,
	|	бит_ПравоустанавливающиеДокументы.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	|	бит_ПравоустанавливающиеДокументы.Представление КАК Представление
	|ИЗ
	|	Справочник.бит_ПравоустанавливающиеДокументы КАК бит_ПравоустанавливающиеДокументы
	|ГДЕ
	|	бит_ПравоустанавливающиеДокументы.бит_ЛицевойСчет = &бит_ЛицевойСчет
	|	И бит_ПравоустанавливающиеДокументы.бит_Архивный = ЛОЖЬ
	|	И бит_ПравоустанавливающиеДокументы.бит_Проживающий = &бит_Проживающий";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		стрДокументы = "";
		Пока Выборка.Следующий() Цикл
			Если ЗначениеЗаполнено(Выборка.НомерДокумента) ИЛИ ЗначениеЗаполнено(Выборка.ДатаДокумента) Тогда
				стрДокументы = "" + стрДокументы + Выборка.Наименование + " " + Выборка.НомерДокумента + " от " + Формат(Выборка.ДатаДокумента, "ДЛФ=Д") + " г." + "; ";
			Иначе
				стрДокументы = "" + стрДокументы + Выборка.Представление + "; ";	
			КонецЕсли; 			
		КонецЦикла; 
		Возврат стрДокументы;
	Иначе
		Возврат "";
		
	КонецЕсли;  
	
КонецФункции

&НаКлиенте
Процедура СформироватьФайлНаКлиенте()
	
	Если ФорматФайла = "csv" Тогда
		ПолноеИмяФайла = Каталог + "\" + ИмяФайла + " " + Формат(ТекущаяДата(),"ДЛФ=Д") + ".csv";
		ИмяВременногоФайла = КаталогВременныхФайлов() + Новый УникальныйИдентификатор + ".csv";
		АдресНаСервере = СформироватьCSVФайлНаКлиенте(ПолноеИмяФайла, ИмяВременногоФайла);
	ИначеЕсли ФорматФайла = "dbf" Тогда
		ПолноеИмяФайла = Каталог + "\" + ИмяФайла + Формат(ТекущаяДата(),"ДЛФ=Д") + ".dbf";
		ИмяВременногоФайла = КаталогВременныхФайлов() + Новый УникальныйИдентификатор + ".dbf";
		АдресНаСервере = СформироватьDBFФайлНаКлиенте(ПолноеИмяФайла, ИмяВременногоФайла);
	ИначеЕсли ФорматФайла = "xlsx" Тогда
		ПолноеИмяФайла = Каталог + "\" + ИмяФайла + " " + Формат(ТекущаяДата(),"ДЛФ=Д") + ".xlsx";
		ИмяВременногоФайла = КаталогВременныхФайлов() + Новый УникальныйИдентификатор + ".xlsx";
		АдресНаСервере = СформироватьXLSXФайлНаКлиенте(ПолноеИмяФайла, ИмяВременногоФайла);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция СформироватьCSVФайлНаКлиенте(ПолноеИмяФайла, ИмяВременногоФайла)
	
	ПолноеИмяФайла = Каталог + "\" + Формат(ТекущаяДата(),"ДФ='dd-MM-yyyy HH.mm.ss'") + ".csv";
	ИмяВременногоФайла = КаталогВременныхФайлов() + Новый УникальныйИдентификатор + ".csv";  
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		ПолноеИмяФайла = Каталог + "\" + ИмяФайла + ".csv";	
	КонецЕсли; 
	
	Попытка
		
		Кодировка = КодировкаТекста.Системная;
		ТекстовыйФайлЗапись = Новый ЗаписьТекста(ИмяВременногоФайла, Кодировка);
		
		СтрокаШапки = "C_SAN;IND;LIC;FAMIL;IMJA;OTCH;DROG;KOD_KLADR;FIAS;NYLIC;NDOM;LDOM;NKW;LKW;KSS;ROPL;Пл_МОП;KCHLS;KSOB;OKS;IN_DATE;OUT_DATE;TEL;V_DOK;S_DOK;N_DOK;D_DOK;KEM_V;ДокументыНаКвартиру;";
		
		ТекстовыйФайлЗапись.ЗаписатьСтроку(СтрокаШапки);
		
		Для каждого Строка Из ТаблицаИтог Цикл
			
			Разделитель = ";";
			ТекстовыйДокумент = "";
			
			ТекстовыйДокумент = 
			Строка.C_SAN + Разделитель + 
			Строка.IND + Разделитель + 
			Строка.LIC + Разделитель +	
			Строка.FAMIL + Разделитель +
			Строка.IMJA + Разделитель +
			Строка.OTCH + Разделитель +
			Строка.DROG + Разделитель +
			Строка.KOD_KLADR + Разделитель +
			Строка.FIAS + Разделитель +
			Строка.NYLIC + Разделитель +
			Строка.NDOM + Разделитель +
			Строка.LDOM + Разделитель +
			Строка.NKW + Разделитель +
			Строка.LKW + Разделитель +
			Строка.KSS + Разделитель +
			Строка.ROPL + Разделитель +
			Строка.Пл_МОП + Разделитель +
			Строка.KCHLS + Разделитель +
			Строка.KSOB + Разделитель +
			Строка.OKS + Разделитель +
			Строка.IN_DATE + Разделитель +
			Строка.OUT_DATE + Разделитель +
			Строка.TEL + Разделитель +
			Строка.V_DOK + Разделитель +
			Строка.S_DOK + Разделитель +
			Строка.N_DOK + Разделитель +
			Строка.D_DOK + Разделитель +
			Строка.KEM_V + Разделитель +
			Строка.ДокументыНаКвартиру + Разделитель;
			
			ТекстовыйФайлЗапись.ЗаписатьСтроку(ТекстовыйДокумент);
			
		КонецЦикла;
		
		ТекстовыйФайлЗапись.Закрыть();
		АдресНаСервере = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), УникальныйИдентификатор);
		
		ПолучитьФайл(АдресНаСервере, ПолноеИмяФайла, Ложь);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Создан файл: " + ПолноеИмяФайла;
		Сообщение.Сообщить();
		
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
			//ОписаниеОшибки()
		КонецПопытки; 
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
КонецФункции

&НаКлиенте
Функция СформироватьDBFФайлНаКлиенте(ПолноеИмяФайла, ИмяВременногоФайла)
	
	ПолноеИмяФайла = Каталог + "\" + ИмяФайла + ".dbf";
	//ИмяВременногоФайла = КаталогВременныхФайлов() + Новый УникальныйИдентификатор + ".dbf";
	
	Попытка
		
		ФайлВыгрузки = Новый XBase();
		ФайлВыгрузки.Кодировка = КодировкаXBase.OEM;
		
		ФайлВыгрузки.Поля.Добавить("C_SAN", "S", 100);  
		ФайлВыгрузки.Поля.Добавить("IND", "S", 100);
		ФайлВыгрузки.Поля.Добавить("LIC"  , "S", 100);
		ФайлВыгрузки.Поля.Добавить("FAMIL"   ,"S", 100);
		ФайлВыгрузки.Поля.Добавить("IMJA"  , "S", 100);
		ФайлВыгрузки.Поля.Добавить("OTCH"  , "S", 100);
		ФайлВыгрузки.Поля.Добавить("DROG" , "S", 100);
		ФайлВыгрузки.Поля.Добавить("KOD_KLADR"   , "S", 100);	
		ФайлВыгрузки.Поля.Добавить("FIAS"  , "S", 100);
		ФайлВыгрузки.Поля.Добавить("NYLIC" , "S", 100);
		ФайлВыгрузки.Поля.Добавить("NDOM"  , "S", 100);
		ФайлВыгрузки.Поля.Добавить("LDOM"   , "S", 100);
		ФайлВыгрузки.Поля.Добавить("NKW" , "S", 100);
		ФайлВыгрузки.Поля.Добавить("LKW"    , "S", 100);
		ФайлВыгрузки.Поля.Добавить("KSS" , "S", 100);
		ФайлВыгрузки.Поля.Добавить("ROPL" , "S", 100);
		ФайлВыгрузки.Поля.Добавить("Pl_MOP", "S", 100);
		ФайлВыгрузки.Поля.Добавить("KCHLS", "S", 100);
		ФайлВыгрузки.Поля.Добавить("KSOB"  , "S", 100);
		ФайлВыгрузки.Поля.Добавить("OKS", "S", 100);
		ФайлВыгрузки.Поля.Добавить("IN_DATE"	, "S", 100);
		ФайлВыгрузки.Поля.Добавить("OUT_DATE", "S", 100);
		ФайлВыгрузки.Поля.Добавить("TEL","S", 100);
		ФайлВыгрузки.Поля.Добавить("V_DOK","S", 100);
		ФайлВыгрузки.Поля.Добавить("S_DOK","S", 100);
		ФайлВыгрузки.Поля.Добавить("N_DOK","S", 100);
		ФайлВыгрузки.Поля.Добавить("D_DOK","S", 100);
		ФайлВыгрузки.Поля.Добавить("KEM_V","S", 100);
		ФайлВыгрузки.Поля.Добавить("Dok_Na_Kv","S", 500);
		ФайлВыгрузки.Поля.Добавить("Dok_Na_Kv1","S", 500);
		ФайлВыгрузки.Поля.Добавить("Dok_Na_Kv2","S", 500);
		
		//ФайлВыгрузки.СоздатьФайл(ИмяВременногоФайла);
		ФайлВыгрузки.СоздатьФайл(ПолноеИмяФайла);
		
		ФайлВыгрузки.ОчиститьФайл();
		
		Для каждого Строка Из ТаблицаИтог Цикл
			
			ФайлВыгрузки.Добавить();
			
			ФайлВыгрузки.C_SAN = Строка.C_SAN;
			ФайлВыгрузки.IND = Строка.IND;
			ФайлВыгрузки.LIC = Строка.LIC;
			ФайлВыгрузки.FAMIL = Строка.FAMIL;
			ФайлВыгрузки.IMJA = Строка.IMJA;
			ФайлВыгрузки.OTCH = Строка.OTCH;
			ФайлВыгрузки.DROG = Строка.DROG;
			ФайлВыгрузки.KOD_KLADR = Строка.KOD_KLADR;
			ФайлВыгрузки.FIAS = Строка.FIAS;
			ФайлВыгрузки.NYLIC = Строка.NYLIC;
			ФайлВыгрузки.NDOM= Строка.NDOM;
			ФайлВыгрузки.LDOM = Строка.LDOM;
			ФайлВыгрузки.NKW = Строка.NKW;
			ФайлВыгрузки.LKW = Строка.LKW;
			ФайлВыгрузки.KSS = Строка.KSS;
			ФайлВыгрузки.ROPL= Строка.ROPL;
			ФайлВыгрузки.Pl_MOP = Строка.Пл_МОП;
			ФайлВыгрузки.KCHLS = Строка.KCHLS;
			ФайлВыгрузки.KSOB = Строка.KSOB;
			ФайлВыгрузки.OKS = Строка.OKS;
			ФайлВыгрузки.IN_DATE = Строка.IN_DATE;
			ФайлВыгрузки.OUT_DATE = Строка.OUT_DATE;
			ФайлВыгрузки.TEL = Строка.TEL;
			ФайлВыгрузки.V_DOK = Строка.V_DOK;
			ФайлВыгрузки.S_DOK= Строка.S_DOK;
			ФайлВыгрузки.N_DOK = Строка.N_DOK;
			ФайлВыгрузки.D_DOK = Строка.D_DOK;
			ФайлВыгрузки.KEM_V = Строка.KEM_V;
			
			
			Если СтрДлина(Строка.ДокументыНаКвартиру) > 244 Тогда
				ФайлВыгрузки.Dok_Na_Kv = Лев(Строка.ДокументыНаКвартиру, 244);
				нСтрока = Прав(Строка.ДокументыНаКвартиру,  СтрДлина(Строка.ДокументыНаКвартиру) - 244);
				Если СтрДлина(нСтрока) > 244 Тогда
					ФайлВыгрузки.Dok_Na_Kv1 = Лев(нСтрока, 244);
					ннСтрока = Прав(нСтрока,  СтрДлина(нСтрока) - 244);
					ФайлВыгрузки.Dok_Na_Kv2 = ннСтрока;	
				Иначе
					ФайлВыгрузки.Dok_Na_Kv1 = нСтрока;
				КонецЕсли;
			Иначе
				ФайлВыгрузки.Dok_Na_Kv = Строка.ДокументыНаКвартиру;
			КонецЕсли;
			
			ФайлВыгрузки.Записать();
			
		КонецЦикла;
		
		//АдресНаСервере = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), УникальныйИдентификатор);
		//
		//ПолучитьФайл(АдресНаСервере, ПолноеИмяФайла, Ложь);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Создан файл: " + ПолноеИмяФайла;
		Сообщение.Сообщить();
		
		Попытка
			УдалитьФайлы(ИмяВременногоФайла);
		Исключение
			//ОписаниеОшибки()
		КонецПопытки; 
		
		//Если ФайлВыгрузки.Открыта() Тогда
		//	ФайлВыгрузки.ЗакрытьФайл();
		//КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла. " + ОписаниеОшибки());
	КонецПопытки;
	
КонецФункции

&НаКлиенте
Функция СформироватьXLSXФайлНаКлиенте(ПолноеИмяФайла, ИмяВременногоФайла)
	
	СформироватьXLSXФайлНаСервере(ПолноеИмяФайла, ИмяВременногоФайла);
	
	Попытка
		
		ПолучитьФайл(АдресВоВременномХранилище, ПолноеИмяФайла, Ложь);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Создан файл: " + ПолноеИмяФайла;
		Сообщение.Сообщить();
		
	Исключение
		Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
КонецФункции

&НаСервере
Функция СформироватьXLSXФайлНаСервере(ПолноеИмяФайла, ИмяВременногоФайла)
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьДетальныхЗаписей = Макет.ПолучитьОбласть("Строка");
	
	ТабДок.Очистить();
	ТабДок.Вывести(ОбластьШапка);
	Для каждого стр Из ТаблицаИтог Цикл
		
		ОбластьДетальныхЗаписей.Параметры.Заполнить(стр);
		ТабДок.Вывести(ОбластьДетальныхЗаписей);
		
	КонецЦикла;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), УникальныйИдентификатор);
	
КонецФункции

&НаСервере
Функция ЧастиИмени(ФамилияИмяОтчество)
	
	Результат = Новый Структура("Фамилия,Имя,Отчество");
	
	ЧастиИмени = СтрРазделить(ФамилияИмяОтчество, " ", Ложь);
	
	Если ЧастиИмени.Количество() >= 1 Тогда
		Результат.Фамилия = ЧастиИмени[0];
	КонецЕсли;
	
	Если ЧастиИмени.Количество() >= 2 Тогда
		Результат.Имя = ЧастиИмени[1];
	КонецЕсли;
	
	Если ЧастиИмени.Количество() >= 3 Тогда
		Результат.Отчество = ЧастиИмени[2];
	КонецЕсли;
	
	Если ЧастиИмени.Количество() > 3 Тогда
		ДополнительныеЧастиОтчества = Новый Массив;
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'оглы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'улы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'уулу'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'кызы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'гызы'"));
		ДополнительныеЧастиОтчества.Добавить(НСтр("ru = 'угли'"));
		
		Если ДополнительныеЧастиОтчества.Найти(НРег(ЧастиИмени[3])) <> Неопределено Тогда
			Результат.Отчество = Результат.Отчество + " " + ЧастиИмени[3];
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Функция ПолучитьФамилияИмяОтчество(Знач ФамилияИмяОтчество) 
	
	Если ТипЗнч(ФамилияИмяОтчество) = Тип("Строка") Тогда
		ФамилияИмяОтчество = ЧастиИмени(ФамилияИмяОтчество);
	КонецЕсли;
	
	Фамилия = ФамилияИмяОтчество.Фамилия;
	Имя = ФамилияИмяОтчество.Имя;
	Отчество = ФамилияИмяОтчество.Отчество;
	
	Если ПустаяСтрока(Имя) Тогда
		Возврат Фамилия;
	КонецЕсли;
	
	Если ПустаяСтрока(Отчество) Тогда
		Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 %2.", Фамилия, Лев(Имя, 1));
	КонецЕсли;
	
	Возврат СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("%1 %2. %3.", Фамилия, Лев(Имя, 1), Лев(Отчество, 1));
	
КонецФункции

&НаСервере
Функция ПолучитьМассивУчастков()
	
	МассивУчастков = Новый Массив;
	
	Отбор = Новый Структура("ВыполняетсяОтбор", Истина);
	НайденныеСтроки = Участки.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() = 0 Тогда
		МассивУчастков = Участки.Выгрузить(,"Участок").ВыгрузитьКолонку("Участок");
	Иначе 	
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			МассивУчастков.Добавить(НайденнаяСтрока.Участок);	
		КонецЦикла; 	
	КонецЕсли;
	
	Возврат МассивУчастков;
	
КонецФункции

&НаСервере
Функция ПолучитьМассивАдресов()
	
	МассивАдресов = Новый Массив;
	
	МассивАдресов = Адреса.Выгрузить(,"Адрес").ВыгрузитьКолонку("Адрес");
	
	Возврат МассивАдресов;
	
КонецФункции

&НаСервере
Функция СтрокаВДату(Знач ДатаСтрока) Экспорт
	
	ПозицияПробела = СтрНайти(ДатаСтрока, " ", НаправлениеПоиска.СНачала);
	Если ПозицияПробела > 0 Тогда
		ДатаСтрока = Лев(ДатаСтрока, ПозицияПробела - 1);
	КонецЕсли;
	ДатаСтрока = СокрЛП(СтрЗаменить(ДатаСтрока, ".", ""));
	ДатаСтрока = Сред(ДатаСтрока, 5) + Сред(ДатаСтрока, 3, 2) + Лев(ДатаСтрока, 2);
	Если СтрДлина(ДатаСтрока) = 6 Тогда
		ДатаСтрока = "20" + ДатаСтрока;
	КонецЕсли;
	
	ОписаниеТипа = Новый ОписаниеТипов("Дата");
	Результат    = ОписаниеТипа.ПривестиЗначение(ДатаСтрока);
	
	Возврат Результат;
	
КонецФункции 

