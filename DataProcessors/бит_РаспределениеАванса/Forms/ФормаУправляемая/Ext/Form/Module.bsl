			|	ТабУслуг.СчетУчетаНДСПоРеализации,
			|	ТабУслуг.СчетДоходов,
			|	ТабУслуг.СчетРасходов,
			|	ТабУслуг.Цена,
			|	ТабУслуг.Сумма,
			|	ТабУслуг.СуммаНДС,
			|	ТабУслуг.ПлановаяСтоимость,
			|	ТабУслуг.СуммаПлановая
			|ИЗ
			|	ТабУслуг КАК ТабУслуг
			|ИТОГИ ПО
			|	Контрагент,
			|	ДоговорКонтрагента";
			
			ВыборкаКонтрагент = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
