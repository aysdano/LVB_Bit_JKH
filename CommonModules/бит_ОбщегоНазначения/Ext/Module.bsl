			Или ШаблонИзвещения = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугамБезСтрахования 
			Или (ШаблонИзвещения.Сальдо = Перечисления.ДаНет.Да И ШаблонИзвещения.Кредит = Перечисления.ДаНет.Да) тогда
			
			БазоваяСумма = 0;
			Для каждого ТекСтрока Из КоммунальныеУслуги Цикл
				БазоваяСумма = БазоваяСумма + ТекСтрока.Сальдо;
				ИтогСальдо = ИтогСальдо + ?(ТекСтрока.Сальдо > 0 , ТекСтрока.Сальдо,0);
			КонецЦикла; 
			
			
			//Начисление (пропорциональное) Суммы по Сальдо, за вычетом переплаты.
			Для Каждого ТекСтрока Из КоммунальныеУслуги Цикл 
				СуммаСписания = ?(ИтогСальдо = 0 ИЛИ БазоваяСумма < 0
				,0
				,?(ТекСтрока.Сальдо > 0 , ТекСтрока.Сальдо,0)/ИтогСальдо) * Мин(СуммаДокумента, БазоваяСумма);
				
				ТекСтрока.Сумма = ТекСтрока.Сумма + Мин(СуммаСписания,?(ТекСтрока.Сальдо > 0 , ТекСтрока.Сальдо,0));
				СуммаДляРаспределения = СуммаДляРаспределения - Мин(СуммаСписания,?(ТекСтрока.Сальдо > 0 , ТекСтрока.Сальдо,0)); 
			КонецЦикла;
			
			Если СуммаДляРаспределения < 0 Тогда
				СуммаДляРаспределения = 0;
			КонецЕсли;	
