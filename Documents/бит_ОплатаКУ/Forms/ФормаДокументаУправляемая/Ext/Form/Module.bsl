		Сообщение.Текст = "Не выбран лицевой счет.";
		Сообщение.Сообщить();
		
	Иначе
		ВыбЗначение = ВыбЭлемент.Значение;
	КонецЕсли;
	
	мКэшЗначений.ВыбЗначение = ВыбЗначение;
КонецФункции

