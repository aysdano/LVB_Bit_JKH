&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	Объект.Дата = ТекущаяДата();      Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_НастройкаПараметровЖКХСрезПоследних.Организация
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, ) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Объект.Дата));	
	
	таб = Запрос.Выполнить().Выгрузить();
	если таб.Количество() > 0 тогда
		Объект.Организация = таб[0].Организация;
	конецесли;	

	ЗаполнитьТабличнуюЧасть();
КонецПроцедуры

