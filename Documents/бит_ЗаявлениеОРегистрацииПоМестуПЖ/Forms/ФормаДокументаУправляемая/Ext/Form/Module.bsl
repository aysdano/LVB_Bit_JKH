&наСервереБезКонтекста
Процедура ЗаполнитьАдресИзЛицевогоСчета(Приемник, ЛицевойСчет)
	
	НаборЗаписей = НЕОПРЕДЕЛЕНО;
	
	бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей, ЛицевойСчет.Здание);
	
	НаборЗаписей.Отбор.Тип.Установить(Перечисления.бит_ТипыКонтактнойИнформации.Адрес, Истина);
	НаборЗаписей.Отбор.Вид.Установить(Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания, Истина);
	
	НаборЗаписей.Прочитать();
	
	Попытка
		ЗаписьАдрес = НаборЗаписей[0];
	Исключение
		ЗаписьАдрес = Неопределено;
		
	КонецПопытки;
	
	Приемник = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ЗаписьАдрес);
	
	Приемник = Приемник + Строка(ЛицевойСчет.Квартира);
	
КонецПроцедуры

