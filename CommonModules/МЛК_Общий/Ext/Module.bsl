Функция ОтправитьКвитанции()
	Если Не ПроверитьЕстьЛиИнтернетСоединение() Тогда 
		Возврат Ложь;
	КонецЕсли;
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл
		Если Настройки.НеИспользоватьИнтеграцию Тогда Продолжить; КонецЕсли;
		Если Не ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоЛицевымСчетам) И
			Не ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоСчетчикам) Тогда
			Продолжить;
		КонецЕсли;
		Возврат ПроверитьИОтправитьКвитанцииНаСервере(Настройки);
	КонецЦикла;
КонецФункции
Функция ПроверитьИОтправитьКвитанцииНаСервере(Настройки)
	ЕстьОтвет = Истина;
	// Журнал
	ЖурналЗапросБезКодировки   = "";
	ЖурналСтрокаОписанияОшибки = "";
	ЖурналВремяНачало          = ТекущаяДатаСеанса();
	// Журнал
	
	СтатусЗавершено=Настройки.СтатусЗакрыто;
	СтатусНовое=Настройки.СтатусОтправленоВУК;
	СтатусНовое = СтрЗаменить(СтатусНовое," ","");
	СтатусНовое = СтрЗаменить(СтатусНовое,Символы.НПП,"");
	
	АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
	АдресРесурса = "/api/v4/events?ApplicationId="+Настройки.НомерПриложения+"&query=";
	
	// Журнал
	ЖурналЗапросБезКодировки = Строка(АдресСервисаСтр)+Строка(АдресРесурса);
	
	СтрокаПараметров = 
	"["
	+"{"
	+"""field"""                +":"+ """StatusId"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+""""+Строка(СтатусНовое)+""""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+","
	+"{"
	+"""field"""                +":"+ """ActionName"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+"""Запрос Квитанции-1"""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+"]";
	
	ЖурналЗапросБезКодировки = Строка(ЖурналЗапросБезКодировки) + СТрока(СтрокаПараметров);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Настройки.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		ЕстьОтвет = Ложь;
		МЛК_Общий.ЗаписатьДанныеВЖурнал("Запрос квитанции","",,"Нет связи с сервером",ОписаниеОшибки(),ТекущаяДатаСеанса());	
	КонецПопытки;
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				Если СокрЛП(РезультатПроверки)="false" Тогда
				Иначе
					
					
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
					ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
					ЧтениеJSON.Закрыть();
					
					Если ЗагруженныеДанные.Количество()<>0 Тогда
						ТЗ = РаспарситьВТаблицуЗапросКвитанции(ЗагруженныеДанные);
						
						
						ПериодНачислений = КонецМесяца(ТекущаяДатаСеанса());
						ОтправитьКвитанцииПоЛицевымСчетам(ТЗ,ПериодНачислений,Настройки);
						
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе
			ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
			ИмяСобытияВЖурнал = "Запрос квитанции";
			КодСостояния = Ответ.КодСостояния;
			СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
		КонецЕсли;
		
	КонецЕсли;
КонецФункции
Функция РаспарситьВТаблицуЗапросКвитанции(Данные)	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ЛС");
	ТЗ.Колонки.Добавить("Статус");
	ТЗ.Колонки.Добавить("ИД_События");
	ТЗ.Колонки.Добавить("ИД_Объекта");
	
	Для Каждого стр Из Данные Цикл
		
		Нов = ТЗ.Добавить();
		
		Нов.ЛС            = Стр["object_Код1С"];
		Нов.Статус        = Стр["StatusId"]; // 17 - Обработан;  15 - В Работе
		Нов.ИД_События    = Стр["id"];       // ИД события по которому будем менять статус
