									СНИЛС = Строка("СНИЛС" + 1);
									
									
								КонецЕсли;	
								
							КонецЕсли;
							
							Если Значение = 1 Тогда
								
								ЗаявлениеОСнятии.Параметры[СНИЛС] = Лев(ВыборкаСН.ПроживающийСтраховойНомерПФР,Значение);	
