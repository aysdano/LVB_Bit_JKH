&НаКлиенте
Процедура СоздатьСправкуОСоставеСемьиЗавершение1Бит(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		
		Результат = ЗаписатьДокументНаСервере();
		
		Если Результат Тогда
			
			Результат = Сформировать("СправкаОСоставеСемьиБит");
			
			АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
			
			бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
			,"бит_СправкаОСоставеСемьи"
			,"СправкаОСоставеСемьиБит"
			,"Справка о составе семьи"
			
			,АдресТабличногоДокументаВоВременномХранилище
			
			,Объект.Ссылка);
			
		Иначе
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("СоздатьСправкуОСоставеСемьиЗавершениеБит", ЭтотОбъект), "Операция не выполнена!");
			
		КонецЕсли;   
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЛСБезРег(Команда)
	
	
	Если Не ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Лицевой счет не указан!");
		
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не заполнено Физ. лицо!");
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ФизическиеЛица.Количество() > 0 Тогда
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПоЛСЗавершениеБезДаты", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;      
	КонецЕсли; 
ФормированиеТабЧасти();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЛСЗавершениеБезДаты(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса ;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;      
	
ФормированиеТабЧасти();

КонецПроцедуры
	

&НаСервере
Процедура ФормированиеТабЧасти()
	Объект.ФизическиеЛица.Очистить();

	
Запрос = Новый Запрос;

Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
Запрос.УстановитьПараметр("Дата", ТекущаяДата());

Запрос.Текст = "ВЫБРАТЬ
               |	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо,
               |	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК РодственныеОтношения,
               |	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
               |	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации
               |ИЗ
               |	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
               |			&Дата,
               |			ЛицевойСчет = &ЛицевойСчет
               |				И ДатаРегистрации <> ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)) КАК бит_ПроживающиеПоЛССрезПоследних";

РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если  ВыборкаДетальныеЗаписи.ФизическоеЛицо <> Объект.ФизЛицо И НЕ ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.ДатаСнятияСРегистрации)  Тогда
		Стр = Объект.ФизическиеЛица.Добавить();
		Стр.ФизическоеЛицо = ВыборкаДетальныеЗаписи.ФизическоеЛицо;
		Стр.РодственныеОтношения = ВыборкаДетальныеЗаписи.РодственныеОтношения;
		Стр.ДатаРождения = ВыборкаДетальныеЗаписи.ДатаРождения;
		КонецЕсли;
	КонецЦикла;
	

КонецПроцедуры


 
