	               |	втРезультат.КонечноеЗначение КАК ПоказаниеНаКонец,
	               |	втРезультат.ОбъемКУ КАК ОбъемКУ,
	               |	втРезультат.КТР КАК КТР
	               |ИЗ
	               |	втРезультат КАК втРезультат
	               |ГДЕ
	               |	втРезультат.УслугаЖКХ = &УслугаГВС";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("УслугаЭлектроэнергия", УслугаЭлектроэнергия);
	Запрос.УстановитьПараметр("УслугаХВС", УслугаХВС);
	Запрос.УстановитьПараметр("УслугаГВС", УслугаГВС);
	ПакетРезультатов = Запрос.ВыполнитьПакет();
	
	Результат.Электроэнергия = ПакетРезультатов[1].Выгрузить();
	Результат.ХВС = ПакетРезультатов[2].Выгрузить();
	Результат.ГВС = ПакетРезультатов[3].Выгрузить();
	Результат.Вставить("ДанныеЕсть", Результат.Электроэнергия.Количество() > 0 
										ИЛИ Результат.ХВС.Количество() > 0 
										ИЛИ Результат.ГВС.Количество() > 0);
	
	Возврат Результат;
	
КонецФункции

