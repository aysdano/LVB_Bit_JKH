Процедура ОбновитьТаблицаПлатежиГИСЖКХ12Получатели(ТаблицаПлатежиГИСЖКХ12Получатели, Строка)
	
	// Только по графе ГЦЖС кап. рем. (Суммируем).
	Если ЭтотОбъект.ПолучательПлатежа924 Тогда
		
		МассивСтрок = ТаблицаПлатежиГИСЖКХ12Получатели.НайтиСтроки(Новый Структура("ПолучательПлатежа", Строка.ПолучательПлатежа));
		Для Каждого Элт Из МассивСтрок Цикл
			Элт.РазмерВзносаНаКвМ = Строка.НастройкаСтавки;
			Элт.ВсегоНачислено	  = Элт.ВсегоНачислено + Строка.Начислено;
			Элт.ПерерасчетыВсего  = Элт.ПерерасчетыВсего + Строка.Разовые;
			Элт.ЛьготыСубсидии	  = Элт.ЛьготыСубсидии + Строка.Льгота;
			Элт.ПорядокРасчетов	  = ""; // Свободный комментарий 500 символов, не используется!.
			Элт.ИтогоКОплате	  = Элт.ИтогоКОплате + Строка.КОплатеЗаМесяц;
		КонецЦикла;
		
	Иначе
		//мТаблицаПерерасчетов
		
		Для Каждого Элт Из ТаблицаПлатежиГИСЖКХ12Получатели Цикл
			Элт.РазмерВзносаНаКвМ = Строка.НастройкаСтавки;
			Элт.ВсегоНачислено	  = Элт.ВсегоНачислено + Строка.Начислено;
			Элт.ПерерасчетыВсего  = Элт.ПерерасчетыВсего + Строка.Разовые;
			Элт.ЛьготыСубсидии	  = Элт.ЛьготыСубсидии + Строка.Льгота;
			Элт.ПорядокРасчетов	  = ""; // Свободный комментарий 500 символов, не используется!.
			Элт.ИтогоКОплате	  = Элт.ИтогоКОплате + Строка.КОплатеЗаМесяц;
			
			//25.10.2019
			если мТаблицаПерерасчетов.Количество() > 0 тогда				
			  Элт.ОснованиеПересчетов = НайтиОснованиеДляКапРемонта(мТаблицаПерерасчетов);            		     		  
			конецесли; 
		КонецЦикла;
		
	КонецЕсли;

КонецПроцедуры	

//25.10.2019
функция НайтиОснованиеДляКапРемонта(ТаблицаПерерасчетов)
	
	для каждого стр из ТаблицаПерерасчетов цикл
		
	  если стр.Услуга.ГрафаОтчетаГЦЖС = перечисления.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт тогда	
		  
		  возврат стр.Основание;
		  
	  конецесли;	  
		  
	конеццикла;	
	
	возврат "";
	
конецфункции	

