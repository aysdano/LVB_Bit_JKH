&НаСервере
// Функция формирует табличный документ с печатной формой приказа о проведении.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьЛСУП()
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаПрибытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаУбытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОписаниеДругойПричины,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдресЗапятые,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдресЗапятые
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("ЛСУП");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) Тогда
		
		СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.МестоРождения);
		ШапкаОбласть.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
		ШапкаОбласть.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
		ШапкаОбласть.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
		ШапкаОбласть.Параметры.СтранаРожд          = СтруктураМестоРождения.Страна;
		ШапкаОбласть.Параметры.НаселенныйПунктРожд = СтруктураМестоРождения.Село;
		
		Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.Пол) Тогда
			Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				
				ШапкаОбласть.Область("ПолМуж").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
				
			ИначеЕсли Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				
				ШапкаОбласть.Область("ПолЖен").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
				
			КонецЕсли;
		КонецЕсли;
		
		ШапкаОбласть.Параметры.Заполнить(Выборка);
		
		Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.ДатаРождения) Тогда
			
			ШапкаОбласть.Параметры.ДеньРожд  	= Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=dd");
			ДатаМесяц 							= Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРожд 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			МесяцРожд                         	= Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=MM");
			ШапкаОбласть.Параметры.МесяцРожд1 	= Сред(МесяцРожд,1,1);
			ШапкаОбласть.Параметры.МесяцРожд2 	= Сред(МесяцРожд,2,1);
			ГодРожд                           	= Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=yyyy");
			ШапкаОбласть.Параметры.ГодРожд1   	= Сред(ГодРожд,1,1);
			ШапкаОбласть.Параметры.ГодРожд2   	= Сред(ГодРожд,2,1);
			ШапкаОбласть.Параметры.ГодРожд3   	= Сред(ГодРожд,3,1);
			ШапкаОбласть.Параметры.ГодРожд4   	= Сред(ГодРожд,4,1);
			
		КонецЕсли;
		
		
		Если Объект.КонтактнаяИнформация.Количество() > 0 Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ОткудаПрибылПредставление);
			
			Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
			
			
			Если Строки.количество() = 0 и ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) Тогда
				
				СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
				
			ИначеЕсли НЕ Строки.количество() = 0 Тогда
				
				//  15.10.2018
				Если ЗначениеЗаполнено(Строки[0].Значение) Тогда					
					
					АдресПрибытияПредставление = Строки[0].Представление;
					СтруктураАдресПрибытия = ПолучитьАдресБСП(Строки[0].Значение);
					//---
				ИначеЕсли ЗначениеЗаполнено(Выборка.ОткудаПрибылАдресЗапятые) Тогда
					
					СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдресЗапятые);
					
				ИначеЕсли ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) Тогда
					
					Если Объект.ОткудаПрибылИзЛС Тогда
						
						
						Если НЕ ПустаяСтрока(Объект.ОткудаПрибылАдрес) Тогда
							ОткудаПрибылПредставление = бит_УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдресаПоСтрока(Объект.ОткудаПрибылАдрес);
							
							ОткудаПрибылКонтактнаяИнформацияНаСервере();	
							
						КонецЕсли;
						
						
						Если ЗначениеЗаполнено(ОткудаПрибылПредставлениеЗапятые) Тогда
							
							СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ОткудаПрибылПредставлениеЗапятые);
							
						КонецЕсли; 
					Иначе
						
						Попытка
							СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
							
						Исключение
							
							бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перезаполните откуда прибыл адрес");
							
							СтруктураАдресПрибытия = Неопределено;
						КонецПопытки;
						
					КонецЕсли; 
					
				Иначе
					
					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните откуда прибыл адрес");
					
					СтруктураАдресПрибытия = Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;			
			
		Иначе
			
			СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
			
		КонецЕсли;		
		
		
		Если НЕ СтруктураАдресПрибытия = Неопределено Тогда
			
			ШапкаОбласть.Параметры.ГосударствоПриб     = СтруктураАдресПрибытия.Страна;
			ШапкаОбласть.Параметры.РегионПриб          = СтруктураАдресПрибытия.Регион;
			ШапкаОбласть.Параметры.РайонПриб           = СтруктураАдресПрибытия.Район ;
			ШапкаОбласть.Параметры.ГородПриб           = СтруктураАдресПрибытия.Город ;
			
			ШапкаОбласть.Параметры.НаселенныйПунктПриб = ?(ПустаяСтрока(СтруктураАдресПрибытия.НаселенныйПункт)
			,СтруктураАдресПрибытия.Улица 
			+ ", д." + СтруктураАдресПрибытия.Дом 
			+?(ЗначениеЗаполнено(СтруктураАдресПрибытия.корпус),", корп. " + СтруктураАдресПрибытия.корпус,"") 
			+ ", кв." + СтруктураАдресПрибытия.Квартира
			, СтруктураАдресПрибытия.НаселенныйПункт);
			
		КонецЕсли;
		
		НаборЗаписей = НЕОПРЕДЕЛЕНО;
		бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
		ИскомаяСтрока = Неопределено;
		Для каждого СтрокаНабор Из НаборЗаписей  Цикл
			
			Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
				И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
				Тогда 
				ИскомаяСтрока = СтрокаНабор;
			КонецЕсли;	
			
		КонецЦикла;
		
		Если Объект.КонтактнаяИнформация.Количество() > 0 Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.КудаВыписанПредставление);
			
			Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
			
			
			Если Строки.количество() = 0 и ЗначениеЗаполнено(Выборка.КудаВыписанАдрес) Тогда
				
				СтруктураАдресУбытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.КудаВыписанАдрес);
				
			ИначеЕсли НЕ Строки.количество() = 0 Тогда
				
				// 15.10.2018
				Если ЗначениеЗаполнено(Строки[0].Значение) Тогда					
					
					АдресУбытияПредставление = Строки[0].Представление;
					СтруктураАдресУбытия = ПолучитьАдресБСП(Строки[0].Значение);
					//---	
					
				ИначеЕсли ЗначениеЗаполнено(Выборка.КудаВыписанАдресЗапятые) Тогда
					
					СтруктураАдресУбытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.КудаВыписанАдресЗапятые);
					
				ИначеЕсли ЗначениеЗаполнено(Выборка.КудаВыписанАдрес) Тогда
					
					// Почтовый адрес здания.
					НаборЗаписей = НЕОПРЕДЕЛЕНО;
					бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
					ВыборкаПочтАдр = Неопределено;
					Для каждого СтрокаНабор Из НаборЗаписей  Цикл
						Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
							И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
							Тогда 
							ВыборкаПочтАдр = СтрокаНабор;
						КонецЕсли;	
					КонецЦикла;
					
					ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ВыборкаПочтАдр);
					СтруктураАдресУбытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
				Иначе
					
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Перезаполните куда убыл адрес";
					Сообщение.Сообщить();
					
					Возврат Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;			
			
		Иначе
			
			СтруктураАдресУбытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.КудаВыписанАдрес);
			
		КонецЕсли;		
		
		Если НЕ СтруктураАдресУбытия = Неопределено Тогда
			
			ШапкаОбласть.Параметры.РегионРег          = СтруктураАдресУбытия.Регион;
			ШапкаОбласть.Параметры.РайонРег           = СтруктураАдресУбытия.Район ;
			ШапкаОбласть.Параметры.ГородРег           = СтруктураАдресУбытия.Город ;
			ШапкаОбласть.Параметры.НаселенныйПунктРег = ?(ПустаяСтрока(СтруктураАдресУбытия.НаселенныйПункт)
			,СтруктураАдресУбытия.Улица 
			+ ", д." + СтруктураАдресУбытия.Дом 
			+?(ЗначениеЗаполнено(СтруктураАдресУбытия.корпус),", корп. " + СтруктураАдресУбытия.корпус,"") 
			+ ", кв." + СтруктураАдресУбытия.Квартира
			, СтруктураАдресУбытия.НаселенныйПункт);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	ДолжностноеЛицоОрганизации = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Выборка.Организация, Выборка.ДолжностноеЛицо, Выборка.Дата);
	ШапкаОбласть.Параметры.ДолжностноеЛицоОрганизации = ДолжностноеЛицоОрганизации;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция вызывает форму печати табличного документа с печатной формой.
// Инвентаризационной описи основных средств.
//
// Параметры:
//  ПечатьДвухЧастей - булево, печатать обе части заявления (Истина) или только верхнюю (Ложь).
//
// Возвращаемое значение:
//  Неопределено.
//
Функция ПечатьЗОССРУПМЖ(ПечатьДвухЧастей)
	
	ДлиннаСтрокиПФ = 95; //Для разбиения на строки, значение было изменено с 75 Дорошенко А.Ю 28.01.2023
	ДлиннаПолнойСтрокиПФ = 95;
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	
	// Добавление регистра сведений с ФИО ответственного за регистрацию.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация КАК Организация,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия КАК Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя КАК Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество КАК Отчество,
	|	ВЫБОР
	|		КОГДА бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения ЕСТЬ NULL
	|				ИЛИ бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ &Момент < бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ РАЗНОСТЬДАТ(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, &Момент, ГОД)
	|	КОНЕЦ КАК РегЛицоВозраст,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий КАК Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо КАК РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл КАК ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации КАК ВидОперации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	ЕСТЬNULL(бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид.КодПФР, """") КАК ДокументКодПФР,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ЕСТЬNULL(бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства КАК ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	ЕСТЬNULL(бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид.КодПФР, """") КАК ДокументПредКодПФР,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКодПодразделения КАК ДокументКодПодразделенияПред,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМС КАК ОрганФМСПрибытия,
	|	бит_ФИОПроживающихСрезПоследних1.Фамилия КАК ФамилияПред,
	|	бит_ФИОПроживающихСрезПоследних1.Имя КАК ИмяПред,
	|	бит_ФИОПроживающихСрезПоследних1.Отчество КАК ОтчествоПред,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо КАК ДолжностноеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата КАК Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.СтепеньРодства КАК СтепеньРодства,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдрес КАК ОткудаПрибылАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдрес КАК КудаВыписанАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаПрибытия КАК ДатаПрибытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаУбытия КАК ДатаУбытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЗаконныйПредставитель КАК ЗаконныйПредставитель,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.СтепеньРодстваЗаконногоПредставителя КАК СтепеньРодстваЗаконногоПредставителя,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПериодРегистрацииПоПрежнемуАдресуС КАК ПериодРегистрацииПоПрежнемуАдресуС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПериодРегистрацииПоПрежнемуАдресуПо КАК ПериодРегистрацииПоПрежнемуАдресуПо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМСКудаПрибыл КАК ОрганФМСКудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДанныеОПрибытии КАК ДанныеОПрибытии,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование КАК ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.Наименование КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВременнаяРегистрация КАК ВременнаяРегистрация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ответственный КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылИзЛС КАК ОткудаПрибылИзЛС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанИзЛС КАК КудаВыписанИзЛС,
	|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК ПредставлениеКвартирыЛС
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ФИОПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если ЗначениеЗаполнено(Выборка.ЗаконныйПредставитель) Тогда
		
		ЗапросПаспортныеДанныеЗаконногоПредставителя = Новый Запрос;
		ЗапросПаспортныеДанныеЗаконногоПредставителя.Текст = "ВЫБРАТЬ
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
		|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения КАК КодПодразделенияДокумента
		|ИЗ
		|	РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Период, ФизЛицо = &ЗаконныйПредставитель) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних ";
		
		
		ЗапросПаспортныеДанныеЗаконногоПредставителя.УстановитьПараметр("ЗаконныйПредставитель", Выборка.ЗаконныйПредставитель);
		ЗапросПаспортныеДанныеЗаконногоПредставителя.УстановитьПараметр("Период", Объект.Дата);
		ПаспортныеДанныеЗП = ЗапросПаспортныеДанныеЗаконногоПредставителя.Выполнить().Выбрать();
		ПаспортныеДанныеЗП.Следующий();
		
	КонецЕсли;
	
	ЗапросПравоустанавливающиеДокументы = Новый Запрос;
	ЗапросПравоустанавливающиеДокументы.Текст = "ВЫБРАТЬ
