// БИТ_ЖКХ добавление кода Начало: 27.02.2012 
// Функция получает ответственного по ЛС на текущую дату.
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//  <Параметр2>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//
// Возвращаемое значение:
//   <Тип.Вид>   - <описание возвращаемого значения>.
//
Функция ПолучитьОтветственногоПоЛС() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.Контрагент,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ОтветственныеЛицаПоКУСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());
	Запрос.УстановитьПараметр("ЛицевойСчет", Ссылка);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()>0 Тогда
		Ответственный = Результат[0].ФизЛицо;
	Иначе
		Ответственный = Справочники.бит_Проживающие.ПустаяСсылка();
	КонецЕсли; 
	Возврат Ответственный;
	
КонецФункции // ПолучитьОтветственногоПоЛС()

