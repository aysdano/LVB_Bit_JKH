// БИТ_ЖКХ 13.04.2021
&НаКлиенте
Процедура ВводПоказанийПодкрутки(Команда)
	ВводПоказанийПодкруткиНаСервере();
КонецПроцедуры

&НаСервере
Процедура ВводПоказанийПодкруткиНаСервере()
	
	    ДокументВводПоказаний = Документы.бит_ВводПоказанийПоСчетчикам.СоздатьДокумент();
		
		ДокументВводПоказаний.Дата        = Объект.ДатаПоказанийПодкрутки;
		ДокументВводПоказаний.Организация = Объект.Счетчики[0].ВладелецСчетчика.Организация;
		ДокументВводПоказаний.ВидОперации = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ПоказанияПодкрутки;
		ДокументВводПоказаний.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный;
		ДокументВводПоказаний.Комментарий = "Документ создан автоматически при поверке счетчиков " + Формат(ДокументВводПоказаний.Дата, "ДФ='ММММ гггг'");
		ДокументВводПоказаний.Ответственный = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
		
		
		СписокСчетчиков = Объект.Счетчики.Выгрузить().ВыгрузитьКолонку("Счетчик");
		ДокументВводПоказаний.ЗаполнитьТаблицуПоказанийПоСпискуСчетчиков(СписокСчетчиков);		
		// БИТ_ЖКХ 25.07.2014
		// Если ДокументВводПоказаний.ПоказанияПоСчетчикам.Количество() > 1 Тогда.
		Если ДокументВводПоказаний.ПоказанияПоСчетчикам.Количество() > 0 Тогда
			// БИТ_ЖКХ 25.07.2014
			
			Попытка
				
				ДокументВводПоказаний.Записать(РежимЗаписиДокумента.Проведение);
				
			Исключение
			КонецПопытки;
			
		КонецЕсли;

КонецПроцедуры

