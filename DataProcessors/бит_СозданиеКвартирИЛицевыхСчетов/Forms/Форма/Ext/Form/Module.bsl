&НаСервере
Процедура НайтиКвартирыПоАдресуНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_Квартиры.Ссылка КАК Ссылка,
	               |	бит_Квартиры.Владелец.Улица КАК Улица,
	               |	бит_Квартиры.Владелец.НомерДома КАК НомерДома,
	               |	бит_Квартиры.Владелец.Корпус КАК Корпус,
	               |	бит_Квартиры.НомерКвартиры КАК НомерКвартиры,
	               |	бит_СведенияОКвартире.ТипКвартиры КАК ТипКвартиры,
	               |	бит_СведенияОКвартире.СтатусКвартиры КАК СтатусКвартиры,
	               |	бит_ЛицевыеСчета.Наименование КАК ЛицевойСчет
	               |ИЗ
	               |	РегистрСведений.бит_СведенияОКвартире КАК бит_СведенияОКвартире
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	               |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	               |			ПО (бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка)
	               |		ПО бит_СведенияОКвартире.Квартира = бит_Квартиры.Ссылка
	               |ГДЕ
	               |	бит_Квартиры.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Объект.ТекущаяСсылка);
	
	табЗапроса = Запрос.Выполнить().Выгрузить();

	Объект.СписокКвартир.Очистить();
	для каждого стр из табЗапроса цикл
			
		  новыйКвартира = Объект.СписокКвартир.Добавить();	
		  новыйКвартира.Улица = стр.Улица;
		  новыйКвартира.Дом = стр.НомерДома;
		  новыйКвартира.Корпус = стр.Корпус;
		  новыйКвартира.НомерКвартиры = стр.НомерКвартиры;    		  
		  новыйКвартира.ТипКвартиры = стр.ТипКвартиры;
		  новыйКвартира.СтатусКвартиры = стр.СтатусКвартиры; 		  
		  новыйКвартира.ЛицевойСчет = стр.ЛицевойСчет;//СформироватьНомерЛС(Объект.ТекущийДом, текущийНомерКвартиры, Объект.ПрефиксЛС, Объект.ДлинаЛС);
		  новыйКвартира.СтатусЛС = "Существует";		 
			
	конеццикла;	 
	
	если табЗапроса.Количество() > 0 тогда
	 Объект.СписокКвартир.Сортировать("Улица, Дом, Корпус, НомерКвартиры");		
	 Объект.НомерПервойКвартиры = Объект.СписокКвартир[Объект.СписокКвартир.Количество()-1].НомерКвартиры + 1;
    иначе 
	 Объект.НомерПервойКвартиры = 1;
	конецесли; 

КонецПроцедуры

