&НаСервере
функция СоздатьЛицевойСчетНаСервере(Здание, Квартира, ТипКвартиры, СтатусКвартиры, Организация, УлицаЛицевогоСчета, Номер)
	
  ЛС = НайтиОбъектЛС (Здание, Квартира);
	
  если ЛС = неопределено тогда  	
	
	НовыйЛС = Справочники.бит_ЛицевыеСчета.СоздатьЭлемент();
	НовыйЛС.УстановитьНовыйКод();
	НовыйЛС.Квартира = Квартира;
	НовыйЛС.Здание   = Здание;
	НовыйЛС.Организация = Организация;
	НовыйЛС.УлицаЛицевогоСчета = УлицаЛицевогоСчета;
	НовыйЛС.Наименование = Номер;
    НовыйЛС.Комментарий = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(("Автоматическое создание в %1"), ТекущаяДата());
	
	если ПроверитьУникальностьЛицевогоСчета(Номер) = ложь тогда
	  возврат "Номер ЛС не уникален";
	конецесли;	
	
	Попытка
	 НовыйЛС.Записать();
	 возврат "Создан";
	Исключение		
	 возврат "Не создан";
    КонецПопытки;

  иначе	
	возврат "У квартиры уже есть ЛС";
  конецесли;	
	
