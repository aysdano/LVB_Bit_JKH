	ТекущиеДанные.Вопрос = ТекущийВопрос;
	
	НомерСтроки = ТекущиеДанные.НомерСтроки;
	Если ЗначениеЗаполнено(НомерСтроки) Тогда
		ИндексСтроки = ПолучитьИндексСтрокиПоНомеруСтроки(НомерСтроки);
		Если ИндексСтроки >= 0 Тогда
			ПовесткаДняВопросПриИзмененииНаСервере(ИндексСтроки);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //HD-

