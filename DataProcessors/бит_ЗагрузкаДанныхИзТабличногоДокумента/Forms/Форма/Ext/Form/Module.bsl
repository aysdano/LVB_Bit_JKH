				ЗагружаемыйОбъект.НомерСтроки = Загружено+1;
				ЗагружаемыйОбъект.МоментВремени = ОбъектИсточника.МоментВремени();
			Иначе
				ТекстСообщения = НСтр("ru = 'При добавлении проводки %1 возникли ошибки. '");
				ТекстСообщения = СтрШаблон(ТекстСообщения, (Загружено + 1));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				ЗаписыватьОбъект = Ложь;
			КонецЕсли;
			
			Загружено = Загружено + 1;
			
		ИначеЕсли ТекРежимЗагрузки = 5 Тогда
			
			Если Не ОбработатьСобытиеПослеДобавленияСтроки(ОбъектИсточника, ЗагружаемыйОбъект, ТекстыЯчеек, ПослеДобавленияСтроки) Тогда
				Отказ = Истина;
			КонецЕсли;
			
		КонецЕсли;
		
		НомерТекущейСтроки = НомерТекущейСтроки + 1;
	КонецЦикла;
	ТекстСообщения = НСтр("ru = '---------------------------------------------'");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	Если ТекРежимЗагрузки = 1  Тогда
		Если ЗаписыватьОбъект и ЗаписатьОбъект(ОбъектИсточника, "", ПередЗаписьюОбъекта, ПриЗаписиОбъекта) Тогда
			
			ТекстСообщения = НСтр("ru = 'Выполнена загрузка %1'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ТекстВопросаИсточника);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			ТекстСообщения = НСтр("ru = '%1 из %2 элементов.'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, Загружено, КоличествоЭлементов);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат Истина;
		Иначе
			ТекстСообщения = НСтр("ru = 'Объект не записан: %1.'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ЗагружаемыйОбъект);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат Ложь;
		КонецЕсли;
	ИначеЕсли ТекРежимЗагрузки = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Выполнена загрузка %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ТекстВопросаИсточника);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		ТекстСообщения = НСтр("ru = '%1 из %2 элементов.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Загружено, КоличествоЭлементов);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Истина;
	ИначеЕсли ТекРежимЗагрузки = 2 Тогда
		ТекстСообщения = НСтр("ru = 'Выполнена загрузка %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ТекстВопросаИсточника);
