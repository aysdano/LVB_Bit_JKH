&НаКлиенте
Процедура ПоказанияПоСчетчикамКоличествоЕдиницПоСчетчикуОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные      = Элементы.ПоказанияПоСчетчикам.ТекущиеДанные;
	
	Показания            = Число(Текст);
	КонечныеПоказания    = ТекущиеДанные.ПредыдущиеПоказания + Показания;
	
	ПереходЧерезНоль   = Ложь;
	Заполнить          = Истина;
	
	Если Показания > ТекущиеДанные.Разрядность Тогда
		
		// БИТ_ЖКХ 03.03.2015{{
		// Сообщить("Количество единиц по счетчику не может превышать разрядность.", СтатусСообщения.ОченьВажное);.
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Количество единиц по счетчику не может превышать разрядность.";
		Сообщение.Сообщить();
		// БИТ_ЖКХ 03.03.2015}}
		
		СтандартнаяОбработка           = Ложь;
		тмпПоказания = Формат(ТекущиеДанные.ТекущиеПоказания, "ЧДЦ=4; ЧН=");
		
		Заполнить = ложь;
		
		Возврат;
		
	КонецЕсли; 
	
	//СтандартнаяОбработка           = Ложь;
	
	Если КонечныеПоказания > ТекущиеДанные.Разрядность Тогда
		
		КонечныеПоказания = ТекущиеДанные.ПредыдущиеПоказания - 1 + Число(Текст) - ТекущиеДанные.Разрядность;
		Ответ = Неопределено;

		ПоказатьВопрос(Новый ОписаниеОповещения("ПоказанияПоСчетчикамКоличествоЕдиницПоСчетчикуОкончаниеВводаТекстаЗавершение", ЭтотОбъект, Новый Структура("Показания, КонечныеПоказания, ТекущиеДанные, ПереходЧерезНоль, Заполнить",Показания, КонечныеПоказания, ТекущиеДанные, ПереходЧерезНоль, Заполнить)), "Произойдет переход через 0 на конечные показания: " + КонечныеПоказания + " Ввести?",РежимДиалогаВопрос.ДаНетОтмена);
        Возврат;
		
	КонецЕсли;
	
	ПоказанияПоСчетчикамКоличествоЕдиницПоСчетчикуОкончаниеВводаТекстаФрагмент(Заполнить, КонечныеПоказания, ПереходЧерезНоль, Показания, ТекущиеДанные);
КонецПроцедуры

