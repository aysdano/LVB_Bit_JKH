// Параметры:
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокПроживающих(Знач ЛицевойСчет, Знач Дата)
	
	Результат = Новый СписокЗначений;
	
	Запрос =  Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Момент"     ,КонецДня(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	ТаблицаФизЛиц = РезультатЗапроса.Выгрузить();
	
	Результат.ЗагрузитьЗначения(ТаблицаФизЛиц.ВыгрузитьКолонку("ФизЛицо"));
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ВывестиСуммуДолгаПоЛСНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ДолгПоЛС = ДокументОбъект.ВывестиСуммуДолгаПоЛС();
	
	Элементы.ДолгПоТекущемуЛС.Заголовок  = ДолгПоЛС.СтрокаДолга;
	Элементы.ДолгПоТекущемуЛС.ЦветТекста = ДолгПоЛС.ЦветНадписи;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	СпРабот			  = Новый СписокЗначений;
	СпЕдиницИзмерений = Новый СписокЗначений;
	
	Для каждого ТекСтрока Из Объект.Работы Цикл
		
		СпРабот.Добавить(ТекСтрока.Работа);
		СпЕдиницИзмерений.Добавить(ТекСтрока.ЕдиницаИзмерения);
		
	КонецЦикла;
	
	ТЗНаборРаботаЕдИзм = Объект.Работы.Выгрузить(,"Работа, ЕдиницаИзмерения, Объем, ОбъемПлан");
	ТЗНаборРаботаЕдИзм.Свернуть("Работа, ЕдиницаИзмерения","Объем, ОбъемПлан");
	
	ВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = ВТ;

	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТЗНаборРаботаЕдИзм.Работа,
	|	ТЗНаборРаботаЕдИзм.ЕдиницаИзмерения,
	|	ТЗНаборРаботаЕдИзм.Объем,
	|	ТЗНаборРаботаЕдИзм.ОбъемПлан
	|ПОМЕСТИТЬ НаборРаботаЕдИзм
	|ИЗ
	|	&ТЗНаборРаботаЕдИзм КАК ТЗНаборРаботаЕдИзм";
	
	Запрос.УстановитьПараметр("ТЗНаборРаботаЕдИзм", ТЗНаборРаботаЕдИзм);
	
	Запрос.Выполнить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НаборРаботаЕдИзм.Работа КАК Работа,
	|	ЕСТЬNULL(бит_СоставРаботСрезПоследних.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка)) КАК Номенклатура,
	|	МАКСИМУМ(ЕСТЬNULL(бит_СоставРаботСрезПоследних.Коэффициент, 0)) КАК Коэффициент,
	|	СУММА(ЕСТЬNULL(бит_СоставРаботСрезПоследних.Количество, 0)) КАК Количество,
	|	СУММА(НаборРаботаЕдИзм.Объем) КАК Объем,
	|	СУММА(НаборРаботаЕдИзм.ОбъемПлан) КАК ОбъемПлан
	|ИЗ
	|	РегистрСведений.бит_СоставРабот.СрезПоследних(
	|			&Период,
	|			ВидОбъекта = &ВидОбъекта
	|				И Подразделение = &Подразделение
	|				И Работа В (&СпРабот)
	|				И ЕдиницаИзмерения В (&СпЕдиницИзмерений)) КАК бит_СоставРаботСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ НаборРаботаЕдИзм КАК НаборРаботаЕдИзм
	|		ПО бит_СоставРаботСрезПоследних.Работа = НаборРаботаЕдИзм.Работа
	|			И бит_СоставРаботСрезПоследних.ЕдиницаИзмерения = НаборРаботаЕдИзм.ЕдиницаИзмерения
	|
	|СГРУППИРОВАТЬ ПО
	|	НаборРаботаЕдИзм.Работа,
	|	ЕСТЬNULL(бит_СоставРаботСрезПоследних.Номенклатура, ЗНАЧЕНИЕ(Справочник.Номенклатура.ПустаяСсылка))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Работа,
	|	Номенклатура";
	
	Запрос.УстановитьПараметр("Период"		     , ТекущаяДата());
	Запрос.УстановитьПараметр("Подразделение"	 , Объект.Подразделение);
	Запрос.УстановитьПараметр("ВидОбъекта" 		 , Объект.ВидОбъекта);
	Запрос.УстановитьПараметр("СпРабот"			 , СпРабот);
	Запрос.УстановитьПараметр("СпЕдиницИзмерений", СпЕдиницИзмерений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока  Выборка.Следующий() Цикл
		НоваяСтрока = Объект.НарядЗаказ.Добавить();
		НоваяСтрока.Работа 			 = Выборка.Работа;
		НоваяСтрока.Номенклатура	 = Выборка.Номенклатура;
		НоваяСтрока.ЕдиницаИзмерения = Выборка.Номенклатура.ЕдиницаИзмерения;
		//19.12.2018 55
		НоваяСтрока.СтавкаНДС		 = Выборка.Номенклатура.ВидСтавкиНДС;
		НоваяСтрока.Количество	     = ?(Выборка.Коэффициент <> 0, Выборка.Объем/Выборка.Коэффициент*Выборка.Количество,
		Выборка.Объем*Выборка.Количество);
		НоваяСтрока.КоличествоПлан	 = ?(Выборка.Коэффициент <> 0, Выборка.ОбъемПлан/Выборка.Коэффициент*Выборка.Количество,
		Выборка.ОбъемПлан*Выборка.Количество);
	КонецЦикла;
	
	СпособЗаполненияЦен = Перечисления.СпособыЗаполненияЦен.ПоЗакупочнымЦенам;
	
	Для Каждого ТекСтрока Из Объект.НарядЗаказ Цикл
		
		ТекСтрока.СуммаПлан = ?(Не ТекСтрока.Количество = 0, (ТекСтрока.Сумма / ТекСтрока.Количество), 0) * ТекСтрока.КоличествоПлан;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыписатьСписаниеНаСервере()
	
	
	ОбъектТН = Документы.ТребованиеНакладная.СоздатьДокумент();
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	// Заполнение шапки.
	ОбъектТН.Комментарий   = "Введен на основании документа " + Строка(ДокументОбъект);
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ОбъектТН, бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"),,,);
	
	ОбъектТН.Организация   = Объект.Организация;
	ОбъектТН.Ответственный = Объект.Ответственный;
	
	Для Каждого ТекСтрокаМатериалыЗаказчика Из Объект.НарядЗаказ Цикл
		
		НоваяСтрока              = ОбъектТН.Материалы.Добавить();
		НоваяСтрока.Количество   = ТекСтрокаМатериалыЗаказчика.Количество;
		НоваяСтрока.Номенклатура = ТекСтрокаМатериалыЗаказчика.Номенклатура;
		
		СчетаУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(ОбъектТН.Организация, НоваяСтрока.Номенклатура, ОбъектТН.Склад);
		
		НоваяСтрока.Счет         = СчетаУчета.СчетУчета;
		
	КонецЦикла;
	
	ОбъектТН.Дата = ТекущаяДата();
	ОбъектТН.Записать(РежимЗаписиДокумента.Запись);
	
	Объект.ТребованиеНакладная = ОбъектТН.Ссылка;
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ВыписатьРеализациюНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ТекПользователь = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
	
	ОбъектРТУ = Документы.РеализацияТоваровУслуг.СоздатьДокумент();//ПолучитьФормуНовогоДокумента(, ЭтаФорма, Строка(Объект));
	
	// Заполнение шапки.
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ОбъектРТУ, ТекПользователь,,,);
	
	ОбъектРТУ.ВидОперации             = Перечисления.ВидыОперацийРеализацияТоваров.ПродажаКомиссия;
	ОбъектРТУ.Организация             = Объект.Организация;		
	ОбъектРТУ.ВалютаДокумента         = Объект.ВалютаДокумента;
	ОбъектРТУ.КурсВзаиморасчетов      = 1;
	ОбъектРТУ.КратностьВзаиморасчетов = 1;		
	
	ОбъектРТУ.СуммаВключаетНДС        = Объект.СуммаВключаетНДС;	
	ОбъектРТУ.Комментарий             = "Введен на основании документа "+Строка(ДокументОбъект);
	
	УчетДенежныхСредствБП.УстановитьБанковскийСчет(ОбъектРТУ.БанковскийСчетОрганизации, ОбъектРТУ.Организация, ОбъектРТУ.ВалютаДокумента);

	Если ЗначениеЗаполнено(ОбъектРТУ.Организация)
		И ЗначениеЗаполнено(ОбъектРТУ.Контрагент)
		И ЗначениеЗаполнено(ОбъектРТУ.ДоговорКонтрагента) Тогда
		Документы.РеализацияТоваровУслуг.ЗаполнитьСчетаУчетаРасчетов(ОбъектРТУ);
	КонецЕсли;
	
	// Табличная часть документа.
	Для Каждого ТекСтрока Из Объект.НарядЗаказ Цикл
		
		Если ТекСтрока.Номенклатура.Услуга = Истина Тогда
			
			НоваяСтрока = ОбъектРТУ.Услуги.Добавить();
			
			НаименованиеПолное = ТекСтрока.Номенклатура.НаименованиеПолное;
			
			Если ПустаяСтрока(НаименованиеПолное) Тогда
				
				НоваяСтрока.Содержание = ТекСтрока.Номенклатура.Наименование;
				
			Иначе
				
				НоваяСтрока.Содержание = НаименованиеПолное;
				
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока                  = ОбъектРТУ.Товары.Добавить();
			
			НоваяСтрока.ЕдиницаИзмерения = ТекСтрока.ЕдиницаИзмерения;
			
		КонецЕсли;
		
		НоваяСтрока.Номенклатура         = ТекСтрока.Номенклатура;
		НоваяСтрока.СтавкаНДС            = ТекСтрока.СтавкаНДС;
		НоваяСтрока.Количество           = ТекСтрока.Количество;
		НоваяСтрока.Цена                 = ТекСтрока.Цена;
		НоваяСтрока.Сумма                = ТекСтрока.Сумма;
		
		НоваяСтрока.СуммаНДС             = УчетНДСКлиентСервер.РассчитатьСуммуНДС(НоваяСтрока.Сумма,Объект.СуммаВключаетНДС, 
		УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(НоваяСтрока.СтавкаНДС));
		
		Если НЕ НоваяСтрока.Номенклатура.Услуга = Истина Тогда
			
			СчетаУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(ОбъектРТУ.Организация, НоваяСтрока.Номенклатура, ОбъектРТУ.Склад);
			
			НоваяСтрока.СчетУчета = СчетаУчета.СчетУчета;
			
		КонецЕсли;
		
		СчетаУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаУчетаНоменклатуры(ОбъектРТУ.Организация, НоваяСтрока.Номенклатура);
		
		НоваяСтрока.СчетДоходов  = СчетаУчета.СчетДоходов;
		НоваяСтрока.СчетРасходов = СчетаУчета.СчетРасходов;
		НоваяСтрока.СчетУчетаНДСПоРеализации = СчетаУчета.СчетУчетаНДСпродажи;
		
		Если Не НоваяСтрока.СчетДоходов.Пустая() Тогда
			
			НоваяСтрока.Субконто = Новый(НоваяСтрока.СчетДоходов.ВидыСубконто[0].ВидСубконто.ТипЗначения.Типы()[0]);
			
			Если ТипЗнч(НоваяСтрока.Субконто) = Тип("СправочникСсылка.НоменклатурныеГруппы") Тогда
				
				НоваяСтрока.Субконто = НоваяСтрока.Номенклатура.НоменклатурнаяГруппа;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ОбъектРТУ.Дата = ТекущаяДата();
	ОбъектРТУ.Записать(РежимЗаписиДокумента.Запись);
	
	Объект.РеализацияТоваровУслуг = ОбъектРТУ.Ссылка;
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

