		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ОтветственныйЗаВыполнение КАК Исполнитель,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Дата КАК ДатаПоступления,
	ВЫБОР
		КОГДА бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.СтатусВыполнения = ЗНАЧЕНИЕ(Справочник.бит_СтатусыВыполнения.Выполнено)
			ТОГДА бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ВремяФактическогоВыполнения
	КОНЕЦ КАК ДатаВыполнения,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Дата КАК ВремяПоступления,
	ВЫБОР
		КОГДА бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.СтатусВыполнения = ЗНАЧЕНИЕ(Справочник.бит_СтатусыВыполнения.Выполнено)
			ТОГДА бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ВремяФактическогоВыполнения
	КОНЕЦ КАК ВремяВыполнения,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Работа КАК Работа,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Количество КАК Количество,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ОценкаВыполнения КАК Оценка,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Ссылка КАК Заявка,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Подразделение
ИЗ
	Документ.бит_ЗаявкаНаВыполнениеРабот.Работы КАК бит_ЗаявкаНаВыполнениеРаботРаботы
ГДЕ
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Проведен = ИСТИНА
	И бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Организация = &amp;Организация
	И бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.СтатусВыполнения = ЗНАЧЕНИЕ(Справочник.бит_СтатусыВыполнения.Выполнено)

УПОРЯДОЧИТЬ ПО
	Исполнитель,
	Работа</query>
