			РасчитатьНачисленияСУчетомДнейПроживания(Запрос, Дата, ТаблицаПроживающих);
			
		КонецЕсли; 
		
		// БИТ_ЖКХ 07.07.2015{{
		//РасчитатьНачисленияПоЛС(ТаблицаНачислений, Запрос, ТаблицаПроживающих);
		РасчитатьНачисленияПоЛС(ТаблицаНачислений, Запрос, ТаблицаПроживающих,РасчетДляРазовых);
