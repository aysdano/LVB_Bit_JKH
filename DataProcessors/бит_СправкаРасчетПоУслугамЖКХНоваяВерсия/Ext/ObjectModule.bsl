Функция СформироватьПечатнуюФорму() экспорт
	
	ТабДок = Новый ТабличныйДокумент;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ИсполнительныйЛист.Ссылка КАК Документ,
	|	бит_ИсполнительныйЛист.ПериодОбразованияЗадолженностиПо КАК ПериодОбразованияЗадолженностиПо,
	|	бит_ИсполнительныйЛист.ЛицевойСчет КАК ЛицевойСчет
	|ПОМЕСТИТЬ ВременнаяТаблица
	|ИЗ
	|	Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
	|ГДЕ
	|	бит_ИсполнительныйЛист.Проведен = ИСТИНА
	|	И бит_ИсполнительныйЛист.ЛицевойСчет В(&ЛицевойСчет)
	|	И бит_ИсполнительныйЛист.Услуга В(&Услуга)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ИсковоеЗаявление.Ссылка КАК Документ,
	|	бит_ИсковоеЗаявление.ПериодОбразованияЗадолженностиПо КАК ПериодОбразованияЗадолженностиПо,
	|	бит_ИсковоеЗаявление.ЛицевойСчет КАК ЛицевойСчет
	|ПОМЕСТИТЬ ВременнаяТаблица1
	|ИЗ
	|	Документ.бит_ИсковоеЗаявление КАК бит_ИсковоеЗаявление
	|ГДЕ
	|	бит_ИсковоеЗаявление.Проведен = ИСТИНА
	|	И бит_ИсковоеЗаявление.ЛицевойСчет В(&ЛицевойСчет)
	|	И бит_ИсковоеЗаявление.Услуга В(&Услуга)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ВременнаяТаблица.ЛицевойСчет ЕСТЬ NULL
	|			ТОГДА ВременнаяТаблица1.ЛицевойСчет
	|		ИНАЧЕ ВременнаяТаблица.ЛицевойСчет
	|	КОНЕЦ КАК ЛицевойСчет,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблица.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И НЕ ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|			ТОГДА ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо
	|		КОГДА НЕ ВременнаяТаблица.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И НЕ ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И ВременнаяТаблица.ПериодОбразованияЗадолженностиПо > ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо
	|			ТОГДА ВременнаяТаблица.ПериодОбразованияЗадолженностиПо
	|		КОГДА НЕ ВременнаяТаблица.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И НЕ ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И ВременнаяТаблица.ПериодОбразованияЗадолженностиПо < ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо
	|			ТОГДА ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо
	|		ИНАЧЕ ВременнаяТаблица.ПериодОбразованияЗадолженностиПо
	|	КОНЕЦ КАК ПериодОбразованияЗадолженностиПо,
	|	ВЫБОР
	|		КОГДА ВременнаяТаблица.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И НЕ ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|			ТОГДА ВременнаяТаблица1.Документ
	|		КОГДА НЕ ВременнаяТаблица.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И НЕ ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И ВременнаяТаблица.ПериодОбразованияЗадолженностиПо > ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо
	|			ТОГДА ВременнаяТаблица.Документ
	|		КОГДА НЕ ВременнаяТаблица.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И НЕ ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо ЕСТЬ NULL
	|				И ВременнаяТаблица.ПериодОбразованияЗадолженностиПо < ВременнаяТаблица1.ПериодОбразованияЗадолженностиПо
	|			ТОГДА ВременнаяТаблица1.Документ
	|		ИНАЧЕ ВременнаяТаблица.Документ
	|	КОНЕЦ КАК Документ
	|ИЗ
	|	ВременнаяТаблица КАК ВременнаяТаблица
	|		ПОЛНОЕ СОЕДИНЕНИЕ ВременнаяТаблица1 КАК ВременнаяТаблица1
	|		ПО ВременнаяТаблица.ЛицевойСчет = ВременнаяТаблица1.ЛицевойСчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПериодОбразованияЗадолженностиПо УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(ПериодОбразованияЗадолженностиПо)
	|ПО
	|	ЛицевойСчет";
	ЛицевыеСчета = ПолучитьМассивЛС();
	Запрос.УстановитьПараметр("Услуга", ГруппаУслуг(Услуга));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевыеСчета);
	РезультатЗапроса = Запрос.Выполнить();
	
	ДанныеИспЛист = РезультатЗапроса.Выгрузить();
	
	МассивЛСИспЛисты = ПолучитьЛСПоПолюДокумент(ДанныеИспЛист);
	
	Если НЕ ОтборПоПериоду Тогда
		Для каждого ЛицевойСчет из МассивЛСИспЛисты Цикл
			ЛицевыеСчета.Удалить(ЛицевыеСчета.Найти(ЛицевойСчет));
		КонецЦикла;
	КонецЕсли;
	//формируем справки БЕЗ исполнительного листа или если стоит флаг "по периоду"
	Для каждого Лс из ЛицевыеСчета Цикл
		Если ПрошелПорогПоДолгу(Лс, КоличествоМесяцевЗадолженности, НачалоМесяца((ДобавитьМесяц(ТекущаяДата(), -1))),  ГруппаУслуг(Услуга)) или ОтборПоПериоду Тогда
			ДатаНачалаЗадложенности = ПолучитьДатуНачалаЗадолженности(Лс, ГруппаУслуг(Услуга));
			ДатаНачалаСправки = ?(ЗначениеЗаполнено(Период.ДатаНачала) И ОтборПоПериоду, Период.ДатаНачала, ДатаНачалаЗадложенности);
			МассивСобственников = МассивСобственников(Лс);
			Если ЗначениеЗаполнено(ДатаНачалаСправки) Тогда
				Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000009") ИЛИ ДелитьПоСобственникам Тогда
					Для каждого Собственник Из МассивСобственников Цикл
						ЗаполнитьТабДок(ТабДок, Лс, Услуга, Дата(1 ,1, 1) , НачалоМесяца(ДатаНачалаСправки), ПолучитьКонецПериодаРасчета(), ЛОЖЬ, Собственник);
					КонецЦикла;
				Иначе
					ЗаполнитьТабДок(ТабДок, Лс, Услуга, Дата(1 ,1, 1) , НачалоМесяца(ДатаНачалаСправки), ПолучитьКонецПериодаРасчета(), ЛОЖЬ, ЛОЖЬ);
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	//формируем справки по тем у кого есть исполнительные листы
	Если не РезультатЗапроса.Пустой() и НЕ ОтборПоПериоду Тогда
		ВыборкаЛС = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		//обход по каждому ЛС
		Пока ВыборкаЛС.Следующий() Цикл
			ВыборкаДокумент = ВыборкаЛС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			//берем первую строку с исполнительным листом с последней датой
			Если ВыборкаДокумент.Следующий() Тогда
				Документ = ВыборкаДокумент.Документ;
				МассивСобственников = МассивСобственников(Документ.ЛицевойСчет);
				МесяцевНеПодачиВСуд = (ТекущаяДата() - Документ.ПериодОбразованияЗадолженностиПо)/3600/24/30;
				ДатаНачалаСправки = ?(Период.ДатаНачала > Документ.ПериодОбразованияЗадолженностиПо и ОтборПоПериоду, Период.ДатаНачала , Документ.ПериодОбразованияЗадолженностиПо);
				ДатаНачалаСправки = ?(ЗначениеЗаполнено(Период.ДатаНачала) И ОтборПоПериоду, Период.ДатаНачала, ДатаНачалаСправки);
				Если МесяцевНеПодачиВСуд >= СрокНеПодачиВСуд И ПрошелПорогПоДолгу(Документ.ЛицевойСчет, КоличествоМесяцевЗадолженности, ДатаНачалаСправки, ГруппаУслуг(Услуга)) Тогда
					Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000009") ИЛИ ДелитьПоСобственникам Тогда
						Для каждого Собственник Из МассивСобственников Цикл
							ЗаполнитьТабДок(ТабДок, Документ.ЛицевойСчет, Документ.Услуга, Документ.ПериодОбразованияЗадолженностиОт, ДатаНачалаСправки, ПолучитьКонецПериодаРасчета(), Истина, Собственник);
						КонецЦикла;
					Иначе
						ЗаполнитьТабДок(ТабДок, Документ.ЛицевойСчет, Документ.Услуга, Документ.ПериодОбразованияЗадолженностиОт, ДатаНачалаСправки, ПолучитьКонецПериодаРасчета(), Истина, Ложь);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Возврат ТабДок;
	
КонецФункции

Функция ПолучитьКонецПериодаРасчета()
	Возврат ?(ОтборПоПериоду И ЗначениеЗаполнено(Период.ДатаОкончания), Период.ДатаОкончания, ТекущаяДата());
КонецФункции

Функция МассивСобственников(Лс)
	
	МассивСобственников = Новый Массив;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.Наименование КАК ФизЛицо,
	|	ВЫБОР
	|		КОГДА бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры = &Муниципальная
	|			ТОГДА 1
	|		ИНАЧЕ бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади
	|	КОНЕЦ КАК ДоляПлощади,
	|	ВЫБОР
	|		КОГДА бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры = &Муниципальная
	|			ТОГДА ""1""
	|		ИНАЧЕ бит_ПроживающиеПоЛССрезПоследних.лб_ДоляПлощадиСтрокой
	|	КОНЕЦ КАК лб_ДоляПлощадиСтрокой,
	|	ЛОЖЬ КАК ЭтоСовместнаяСобственность
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(, ЛицевойСчет = &ЛС) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	ВЫБОР
	|			КОГДА бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры = &Муниципальная
	|					И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = &Ответственный
	|				ТОГДА ИСТИНА
	|			ИНАЧЕ бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади > 0
	|		КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЛС", ЛС);
	Запрос.УстановитьПараметр("Муниципальная", Справочники.бит_СтатусыКвартиры.Неприватизированная);
	Запрос.УстановитьПараметр("Ответственный", Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	МассивСобственников = РезультатЗапроса.Выгрузить();     
	МассивСобственников.Колонки.Добавить("ДоляПлощадиДробь", Новый ОписаниеТипов("Структура"));
	Собственники = "";
	ДоляСовместойСобственности = 0;
	СуммаЧислителейДолей = 0;
	ЗнаменательСовместнойСобственности = 0;
	ДоляСовместойСобственностиСтрока = "";
	МассивИндесовСовместнойСобственности = Новый Массив;
	
	Для каждого СтрокаСобственник Из МассивСобственников Цикл
		ЭтоСовместнаяСобственность = ?(СтрНачинаетсяС(СтрокаСобственник.лб_ДоляПлощадиСтрокой, "с") или СтрНачинаетсяС(СтрокаСобственник.лб_ДоляПлощадиСтрокой, "о"), Истина, Ложь);
		Если ЭтоСовместнаяСобственность Тогда 
			СтрокаДанных = СтрЗаменить(СтрокаСобственник.лб_ДоляПлощадиСтрокой, "с","");	
			СтрокаДанных = СтрЗаменить(СтрокаДанных, "о","");    
		Иначе
			СтрокаДанных = СтрокаСобственник.лб_ДоляПлощадиСтрокой;
		КонецЕсли;
		СтрокаДанных = СтрЗаменить(СтрокаДанных, "/"," ");
		МассивЧисел = СтрРазделить(СтрокаДанных, " ");
		Попытка
			Числитель = Число(МассивЧисел[0]);
			Знаменатель = Число(МассивЧисел[1]);
		Исключение
			Числитель = 0;
			Знаменатель = 0;
		КонецПопытки;
		
		ЗнаменательСовместнойСобственности = Знаменатель;
		Если ЭтоСовместнаяСобственность Тогда
			ДоляСовместойСобственности = ДоляСовместойСобственности + Числитель / Знаменатель;
			СуммаЧислителейДолей = СуммаЧислителейДолей + Числитель;
			МассивИндесовСовместнойСобственности.Добавить(СтрокаСобственник);
			Собственники = Собственники + (СтрокаСобственник.ФизЛицо) + Символы.ПС;
		Иначе
			Попытка   
				ДробьДолиПлощади = Новый Структура;
				ДробьДолиПлощади.Вставить("Числитель", ?(Числитель = 0, 1, Числитель));
				ДробьДолиПлощади.Вставить("Знаменатель", ?(Знаменатель = 0, 1, Знаменатель));
				СтрокаСобственник.ДоляПлощадиДробь = ДробьДолиПлощади;
				СтрокаСобственник.ДоляПлощади = Числитель / Знаменатель;
			Исключение
			КонецПопытки;
		КонецЕсли;
	КонецЦикла;
	
	Если ДоляСовместойСобственности > 0 Тогда
		
		Для каждого Строка Из МассивИндесовСовместнойСобственности Цикл
			МассивСобственников.Удалить(Строка);
		КонецЦикла;
		
		НоваяСтрока = МассивСобственников.Добавить();
		НоваяСтрока.ФизЛицо = Собственники;
		ДробьДолиПлощади = Новый Структура;
		ДробьДолиПлощади.Вставить("Числитель", СуммаЧислителейДолей);
		ДробьДолиПлощади.Вставить("Знаменатель", Знаменатель);
		НоваяСтрока.ДоляПлощади = ДоляСовместойСобственности;             
		НоваяСтрока.ДоляПлощадиДробь = ДробьДолиПлощади;//;
		НоваяСтрока.лб_ДоляПлощадиСтрокой = Строка(Строка(СуммаЧислителейДолей) + "/" + Строка(Знаменатель));
		НоваяСтрока.ЭтоСовместнаяСобственность = Истина;
	КонецЕсли;	
	
	Возврат МассивСобственников;
КонецФункции

Функция ПолучитьТарифыОДН(Услуга, ЛицевойСчет, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	СУММА(ВЫБОР
	|			КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &ХВ
	|				ТОГДА бит_СтавкиНаУслугиСрезПоследних.Тариф
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ТарифХВ,
	|	СУММА(ВЫБОР
	|			КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &ГВ
	|				ТОГДА бит_СтавкиНаУслугиСрезПоследних.Тариф
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ТарифГВ,
	|	СУММА(ВЫБОР
	|			КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &ВО
	|				ТОГДА бит_СтавкиНаУслугиСрезПоследних.Тариф
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ТарифВО,
	|	СУММА(ВЫБОР
	|			КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &ЭЛ
	|				ТОГДА бит_СтавкиНаУслугиСрезПоследних.Тариф
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ТарифЭЛ
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И Услуга В (&Услуга)) КАК бит_СведенияПоУслугамЛССрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&Период, ) КАК бит_СтавкиНаУслугиСрезПоследних
	|		ПО бит_СведенияПоУслугамЛССрезПоследних.Услуга = бит_СтавкиНаУслугиСрезПоследних.Услуга
	|			И бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления = бит_СтавкиНаУслугиСрезПоследних.РежимПотребления
	|			И бит_СведенияПоУслугамЛССрезПоследних.Поставщик = бит_СтавкиНаУслугиСрезПоследних.Поставщик
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Услуга", ГруппаУслуг(Услуга));
	Запрос.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаТарифы = РезультатЗапроса.Выбрать().Выгрузить();
	
	//СтрокаТарифы = "";
	//
	//Пока Выборка.Следующий() Цикл
	//	 СтрокаТарифы = СтрокаТарифы + Выборка.УслугаНаименованиеСокращенное + " - " + Выборка.Тариф + ";  ";
	//КонецЦикла;
	
	Возврат ТаблицаТарифы;
	
КонецФункции

Функция ПолучитьПлощадь(ЛицевойСчет, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(, Квартира = &кв) КАК бит_СведенияОКвартиреСрезПоследних";
	
	Запрос.УстановитьПараметр("кв", ЛицевойСчет.Квартира);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат  Выборка.ОбщаяПлощадь;
	КонецЦикла;
	
	Возврат 0;
	
КонецФункции

Функция ПолучитьСтрокуФизЛица(Собственники)
	Строка = "";
	Если ТипЗнч(Собственники) = Тип("Массив") Тогда
		Для каждого ФизЛицо Из Собственники Цикл
			Строка = Строка + Строка(ФизЛицо) + Символы.ПС;
		КонецЦикла;
		
	Иначе
		Строка = Строка(Собственники);
	КонецЕсли;
	
	Возврат Строка;
КонецФункции


Процедура ЗаполнитьТабДок(ТабДок, ЛицевойСчет, Услуга, ПериодОбразованияЗадолженностиОт, ПериодОбразованияЗадолженностиПо, КонецПериодаРасчета, ПоИсполнительномуЛисту, Собственник)
	
	//ТабДок.Очистить();
	УслугаСодРем        = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001");
	УслугаВО     	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000005");
	УслугаГВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000003");
	УслугаХВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000004");
	УслугаЭЭ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000002");
	
	Коэфф = Новый Структура("Числитель, Знаменатель", 1, 1);
	ЭтоОДН = ЭтоОДН(Услуга);
	
	Если ЭтоОДН Тогда
		Макет = ПолучитьМакет("МакетСправкаОДН");
	Иначе
		Макет = ПолучитьМакет("МакетСправка");
	КонецЕсли;
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка|Основная");
	ОбластьШапка.Параметры.УслугаЖКХ = ?(ЗначениеЗаполнено(Услуга.ГруппаУслуги), Услуга.ГруппаУслуги, Услуга);
	ОбластьШапка.Параметры.Адрес = Строка(ЛицевойСчет.Здание) + " кв. " + Строка(ЛицевойСчет.Квартира.Наименование);
	ОбластьШапка.Параметры.НомерЛицевогоСчета = ЛицевойСчет;
	Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000009") или ДелитьПоСобственникам Тогда
		СтрокаСовместнойСобственности = ?(Собственник.ЭтоСовместнаяСобственность, "совмест. соб-ть" + Символы.ПС, "");
		ОбластьШапка.Параметры.ФИО = СтрокаСовместнойСобственности + Собственник.ФизЛицо + " " + Строка(?(Собственник.лб_ДоляПлощадиСтрокой = "1","", Собственник.лб_ДоляПлощадиСтрокой));
		Коэфф = Собственник.ДоляПлощадиДробь;//Собственник.ДоляПлощади;
		ОбластьШапкаПоСобственникам = Макет.ПолучитьОбласть("ШапкаПоСобственникам|Основная");
		//ОбластьШапкаПоСобственникам.Параметры.Тариф = "";//ПолучитьТарифы(Услуга, ЛицевойСчет, ТекущаяДата());
		ОбластьШапкаПоСобственникам.Параметры.Площадь = Формат(Окр(ПолучитьПлощадь(ЛицевойСчет, Период)*Коэфф.Числитель / Коэфф.Знаменатель, 2), "ЧДЦ=2");
	КонецЕсли;
	
	ТабДок.Вывести(ОбластьШапка);
	
	Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000009") или ДелитьПоСобственникам Тогда
		ТабДок.Вывести(ОбластьШапкаПоСобственникам);
	КонецЕсли;
	
	ТабДок.Вывести(Макет.ПолучитьОбласть("ШапкаТаблицы|Основная"));
	
	ДанныеЗадолженностиНаНачалоСправки = ПолучитьЗадолженностьНаНачалоСправки(ПериодОбразованияЗадолженностиПо, ЛицевойСчет, Услуга);
	ДолгУслуга = ДанныеЗадолженностиНаНачалоСправки.Итог("СуммаОстаток") *Коэфф.Числитель / Коэфф.Знаменатель;
	ДолгУслугаЗаПрошлыйПериод = ДолгУслуга;
	ДанныеСодРем = ДанныеЗадолженностиНаНачалоСправки.Найти(УслугаСодРем, "УслугаЖКХ");
	ДанныеГВ = ДанныеЗадолженностиНаНачалоСправки.Найти(УслугаГВ, "УслугаЖКХ");
	ДанныеХВ = ДанныеЗадолженностиНаНачалоСправки.Найти(УслугаХВ, "УслугаЖКХ");
	ДанныеВО = ДанныеЗадолженностиНаНачалоСправки.Найти(УслугаВО, "УслугаЖКХ");
	ДанныеЭЛ = ДанныеЗадолженностиНаНачалоСправки.Найти(УслугаЭЭ, "УслугаЖКХ");
	ДолгСодРем = ?(ЗначениеЗаполнено(ДанныеСодРем), ДанныеСодРем.СуммаОстаток *Коэфф.Числитель / Коэфф.Знаменатель, 0);
	ДолгГВ = ?(ЗначениеЗаполнено(ДанныеГВ), ДанныеГВ.СуммаОстаток, 0) *Коэфф.Числитель / Коэфф.Знаменатель;
	ДолгХВ = ?(ЗначениеЗаполнено(ДанныеХВ), ДанныеХВ.СуммаОстаток, 0) *Коэфф.Числитель / Коэфф.Знаменатель;
	ДолгВО = ?(ЗначениеЗаполнено(ДанныеВО), ДанныеВО.СуммаОстаток, 0) *Коэфф.Числитель / Коэфф.Знаменатель;
	ДолгЭЛ = ?(ЗначениеЗаполнено(ДанныеЭЛ), ДанныеЭЛ.СуммаОстаток, 0) *Коэфф.Числитель / Коэфф.Знаменатель;
	ДолгЗаПрошлыйПериод = ДолгГВ + ДолгХВ + ДолгВО + ДолгЭЛ + ДолгСодРем;
	ИтогоНачислено = 0;
	ИтогоПерерасчеты = 0;
	ИтогоОплатаТекПериод = 0;
	ИтогоОплатаПрошлыйПериод = 0;
	ДолгТекПериод = 0;
	СуммаПерерасчеты = 0;
	НачисленияПрошлыхПериодов = Новый Соответствие;
	ДанныеСправки = ПолучитьДанныеДляСправки(ПериодОбразованияЗадолженностиОт, ПериодОбразованияЗадолженностиПо, КонецПериодаРасчета, ЛицевойСчет, Услуга);
	//ДанныеРазовых = ПолучитьДанныеРазовых(ПериодОбразованияЗадолженностиПо, КонецПериодаРасчета, ЛицевойСчет, Услуга);
	МассивСортировки = ПолучитьМассивСортировки(ДанныеСправки);
	//Для каждого СтрокаДанных Из ДанныеСправки Цикл
	#Область ЗаполнениеТаблицы
	
	//++bit_AnisimovaMV_23.10.2023 
	ПереплатаНаНачалоПериодаОДН = 0;  
	ПереплатаОб = ПереплатаНаНачалоПериодаОДН+ДолгСодРем+ДолгГВ+ДолгХВ+ДолгВО+ДолгЭЛ;
	Если ДолгСодРем < 0 Тогда       
		ПереплатаНаНачалоПериодаОДН = ПереплатаНаНачалоПериодаОДН+ДолгСодРем; 
	КонецЕсли; 
	Если ДолгГВ < 0 Тогда       
		ПереплатаНаНачалоПериодаОДН = ПереплатаНаНачалоПериодаОДН+ДолгГВ; 
	КонецЕсли;   
	Если ДолгХВ < 0 Тогда       
		ПереплатаНаНачалоПериодаОДН = ПереплатаНаНачалоПериодаОДН+ДолгХВ; 
	КонецЕсли;
	Если ДолгВО < 0 Тогда       
		ПереплатаНаНачалоПериодаОДН = ПереплатаНаНачалоПериодаОДН+ДолгВО; 
	КонецЕсли;     
	Если ДолгЭЛ < 0 Тогда       
		ПереплатаНаНачалоПериодаОДН = ПереплатаНаНачалоПериодаОДН+ДолгЭЛ; 
	КонецЕсли;  
	Если ПереплатаОб > 0 Тогда  
		ПереплатаНаНачалоПериодаОДН = 0;
	КонецЕсли;
	ПереплатаНаНачалоПериодаУслуги = 0;   
	Если ДолгУслуга < 0 Тогда       
		ПереплатаНаНачалоПериодаУслуги = ПереплатаНаНачалоПериодаУслуги+ДолгУслуга; 
	КонецЕсли; 
	
	//--bit_AnisimovaMV_23.10.2023	
	Для каждого Ключ Из МассивСортировки Цикл                         
		МассивДанных = ДанныеСправки.Получить(Ключ);
		ДанныеПоЛС = МассивДанных[0];
		ДанныеНачИОпл = МассивДанных[1];
		ДанныеНачичсленияОснова = МассивДанных[2];
		ДанныеРазовые = МассивДанных[3];
		ОбластьТаблица = Макет.ПолучитьОбласть("Таблица|Основная");
		ОбластьТаблица.Параметры.Период = ПериодСтрокой(Ключ);
		ЭтоСтрокаНачислений = Ложь;
		ЭтоПерваяСтрока = Истина;
		//СтруктураПодвала = ПодвалКвитанции(ДанныеПоЛС, ТекущаяДата());
		Если ДанныеПоЛС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда 
			Площадь = ДанныеПоЛС.ЖилаяПлощадь;
		Иначе
			Площадь = ДанныеПоЛС.ОбщаяПлощадь; 
		КонецЕсли;
		//++AnisimovaMV_22.01.2024 добавлены структуры для хранения данных о выведенных начислениях
		//ОплатыВТекущемПериодеВыведеноВМакет = Новый Структура("СодРем,ЭЭ,ГВ,ХВ,ВО",0,0,0,0,0);
		//ОплатыВПрошломПериодеВыведеноВМакет = Новый Структура("СодРем,ЭЭ,ГВ,ХВ,ВО",0,0,0,0,0);
		//--AnisimovaMV_22.01.2024
		СуммаНачислено = 0;
		СуммаОплатыПрошлыйПериод = 0;
		СуммаОплатыТекПериод = 0;
		СуммаПерерасчеты = 0;
		ВыводСодРем = 0; 
		ВыводГВ = 0;
		ВыводХВ = 0;
		ВыводВО = 0;
		ВыводЭЛ = 0;
		КоличествоОплат = ДанныеНачИОпл.Количество();          
		//++АнисимоваМВ_26/11/2023 БИТ
		//СтрокаБухСправки = ДанныеНачИОпл.НайтиСтроки(Новый Структура("СуммаОплачено, ДатаОплаты", 0 , КонецМесяца(Ключ)));    
		СтрокаБухСправки = ДанныеНачИОпл.НайтиСтроки(Новый Структура("ЭтоБухСправка",Истина));
		
		//ДанныеПоРаспределениюБухСправкиСодРем = Новый Соответствие();
		//ДанныеПоРаспределениюБухСправкиХВ= Новый Соответствие();
		//ДанныеПоРаспределениюБухСправкиГВ= Новый Соответствие();
		//ДанныеПоРаспределениюБухСправкиВО= Новый Соответствие();    
		//ДанныеПоРаспределениюБухСправкиЭЛ= Новый Соответствие();
		//
		//ДанныеПоРаспределениюБухСправкиСодРем.Вставить(Ключ, Новый Структура("ТекПериод, ПрошПериод",0,0));
		//ДанныеПоРаспределениюБухСправкиХВ.Вставить(Ключ, Новый Структура("ТекПериод, ПрошПериод",0,0));
		//ДанныеПоРаспределениюБухСправкиГВ.Вставить(Ключ, Новый Структура("ТекПериод, ПрошПериод",0,0));
		//ДанныеПоРаспределениюБухСправкиВО.Вставить(Ключ, Новый Структура("ТекПериод, ПрошПериод",0,0));    
		//ДанныеПоРаспределениюБухСправкиЭЛ.Вставить(Ключ, Новый Структура("ТекПериод, ПрошПериод",0,0));
		
		//--АнисимоваМВ_26/11/2023 БИТ
		ЗакрыватьБухСправкойТекПериод = Ложь;   
		БухСправкаВТекущемПериодеПредыдущегоМесяца = Ложь; 
		СтрокаОплатыПрошлогоПериода = Неопределено;  
		БухПоПрошломуПериоду = Истина;           
		ПериодОплатыБухСправки = Дата(1,1,1);	
