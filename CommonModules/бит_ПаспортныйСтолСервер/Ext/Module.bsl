
#Область ФункцииОбработкиДанныхФизическихЛиц

// Функция получает ФИО из регистра сведений в виде структуры. 
Функция ПолучитьДанныеДокументаФизЛица(ФизЛицо, НаДату = Неопределено) Экспорт
	
	Результат = Новый Структура("ДокументВид, ДокументСерия, ДокументНомер,ДокументДатаВыдачи,ДокументКемВыдан,ДокументКодПодразделения,ДатаРегистрацииПоМестуЖительства,ДокументПричинаЗамены", "", "", "", "", "", "", "", "");
	Если Метаданные.Справочники.Найти("бит_Проживающие") = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, ФизЛицо);
	Иначе
		ДанныеФЛ = РегистрыСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(?(ЗначениеЗаполнено(НаДату), НаДату, ТекущаяДата()), Новый Структура("ФизЛицо", ФизЛицо));
		Если ДанныеФЛ.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат, ДанныеФЛ[0]);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция получает данные документа из регистра сведений в виде структуры 
Функция ПолучитьДанныеРанееВыданногоДокументаФизЛица(ФизЛицо, НаДату = Неопределено) Экспорт
	
	Результат = Новый Структура("ДокументВид, ДокументСерия, ДокументНомер,ДокументДатаВыдачи,ДокументКемВыдан,ДокументКодПодразделения,ДатаРегистрацииПоМестуЖительства,ДокументПричинаЗамены", "", "", "", "", "", "", "", "");
	Если Метаданные.Справочники.Найти("бит_Проживающие") = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, ФизЛицо);
	Иначе
		
		Запрос = Новый Запрос;
		Период = ?(ЗначениеЗаполнено(НаДату), НаДату, ТекущаяДата());
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПаспортныеДанныеПроживающих.ДокументВид,
		|	бит_ПаспортныеДанныеПроживающих.ДокументСерия,
		|	бит_ПаспортныеДанныеПроживающих.ДокументНомер,
		|	бит_ПаспортныеДанныеПроживающих.ДокументДатаВыдачи,
		|	бит_ПаспортныеДанныеПроживающих.ДокументКемВыдан,
		|	бит_ПаспортныеДанныеПроживающих.ДокументКодПодразделения,
		|	бит_ПаспортныеДанныеПроживающих.ДатаРегистрацииПоМестуЖительства,
		|	бит_ПаспортныеДанныеПроживающих.ДокументПричинаЗамены
		|ИЗ
		|	РегистрСведений.бит_ПаспортныеДанныеПроживающих КАК бит_ПаспортныеДанныеПроживающих
		|ГДЕ
		|	бит_ПаспортныеДанныеПроживающих.Период <= &Период
		|	И бит_ПаспортныеДанныеПроживающих.ФизЛицо = &ФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_ПаспортныеДанныеПроживающих.Период УБЫВ";
		
		Запрос.УстановитьПараметр("Период", Период);
		Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
		
		ДанныеФЛ = Запрос.Выполнить().Выгрузить();
		
		Если ДанныеФЛ.Количество() > 1 Тогда
			ЗаполнитьЗначенияСвойств(Результат, ДанныеФЛ[1]);
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Функция возвращает паспортные данные физлица в виде строки.
//
// Параметры: 
//  ФизЛицо - ссылка на элемент справочников "Физические лица", "Проживающие".
//           по которому необходимо получить паспортные данные.
//  НаДату 	- получение данных на дату;.
//  ВидСтроки - при Истине не выводится код подразделения, выдавшего документ.
//
// Возвращаемое значение:
//  Строка с данными об удостоверении личности физического лица.
//
Функция ПолучитьПаспортныеДанныеСтрокой(ФизЛицо, НаДату = Неопределено, ВидСтроки = Истина) Экспорт
	
	Результат = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"   ,?(ЗначениеЗаполнено(НаДату), НаДату, ТекущаяДата()));
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.Период,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументПричинаЗамены
	|ИЗ
	|	РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&дата, ФизЛицо = &ФизЛицо) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ВидДокумента       = Выборка.ДокументВид;
		Серия              = Выборка.ДокументСерия;
		Номер              = Выборка.ДокументНомер;
		ДатаВыдачи         = Выборка.ДокументДатаВыдачи;
		КемВыдан           = Выборка.ДокументКемВыдан;
		НомерПодразделения = Выборка.ДокументКодПодразделения;
		
		Если НЕ (НЕ ЗначениеЗаполнено(ДатаВыдачи)
			И НЕ ЗначениеЗаполнено(ВидДокумента)
			И НЕ ЗначениеЗаполнено(Серия + Номер + КемВыдан + НомерПодразделения)) Тогда
			
			// 17.10.2018
			если ВидДокумента <> неопределено тогда			
				Результат = ?(ВидДокумента.Пустая(),"","" + ВидДокумента + ", ") 
				+ "сер."   + Серия + ", №" + Номер 
				+ ", выд. " + Формат(ДатаВыдачи,"ДФ=dd.MM.yyyy") + "г. " 
				+ КемВыдан + ?(ВидСтроки, "", " код подр." + НомерПодразделения );
			иначе				
				Результат = "";
			конецесли;	
			
		Иначе
			Результат = "";
		КонецЕсли;
		
	Иначе
		Результат = "";
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции // ПолучитьПаспортныеДанныеСтрокой()

// Функция возвращает паспортные данные физлица в виде строки из структуры.
// Параметры: 
//  СтруктураПаспортныхДанных - структура паспортных данных,по которой необходимо.
//            получить паспортные данные строкой.
//
// Возвращаемое значение:
//  Строка с данными об удостоверении личности физического лица.
//
Функция ПолучитьПаспортныеДанныеСтрокойИзСтруктуры(СтруктураПаспортныхДанных) Экспорт
	
	ВидДокумента       = СтруктураПаспортныхДанных.ДокументВид;
	Серия              = СтруктураПаспортныхДанных.ДокументСерия;
	Номер              = СтруктураПаспортныхДанных.ДокументНомер;
	ДатаВыдачи         = СтруктураПаспортныхДанных.ДокументДатаВыдачи;
	КемВыдан           = СтруктураПаспортныхДанных.ДокументКемВыдан;
	НомерПодразделения = СтруктураПаспортныхДанных.ДокументКодПодразделения;
	
	Если НЕ (НЕ ЗначениеЗаполнено(ДатаВыдачи)
		И НЕ ЗначениеЗаполнено(ВидДокумента)
		И НЕ ЗначениеЗаполнено(Серия + Номер + КемВыдан + НомерПодразделения)) Тогда
		
		Возврат ?(ВидДокумента.Пустая(),"","" + ВидДокумента + ", ") 
		+ "сер."   + Серия + ", №" + Номер 
		+ ", выд. " + Формат(ДатаВыдачи,"ДФ=dd.MM.yyyy") + "г. " 
		+ КемВыдан;
		
	Иначе
		
		Возврат "Отсутствуют данные об удостоверении личности."
		
	КонецЕсли;
	
КонецФункции // ПолучитьПаспортныеДанныеСтрокойИзСтруктуры()

// Функция получает ФИО из регистра сведений в виде структуры  или строки с полным именем.
// В зависимости от значения  ВидДанных при ВидСтроки = Ложь выводятся ФИО с инициалами.
Функция ПолучитьФИОФизЛица(ФизЛицо, НаДату = Неопределено, ВидДанных = Истина, ВидСтроки = Истина) Экспорт
	
	Результат = Новый Структура("Фамилия, Имя, Отчество", "", "", "");
	
	Если Метаданные.Справочники.Найти("бит_Проживающие") = Неопределено Тогда
		ЗаполнитьЗначенияСвойств(Результат, ФизЛицо);
	ИначеЕсли ТипЗнч(ФизЛицо) = Тип("СправочникСсылка.бит_Проживающие") Тогда
		ДанныеФЛ = РегистрыСведений.бит_ФИОПроживающих.СрезПоследних(?(ЗначениеЗаполнено(НаДату), НаДату, ТекущаяДата()), Новый Структура("ФизЛицо", ФизЛицо));
		Если ДанныеФЛ.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Результат, ДанныеФЛ[0]);
		КонецЕсли;
		
	КонецЕсли;
	
	ИтогРезультат = Неопределено;
	
	Если ВидСтроки Тогда
		
		Если ВидДанных Тогда
			ИтогРезультат = Результат;
		Иначе
			Фамилия 	= СокрЛП(Результат.Фамилия);
			Имя 		= СокрЛП(Результат.Имя);
			Отчество 	= СокрЛП(Результат.Отчество);
			ИтогРезультат = (Фамилия + " " + Имя + " " + Отчество);
		КонецЕсли;
		
	Иначе	
		Фамилия 	= СокрЛП(Результат.Фамилия);
		Имя 		= СокрЛП(Результат.Имя);
		Отчество 	= СокрЛП(Результат.Отчество);
		ИтогРезультат = (Фамилия + " " + Лев(Имя,1) + "." + Лев(Отчество,1)+ ".");
		Если СтрДлина(СокрЛП(ИтогРезультат))<= 3 Тогда
			ИтогРезультат = "";  
		КонецЕсли;
		
	КонецЕсли; 
	
	Возврат ИтогРезультат;
	
КонецФункции

// Преобразовывает исходную строку по формату представления реквизитов типа ФИО.
// Разделительные пробелы заменяет запятыми и преобразовывает символы в верхний регистр.
// 
//   Строка, преобразованная по формату МНС.
Функция СтрЗаменитьПробелы(ИсхСтрока) Экспорт
	
	ПромСтр=СокрЛП(ИсхСтрока); 
	
	Если ПустаяСтрока(ПромСтр) Тогда
		ПромСтр = ",,";
		
		Возврат ПромСтр;
	КонецЕсли;
	
	// Сначала удаляем возможный недопустимый символ '.'.
	ЧП = СтрЧислоВхождений(ПромСтр,".");
	Если ЧП>0 Тогда
		Для Значение = 1 По ЧП Цикл
			РезСтр=СтрЗаменить(ПромСтр,"."," ");
			ПромСтр=РезСтр;
		КонецЦикла; 
	КонецЕсли;
	
	// Число разделительных пробелов.
	ЧП=СтрЧислоВхождений(ПромСтр," ");
	Если ЧП>0 Тогда
		Для Значение = 1 По ЧП Цикл
			РезСтр  = СтрЗаменить(ПромСтр," ",",");
			ПромСтр = РезСтр;
		КонецЦикла; 
	КонецЕсли;
	
	// Проверяем соответствие формату представления.
	КолЗап = СтрЧислоВхождений(ПромСтр,",");
	Если КолЗап < 2 Тогда
		// Дополняем недостающими запятыми.
		Для Ном=(КолЗап+1) По 2 Цикл
			ПромСтр=ПромСтр+",";
		КонецЦикла;
	ИначеЕсли КолЗап > 2 Тогда
		Пока СтрЧислоВхождений(ПромСтр, ",") <> 2 Цикл
			НайденПовтор = 0;
			
			ПозицияЗапятой = Найти(ПромСтр, ",");
			Если Сред(ПромСтр, ПозицияЗапятой + 1, 1) = "," Тогда
				НачПозиция	 = ПозицияЗапятой;
				НайденПовтор = 1;
			Иначе
				ПозицияЗапятой2 = Найти(Сред(ПромСтр, ПозицияЗапятой + 1), ",");
				Если Сред(ПромСтр, ПозицияЗапятой + ПозицияЗапятой2 + 1, 1) = "," Тогда
					НачПозиция	 = ПозицияЗапятой + ПозицияЗапятой2;
					НайденПовтор = 1;
				КонецЕсли;
			КонецЕсли;	
			
			Если НайденПовтор = 1 Тогда
				ПромСтр = Лев(ПромСтр, НачПозиция) + Сред(ПромСтр, НачПозиция + 2);
			Иначе
				Если Прав(ПромСтр, 1) = "," Тогда
					// Лишние хвостовые пробелы удаляем.
					ПромСтр = Лев(ПромСтр, СтрДлина(ПромСтр) - 1);
				Иначе
					// Лишние запятые заменяем пробелами.
					ПромСтр = Лев(ПромСтр, ПозицияЗапятой - 1) + " " + Сред(ПромСтр, ПозицияЗапятой + 1); 
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Возврат ВРег(ПромСтр);         
	
КонецФункции // СтрЗаменитьПробелы()

// Получает список проживающих по ЛС на дату и с учетом истории по ЛС.
// Параметры:
// ЛС - лицевой счет;.
// Дата - дата среза.
// ИсторияПроживающих - список всех, когда-либо проживающих на ЛС.
//
// Возвращаемое значение:
// Результат - Таблица значений.
Функция ПолучитьСписокПроживающихПоЛС(ЛС, Дата, ИсторияПроживающих = Истина)Экспорт
	Если ИсторияПроживающих Тогда
		
		Условие = "";
		
	Иначе
		
		Условие = "	ГДЕ (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
		
	КонецЕсли; 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаЗаписи,
	|	бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
	|	бит_ПроживающиеПоЛССрезПоследних.ПричинаВыписки,
	|	бит_ПроживающиеПоЛССрезПоследних.ПричинаПрописки,
	|	бит_ПроживающиеПоЛССрезПоследних.КудаВыписан,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаПрибытия,
	|	бит_ПроживающиеПоЛССрезПоследних.ОткудаПрибыл,
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛС) КАК бит_ПроживающиеПоЛССрезПоследних
	| " + Условие + "
	|УПОРЯДОЧИТЬ ПО
	|	ФизЛицо";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	Запрос.УстановитьПараметр("ЛС", ЛС);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции											   

