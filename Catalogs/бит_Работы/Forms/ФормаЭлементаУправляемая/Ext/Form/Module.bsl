
#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура устанавливает отборы  
Процедура УстановитьОтборы()
	
	Эл = КоэффициентыНорм.Отбор.Работа;
	
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.Значение   = Объект.Ссылка;
	Эл.Использование    = Истина;
	
	ЭтаФорма.СоставРабот.Отбор.Элементы.Очистить();
	
	Эл = ЭтаФорма.СоставРабот.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Работа");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = Объект.Ссылка;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	ЭтаФорма.ЦеныРабот.Отбор.Элементы.Очистить();

	Эл = ЭтаФорма.ЦеныРабот.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("СписокРабот");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Содержит;
	Эл.ПравоеЗначение   = Объект.Ссылка.Код;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры	

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	УстановитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельКоэффициентыОбновить(Команда)
	
	УстановитьОтборы();

КонецПроцедуры

&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.НаименованиеПолное) тогда
		Объект.НаименованиеПолное      = Объект.Наименование;
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделенияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Сначала сохраните справочник");
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделенияПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.Подразделения.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	// Запретим удалять Подразделение если оно когда либо использовалось.
	УдалениеРазрешено = Истина;
	
	Отбор = Новый Структура("Подразделение", ТекущаяСтрока.Подразделение);
	
	Строки = Объект.Подразделения.НайтиСтроки(Отбор);
	
	Если Строки.Количество() <= 1 Тогда
		
		УдалениеРазрешено = ОпределитьВозможностьУдаленияПодразделения(ТекущаяСтрока.Подразделение);	
		
		Если НЕ УдалениеРазрешено Тогда
			Отказ = Истина;
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Существуют коэффициенты норм труда, состав работ или цены по подразделению <"+ТекущаяСтрока.Подразделение+">!
			|Удаление текущего Подразделения невозможно.");
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Функция определяет возможность удаления или изменения.
// В табличной части одного подразделения на другое.
// Параметры:
//	СпособРасчета - способ расчета, ссылки на который надо проверить.
// Возвращаемое значение:
//	Булево, истина - удалять/изменять можно.
&НаСервере
Функция ОпределитьВозможностьУдаленияПодразделения(Подразделение)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_КоэффициентыНормСрезПоследних.Подразделение
	               |ИЗ
	               |	РегистрСведений.бит_КоэффициентыНорм.СрезПоследних(
	               |			,
	               |			Работа = &Работа
	               |				И Подразделение = &Подразделение) КАК бит_КоэффициентыНормСрезПоследних
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	бит_СоставРаботСрезПоследних.Подразделение
	               |ИЗ
	               |	РегистрСведений.бит_СоставРабот.СрезПоследних(
	               |			,
	               |			Работа = &Работа
	               |				И Подразделение = &Подразделение) КАК бит_СоставРаботСрезПоследних
	               |
	               |ОБЪЕДИНИТЬ ВСЕ
	               |
	               |ВЫБРАТЬ
	               |	бит_ЦеныРаботСрезПоследних.Подразделение
	               |ИЗ
	               |	РегистрСведений.бит_ЦеныРабот.СрезПоследних(
	               |			,
	               |			Работа = &Работа
	               |				И Подразделение = &Подразделение) КАК бит_ЦеныРаботСрезПоследних";
	Запрос.УстановитьПараметр("Работа", Объект.Ссылка);
	Запрос.УстановитьПараметр("Подразделение", Подразделение);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

&НаКлиенте
Процедура ЕдиницыИзмеренияПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Сначала сохраните справочник");
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЕдиницыИзмеренияПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.ЕдиницыИзмерения.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	// Запретим удалять Подразделение если оно когда либо использовалось.
	УдалениеРазрешено = Истина;
	
	Отбор = Новый Структура("ЕдиницаИзмерения", ТекущаяСтрока.ЕдиницаИзмерения);
	
	Строки = Объект.ЕдиницыИзмерения.НайтиСтроки(Отбор);
	
	Если Строки.Количество() <= 1 Тогда
		
		УдалениеРазрешено = ОпределитьВозможностьУдаленияПодразделения(ТекущаяСтрока.ЕдиницаИзмерения);	
		
		Если НЕ УдалениеРазрешено Тогда
			Отказ = Истина;
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Существуют нормы труда или цены по единице измерения <"+ТекущаяСтрока.ЕдиницаИзмерения+">!
				|Удаление текущей единицы измерения невозможно.");
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

// Процедура - обработчик события "ПриСозданииНаСервере".
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СправочникОбъект = ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.бит_Работы"));
	// Вызов механизма разделения прав доступа.
	бит_ПраваДоступа.ПередОткрытиемФормы(Отказ,СтандартнаяОбработка,СправочникОбъект,ЭтаФорма);	
	
КонецПроцедуры

// Процедура - обработчик события "ПриОткрытии".
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборы();
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельЕдИзмОсновная(Команда)
	
	ТекущаяСтрока = Элементы.ЕдиницыИзмерения.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
			Для каждого Строка Из Объект.ЕдиницыИзмерения Цикл
				
				Строка.Основная = Ложь;
				
			КонецЦикла; 
			
			Объект.ОсновнаяЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
			
			ТекущаяСтрока.Основная          = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделенияПодразделениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Элементы.Подразделения.ТекущиеДанные.Подразделение <> ВыбранноеЗначение Тогда
		УдалениеРазрешено = ОпределитьВозможностьУдаленияПодразделения(Элементы.Подразделения.ТекущиеДанные.Подразделение);
		Если НЕ УдалениеРазрешено Тогда
			СтандартнаяОбработка = Ложь;
			
			
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Существуют коэффициенты норм труда,
		    |состав работ или цены по подразделению <"+Элементы.Подразделения.ТекущиеДанные.Подразделение+">!
			|Изменение текущего Подразделения невозможно.");
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

