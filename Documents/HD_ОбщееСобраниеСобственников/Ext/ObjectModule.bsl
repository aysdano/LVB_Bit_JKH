	Попытка
		Если ТипЗнч(МКД.Улица) = Тип("СправочникСсылка.бит_СписокУлиц") Тогда
			НаименованиеУлицы = МКД.Улица.Наименование;
		Иначе
			НаименованиеУлицы = Строка(МКД.Улица);
		КонецЕсли;
		Возврат УбратьСловоУлицаИзСтрокиАдресаДляПечати(НаименованиеУлицы);
	Исключение
		Возврат "";
	КонецПопытки;
	
