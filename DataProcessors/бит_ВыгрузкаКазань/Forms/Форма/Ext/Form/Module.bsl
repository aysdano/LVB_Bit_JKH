Функция СформироватьТаблицуТарифовНаСервере();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СтавкиНаУслугиСрезПоследних.Период,
	|	бит_СтавкиНаУслугиСрезПоследних.Услуга,
	|	бит_СтавкиНаУслугиСрезПоследних.РежимПотребления,
	|	бит_СтавкиНаУслугиСрезПоследних.Поставщик,
	|	бит_СтавкиНаУслугиСрезПоследних.СпособРасчета,
	|	бит_СтавкиНаУслугиСрезПоследних.СтатусКвартиры,
	|	бит_СтавкиНаУслугиСрезПоследних.ТипКвартиры,
	|	ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.Тариф, 0) КАК Тариф
	|ИЗ
	|	РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&сг_КонецПериода, ) КАК бит_СтавкиНаУслугиСрезПоследних";
	
	Запрос.УстановитьПараметр("сг_КонецПериода", Объект.сг_КонецПериода);
	
	Результат = Запрос.Выполнить();
	
	ТаблицаТарифов = Результат.Выгрузить();
	
	ТаблицаТарифов.Сортировать("Период Возр");
	
	Возврат ТаблицаТарифов;
	
КонецФункции

&НаСервере
Функция СформироватьТаблицуЛьготниковНаСервере();
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Льготы.ФизЛицо КАК ФизЛицо,
	|	Льготы.Льгота,
	|	Льготы.СрокДействияЛьготы,
	|	ФизЛица.СтатусФизЛица.НачислятьПоНорме КАК НачислятьПоНорме,
	|	ФизЛица.СтатусФизЛица.ПроживаниеВДанныйМомент КАК ПроживаниеВДанныйМомент,
	|	Льготы.СрокЛьготыИстек,
	|	ФизЛица.ЛицевойСчет,
	|	Льготы.Льгота.Код,
	|	Льготы.Льгота.КодПоГУГЦЖС,
	|	Льготы.Льгота.ВнешнийИдентификатор,
	|	ФизЛица.Фамилия,
	|	ФизЛица.Имя,
	|	ФизЛица.Отчество,
	|	ФизЛица.ДатаРождения,
	|	Льготы.Льгота.ТипДокумента КАК ТипУдостоверения,
	|	Льготы.Льгота.ТипДокумента.Код КАК НомерУдостоверенияЛьготника,
	|	Льготы.НомерДокумента,
	|	Льготы.СерияДокумента,
	|	Льготы.ДатаВыдачи,
	|	Льготы.КемВыдан
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|		ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|		ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|		ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|		ПроживающиеПоЛССрезПоследних.ДатаЗаписи КАК ДатаЗаписи,
	|		ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|		ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|		ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|		бит_ФИОПроживающихСрезПоследних.Фамилия КАК Фамилия,
	|		бит_ФИОПроживающихСрезПоследних.Имя КАК Имя,
	|		бит_ФИОПроживающихСрезПоследних.Отчество КАК Отчество,
	|		ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения
	|	ИЗ
	|		РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК ПроживающиеПоЛССрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних КАК бит_ФИОПроживающихСрезПоследних
	|			ПО ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|	ГДЕ
	|		(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|				ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))) КАК ФизЛица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_ЛьготыПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|			бит_ЛьготыПоЛССрезПоследних.Льготы КАК Льгота,
	|			бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы КАК СрокДействияЛьготы,
	|			ВЫБОР
	|				КОГДА бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы > &Момент
	|						ИЛИ бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы = ДАТАВРЕМЯ(1, 1, 1)
	|					ТОГДА ЛОЖЬ
	|				ИНАЧЕ ИСТИНА
	|			КОНЕЦ КАК СрокЛьготыИстек,
	|			бит_ЛьготыПоЛССрезПоследних.НомерДокумента КАК НомерДокумента,
	|			бит_ЛьготыПоЛССрезПоследних.ДатаВыдачи КАК ДатаВыдачи,
	|			бит_ЛьготыПоЛССрезПоследних.КемВыдан КАК КемВыдан,
	|			бит_ЛьготыПоЛССрезПоследних.СерияДокумента КАК СерияДокумента
	|		ИЗ
	|			РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних(&Момент, ) КАК бит_ЛьготыПоЛССрезПоследних) КАК Льготы
	|		ПО ФизЛица.ФизЛицо = Льготы.ФизЛицо
	|ГДЕ
	|	ФизЛица.СтатусФизЛица.ПравоНаЛьготы = ИСТИНА
	|ИТОГИ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ФизЛицо)
	|ПО
	|	ОБЩИЕ";
	Запрос.УстановитьПараметр("Момент"		, Объект.сг_КонецПериода);
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
	
	ТаблицаЛьготников = Запрос.Выполнить().Выгрузить();
	
	ТаблицаЛьготников.Сортировать("ЛицевойСчет Возр");
	
	Возврат ТаблицаЛьготников;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеДляСтрокиЗаголовка()
	
	Дата = Формат(Объект.Дата,"ДФ=дд.ММ.гггг");
	
	Пользователь = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
	
	Телефон = "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_КонтактнаяИнформация.Тип,
	|	бит_КонтактнаяИнформация.Вид,
	|	бит_КонтактнаяИнформация.Представление,
	|	бит_КонтактнаяИнформация.Объект
	|ИЗ
	|	РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Если Строка(ВыборкаДетальныеЗаписи.Объект) = Строка(Пользователь) Тогда
			
			Телефон = ВыборкаДетальныеЗаписи.Представление;
			
		КонецЕсли;	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Объект
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если Строка(ВыборкаДетальныеЗаписи.Объект) = Строка(Пользователь) Тогда
			
			Телефон = ВыборкаДетальныеЗаписи.Представление;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	МесяцГодНачислений = Формат(Объект.сг_НачалоПериода,"ДФ=ММ.гггг");
	
	КоличествоЛС = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Организация = &Организация";
	
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Результат = Запрос.Выполнить();
	Если не Результат.Пустой() Тогда
		
		ТаблицаЛС = Результат.Выгрузить();
		
		КоличествоЛС = ТаблицаЛС.Количество();
		
	КонецЕсли;	
	
	ВерсияФормата = "2.2";
	
	Если Объект.НомерФайла = 0 Тогда
		Объект.НомерФайла = 1;
	КонецЕсли;	  	
	
	СтруктураДанныхДляЗаголовка = Новый Структура;
	СтруктураДанныхДляЗаголовка.Вставить("Дата",Дата);
	СтруктураДанныхДляЗаголовка.Вставить("Пользователь",Пользователь);
	СтруктураДанныхДляЗаголовка.Вставить("Телефон",Телефон);
	СтруктураДанныхДляЗаголовка.Вставить("МесяцГодНачислений",МесяцГодНачислений);
	СтруктураДанныхДляЗаголовка.Вставить("КоличествоЛС",КоличествоЛС);
	СтруктураДанныхДляЗаголовка.Вставить("ВерсияФормата",ВерсияФормата);
	
	Возврат СтруктураДанныхДляЗаголовка;
	
КонецФункции

&НаСервере
Функция СформироватьСтрокуДомохозяйстваНаСервере(Выборка,НоваяСтрока,СимволРазделения,ТаблицаЛьготников,КолЛьготников,ПостроительЗапросаТаблицаЗначений,КоличествоУслуг,ПредыдущийЛС)
	
	// 1.	Тип строки (Фиксированное значение: 2).					
	ТипСтроки  = 2;
	
	НоваяСтрока  = НоваяСтрока + ТипСтроки + СимволРазделения;
	
	// 2.	№ персонифицированного счета.						
	ИД = Формат(Выборка.ИдентификаторЛицевогоСчета, "ЧГ=0");
	
	НоваяСтрока  = НоваяСтрока + ИД + СимволРазделения;
	
	// 3.	№ домохозяйства в системе поставщика (№ лицевого счета).						
	ЛицевойСчет = СокрЛП(Выборка.НаименованиеЛС);
	
	НоваяСтрока  = НоваяСтрока + ЛицевойСчет + СимволРазделения;
	
	// 4.	Фамилия квартиросъемщика.
	Фамилия = Выборка.Фамилия;
	
	НоваяСтрока  = НоваяСтрока + Фамилия + СимволРазделения;
	
	// 5.	Имя квартиросъемщика.
	Имя = Выборка.Имя;
	
	НоваяСтрока  = НоваяСтрока + Имя + СимволРазделения;
	
	// 6.	Отчество квартиросъемщика.						
	Отчество = Выборка.Отчество;
	
	НоваяСтрока  = НоваяСтрока + Отчество + СимволРазделения;
	
	// 7.	Дата рождения квартиросъемщика.						
	ДатаРождения = Выборка.ДатаРождения;
	
	НоваяСтрока  = НоваяСтрока + Формат(ДатаРождения,"ДФ=дд.ММ.гггг") + СимволРазделения;
	
	// 8.	Город/район.						                        
	Город = Выборка.Город;
	
	НоваяСтрока  = НоваяСтрока + Город + СимволРазделения;
	
	// 9.	Село/деревня.						
	СелоДеревня = "";
	
	НоваяСтрока  = НоваяСтрока + СелоДеревня + СимволРазделения;
	
	// 10.	Наименование улицы.						
	Улица = Выборка.Улица;
	
	НоваяСтрока  = НоваяСтрока + Улица + СимволРазделения;
	
	// 11.	Дом.				
	Дом = Выборка.Здание;
	
	НоваяСтрока  = НоваяСтрока + Дом + СимволРазделения;
	
	// 12.	Корпус.						
	Корпус = Выборка.Корпус;
	
	НоваяСтрока  = НоваяСтрока + Корпус + СимволРазделения;
	
	// 13.	Квартира.
	Квартира = Выборка.Квартира;
	
	НоваяСтрока  = НоваяСтрока + Квартира + СимволРазделения;
	
	// 14.	Комната.
	Комната = "";
	
	НоваяСтрока  = НоваяСтрока + Комната + СимволРазделения;
	
	// 15.	Количество жильцов.						
	КолПроживающих = Выборка.КолПроживающих;
	
	НоваяСтрока  = НоваяСтрока + КолПроживающих + СимволРазделения;
	
	// 16.	Количество комнат.						
	КоличествоКомнат = Выборка.Квартира.КоличествоКомнат;
	
	НоваяСтрока  = НоваяСтрока + КоличествоКомнат + СимволРазделения;
	
	// 17.	Общая площадь.						
	ОбщаяПлощадь = Выборка.ОбщаяПлощадь;
	
	Если ОбщаяПлощадь <= 0 Тогда
		ОбщаяПлощадь = 0;
	КонецЕсли;
	
	НоваяСтрока  = НоваяСтрока + ОбщаяПлощадь + СимволРазделения;
	
	// 18.	Отапливаемая площадь.						
	ОтапливаемаяПлощадь = Выборка.ОтапливаемаяПлощадь;
	
	Если ОтапливаемаяПлощадь <= 0 Тогда
		ОтапливаемаяПлощадь = 0;
	КонецЕсли;
	
	НоваяСтрока  = НоваяСтрока + ОтапливаемаяПлощадь + СимволРазделения;
	
	// 19.	Количество коров.
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 20.	Количество свиней.
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 21.	Количество коз и овец.
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 22.	Количество лошадей.
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 23.	Наличие эл. котла (1-да, 0 -нет).
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 24.	Наличие эл. плиты (1-да, 0 -нет).
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 25.	Наличие газовой плиты (1-да, 0 -нет).
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 26.	Наличие газовой колонки (1-да, 0 –нет).
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 27.	Наличие АГВ (1-да, 0 –нет).
	НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
	
	// 28.	Код типа жилья по газоснабжению (из справочника).
	КодТипаЖильяПоГазоснабжению = Выборка.ЛицевойСчет.Здание.ТипЖилФонда.КодТипаЖильяПоГазоснабжению;
	Если КодТипаЖильяПоГазоснабжению = 0 Тогда
		КодТипаЖильяПоГазоснабжению = ""
	КонецЕсли;	
	
	НоваяСтрока  = НоваяСтрока + КодТипаЖильяПоГазоснабжению + СимволРазделения;
	
	// 29.	Код типа жилья по водоснабжению (из справочника).
	КодТипаЖильяПоВодоснабжению = Выборка.ЛицевойСчет.Здание.ТипЖилФонда.КодТипаЖильяПоВодоснабжению;
	Если КодТипаЖильяПоВодоснабжению = 0 Тогда
		КодТипаЖильяПоВодоснабжению = ""
	КонецЕсли;	
	
	НоваяСтрока  = НоваяСтрока + КодТипаЖильяПоВодоснабжению + СимволРазделения;
	
	// 30.	Количество строк по льготникам (Строка – льготник).						
	Для каждого Строка из ТаблицаЛьготников Цикл
		
		Если Строка.ЛицевойСчет = Выборка.ЛицевойСчет Тогда
			
			КолЛьготников = КолЛьготников + 1;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	НоваяСтрока  = НоваяСтрока + КолЛьготников + СимволРазделения;
	
	// 31.	Количество строк по услугам (Строка – услуга).
	
	КоличествоУслуг = 0;
	
	Если НЕ	ПредыдущийЛС = Выборка.Лицевойсчет Тогда
		
		Для каждого СтрокаУслуга из ПостроительЗапросаТаблицаЗначений Цикл
			
			Если СтрокаУслуга.ЛицевойСчет = Выборка.ЛицевойСчет Тогда
				
				КоличествоУслуг = КоличествоУслуг + 1;
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЕсли;
	
	НоваяСтрока  = НоваяСтрока + КоличествоУслуг + СимволРазделения;
	
	// 32.	Факт хищения коммунальных услуг.
	
	ФактХищения = 0;
	
	НоваяСтрока  = НоваяСтрока + ФактХищения + СимволРазделения;
	
	// 33.	Необходимость приостановки выплаты льгот за ЖКУ (1-да, 0 –нет).						
	
	НеобходимостьПриостановкиВыплатыЛьгот = 0;
	
	НоваяСтрока  = НоваяСтрока + НеобходимостьПриостановкиВыплатыЛьгот + СимволРазделения;
	
	Возврат НоваяСтрока;					
	
КонецФункции

&НаСервере
Функция СформироватьСтрокуЛьготникаНаСервере(Текст,Выборка,НоваяСтрока,СимволРазделения,ТаблицаЛьготников,НомерНосителяКатегорииЛьгот)
	
	Для Каждого СтрокаЛьготник из ТаблицаЛьготников Цикл
		
		Если СтрокаЛьготник.ЛицевойСчет = Выборка.ЛицевойСчет Тогда
			
			ЕстьЛьготник = Истина;
			
			КодЛьготы = СтрокаЛьготник.ЛьготаКодПоГУГЦЖС;
			
			НомерНосителяКатегорииЛьгот = НомерНосителяКатегорииЛьгот + 1;
			
			// 1.	Тип строки (Фиксированное значение: 3).
			ТипСтроки  = 3;
			
			НоваяСтрока  = "" + ТипСтроки + СимволРазделения;
			// 2.	Код льготной категории (из справочника).		
			НоваяСтрока  = НоваяСтрока + КодЛьготы + СимволРазделения;
			
			// 3.	№ носителя  категории льгот в домохозяйстве.	
			НоваяСтрока  = НоваяСтрока + НомерНосителяКатегорииЛьгот + СимволРазделения;
			
			// 4.	Фамилия носителя  категории льгот.
			НоваяСтрока  = НоваяСтрока + СтрокаЛьготник.Фамилия + СимволРазделения;
			
			// 5.	Имя носителя  категории льгот.
			НоваяСтрока  = НоваяСтрока + СтрокаЛьготник.Имя + СимволРазделения;
			
			// 6.	Отчество носителя  категории льгот.
			НоваяСтрока  = НоваяСтрока + СтрокаЛьготник.Отчество + СимволРазделения;
			
			// 7.	Дата рождения носителя  категории льгот.
			НоваяСтрока  = НоваяСтрока + Формат(СтрокаЛьготник.ДатаРождения,"ДФ=дд.ММ.гггг") + СимволРазделения;
			
			// 8.	Тип удостоверения льготника.
			НоваяСтрока  = НоваяСтрока + СтрокаЛьготник.ТипУдостоверения + СимволРазделения;
			
			// 9.	Серия удостоверения льготника.
			НоваяСтрока  = НоваяСтрока + СтрокаЛьготник.СерияДокумента + СимволРазделения;
			
			// 10.	Номер удостоверения льготника.
			НоваяСтрока  = НоваяСтрока + СтрокаЛьготник.НомерДокумента + СимволРазделения;
			
			// 11.	Дата выдачи удостоверения льготника.
			НоваяСтрока  = НоваяСтрока + Формат(СтрокаЛьготник.ДатаВыдачи,"ДФ=дд.ММ.гггг") + СимволРазделения;
			
			// 12.	Дата начала действия льготы.
			НоваяСтрока  = НоваяСтрока + Формат(СтрокаЛьготник.ДатаВыдачи,"ДФ=дд.ММ.гггг") + СимволРазделения;
			
			// 13.	Дата окончания действия льготы.
			НоваяСтрока  = НоваяСтрока + Формат(СтрокаЛьготник.СрокДействияЛьготы,"ДФ=дд.ММ.гггг") + СимволРазделения;
			
			// 14.	Количество членов семьи, на которых распространяется льгота.
			НоваяСтрока  = НоваяСтрока + 0 + СимволРазделения;
			
			// ДОБАВЛЕНИЕ СТРОКИ Льготник В ТЕКСТОВЫЙ ФАЙЛ.	
			Текст.ДобавитьСтроку(НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Текст;
	
КонецФункции	

&НаСервере
Функция СформироватьСтрокуУслугиНаСервере(Текст,Выборка,СимволРазделения,ТаблицаТарифов,ТаблицаЛьготников,КолЛьготников,КоличествоУслуг,ТаблицаЛьгот,ТЗПерерасчетЛьгот,ТЗРазовые,КоличествоСтрокПерерасчетов,ПредыдущийЛС,КоличествоСтрокЛьгот)

	// 1.	Тип строки (Фиксированное значение: 4).	
	ТипСтроки  = 4;
	
	НоваяСтрока  = "" + ТипСтроки + СимволРазделения;
	
	// 2.	Код услуги (из справочника).	
	КодУслуги = Выборка.Услуга.КодПоГУГЦЖС;
	
	НоваяСтрока  = НоваяСтрока + КодУслуги + СимволРазделения;
	
	// 3.	Входящее сальдо (Долг на начало месяца).	
	НачальноеСальдо = Выборка.НачальноеСальдо;
	
	НоваяСтрока  = НоваяСтрока + НачальноеСальдо + СимволРазделения;
	
	// 4.	Экономически обоснованный тариф. 	
	Для каждого строка из ТаблицаТарифов Цикл
		
		Если строка.Услуга = Выборка.Услуга и строка.ТипКвартиры = Выборка.ТипКвартиры
			и строка.СтатусКвартиры = Выборка.СтатусКвартиры 
			и строка.РежимПотребления = Выборка.РежимПотребления 
			и строка.Поставщик = Выборка.Поставщик 
			и строка.СпособРасчета = Выборка.СпособРасчета Тогда
			
			Тариф = строка.Тариф;
			
		КонецЕсли;	
		
	КонецЦикла;	
	
	НоваяСтрока  = НоваяСтрока + Тариф + СимволРазделения;
	
	// 5.	Регулируемый тариф.	
	НоваяСтрока  = НоваяСтрока + Тариф + СимволРазделения;
	
	// 6.	Код единицы измерения расхода (из справочника).
	Если Выборка.Услуга.СпособыРасчета.количество() = 0 Тогда
		КодЕдиницыИзмерения = "";
		
	Иначе	
		
		Для каждого Строка из Выборка.Услуга.СпособыРасчета Цикл
			
			Если Строка.СпособРасчета = Выборка.СпособРасчета Тогда
				
				КодЕдиницыИзмерения = Строка.ЕдИзм.Код;
				
			КонецЕсли;	
			
		КонецЦикла;;	
		
	КонецЕсли;	
	
	НоваяСтрока  = НоваяСтрока + КодЕдиницыИзмерения + СимволРазделения;
	
	// 7.	Расход фактический.
	РасходФактический = Выборка.Норма + Выборка.СверхНорма;
	
	НоваяСтрока  = НоваяСтрока + РасходФактический + СимволРазделения;
	
	// 8.	Расход по социальному нормативу.
	НоваяСтрока  = НоваяСтрока + Выборка.Норма + СимволРазделения;
	
	// 9.	Наличие прибора учета(1-по счетчику / 0-без счетчика).
	Если Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")
		или Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")
		или Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")
		или Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам") Тогда
		
		НаличиеПрибораУчета = 1;
		
	Иначе
		НаличиеПрибораУчета = 0;
		
	КонецЕсли;
	
	НоваяСтрока  = НоваяСтрока + НаличиеПрибораУчета + СимволРазделения;
	
	// 10.	Сумма начисления по социальному нормативу по регулируемому тарифу.
	
	НоваяСтрока  = НоваяСтрока + Выборка.СуммаНачислений + СимволРазделения;
	
	// 11.	Сумма перерасчета начисления по социальному нормативу по регулируемому тарифу за предыдущий период (за все месяца).
	НоваяСтрока  = НоваяСтрока + Выборка.Разовые + СимволРазделения;
	
	
	// 12.	Сумма дотации
	НоваяСтрока  = НоваяСтрока + Выборка.СуммаНачислений + СимволРазделения;
	
	// 13.	Сумма перерасчета дотации за предыдущий период (за все месяца).
	НоваяСтрока  = НоваяСтрока + Выборка.Разовые + СимволРазделения;
	
	// 14.	Сумма льготы (Общая сумма льготы по всем категориям льгот для данной услуги).
	
	СуммаЛьготы = 0;
	
	Для каждого СтрокаЛьготы из ТаблицаЛьгот Цикл
		Если СтрокаЛьготы.ЛицевойСчет = Выборка.ЛицевойСчет и СтрокаЛьготы.Услуга = Выборка.Услуга Тогда
			
			СуммаЛьготы = СуммаЛьготы + СтрокаЛьготы.НачисленоЛьготы;
			
		КонецЕсли;
	КонецЦикла;
	
	НоваяСтрока  = НоваяСтрока + СуммаЛьготы + СимволРазделения;
	
	
	// 15.	Сумма перерасчета льготы за предыдущий период (Общая по всем категориям льгот для данной услуги) (за все месяца).
	
	СуммаПерерасчетаЛьготы = 0;
	Если Выборка.Разовые <> 0 Тогда
		
		Для Каждого СтрокаТЗПерерасчетЛьгот из ТЗПерерасчетЛьгот Цикл
			
			Если СтрокаТЗПерерасчетЛьгот.ЛицевойСчет = Выборка.ЛицевойСчет и СтрокаТЗПерерасчетЛьгот.УслугаЖКХ = Выборка.Услуга и СтрокаТЗПерерасчетЛьгот.ВидДвижения = ВидДвиженияНакопления.Приход Тогда
				СуммаПерерасчетаЛьготы  = СуммаПерерасчетаЛьготы + СтрокаТЗПерерасчетЛьгот.Сумма;
			ИначеЕсли СтрокаТЗПерерасчетЛьгот.ЛицевойСчет = Выборка.ЛицевойСчет и СтрокаТЗПерерасчетЛьгот.УслугаЖКХ = Выборка.Услуга и СтрокаТЗПерерасчетЛьгот.ВидДвижения = ВидДвиженияНакопления.Расход Тогда	
				СуммаПерерасчетаЛьготы  = СуммаПерерасчетаЛьготы - СтрокаТЗПерерасчетЛьгот.Сумма;
			КонецЕсли;	  
			
		КонецЦикла;	
		
		
	КонецЕсли;
	
	НоваяСтрока  = НоваяСтрока + СуммаПерерасчетаЛьготы + СимволРазделения;
	
	// 16.	Сумма оплаты, поступившие за месяц начислений.
	
	СуммаОплаты = Выборка.СуммаОплаты;
	
	НоваяСтрока  = НоваяСтрока + СуммаОплаты + СимволРазделения;
	
	// 17.	Количество строк перерасчетов начисления по социальному нормативу.
	// По регулируемому тарифу по месяцам (Строка – перерасчеты начисления для каждой услуги).
	
	ПредыдущаяСтрокаПериод = "";
	КоличествоСтрокПерерасчетов =0;
	Для каждого СтрокаРазовые из ТЗРазовые Цикл
		
		Если СтрокаРазовые.ЛицевойСчет = Выборка.ЛицевойСчет и СтрокаРазовые.УслугаЖКХ = Выборка.Услуга Тогда
			
			Если Формат(СтрокаРазовые.Период,"ДФ=ММ.гггг") <> ПредыдущаяСтрокаПериод Тогда
				
				КоличествоСтрокПерерасчетов	= КоличествоСтрокПерерасчетов + 1;
				
				ПредыдущаяСтрокаПериод = Формат(СтрокаРазовые.Период,"ДФ=ММ.гггг");
			КонецЕсли;	
		КонецЕсли;	
		
	КонецЦикла;	
	
	НоваяСтрока  = НоваяСтрока + КоличествоСтрокПерерасчетов + СимволРазделения;
	
	// 18.	Количество строк начисленных льгот по категориям (Строка – начисленная льгота).
	
	ПредыдущаяСтрокаЛьгота = "";
	КоличествоСтрокЛьгот =0;
	Для каждого СтрокаЛьгота из ТаблицаЛьгот Цикл
		
		Если СтрокаЛьгота.ЛицевойСчет = Выборка.ЛицевойСчет и СтрокаЛьгота.Услуга = Выборка.Услуга Тогда
			
			Если НЕ СтрокаЛьгота.СрокЛьготыИстек и СтрокаЛьгота.Льгота <> ПредыдущаяСтрокаЛьгота Тогда
				
				КоличествоСтрокЛьгот = КоличествоСтрокЛьгот + 1;
				ПредыдущаяСтрокаЛьгота = СтрокаЛьгота.Льгота;
				
			КонецЕсли;	
			
		КонецЕсли;	
		
	КонецЦикла;
	
	НоваяСтрока  = НоваяСтрока + КоличествоСтрокЛьгот + СимволРазделения;
	
	Текст.ДобавитьСтроку(НоваяСтрока);
	
	Возврат Текст;
	
КонецФункции	

&НаСервере
Функция СформироватьТаблицуЛьготНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.СуммаОборот, 0)) КАК НачисленоЛьготы,
	|	СУММА(ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.СуммаРазовыхОборот, 0)) КАК НачисленоЛьготыРазовые,
	|	СУММА(ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.СуммаСемейнойОборот, 0)) КАК НачисленоЛьготыСемейной,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	|	бит_НачислениеПоЛьготамОбороты.Услуга,
	|	бит_НачислениеПоЛьготамОбороты.Льгота,
	|	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	|	СУММА(ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.ОбъемОборот, 0)) КАК НачисленоЛьготыОбъем,
	|	ВЫБОР
	|		КОГДА бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы > &сг_КонецПериода
	|				ИЛИ бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК СрокЛьготыИстек
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПоЛьготам.Обороты(, &сг_КонецПериода, , ) КАК бит_НачислениеПоЛьготамОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних(&сг_КонецПериода, ) КАК бит_ЛьготыПоЛССрезПоследних
	|		ПО бит_НачислениеПоЛьготамОбороты.Льгота = бит_ЛьготыПоЛССрезПоследних.Льготы
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	|	бит_НачислениеПоЛьготамОбороты.Услуга,
	|	бит_НачислениеПоЛьготамОбороты.Льгота,
	|	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	|	ВЫБОР
	|		КОГДА бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы > &сг_КонецПериода
	|				ИЛИ бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("сг_НачалоПериода",Объект.сг_НачалоПериода);
	Запрос.УстановитьПараметр("сг_КонецПериода",Объект.сг_КонецПериода);
	
	Результат = Запрос.Выполнить();
	
	ТаблицаЛьгот = Результат.Выгрузить();
	
	ТаблицаЛьгот.Сортировать("ЛицевойСчет Возр");
	
	Возврат ТаблицаЛьгот;
	
КонецФункции

&НаСервере
Процедура ОбработатьВыбранныеЗначения(ВыбранноеЗначение)
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресЛСВХранилище);
	
	Если ТаблицаЛС = Неопределено Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка получения данных из временного хранилища. Выполните подбор заново.");
		Возврат;
		
	КонецЕсли; 
	
	Для каждого СтрокаЛС Из ТаблицаЛС Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет", СтрокаЛС.ЛицевойСчет);
		
		Поиск = Объект.ОтборЛицевыхСчетов.НайтиСтроки(Отбор);
		
		Если Поиск.Количество() = 0 Тогда
			
			НоваяСтрока = Объект.ОтборЛицевыхСчетов.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаЛС);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

#КонецОбласти