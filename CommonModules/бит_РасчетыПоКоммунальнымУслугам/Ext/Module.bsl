			Пока ВыборкаУслуга.Следующий() Цикл
				
				// Пересчет погрешности Начало:{
				ПогрешностьНачислений = 0;
				ПогрешностьФакта      = 0;
				
				КоличествоПроживающих = ?(ВыборкаУслуга.КоличествоПроживающих = 0, 1, ВыборкаУслуга.КоличествоПроживающих);
				
				НачисленоПоУслуге     = ВыборкаУслуга.Начислено;
				ФактПоУслуге          = ВыборкаУслуга.Факт;
				
				НачисленоПоПрож       = Окр(НачисленоПоУслуге/КоличествоПроживающих,4);
				ФактПоПрож            = ОКР(ФактПоУслуге/КоличествоПроживающих,4);
				
				// Расчет поргешности только для льгот распространяющихся по факту начислений
				Если ВыборкаУслуга.Распространение = Перечисления.бит_РаспространениеЛьготы.ПоФакту
					И НЕ ВыборкаУслуга.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет Тогда
					
					СтавкаЛьготы       = ?(НЕ ВыборкаУслуга.СемейнаяСтавка = 0, ВыборкаУслуга.СемейнаяСтавка, ВыборкаУслуга.ЛичнаяСтавка);
					
					СуммаДляПроверки   = НачисленоПоПрож * КоличествоПроживающих; 
					ФактДляПроверки    = ФактПоПрож      * КоличествоПроживающих;
					
					ПогрешностьНачислений = НачисленоПоУслуге - СуммаДляПроверки;
					ПогрешностьФакта      = ФактПоУслуге      - ФактДляПроверки;
					
				КонецЕсли;
				// Пересчет погрешности }Конец
				
				Выборка = ВыборкаУслуга.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					ПоПлощадям = (Выборка.СпособРасчета   = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади
					ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади
					ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади);
					
					Норма         = 0;
					Начислено     = 0;
					НормаСемейная = 0;
					
