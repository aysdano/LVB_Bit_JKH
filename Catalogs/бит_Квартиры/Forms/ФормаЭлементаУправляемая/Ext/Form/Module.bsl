&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// БИТ_ЖКХ 11.03.2016 13:23:02 Начало правки...
	НаборСведенияОКвартире = РегистрыСведений.бит_СведенияОКвартире.СоздатьНаборЗаписей();
	НаборСведенияОКвартире.Отбор.Квартира.Установить(ТекущийОбъект.Ссылка);
	НаборСведенияОКвартире.Прочитать();
	Если НаборСведенияОКвартире.Количество() = 0 Тогда
		СоздатьЗапись = Истина;
	Иначе
		СоздатьЗапись = Ложь;
	КонецЕсли;
	// БИТ_ЖКХ 11.03.2016 13:23:04 Конец правки. 
	
	Попытка
		ТекущийОбъект.Записать();
	Исключение
		СоздатьЗапись = Ложь;
	КонецПопытки;
	
	Если СоздатьЗапись Тогда
		
		
		НовыйНабор = РегистрыСведений.бит_СведенияОКвартире.СоздатьНаборЗаписей();
		НовыйНабор.Отбор.Квартира.Установить(ТекущийОбъект.Ссылка);
		НовыйНабор.Прочитать();
		
		НоваяЗапись = НовыйНабор.Добавить();
		
		НоваяЗапись.Период         = НаДату;
		НоваяЗапись.Квартира       = ТекущийОбъект.Ссылка;
		НоваяЗапись.СтатусКвартиры = Справочники.бит_СтатусыКвартиры.Приватизированная;
		НоваяЗапись.ТипКвартиры    = Справочники.бит_ТипыКвартиры.Отдельная;
		
		Попытка
			НовыйНабор.Записать();
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры
