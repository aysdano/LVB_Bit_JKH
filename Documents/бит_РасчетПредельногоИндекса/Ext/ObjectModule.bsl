#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем мРасчетДолей                        Экспорт;  // Хранит флаг настройки ЖКХ.
Перем мУменьшитьНормуЛьготы               Экспорт;  // Хранит флаг настройки ЖКХ.
Перем мУчетДнейПРоживания                 Экспорт;  // Хранит флаг настройки ЖКХ.
Перем мОбщедомовыеРасходыВГрафеНачисления Экспорт;  // Хранит флаг настройки ЖКХ.
Перем мСчетчикиПодкрутка                  Экспорт;  // Хранит флаг настройки ЖКХ.
Перем мЛьготаПерсонифицированная          Экспорт;  // Хранит флаг настройки ЖКХ.
Перем мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика Экспорт; // Хранит флаг настройки ЖКХ.

// БИТ_ЖКХ_06102013_начало_изменений
Перем мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика Экспорт; // Хранит флаг настройки ЖКХ.
// БИТ_ЖКХ_06102013_окончание_изменений

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункцииДокумента

Процедура ОбновитьПараметрыЖКХ() Экспорт
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("РасчетСУчетомДолейВладения"         , Ложь);
	ПараметрыЖКХ.Вставить("УменьшениеНормыЛьготыВПределахФакта", Ложь);
	ПараметрыЖКХ.Вставить("НачислениеСУчетомДнейПроживания"    , Ложь);
	ПараметрыЖКХ.Вставить("ОбщедомовыеРасходыВГрафеНачисления" , Ложь);
	ПараметрыЖКХ.Вставить("СчетчикиПодкрутка"                  , Ложь);
	ПараметрыЖКХ.Вставить("ЛьготаПерсонифицированная"          , Ложь); 	
	ПараметрыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	
	// БИТ_ЖКХ_06102013_начало_изменений
	ПараметрыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	// БИТ_ЖКХ_06102013_окончание_изменений
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецМесяца(Дата), Организация, ПараметрыЖКХ);
	
	мРасчетДолей          = ПараметрыЖКХ.РасчетСУчетомДолейВладения;
	мУменьшитьНормуЛьготы = ПараметрыЖКХ.УменьшениеНормыЛьготыВПределахФакта;
	мУчетДнейПРоживания   = ПараметрыЖКХ.НачислениеСУчетомДнейПроживания;
	
	мОбщедомовыеРасходыВГрафеНачисления = ПараметрыЖКХ.ОбщедомовыеРасходыВГрафеНачисления;
	мСчетчикиПодкрутка                  = ПараметрыЖКХ.СчетчикиПодкрутка;
	мЛьготаПерсонифицированная          = ПараметрыЖКХ.ЛьготаПерсонифицированная;
	
	мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика = ПараметрыЖКХ.РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика;
	
	// БИТ_ЖКХ_06102013_начало_изменений
	мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика = ПараметрыЖКХ.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика;
	// БИТ_ЖКХ_06102013_окончание_изменений
	
КонецПроцедуры

Процедура ВыполнитьРасчет() Экспорт
	
	Начисления.Очистить();
	
	ОбновитьПараметрыЖКХ();
	
	СписокЛС     = Новый Массив;
	СписокЗданий = Новый Массив;
	
	СписокЗданий.Добавить(Здание);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Здание = &Здание
	|	И бит_ЛицевыеСчета.УлицаЛицевогоСчета = &УлицаЛицевогоСчета";
	
	Запрос.УстановитьПараметр("УлицаЛицевогоСчета", Улица);
	Запрос.УстановитьПараметр("Здание"            , Здание);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокЛС = Результат.ВыгрузитьКолонку("ЛицевойСчет");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоСчетчикам.Дата
	|ИЗ
	|	Документ.бит_НачисленияПоСчетчикам КАК бит_НачисленияПоСчетчикам
	|ГДЕ
	|	бит_НачисленияПоСчетчикам.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	|	И бит_НачисленияПоСчетчикам.Улица = &Улица
	|	И бит_НачисленияПоСчетчикам.Здание = &Здание
	|	И бит_НачисленияПоСчетчикам.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ДатаНачала"    , НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("ДатаОкончания" , КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Улица"         , Улица);
	Запрос.УстановитьПараметр("Здание"        , Здание);
	Запрос.УстановитьПараметр("Организация"   , Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДатаЗапроса = Дата(1,1,1);
	
	Пока Выборка.Следующий() Цикл
		
		ДатаЗапроса = Выборка.Дата;
		
	КонецЦикла;
	
	ТаблицаНачислений = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуНачислений();
	
	Если ДатаЗапроса = Дата(1,1,1) Тогда
		
		ТаблицаСчетчиков = Неопределено;
		
	Иначе
		
		ТаблицаСчетчиков  = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
		
	КонецЕсли;
	
	бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(ДатаЗапроса, 
	Организация, 
	СписокЛС, 
	СписокЗданий, 
	, 
	, 
	ТаблицаНачислений, 
	ТаблицаСчетчиков, 
	, 
	,
	,
	,
	мРасчетДолей,
	мУменьшитьНормуЛьготы, 
	мУчетДнейПРоживания, 
	, 
	,
	// БИТ_ЖКХ_06102013_начало_изменений
	// мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика);.
	мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика,
	мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика);
	// БИТ_ЖКХ_06102013_окончание_изменений
	
	// Начисление по лицевым счетам.
	Если ТаблицаНачислений.Количество() > 0 Тогда
		
		бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаНачислений);
		ЗаполнениеСчетовКУ(ТаблицаНачислений);		
		
		Для каждого СтрокаНачислений Из ТаблицаНачислений Цикл
			
			Если СтрокаНачислений.НачислятьПредельныйИндекс Тогда
				
				СтрокаНачисления = Начисления.Добавить();
				
				ЗаполнитьЗначенияСвойств(СтрокаНачисления, СтрокаНачислений);
				
				Если СтрокаНачислений.ГруппаУслуги = Справочники.бит_ГруппыУслуг.ПустаяСсылка() Тогда
					
					СтрокаНачисления.ГруппаУслуги    = СтрокаНачислений.Услуга;
					
				КонецЕсли;
				
				СтрокаНачисления.Поставщик            = СтрокаНачислений.МойПоставщик;
				СтрокаНачисления.ОбъемПоНормативамДо  = СтрокаНачислений.ОбъемДо;
				СтрокаНачисления.ОбъемПоНормативам    = СтрокаНачислений.Объем;
				// БИТ_ЖКХ_10012014_начало_изменений
				СтрокаНачисления.ПоказанияСчетчика    = 0;
				// БИТ_ЖКХ_10012014_окончание_изменений
				СтрокаНачисления.ОбъемПоСчетчикам     = 0;
				СтрокаНачисления.Превышение           = СтрокаНачислений.Начислено - (СтрокаНачислений.НачисленоДо * (1 + (СтрокаНачислений.ПредельныйИндекс/100)));
				СтрокаНачисления.ПревышениеВПроцентах = ?(СтрокаНачислений.НачисленоДо = 0, 0, 
				(СтрокаНачислений.Начислено * 100) /(СтрокаНачислений.НачисленоДо * (1 + (СтрокаНачислений.ПредельныйИндекс/100))));
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Начисление по счетчикам.	
	Если ТаблицаСчетчиков <> Неопределено Тогда
		
		ТаблицаСчетчиков.Свернуть("ЛицевойСчет, Услуга, Ставка, СверхномСтавка, Тариф, ТарифДо, СтавкаДо, СверхномСтавкаДо, ПредельныйИндекс, НачислятьПредельныйИндекс, ГруппаУслуги, ПериодСравнения, ПлановаяСтавка, ПлановаяСтавкаДо, МойПоставщик, ЕдИзм","Факт, Начислено, НачисленоДо, Норма, СверхНорма, Объем, КоличествоЕдиниц");
		
		Если ТаблицаСчетчиков.Количество() > 0 Тогда
			
			бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаСчетчиков);
			ЗаполнениеСчетовКУ(ТаблицаСчетчиков);
			
			Для каждого СтрокаСчетчиков Из ТаблицаСчетчиков Цикл
				
				Если СтрокаСчетчиков.НачислятьПредельныйИндекс Тогда
					
					СтрокаНачисления = Начисления.Добавить();
					
					ЗаполнитьЗначенияСвойств(СтрокаНачисления, СтрокаСчетчиков);
					
					Если СтрокаСчетчиков.ГруппаУслуги = Справочники.бит_ГруппыУслуг.ПустаяСсылка() Тогда
						
						СтрокаНачисления.ГруппаУслуги    = СтрокаСчетчиков.Услуга;
						
					КонецЕсли;
					
					СтрокаНачисления.Поставщик            = СтрокаСчетчиков.МойПоставщик;
					СтрокаНачисления.ОбъемПоНормативамДо  = 0;
					СтрокаНачисления.ОбъемПоНормативам    = 0;
					// БИТ_ЖКХ_10012014_начало_изменений
					СтрокаНачисления.ПоказанияСчетчика    = СтрокаСчетчиков.КоличествоЕдиниц;
					// БИТ_ЖКХ_10012014_окончание_изменений
					СтрокаНачисления.ОбъемПоСчетчикам     = СтрокаСчетчиков.Объем;
					СтрокаНачисления.Превышение           = СтрокаСчетчиков.Начислено - (СтрокаСчетчиков.НачисленоДо * (1 + (СтрокаСчетчиков.ПредельныйИндекс/100)));
					СтрокаНачисления.ПревышениеВПроцентах = ?(СтрокаСчетчиков.НачисленоДо = 0, 0, 
					(СтрокаСчетчиков.Начислено * 100) /(СтрокаСчетчиков.НачисленоДо * (1 + (СтрокаСчетчиков.ПредельныйИндекс/100))));
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Начисления.Сортировать("ЛицевойСчет Возр, ГруппаУслуги Возр, Услуга Возр");
	
	Для Каждого СтрокаТЧ Из Начисления Цикл
		
		ОтборТЧ = Новый Структура;
		
		ОтборТЧ.Вставить("ЛицевойСчет", СтрокаТЧ.ЛицевойСчет);
		
		Если СтрокаТЧ.ГруппаУслуги = Справочники.бит_ГруппыУслуг.ПустаяСсылка() Тогда
			
			ОтборТЧ.Вставить("Услуга", СтрокаТЧ.Услуга);
			
		Иначе
			
			ОтборТЧ.Вставить("ГруппаУслуги", СтрокаТЧ.ГруппаУслуги);
			
		КонецЕсли;
		
		МассивТЧ = Начисления.НайтиСтроки(ОтборТЧ);
		
		ИтогПоГруппе                   = 0;
		ИтогоПревышение                = 0;
		КоличествоЭлементовВГруппе     = МассивТЧ.Количество();
		ПоследнийНомерСтрокиПревышения = 0;
		НомСтр                         = 0;
		
		Для Каждого ЭлементМассива Из МассивТЧ Цикл
			
			НомСтр = НомСтр + 1;
			
			ИтогПоГруппе = ИтогПоГруппе + ЭлементМассива.Начислено - (ЭлементМассива.НачисленоДо * (1 + (ЭлементМассива.ПредельныйИндекс/100)));
			
			Если ЭлементМассива.Превышение > 0 Тогда
				
				ИтогоПревышение = ИтогоПревышение + ЭлементМассива.Превышение;
				
				ПоследнийНомерСтрокиПревышения = НомСтр;
				
			КонецЕсли;
			
		КонецЦикла;
		
		НомерСтр                   = 0;
		ОстатокПоГруппе            = ИтогПоГруппе;
		
		Для Каждого ЭлементМассива Из МассивТЧ Цикл
			
			Если ОстатокПоГруппе > 0 Тогда
				
				НомерСтр = НомерСтр + 1;
				
				Если НомерСтр = ПоследнийНомерСтрокиПревышения Тогда
					
					ЭлементМассива.СуммаНедополученныхДоходов = ОстатокПоГруппе;
					
				Иначе
					
					Если ЭлементМассива.Превышение > 0 Тогда
						
						РасчетнаяСумма = Окр(ИтогПоГруппе / ИтогоПревышение * ЭлементМассива.Превышение,2,1);
						
					Иначе
						
						РасчетнаяСумма = 0;
						
					КонецЕсли;
					
					ЭлементМассива.СуммаНедополученныхДоходов = РасчетнаяСумма;
					
					ОстатокПоГруппе = ОстатокПоГруппе - РасчетнаяСумма;
					
				КонецЕсли;
				
			Иначе
				
				ЭлементМассива.СуммаНедополученныхДоходов = 0;
				
			КонецЕсли;
			
		КонецЦикла;	
		
	КонецЦикла;
	
	ВводВручную = Ложь;
	
КонецПроцедуры

// Процедура выполняет заполнение Счетов и Субконто.
//
Процедура ЗаполнениеСчетовКУ(ТабНачисления=Неопределено) Экспорт 
	
	Если ТабНачисления=Неопределено тогда
		
		СписокЛС = Начисления.ВыгрузитьКолонку("ЛицевойСчет");
		Колонки  = Начисления.ВыгрузитьКолонки().Колонки;
		
		бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(Начисления, Колонки, СписокЛС, Организация , Дата,,,,,,Истина);
		
	Иначе
		
		СписокЛС = ТабНачисления.ВыгрузитьКолонку("ЛицевойСчет");
		Колонки  = ТабНачисления.Колонки;
		
		бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ТабНачисления, Колонки, СписокЛС, Организация , Дата,,,,,,Истина);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

Процедура ПервоначальноеЗаполнениеДокумента(ПараметрОбъектКопирования = Неопределено)
	
	бит_ОбщегоНазначения.ЗаполнитьШапкуДокумента(ЭтотОбъект
	
	// БИТ_ЖКХ 10.02.2014
	//,глЗначениеПеременной("глТекущийПользователь")
	,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь")
	// БИТ_ЖКХ 10.02.2014
	
	,ПараметрОбъектКопирования);
	
	Дата = КонецМесяца(ТекущаяДата());
	
КонецПроцедуры

// Выполняет движения по регистрам. 
//
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, Отказ, Заголовок)
	
	ДатаДока            = Дата;
	НачислениеПоУслугам = Движения.бит_НачисленияПоУслугамЖКХ;
	НачислениеПоРасчету = Движения.бит_РасчетПредельногоИндексаПоУслугамЖКХ;
	
	// БИТ_ЖКХ 15.03.2016 14:37:33 Начало правки...
	НачислениеПоУслПоПериоду = Движения.бит_НачисленияПоУслугамЖКХПоПериоду;
	// БИТ_ЖКХ 15.03.2016 14:37:33 Конец правки.
	
	Для каждого СтрокаТЧ Из ТаблицаПоУслугам Цикл
		
		ОтборТЧ = Новый Структура;
		
		ОтборТЧ.Вставить("ЛицевойСчет", СтрокаТЧ.ЛицевойСчет);
		
		Если СтрокаТЧ.ГруппаУслуги = Справочники.бит_ГруппыУслуг.ПустаяСсылка() Тогда
			
			ОтборТЧ.Вставить("Услуга", СтрокаТЧ.Услуга);
			
		Иначе
			
			ОтборТЧ.Вставить("ГруппаУслуги", СтрокаТЧ.ГруппаУслуги);
			
		КонецЕсли;
		
		МассивТЧ = Начисления.НайтиСтроки(ОтборТЧ);
		
		Итог = 0;                  
		
		Для Каждого ЭлементМассива Из МассивТЧ Цикл
			
			Итог = Итог + СтрокаТЧ.СуммаНедополученныхДоходов;
			
		КонецЦикла;
		
		Если Итог > 0 Тогда
			
			ДвижениеРасчет                                                                                    = НачислениеПоРасчету.Добавить();
			ДвижениеРасчет.Период                                                                             = ДатаДока;
