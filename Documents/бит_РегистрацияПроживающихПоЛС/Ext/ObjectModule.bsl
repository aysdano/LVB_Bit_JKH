// Проверяет правильность заполнения шапки документа.
// Если какой-то из реквизтов шапки, влияющий на проведение не заполнен или.
// Заполнен не корректно, то выставляется флаг отказа в проведении.
// Проверяется также правильность заполнения реквизитов ссылочных полей документа.
// Проверка выполняется по объекту и по выборке из результата запроса по шапке.
//
// Параметры: 
//  СтруктураШапкиДокумента - выборка из результата запроса по шапке документа,
//  Отказ                   - флаг отказа в проведении,
//  Заголовок               - строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок)
	
	// Укажем, что надо проверить:
	ОбязательныеРеквизитыШапки = "ЛицевойСчет";
	
	СтруктураОбязательныхПолей = Новый Структура(ОбязательныеРеквизитыШапки);
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры // ПроверитьЗаполнениеШапки()

// Процедура проверяет правильность заполнения реквизитов документа.
//
Процедура ПроверкаРеквизитовТЧ(ТаблицаОС,СтруктураШапкиДокумента,Отказ, Заголовок) Экспорт
	
	РеквизитыТабСписокУслуг = "Физлицо"; //через запятую
	
	СтруктураОбязательныхПолей = Новый Структура(РеквизитыТабСписокУслуг);
	
	ПредставлениеТабличнойЧасти = ЭтотОбъект.Метаданные().ТабличныеЧасти.СписокПроживающих.Представление();
	
	МетаданныеРеквизиты = ЭтотОбъект.Метаданные().ТабличныеЧасти.СписокПроживающих.Реквизиты;
	
	Для каждого СтрокаТаблицы Из СписокПроживающих Цикл
		
		СтрокаНачалаСообщенияОбОшибке = "Строка номер "+ СокрЛП(СтрокаТаблицы.НомерСтроки) +
		" табличной части """ + " Список проживающих" + """: ";
		
		// Цикл по проверяемым полям.
		Для каждого КлючЗначение Из СтруктураОбязательныхПолей Цикл
			
			Значение = СтрокаТаблицы[КлючЗначение.Ключ];
			
			Если НЕ ЗначениеЗаполнено(Значение) Тогда 
				
				Если СтрокаТаблицы.ВладелецКвартиры = Перечисления.ДаНет.Да И КлючЗначение.Ключ  = "ДатаРегистрации" Тогда
					
					Продолжить;
					
				КонецЕсли; 
				
				Если НЕ ЗначениеЗаполнено(КлючЗначение.Значение) Тогда
					ПредставлениеРеквизита = МетаданныеРеквизиты[КлючЗначение.Ключ].Представление();
					СтрокаСообщения = "Не заполнено значение реквизита """ + СокрЛП(ПредставлениеРеквизита) + """.";
					
				Иначе
					СтрокаСообщения = КлючЗначение.Значение;
					
				КонецЕсли;
				
				бит_ОбщегоНазначения.ОшибкаПриПроведении(СтрокаНачалаСообщенияОбОшибке + СтрокаСообщения, Отказ, Заголовок);
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
	// БИТ_ЖКХ 
	// Удален закоментированный участок кода.
	
	Если Не Отказ тогда
		Для Каждого ТекСтрока Из ТаблицаОС Цикл	 
			
			Если  ЗначениеЗаполнено(ТекСтрока.ДатаСнятияСРегистрации) И Не ЗначениеЗаполнено(ТекСтрока.ПричинаВыписки) Тогда
				бит_ОбщегоНазначения.ОшибкаПриПроведении("У физ. лица "+ТекСтрока.ФизЛицо+" не заполнен рекзвизит ""Причина выписки""", Отказ, Заголовок)
			КонецЕсли;
			
			Если ТекСтрока.СтатусФизЛица = Справочники.бит_СтатусФизЛица.Выписан И НЕ ЗначениеЗаполнено(ТекСтрока.ДатаСнятияСРегистрации) Тогда
				бит_ОбщегоНазначения.ОшибкаПриПроведении("У физ. лица "+ТекСтрока.ФизЛицо+" статус ""Выписан"", необходимо заполнить рекзвизит ""Дата снятия с регистрации""", Отказ, Заголовок)
			КонецЕсли;
			
		КонецЦикла;  
	КонецЕсли;
		
КонецПроцедуры // ПроверкаРеквизитов()

// Процедура проверяет добли строк.
//
Процедура ПроверитьДублиФизлиц(ТаблицаПоФизЛицам, Отказ, Заголовок)
	
	ТаблицаДублей = ТаблицаПоФизЛицам.Скопировать();
	
	// Подсчитываем количество повторений.
	ТаблицаДублей.Колонки.Добавить("КоличествоПовторений");
	ТаблицаДублей.ЗаполнитьЗначения(1, "КоличествоПовторений");
	ТаблицаДублей.Свернуть("ФизЛицо", "КоличествоПовторений");
	
	// Если количество повторений > 1, выдаем сообщение об ошибке.
	Если ?(ТаблицаДублей.Количество() > 0, ТаблицаДублей.Итог("КоличествоПовторений") / ТаблицаДублей.Количество(), 0) > 1 Тогда
		
		ТекстСообщенияОбОшибке = "";
		
		// ТаблицаПоЦБ.Индексы.Добавить("Контрагент");.
		
		// Цикл по каждому найденному повторению.
		Для Каждого СтрокаТаблицыДублей Из ТаблицаДублей Цикл
			
			Если СтрокаТаблицыДублей.КоличествоПовторений = 1 Тогда
				Продолжить; // Повторений нет.
			КонецЕсли;
			
			// Добавим перевод строки, если требуется.
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке 
			+ ?(НЕ ЗначениеЗаполнено(ТекстСообщенияОбОшибке), "", "
			|");
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке
			+ "В строках №№ "; 
			
			// Выводим номера строк.
			СписокНомеровСтрок = "";
			МассивСтрок = ТаблицаПоФизЛицам.НайтиСтроки(Новый Структура("ФизЛицо", СтрокаТаблицыДублей.ФизЛицо));
			
			Для Каждого Строка Из МассивСтрок Цикл
				СписокНомеровСтрок = СписокНомеровСтрок + ?(НЕ ЗначениеЗаполнено(СписокНомеровСтрок), "", ", ") + Строка.НомерСтроки;
			КонецЦикла;
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке
			+ СписокНомеровСтрок
			+ " табличной части ""Физ. лица"" указаны одни и те же.";
			
		КонецЦикла;
		
		бит_ОбщегоНазначения.ОшибкаПриПроведении(ТекстСообщенияОбОшибке, Отказ, Заголовок);
		
	КонецЕсли;
	Если Не Отказ тогда
		ТаблицаПроживающихСкоп = ТаблицаПоФизЛицам.Скопировать(Новый Структура("СтепеньРодства",Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо));
		КоличествоСовпадений = 0;
		Для Каждого ТекСтрока Из ТаблицаПроживающихСкоп Цикл 
			Если ТекСтрока.ДатаСнятияСРегистрации = '00010101' ИЛИ 
				ТекСтрока.ДатаСнятияСРегистрации >= КонецМесяца(Дата)
				ИЛИ ТекСтрока.лб_СтатусСтрокиДляФЛС = Перечисления.лб_ОсобенностиСтрокиРегистрации.ОставитьЖильцаНаЛС тогда	
				КоличествоСовпадений = КоличествоСовпадений + 1;
			КонецЕсли;	
		КонецЦикла;	
		Если КоличествоСовпадений > 1 Тогда
			бит_ОбщегоНазначения.ОшибкаПриПроведении("На лицевом счете должен быть один ответственный.",Отказ, Заголовок);
		ИначеЕсли КоличествоСовпадений = 1 Тогда 
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
			|ИЗ
			|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
			|			&Момент,
			|			ЛицевойСчет = &ЛицевойСчет
			|				И (НЕ ФизЛицо В (&ФизЛицо))) КАК бит_ПроживающиеПоЛССрезПоследних
			|ГДЕ бит_ПроживающиеПоЛССрезПоследних.Период >= &НачалоМесяца и
			|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент        
			|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
			|	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)";
			Запрос.УстановитьПараметр("началомесяца",началомесяца(Дата));			   
			Запрос.УстановитьПараметр("Момент",КонецМесяца(Дата));			   
			Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
			Запрос.УстановитьПараметр("ФизЛицо",ТаблицаПроживающихСкоп.ВыгрузитьКолонку("ФизЛицо"));
			Если Не Запрос.Выполнить().Пустой() тогда
				бит_ОбщегоНазначения.ОшибкаПриПроведении("На лицевом счете уже есть один ответственный.",Отказ, Заголовок);
			КонецЕсли;	
		ИначеЕсли КоличествоСовпадений = 0 Тогда 	
			Запрос = Новый Запрос;
			Запрос.Текст = "ВЫБРАТЬ
			|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
			|ИЗ
			|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
			|			&Момент,
			|			ЛицевойСчет = &ЛицевойСчет
			|				И (НЕ ФизЛицо В (&ФизЛицо))) КАК бит_ПроживающиеПоЛССрезПоследних
			|ГДЕ
			|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент  
			|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
			|	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
			|	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица <> ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.Выписан)";
			Запрос.УстановитьПараметр("Момент",КонецМесяца(Дата));
			Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
			Запрос.УстановитьПараметр("ФизЛицо",ТаблицаПроживающихСкоп.ВыгрузитьКолонку("ФизЛицо"));
			Если Запрос.Выполнить().Пустой() тогда
				бит_ОбщегоНазначения.ОшибкаПриПроведении("На конец месяца, на лицевом счете: "+ ЛицевойСчет +" не установлен ответственный.",, Заголовок);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры

// Выполняет движения по регистрам. 
//
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоФизЛицам,Отказ, Заголовок)
	
	ДатаДока = Дата;
	НачислениеПоУсл = Движения.бит_ПроживающиеПоЛС;
	
	Для каждого СтрокаТЧ Из ТаблицаПоФизЛицам Цикл
		Движение = НачислениеПоУсл.Добавить();
		Движение.Период                 		= ДатаДока;
		Движение.ЛицевойСчет            		= СтруктураШапкиДокумента.ЛицевойСчет;
		Движение.ФизЛицо                		= СтрокаТЧ.ФизЛицо;
		Движение.СтатусФизЛица          		= СтрокаТЧ.СтатусФизЛица;
		Движение.СтатусПроживания       		= СтрокаТЧ.СтатусПроживания;
		Движение.ДатаРегистрации        		= СтрокаТЧ.ДатаРегистрации;
		Движение.ДатаСнятияСРегистрации 		= СтрокаТЧ.ДатаСнятияСРегистрации;
		Движение.СтепеньРодства         		= СтрокаТЧ.СтепеньРодства;
		Движение.ДатаЗаписи             		= СтрокаТЧ.ДатаЗаписи;
		Движение.ВладелецКвартиры       		= СтрокаТЧ.ВладелецКвартиры;
		Движение.ПричинаВыписки         		= СтрокаТЧ.ПричинаВыписки;
		// БИТ_ЖКХ добавление кода Начало: 16.04.2012 
		Движение.ПричинаПрописки         		= СтрокаТЧ.ПричинаПрописки;
		//++АнисимоваМВ 1бит 11.11.2024 восстановление после сбоя
		//Движение.лб_ДатаВыпискиДляФЛС = ?(СтрокаТЧ.лб_СтатусСтрокиДляФЛС = Перечисления.лб_ОсобенностиСтрокиРегистрации.ОставитьЖильцаНаЛС 
		//							ИЛИ СтрокаТЧ.ДатаСнятияСРегистрации = Дата(1,1,1), 
		//							"", Строка(СтрокаТЧ.ДатаСнятияСРегистрации));          
		//							
		//Движение.лб_ДоляПлощадиСтрокой         		= СтрокаТЧ.лб_ДоляПлощадиСтрокой;  
		//Движение.лб_СтрокаРодствДляФЛС         		= СтрокаТЧ.лб_СтрокаРодствДляФЛС;  
		//Движение.лб_СтатусСтрокиДляФЛС         		= СтрокаТЧ.лб_СтатусСтрокиДляФЛС;     
		//Движение.бит_ПомещенВАрхив         		= СтрокаТЧ.бит_ПомещенВАрхив;     
		
		//--АнисимоваМВ 1бит 11.11.2024 восстановление после сбоя
		
		// БИТ_ЖКХ 23.12.2014{{
		Движение.КудаВыписан            		= СтрокаТЧ.КудаВыписанАдрес;
		Движение.ОткудаПрибыл            		= СтрокаТЧ.ОткудаПрибылАдрес;
		
		Движение.ДатаПрибытия            		= СтрокаТЧ.ДатаПрибытия;
		
		// БИТ_ЖКХ 23.12.2014}}
		
		Движение.ПравоустанавливающиеДокументы  = СтрокаТЧ.ПравоустанавливающиеДокументы;
		Движение.СтатусФизЛицаДляИзменения      = СтрокаТЧ.СтатусФизЛицаДляИзменения;
		
		// БИТ ЖКХ 25.06.2020
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата"       , КонецДня(ТекущаяДата()));
	//	Запрос.УстановитьПараметр("Организация", Объект.ЛицевойСчет.Организация);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НастройкаПараметровЖКХСрезПоследних.НачислениеСоДняПраваСобственности КАК НачислениеСоДняПраваСобственности
		|ИЗ
		|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата,) КАК бит_НастройкаПараметровЖКХСрезПоследних";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			НачислениеСоДняПраваСобственности = Выборка.НачислениеСоДняПраваСобственности;
		Иначе	
			НачислениеСоДняПраваСобственности = Ложь;
		КонецЕсли;

		если НачислениеСоДняПраваСобственности = истина тогда
		 Движение.ДатаПраваСобственности    		= СтрокаТЧ.ДатаПраваСобственности;
	    иначе
		 Движение.ДатаПраваСобственности    		= неопределено;
		конецесли; 
		
		Если СтрокаТЧ.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо тогда
			ДвижениеОтв = Движения.бит_ОтветственныеЛицаПоКУ.Добавить();
			ДвижениеОтв.Период      = ДатаДока;
			ДвижениеОтв.ЛицевойСчет = СтруктураШапкиДокумента.ЛицевойСчет;
			ДвижениеОтв.ФизЛицо     = СтрокаТЧ.ФизЛицо;
			ДвижениеОтв.Контрагент  = СтрокаТЧ.Контрагент;
			ДвижениеОтв.ДоговорКонтрагента  = СтрокаТЧ.ДоговорКонтрагента;
			
		КонецЕсли;
		// БИТ_ЖКХ добавление кода Начало: 20.08.2010 
		Движение.ДоляПлощади = ?(СтрокаТЧ.ВладелецКвартиры = Перечисления.ДаНет.Да,СтрокаТЧ.ДоляПлощади,0);
		// БИТ_ЖКХ добавление кода конец : 20.08.2010
	КонецЦикла;
	
	Движения.Записать();
	
КонецПроцедуры

//БИТ Михайлов работы по ЛТ№74 10.01.2022
&наСервере
Функция НазначениеОтветственногоПоЛСНаСервере()
	
	Запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
