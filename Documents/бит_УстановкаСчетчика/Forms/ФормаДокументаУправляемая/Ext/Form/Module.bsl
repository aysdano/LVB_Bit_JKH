// Процедура - обработчик события "ПриИзменении" поля ввода "Объект".
//
&НаКлиенте
Процедура ОбъектПриИзменении(Элемент)
	
	Объект.Услуги.Очистить();
	Объект.ЛицевыеСчета.Очистить();
	
	Объект.НачальныеПоказания     = 0;
	Объект.КонечныеПоказания      = 0;
	Объект.Приоритет              = 0;
	Объект.Счетчик                = Неопределено;
	Объект.СпособРасчета          = Неопределено;
	Объект.МестоУстановкиСчетчика = Неопределено;
	
	ОбъектПриИзмененииНаСервере();
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "ВидОперации".
//
&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Объект.Услуги.Очистить();
	Объект.ЛицевыеСчета.Очистить();
	Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
	Корень.Очистить();
	
	Объект.НачальныеПоказания = 0;
	Объект.КонечныеПоказания  = 0;
	Объект.Счетчик            = Неопределено;
	Объект.Объект             = ПредопределенноеЗначение("Справочник.бит_ЛицевыеСчета.ПустаяСсылка");
	
	УстановитьЗаголовокФормыДокумента();
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

