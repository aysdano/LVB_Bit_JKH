
#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура устанавливает отборы.
//
&НаКлиенте
Процедура УстановитьОтборы()
	
	СтавкиНаУслуги.Отбор.Элементы.Очистить();
	
	Попытка
		Если мКэшЗначений.ЭтоНовый = Ложь Тогда
			
			НормыУслуг.Отбор.Элементы.Очистить();
			НормыУслуг.Отбор.Элементы[0].ПравоеЗначение   = Объект.Ссылка;
			
		КонецЕсли;	
		
	Исключение
	КонецПопытки;
	
	Эл = ЭтаФорма.НормыУслуг.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Услуга");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = Объект.Ссылка;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	Эл = ЭтаФорма.СтавкиНаУслуги.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Услуга");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = Объект.Ссылка;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры	

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	КэшированныеЗначения.Вставить("РежимПотребленияПустаяСсылка", Справочники.бит_РежимыПотребленияУслуг.ПустаяСсылка());
	
	КэшированныеЗначения.Вставить("СпособРасчетаПустаяСсылка"   , Перечисления.бит_СпособыРасчетаПоУслугам.ПустаяСсылка());
	
	КэшированныеЗначения.Вставить("ЭтоНовый"   , ?(Параметры.Ключ.Пустая(), Истина, Ложь));
	
КонецПроцедуры

// Функция получает ТипОбъекта на сервере.
//
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("СправочникОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции // ПолучитьТипОбъекта()

// Процедура получает объект из данных формы и записывает объект.
//
&НаСервере
Процедура ЗаписатьОбъект(Параметр)
	
	СправочникОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	СправочникОбъект.ПроверятьРежимПотребления = Параметр;
	
	Попытка
		
		СправочникОбъект.Записать();
		
		мКэшЗначений.ЭтоНовый = Ложь;
		
	Исключение
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось записать объект """ + СправочникОбъект + """!
		|" + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	ЗначениеВДанныеФормы(СправочникОбъект, Объект);
	
КонецПроцедуры

&НаСервере
// Функция определяет возможность удаления или изменения в табличной части одного поставщика на другой.
// Параметры:
//	Поставщик - поставщик, ссылки на который надо проверить.
// Возвращаемое значение:
//	булево, истина - удалять/изменять можно.
Функция ОпределитьВозможностьУдаленияПоставщика(Поставщик)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_СтавкиНаУслугиСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(
	|			,
	|			Услуга = &Услуга
	|				И Поставщик = &Поставщик) КАК бит_СтавкиНаУслугиСрезПоследних
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.Период
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			,
	|			Услуга = &Услуга
	|				И Поставщик = &Поставщик) КАК бит_СведенияПоУслугамЛССрезПоследних";
	Запрос.УстановитьПараметр("Услуга", Объект.Ссылка);
	Запрос.УстановитьПараметр("Поставщик", Поставщик);
	Результат = Запрос.Выполнить();
	Если Результат.Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции

