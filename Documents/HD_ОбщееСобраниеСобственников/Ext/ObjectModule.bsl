//HD+
// Получает дату и время проведения голосования в зависимости от формы проведения
// Возвращает:
//  Строка - отформатированная дата/время в нужном формате
//
Функция ПолучитьДатуВремяПроведенияГолосования()
	
	Если НЕ ЗначениеЗаполнено(ФормаПроведения) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ФормаПроведения) = Тип("ПеречислениеСсылка.бит_ФормыСобраний") Тогда
		
		Если ФормаПроведения = Перечисления.бит_ФормыСобраний.Очная Тогда
			
			// Очное: "в 14:00 часов 01.01.2026 г."
			Если НЕ ЗначениеЗаполнено(ДатаОчногоГолосования) Тогда
				Возврат "";
			КонецЕсли;
			
			ВремяСтрокой = ФорматироватьВремяБезЛидирующегоНуля(ДатаОчногоГолосования);
			ДатаСтрокой = Формат(ДатаОчногоГолосования, "ДФ=dd.MM.yyyy ""г.""");
			
			Возврат "в " + ВремяСтрокой + " часов " + ДатаСтрокой;
			
		ИначеЕсли ФормаПроведения = Перечисления.бит_ФормыСобраний.Заочная Тогда
			
			// Заочное: "с 9:00 часов 01.01.2026 г. по 14:00 часов 12.01.2026 г."
			Если НЕ ЗначениеЗаполнено(ДатаЗаочногоГолосования_Начало) И НЕ ЗначениеЗаполнено(ДатаЗаочногоГолосования_Окончание) Тогда
				Возврат "";
			КонецЕсли;
			
			СтрокаПериода = "";
			
			Если ЗначениеЗаполнено(ДатаЗаочногоГолосования_Начало) Тогда
				ВремяНачала = ФорматироватьВремяБезЛидирующегоНуля(ДатаЗаочногоГолосования_Начало);
				ДатаНачала = Формат(ДатаЗаочногоГолосования_Начало, "ДФ=dd.MM.yyyy ""г.""");
				СтрокаПериода = "с " + ВремяНачала + " часов " + ДатаНачала;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДатаЗаочногоГолосования_Окончание) Тогда
				ВремяОкончания = ФорматироватьВремяБезЛидирующегоНуля(ДатаЗаочногоГолосования_Окончание);
				ДатаОкончания = Формат(ДатаЗаочногоГолосования_Окончание, "ДФ=dd.MM.yyyy ""г.""");
				Если СтрокаПериода <> "" Тогда
					СтрокаПериода = СтрокаПериода + " по " + ВремяОкончания + " часов " + ДатаОкончания;
				Иначе
					СтрокаПериода = "по " + ВремяОкончания + " часов " + ДатаОкончания;
				КонецЕсли;
			КонецЕсли;
			
			Возврат СтрокаПериода;
			
		Иначе
			
			// Проверяем, есть ли значение ОчноЗаочная
			Попытка
				Если ФормаПроведения = Перечисления.бит_ФормыСобраний.ОчноЗаочная Тогда
					
					// Очно-заочное: "с 9:00 часов 01.01.2026 г. по 14:00 часов 12.01.2026 г."
					Если НЕ ЗначениеЗаполнено(ДатаОчноЗаочногоГолосования_Начало) И НЕ ЗначениеЗаполнено(ДатаОчноЗаочногоГолосования_Окончание) Тогда
						Возврат "";
					КонецЕсли;
					
					СтрокаПериода = "";
					
					Если ЗначениеЗаполнено(ДатаОчноЗаочногоГолосования_Начало) Тогда
						ВремяНачала = ФорматироватьВремяБезЛидирующегоНуля(ДатаОчноЗаочногоГолосования_Начало);
						ДатаНачала = Формат(ДатаОчноЗаочногоГолосования_Начало, "ДФ=dd.MM.yyyy ""г.""");
						СтрокаПериода = "с " + ВремяНачала + " часов " + ДатаНачала;
					КонецЕсли;
					
					Если ЗначениеЗаполнено(ДатаОчноЗаочногоГолосования_Окончание) Тогда
						ВремяОкончания = ФорматироватьВремяБезЛидирующегоНуля(ДатаОчноЗаочногоГолосования_Окончание);
						ДатаОкончания = Формат(ДатаОчноЗаочногоГолосования_Окончание, "ДФ=dd.MM.yyyy ""г.""");
						Если СтрокаПериода <> "" Тогда
							СтрокаПериода = СтрокаПериода + " по " + ВремяОкончания + " часов " + ДатаОкончания;
						Иначе
							СтрокаПериода = "по " + ВремяОкончания + " часов " + ДатаОкончания;
						КонецЕсли;
					КонецЕсли;
					
					Возврат СтрокаПериода;
					
				КонецЕсли;
			Исключение
				// Если значения нет, возвращаем пустую строку
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";

КонецФункции //HD-

//HD+
// Приводит переносы строк к виду, пригодному для ячеек табличного документа (LF).
//
Функция НормализоватьПереносыСтрокДляТабличногоДокумента(СтрокаТекст)
	
	Если НЕ ЗначениеЗаполнено(СтрокаТекст) Тогда
		Возврат СтрокаТекст;
	КонецЕсли;
	
	Результат = СтрЗаменить(Строка(СтрокаТекст), Символ(13) + Символ(10), Символ(10));
	Результат = СтрЗаменить(Результат, Символ(13), Символ(10));
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Удаляет из текста формулировки шаблонный блок итогов голосования (как в макете протокола), если он целиком присутствует.
// Не печатается в бланке решения. Номер вопроса в фразе «Решение по N вопросу…» может быть любым.
//
Функция УбратьШаблонИтоговГолосованияИзФормулировкиДляБланкаРешения(ИсходныйТекст)
	
	Если НЕ ЗначениеЗаполнено(ИсходныйТекст) Тогда
		Возврат ИсходныйТекст;
	КонецЕсли;
	
	Результат = НормализоватьПереносыСтрокДляТабличногоДокумента(Строка(ИсходныйТекст));
	МаркерНачала = "Итоги голосования по данному вопросу:";
	ОкончаниеФразы = "вопросу повестки дня принято.";
	ПодстрокаРешение = "Решение по ";
	
	СмещениеПоиска = 1;
	ЗащитаОтЗацикливания = 0;
	Пока ЗащитаОтЗацикливания < 1000 Цикл
		ЗащитаОтЗацикливания = ЗащитаОтЗацикливания + 1;
		
		ПозНачала = СтрНайти(Результат, МаркерНачала, , СмещениеПоиска);
		Если ПозНачала = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПодстрокаОтМаркера = Сред(Результат, ПозНачала);
		ПозОкончанияОтносительно = СтрНайти(ПодстрокаОтМаркера, ОкончаниеФразы, , 1);
		Если ПозОкончанияОтносительно = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ДлинаОкончания = СтрДлина(ОкончаниеФразы);
		ДлинаУдаляемого = ПозОкончанияОтносительно + ДлинаОкончания - 1;
		ФрагментПроверки = Лев(ПодстрокаОтМаркера, ДлинаУдаляемого);
		Если СтрНайти(ФрагментПроверки, ПодстрокаРешение) = 0 Тогда
			СмещениеПоиска = ПозНачала + 1;
			Продолжить;
		КонецЕсли;
		
		ДоУдаления = ?(ПозНачала > 1, Лев(Результат, ПозНачала - 1), "");
		ПослеУдаления = Сред(Результат, ПозНачала + ДлинаУдаляемого);
		Результат = ДоУдаления + ПослеУдаления;
		СмещениеПоиска = Макс(1, ПозНачала - 1);
		
	КонецЦикла;
	
	Возврат СокрЛП(Результат);
	
КонецФункции //HD-

//HD+
// Печатает одну сторону (один логический лист страницы) бланка решения MXL для одного участника.
//
Процедура ВывестиСтраницуБланкаРешенияMXLПоУчастнику(ТабличныйДокумент, Макет, ДанныеУчастника, ДанныеОрганов, Прочерк, БезДоверенности = Ложь)
	
	НастройкиДлиныПрочерков = ПолучитьНастройкиДлиныПрочерков();
	
	ОбластьШапка = Макет.ПолучитьОбласть("ОбластьШапка");
	Если ОбластьШапка <> Неопределено Тогда
		Попытка
			ПрочеркМКДУлица = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Улица");
			ПрочеркМКДДом = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Дом");
			ПрочеркАдресМКД = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "Общий");
			ПрочеркВидСобрания = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВидСобрания");
			ПрочеркФормаПроведенияСобрания = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ФормаПроведенияСобрания");
			ЗначАдрес = ПрочеркАдресМКД;
			Если ДанныеУчастника.Свойство("АдресМКД", ЗначАдрес) И ЗначениеЗаполнено(ЗначАдрес) Тогда
				ОбластьШапка.Параметры.АдресМКД = ЗначАдрес;
			Иначе
				ОбластьШапка.Параметры.АдресМКД = ПрочеркАдресМКД;
			КонецЕсли;
			ЗначениеПараметра = ПолучитьВидСобранияВПредложномПадеже();
			ОбластьШапка.Параметры.ВидСобрания = ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПрочеркВидСобрания);
			ЗначениеПараметра = НРег(ПолучитьФормаПроведенияСобранияВРодительномПадеже());
			ОбластьШапка.Параметры.ФормаПроведенияСобрания = ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, ПрочеркФормаПроведенияСобрания);
		Исключение
			КонецПопытки;
		ТабличныйДокумент.Вывести(ОбластьШапка);
	КонецЕсли;
	
	//HD+ Блок инициатора / дат голосования / собственника: даты — отдельные области по ФормаПроведения
	ВыводитьОчное = Истина;
	ВыводитьЗаочное = Истина;
	Если ТипЗнч(ФормаПроведения) = Тип("ПеречислениеСсылка.бит_ФормыСобраний") Тогда
		Если ФормаПроведения = Перечисления.бит_ФормыСобраний.Очная Тогда
			ВыводитьЗаочное = Ложь;
		ИначеЕсли ФормаПроведения = Перечисления.бит_ФормыСобраний.Заочная Тогда
			ВыводитьОчное = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ЗначениеП = "";
	ПрочеркИнициаторФИО = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторФИО");
	ПрочеркИнициаторНомерКвартиры = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторНомерКвартиры");
	ПрочеркДатаОчногоГолосования = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ДатаОчногоГолосования");
	ПрочеркПериодЗаочногоГолосования = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПериодЗаочногоГолосования");
	
	Если ШаблонПовесткиСИнициаторомУК() Тогда
		
		ОбластьДанныеУК = Неопределено;
		Попытка
			ОбластьДанныеУК = Макет.ПолучитьОбласть("ОбластьДанныеИнициатораУК");
		Исключение
			ОбластьДанныеУК = Неопределено;
		КонецПопытки;
		Если ОбластьДанныеУК <> Неопределено Тогда
			Попытка
				НаименованиеОрганизации = "";
				Если ДанныеУчастника.Свойство("ПолноеНаименованиеОрганизации", ЗначениеП) Тогда
					НаименованиеОрганизации = ЗначениеП;
				КонецЕсли;
				Если НЕ ЗначениеЗаполнено(НаименованиеОрганизации) Тогда
					РеквизитыУК = ПолучитьРеквизитыОрганизацииИнициатораДляПечати();
					НаименованиеОрганизации = РеквизитыУК.НаименованиеПолное;
				КонецЕсли;
				ОбластьДанныеУК.Параметры.ПолноеНаименованиеОрганизации = ?(ЗначениеЗаполнено(НаименованиеОрганизации), НаименованиеОрганизации, ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторОрганизацияНаименование"));
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьДанныеУК);
		КонецЕсли;
		
	Иначе
		
		ОбластьДанные = Макет.ПолучитьОбласть("ОбластьДанныеИнициатораИСобственника");
		Если ОбластьДанные <> Неопределено Тогда
			Попытка
				Парам = ОбластьДанные.Параметры;
				Если ДанныеУчастника.Свойство("ИнициаторФИО", ЗначениеП) Тогда
					Парам.ИнициаторФИО = ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркИнициаторФИО);
				Иначе
					Парам.ИнициаторФИО = ПрочеркИнициаторФИО;
				КонецЕсли;
				Если ДанныеУчастника.Свойство("ИнициаторНомерКвартиры", ЗначениеП) Тогда
					Парам.ИнициаторНомерКвартиры = ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркИнициаторНомерКвартиры);
				Иначе
					Парам.ИнициаторНомерКвартиры = ПрочеркИнициаторНомерКвартиры;
				КонецЕсли;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьДанные);
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВыводитьОчное Тогда
		ОбластьДатаОчного = Неопределено;
		Попытка
			ОбластьДатаОчного = Макет.ПолучитьОбласть("ОбластьДатаОчногоГолосования");
		Исключение
			ОбластьДатаОчного = Неопределено;
		КонецПопытки;
		Если ОбластьДатаОчного <> Неопределено Тогда
			Попытка
				Если ДанныеУчастника.Свойство("ДатаОчногоГолосования", ЗначениеП) Тогда
					ОбластьДатаОчного.Параметры.ДатаОчногоГолосования = ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркДатаОчногоГолосования);
				Иначе
					ОбластьДатаОчного.Параметры.ДатаОчногоГолосования = ПрочеркДатаОчногоГолосования;
				КонецЕсли;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьДатаОчного);
		КонецЕсли;
	КонецЕсли;
	
	Если ВыводитьЗаочное Тогда
		ОбластьПериодЗаочного = Неопределено;
		Попытка
			ОбластьПериодЗаочного = Макет.ПолучитьОбласть("ОбластьПериодЗаочногоГолосования");
		Исключение
			ОбластьПериодЗаочного = Неопределено;
		КонецПопытки;
		Если ОбластьПериодЗаочного <> Неопределено Тогда
			Попытка
				Если ДанныеУчастника.Свойство("ПериодЗаочногоГолосования", ЗначениеП) Тогда
					ОбластьПериодЗаочного.Параметры.ПериодЗаочногоГолосования = ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркПериодЗаочногоГолосования);
				Иначе
					ОбластьПериодЗаочного.Параметры.ПериодЗаочногоГолосования = ПрочеркПериодЗаочногоГолосования;
				КонецЕсли;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьПериодЗаочного);
		КонецЕсли;
	КонецЕсли;
	
	ОбластьДанныеСобственника = Неопределено;
	Попытка
		ОбластьДанныеСобственника = Макет.ПолучитьОбласть("ОбластьДанныеСобственника");
	Исключение
		ОбластьДанныеСобственника = Неопределено;
	КонецПопытки;
	Если ОбластьДанныеСобственника <> Неопределено Тогда
		Попытка
			Парам = ОбластьДанныеСобственника.Параметры;
			Если ДанныеУчастника.Свойство("УчастникиСобранияСобственник", ЗначениеП) Тогда
				Парам.УчастникиСобранияСобственник = ЗначениеП;
			Иначе
				Парам.УчастникиСобранияСобственник = "";
			КонецЕсли;
			Если ДанныеУчастника.Свойство("УчастникиСобранияСНИЛС", ЗначениеП) Тогда
				Парам.УчастникиСобранияСНИЛС = ЗначениеП;
			Иначе
				Парам.УчастникиСобранияСНИЛС = "";
			КонецЕсли;
			Если ДанныеУчастника.Свойство("УчастникиСобранияДоляСобственности", ЗначениеП) Тогда
				Парам.УчастникиСобранияДоляСобственности = ЗначениеП;
			Иначе
				Парам.УчастникиСобранияДоляСобственности = "";
			КонецЕсли;
			Если ДанныеУчастника.Свойство("УчастникиСобранияКвартира", ЗначениеП) Тогда
				Парам.УчастникиСобранияКвартира = ЗначениеП;
			Иначе
				Парам.УчастникиСобранияКвартира = "";
			КонецЕсли;
			Если ДанныеУчастника.Свойство("УчастникиСобранияПлощадь", ЗначениеП) Тогда
				Парам.УчастникиСобранияПлощадь = ЗначениеП;
			Иначе
				Парам.УчастникиСобранияПлощадь = "";
			КонецЕсли;
			ЗначениеПоУмолчаниюДокументПрава = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "УчастникиСобранияДокументПрава");
			Если ДанныеУчастника.Свойство("УчастникиСобранияДокументПрава", ЗначениеП) Тогда
				ЗначениеДокументаПрава = НормализоватьПереносыСтрокДляТабличногоДокумента(ЗначениеП);
				Парам.УчастникиСобранияДокументПрава = ?(ЗначениеЗаполнено(ЗначениеДокументаПрава), ЗначениеДокументаПрава, ЗначениеПоУмолчаниюДокументПрава);
			Иначе
				Парам.УчастникиСобранияДокументПрава = ЗначениеПоУмолчаниюДокументПрава;
			КонецЕсли;
			Попытка
				Если ДанныеУчастника.Свойство("УчастникиСобранияПаспортСерия", ЗначениеП) Тогда
					Парам.УчастникиСобранияПаспортСерия = ЗначениеП;
				КонецЕсли;
				Если ДанныеУчастника.Свойство("УчастникиСобранияПаспортНомер", ЗначениеП) Тогда
					Парам.УчастникиСобранияПаспортНомер = ЗначениеП;
				КонецЕсли;
			Исключение
			КонецПопытки;
		Исключение
		КонецПопытки;
		ТабличныйДокумент.Вывести(ОбластьДанныеСобственника);
	КонецЕсли;
	//HD-
	
	ОбластьШапкаТЧ = Макет.ПолучитьОбласть("ОбластьШапкаТЧФормулировкаВопросов");
	Если ОбластьШапкаТЧ <> Неопределено Тогда
		ТабличныйДокумент.Вывести(ОбластьШапкаТЧ);
	КонецЕсли;
	
	// Области органов собрания в макете: ОбластьПредседатель, ОбластьСекретарь, ОбластьСчКом_1..5 (данные ТЧ ПредседательСекретарьСчетнаяКомиссия)
	ВывестиОбластиОргановСобранияДляБланкаРешенияMXL(ТабличныйДокумент, Макет, ДанныеОрганов, Прочерк);
	
	МассивНомеров = Неопределено;
	МассивТекстов = Неопределено;
	Попытка
		МассивНомеров = ДанныеУчастника.ПредложенияПовесткиДняНомерСтроки;
		МассивТекстов = ДанныеУчастника.ПредложенияПовесткиДня;
	Исключение
		МассивНомеров = Неопределено;
		МассивТекстов = Неопределено;
	КонецПопытки;
	
	Если МассивНомеров <> Неопределено И МассивТекстов <> Неопределено Тогда
		Если ТипЗнч(МассивНомеров) = Тип("Массив") И ТипЗнч(МассивТекстов) = Тип("Массив") Тогда
			КолВоСтрок = МассивНомеров.Количество();
			Если МассивТекстов.Количество() < КолВоСтрок Тогда
				КолВоСтрок = МассивТекстов.Количество();
			КонецЕсли;
			//HD+ В макете пункт 1 занят блоком органов собрания; строки формулировок нумеруем с 2.
			Для ИндексСтроки = 0 По КолВоСтрок - 1 Цикл
				ОбластьСтрокаПовестки = Макет.ПолучитьОбласть("ОбластьСтрокаФормулировкаВопросов");
				Если ОбластьСтрокаПовестки <> Неопределено Тогда
					Попытка
						ОбластьСтрокаПовестки.Параметры.ПовесткаДняНомерСтроки = Формат(2 + ИндексСтроки, "ЧГ=");
						ОбластьСтрокаПовестки.Параметры.ПовесткаДняФормулировкаПредложенияРешенияВопроса =
							НормализоватьПереносыСтрокДляТабличногоДокумента(МассивТекстов[ИндексСтроки]);
					Исключение
						КонецПопытки;
						ТабличныйДокумент.Вывести(ОбластьСтрокаПовестки);
				КонецЕсли;
			КонецЦикла;
			//HD-
		КонецЕсли;
	КонецЕсли;
	
	//HD+
	ОбластьДоверенность = Макет.ПолучитьОбласть("ОбластьДоверенность");
	ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
	
	Если ОбластьДоверенность <> Неопределено Или ОбластьПодвал <> Неопределено Тогда
		
		ПрочеркМКДУлица = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Улица");
		ПрочеркМКДДом = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Дом");
		ПрочеркСобственник = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "УчастникиСобранияСобственник");
		ПрочеркКвартира = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "УчастникиСобранияКвартира");
		ПрочеркПредставитель1 = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительСобственников_1");
		ПрочеркПредставитель2 = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПредставительСобственников_2");
		ПрочеркКвартираПредставителя1 = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "КвартираПредставителя_1");
		ПрочеркКвартираПредставителя2 = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "КвартираПредставителя_2");
		
		ЗначениеП = "";
		
		ЗначениеМКДУлица = ?(ДанныеУчастника.Свойство("МКД_Улица", ЗначениеП), ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркМКДУлица), ПрочеркМКДУлица);
		ЗначениеМКДДом = ?(ДанныеУчастника.Свойство("МКД_Дом", ЗначениеП), ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркМКДДом), ПрочеркМКДДом);
		ЗначениеСобственник = ?(ДанныеУчастника.Свойство("УчастникиСобранияСобственник", ЗначениеП), ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркСобственник), ПрочеркСобственник);
		ЗначениеКвартира = ?(ДанныеУчастника.Свойство("УчастникиСобранияКвартира", ЗначениеП), ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркКвартира), ПрочеркКвартира);
		ЗначениеПредставитель1 = ?(ДанныеУчастника.Свойство("ПредставительСобственников_1_Дательный", ЗначениеП), ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркПредставитель1), ПрочеркПредставитель1);
		ЗначениеПредставитель2 = ?(ДанныеУчастника.Свойство("ПредставительСобственников_2_Дательный", ЗначениеП), ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркПредставитель2), ПрочеркПредставитель2);
		ЗначениеКвартираПредставителя1 = ?(ДанныеУчастника.Свойство("КвартираПредставителя_1", ЗначениеП), ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркКвартираПредставителя1), ПрочеркКвартираПредставителя1);
		ЗначениеКвартираПредставителя2 = ?(ДанныеУчастника.Свойство("КвартираПредставителя_2", ЗначениеП), ?(ЗначениеЗаполнено(ЗначениеП), ЗначениеП, ПрочеркКвартираПредставителя2), ПрочеркКвартираПредставителя2);
		
		Если ОбластьДоверенность <> Неопределено И НЕ БезДоверенности Тогда
			Попытка
				ПарамДоверенности = ОбластьДоверенность.Параметры;
				ПарамДоверенности.МКД_Улица = ЗначениеМКДУлица;
				ПарамДоверенности.МКД_Дом = ЗначениеМКДДом;
				ПарамДоверенности.УчастникиСобранияСобственник = ЗначениеСобственник;
				ПарамДоверенности.УчастникиСобранияКвартира = ЗначениеКвартира;
				ПарамДоверенности.ПредставительСобственников_1_Дательный = ЗначениеПредставитель1;
				ПарамДоверенности.ПредставительСобственников_2_Дательный = ЗначениеПредставитель2;
				ПарамДоверенности.КвартираПредставителя_1 = ЗначениеКвартираПредставителя1;
				ПарамДоверенности.КвартираПредставителя_2 = ЗначениеКвартираПредставителя2;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьДоверенность);
		КонецЕсли;
		
		Если ОбластьПодвал <> Неопределено Тогда
			Попытка
				ПарамПодвала = ОбластьПодвал.Параметры;
				ПарамПодвала.МКД_Улица = ЗначениеМКДУлица;
				ПарамПодвала.МКД_Дом = ЗначениеМКДДом;
				ПарамПодвала.УчастникиСобранияСобственник = ЗначениеСобственник;
				ПарамПодвала.УчастникиСобранияКвартира = ЗначениеКвартира;
				ПарамПодвала.ПредставительСобственников_1_Дательный = ЗначениеПредставитель1;
				ПарамПодвала.ПредставительСобственников_2_Дательный = ЗначениеПредставитель2;
				ПарамПодвала.КвартираПредставителя_1 = ЗначениеКвартираПредставителя1;
				ПарамПодвала.КвартираПредставителя_2 = ЗначениеКвартираПредставителя2;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьПодвал);
		КонецЕсли;
		
	КонецЕсли;
	//HD-
	
КонецПроцедуры //HD-

//HD+
// Заполняет макет ПФ_MXL_БланкРешения / ПФ_MXL_БланкРешения1: по одному комплекту областей на каждого участника, разделитель страниц между бланками.
//
Процедура ЗаполнитьПечатнуюФормуБланкРешенияMXL(ТабличныйДокумент, ИмяШаблона, БезДоверенности = Ложь)
	
	НастройкиДлиныПрочерков = ПолучитьНастройкиДлиныПрочерков();
	Прочерк = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "Общий");
	Макет = ПолучитьМакет(ИмяШаблона);
	Если Макет = Неопределено Тогда
		ВызватьИсключение "Макет """ + ИмяШаблона + """ не найден";
	КонецЕсли;
	
	МассивДанных = ПолучитьМассивДанныхДляБланкРешенияПоУчастникам();
	Если МассивДанных.Количество() = 0 Тогда
		ВызватьИсключение "Добавьте участников собрания в табличную часть для печати бланков решения.";
	КонецЕсли;
	
	//HD+ Параметры печати бланка решения (двусторонняя печать отключена)
	ТабличныйДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.Нет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	//HD-
	
	ДанныеОрганов = ПолучитьДанныеУчастниковСобрания();
	
	ВсегоУчастников = 0;
	Для Каждого ЭлементМассива Из МассивДанных Цикл
		Если ТипЗнч(ЭлементМассива) = Тип("Структура") Тогда
			ВсегоУчастников = ВсегоУчастников + 1;
		КонецЕсли;
	КонецЦикла;
	НомерПоПорядку = 0;
	
	Для Каждого ДанныеУчастника Из МассивДанных Цикл
		
		Если ТипЗнч(ДанныеУчастника) <> Тип("Структура") Тогда
			Продолжить;
		КонецЕсли;
		
		НомерПоПорядку = НомерПоПорядку + 1;
		
		//HD+ Односторонняя печать: один бланк на участника.
		ВывестиСтраницуБланкаРешенияMXLПоУчастнику(ТабличныйДокумент, Макет, ДанныеУчастника, ДанныеОрганов, Прочерк, БезДоверенности);
		
		Если НомерПоПорядку < ВсегоУчастников Тогда
			ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		//HD-
		
	КонецЦикла;
	
	//HD+ Итоговые параметры листа для печати (двусторонняя печать отключена)
	ТабличныйДокумент.РазмерСтраницы = "A4";
	ТабличныйДокумент.ДвусторонняяПечать = ТипДвустороннейПечати.Нет;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	//HD-
	
КонецПроцедуры //HD-

//HD+
// Заполняет печатную форму "Итоги голосования" (макет Word). Пустые параметры подменяются прочерками.
//
Процедура ЗаполнитьПечатнуюФормуИтогиГолосованияWord(ТабличныйДокумент, ИмяШаблона)
	
	НастройкиДлиныПрочерков = ПолучитьНастройкиДлиныПрочерков();
	Прочерк_МКД_Улица = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Улица");
	Прочерк_МКД_Дом = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МКД_Дом");
	Прочерк_ПротоколДата = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколДата");
	Прочерк_ПротоколМесяц = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколМесяц");
	Прочерк_ПротоколГод = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ПротоколГод");
	Прочерк_ВидСобрания = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВидСобрания");
	Прочерк_ФормаПроведенияСобрания = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ФормаПроведенияСобрания");
	Прочерк_ИнициаторФИО = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторФИО");
	Прочерк_ИнициаторПаспортСерия = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторПаспортСерия");
	Прочерк_ИнициаторПаспортНомер = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторПаспортНомер");
	Прочерк_ИнициаторАдресРегистрации = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторАдресРегистрации");
	Прочерк_ИнициаторТелефон = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ИнициаторТелефон");
	Прочерк_ОбщаяПлощадьМКД = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ОбщаяПлощадьМКД");
	Прочерк_ВсегоСобственников = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВсегоСобственников");
	Прочерк_МестоПроведенияСобрания = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МестоПроведенияСобрания");
	Прочерк_ВремяПроведенияОчногоГолосования = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияОчногоГолосования");
	Прочерк_ГодПроведенияОчногоГолосования = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияОчногоГолосования");
	Прочерк_МесяцПроведенияОчногоГолосования = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияОчногоГолосования");
	Прочерк_ВремяПроведенияЗаочногоГолосования_Нач = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Нач");
