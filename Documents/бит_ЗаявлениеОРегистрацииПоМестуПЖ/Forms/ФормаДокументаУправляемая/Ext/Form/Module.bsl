			СтруктураПрошлыеПД.Вставить("Вид", Выборка.ДокументВид);
			СтруктураПрошлыеПД.Вставить("Серия", Выборка.ДокументСерия);
			СтруктураПрошлыеПД.Вставить("Номер", Выборка.ДокументНомер);
			СтруктураПрошлыеПД.Вставить("ДатаВыдачи", Выборка.ДокументДатаВыдачи);
			СтруктураПрошлыеПД.Вставить("КемВыдан", Выборка.ДокументКемВыдан);
			СтруктураПрошлыеПД.Вставить("КодПодразделения", Выборка.ДокументКодПодразделения);
			СтруктураПрошлыеПД.Вставить("ДатаРегистрацииПоМЖ", Выборка.ДатаРегистрацииПоМестуЖительства);
			СтруктураПрошлыеПД.Вставить("ПричинаЗамены", Выборка.ДокументПричинаЗамены);
			
		КонецЕсли;
		
	КонецЕсли;
	
	
	Если МакетНовогоОбразца Тогда
		Макет = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("АЛУ_New");
