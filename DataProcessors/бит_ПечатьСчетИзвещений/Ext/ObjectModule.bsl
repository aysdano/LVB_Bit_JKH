функция ПолучитьТаблицуПлощадейСчетчиков (Период)
	
  запросСчетчиков = новый запрос;
  
  запросСчетчиков.Текст = "ВЫБРАТЬ
                          |	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
                          |	бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик КАК ГрупповойСчетчик,
                          |	бит_ГрупповыеСчетчикиСрезПоследних.Услуга КАК Услуга,
                          |	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет.Квартира КАК ЛицевойСчетКвартира,
                          |	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
                          |	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь КАК ОтапливаемаяПлощадь
                          |ИЗ
                          |	РегистрСведений.бит_ГрупповыеСчетчики.СрезПоследних(&Период, ) КАК бит_ГрупповыеСчетчикиСрезПоследних
                          |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Период, ) КАК бит_СведенияОКвартиреСрезПоследних
                          |		ПО бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира";	
	

  запросСчетчиков.УстановитьПараметр("Период", Период);
  табСчетчиков = запросСчетчиков.Выполнить().Выгрузить();
  табСчетчиковЛС = табСчетчиков.Скопировать();
  
  // БИТ ЖКХ 20.02.2020
  таблицаСумм = новый ТаблицаЗначений;
  таблицаСумм.Колонки.Добавить("ГрупповойСчетчик", Новый ОписаниеТипов("СправочникСсылка.бит_Счетчики"));
  таблицаСумм.Колонки.Добавить("ОбщаяПлощадь", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 2)));
  таблицаСумм.Колонки.Добавить("ОтапливаемаяПлощадь", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(20, 2)));

  для каждого стр из табСчетчиков цикл
	  
	  стрСумм = таблицаСумм.Добавить();
	  стрСумм.ГрупповойСчетчик = стр.ГрупповойСчетчик;
	  стрСумм.ОбщаяПлощадь = стр.ОбщаяПлощадь;
	  стрСумм.ОтапливаемаяПлощадь = стр.ОтапливаемаяПлощадь; 
	  
  конеццикла;	  
  
  таблицаСумм.Свернуть("ГрупповойСчетчик", "ОбщаяПлощадь, ОтапливаемаяПлощадь");
  КвартирыЛС = табСчетчиков.ВыгрузитьКолонку("ЛицевойСчетКвартира");         
     
  возврат таблицаСумм;

