
#Область ПеременныеМодуля

&НаКлиенте 
Перем мКэшРеквизитовФормы;       // Хранит текущие значения реквизитов формы. Клиент.

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Запишем переменные формы.
	КэшированныеЗначения.Вставить("ЭтоНовый"                , ?(Параметры.Ключ.Пустая(), Истина, Ложь));
	КэшированныеЗначения.Вставить("мФормаВводаМестаРождения", Ложь);
	КэшированныеЗначения.Вставить("ЮрАдресПроживающего", Неопределено);
	КэшированныеЗначения.Вставить("ФактАдресПроживающего", Неопределено);
	КэшированныеЗначения.Вставить("ТелефонПроживающего", Неопределено);
	КэшированныеЗначения.Вставить("ИнформАдресПроживающего", Неопределено);
	
	КэшированныеЗначения.Вставить("ИнострАдресПроживающего", Неопределено);
	КэшированныеЗначения.Вставить("ТелефонСлужебныйПроживающего", Неопределено);
	КэшированныеЗначения.Вставить("EmailПроживающего", Неопределено);
	КэшированныеЗначения.Вставить("ДругаяИнформацияПроживающего", Неопределено);
	КэшированныеЗначения.Вставить("АдресПрибытияДрРегион", Неопределено);
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	// БИТ_ЖКХ 24.02.2014
	РазместитьКонтактнуюИнформацию();
	// БИТ_ЖКХ 24.02.2014
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ФизЛицо", Объект.Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СвидетельстваОСмерти.ФизЛицо,
	|	бит_СвидетельстваОСмерти.ДатаВыдачи,
	|	бит_СвидетельстваОСмерти.ДатаСмерти,
	|	бит_СвидетельстваОСмерти.ДатаСоставления,
	|	бит_СвидетельстваОСмерти.КемВыдано,
