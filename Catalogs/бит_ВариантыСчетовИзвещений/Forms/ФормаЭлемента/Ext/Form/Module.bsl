&НаКлиенте
Процедура ОбъединитьЯчейки(Команда)
	
	Если ПолеТабличногоДокумента.ВыделенныеОбласти.Количество() = 1
		И ТипЗнч(ПолеТабличногоДокумента.ВыделенныеОбласти[0]) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
		
		ТекущаяОбласть = ПолеТабличногоДокумента.ТекущаяОбласть;
		ОбъединитьОбласть(ТекущаяОбласть.Имя);
		
	Иначе
		
		ОчиститьСообщения();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Некорректная область!'");
		Сообщение.Поле = "ПолеТабличногоДокумента";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазъединитьЯчейки(Команда)
	
	Если ПолеТабличногоДокумента.ВыделенныеОбласти.Количество() = 1
		И ТипЗнч(ПолеТабличногоДокумента.ВыделенныеОбласти[0]) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
		
		ТекущаяОбласть = ПолеТабличногоДокумента.ТекущаяОбласть;
		РазъединитьОбласть(ТекущаяОбласть.Имя);
		
	Иначе
		
		ОчиститьСообщения();
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = НСтр("ru = 'Некорректная область!'");
		Сообщение.Поле = "ПолеТабличногоДокумента";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьМакет(Команда)
	
	ОчиститьСообщения();
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораФайла.Заголовок = НСтр("ru = 'Укажите каталог'");
	ДиалогВыбораФайла.Каталог   = Каталог;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		
		ИмяФайла = "Вариант счет-извещения(" + Объект.Наименование + ").mxl";
		Каталог  = ДиалогВыбораФайла.Каталог;
		
		ПолныйПустьКФайлу = ДиалогВыбораФайла.Каталог + "\" + ИмяФайла;
		
		Попытка
			
			ПолеТабличногоДокумента.Записать(ПолныйПустьКФайлу, ТипФайлаТабличногоДокумента.MXL);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Файл : """ + ИмяФайла + """ сохранен в каталог: " + Каталог);
			
		Исключение
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ОписаниеОшибки());
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

