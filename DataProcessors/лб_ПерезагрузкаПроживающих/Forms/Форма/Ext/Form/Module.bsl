&НаСервере
Процедура КоррекцияЖильцовНаСервере()
	Д1 = ТекущаяДата();
	
	Счетчик = 1000; //количество обрабатываемых домов
	Сч=0;
	
	НаборП=Неопределено; //НаборП - набор проводок
	ТаблП= неопределено; //ТаблП = НаборП.Выгрузить();
	
	НаборИсх = РегистрыСведений.лб_Тест_Жильцы.СоздатьНаборЗаписей();
