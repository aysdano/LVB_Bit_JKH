	ДанныеДляПарсера = "c92ae251803621fd4f487f68f3fe3158"+":"+"2760b0fb01adb00f940c1f6fb0458faa"; //КодироватьСтроку(
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла,"CESU-8");
	ЗаписьТекста.Записать(ДанныеДляПарсера);
	ЗаписьТекста.Закрыть();
	
	СтрокаТокен = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Токен = Base64Строка(СтрокаТокен);
	Токен = СтрЗаменить(Токен,"¶","");
	Токен = СтрЗаменить(Токен,Символ(10),"");
	Токен = СтрЗаменить(Токен,Символ(13),"");
	УдалитьФайлы(ИмяВременногоФайла);
	
	АдресСервисаСтр = "testbit-admin.moe-zkx.ru";
	//АдресСервисаСтр = "mobsted.mobsted.ru";
	
	Соединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
	
	Запрос        = Новый HTTPЗапрос("/api/v4/applications/717");
	Запрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Токен));
	//Запрос.Заголовки.Вставить("cache-control", "no-cache");  
	
	ЖурналВремяНачало = ТекущаяДата();
	ЖурналЗапросБезКодировки   = Строка(АдресСервисаСтр)+Строка("/api/v4/applications/717");
	
	Результат    = Соединение.Получить(Запрос);
	Если Результат.КодСостояния <> 200 Тогда 
		ИмяСобытияВЖурнал = "Получение ключа для создания агента";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвета = Результат.ПолучитьТелоКакСтроку();;	
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало,ТекущаяДата(),Неопределено);	
		Возврат ложь;
	Иначе
		
		РезультатПроверки = Результат.ПолучитьТелоКакСтроку();;	
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
		ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
		ЧтениеJSON.Закрыть();
		
		Ответ = ЗагруженныеДанные["FullDescription"];
		Если Ответ <> "stop" Тогда
		Возврат Истина;
		Иначе
		Возврат ложь;
		КонецЕсли;	
		
		
	КонецЕсли; 
КонецФункции	

