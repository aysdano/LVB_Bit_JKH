				СтрокаКорня.ДокументОплаты = Документ.Ссылка;
				
			КонецЕсли;
			
		Иначе
			
			Документ = Документы.бит_ОплатаКУ.СоздатьДокумент();
			
			Дата = СтрокаКорня.ДатаОплаты_ЛицевойСчет_Услуга;
			
