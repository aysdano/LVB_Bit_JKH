		Если НЕ СтрНачинаетсяС(СтрокаТЧ.блгКодЗдания, СтрокаТЧ.лвбКодЗдания) тогда
			Табл.Удалить(СтрокаТЧ);
		КонецЕсли;
	КонецЦикла;	
	
	НаборЗаписей = РегистрыСведений.бит_ЗависимыеЛС.СоздатьНаборЗаписей();
	НаборЗаписей.Загрузить(Табл);
	НаборЗаписей.Записать(Истина);
	
	
	// Вставить содержимое обработчика.
