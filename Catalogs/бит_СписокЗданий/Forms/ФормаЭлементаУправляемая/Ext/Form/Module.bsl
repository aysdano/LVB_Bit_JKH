	|	ТабРП.Распределение,
	|	ТабРП.Услуга,
	|	ТабРП.СпособРасчета";
	
	Запрос.УстановитьПараметр("ТаблицаРп", ТЗТаблицаРасшифровкиРаспределений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТЗРаспределения.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;
	
	Распределения.Загрузить(ТЗРаспределения);
	
	// Заполнение таблицы "Предоставляемые услуги".	
	ТЗПредоставляемыеУслуги = РеквизитФормыВЗначение("ПредоставляемыеУслуги");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ШаблоныУслугСрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_ШаблоныУслуг.СрезПоследних(
	|			&Момент,
	|			Здание = &Здание
	|				И Улица = &Улица) КАК бит_ШаблоныУслугСрезПоследних
	|ГДЕ
	|	бит_ШаблоныУслугСрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Запрос.УстановитьПараметр("Здание", Объект.Ссылка);
	Запрос.УстановитьПараметр("Улица" , Объект.Улица);
	Запрос.УстановитьПараметр("Момент", ТекущаяДата());
	
	ТЗПредоставляемыеУслуги = Запрос.Выполнить().Выгрузить();
	
	ПредоставляемыеУслуги.Загрузить(ТЗПредоставляемыеУслуги);
	
	Если Объект.ИмеетТСЖ Тогда
		
		ЗаполнитьТСЖ();
		
	КонецЕсли; 
	
КонецПроцедуры

