	ТекущаяСтрока = ДополнительныеПараметры.ТекущаяСтрока;
	
	Вариант = ВыбранныйЭлемент;
	
	Если НЕ Вариант = Неопределено Тогда
		
		ТекущаяСтрока.Решение              = Вариант.Представление;
		ТекущаяСтрока.ИдентификаторРешения = Вариант.Значение;
		
	КонецЕсли;
	
