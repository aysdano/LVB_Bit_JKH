	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "Закрытие" Тогда
		
		ПодчиненныйДокумент = НайтиПодчиненныйДокумент(Объект.Ссылка);
		Если ПодчиненныйДокумент = Неопределено Тогда
			
			Элементы.ФормаСвПоМестуПребывания.Видимость = Ложь;
			
		КонецЕсли;
	ИначеЕсли ИмяСобытия = "ЗакрытиеПроживание" Тогда
		
		ПодчиненныйДокументПроживание = НайтиПодчиненныйДокументПроживание(Объект.Ссылка);
		
		Если ПодчиненныйДокументПроживание = Неопределено Тогда
			
			Элементы.ФормаСвПоМестуПроживания.Видимость = Ложь;
			
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ДокументЗаписан" Тогда
		
		Элементы.ФормаСвПоМестуПребывания.Видимость = Истина;
		
	ИначеЕсли ИмяСобытия = "ДокументЗаписанПроживание" Тогда
		
		Элементы.ФормаСвПоМестуПроживания.Видимость = Истина;
		
	ИначеЕсли ИмяСобытия = "СменаФамилииПоМЖ" Тогда
		
		Объект.СменаФамилииНа = "" + Параметр.Фамилия + " " + Параметр.Имя + " " + Параметр.Отчество;
		
	ИначеЕсли ИмяСобытия = "СменаУдостоверенияЛичностиПоМЖ" Тогда
		
		Объект.УдостоверениеЛичности = "" + Параметр.ДокументВид + ", серия: " + Параметр.ДокументСерия + ", № " + Параметр.ДокументНомер 
		+ ", выдан: " + Формат(Параметр.ДокументДатаВыдачи,"ДФ='дд ММММ гггг'; ДП='Не указано'") + " года, " 
		+ Параметр.ДокументКемВыдан + ", № подр. " + Параметр.ДокументКодПодразделения 
		+ Символы.Таб + "Дата регистрации по месту жительства: " + Формат(Параметр.ДатаРегистрацииПоМестуЖительства,"ДФ='дд ММММ гггг'; ДП='Не указано'");
		
		Объект.УдостоверениеЛичности = СтрЗаменить(Объект.УдостоверениеЛичности,"Не указано","...");
		
		Модифицированность = Истина;
		
	ИначеЕсли ИмяСобытия = "СнятиеПоСмертиПоМЖ" Тогда
		
		СвидетельствоОСмерти = "а/з " + Параметр.Номер + ", от " + Формат(Параметр.ДатаСоставления,"ДФ='дд ММММ гггг'; ДП='Не указано'")+", " 
		+ Параметр.КемВыдано + ", свидетельство о смерти " + Параметр.СерияСвидетельства
		+ ", №" + Параметр.НомерСвидетельства + ", " + Параметр.КемВыдано 
		+ ", от " + Формат(Параметр.ДатаВыдачи,"ДФ='дд ММММ гггг'; ДП='Не указано'");
		
		СвидетельствоОСмерти = СтрЗаменить(СвидетельствоОСмерти,"Не указано","...");
		
		Если НЕ СвидетельствоОСмерти = Объект.СвидетельствоОСмерти Тогда
			
			Модифицированность          = Истина;
			Объект.СвидетельствоОСмерти = СвидетельствоОСмерти;
			
		КонецЕсли; 
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

