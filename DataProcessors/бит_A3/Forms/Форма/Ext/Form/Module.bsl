&НаКлиенте
Процедура НастройкаПолейСтрокиРеестраСальдоПриАктивизацииЯчейки(Элемент)
	
	Если НЕ Элемент.ТекущиеДанные = Неопределено Тогда
		
		Если Элемент.ТекущиеДанные.ИмяПоля = "НачальноеСальдо"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "НачальноеСальдоСУчетомПени"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "НачальноеСальдоПени"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "НачальноеСальдоСУчетомОплаты"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "НачальноеСальдоСУчетомОплатыИПени"
			
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "КонечноеСальдо"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "КонечноеСальдоСУчетомПени"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "КонечноеСальдоПени"
			
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "СуммаОплаты"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "СуммаПени"
			
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "СуммаНачислений"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "СуммаНачисленийСУчетомОплатыИПени"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "СуммаНачисленийСУчетомПени"
			ИЛИ Элемент.ТекущиеДанные.ИмяПоля = "СуммаНачисленийСУчетомОплаты" Тогда
			
			Элемент.ТолькоПросмотр = Ложь;
		Иначе
			Элемент.ТолькоПросмотр = Истина;
			
		КонецЕсли;	
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПолейСтрокиРеестраСальдоИмяПоляОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = "НачальноеСальдо"
		ИЛИ ВыбранноеЗначение = "НачальноеСальдоСУчетомПени"
		ИЛИ ВыбранноеЗначение = "НачальноеСальдоПени"
		ИЛИ ВыбранноеЗначение = "НачальноеСальдоСУчетомОплаты"
		ИЛИ ВыбранноеЗначение = "НачальноеСальдоСУчетомОплатыИПени"
		
		ИЛИ ВыбранноеЗначение = "КонечноеСальдо"
		ИЛИ ВыбранноеЗначение = "КонечноеСальдоСУчетомПени"
		ИЛИ ВыбранноеЗначение = "КонечноеСальдоПени"
		
		ИЛИ ВыбранноеЗначение = "СуммаОплаты"
		ИЛИ ВыбранноеЗначение = "СуммаПени"
		
		ИЛИ ВыбранноеЗначение = "СуммаНачислений"
		ИЛИ ВыбранноеЗначение = "СуммаНачисленийСУчетомОплатыИПени"
		ИЛИ ВыбранноеЗначение = "СуммаНачисленийСУчетомПени" 
		ИЛИ ВыбранноеЗначение = "СуммаНачисленийСУчетомОплаты" Тогда
		
		
	Иначе
		ВыбранноеЗначение = Элемент.ТекстРедактирования;
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Необходимо выбрать расчетное поле";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;	
	
КонецПроцедуры

