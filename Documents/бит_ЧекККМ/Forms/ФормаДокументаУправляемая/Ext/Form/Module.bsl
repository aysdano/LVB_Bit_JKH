// Процедура выполняет группировку услуг по "Грппа услуги".
// И заполнение дерева услуг.
//
&НаСервере
Процедура СформироватьДеревоУслуг()
	
	ТаблицаЧек = Объект.Услуги.Выгрузить();
	
	УслугиДер = ДанныеФормыВЗначение(УслугиДерево,Тип("ДеревоЗначений"));
	
	УслугиДер.Строки.Очистить();
	
	// Заполняем Дерево начислений.
	Для каждого Строка Из ТаблицаЧек Цикл
		
		НоваяСтрока = УслугиДер.Строки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		НоваяСтрока.Приоритет = Строка.Услуга.Приоритет;
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Таблица.Услуга
	|ПОМЕСТИТЬ ТабНач
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабНач.Услуга,
	|	ТабНач.Услуга.ГруппаУслуги КАК ГруппаУслуги
	|ИЗ
	|	ТабНач КАК ТабНач
	|ИТОГИ ПО
	|	ГруппаУслуги;
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТабНач";
	
	Запрос.УстановитьПараметр("Таблица", ТаблицаЧек);
	
	ВыборкаГруп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаГруп.Следующий() Цикл
		
		Выборка = ВыборкаГруп.Выбрать();
		
		Если ВыборкаГруп.ГруппаУслуги = Справочники.бит_ГруппыУслуг.ПустаяСсылка() Тогда
			Продолжить;
		КонецЕсли; 
		
		Если Выборка.Количество() > 1 Тогда
			
			НоваяСтрока							= УслугиДер.Строки.Добавить();
			НоваяСтрока.Услуга					= ВыборкаГруп.ГруппаУслуги;
			НоваяСтрока.ГруппаУслугиПриоритет	= ВыборкаГруп.ГруппаУслуги.Приоритет;
			
			Долг      = 0;
			СуммаПени = 0;
			Сумма     = 0;
			Начислено = 0;
			Сальдо    = 0;
			
			Пока Выборка.Следующий() Цикл
				
				Отбор = Новый Структура;
				
				Отбор.Вставить("Услуга", Выборка.Услуга);
				
				Строка = ТаблицаЧек.НайтиСтроки(Отбор);
				
				// Убираем строки с общией группой под группу.
				Если Строка.Количество() > 0 Тогда
					
					Строка = Строка[0];	
					
					СтрокаДерева = УслугиДер.Строки.НайтиСтроки(Отбор);
					
					Если СтрокаДерева.Количество() > 0 Тогда
						
						Для Каждого ЭлементМассива Из СтрокаДерева Цикл
							
							УслугиДер.Строки.Удалить(ЭлементМассива);
							
						КонецЦикла;
						
					КонецЕсли; 
					
					ПеренесеннаяСтрока = НоваяСтрока.Строки.Добавить();
					
					ЗаполнитьЗначенияСвойств(ПеренесеннаяСтрока, Строка);
					
					Долг      = Долг      + Строка.Долг;
					СуммаПени = СуммаПени + Строка.СуммаПени;
					Сумма     = Сумма     + Строка.Сумма;
					Начислено = Начислено + Строка.Начислено;
					Сальдо    = Сальдо    + Строка.Сальдо;
					
				КонецЕсли;
				
			КонецЦикла;
			
			НоваяСтрока.Долг            = Долг;
			НоваяСтрока.СуммаПени       = СуммаПени;
			НоваяСтрока.Сумма           = Сумма;
			НоваяСтрока.Начислено       = Начислено;
			НоваяСтрока.Сальдо          = Сальдо;			
			НоваяСтрока.ШаблонИзвещений = Объект.ШаблонИзвещений;
			НоваяСтрока.ЛицевойСчет     = Объект.ЛицевойСчет;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	УслугиДер.Строки.Сортировать("Приоритет Возр, ГруппаУслугиПриоритет Возр", ИСТИНА);
	
	Элементы.Группа21.Видимость = Ложь;
	Элементы.Группа22.Видимость = Истина;
	Элементы.Группа23.Видимость = Ложь;
	
	ЗначениеВДанныеФормы(УслугиДер,УслугиДерево);
	
КонецПроцедуры

&НаСервере
Функция ПроведениеДокументаВводПоказанийПоСчетчикамНаСервере()
	
	Документ = Документы.бит_ВводПоказанийПоСчетчикам.СоздатьДокумент();
	
	Документ.Дата               = Объект.Дата - 60;
	Документ.ВидОперации        = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний;
	Документ.Организация        = Объект.Организация;
	Документ.ЛицевойСчет        = Объект.ЛицевойСчет;
	Документ.Ответственный      = Объект.Ответственный;
	Документ.Улица              = Объект.ЛицевойСчет.УлицаЛицевогоСчета;
	Документ.ТипСчетчика        = Перечисления.бит_ТипСчетчика.Индивидуальный;
	Документ.ПоказанияНаселения = Истина;
	
	Документ.ПоказанияПоСчетчикам.Очистить();
	
	Для каждого Счетчик Из Объект.Счетчики Цикл
		
		Если Счетчик.ТекущиеПоказания <> 0  Тогда
			
			НоваяСтрока = Документ.ПоказанияПоСчетчикам.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Счетчик);
			
			НоваяСтрока.ЛицевойСчет = Объект.ЛицевойСчет;
			
			КолЕдиниц = 0 ;
			
			Если Счетчик.ПредыдущиеПоказания > Счетчик.ТекущиеПоказания Тогда
				
				КолЕдиниц = Счетчик.Разрядность - Счетчик.ПредыдущиеПоказания + Счетчик.ТекущиеПоказания + 1;
				
			Иначе
				
				КолЕдиниц = Счетчик.ТекущиеПоказания - Счетчик.ПредыдущиеПоказания;
				
			КонецЕсли; 
			
			НоваяСтрока.КоличествоЕдиницПоСчетчику = КолЕдиниц;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	мКэшЗначений.НуженПерерасчет = Истина;
	
	Попытка
		
		Документ.Записать(РежимЗаписиДокумента.Проведение);
		
		Возврат Истина;
		
	Исключение
		
		Возврат Ложь;
		
	КонецПопытки;
	
КонецФункции

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	УстановитьРучнойВвод();
	
	Итог = Объект.Услуги.Итог("СуммаПени");
	
	Элементы.УслугиСуммаПени.Видимость = ?(Итог = 0 И НЕ Объект.ВводВручную, Ложь, Истина);
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Возврат Тогда
		Элементы.УслугиДолг.Видимость = Ложь;
	Иначе
		Элементы.УслугиДолг.Видимость = Истина;
	КонецЕсли; 
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Продажа
		ИЛИ Объект.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Возврат  Тогда
		
		Элементы.Группа21.Видимость = Истина;
		Элементы.Группа22.Видимость = Ложь;
		Элементы.Группа23.Видимость = Ложь;
		
		Если Объект.ЛицевойСчет.ОтображатьПоГруппам Тогда
			
			Элементы.Группа21.Видимость = Ложь;
			Элементы.Группа22.Видимость = Истина;
			Элементы.Группа23.Видимость = Ложь;
			
			Если Не Параметры.Ключ.Пустая() Тогда
				
				СформироватьДеревоУслуг();
				
			КонецЕсли; 
			
		Иначе
			
			Элементы.Группа21.Видимость = Истина;
			Элементы.Группа22.Видимость = Ложь;
			Элементы.Группа23.Видимость = Ложь;
			
		КонецЕсли;
		
	Иначе
		
		Элементы.Группа21.Видимость = Ложь;
		Элементы.Группа22.Видимость = Ложь;
		Элементы.Группа23.Видимость = Истина;
		
	КонецЕсли;
	
	Если Объект.ВводВручную Тогда
		
		Элементы.НадписьИнфоОбщ.Видимость        = Истина;
		Элементы.Услуги.ТолькоПросмотр       = Ложь;
		Элементы.УслугиДерево.ТолькоПросмотр = Ложь;
		
	Иначе
		
		Элементы.НадписьИнфоОбщ.Видимость        = Ложь;
		Элементы.Услуги.ТолькоПросмотр       = Истина;
		Элементы.УслугиДерево.ТолькоПросмотр = Истина;
		
	КонецЕсли; 	
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Возврат Тогда
		
		Элементы.СуммаОплаты.Доступность             = Ложь;
		Элементы.ШаблонИзвещений.Доступность         = Ложь; 
		Элементы.ЛицевойСчет.Доступность             = Ложь;
		Элементы.Плательщик.Доступность              = Ложь;
		Элементы.СчетчикиВвестиПоказания.Доступность = Ложь;
		Элементы.СчетчикиЗаполнить.Доступность       = Ложь;
		Элементы.ОплатаБезСдачи.Доступность          = Ложь;	
		
	Иначе
		
		Элементы.СуммаОплаты.Доступность             = Истина;
		Элементы.ШаблонИзвещений.Доступность         = Истина; 
		Элементы.ЛицевойСчет.Доступность             = Истина;
		Элементы.СчетчикиВвестиПоказания.Доступность = Истина;
		Элементы.СчетчикиЗаполнить.Доступность       = Истина;
		Элементы.ОплатаБезСдачи.Доступность          = Истина;
		Элементы.Плательщик.Доступность              = Истина;		
		
	КонецЕсли; 
	
	// Активировать кнопку "ручного" режима печати чека ККМ.
	Если Объект.ЧекПробитНаККМ Тогда
		Элементы.Чек.Доступность    = Ложь;
		//Элементы.Пречек.Доступность = Ложь;
	КонецЕсли;
	
	// Сделать недоступными все действия для пробитого чека.
	Если Объект.ЧекПробитНаККМ Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	Иначе
		ЭтаФорма.ТолькоПросмотр = Ложь;
	КонецЕсли;
	
	Элементы.ОплатаБезСдачи.Доступность          = Не ТолькоПросмотр;
	Элементы.СчетчикиЗаполнить.Доступность       = Не ТолькоПросмотр;	
	Элементы.СчетчикиВвестиПоказания.Доступность = Не ТолькоПросмотр;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьРучнойВвод()
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.ПродажаВнешнийБиллинг
		ИЛИ Объект.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.ВозвратВнешнийБиллинг Тогда
		
		Элементы.НадписьИнфоОбщ.Видимость = Истина;
		Если Параметры.Ключ.Пустая() Тогда
			Объект.ВводВручную = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьФормыДляРедактированияНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.бит_ЧекККМ"));
	
	бит_РаботаСДиалогамиСервер.УстановитьДоступностьФормыДляРедактирования(ДокументОбъект, ЭтаФорма);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

