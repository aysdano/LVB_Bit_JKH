		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание.Улица КАК Улица,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание.НомерДома КАК НомерДома,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира КАК Квартира,
	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК Проживающий,
	бит_ПроживающиеПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК ДоляСобственности,
	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства_1,
	бит_ПроживающиеПоЛССрезПоследних.лб_СтрокаРодствДляФЛС КАК СтепеньРодства_2,
	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы КАК ПравоустанавливающиеДокументы,
	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы.лб_Архив КАК ПравоустанавливающиеДокументы_Архив
ПОМЕСТИТЬ ВТ_1
ИЗ
	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(, ) КАК бит_ПроживающиеПоЛССрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		ПО бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
ГДЕ
	бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_1.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_1.Улица КАК Улица,
	ВТ_1.НомерДома КАК НомерДома,
	ВТ_1.Квартира КАК Квартира,
	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК ПредставлениеКвартиры,
	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	ВТ_1.Проживающий КАК Собственник,
	ВТ_1.ДоляСобственности КАК ДоляСобственности,
	ВТ_1.СтепеньРодства_1 КАК СтепеньРодства_1,
	ВТ_1.СтепеньРодства_2 КАК СтепеньРодства_2,
	ВТ_1.СтатусПроживания КАК СтатусПроживания,
	ВТ_1.ПравоустанавливающиеДокументы КАК ПравоустанавливающиеДокументы,
	ВТ_1.ПравоустанавливающиеДокументы_Архив КАК ПравоустанавливающиеДокументы_Архив
ПОМЕСТИТЬ ВТ_2
ИЗ
	ВТ_1 КАК ВТ_1
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(
				,
				Квартира В
					(ВЫБРАТЬ
						ВТ_1.Квартира
					ИЗ
						ВТ_1)) КАК бит_СведенияОКвартиреСрезПоследних
		ПО ВТ_1.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_2.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_2.ЛицевойСчет.Здание.Участок КАК Участок,
	ВТ_2.Улица КАК Улица,
	ВТ_2.НомерДома КАК Дом,
	ВТ_2.ЛицевойСчет.Здание.ПрефиксДома КАК Корпус,
	ВТ_2.Квартира КАК Квартира,
	ВТ_2.ПредставлениеКвартиры КАК ПредставлениеКвартиры,
	ВТ_2.ОбщаяПлощадь КАК ОбщаяПлощадь,
	ВТ_2.Собственник КАК Собственник,
	ВТ_2.ДоляСобственности КАК ДоляСобственности,
	ВТ_2.СтепеньРодства_1 КАК СтепеньРодства_1,
	ВТ_2.СтепеньРодства_2 КАК СтепеньРодства_2,
	ВТ_2.СтатусПроживания КАК СтатусПроживания,
	ВТ_2.ПравоустанавливающиеДокументы КАК Пр_уст_Документы_1,
	бит_ПравоустанавливающиеДокументы.Наименование КАК Пр_уст_Документы_2,
	ВТ_2.ПравоустанавливающиеДокументы_Архив КАК Пр_уст_Документы_Архив,
	бит_ПравоустанавливающиеДокументы.ВидДокумента КАК Пр_уст_ВидДок_1,
	бит_ПравоустанавливающиеДокументы.НомерДокумента КАК Пр_уст_НомерДок_2,
	бит_ПравоустанавливающиеДокументы.ДатаДокумента КАК Пр_уст_ДатаДок_3,
	бит_ПравоустанавливающиеДокументы.ОрганизацияВыдавшаяДокумент КАК Пр_уст_ОргВыдДок_4,
	ВЫБОР
		КОГДА бит_ПравоустанавливающиеДокументы.ПометкаУдаления = ИСТИНА
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ПометкаУдаления,
	ВЫБОР
		КОГДА бит_ПравоустанавливающиеДокументы.бит_Архивный = ИСТИНА
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ПометкаАрхивный
ПОМЕСТИТЬ Итог
ИЗ
	ВТ_2 КАК ВТ_2
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ПравоустанавливающиеДокументы КАК бит_ПравоустанавливающиеДокументы
		ПО ВТ_2.Собственник = бит_ПравоустанавливающиеДокументы.бит_Проживающий
			И ВТ_2.ЛицевойСчет = бит_ПравоустанавливающиеДокументы.бит_ЛицевойСчет
ГДЕ
	ВТ_2.ЛицевойСчет &gt; 0
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Итог.ЛицевойСчет КАК ЛицевойСчет,
	Итог.Участок КАК Участок,
	Итог.Улица КАК Улица,
	Итог.Дом КАК Дом,
	Итог.Корпус КАК Корпус,
	Итог.Квартира КАК Квартира,
	Итог.ПредставлениеКвартиры КАК ПредставлениеКвартиры,
	Итог.ОбщаяПлощадь КАК ОбщаяПлощадь,
	Итог.Собственник КАК Собственник,
	Итог.ДоляСобственности КАК ДоляСобственности,
	Итог.СтепеньРодства_1 КАК СтепеньРодства_1,
	Итог.СтепеньРодства_2 КАК СтепеньРодства_2,
	Итог.СтатусПроживания КАК СтатусПроживания,
	Итог.Пр_уст_Документы_1 КАК Пр_уст_Документы_1,
	Итог.Пр_уст_Документы_2 КАК Пр_уст_Документы_2,
	Итог.Пр_уст_Документы_Архив КАК Пр_уст_Документы_Архив,
	Итог.Пр_уст_ВидДок_1 КАК Пр_уст_ВидДок_1,
	Итог.Пр_уст_НомерДок_2 КАК Пр_уст_НомерДок_2,
	Итог.Пр_уст_ДатаДок_3 КАК Пр_уст_ДатаДок_3,
	Итог.Пр_уст_ОргВыдДок_4 КАК Пр_уст_ОргВыдДок_4,
	Итог.ПометкаУдаления КАК ПометкаУдаления,
	Итог.ПометкаАрхивный КАК ПометкаАрхивный
ИЗ
	Итог КАК Итог
ГДЕ
	Итог.ПометкаУдаления = &amp;ПометкаУдаления
	И Итог.ПометкаАрхивный = &amp;ПометкаАрхивный</query>
	</dataSet>
	<calculatedField>
		<dataPath>Пр_уст_Документы_3</dataPath>
		<expression>ВЫБОР КОГДА Строка(Пр_уст_ВидДок_1) = "" ТОГДА Пр_уст_Документы_2 ИНАЧЕ Строка(Пр_уст_ВидДок_1) + Представление(" №") + Строка(Пр_уст_НомерДок_2) + Представление(" от ") + Формат (Пр_уст_ДатаДок_3, "ДФ=dd.MM.yyyy") + Представление(", ") + Строка(Пр_уст_ОргВыдДок_4) КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Пр.уст.Документы 3</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>Служебные.НППКвартира</dataPath>
		<expression>ВычислитьВыражение("НомерПоПорядкуВГруппировке()","ГруппКв")</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>НППКвартира</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<calculatedField>
		<dataPath>Служебные.ЧетНечет</dataPath>
		<expression>ВычислитьВыражение("НомерПоПорядкуВГруппировке()","ГруппКв")%2</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>ЧетНечет</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
