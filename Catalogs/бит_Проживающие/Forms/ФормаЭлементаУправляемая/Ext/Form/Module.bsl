// Процедура считывает ФИО физлица.
//
// Параметры: 
//  Нет.
//
// Возвращаемое значение:
//  Нет.
//
&НаСервере
Процедура ПрочитатьФИО()
	
	ФИОСрез = РегистрыСведений.бит_ФИОПроживающих.ПолучитьПоследнее( ,Новый Структура("ФизЛицо", Объект.Ссылка));
	
	Фамилия  = ФИОСрез.Фамилия;
	Имя      = ФИОСрез.Имя;
	Отчество = ФИОСрез.Отчество;
	
КонецПроцедуры // ПрочитатьМестоРождения

// Процедура записи ФИО.
//
&НаСервере
Процедура ЗаписатьДанныеФИО()
	
	ФИОСрез = РегистрыСведений.бит_ФИОПроживающих.ПолучитьПоследнее( ,Новый Структура("ФизЛицо", Объект.Ссылка));
	
	СтрокаСреза = ФИОСрез.Фамилия + ФИОСрез.Имя + ФИОСрез.Отчество;
	
	Если СтрокаСреза <> (Фамилия + Имя + Отчество) Тогда
		
		МенеджерЗаписи = РегистрыСведений.бит_ФИОПроживающих.СоздатьМенеджерЗаписи();
		
		МенеджерЗаписи.ФизЛицо = Объект.Ссылка;
		
		Если ПустаяСтрока(СтрокаСреза) Тогда
			
			МенеджерЗаписи.Период = '19000101';
			
		Иначе
			
			МенеджерЗаписи.Период = ТекущаяДата();
			
		КонецЕсли;
		
		МенеджерЗаписи.Фамилия  = Фамилия;
		МенеджерЗаписи.Имя      = Имя;
		МенеджерЗаписи.Отчество = Отчество;
		
		МенеджерЗаписи.Записать(Истина);
		
	КонецЕсли;
	
КонецПроцедуры

// Функция обработки строки.
//
&НаСервере
Функция ВыделитьСлово(ИсходнаяСтрока)
	
	Буфер              = СокрЛ(ИсходнаяСтрока);
	ПозицияПослПробела = Найти(Буфер, " ");
	
	Если ПозицияПослПробела = 0 Тогда
		
		ИсходнаяСтрока = "";
		
		Возврат Буфер;
		
	КонецЕсли;
	
	ВыделенноеСлово = СокрЛП(Лев(Буфер, ПозицияПослПробела));
	ИсходнаяСтрока  = Сред(ИсходнаяСтрока, ПозицияПослПробела + 1);
	
	Возврат ВыделенноеСлово;
	
КонецФункции

// БИТ_ЖКХ добавление кода Начало: 31.01.2011 
// БИТ_ЖКХ 31.01.2011 Процедура <Описание процедуры>.
// Формирование списка вида сведений на странице "дополнительные сведения".
&НаСервере
Процедура бит_ДобавлениеСпискаДопДанных(Знач ТабЗнач, Знач Ссылка, Знач ПериодДопДанных)
	
	СписокИсключений = Новый Массив;
	
	СписокИсключений.Добавить(ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.Должность);
	СписокИсключений.Добавить(ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.КогдаИОткудаПрибыл);
	СписокИсключений.Добавить(ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.МестоРаботы);
	СписокИсключений.Добавить(ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.ОтношениеКВоеннойСлужбе);
	СписокИсключений.Добавить(ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.РодЗанятий);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ДополнительныеДанныеОПроживающих.Ссылка КАК ВидСведений,
	|	ЕСТЬNULL(бит_ДопСведенияОПроживающихСрезПоследних.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
	|ИЗ
	|	ПланВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих КАК бит_ДополнительныеДанныеОПроживающих
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ДопСведенияОПроживающих.СрезПоследних(&Период, Проживающий.Ссылка = &Ссылка) КАК бит_ДопСведенияОПроживающихСрезПоследних
	|		ПО (бит_ДопСведенияОПроживающихСрезПоследних.ВидСведений = бит_ДополнительныеДанныеОПроживающих.Ссылка)
	|ГДЕ
	|	НЕ бит_ДополнительныеДанныеОПроживающих.Ссылка В (&СписокИсключений)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВидСведений";
	
	Запрос.УстановитьПараметр("СписокИсключений", СписокИсключений);
	Запрос.УстановитьПараметр("Период"          , ПериодДопДанных);
	Запрос.УстановитьПараметр("Ссылка"          , Ссылка);
	
	ТабЗначВрем = Запрос.Выполнить().Выгрузить();
	
	ДопДанныеПроживающих.Очистить();
	
	ДопДанныеПроживающих.Загрузить(ТабЗначВрем); 
	
КонецПроцедуры //битДобавлениеСпискаДопДанных()                        

// Процедура обновляет представления элемента.
//
&НаСервере
Процедура ОбновитьПредставлениеЭлемента(ИмяОбновляемогоЭлемента);
	
	ОбновитьНаборыЗаписейНаСервере();
	
	Если ИмяОбновляемогоЭлемента = "Гражданство" Тогда
		
		Если мНаборЗаписейГражданство.Количество() > 0 Тогда
			
			Гражданство       = "" + СокрЛП(мНаборЗаписейГражданство[0].Страна);
			ГражданствоСтрана = "" + мНаборЗаписейГражданство[0].Страна;
			
			Модифицированность = Истина;
			
		Иначе
			
			Гражданство = "Ввести данные о гражданстве";
			
		КонецЕсли;
		
	ИначеЕсли ИмяОбновляемогоЭлемента = "ТрудоваяДеятельность" Тогда
		
		Если мНаборЗаписейТрудоваяДеятельность.Количество() > 0 Тогда
			
			СтруктураТрудоваяДеятельность = мНаборЗаписейТрудоваяДеятельность[0];
			
			Если СтруктураТрудоваяДеятельность.ВидыЗанятости = Перечисления.бит_ВидыЗанятостиПроживающих.Учащийся Тогда
				
				ТрудоваяДеятельность = "" + СтруктураТрудоваяДеятельность.ВидыЗанятости + " "
				+ СтруктураТрудоваяДеятельность.МестоРаботы + ", курс/ класс: "
				+ СтруктураТрудоваяДеятельность.КурсКласс;
				
				
			Иначе
				
				ТрудоваяДеятельность = "" + СтруктураТрудоваяДеятельность.ВидыЗанятости + " "
				+ СтруктураТрудоваяДеятельность.МестоРаботы + " с "
				+ Формат(СтруктураТрудоваяДеятельность.НачалоРаботы, "ДФ='дд ММММ гггг';ДП='...'") +  " по "
				+ Формат(СтруктураТрудоваяДеятельность.ОкончаниеРаботы, "ДФ='дд ММММ гггг';ДП='...'") + ", в должности : "
				+ СтруктураТрудоваяДеятельность.Должность;
				
			КонецЕсли; 
			
			ТрудоваяДеятельность = СтрЗаменить(ТрудоваяДеятельность,"Не указано","...");
			
			Модифицированность = Истина;
			
		Иначе
			
			ТрудоваяДеятельность = "Ввести данные о трудовой деятельности";
			
		КонецЕсли;
		
	ИначеЕсли ИмяОбновляемогоЭлемента = "ВоинскийУчет" Тогда
		
		Если мНаборЗаписейВоинскийУчет.Количество() > 0 Тогда
			
			СтруктураВоинскийУчет = мНаборЗаписейВоинскийУчет[0];
			
			Если СтруктураВоинскийУчет.ОтношениеКВоинскойОбязанности = Перечисления.бит_ОтношениеКВоинскойОбязанности.НеВоеннообязанный Тогда
				
				ВоинскийУчет 	= СтруктураВоинскийУчет.ОтношениеКВоинскойОбязанности;
				
			Иначе
				
				ВоинскийУчет 	= "" + СтруктураВоинскийУчет.ОтношениеКВоинскойОбязанности
				+ ", Категория: " + СтруктураВоинскийУчет.КатегорияЗапаса
				+ ", Звание: " + СтруктураВоинскийУчет.Звание 
				+ ", Состав: " + СтруктураВоинскийУчет.Состав
				+ ", ВУС: " + СтруктураВоинскийУчет.ВУС + ", Годность: " 
				+ СтруктураВоинскийУчет.Годность + ", Военкомат: " 
				+ СтруктураВоинскийУчет.Военкомат 
				+ ", " + СтруктураВоинскийУчет.ОтношениеКВоинскомуУчету 
				+ ?(СтруктураВоинскийУчет.НаличиеМобпредписания, ", имеет мобпредписание", "")
				+", № команды: " + СтруктураВоинскийУчет.НомерКомандыПартии;
				
			КонецЕсли;
			
			ЭтаФорма.Модифицированность = Истина;
			
		Иначе 
			
			ЭтаФорма.ВоинскийУчет = "Ввести данные о воинском учете";
			
		КонецЕсли;
		
	ИначеЕсли ИмяОбновляемогоЭлемента = "СвидетельствоОСмерти" Тогда
		
		Если мНаборЗаписейСвидетельстваОСмерти.Количество() > 0 Тогда
			
			Свидетельство = мНаборЗаписейСвидетельстваОСмерти[0];
			
			СвидетельствоОСмерти = "а/з " + Свидетельство.Номер + ", от " + Формат(Свидетельство.ДатаСоставления, "ДФ='дд ММММ гггг'; ДП='Не указано'") + ", " 
			+ ", свидетельство о смерти " + Свидетельство.СерияСвидетельства
			+ ", №" + Свидетельство.НомерСвидетельства + ", " + Свидетельство.КемВыдано 
			+ ", от " + Формат(Свидетельство.ДатаВыдачи, "ДФ='дд ММММ гггг'; ДП='Не указано'");
			
			СвидетельствоОСмерти = СтрЗаменить(СвидетельствоОСмерти,"Не указано","...");
			
			Модифицированность = Истина;
			
		Иначе
			
			СвидетельствоОСмерти = "Ввести данные об свидетельстве о смерти";
			
		КонецЕсли;
		
	ИначеЕсли ИмяОбновляемогоЭлемента = "УдостоверениеЛичности" Тогда
		
		Если мНаборЗаписейДокументаУдостоверяющегоЛичность.Количество() > 0 Тогда
			
			Паспорт = мНаборЗаписейДокументаУдостоверяющегоЛичность[0];
			
			УдостоверениеЛичности = "" + Паспорт.ДокументВид + ", серия: " + Паспорт.ДокументСерия + ", № " + Паспорт.ДокументНомер 
			+ ", выдан: " + Формат(Паспорт.ДокументДатаВыдачи, "ДФ='дд ММММ гггг'; ДП='Не указано'") + " года, " 
			+ Паспорт.ДокументКемВыдан + ", № подр. " + Паспорт.ДокументКодПодразделения 
			+ Символы.Таб + "Дата регистрации по месту жительства: " + Формат(Паспорт.ДатаРегистрацииПоМестуЖительства, "ДФ='дд ММММ гггг'; ДП='Не указано'");
			
			УдостоверениеЛичности = СтрЗаменить(УдостоверениеЛичности, "Не указано", "...");
			
			Модифицированность = Истина;
			
		Иначе
			
			УдостоверениеЛичности = "Ввести данные об удостоверении личности";
			
		КонецЕсли;
		
	ИначеЕсли ИмяОбновляемогоЭлемента = "ФИО" Тогда
		
		ПрочитатьФИО();
		
	ИначеЕсли ИмяОбновляемогоЭлемента = "Инвалидность" Тогда
		
		Если мНаборЗаписейИнвалидность.Количество() > 0 Тогда
			
			ЗаписьИзНабора = мНаборЗаписейИнвалидность[0];
			
			Если ЗаписьИзНабора.Инвалидность Тогда
				
				Инвалидность = 	"инвалид: " + ЗаписьИзНабора.ГруппаИнвалидности + " группы" 
				+ ", справка серия: " + ЗаписьИзНабора.СерияСправки + ", номер: " + ЗаписьИзНабора.НомерСправки 
				+ ", выдана: "  + Формат(ЗаписьИзНабора.ДатаВыдачи, "ДФ='дд ММММ гггг';ДП='...'") + " года "
				+ ", срок действия: " + Формат(ЗаписьИзНабора.СрокДействияСправки, "ДФ='дд ММММ гггг';ДП='...'") + " года ";
				
			Иначе
				
				Инвалидность = "Не является инвалидом";
				
			КонецЕсли;
			
			Модифицированность = Истина;
			
		Иначе
			
			Инвалидность = "Ввести данные об инвалидности";
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура одновления ИНН организации.
//
&НаСервере
Функция ОбновитьИННОрганизаций()
	
	ТекстСообщения = "";
	
	ЗапросОрганизации = Новый Запрос;
	
	ЗапросОрганизации.УстановитьПараметр("ИндивидуальныйПредприниматель", Объект.Ссылка);
	ЗапросОрганизации.УстановитьПараметр("ИНН"                          , Объект.ИНН);
	
	ТекстЗапроса =
	"ВЫБРАТЬ
	|	Организации.Ссылка
	|ИЗ
	|	Справочник.Организации КАК Организации
	|
	|ГДЕ
	|	Организации.ИндивидуальныйПредприниматель = &ИндивидуальныйПредприниматель И
	|	Организации.ИНН <> &ИНН";
	
	ЗапросОрганизации.Текст = ТекстЗапроса;
	
	ВыборкаЗапроса = ЗапросОрганизации.Выполнить().Выбрать();
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		ЗависимаяОрганизация = ВыборкаЗапроса.Ссылка.ПолучитьОбъект();
		
		Если ВладелецФормы <> Неопределено И ТипЗнч(ВладелецФормы) = Тип("Форма") И ВладелецФормы.ЭтотОбъект.Ссылка = ЗависимаяОрганизация.Ссылка Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Попытка
			
			ЗависимаяОрганизация.Заблокировать();
			
		Исключение
			
			ТекстСообщения = "Организация: " + ВыборкаЗапроса.Ссылка + " - объект заблокирован.";
			
			Возврат ТекстСообщения;
			
		КонецПопытки;
		
	КонецЦикла;	    
	
	ВыборкаЗапроса.Сбросить(); 
	
	Пока ВыборкаЗапроса.Следующий() Цикл
		
		ЗависимаяОрганизация = ВыборкаЗапроса.Ссылка.ПолучитьОбъект();
		
		Если ВладелецФормы <> Неопределено И ТипЗнч(ВладелецФормы) = Тип("Форма") И ВладелецФормы.ЭтотОбъект.Ссылка = ЗависимаяОрганизация.Ссылка Тогда
			
			ВладелецФормы.ИНН = Объект.ИНН;
			
			Продолжить;
			
		КонецЕсли;
		
		ЗависимаяОрганизация.ИНН = Объект.ИНН;
		
		ЗависимаяОрганизация.Записать();
		
	КонецЦикла; 
	
	Возврат ТекстСообщения;
	
КонецФункции

&НаСервере
Функция ЗаписатьОбъектНаСервере()
	
	СправочникОбъект = РеквизитФормыВЗначение("Объект");
	
	Попытка
		
		СправочникОбъект.Записать();
		
		Отказ = Ложь;
		
	Исключение
		
		Отказ = Истина;
		
	КонецПопытки;
	
	Возврат Отказ;
	
КонецФункции

&НаСервере
Функция ПолучитьСтруктуруРегистраСведеенийФИОПроживающихНаСервере(Знач Ссылка, Знач ФИО);
	
	ТаблицаРегистра = РегистрыСведений.бит_ФИОПроживающих.СрезПоследних( , Новый Структура("ФизЛицо", Ссылка));
	
	СтруктураРегистра = Новый Структура;
	
	Если ТаблицаРегистра.Количество() > 0 Тогда
		
		СтруктураРегистра.Вставить("Период"  , ТаблицаРегистра[0].Период);
		СтруктураРегистра.Вставить("Фамилия" , ТаблицаРегистра[0].Фамилия);
		СтруктураРегистра.Вставить("Имя"     , ТаблицаРегистра[0].Имя);
		СтруктураРегистра.Вставить("Отчество", ТаблицаРегистра[0].Отчество);
		
	Иначе
		
		СтруктураРегистра.Вставить("Период"  , '19000101');
		СтруктураРегистра.Вставить("Фамилия" , ВыделитьСлово(ФИО));
		СтруктураРегистра.Вставить("Имя"     , ВыделитьСлово(ФИО));
		СтруктураРегистра.Вставить("Отчество", ВыделитьСлово(ФИО));
		
	КонецЕсли;
	
	Возврат СтруктураРегистра;
	
КонецФункции

&НаСервере
Функция ПолучитьДанныеИзКонтактнойИнформации(Тип, Вид)
	
	ТипВЗапросе = ПолучитьТипКонтактнойИнформации(Тип);
	ВидВЗапросе = ПолучитьВидКонтактнойИнформации(Вид);
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	бит_КонтактнаяИнформация.Представление
	|ИЗ
	|	РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
	|ГДЕ
	|	бит_КонтактнаяИнформация.Объект = &Объект
	|	И бит_КонтактнаяИнформация.Тип = &Тип
	|	И бит_КонтактнаяИнформация.Вид = &Вид");
	
	Запрос.УстановитьПараметр("Объект", Объект.Ссылка);
	Запрос.УстановитьПараметр("Тип"   , ТипВЗапросе);
	Запрос.УстановитьПараметр("Вид"   , ВидВЗапросе);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ПредставлениеАдреса = "";
	
	Если Выборка.Следующий() Тогда
		
		ПредставлениеАдреса = Выборка.Представление;
		
	КонецЕсли;
	
	Возврат ПредставлениеАдреса;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьТипКонтактнойИнформации(Тип)
	
	Если Тип = "Адрес" Тогда
		
		ТипВЗапросе = Перечисления.бит_ТипыКонтактнойИнформации.Адрес;
		
	ИначеЕсли Тип = "Телефон" Тогда
		
		ТипВЗапросе = Перечисления.бит_ТипыКонтактнойИнформации.Телефон;
		
	ИначеЕсли Тип = "АдресЭлектроннойПочты" Тогда
		
		ТипВЗапросе = Перечисления.бит_ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		
	ИначеЕсли Тип = "Другое" Тогда
		
		ТипВЗапросе = Перечисления.бит_ТипыКонтактнойИнформации.Другое;
		
	КонецЕсли;
	
	Возврат ТипВЗапросе;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьВидКонтактнойИнформации(Вид)
	
	Если Вид = "АдресПоПрописке" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.ЮрАдресПроживающего;
		
	ИначеЕсли Вид = "АдресПроживания" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.ФактАдресПроживающего;
		
		
	ИначеЕсли Вид = "Телефон" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.ТелефонПроживающего;
		
		
	ИначеЕсли Вид = "АдресДляИнформирования" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.ИнформАдресПроживающего;
		
		
	ИначеЕсли Вид = "АдресЗапределамиРФ" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.ИнострАдресПроживающего;
		
		
	ИначеЕсли Вид = "ТелефонСлужебный" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.ТелефонСлужебныйПроживающего;
		
		
	ИначеЕсли Вид = "Email" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.EmailПроживающего;
		
		
	ИначеЕсли Вид = "АдресПрибытияИзДругогоРегиона" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытияДрРегион;
		
		
	ИначеЕсли Вид = "ДругаяИнформация" Тогда
		
		ВидВЗапросе = Справочники.бит_ВидыКонтактнойИнформации.ДругаяИнформацияПроживающего;
		
	КонецЕсли;
	
	Возврат ВидВЗапросе;
	
КонецФункции

&НаСервере
Функция ПечатьДанныхПоФизлицуНаСервере()
	
	СтруктураДанных            = Новый Структура; 
	СтруктураДанныхОрганизации = Новый Структура; 
	
	Подробно = Истина;
	
	Запрос = Новый Запрос;
	
	// Установим параметры запроса.
	Запрос.УстановитьПараметр("ФизЛицо"         , Объект.Ссылка);
	Запрос.УстановитьПараметр("ДатаАктуальности", ТекущаяДата());
	Запрос.УстановитьПараметр("ПустаяСтрока"    , "");
	Запрос.УстановитьПараметр("ПустаяДата"      , Дата('00010101'));
	Запрос.УстановитьПараметр("Проведен"        ,Истина);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ФизическиеЛица.Наименование,
	|	ФизическиеЛица.ДатаРождения,
	|	ФизическиеЛица.МестоРождения,
	|	ФизическиеЛица.ИНН,
	|	ФизическиеЛица.Код,
	|	ФизическиеЛица.КодИМНС,
	|	ФизическиеЛица.Пол,
	|	ФизическиеЛица.СтраховойНомерПФР,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид.Представление КАК ДокументВид,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКодПодразделения,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество
	|ИЗ
	|	Справочник.бит_Проживающие КАК ФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ФИОФизЛицСрезПоследних
	|		ПО (ФИОФизЛицСрезПоследних.ФизЛицо = ФизическиеЛица.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО ФизическиеЛица.Ссылка = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|ГДЕ
	|	ФизическиеЛица.Ссылка = &ФизЛицо";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДляПроверок = Результат.Выбрать();
	
	ВыборкаДляПроверок.Следующий();
	
	СтруктураДанных.Вставить("ФизическиеЛица", Результат.Выбрать());
	
	Если ВыборкаДляПроверок.ДокументВид <> Null Тогда
		
		СтруктураДанных.Вставить("ПаспортныеДанныеФизЛиц", Результат.Выбрать());
		
	КонецЕсли;
	
	// БИТ_ЖКХ 26.03.2015{{
	Если Объект.Ссылка.КонтактнаяИнформация.Количество() > 0 Тогда
		
		// Контактная информация.
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПроживающиеКонтактнаяИнформация.Тип КАК Тип,
		|	бит_ПроживающиеКонтактнаяИнформация.Вид КАК ВидКИ,
		|	бит_ПроживающиеКонтактнаяИнформация.Представление КАК ПредставлениеКИ
		|ИЗ
		|	Справочник.бит_Проживающие.КонтактнаяИнформация КАК бит_ПроживающиеКонтактнаяИнформация
		|ГДЕ
		|	бит_ПроживающиеКонтактнаяИнформация.Ссылка = &ФизЛицо";
		
		Запрос.УстановитьПараметр("ФизЛицо", Объект.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		СтруктураДанных.Вставить("КонтактнаяИнформация", ВыборкаДетальныеЗаписи);
		
	Иначе	
		
		// Контактная информация.
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактнаяИнформация.Тип КАК Тип,
		|	ВЫБОР КОГДА КонтактнаяИнформация.Вид ССЫЛКА Справочник.бит_ВидыКонтактнойИнформации ТОГДА
		|		КонтактнаяИнформация.Вид.Представление
		|	ИНАЧЕ
		|		КонтактнаяИнформация.Вид
		|	КОНЕЦ КАК ВидКИ,
		|	КонтактнаяИнформация.Представление КАК ПредставлениеКИ
		|ИЗ
		|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &ФизЛицо
		|УПОРЯДОЧИТЬ ПО
		|	Тип
		|АВТОУПОРЯДОЧИВАНИЕ";
		
		СтруктураДанных.Вставить("КонтактнаяИнформация", Запрос.Выполнить().Выбрать());
		
	КонецЕсли;
	// БИТ_ЖКХ 26.03.2015}}	
	
	СтруктураДанных.Вставить("КонтактнаяИнформация", Запрос.Выполнить().Выбрать());
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	ВыводитьНаПечать = Истина;
	
	ТабДокумент.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_ФизическиеЛица_ДанныеПоФизлицу";
	
	СправочникОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	Макет = СправочникОбъект.ПолучитьМакет("ДанныеПоФизлицу");
	
	Для Каждого СекцияДанных Из СтруктураДанных Цикл
		
		ИмяСекции = СекцияДанных.Ключ;
		
		УсловиеВыводаРаскрытойГруппы = ИмяСекции = "ФизическиеЛица";
		
		Выборка = СекцияДанных.Значение;
		
		Если ИмяСекции = "КонтактнаяИнформация" И НЕ Выборка.Количество() = 0 Тогда
			
			СекцияЗаголовка = Макет.ПолучитьОбласть("КонтактнаяИнформация_Заголовок");
			
			ТабДокумент.Вывести(СекцияЗаголовка);
			
			ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, , ТабДокумент.ВысотаТаблицы, ).ЦветФона = ЦветаСтиля.ФонГруппировкиВерхнегоУровня;
			
			ТабДокумент.НачатьГруппуСтрок("", Ложь);
			
			Отбивка = Макет.ПолучитьОбласть("Отбивка");
			
			СекцияТипаКИ = Макет.ПолучитьОбласть("КонтактнаяИнформация_Тип");
			
			Пока Выборка.СледующийПоЗначениюПоля("Тип") Цикл
				
				ТабДокумент.Вывести(Отбивка);
				
				СекцияТипаКИ.Параметры.ТипКИ = Строка(Выборка.Тип) + ":";
				
				ТабДокумент.Вывести(СекцияТипаКИ);
				
				СекцияКИ = Макет.ПолучитьОбласть("КонтактнаяИнформация_Данные");
				
				Пока Выборка.СледующийПоЗначениюПоля("ВидКИ") Цикл
					
					СекцияКИ.Параметры.Заполнить(Выборка);
					
					ТабДокумент.Вывести(СекцияКИ);
					
				КонецЦикла;
				
			КонецЦикла; 
			
			ТабДокумент.Вывести(Отбивка);
			
			ТабДокумент.ЗакончитьГруппуСтрок();
			
		ИначеЕсли Макет.Области.Найти(ИмяСекции + "_Заголовок") <> Неопределено и Выборка.Следующий() Тогда
			
			Отбивка = ?(Макет.Области.Найти(ИмяСекции + "_Отбивка") <> Неопределено, Макет.ПолучитьОбласть(ИмяСекции + "_Отбивка"), Макет.ПолучитьОбласть("Отбивка"));
			
			ОбластьМакета = Макет.ПолучитьОбласть(ИмяСекции + "_Заголовок");
			
			Если ОбластьМакета.Области.Количество() = 1 Тогда
				
				ТабДокумент.Вывести(ОбластьМакета);
				
				ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, , ТабДокумент.ВысотаТаблицы, ).ЦветФона = ЦветаСтиля.ФонГруппировкиВерхнегоУровня;
				
				ТабДокумент.НачатьГруппуСтрок("", УсловиеВыводаРаскрытойГруппы);
				
				ТабДокумент.Вывести(Отбивка);
				
			Иначе
				
				ОбластьМакета = Макет.ПолучитьОбласть(ИмяСекции + "_Заголовок_ПерваяСтрока");
				
				ТабДокумент.Вывести(ОбластьМакета);
				
				ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, , ТабДокумент.ВысотаТаблицы, ).ЦветФона = ЦветаСтиля.ФонГруппировкиВерхнегоУровня;
				
				ТабДокумент.НачатьГруппуСтрок("", УсловиеВыводаРаскрытойГруппы);
				
				ТабДокумент.Вывести(Отбивка);
				
				ОбластьМакета = Макет.ПолучитьОбласть(ИмяСекции + "_Заголовок_Остальное");
				
				Если ОбластьМакета.Параметры.Количество() = 0 Тогда // раскрашиваем заголовок без выведенных данных
					
					ТабДокумент.Область(ТабДокумент.ВысотаТаблицы, 2, ТабДокумент.ВысотаТаблицы, 10).ЦветФона = ЦветаСтиля.ФонГруппировкиПромежуточногоУровня;
					
				Иначе
					
					ОбластьМакета.Параметры.Заполнить(Выборка);
					
				КонецЕсли;
				
				ТабДокумент.Вывести(ОбластьМакета);
				
				Если ОбластьМакета.Параметры.Количество() = 0 Тогда // раскрашиваем заголовок без выведенных данных
					
					ТабДокумент.Область(ТабДокумент.ВысотаТаблицы - ОбластьМакета.ВысотаТаблицы + 1, 2, ТабДокумент.ВысотаТаблицы, 10).ЦветФона = ЦветаСтиля.ФонГруппировкиПромежуточногоУровня;
					
				КонецЕсли;
				
			КонецЕсли;
			
			ОбластьМакета = Макет.ПолучитьОбласть(ИмяСекции + "_Данные");
			
			ОбластьМакета.Параметры.Заполнить(Выборка);
			
			Если ИмяСекции = "ФизическиеЛица" и НЕ ЗначениеЗаполнено(Выборка.Фамилия) Тогда
				
				Фамилия  = " "; 
				Имя      = " "; 
				Отчество = " ";
				
				бит_ОбщегоНазначения.ФамилияИнициалыФизЛица(СправочникОбъект, Фамилия, Имя, Отчество);
				
				ОбластьМакета.Параметры.Фамилия  = Фамилия;
				ОбластьМакета.Параметры.Имя      = Имя;
				ОбластьМакета.Параметры.Отчество = Отчество;
				
			КонецЕсли;
			
			ТабДокумент.Вывести(ОбластьМакета);
			
			Пока Выборка.Следующий() Цикл
				
				ОбластьМакета.Параметры.Заполнить(Выборка);
				
				ТабДокумент.Вывести(ОбластьМакета);
				
			КонецЦикла;
			
			ТабДокумент.Вывести(Отбивка);
			
			ТабДокумент.ЗакончитьГруппуСтрок();
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("СправочникОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции // ПолучитьТипОбъекта()

&НаСервереБезКонтекста
Функция КлючЗаписиФИОПроживающихСуществует(ПередаваемыеПараметры)
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ФИОПроживающих.Фамилия,
	|	бит_ФИОПроживающих.Имя,
	|	бит_ФИОПроживающих.Отчество
	|ИЗ
	|	РегистрСведений.бит_ФИОПроживающих КАК бит_ФИОПроживающих
	|ГДЕ
	|	бит_ФИОПроживающих.Период = &Период
	|	И бит_ФИОПроживающих.ФизЛицо = &ФизЛицо");
	
	Запрос.УстановитьПараметр("Период" , ПередаваемыеПараметры.Период);
	Запрос.УстановитьПараметр("ФизЛицо", ПередаваемыеПараметры.ФизЛицо);
	
	Возврат Не Запрос.Выполнить().Пустой();
	
КонецФункции

