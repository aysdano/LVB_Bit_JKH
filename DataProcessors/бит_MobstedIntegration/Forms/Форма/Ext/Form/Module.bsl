Функция ПроверитьНачисленияВМобстед(Период,ЛицевойСчет)
	ЕстьОтвет = Истина;
	УИН = Период;
	УИН = КодироватьСтроку(УИН,СпособКодированияСтроки.КодировкаURL);
	НомПриложения = Объект.НомерПриложения;
	НомПриложения =  КодироватьСтроку(НомПриложения,СпособКодированияСтроки.КодировкаURL);
	ПеремЛицевойСчет   =  КодироватьСтроку(ЛицевойСчет,СпособКодированияСтроки.КодировкаURL);
	
	АдресСервисаСтр = СокрЛП(Объект.АдресСервиса);
	АдресРесурса = "/api/v4/events?ApplicationId="+НомПриложения+"&query=";
	//////http://requestb.in/z5d323z5   http://requestb.in/1il9nj21
	//АдресСервисаСтр = "requestb.in";
	//АдресРесурса = "1il9nj21";
	
	СтрокаПараметров = 
	"["
	+"{"
	+"""field"""                +":"+ """object_НомерЛицевогоСчета"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+""""+Строка(ПеремЛицевойСчет)+""""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+","
	+"{"
	+"""field"""                +":"+ """ActionName"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+"""Начисление"""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+","
	+"{"                                 
	+"""field"""                +":"+ """PaymentDocNumber"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+""""+Строка(УИН)+""""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+"]";
	
	СтрокаПараметров =  КодироватьСтроку(СтрокаПараметров,СпособКодированияСтроки.КодировкаURL);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		ЕстьОтвет = Ложь;
		Сообщить("Ошибка при отправке запроса: " + ОписаниеОшибки());
		Возврат Ложь;
	КонецПопытки;
	Если ЕстьОтвет Тогда 	
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				Если СокрЛП(СтрокаОтвет) = "[]" Тогда
					Возврат Ложь;	
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			Сообщить("Проверка начислений в Мобстед. "+"Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Сообщить("Проверка начислений в Мобстед. "+"Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Сообщить("Проверка начислений в Мобстед. "+"Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
		Иначе
			Сообщить("Проверка начислений в Мобстед. "+"Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
		КонецЕсли;
		Возврат Истина;
	КонецЕсли;
КонецФункции	

