&НаСервере
Процедура ЗагрузитьУслугиЛСНаСервере(ВариантУслуги = "", ТолькоТарифы = ложь)
	// Вставить содержимое обработчика.
	МассивСтру = ЗагрузитьДБФВМассивСтруктур();		                                            	
	
	Если ВариантУслуги = "КР" тогда
		ЧислоСтрок = МассивСтру.Количество();
		Для СчетВниз=1 по ЧислоСтрок цикл
			Инд = ЧислоСтрок- СчетВниз;
			Стру = МассивСтру[инд];
			Если лев(Стру.POST,4)= "РФКР" тогда
				Стру.Вставить("ПропуститьЭтотЭлемент",истина);
			иначе
				Стру.YSLYGA= "Минимальный взнос на кап.ремонт";
			КонецЕсли;	
		КонецЦикла;	
	ИначеЕсли ВариантУслуги = "РФКР" тогда
				
		ЧислоСтрок = МассивСтру.Количество();
		Для СчетВниз=1 по ЧислоСтрок цикл
			Инд = ЧислоСтрок- СчетВниз;
			Стру = МассивСтру[инд];
			Если лев(Стру.POST,4)= "РФКР" тогда
				Стру.YSLYGA= "Капитальный ремонт (РФКР)";
			иначе
				Стру.Вставить("ПропуститьЭтотЭлемент",истина);
			КонецЕсли;	
		КонецЦикла;	  
		
	КонецЕсли;	
	
	
	
	ДополнитьМассивСтруктурДляУслугНаЛС();          
	
	
	
	
	
	
	Если ВариантУслуги = "РФКР" тогда
		Услуга = Справочники.бит_УслугиЖКХ.НайтиПоНаименованию("Капитальный ремонт (РФКР)");
	ИначеЕсли МассивСтру.Количество()>0 и МассивСтру[0].Свойство("Услуга") тогда
		Услуга = МассивСтру[0].Услуга;
	иначе
		Сообщить("В файле" + ЭтаФорма.ИмяФайлаКл+" нет информации по услуге");
		возврат 
	КонецЕсли;	

	Если Не ЗначениеЗаполнено(Услуга) тогда
		ИмяУслуги = сокрЛП(МассивСтру[0].YSLYGA);
		Сообщить("Не могу найти услугу: "+ИмяУслуги );
		возврат;
	КонецЕсли;	
	
	Если Объект.ТолькоНовыеОбъекты = истина тогда
		ЗаполнитьОбработанныеУслуги(Услуга);
		УдалитьстрокиОбработанныхОстатков();
	КонецЕсли;	
	
	
	
	Если ВариантУслуги= "" тогда
		Попытка
			ПодключитьУслугуКДомам();	
		исключение
		КонецПопытки;	
	КонецЕсли;	
	
	ДокСтавки = получитьДокСтавок(Услуга);	
	Если ложь тогда ДокСтавки = Документы.бит_УстановкаСтавокПоУслугам.СоздатьДокумент() КонецЕсли;
	ТаблСтавок = ДокСтавки.СтавкиНаУслуги.Выгрузить();
	
	
	ДобавитьПодучасткиВМассивСтру();
			
	ОбработаноЭлементов = 0;
	ЧислоСтрокВДокумненте = 0;  //если =0, то группирируем в документы по подучасткам  Стру.Подучасток, идущим подряд
	Подучасток = ""; 
	
	
	
	ЗапросТекУслуги = новый запрос;
	ЗапросТекУслуги.УстановитьПараметр("Услуга",Услуга);
	ЗапросТекУслуги.УстановитьПараметр("Дата",Объект.Дата);
	ЗапросТекУслуги.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления,
		|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик,
		|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета,
		|	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления
		|ИЗ
		|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
		|ГДЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ИСТИНА";
	ТаблТекУслуг = ЗапросТекУслуги.Выполнить().Выгрузить();
	ТаблТекУслуг.Индексы.Добавить("ЛицевойСчет");
	
	
	
	Пока ОбработаноЭлементов<МассивСтру.Количество()  цикл				
		ДокОбъект = Документы.бит_УстановкаИзменениеУслугПоЛС.СоздатьДокумент();
		ДокОбъект.Дата = Объект.Дата;
		ДокОбъект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета;
		ДокОбъект.Услуга = Услуга;
		
		
		
		ЗаполнитьСтрокиДокументаУстановкаУслугЛС(ДокОбъект,ОбработаноЭлементов,ЧислоСтрокВДокумненте,Подучасток,ТаблСтавок,ТаблТекУслуг);
		Если ДокОбъект.ЛицевыеСчета.Количество() >0 тогда			
			ПозСлэша = СтрНайти(ЭтаФорма.ИмяФайлаКл,"\",НаправлениеПоиска.СКонца,,2);
			ИмяФ = ?(ПозСлэша=0,ЭтаФорма.ИмяФайлаКл,Сред(ЭтаФорма.ИмяФайлаКл,ПозСлэша+1));
			Если НЕ ЗначениеЗаполнено(Подучасток) или ПустаяСтрока(Подучасток) тогда
				ДокОбъект.Комментарий = "Подуч "+Подучасток + " из файла " + ИмяФ;
			иначе
				ДокОбъект.Комментарий = "Из файла " + ЭтаФорма.ИмяФ;
			КонецЕсли;	
			Если Не ТолькоТарифы тогда	
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);				
			КонецЕсли;	
		иначе	
			Сообщить("В файле "+ ЭтаФорма.ИмяФайлаКл + " нет ненулевых строк");
		КонецЕсли;	
	Конеццикла;	
	
	Если ТаблСтавок.Количество()>0 тогда
		ДокСтавки.СтавкиНаУслуги.Загрузить(ТаблСтавок);
		ДокСтавки.Записать(РежимЗаписиДокумента.Запись);
		Попытка
		ДокСтавки.Записать(РежимЗаписиДокумента.Проведение)
	исключение
			Сообщить("ОШИБКА ПРИ ПРОВЕДЕНИИ "+ ДокСтавки)
		конецпопытки
		
	КонецЕсли;	
	
	
КонецПроцедуры

&НаСервере
Функция получитьДокСтавок(Услуга)
	Запрос = новый запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_УстановкаСтавокПоУслугам.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.бит_УстановкаСтавокПоУслугам КАК бит_УстановкаСтавокПоУслугам
	               |ГДЕ
	               |	бит_УстановкаСтавокПоУслугам.Услуга = &Услуга
	               |	И бит_УстановкаСтавокПоУслугам.Дата МЕЖДУ &Дата1 И КОНЕЦПЕРИОДА(&Дата1, ДЕНЬ)
	               |	И бит_УстановкаСтавокПоУслугам.Организация = &Организация";
	Запрос.УстановитьПараметр("Услуга",Услуга);
	Запрос.УстановитьПараметр("Дата1",Объект.Дата);
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если выборка.Следующий() тогда
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
	иначе
		ДокОбъект = Документы.бит_УстановкаСтавокПоУслугам.СоздатьДокумент();
		ДокОбъект.Дата = Объект.Дата;
		ДокОбъект.Услуга = Услуга;
		ДокОбъект.Организация = Объект.Организация;	
	КонецЕсли;	
	
	возврат ДокОбъект;
		
КонецФункции	

&НаСервере
Процедура ЗаполнитьСтрокиДокументаУстановкаУслугЛС(ДокОбъект,НачИндекс,ЧислоСтрокВДокументе=0,Подучасток,ТаблСтавок,ТаблТекУслуг = Неопределено);
	Если ложь тогда ДокОбъект = Документы.бит_УстановкаИзменениеУслугПоЛС.СоздатьДокумент()КонецЕсли; 
	Если  ложь тогда ТаблСтавок = Документы.бит_УстановкаСтавокПоУслугам.СоздатьДокумент().СтавкиНаУслуги КонецЕсли;
	Если ТипЗнч(МассивСтру)<>Тип("Массив") тогда 
		возврат
	КонецЕсли;	
	
	Поставщик = ДокОбъект.Услуга.Поставщики[0].Поставщик;
	СпособРасчетаПоУмолчанию = ДокОбъект.Услуга.СпособыРасчета[0].СпособРасчета;
	
	
	
	//Определим загружаемые элементы МассивСтру
	ВГраница = МассивСтру.ВГраница();
	Если ЧислоСтрокВДокументе =0 и НачИндекс<=ВГраница тогда
		ТекПодучасток = МассивСтру[НачИндекс].Подучасток;				
		Для МаксИндекс = НачИндекс+1 по ВГраница цикл
			Если МассивСтру[МаксИндекс].Подучасток<>ТекПодучасток тогда
				прервать;
			КонецЕсли;	
		КонецЦикла;	
		Если (МаксИндекс>ВГраница) или  (МассивСтру[МаксИндекс].Подучасток<>ТекПодучасток) тогда
			МаксИндекс = МаксИндекс-1;
		КонецЕсли;	              		
	иначе		
		МаксИндекс = мин(НачИндекс + ЧислоСтрокВДокументе-1,МассивСтру.ВГраница());			
	КонецЕсли;
	
	
	ЗначПропустить = ложь;
	Для Инд = НачИндекс по МаксИндекс цикл	  		
		Стру = МассивСтру[Инд]; 
		//ЛС = СсылкаЛС(Стру.LS);	
				
		Если Стру.Свойство("ПропуститьЭтотЭлемент",ЗначПропустить) и (ЗначПропустить=истина)  тогда
			продолжить
		КонецЕсли;	
		
		
		ЛС = Стру.ЛС;
		Услуга = Стру.Услуга;		
		ИмяРежима = сокрЛП(Стру.R_POTR);
		РежимПотребления  = РежимПотребления(ИмяРежима,Стру.TAR);
		ЧислоЕдПотребления = Стру.ED_POTR;
		КодСпособаРасчета = Стру.SPOSOB_R;
		
		Если КодСпособаРасчета = 1 или КодСпособаРасчета = 5 тогда
			СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади;
		ИначеЕсли КодСпособаРасчета = 2 или КодСпособаРасчета = 6 тогда
			СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади;
		ИначеЕсли КодСпособаРасчета = 3 тогда
			СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления
		ИначеЕсли КодСпособаРасчета = 4 тогда
			СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим
		иначе
			СпособРасчета = СпособРасчетаПоУмолчанию
		КонецЕсли;	
		
		
		Если Не ЗначениеЗаполнено(ЛС) тогда
			Сообщить("Не найден ЛС:" + сокрЛП(Стру.LS));
			Продолжить;
		КонецЕсли;
		
		СтрокаТекУслуги = ТаблТекУслуг.Найти(ЛС);
		Если СтрокаТекУслуги<> Неопределено тогда
			УслугаУжеНазначена = СтрокаТекУслуги.Поставщик = Поставщик и 
				 СтрокаТекУслуги.РежимПотребления = РежимПотребления и 
				 СтрокаТекУслуги.СпособРасчета = СпособРасчета;
				 
			//Соовтетствуют три параметра. 
			//Контроль числа единиц зависит от способа расчета
			Если УслугаУжеНазначена и 
					 (СтрокаТекУслуги.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления или
					  СтрокаТекУслуги.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет) тогда
				УслугаУжеНазначена = СтрокаТекУслуги.КоличествоЕдиницПотребления = ЧислоЕдПотребления; 	  
			КонецЕсли;		  
			
			Если УслугаУжеНазначена тогда
				продолжить;
			КонецЕсли;				
		КонецЕсли;
		
		НовСтрока = ДокОбъект.ЛицевыеСчета.Добавить();
		НовСтрока.Услуга = ДокОбъект.Услуга;		
		НовСтрока.ЛицевойСчет = ЛС;
		НовСтрока.Поставщик = Поставщик;
		НовСтрока.РежимПотребления = РежимПотребления;
		НовСтрока.КоличествоЕдиницПотребления = ЧислоЕдПотребления;
		НовСтрока.СпособРасчета = СпособРасчета;   
		
		Стру.Вставить("Поставщик",Поставщик);
		Стру.Вставить("РежимПотребления",РежимПотребления);
		Стру.Вставить("СпособРасчета",СпособРасчета);
		Стру.Вставить("ПлановаяСтавка",Стру.TAR);
		
	КонецЦикла;;	
	СписокЛС = ДокОбъект.ЛицевыеСчета.Выгрузить(,"ЛицевойСчет").ВыгрузитьКолонку("ЛицевойСчет");
    ДополнитьТаблицуСтавок(ТаблСтавок,Услуга,СписокЛС,НачИндекс,МаксИндекс);
	
	
	НачИндекс = МаксИндекс+1;

КонецПроцедуры

&НаСервере
Процедура ДополнитьТаблицуСтавок(ТаблСтавок,Услуга,СписокЛС,НачИндекс,МаксИндекс)
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("СписокЛС",СписокЛС);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК Ссылка,
		|	бит_ЛицевыеСчета.Квартира КАК Квартира
		|ПОМЕСТИТЬ ЛС
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Ссылка В(&СписокЛС)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЛС.Ссылка КАК ЛицевойСчет,
		|	ЛС.Квартира КАК Квартира,
		|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
		|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры
		|ИЗ
		|	ЛС КАК ЛС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(
		|				,
		|				Квартира В
		|					(ВЫБРАТЬ
		|						ЛС.Квартира КАК Квартира
		|					ИЗ
		|						ЛС КАК ЛС)) КАК бит_СведенияОКвартиреСрезПоследних
		|		ПО ЛС.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира";
	таблКэш = Запрос.Выполнить().Выгрузить();
	таблКэш.Индексы.Добавить("ЛицевойСчет");
	
	ЗначПропустить = Неопределено;
	СтрокаСтавки = неопределено;
	Для Инд = НачИндекс по МаксИндекс цикл
		Стру = МассивСтру[Инд];     		
		
		Если Стру.Свойство("ПропуститьЭтотЭлемент",ЗначПропустить) и (ЗначПропустить=истина)  тогда
			продолжить
		КонецЕсли;	
		
		Если Стру.РежимПотребления = Справочники.бит_РежимыПотребленияУслуг.НеНачислять тогда
			Стру.ПлановаяСтавка = 0;
	    КонецЕсли;
		
		
		СтрокаКвартиры= ТаблКэш.Найти(Стру.ЛС,"ЛицевойСчет");

		Если СтрокаКвартиры = Неопределено или Стру.ПлановаяСтавка = 0 тогда
			продолжить
		КонецЕсли;
		
		//проверим на дубли с последней строкой 
		Если СтрокаСтавки<>неопределено  и 
				 СтрокаСтавки.Поставщик = Стру.Поставщик и
				 СтрокаСтавки.РежимПотребления = Стру.РежимПотребления и 
				 СтрокаСтавки.ПлановаяСтавка = Стру.ПлановаяСтавка и 
				 СтрокаСтавки.ТипКвартиры = СтрокаКвартиры.ТипКвартиры и 
				 СтрокаСтавки.СтатусКвартиры = СтрокаКвартиры.СтатусКвартиры 
				 тогда
		    продолжить
		КонецЕсли;	
		
		СтрокаСтавки = ТаблСтавок.Добавить();
		ЗаполнитьЗначенияСвойств(СтрокаСтавки,Стру);
		ЗаполнитьЗначенияСвойств(СтрокаСтавки,СтрокаКвартиры);            
		СтрокаСтавки.Тариф = СтрокаСтавки.ПлановаяСтавка; 
		СтрокаСтавки.ОсновнаяСтавка = СтрокаСтавки.ПлановаяСтавка;
		СтрокаСтавки.СверхНормативнаяСтавка = СтрокаСтавки.ПлановаяСтавка;  				
	КонецЦикла;	
	
	ТаблСтавок.Сортировать("Поставщик,РежимПотребления,СпособРасчета,ТипКвартиры,СтатусКвартиры,ПлановаяСтавка УБЫВ");
	ЧислоСтрокСтавок = ТаблСтавок.Количество();
	Для СчетВниз = 1 По ЧислоСтрокСтавок-1 цикл
		ТекСтрока = ТаблСтавок[ЧислоСтрокСтавок-СчетВниз];
		ПредСтрока = ТаблСтавок[ЧислоСтрокСтавок-СчетВниз-1];
		ИзмеренияРавны = ТекСтрока.Поставщик = ПредСтрока.Поставщик и
				 ТекСтрока.РежимПотребления = ПредСтрока.РежимПотребления и 
				 ТекСтрока.ТипКвартиры = ПредСтрока.ТипКвартиры и 
				 ТекСтрока.СтатусКвартиры = ПредСтрока.СтатусКвартиры;
		Если ИзмеренияРавны тогда
			Если  ТекСтрока.ПлановаяСтавка <> ПредСтрока.ПлановаяСтавка тогда
				Текст = "РАЗНЫЕ ЗНАЧЕНИЯ СТАВОК по услуге "+ Услуга+ Символы.ПС +
						"        Режим потр.: " + ТекСтрока.РежимПотребления + "     СпособРасчета: " + ТекСтрока.СпособРасчета + Символы.ПС + 
				        "        ТипКвартиры: " + ТекСтрока.ТипКвартиры + "      СтатусКвартиры: " + ТекСтрока.СтатусКвартиры + Символы.ПС + 
						"		 Ставки  (оставлена большая) " + ТекСтрока.ПлановаяСтавка + " и "+ ПредСтрока.ПлановаяСтавка;
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);    				
			КонецЕсли;
			ТаблСтавок.Удалить(ТекСтрока);   
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	

&НаСервере
Процедура ОбновитьРежимыПотребления()
КонецПроцедуры	



&НаСервере
Процедура ДополнитьМассивСтруктурДляУслугНаЛС();
	ЗаполнитьКэшКвартирЛицевыхСчетов();

	СписокУслуг = новый Соответствие;
	Для каждого Стру из МассивСтру цикл
		ЛС = СсылкаЛС(Стру.LS);
		Услуга = УслугаЖКХ(Стру.YSLYGA);
		ИмяРежима = ?(Стру.TAR=0,"не начислять",сокрЛП(Стру.R_POTR));
		Режим = РежимПотребления(ИмяРежима,Стру.TAR);
		Поставщик = ПоставщикУслуги(Услуга);
		
		//дополняем Стру 
		Стру.Вставить("ЛС",ЛС);
		Стру.Вставить("Услуга",Услуга);
		Стру.Вставить("Режим",Режим);
		Стру.Вставить("Поставщик",Поставщик);
		Стру.Вставить("ПлановаяСтавка",Стру.TAR);
		//и формируем список режимов потребления
		Если СписокУслуг[Услуга]=неопределено тогда
			СписокУслуг.Вставить(Услуга,Новый массив);
		КонецЕсли;	
		
		МассивРежимов = СписокУслуг[Услуга];
		Если ложь тогда МассивРежимов = новый массив КонецЕсли;
		Если МассивРежимов.Найти(ИмяРежима) = Неопределено тогда
			МассивРежимов.Добавить(ИмяРежима);
		КонецЕсли;	 	
	КонецЦикла;	
	
	
	//Дополняем режимы услуги из массивов 
	Для каждого КЗ из СписокУслуг цикл
		Услуга = КЗ.Ключ;
		Если ложь тогда Услуга = Справочники.бит_УслугиЖКХ.ПустаяСсылка() КонецЕсли;		
		МассивРежимов = КЗ.Значение;
		
		
		Для Инд =0 по МассивРежимов.ВГраница() цикл			
			ИмяРежима = МассивРежимов[Инд];
			Если не ПустаяСтрока(ИмяРежима) тогда
				МассивРежимов[Инд] = РежимПотребления(ИмяРежима,1); //имя режима, если тариф =0 , уже земенено на "не начислять"
			иначе
				МассивРежимов[Инд] = неопределено;
			КонецЕсли;	
				
		КонецЦикла;	
		
		
		СпрОбъект = Услуга.ПолучитьОбъект();
		РежимыУслуги = Услуга.РежимыПотребленияУслуг.ВыгрузитьКолонку("РежимПотребленияУслуг");
		ЧислоРежимов = РежимыУслуги.Количество();
		Для каждого Режим из МассивРежимов цикл
			Если РежимыУслуги.Найти(Режим) = Неопределено и ЗначениеЗаполнено(Режим) тогда
				РежимыУслуги.Добавить(Режим);
				НовСтрока = СпрОбъект.РежимыПотребленияУслуг.Добавить();
				НовСтрока.РежимПотребленияУслуг = Режим;
			КонецЕсли;	
		КонецЦикла;	
		
