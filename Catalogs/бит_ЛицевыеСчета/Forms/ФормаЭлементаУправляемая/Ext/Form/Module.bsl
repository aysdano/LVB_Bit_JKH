&НаКлиенте
Процедура Группа6ПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Заголовок = "Зависимые ЛС" Тогда
		
		ОбновитьТаблицуЗависимыеЛС();

		ПрочитатьДанныеНабораЗаписейНаСервере();

	ИначеЕсли ТекущаяСтраница.Заголовок = "Замечания по ЛС" Тогда
		ОбновитьТаблицуЗамечания();
		
	ИначеЕсли ТекущаяСтраница.Заголовок = "Комнаты" Тогда
		ЗаполнитьТаблицуКомнат();
		
	ИначеЕсли ТекущаяСтраница.Заголовок = "Основной ЛС" Тогда
		
		ЗаполнитьТаблицуОсновнойЛС();
		ОбновитьДанныеКолонкиАдресДляОсновногоЛС();
		ОбновитьДанныеКолонкиОтветственныйДляОсновногоЛС();
		
	КонецЕсли;
	
