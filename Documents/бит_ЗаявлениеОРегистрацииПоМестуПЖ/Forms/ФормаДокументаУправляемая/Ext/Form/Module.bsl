			ШапкаОбласть.Параметры.КорпусВыб          = ШапкаОбласть.Параметры.КорпусРег;
			ШапкаОбласть.Параметры.КвартираВыб        = ШапкаОбласть.Параметры.КвартираРег;
			
	
		КонецЕсли;
		
		Если МакетНовогоОбразца И ЗначениеЗаполнено(ДанныеПечати.Пол) Тогда
			
			Если ДанныеПечати.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
