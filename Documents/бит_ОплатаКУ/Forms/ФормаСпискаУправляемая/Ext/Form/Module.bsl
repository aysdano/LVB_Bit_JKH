
#Область ПроцедурыОбработчикиСобытий

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФорм

&НаКлиенте
Процедура СписокПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если ПроверитьДоступностьОсновныхРолейНаСервере() Тогда
		
		Если НЕ РольДоступнаНаСервере() Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Документ Оплата КУ создается автоматически при закрытии кассовой смены.";
			Сообщение.Сообщить();
			
			Отказ = Истина;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// БИТ_ЖКХ 25.06.2015{{
&НаСервере
Функция РольДоступнаНаСервере()

	//АПК пункт 4 https://its.1c.ru/db/v8std/content/737/hdoc
	Возврат РольДоступна("бит_Кассир");
	
КонецФункции
// БИТ_ЖКХ 25.06.2015}}

#КонецОбласти

#Область ДействияКомандФорм

&НаКлиенте
Процедура НачислениеПениПоЛицевымСчетам(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Документ = НайтиДокументНачислениеПениПоЛицевымСчетамНаСервере(ТекДанные.Ссылка);
	
	Если Документ = ПредопределенноеЗначение("Документ.бит_НачислениеПениПоЛицевымСчетам.ПустаяСсылка") Тогда
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Организация",     ТекДанные.Организация);
		ПараметрыФормы.Вставить("Дата",            ТекДанные.Дата);
		ПараметрыФормы.Вставить("ДокОснование",    ТекДанные.Ссылка);
		ПараметрыФормы.Вставить("ЗакрытиеПериода", Ложь);
		
		ОткрытьФорму("Документ.бит_НачислениеПениПоЛицевымСчетам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаНачислениеПениПоЛицевымСчетам, Ключ", ПараметрыФормы, Неопределено), ЭтаФорма);
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Основание", ТекДанные.Ссылка);
		
		ОткрытьФорму("Документ.бит_НачислениеПениПоЛицевымСчетам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаНачислениеПениПоЛицевымСчетам, Ключ", ПараметрыФормы, Документ), ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоступлениеНаРасчетныйСчет(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДокументОплаты",          ТекДанные.Ссылка);
	ПараметрыФормы.Вставить("ИсточникОплаты",          ТекДанные.ИсточникОплаты);
	ПараметрыФормы.Вставить("Организация",             ТекДанные.Организация);
	// БИТ_ЖКХ 24.09.2015 11:03:02 Начало правки...
	ПараметрыФормы.Вставить("БанковскийСчет",          ЗначениеРеквизитаНаСервере(ТекДанные.Организация, "ОсновнойБанковскийСчет"));
	// БИТ_ЖКХ 24.09.2015 11:03:02 Конец правки.
	ПараметрыФормы.Вставить("СуммаДокумента",          ТекДанные.СуммаДокумента);
	ПараметрыФормы.Вставить("РазбиватьПоЛицевымСчетам", Ложь);
	
	ОткрытьФорму("Обработка.бит_ВводПКО.Форма.ФормаУправляемая", Новый Структура("ЗаполнитьИзДокументаПоступлениеНаРасчетныйСчет", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриходныйКассовыйОрдер(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;	
	
	ПараметрыФормы = Новый Структура;
	
	ТекущаяСтрока = Элементы.Список.ТекущаяСтрока;		
	
	ИсточникОплаты = ПолучитьИсточникОплатыНаСервере(ТекущаяСтрока);
	
	ПараметрыФормы.Вставить("ДокументОплаты",          Элементы.Список.ТекущаяСтрока);
	
	ПараметрыФормы.Вставить("ИсточникОплаты",          ИсточникОплаты);
	ПараметрыФормы.Вставить("Организация",             ТекДанные.Организация);
	// БИТ_ЖКХ 24.09.2015 11:03:02 Начало правки...
	ПараметрыФормы.Вставить("БанковскийСчет",          ЗначениеРеквизитаНаСервере(ТекДанные.Организация, "ОсновнойБанковскийСчет"));
	// БИТ_ЖКХ 24.09.2015 11:03:02 Конец правки.
	ПараметрыФормы.Вставить("СуммаДокумента",          ТекДанные.СуммаДокумента);
	ПараметрыФормы.Вставить("РазбиватьПоЛицевымСчетам", Ложь);
	
	ОткрытьФорму("Обработка.бит_ВводПКО.Форма.ФормаУправляемая", Новый Структура("ЗаполнитьИзДокументаПриходныйКассовыйОрдер", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОплатыПоПоставщикам(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	Документ = НайтиДокументРаспределениеОплатыПоПоставщикамНаСервере(ТекДанные.Ссылка);
	
	Если Документ = ПредопределенноеЗначение("Документ.бит_РаспределениеОплатыПоПоставщикам.ПустаяСсылка") Тогда
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Организация"      , ТекДанные.Организация);
		ПараметрыФормы.Вставить("Дата"             , ТекДанные.Дата);
		ПараметрыФормы.Вставить("ДокументОснование", ТекДанные.Ссылка);
		ПараметрыФормы.Вставить("ЗакрытиеПериода"  , Ложь);
		
		ОткрытьФорму("Документ.бит_РаспределениеОплатыПоПоставщикам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаОплатаКУ", ПараметрыФормы), ЭтаФорма);
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("ДокументОснование", ТекДанные.Ссылка);
		ПараметрыФормы.Вставить("Организация"      , ТекДанные.Организация);
		ПараметрыФормы.Вставить("Дата"             , ТекДанные.Дата);
		
		ОткрытьФорму("Документ.бит_РаспределениеОплатыПоПоставщикам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаОплатаКУ, Ключ", ПараметрыФормы, Документ), ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Функция ПроверитьДоступностьОсновныхРолейНаСервере()
	
	Возврат бит_ОбщегоНазначения.ПроверитьДоступностьОсновныхРолей();
	
КонецФункции

&НаСервере
Функция НайтиДокументНачислениеПениПоЛицевымСчетамНаСервере(Знач Ссылка)
	
	Документ = Документы.бит_НачислениеПениПоЛицевымСчетам.НайтиПоРеквизиту("ДокОснование", Ссылка);
	
	Возврат Документ;
	
КонецФункции

&НаСервере
Функция НайтиДокументРаспределениеОплатыПоПоставщикамНаСервере(Знач Ссылка)
	
	Документ = Документы.бит_РаспределениеОплатыПоПоставщикам.НайтиПоРеквизиту("ДокументОснование", Ссылка);
	
	Возврат Документ;
	
КонецФункции

&НаСервере
Функция ПолучитьИсточникОплатыНаСервере(ТекущаяСтрока)
	
	Возврат ТекущаяСтрока.ИсточникОплаты;	
	
КонецФункции

