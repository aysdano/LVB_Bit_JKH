&НаКлиенте
Процедура Загрузить(Команда)
	
	Индикатор = 0;
	Состояние("Загрузка данных в справочник '" + Справочник + "'...");
	
	Если НЕ ЗначениеЗаполнено(Справочник) Тогда
		ТекстСообщения = НСтр("ru = 'Необходимо выбрать справочник для заполнения и выполнить настройку.'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		Возврат;
	ИначеЕсли НЕ ЗначениеЗаполнено(ФайлЧтения) Тогда
		ТекстСообщения = НСтр("ru = 'Не выбран файл для загрузки данных в справочник.'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		Возврат;
	КонецЕсли; 
	
	Если ТаблицаЗагружаемыхРеквизитов.НайтиСтроки(Новый Структура("Пометка, РежимЗагрузки", Истина, Истина)).Количество() > 0 Тогда 
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗагрузитьЗавершение", ЭтотОбъект)
						, "Будет выполнена попытка загрузки данных в справочник """ + Элементы.Справочник.ВыделенныйТекст + """. Продолжить?"
						, РежимДиалогаВопрос.ДаНет); 
	Иначе
		ТекстСообщения = НСтр("ru = 'Необходимо выполнить настройку для загрузки данных.'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

