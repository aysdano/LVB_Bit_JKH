&НаСервере
Процедура КоррекцияГоргазНаСервере()
	// Вставить содержимое обработчика.
	
	//Загрузим исх.данные
	МассивСтру = ЗагрузитьДБФВМассивСтруктур();
	
	
	ТипСтрока10 = новый ОписаниеТипов("Строка",,,,новый КвалификаторыСтроки(10));
	ТипСтрока11 = новый ОписаниеТипов("Строка",,,,новый КвалификаторыСтроки(11));
	Табл = Новый ТаблицаЗначений;	
	Табл.Колонки.Добавить("LS",ТипСтрока11);
	//Табл.Колонки.Добавить("ИмяЛС10",ТипСтрока10);
	Табл.Колонки.Добавить("K_JIL",новый ОписаниеТипов("Число"));
	Табл.Колонки.Добавить("K_SOB",новый ОписаниеТипов("Число"));
	Для каждого Стру из МассивСтру цикл НовСтрока= Табл.Добавить(); ЗаполнитьЗначенияСвойств(НовСтрока,Стру) КонецЦикла;
		
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("ДокГоргаза",ЭтаФорма.ДокГоргаза);
	Запрос.УстановитьПараметр("РежимПоСчетчикам",Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию("Горгаз (по счетчикам)"));
	Запрос.УстановитьПараметр("РежимНеНачислять",Справочники.бит_РежимыПотребленияУслуг.НеНачислять);
	Запрос.УстановитьПараметр("Табл",Табл);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Табл.K_JIL КАК ЧИСЛО(10, 0)) КАК Жильцов,
		|	ВЫРАЗИТЬ(Табл.K_SOB КАК ЧИСЛО(10, 0)) КАК Собств,
		|	ВЫРАЗИТЬ(Табл.LS КАК СТРОКА(10)) КАК ИмяЛС10
		|ПОМЕСТИТЬ ТаблНов
		|ИЗ
		|	&Табл КАК Табл
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ИмяЛС10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	лб_ДанныеГорГазаТЧ.Ссылка КАК Ссылка,
		|	лб_ДанныеГорГазаТЧ.НомерСтроки КАК НомерСтроки,
		|	лб_ДанныеГорГазаТЧ.Здание КАК Здание,
		|	лб_ДанныеГорГазаТЧ.ЛицевойСчет КАК ЛицевойСчет,
		|	лб_ДанныеГорГазаТЧ.Тариф КАК Тариф,
		|	лб_ДанныеГорГазаТЧ.Норматив КАК Норматив,
		|	лб_ДанныеГорГазаТЧ.Сальдо КАК Сальдо,
		|	лб_ДанныеГорГазаТЧ.СальдоПени КАК СальдоПени,
		|	лб_ДанныеГорГазаТЧ.Пени КАК Пени,
		|	лб_ДанныеГорГазаТЧ.НаличиеСчетчика КАК НаличиеСчетчика,
		|	лб_ДанныеГорГазаТЧ.НомерСчетчика КАК НомерСчетчика,
		|	лб_ДанныеГорГазаТЧ.ДатаПоверки КАК ДатаПоверки,
		|	лб_ДанныеГорГазаТЧ.ТекПоказание КАК ТекПоказание,
		|	лб_ДанныеГорГазаТЧ.Режим КАК Режим,
		|	ВЫБОР
		|		КОГДА ЕСТЬNULL(ТаблНов.ИмяЛС10, """") = """"
		|			ТОГДА лб_ДанныеГорГазаТЧ.КоличествоЕдиницПотребления
		|		КОГДА лб_ДанныеГорГазаТЧ.Режим В (&РежимПоСчетчикам, &РежимНеНачислять)
		|			ТОГДА 0
		|		КОГДА ТаблНов.Жильцов > 0
		|			ТОГДА ТаблНов.Жильцов
		|		ИНАЧЕ ТаблНов.Собств
		|	КОНЕЦ КАК КоличествоЕдиницПотребления
		|ИЗ
		|	Документ.лб_ДанныеГорГаза.ТЧ КАК лб_ДанныеГорГазаТЧ
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблНов КАК ТаблНов
		|		ПО (ПОДСТРОКА(лб_ДанныеГорГазаТЧ.ЛицевойСчет.Наименование, 1, 10) = ПОДСТРОКА(ТаблНов.ИмяЛС10, 1, 10))
		|ГДЕ
		|	лб_ДанныеГорГазаТЧ.Ссылка = &ДокГоргаза";
	ТаблГГ = Запрос.Выполнить().Выгрузить();
	
	
	Попытка
		ДокОбъект = ЭтаФорма.ДокГоргаза.ПолучитьОбъект();
		ДокОбъект.ТЧ.Загрузить(ТаблГГ);
		ДокОбъект.Записать();
	исключение
	КонецПопытки;
	
КонецПроцедуры

