Функция ПолучитьПустуюТаблицуДанныхПоЛС(ЛицевойСчет)		
			
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("ЛицевойСчет");
	Таблица.Колонки.Добавить("ТарифХВ");
	Таблица.Колонки.Добавить("ТарифГВ");
	Таблица.Колонки.Добавить("ТарифВО");
