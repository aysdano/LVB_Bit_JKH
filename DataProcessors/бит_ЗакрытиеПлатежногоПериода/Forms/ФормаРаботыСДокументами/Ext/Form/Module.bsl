&НаКлиенте
Процедура ДеревоДокументовПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	бит_ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(ТаблицаДокументовРеализации,
	"ДокументОснование",
	ТекущаяСтрока.Документ,
	Истина,
	ВидСравненияКомпоновкиДанных.Равно);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаДокументовРеализацииВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ТаблицаДокументовРеализации.ТекущиеДанные;
	
	Если Поле = Элементы.ТаблицаДокументовРеализацииДокументРеализации Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
			Форма = ТекущаяСтрока.ДокументРеализации.ПолучитьФорму();
			Форма.Открыть();
			
		#КонецЕсли
	ИначеЕсли Поле = Элементы.ТаблицаДокументовРеализацииСчетФактура Тогда
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
			Форма = ТекущаяСтрока.СчетФактура.ПолучитьФорму();
			Форма.Открыть();
			
		#КонецЕсли
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти