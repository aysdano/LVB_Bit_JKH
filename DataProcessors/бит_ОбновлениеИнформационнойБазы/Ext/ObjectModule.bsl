Процедура ЗаполнитьТипЛСГИСЖКХ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И НЕ бит_ЛицевыеСчета.Архивный
	|	И бит_ЛицевыеСчета.ТипЛицевогоСчетаГИСЖКХ <> ЗНАЧЕНИЕ(Перечисление.бит_ТипЛицевогоСчетаГИСЖКХ.ПустаяСсылка)";
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И НЕ бит_ЛицевыеСчета.Архивный
	|	И бит_ЛицевыеСчета.ТипЛицевогоСчетаГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипЛицевогоСчетаГИСЖКХ.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Попытка
			Об = Выборка.Ссылка.ПолучитьОбъект();
			Об.ТипЛицевогоСчетаГИСЖКХ = Перечисления.бит_ТипЛицевогоСчетаГИСЖКХ.ЛСУО;
			Об.Записать();
		Исключение
			Продолжить;
		КонецПопытки;
		
	КонецЦикла; 
	
КонецПроцедуры
