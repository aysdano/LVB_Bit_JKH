&НаСервере
Функция ЕстьПени(МассивНачислений)
	
	Если Не МассивНачислений.Найти(Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000001")) = Неопределено Тогда
		Возврат Истина;
	ИначеЕсли Не МассивНачислений.Найти(Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000003")) = Неопределено Тогда	
		Возврат Истина;
	ИначеЕсли Не МассивНачислений.Найти(Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000004")) = Неопределено Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
