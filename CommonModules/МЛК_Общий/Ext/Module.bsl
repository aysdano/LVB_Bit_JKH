Функция СоздатьЗапросКороткойСсылки(ИД,Настройки)
	ЕстьОтвет = Истина;
	
	АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
	АдресРесурса = "/api/v4/objects/"+СТрока(ИД)+"?ApplicationId="+Настройки.НомерПриложения;
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Настройки.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		МЛК_Общий.ЗаписатьДанныеВЖурнал("Запрос коротких ссылок","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		ЕстьОтвет = Ложь;
	КонецПопытки;
	
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
				ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
				ЧтениеJSON.Закрыть();
				
				
				Ссылка = ЗагруженныеДанные["LoginLink"];
				Код1с  = ЗагруженныеДанные["Код1С"];
				ЛС = Справочники.бит_ЛицевыеСчета.НайтиПоКоду(Код1С);
				Если ЛС <> Справочники.бит_ЛицевыеСчета.ПустаяСсылка() Тогда
					МенеджерЗаписи = РегистрыСведений.МЛК_АдресаЛичныхКабинетов.СоздатьНаборЗаписей();
					МенеджерЗаписи.Отбор.ЛицевойСчет.Установить(Справочники.бит_ЛицевыеСчета.НайтиПоКоду(Код1С));
					МенеджерЗаписи.Прочитать();
					
					Если МенеджерЗаписи.Выбран() Тогда
						Если МенеджерЗаписи.Количество()<>0 Тогда
							Если МенеджерЗаписи[0].СсылкаНаКабинет <> Ссылка Тогда
								МенеджерЗаписи[0].СсылкаНаКабинет = Ссылка;
								МенеджерЗаписи[0].ИДОбъекта = ИД;
							КонецЕсли;
						Иначе
							НоваяЗапись = МенеджерЗаписи.Добавить();
							НоваяЗапись.ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоКоду(Код1С);
							НоваяЗапись.СсылкаНаКабинет = Ссылка;
							НоваяЗапись.ИДОбъекта = ИД;
							
						КонецЕсли;
					Иначе
						МенеджерЗаписи.СсылкаНаКабинет = Ссылка;
					КонецЕсли;
					МенеджерЗаписи.Записать();
				КонецЕсли;
			Иначе
				
			КонецЕсли;                                      
		КонецЕсли;
	КонецЕсли;
