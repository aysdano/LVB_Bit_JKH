//HD+
// Убирает слово «Улица»/«улица» из строки адреса для печати (если присутствует).
// Пример: «Солнечная 2-я Улица» → «Солнечная 2-я».
//
Функция УбратьСловоУлицаИзСтрокиАдресаДляПечати(Знач СтрокаАдреса)
	
	Результат = СокрЛП(Строка(СтрокаАдреса));
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, " Улица ", " ");
	Результат = СтрЗаменить(Результат, " улица ", " ");
	Результат = СтрЗаменить(Результат, " Улица", "");
	Результат = СтрЗаменить(Результат, " улица", "");
	Результат = СтрЗаменить(Результат, "Улица ", "");
	Результат = СтрЗаменить(Результат, "улица ", "");
	
	Если ВРег(СокрЛП(Результат)) = "УЛИЦА" Тогда
		Результат = "";
	КонецЕсли;
	
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	
	Возврат СокрЛП(Результат);
	
КонецФункции //HD-

//HD+
// Получает улицу МКД для подстановки в печатные формы Word (параметр МКД_Улица).
