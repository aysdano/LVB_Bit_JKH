				 стр.ВсегоНачислено = "";  
				 стр.ПерерасчетыВсего = "";  
				 стр.ЛьготыСубсидии = "";  
				 стр.ПорядокРасчетов = "";  
				 стр.ИтогоКОплате = "";  
				 стр.ПениИтого = "";  
				 	  
			  КонецЦикла;	
			 
		  конецесли;
	  конецесли;
	конецесли; 
	
	Возврат СоответствиеДанныхМакета;
	
КонецФункции

// Формирует и возвращает таблицу значений по СКД и настройкам
