//HD+
// Действующие доверенности физлица: сначала строки с Действует, иначе все с заполненным Представление в сроке дат.
//
&НаСервереБезКонтекста
Функция ПолучитьПредставленияДоверенностейПредставителяУКНаСервере(Знач ФизическоеЛицо, Знач ДатаСреза)
	
	МассивПредставлений = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ФизическоеЛицо)
		ИЛИ ТипЗнч(ФизическоеЛицо) <> Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Возврат МассивПредставлений;
	КонецЕсли;
	
	Если Метаданные.Справочники.ФизическиеЛица.ТабличныеЧасти.Найти("бит_Доверенности") = Неопределено Тогда
		Возврат МассивПредставлений;
	КонецЕсли;
	
	Если ТипЗнч(ДатаСреза) <> Тип("Дата") ИЛИ НЕ ЗначениеЗаполнено(ДатаСреза) Тогда
		ДатаСреза = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ФизическиеЛицабит_Доверенности.Представление КАК ПредставлениеДоверенности,
	|	ФизическиеЛицабит_Доверенности.Действует КАК Действует,
	|	ФизическиеЛицабит_Доверенности.ДатаС КАК ДатаС,
	|	ФизическиеЛицабит_Доверенности.ДатаДо КАК ДатаДо
	|ИЗ
	|	Справочник.ФизическиеЛица.бит_Доверенности КАК ФизическиеЛицабит_Доверенности
	|ГДЕ
	|	ФизическиеЛицабит_Доверенности.Ссылка = &ФизическоеЛицо";
	Запрос.УстановитьПараметр("ФизическоеЛицо", ФизическоеЛицо);
	
	МассивВсех = Новый Массив;
	МассивДействующих = Новый Массив;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		ПредставлениеДоверенности = НормализоватьТекстОснованияПредставителяУК(Выборка.ПредставлениеДоверенности);
		Если НЕ ЗначениеЗаполнено(ПредставлениеДоверенности) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Выборка.ДатаС) = Тип("Дата")
			И ЗначениеЗаполнено(Выборка.ДатаС)
			И Выборка.ДатаС > ДатаСреза Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(Выборка.ДатаДо) = Тип("Дата")
			И ЗначениеЗаполнено(Выборка.ДатаДо)
			И Выборка.ДатаДо < НачалоДня(ДатаСреза) Тогда
			Продолжить;
		КонецЕсли;
		
		МассивВсех.Добавить(ПредставлениеДоверенности);
		Если ТипЗнч(Выборка.Действует) = Тип("Булево") И Выборка.Действует Тогда
			МассивДействующих.Добавить(ПредставлениеДоверенности);
		КонецЕсли;
		
	КонецЦикла;
	
	Если МассивДействующих.Количество() > 0 Тогда
		Возврат МассивДействующих;
	КонецЕсли;
	
	Возврат МассивВсех;
	
КонецФункции //HD-

