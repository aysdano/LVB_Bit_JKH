#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.Услуги = "Все";
	
	Объект.ЛицевыеСчета = "Все";
	
	Объект.ВыводИнформации = "Без разбивки по услугам";
	Объект.ВводИнформации  = "Без разбивки по услугам";
	Объект.Вручную         = Ложь;
	
	Если НЕ ЗначениеЗаполнено(сг_ВспомогательныйСимвол) Тогда
		
		сг_ВспомогательныйСимвол = """";
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(сг_СимволРазделения) Тогда
		
		сг_СимволРазделения = ";";
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(сг_СимволПослеКодаДополнения) Тогда
		
		сг_СимволПослеКодаДополнения = ":";
		
	КонецЕсли; 
	
	сг_ИмяЛСВФайле = Элементы.сг_ВыгружатьЛС.СписокВыбора[0].Значение;
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	УправлениеЭлементамиФормы();
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	Массив.Добавить(Тип("Число"));
	Массив.Добавить(Тип("Дата"));
	
	КЧ = Новый КвалификаторыЧисла(15,2);
	КС = Новый КвалификаторыСтроки(100);
	КД = Новый КвалификаторыДаты();
	
	Элементы.НастройкаПолейСтрокиРеестраСальдоТип.ДоступныеТипы         = Новый ОписаниеТипов(Массив, КЧ, КС,КД);
	Элементы.НастройкаПолейСтрокиРеестраСальдоТип.РазрешитьСоставнойТип = Ложь;
	
	Элементы.УсловиеОтбора.СписокВыбора.Добавить(ВидСравнения.ВСписке);
	Элементы.УсловиеОтбора.СписокВыбора.Добавить(ВидСравнения.НеВСписке);
	
	УсловиеОтбора = ВидСравнения.ВСписке;
	
	Элементы.УсловиеОтбораУслуг.СписокВыбора.Добавить(ВидСравнения.ВСписке);
	Элементы.УсловиеОтбораУслуг.СписокВыбора.Добавить(ВидСравнения.НеВСписке);
	
