#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область СлужебныйПрограммныйИнтерфейс

Процедура ЗаполнитьПодъезды() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_Подъезды.Ссылка
	|ИЗ
	|	Справочник.бит_Подъезды КАК бит_Подъезды
	|ГДЕ
	|	НЕ бит_Подъезды.ПометкаУдаления";
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Возврат;	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_Квартиры.Владелец КАК Здание,
	|	бит_Квартиры.НомерПодъезда КАК НомерПодъезда,
	|	бит_Квартиры.Ссылка КАК Квартира,
	|	МАКСИМУМ(бит_Квартиры.Этаж) КАК Этаж
	|ИЗ
	|	Справочник.бит_Квартиры КАК бит_Квартиры
	|ГДЕ
	|	бит_Квартиры.НомерПодъезда > 0
	|	И НЕ бит_Квартиры.ПометкаУдаления
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_Квартиры.Владелец,
	|	бит_Квартиры.НомерПодъезда,
	|	бит_Квартиры.Ссылка
	|ИТОГИ ПО
	|	Здание,
	|	НомерПодъезда";
	
	// Обход зданий.
	ВыборкаЗданий = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЗданий.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаЗданий.Здание) Тогда
			Продолжить;
		КонецЕсли;
		
		// Обход подъездов.
		ВыборкаПодъезды = ВыборкаЗданий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаПодъезды.Следующий() Цикл
				НовыйПодъезд = Справочники.бит_Подъезды.СоздатьЭлемент();
				НовыйПодъезд.Владелец		  = ВыборкаЗданий.Здание;
				НовыйПодъезд.Наименование	  = ВыборкаПодъезды.НомерПодъезда;
				НовыйПодъезд.КоличествоЭтажей = ВыборкаПодъезды.Этаж;
				Попытка
					НовыйПодъезд.Записать();
				Исключение
					Продолжить;
				КонецПопытки;
				
				// Обход квартир (заполнение ссылок на подъезд).
				ВыборкаКвартиры = ВыборкаПодъезды.Выбрать();
				Пока ВыборкаКвартиры.Следующий() Цикл
					
					Квартира = ВыборкаКвартиры.Квартира.ПолучитьОбъект();
					Квартира.Подъезд = НовыйПодъезд.Ссылка;
					
					Попытка
						Квартира.Записать();
					Исключение
						Продолжить;
					КонецПопытки;
				КонецЦикла;
				
		КонецЦикла; 
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли