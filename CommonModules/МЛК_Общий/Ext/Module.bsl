#КонецОбласти

#Область Загрузка_Реестра_Оплат_В_Регистр
Процедура МЛК_ИмпортОплат() Экспорт
	
	Если Не Константы.МЛК_ИспользоватьИнтеграциюСМобильнымиЛичнымиКабинетами.Получить() Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЭтоКопияБазы() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	СинхронизацияОплат = ПодгрузитьОплаты();	
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл 
		СинхронизироватьПлатежки(Настройки);
	КонецЦикла;
	
КонецПроцедуры
Функция ПодгрузитьОплаты()
	Если Не ПроверитьЕстьЛиИнтернетСоединение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл
		Если Настройки.НеИспользоватьИнтеграцию Тогда Продолжить; КонецЕсли;
		Возврат ПодгрузитьОплатыОнлайн(Настройки);
	КонецЦикла;	
КонецФункции	
Функция ПодгрузитьОплатыОнлайн(Настройки)
	//Журнал
	ЖурналЗапросБезКодировки   = "";
	ЖурналСтрокаОписанияОшибки = "";
	ЖурналВремяНачало          = ТекущаяДатаСеанса();
	//Журнал
	
	СтатусЗавершено=Настройки.СтатусЗакрыто;
	СтатусНовое=Настройки.СтатусОтправленоВУК;
	СтатусНовое = СтрЗаменить(СтатусНовое," ","");
	СтатусНовое = СтрЗаменить(СтатусНовое,Символы.НПП,"");
	
	Успешных=0;Всего=0;
	
	
	АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
	АдресРесурса = "/api/v4/events?ApplicationId="+Строка(СокрЛП(Настройки.НомерПриложения))+"&query=";
	
	// Журнал
	ЖурналЗапросБезКодировки = Строка(АдресСервисаСтр)+Строка(АдресРесурса);
	
	СтрокаПараметров = 
	"["
	+"{"
	+"""field"""                +":"+ """ActionName"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+"""Оплата Онлайн"""+","
	+"""andor"""                +":"+"""and"""
	+"}"+","
	+"{"
	+"""field"""                +":"+ """value_ID пакета платежа"""+","
	+"""operation"""            +":"+ """!="""+","
	+"""value"""                +":"+""""""+","
	+"""andor"""                +":"+"""and"""
	+"}"+","
	+"{"
	+"""field"""                +":"+ """StatusId"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+""""+Строка(СтатусНовое)+""""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+"]";	
	
	ЖурналЗапросБезКодировки = ЖурналЗапросБезКодировки + Строка(СтрокаПараметров);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Настройки.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
	
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		МЛК_Общий.ЗаписатьДанныеВЖурнал("Загрузка оплат онлайн из МЛК",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		Возврат Ложь;
	КонецПопытки;
	
	
	
	Если Ответ.КодСостояния = 200 Тогда
		СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если Не ПустаяСтрока(СтрокаОтвет) Тогда
			РезультатПроверки = СтрокаОтвет;
			Если СокрЛП(РезультатПроверки)="false" Тогда
				МЛК_Общий.ЗаписатьДанныеВЖурнал("Загрузка оплат онлайн из МЛК",Ответ.КодСостояния,ЖурналЗапросБезКодировки,Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8),ОписаниеОшибки(),ТекущаяДатаСеанса());	
				Возврат Ложь;
			Иначе
				
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
				ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
				ЧтениеJSON.Закрыть();
				
				
				
				ТЗ = РаспарситьВТаблицуОплаты(ЗагруженныеДанные);
				
				ЗагрузитьТаблицуВРегистр(ТЗ,Настройки);
				
			КонецЕсли;
		КонецЕсли;
	Иначе
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		МЛК_Общий.ЗаписатьДанныеВЖурнал("Загрузка оплат онлайн из МЛК",Ответ.КодСостояния,ЖурналЗапросБезКодировки,Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8),ОписаниеОшибки(),ТекущаяДатаСеанса());	
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции
Функция РаспарситьВТаблицуОплаты(Данные)	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Пакет");
	ТЗ.Колонки.Добавить("Код1С");
	ТЗ.Колонки.Добавить("СуммаОплаты");
	ТЗ.Колонки.Добавить("Описание");
	
	ТЗ.Колонки.Добавить("Дата");
	ТЗ.Колонки.Добавить("Статус");
	ТЗ.Колонки.Добавить("ИД_События");
	Для Каждого стр из Данные Цикл
		
		Нов = ТЗ.Добавить();
		Нов.Пакет            = Стр["value_ID пакета платежа"];
		Нов.Код1С            = Стр["object_Код1С"];
		Нов.СуммаОплаты      = Стр["value_Amount"];
		Нов.Описание         = Стр["value_Description"];
		Нов.Статус           = СтрЗаменить(Стр["StatusId"],Символы.НПП,""); 
		Нов.ИД_События       = СтрЗаменить(Стр["id"],Символы.НПП,"");       //ИД события по которому будем менять статус
		
		СтрДата              = Стр["CreateDate"]; //"CreateDate"  UpdateDate
		Нов.Дата             = Дата(Лев(СтрДата,4),Сред(СтрДата,6,2),Сред(СтрДата,9,2));		
	КонецЦикла;	
	
	Возврат ТЗ;
	
	
	
КонецФункции
Процедура ЗагрузитьТаблицуВРегистр(ТЗ,Настройки)
	
	Для Каждого  Стр Из ТЗ Цикл
		
		Если ПроверитьСобытие(Стр.ИД_События) Тогда Продолжить; КонецЕсли;
		СсылкаЛС =  Справочники.бит_ЛицевыеСчета.НайтиПоКоду(Стр.Код1с);
		Если ССылкаЛС = Справочники.бит_ЛицевыеСчета.ПустаяСсылка() Тогда Продолжить; КонецЕсли;
		НоваяЗапись = РегистрыСведений.МЛК_РеестрОплат.СоздатьМенеджерЗаписи();
		НоваяЗапись.ДатаЗагрузки         = ТекущаяДата();
		НоваяЗапись.ЛицевойСчет          = СсылкаЛС;
		НоваяЗапись.Пакет                = Стр.Пакет;
		НоваяЗапись.Сумма                = Стр.СуммаОплаты;
		НоваяЗапись.Описание             = Стр.Описание;
		НоваяЗапись.ИД_События           = Стр.ИД_События;
		НоваяЗапись.Дата                 = Стр.Дата;
		НоваяЗапись.Записать();
		
	КонецЦикла;
	
	//Теперь создадим документ оплаты КУ
	
	СоздатьДокументыОплатыКУ(Настройки);
КонецПроцедуры
Функция ПроверитьСобытие(ИД_События)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МЛК_РеестрОплат.ИД_События КАК ИД_События
	|ИЗ
	|	РегистрСведений.МЛК_РеестрОплат КАК МЛК_РеестрОплат
	|ГДЕ
	|	МЛК_РеестрОплат.ИД_События = &ИД_События";
	Запрос.УстановитьПараметр("ИД_События",ИД_События);
	Если Запрос.Выполнить().Пустой() Тогда
		Возврат Ложь;
	Иначе
		Возврат Истина;
	КонецЕсли;
	
КонецФункции
Процедура СоздатьДокументыОплатыКУ(Настройки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	|	МЛК_РеестрОплат.ЛицевойСчет КАК ЛицевойСчет,
	|	МЛК_РеестрОплат.Пакет КАК Пакет,
	|	МЛК_РеестрОплат.Дата КАК Дата,
	|	МЛК_РеестрОплат.ДатаЗагрузки КАК ДатаЗагрузки,
	|	МЛК_РеестрОплат.ИД_События КАК ИД_События,
	|	МЛК_РеестрОплат.Сумма КАК Сумма,
	|	МЛК_РеестрОплат.Описание КАК Описание,
	|	МЛК_РеестрОплат.Платежка КАК Платежка,
	|	МЛК_РеестрОплат.ДокОплатыБит КАК ДокОплатыБит
	|ИЗ
	|	РегистрСведений.МЛК_РеестрОплат КАК МЛК_РеестрОплат
	|ГДЕ
	|	МЛК_РеестрОплат.Пакет <> """"
	|	И МЛК_РеестрОплат.ДокОплатыБит = &ДокОплатыБит" ;
	
	Запрос.УстановитьПараметр("ДокОплатыБит",Документы.бит_ОплатаКУ.ПустаяСсылка());
	КопияТЗ = Запрос.Выполнить().Выгрузить();
	КопияТЗ.Свернуть("Пакет,Дата","Сумма");
	
	Для Каждого Стр Из КопияТЗ Цикл
		
		Документ = Документы.бит_ОплатаКУ.СоздатьДокумент();
		
		Дата = Стр.дата; //Дата пакета
		
		Если НЕ ЗначениеЗаполнено(Дата) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Документ.Дата           = Дата;
		Документ.УстановитьВремя(РежимАвтоВремя.ТекущееИлиПоследним);
		Документ.Организация    = Настройки.Организация;
		Документ.Ответственный  = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
		
		НайденнаяСсылка = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН","7203468252");
		Документ.ИсточникОплаты = НайденнаяСсылка;
		
		//Документ.ВводВРучную    = Объект.Вручную;
		//Документ.НомерРеестра   = Объект.НомерРеестра;
		Документ.Комментарий    = Строка(Стр.Пакет)+" "+"""МЛК ОПЛАТЫ"".";
		
		ИтогПоДокументу      = Стр.Сумма;
		СуммаИтогПоДокументу = 0;
		
		
		МассивЛС = Новый Массив;
		
		ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата,Настройки);
		
		ТЗОплатыПакета = ПолучитьТаблицуПакета(Стр.Пакет);
		
		Для каждого СтрокаВторогоУровня Из ТЗОплатыПакета Цикл
			
			Если ЗначениеЗаполнено(СтрокаВторогоУровня.Дата) И НЕ СтрокаВторогоУровня.Сумма = 0 Тогда
				
				НоваяСтрокаЛС = Документ.СписокЛС.Добавить();
				НоваяСтрокаЛС.ЛицевойСчет     = СтрокаВторогоУровня.ЛицевойСчет;
				НоваяСтрокаЛС.ШаблонИзвещений = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
				
				ИтогПоЛС      = СтрокаВторогоУровня.Сумма;
				СуммаИтогПоЛС = 0;
				
				
				//Документ.ВводВРучную    = Объект.Вручную;
				НоваяСтрокаЛС.Сумма = СтрокаВторогоУровня.Сумма;
				
				тмпСписокЛС = Новый Массив;
				тмпСписокЛС.Добавить(СтрокаВторогоУровня.ЛицевойСчет);
				//НоваяСтрокаЛС.ВыгрузитьКолонку("ЛицевойСчет");
				
				Колонки  =  Документ.СписокЛС.ВыгрузитьКолонки();
				
				УдалитКолоку = Колонки.Найти("Услуга");
				
				//Колонки.Удалить(УдалитКолоку);
				
				бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(Документ.СписокЛС, Колонки, тмпСписокЛС, Документ.Организация , Документ.Дата, Документ.ИсточникОплаты, Истина);
				
				
				
				ТаблицаЛС          = Документ.СписокЛС.Выгрузить();
				КоммунальныеУслуги = Документ.СписокУслуг.ВыгрузитьКолонки();
				
				бит_ОбщегоНазначения.РаспределениеСуммПоОплате(Дата,
				Настройки.Организация,
				ТаблицаЛС,
				КоммунальныеУслуги,
				ПараметрыЖКХ.ЛьготаПерсонифицированная,
				ПараметрыЖКХ.РасчетСУчетомДолейВладения,
				ПараметрыЖКХ.УменьшениеНормыЛьготыВПределахФакта,
				ПараметрыЖКХ.НачислениеСУчетомДнейПроживания,
				ПараметрыЖКХ.РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
				ПараметрыЖКХ.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
				ПараметрыЖКХ.НачислятьПениСУчетомПереплаты); 
				
				Документ.СписокУслуг.Очистить();
				Документ.СписокУслуг.Загрузить(КоммунальныеУслуги);
				
				СуммаИтогПоДокументу = СуммаИтогПоДокументу + СтрокаВторогоУровня.Сумма;
				
			КонецЕсли; 
		КонецЦикла; 
		
		Документ.СуммаДокумента = СуммаИтогПоДокументу;
		
		Документ.ЗапролнитьСчета();
		
		Если бит_ОбщегоНазначения.ЗаписатьПровестиДокумент(Документ, РежимЗаписиДокумента.Запись,,"Ошибки") Тогда
			
			// Тут создадим оплату по карте
			МенеджерЗаписи = РегистрыСведений.МЛК_РеестрОплат.СоздатьНаборЗаписей();
			МенеджерЗаписи.Отбор.пакет.Установить(Стр.Пакет);
			МенеджерЗаписи.Прочитать();
			
			Для каждого СтрНабор Из  МенеджерЗаписи Цикл
				// Изменить существующую запись
				СтрНабор.ДокОплатыБит = Документ.Ссылка;
			КонецЦикла;
			
			МенеджерЗаписи.Записать();			
			
			СоздатьОперацииПоПлатежнойКарте(Документ.Ссылка);
			
		КонецЕсли;
		
	КонецЦикла;
КонецПроцедуры
Функция ОбновитьПараметрыЖКХ(Дата,Настройки)
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("РасчетСУчетомДолейВладения"                           , Ложь);
	ПараметрыЖКХ.Вставить("УменьшениеНормыЛьготыВПределахФакта"                  , Ложь);
	ПараметрыЖКХ.Вставить("ЛьготаПерсонифицированная"                            , Ложь);
	ПараметрыЖКХ.Вставить("НачислениеСУчетомДнейПроживания"                      , Ложь);
	ПараметрыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	ПараметрыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	
	ПараметрыЖКХ.Вставить("НачислятьПениСУчетомПереплаты", Ложь); 
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Дата), Настройки.Организация, ПараметрыЖКХ);
	
	Возврат ПараметрыЖКХ;
	
КонецФункции
Функция ПолучитьТаблицуПакета(Пакет)
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	|	МЛК_РеестрОплат.ЛицевойСчет КАК ЛицевойСчет,
	|	МЛК_РеестрОплат.Пакет КАК Пакет,
	|	МЛК_РеестрОплат.Дата КАК Дата,
	|	МЛК_РеестрОплат.ДатаЗагрузки КАК ДатаЗагрузки,
	|	МЛК_РеестрОплат.ИД_События КАК ИД_События,
	|	МЛК_РеестрОплат.Сумма КАК Сумма,
	|	МЛК_РеестрОплат.Описание КАК Описание,
	|	МЛК_РеестрОплат.Платежка КАК Платежка,
	|	МЛК_РеестрОплат.ДокОплатыБит КАК ДокОплатыБит
	|ИЗ
	|	РегистрСведений.МЛК_РеестрОплат КАК МЛК_РеестрОплат
	|ГДЕ
	|	МЛК_РеестрОплат.Пакет <> """"
	|	И МЛК_РеестрОплат.Пакет = &Пакет" ;
	Запрос.УстановитьПараметр("Пакет",Пакет);
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
КонецФункции	
Процедура СоздатьОперацииПоПлатежнойКарте(ОплатаКу)
	// Тут создадим оплату по карте
	МенеджерЗаписи = РегистрыСведений.МЛК_РеестрОплат.СоздатьНаборЗаписей();
	МенеджерЗаписи.Отбор.ДокОплатыБит.Установить(ОплатаКу);
	МенеджерЗаписи.Прочитать();
	
	Для каждого СтрНабор Из  МенеджерЗаписи Цикл
		// Изменить существующую запись
		// СтрНабор.ДокОплатыБит = Документ.Ссылка;
		
		ПлатежныйДокумент = Документы.ОплатаПлатежнойКартой.СоздатьДокумент(); 
		ПлатежныйДокумент.Дата              = ОплатаКУ.Дата;
		ПлатежныйДокумент.ДокументОснование = ОплатаКУ.Ссылка;
		ТранзитныйСчетОплаты = ПолучитьСчет(ОплатаКу.Организация);
		ПрименениеУСН = УчетнаяПолитика.ПрименяетсяУСН(ОплатаКу.Организация, ОплатаКу.Дата);
		ТаблицаУСН = ?(ПрименениеУСН, ПолучитьТаблицуУСН(ОплатаКу),Неопределено);
		СуммаПринимаемых = ПолучитьСуммуПолучаемых(ТаблицаУСН, СтрНабор.ЛицевойСчет);
		БанковскийСчет = "";
		ИсточникОплаты = "";
		ДокументЗаписан = Ложь;
		ЗаполнитьПКО(ПлатежныйДокумент, СтрНабор, ОплатаКу, Истина, ДокументЗаписан, ТранзитныйСчетОплаты, ПрименениеУСН, СуммаПринимаемых
		,БанковскийСчет, ИсточникОплаты,СтрНабор.ИД_События);
		
		
	КонецЦикла;
КонецПроцедуры
Функция ПолучитьСчет(Знач Организация)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_НастройкаПараметровЖКХСрезПоследних.Организация,
	|	бит_НастройкаПараметровЖКХСрезПоследних.ТранзитныйСчетОплаты,
	|	бит_НастройкаПараметровЖКХСрезПоследних.СчетАбонента
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата"        , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация" , Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.СчетАбонента) Тогда
			
			СубконтоКонтрагент = Выборка.СчетАбонента.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты, "ВидСубконто");
			
			Если СубконтоКонтрагент = Неопределено Тогда
				
				Возврат Выборка.ТранзитныйСчетОплаты;
				
			Иначе
				
				Возврат Выборка.СчетАбонента;
				
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Выборка.ТранзитныйСчетОплаты) Тогда
			
			Возврат Выборка.ТранзитныйСчетОплаты;
			
		Иначе
			
			Возврат ПланыСчетов.Хозрасчетный.ПустаяСсылка();
			
		КонецЕсли; 
		
	Иначе
		
		Возврат ПланыСчетов.Хозрасчетный.ПустаяСсылка();
		
	КонецЕсли; 
	
КонецФункции
Функция ПолучитьТаблицуУСН(Оплата)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка", Оплата);
	Запрос.УстановитьПараметр("Дата"  , Оплата.Дата);
	
	Запрос.УстановитьПараметр("Организация"  , Оплата.Организация);
	НеПриниматьПениСобственныхУслугВДоход = Истина;
	НеПриниматьПениСтороннихУслугВДоход   = Истина;
	
	Если НЕ НеПриниматьПениСобственныхУслугВДоход и НЕ НеПриниматьПениСтороннихУслугВДоход Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ОплатаКУСписокУслуг.ЛицевойСчет,
		|	бит_ОплатаКУСписокУслуг.Услуга,
		|	СУММА(бит_ОплатаКУСписокУслуг.Сумма + бит_ОплатаКУСписокУслуг.СуммаПени) КАК Сумма,
		|	СУММА(бит_ОплатаКУСписокУслуг.Сумма) КАК СуммаБезПени,
		|	СУММА(бит_ОплатаКУСписокУслуг.СуммаПени) КАК СуммаПени
		|ПОМЕСТИТЬ Оплата
		|ИЗ
		|	Документ.бит_ОплатаКУ.СписокУслуг КАК бит_ОплатаКУСписокУслуг
		|ГДЕ
		|	бит_ОплатаКУСписокУслуг.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_ОплатаКУСписокУслуг.Услуга,
		|	бит_ОплатаКУСписокУслуг.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Поставщики.ЛицевойСчет КАК ЛицевойСчет,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств ССЫЛКА Справочник.Организации
		|				ТОГДА ЕСТЬNULL(Поставщики.СуммаПени, 0)
		|			ИНАЧЕ ВЫБОР
		|					КОГДА Поставщики.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийпоЖКХ.Аренда)
		|							И бит_НастройкаПараметровЖКХСрезПоследних.СчетСУАренды.НалоговыйУчет = ЛОЖЬ
		|							И бит_НастройкаПараметровЖКХСрезПоследних.СчетПениСУ.НалоговыйУчет = ИСТИНА
		|						ТОГДА ЕСТЬNULL(Поставщики.СуммаПени, 0)
		|					КОГДА Поставщики.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийпоЖКХ.Аренда)
		|							И бит_НастройкаПараметровЖКХСрезПоследних.СчетСУАренды.НалоговыйУчет = ИСТИНА
		|						ТОГДА ЕСТЬNULL(Поставщики.Сумма, 0)
		|					ИНАЧЕ ВЫБОР
