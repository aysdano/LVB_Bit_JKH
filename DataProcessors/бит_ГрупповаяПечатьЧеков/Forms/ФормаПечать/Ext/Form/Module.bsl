&НаСервере
Процедура КассаККМПриИзмененииНаСервере()
	
	Если НЕ КассаККМ.Пустая() Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ПодключаемоеОборудование", КассаККМ);
		Запрос.Текст = "
			|ВЫБРАТЬ
			|	лб_ДоступныеВидыОплатДляКассыККМ.ВидОплаты КАК ВидОплаты
			|ИЗ
			|	РегистрСведений.лб_ДоступныеВидыОплатДляКассыККМ КАК лб_ДоступныеВидыОплатДляКассыККМ
			|ГДЕ
			|	лб_ДоступныеВидыОплатДляКассыККМ.ПодключаемоеОборудование = &ПодключаемоеОборудование
			|";
		
		ТЗВидовОплат = Запрос.Выполнить().Выгрузить();
		МассивВидовОплат = ТЗВидовОплат.ВыгрузитьКолонку("ВидОплаты");
		//СЗВидовОплат = Новый СписокЗначений;
		//СЗВидовОплат.ЗагрузитьЗначения(МассивВидовОплат);
		
		Элементы.ВидОплаты.СписокВыбора.ЗагрузитьЗначения(МассивВидовОплат);
		Если ТЗВидовОплат.Найти(ВидОплаты, "ВидОплаты") = Неопределено Тогда
			ВидОплаты = Справочники.лб_ВидыОплат.ПустаяСсылка();
		КонецЕсли;
		
		//Если ТЗВидовОплат.Количество() > 0 Тогда
		//	Результат = Строка(ТЗКонтИнф[0].АдресПочты);
		//КонецЕсли;
	КонецЕсли;
	Организация = КассаККМ.Организация;
	Объект.Документы.Очистить();
	
КонецПроцедуры

