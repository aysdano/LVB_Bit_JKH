			ФИОФизЛицо = Строка(Выборка.Фамилия) + " " + Строка(Выборка.Имя) + " " + Строка(Выборка.Отчество); 
		Иначе
			ФИОФизЛицо = Строка(Выборка.РегистрируемоеЛицо);	
		КонецЕсли;	
		
		ФизЛицоСтр = ФИОФизЛицо;
		
		Если СнятиеСРегистрации(Объект.ВидОперации) или ПечатьДвухЧастей Тогда
			
			АдресРегистрации_1 = "";
			АдресРегистрации_2 = "";
			
			ЗаявлениеОСнятии.Параметры.Заполнить(Выборка);           
			
			// Заполнение места рождения регистрируемого лица.
			Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.МестоРождения) Тогда
				
				МестоРождения = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(Выборка.РегистрируемоеЛицо.МестоРождения);
				
			КонецЕсли;
			
			// Заполнение пола регистрируемого лица.
			Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				
