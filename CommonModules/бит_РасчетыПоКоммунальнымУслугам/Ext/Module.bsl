			Если ДоляПлощади <> 0 Тогда
				
				Норма = ?(Норма > ДоляПлощади, ДоляПлощади, Норма);
				
			КонецЕсли; 
			
			НоваяСтрока.Норматив =  НормаЛьготы * Выборка.Ставка;
			
			Если Норма > Выборка.ОбщаяПлощадь тогда
				Норма      = Выборка.ОбщаяПлощадь;
			иначе
				СверхНорма = Выборка.ОбщаяПлощадь - Норма; 
			КонецЕсли;
			
			НоваяСтрока.Факт        = Выборка.ОбщаяПлощадь;
			НоваяСтрока.НормаЛьготы = НормаЛьготы;
			НоваяСтрока.Норма       = Норма;
			НоваяСтрока.СверхНорма  = СверхНорма;
			
		ИначеЕсли СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда
			
			Если ДоляПлощади <> 0 Тогда
				
				Норма = ?(Норма > ДоляПлощади, ДоляПлощади, Норма);
				
			КонецЕсли; 
			
			НоваяСтрока.Норматив = НормаЛьготы * Выборка.Ставка;
			
			Если Норма > Выборка.ЖилаяПлощадь тогда
				Норма      = Выборка.ЖилаяПлощадь;
			иначе
				СверхНорма = Выборка.ЖилаяПлощадь - Норма; 
			КонецЕсли;	
			
			НоваяСтрока.Факт         = Выборка.ЖилаяПлощадь;
			НоваяСтрока.НормаЛьготы  = НормаЛьготы;
			НоваяСтрока.Норма        = Норма;
			НоваяСтрока.СверхНорма   = СверхНорма;
			
		ИначеЕсли СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади Тогда
			
			Если ДоляПлощади <> 0 Тогда
				
				Норма = ?(Норма > ДоляПлощади, ДоляПлощади, Норма);
				
			КонецЕсли; 
			
			НоваяСтрока.Норматив =  НормаЛьготы * Выборка.Ставка;
			
			Если Норма > Выборка.ОтапливаемаяПлощадь тогда
				Норма      = Выборка.ОтапливаемаяПлощадь;
			иначе
				СверхНорма = Выборка.ОтапливаемаяПлощадь - Норма; 
			КонецЕсли;	
			
			НоваяСтрока.Факт          = Выборка.ОтапливаемаяПлощадь;
			НоваяСтрока.НормаЛьготы   = НормаЛьготы;
			НоваяСтрока.Норма         = Норма;
			НоваяСтрока.СверхНорма    = СверхНорма;
			
		ИначеЕсли СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим Тогда
			
