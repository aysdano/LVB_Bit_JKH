
Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	Проверка = ПроверкаСвязанныхДокументов(ДанныеЗаполнения.Ссылка); 
	Если   Проверка Тогда
		ВызватьИсключение "Документ Решение суда уже создан на основании"; 
	Иначе	
			Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.бит_ИсковоеЗаявление") Тогда
		Адрес = ДанныеЗаполнения.Адрес;
		Госпошлина = ДанныеЗаполнения.Госпошлина;
		Здание = ДанныеЗаполнения.Здание;
		Квартира = ДанныеЗаполнения.Квартира;
		ЛицевойСчет = ДанныеЗаполнения.ЛицевойСчет;
		Организация = ДанныеЗаполнения.Организация;
		ПериодОбразованияЗадолженностиОт = ДанныеЗаполнения.ПериодОбразованияЗадолженностиОт;
		ПериодОбразованияЗадолженностиПо = ДанныеЗаполнения.ПериодОбразованияЗадолженностиПо;
		Подписант = ДанныеЗаполнения.Подписант;
		ПредставительскиеРасходы = ДанныеЗаполнения.ПредставительскиеРасходы;
		СудебныйУчасток = ДанныеЗаполнения.СудебныйУчасток;
		СуммаЗадолженности = ДанныеЗаполнения.СуммаЗадолженности;
		ТипДокумента = ДанныеЗаполнения.ТипДокумента;
		Услуга = ДанныеЗаполнения.Услуга;
		Заявление = ДанныеЗаполнения.Ссылка;
		Для Каждого ТекСтрокаОтветчики Из ДанныеЗаполнения.Ответчики Цикл
			НоваяСтрока = Ответчики.Добавить();
			НоваяСтрока.ФизЛицо = ТекСтрокаОтветчики.ФизЛицо;
		КонецЦикла;
	КонецЕсли;
КонецЕсли;
КонецПроцедуры 


Функция ПроверкаСвязанныхДокументов(Заявление)
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ",Заявление);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СвязанныеДокументы.Ссылка КАК Ссылка
	               |ИЗ
	               |	КритерийОтбора.СвязанныеДокументы(&Документ) КАК СвязанныеДокументы";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Связь = Истина;
	Иначе 
		Связь = Ложь;
	КонецЕсли;
	Возврат Связь;
	УстановитьПривилегированныйРежим(Ложь);
КонецФункции


