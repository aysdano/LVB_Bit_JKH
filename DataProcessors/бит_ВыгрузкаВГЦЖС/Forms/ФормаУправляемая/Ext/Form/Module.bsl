	Запрос.УстановитьПараметр("ФизЛицо"	, ФизЛицо);

	Выборка = Запрос.Выполнить().Выбрать();
	
	если Выборка.Следующий() тогда
		
	 если Выборка.СтатусПроживания = перечисления.бит_СтатусПроживания.Временно ИЛИ 	
		   Выборка.СтатусПроживания = перечисления.бит_СтатусПроживания.Постоянно тогда
	  возврат "1";
     конецесли;	   
	 
	 если Выборка.СтатусПроживания = перечисления.бит_СтатусПроживания.НеПроживает тогда
	  возврат "0";
     конецесли;	 
	 
    иначе
	 возврат неопределено;	
    конецесли;
	
