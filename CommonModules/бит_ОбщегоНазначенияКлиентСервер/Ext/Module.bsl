	Пары.Добавить(Пара);
	
	Пара = Новый Структура("ИмяКласса, ИмяКоллекции", "Задача", "Задачи");
	Пары.Добавить(Пара);
	
	Имена = Новый Соответствие;
	
	Для каждого пара Из Пары Цикл
		
		Если ВРег(Режим) = ВРег("КоллекцияКласс") Тогда
			
			Имена.Вставить(пара.ИмяКоллекции,пара.ИмяКласса);
			
