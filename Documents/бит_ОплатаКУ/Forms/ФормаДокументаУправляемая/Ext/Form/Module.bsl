КонецПроцедуры

// Получение ответственного, на выбранном ЛС.
// Параметры:
//  <ЛицевойСчет> – <Справочник.бит_ЛицевыеСчета> – для получения ответственного по ЛС.
//
// Возвращаемое значение:
//   <ТаблицаЗначений.Строка> – <строка с ответственным по ЛС>.
//
&НаСервере
Функция ОтветственныйНаЛС(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					ЛицевыеСчета.Ссылка
	|				ИЗ
	|					Справочник.бит_ЛицевыеСчета КАК ЛицевыеСчета
	|				ГДЕ
	|					ЛицевыеСчета.Ссылка = &ЛицевойСчет)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица <> &Выписан
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизЛицо";
	
	Запрос.УстановитьПараметр("Момент", 	 ТекущаяДата());
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Выписан", ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан"));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()> 0 и Результат.Количество()< 2  Тогда
		
		РезультатФизЛицо = Результат[0].ФизЛицо
	ИначеЕсли Результат.Количество()> 1  Тогда
		
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл
			
			ФизЛицо = Выборка.ФизЛицо;
			
		КонецЦикла;
		РезультатФизЛицо = ФизЛицо;
	Иначе
		РезультатФизЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФизЛицо;
	
КонецФункции 

&НаКлиенте
Процедура СписокЛСЛицевойСчетОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	
	Если Не Объект.Проведен Тогда
		
		МожноИспользоватьЭтотЛС = МожноИспользоватьЭтотЛСНаСервере(Текст);
		
		Если МожноИспользоватьЭтотЛС = Неопределено Тогда
			
			СтандартнаяОбработка = Ложь;
			
			Возврат;
			
		КонецЕсли;
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Перед изменением таблицы лицевых счетов - распроведите документ";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция МожноИспользоватьЭтотЛСНаСервере(Текст)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка,
	|	бит_ЛицевыеСчета.Организация
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Организация = &Организация
	//++АнисимоваМВ 08.11 восстановление базы
	| И бит_ЛицевыеСчета.Наименование = &Наименование";
	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);	
	Запрос.УстановитьПараметр("Наименование", Текст);	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Если Строка(ВыборкаДетальныеЗаписи.Ссылка) = Текст Тогда
			
			Возврат Истина;
		Иначе
			
		КонецЕсли;	
		
	КонецЦикла;
	
КонецФункции

&НаКлиенте
Процедура РассчитатьНаКлиенте()
	
	Если Не Объект.Проведен Тогда
		ВыполнитьРасчетНаСервере();
		УдалитьПустыеСтрокиНаСервере();
		ОбновитьДанныеКолонкиАдрес();
		ОбновитьДанныеКолонкиОтветственный();
		Элементы.СписокУслугСуммаПени.Видимость = ?(Объект.СписокУслуг.Итог("СуммаПени") <> 0 ИЛИ Объект.ВводВРучную, Истина, Ложь);
		
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Перед изменением таблицы лицевых счетов - распроведите документ";
		Сообщение.Сообщить();
	КонецЕсли;

КонецПроцедуры

