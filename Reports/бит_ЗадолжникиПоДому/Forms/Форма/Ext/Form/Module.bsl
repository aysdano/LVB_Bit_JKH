КонецФункции

Функция ПолучитьДанные()
	
	Адреса = Новый Массив;
	Если ЗначениеЗаполнено(Адрес) Тогда
		
		Адреса.Добавить(Адрес);
	
	КонецЕсли;
	
	Если УчастокПодходит(Участок) Тогда
		ЗапросЗданияПоУчастку = Новый Запрос;
		ЗапросЗданияПоУчастку.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                              |	бит_СписокЗданий.Ссылка КАК Ссылка
	                              |ИЗ
	                              |	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	                              |ГДЕ
	                              |	бит_СписокЗданий.Участок В(&Участки)";
		ЗапросЗданияПоУчастку.УстановитьПараметр("Участки", Участок);
	
		ВыборкаЗдания = ЗапросЗданияПоУчастку.Выполнить().Выбрать();
	
		Пока ВыборкаЗдания.Следующий() Цикл
		
			Адреса.Добавить(ВыборкаЗдания.Ссылка);
		
		КонецЦикла;
	КонецЕсли;

	УслугиПараметр = Новый Массив;
	
	Для Каждого Услуга ИЗ УслугаГруппаУслуг Цикл
		
		УслугиПараметр.Добавить(Услуга.Значение);
		
	КонецЦикла;
	
	ЗапросУслуги = Новый Запрос;
	ЗапросУслуги.Текст = "ВЫБРАТЬ
	                     |	бит_УслугиЖКХ.Ссылка КАК Ссылка
	                     |ИЗ
	                     |	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	                     |ГДЕ
	                     |	(бит_УслугиЖКХ.Ссылка В (&Услуги)
	                     |			ИЛИ бит_УслугиЖКХ.ГруппаУслуги В (&Услуги))";
	
	ЗапросУслуги.УстановитьПараметр("Услуги", УслугиПараметр);
	
	ВыборкаУслуги = ЗапросУслуги.Выполнить().Выбрать();
	
	Услуги = Новый Массив;
	
	Пока ВыборкаУслуги.Следующий() Цикл
		Услуги.Добавить(ВыборкаУслуги.Ссылка);		
	КонецЦикла;
	
	ТипыПомещенийМ = Новый Массив;
	
	Для Каждого Тип Из ТипыПомещений Цикл
		
		ТипыПомещенийМ.Добавить(Тип.Значение);
		
	КонецЦикла;
	
	ЗапросЛицевыеСчета = Новый Запрос;
	ЗапросЛицевыеСчета.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                           |	бит_Квартиры.Ссылка КАК Ссылка
	                           |ПОМЕСТИТЬ ВТ_Квартиры
	                           |ИЗ
	                           |	Справочник.бит_Квартиры КАК бит_Квартиры
	                           |ГДЕ
	                           |	бит_Квартиры.Владелец В(&Адреса)
	                           |;
	                           |
	                           |////////////////////////////////////////////////////////////////////////////////
	                           |ВЫБРАТЬ
	                           |	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	                           |ИЗ
	                           |	ВТ_Квартиры КАК ВТ_Квартиры
	                           |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	                           |		ПО ВТ_Квартиры.Ссылка = бит_ЛицевыеСчета.Квартира";
	ЗАпросЛицевыеСчета.УстановитьПараметр("Адреса", Адреса);
	
	ВыборкаЛицевыеСчета = ЗапросЛицевыеСчета.Выполнить().Выбрать();
	
	ЛС = Новый Массив;
	
	Пока ВыборкаЛицевыеСчета.Следующий() Цикл
		
		ЛС.Добавить(ВыборкаЛицевыеСчета.ЛицевойСчет);
		
	КонецЦикла;
	
	ВсеЛС = ЛС;
	ОсновнойЗапрос = Новый Запрос;
	ОсновнойЗапрос.Текст = "ВЫБРАТЬ
	                       |	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	                       |	бит_ЛицевыеСчета.Квартира КАК Квартира,
	                       |	бит_ЛицевыеСчета.Квартира.НомерКвартиры КАК КвартираНомерКвартиры
	                       |ПОМЕСТИТЬ ВТ_Квартиры
	                       |ИЗ
	                       |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	                       |ГДЕ
	                       |	бит_ЛицевыеСчета.Ссылка В(&ЛицевыеСчета)
	                       |	И бит_ЛицевыеСчета.ПометкаУдаления = ЛОЖЬ
	                       |;
	                       |
	                       |////////////////////////////////////////////////////////////////////////////////
						   //shevtsov 27.02.26 Начало
	                       |ВЫБРАТЬ
	                       |	ВТ_Квартиры.ЛицевойСчет КАК ЛицевойСчет,
	                       |	ВТ_Квартиры.Квартира КАК Квартира,
	                       |	ВТ_Квартиры.КвартираНомерКвартиры КАК КвартираНомерКвартиры,
	                       |	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	                       |	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления
	                       |ПОМЕСТИТЬ ВтКвартирыСУслугами
	                       |ИЗ
	                       |	ВТ_Квартиры КАК ВТ_Квартиры
	                       |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	                       |				&НачалоПериода,
	                       |				ВЫБОР
	                       |					КОГДА &УслугиЗаполнено > 0
	                       |						ТОГДА Услуга В (&Услуги)
	                       |					ИНАЧЕ ИСТИНА
	                       |				КОНЕЦ) КАК бит_СведенияПоУслугамЛССрезПоследних
	                       |		ПО ВТ_Квартиры.ЛицевойСчет = бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет
	                       |;
	                       |
	                       |////////////////////////////////////////////////////////////////////////////////
	                       |ВЫБРАТЬ
	                       |	ВтКвартирыСУслугами.ЛицевойСчет КАК ЛицевойСчет,
	                       |	ВтКвартирыСУслугами.Квартира КАК Квартира,
	                       |	ВтКвартирыСУслугами.КвартираНомерКвартиры КАК КвартираНомерКвартиры,
	                       |	ВтКвартирыСУслугами.Услуга КАК Услуга
	                       |ПОМЕСТИТЬ втКвартирыСУслугамиСОтбором
	                       |ИЗ
	                       |	ВтКвартирыСУслугами КАК ВтКвартирыСУслугами
	                       |ГДЕ
	                       |	НЕ ВтКвартирыСУслугами.РежимПотребления = ЗНАЧЕНИЕ(Справочник.бит_РежимыПотребленияУслуг.НеНачислять)
	                       |;
	                       |
						   //shevtsov 27.02.26 Окончание
	                       |////////////////////////////////////////////////////////////////////////////////
	                       |ВЫБРАТЬ
	                       |	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет КАК ЛицевойСчет,
	                       |	СУММА(ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток, 0)) КАК НачальныйОстаток
	                       |ПОМЕСТИТЬ ВТ_ОстаткиНач
	                       |ИЗ
	                       |	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(
	                       |			&НачалоПериода,
	                       |			ЛицевойСчет В (&ЛицевыеСчета)
	                       |				И ВЫБОР
	                       |					КОГДА &УслугиЗаполнено > 0
	                       |						ТОГДА УслугаЖКХ В (&Услуги)
	                       |					ИНАЧЕ ИСТИНА
