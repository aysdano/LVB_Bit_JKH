// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьСправкуВВоенкомат(ДокументРезультат, ПараметрыОтчета)
	
	Макет = Документы.бит_СправкиПаспортногоСтола.ПолучитьМакет("ВВоенкомат");
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ФизЛицо_Склон = "";
	ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ПараметрыОтчета.Проживающий.Наименование,3,ПараметрыОтчета.Пол,ФизЛицо_Склон);
	
	Если ИсходСклонения Тогда
		ОбластьШапка.Параметры.Проживающий = ФизЛицо_Склон;
	Иначе
		ОбластьШапка.Параметры.Проживающий = ПараметрыОтчета.Проживающий; 
	КонецЕсли;
	
	ОбластьШапка.Параметры.Номер			= ПараметрыОтчета.Номер;
	ОбластьШапка.Параметры.ДатаВыдачи		= Формат(ПараметрыОтчета.Период, "ДЛФ=DD");
	ОбластьШапка.Параметры.ДатаРождения		= Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.АдресПроживающего= ПараметрыОтчета.Адрес;
	
	СписокПроживающих = Новый СписокЗначений;
	СписокПроживающих.ЗагрузитьЗначения(ПараметрыОтчета.СписокПроживающих.ВыгрузитьКолонку("ФизЛицо"));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"           , ПараметрыОтчета.Период);
	Запрос.УстановитьПараметр("ЛицевойСчет"      , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("Проживающий"      , ПараметрыОтчета.Проживающий);
	Запрос.УстановитьПараметр("СписокПроживающих", СписокПроживающих);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			ФизЛицо = &Проживающий
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОбластьШапка.Параметры.ДатаРегистрацииПроживающего = Формат(Выборка.ДатаРегистрации, "ДФ=dd.MM.yyyy");
		
	КонецЕсли;
	
	ЗаполнитьИнформациюОбОрганизации(ОбластьШапка, ПараметрыОтчета);
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФИО,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			НЕ ФизЛицо = &Проживающий
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Постоянно)";
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	
	ПостроительЗапроса.Текст = Текст;
	
	ПостроительЗапроса.Параметры.Вставить("Период"           , ПараметрыОтчета.Период);
	ПостроительЗапроса.Параметры.Вставить("ЛицевойСчет"      , ПараметрыОтчета.ЛицевойСчет);
	ПостроительЗапроса.Параметры.Вставить("Проживающий"      , ПараметрыОтчета.Проживающий);
	
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если ПараметрыОтчета.ИспользоватьОтборПроживающих Тогда
		
		Отбор = ПостроительЗапроса.Отбор.Добавить("ФИО");
		Отбор.ВидСравнения  = ВидСравнения.ВСписке;
		Отбор.Использование = Истина;
		Отбор.Значение      = СписокПроживающих;
		
	КонецЕсли; 
	
	ПостроительЗапроса.Выполнить();
	
	Выборка = ПостроительЗапроса.Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока.Параметры.ФИО             = Выборка.ФИО;
		// БИТ_ЖКХ 23.10.2015 18:00:15 Начало правки... 
		//ОбластьСтрока.Параметры.ДатаРождения    = Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
		ОбластьСтрока.Параметры.ДатаРождения    = Формат(Выборка.ДатаРождения, "ДФ=dd.MM.yyyy");
		// БИТ_ЖКХ 23.10.2015 18:00:17 Конец правки. 
		ОбластьСтрока.Параметры.ДатаРегистрации = Формат(Выборка.ДатаРегистрации, "ДФ=dd.MM.yyyy");
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ОбластьПодвал.Параметры.Заполнить(ПараметрыОтчета);
	ДокументРезультат.Вывести(ОбластьПодвал);
	
КонецПроцедуры // ()

