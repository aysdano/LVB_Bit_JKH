&НаСервере
Функция ПолучитьМассивУслуг()
	Массив = Новый Массив;
	Массив.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001")); //Содержание
	Массив.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010")); //Капремонт
	Массив.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000012")); //Госпошлина
	Массив.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000013")); //Представительские
	Возврат Массив;
КонецФункции

&НаСервере
Процедура ПровестиРасчет(Стр,Счет,Организация,Массив,МассивУслуг,МассивКлючей)
	//Если Организация.ОсновнойБанковскийСчет = Счет И 	
	Содержание = МассивУслуг[0];// Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001");	
	Сумма = Стр.Сумма;
	Ошибочный = Ложь;
	пМассив = Новый Массив;
	Запрос = Новый Запрос;
	Если Объект.Проведен Тогда
		Доп = "И НЕ ВзаиморасчетыПоИсполнительномуПроизводствуОстаткиИОбороты.Регистратор = &Док";
		Запрос.УстановитьПараметр("Док",Объект.Ссылка);
	Иначе
		Доп = "";
	КонецЕсли;
	Запрос.Текст = "ВЫБРАТЬ
	               |	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.СуммаГоспошлиныОстаток КАК Госпошлина,
	               |	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.СуммаПредставительскихРасходовОстаток КАК Представительские,
	               |	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.СуммаОстаток КАК Услуга,
	               |	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.Услуга КАК УслугаСсылка
	               |ИЗ
	               |	РегистрНакопления.ВзаиморасчетыПоИсполнительномуПроизводству.Остатки(, ИсполнительныйЛист = &Регистратор"+Доп+") КАК ВзаиморасчетыПоИсполнительномуПроизводствуОстатки";
	Запрос.УстановитьПараметр("Регистратор",Стр.ИсполнительныйЛист);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.УслугаСсылка = МассивУслуг[1] И Счет = Организация.ОсновнойБанковскийСчет Тогда
			Ошибочный = Истина;
			Если Сумма >= Выборка.Госпошлина Тогда
				Госпошлина = Выборка.Госпошлина;
				Сумма = Сумма - Госпошлина;
				Если Сумма >= Выборка.Представительские Тогда
					Представительские = Выборка.Представительские;
					Сумма = Сумма - Представительские;
					Услуга = Содержание;
					Сторно = -Сумма;
					Стр.ИзменитьСтатусИЛ = Ложь;

				Иначе
					Представительские = Сумма;
					Сумма = 0;
					Услуга = Содержание;
					Сторно = 0;
					Стр.ИзменитьСтатусИЛ = Ложь;

				КонецЕсли;
				
			Иначе
				Госпошлина = Сумма;	
				Представительские = 0;
				Сумма = 0;
				Услуга = Содержание;
				Сторно = 0;
				Стр.ИзменитьСтатусИЛ = Ложь;

			КонецЕсли;
			
		Иначе
			Если Сумма >= Выборка.Госпошлина Тогда
				Госпошлина = Выборка.Госпошлина;
				Сумма = Сумма - Госпошлина;
				Если Сумма >= Выборка.Представительские Тогда
					Представительские = Выборка.Представительские;
					Сумма = Сумма - Представительские;
					Если Сумма >= Выборка.Услуга Тогда
						Сторно = Сумма - Выборка.Услуга;
						Сумма = Выборка.Услуга;
						Стр.ИзменитьСтатусИЛ = Истина;
					Иначе
						Стр.ИзменитьСтатусИЛ = Ложь;
						Сторно = 0;
					КонецЕсли;
				Иначе
					Представительские = Сумма;
					Сумма = 0;
					Сторно = 0;
					Стр.ИзменитьСтатусИЛ = Ложь;

				КонецЕсли;
			Иначе
				Госпошлина = Сумма;	
				Представительские = 0;
				Сумма = 0;
				Сторно = 0;
				Стр.ИзменитьСтатусИЛ = Ложь;

			КонецЕсли;
			Услуга = Выборка.УслугаСсылка;
		КонецЕсли;
		МассивКлючей.Добавить(Стр.ЛицевойСчет);
		Если Сторно < 0 Тогда 
			Стр.Сумма = Стр.Сумма + Сторно;
		КонецЕсли;
		пМассив.Добавить(Госпошлина);	
		пМассив.Добавить(Представительские);	
		пМассив.Добавить(Сумма);	
		пМассив.Добавить(Сторно);	
		пМассив.Добавить(Услуга);
		пМассив.Добавить(Ошибочный);
		пМассив.Добавить(Стр.лб_КлючСтроки);	
		пМассив.Добавить(Стр.ИсполнительныйЛист);
		пМассив.Добавить(Стр.ЛицевойСчет);
		
		Массив.Добавить(пМассив);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСИсполнительныйЛистПриИзменении(Элемент)
	
	ТекущаяСтрока = Объект.СписокЛС.НайтиПоИдентификатору(Элементы.СписокЛС.ТекущаяСтрока);
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("лб_КлючСтроки", ТекущаяСтрока.лб_КлючСтроки);
	
	Для каждого стр из Объект.СписокУслуг.НайтиСтроки(ПараметрыОтбора) Цикл
		стр.ИсполнительныйЛист = ТекущаяСтрока.ИсполнительныйЛист;
	КонецЦикла;
	
КонецПроцедуры


#КонецОбласти
