&НаСервере
Процедура ЗаполнитьВсеЛСНаСервере()
	
	ТекущиеЛС = новый массив;
	для каждого стр из Объект.СписокЛС цикл
	  ТекущиеЛС.Добавить(стр.ЛицевойСчет);	
    конеццикла;	
  
    запрос = новый Запрос;
	запрос.Текст =    "ВЫБРАТЬ
	                  |	бит_ЛицевыеСчета.Ссылка КАК Ссылка,
	                  |	бит_ЛицевыеСчета.ПометкаУдаления КАК ПометкаУдаления
	                  |ИЗ
	                  |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	                  |ГДЕ
	                  |	бит_ЛицевыеСчета.ПометкаУдаления = &ПометкаУдаления";
	
	запрос.УстановитьПараметр("ПометкаУдаления", ложь);
	
	таблицаЛС = запрос.Выполнить().Выгрузить();
	
	для каждого стр из таблицаЛС цикл
		
		если ТекущиеЛС.Найти(стр.Ссылка) = неопределено тогда
			НоваяСтрока = Объект.СписокЛС.Добавить();
			НоваяСтрока.ЛицевойСчет = стр.Ссылка;
		конецесли;	
		
	конеццикла;
	
КонецПроцедуры


