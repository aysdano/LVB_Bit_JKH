
#Область ПеременныеМодуля

Перем мВыводитьСуммуБезУчетаПереплатПоУслугам Экспорт; // Хранит флаг настройки ЖКХ.
Перем мВключатьВРасчетСуммыДолгаПени          Экспорт; // Хранит флаг настройки ЖКХ.

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункцииДокумента

// Функция фозвращает дату долга.
//
// Параметры:
//  Организация  - СправочникСсылка - фильтр к запросу.
//
//  Дата         - Дата             - фильтр к запросу.
//
// Возвращаемое значение:
//   Дата   - текущая дата долга.
//
Функция ПолучитьДатуДолга(Организация, Дата) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -(1 + бит_НастройкаПараметровЖКХСрезПоследних.КоличествоМесяцевОтсрочкиНачисленияПени)), МЕСЯЦ) КАК Дата1,
	|	ВЫБОР
	|		КОГДА бит_НастройкаПараметровЖКХСрезПоследних.ПоследнийДеньПриемаПлатежей >= ДЕНЬ(&Дата)
	|			ТОГДА НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -1 - бит_НастройкаПараметровЖКХСрезПоследних.КоличествоМесяцевОтсрочкиНачисленияПени), МЕСЯЦ)
	|		ИНАЧЕ НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -бит_НастройкаПараметровЖКХСрезПоследних.КоличествоМесяцевОтсрочкиНачисленияПени), МЕСЯЦ)
	|	КОНЕЦ КАК Дата
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата"       , Дата);
	
	Возврат ?(Запрос.Выполнить().Пустой(), ТекущаяДата(),Запрос.Выполнить().Выгрузить()[0].Дата);
	
КонецФункции

// Функция возвращает список ЛС по ЛС, зданию или организации.
//
// Параметры:
//  <Здание>  - <Справочник.бит_СписокЗданий> - ссылка на справочник.
//  <ФлагЗдания>  - <логическое> - заполнение поля ОбъектВыбора на вид справочника бит_СписокЗданий.
//  <ЛС>  - <Справочник.бит_ЛицевыеСчета> - ссылка на справочник.
//
// Возвращаемое значение:
//   <СписокЛС>   -  ТаблицаЗначенений из ЛС.
//
Функция ПолучитьСписокЛС(Здание = Неопределено,  ФлагЗдания = Ложь, ЛС = Неопределено) Экспорт
	
	Запрос = Новый Запрос;
	
	Если  ЛС <> Неопределено  Тогда
		Запрос.Текст = 
		
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Ссылка = &ЛС";
		
	ИначеЕсли ФлагЗдания Тогда
		Запрос.Текст = 
		
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Здание = &СписокЗданий
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛицевойСчет";
		
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СписокЗданий.Здание
		|ПОМЕСТИТЬ СписокЗданий
		|ИЗ
		|	&СписокЗданий КАК СписокЗданий
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Здание В
		|			(ВЫБРАТЬ
		|				СписокЗданий.Здание
		|			ИЗ
		|				СписокЗданий КАК СписокЗданий)
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛицевойСчет";
		
	КонецЕсли; 
	
	Запрос.УстановитьПараметр("СписокЗданий", Здание);
	Запрос.УстановитьПараметр("ЛС", ЛС);
	
	СписокЛС = Запрос.Выполнить().Выгрузить();
	
	Возврат СписокЛС;
	
КонецФункции

// // Функция возвращает список зданий.
//
// Параметры:
//  <Организация>  - <Справочник.организации> - название организации.
//
// Возвращаемое значение:
//   СписокЗданий   - таблица значений по организации.
//
Функция ПолучитьСписокЗданий(Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СписокЗданий.Ссылка КАК Здание
	|ИЗ
	|	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|ГДЕ
	|	бит_СписокЗданий.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	
	СписокЗданий = Запрос.Выполнить().Выгрузить();
	
	Возврат СписокЗданий;
	
КонецФункции

// Содержит полный список всех необходимых данных.
// Параметр СписокЛС - массив из номеров лицевых счетов по настройкам пользователя.
// Возврат ИтогТЗ - дерево значений из ЛС, отвественных и сумм долгов. 
// Для заполнения табличной части формы документа.
Функция РасчитатьДолги(СписокЛС, МоментРасчет, ДатаРасчетаПени = '00010101000000') Экспорт
	
	МассивУслуг = Новый Массив;
	Если НЕ ШаблонИзвещений = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", ШаблонИзвещений);
		Запрос.Текст =
		"ВЫБРАТЬ
		|	бит_ШаблоныИзвещенийУслуги.Услуга
		|ИЗ
		|	Справочник.бит_ШаблоныИзвещений.Услуги КАК бит_ШаблоныИзвещенийУслуги
		|ГДЕ
		|	бит_ШаблоныИзвещенийУслуги.Ссылка = &Ссылка";
		Результат = Запрос.Выполнить().Выгрузить();
		МассивУслуг = Результат.ВыгрузитьКолонку("Услуга");
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент"		, МоментРасчет);
	Запрос.УстановитьПараметр("ДопСписокЛС"	, СписокЛС);
	Запрос.УстановитьПараметр("ДатаДолга"	, КонецДня(?(ЗначениеЗаполнено(ЭтотОбъект.ДатаРасчета),ЭтотОбъект.ДатаРасчета,ЭтотОбъект.Дата)));
	Запрос.УстановитьПараметр("Услуги"		, МассивУслуг);
	
	Если МассивУслуг.Количество() = 0 Тогда
		Запрос.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ОтветственноеЛицо,
		|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
		|ПОМЕСТИТЬ СписокОтветственных
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет В (&ДопСписокЛС)) КАК бит_ПроживающиеПоЛССрезПоследних
		|ГДЕ
		|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
		|	И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
		|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	бит_НачислениеПениПоУслугамЖКХОстатки.ЛицевойСчет КАК ЛицевойСчет,
		|	СУММА(бит_НачислениеПениПоУслугамЖКХОстатки.СуммаПениОстаток) КАК СуммаОстаток,
		|	бит_НачислениеПениПоУслугамЖКХОстатки.УслугаЖКХ
		|ПОМЕСТИТЬ ДолгПени
		|ИЗ
		|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Остатки(&Момент {(&Момент)}, ЛицевойСчет В (&ДопСписокЛС)) КАК бит_НачислениеПениПоУслугамЖКХОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачислениеПениПоУслугамЖКХОстатки.ЛицевойСчет,
		|	бит_НачислениеПениПоУслугамЖКХОстатки.УслугаЖКХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
		|				ТОГДА -бит_НачислениеПениПоУслугамЖКХОбороты.СуммаПениОборот
		|		КОНЕЦ) КАК Оплата,
		|	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ
		|ПОМЕСТИТЬ ОплатаСДатыДолгаПени
		|ИЗ
		|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Обороты(&Момент {(&Момент)}, &ДатаДолга {(&ДатаДолга)}, Регистратор, ЛицевойСчет В (&ДопСписокЛС)) КАК бит_НачислениеПениПоУслугамЖКХОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет,
		|	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет КАК ЛицевойСчет,
		|	СУММА(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток) КАК СуммаОстаток,
		|	бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ КАК Услуга
		|ПОМЕСТИТЬ Долг
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&Момент {(&Момент)}, ЛицевойСчет В (&ДопСписокЛС)) КАК бит_НачисленияПоУслугамЖКХОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
		|				ТОГДА -бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Оплата,
		|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
		|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Разовые
		|ПОМЕСТИТЬ ОплатаСДатыДолга
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&Момент {(&Момент)}, &ДатаДолга {(&ДатаДолга)}, Регистратор, ЛицевойСчет В (&ДопСписокЛС)) КАК бит_НачисленияПоУслугамЖКХОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
		|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	Долг.ЛицевойСчет,
		|	СУММА(Долг.СуммаОстаток) КАК СуммаОстаток,
		|	СУММА(ОплатаСДатыДолга.Оплата) КАК Оплата,
		|	СУММА(ВЫБОР
		|			КОГДА ЕСТЬNULL(Долг.СуммаОстаток, 0) + ЕСТЬNULL(ОплатаСДатыДолга.Разовые, 0) - ЕСТЬNULL(ОплатаСДатыДолга.Оплата, 0) < 0
		|				ТОГДА 0
		|			ИНАЧЕ ЕСТЬNULL(Долг.СуммаОстаток, 0) + ЕСТЬNULL(ОплатаСДатыДолга.Разовые, 0) - ЕСТЬNULL(ОплатаСДатыДолга.Оплата, 0)
		|		КОНЕЦ) КАК СуммаБезПереплат,
		|	СУММА(ЕСТЬNULL(Долг.СуммаОстаток, 0) + ЕСТЬNULL(ОплатаСДатыДолга.Разовые, 0) - ЕСТЬNULL(ОплатаСДатыДолга.Оплата, 0)) КАК Сумма,
		|	ВЫБОР
		|		КОГДА Долг.Услуга <> НЕОПРЕДЕЛЕНО
		|			ТОГДА Долг.Услуга
		|		ИНАЧЕ ОплатаСДатыДолга.Услуга
		|	КОНЕЦ КАК Услуга
		|ПОМЕСТИТЬ ИтогоПоДолгу
		|ИЗ
		|	Долг КАК Долг
		|		ПОЛНОЕ СОЕДИНЕНИЕ ОплатаСДатыДолга КАК ОплатаСДатыДолга
		|		ПО Долг.ЛицевойСчет = ОплатаСДатыДолга.ЛицевойСчет
		|			И Долг.Услуга = ОплатаСДатыДолга.Услуга
		|
		|СГРУППИРОВАТЬ ПО
		|	Долг.ЛицевойСчет,
		|	ВЫБОР
		|		КОГДА Долг.Услуга <> НЕОПРЕДЕЛЕНО
		|			ТОГДА Долг.Услуга
		|		ИНАЧЕ ОплатаСДатыДолга.Услуга
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ДолгПени.ЛицевойСчет,
		|	СУММА(ЕСТЬNULL(ДолгПени.СуммаОстаток, 0) - ЕСТЬNULL(ОплатаСДатыДолгаПени.Оплата, 0)) КАК СуммаПени,
		|	ВЫБОР
		|		КОГДА ДолгПени.УслугаЖКХ = НЕОПРЕДЕЛЕНО
		|			ТОГДА ОплатаСДатыДолгаПени.УслугаЖКХ
		|		ИНАЧЕ ДолгПени.УслугаЖКХ
		|	КОНЕЦ КАК Услуга
		|ПОМЕСТИТЬ ИтогоПоПени
		|ИЗ
		|	ДолгПени КАК ДолгПени
		|		ПОЛНОЕ СОЕДИНЕНИЕ ОплатаСДатыДолгаПени КАК ОплатаСДатыДолгаПени
		|		ПО ДолгПени.ЛицевойСчет = ОплатаСДатыДолгаПени.ЛицевойСчет
		|			И ДолгПени.УслугаЖКХ = ОплатаСДатыДолгаПени.УслугаЖКХ
		|
		|СГРУППИРОВАТЬ ПО
		|	ДолгПени.ЛицевойСчет,
		|	ВЫБОР
		|		КОГДА ДолгПени.УслугаЖКХ = НЕОПРЕДЕЛЕНО
		|			ТОГДА ОплатаСДатыДолгаПени.УслугаЖКХ
		|		ИНАЧЕ ДолгПени.УслугаЖКХ
		|	КОНЕЦ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
		|ПОМЕСТИТЬ СведенияПоУслугам
		|ИЗ
