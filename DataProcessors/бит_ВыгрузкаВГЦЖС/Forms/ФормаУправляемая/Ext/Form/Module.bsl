#Область ПроцедурыИФункцииОбщегоНазначения

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	Элементы.СтатусКвартиры.Доступность  = ИспользоватьОтборСтатусКв;
	Элементы.ТипКвартиры.Доступность     = ИспользоватьОтборТипКв;
	
	Если Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.Москва Тогда
		
		Элементы.ВидВыгрузки.Доступность        = Истина;
		Элементы.ПанельВыгрузки.Доступность     = Истина;
		
		Элементы.НастройкиРегиона_Льготы.ТекущаяСтраница = Элементы.НастройкиРегиона_Льготы_Москва;
		
		Если Объект.ВидВыгрузки = Перечисления.бит_ВидВыгрузкиГЦЖС.Льготы Тогда
			
			Элементы.ПанельВыгрузки.ТекущаяСтраница = Элементы.Льготы;
			Элементы.Льготы.Видимость     = Истина;
			Элементы.Начисления.Видимость = Ложь;
			
		ИначеЕсли  Объект.ВидВыгрузки = Перечисления.бит_ВидВыгрузкиГЦЖС.Начисления Тогда
			
			Элементы.ПанельВыгрузки.ТекущаяСтраница = Элементы.Начисления;
			Элементы.Начисления.Видимость = Истина;
			Элементы.Льготы.Видимость     = Ложь;
			
		КонецЕсли;
		
	ИначеЕсли Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.Иркутск Тогда
		
		Элементы.ВидВыгрузки.Доступность        = Ложь;
		Элементы.ПанельВыгрузки.Доступность     = Истина;
		
		Элементы.НастройкиРегиона_Льготы.ТекущаяСтраница = Элементы.НастройкиРегиона_Льготы_Иркутск;
		
		Элементы.ПанельВыгрузки.ТекущаяСтраница = Элементы.Льготы;
		Элементы.Льготы.Видимость     = Истина;
		Элементы.Начисления.Видимость = Ложь;
		
	ИначеЕсли Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.КрасноярскийКрай Тогда
		
		Элементы.ВидВыгрузки.Доступность        = Ложь;
		Элементы.ПанельВыгрузки.Доступность     = Истина;
		
		Элементы.НастройкиРегиона_Льготы.ТекущаяСтраница = Элементы.НастройкиРегиона_Льготы_КрасноярскийКрай;
		
		Элементы.ПанельВыгрузки.ТекущаяСтраница = Элементы.Льготы;
		Элементы.Льготы.Видимость     = Истина;
		Элементы.Начисления.Видимость = Ложь;
		
	Иначе
		
		Элементы.ВидВыгрузки.Доступность    = Ложь;
		Элементы.ПанельВыгрузки.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УправлениеЭлементамиФормыНаКлиенте()
	
	Элементы.СтатусКвартиры.Доступность  = ИспользоватьОтборСтатусКв;
	Элементы.ТипКвартиры.Доступность     = ИспользоватьОтборТипКв;
	
КонецПроцедуры

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Перечисления.
	КэшПеречисления = Новый Структура;
	КэшПеречисления.Вставить("бит_ВидВыгрузкиГЦЖС"     ,бит_ОбщегоНазначения.КэшироватьЗначенияПеречисления(Перечисления.бит_ВидВыгрузкиГЦЖС));
	КэшПеречисления.Вставить("бит_РегионыВыгрузкиВГЦЖС",бит_ОбщегоНазначения.КэшироватьЗначенияПеречисления(Перечисления.бит_РегионыВыгрузкиВГЦЖС));
	
	КэшированныеЗначения.Вставить("Перечисления", КэшПеречисления);
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)  	
		
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Организация = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ответственный) Тогда
		
		ОбработкаОбъект = ДанныеФормыВЗначение(Объект,Тип("ОбработкаОбъект.бит_ВыгрузкаВГЦЖС"));		

		бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ОбработкаОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
		
		Объект.Ответственный = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнойОтветственный",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
		
	КонецЕсли;
	
	Каталог = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнойКаталогФайлов",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	Если НЕ ЗначениеЗаполнено(Объект.КаталогНач1) Тогда
		Объект.КаталогНач1 = Каталог; 
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КаталогНач2) Тогда
		Объект.КаталогНач2 = Каталог;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.КаталогНач3) Тогда
		Объект.КаталогНач3 = Каталог;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Каталог) Тогда
		Объект.Каталог = Каталог;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Период) Тогда
		Объект.Период = КонецМесяца(ТекущаяДата());
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(Объект.кр_Каталог) Тогда
		Объект.кр_Каталог = Каталог;
	КонецЕсли; 
	
	Объект.ВидВыгрузки = Перечисления.бит_ВидВыгрузкиГЦЖС.Льготы;
	//21.11.2018
	Объект.НовыйФорматВыгрузки = Истина;
	Объект.ТипОтчета = "Отчет";
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	СтатусКвартиры.ТипЗначения = Новый ОписаниеТипов("СправочникСсылка.бит_СтатусыКвартиры");
	ТипКвартиры.ТипЗначения    = Новый ОписаниеТипов("СправочникСсылка.бит_ТипыКвартиры");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(СтрокаКонецПериода) Тогда
		СтрокаКонецПериода = бит_РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(Объект.Период);
	КонецЕсли; 	
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СтрокаКонецПериодаПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(СтрокаКонецПериода) или СтрокаКонецПериода = "Структура" Тогда
		
		СтрокаКонецПериода = бит_РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(Объект.Период);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаКонецПериодаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	НачальнаяДатаДокумента = Объект.Период;
	
	бит_РаботаСДиалогами.НачалоВыбораИзСпискаПредставленияПериодаРегистрации(
	Элемент, СтандартнаяОбработка, Объект.Период, ЭтаФорма);
	СтрокаКонецПериода = бит_РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(Объект.Период);
	Объект.Период = КонецМесяца(Объект.Период);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаКонецПериодаОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаКонецПериодаРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	НачальнаяДатаДокумента = Объект.Период;
	
	ТекущаяДата = ?(Направление > 0, Объект.Период, ДобавитьМесяц(Объект.Период, -1));
	бит_РаботаСДиалогами.РегулированиеПредставленияПериодаРегистрации(
	Направление, СтандартнаяОбработка, ТекущаяДата, СтрокаКонецПериода);
	Объект.Период = КонецМесяца(ТекущаяДата);
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог   = Объект[Элемент.Имя];
	Диалог.Заголовок = "Укажите каталог...";
	
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Объект[Элемент.Имя]  = Диалог.Каталог;
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогОткрытие(Элемент, СтандартнаяОбработка)
	
	ЗапуститьПриложение(Объект[Элемент.Имя]);
	СтандартнаяОбработка = ЛОЖЬ;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидВыгрузкиПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборСтатусКвПриИзменении(Элемент)
	УправлениеЭлементамиФормыНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборТипКвПриИзменении(Элемент)
	УправлениеЭлементамиФормыНаКлиенте();
КонецПроцедуры

&НаКлиенте
Процедура РегионВыгрузкиПриИзменении(Элемент)
	
	Если Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.Иркутск
		ИЛИ Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.КрасноярскийКрай Тогда
		
		Объект.ВидВыгрузки = мКэшЗначений.Перечисления.бит_ВидВыгрузкиГЦЖС.Льготы;
		
	КонецЕсли; 
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСоответствийПередУдалением(Элемент, Отказ)
	Отказ = Истина;
КонецПроцедуры

&НаКлиенте
Процедура СтрокаКонецПериодаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыВыбора = Новый Структура("НачалоПериода, КонецПериода", НачалоМесяца(Объект.Период), КонецМесяца(Объект.Период));
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериодаМесяц", ПараметрыВыбора, Элементы.СтрокаКонецПериода, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаКонецПериодаАвтоПодбор(Элемент, Текст, ДанныеВыбора, Параметры, Ожидание, СтандартнаяОбработка)
	
	бит_РаботаСДиалогами.ДатаКакМесяцАвтоПодборТекста(Текст, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлExcelНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	// Создается диалог для открытия файла Excel.
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	// Зададим фильтр для диалога.
	Диалог.Фильтр = "Все файлы Excel (*.xls, *.xlsx)|*.xls; *.xlsx|" 
	+ "Файлы Excel (*.xlsx)|*.xlsx|Файлы Excel 97-2003 (*.xls)|*.xls|";
	
	Если Диалог.Выбрать() Тогда
		// Сохраняет имя выбранного файла.
		Объект.ФайлExcel = Диалог.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлExcelОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ИмяФайла = СокрЛП(Объект.ФайлExcel);
	
	ОткрываемыйФайл = Новый Файл(ИмяФайла);
	Если ОткрываемыйФайл.Существует() Тогда
		ЗапуститьПриложение(ИмяФайла);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыДействияКомандныхПанелейФормы

&НаКлиенте
Процедура Выгрузить(Команда)	
	
	//02.08.2019
	если ЗначениеЗаполнено(Объект.РегионВыгрузки) = ложь тогда
		
		Сообщить("Не заполнен регион выгрузки");
		возврат;
		
	конецесли;
	
	//02.08.2019
	если Объект.ВидВыгрузки = мКэшЗначений.Перечисления.бит_ВидВыгрузкиГЦЖС.Льготы тогда
		//13.02.2019  
		если Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.Москва тогда
		  если ЗначениеЗаполнено(Объект.Каталог) = ложь тогда		
		     Сообщить("Не заполнен Каталог выгрузки");
		     возврат;
		  конецесли;	
		  КаталогНаДиске = Новый Файл(Объект.Каталог);
	    конецесли;
		
		если Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.КрасноярскийКрай тогда
		  если ЗначениеЗаполнено(Объект.кр_Каталог) = ложь тогда		
		       Сообщить("Не заполнен Каталог выгрузки");
		       возврат;
		  конецесли;		
		  КаталогНаДиске = Новый Файл(Объект.кр_Каталог);
		  Объект.Каталог = Объект.кр_Каталог;
	    конецесли;
		
		// БИТ ЖКХ 15.01.2020
	    если Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.Иркутск тогда
		  если ЗначениеЗаполнено(Объект.ФайлExcel) = ложь тогда		
		       Сообщить("Не заполнен Каталог выгрузки");
		       возврат;
		  конецесли;		
		  КаталогНаДиске = Новый Файл(Объект.КаталогНач1);
		  Объект.Каталог = Объект.КаталогНач1;
	    конецесли;
     
	    Если КаталогНаДиске.Существует() = Ложь Тогда
	        
	        Ответ = Вопрос("Каталог не существует. Создать?", 
	                        РежимДиалогаВопрос.ОКОтмена);
		    Если Ответ = КодВозвратаДиалога.ОК Тогда
			  если ЗначениеЗаполнено(Объект.Каталог) = ложь тогда		
		       Сообщить("Не заполнен Каталог выгрузки");
		       возврат;
			  конецесли;			        				
	          СоздатьКаталог(Объект.Каталог);            
	        Иначе
	            Возврат;
			КонецЕсли;
			
		КонецЕсли;	
	конецесли;

	//02.08.2019
	если Объект.ВидВыгрузки = мКэшЗначений.Перечисления.бит_ВидВыгрузкиГЦЖС.Начисления тогда
		//13.02.2019  
		если Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.Москва тогда
		  если ЗначениеЗаполнено(Объект.КаталогНач1) = ложь тогда		
		     Сообщить("Не заполнен Каталог выгрузки");
		     возврат;
		  конецесли;	
		  КаталогНаДиске = Новый Файл(Объект.КаталогНач1);
		  Если КаталогНаДиске.Существует() = Ложь Тогда
			  
			стрВопроса = строка("Каталог ") + строка(КаталогНаДиске.ПолноеИмя) + " не существует. Создать?" ;  
	        Ответ = Вопрос(стрВопроса, 
	                        РежимДиалогаВопрос.ОКОтмена);
		    Если Ответ = КодВозвратаДиалога.ОК Тогда
			  если ЗначениеЗаполнено(Объект.КаталогНач1) = ложь тогда		
		       Сообщить("Не заполнен Каталог выгрузки");
		       возврат;
			  конецесли;			        				
	          СоздатьКаталог(Объект.КаталогНач1);            
	        Иначе
	            Возврат;
			КонецЕсли;
			
		  КонецЕсли;
		
		  если ЗначениеЗаполнено(Объект.КаталогНач2) = ложь тогда		
		     Сообщить("Не заполнен Каталог выгрузки");
		     возврат;
		  конецесли;	
		  КаталогНаДиске = Новый Файл(Объект.КаталогНач2);
		  Если КаталогНаДиске.Существует() = Ложь Тогда
			  
			стрВопроса = строка("Каталог ") + строка(КаталогНаДиске.ПолноеИмя) + " не существует. Создать?" ; 
	        Ответ = Вопрос(стрВопроса, 
	                        РежимДиалогаВопрос.ОКОтмена);
		    Если Ответ = КодВозвратаДиалога.ОК Тогда
			  если ЗначениеЗаполнено(Объект.КаталогНач2) = ложь тогда		
		       Сообщить("Не заполнен Каталог выгрузки");
		       возврат;
			  конецесли;			        				
	          СоздатьКаталог(Объект.КаталогНач2);            
	        Иначе
	            Возврат;
			КонецЕсли;
			
		  КонецЕсли;	

		   если ЗначениеЗаполнено(Объект.КаталогНач3) = ложь тогда		
		     Сообщить("Не заполнен Каталог выгрузки");
		     возврат;
		  конецесли;	
		  КаталогНаДиске = Новый Файл(Объект.КаталогНач3);
		  Если КаталогНаДиске.Существует() = Ложь Тогда
			  
 		    стрВопроса = строка("Каталог ") + строка(КаталогНаДиске.ПолноеИмя) + " не существует. Создать?" ; 
	        Ответ = Вопрос(стрВопроса, 
	                        РежимДиалогаВопрос.ОКОтмена);
		    Если Ответ = КодВозвратаДиалога.ОК Тогда
			  если ЗначениеЗаполнено(Объект.КаталогНач3) = ложь тогда		
		       Сообщить("Не заполнен Каталог выгрузки");
		       возврат;
			  конецесли;			        				
	          СоздатьКаталог(Объект.КаталогНач3);            
	        Иначе
	            Возврат;
			КонецЕсли;
			
		  КонецЕсли;	


	    конецесли;
		
		если Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.КрасноярскийКрай тогда
		  если ЗначениеЗаполнено(Объект.кр_Каталог) = ложь тогда		
		       Сообщить("Не заполнен Каталог выгрузки");
		       возврат;
		  конецесли;		
		  КаталогНаДиске = Новый Файл(Объект.кр_Каталог);
		  Объект.Каталог = Объект.кр_Каталог;
	    конецесли;
     
	    Если КаталогНаДиске.Существует() = Ложь Тогда
	        
	        Ответ = Вопрос("Каталог не существует. Создать?", 
	                        РежимДиалогаВопрос.ОКОтмена);
		    Если Ответ = КодВозвратаДиалога.ОК Тогда
			  если ЗначениеЗаполнено(Объект.КаталогНач1) = ложь тогда		
		       Сообщить("Не заполнен Каталог выгрузки");
		       возврат;
			  конецесли;			        				
	          СоздатьКаталог(Объект.Каталог);            
	        Иначе
	            Возврат;
			КонецЕсли;
			
		КонецЕсли;	
	конецесли;

	
	
	Если СтроковыеФункцииКлиентСервер.ТолькоЦифрыВСтроке(Объект.НомерДоговора) = Ложь Тогда
	  бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("В поле номера договора разрешены только цифры");
	  возврат;
	Конецесли;	
	//----
	Если Объект.ВидВыгрузки = мКэшЗначений.Перечисления.бит_ВидВыгрузкиГЦЖС.Льготы Тогда
		
		ВыгрузитьЛьготы();
		
	ИначеЕсли Объект.ВидВыгрузки = мКэшЗначений.Перечисления.бит_ВидВыгрузкиГЦЖС.Начисления Тогда
		
		ВыгрузитьНачисления();
		
	Иначе

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не указан вид выгрузки.");
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Настройка(Команда)
	
	ОткрытьФорму("Обработка.бит_ВыгрузкаВГЦЖС.Форма.ФормаНастройки",,,,,, Новый ОписаниеОповещения("НастройкаЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьНаименования(Команда)
	
	Месяц = Формат(КонецМесяца(Объект.Период), "ДФ=MM");
	Год   = Формат(КонецМесяца(Объект.Период), "ДФ=yy");
	
	Объект.кр_ИмяФайлаКвартиросъемщики = "S" + Год + Месяц + "-01"; 
	Объект.кр_ИмяФайлаОплатыУслуг      = "S" + Год + Месяц + "-02"; 
	Объект.кр_ИмяФайлаСведения         = "S" + Год + Месяц + "-2a"; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборЛС(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"       , Объект.Организация);
	ПараметрыФормы.Вставить("Дата"              , Объект.Период);
	ПараметрыФормы.Вставить("ОткрытоИзДокумента", Истина);
	
	ОткрытьФорму("Обработка.бит_ПодборЛицевыхСчетов.Форма", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);	
	
КонецПроцедуры

&НаКлиенте
Процедура ПрочитатьСтруктуруExcel(Команда)
	
	ВсеРеквизитыЗаполнены = ПроверитьЗаполнение();
	
	Если ВсеРеквизитыЗаполнены Тогда
		
		ПодготовитьВыгрузкуВExcel()
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьДанные(Команда)
	
	ОбновитьТаблицуДанных();
	
КонецПроцедуры

&НаКлиенте
Процедура ПредворительныйПросмотр(Команда)
	
	ТабличныйДокумент = СформироватьТаблицуПроверки();
	
	Если НЕ ТабличныйДокумент = Неопределено И ТабличныйДокумент.ВысотаТаблицы > 0 Тогда
		
		ТабличныйДокумент.Показать();
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

