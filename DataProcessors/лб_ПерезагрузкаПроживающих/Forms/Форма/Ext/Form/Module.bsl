&НаСервере
Процедура ОбновитьУслугиНеНачислятьНаСервере()
	// Вставить содержимое обработчика.
	Запрос = новый запрос;	
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
		|ПОМЕСТИТЬ ИмеющиесяУслугуЛС
		|ИЗ
		|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(, Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛС,
		|	бит_ЛицевыеСчета.Здание.Участок КАК Подучасток,
		|	бит_ЛицевыеСчета.Организация КАК Организация
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИмеющиесяУслугуЛС КАК ИмеющиесяУслугуЛС
		|		ПО бит_ЛицевыеСчета.Ссылка = ИмеющиесяУслугуЛС.ЛицевойСчет
		|ГДЕ
		|	ИмеющиесяУслугуЛС.ЛицевойСчет ЕСТЬ NULL
		|ИТОГИ ПО
		|	Организация,
		|	Подучасток";
	
	ВыборкаУслуга = Справочники.бит_УслугиЖКХ.Выбрать();
	Пока ВыборкаУслуга.Следующий() цикл
		Услуга = ВыборкаУслуга.Ссылка;
		Если Услуга.ПометкаУдаления или Услуга.Поставщики.Количество()=0 тогда
			продолжить
		КонецЕсли;	
		Запрос.УстановитьПараметр("Услуга",Услуга);
		РезультатЗапроса = Запрос.Выполнить();	
		Если РезультатЗапроса.Пустой() тогда
			продолжить
		КонецЕсли;
		
		Поставщик = Услуга.Поставщики[0];
		СпособРасчета = Услуга.ОсновнойСпособРасчета;
		РежимПотребления = Справочники.бит_РежимыПотребленияУслуг.НеНачислять;

		ВыборкаОрганизация =  РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОрганизация.Следующий() цикл
			ВыборкаПодучасток = ВыборкаОрганизация.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПодучасток.Следующий() цикл
				Док = Документы.бит_УстановкаИзменениеУслугПоЛС.СоздатьДокумент();
				Док.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета;
				Док.Услуга = ВыборкаПодучасток.Услуга;
				Док.Дата = '2018-12-30';
				Док.Комментарий = "Установка БЕЗ НАЧИСЛЕНИЙ для ЛС подучасток" + ВыборкаПодучасток.Подучасток;
				Табл = Док.ЛицевыеСчета.Выгрузить(); 
				
				ВыборкаЛС = ВыборкаПодучасток.Выбрать();
				Пока ВыборкаЛС.Следующий() цикл НовСтрока = Табл.Добавить(); НовСтрока.ЛицевойСчет = ВыборкаЛС.ЛС; КонецЦикла;
				
				Табл.ЗаполнитьЗначения(Поставщик,"Поставщик");
				Табл.ЗаполнитьЗначения(РежимПотребления,"РежимПотребления");
				Табл.ЗаполнитьЗначения(СпособРасчета,"СпособРасчета");
				Док.ЛицевыеСчета.Загрузить(Табл);
				//Док.Записать(РежимЗаписиДокумента.Запись);
				Док.Записать(РежимЗаписиДокумента.Проведение);   		
							
			КонецЦикла;	//документ
		КонецЦикла;	//организация	
		
	КонецЦикла;
	
	
	
	
	
	
	ВыборкаУслуга = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаУслуга.Следующий() цикл
		Услуга =  ВыборкаУслуга.Услуга;
		Если ложь тогда Услуга = Справочники.бит_УслугиЖКХ.Выбрать().Ссылка КонецЕсли;
	КонецЦикла;	//услуга
	
КонецПроцедуры

