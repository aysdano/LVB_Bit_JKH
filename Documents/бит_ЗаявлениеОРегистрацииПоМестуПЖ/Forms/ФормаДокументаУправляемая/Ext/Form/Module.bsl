&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Объект.ФизическиеЛица.Очистить();
	
	Объект.РегистрируемоеЛицо		  = Неопределено;
	Объект.ДолжностноеЛицо			  = Неопределено;
	Объект.ЛицевойСчет		          = Неопределено;
	Объект.ОтветственныйЗаРегистрацию = Неопределено;
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ФормаВыбора = ПолучитьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая",,Элемент);
	
	ОтборОрганизации = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОрганизации.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Организация");
	ОтборОрганизации.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборОрганизации.ПравоеЗначение = Объект.Организация;
	
	ФормаВыбора.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура РегистрируемоеЛицоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеВСвязиСоСмертью") 
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета") Тогда
		
		ДанныеВыбора = ПолучитьСписокПроживающих(Объект.ЛицевойСчет, Объект.Дата);
		
	Иначе
		
		ФормаВыбора = ОткрытьФорму("Справочник.бит_Проживающие.Форма.ФормаВыбораУправляемая",Новый Структура("ТекущаяСтрока", Объект.РегистрируемоеЛицо),Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтветственныйЗаРегистрациюНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка 	= Ложь;
	
	ОткрытьФорму("Справочник.бит_Проживающие.Форма.ФормаВыбораУправляемая",,Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткудаПрибылПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Объект.ОткудаПрибыл               = Неопределено;
	Объект.СвидетельствоОСмерти       = "";
	Объект.ОтветственныйЗаРегистрацию = Неопределено;
	Объект.ОрганФМС                   = Неопределено;
	//Объект.ДатаРегистрации            = Неопределено;
	
	//Объект.ДатаСнятияСРегистрации     = Неопределено;
	//Объект.СнимаемыеСРегУчета.Очистить();
	//Объект.ОтветственныеЗаРегистрацию.Очистить();
	//Объект.ПравоустанавливающиеДокументы.Очистить();
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Функция Сформировать(ИмяМакета)
	
	// Получить экземпляр документа на печать.
	Если ИмяМакета = "ЗОРПМЖ" тогда
		
		ТабДокумент = ПечатьЗОРПМЖ();
		
	ИначеЕсли ИмяМакета = "КР_New" тогда
		
		ТабДокумент = ПечатьКР();
		
	ИначеЕсли ИмяМакета = "ЛСУП" тогда
		
		ТабДокумент = ПечатьЛСУП();
		
	ИначеЕсли ИмяМакета = "ЗОССРУПМЖ" тогда
		
		ТабДокумент = ПечатьЗОССРУПМЖ(Ложь);
		
	ИначеЕсли ИмяМакета = "ЗОССРУПМЖ_2части" тогда
		
		ТабДокумент = ПечатьЗОССРУПМЖ(Истина);
		
	ИначеЕсли ИмяМакета = "АЛУ" тогда
		
		ВидМакета = истина;
		ТабДокумент = ПечатьАЛУ(ВидМакета);
		
	ИначеЕсли ИмяМакета = "АЛУ_стар" тогда
		
		ВидМакета = ложь;
		ТабДокумент = ПечатьАЛУ(ВидМакета);
		
	ИначеЕсли ИмяМакета = "ЛСУВ" тогда
		
		ТабДокумент = ПечатьЛСУВ();
		
	ИначеЕсли ИмяМакета = "УВОРУ" тогда
		
		ТабДокумент = ПечатьУВОРУ();
		
	ИначеЕсли  ИмяМакета = "АЛП" тогда	
		
		ВидМакета = Истина;
		ТабДокумент = ПечатьАЛП(ВидМакета);
		
	ИначеЕсли  ИмяМакета = "АЛП_стар" тогда	
		
		ВидМакета = Ложь;
		ТабДокумент = ПечатьАЛП(ВидМакета);
		
	ИначеЕсли  ИмяМакета = "Анкета" тогда	
		
		ТабДокумент = ПечатьАнкета();
		
	ИначеЕсли  ИмяМакета = "СОРГ_РФ_ПМЖ" тогда	
		
		ТабДокумент = ПечатьСОРГ_РФ_ПМЖ();
		
	ИначеЕсли  ИмяМакета = "СОРГ_РФ_ПМЖ_Old" тогда	
		
		ТабДокумент = ПечатьСОРГ_РФ_ПМЖ(Ложь);
		
	ИначеЕсли ИмяМакета = "СОРПМП" Тогда
		
		ТабДокумент = ПечатьСОРПМП();
		
	ИначеЕсли ИмяМакета = "СОРПМПЖ" Тогда
		
		ТабДокумент = ПечатьСОРПМПЖ();
		
	ИначеЕсли ИмяМакета = "ЗаявлениеСНГ1" Тогда
		
		ТабДокумент = ПечатьЗаявление(Ложь);
		
	ИначеЕсли ИмяМакета = "ЗаявлениеРФ1" Тогда
		
		ТабДокумент = ПечатьЗаявление();
		
	ИначеЕсли ИмяМакета = "ЗаявлениеСНГ2" Тогда
		
		ТабДокумент = ПечатьЗаявление(Ложь, Ложь);
		
	ИначеЕсли ИмяМакета = "ЗаявлениеРФ2" Тогда
		
		ТабДокумент = ПечатьЗаявление(, Ложь);
		
	ИначеЕсли ИмяМакета = "СопроводительноеПисьмо" Тогда
		
		ТабДокумент = ПечатьСопроводительноеПисьмо();
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Функция ПечатьСопроводительноеПисьмо()
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Проживающий КАК Проживающий,
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.ДатаРегистрации КАК ДатаРегистрации,
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.ОрганФМС КАК ОрганФМС,
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Проживающий.ДатаРождения КАК ПроживающийДатаРождения,
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.ОрганФМСКудаПрибыл КАК ОрганФМСКудаПрибыл,
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.ОткудаПрибылАдрес КАК ОткудаПрибылАдрес,
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.ОрганФМСКудаПрибыл.Руководитель КАК ОрганФМСКудаПрибылРуководитель,
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.КудаВыписанАдрес КАК КудаВыписанАдрес,
	               |	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК ПредставлениеКвартирыЛС
	               |ИЗ
	               |	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ.СнимаемыеСРегУчета КАК бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
	               |		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	               |ГДЕ
	               |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент", Объект.Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ОсновныеРеквизитыЗаполнены = Ложь;
	
	ОрганФМСВыбытия = "";
	ОткудаыПрибылАдрес = "";
	ОрганФМСКудаПрибыл = "";
	
	РегЛицаСтр = "";
	КоличествоПроживающих = 0;
	
	АдрПриб = ЭтаФорма.КонтактнаяИнформацияПолеОткудаПрибылПредставление;
	
	Пока Выборка.Следующий() Цикл
		Если НЕ ОсновныеРеквизитыЗаполнены Тогда
			
			ОрганФМСВыбытия = Выборка.ОрганФМС;			
			ОткудаПрибылАдрес = АдрПриб;
			ОрганФМСКудаПрибыл = Выборка.ОрганФМСКудаПрибыл;	
			
			ОсновныеРеквизитыЗаполнены = Истина;
			
		КонецЕсли;
		
		РегЛицаСтр = РегЛицаСтр + Выборка.Проживающий + " " 
		+ ?(ЗначениеЗаполнено(Выборка.ПроживающийДатаРождения),Формат(Выборка.ПроживающийДатаРождения,"ДФ=dd.MM.yyyy" ) + "г.р", "")
		+ "; ";
		
		КоличествоПроживающих = КоличествоПроживающих + 1;
		
	КонецЦикла;
	
	РегЛицаСтр = УбратьПоследнийСимвол(РегЛицаСтр, ";") + ".";
	
	ТабДокумент = Новый ТабличныйДокумент;
	Макет = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("СопроводительноеПисьмо");
	
	ОбластьШапка   = Макет.ПолучитьОбласть("Шапка");
	ОбластьРегЛицо = Макет.ПолучитьОбласть("РегЛица");
	ОбластьПодписьРегЛица = Макет.ПолучитьОбласть("ПодписьРегЛица");
	ОбластьАдрес  = Макет.ПолучитьОбласть("Адрес");
	ОбластьАдресДопСтрока = Макет.ПолучитьОбласть("АдресДопСтрока");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	Если КоличествоПроживающих > 1 Тогда		
		
		ОбластьАдрес.Параметры.СтрокаФормы = "которые обратились к нам по вопросу регистрации по м/ж в гор. Омске, были зарегистрированы" 	
	Иначе 
		
		ОбластьАдрес.Параметры.СтрокаФормы = "который(а) обратился к нам по вопросу регистрации по м/ж в гор. Омске, был(а) зарегистрирован(а)" 	
	КонецЕсли;
	
	//Орган ФМС Выбытия
	ОФМСВыбытия1 = "";
	ОФМСВыбытия2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки("" + ОрганФМСВыбытия, 42, ОФМСВыбытия1, ОФМСВыбытия2);
	
	ОбластьШапка.Параметры.ОрганФМСВыбытия1  = ОФМСВыбытия1;
	ОбластьШапка.Параметры.ОрганФМСВыбытия2  = ОФМСВыбытия2;
	
	//Лица снятые с регистрации
	РегЛицо1 = "";                          
	РегЛицо2 = "";

// + Мурас Д.А. 16.02.2023 - Задача 6826 - некорректный перенос Фамилии Имени Отчества
// Отключена процедура: бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки по причине 
// необходимости отключить переносы (запрещено переносить имена собственные, русский язык 4 класс)
// Отключен перенос по слогам, изменен перенос по словам в ФИО:

//	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(РегЛицаСтр , 15, РегЛицо1, РегЛицо2);
	
	Длина = 19;
	Если СтрДлина(РегЛицаСтр) <= Длина Тогда
		РегЛицо1 = РегЛицаСтр;
		РегЛицо2 = "";
	Иначе
		КонецСлова = Длина + 1;
		ПоказательДлины = Сред(РегЛицаСтр, КонецСлова, 1);
		Пока ПоказательДлины <> " " И КонецСлова > 0  Цикл
			ПоказательДлины = Сред(РегЛицаСтр, КонецСлова, 1);
			КонецСлова = КонецСлова - 1;
		КонецЦикла;
		РегЛицо1 = Лев(РегЛицаСтр, КонецСлова);
		РегЛицо2 = Прав(РегЛицаСтр, СтрДлина(РегЛицаСтр) - КонецСлова - 1);
	КонецЕсли;
// - Мурас Д.А. 16.02.2023

	ОбластьШапка.Параметры.РегЛицо1 = РегЛицо1;
	
	ТабДокумент.Вывести(ОбластьШапка);
	
	//Цикл
	ДлиннаРегЛица = СтрДлина(РегЛицаСтр);
	ДлиннаТекСтроки = 15;
	ПерваяСтрока = Истина;	
	Пока ДлиннаТекСтроки < ДлиннаРегЛица  Цикл
		
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(РегЛицо2, 85, РегЛицо1 , РегЛицо2 );
		ОбластьРегЛицо.Параметры.РегЛицо2 = РегЛицо1;
		ДлиннаТекСтроки = ДлиннаТекСтроки + 85;
		ТабДокумент.Вывести(ОбластьРегЛицо);
		Если ПерваяСтрока Тогда
			
			ПерваяСтрока= Ложь;
			ТабДокумент.Вывести(ОбластьПодписьРегЛица);
			
		КонецЕсли;	
		
	КонецЦикла;		
	
	//Адрес регистрации
	ОткудаПрибылАдрес1 = "";
	ОткудаПрибылАдрес2 = "";
	
	ОткудаПрибылАдрес = ОткудаПрибылАдрес +  ?(Не Объект.ОткудаПрибылИзЛС, ", кв. " + Выборка.ПредставлениеКвартирыЛС, "");
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ОткудаПрибылАдрес, 80, ОткудаПрибылАдрес1, ОткудаПрибылАдрес2);
	
	ОбластьАдрес.Параметры.АдресРегистрацииПоМЖ1 = ОткудаПрибылАдрес1;
	ТабДокумент.Вывести(ОбластьАдрес);
	Если НЕ ОткудаПрибылАдрес2 = "" Тогда
		
		ОбластьАдресДопСтрока.Параметры.АдресРегистрацииПоМЖ2 = ОткудаПрибылАдрес2;
		ТабДокумент.Вывести(ОбластьАдресДопСтрока);
		
	КонецЕсли;
	
	//ОрганФМС Куда прибыл
	ОФМС1 = "";
	ОФМС2 = "";
	
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки("" + Выборка.ОрганФМСКудаПрибыл, 45, ОФМС1, ОФМС2);
	ОбластьПодвал.Параметры.ОрганФМС1 = ОФМС1; 
	ОбластьПодвал.Параметры.ОрганФМС2 = ОФМС2;
	ОбластьПодвал.Параметры.ФИОИнициалы = ПолучитьИнициалы(Выборка.ОрганФМСКудаПрибылРуководитель);
	ТабДокумент.Вывести(ОбластьПодвал);
	
	ПустаяОбласть = Макет.ПолучитьОбласть("Пустая"); 
	
	ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	
	ТабДокумент2 = Новый ТабличныйДокумент;
	Макет2 =	Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("СопроводительноеПисьмо");
	ПустаяОбласть2 = Макет2.ПолучитьОбласть("Пустая");
	МассивОбластей2 = Новый Массив;
	МассивОбластей2.Добавить(ПустаяОбласть2);
	МассивОбластей2.Добавить(ПустаяОбласть2);
	
	Пока ТабДокумент2.ПроверитьВывод(МассивОбластей2) Цикл
		ТабДокумент2.Вывести(ПустаяОбласть2);	
	КонецЦикла;
	
	ВысотаСтраницы = ВысотаОбластиТабДока(ТабДокумент2);
	
	ОбластьОбратнаяСторона = Макет.ПолучитьОбласть("ОбратнаяСторона");
	
	МассивОбластей = Новый Массив;
	МассивОбластей.Добавить(ПустаяОбласть);
	МассивОбластей.Добавить(ОбластьОбратнаяСторона);
	
	ВысотаОбратнойСтороны = ВысотаОбластиТабДока(ОбластьОбратнаяСторона);
	ВысотаПустойОбласти = (ВысотаСтраницы/2)-ВысотаОбратнойСтороны;
	
	ПустаяОбластьТД = ТабДокумент.Вывести(ПустаяОбласть);
	
	ПустаяОбластьТД.ВысотаСтроки = ВысотаПустойОбласти;
	
	ТабДокумент.Вывести(ОбластьОбратнаяСторона);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция вызывает форму печати табличного документа с печатной формой.
// Инвентаризационной описи основных средств.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Неопределено.
//
Функция ПечатьЗОРПМЖ()
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	// Добавление ФИО ответственного за регистрацию из регистра.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация КАК Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий КАК Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо КАК РегистрируемоеЛицо,
	|	ВЫБОР
	|		КОГДА бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения ЕСТЬ NULL
	|				ИЛИ бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ &Момент < бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ РАЗНОСТЬДАТ(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, &Момент, ГОД)
	|	КОНЕЦ КАК РегЛицоВозраст,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование КАК ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл КАК ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации КАК ВидОперации,
	|	ФИОФизЛицСрезПоследних.Фамилия КАК Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя КАК Имя,
	|	ФИОФизЛицСрезПоследних.Отчество КАК Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид КАК ВидДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачи,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДатаРегистрацииПоМестуЖительства КАК ДатаРегистрацииПоМестуЖительства,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументКодПодразделения КАК ДокументКодПодразделенияПред,
	|	бит_СвидетельствоОРегистрацииПоМестуПребывания.Дата КАК ДатаСвидетельства,
	|	бит_СвидетельствоОРегистрацииПоМестуПребывания.Номер КАК НомерСвидетельства,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия КАК ФамилияПред,
	|	бит_ФИОПроживающихСрезПоследних.Имя КАК ИмяПред,
	|	бит_ФИОПроживающихСрезПоследних.Отчество КАК ОтчествоПред,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата КАК Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.СтепеньРодства КАК СтепеньРодства,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо КАК ДолжностноеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдрес КАК ОткудаПрибылАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдрес КАК КудаВыписанАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаПрибытия КАК ДатаПрибытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаУбытия КАК ДатаУбытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПериодРегистрацииПоПрежнемуАдресуС КАК ПериодРегистрацииПоПрежнемуАдресуС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПериодРегистрацииПоПрежнемуАдресуПо КАК ПериодРегистрацииПоПрежнемуАдресуПо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЗаконныйПредставитель КАК ЗаконныйПредставитель,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЗаконныйПредставительВСвязиСНедееспособностью КАК ЗаконныйПредставительВСвязиСНедееспособностью,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.СтепеньРодстваЗаконногоПредставителя КАК СтепеньРодстваЗаконногоПредставителя,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМСКудаПрибыл КАК ПаспортнаяСлужба,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМСКудаПрибыл КАК ОрганФМСКудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.Наименование КАК ПринятоеРешениеНаименование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМСКудаПрибыл.Должность КАК ДолжностьДЛО,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМСКудаПрибыл.Руководитель КАК ОрганФМСКудаПрибылРуководитель,
	|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК ПредставлениеКвартирыЛС
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК ФИОФизЛицСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЗаконныйПредставитель = ПаспортныеДанныеФизЛицСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_СвидетельствоОРегистрацииПоМестуПребывания КАК бит_СвидетельствоОРегистрацииПоМестуПребывания
	|		ПО (бит_СвидетельствоОРегистрацииПоМестуПребывания.ДокументОснование = бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЗаконныйПредставитель = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗапросПравоустанавливающиеДокументы = Новый Запрос;
	ЗапросПравоустанавливающиеДокументы.Текст = "ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖПравоустанавливающиеДокументы.Документ КАК Документ
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПравоустанавливающиеДокументы КАК бит_ЗаявлениеОРегистрацииПоМестуПЖПравоустанавливающиеДокументы
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖПравоустанавливающиеДокументы.Ссылка.Ссылка = &Ссылка
	|	И бит_ЗаявлениеОРегистрацииПоМестуПЖПравоустанавливающиеДокументы.ВыводитьВПФ ";
	ЗапросПравоустанавливающиеДокументы.УстановитьПараметр("Ссылка", Объект.Ссылка);
	ВыборкаПДок = ЗапросПравоустанавливающиеДокументы.Выполнить().Выбрать();
	СтрПДок = "";
	Пока ВыборкаПДок.Следующий() Цикл
		СтрПДок = СтрПДок + ВыборкаПДок.Документ + " № " + ВыборкаПДок.Документ.НомерДокумента + " от " + Формат(ВыборкаПДок.Документ.ДатаДокумента, "ДФ=dd.MM.yy") + ", ";
	КонецЦикла;
	
	СтрПДок = УбратьПоследнийСимвол(СтрПДок, ",");
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) И ЗначениеЗаполнено(Выборка.ЛицевойСчет) Тогда
		
		ТабДокумент   = Новый ТабличныйДокумент();
		ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
		
		Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("ЗОРПМЖ_New");
		Шапка0Область  = Макет.ПолучитьОбласть("Шапка0");
		ЗаконныйПредставительОбласть = Макет.ПолучитьОбласть("ЗаконныйПредставитель");
		Шапка1Область = Макет.ПолучитьОбласть("Шапка1");
		ОтветственныеСтрокаОбласть = Макет.ПолучитьОбласть("ОтветственныеСтрока");
		ПодвалДоОбласть = Макет.ПолучитьОбласть("ПодвалДо");
		ПодвалПослеОбласть = Макет.ПолучитьОбласть("ПодвалПосле");		
		
		//Орган Учета
		ОрганУчета_1 = "";
		ОрганУчета_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ПаспортнаяСлужба, 60, ОрганУчета_1 , ОрганУчета_2 );
		Шапка0Область.Параметры.ОрганУчета1 = ОрганУчета_1;
		Шапка0Область.Параметры.ОрганУчета2 = ОрганУчета_2;
		
		//ФизЛицо
		Если ЗначениеЗаполнено(Выборка.Фамилия) Тогда
			ФИОФизЛицо = Строка(Выборка.Фамилия)+" "+ Строка(Выборка.Имя)+" "+Строка(Выборка.Отчество);
		Иначе
			ФИОФизЛицо = Строка(Выборка.РегистрируемоеЛицо) ;
		КонецЕсли;
		
		// Перевод в родительный падеж.
		ФизЛицо_Склон = "";
		ФизЛицо = ФИОФизЛицо;
		//ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФИОФизЛицо,2,Выборка.РегистрируемоеЛицо.Пол,ФизЛицо_Склон);
		//Если ИсходСклонения Тогда
		//	ФизЛицо = ФизЛицо_Склон;
		//КонецЕсли;	
		
		Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.ДатаРождения) Тогда
			Шапка0Область.Параметры.ФизЛицо =  ФизЛицо +", "+Строка(Формат (Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ='dd.MM.yyyy ""г.р.""'"));
		Иначе
			Шапка0Область.Параметры.ФизЛицо =  ФизЛицо;
		КонецЕсли; 
		
		//АдресПрибытия
		СтрокаАдресПрибытия = ЭтаФорма.КонтактнаяИнформацияПолеОткудаПрибылПредставление;
		
		Если ЗначениеЗаполнено(СтрокаАдресПрибытия) Тогда
			СтрокаАдресПрибытия = СтрокаАдресПрибытия 
			+ ?(ЗначениеЗаполнено(Выборка.ПериодРегистрацииПоПрежнемуАдресуС),", с " + Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуС,"ДФ=dd.MM.yyyy"), "") 
			+ ?(ЗначениеЗаполнено(Выборка.ПериодРегистрацииПоПрежнемуАдресуПо)," по " + Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуПо,"ДФ=dd.MM.yyyy"), "");
		КонецЕсли;
		
		АдресПрибытия_1 = "";
		АдресПрибытия_2 = "";
		
		Если ЗначениеЗаполнено(СтрокаАдресПрибытия) Тогда
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаАдресПрибытия, 80, АдресПрибытия_1, АдресПрибытия_2);
			Шапка0Область.Параметры.АдресПрибытия = АдресПрибытия_1;
			Шапка0Область.Параметры.АдресПрибытия2 = АдресПрибытия_2;
			
		КонецЕсли; 
		
		Шапка0Область.Параметры.Заполнить(Выборка);
		ТабДокумент.Вывести(Шапка0Область);
		
		//АдресРегистрации
		//НаборЗаписей = НЕОПРЕДЕЛЕНО;
		//бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
		//
		//ВыборкаПочтАдр = Неопределено;
		//Для каждого СтрокаНабор Из НаборЗаписей  Цикл
		//	Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
		//		И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
		//		Тогда 
		//		ВыборкаПочтАдр = СтрокаНабор;
		//	КонецЕсли;	
		//КонецЦикла;
		//
		//адресДляСправки = "";
		//попытка
		//	если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ВыборкаПочтАдр.Объект, "КонтактнаяИнформация") = истина И 
		//		ВыборкаПочтАдр.Объект.КонтактнаяИнформация <> неопределено И
		//		ВыборкаПочтАдр.Объект.КонтактнаяИнформация.Количество() > 0 тогда
		//		адресДляСправки = ПолучитьАдресДляСправки (ВыборкаПочтАдр.Объект.КонтактнаяИнформация[0].Значение);
		//	конецесли;           
		//исключение
		//	адресДляСправки = "";
		//конецпопытки;	
		
		АдресДляСправки = ПолучитьМуниципальныйАдресБСП(Объект.ЛицевойСчет);
		//ПодвалДоОбласть.Параметры.НаселенныйПунктРег = адресДляСправки.Представление;
		
		ПодвалДоОбласть.Параметры.НаселенныйПунктРег = "г. Омск";
		ПодвалДоОбласть.Параметры.УлицаРег    			= Выборка.УлицаРег;
		ПодвалДоОбласть.Параметры.ДомРег  				= ПолучитьНомерДома(Выборка.ДомРег);
		ПодвалДоОбласть.Параметры.КорпусРег   			= ПолучитьНомерКорпуса(Выборка.ДомРег);
		ПодвалДоОбласть.Параметры.КвартираРег 			= Выборка.ПредставлениеКвартирыЛС;
		
		//ЗаконныйПредставитель
		Если (НЕ Выборка.РегЛицоВозраст = Неопределено
			И  Выборка.РегЛицоВозраст <= 14) ИЛИ Выборка.ЗаконныйПредставительВСвязиСНедееспособностью Тогда
			
			ЗаконныйПредставитель_1 = "";
			ЗаконныйПредставитель_2 = "";
			
			Если ЗначениеЗаполнено(Выборка.ВидДокументаПред) Тогда
