
#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
Процедура ВыборДоступногоПоля(ВыбраннаяСтрока)
	
	Если ВыбраннаяСтрока.Поле = "Реквизиты"
		ИЛИ ВыбраннаяСтрока.Поле = "Строка: Таблица начислений" 
		ИЛИ ВыбраннаяСтрока.Поле = "Строка: Таблица счетчиков" 
		ИЛИ ВыбраннаяСтрока.Поле = "Строка: Таблица перерасчетов" Тогда
		Возврат;
	КонецЕсли; 
	
	// Перед началом добавления необходимо выделить область в табличном документе.
	Если НЕ ТипЗнч(ПолеТабличногоДокумента.ТекущаяОбласть) = Тип("ОбластьЯчеекТабличногоДокумента") Тогда
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ВыборДоступногоПоляЗавершение", ЭтотОбъект), НСтр("ru = 'Для переноса поля шаблона нужно выделить ячейку или область ячеек!'"));
		Возврат;
	Иначе
		ТекущаяОбласть = ПолеТабличногоДокумента.ТекущаяОбласть;
		ОбъединитьОбласть(ТекущаяОбласть.Имя);
	КонецЕсли;
	
	ИмяПоля = Строка(ВыбраннаяСтрока.Поле);
	
	ТекущаяОбласть.Заполнение       = ТипЗаполненияОбластиТабличногоДокумента.Параметр;
	ТекущаяОбласть.Параметр         = ИмяПоля;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборДоступногоПоляЗавершение(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.Предопределенный Тогда
		
		Отказ = Истина;
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Предопределенные элементы не редактируются.");
		Возврат;
		
	КонецЕсли; 
	
	ОбновитьДеревоПолей();
	
	ПолеТабличногоДокумента = Новый ТабличныйДокумент;
	ПолеТабличногоДокумента.Защита = Ложь;
	Элементы.Результат.Защита      = Ложь;
	// СправочникОбъект = ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.бит_ВариантыСчетовИзвещений"));.
	ПолеТабличногоДокумента = Объект.Ссылка.ШаблонПечатнойФормы.Получить(); 
	
	УправлениеВидимостьюЭлементовФормы();
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.КодФункции = "Результат = Новый ТабличныйДокумент;";
	КонецЕсли; 
	
КонецПроцедуры

