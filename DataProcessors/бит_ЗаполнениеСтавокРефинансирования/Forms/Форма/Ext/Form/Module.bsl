&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыФормы = Новый Структура;
		
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	
	ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.бит_УслугиЖКХ") Тогда
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("Услуга", ВыбранноеЗначение);
			
			СтрокаТабличнойЧасти = Объект.ТаблицаУслуг.НайтиСтроки(Отбор);
			
			Если СтрокаТабличнойЧасти.Количество() = 0 Тогда
				
				НоваяСтрока = Объект.ТаблицаУслуг.Добавить();
				
				НоваяСтрока.Услуга = ВыбранноеЗначение;
				НоваяСтрока.Начислять = истина;
				
				ставкаПроцент = ПолучитьСтавкуРефинансирования(Объект.Дата, Объект.ПериодНачисления);  	
				НоваяСтрока.Процент = ставкаПроцент.Процент;
				НоваяСтрока.Ставка = ставкаПроцент.Ставка;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

// БИТ ЖКХ 30.04.2020 
Функция ПолучитьСтавкуРефинансирования(ДатаСтавки, ПериодСтавки)

 ставкаСтруктура = новый Структура();	
 запрос = новый Запрос;
 запрос.Текст = "ВЫБРАТЬ
                |	бит_СтавкиРефинансированияСрезПоследних.Период КАК Период,
                |	бит_СтавкиРефинансированияСрезПоследних.Организация КАК Организация,
                |	бит_СтавкиРефинансированияСрезПоследних.Дата КАК Дата,
                |	бит_СтавкиРефинансированияСрезПоследних.Ставка КАК Ставка
                |ИЗ
                |	РегистрСведений.бит_СтавкиРефинансирования.СрезПоследних(&ДатаОбработки, ) КАК бит_СтавкиРефинансированияСрезПоследних
                |
                |УПОРЯДОЧИТЬ ПО
                |	Период УБЫВ";
				
 запрос.УстановитьПараметр("ДатаОбработки", ДатаСтавки);				
 
 таб = запрос.Выполнить().Выгрузить();
 ставкаРефинансирования = 0;	
 если таб.Количество() > 0 тогда	
  ставкаРефинансирования = таб[0].Ставка;	
 конецесли; 
 
 ставкаСтруктура.Вставить("Ставка",  ставкаРефинансирования);
 
 если ПериодСтавки.ЕдиницаСтавкиРефинансирования > 0 и
	    ПериодСтавки.ДоляСтавкиРефинансирования > 0 тогда
  ставкаСтруктура.Вставить("Процент",  ставкаРефинансирования*(ПериодСтавки.ЕдиницаСтавкиРефинансирования/ПериодСтавки.ДоляСтавкиРефинансирования));  
 иначе
  //если Объект.ПериодНачисления.ЕдиницаСтавкиРефинансирования > 0 тогда
   ставкаСтруктура.Вставить("Процент", 0);
  //конецесли; 
 конецесли; 
 
 возврат ставкаСтруктура;
  
КонецФункции // ПолучитьСтавкуРефинансирования()

