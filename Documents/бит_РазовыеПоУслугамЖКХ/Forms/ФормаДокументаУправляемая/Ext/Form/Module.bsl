&НаСервере
Функция ПолучитьУслуги(Период, ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга
		|ИЗ
		|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
		|			&Период,
		|			ЛицевойСчет = &ЛицевойСчет
		|				И (СпособРасчета = &СпособРасчета
		|					ИЛИ СпособРасчета = &СпособРасчета0)) КАК бит_СведенияПоУслугамЛССрезПоследних";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("СпособРасчета", Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади);
	Запрос.УстановитьПараметр("СпособРасчета0", Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади);
	
	РезультатЗапроса = Запрос.Выполнить();
	//Михайлов 05.02.2021 Начало работ
	Выборка = РезультатЗапроса.Выгрузить(); 	
	
	Массив = ОбщегоНазначения.ТаблицаЗначенийВМассив(Выборка);
	
    Возврат Массив;
	//КонецРабот
КонецФункции

&НаСервере
Функция ПолучитьПощадьКапРемонт()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
		|	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления
		|ИЗ
		|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(, ) КАК бит_СведенияПоУслугамЛССрезПоследних
		|ГДЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга = &Услуга
		//Михайлов 05.02.2021 начало работ
		|   И бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет = &ЛицевойСчет
		//Конец работ
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_СведенияПоУслугамЛССрезПоследних.Период УБЫВ";
		
	Запрос.УстановитьПараметр("Услуга", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000008")); //Капитальный ремонт (мин)
	//Михайлов 05.02.2021 Начало работ
	Запрос.УстановитьПараметр("ЛицевойСчет", объект.ЛицевойСчет);
	//конец работ
	РезультатЗапроса = Запрос.Выполнить().Выбрать();	
	
	Если РезультатЗапроса.Следующий() Тогда
		Возврат РезультатЗапроса.КоличествоЕдиницПотребления;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

