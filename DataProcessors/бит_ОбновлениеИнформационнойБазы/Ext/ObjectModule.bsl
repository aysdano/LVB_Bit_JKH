  если ПредопределенныйОбъект.Наименование = "Справочник ""Список зданий""" тогда 
   ПредопределенныйОбъект.Наименование =  "Список зданий";
  конецесли; 

  если ПредопределенныйОбъект.Наименование = "Справочник ""Счетчики""" тогда 
   ПредопределенныйОбъект.Наименование =  "Счетчики";
  конецесли; 
  
  запрос = новый Запрос;
