		Если Объект.ВыполнитьНачисления И Объект.ВыполнитьНачисленияПоСчетчикам Тогда
			
			Если ЗначениеЗаполнено(Выборка.ДокументПоСч) Тогда
				
				ДокументНачисленийПоСЧ = Выборка.ДокументПоСч.ПолучитьОбъект();

			Иначе
				ДокументНачисленийПоСЧ = Документы.бит_НачисленияПоСчетчикам.СоздатьДокумент();
				
				ДокументНачисленийПоСЧ.Дата        = КонецМесяца(Объект.ДатаЗакрытия) - 1;
				ДокументНачисленийПоСЧ.Организация = Объект.Организация;
				ДокументНачисленийПоСЧ.Улица       = Выборка.Улица;
				ДокументНачисленийПоСЧ.Здание      = Выборка.Здание;
				
				ДокументНачисленийПоСЧ.Ответственный = мОтветственный;
				ДокументНачисленийПоСЧ.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
				
			КонецЕсли;
			
			// Начисление по счетчикам.
			Если ТаблицаСчетчиков.Количество() > 0 ИЛИ ТаблицаРаспред.Количество() > 0 Тогда
				
				бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаСчетчиков);
				ДокументНачисленийПоСЧ.ЗаполнениеСчетовКУ(ТаблицаСчетчиков);
				ДокументНачисленийПоСЧ.Начисления.Очистить();
				ДокументНачисленийПоСЧ.Начисления.Загрузить(ТаблицаСчетчиков);
				
				бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаРаспред);
				ДокументНачисленийПоСЧ.ЗаполнениеСчетовКУ(ТаблицаРаспред);
				ДокументНачисленийПоСЧ.Распределения.Очистить();
				ДокументНачисленийПоСЧ.Распределения.Загрузить(ТаблицаРаспред);
				
				ДокументНачисленийПоСЧ.мУчетДнейПроживания = мКэшЗначений.НачислениеСУчетомДнейПроживания;
				
				Попытка
					
					Если ДокументНачисленийПоСЧ.Начисления.Количество() > 0 ИЛИ ДокументНачисленийПоСЧ.Распределения.Количество() > 0 Тогда
						
						ДокументНачисленийПоСЧ.Записать(РежимЗаписиДокумента.Запись);
						ДокументыНаПроведение.Добавить(ДокументНачисленийПоСЧ.Ссылка);
						
					КонецЕсли; 
					
				Исключение

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
					
				КонецПопытки; 
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ПровестиДокументы(ДокументыНаПроведение);
	
	Если мКэшЗначений.ОбщедомовыеРасходыВГрафеНачисления
		И Объект.ВыполнитьОбщедомовыеНачисления Тогда
		
		ВыполнитьОбщедомовыеНачисления();
		
	КонецЕсли;
	
	// Расчет Льгот после выполнения всех начислений.
	ДокументыНаПроведение.Очистить();
	Выборка.Сбросить();
	
	Пока Выборка.Следующий() Цикл
		
		Запрос.Текст = ТекстЛС;
		
		Запрос.УстановитьПараметр("Здание", Выборка.Здание);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		СписокЗданий = Новый Массив;
		СписокЛС     = Новый Массив;
		
		СписокЗданий.Добавить(Выборка.Здание);
		
		СписокЛС = Результат.ВыгрузитьКолонку("ЛицевойСчет");
		
		ТаблицаЛьгот      = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуЛьгот();
		
		бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(КонецМесяца(Объект.ДатаЗакрытия), 
		Объект.Организация, 
		СписокЛС, 
		СписокЗданий, 
		, 
		, 
		, 
		, 
		, 
		ТаблицаЛьгот,
		,
		,
		мКэшЗначений.РасчетСУчетомДолейВладения,
		мКэшЗначений.УменьшениеНормыЛьготыВПределахФакта, 
		мКэшЗначений.НачислениеСУчетомДнейПроживания, 
		, 
		,
		мКэшЗначений.РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
		мКэшЗначений.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика);
		
		Если Объект.ВыполнитьНачисления И Объект.ВыполнитьНачисленияПоЛьготам Тогда
			
			Если ЗначениеЗаполнено(Выборка.ДокументПоЛьготам) Тогда
				
				ДокументНачисленийПоЛьготам = Выборка.ДокументПоЛьготам.ПолучитьОбъект();
				
			Иначе
				
				ДокументНачисленийПоЛьготам = Документы.бит_НачислениеЛьготПоЛицевымСчетам.СоздатьДокумент();
				
				ДокументНачисленийПоЛьготам.Дата        = КонецМесяца(Объект.ДатаЗакрытия) - 1;
				ДокументНачисленийПоЛьготам.Организация = Объект.Организация;
				ДокументНачисленийПоЛьготам.Улица       = Выборка.Улица;
				ДокументНачисленийПоЛьготам.Здание      = Выборка.Здание;
				
				ДокументНачисленийПоЛьготам.Ответственный = мОтветственный;
				ДокументНачисленийПоЛьготам.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
				
			КонецЕсли;
			
			Если ТаблицаЛьгот.Количество() > 0 Тогда
				
				Для Каждого Строка Из ТаблицаЛьгот Цикл
					
					Строка.СуммаСумм = Окр((Строка.СуммаЛичной + Строка.НачисленоСемейной),2);
					
				КонецЦикла;
				
				ДокументНачисленийПоЛьготам.СписокЛьгот.Очистить();
				
				ДокументНачисленийПоЛьготам.СписокЛьгот.Загрузить(ТаблицаЛьгот);
				
				ТаблицаЛьгот.Свернуть("ЛицевойСчет,Услуга,Начислено");
				
				бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаЛьгот);
				ДокументНачисленийПоЛьготам.ЗаполнениеСчетовКУ(ТаблицаЛьгот);
				
				Для каждого СтрокаЛС из ТаблицаЛьгот Цикл
					
					Отбор = Новый Структура;
					
					Отбор.Очистить();
					Отбор.Вставить("ЛицевойСчет", СтрокаЛС.ЛицевойСчет);
					Отбор.Вставить("Услуга"     , СтрокаЛС.Услуга);
					
					МассивСтрокЛьгот = ДокументНачисленийПоЛьготам.СписокЛьгот.НайтиСтроки(Отбор);
					
					Если МассивСтрокЛьгот.Количество()>1 Тогда
						
						СуммаСумм = 0;
						
						Для Каждого Строка Из МассивСтрокЛьгот Цикл
							
							СуммаСумм = СуммаСумм + Строка.СуммаСумм;
							
							Строка.Начислено = Строка.СуммаСумм; 
							
						КонецЦикла;
						
						СтрокаЛС.Начислено =  СуммаСумм;
						
					КонецЕсли;
					
				КонецЦикла;	
				
				ДокументНачисленийПоЛьготам.ЛицевыеСчета.Очистить();
				ДокументНачисленийПоЛьготам.ЛицевыеСчета.Загрузить(ТаблицаЛьгот);
				
				ДокументНачисленийПоЛьготам.мЛьготаПерсонифицированная           = мКэшЗначений.ЛьготаПерсонифицированная;
				ДокументНачисленийПоЛьготам.мРасчетСУчетомДолейВладения          = мКэшЗначений.РасчетСУчетомДолейВладения;
				ДокументНачисленийПоЛьготам.мУменьшениеНормыЛьготыВПределахФакта = мКэшЗначений.УменьшениеНормыЛьготыВПределахФакта;
				
				Попытка
					
					Если ДокументНачисленийПоЛьготам.ЛицевыеСчета.Количество() > 0 Тогда
						
						ДокументНачисленийПоЛьготам.Записать(РежимЗаписиДокумента.Запись);
						ДокументыНаПроведение.Добавить(ДокументНачисленийПоЛьготам.Ссылка);
						
					КонецЕсли; 
					
				Исключение

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
					
				КонецПопытки; 
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ПровестиДокументы(ДокументыНаПроведение);
	
КонецПроцедуры

&НаСервере
Процедура ПровестиДокументы(ДокументыНаПроведение)
	
	Для каждого СсылкаНаДокумент Из ДокументыНаПроведение Цикл
		
		Попытка  
			
			Документ = СсылкаНаДокумент.ПолучитьОбъект(); 
			//Pemelnik 280223
			Если ТипЗнч(Документ) = Тип("ДокументОбъект.бит_НачислениеПоЛицевымСчетам") Тогда 
				ПроверитьНачисленияКопеек(Документ);	
			КонецЕсли;
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ПроверитьНачисленияКопеек(Документ) 
    УслугаХВ = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000004");
    УслугаГВ = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000003");
    УслугаВО = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000005");
    УслугаЭЭ = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000002");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	лб_НормативыОДНСрезПоследних.СтоимостьКубаХВ КАК СтоимостьКубаХВ,
		|	лб_НормативыОДНСрезПоследних.СтоимостьКВтч КАК СтоимостьКВтч,
		|	лб_НормативыОДНСрезПоследних.СтоимостьКубаВО КАК СтоимостьКубаВО,
		|	ВЫРАЗИТЬ(лб_НормативыОДНСрезПоследних.СтоимостьГКалл * лб_НормативыОДНСрезПоследних.НормативНаПодогрев + лб_НормативыОДНСрезПоследних.СтоимостьКубаХВнаГВ КАК ЧИСЛО(15, 2)) КАК СтоимостьГКалл
		|ПОМЕСТИТЬ ВТ_Нормативы
		|ИЗ
		|	РегистрСведений.лб_НормативыОДН.СрезПоследних(КонецПериода(&Период, Месяц), Адрес = &Здание) КАК лб_НормативыОДНСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ДанныеПоОбъемамЖКУСрезПоследних.Объем КАК Объем,
		|	бит_ДанныеПоОбъемамЖКУСрезПоследних.Услуга КАК Услуга
		|ПОМЕСТИТЬ ВТ_Объемы
		|ИЗ
		|	РегистрСведений.бит_ДанныеПоОбъемамЖКУ.СрезПоследних(КонецПериода(&Период, Месяц), Здание = &Здание) КАК бит_ДанныеПоОбъемамЖКУСрезПоследних
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВЫБОР
		|		КОГДА ВТ_Объемы.Услуга = &УслугаХВ
		|			ТОГДА ВТ_Объемы.Объем
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ОбъемХВ,
		|	0 КАК ОбъемГВ,
		|	0 КАК ОбъемВО,
		|	0 КАК ОбъемЭЭ
		|ПОМЕСТИТЬ ВТ_ОбъемыРазные
		|ИЗ
		|	ВТ_Объемы КАК ВТ_Объемы
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	0,
		|	ВЫБОР
		|		КОГДА ВТ_Объемы.Услуга = &УслугаГВ
		|			ТОГДА ВТ_Объемы.Объем
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	0,
		|	0
		|ИЗ
		|	ВТ_Объемы КАК ВТ_Объемы
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	0,
		|	0,
		|	ВЫБОР
		|		КОГДА ВТ_Объемы.Услуга = &УслугаВО
		|			ТОГДА ВТ_Объемы.Объем
		|		ИНАЧЕ 0
		|	КОНЕЦ,
		|	0
		|ИЗ
		|	ВТ_Объемы КАК ВТ_Объемы
		|
		|ОБЪЕДИНИТЬ
		|
		|ВЫБРАТЬ
		|	0,
		|	0,
		|	0,
		|	ВЫБОР
		|		КОГДА ВТ_Объемы.Услуга = &УслугаЭЭ
		|			ТОГДА ВТ_Объемы.Объем
		|		ИНАЧЕ 0
		|	КОНЕЦ
		|ИЗ
		|	ВТ_Объемы КАК ВТ_Объемы
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СУММА(ВТ_ОбъемыРазные.ОбъемХВ) КАК ОбъемХВ,
		|	СУММА(ВТ_ОбъемыРазные.ОбъемГВ) КАК ОбъемГВ,
		|	СУММА(ВТ_ОбъемыРазные.ОбъемВО) КАК ОбъемВО,
		|	СУММА(ВТ_ОбъемыРазные.ОбъемЭЭ) КАК ОбъемЭЭ
		|ПОМЕСТИТЬ ВТ_ОбъемыИтог
		|ИЗ
		|	ВТ_ОбъемыРазные КАК ВТ_ОбъемыРазные
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Нормативы.СтоимостьКубаХВ КАК СтоимостьХВ,
		|	ВТ_Нормативы.СтоимостьКВтч КАК СтоимостьЭЭ,
		|	ВТ_Нормативы.СтоимостьКубаВО КАК СтоимостьВО,
		|	ВТ_Нормативы.СтоимостьГКалл КАК СтоимостьГВ,
		|	ВТ_ОбъемыИтог.ОбъемХВ КАК ОбъемХВ,
		|	ВТ_ОбъемыИтог.ОбъемГВ КАК ОбъемГВ,
		|	ВТ_ОбъемыИтог.ОбъемВО КАК ОбъемВО,
		|	ВТ_ОбъемыИтог.ОбъемЭЭ КАК ОбъемЭЭ
		|ИЗ
		|	ВТ_Нормативы КАК ВТ_Нормативы,
		|	ВТ_ОбъемыИтог КАК ВТ_ОбъемыИтог";
	
	Запрос.УстановитьПараметр("Здание", Документ.Здание);
	Запрос.УстановитьПараметр("Период", Документ.Дата);
	Запрос.УстановитьПараметр("УслугаВО", УслугаВО);
	Запрос.УстановитьПараметр("УслугаГВ", УслугаГВ);
	Запрос.УстановитьПараметр("УслугаХВ", УслугаХВ);
	Запрос.УстановитьПараметр("УслугаЭЭ", УслугаЭЭ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Для Каждого Строка Из Документ.ЛицевыеСчета Цикл 
			Если Строка.Услуга = УслугаВО Тогда
				Тариф = Окр(Строка.Объем * Выборка.ОбъемВО, 4);
				Строка.Начислено = Окр(Тариф * Выборка.СтоимостьВО, 2);
			ИначеЕсли Строка.Услуга = УслугаХВ Тогда
				Тариф = Окр(Строка.Объем * Выборка.ОбъемХВ, 4);
				Строка.Начислено = Окр(Тариф * Выборка.СтоимостьХВ, 2);
			ИначеЕсли Строка.Услуга = УслугаГВ Тогда
				Тариф = Окр(Строка.Объем * Выборка.ОбъемГВ, 4);
				Строка.Начислено = Окр(Тариф * Выборка.СтоимостьГВ, 2);
			ИначеЕсли Строка.Услуга = УслугаЭЭ Тогда
				Тариф = Окр(Строка.Объем * Выборка.ОбъемЭЭ, 4);
				Строка.Начислено = Окр(Тариф * Выборка.СтоимостьЭЭ, 2);
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;

	Документ.Записать(РежимЗаписиДокумента.Запись);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьОбщедомовыеНачисления()
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Здание");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Улица");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Документ");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(Объект.ДатаЗакрытия));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "ОбщедомовыеНачисления";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	ДокументОбщедомовыеРасходы = Неопределено;
	
	Отбор = Новый Структура;
	
	Выборка = СтруктураРезультата.РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
