// Процедура - обработчик события "Нажатие" кнопки "ДобавитьУслугуНаСчетчик" коммандной панели "Счетчики".
//
&НаКлиенте
Процедура ДобавитьУслугуНаСчетчик(Команда)
	
	ТекДанные = Элементы.ТаблицаСчетчиков.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нет установленных счетчиков!");
		
		Возврат;
	ИначеЕсли ТекДанные.СпособРасчета <> ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам") Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Изменения по групповым счетчикам производятся в справочнике ""Список зданий""");
		
	Иначе
		ТекСчетчик = ТекДанные.Счетчик;
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Организация",Объект.Организация);
		
		ПараметрыФормы.Вставить("Дата",ТекущаяДата());
		
		ПараметрыФормы.Вставить("Объект",Объект.Ссылка);
		
		ПараметрыФормы.Вставить("Счетчик",ТекСчетчик);
		
		ПараметрыФормы.Вставить("ВидОперации",ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик"));
		
		ФормаОткрытия = ОткрытьФорму("Документ.бит_УстановкаСчетчика.Форма.ФормаДокументаУправляемая",Новый Структура ("ЗаполнитьИзСправочникаЛицевыеСчета",ПараметрыФормы),ЭтаФорма);  
		
	КонецЕсли;
	
КонецПроцедуры

