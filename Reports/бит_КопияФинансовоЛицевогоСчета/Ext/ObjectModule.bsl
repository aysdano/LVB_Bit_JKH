				ТаблицаОстатков.Свернуть("МесяцГод", "ВхСальдо, ИсхСальдо");
				
				ВыборкаМесяцГод = РезультатОстатки.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "МесяцГод");
				
				Пока ВыборкаМесяцГод.Следующий() Цикл
					
					// БИТ_ЖКХ изменения кода . Начало: 04.04.2012
					Если ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный
						ИЛИ ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСтр2 Тогда
						СтрокаМесяцГод.Параметры.Заполнить(ВыборкаМесяцГод);
					КонецЕсли;
					// БИТ_ЖКХ изменения кода . Конец  04.04.2012
					
					// Сюда положить ВХ сальдо.
					СтрокаОстатка = ТаблицаОстатков.Найти(ВыборкаМесяцГод.МесяцГод,"МесяцГод");
					ВХСальдо  = 0;
					ИСХСальдо = 0;
					
					КОплате   = 0;
					
					Если НЕ СтрокаОстатка = Неопределено Тогда
						
						ВХСальдо  = СтрокаОстатка.ВХСальдо;
						ИСХСальдо = СтрокаОстатка.ИСХСальдо;
						
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(ВыборкаМесяцГод.Сумма) Тогда
						Продолжить;
					КонецЕсли; 
					
					
					СтрокаМесяцГод.Параметры.ВХСальдо  = ВХСальдо;
					
					СтруктураДанных = ПолучитьОтветственногоИКоличество(КонецМесяца(Дата(ВыборкаМесяцГод.МесяцГод)));
					СтрокаМесяцГод.Параметры.Ответственный = СтруктураДанных.Ответственный;
					ДокументРезультат.Вывести(СтрокаМесяцГод,ВыборкаМесяцГод.Уровень(), "МесяцГод");
					ВыборкаУслуга = ВыборкаМесяцГод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Услуга", "ВСЕ");
					
					Пока ВыборкаУслуга.Следующий() Цикл
						СтрокаУслуга.Параметры.Заполнить(ВыборкаУслуга);
						ДокументРезультат.Присоединить(СтрокаУслуга);
					КонецЦикла;
					СтрокаМесяцГодКол.Параметры.Заполнить(ВыборкаМесяцГод);
					
					СтрокаМесяцГодКол.Параметры.ИСХСальдо  = ИСХСальдо;
					
					СтрокаМесяцГодКол.Параметры.Количество = СтруктураДанных.Количество;
					ДокументРезультат.Присоединить(СтрокаМесяцГодКол);
					
					ВыборкаВидНач = ВыборкаМесяцГод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидНачисления");
					Пока ВыборкаВидНач.Следующий() Цикл 
						
						СтрокаВидНачисления.Параметры.Заполнить(ВыборкаВидНач);
						ДокументРезультат.Вывести(СтрокаВидНачисления);
						
						ВыборкаУслугаВидНач = ВыборкаВидНач.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Услуга", "ВСЕ");
						ИтогоСумма = 0;
						Пока ВыборкаУслугаВидНач.Следующий() Цикл
							СтрокаУслугаВидНач.Параметры.Заполнить(ВыборкаУслугаВидНач);
							ДокументРезультат.Присоединить(СтрокаУслугаВидНач);
							ИтогоСумма = ИтогоСумма +  ?(ВыборкаУслугаВидНач.Сумма = Null ,0,ВыборкаУслугаВидНач.Сумма);
						КонецЦикла;
						
						// Сюда положить ИСХ сальдо.
						СтрокаВидНачКол.Параметры.Заполнить(ВыборкаВидНач);
						СтрокаВидНачКол.Параметры.Итого = ИтогоСумма;
						ДокументРезультат.Присоединить(СтрокаВидНачКол);
						
					КонецЦикла;
					
				КонецЦикла;
				
				ПодвалОборот.Параметры.ДатаФормОтчета = Формат(КонецМесяца(КонецПериода),"ДФ=dd.MM.yyyy");	
				// Здесть поменять получение ДолгОстаток.
				ПодвалОборот.Параметры.Сумма = ?(СУчетомПереплаты,ИСХСальдо, ДолгОстаток());
				ДокументРезультат.Вывести(ПодвалОборот);
				// БИТ_ЖКХ добавление кода Начало: 04.04.2012 
			КонецЕсли; 
			// БИТ_ЖКХ изменения кода . Конец  06.10.2011
			
			Если ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Основной Тогда
				
				ДокументРезультат.Вывести(Подвал);
				
			КонецЕсли;
			// БИТ_ЖКХ добавление кода конец : 04.04.2012
			// БИТ_ЖКХ изменения кода . Начало: 14.06.2012
			Если ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный 
				ИЛИ ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Основной
				ИЛИ ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.ПолныйСтр2 Тогда
				
				ДокументРезультат.АвтоМасштаб = Истина;
				ДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
			КонецЕсли;
			// БИТ_ЖКХ изменения кода. Конец
			
			// БИТ_ЖКХ добавление кода. Начало:
		ИначеЕсли ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Остатки Тогда
			
			Макет = ПолучитьМакет("ФинансовоЛицевойСчет_Остатки");
			// БИТ_ЖКХ КОММЕНТИРОВАНИЕ кода . Конец  14.06.2012
			ПодвалОборот        = Макет.ПолучитьОбласть("ПодвалОборот");
			НачалоЗаголовка     = Макет.ПолучитьОбласть("Шапка");
			СтрокаМесяцГод      = Макет.ПолучитьОбласть("СтрокаМесяцГод");
			СтрокаМесяцГодКол   = Макет.ПолучитьОбласть("СтрокаМесяцГодКол");
			
			ШапкаУслуги         = Макет.ПолучитьОбласть("ШапкаУслуги");
			ШапкаУслуга         = Макет.ПолучитьОбласть("ШапкаУслуга");
			ШапкаУслуг          = Макет.ПолучитьОбласть("ШапкаУслуг");
			
			СтрокаУслуга        = Макет.ПолучитьОбласть("СтрокаУслуга");
			
			НачалоЗаголовка.Параметры.НомерЛС      = ЛицевойСчет;
			НачалоЗаголовка.Параметры.Организация  = ЛицевойСчет.Организация;
			// БИТ_ЖКХ добавление кода Начало: 23.08.2012 
			Если ВыводитьПочтовыйАдрес Тогда
				Если ЗначениеЗаполнено(ЛицевойСчет.Здание.ПочтовыйАдрес) Тогда
					АдресСтруктура = бит_ПаспортныйСтолСервер.ПолучитьСтруктуруАдресаИзКонтактнойИнформации(ЛицевойСчет.Здание,
					Перечисления.бит_ТипыКонтактнойИнформации.Адрес,Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания);
					АдресЛС = ?(ЗначениеЗаполнено(АдресСтруктура.Регион),"рег. " + АдресСтруктура.Регион + ", ","")
					+ ?(ЗначениеЗаполнено(АдресСтруктура.Район),"р-н " +  АдресСтруктура.Район + ", ","")
					+ ?(ЗначениеЗаполнено(АдресСтруктура.Город),"г." + АдресСтруктура.Город + ", ","")
					+ ?(ЗначениеЗаполнено(АдресСтруктура.Улица),"ул. " + АдресСтруктура.Улица, "");
					
				Иначе

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните почтовый адрес у здания");
					
					АдресЛС = Строка(ЛицевойСчет.УлицаЛицевогоСчета);
					
				КонецЕсли;
			Иначе
				АдресЛС = Строка(ЛицевойСчет.УлицаЛицевогоСчета);
			КонецЕсли;
			// БИТ_ЖКХ добавление кода конец : 23.08.2012
			НачалоЗаголовка.Параметры.Улица        = АдресЛС;
			НачалоЗаголовка.Параметры.Дом          = ЛицевойСчет.Здание;
			НачалоЗаголовка.Параметры.Квартира     = ЛицевойСчет.Квартира;
			НачалоЗаголовка.Параметры.Корпус       = ЛицевойСчет.Здание.Корпус;
			НачалоЗаголовка.Параметры.Этаж         = ЛицевойСчет.Квартира.Этаж;
			НачалоЗаголовка.Параметры.ДД           = Формат(КонецПериода,"ДФ=dd");
			НачалоЗаголовка.Параметры.месяц        = Формат(КонецПериода,"ДФ=ММMM");
			НачалоЗаголовка.Параметры.ГГГГ         = Формат(КонецПериода,"ДФ=yyyy");
			
			Если Отвественный <> Неопределено тогда	
				НачалоЗаголовка.Параметры.Ответственный = Отвественный.ФизЛицо;
				НачалоЗаголовка.Параметры.Телефон      = бит_ОбщегоНазначения.ПолучитьТелефонИзКонтактнойИнформацииФизЛица(Отвественный.ФизЛицо);
			КонецЕсли;	
			ДокументРезультат.Вывести(НачалоЗаголовка);
			ЗапросОстатки = Новый Запрос;
			
			УстановитьПараметрыЗапроса(ЗапросОстатки, Истина);
			
			ЗапросОстатки.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК МесяцГод,
			|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
			|	СУММА(ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)) КАК Сумма,
			|	СУММА(ВЫБОР
			|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
			|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК Оплата,
			|	СУММА(ВЫБОР
			|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
			|					ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
			|					ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
			|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК Начисления,
			|	СУММА(ВЫБОР
			|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
			|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК Разовые,
			|	СУММА(ВЫБОР
			|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
			|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
			|			ИНАЧЕ 0
			|		КОНЕЦ) КАК Льгота
			|ПОМЕСТИТЬ Обороты
			|ИЗ
			|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ЛицевойСчет = &ЛицевойСчет) КАК НачисленияПоУслугамЖКХОбороты
			|
			|СГРУППИРОВАТЬ ПО
			|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ),
			|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ТаблицаОстатков.Услуга,
			|	ТаблицаОстатков.МесяцГод,
			|	ТаблицаОстатков.ВхСальдо,
			|	ТаблицаОстатков.ИсхСальдо
			|ПОМЕСТИТЬ Остатки
			|ИЗ
			|	&ТаблицаОстатков КАК ТаблицаОстатков
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ЕСТЬNULL(Остатки.ВхСальдо, 0) КАК ВхСальдо,
			|	ЕСТЬNULL(Остатки.ИсхСальдо, 0) КАК ИсхСальдо,
			|	ЕСТЬNULL(Обороты.Начисления, 0) - ВЫБОР
			|		КОГДА ЕСТЬNULL(Обороты.Льгота, 0) < 0
			|			ТОГДА ЕСТЬNULL(Обороты.Льгота, 0) * -1
			|		ИНАЧЕ ЕСТЬNULL(Обороты.Льгота, 0)
			|	КОНЕЦ + ЕСТЬNULL(Обороты.Разовые, 0) КАК Сумма,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(Обороты.Оплата, 0) < 0
			|			ТОГДА ЕСТЬNULL(Обороты.Оплата, 0) * -1
			|		ИНАЧЕ ЕСТЬNULL(Обороты.Оплата, 0)
			|	КОНЕЦ КАК Оплата,
			|	ВЫБОР
			|		КОГДА ЕСТЬNULL(Остатки.ВхСальдо, 0) + ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ВЫБОР
			|				КОГДА ЕСТЬNULL(Обороты.Оплата, 0) < 0
			|					ТОГДА ЕСТЬNULL(Обороты.Оплата, 0) * -1
			|				ИНАЧЕ ЕСТЬNULL(Обороты.Оплата, 0)
			|			КОНЕЦ - ВЫБОР
			|				КОГДА ЕСТЬNULL(Обороты.Льгота, 0) < 0
			|					ТОГДА ЕСТЬNULL(Обороты.Льгота, 0) * -1
			|				ИНАЧЕ ЕСТЬNULL(Обороты.Льгота, 0)
			|			КОНЕЦ > 0
			|			ТОГДА ЕСТЬNULL(Остатки.ВхСальдо, 0) + ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ВЫБОР
			|					КОГДА ЕСТЬNULL(Обороты.Оплата, 0) < 0
			|						ТОГДА ЕСТЬNULL(Обороты.Оплата, 0) * -1
			|					ИНАЧЕ ЕСТЬNULL(Обороты.Оплата, 0)
			|				КОНЕЦ - ВЫБОР
			|					КОГДА ЕСТЬNULL(Обороты.Льгота, 0) < 0
			|						ТОГДА ЕСТЬNULL(Обороты.Льгота, 0) * -1
			|					ИНАЧЕ ЕСТЬNULL(Обороты.Льгота, 0)
			|				КОНЕЦ
			|		ИНАЧЕ 0
			|	КОНЕЦ КАК КОплате,
			|	Остатки.Услуга КАК Услуга,
			|	Остатки.МесяцГод КАК МесяцГод
			|ИЗ
			|	Остатки КАК Остатки
			|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
			|		ПО Остатки.Услуга = Обороты.Услуга
			|			И Остатки.МесяцГод = Обороты.МесяцГод
			|ИТОГИ
			|	СУММА(ВхСальдо),
			|	СУММА(ИсхСальдо),
			|	СУММА(Сумма),
			|	СУММА(Оплата),
			|	СУММА(КОплате)
			|ПО
			|	МесяцГод,
			|	Услуга
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ Обороты
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|УНИЧТОЖИТЬ Остатки";
			
			ЗапросОстатки.УстановитьПараметр("ТаблицаОстатков", ПолучитьТаблицуОстатков());
			
			ВыборкаУслуга = ЗапросОстатки.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Услуга");
			ДокументРезультат.Вывести(ШапкаУслуги);
			
			СписокУслуг = Новый Массив;
			
			Пока ВыборкаУслуга.Следующий() Цикл
				
				Если ЗначениеЗаполнено(ВыборкаУслуга.Сумма) Тогда
					
					ШапкаУслуга.Параметры.Заполнить(ВыборкаУслуга);
					ДокументРезультат.Присоединить(ШапкаУслуга );
					
					СписокУслуг.Добавить(ВыборкаУслуга.Услуга);
					
				КонецЕсли; 
				
			КонецЦикла;
			
			ДокументРезультат.Присоединить(ШапкаУслуг);
			
			ВыборкаМесяцГод = ЗапросОстатки.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "МесяцГод");
			
			Пока ВыборкаМесяцГод.Следующий() Цикл
				
