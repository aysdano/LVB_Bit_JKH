&НаСервере
Функция ПолучитьПредставлениеСпособаДетализации()
	
	Если СпособДетализации = "1" Тогда
		Возврат "по участкам";	
	ИначеЕсли СпособДетализации = "2" Тогда 
		Возврат "по адресам";	
	Иначе	
		Возврат "по лицевым счетам";	
	КонецЕсли; 
	
