				ОбластьПодписиОтветственных.Параметры.ВыданДокументПред 		  	  = Ответственный.ДокументКемВыдан;
				ОбластьПодписиОтветственных.Параметры.ДокументКодПодразделенияПред  = Ответственный.КодПодразделенияДокумента;
				
				ОбластьПодписиОтветственных.Параметры.ДатаВыдачиДокументаПред = Ответственный.ДатаВыдачиДокументаПред;
				ОбластьПодписиОтветственных.Параметры.МесяцВыдачиДокументаПред = Ответственный.МесяцВыдачиДокументаПред;
				ОбластьПодписиОтветственных.Параметры.ГодВыдачиДокументаПред   = Ответственный.ГодВыдачиДокументаПред;
				
				ТабДокумент.Вывести(ОбластьПодписиОтветственных);
			КонецЦикла;
			
			ОбластьПодписьЗаявителя.Параметры.ЧислоТек = 	Формат(Выборка.Дата,"ДФ=dd");
			ДатаМесяц 						= Формат(Выборка.Дата,"ДФ=dd.MM.yyyy");
			ОбластьПодписьЗаявителя.Параметры.МесяцТек = Сред(ДатаМесяц, 4, 2);
			ОбластьПодписьЗаявителя.Параметры.ГодТек   = Прав(Формат(Выборка.Дата,"ДФ=yyyy"), 2);
			
			ОбластьПодписьЗаявителя.Параметры.ДолжностноеЛицо = ДолжностноеЛицо;
			
			ТабДокумент.Вывести(ОбластьПодписьЗаявителя);
			
			ОбластьПринятоеРешениеШапка = Макет.ПолучитьОбласть("ПринятоеРешениеШапка");
			ОбластьПринятоеРешениеСтрока = Макет.ПолучитьОбласть("ПринятоеРешениеСтрока");
			ОбластьПринятоеРешениеПодвал = Макет.ПолучитьОбласть("ПринятоеРешениеПодвал");
			
			
			ПринятоеРешение_1 = "";
			ПринятоеРешение_2 = "";
			
			ПринятоеРешениеСтр = Выборка.ПринятоеРешение;
			ПринятоеРешениеСтр = СтрЗаменить(ПринятоеРешениеСтр, Символы.ПС, " ");
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ПринятоеРешениеСтр, 90, ПринятоеРешение_1 , ПринятоеРешение_2 );
			
			//Принятое решение
			ОбластьПринятоеРешениеШапка.Параметры.ПринятоеРешение_1     = ПринятоеРешение_1;
			ТабДокумент.Вывести(ОбластьПринятоеРешениеШапка);
			
			ДлиннаНужнойСтрокиПринятоеРешение = СтрДлина(Выборка.ПринятоеРешение);
			ПринятоеРешениеВыведено = 90;
			
			Пока ПринятоеРешениеВыведено < ДлиннаНужнойСтрокиПринятоеРешение Цикл
				
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ПринятоеРешение_2, 115, ПринятоеРешение_1 , ПринятоеРешение_2 );
				
				ОбластьПринятоеРешениеСтрока.Параметры.ПринятоеРешение_2     = ПринятоеРешение_1;
				ТабДокумент.Вывести(ОбластьПринятоеРешениеСтрока);
				
				ПринятоеРешениеВыведено = ПринятоеРешениеВыведено + 115;
				
			КонецЦикла;					
			
			ОбластьПринятоеРешениеПодвал.Параметры.ЧислоРеш    	= Формат(Выборка.ДатаРегистрации,"ДФ=dd");
			ДатаМесяцРеш 						= Формат(Выборка.ДатаРегистрации,"ДФ=dd.MM.yy");
			ОбластьПринятоеРешениеПодвал.Параметры.МесяцРеш    	= Сред(ДатаМесяцРеш, 4, 2);
			ОбластьПринятоеРешениеПодвал.Параметры.ГодРеш4     	= Формат(Выборка.ДатаРегистрации,"ДФ=yyyy");
			ОбластьПринятоеРешениеПодвал.Параметры.ДолжностноеЛицоОрганизации  = ДолжностноеЛицоОрганизации;				
			
			ОбластьПринятоеРешениеПодвал.Параметры.ДолжностьДЛО1 = ?(ЗначениеЗаполнено(ДолжностьДЛО), "Начальник " + ДолжностьДЛО, "");
			
			
			ТабДокумент.Вывести(ОбластьПринятоеРешениеПодвал);
			
		КонецЕсли;
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните обязательные поля - Лицевой счет и Регистрируемое лицо и запишите документ";
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Функция ПолучитьАдресБезПодписей(Адрес)
	
	СтрокаРезультат = СтрЗаменить(Адрес, "страна:", "");
	СтрокаРезультат = СтрЗаменить(СтрокаРезультат, "область:", "");
	СтрокаРезультат = СтрЗаменить(СтрокаРезультат, "район:", "");
	СтрокаРезультат = СтрЗаменить(СтрокаРезультат, "село (дер.):", "");
	СтрокаРезультат = СтрЗаменить(СтрокаРезультат, "Населенный пункт:", "");
	
	Возврат СтрокаРезультат;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ с печатной формой адресный листок прибытия.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьАЛП(МакетНовогоОбразца = Ложь)  
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	Запрос.Текст =
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация КАК Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий КАК Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо КАК РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование КАК ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл КАК ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации КАК ВидОперации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо КАК ДолжностноеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид КАК ВидДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ЕСТЬNULL(ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыдачиДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	|	ЕСТЬNULL(ПаспортныеДанныеФизЛицСрезПоследних.ДатаРегистрацииПоМестуЖительства, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРегистрацииПоМестуЖительства,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	ЕСТЬNULL(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрацииПроживающего,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Страна,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия КАК Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя КАК Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество КАК Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата КАК Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрацииДокумент,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдрес КАК ОткудаПрибылАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдрес КАК КудаВыписанАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.Пол КАК Пол,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаПрибытия КАК ДатаПрибытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаУбытия КАК ДатаУбытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылИзЛС КАК ОткудаПрибылИзЛС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанИзЛС КАК КудаВыписанИзЛС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдресЗапятые КАК ОткудаПрибылАдресЗапятые,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ДокументВид,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдресЗапятые КАК ПочтовыйАдресЗапятые,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПериодРегистрацииПоПрежнемуАдресуС КАК ПериодРегистрацииПоПрежнемуАдресуС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПериодРегистрацииПоПрежнемуАдресуПо КАК ПериодРегистрацииПоПрежнемуАдресуПо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДанныеОПрибытии КАК ДанныеОПрибытии,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМС КАК ПаспортнаяСлужба,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ответственный КАК ОтветственныйПользователь,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМСКудаПрибыл КАК ОрганФМСПрибытия,
	|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК ПредставлениеКвартирыЛС
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = ПаспортныеДанныеФизЛицСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
		
	ВыборкаТЗ = Запрос.Выполнить().Выгрузить();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ПолеСверху = 3;
	ТабДокумент.ПолеСлева = 3;
	ТабДокумент.ПолеСнизу = 3;
	ТабДокумент.ПолеСправа = 3;
	
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	
	Если МакетНовогоОбразца Тогда
		Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("АЛП_New");
	Иначе 	
		Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("АЛП");
	КонецЕсли;
	
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	Если ВыборкаТЗ.Количество()= 0 Тогда
		
		Возврат ТабДокумент;
		
	КонецЕсли;
	
	ВыборкаИсходник = ВыборкаТЗ[0];
	                     
	ДанныеПечати = Новый Структура;
	
	Для Каждого Колонка Из ВыборкаТЗ.Колонки Цикл
		ДанныеПечати.Вставить(Колонка.Имя);
	КонецЦикла;
	
	ЗаполнитьЗначенияСвойств(ДанныеПечати, ВыборкаИсходник);
	
	// При переводе к верхнему регистру типы данных приведены к строке.
	ДанныеПечати.ДокументОснование         = ВРег(Строка(ВыборкаИсходник.ДокументОснование));
	ДанныеПечати.ПринятоеРешение           = ВРег(Строка(ВыборкаИсходник.ПринятоеРешение));
	ДанныеПечати.ОткудаПрибыл              = ВРег(Строка(ВыборкаИсходник.ОткудаПрибыл));
	ДанныеПечати.УлицаРег                  = ВРег(Строка(ВыборкаИсходник.УлицаРег));
	ДанныеПечати.ДомРег                    = ПолучитьНомерДома(ВРег(Строка(ВыборкаИсходник.ДомРег)));
	ДанныеПечати.КвартираРег               = ВРег(Строка(ВыборкаИсходник.КвартираРег));
	ДанныеПечати.КорпусРег                 = ПолучитьНомерКорпуса(ВРег(Строка(ВыборкаИсходник.КорпусРег)));
	ДанныеПечати.ПочтовыйАдрес             = ВРег(ВыборкаИсходник.ПочтовыйАдрес);
	
	Если ЗначениеЗаполнено(ВыборкаИсходник.ВидДокумента) Тогда
		Если ЗначениеЗаполнено(ВыборкаИсходник.ВидДокумента.КодПФР) Тогда
			ДанныеПечати.ВидДокумента 		   = ВыборкаИсходник.ВидДокумента.КодПФР; 
		Иначе	
			ДанныеПечати.ВидДокумента          = ВРег(Строка(ВыборкаИсходник.ВидДокумента));
		КонецЕсли;
	КонецЕсли;
	
	ДанныеПечати.СерияДокумента            = ВРег(ВыборкаИсходник.СерияДокумента);
	ДанныеПечати.НомерДокумента            = ВРег(ВыборкаИсходник.НомерДокумента);
	ДанныеПечати.ВыданДокумент             = ВРег(ВыборкаИсходник.ВыданДокумент);
	ДанныеПечати.ДокументКодПодразделения  = ВРег(ВыборкаИсходник.ДокументКодПодразделения);
	
	Если ЗначениеЗаполнено(ВыборкаИсходник.ВидДокументаПред) Тогда
		Если ЗначениеЗаполнено(ВыборкаИсходник.ВидДокументаПред.КодПФР) Тогда
			ДанныеПечати.ВидДокументаПред 		   = ВыборкаИсходник.ВидДокументаПред.КодПФР; 
		Иначе	
			ДанныеПечати.ВидДокументаПред          = ВРег(Строка(ВыборкаИсходник.ВидДокументаПред));
		КонецЕсли;
	КонецЕсли;
	
	ДанныеПечати.СерияДокументаПред        = ВРег(ВыборкаИсходник.СерияДокументаПред);
	ДанныеПечати.НомерДокументаПред        = ВРег(ВыборкаИсходник.НомерДокументаПред);
	ДанныеПечати.ВыданДокументПред         = ВРег(ВыборкаИсходник.ВыданДокументПред);
	ДанныеПечати.Страна                    = ВРег(Строка(ВыборкаИсходник.Страна));
	ДанныеПечати.Фамилия                   = ВРег(ВыборкаИсходник.Фамилия);
	ДанныеПечати.Имя                       = ВРег(ВыборкаИсходник.Имя);
	ДанныеПечати.Отчество                  = ВРег(ВыборкаИсходник.Отчество);
	
	ВыданДокумент_1 = "";
	ВыданДокумент_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ДанныеПечати.ВыданДокумент, 42, ВыданДокумент_1 , ВыданДокумент_2 );
	ШапкаОбласть.Параметры.ВыданДокумент_1 = ВыданДокумент_1;
	ШапкаОбласть.Параметры.ВыданДокумент_2 = ВыданДокумент_2;
	
	СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(ДанныеПечати.МестоРождения);
	ШапкаОбласть.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
	ШапкаОбласть.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
	ШапкаОбласть.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
	ШапкаОбласть.Параметры.НаселенныйПунктРожд = СтруктураМестоРождения.Село;
	
	Если МакетНовогоОбразца Тогда
		ШапкаОбласть.Параметры.СтранаРожд = СтруктураМестоРождения.Страна;
	КонецЕсли;
	
	Если ДанныеПечати.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
		ШапкаОбласть.Область("ПолМуж").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
	ИначеЕсли  ДанныеПечати.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
		ШапкаОбласть.Область("ПолЖен").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.Гражданство = ДанныеПечати.Страна;
	
	ШапкаОбласть.Параметры.Заполнить(ДанныеПечати);
	
	Если 
		
		Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаПаспорта Тогда
		
		ШапкаОбласть.Параметры.ВидДокумента             = "";
		ШапкаОбласть.Параметры.НомерДокумента           = "";
		
		// 10.10.2018
		Если МакетНовогоОбразца Тогда
			ШапкаОбласть.Параметры.ДеньВыдачиДокумента      = "";
			ШапкаОбласть.Параметры.МесяцВыдачиДокумента     = "";
			ШапкаОбласть.Параметры.ГодВыдачиДокумента       = "";
			ШапкаОбласть.Параметры.ДокументКодПодразделения = "";

		иначе
			ШапкаОбласть.Параметры.ДатаВыдачиДокумента      = "";
		конецесли; 
		
		ШапкаОбласть.Параметры.СерияДокумента           = "";
		ШапкаОбласть.Параметры.ВыданДокумент_1          = "";
		ШапкаОбласть.Параметры.ВыданДокумент_2          = "";
		
		
	КонецЕсли; 
	
	Если МакетНовогоОбразца Тогда
		
		ШапкаОбласть.Параметры.ПериодРегистрацииС =  Формат(ВыборкаИсходник.ПериодРегистрацииПоПрежнемуАдресуС,"ДФ=dd.MM.yyyy" );
		ШапкаОбласть.Параметры.ПериодРегистрацииПо = Формат(ВыборкаИсходник.ПериодРегистрацииПоПрежнемуАдресуПо, "ДФ=dd.MM.yyyy");
		
		ПаспортнаяСлужба_1 = "";
		ПаспортнаяСлужба_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ВРег(Строка(ДанныеПечати.ОрганФМСПрибытия)), 40, ПаспортнаяСлужба_1 , ПаспортнаяСлужба_2 );
		
		ШапкаОбласть.Параметры.ПаспортнаяСлужба_1 = ВРег(ПаспортнаяСлужба_1);
		ШапкаОбласть.Параметры.ПаспортнаяСлужба_2 = ВРег(ПаспортнаяСлужба_2);
		
		ШапкаОбласть.Параметры.КодПаспортнойСлужбы = ДанныеПечати.ОрганФМСПрибытия.КодПодразделения;
		
		ШапкаОбласть.Параметры.КвартираРег = ВыборкаИсходник.ПредставлениеКвартирыЛС;
	Иначе
		ШапкаОбласть.Параметры.ПаспортнаяСлужба = ВРег(Строка(ДанныеПечати.ПаспортнаяСлужба));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДанныеПечати.ДатаРождения) Тогда
		
		Если МакетНовогоОбразца Тогда
			
			ШапкаОбласть.Параметры.ДеньРождения  = Формат(ДанныеПечати.ДатаРождения,"ДФ='дд'");
			ДатаМесяц				 			 = Формат(ДанныеПечати.ДатаРождения,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРождения = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодРождения   = Формат(ДанныеПечати.ДатаРождения,"ДФ='yyyy'");
			
		Иначе
			ШапкаОбласть.Параметры.ДатаРождения		= Формат(ДанныеПечати.ДатаРождения,"ДЛФ=DD");
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ВыборкаИсходник.ДатаРегистрации) Тогда
		
		Если ДанныеПечати.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства Тогда
			
			ЗачеркнутыйШрифт = Новый Шрифт(Макет.Область("ТекстПребывания").Шрифт,,,,,,Истина);
			ШапкаОбласть.Область("ТекстПребывания").Шрифт = ЗачеркнутыйШрифт;
			
		ИначеЕсли ДанныеПечати.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуПребывания    Тогда
			
			ЗачеркнутыйШрифт = Новый Шрифт(Макет.Область("ТекстЖительство").Шрифт,,,,,,Истина);
			ШапкаОбласть.Область("ТекстЖительство").Шрифт = ЗачеркнутыйШрифт;
			
		КонецЕсли; 
				
	КонецЕсли;
	
	ЗаполнятьКвартиру = Ложь;
	РегЛицо = ВыборкаИсходник.РегистрируемоеЛицо;
	Отбор = Новый Структура();
	Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ЮрАдресПроживающего);
	Строки = РегЛицо.КонтактнаяИнформация.НайтиСтроки(Отбор);
	Если Строки.Количество() = 0 Тогда
		Отбор = Новый Структура();
		Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ФактАдресПроживающего);

		Строки = РегЛицо.КонтактнаяИнформация.НайтиСтроки(Отбор);
	КонецЕсли;
	
	Если Строки.Количество() > 0 Тогда
		АдресФактПроживания = Строки[0].Значение;
		АдресФактПроживания = ПолучитьМуниципальныйАдресБСП(АдресФактПроживания);
	Иначе
		АдресФактПроживания = ПолучитьМуниципальныйАдресБСП(ДанныеПечати.ЛицевойСчет);
		ЗаполнятьКвартиру = Истина;
	КонецЕсли;
	
	СтруктураАдресРегистрации = АдресФактПроживания;
	
		Если ЗначениеЗаполнено(СтруктураАдресРегистрации)  Тогда
			
			Если НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
				
				ШапкаОбласть.Параметры.РегионРег 			= ВРег(СтруктураАдресРегистрации.Регион);
				ШапкаОбласть.Параметры.РайонРег 			= ВРег(СтруктураАдресРегистрации.Район);
				ШапкаОбласть.Параметры.ГородРег 			= ВРег(СтруктураАдресРегистрации.Город);
				ШапкаОбласть.Параметры.НаселенныйПунктРег 	= ВРег(СтруктураАдресРегистрации.НаселенныйПункт);
				ШапкаОбласть.Параметры.УлицаРег 			= ВРег(СтруктураАдресРегистрации.Улица);
				ШапкаОбласть.Параметры.КорпусРег 			= ВРег(СтруктураАдресРегистрации.Корпус);
				ШапкаОбласть.Параметры.ДомРег	 			= ВРег(СтруктураАдресРегистрации.Дом);
				ШапкаОбласть.Параметры.КвартираРег			= ВРег(СтруктураАдресРегистрации.Квартира);
					
				//+bit_semenov.v_03.02.2022
				//Если берем адрес из ЛС, то в СтруктураАдресРегистрации квартиры нет, берем прямо из ЛС 
				Если ДанныеПечати.ВидОперации 				= Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуПребывания И ЗаполнятьКвартиру Тогда
					ШапкаОбласть.Параметры.КвартираРег	 	= Строка(ВыборкаИсходник.ПредставлениеКвартирыЛС);
				ИначеЕсли ДанныеПечати.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства Тогда
					ШапкаОбласть.Параметры.КвартираРег	 	= Строка(СтруктураАдресРегистрации.Квартира);	
				КонецЕсли;
				//-bit_semenov.v_03.02.2022
				
			КонецЕсли;
			
		КонецЕсли;

	
	Если МакетНовогоОбразца Тогда
		
			ШапкаОбласть.Параметры.ДеньРегистрации  = Формат(ВыборкаИсходник.ДатаРегистрации,"ДФ='дд'");
			ДатаМесяц				 				= Формат(ВыборкаИсходник.ДатаРегистрации,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРегистрации = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодРегистрации   = Формат(ВыборкаИсходник.ДатаРегистрации,"ДФ='yyyy'");
			
			Если Не (Объект.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства 
				ИЛИ Объект.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуПребывания)
				И ЗначениеЗаполнено(Объект.ПериодРегистрацииПоПрежнемуАдресуС) И Не ЗначениеЗаполнено(Объект.ПериодРегистрацииПоПрежнемуАдресуПо) Тогда
				ШапкаОбласть.Параметры.ДеньРегистрации  = Формат(Объект.ПериодРегистрацииПоПрежнемуАдресуС,"ДФ='дд'");
				ДатаМесяц				 				= Формат(Объект.ПериодРегистрацииПоПрежнемуАдресуС,"ДФ='дд.MMMM'");
				ШапкаОбласть.Параметры.МесяцРегистрации = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
				ШапкаОбласть.Параметры.ГодРегистрации   = Формат(Объект.ПериодРегистрацииПоПрежнемуАдресуС,"ДФ='yyyy'");
			КонецЕсли;
						
			Если ЗначениеЗаполнено(ВыборкаИсходник.ДатаСнятияСРегистрацииДокумент) Тогда
				ШапкаОбласть.Параметры.ДеньСнятияСРегистрации  = Формат(ВыборкаИсходник.ДатаСнятияСРегистрацииДокумент,"ДФ='дд'");
				ДатаМесяц				 					   = Формат(ВыборкаИсходник.ДатаСнятияСРегистрацииДокумент,"ДФ='дд.MMMM'");
				ШапкаОбласть.Параметры.МесяцСнятияСРегистрации = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
				ШапкаОбласть.Параметры.ГодСнятияСРегистрации   = Формат(ВыборкаИсходник.ДатаСнятияСРегистрацииДокумент,"ДФ='yyyy'");
			КонецЕсли;
		
	КонецЕсли;

	
	Если ЗначениеЗаполнено(ДанныеПечати.ДатаВыдачиДокумента) Тогда
		
		Если МакетНовогоОбразца Тогда
						
				ШапкаОбласть.Параметры.ДеньВыдачиДокумента    = Формат(ДанныеПечати.ДатаВыдачиДокумента,"ДФ='дд'");
				ДатаМесяц				 					  = Формат(ДанныеПечати.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
				ШапкаОбласть.Параметры.МесяцВыдачиДокумента   = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
				ШапкаОбласть.Параметры.ГодВыдачиДокумента     = Формат(ДанныеПечати.ДатаВыдачиДокумента,"ДФ='yyyy'");
						
		Иначе
			
			ШапкаОбласть.Параметры.ДатаВыдачиДокумента    = Формат(ДанныеПечати.ДатаВыдачиДокумента,"ДЛФ=DD");
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НЕ МакетНовогоОбразца Тогда
		
		ШапкаОбласть.Параметры.ДатаСоставления        = Формат(ДанныеПечати.Дата,"ДЛФ=DD");
		
	КонецЕсли;

	
	НаборЗаписей = НЕОПРЕДЕЛЕНО;
	
	Если Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаФамилии ИЛИ Объект.ОткудаПрибыл = перечисления.бит_ВариантыИзмененияМестаПребывания.СменаПаспорта Тогда
		
		СтруктураАдресПрибИзДрРегиона = СтруктураАдресРегистрации;
			
	Иначе
		СтруктураАдресПрибИзДрРегиона = ПолучитьМуниципальныйАдресБСП(КонтактнаяИнформацияОписаниеДополнительныхРеквизитов[1].Значение);
		//Если НЕ ЗначениеЗаполнено(СтруктураАдресПрибИзДрРегиона.Улица) И ЗначениеЗаполнено(СтруктураАдресПрибИзДрРегиона.Район) Тогда
		//	СтруктураАдресПрибИЗДрРегиона.Квартира = ДанныеПечати.ПредставлениеКвартирыЛС;
		//КонецЕсли;                                            

	КонецЕсли;
	
	Если НЕ ДанныеПечати.ОткудаПрибылИЗЛС Тогда
		Если СтруктураАдресПрибИзДрРегиона <> Неопределено И ЗначениеЗаполнено(СтруктураАдресПрибИзДрРегиона.Улица) Тогда
			
			СтруктураАдресПрибИзДрРегиона.Квартира = ДанныеПечати.ПредставлениеКвартирыЛС;
			СтруктураАдресПрибИзДрРегиона.Корпус = ДанныеПечати.КорпусРег;
			СтруктураАдресПрибИзДрРегиона.Улица = ДанныеПечати.УлицаРег;
			СтруктураАдресПрибИзДрРегиона.Дом = ДанныеПечати.ДомРег;
			
		КонецЕсли;
	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтруктураАдресПрибИзДрРегиона) И НЕ СтруктураАдресПрибИзДрРегиона.Свойство("ЗаПределамиРФ") Тогда
		Если МакетНовогоОбразца Тогда
			ШапкаОбласть.Параметры.СтранаПрибДГ = СтруктураАдресПрибИзДрРегиона.Страна;
		КонецЕсли;
		
		Попытка
			ШапкаОбласть.Параметры.СтранаПрибДГ          = ВРег(СтруктураАдресПрибИзДрРегиона.Страна);
		Исключение
		КонецПопытки; 	 
		
		ШапкаОбласть.Параметры.РегионПрибДГ = ВРег(СтруктураАдресПрибИзДрРегиона.Регион);			
		
		Если МакетНовогоОбразца Тогда
			
			ШапкаОбласть.Параметры.ДанныеОПрибытии0 = ВыборкаИсходник.ДанныеОПрибытии;
			
		КонецЕсли;
		
		ШапкаОбласть.Параметры.РайонПрибДГ           = ВРег(СтруктураАдресПрибИзДрРегиона.Район) ;
		ШапкаОбласть.Параметры.ГородПрибДГ           = ВРег(СтруктураАдресПрибИзДрРегиона.Город) ;
		ШапкаОбласть.Параметры.НаселенныйПунктПрибДГ = ВРег(СтруктураАдресПрибИзДрРегиона.НаселенныйПункт) ;
		ШапкаОбласть.Параметры.УлицаПрибДГ           = ВРег(СтруктураАдресПрибИзДрРегиона.Улица) ;
		ШапкаОбласть.Параметры.ДомПрибДГ             = ВРег(СтруктураАдресПрибИзДрРегиона.Дом) ;
		ШапкаОбласть.Параметры.КорпусПрибДГ          = ВРег(СтруктураАдресПрибИзДрРегиона.Корпус) ;
		ШапкаОбласть.Параметры.КвартираПрибДГ        = ВРег(СтруктураАдресПрибИзДрРегиона.Квартира) ;
		
	КонецЕсли;
			
	Если Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаФамилии Тогда
		
		// Поиск предыдущих ФИО при смене ФИО.
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 2
		|	бит_ФИОПроживающих.Фамилия,
		|	бит_ФИОПроживающих.Имя,
		|	бит_ФИОПроживающих.Отчество
		|ИЗ
		|	РегистрСведений.бит_ФИОПроживающих КАК бит_ФИОПроживающих
		|ГДЕ
		|	бит_ФИОПроживающих.Период <= &Момент
		|	И бит_ФИОПроживающих.ФизЛицо = &ФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_ФИОПроживающих.Период УБЫВ";
		
		Запрос.УстановитьПараметр("Момент" , НачалоДня(ДанныеПечати.Дата));
		Запрос.УстановитьПараметр("ФизЛицо", ДанныеПечати.РегистрируемоеЛицо);
		
		ТаблицаФИО = Запрос.Выполнить().Выгрузить();
		
		Если ТаблицаФИО.Количество() = 2 Тогда
			ШапкаОбласть.Параметры.ФамилияСмена  = ВРег(ТаблицаФИО[1].Фамилия);
			ШапкаОбласть.Параметры.ИмяСмена      = ВРег(ТаблицаФИО[1].Имя);
			ШапкаОбласть.Параметры.ОтчествоСмена = ВРег(ТаблицаФИО[1].Отчество);
		КонецЕсли;
		
		Если МакетНовогоОбразца Тогда			
			     			
			Если ЗначениеЗаполнено(ДанныеПечати.ДатаРождения) Тогда
				
				ШапкаОбласть.Параметры.ДеньРожденияСмена  = Формат(ДанныеПечати.ДатаРождения,"ДФ='дд'");
				ДатаМесяц 							 	  = Формат(ДанныеПечати.ДатаРождения,"ДФ='дд.MMMM'");
				ШапкаОбласть.Параметры.МесяцРожденияСмена = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
				ШапкаОбласть.Параметры.ГодРожденияСмена   = Формат(ДанныеПечати.ДатаРождения,"ДФ='yyyy'");
				
			КонецЕсли;
			
			Если ДанныеПечати.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				ШапкаОбласть.Область("ПолМуж1").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
			ИначеЕсли  ДанныеПечати.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				ШапкаОбласть.Область("ПолЖен1").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
			КонецЕсли; 
			
		Иначе
			
			Если ЗначениеЗаполнено(ДанныеПечати.ДатаРождения) Тогда
				ШапкаОбласть.Параметры.ГодРожденияСмена = Формат(ДанныеПечати.ДатаРождения,"ДФ='yyyy'");
			КонецЕсли; 
			
		КонецЕсли; 		
		
	КонецЕсли; 
	
	Если МакетНовогоОбразца Тогда
		
		ШапкаОбласть.Параметры.ДокументСоставил = ПолучитьИнициалы(ВыборкаИсходник.ОтветственныйПользователь);
		ШапкаОбласть.Параметры.ДеньСоставил =    Формат(ВыборкаИсходник.Дата,"ДФ='дд'");
		ДатаМесяц  = Формат(ВыборкаИсходник.Дата,"ДФ=dd.MM.yy");
		ШапкаОбласть.Параметры.МесяцСоставил   = Сред(ДатаМесяц, 4, 2);
		ШапкаОбласть.Параметры.ГодСоставил  = Формат(ВыборкаИсходник.Дата,"ДФ=yyyy");
		
		Если Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаФамилии Тогда
			
			ШапкаОбласть.Параметры.ДеньЗарегистрировал =    Формат(ВыборкаИсходник.ДатаРегистрации,"ДФ='дд'");
			ДатаМесяц  = Формат(ВыборкаИсходник.ДатаРегистрации,"ДФ=dd.MM.yy");
			ШапкаОбласть.Параметры.МесяцЗарегистрировал   = Сред(ДатаМесяц, 4, 2);
			ШапкаОбласть.Параметры.ГодЗарегистрировал  = Формат(ВыборкаИсходник.ДатаРегистрации,"ДФ=yyyy");

		Иначе
			
			ШапкаОбласть.Параметры.ДеньЗарегистрировал =    Формат(ВыборкаИсходник.Дата,"ДФ='дд'");
			ДатаМесяц  = Формат(ВыборкаИсходник.Дата,"ДФ=dd.MM.yy");
			ШапкаОбласть.Параметры.МесяцЗарегистрировал   = Сред(ДатаМесяц, 4, 2);
			ШапкаОбласть.Параметры.ГодЗарегистрировал  = Формат(ВыборкаИсходник.Дата,"ДФ=yyyy");

		КонецЕсли;
		
		
	КонецЕсли;
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ с печатной формой приказа о проведении.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьЛСУВ()
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка"  ,Объект.Ссылка);
	Запрос.УстановитьПараметр("ФизЛицо" ,Объект.РегистрируемоеЛицо);
	Запрос.УстановитьПараметр("Момент"  ,КонецДня(Объект.Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОписаниеДругойПричины,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаПрибытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаУбытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылИзЛС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанИзЛС,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ПроживающиеДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдресЗапятые,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдресЗапятые
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ФизЛицо = &ФизЛицо) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|			И бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет = бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	
	Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("ЛСУВ");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	// Фалг вида оперции регистрации по месту жительства.
	РегистрацияПМЖ = (Выборка.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства);
	
	Если Объект.КонтактнаяИнформация.Количество() > 0 Тогда
		
		Отбор = Новый Структура();
		Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ОткудаПрибылПредставление);
		
		Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
		
		Если ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) и Объект.ОткудаПрибылИзЛС Тогда
			
			ОткудаПрибылКонтактнаяИнформацияНаСервере();
			
			Если НЕ ЗначениеЗаполнено(ОткудаПрибылПредставлениеЗапятые) Тогда
				
				НаборЗаписей = НЕОПРЕДЕЛЕНО;
				
				
				бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ЛицевойСчет.Здание);
				
				Для Каждого СтрокаНабора Из НаборЗаписей Цикл
					Если СтрокаНабора.Вид = Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания Тогда
						ИскомаяСтрока = СтрокаНабора;
					КонецЕсли;
				КонецЦикла;
				
				ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
				
				СтруктураОткудаПрибыл = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
			Иначе 
				
				СтруктураОткудаПрибыл = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ОткудаПрибылПредставлениеЗапятые);
				
			КонецЕсли;
			
		ИначеЕсли Строки.количество() = 0 и ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) Тогда
			
			СтруктураОткудаПрибыл = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
			
		ИначеЕсли НЕ Строки.количество() = 0 Тогда
			
			//  15.10.2018
			Если ЗначениеЗаполнено(Строки[0].Значение) Тогда
				
				ОткудаПрибыл = Строки[0].Представление;
				СтруктураОткудаПрибыл = ПолучитьАдресБСП(Строки[0].Значение);
				
				//---				
			ИначеЕсли ЗначениеЗаполнено(Выборка.ОткудаПрибылАдресЗапятые) Тогда
				
				СтруктураОткудаПрибыл = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдресЗапятые);
				
				
			ИначеЕсли ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) и Объект.ОткудаПрибылИзЛС = Ложь Тогда
				
				СтруктураОткудаПрибыл = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
				
			Иначе
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перезаполните поле откуда прибыл адрес");
				
				СтруктураОткудаПрибыл = Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Отбор = Новый Структура();
		Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.КудаВыписанПредставление);
		
		Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
		
		Если Строки.количество() = 0 и ЗначениеЗаполнено(Выборка.КудаВыписанАдрес) Тогда
			
			СтруктураКудаВыписан = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.КудаВыписанАдрес);
			
		ИначеЕсли НЕ Строки.количество() = 0 Тогда
			
			//  15.10.2018
			Если ЗначениеЗаполнено(Строки[0].Значение) Тогда
				
				КудаВыписан = Строки[0].Представление;
				СтруктураКудаВыписан = ПолучитьАдресБСП(Строки[0].Значение);
				
				//---				
			ИначеЕсли ЗначениеЗаполнено(Выборка.КудаВыписанАдресЗапятые) Тогда
				
				СтруктураКудаВыписан = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.КудаВыписанАдресЗапятые);
				
			ИначеЕсли ЗначениеЗаполнено(Выборка.КудаВыписанАдрес) Тогда
				
				Если Объект.КудаВыписанИзЛС Тогда
					
					КудаВыписанКонтактнаяИнформацияНаСервере();
					
					Если НЕ ЗначениеЗаполнено(КудаВыписанПредставлениеЗапятые) Тогда
						
						НаборЗаписей = НЕОПРЕДЕЛЕНО;
						
						
						бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ЛицевойСчет.Здание);
						
						Для Каждого СтрокаНабора Из НаборЗаписей Цикл
							Если СтрокаНабора.Вид = Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания Тогда
								ИскомаяСтрока = СтрокаНабора;
							КонецЕсли;
						КонецЦикла;
						
						ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
						
						СтруктураКудаВыписан = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
					Иначе 
						
						СтруктураКудаВыписан = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(КудаВыписанПредставлениеЗапятые);
						
					КонецЕсли;
					
					
				Иначе
					СтруктураКудаВыписан = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.КудаВыписанАдрес);
				КонецЕсли;
				
			Иначе
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Перезаполните поле куда выписан адрес";
				Сообщение.Сообщить();
				
				СтруктураОткудаПрибыл = Неопределено;
				
			КонецЕсли;
			
		КонецЕсли;		
		
	Иначе
		
		СтруктураОткудаПрибыл = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
		СтруктураКудаВыписан = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.КудаВыписанАдрес);
		
	КонецЕсли;	
	
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) Тогда
		
		Если НЕ СтруктураОткудаПрибыл = Неопределено Тогда
			
			ШапкаОбласть.Параметры.РегионПриб          = СтруктураОткудаПрибыл.Регион; 
			ШапкаОбласть.Параметры.ГородПриб           = СтруктураОткудаПрибыл.Город;
			ШапкаОбласть.Параметры.РайонПриб           = СтруктураОткудаПрибыл.Район;
			ШапкаОбласть.Параметры.СтранаПриб          = СтруктураОткудаПрибыл.Страна;
			
			ШапкаОбласть.Параметры.НаселенныйПунктПриб 	= ?(ПустаяСтрока(СтруктураОткудаПрибыл.НаселенныйПункт)
			,СтруктураОткудаПрибыл.Улица 
			+ ", д." + СтруктураОткудаПрибыл.Дом 
			+?(ЗначениеЗаполнено(СтруктураОткудаПрибыл.корпус),", корп. " + СтруктураОткудаПрибыл.корпус,"") 
			+ ", кв." +СтруктураОткудаПрибыл.Квартира
			,СтруктураОткудаПрибыл.НаселенныйПункт);
			
		КонецЕсли;
		
		Если НЕ СтруктураКудаВыписан = Неопределено Тогда
			
			ШапкаОбласть.Параметры.РегионРег          = СтруктураКудаВыписан.Регион; 
			ШапкаОбласть.Параметры.РайонРег           = СтруктураКудаВыписан.Район;
			ШапкаОбласть.Параметры.ГородРег           = СтруктураКудаВыписан.Город; 
			ШапкаОбласть.Параметры.СтранаРег          = СтруктураКудаВыписан.Страна;
			
			ШапкаОбласть.Параметры.НаселенныйПунктРег = ?(ПустаяСтрока(СтруктураКудаВыписан.НаселенныйПункт)
			,СтруктураКудаВыписан.Улица 
			+ ", д." + СтруктураКудаВыписан.Дом 
			+?(ЗначениеЗаполнено(СтруктураКудаВыписан.корпус),", корп. " + СтруктураКудаВыписан.корпус,"") 
			+ ", кв." +СтруктураКудаВыписан.Квартира
			,СтруктураКудаВыписан.НаселенныйПункт);
			
		КонецЕсли;
		
		ГодРегистрации = Формат(Выборка.ПроживающиеДатаРегистрации, "ДФ=yyyy");
		   
		Если НЕ ПустаяСтрока(ГодРегистрации) Тогда
			
			ШапкаОбласть.Параметры.ГодРегПредМесто1 = Сред(ГодРегистрации,1,1);
			ШапкаОбласть.Параметры.ГодРегПредМесто2 = Сред(ГодРегистрации,2,1);
			ШапкаОбласть.Параметры.ГодРегПредМесто3 = Сред(ГодРегистрации,3,1);
			ШапкаОбласть.Параметры.ГодРегПредМесто4 = Сред(ГодРегистрации,4,1);
			
		КонецЕсли; 
		
		Если НЕ РегистрацияПМЖ Тогда
			ШапкаОбласть.Параметры.ЧислоТек = Формат(Выборка.Дата,"ДФ=dd");
			ДатаМесяц 						= Формат(Выборка.Дата,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцТек = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодТек   = Формат(Выборка.Дата,"ДФ=yyyy");
			
			ДолжностноеЛицоОрганизации = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Выборка.Организация,Выборка.ДолжностноеЛицо, Выборка.Дата); 
			
			ШапкаОбласть.Параметры.ДолжностноеЛицоОрганизации  = ДолжностноеЛицоОрганизации;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.МестоРождения) Тогда
			
			СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.РегистрируемоеЛицо.МестоРождения);
			ШапкаОбласть.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
			ШапкаОбласть.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
			ШапкаОбласть.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
			ШапкаОбласть.Параметры.СтранаРожд          = СтруктураМестоРождения.Страна;
			ШапкаОбласть.Параметры.НаселенныйПунктРожд = СтруктураМестоРождения.Село;
			
		Иначе
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "В справочнике ""Проживающие"" заполните место рождения регистрируемого лица!";
			Сообщение.Сообщить();
			
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.Пол) Тогда
			Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				ШапкаОбласть.Область("ПолМуж").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
			ИначеЕсли Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				ШапкаОбласть.Область("ПолЖен").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
			КонецЕсли;
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Выборка.Фамилия) Тогда
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "В справочнике ""Проживающие"" ФИО регистрируемого лица!";
			Сообщение.Сообщить();
		КонецЕсли; 
		
		ШапкаОбласть.Параметры.Заполнить(Выборка);
		
		Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.ДатаРождения) Тогда
			ШапкаОбласть.Параметры.ДеньРожд   = Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=dd");
			ДатаМесяц 						  = Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРожд  = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			МесяцРожд                         = Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=MM");
			ШапкаОбласть.Параметры.МесяцРожд1 = Сред(МесяцРожд,1,1);
			ШапкаОбласть.Параметры.МесяцРожд2 = Сред(МесяцРожд,2,1);
			ГодРожд                           = Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=yyyy");
			ШапкаОбласть.Параметры.ГодРожд1   = Сред(ГодРожд,1,1);
			ШапкаОбласть.Параметры.ГодРожд2   = Сред(ГодРожд,2,1);
			ШапкаОбласть.Параметры.ГодРожд3   = Сред(ГодРожд,3,1);
			ШапкаОбласть.Параметры.ГодРожд4   = Сред(ГодРожд,4,1);
		Иначе 
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "В справочнике ""Проживающие"" заполните дату рождения регистрируемого лица!";
			Сообщение.Сообщить();
		КонецЕсли;
		
	КонецЕсли; 
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ с печатной формой приказа о проведении.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьУВОРУ()
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация КАК Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий КАК Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо КАК РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование КАК ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл КАК ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации КАК ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия КАК Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя КАК Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество КАК Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачи,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства КАК ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ФИОПроживающихСрезПоследних.ФизЛицо.МестоРождения КАК ФизЛицоМестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПаспортнаяСлужба КАК ЛицевойСчетЗданиеПаспортнаяСлужба,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата КАК Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо КАК ДолжностноеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМСКудаПрибыл КАК ОрганФМСКудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМС КАК ОрганФМС,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОрганФМС.Руководитель КАК ОрганФМСДолжностноеЛицо,
	|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК ПредставлениеКвартиры
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗапросСнимаемыеСРег = Новый Запрос;
	ЗапросСнимаемыеСРег.Текст = "ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Проживающий КАК Проживающий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Проживающий.ДатаРождения КАК ПроживающийДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.ДатаРегистрации КАК ДатаРегистрации, 
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка.ОрганФМС КАК ОрганФМСВыбытия
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ.СнимаемыеСРегУчета КАК бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Ссылка = &Ссылка";
	
	ЗапросСнимаемыеСРег.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	ВыборкаСнимаемыеСРег = ЗапросСнимаемыеСРег.Выполнить().Выбрать();
	
	РегЛицаСтр = "";
	Пока ВыборкаСнимаемыеСРег.Следующий() Цикл
		
		РегЛицаСтр = РегЛицаСтр 
		+?(ЗначениеЗаполнено(ВыборкаСнимаемыеСРег.Проживающий)," "+ Строка(ВыборкаСнимаемыеСРег.Проживающий),"")
		+?(ЗначениеЗаполнено(ВыборкаСнимаемыеСРег.ПроживающийДатаРождения), ", "+Формат(ВыборкаСнимаемыеСРег.ПроживающийДатаРождения,"ДФ='yyyy ""г.р;""'"), "");
		
	КонецЦикла;
	РегЛицаСтр = УбратьПоследнийСимвол(РегЛицаСтр, ";") + ".";
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	ТабДокумент.РазмерСтраницы = "A5";
	ТабДокумент.АвтоМасштаб = Истина;
	ТабДокумент.ПолеСлева = 5;
	ТабДокумент.ПолеСверху = 5;
	ТабДокумент.ПолеСправа = 5;
	ТабДокумент.ПолеСнизу = 5;
	
	Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("УВОРУ");
	
	ШапкаОбласть   = Макет.ПолучитьОбласть("Шапка");
	РегЛицаОбласть = Макет.ПолучитьОбласть("РегЛица");	
	АдресЛицСчетОбласть = Макет.ПолучитьОбласть("АдресЛицСчет");
	АдресЛицСчетДопСтрока = Макет.ПолучитьОбласть("АдресЛицСчетДопСтрока");
	ОформленоСнятиеОбласть  = Макет.ПолучитьОбласть("ОформленоСнятие");
	НаименованиеОрганизцаииОбласть = Макет.ПолучитьОбласть("НаименованиеОрганизации");
	ПодвалОбласть  = Макет.ПолучитьОбласть("Подвал");
	
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	//ШапкаОбласть.Параметры.ЧислоТек = Формат(Выборка.Дата,"ДФ=dd");
	//ДатаМесяц 						= Формат(Выборка.Дата,"ДФ='дд.MMMM'");
	//ШапкаОбласть.Параметры.МесяцТек = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	//ШапкаОбласть.Параметры.ГодТек   = Формат(Выборка.Дата,"ДФ=yy");
	
	ШапкаОбласть.Параметры.ОрганУчета = Объект.ОрганФМСКудаПрибыл;
	
	АдресОрганаФМС = бит_ПаспортныйСтолСервер.ПолучитьАдресИзКонтактнойИнформации(Объект.ОрганФМС, "Фактический");
	
	ОрганУчетаАдрес_1 = "";
	ОрганУчетаАдрес_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресОрганаФМС, 40, ОрганУчетаАдрес_1 , ОрганУчетаАдрес_2 );
	ШапкаОбласть.Параметры.ОрганУчетаАдрес_1 = ОрганУчетаАдрес_1;
	ШапкаОбласть.Параметры.ОрганУчетаАдрес_2 = ОрганУчетаАдрес_2;
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) Тогда
		
		ФизЛицо_1 = "";
		ФизЛицо_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(РегЛицаСтр, 70, ФизЛицо_1 , ФизЛицо_2 );
		ШапкаОбласть.Параметры.ФизЛицо_1 = ФизЛицо_1;
		ТабДокумент.Вывести(ШапкаОбласть);
		
		ДлиннаРегЛица = СтрДлина(РегЛицаСтр);
		ДлиннаТекСтроки = 70;
		
		Пока ДлиннаТекСтроки < ДлиннаРегЛица  Цикл
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ФизЛицо_2, 75, ФизЛицо_1 , ФизЛицо_2 );
			РегЛицаОбласть.Параметры.ФизЛицо_2 = ФизЛицо_1;
			ДлиннаТекСтроки = ДлиннаТекСтроки + 75;
			ТабДокумент.Вывести(РегЛицаОбласть);
			
		КонецЦикла;
		
	КонецЕсли; 	
	
	ОформленоСнятиеОбласть.Параметры.ЧислоСнят = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=dd");
	ДатаМесяц 						= Формат(Выборка.ДатаСнятияСРегистрации,"ДФ='дд.MMMM'");
	ОформленоСнятиеОбласть.Параметры.МесяцСнят = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ОформленоСнятиеОбласть.Параметры.ГодСнят   = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=yy");
	
	ПредставлениеРег_1 = "";
	ПредставлениеРег_2 = "";
	
	Если ЗначениеЗаполнено(Выборка.ПочтовыйАдрес) Тогда
		СтрокаАдресРегистрации = Выборка.ПочтовыйАдрес + ", кв." + Строка(Выборка.ПредставлениеКвартиры);
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаАдресРегистрации, 75, ПредставлениеРег_1 , ПредставлениеРег_2 );
	КонецЕсли; 
	
	АдресЛицСчетОбласть.Параметры.ПредставлениеРег_1 = ПредставлениеРег_1;
	ТабДокумент.Вывести(АдресЛицСчетОбласть);
	
	Если ЗначениеЗаполнено(ПредставлениеРег_2) Тогда 
		АдресЛицСчетДопСтрока.Параметры.ПредставлениеРег_2 = ПредставлениеРег_2;
		ТабДокумент.Вывести(АдресЛицСчетДопСтрока);
	КонецЕсли;
	
	НаименованиеОрганизации_1 = "";
	НаименованиеОрганизации_2 = "";
	
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ОрганФМС, 39, НаименованиеОрганизации_1 , НаименованиеОрганизации_2 );
	
	ОформленоСнятиеОбласть.Параметры.НаименованиеОрганизации = НаименованиеОрганизации_1;
	ТабДокумент.Вывести(ОформленоСнятиеОбласть);
	
	Пока ЗначениеЗаполнено(НаименованиеОрганизации_2) Цикл
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(НаименованиеОрганизации_2, 39, НаименованиеОрганизации_1, НаименованиеОрганизации_2);
		НаименованиеОрганизцаииОбласть.Параметры.НаименованиеОрганизации_2 = НаименованиеОрганизации_1;
		ТабДокумент.Вывести(НаименованиеОрганизцаииОбласть);
	КонецЦикла;
	
	Если ЗначениеЗаполнено(Выборка.ОрганФМСДолжностноеЛицо) Тогда
		ПодвалОбласть.Параметры.ДолжностноеЛицо = ПолучитьИнициалы(Выборка.ОрганФМСДолжностноеЛицо);	
	КонецЕсли;
	
	ТабДокумент.Вывести(ПодвалОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ с печатной формой сличительной ведомости.
//
// Параметры:
