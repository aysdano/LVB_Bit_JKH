&НаКлиенте
Процедура Вперед(Команда)
	
	Если НЕ Объект.ТекущийПакет = Объект.КоличествоПакетов Тогда
		
		ИзменитьСостояниеТабличногоПоля("ФОРМИРОВАНИЕОТЧЕТА");
		Объект.ТекущийПакет = Объект.ТекущийПакет + 1;
		
		ТабличныйДокумент = СформироватьКвитанции();
		
		Если НЕ ТабличныйДокумент = Неопределено Тогда
			
			ВывестиПакетНаСервере(ТабличныйДокумент);
			
		КонецЕсли;
		
		ИзменитьСостояниеТабличногоПоля();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Назад(Команда)
	
	Если НЕ Объект.ТекущийПакет <= 1 Тогда
		
		ИзменитьСостояниеТабличногоПоля("ФОРМИРОВАНИЕОТЧЕТА");
		Объект.ТекущийПакет = Объект.ТекущийПакет - 1;
		
		ТабличныйДокумент = СформироватьКвитанции();
		
		Если НЕ ТабличныйДокумент = Неопределено Тогда
			
			ВывестиПакетНаСервере(ТабличныйДокумент);
			
		КонецЕсли;
		
		ИзменитьСостояниеТабличногоПоля();
		
	КонецЕсли; 
	
КонецПроцедуры

