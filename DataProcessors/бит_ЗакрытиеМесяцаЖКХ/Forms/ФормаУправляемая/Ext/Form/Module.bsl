&НаСервере
Функция НайтиДокументНаРеализацию(Контрагент, ДоговорКонтрагента, Здание, ЛС)	
	
	ДокументРеализации = Неопределено;
	// БИТ_ЖКХ 23.10.2017 11:18:05 Начало правки... 
	ЗапросУсл="";
    Если ЗначениеЗаполнено(ЛС) Тогда
        ЗапросУсл =  "
        |	И ДокументРеализации.бит_ЛицевойСчет = &бит_ЛицевойСчет";
	КонецЕсли; 
	
	//16.05.2019
	ДопЗапрос = "";
	// 23.06.2020
	если Объект.ДокументРаспределенияРасходовНаОказаниеУслуг <> "АктОбОказанииПроизводственныхУслуг" тогда
		ДопЗапрос = " И ( ДокументРеализации.бит_Здание = &бит_Здание " + строка(" ИЛИ  ") + 
		                строка(" ДокументРеализации.бит_Здание = &пустоеЗдание) ") +   
		                     ЗапросУсл + " ";
	конецесли;	
	
	// БИТ_ЖКХ 23.10.2017 11:18:10 Конец правки. 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Контрагент"        , Контрагент);
	Запрос.УстановитьПараметр("ДоговорКонтрагента", ДоговорКонтрагента);
	// БИТ_ЖКХ 23.10.2017 11:17:43 Начало правки... 
	//Запрос.УстановитьПараметр("ДокументОснование" , ДокументОснование);
	Запрос.УстановитьПараметр("бит_Здание" , Здание);
	Запрос.УстановитьПараметр("пустоеЗдание" , справочники.бит_СписокЗданий.ПустаяСсылка());
	Запрос.УстановитьПараметр("ВидОперации" ,Перечисления.ВидыОперацийРеализацияТоваров.Услуги);

	Запрос.УстановитьПараметр("бит_ЛицевойСчет" , ЛС);
