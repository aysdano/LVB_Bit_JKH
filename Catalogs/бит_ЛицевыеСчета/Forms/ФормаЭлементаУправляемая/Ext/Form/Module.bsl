		Если Элемент.ТекущийЭлемент.Имя <> мКэшЗначений.мКолонка Тогда
			
			ДанныеЗамечаний = 	ТаблицаЗамечаний;
			
			мКэшЗначений.мКолонка = Элемент.ТекущийЭлемент.Имя; 
			
		КонецЕсли;
	КонецЕсли;
	
