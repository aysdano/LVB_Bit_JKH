Функция ПолучитьКвитанциюПоЛС(Источник, Пеня = ложь) Экспорт
	
	
	Если ТипЗнч(Источник) = Тип("СтрокаТаблицыЗначений") Тогда
		
		мСтруктураДанных        = Источник.Значение.СтруктураДанных;
		мТаблицаПечати          = Источник.Значение.ТаблицаПечати;
		мТаблицаПечатиСчетчиков = Источник.Значение.ТаблицаПечатиСчетчиков;
		мТаблицаПерерасчетов    = Источник.Значение.ТаблицаПерерасчетов;
		мТаблицаСвойств			= Источник.Значение.ТаблицаСвойств;
		мТаблицаОбщедомовыхСчетчиков = Источник.Значение.ТаблицаОбщедомовыхСчетчиков;
		
	Иначе
		
		Структура = ПолучитьИзВременногоХранилища(Источник);
		
		мСтруктураДанных        = Структура.СтруктураДанных;
		мТаблицаПечати          = Структура.ТаблицаПечати;
		мТаблицаПечатиСчетчиков = Структура.ТаблицаПечатиСчетчиков;
		мТаблицаПерерасчетов    = Структура.ТаблицаПерерасчетов;
		мТаблицаСвойств			= Структура.ТаблицаСвойств;
		мТаблицаОбщедомовыхСчетчиков = Структура.ТаблицаОбщедомовыхСчетчиков;
		
	КонецЕсли;	
	
	
	Если ГруппироватьУслуги ИЛИ мСтруктураДанных.ГруппироватьУслуги Тогда
		
		Если НЕ (мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция // Квитанция №1.  
			ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция2	// Квитанция №1 чек слева.
			ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция6	// Квитанция №4.
			ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияСПБ // Квитанция №1 СПБ.
			ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение
			ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент1) Тогда // Платежный документ РК БИТ.
			
			ПерезаполнитьПоГруппа();

		КонецЕсли;
		
	КонецЕсли;
	
	//23.05.2019
	Если Пеня = истина тогда
		
		мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокументПеня;
		
	КонецЕсли;	
	
	Если НЕ МакетКв.Предопределенный И МакетКв.ИспользоватьПользовательскуюФункцию Тогда
		
		Квитанция = ВыполнитьПользовательскуюФункцию(); 
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение2 Тогда
		
		ДляКиева  = мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение2;
		Квитанция = ПечатьСчетИзвещение(ДляКиева);
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение1 Тогда
		
		Квитанция = ПечатьСчетИзвещение1();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение3 Тогда
		
		Квитанция = ПечатьСчетИзвещение2();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение4 Тогда
		
		Квитанция = ПечатьСчетИзвещение3();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение5 ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение7 Тогда
		
		УчетОплатыВСальдо = (мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение5);
		
		Квитанция = ПечатьСчетИзвещение4(УчетОплатыВСальдо);
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение6 Тогда
		
		Квитанция = ПечатьСчетИзвещение5();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция 
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция2 Тогда
		
		Квитанция = ПечатьКвитанция();
		
    ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияСПБ Тогда
		
		Квитанция = ПечатьКвитанцияСПБ();		
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция3 Тогда
		
		Квитанция = ПечатьКвитанция2();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция4 ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция5 Тогда
		
		УчетПени = мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция5;
		
		Квитанция = ПечатьКвитанция3(УчетПени);
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция6 Тогда
		
		Квитанция = ПечатьКвитанция4();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение8 Тогда
		
		Квитанция = ПечатьСчетИзвещение6();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещениеРСК Тогда
		
		Квитанция = ПечатьСчетИзвещениеРСК();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент Тогда
		
		Квитанция = ПечатьПлатежныйДокумент();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент1 Тогда
		
		Квитанция = ПечатьПлатежныйДокументРКБИТ();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент Тогда
		
		Квитанция = ПечатьЕдиныйПлатежныйДокумент();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументПени Тогда
		
		Квитанция = СформироватьПлатежныйДокументПени(мСтруктураДанных.ВходящееСальдоПени,мСтруктураДанных.НачисленоПениЗаПериод,мСтруктураДанных.ПолучательКоррСчет,мСтруктураДанных.ПолучательБанк,мСтруктураДанных.ИтогПени,мСтруктураДанных.ПолучательТелефон,мСтруктураДанных.ПолучательПредставление,мСтруктураДанных.ПолучательКПП,мСтруктураДанных.ПолучательИНН,мСтруктураДанных.ПолучательРС,мСтруктураДанных.ПолучательАдрес,мСтруктураДанных.ЛицевойСчет, мСтруктураДанных.ЛицевойСчетФио, мСтруктураДанных.Дата);
		
	ИначеЕсли  мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924 Тогда
		Квитанция = ПечатьПлатежныйДокументРК924();
		
	ИначеЕсли  мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ Тогда
		Квитанция = ПечатьПлатежныйДокументРК924ГИСЖКХ();
		
	ИначеЕсли  мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК43 Тогда
		Квитанция = ПечатьПлатежныйДокументРК43();
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент679_30 Тогда
		Квитанция = ПечатьЕдиныйПлатежныйДокумент679_30();
	
	ИначеЕсли Пеня = ложь и мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32
		            ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32_Новый 
					ИЛИ	мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32_НовыйСПени Тогда
		Квитанция = ПечатьЕдиныйПлатежныйДокумент761_32();
		
	//23.05.2019
	ИначеЕсли Пеня = истина Тогда
		Квитанция = ПечатьЕдиныйПлатежныйДокумент();
	КонецЕсли; 
	
	Если ТипЗнч(Квитанция) = Тип("ТабличныйДокумент")Тогда
		
		Квитанция.АвтоМасштаб = Истина;
		Квитанция.ПолеСверху  = 0;
		Квитанция.ПолеСнизу   = 0;
		
		Если Не МакетКв.ИспользоватьПользовательскуюФункцию Тогда
			Если мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК43 Тогда 
				Квитанция.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
			Иначе
				Квитанция.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
			КонецЕсли;
		КонецЕсли;
		
		Если ПечататьСрочноеДонесениеОПоказанияхВодосчетчиков Тогда
			
			Донесение = СформироватьДонесениеОПоказанияхВодосчетчиков(мСтруктураДанных.ЛицевойСчет, мСтруктураДанных.ЛицевойСчетФио, мСтруктураДанных.Дата);
			
			Если НЕ Донесение = Неопределено Тогда
				
				Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(Квитанция, Донесение) Тогда
					Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
					Квитанция.Вывести(Донесение);
					Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
				Иначе
					Квитанция.Вывести(Донесение);
				КонецЕсли;  
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если ПечататьПлатежныйДокументПени Тогда
			
			Если мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент 
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент1 
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент  
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32  
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924 
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ Тогда 
				
				ДокументПени = СформироватьПлатежныйДокументПени(мСтруктураДанных.ВходящееСальдоПени,мСтруктураДанных.НачисленоПениЗаПериод,мСтруктураДанных.ПолучательКоррСчет,мСтруктураДанных.ПолучательБанк,мСтруктураДанных.ИтогПени,мСтруктураДанных.ПолучательТелефон,мСтруктураДанных.ПолучательПредставление,мСтруктураДанных.ПолучательКПП,мСтруктураДанных.ПолучательИНН,мСтруктураДанных.ПолучательРС,мСтруктураДанных.ПолучательАдрес,мСтруктураДанных.ЛицевойСчет, мСтруктураДанных.ЛицевойСчетФио, мСтруктураДанных.Дата);
				
				Если НЕ ДокументПени = Неопределено Тогда
					
					Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(Квитанция, ДокументПени) Тогда
						Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
						Квитанция.Вывести(ДокументПени);
						Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
					Иначе
						Квитанция.Вывести(ДокументПени);
					КонецЕсли;  
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

Функция ПечатьКвитанций(Знач ТаблицаДанных, ПервыйЭлемент = 0, ПоследнийЭлемент = 0, АдресХранилщаДанных = Неопределено) Экспорт
	
	Если ПоследнийЭлемент = 0 Тогда
		ПоследнийЭлемент = ТаблицаДанных.Количество() -1;
	КонецЕсли; 
	
	мТаблицаПлатежиГИСЖКХ12			= ПолучитьТаблицаПлатежиГИСЖКХ12();
	мТаблицаПлатежиГИСЖКХ36			= ПолучитьТаблицаПлатежиГИСЖКХ36();
	мТаблицаПлатежиГИСЖКХДПД		= ПолучитьТаблицаПлатежиГИСЖКХДПД();
	мТаблицаПлатежиГИСЖКХНеустойки	= ПолучитьТаблицаПлатежиГИСЖКХНеустойки();
	
	ТабличнйДокумент = Новый ТабличныйДокумент;
	
	УстановитьНастройкиТабличногоДокумена(ТабличнйДокумент);
	
	ПодключитьВнешнююКомпонентуПечатиШтрихкода();
	
	Отказ = Ложь;
	Для Значение = ПервыйЭлемент По ПоследнийЭлемент  Цикл
		
		СтрокаТаблица = ТаблицаДанных[Значение];
		
		//23.05.2019
		ВывестиНаПечатьКвитанцию(ТабличнйДокумент, СтрокаТаблица, ложь, Отказ);
		
		Если Отказ Тогда
			Прервать;
		КонецЕсли; 
		
	КонецЦикла;
	
	Попытка
		СтруктураПД = Новый Структура();
		СтруктураПД.Вставить("ТаблицаПлатежиГИСЖКХ12"		, мТаблицаПлатежиГИСЖКХ12);
		СтруктураПД.Вставить("ТаблицаПлатежиГИСЖКХ36"		, мТаблицаПлатежиГИСЖКХ36);
		СтруктураПД.Вставить("ТаблицаПлатежиГИСЖКХДПД"		, мТаблицаПлатежиГИСЖКХДПД);
		СтруктураПД.Вставить("ТаблицаПлатежиГИСЖКХНеустойки", мТаблицаПлатежиГИСЖКХНеустойки);
		АдресХранилщаДанных = ПоместитьВоВременноеХранилище(СтруктураПД, Новый УникальныйИдентификатор);
	Исключение
	КонецПопытки;
	
	Возврат ТабличнйДокумент;
	
КонецФункции

// Процедура устанавливает настройки табличного документа. 
//
Процедура УстановитьНастройкиТабличногоДокумена(ТабличныйДокумент) Экспорт
	
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ПолеСверху  = 0;
	ТабличныйДокумент.ПолеСнизу   = 0;
	
	Если НЕ ЗначениеЗаполнено(мОсновнойВариантМакета) Тогда
		
	ИначеЕсли (мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК43 
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924 
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ) 
		И НЕ ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт Тогда
		
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ИначеЕсли НЕ (мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент 
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК43 
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ) 
		И ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт Тогда
		
		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВывестиНаПечатьКвитанцию(ТабличнйДокумент, Знач Источник, Пеня = ложь, Отказ = Ложь) Экспорт
	
	//23.05.2019
	Квитанция = ПолучитьКвитанциюПоЛС(Источник, Пеня);
	
	Если Квитанция = Неопределено Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если Квитанция.ОриентацияСтраницы <> ТабличнйДокумент.ОриентацияСтраницы Тогда
		ТабличнйДокумент.ОриентацияСтраницы = Квитанция.ОриентацияСтраницы;
	КонецЕсли;
	
	ТабличнйДокумент.Вывести(Квитанция);
	
	// Вывод разделителя для квитанций.
	ВывестиРазделитель = Истина;
	
	Если  мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция  
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция2
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияСПБ
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция3
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция4
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция5
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.Квитанция6 
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументПени Тогда
		Если НЕ ПечатьКвитанцийНаКаждойСтанице Тогда
			Попытка
				ВывестиРазделитель = НЕ ТабличнйДокумент.ПроверитьВывод(Квитанция);
			Исключение
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Установите принтер, пожалуйста!'"));
			КонецПопытки;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ВывестиРазделитель Тогда
		ТабличнйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПерезаполнитьПоГруппа()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаПечати", мТаблицаПечати);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПечати.ГруппаУслуги,
	|	ТаблицаПечати.Услуга,
	|	ТаблицаПечати.Сальдо,
	|	ТаблицаПечати.Пени,
	|	ТаблицаПечати.Начислено,
	|	ТаблицаПечати.Льгота,
	|	ТаблицаПечати.Оплата,
	|	ТаблицаПечати.Разовые,
	|	ТаблицаПечати.КОплате,
	|	ТаблицаПечати.КОплатеЗаМесяц,
	|	ТаблицаПечати.Долг,
	|	ТаблицаПечати.ПереплатаНаНачало,
	|	ТаблицаПечати.ПриоритетГруп,
	|	ТаблицаПечати.УслугаПредставление,
	|	ТаблицаПечати.НастройкаСтавки,
	|	ТаблицаПечати.Количество,
	|	ТаблицаПечати.ЕдИзм,
	|	ТаблицаПечати.Объем,
	|	ТаблицаПечати.ОбъемИНД,
	|	ТаблицаПечати.ОбъемОбщДом,
	|	ТаблицаПечати.НачисленоИНД,
	|	ТаблицаПечати.НачисленоОбщДом
	|ПОМЕСТИТЬ ТМП
	|ИЗ
	|	&ТаблицаПечати КАК ТаблицаПечати
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТМП.ГруппаУслуги КАК Услуга,
	|	ТМП.Услуга КАК УслугаСтар,
	|	ТМП.Пени КАК Пени,
	|	ТМП.Начислено КАК Начислено,
	|	ТМП.Льгота КАК Льгота,
	|	ТМП.Оплата КАК Оплата,
	|	ТМП.Разовые КАК Разовые,
	|	ТМП.КОплате КАК КОплате,
	|	ТМП.КОплатеЗаМесяц КАК КОплатеЗаМесяц,
	|	ТМП.Долг КАК Долг,
	|	ТМП.ПереплатаНаНачало КАК ПереплатаНаНачало,
	|	ТМП.ПриоритетГруп КАК ПриоритетГруп,
	|	ТМП.Сальдо КАК Сальдо,
	|	ТМП.УслугаПредставление КАК УслугаПредставление,
	|	ТМП.НастройкаСтавки,
	|	ТМП.Количество,
	|	ТМП.ЕдИзм,
	|	ТМП.Объем,
	|	ТМП.ОбъемИНД,
	|	ТМП.ОбъемОбщДом,
	|	ТМП.НачисленоИНД,
	|	ТМП.НачисленоОбщДом
	|ИЗ
	|	ТМП КАК ТМП
	|ИТОГИ
	|	СУММА(Пени),
	|	СУММА(Начислено),
	|	СУММА(Льгота),
	|	СУММА(Оплата),
	|	СУММА(Разовые),
	|	СУММА(КОплате),
	|	СУММА(КОплатеЗаМесяц),
	|	СУММА(Долг),
	|	СУММА(ПереплатаНаНачало),
	|	МАКСИМУМ(ПриоритетГруп),
	|	СУММА(Сальдо)
	|ПО
	|	Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТМП";
	
	Результат   = Запрос.Выполнить();
	ВыборкаГруп = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	мТаблицаПечати.Очистить();
	
	Пока ВыборкаГруп.Следующий() Цикл
		
		НоваяСтрока = мТаблицаПечати.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаГруп);
		НоваяСтрока.УслугаПредставление = ВыборкаГруп.Услуга.Наименование;
		
		Выборка = ВыборкаГруп.Выбрать();
		
		Если Выборка.Количество() = 1 Тогда
			
			Выборка.Следующий();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Услуга              = Выборка.УслугаСтар;
			НоваяСтрока.УслугаПредставление = Выборка.УслугаПредставление; 
			
		ИначеЕсли ВыборкаГруп.Услуга.Пустая() Тогда 
			
			мТаблицаПечати.Удалить(НоваяСтрока);
			Пока Выборка.Следующий() Цикл
				
				НоваяСтрокаУслуги = мТаблицаПечати.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаУслуги, Выборка);
				НоваяСтрокаУслуги.Услуга = Выборка.УслугаСтар;
				
			КонецЦикла; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииФормированияСтруктурыДанных

