&НаСервереБезКонтекста
Процедура ПолучитьДаты(Набор,ПолеИсточник,ПолеПриемник)
	Для каждого Запись из Набор цикл
		Если лев(Запись[ПолеИсточник],2)="  " тогда
			Запись[ПолеПриемник]= '0001-01-01'
		иначе
			Год = сред(Запись[ПолеИсточник],7,4);
			Если Год <"1900" или Год>"2500" тогда
				Запись[ПолеПриемник]= '0001-01-01';
				продолжить;
			КонецЕсли;	
			Мес = сред(Запись[ПолеИсточник],4,2);
			Ден = лев(Запись[ПолеИсточник],2);
			Попытка
				Запись[ПолеПриемник]= дата(""+Год+Мес+Ден);
			исключение	
				Запись[ПолеПриемник]= '0001-01-01'
			КонецПопытки;	
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры	

