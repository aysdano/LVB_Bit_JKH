&НаСервере
Функция ПолучитьEmailПроживающего(ПлатежныйДокумент)

	Результат = "";
	Если ЗначениеЗаполнено(ПлатежныйДокумент.бит_ЛицевойСчет) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЛицевойСчет", ПлатежныйДокумент.бит_ЛицевойСчет);
		Запрос.УстановитьПараметр("Дата", КонецМесяца(ПериодОплат.ДатаНачала));
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ПолучательПисьма,
			|	КИ.Представление КАК АдресПочты
			|ИЗ
			|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК КИ
			|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = КИ.Ссылка
			|			И (КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты))
			|			И (КИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПроживающего))
			|ГДЕ
			|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
			|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
			|	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)";
		
		ТЗКонтИнф = Запрос.Выполнить().Выгрузить();
		Если ТЗКонтИнф.Количество() > 0 Тогда
			Результат = Строка(ТЗКонтИнф[0].АдресПочты);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция ПолучитьТелефонПроживающего(ЛицевойСчет)

	Результат = "";
	Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
		Запрос.УстановитьПараметр("Дата", КонецМесяца(ПериодОплат.ДатаНачала));
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ПолучательПисьма,
			|	КИ.Представление КАК Телефон
			|ИЗ
			|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
			|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК КИ
			|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = КИ.Ссылка
			|			И (КИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон))
			|			И (КИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПроживающего))
			|ГДЕ
			|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
			|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
			|	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)";
		
		ТЗКонтИнф = Запрос.Выполнить().Выгрузить();
		Если ТЗКонтИнф.Количество() > 0 Тогда
			Результат = Строка(ТЗКонтИнф[0].Телефон);
		КонецЕсли;
	КонецЕсли;
	
	Возврат Результат;

КонецФункции

&НаСервере
Функция СтатусГрупповойПечатиНаСервере()

	Результат = Новый Структура;
    Результат.Вставить("ЕстьРаботающаяОбработка", Ложь);
    Результат.Вставить("ВидОплаты", ВидОплаты);
    Результат.Вставить("РабочееМесто");
    Результат.Вставить("ДатаНачала");
    Результат.Вставить("ДатаОкончания");
	
	НаборЗаписейДляКорректировки = РегистрыСведений.лб_СтатусыГрупповойПечатиЧеков.СоздатьНаборЗаписей();
	НаборЗаписейДляКорректировки.Отбор.ВидОплаты.Использование 	= Истина;
	НаборЗаписейДляКорректировки.Отбор.ВидОплаты.Значение 		= ВидОплаты;
	НаборЗаписейДляКорректировки.Отбор.ДатаНачала.Использование 	= Истина;
	НаборЗаписейДляКорректировки.Отбор.ДатаОкончания.Использование 	= Истина;
	НаборЗаписейДляКорректировки.Отбор.ДатаНачалаПечати.Использование 	= Истина;
	
	
	НаборЗаписейСтатусыГрупповойПечатиЧеков	= РегистрыСведений.лб_СтатусыГрупповойПечатиЧеков.СоздатьНаборЗаписей();
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.Завершена.Использование 	= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.Завершена.Значение 		= Ложь;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ВидОплаты.Использование 	= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ВидОплаты.Значение 		= ВидОплаты;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Прочитать();
	
	Если НаборЗаписейСтатусыГрупповойПечатиЧеков.Количество() > 0 Тогда
		
		ЕстьИзменения = Ложь;
		Для Каждого Запись ИЗ НаборЗаписейСтатусыГрупповойПечатиЧеков Цикл
			Если ТекущаяДатаСеанса() - Запись.ДатаПечатиПоследнегоЧека > 60 Тогда
				
				НаборЗаписейДляКорректировки.Отбор.ДатаНачала.Значение		 = Запись.ДатаНачала;
				НаборЗаписейДляКорректировки.Отбор.ДатаОкончания.Значение 	 = Запись.ДатаОкончания;
				НаборЗаписейДляКорректировки.Отбор.ДатаНачалаПечати.Значение = Запись.ДатаНачалаПечати;
				НаборЗаписейДляКорректировки.Прочитать();
				Если НаборЗаписейДляКорректировки.Количество() > 0 Тогда
					НаборЗаписейДляКорректировки[0].Завершена = Истина;
					
					Попытка
						НаборЗаписейДляКорректировки.Записать(Истина);
					Исключение
						Сообщить(ОписаниеОшибки());
					КонецПопытки;
					
				КонецЕсли;
				
			ИначеЕсли ПериодОплат.ДатаНачала <= Запись.ДатаОкончания И ПериодОплат.ДатаОкончания >= Запись.ДатаНачала Тогда
				Результат.ЕстьРаботающаяОбработка = Истина;
				Результат.РабочееМесто			  = Запись.РабочееМесто;
				Результат.ДатаНачала 			  = Запись.ДатаНачала;
				Результат.ДатаОкончания 		  = Запись.ДатаОкончания;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли; 

	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗаписатьНачалоПечатиЧекаНаСервере()

	Результат = Истина;
	
	НаборЗаписейСтатусыГрупповойПечатиЧеков	= РегистрыСведений.лб_СтатусыГрупповойПечатиЧеков.СоздатьНаборЗаписей();
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.Завершена.Использование	 	= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.Завершена.Значение 			= Ложь;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ВидОплаты.Использование 		= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ВидОплаты.Значение 			= ВидОплаты;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ДатаНачала.Использование	 	= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ДатаНачала.Значение 			= ПериодОплат.ДатаНачала;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ДатаОкончания.Использование 	= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ДатаОкончания.Значение 		= ПериодОплат.ДатаОкончания;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Прочитать();
	Если НаборЗаписейСтатусыГрупповойПечатиЧеков.Количество() > 0 Тогда
		
		Для Каждого Запись ИЗ НаборЗаписейСтатусыГрупповойПечатиЧеков Цикл
			Запись.ДатаПечатиПоследнегоЧека = ТекущаяДатаСеанса();
		КонецЦикла;
			
	Иначе
		НоваяЗапись=НаборЗаписейСтатусыГрупповойПечатиЧеков.Добавить();
		НоваяЗапись.ВидОплаты = ВидОплаты;
		НоваяЗапись.ДатаНачала = ПериодОплат.ДатаНачала;
		НоваяЗапись.ДатаОкончания = ПериодОплат.ДатаОкончания;
		НоваяЗапись.ДатаНачалаПечати = ТекущаяДатаСеанса();
		НоваяЗапись.ДатаПечатиПоследнегоЧека = ТекущаяДатаСеанса();
		НоваяЗапись.РабочееМесто = РабочееМесто;
	КонецЕсли; 
	
	Попытка
		НаборЗаписейСтатусыГрупповойПечатиЧеков.Записать(Истина);
	Исключение
		Сообщить(ОписаниеОшибки());
		Результат = Ложь;
	КонецПопытки;
				
	Возврат Результат;

КонецФункции

&НаСервере
Функция ЗаписатьОкончаниеПечатиЧековНаСервере()

	Результат = Истина;
	
	НаборЗаписейСтатусыГрупповойПечатиЧеков	= РегистрыСведений.лб_СтатусыГрупповойПечатиЧеков.СоздатьНаборЗаписей();
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ВидОплаты.Использование 		= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ВидОплаты.Значение 			= ВидОплаты;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ДатаНачала.Использование	 	= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ДатаНачала.Значение 			= ПериодОплат.ДатаНачала;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ДатаОкончания.Использование 	= Истина;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Отбор.ДатаОкончания.Значение 		= ПериодОплат.ДатаОкончания;
	НаборЗаписейСтатусыГрупповойПечатиЧеков.Прочитать();
	Если НаборЗаписейСтатусыГрупповойПечатиЧеков.Количество() > 0 Тогда
		
		Для Каждого Запись ИЗ НаборЗаписейСтатусыГрупповойПечатиЧеков Цикл
			Если НЕ Запись.Завершена Тогда
				Запись.Завершена = Истина;
				Запись.ЗавершенаБезОшибок = Истина;
			КонецЕсли;
		КонецЦикла;
			
	КонецЕсли; 
	
	Попытка
		НаборЗаписейСтатусыГрупповойПечатиЧеков.Записать(Истина);
	Исключение
		Сообщить(ОписаниеОшибки());
		Результат = Ложь;
	КонецПопытки;
				
	Возврат Результат;

КонецФункции

&НаСервере
Процедура Пауза(Интервал)

	ОбщегоНазначенияБТС.Пауза(Интервал);

КонецПроцедуры

&НаКлиенте
Процедура ПечататьВсеЧеки(Команда)
	
	Если ИспользоватьПаузуПриПечатиЧеков Тогда
		Если ИнтервалПаузыВСекундах = 0 Тогда
			Сообщить("Не задан интервал паузы в секундах.", СтатусСообщения.Внимание);
		КонецЕсли;
		Если КоличествоЧековПередПаузой = 0 Тогда
			Сообщить("Не задано количество чеков перед паузой.", СтатусСообщения.Внимание);
		КонецЕсли;
		Если ИнтервалПаузыВСекундах = 0 ИЛИ КоличествоЧековПередПаузой = 0 Тогда
			Возврат;	
		КонецЕсли;
	КонецЕсли;
	
	СтатусГрупповойПечати = СтатусГрупповойПечатиНаСервере();
		
	Если СтатусГрупповойПечати.ЕстьРаботающаяОбработка Тогда
		Сообщить("Уже выполняется групповая печать чеков на рабочем месте """ + РабочееМесто + """ по виду оплат """ + ВидОплаты + """ за период с " + СтатусГрупповойПечати.ДатаНачала + " по " + СтатусГрупповойПечати.ДатаОкончания + ". Печать невозможна.", СтатусСообщения.Внимание);
		Возврат;	
	КонецЕсли;
	
	РезультатПечатиПоследнегоЧека = Истина;
	
	Элементы.Прогресс.МаксимальноеЗначение = Объект.Документы.Количество();
	Прогресс = Элементы.Прогресс.МинимальноеЗначение;
	НапечатаноЧековПередПаузой = 0;
	
	Для Каждого Стр ИЗ Объект.Документы Цикл
		
		Если НЕ РезультатПечатиПоследнегоЧека Тогда
			Возврат;
		КонецЕсли;
		
		Если НЕ ЗаписатьНачалоПечатиЧекаНаСервере() Тогда
			Возврат;
		КонецЕсли;
		
		Прогресс = Прогресс + 1;
		Если НЕ Стр.Пробит Тогда
		
			Если ИспользоватьПаузуПриПечатиЧеков Тогда
				Если НапечатаноЧековПередПаузой >= КоличествоЧековПередПаузой Тогда
					Пауза(ИнтервалПаузыВСекундах);
					НапечатаноЧековПередПаузой = 0;
				КонецЕсли;
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Стр.ПараметрыДокумента) Тогда
				ПолучитьДанныеДляПечати(Стр)	
			КонецЕсли;
			
			//25.09.2019
			если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Стр.ПараметрыДокумента, "МассивЧеков") = ложь тогда				
			  продолжить;
			конецесли;	
			
			Если Стр.ПараметрыДокумента.МассивЧеков.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			
			Если НЕ ОтправлятьЧекПочтой Тогда
				Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail = Неопределено;
				
			Иначе
				Стр.ПараметрыДокумента.МассивЧеков[0].Отправляет1СEmail = ПолучитьНастройкиОтправкиОтчетов(Стр.ПараметрыДокумента.ИдентификаторУстройства).Отправляет1СEmail;
				//БИТ ЖКХ 13.05.2020
				если ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков) тогда
					
					 Если НЕ ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail) Тогда 	
						Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail = ПолучитьEmailПроживающего(Стр.Документ);
					 КонецЕсли;	
											
					 если ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail) = ложь тогда 	
						Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail = ЭтотОбъект.АдресЭлектроннойПочты;
					 конецесли;	
				конецесли;	
			КонецЕсли;
			
			Если НЕ ОтправлятьЧекSMS Тогда
				Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательНомер = "";
				
			Иначе
				 Если НЕ ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательНомер) Тогда 	
					Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательНомер = ПолучитьТелефонПроживающего(Стр.Документ.бит_ЛицевойСчет);
				 КонецЕсли;	
				Стр.ПараметрыДокумента.МассивЧеков[0].Отправляет1СSMS = ПолучитьНастройкиОтправкиОтчетов(Стр.ПараметрыДокумента.ИдентификаторУстройства).Отправляет1СSMS;
			КонецЕсли;
		
			Если (ОтправлятьЧекSMS И ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательНомер)) ИЛИ (ОтправлятьЧекПочтой И ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail)) Тогда
				Если НЕПечататьЧек Тогда			
					Стр.ПараметрыДокумента.МассивЧеков[0].Электронно = Истина;
					
				КонецЕсли;	
				
			КонецЕсли;
			
			// БИТ ЖКХ 19.02.2020
			Если НЕПечататьЧек = истина Тогда
				Стр.ПараметрыДокумента.МассивЧеков[0].Электронно = Истина;
			конецесли;	
			
			//ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",Стр.Документ));
			//25.09.2019
			если ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") тогда 
			 // БИТ ЖКХ 27.04.2020
			 попытка
		      ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокументаОбщая",Новый Структура("Ключ",Стр.Документ));
		     исключение
			  ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",Стр.Документ)); 
	         конецпопытки;  			  
		    иначе
		     ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",Стр.Документ));
		    конецесли;
			
			Если Стр.ПараметрыДокумента.МассивЧеков.Количество() > 0 Тогда
				НапечататьОдинЧек(ФормаДок, Стр.ПараметрыДокумента.МассивЧеков, Стр.ПараметрыДокумента.ИдентификаторУстройства, Стр.ПараметрыДокумента.ВерсияФормата);
			КонецЕсли;
			
			Если Не Отладка_НеМенятьНомерЧекаККМ Тогда
				// БИТ ЖКХ 23.05.2020
				ФормаДок.Объект.РучнаяКорректировка = ложь;
				Попытка
				ФормаДок.Записать();
				Исключение
				
				КонецПопытки;
			    КонецЕсли;
			Если ФормаДок.Объект.НомерЧекаККМ <> 0 Тогда
				Стр.Пробит = Истина;
				НапечатаноЧековПередПаузой = НапечатаноЧековПередПаузой + 1;
			Иначе
				Стр.Пробит = Ложь;
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла;	
	
	ЗаписатьОкончаниеПечатиЧековНаСервере();
	
	//25.09.2019
	ПараметрыОтбора = Новый Структура;
    ПараметрыОтбора.Вставить("Пробит", ложь);
	НайденныеСтроки = Объект.Документы.НайтиСтроки(ПараметрыОтбора);
	
	если НайденныеСтроки.Количество() > 0 тогда
	 Сообщить("Чеки не пробиты!");
    иначе
	 Сообщить("Чеки пробиты!");
	конецесли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПараметры(Форма)
	
	ДокОбъект = Форма.Объект;
	
	ОчиститьСообщения();
	
	ОписаниеОшибки = "";
	
	Если ДокОбъект.НомерЧекаККМ <> 0 Тогда
		ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном устройстве!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	//Если ОбщегоНазначенияБПКлиент.ПроверитьВозможностьПечатиЧека(Форма) Тогда
	Если ПроверитьВозможностьПечатиЧека(Форма) Тогда
		
		Если МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда
			Контекст = Новый Структура();
			Контекст.Вставить("Форма", Форма);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборФискальногоУстройстваЗавершение", ЭтотОбъект, Контекст);
			ПоддерживаемыеТипыВО = Новый Массив();
			ПоддерживаемыеТипыВО.Добавить("ФискальныйРегистратор");
			ПоддерживаемыеТипыВО.Добавить("ПринтерЧеков");
			ПоддерживаемыеТипыВО.Добавить("ККТ");
			ПредложитьВыбратьУстройство(ОписаниеОповещения, ПоддерживаемыеТипыВО,
				НСтр("ru = 'Выберите фискальное устройство'"), НСтр("ru = 'Фискальное устройство не подключено.'"));
		Иначе
			ТекстСообщения = НСтр("ru = 'Предварительно необходимо выбрать рабочее место внешнего оборудования текущего сеанса.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьВыбратьУстройство(ОповещениеВыбора, ТипОборудования, ТекстЗаголовкаВыбора, 
	
	СообщениеНеПодключен = "", СообщениеНеВыбран = "", БезСообщений = Ложь, ТекстСообщения = "") 
	
	Если Не МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда
		ТекстСообщения = НСтр("ru='Предварительно необходимо выбрать рабочее место подключаемого оборудования текущего сеанса.'");
		Если Не БезСообщений Тогда
		      ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СписокДоступныхУстройств = МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам(ТипОборудования);
	
	Если СписокДоступныхУстройств.Количество() = 0 Тогда
		Если Не ПустаяСтрока(СообщениеНеПодключен) Тогда
			Если БезСообщений Тогда
				ТекстСообщения = СообщениеНеПодключен;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеНеПодключен);
			КонецЕсли;
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ОповещениеВыбора, Неопределено);
	Иначе
		СписокУстройств = Новый СписокЗначений();
		Для Каждого Устройства Из СписокДоступныхУстройств Цикл
			СписокУстройств.Добавить(Устройства.Ссылка, Устройства.Наименование);
		КонецЦикла;
		Если СписокУстройств.Количество() = 1 Тогда
			Идентификатор = СписокУстройств[0].Значение;
			ВыполнитьОбработкуОповещения(ОповещениеВыбора, Идентификатор); 
		ИначеЕсли НЕ КассаККМ.Пустая() Тогда
			Идентификатор = КассаККМ;
			ВыполнитьОбработкуОповещения(ОповещениеВыбора, Идентификатор); 
		Иначе
			Контекст = Новый Структура;
			Контекст.Вставить("СледующееОповещение", ОповещениеВыбора);
			Контекст.Вставить("СообщениеНеВыбран"  , ?(ПустаяСтрока(СообщениеНеВыбран), СообщениеНеПодключен, СообщениеНеВыбран));
			Контекст.Вставить("БезСообщений"       , БезСообщений);
			//25.09.2019
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборФискальногоУстройстваЗавершение", ЭтотОбъект, Контекст);
//			ОписаниеОповещения = Новый ОписаниеОповещения("ПредложитьВыбратьУстройствоЗавершение", ЭтотОбъект, Контекст);

			СписокУстройств.ПоказатьВыборЭлемента(ОписаниеОповещения, ТекстЗаголовкаВыбора);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФискальногоУстройстваЗавершение(ИдентификаторУстройства, Параметры)Экспорт
	
	Если ИдентификаторУстройства = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//Параметры.Вставить("ИдентификаторУстройства", ИдентификаторУстройства.Значение);
	Параметры.Вставить("ИдентификаторУстройства", ИдентификаторУстройства);
	
	//ДанныеУстройства = МенеджерОборудованияКлиентПовтИсп.ПолучитьДанныеУстройства(ИдентификаторУстройства.Значение);
	ДанныеУстройства = МенеджерОборудованияКлиентПовтИсп.ПолучитьДанныеУстройства(ИдентификаторУстройства);
	ТипУстройства = ?(ДанныеУстройства.Свойство("ТипОборудованияИмя"), ДанныеУстройства.ТипОборудованияИмя, "ККТ");
	
	Параметры.Вставить("ТипУстройства", ТипУстройства);
	
	Если ТипУстройства = "ККТ" Тогда
		//Форма = Параметры.Форма;
	
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПолучитьПараметрыЗавершение", ЭтотОбъект, Параметры);
		//МенеджерОборудованияКлиент.НачатьПолучениеПараметровФискальногоУстройства(ОповещениеПриЗавершении, Форма.УникальныйИдентификатор , ИдентификаторУстройства.Значение, Ложь);
		МенеджерОборудованияКлиент.НачатьПолучениеПараметровФискальногоУстройства(ОповещениеПриЗавершении, УникальныйИдентификатор , ИдентификаторУстройства, Ложь);
	Иначе
		ПолучитьПараметрыЗавершение(Неопределено, Параметры);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПараметрыЗавершение(ПараметрыФискальногоУстройства, Параметры) Экспорт
	
	Перем АдресУстановкиККТ, ОписаниеОшибки;	
	Если ПараметрыФискальногоУстройства =  Неопределено Тогда
		// Принтер чеков эмулирует все атрибуды ФФД 1.1
		пВерсияФормата = ?(Параметры.ТипУстройства = "ПринтерЧеков", "1.1.0.0", "1.0.0.0");
	ИначеЕсли НЕ ПараметрыФискальногоУстройства.Результат Тогда 
		ОписаниеОшибки = ПараметрыФискальногоУстройства.ОписаниеОшибки;
	Иначе
		пВерсияФормата = ПечатьФискальныхДокументовКлиент.ПолучитьВерсиюФФД(ПараметрыФискальногоУстройства.ВыходныеПараметры.ВерсияФФДФН, ПараметрыФискальногоУстройства.ВыходныеПараметры.ВерсияФФДККТ);
		ПараметрыФискальногоУстройства.ВыходныеПараметры.Свойство("АдресУстановкиККТ", АдресУстановкиККТ);
	КонецЕсли; 
	
	// Если не удалось подключить ККТ, то формировать чеки смысла нет
	Если НЕ ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ПараметрыУстройства = МенеджерОборудованияКлиентПовтИсп.ПолучитьПараметрыУстройства(Параметры.ИдентификаторУстройства);
		НомерСекции         = ?(ПараметрыУстройства.Свойство("НомерСекции"), ПараметрыУстройства.НомерСекции, 0);
		
		МассивЧеков = СобратьДанные(Параметры.Форма.Объект.Ссылка,пВерсияФормата,Параметры.ИдентификаторУстройства);
		//МассивЧеков = СобратьДанные(Элементы.Документы.ТекущиеДанные.Документ,пВерсияФормата,Параметры.ИдентификаторУстройства);
		
		//07.8.2019
		ОбъектТекущегоДокумента = Параметры.Форма.Объект.Ссылка;
		//ОбъектТекущегоДокумента = Элементы.Документы.ТекущиеДанные.Документ;
		
		для каждого стр из МассивЧеков[0].ПозицииЧека цикл
			стр.ПризнакСпособаРасчета = Объект.Документы[0].ПризнакиСпособаРасчета;
			
			//20.09.2019
			если ТипЗнч(ОбъектТекущегоДокумента) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") и стр.СтавкаНДС = 0 или 
				  ТипЗнч(ОбъектТекущегоДокумента) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") и стр.СтавкаНДС = 0 или
				   ТипЗнч(ОбъектТекущегоДокумента) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") и стр.СтавкаНДС = 0 тогда
				НДСИзПоступления = ПолучитьНДСИзДокумента(ОбъектТекущегоДокумента);
				стр.СтавкаНДС = НДСИзПоступления.СтавкаНДС;
				стр.СуммаНДС = НДСИзПоступления.СуммаНДС;
			конецесли;
			
		конеццикла;	
		
		ПараметрСтроки = Новый Структура("МассивЧеков,ИдентификаторУстройства,ВерсияФормата",МассивЧеков, Параметры.ИдентификаторУстройства, пВерсияФормата);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		
		РезультатПечатиПоследнегоЧека = Ложь;
		
		ТекстСообщения = НСтр("ru = 'При подключении устройства произошла ошибка.
			|Чек не напечатан на фискальном устройстве.
			|Дополнительное описание:
			|%ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	

КонецПроцедуры

//20.09.2019
функция ПолучитьНДСИзДокумента(Док)	
	
  ндс = новый Структура();	
  ндс.Вставить("СтавкаНДС", 0);//
  
  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/120") > 0  тогда
	ндс.СтавкаНДС = 120;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;
  конецесли;

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "20") > 0 и
      Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/120") = 0 тогда	
	ндс.СтавкаНДС = 20;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;     
  конецесли; 

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/110") > 0  тогда
	ндс.СтавкаНДС = 110;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;
  конецесли;

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "10") > 0 и
      Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/110") = 0 тогда	
	ндс.СтавкаНДС = 10;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;     
  конецесли; 

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/118") > 0  тогда
	ндс.СтавкаНДС = 118;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;
  конецесли;

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "18") > 0 и
      Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/118") = 0 тогда	
	ндс.СтавкаНДС = 18;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;     
  конецесли; 

  //shevtsov 22.01.25 Начало
  Если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "22") > 0 и
      Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/122") = 0 тогда	
	ндс.СтавкаНДС = 22;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    Возврат ндс;     
  КонецЕсли;
  //shevtsov 22.01.25 Окончание
  
  ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
  возврат ндс;    
  
конецфункции	

&НаКлиенте
Процедура НапечататьОдинЧек(Форма, МассивЧеков, ИдентификаторУстройства, ВерсияФормата)
	ДокОбъект = Форма.Объект;
	
	ОбщиеПараметры    = МассивЧеков[0];
	
	Контекст = Новый Структура();
	Контекст.Вставить("МассивЧеков", МассивЧеков);
	Контекст.Вставить("ИдентификаторУстройства", ИдентификаторУстройства);
	Контекст.Вставить("ВерсияФормата", ВерсияФормата);
	Контекст.Вставить("Форма", Форма);
	
	Оповещение = Новый ОписаниеОповещения("НапечататьОдинЧекЗавершение", ЭтотОбъект, Контекст);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПараметрыПечатиЧека",     МассивЧеков[0]);
	ПараметрыФормы.Вставить("Организация",             ДокОбъект.Организация);
	ПараметрыФормы.Вставить("ИдентификаторУстройства", ИдентификаторУстройства);
	ПараметрыФормы.Вставить("ВерсияФормата",           ВерсияФормата);
	
	Если ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 118 Тогда
		ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 18; 
	ИначеЕсли ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 110 Тогда
		ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 10;
	//shevtsov 22.01.25 Начало
	ИначеЕсли ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 122 Тогда
		ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 22;
	//shevtsov 22.01.25 Окончание
	КонецЕсли;	

	МенеджерОборудованияКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
		Форма.УникальныйИдентификатор, 
		ПараметрыФормы.ПараметрыПечатиЧека, 
		ПараметрыФормы.ИдентификаторУстройства,
		,
		,
		);

КонецПроцедуры

&НаКлиенте
Процедура НапечататьОдинЧекЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма = Параметры.Форма;
	ДокОбъект = Форма.Объект;
	
	Если РезультатВыполнения.Результат Тогда
		
		Параметры.МассивЧеков.Удалить(0);
		ДокОбъект.НомерЧекаККМ = РезультатВыполнения.ВыходныеПараметры[1];
		
		Если Параметры.МассивЧеков.Количество() > 0 Тогда
			НапечататьОдинЧек(Форма, Параметры.МассивЧеков, Параметры.ИдентификаторУстройства, Параметры.ВерсияФормата);
		Иначе
			Модифицированность = Истина;
			Если Не Отладка_НеМенятьНомерЧекаККМ Тогда
				Форма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		
		РезультатПечатиПоследнегоЧека = Ложь;
		
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
			|Чек не напечатан на фискальном устройстве.
			|Дополнительное описание:
			|%ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения,
			"%ДополнительноеОписание%",
			РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры

