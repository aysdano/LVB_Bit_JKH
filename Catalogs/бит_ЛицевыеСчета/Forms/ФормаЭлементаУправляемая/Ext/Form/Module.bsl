// Процедура - обработчик события "Нажатие". 
// Кнопки ИзменитьСписокПредоставляемыхУслуг командной панели КоманднаяПанельУслуг.
//
&НаКлиенте
Процедура КоманднаяПанельУслугИзменитьСписокПредоставляемыхУслуг(Команда)
	
	Выборка = ИзменитьСписокПредоставляемыхУслугНаСервере();
	Если Выборка = Ложь Тогда
		
		ЗначенияЗаполнения = Новый Структура;
		ЗначенияЗаполнения.Вставить("Улица"      , Объект.УлицаЛицевогоСчета);
		ЗначенияЗаполнения.Вставить("Здание"     , Объект.Здание);
		ЗначенияЗаполнения.Вставить("ЛицевойСчет", Объект.Ссылка);
		
		ЗначенияЗаполнения.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет"));
		
		
		ЗначенияЗаполнения.Вставить("Комментарий", "Документ создан автоматически из справочника ""Лицевые счета"".");
		
		ОткрытьФорму("Документ.бит_УстановкаИзменениеУслугПоЛС.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзСправочникаЛицевыеСчета, ЗначенияЗаполнения", Истина, ЗначенияЗаполнения), ЭтаФорма);
		
	Иначе
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ",Выборка);
		
		ФормаОткрытия = ОткрытьФорму("Документ.бит_УстановкаИзменениеУслугПоЛС.Форма.ФормаДокументаУправляемая", ПараметрыФормы, ЭтаФорма);
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельЗамечанияДобавить(Команда)
	
	Если Не Объект.Ссылка.Пустая() Тогда
		СтандартнаяОбработка = Ложь;
		
		ПередаваемыеПараметры = ПолучитьЗаписьРегистраСведений();
		
		Если ПередаваемыеПараметры = Неопределено Тогда
			
			ЗначенияЗаполнения = Новый Структура;
			
			ЗначенияЗаполнения.Вставить("ЛицевойСчет",Объект.Ссылка);
			ЗначенияЗаполнения.Вставить("ДатаЗаписи" ,ТекущаяДата());
			
			ПередаваемыеПараметры = Новый Структура; //формируем структуру полей измерений
			
			ПередаваемыеПараметры.Вставить("ЛицевойСчет",Объект.Ссылка);
			ПередаваемыеПараметры.Вставить("Номер","");
			
			ОткрытьФорму("РегистрСведений.бит_ЗамечанияПоЛС.Форма.ФормаЗаписиУправляемая",Новый Структура("ЗаполнитьИзСправочникаЛицевыеСчета",ПередаваемыеПараметры, ЗначенияЗаполнения),ЭтаФорма);
		Иначе
			
			ПараметрыМассив = Новый Массив;
			ПараметрыМассив.Добавить(ПередаваемыеПараметры); // помещаем структуру в массив
			КлючЗаписиРегистра = Новый("РегистрСведенийКлючЗаписи.бит_ЗамечанияПоЛС", ПараметрыМассив); ОткрытьФорму("РегистрСведений.бит_ЗамечанияПоЛС.Форма.ФормаЗаписиУправляемая", Новый Структура("Ключ", КлючЗаписиРегистра),,,,, Новый ОписаниеОповещения("КоманднаяПанельЗамечанияДобавитьЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КоманднаяПанельЗамечанияДобавитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;

