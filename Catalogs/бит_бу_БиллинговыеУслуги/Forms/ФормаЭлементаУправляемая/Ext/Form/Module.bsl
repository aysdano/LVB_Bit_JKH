
#Область ПроцедурыИФункцииОбщегоНазначения

&НаСервере
// Функция определеяет возможность удаления режима потребеления.
//
Функция ОпределитьВозможностьУдаленияРежимПотребления(РежимПотребления)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.бит_бу_СведенияОБиллинговыхУслугах.СрезПоследних(
	|			&Период,
	|			Услуга = &БиллинговаяУслуга
	|				И РежимПотребления = &РежимПотребления) КАК бит_бу_СведенияОБиллинговыхУслугахСрезПоследних";
	Запрос.УстановитьПараметр("Период"           , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("БиллинговаяУслуга", Объект.Ссылка);
	Запрос.УстановитьПараметр("РежимПотребления" , РежимПотребления);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Истина;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции // ()

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	КэшированныеЗначения.Вставить("РежимПотребленияПустаяСсылка", Справочники.бит_РежимыПотребленияУслуг.ПустаяСсылка());
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

// БИТ_ЖКХ 28.10.2011
//
&НаКлиенте
Процедура Основной(Команда)
	
	ТекущаяСтрока = Элементы.РежимыПотребленияУслуг.ТекущиеДанные;
	
	Для каждого Строка Из Объект.РежимыПотребленияУслуг Цикл
		
		Строка.Основной = Ложь;
		
	КонецЦикла; 
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		Объект.ОсновнойРежимПотребления = ТекущаяСтрока.РежимПотребленияУслуг;
		ТекущаяСтрока.Основной          = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// БИТ_ЖКХ 28.10.2011
//
&НаКлиенте
Процедура РежимыПотребленияУслугПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.РежимыПотребленияУслуг.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	УдалениеРазрешено = Истина;
	
	УдалениеРазрешено = ОпределитьВозможностьУдаленияРежимПотребления(ТекущаяСтрока.РежимПотребленияУслуг);	
	
	Если НЕ УдалениеРазрешено Тогда
		Отказ = Истина;

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Существуют документы проведенные по режиму потребления <"+ТекущаяСтрока.РежимПотребленияУслуг+">!
		|Удаление не возможно.");
		
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.РежимПотребленияУслуг = Объект.ОсновнойРежимПотребления Тогда
		Объект.ОсновнойРежимПотребления = мКэшЗначений.РежимПотребленияПустаяСсылка;
	КонецЕсли;
	
КонецПроцедуры

// БИТ_ЖКХ 28.10.2011
//
&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.НаименованиеПолное) тогда
		Объект.НаименованиеПолное = Объект.Наименование;
	КонецЕсли;  
	
КонецПроцедуры

&НаКлиенте
Процедура ОкрытьРегстрСведений(Команда)
	
	СписокПоставщиков = ПолучитьСписокПоставщиков();
	
	Отбор = Новый Структура;
	Отбор.Вставить("Услуга"   , Параметры.Ключ);
	Отбор.Вставить("Поставщик", СписокПоставщиков);
	ОткрытьФорму("РегистрСведений.бит_бу_ПолучателиДенежныхСредств.Форма.ФормаСписка", Новый Структура("Отбор", Отбор));
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоля

&НаКлиенте
Процедура РежимыПотребленияУслугПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	ТекСтрока = Элементы.РежимыПотребленияУслуг.ТекущиеДанные;
	
	Если ТекСтрока.РежимПотребленияУслуг = ПредопределенноеЗначение("Справочник.бит_РежимыПотребленияУслуг.ПустаяСсылка") Тогда
		
		Отказ = Истина;	
		ПоказатьПредупреждение(Новый ОписаниеОповещения("РежимыПотребленияУслугПередОкончаниемРедактированияЗавершение", ЭтотОбъект), "Выберите режим потребления услуг из списка");
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура РежимыПотребленияУслугПередОкончаниемРедактированияЗавершение(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Функция ПолучитьСписокПоставщиков()
	
	СписокПоставщиков = Новый СписокЗначений;
	ТЗ = Объект.Поставщики.Выгрузить();
	СписокПоставщиков.ЗагрузитьЗначения(ТЗ.ВыгрузитьКолонку("Поставщик"));
	
	Возврат СписокПоставщиков;
	
КонецФункции

#КонецОбласти
