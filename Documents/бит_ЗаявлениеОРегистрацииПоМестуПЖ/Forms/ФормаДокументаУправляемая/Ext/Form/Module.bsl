Функция ПолучитьАдресДляСправки (стрАдреса)
	
	строкаАдреса = "";
	
	попытка
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(стрАдреса);
		address = ПрочитатьJSON(ЧтениеJSON, ложь);	
		ЧтениеJSON.Закрыть();
	исключение
		возврат ""; 
	конецпопытки; 
	
	если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "area") = истина тогда
		строкаАдреса = строкаАдреса + строка(address.area);  	  
	конецесли;
	
	если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "areaType") = истина тогда
		строкаАдреса = строкаАдреса + " " + строка(address.areaType);  	  
	конецесли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "munDistrict") = Истина Тогда
		строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса) + " " + строка(address.munDistrict);
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "district") = истина тогда
		строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса) + " " + строка(address.district); 	
	КонецЕсли;
	
	Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "munDistrictType") = Истина Тогда
		строкаАдреса = строкаАдреса + " " + строка(address.munDistrictType);		
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "districtType") = истина тогда
		строкаАдреса = строкаАдреса + " " + строка(address.districtType); 
	ИначеЕсли ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "district") = истина тогда
			строкаАдреса = строкаАдреса + " р-н"; 
	КонецЕсли;
	
	если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "city") = истина тогда
		если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "districtType") = истина тогда
			строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса);  
		конецесли;       	  
		строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса) + " " + строка(address.city);  	  
	конецесли;
	
	если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "cityType") = истина тогда
		строкаАдреса = строкаАдреса + " " + строка(address.cityType);  	  
	конецесли;
	
	если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "locality") = истина тогда
		строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса) + " " + строка(address.locality);  	  
	конецесли;
	
	возврат строкаАдреса;	
	
конецфункции	

// БИТ ЖКХ 27.01.2021
функция ДобавитьРазделитель(ЗначениеИзСтроки)
	
	если ЗначениеЗаполнено(ЗначениеИзСтроки) = истина тогда
		возврат ",";
	конецесли;
	
конецфункции

Функция ПолучитьВладельцаКвартирыПоЛС(Знач ЛицевойСчет,Знач Дата)
	ЗапросСобственник = Новый Запрос;
	ЗапросСобственник.Текст = "ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры КАК ВладелецКвартиры,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.Ссылка КАК ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&ДатаСреза, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|	И бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет = &ЛицевойСчет" ;
	
	ЗапросСобственник.УстановитьПараметр("ДатаСреза", Дата);
	ЗапросСобственник.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	ВыборкаСобственник = ЗапросСобственник.Выполнить().Выбрать();
	
	Собственники = Новый Массив;
	
	Пока ВыборкаСобственник.Следующий() Цикл
		Собственники.Добавить(ВыборкаСобственник.ФизЛицо);	
	КонецЦикла;
	
	Возврат Собственники;	
	
КонецФункции

&НаКлиенте
Процедура ЗаконныйПредставительВСвязиСНедееспособностьюПриИзменении(Элемент)
	
	Если Объект.ЗаконныйПредставительВСвязиСНедееспособностью тогда
		
		ЗаконныйПредставительЗаполнить(Объект.РегистрируемоеЛицо);
		ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Истина;
		ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Истина;
		
	ИначеЕсли НЕ ПроверитьВозраст(Объект.РегистрируемоеЛицо) тогда
		
		ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Ложь;
		ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Ложь;
		
		Объект.ЗаконныйПредставитель = Неопределено;   
		Объект.СтепеньРодстваЗаконногоПредставителя = Неопределено;	
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура РегистрируемоеЛицоПриИзменении(Элемент)
	
	Если ПроверитьВозраст(Объект.РегистрируемоеЛицо) Тогда
		
		ЗаконныйПредставительЗаполнить(Объект.РегистрируемоеЛицо);
		ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Истина;
		ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Истина;
		
	ИначеЕсли НЕ Объект.ЗаконныйПредставительВСвязиСНедееспособностью Тогда
		
		ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Ложь;
		ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Ложь;
		
		Объект.СтепеньРодстваЗаконногоПредставителя = Неопределено;
		Объект.ЗаконныйПредставитель = Неопределено;
		
	КонецЕсли;
	
	УстановитьДатуСнятия(Объект.ЛицевойСчет, Объект.РегистрируемоеЛицо);
	УстановитьДатуРегистрации(Объект.ЛицевойСчет, Объект.РегистрируемоеЛицо);
	ЗаполнитьСвидетельствоОСмерти(Объект.РегистрируемоеЛицо);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСвидетельствоОСмерти(Проживающий)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_СвидетельстваОСмерти.ФизЛицо КАК ФизЛицо,
	|	бит_СвидетельстваОСмерти.ДатаВыдачи КАК ДатаВыдачи,
	|	бит_СвидетельстваОСмерти.ДатаСмерти КАК ДатаСмерти,
	|	бит_СвидетельстваОСмерти.ДатаСоставления КАК ДатаСоставления,
	|	бит_СвидетельстваОСмерти.УдалитьКемВыдано КАК УдалитьКемВыдано,
	|	бит_СвидетельстваОСмерти.Номер КАК Номер,
	|	бит_СвидетельстваОСмерти.СерияСвидетельства КАК СерияСвидетельства,
	|	бит_СвидетельстваОСмерти.НомерСвидетельства КАК НомерСвидетельства,
	|	бит_СвидетельстваОСмерти.КемВыдано КАК КемВыдано
	|ИЗ
	|	РегистрСведений.бит_СвидетельстваОСмерти КАК бит_СвидетельстваОСмерти
	|ГДЕ
	|	бит_СвидетельстваОСмерти.ФизЛицо = &ФизЛицо";
