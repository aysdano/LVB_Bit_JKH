Процедура ЗаполнитьСтруктураДанных(СтруктураДанных) Экспорт
	
	СтруктураДанных.ПолучательПредставление           = мКэшОрганизации.НаименованиеСокращенное;
	СтруктураДанных.ПолучательРС                      = мКэшОрганизации.НомерСчета;
	СтруктураДанных.ПолучательБанк                    = мКэшОрганизации.ПолучательБанк;
	СтруктураДанных.ПолучательКоррСчет                = Строка(мКэшОрганизации.КоррСчет)+" \ "+Строка(мКэшОрганизации.БИК);
	СтруктураДанных.ПолучательИНН                     = мКэшОрганизации.ПолучательИНН;
	СтруктураДанных.ПолучательКПП                     = мКэшОрганизации.ПолучательКПП;
	СтруктураДанных.Период                            = Формат(Период,"ДФ='MMММ yyyy'")+" г.";
	СтруктураДанных.ПолучательАдрес                   = мКэшОрганизации.ПолучательАдрес;
	СтруктураДанных.ПолучательТелефон                 = мКэшОрганизации.ПолучательТелефон;
	// 17.10.2018
	СтруктураДанных.ПолучательСайт                    = мКэшОрганизации.ПолучательСайт;
	//---
	СтруктураДанных.ПолучательДопИнформация           = мКэшОрганизации.ПолучательДопИнформация;
	СтруктураДанных.ПолучательКоррСчет2               = Строка(мКэшОрганизации.КоррСчет);
	СтруктураДанных.ПолучательБИК                     = Строка(мКэшОрганизации.БИК);
	СтруктураДанных.Дата                              = Период;
	СтруктураДанных.ДатаПечатиКвитанций               = Формат(ДатаПечатиКвитанций,"ДФ=dd.MM.yyyy");
	СтруктураДанных.ПериодМесяц                       = Формат(Период,"ДФ=MM");
	СтруктураДанных.ПериодГод                         = Формат(Период,"ДФ=yyyy");
	СтруктураДанных.ДатаНачалоМесяца                  = Формат(НачалоМесяца(Период),"ДФ=dd.MM.yyyy");
	СтруктураДанных.ДатаОкончанияМесяца               = Формат(КонецМесяца(Период),"ДФ=dd.MM.yyyy");
	СтруктураДанных.ПолучательПлатежа                 = ПолучательПлатежа;
	
КонецПроцедуры

