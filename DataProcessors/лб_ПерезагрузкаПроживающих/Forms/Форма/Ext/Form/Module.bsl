&НаСервереБезКонтекста
Процедура ЗаполнитьДанныеДляФЛСНаСервереБезКонтекста(ЛС=неопределено);
	ЗапросРегистраторов = новый запрос;
	ЗапросРегистраторов.Текст = 
		 "ВЫБРАТЬ
		 |	бит_ПроживающиеПоЛС.Регистратор КАК Регистратор
		 |ИЗ
		 |	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
		 |ГДЕ
		 |	бит_ПроживающиеПоЛС.Активность = ИСТИНА
		 |	И бит_ПроживающиеПоЛС.ЛицевойСчет = &ЛС
		 |
		 |СГРУППИРОВАТЬ ПО
		 |	бит_ПроживающиеПоЛС.Регистратор";
	
	Если Не ЗначениеЗаполнено(ЛС) тогда
		ЗапросРегистраторов.Текст = СтрЗаменить(ЗапросРегистраторов.Текст,"И бит_ПроживающиеПоЛС.ЛицевойСчет = &ЛС","");
	КонецЕсли;
	
	СписокРегистраторов = ЗапросРегистраторов.Выполнить().Выгрузить().ВыгрузитьКолонку("Регистратор");
	Для Каждого ДокСсылка из СписокРегистраторов цикл
		ДополнитьДвиженияПроживающихДаннымиДляФЛС(ДокСсылка);		
	КонецЦикла;		
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура ДополнитьДвиженияПроживающихДаннымиДляФЛС(ДокСсылка);		
	СобственникНеПроживает = Справочники.бит_СтатусФизЛица.НайтиПоНаименованию("Собственник не проживает");
	ОтветственныйНеПроживает = Справочники.бит_СтатусФизЛица.НайтиПоНаименованию("Ответственный не проживает");
	Набор = РегистрыСведений.бит_ПроживающиеПоЛС.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Значение = ДокСсылка;
	Набор.Прочитать();
	Табл = Набор.Выгрузить();
	Для каждого СтрокаТ из Табл цикл
		Если Не СтрокаТ.Активность тогда
			продолжить
		КонецЕсли;
		Если НЕ (СтрокаТ.СтатусФизЛица = СобственникНеПроживает)  
				и не (СтрокаТ.СтатусФизЛица = ОтветственныйНеПроживает) 
		тогда
			СтрокаТ.лб_ИгнорироватьПериодВКопииФЛС = ложь;
			СтрокаТ.лб_ДатаРегистрацииДляФЛС = СтрокаТ.ДатаРегистрации;
			СтрокаТ.лб_ДатаВыпискиДляФЛС = СтрокаТ.ДатаСнятияСРегистрации;			
		иначе
			СтрокаТ.лб_ИгнорироватьПериодВКопииФЛС = истина;
		КонецЕсли;	
	КонецЦикла;
	
	Набор.Загрузить(Табл);
	Набор.Записать(истина);
	
	
КонецПроцедуры	

