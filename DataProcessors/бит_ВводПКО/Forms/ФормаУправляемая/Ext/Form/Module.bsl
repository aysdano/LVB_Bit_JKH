&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийОплатыКУ.ЗакрытиеКассовойСмены"));
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	
	ОткрытьФорму("Документ.бит_ОплатаКУ.Форма.ФормаВыбораУправляемая", Новый Структура("ПодборИзОбработкиВводПКО", ПараметрыФормы), Элементы.ОплатыКУ, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатыКУБанковскийСчетПриИзменении(Элемент)
	
	// Больше одной строки в ТЧ.
	Если Объект.ОплатыКУ.Количество() > 1  Тогда
		
		ТекСтрока = Элементы.ОплатыКУ.ТекущиеДанные;
		// Больше одной строки с организацией.
		ПараметрыОтбора	  = Новый Структура("Организация", ТекСтрока.Организация);
		МассивОрганизаций =  Объект.ОплатыКУ.НайтиСтроки(ПараметрыОтбора);
		
		Если МассивОрганизаций.Количество() > 1
			И НЕ БылВопросБанковскиеСчета = ТекСтрока.Организация 
			И НЕ Элемент.ТекстРедактирования = "" Тогда
			
			ТекстВопроса = СтрШаблон(
								НСтр("ru = 'Установить текущий Банковский счет: ""%1"" для всех документов Оплаты КУ, организации ""%2""?'")
								,Элемент.ТекстРедактирования
								,Строка(ТекСтрока.Организация));
			
			ДополнительныеПараметры = Новый Структура;
			ДополнительныеПараметры.Вставить("Организация",ТекСтрока.Организация);
			ОписаниеОповещения = Новый ОписаниеОповещения("ВводПКОБанковскийСчетПриИзмененииЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			
			ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		КонецЕсли;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВводПКОБанковскийСчетПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		БылВопросБанковскиеСчета = ДополнительныеПараметры.Организация;
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из Объект.ОплатыКУ Цикл
		Если Строка.Организация = ДополнительныеПараметры.Организация Тогда
			Строка.БанковскийСчет = Элементы.ОплатыКУ.ТекущиеДанные.БанковскийСчет;	
		КонецЕсли;
	КонецЦикла; 
	
КонецПроцедуры

