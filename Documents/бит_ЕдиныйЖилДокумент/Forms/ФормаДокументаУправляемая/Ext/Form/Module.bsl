
#Область ПеременныеМодуля

Перем мСписокФизЛиц; // Список физлиц по выбранному лицевому счету. 

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
// Процедура открытия формы выбора справочника - всего списка или активной строки.
//
Процедура ПолучитьИзСправочникаПроживающие(Элемент = Неопределено)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе", Ложь);
	
	Если Элемент = Неопределено Тогда
		ОткрытьФорму("Справочник.бит_Проживающие.ФормаВыбора", ПараметрыФормы, ЭтаФорма);	
	Иначе
		ОткрытьФорму("Справочник.бит_Проживающие.ФормаВыбора", ПараметрыФормы, Элемент);	
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеВнешнимВидомФорм

&НаКлиенте
// Процедура изменения данных поля Физ лицо.
Процедура ФизЛицоПриИзменении(Элемент)
	
	ЗаполнитьПоЛС(Неопределено);	
	
КонецПроцедуры

&НаКлиенте
// Процедура начала выбора поля Физ лицо.
Процедура ФизЛицоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Элементы.ФизЛицо.СписокВыбора) Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните ""Лицевой счет""!";
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
// Процедура - обработчик события "ПриИзменении" поля ввода "ЛицевойСчет".
//
Процедура ЛицевойСчетПриИзменении(Элемент)
	Объект.ФизическиеЛица.Очистить();
	Объект.Коммунальные.Очистить();
	Если Объект.СправкаПоСмерти Тогда
		
		СписокПроживающихЛиц(Объект.ЛицевойСчет);
		
	Иначе
		
		Если Объект.ВыводитьВесьСписок Тогда
			
			СписокПроживающихЛиц(Объект.ЛицевойСчет,Истина);
			
		Иначе
			
			СписокПроживающихЛиц(Объект.ЛицевойСчет);
			
		КонецЕсли; 
		
	КонецЕсли;
	
	ПризнакКоммунальной = ПолучитьПризнакТипаКвартиры();
	
	Если ПризнакКоммунальной Тогда
		ДанныеКоммунальныхКомнат = ПолучитьДанныеКоммунальныхКвартир();
		Если ДанныеКоммунальныхКомнат.Количество() > 0 Тогда
			ЗагрузитьКоммунальныеКомнаты(ДанныеКоммунальныхКомнат);
		КонецЕсли;
	КонецЕсли;
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьКоммунальныеКомнаты(ДанныеКоммунальныхКомнат)
	
	Объект.Коммунальные.Загрузить(ДанныеКоммунальныхКомнат);            
	
КонецПроцедуры

&НаСервере 
// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
Процедура УправлениеЭлементамиФормы()
	
	Если Объект.ЛицевойСчет <> Справочники.бит_ЛицевыеСчета.ПустаяСсылка()  Тогда
		ПризнакКоммунальной = ПолучитьПризнакТипаКвартиры();		
		Если ПризнакКоммунальной Тогда
			Элементы.КоммунальныеДанные.Доступность 	= Истина;
			Элементы.КоммунальныеДанные.Видимость 		= Истина;
		Иначе	
			Элементы.КоммунальныеДанные.Доступность 	= Ложь;
			Элементы.КоммунальныеДанные.Видимость 		= Ложь;
		КонецЕсли; 
		
	иначе  
		Элементы.КоммунальныеДанные.Доступность 	= Ложь;
		Элементы.КоммунальныеДанные.Видимость 		= Ложь;
	КонецЕсли; 
	
	Если Объект.СправкаПоСмерти Тогда
		Элементы.ДатаСмерти.Доступность = Истина;
		Элементы.ДатаСмерти.Видимость 	= Истина
	Иначе
		Элементы.ДатаСмерти.Доступность = Ложь;
		Элементы.ДатаСмерти.Видимость 	= Ложь
	КонецЕсли; 
	
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	// Установить видимость реквизитов и заголовков колонок.
	УправлениеЭлементамиФормы();
	
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		СписокЗначенийФизЛиц = СписокПроживающих(ДокументОбъект.ЛицевойСчет);
		мТаблицаФизЛиц.Загрузить(ФормированиеДанныхТабЧасти(СписокЗначенийФизЛиц, ДокументОбъект.Дата));
		
	КонецЕсли; 
	
	ЭтоНовый = ?(Параметры.Ключ.Пустая(), Истина, Ложь);

	Если ЭтоНовый И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда   
		
		Объект.Организация 		= бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");
		
		Объект.Ответственный 	= бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
		
		Объект.СоответствиеСтандартамБлагоустройства = Истина;
		Объект.ПригодностьДляЖилья = Истина;
	КонецЕсли;
	
	// БИТ ЖКХ 14.01.2020
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды
    //	УправлениеПечатью.ПриСозданииНаСервере(ЭтаФорма, Элементы.ПечатьПодменю);
	
	Элементы.ПечатьПодменю.Вид = ВидГруппыФормы.Подменю;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуПечати(Команда)
	
	УправлениеПечатьюКлиент.ВыполнитьПодключаемуюКомандуПечати(Команда, ЭтаФорма, Объект);
	
КонецПроцедуры

// Процедура - обработчик события "ПриОткрытии" формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// При заполненном значении лицевого счета формируется список физлиц,
	// Прописанных по этому ЛС.
	Если НЕ Объект.ЛицевойСчет.Пустая() Тогда
		
		СписокПроживающихЛиц(Объект.ЛицевойСчет);
		
		ПризнакКоммунальной = ПолучитьПризнакТипаКвартиры();
		
		Если ПризнакКоммунальной Тогда
			ДанныеКоммунальныхКомнат = ПолучитьДанныеКоммунальныхКвартир();
			Если ДанныеКоммунальныхКомнат.Количество() > 0 Тогда
				ЗагрузитьКоммунальныеКомнаты(ДанныеКоммунальныхКомнат)
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	мКэшРеквизитовФормы = Новый Структура;
	
КонецПроцедуры

// Процедура - обработчик события "ПослеЗаписи" формы.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)

	УправлениеЭлементамиФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФорм

&НаКлиенте
Процедура ЗаполнитьПоЛС(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Лицевой счет не указан!";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не заполнено Физ. лицо!";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ФизическиеЛица.Количество() > 0 Тогда
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПоЛСЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;      
	КонецЕсли; 
	
	ЗаполнитьПоЛСФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЛСЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса ;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;      
	
	ЗаполнитьПоЛСФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЛСФрагмент()
	
	Если Объект.СправкаПоСмерти Тогда
		
		СписокПроживающихЛиц(Объект.ЛицевойСчет);
		
	Иначе
		
		Если Объект.ВыводитьВесьСписок Тогда

			СписокПроживающихЛиц(Объект.ЛицевойСчет,Истина);
		Иначе

			СписокПроживающихЛиц(Объект.ЛицевойСчет);
		КонецЕсли; 
		
	КонецЕсли; 
	
	ЗаполнитьТабличнуюЧасть();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧасть()
	
	Объект.ФизическиеЛица.Очистить();

	мСписокФизЛиц = ПолучитьИзВременногоХранилища(АдресВХранилище);
	
	СписокЗначенийФизЛиц = мСписокФизЛиц.Скопировать();
	Если  СписокЗначенийФизЛиц.Количество()>0 И ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		
		Если СписокЗначенийФизЛиц.Найти(Объект.ФизЛицо,"ФизическоеЛицо")<> Неопределено Тогда
			
			НомерИндекса = СписокЗначенийФизЛиц.Индекс(СписокЗначенийФизЛиц.Найти(Объект.ФизЛицо,"ФизическоеЛицо"));
			СписокЗначенийФизЛиц.Удалить(НомерИндекса);
			
		КонецЕсли;
		
	КонецЕсли;
	Если СписокЗначенийФизЛиц.Количество()>0 Тогда
		
		ЗагрузкаТабЧасти(СписокЗначенийФизЛиц, Объект.Дата);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьИзСправочника(Команда)
	ПолучитьИзСправочникаПроживающие();
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.бит_Проживающие") Тогда
			
			ДобавитьФизическоеЛицоНаСервере(ВыбранноеЗначение);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьМакета(Команда)

	Результат = Сформировать();

	Результат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
	АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
	
	бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
	,"бит_ЕдиныйЖилДокумент"
	,"ЕдиныйЖилищныйДокумент"
	,"Единый жилищный документ"
	
	,АдресТабличногоДокументаВоВременномХранилище
	
	,Объект.Ссылка);
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляФизическиеЛица

&НаКлиенте
Процедура ФизическиеЛицаФизическоеЛицоПриИзменении(Элемент)
	
	ВыбранноеФИзЛицо = Элементы.ФизическиеЛица.ТекущиеДанные.ФизическоеЛицо;

	Элементы.ФизическиеЛица.ТекущиеДанные.ДатаРождения = ПолучитьДатуРожденияНаСервере(ВыбранноеФИзЛицо);

	Отбор = Новый Структура;
	Отбор.Вставить("ФизическоеЛицо",ВыбранноеФИзЛицо);
	МассивПоиска = мТаблицаФизЛиц.НайтиСтроки(Отбор);
	
	Если МассивПоиска.Количество()>0 Тогда
		Элементы.ФизическиеЛица.ТекущиеДанные.РодственныеОтношения 	= МассивПоиска[0].РодственныеОтношения;
		Элементы.ФизическиеЛица.ТекущиеДанные.СтатусПроживания 		= МассивПоиска[0].СтатусПроживания;
		
	Иначе	
		Элементы.ФизическиеЛица.ТекущиеДанные.РодственныеОтношения 	= Неопределено; 
		Элементы.ФизическиеЛица.ТекущиеДанные.СтатусПроживания 		= Неопределено; 
	КонецЕсли; 
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере 
Функция ПолучитьТипКвартиры()
	
	Отбор = Новый Структура;
	Отбор.Вставить("Квартира",Объект.ЛицевойСчет.Квартира);
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		Момент = Объект.Дата;
	Иначе
		Момент = ТекущаяДата();
	КонецЕсли; 
	
	ТипКвартиры  = РегистрыСведений.бит_СведенияОКвартире.ПолучитьПоследнее(Момент, Отбор);
	
	Возврат ТипКвартиры.ТипКвартиры;
	
КонецФункции

&НаСервере
// Возвращает признак коммунальной квартиры, булево.
Функция ПолучитьПризнакТипаКвартиры()
	
	ТипКвартиры = ПолучитьТипКвартиры();
	Если ТипКвартиры = Справочники.бит_ТипыКвартиры.Коммунальная Тогда
		
		Возврат Истина;
		
	Иначе
		
		Возврат Ложь;
		
	КонецЕсли; 
	
КонецФункции

&НаСервере 
// Функция получения данных квартир по реквизитам документа - здание, номер квартиры, дата.
// Используется, если квартира коммунальная. 
Функция ПолучитьДанныеКоммунальныхКвартир()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЕдиныйЖилДокумент.Дата КАК Дата,
	|	бит_ЕдиныйЖилДокумент.ЛицевойСчет.Здание КАК Здание,
	|	бит_ЕдиныйЖилДокумент.ЛицевойСчет.Квартира.НомерКвартиры КАК НомерКвартиры
	|ИЗ
	|	Документ.бит_ЕдиныйЖилДокумент КАК бит_ЕдиныйЖилДокумент
	|ГДЕ
	|	бит_ЕдиныйЖилДокумент.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Здание 		= Выборка.Здание;
		НомерКвартиры	= Выборка.НомерКвартиры;
		Момент			= Выборка.Дата;
		
	Иначе
		Здание 		= Справочники.бит_СписокЗданий.ПустаяСсылка();
		НомерКвартиры	= 0;
		Момент			= Дата("00010101");
		
	КонецЕсли;
	
	ДанныеКоммунальныхКомнат = бит_ПаспортныйСтолСервер.ПолучитьДанныеКоммунальныхКвартир(Здание, НомерКвартиры, Момент);
	
	Возврат ДанныеКоммунальныхКомнат;
	
КонецФункции

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	Документ       = Метаданные.Документы.бит_ЕдиныйЖилДокумент;
	// Общие переменные.
	КэшированныеЗначения = Новый Структура;
	
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	
КонецПроцедуры

&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции

&НаСервере
// Функция формирует список физ лиц, когда-либо прописанных на ЛС (ВесьСписок = Ложь).
// Либо тех, кто прописан на момент даты документа (ВесьСписок = Истина).
Функция  СписокПроживающих(ЛС = Неопределено, ВесьСписок = Ложь)  
	
	Если ВесьСписок Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних";
		
	Иначе
		
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
		|ГДЕ
		|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата
		|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
		
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		
		Момент = Объект.Дата;
		
	Иначе
		
		Момент = ТекущаяДата();
		
	КонецЕсли;
	
	Если Объект.СправкаПоСмерти Тогда
		Если ЗначениеЗаполнено(Объект.ДатаСмерти) Тогда
			
			Момент  = Объект.ДатаСмерти + 10*24*60*60;
			
		Иначе
			Момент = Объект.Дата;
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Момент));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	
	СписокФизЛиц = Запрос.Выполнить().Выгрузить();
	
	ЭтаФорма.Элементы.ФизЛицо.СписокВыбора.ЗагрузитьЗначения(СписокФизЛиц.ВыгрузитьКолонку("ФизическоеЛицо"));
	
	Возврат СписокФизЛиц;
	
КонецФункции

&НаСервере
