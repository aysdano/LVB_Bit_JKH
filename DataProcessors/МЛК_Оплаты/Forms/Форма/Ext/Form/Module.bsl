	// Вставить содержимое обработчика.
	ОбработатьДокументыНаСервере();
	ПриОткрытииНаСервере();
	
	//Реестр.Параметры.УстановитьЗначениеПараметра("Платежка", Документы.ПоступлениеНаРасчетныйСчет.ПустаяСсылка());	
