#Область ДействияКомандФормы

&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	Отказ = Ложь;
	
	ИзмененаРучнаяКорректировка = СтруктураШапки.Свойство("РучнаяКорректировка")
	И (СтруктураШапки.РучнаяКорректировка <> Объект.РучнаяКорректировка);
	
	Если СтруктураШапки.Свойство("РучнаяКорректировка")
		И СтруктураШапки.РучнаяКорректировка
		И НЕ Объект.РучнаяКорректировка Тогда
		
		ТекстВопроса = НСтр("ru='Ручная корректировка движений документа отменена.
		|Восстановить движения, сформированные автоматически?'");
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаписатьИЗакрытьЗавершение", ЭтотОбъект, Новый Структура("ИзмененаРучнаяКорректировка, Отказ", ИзмененаРучнаяКорректировка, Отказ)), ТекстВопроса, РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Да);
		Возврат;
		
	КонецЕсли;
	
	ЗаписатьИЗакрытьФрагмент(ИзмененаРучнаяКорректировка, Отказ);
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрытьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ИзмененаРучнаяКорректировка = ДополнительныеПараметры.ИзмененаРучнаяКорректировка;
	Отказ = ДополнительныеПараметры.Отказ;
	
	
	Ответ = РезультатВопроса;
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Объект.РучнаяКорректировка = Истина;
		УстановитьВозможностьРедактированияЗаписей();
		Возврат;
	КонецЕсли;
	
	
	ЗаписатьИЗакрытьФрагмент(ИзмененаРучнаяКорректировка, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаписатьИЗакрытьФрагмент(Знач ИзмененаРучнаяКорректировка, Знач Отказ)
	
	ЗаписатьДвижения(Отказ);
	
	Если НЕ Отказ Тогда
		
		Если ИзмененаРучнаяКорректировка Тогда
			ОповеститьОбИзменении(ДокументСсылка);
		КонецЕсли;
		
		ЭтаФорма.Модифицированность = Ложь;
		
		Оповестить("ИзмененФлагРучнаяКорректировка",Новый Структура("ДокументСсылка",ДокументСсылка));
		
		Закрыть();
		
	КонецЕсли;
	
КонецПроцедуры

