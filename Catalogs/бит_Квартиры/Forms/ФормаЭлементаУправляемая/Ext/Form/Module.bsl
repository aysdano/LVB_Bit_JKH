&НаСервере
Процедура ЗаполнитьТаблицуКомнат()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_Комнаты.Наименование КАК Наименование,
	|	бит_Комнаты.НомерКомнаты КАК НомерКомнаты,
	|	бит_СведенияОКомнатеСрезПоследних.Высота,
	|	бит_СведенияОКомнатеСрезПоследних.Площадь,
	|	бит_Комнаты.Владелец КАК Владелец,
	|	бит_Комнаты.Ссылка КАК Ссылка,
	|	ВЫБОР
	|		КОГДА бит_Комнаты.ПометкаУдаления
	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК НомерКартинки
	|ИЗ
	|	Справочник.бит_Комнаты КАК бит_Комнаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКомнате.СрезПоследних(&Момент, Комната.Владелец = &Владелец) КАК бит_СведенияОКомнатеСрезПоследних
	|		ПО бит_СведенияОКомнатеСрезПоследних.Комната = бит_Комнаты.Ссылка
	|ГДЕ
	|	бит_Комнаты.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент"  , НаДату);
	
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписей.Количество() > 0 Тогда 
		
		КомнатыКвартиры.Загрузить(ТаблицаЗаписей);
		
	КонецЕсли;
	
	КомнатыКвартиры.Сортировать("НомерКомнаты Возр");
	
	Модифицированность = Ложь;
	
КонецПроцедуры

