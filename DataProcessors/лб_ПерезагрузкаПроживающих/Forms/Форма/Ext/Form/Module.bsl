&НаСервере
Процедура ТестОбновитьКвартирыЛицСчетовНаСервере()
	// Вставить содержимое обработчика.
	Запрос = новый запрос;
	Запрос.Текст = 
		 "ВЫБРАТЬ
		 |	лб_Тест_ЛС.ЛС КАК ЛС,
		 |	лб_Тест_ЛС.ЛС.Квартира КАК ЛСКвартира,
		 |	лб_Тест_ЛС.ЛС.Здание КАК ЛСЗдание,
		 |	лб_Тест_ЛС.Квартира КАК Квартира,
		 |	лб_Тест_ЛС.Здание КАК Здание,
		 |	лб_Тест_ЛС.LS КАК LS,
		 |	лб_Тест_ЛС.Здание.Организация КАК Организация,
		 |	лб_Тест_ЛС.Здание.Улица КАК УлицаЛицевогоСчета
		 |ИЗ
		 |	РегистрСведений.лб_Тест_ЛС КАК лб_Тест_ЛС
		 |ГДЕ
		 |	лб_Тест_ЛС.Квартира <> лб_Тест_ЛС.ЛС.Квартира";
	Выборка = запрос.Выполнить().Выбрать();
	Пока выборка.Следующий() цикл
		Запись = РегистрыСведений.лб_Тест_ЛС.СоздатьМенеджерЗаписи();
		Запись.LS = Выборка.LS;
		Запись.Прочитать();
		Если не ЗначениеЗаполнено(Запись.ЛС) или не ЗначениеЗаполнено(Запись.Квартира) тогда
			продолжить
		КонецЕсли;	
		Если Запись.Квартира = Выборка.ЛСКвартира тогда		
			продолжить
		КонецЕсли;
		
		СпрОбъект = Запись.ЛС.ПолучитьОбъект();
		СпрОбъект.ОбменДанными.Загрузка = истина;
		ЗаполнитьЗначенияСвойств(СпрОбъект,Выборка,"Квартира,Здание,УлицаЛицевогоСчета,Организация");
		СпрОбъект.Записать();
	КонецЦикла;	
	
КонецПроцедуры

