&НаСервере
Процедура Тест_СопоставитьЛСНаСервере()
	д1 = ТекущаяДата();
	// Вставить содержимое обработчика.
	Набор = РегистрыСведений.лб_Тест_ЛС.СоздатьНаборЗаписей();
	Набор.Прочитать();		
	Табл = Набор.Выгрузить();
	
	Табл.Колонки.Удалить("ЛС");
	Табл.Колонки.Удалить("ИмяЛС10");
	
	Запрос = новый Запрос;	
	Запрос.УстановитьПараметр("Табл",Табл);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Табл.* 
		|ПОМЕСТИТЬ Т
		|ИЗ
		|	&Табл КАК Табл
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ Т.*,
		|	ПОДСТРОКА(Т.LS, 1, 10) КАК ИмяЛС10,
		|	ЕСТЬNULL(бит_ЛицевыеСчета.Ссылка, ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)) КАК ЛС
		|ИЗ
		|	Т КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ПО (ПОДСТРОКА(Т.LS, 1, 10) = ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 10))";
	Т2 = Запрос.Выполнить().Выгрузить();
	
	Если Т2.Количество() = Табл.Количество() тогда	
		Набор.Загрузить(Т2);
		Набор.Записать(истина);
		д2 = ТекущаяДата();
		Сообщить("ЛС - Сопоставлены. Затрачено "+(д2-д1)+ " сек.");		
	иначе
		Сообщить("ЛС - есть дубли в справочнике");
	КонецЕсли;
КонецПроцедуры

