&НаСервере 
Процедура ПроверитьОбновитьСогласиеПД(Стру)
	Если Стру = неопределено 
			или НЕ ЗначениеЗаполнено(Стру.НовСогласиеПД) 
			или (Стру.НовСогласиеПД = Стру.СогласиеПД)
			или (Стру.СогласиеПД = Перечисления.лб_ВидСогласияНаОбработкуПД.ЕстьАбонентскийОтдел) 
			или (Стру.СогласиеПД = Перечисления.лб_ВидСогласияНаОбработкуПД.ЕстьПаспортныйСтол)
	тогда
	 	возврат
	КонецЕсли;
	
	СпрОбъект = Стру.ФЛ.ПолучитьОбъект();
	Если ложь тогда СпрОбъект = Справочники.бит_Проживающие.СоздатьЭлемент() КонецЕсли;
	СпрОбъект.лб_СогласиеНаОбработкуПД = Стру.НовСогласиеПД;
	СпрОбъект.Записать();
КонецПроцедуры	

