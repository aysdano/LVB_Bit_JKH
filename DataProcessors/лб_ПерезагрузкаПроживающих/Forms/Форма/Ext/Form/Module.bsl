				ИначеЕсли  СтрокаТекОтветственного.ДатаВыписки<>'0001-01-01' тогда
					 //Был ответственный, но ушел с л/с
					 ИндексОтв = ТаблИсхЛС.Индекс(СтрокаТекОтветственного);
					 Если ИндексОтв <ТаблИсхЛС.Количество()-1 тогда
						НовСтрока =  ТаблИсхЛС.Вставить(ИндексОтв+1);
					 иначе
						НовСтрока =  ТаблИсхЛС.Добавить();
					 КонецЕсли;	 					 
					 ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаТекОтветственного);
					 СтрокаТекОтветственного.ДатаВыписки = '0001-01-01';					 
