	Для Значение=1 По Объект.КоличествоПакетовПечати Цикл
		
		Объект.ТекущийПакетПечати = Значение;
		
		ТабличныйДокумент = СформироватьКвитанции(Истина);
		
		Если НЕ ТабличныйДокумент = Неопределено Тогда
			ТабличныйДокумент.Напечатать();
