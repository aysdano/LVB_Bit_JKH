// Функция определяет работает ли данный вид сравнения со списком или нет.
//
// Параметры:
//  ТекВидСравнения - ВидСравенения.
//
// Возвращаемое значение:
//  флДляСписка – Булево.
//
Функция ЭтоВидСравненияДляСписка(ТекВидСравения) Экспорт

	МассивВидовДляСписка = Новый Массив;
	МассивВидовДляСписка.Добавить(ВидСравнения.ВСписке);
	МассивВидовДляСписка.Добавить(ВидСравнения.НеВСписке);
	МассивВидовДляСписка.Добавить(ВидСравнения.ВСпискеПоИерархии);
	МассивВидовДляСписка.Добавить(ВидСравнения.НеВСпискеПоИерархии);
	
	Если МассивВидовДляСписка.Найти(ТекВидСравения) = Неопределено Тогда
	   флДляСписка = Ложь;
	Иначе	
	   флДляСписка = Истина;
	КонецЕсли; 

	Возврат флДляСписка;
	
КонецФункции // ЭтоВидСравненияДляСписка()

Функция СведенияОбАдресе(ЗначенияПолей, Поле = Неопределено) Экспорт
	
	Если НЕ ЗначениеЗаполнено(ЗначенияПолей) Тогда
		Возврат "";
	КонецЕсли;
	СтруктураПолейАдреса =  бит_ОбщегоНазначенияПовтИсп.СведенияОбАдресе(ЗначенияПолей);
	Если ЗначениеЗаполнено(Поле) Тогда
		
		Если Поле = "Дом" Тогда
			
			Возврат СтруктураПолейАдреса.Здание.Номер;
			
		ИначеЕсли Поле = "НаселенныйПункт" Тогда
				НаселенныйПункт = ?(ЗначениеЗаполнено(СтруктураПолейАдреса.Город), СтруктураПолейАдреса.Город + ", ", "") 
									+ ?(ЗначениеЗаполнено(СтруктураПолейАдреса.ВнутригородскойРайон), СтруктураПолейАдреса.ВнутригородскойРайон + ", ", "")
									+ ?(ЗначениеЗаполнено(СтруктураПолейАдреса.НаселенныйПункт), СтруктураПолейАдреса.НаселенныйПункт, "");
				НаселенныйПункт = СокрЛП(НаселенныйПункт);					
				Если ЗначениеЗаполнено(НаселенныйПункт) И СтрЗаканчиваетсяНа(НаселенныйПункт,",") Тогда // Убираем запятую.
					НаселенныйПункт = Лев(НаселенныйПункт, СтрДлина(НаселенныйПункт) - 1);
				КонецЕсли;					
									
			Возврат  СокрЛП(НаселенныйПункт);
			
		ИначеЕсли Поле = "Корпус" Тогда
			
			Если СтруктураПолейАдреса.Корпуса.Количество() > 0 Тогда
				Возврат СтруктураПолейАдреса.Корпуса[0].Номер;
			Иначе
				Возврат СтруктураПолейАдреса.Корпус;
			КонецЕсли; 
	
		Иначе
			
			Возврат СтруктураПолейАдреса[Поле];
			
		КонецЕсли;
		
	Иначе
		Возврат СтруктураПолейАдреса;
	КонецЕсли;
	
КонецФункции

