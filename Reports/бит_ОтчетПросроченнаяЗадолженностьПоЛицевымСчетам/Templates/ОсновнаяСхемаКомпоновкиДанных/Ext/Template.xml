			<field>ДоговорКонтрагента</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	бит_КонтактнаяИнформация.Объект КАК ФизЛицо,
	бит_КонтактнаяИнформация.Представление КАК Представление
ПОМЕСТИТЬ ВТ_Проживающие
ИЗ
	РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
ГДЕ
	бит_КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.бит_ВидыКонтактнойИнформации.ТелефонПроживающего)
	И бит_КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.бит_ТипыКонтактнойИнформации.Телефон)
	И бит_КонтактнаяИнформация.Объект ССЫЛКА Справочник.бит_Проживающие

ИНДЕКСИРОВАТЬ ПО
	ФизЛицо
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	бит_ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо КАК ФизЛицо,
	бит_ОтветственныеЛицаПоКУСрезПоследних.ДоговорКонтрагента КАК ДоговорКонтрагента
ПОМЕСТИТЬ ВТ_ОтветственныеЛица
ИЗ
	РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&amp;Период, ) КАК бит_ОтветственныеЛицаПоКУСрезПоследних
ГДЕ
	бит_ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо ССЫЛКА Справочник.бит_Проживающие

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет,
	ФизЛицо
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ОтветственноеЛицо,
	ВТ_Проживающие.Представление КАК Телефон,
	ВТ_ОтветственныеЛица.ДоговорКонтрагента КАК ДоговорКонтрагента
ИЗ
	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&amp;Период, ) КАК бит_ПроживающиеПоЛССрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Проживающие КАК ВТ_Проживающие
		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = ВТ_Проживающие.ФизЛицо
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОтветственныеЛица КАК ВТ_ОтветственныеЛица
		ПО бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет = ВТ_ОтветственныеЛица.ЛицевойСчет
			И бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = ВТ_ОтветственныеЛица.ФизЛицо
ГДЕ
	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации &gt; &amp;Период
			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
