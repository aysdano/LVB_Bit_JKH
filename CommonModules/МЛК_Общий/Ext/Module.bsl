	Обработка = ОбработкаОбъект;
	// Периоды
	ТаблицаДанныхНачислений = Новый ТаблицаЗначений;
	ТаблицаДанныхНачислений.Колонки.Добавить("Период");
	ТаблицаДанныхНачислений.Колонки.Добавить("Начислено");
	
	
	КоличествоМесяцев = Окр((ДатаОкончания - ДатаНачала) / (60*60*24*30),0);
	ПериодДанных = КонецМесяца(ДатаНачала);	
