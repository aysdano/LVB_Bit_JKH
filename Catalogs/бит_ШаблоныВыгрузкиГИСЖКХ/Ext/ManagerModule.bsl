		ТаблицаШаблоновГИСЖКХ = Справочники.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаЖилыхПомещений;
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, ТаблицаШаблоновГИСЖКХ,		2, 3);
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "АдресКвартиры",			1, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "НомерПомещения",			2, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "КатегорияПомещения",		3, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "ХарактеристикаПомещения",	4, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "ОбщаяПлощадь",				5, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "ЖилаяПлощадь",				6, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "КадастровыйНомерКвартиры",	7, );
				
		ТаблицаШаблоновГИСЖКХ = Справочники.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаКомнат;
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, ТаблицаШаблоновГИСЖКХ,		3, 3);
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "АдресКомнаты",				1, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "НомерПомещения",			2, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "НомерКомнаты",				3, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "Площадь",					4, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "КадастровыйНомерКомнаты",	5, );
		НШаблон.МакетСтраницы = Новый ХранилищеЗначения(Справочники.бит_ШаблоныВыгрузкиГИСЖКХ.ПолучитьМакет("МакетЖДРСО"));
		
		Попытка
			НШаблон.Записать();
		Исключение
		КонецПопытки;
	КонецЕсли;
	
