&НаСервере
// Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОбновитьСписокЗданий()
	
	ПервыйУровень = ДеревоОбъектовУчета.ПолучитьЭлементы();
	ПервыйУровень.Очистить();
	
	Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьУслугиСоСчетчика Тогда
		
		Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
			
			Для каждого ЭлементСписка Из мКэшЗначений.СписокЗданий Цикл
				
				Отказ = Ложь;
				
				Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик Тогда
					ПроверитьВозможностьУстановкиСчетчикаНаЗдание(ЭлементСписка.Значение, СтрокаТаблицы.Услуга, Отказ);
				КонецЕсли;
				
				Если Отказ Тогда
					Продолжить;
				КонецЕсли; 
				
				НоваяСтрокаПервогоУровня = ПервыйУровень.Добавить();
				НоваяСтрокаПервогоУровня.Услуга              = СтрокаТаблицы.Услуга;
				НоваяСтрокаПервогоУровня.Здание              = ЭлементСписка.Значение;
				НоваяСтрокаПервогоУровня.ПредставлениеЗдания = ЭлементСписка.Представление;
				НоваяСтрокаПервогоУровня.Родитель            = Истина;
				
				Для каждого ЭлементСпискаЛС Из мКэшЗначений.СписокЛС Цикл
					
					Если НЕ ЭлементСписка.Значение = ЭлементСпискаЛС.Значение.Здание Тогда
						Продолжить;
					КонецЕсли; 
					
					Отказ = Ложь;
					
					ОтветственноеЛицо    = ПолучитьОтвЛицо(ЭлементСпискаЛС.Значение);
					Индивидуальный       = Ложь;
					
					Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик Тогда
						
						ПроверитьВозможностьУстановкиСчетчикаНаЛицевойСчет(ЭлементСписка.Значение, 
						ЭлементСпискаЛС.Значение, 
						СтрокаТаблицы.Услуга, 
						,
						ОтветственноеЛицо, 
						Индивидуальный, 
						, 
						Отказ);
					КонецЕсли;
					
					Если Отказ Тогда
						Продолжить;
					КонецЕсли;
					
					ВторойУровень = НоваяСтрокаПервогоУровня.ПолучитьЭлементы();
					
					НоваяСтрокаВторогоУровня = ВторойУровень.Добавить();
					НоваяСтрокаВторогоУровня.Услуга              = СтрокаТаблицы.Услуга;
					НоваяСтрокаВторогоУровня.Здание              = ЭлементСписка.Значение;
					НоваяСтрокаВторогоУровня.ПредставлениеЗдания = ЭлементСписка.Представление;
					НоваяСтрокаВторогоУровня.ЛицевойСчет         = ЭлементСпискаЛС.Значение;
					НоваяСтрокаВторогоУровня.ОтветственноеЛицо   = ОтветственноеЛицо;
					
				КонецЦикла; 
				
			КонецЦикла; 
			
		КонецЦикла;
		
	Иначе
		
		Для каждого ЭлементСпискаУС Из мКэшЗначений.СписокУС Цикл
			
			Для каждого ЭлементСписка Из мКэшЗначений.СписокЗданий Цикл
				
				НоваяСтрокаПервогоУровня = ПервыйУровень.Добавить();
				НоваяСтрокаПервогоУровня.Услуга              = ЭлементСпискаУС.Значение;
				НоваяСтрокаПервогоУровня.Здание              = ЭлементСписка.Значение;
				НоваяСтрокаПервогоУровня.ПредставлениеЗдания = ЭлементСписка.Представление;
				НоваяСтрокаПервогоУровня.Родитель            = Истина;
				
			КонецЦикла; 
			
		КонецЦикла;
		
	КонецЕсли; 
	
КонецПроцедуры // () 

&НаКлиенте
Процедура УслугиРежимПотребленияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ТекущаяСтрока.Услуга.Пустая() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните услугу.");
		
		Возврат;
		
	КонецЕсли; 
	
	СтандартнаяОбработка = Ложь; 
	// БИТ_ЖКХ 24.03.2014
	СписокРежимов = РежимыПотребленияУслугНаСервере(ТекущаяСтрока.Услуга);
	// БИТ_ЖКХ 24.03.2014
	
	ФормаВыбора = ПолучитьФорму("Справочник.бит_РежимыПотребленияУслуг.Форма.ФормаВыбораУправляемая",,Элемент);
	
	Отбор = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Отбор.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
	Отбор.ВидСравнения   = ВидСравненияКомпоновкиДанных.ВСписке;
	Отбор.ПравоеЗначение = СписокРежимов;
	
	ФормаВыбора.Открыть();
	
КонецПроцедуры

