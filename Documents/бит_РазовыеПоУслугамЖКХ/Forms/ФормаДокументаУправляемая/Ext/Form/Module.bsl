&НаСервере
Функция ПолучитьСписокВыбораВидаОперацииНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|    ВидыОпераций.Ссылка
	|ИЗ
	|    Перечисление.бит_ВидыОперацийРазовыеПоЖКХ КАК ВидыОпераций";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокВыбора = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		СписокВыбора.Добавить(Выборка.Ссылка);
		
	КонецЦикла;
	
	МассивИсключений = Новый Массив;
	
	МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоСчетчикам);
	МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПриУстановкеСчетчика);
	МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПриСнятииСчетчика);
	
	//АПК пункт 4 https://its.1c.ru/db/v8std/content/737/hdoc
	Если НЕ (РольДоступна("ПолныеПрава") ИЛИ РольДоступна("бит_Бухгалтер")) Тогда
		
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоОтсутствующим);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслуги);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначислениеПоВременноПроживающим);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьгот);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслуге);
		// БИТ ЖКХ 10.03.2020
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеЗаПрошлыеПериоды);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьготПоНедоставкиУслуг);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьготПоОтсутствующим);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПоГрупповымСчетчикамСНаличиемИндивидуальных);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое);
		// БИТ ЖКХ 10.03.2020
        МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды);
		// БИТ ЖКХ 10.03.2020
        МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетСтраховыхДобровольныхВзносов);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПриУстановкеСчетчика);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПриСнятииСчетчика);		
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчика);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчику);
		МассивИсключений.Добавить(Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПереносОстатков);
		
	КонецЕсли;
	
	Для Каждого ЭлементМассива Из МассивИсключений Цикл
		
		НайденныйЭлемент = СписокВыбора.НайтиПоЗначению(ЭлементМассива);
		
		Если НайденныйЭлемент <> Неопределено Тогда
			
			СписокВыбора.Удалить(НайденныйЭлемент);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СписокВыбора;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьКолвоДнейНедопоставки()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	КолвоДнейНедопоставки = Строка(ДокументОбъект.РазностьДатВДнях(Объект.КонПериода,Объект.НачПериода));
	
	ЭтаФорма.КолвоДнейНедопоставки = КолвоДнейНедопоставки;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПоОплатеНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	МассивРеквизитовТабличнойЧастиСписокУслуг = Новый Массив;
	
	Для Каждого Реквизит Из Метаданные.Документы.бит_РазовыеПоУслугамЖКХ.ТабличныеЧасти.СписокУслуг.Реквизиты Цикл
		
		МассивРеквизитовТабличнойЧастиСписокУслуг.Добавить(Реквизит.Имя);
		
	КонецЦикла;
	
	ДокументОбъект.ЗаполнитьПоОплате(МассивРеквизитовТабличнойЧастиСписокУслуг);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПереносОстатковСервер()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	МассивЛС = Новый Массив;
	Если ДокументОбъект.СписокУслуг.Количество() > 0 Тогда
		МассивЛС = ДокументОбъект.СписокУслуг.ВыгрузитьКолонку("ЛицевойСчет");
		ДокументОбъект.СписокУслуг.Очистить();
		// БИТ ЖКХ 20.07.2020
		ДокументОбъект.СписокУслугПеня.Очистить();
	КонецЕсли;
	
	ТекстЗапрос =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Организация КАК Организация
	|ПОМЕСТИТЬ ПоставщикиИУслуги
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&КонецПериода {(&КонецПериода)}, Услуга = &УслугаСписания) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|	И бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Услуга,
	|	ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Организация КАК Организация
	|ПОМЕСТИТЬ ВТ_УслугиНачисления
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&КонецПериода {(&КонецПериода)}, Услуга = &УслугаНачисления) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|	И бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Организация
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Услуга,
	|	ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ КАК УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|			&НачалоПериода {(&НачалоПериода)},
	|			&КонецПериода {(&КонецПериода)},
	|			,
	|			,
	|			(ЛицевойСчет, УслугаЖКХ) В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ПоставщикиИУслуги.ЛицевойСчет,
	|					ПоставщикиИУслуги.Услуга
	|				ИЗ
	|					ПоставщикиИУслуги)) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	УслугаЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПоставщикиИУслуги.Услуга КАК Услуга,
	|	ЕСТЬNULL(ВТ_УслугиНачисления.Услуга, ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)) КАК УслугаНачисления,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0) < 0
	|				ТОГДА -ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаКонечныйОстатокКт,
	|	ПоставщикиИУслуги.ЛицевойСчет КАК ЛицевойСчет,
	|	ПоставщикиИУслуги.Организация
	|ИЗ
	|	ПоставщикиИУслуги КАК ПоставщикиИУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК Остатки
	|		ПО ПоставщикиИУслуги.ЛицевойСчет = Остатки.ЛицевойСчет
	|			И ПоставщикиИУслуги.Услуга = Остатки.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УслугиНачисления КАК ВТ_УслугиНачисления
	|		ПО ПоставщикиИУслуги.ЛицевойСчет = ВТ_УслугиНачисления.ЛицевойСчет
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоставщикиИУслуги.Услуга,
	|	ЕСТЬNULL(ВТ_УслугиНачисления.Услуга, ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)),
	|	ПоставщикиИУслуги.ЛицевойСчет,
	|	ПоставщикиИУслуги.Организация
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0) < 0
	|				ТОГДА -ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) > 0";
	
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапрос);

	Если МассивЛС.Количество() > 0 Тогда
		
		ЗапросСхемы0	= СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбора0 = ЗапросСхемы0.Операторы[0];
		ОператорВыбора0.Отбор.Добавить("бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет В (&ЛицевыеСчета)");

		ЗапросСхемы1	= СхемаЗапроса.ПакетЗапросов[1];
		ОператорВыбора1 = ЗапросСхемы1.Операторы[0];
		ОператорВыбора1.Отбор.Добавить("бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет В (&ЛицевыеСчета)");
		
	КонецЕсли;
	
	Запрос = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());
	Запрос.УстановитьПараметр("Организация"		,ДокументОбъект.Организация);
	Запрос.УстановитьПараметр("НачалоПериода"	,ДокументОбъект.НачПериода);
	Запрос.УстановитьПараметр("КонецПериода"	,ДокументОбъект.КонПериода);
	Запрос.УстановитьПараметр("УслугаСписания"	,ДокументОбъект.УслугаСписания);
	Запрос.УстановитьПараметр("УслугаНачисления",ДокументОбъект.УслугаНачисления);
	Запрос.УстановитьПараметр("ЛицевыеСчета"	,МассивЛС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(Выборка.УслугаНачисления) Тогда
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Для лицевого счетета '" + Строка(Выборка.ЛицевойСчет) + "' отсутствует услуга начисления!");
			Продолжить;
		КонецЕсли;
		
		НСтр = ДокументОбъект.СписокУслуг.Добавить();
		НСтр.ЛицевойСчет = Выборка.ЛицевойСчет;
		НСтр.Услуга = Выборка.Услуга;
		НСтр.Сумма = Выборка.СуммаКонечныйОстатокКт;
		
		НСтр = ДокументОбъект.СписокУслуг.Добавить();
		НСтр.ЛицевойСчет = Выборка.ЛицевойСчет;
		НСтр.Услуга = Выборка.УслугаНачисления;
		НСтр.Сумма = -Выборка.СуммаКонечныйОстатокКт;
		
	КонецЦикла; 
	
	Если ДокументОбъект.СписокУслуг.Количество() = 0 Тогда
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Отсутствуют переплаты для выбранного набора лицевых счетов и услуг!");
		Возврат;	
	КонецЕсли;
	
	МассивЛС = ДокументОбъект.СписокУслуг.ВыгрузитьКолонку("ЛицевойСчет");
	МассивУслуг = Новый Массив();
	МассивУслуг.Добавить("Услуга");
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ДокументОбъект.СписокУслуг, МассивУслуг, МассивЛС
											, ДокументОбъект.Организация , КонецМесяца(ДокументОбъект.Дата),,,,,,, Истина);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
	РассчитатьСуммыПересчетаНаСервере();	
	
КонецПроцедуры

