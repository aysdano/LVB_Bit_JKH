		//Если ТабСчетчики.Количество() > 0 Тогда
		//	МаксКолВоСчетчиков = ТабСчетчики[0].КолВоСчетчиков;
		//КонецЕсли;
	КонецЕсли;
	
	//01.08.2019
	Если НастройкаПолейСтрокиРеестраСальдо.НайтиСтроки(ОтборСчетчики).Количество() = 0 Тогда
      ОтборСчетчики = Новый Структура("ИмяПоля, Использовать", "СчетчикиБезТипа", Истина);
	  Если НастройкаПолейСтрокиРеестраСальдо.НайтиСтроки(ОтборСчетчики).Количество() > 0 Тогда
		ТабСчетчики = ПолучитьСчетчики();		
	  КонецЕсли;		
	КонецЕсли;	
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = "";
		
		СимволРазделения = сг_СимволРазделения;
		
		Для каждого СтрокаТаблицы Из НастройкаПолейСтрокиРеестраСальдо Цикл
			
			Индекс = НастройкаПолейСтрокиРеестраСальдо.Индекс(СтрокаТаблицы);
			
			ПоследСтрока = (Индекс = КоличествоПолей);
			
			Город       = "";
			Здание      = "";
			Улица       = "";
			Квартира    = "";
			ЛицевойСчет = "";
			ФИО         = "";
			
			Если СтрокаТаблицы.Использовать И НЕ ПустаяСтрока(СтрокаТаблицы.ИмяПоля) Тогда
				
				// Поле лицевого счета заполняется по настройке либо наименованием либо идентификатором.
				Если СтрокаТаблицы.ИмяПоля = "ЛицевойСчет" Тогда
					
					ЛицевойСчет = СокрЛП(Выборка.НаименованиеЛС);
					
					НоваяСтрока  = НоваяСтрока + ЛицевойСчет;
					
				// БИТ ЖКХ 30.06.2020	
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "ЕЛС" Тогда
					
					НоваяСтрока = НоваяСтрока + Выборка.ЛицевойСчет.ЕЛСГИСЖКХ;
                // БИТ ЖКХ 02.07.2020
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "КодФИАС" Тогда
					
					// БИТ ЖКХ 19.10.2020
					//НоваяСтрока = НоваяСтрока + Выборка.Здание.КодФИАС + строка(",") + строка(Выборка.Квартира.НомерКвартиры);
				   // БИТ ЖКХ 05.03.2021	
				   Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Выборка, "Здание") тогда					
					 НоваяСтрока = НоваяСтрока + Выборка.Здание.КодФИАС;
				   иначе	 
				    Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Выборка.ЛицевойСчет, "Здание") тогда					
				     НоваяСтрока = НоваяСтрока + Выборка.ЛицевойСчет.Здание.КодФИАС
				    конецесли;
				   конецесли;
				// БИТ ЖКХ 11.01.2021
			    ИначеЕсли СтрокаТаблицы.ИмяПоля = "КодФИАСКвартира" Тогда
				    // БИТ ЖКХ 05.03.2021
				    кодФИАС = "";
					Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Выборка, "Здание") тогда				
					 кодФИАС = Выборка.Здание.КодФИАС;
				    иначе 
					  Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Выборка.ЛицевойСчет, "Здание") тогда					
				       кодФИАС = Выборка.ЛицевойСчет.Здание.КодФИАС
				      конецесли
					конецесли;	
					// БИТ ЖКХ 11.01.2021
					
					НоваяСтрока = НоваяСтрока + кодФИАС + строка(ДобавитьРазделитель(кодФИАС)) + строка(Выборка.Квартира.НомерКвартиры);
					
				// БИТ ЖКХ 12.01.2021	
			    ИначеЕсли СтрокаТаблицы.ИмяПоля = "Реквизит1" ИЛИ
				           СтрокаТаблицы.ИмяПоля = "Реквизит2" Тогда
					
					НоваяСтрока = НоваяСтрока + СтрокаТаблицы.ЗначениеРеквизита;
	
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "ИдентификаторЛицевогоСчета" Тогда
					
					ИД = Формат(Выборка.ИдентификаторЛицевогоСчета, "ЧГ=0");
					
					НоваяСтрока  = НоваяСтрока + ИД;
					
					// Состав поля адреса ГОРОД,УЛИЦА,ЗДАНИЕ,КВАРТИРА.
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "Адрес" Тогда
					
					Город    = Город + Выборка.Город;
					Улица    = Улица + Выборка.Улица;
					Здание   = Здание + Выборка.Здание + ?(ЗначениеЗаполнено(Выборка.Корпус), "К" + Выборка.Корпус, "") + ?(ЗначениеЗаполнено(Выборка.Строение), " строение " + Выборка.Строение, "");
					Квартира = Квартира + Выборка.Квартира; // + ?(ЗначениеЗаполнено(Выборка.ПрефиксКвартиры), Выборка.ПрефиксКвартиры, "");
					// БИТ ЖКХ 12.01.2021
					НоваяСтрока = НоваяСтрока + Город + ДобавитьРазделитель(Город) + Улица + "," + Здание + "," + Квартира;
				//08.05.2019	
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "ФИОСЗапятыми" Тогда
					
                    ЧастиФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Выборка.ФИО);
					НоваяСтрока  = НоваяСтрока + ЧастиФИО.Фамилия + "," + ЧастиФИО.Имя + "," + ЧастиФИО.Отчество;
                									
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "ФИОАдрес" Тогда
					
					ЧастиФИО = ФизическиеЛицаКлиентСервер.ЧастиИмени(Выборка.ФИО);
//					НоваяСтрока  = НоваяСтрока + ЧастиФИО.Фамилия + "," + ЧастиФИО.Имя + "," + ЧастиФИО.Отчество;

					ФИО      = ФИО + ЧастиФИО.Фамилия + "," + ЧастиФИО.Имя + "," + ЧастиФИО.Отчество;
					Город    = Город + Выборка.Город;
					Улица    = Улица + Выборка.Улица;
					Здание   = Здание + Выборка.Здание + ?(ЗначениеЗаполнено(Выборка.Корпус), "К" + Выборка.Корпус, "") + ?(ЗначениеЗаполнено(Выборка.Строение), " строение " + Выборка.Строение, "");
					Квартира = Квартира + Выборка.Квартира; // + ?(ЗначениеЗаполнено(Выборка.ПрефиксКвартиры), Выборка.ПрефиксКвартиры, "");
					
					НоваяСтрока = НоваяСтрока + ФИО + "/" + Город + "," + Улица + "," + Здание + "," + Квартира;
					
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "КодДополнения" Тогда
					
					НоваяСтрока      = НоваяСтрока + Объект.сг_ФиксированныйКод;
					СимволРазделения = сг_СимволПослеКодаДополнения;
					
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "НачалоПериода" Тогда
					
					НоваяСтрока = НоваяСтрока + Формат(Объект.сг_НачалоПериода, СтрокаТаблицы.Формат);
					
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "КонецПериода" Тогда
					
					НоваяСтрока = НоваяСтрока + Формат(Объект.сг_КонецПериода, СтрокаТаблицы.Формат);
					
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "ШтрихКод" Тогда
					
					ШаблонИзвещения = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемУслугам");
					
					Сумма = 0;
					
					Попытка
						Сумма = ?(Выборка.КонечноеСальдо > 0, Выборка.КонечноеСальдо,0);
					Исключение
					КонецПопытки; 
					
					Если НЕ НастроитьСоставШК Тогда
						ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(Сумма,
						Выборка.НаименованиеЛС,
						ШаблонИзвещения.Идентификатор,
						Выборка.ИдентификаторЛицевогоСчета,
						НомерПолучателяПоБанку,
						ИспользоватьНомерПолучателя);
					Иначе
						Попытка
							Выполнить(ТекстПользовательскойФункции);
						Исключение	
							ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка выполнения пользовательской функции:
							|"+ОписаниеОшибки());
						КонецПопытки;
					КонецЕсли;
					
					НоваяСтрока = НоваяСтрока + ЗначениеШтрихкода;
					
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "НаселенныйПункт" Тогда
					
					НоваяСтрока = НоваяСтрока + Выборка.Город;
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "Улица" Тогда
					
					НоваяСтрока = НоваяСтрока + Выборка.Улица;
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "НомерДома" Тогда
					
					НоваяСтрока = НоваяСтрока + Выборка.Здание + ?(ЗначениеЗаполнено(Выборка.Корпус), "К" + Выборка.Корпус, "") + ?(ЗначениеЗаполнено(Выборка.Строение), " строение " + Выборка.Строение, "");
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "НомерКвартиры" Тогда
					
					НоваяСтрока = НоваяСтрока + Выборка.Квартира; // + ?(ЗначениеЗаполнено(Выборка.ПрефиксКвартиры), Выборка.ПрефиксКвартиры, "");
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "Счетчики" И ЗначениеЗаполнено(ТабСчетчики) Тогда
					
					МассивСчетчики = ТабСчетчики.НайтиСтроки(Новый Структура("ЛицевойСчет", Выборка.ЛицевойСчет));
					//КолВоСчетчиковЛС = 0;
					Для Каждого Элт Из МассивСчетчики Цикл
						НоваяСтрока = НоваяСтрока + СтрШаблон("%1%4%2%4%3%4"
																, Лев(Элт.НомерСчетчика, 20)
																, Лев(Строка(Элт.Тип), 8)
																, Формат(Элт.ПоследниеПоказания, СтрокаТаблицы.Формат)
																, СимволРазделения);
						//КолВоСчетчиковЛС = КолВоСчетчиковЛС + 1;
					КонецЦикла;
					
					//// Выравнивает количество полей по счетчикам для всех ЛС.
					//Пока КолВоСчетчиковЛС <= МаксКолВоСчетчиков Цикл
					//	НоваяСтрока = НоваяСтрока + СтрШаблон("%1%1%1", СимволРазделения);
					//	КолВоСчетчиковЛС = КолВоСчетчиковЛС + 1;
					//КонецЦикла; 
					
				//01.08.2019
				ИначеЕсли СтрокаТаблицы.ИмяПоля = "СчетчикиБезТипа" И ЗначениеЗаполнено(ТабСчетчики) Тогда
					
					МассивСчетчики = ТабСчетчики.НайтиСтроки(Новый Структура("ЛицевойСчет", Выборка.ЛицевойСчет));
					//КолВоСчетчиковЛС = 0;
					Для Каждого Элт Из МассивСчетчики Цикл
						НоваяСтрока = НоваяСтрока + СтрШаблон("%1%3%2%3"
																	, Лев(Элт.НомерСчетчика, 20)
																	, Формат(Элт.ПоследниеПоказания, СтрокаТаблицы.Формат)
																	, СимволРазделения);

						//КолВоСчетчиковЛС = КолВоСчетчиковЛС + 1;
					КонецЦикла;						
					
				Иначе
					
					НоваяСтрока = НоваяСтрока + Формат(Выборка[СтрокаТаблицы.ИмяПоля], СтрокаТаблицы.Формат);
					
				КонецЕсли;
				
			Иначе
				
				// Разеделитель поля ФИО "Пробел" если не используется поле - два пробела.
				Если СтрокаТаблицы.ИмяПоля = "ФИО" Тогда
					НоваяСтрока = НоваяСтрока + "  ";
				КонецЕсли;
				
				// Разеделитель поля адрес "Запятая" если не используется поле - три запятых.
				Если СтрокаТаблицы.ИмяПоля = "Адрес" Тогда
					НоваяСтрока = НоваяСтрока + ",,,";
				КонецЕсли; 
				
			КонецЕсли;
			
			НоваяСтрока = НоваяСтрока + ?(ПоследСтрока И НЕ сг_ЗаканчиватьСтрокуСимволом,"",СимволРазделения);
			
		КонецЦикла;
		
		Текст.ДобавитьСтроку(НоваяСтрока);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура сгВыгрузить(Текст)
	
	ИспользоватьНомерПолучателя = Ложь;
	НомерПолучателяПоБанку      = 0;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИспользоватьНомерПолучателяВШК", ИспользоватьНомерПолучателя);
	СтруктураПараметров.Вставить("НомерПолучателяПоБанку"        , НомерПолучателяПоБанку);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Объект.сг_КонецПериода), Объект.Организация, СтруктураПараметров);
	
	ИспользоватьНомерПолучателя = СтруктураПараметров.ИспользоватьНомерПолучателяВШК;
	НомерПолучателяПоБанку      = СтруктураПараметров.НомерПолучателяПоБанку;
	
	ПостроительЗапроса = Новый ПостроительЗапроса;

	ПостроительЗапроса.Параметры.Вставить("НачалоПериода", НачалоДня(Объект.сг_НачалоПериода));
	ПостроительЗапроса.Параметры.Вставить("КонецПериода" , КонецДня(Объект.сг_КонецПериода));
	ПостроительЗапроса.Параметры.Вставить("Организация"  , Объект.Организация);
	
	Если Объект.ВыводИнформации  = "С разбивкой по услугам" Тогда
		ПостроительЗапроса.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
		|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток) КАК НачальноеСальдо,
		|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток) КАК КонечноеСальдо,
		|	СУММА(0) КАК НачальноеСальдоПени,
		|	СУММА(0) КАК КонечноеСальдоПени
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
		|	СУММА(0),
		|	СУММА(0),
		|	СУММА(бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.СуммаПениНачальныйОстаток),
		|	СУММА(бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.СуммаПениКонечныйОстаток)
		|ИЗ
		|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ЛицевойСчет.Организация = &Организация) КАК бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.ЛицевойСчет,
		|	Остатки.УслугаЖКХ,
		|	СУММА(Остатки.НачальноеСальдо) КАК НачальноеСальдо,
		|	СУММА(Остатки.КонечноеСальдо) КАК КонечноеСальдо,
		|	СУММА(Остатки.НачальноеСальдоПени) КАК НачальноеСальдоПени,
		|	СУММА(Остатки.КонечноеСальдоПени) КАК КонечноеСальдоПени
		|ПОМЕСТИТЬ ГрупОстатки
		|ИЗ
		|	Остатки КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.ЛицевойСчет,
		|	Остатки.УслугаЖКХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
