	Результат = ПолучитьРезультатДубликат(Параметры.Ключ);
	// БИТ_ЖКХ_30012014_окончание_изменений
	
	// БИТ_ЖКХ 10.02.2014
	
	//Результат = Документы.бит_СвидетельствоОРегистрацииПоМестуПроживания.Печать(Параметры.Ключ);
	//
	Если Результат.НетОшибок Тогда
		//УниверсальныеМеханизмы.НапечататьДокумент(Результат.ТабДокумент,,,"Свидетельство о регистрации по месту жительства");
		АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат.ТабДокумент, АдресТабличногоДокументаВоВременномХранилище);
		
