#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем обязательные поля.
//	Если НЕ ЗначениеЗаполнено(Объект.Ссылка)
//		И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда // Новый, не копирование.
        если Объект.ПоляЗагрузки.НайтиСтроки(Новый Структура("ПолеОплатыКУ", "ДатаОплаты" )).Количество() = 0 тогда
		 НовСтрока = Объект.ПоляЗагрузки.Добавить();
		 НовСтрока.НомерПозиции = 10;
		 НовСтрока.ПолеОплатыКУ = "ДатаОплаты";
	    конецесли;
		
		если Объект.ПоляЗагрузки.НайтиСтроки(Новый Структура("ПолеОплатыКУ", "ЛицевойСчет" )).Количество() = 0 тогда
		 НовСтрока = Объект.ПоляЗагрузки.Добавить();
		 НовСтрока.НомерПозиции = 3;
		 НовСтрока.ПолеОплатыКУ = "ЛицевойСчет";
	    конецесли; 
		
		если Объект.ПоляЗагрузки.НайтиСтроки(Новый Структура("ПолеОплатыКУ", "Сумма" )).Количество() = 0 тогда
		 НовСтрока = Объект.ПоляЗагрузки.Добавить();
		 НовСтрока.НомерПозиции = 4;
		 НовСтрока.ПолеОплатыКУ = "Сумма";
		конецесли; 
		
		если Объект.ПоляЗагрузки.НайтиСтроки(Новый Структура("ПолеОплатыКУ", "Счетчик" )).Количество() = 0 тогда
		 НовСтрока = Объект.ПоляЗагрузки.Добавить();
		 НовСтрока.НомерПозиции = 13;
		 НовСтрока.ПолеОплатыКУ = "Счетчик";
		конецесли; 
		
		если Объект.ПоляЗагрузки.НайтиСтроки(Новый Структура("ПолеОплатыКУ", "ЗначениеСчетчика" )).Количество() = 0 тогда
		 НовСтрока = Объект.ПоляЗагрузки.Добавить();
		 НовСтрока.НомерПозиции = 14;
		 НовСтрока.ПолеОплатыКУ = "ЗначениеСчетчика";
    	КонецЕсли;
		
КонецПроцедуры

