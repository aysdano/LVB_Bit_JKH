		бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(Объект.Дата, Объект.Организация, СписокЛ, СписокЗданий, , , ТабЛицевыеСчета,ТабНачисления,,,,,,,,);
		
		Массив = Новый Массив;
		
		Для каждого СтрокаСбора из ТаблицаСбора Цикл
			
			Для каждого Строка из ТабЛицевыеСчета Цикл
				
				Если СтрокаСбора.Услуга = Строка.Услуга Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						СтрокаСбора.Объем = СтрокаСбора.Сумма/Строка.Тариф;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Попытка 	
				Массив.Добавить(СтрокаСбора.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		
		Для каждого СтрокаСбора из ТаблицаСбора Цикл
			
			Для каждого Строка из ТабНачисления Цикл
				
				Если СтрокаСбора.Услуга = Строка.Услуга Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						СтрокаСбора.Объем = СтрокаСбора.Сумма/Строка.Тариф;
						
					КонецЕсли; 
					
