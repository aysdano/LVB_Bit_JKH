
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда
		
		//+!  изменено ГВВ 23.08.2022 https://firstbitone.freshdesk.com/a/tickets/5604
		//Отказ = Истина;
		//ТекстСообщения = НСтр("ru = 'Запрещено создавать документ копированием.'");
		//ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		//Возврат;
		ПрисоединенныйФайл = неопределено;
		//-! 
	КонецЕсли;

	
	НастройкиДоступа();
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.Организация = БухгалтерскийУчетПереопределяемый.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация");
	Иначе
		ДвоичныеДанныеПрисоединенныйФайл = ПолучитьПрисоединенныйФайл(Объект.Ссылка);
		ДанныеФайла = ДвоичныеДанныеПрисоединенныйФайл;	
	КонецЕсли;
	
	Если ЭтоШаблонПлатежногоДокумента(Объект.ШаблонВыгрузкиГИСЖКХ) Тогда
		Элементы.ШаблонИзвещений.Видимость = Истина;
		Элементы.ДолговойПД.Видимость = Истина;
	Иначе
		Элементы.ШаблонИзвещений.Видимость = Ложь;
		Элементы.ДолговойПД.Видимость = Ложь;
	КонецЕсли;
	
	//11.11.2019
	//11.09.2020
	если строка(Объект.ШаблонВыгрузкиГИСЖКХ) = "Шаблон импорт платежных документов" ИЛИ 
               	строка(Объект.ШаблонВыгрузкиГИСЖКХ) = "Шаблон импорт платежных документов 2020" тогда	
		Элементы.ГруппаСверткиВодоснабжения.Видимость = истина;
	иначе
		Элементы.ГруппаСверткиВодоснабжения.Видимость = ложь;
	КонецЕсли; 
	
	Объект.ВсеДома = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	// Запись макета.
	Если ЗначениеЗаполнено(ДанныеФайла) Тогда
		Попытка
			ТекущийОбъект.ПрисоединенныйФайл = Новый ХранилищеЗначения(ДанныеФайла, Новый СжатиеДанных(9));
		Исключение
		КонецПопытки;
	КонецЕсли;

	СтруктураДанныхМакета = Неопределено;
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	НастройкиДоступа();
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Укажите файл";
	Диалог.Фильтр    = "(*.xlsx;*.xls)|*.xlsx;*.xls";
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьПутьКаталогаЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПутьКаталогаЗавершение(ВыбранныйКаталог, ВходящийКонтекст) Экспорт
	
	Если ТипЗнч(ВыбранныйКаталог) = Тип("Массив") И ВыбранныйКаталог.Количество() > 0 Тогда 
		Каталог = ВыбранныйКаталог[0];
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Если ЗначениеЗаполнено(Каталог) Тогда
		ЗапуститьПриложение(Каталог);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУлицОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Элт Из ВыбранноеЗначение Цикл
		Если Элт = Неопределено
			ИЛИ Элт = ПредопределенноеЗначение("Справочник.бит_СписокУлиц.ПустаяСсылка") Тогда
			Продолжить;	
		КонецЕсли;
		НоваяСтрока = Объект.СписокУлиц.Добавить();
		НоваяСтрока.Улица = Элт;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗданийОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Элт Из ВыбранноеЗначение Цикл
		Если Элт = Неопределено
			ИЛИ Элт = ПредопределенноеЗначение("Справочник.бит_СписокЗданий.ПустаяСсылка") Тогда
			Продолжить;	
		КонецЕсли;
		НоваяСтрока = Объект.СписокЗданий.Добавить();
		НоваяСтрока.Здание = Элт;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Элт Из ВыбранноеЗначение Цикл
		Если Элт = Неопределено
			ИЛИ элт = ПредопределенноеЗначение("Справочник.бит_ЛицевыеСчета.ПустаяСсылка") Тогда
			Продолжить;	
		КонецЕсли;
		НоваяСтрока = Объект.СписокЛС.Добавить();
		НоваяСтрока.ЛицевойСчет = Элт;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблоныВыгрузкиГИСЖКХОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЭтоШаблонПлатежногоДокумента(ВыбранноеЗначение) Тогда
		
		Элементы.ШаблонИзвещений.Видимость = Истина;
		Элементы.ДолговойПД.Видимость = Истина;
		Если НЕ ЗначениеЗаполнено(Объект.ДолговойПД) Тогда
			Объект.ДолговойПД = ПредопределенноеЗначение("Перечисление.ДаНет.Нет");
		КонецЕсли;
		Элементы.ВыводитьКоличествоДопУслуг.Видимость = Истина; 
	Иначе
		Элементы.ШаблонИзвещений.Видимость = Ложь;
		Элементы.ДолговойПД.Видимость = Ложь;
		Объект.ДолговойПД = ПредопределенноеЗначение("Перечисление.ДаНет.ПустаяСсылка");
		Элементы.ВыводитьКоличествоДопУслуг.Видимость = Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонИзвещений) Тогда
		Объект.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемУслугам");
	КонецЕсли;	
	
	//11.11.2019
	//11.09.2020
	если строка(ВыбранноеЗначение) = "Шаблон импорт платежных документов" ИЛИ 
		  строка(ВыбранноеЗначение) = "Шаблон импорт платежных документов 2020" тогда
		ЭтаФорма.Элементы.ГруппаСверткиВодоснабжения.Видимость = истина;
	иначе
		ЭтаФорма.Элементы.ГруппаСверткиВодоснабжения.Видимость = ложь;
	КонецЕсли;  
	
	//23.04.2020
	если строка(ВыбранноеЗначение) <> "Шаблон импорта ЛС" тогда
		ЭтаФорма.Элементы.ВыводитьКомнаты.Видимость = ложь;
	иначе
		ЭтаФорма.Элементы.ВыводитьКомнаты.Видимость = истина;
	КонецЕсли;   
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

