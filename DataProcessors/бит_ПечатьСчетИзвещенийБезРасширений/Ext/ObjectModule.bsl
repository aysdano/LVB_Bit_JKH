	|					И УслугаЖКХ = &УслугаРФКР) КАК бит_НачисленияПоУслугамЖКХОстатки
	|	ГДЕ
	|		НЕ ТИПЗНАЧЕНИЯ(бит_НачисленияПоУслугамЖКХОстатки.Регистратор) = ТИП(Документ.бит_ВводНачальныхОстатковПоКУ)
	|	
	|	ОБЪЕДИНИТЬ ВСЕ
	|	
	|	ВЫБРАТЬ
	|		ЕСТЬNULL(СУММА(ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(бит_НачисленияПоУслугамЖКХОстатки.Регистратор) = ТИП(Документ.бит_РазовыеПоУслугамЖКХ)
	|						ТОГДА бит_НачисленияПоУслугамЖКХОстатки.СуммаПриход - бит_НачисленияПоУслугамЖКХОстатки.СуммаРасход
	|					ИНАЧЕ бит_НачисленияПоУслугамЖКХОстатки.СуммаПриход
	|				КОНЕЦ), 0),
	|		ЕСТЬNULL(СУММА(ВЫБОР
	|					КОГДА ТИПЗНАЧЕНИЯ(бит_НачисленияПоУслугамЖКХОстатки.Регистратор) = ТИП(Документ.бит_РазовыеПоУслугамЖКХ)
	|						ТОГДА 0
	|					ИНАЧЕ бит_НачисленияПоУслугамЖКХОстатки.СуммаРасход
	|				КОНЕЦ), 0)
	|	ИЗ
	|		РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|				,
	|				КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ),
	|				Регистратор,
	|				,
	|				Организация = &Организация
	|					И ЛицевойСчет.Здание = &Здание
	|					И УслугаЖКХ = &УслугаЖКХ) КАК бит_НачисленияПоУслугамЖКХОстатки
	|	ГДЕ
	|		НЕ ТИПЗНАЧЕНИЯ(бит_НачисленияПоУслугамЖКХОстатки.Регистратор) = ТИП(Документ.бит_ВводНачальныхОстатковПоКУ)) КАК ВложенныйЗапрос";
	Запрос.УстановитьПараметр("ДатаРФКР", МструктураДанных.Дата);
	//--Мельник
	
	Запрос.УстановитьПараметр("Дата", ДобавитьМесяц(МструктураДанных.Дата,-1));
	Запрос.УстановитьПараметр("Здание", МструктураДанных.КвартираСсылка.Владелец);
	Запрос.УстановитьПараметр("УслугаЖКХ", УслугаМинВзнос);
	Запрос.УстановитьПараметр("УслугаРФКР", УслугаРФКР);
	Запрос.УстановитьПараметр("Организация", Организация);	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	ОбластьКвитанции.Параметры.ДатаНаНачало                  = ФОрмат(НачалоМесяца(МструктураДанных.Дата),"ДФ=dd.MM.yyyy");
	Если Выборка.Следующий() Тогда                          
		ОбластьКвитанции.Параметры.НачНаНачало             = ?(Выборка.СуммаПриход = Null, 0, Выборка.СуммаПриход) + ПолучитьОстатокПоКР(МструктураДанных.КвартираСсылка.Владелец);
		ОбластьКвитанции.Параметры.ОплНаНачало             = ?(Выборка.СуммаРасход = Null, 0, Выборка.СуммаРасход) + ПолучитьОстатокПоКР(МструктураДанных.КвартираСсылка.Владелец, Ложь);
	Иначе
		ОбластьКвитанции.Параметры.НачНаНачало             = 0 +  ПолучитьОстатокПоКР(МструктураДанных.КвартираСсылка.Владелец);
		ОбластьКвитанции.Параметры.ОплНаНачало               = 0 + ПолучитьОстатокПоКР(МструктураДанных.КвартираСсылка.Владелец, Ложь);
	КонецЕсли;
	
	ПроверкаДаты = СтрНайти(ДанныеОПолучателеПлатежа[0].Наименование,"ЛЕВОБЕРЕЖЬЕ");
	ОбластьКвитанции.Параметры.Сальдо                = "Остаток средств на специальном счете на " + ?(ПроверкаДаты = 0,Формат(НачалоМесяца(ДобавитьМесяц(МструктураДанных.Дата, -1)),"ДФ=dd.MM.yyyy"),Формат(НачалоМесяца(МструктураДанных.Дата),"ДФ=dd.MM.yyyy")) + " " + ПолучитьСальдо(МструктураДанных.Дата,РасчетныйСчет,ДанныеОПолучателеПлатежа[0].Наименование)+ " " + "руб."; 
	ОбластьКвитанции.Параметры.Текст                 = ПолучитьТекстДляКвитанции(); 
	ОбластьКвитанции.Параметры.Всего                 = Число(ОбластьКвитанции.Параметры.ПениКОплате) + ОбластьКвитанции.Параметры.ДопВзносКОплате + ОбластьКвитанции.Параметры.МинВзносКОплате;
	ОбластьКвитанции.Параметры.НомерЛС               = Лев(СокрЛП(мСтруктураДанных.ЛицевойСчетНомер),4)+"   "+Прав(СокрЛП(мСтруктураДанных.ЛицевойСчетНомер),7);;
	ОбластьКвитанции.Параметры.Организация           = ДанныеОПолучателеПлатежа[0].Наименование;
	ОбластьКвитанции.Параметры.КПП                   = ДанныеОПолучателеПлатежа[0].КПП;
	ОбластьКвитанции.Параметры.ИНН                   = ДанныеОПолучателеПлатежа[0].ИНН;
	ОбластьКвитанции.Параметры.Банк                  = "В " + ДанныеОПолучателеПлатежа[0].Банк;
	ОбластьКвитанции.Параметры.БИК                   = ДанныеОПолучателеПлатежа[0].БИК;
	ОбластьКвитанции.Параметры.КоррСчет              = ДанныеОПолучателеПлатежа[0].КоррСчет;
	ОбластьКвитанции.Параметры.РасчетныйСчет         = РасчетныйСчет;
	ОбластьКвитанции.Параметры.ЮрАдрес               = ПолучательАдрес;
	ОбластьКвитанции.Параметры.ЕЛСГИСЖКХ             = мСтруктураДанных.ЕЛСГИСЖКХ;
	ОбластьКвитанции.Параметры.Адрес                 = лб_сервер.лб_АдресЛС(мСтруктураДанных.ЛицевойСчет, мСтруктураДанных.Дата);
	ОбластьКвитанции.Параметры.МесяцГодСтрока        = мСтруктураДанных.Период;
	ОбластьКвитанции.Параметры.ПериодМесяцГод        = мСтруктураДанных.ПериодМесяц + "." + мСтруктураДанных.ПериодГод;
	ОбластьКвитанции.Параметры.ПериодДеньМесяцГод    = "01." + мСтруктураДанных.ПериодМесяц + "." + мСтруктураДанных.ПериодГод;
	ОбластьКвитанции.Параметры.ОтветственныйФИО      = ЛицевойСчетФИО;
	//shevtsov 12.12.25 Начало
	//Было:
	//ОбластьКвитанции.Параметры.ДатаПечати     	     = мСтруктураДанных.ДатаПечатиКвитанций;
	//Стало:
	Если НЕ БИТ_НеВыводитьДатуПечати Тогда
																 
		ОбластьКвитанции.Параметры.БлокДатаПечатиКвитанций = СтрШаблон(НСтр("ru='Дата печати %1%2'"),
															   "",
															   Формат(?(ЗначениеЗаполнено(ДатаПечатиКвитанций), ДатаПечатиКвитанций, ТекущаяДата()), "ДФ=дд.ММ.гггг")); 
		
	КонецЕсли;
	//shevtsov 12.12.25 Окончание
	ОбластьКвитанции.Параметры.ИнфоАО       	     = мСтруктураДанных.АдресУчастка;
	ОбластьКвитанции.Параметры.ИнфоАОТ     	         = "Телефоны: " + мСтруктураДанных.ТелефоныУчастка;
	ОбластьКвитанции.Параметры.КодПочты1     	     = КодПочты1СРазделителем;
	ОбластьКвитанции.Параметры.КодПочты2     	     = КодПочты2СРазделителем;
	ОбластьКвитанции.Параметры.ПлощадьКвартиры       = Формат(Площадь,"ЧДЦ=2");
	ОбластьКвитанции.Параметры.ДопТекстКОплате       = ДопТекстКОплате;
	МакетКапРемонт.Вывести(ОбластьКвитанции);
	//Перерасчеты
	МассивУслугКапРем = Новый Массив;
	МассивУслугКапРем.Добавить(УслугаМинВзнос);
	МассивУслугКапРем.Добавить(УслугаДопВзнос);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет",мСтруктураДанных.ЛицевойСчет);
	Запрос.УстановитьПараметр("Период",мСтруктураДанных.Дата);
	Запрос.УстановитьПараметр("МассивУслуг",МассивУслугКапРем);
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХ.Регистратор КАК Регистратор,
	|	бит_НачисленияПоУслугамЖКХ.УслугаЖКХ КАК Услуга,
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			ТОГДА -бит_НачисленияПоУслугамЖКХ.Сумма
	|		ИНАЧЕ бит_НачисленияПоУслугамЖКХ.Сумма
	|	КОНЕЦ КАК Сумма,
	|	бит_НачисленияПоУслугамЖКХ.Регистратор.ДокументНаПерерасчет КАК Основание,
	|	бит_НачисленияПоУслугамЖКХ.ВидДвижения КАК ВидДвижения
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ КАК бит_НачисленияПоУслугамЖКХ
	|ГДЕ
	|	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет = &ЛицевойСчет
	|	И бит_НачисленияПоУслугамЖКХ.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Период, МЕСЯЦ)
	|	И ТИПЗНАЧЕНИЯ(бит_НачисленияПоУслугамЖКХ.Регистратор) = ТИП(Документ.бит_РазовыеПоУслугамЖКХ)
	|	И бит_НачисленияПоУслугамЖКХ.УслугаЖКХ В(&МассивУслуг)";
	Выборка = Запрос.Выполнить().Выбрать();
	Первый = Истина;
	Пока Выборка.Следующий() Цикл
		ОбластьПерерасчет = МакетКвитанции.ПолучитьОбласть("ОбластьШирина|ОбластьПерерасчет");
		//ОбластьЧастьЦентрНижняяЧасть4 = мМакет.ПолучитьОбласть("Область16|Область8");
		//ОбластьЧастьЦентрНижняяЧасть4.Параметры.Перерасчет = Строка.Основание + " (" + Строка(Строка.Услуга) + " " + Строка(Строка.Сумма) + " руб.)";
		Если Первый Тогда
			ОбластьПерерасчет.Параметры.Причина = "Причина и сумма перерасчета";
			Первый = Ложь;
		КонецЕсли;
		ОбластьПерерасчет.Параметры.Перерасчет = СТрока(Выборка.Основание) + ": " + Строка(Выборка.Сумма) + " р. " + " ("+ Строка(Выборка.Услуга) + ").";
		МакетКапРемонт.Вывести(ОбластьПерерасчет);
	КонецЦикла;
	
	Возврат МакетКапРемонт;
	
КонецФункции


Функция КвитанцияКапРемонтМуниципальная()
	
	УслугаМинВзнос = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");
	УслугаДопВзнос = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000014");
	УслугаРФКР     = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000009");
	МакетКапРемонт = Новый ТабличныйДокумент;
	МакетКапРемонт.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	МакетКвитанции = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("лб_МакетКапРемонт");
	ОбластьКвитанции = МакетКвитанции.ПолучитьОбласть("ОбластьШирина|ОбластьВысота");
	//Формирование кодов почты. 10 знак - первый и второй символы кода капитального ремонта.
	ЗапросКода = Новый Запрос;
	ЗапросКода.УстановитьПараметр("Здание",МструктураДанных.КвартираСсылка.Владелец);
	ЗапросКода.Текст = 
	"ВЫБРАТЬ
	|	лб_Тест_Дома.ВладелецСчетаКР КАК Организация,
	|	лб_Тест_Дома.KR_KOD КАК КодКапРемонта,
	|	лб_Тест_Дома.KR_RS КАК РасчетныйСчет,
	|	лб_Тест_Дома.ЛицевойСчетКР КАК РасчетныйСчетСсылка
	|ИЗ
	|	РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
	|ГДЕ
	|	лб_Тест_Дома.Здание = &Здание";
	РезультатЗапроса = ЗапросКода.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаЗапроса = РезультатЗапроса.Выгрузить();
		
		Если ЗначениеЗаполнено(ВыборкаЗапроса[0].РасчетныйСчетСсылка) Тогда
			РасчетныйСчетСсылка = ВыборкаЗапроса[0].РасчетныйСчетСсылка;
		Иначе
			Возврат МакетКапРемонт; 
		КонецЕсли;
		ПолучательПлатежа   = ВыборкаЗапроса[0].Организация;
		РасчетныйСчет       = ВыборкаЗапроса[0].РасчетныйСчет;
		Если (СокрЛП(ВыборкаЗапроса[0].КодКапРемонта) <> "") И (ВыборкаЗапроса[0].КодКапРемонта <> Неопределено) Тогда
			Код1 = Лев(СокрЛП(ВыборкаЗапроса[0].КодКапРемонта),1);
			Код2 = Сред(СокрЛП(ВыборкаЗапроса[0].КодКапРемонта),2,1);
		Иначе
			Код1 = 0;
			Код2 = 0;
		КонецЕсли;
		
	Иначе 
		Возврат МакетКапРемонт;
		//ПолучательПлатежа = мСтруктураДанных.ПолучательПредставление;
		//РасчетныйСчет     = мСтруктураДанных.ПолучательРС;
		//Код1 = 0;
		//Код2 = 0;
	КонецЕсли;

	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") И НЕ ЗначениеЗаполнено(РасчетныйСчетСсылка) Тогда
		РасчетныйСчетСсылка = ПолучательПлатежа.ОсновнойБанковскийСчет;		
	КонецЕсли;	
		
	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") Тогда
		ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Истина,РасчетныйСчетСсылка).Выгрузить();
	Иначе
		ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Ложь,РасчетныйСчетСсылка).Выгрузить();
	КонецЕсли;
	
	КонтрольныйРазрядКод1 = (3*(1 + (Код1*3)))%10;
	КонтрольныйРазрядКод2 = (3*(1 + (Код2*3)))%10;
	КодПочты1 = "01000000" + Код1 + "0" + КонтрольныйРазрядКод1; 
	КодПочты1СРазделителем = "01'000'000'" + Код1 + "0" + КонтрольныйРазрядКод1; 
	КодПочты2 = "00001000" + Код2 + "0" + КонтрольныйРазрядКод2; 
	КодПочты2СРазделителем = "00'001'000'" + Код2 + "0" + КонтрольныйРазрядКод2; 
	// Штрихкод - Лицевой счет 11 знаков, дата формата ММГГ, Коды почты без контрольного разряда 10\10 и девять нулей.
	Штрихкод = мСтруктураДанных.ЛицевойСчетНомер + мСтруктураДанных.ПериодМесяц + Прав(мСтруктураДанных.ПериодГод, 2) +	Лев(КодПочты1, 10) + Лев(КодПочты2, 10) +	"000000000";
	Сумма = 0;
	Для Счетчик = 1 По (СтрДлина(Штрихкод)/2) Цикл
		ДвухзначноеЧисло = Сред(Штрихкод,Счетчик*2-1,2);		
		Сумма = Сумма + ДвухзначноеЧисло * Счетчик;
	КонецЦикла;
	РезультатРасчета = Сумма + 105;
	КонтрольныйРазрядШтрихкода = РезультатРасчета%103;
	//Контрольный разряд для штрихкода.
	//44 цифры разбиваются попарно. Первая пара умножается на 1, вторая на 2 и т.д. Результат суммируется.
	//К полученному результату придавляем 105 и находим остаток от деления на 103.
	ЗначениеШтрихкода = Штрихкод + Строка(КонтрольныйРазрядШтрихкода);
	//Формирование Штрихкода
	Эталон = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("Эталон");
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;	
	Попытка
		Рисунок = ОбластьКвитанции.Рисунки.D1;
	Исключение
	КонецПопытки;	
	Попытка		
		ПараметрыШтрихкода = Новый Структура;
