
#Область ПеременныеМодуля

&НаКлиенте
Перем мПлатежныеСистемы; // Хранит список платежных систем.

&НаКлиенте
Перем мСписокКодировок;  // Хранит список кодировок.

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	Элементы.СтраницыОтбор.Видимость = (Объект.ЛицевыеСчета = "По выбору");
	
	Элементы.ВидОперации.Доступность = ЗначениеЗаполнено(Объект.Организация);
	
	Элементы.РабочаяПанель.Видимость = Истина;
	
	НайденныйЭлемент = Элементы.ВидОперации.СписокВыбора.НайтиПоЗначению("Загрузка");
	Если НайденныйЭлемент = Неопределено Тогда
		Элементы.ВидОперации.СписокВыбора.Добавить("Загрузка","Загрузка");
	КонецЕсли;
	
	Элементы.РабочаяПанель.ТекущаяСтраница = Элементы.Выгрузка;
	
	Элементы.ГруппаВыводИнформации.Видимость = Истина;
	
	Объект.Вручную = Ложь;
	
КонецПроцедуры

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Перечисления.
	КэшПеречисления = Новый Структура;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Объект.НомерФайла = 0 Тогда
		Объект.НомерФайла = 1;
	КонецЕсли;	  
	
	Объект.Дата = Формат(ТекущаяДата(),"ДФ=ггггММдд");
	
	Если  Объект.сг_ИмяФайлаВыгрузки = "" Тогда
		
		Объект.сг_ИмяФайлаВыгрузки = "C:\";
		
	КонецЕсли;	
	
	Объект.ВыводИнформации = "С разбивкой по услугам";
	Объект.ВводИнформации  = "С разбивкой по услугам";
	Объект.Вручную         = Ложь;
	
	Если НЕ ЗначениеЗаполнено(сг_СимволРазделения) Тогда
		
		сг_СимволРазделения = "|";
		
	КонецЕсли;
	
	сг_ИмяЛСВФайле = Элементы.сг_ВыгружатьЛС.СписокВыбора[0].Значение;
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	УправлениеЭлементамиФормы();
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	Массив.Добавить(Тип("Число"));
	Массив.Добавить(Тип("Дата"));
	
	КЧ = Новый КвалификаторыЧисла(15,2);
	КС = Новый КвалификаторыСтроки(100);
	КД = Новый КвалификаторыДаты();
	
	Элементы.УсловиеОтбора.СписокВыбора.Добавить(ВидСравнения.ВСписке);
	Элементы.УсловиеОтбора.СписокВыбора.Добавить(ВидСравнения.НеВСписке);
	
	УсловиеОтбора = ВидСравнения.ВСписке;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.СтраницыОтбор.Видимость = (Объект.ЛицевыеСчета = "По выбору");
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЛицевыеСчетаПриИзменении(Элемент)
	
	Элементы.СтраницыОтбор.Видимость = (Объект.ЛицевыеСчета = "По выбору");
	
КонецПроцедуры

&НаКлиенте
Процедура сг_ИмяФайлаВыгрузкиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Заголовок               = "Выберите файл";
	ДиалогВыбораФайла.ПредварительныйПросмотр = Ложь;
	ДиалогВыбораФайла.ИндексФильтра           = 0;
	ДиалогВыбораФайла.ПолноеИмяФайла          = Объект.сг_ИмяФайлаВыгрузки;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		Объект.сг_ИмяФайлаВыгрузки = ДиалогВыбораФайла.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура сг_ИмяФайлаВыгрузкиОткрытие(Элемент, СтандартнаяОбработка)
	
	ЗапуститьПриложение(Объект.сг_ИмяФайлаВыгрузки);
	СтандартнаяОбработка = ЛОЖЬ;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЛицевыхСчетовЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Объект.Организация);
	
	ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Объект.ПодразделениеОрганизации = ПредопределенноеЗначение("Справочник.бит_ПодразделенияОрганизаций.ПустаяСсылка");
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтборЛицевыхСчетовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ОбработатьВыбранныеЗначения(ВыбранноеЗначение);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеОрганизацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ссылка",Объект.Организация);
	
	ОткрытьФорму("Справочник.бит_ПодразделенияОрганизаций.Форма.ФормаВыбораУправляемая",Новый Структура("ОткрытьИзОбработкиВыгрузкаКазань",ПараметрыФормы),Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура сг_НачалоПериодаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачалоМесяцаВыгрузки = НачалоМесяца(ВыбранноеЗначение);
	КонецМесяцаВыгрузки = КонецМесяца(ВыбранноеЗначение);
	
	Объект.сг_НачалоПериода = НачалоМесяцаВыгрузки;
	Объект.сг_КонецПериода = КонецМесяцаВыгрузки;
	
КонецПроцедуры

&НаКлиенте
Процедура сг_КонецПериодаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	НачалоМесяцаВыгрузки = НачалоМесяца(ВыбранноеЗначение);
	КонецМесяцаВыгрузки = КонецМесяца(ВыбранноеЗначение);
	
	Объект.сг_НачалоПериода = НачалоМесяцаВыгрузки;
	Объект.сг_КонецПериода = КонецМесяцаВыгрузки;
	
КонецПроцедуры

&НаКлиенте
Процедура НомерФайлаПриИзменении(Элемент)
	
	Если Элемент.ТекстРедактирования = "0" Тогда
		
		Объект.НомерФайла = 1;

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Номер файла должен быть больше 0");
		
	КонецЕсли;	
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура ВыбратьСтандартныйПериод(Команда)
	
	СтандартныйПериод.ДатаНачала         = Объект.сг_НачалоПериода;
	СтандартныйПериод.ДатаОкончания      = Объект.сг_КонецПериода;
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = СтандартныйПериод;
	Диалог.Показать(Новый ОписаниеОповещения("ВыбратьСтандартныйПериодЗавершение", ЭтотОбъект, Новый Структура("Диалог", Диалог)));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтандартныйПериодЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог;
	
	
	Если Период Тогда
		СтандартныйПериод = Диалог.Период;
		Объект.сг_НачалоПериода    = СтандартныйПериод.ДатаНачала;
		Объект.сг_КонецПериода     = СтандартныйПериод.ДатаОкончания;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыгрузку(Команда)
	
	Текст = Новый ТекстовыйДокумент;
	
	сгВыгрузить(Текст);
	
	Попытка
		Текст.Записать(Объект.сг_ИмяФайлаВыгрузки, КодировкаТекста[Кодировка]);
	Исключение
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(""+ ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"       , Объект.Организация);
	ПараметрыФормы.Вставить("Дата"              , Объект.сг_КонецПериода);
	ПараметрыФормы.Вставить("ОткрытоИзДокумента", Истина);
	
	ОткрытьФорму("Обработка.бит_ПодборЛицевыхСчетов.Форма", ПараметрыФормы, Элементы.ОтборЛицевыхСчетов, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура Настройка(Команда)
	
	ОткрытьФорму("Обработка.бит_ВыгрузкаКазань.Форма.ФормаНастройки",,,,,, Новый ОписаниеОповещения("НастройкаЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура сгВыгрузить(Текст)
	
	ИспользоватьНомерПолучателя = Ложь;
	НомерПолучателяПоБанку      = 0;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИспользоватьНомерПолучателяВШК", ИспользоватьНомерПолучателя);
	СтруктураПараметров.Вставить("НомерПолучателяПоБанку"        , НомерПолучателяПоБанку);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Объект.сг_КонецПериода), Объект.Организация, СтруктураПараметров);
	
	ИспользоватьНомерПолучателя = СтруктураПараметров.ИспользоватьНомерПолучателяВШК;
	НомерПолучателяПоБанку      = СтруктураПараметров.НомерПолучателяПоБанку;
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	
	ПостроительЗапроса.Параметры.Вставить("НачалоПериода", НачалоДня(Объект.сг_НачалоПериода));
	ПостроительЗапроса.Параметры.Вставить("КонецПериода" , КонецДня(Объект.сг_КонецПериода));
	ПостроительЗапроса.Параметры.Вставить("Организация"  , Объект.Организация);
	
	ПостроительЗапроса.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток) КАК НачальноеСальдо,
	|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток) КАК КонечноеСальдо,
	|	СУММА(0) КАК НачальноеСальдоПени,
	|	СУММА(0) КАК КонечноеСальдоПени
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
	|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	СУММА(0),
	|	СУММА(0),
	|	СУММА(бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.СуммаПениНачальныйОстаток),
	|	СУММА(бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.СуммаПениКонечныйОстаток)
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ЛицевойСчет.Организация = &Организация) КАК бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.ЛицевойСчет,
	|	Остатки.УслугаЖКХ,
	|	СУММА(Остатки.НачальноеСальдо) КАК НачальноеСальдо,
	|	СУММА(Остатки.КонечноеСальдо) КАК КонечноеСальдо,
	|	СУММА(Остатки.НачальноеСальдоПени) КАК НачальноеСальдоПени,
	|	СУММА(Остатки.КонечноеСальдоПени) КАК КонечноеСальдоПени
	|ПОМЕСТИТЬ ГрупОстатки
	|ИЗ
	|	Остатки КАК Остатки
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.ЛицевойСчет,
	|	Остатки.УслугаЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
	|	СУММА(ВЫБОР
	|			КОГДА НЕ бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаНачислений,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаОплаты,
	|	СУММА(0) КАК СуммаПени,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет,
	|	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ,
	|	СУММА(0),
	|	СУММА(0),
	|	СУММА(бит_НачислениеПениПоУслугамЖКХОбороты.СуммаПениОборот),
	|	0
	|ИЗ
