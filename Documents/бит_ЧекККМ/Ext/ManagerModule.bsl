// Функция ищет торговое оборудование добавленное в табличную часть КассыККМ
//
// Параметры:
//   ТипОборудования - Строка тип оборудования,				
//   КассаККМ		 - Ссылка на справочник бит_КассыККМ.
//
// Возвращаемое значение:
//   СписокОборудования   - Список значений, с перечислением ссылок на оборудование. 
//
Функция ПолучитьСписокОборудования(ТипОборудования, КассаККМ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_КассыККМПодключенноеОборудование.Оборудование КАК Ссылка,
	               |	ПодключаемоеОборудование.ИдентификаторУстройства,
	               |	ПодключаемоеОборудование.Наименование,
	               |	ПодключаемоеОборудование.Параметры,
	               |	ПодключаемоеОборудование.ДрайверОборудования
	               |ИЗ
	               |	Справочник.бит_КассыККМ.ПодключенноеОборудование КАК бит_КассыККМПодключенноеОборудование
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ПодключаемоеОборудование КАК ПодключаемоеОборудование
	               |		ПО бит_КассыККМПодключенноеОборудование.Оборудование = ПодключаемоеОборудование.Ссылка
	               |ГДЕ
	               |	бит_КассыККМПодключенноеОборудование.Ссылка = &Ссылка
	               |	И ПодключаемоеОборудование.ТипОборудования = &ТипОборудования";
	Запрос.УстановитьПараметр("Ссылка", КассаККМ);
	Запрос.УстановитьПараметр("ТипОборудования", Перечисления.ТипыПодключаемогоОборудования[ТипОборудования]);
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Перебирая выборку составляем список устройств.
	СписокОборудования = Новый Массив();
	Пока Выборка.Следующий() Цикл
		// Заполним структуру данных устройства.
		ДанныеУстройства = Новый Структура();
		ДанныеУстройства.Вставить("Ссылка"                    , Выборка.Ссылка);
		ДанныеУстройства.Вставить("ИдентификаторУстройства"   , Выборка.ИдентификаторУстройства);
		ДанныеУстройства.Вставить("Наименование"              , Выборка.Наименование);
		ДанныеУстройства.Вставить("ИдентификаторОбъекта"      , Выборка.ДрайверОборудования.ИдентификаторОбъекта);
		ДанныеУстройства.Вставить("Параметры"                 , Выборка.Параметры.Получить());
		Если ТипЗнч(ДанныеУстройства.Параметры) = Тип("Структура") Тогда
			ДанныеУстройства.Параметры.Вставить("Идентификатор", Выборка.Ссылка); 
		КонецЕсли;
		СписокОборудования.Добавить(ДанныеУстройства);
	КонецЦикла;
	
	// Возвращаем полученный массив с данными всех найденных устройств.
	Возврат СписокОборудования;
	
КонецФункции

Функция СобратьДанныеЧеков(ДокументСсылка, НомерСекции = 0, ДоговорПА, ПокупательНомер = "", ПокупательEmail = "") Экспорт
	
	МассивЧеков = Новый Массив;
	
	ТаблицаУслуг = ?(ДокументСсылка.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Продажа ИЛИ ДокументСсылка.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Возврат, "Услуги", "БиллинговыеУслуги");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Пользователь", Пользователи.ТекущийПользователь());
	Запрос.УстановитьПараметр("ДокументСсылка", ДокументСсылка);
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	ЕСТЬNULL(ФизическиеЛица.ФИО, НЕОПРЕДЕЛЕНО) КАК КассирФИО,
	|	ЕСТЬNULL(ФизическиеЛица.ИНН, НЕОПРЕДЕЛЕНО) КАК КассирИНН
	|ПОМЕСТИТЬ Кассир
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ПО Пользователи.ФизическоеЛицо = ФизическиеЛица.Ссылка
	|ГДЕ
	|	Пользователи.Ссылка = &Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЧекККМ.Организация,
	|	бит_ЧекККМ.Итого КАК СуммаДокумента,
	|	бит_ЧекККМ.Дата,
	|	бит_ЧекККМ.ВидОперации,
	|	Кассир.КассирФИО КАК Кассир,
	|	Кассир.КассирИНН
	|ИЗ
	|	Документ.бит_ЧекККМ КАК бит_ЧекККМ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Кассир КАК Кассир
	|		ПО (ИСТИНА)
	|ГДЕ
	|	бит_ЧекККМ.Ссылка = &ДокументСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	// 19.12.2018  55
	|	ЕСТЬNULL(ТаблицаУслуг.Услуга.Номенклатура.ВидСтавкиНДС, ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.БезНДС)) КАК СтавкаНДС,
	|	ТаблицаУслуг.Услуга КАК Услуга,
	|	СУММА(ТаблицаУслуг.Сумма) КАК Сумма
	|ИЗ
	|	Документ.бит_ЧекККМ.Услуги КАК ТаблицаУслуг
	|ГДЕ
	|	ТаблицаУслуг.Ссылка = &ДокументСсылка
	|
	|СГРУППИРОВАТЬ ПО
	//19.12.2018  55
	|	ЕСТЬNULL(ТаблицаУслуг.Услуга.Номенклатура.ВидСтавкиНДС, ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.БезНДС)),
	|	ТаблицаУслуг.Услуга
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.БезНДС),
	|	ЗНАЧЕНИЕ(Справочник.бит_УслугиЖКХ.Пеня),
	|	СУММА(ТаблицаПени.СуммаПени)
	|ИЗ
	|	Документ.бит_ЧекККМ.Услуги КАК ТаблицаПени
	|ГДЕ
	|	ТаблицаПени.Ссылка = &ДокументСсылка
	|
	|СГРУППИРОВАТЬ ПО
	|	ЗНАЧЕНИЕ(Перечисление.ВидыСтавокНДС.БезНДС),
	|	ЗНАЧЕНИЕ(Справочник.бит_УслугиЖКХ.Пеня)";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	РезультатШапка = РезультатЗапроса[1];
	СтруктураШапки = РезультатШапка.Выбрать();
	Если НЕ СтруктураШапки.Следующий() Тогда
		Возврат МассивЧеков;
	КонецЕсли;
	
	СведенияОбОрганизации = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(СтруктураШапки.Организация, СтруктураШапки.Дата);
	
	Если УчетнаяПолитика.ПрименяетсяУСНДоходы(СтруктураШапки.Организация, СтруктураШапки.Дата) Тогда
		НалоговыйРежим = 1;
	ИначеЕсли УчетнаяПолитика.ПрименяетсяУСНДоходыМинусРасходы(СтруктураШапки.Организация, СтруктураШапки.Дата) Тогда
		НалоговыйРежим = 2;
	Иначе
		НалоговыйРежим = 0;
	КонецЕсли;
	
	ИтогоСуммаЧеков = 0;
	
	// Шапка чека.
	ОбщиеПараметры = МенеджерОборудованияКлиентСервер.ПараметрыОперацииФискализацииЧека();
	
	ОбщиеПараметры.ТипРасчета = ?(СтруктураШапки.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Возврат ИЛИ СтруктураШапки.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.ВозвратВнешнийБиллинг,
		Перечисления.ТипыРасчетаДенежнымиСредствами.ВозвратДенежныхСредств,
		Перечисления.ТипыРасчетаДенежнымиСредствами.ПриходДенежныхСредств);
		
	ОбщиеПараметры.Электронно = Ложь;
	
	// Параметры принтера чеков ЕНВД.
	ОбщиеПараметры.НомерКассы	= "00001";
	// БИТ_ЖКХ 11.07.2017 15:17:34 Начало правки...!!!! 
	//ОбщиеПараметры.НомерЧека	= 1;
	ОбщиеПараметры.НомерЧека	= ПрефиксацияОбъектовКлиентСервер.НомерНаПечать(ДокументСсылка.Номер, Истина, Истина);
	// БИТ_ЖКХ 11.07.2017 15:17:40 Конец правки. 
	ОбщиеПараметры.НомерСмены	= 1;
	
	ОбщиеПараметры.ОрганизацияНазвание       = СведенияОбОрганизации.НаименованиеДляПечатныхФорм;
	ОбщиеПараметры.ОрганизацияИНН            = СведенияОбОрганизации.ИНН;
	ОбщиеПараметры.ОрганизацияКПП            = СведенияОбОрганизации.КПП;
	ОбщиеПараметры.АдресМагазина             = СведенияОбОрганизации.ФактическийАдрес;
	ОбщиеПараметры.КодСистемыНалогообложения = НалоговыйРежим;
	
	СписокПараметров = "Кассир, КассирИНН";
	ЗаполнитьЗначенияСвойств(ОбщиеПараметры, СтруктураШапки, СписокПараметров);
	
	ОбщиеПараметры.ПокупательНомер = ПокупательНомер;
	ОбщиеПараметры.ПокупательEmail = ПокупательEmail;
	
	// Строки чека.
	РезультатЧеки = РезультатЗапроса[2];
	ВыборкаПоСтавкамНДС = РезультатЧеки.Выбрать();

	Пока ВыборкаПоСтавкамНДС.Следующий() Цикл
		
		Если ВыборкаПоСтавкамНДС.Сумма = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Перечисления.СтавкиНДС.БезНДС.
		СтрокаПозицииЧека = МенеджерОборудованияКлиентСервер.ПараметрыФискальнойСтрокиЧека(); 
		СтрокаПозицииЧека.Наименование = Строка(ВыборкаПоСтавкамНДС.Услуга);
		СтрокаПозицииЧека.Количество   = 1;
		СтрокаПозицииЧека.Цена         = ВыборкаПоСтавкамНДС.Сумма;
		СтрокаПозицииЧека.Сумма        = ВыборкаПоСтавкамНДС.Сумма;
		СтрокаПозицииЧека.СтавкаНДС    = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(ВыборкаПоСтавкамНДС.СтавкаНДС);
		СтрокаПозицииЧека.НомерСекции  = НомерСекции;
		ОбщиеПараметры.ПозицииЧека.Добавить(СтрокаПозицииЧека);
		
		ИтогоСуммаЧеков = ИтогоСуммаЧеков + ВыборкаПоСтавкамНДС.Сумма;
				
	КонецЦикла;
	
	СтрокаОплаты = Новый Структура();
	СтрокаОплаты.Вставить("ТипОплаты", 0);
	СтрокаОплаты.Вставить("Сумма", СтруктураШапки.СуммаДокумента);
	ОбщиеПараметры.ТаблицаОплат.Добавить(СтрокаОплаты);

	МассивЧеков.Добавить(ОбщиеПараметры);
	
	Возврат МассивЧеков;
	
КонецФункции

