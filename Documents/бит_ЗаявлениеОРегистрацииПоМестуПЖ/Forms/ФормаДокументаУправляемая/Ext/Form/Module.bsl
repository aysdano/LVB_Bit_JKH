&НаСервереБезКонтекста
Функция ПолучитьДокументыПоЛицевомуСчету(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПравоустанавливающиеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.бит_ПравоустанавливающиеДокументы КАК бит_ПравоустанавливающиеДокументы
	|ГДЕ
	|	бит_ПравоустанавливающиеДокументы.бит_ЛицевойСчет = &бит_ЛицевойСчет";
	
	Запрос.УстановитьПараметр("бит_ЛицевойСчет", ЛицевойСчет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Результат = Новый Массив;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		Результат.Добавить(ВыборкаДетальныеЗаписи.Ссылка);
	КонецЦикла;
	
	Возврат Результат;	
	
КонецФункции

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	ЛицевойСчетПриИзмененииНаСервере();
	ОбновитьПравоустанавливающиеДокументы();
	//Обновляется табличная часть СнимаемыеСРег и Регистрируемое лицо документа	
	Если СнятиеСРегистрации(Объект.ВидОперации) Тогда
		ОбновитьСнимаемыхСРегистрации();
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЛицевойСчетПриИзмененииНаСервере()
	//Ограничение списка выбора правоустанавливающих документов по Лицевому счету	
	Если Не Объект.ЛицевойСчет.Пустая() Тогда				
		
		ПроживающиеПоЛС = ПолучитьПроживающихПоЛССДолей(Объект.ЛицевойСчет, Объект.Дата);
		
		Если ПроживающиеПоЛС.Количество()>0 Тогда
			Элементы.ОтветственныеЗаРегистрациюОтветственный.РежимВыбораИзСписка = Истина;
			Элементы.ОтветственныеЗаРегистрациюОтветственный.СписокВыбора.ЗагрузитьЗначения(ПроживающиеПоЛС);
		Иначе
			Элементы.ОтветственныеЗаРегистрациюОтветственный.РежимВыбораИзСписка = Ложь;
			Элементы.ОтветственныеЗаРегистрациюОтветственный.СписокВыбора.Очистить();
		КонецЕсли;
		
		мСобственники = ПолучитьВладельцаКвартирыПоЛС(Объект.ЛицевойСчет, КонецДня(Объект.Дата));
		
		//Автозаполнение ответственного по собственнику
		ТЗСобственники = Новый ТаблицаЗначений;
		ТЗСобственники.Колонки.Добавить("НомерСтроки");
		ТЗСобственники.Колонки.Добавить("Ответственный");
		
		Индекс = 0;
		
		Для Каждого Собственник Из мСобственники Цикл
			
			СтрокаТЗ = ТЗСобственники.Вставить(Индекс);
			СтрокаТЗ.НомерСтроки = Индекс;
			СтрокаТЗ.Ответственный = Собственник;
			
			Индекс = Индекс + 1;
			
		КонецЦикла;
		
		Объект.ОтветственныеЗаРегистрацию.Загрузить(ТЗСобственники);
		
		//Установка адерса лицевого счета
		ЭтаФорма.АдресЛицевойСчет = ПолучитьУлицуЛицевогоСчета(Объект.ЛицевойСчет);
		
		//Заполнение орган ФМС Куда Прибыл
		Объект.ОрганФМСКудаПрибыл = Объект.ЛицевойСчет.Здание.ПаспортнаяСлужба;
		
	КонецЕсли;
	
КонецПроцедуры
