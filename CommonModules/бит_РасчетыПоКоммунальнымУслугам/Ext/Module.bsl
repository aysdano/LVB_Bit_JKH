				Норма      = Выборка.КоличествоЕдиницПотребления;
				СверхНорма = 0; 
			иначе
				СверхНорма = Выборка.КоличествоЕдиницПотребления - Норма; 
			КонецЕсли;	
			
			НоваяСтрока.Норма         = Норма;
			НоваяСтрока.СверхНорма    = СверхНорма;
			
			НоваяСтрока.Факт           = Выборка.КоличествоЕдиницПотребления;
			НоваяСтрока.НормаЛьготы    = Норма;
			
		ИначеЕсли СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению Тогда
			
			Если Выборка.ОсновнойСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет Тогда
				
				НоваяСтрока.Норматив    = Выборка.НаЛицевойСчет * Выборка.Ставка;
				НоваяСтрока.Норма       = Выборка.НаЛицевойСчет;
				НоваяСтрока.НормаЛьготы = Выборка.НаЛицевойСчет;
				
			Иначе
				
				НоваяСтрока.Норматив    = НормаЛьготы * Выборка.Ставка;
				НоваяСтрока.Норма       = Норма;
				НоваяСтрока.НормаЛьготы = НормаЛьготы;
				
			КонецЕсли; 
			
		КонецЕсли;	
		
	КонецЦикла; 
	
	ТаблицаНорм.Сортировать("Приоритет возр");
	
