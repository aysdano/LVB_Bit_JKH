&НаСервере
Процедура РассчитатьНачисленияПениПоЛицевымСчетам(СписокЛС, ДокПени) //Экспорт 
	
	СсылкаОС = Неопределено;
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НачислятьПени"                , Ложь);
	СтруктураПараметров.Вставить("НачислятьПениСУчетомПереплаты", Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(Объект.ДатаЗакрытия, Объект.Организация, СтруктураПараметров);
	
	//ЛицевыеСчета.Очистить();
	
	Если НЕ СтруктураПараметров.НачислятьПени Тогда
		
		ШаблоСообщения = НСтр("ru='В настройках %1 от %2 начисление пени отключено.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
		ШаблоСообщения, Объект.Организация, Формат(Объект.ДатаЗакрытия, "ДФ=dd.MM.yyyy")));
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
