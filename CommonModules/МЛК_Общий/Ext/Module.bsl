#Область История_Начислений
Функция ОтправитьИсториюНачислений()
	Если Не ПроверитьЕстьЛиИнтернетСоединение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл
		Если Настройки.НеИспользоватьИнтеграцию Тогда Продолжить; КонецЕсли;
		Если НачалоДня(Настройки.ДатаПоследнейВыгрузкиПоНачислениям) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Возврат Истина;
		КонецЕсли;
		ТаблицаЛС = ПолучитьТаблицуЛицевыхСчетов(Настройки);
		
		Если ЗначениеЗаполнено(Настройки.ДатаПоследнейВыгрузкиПоНачислениям) Тогда
			ДатаС = Настройки.ДатаПоследнейВыгрузкиПоНачислениям - (60*60*24*30);
		Иначе
			ДатаС = ТекущаяДатаСеанса() - (60*60*24*365);
		КонецЕсли;
		
		Если СоздатьСобытиеНачислениеНовое(Настройки, ТаблицаЛС, ДатаС, ТекущаяДатаСеанса()) Тогда
			ОбъектНастроек = Настройки.ПолучитьОбъект();
			ОбъектНастроек.Прочитать();
			ОбъектНастроек.ДатаПоследнейВыгрузкиПоНачислениям = ТекущаяДатаСеанса();
			Попытка
				ОбъектНастроек.Записать();
			Исключение
				
			КонецПопытки;
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;	
	КонецЦикла;	
КонецФункции
