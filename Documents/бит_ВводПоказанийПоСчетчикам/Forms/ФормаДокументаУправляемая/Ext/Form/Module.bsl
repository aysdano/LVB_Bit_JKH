&НаСервере
Процедура СортироватьПоКвартиреНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
	если ПоказанияЗаполнены() = ложь тогда
	
	 ДокументОбъект.ЗаполнитьТаблицуПоказаний(истина);	
	 ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	 
	конецесли;
	
	ПодготовитьФормуНаСервере(истина);

КонецПроцедуры

функция ПоказанияЗаполнены()	
	для каждого стр из объект.ПоказанияПоСчетчикам цикл
		если стр.ТекущиеПоказания <> 0 тогда
		 возврат истина;
		конецесли;	
	конеццикла;
	
	возврат ложь;
конецфункции

