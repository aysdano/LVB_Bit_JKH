&НаКлиенте
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура УправлениеДоступностьюЭлементовФормы()
	
	Элементы.ЛицевойСчет.Доступность = ЗначениеЗаполнено(Объект.СправкаДанаДляПредоставления);
	Элементы.Проживающий.Доступность = ЗначениеЗаполнено(Объект.СправкаДанаДляПредоставления);
	
	ПоТребованию = Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.ПоТребованию");
	
	Элементы.ТаблицаПроживающих.Доступность = Объект.ИспользоватьОтборПроживающих;
	
	// +bit ISedakova 25.03.2022 #ЛТ81	
	//Элементы.ИспользоватьОтборПроживающих.Доступность = НЕ ПоТребованию;
	
	ВНотариальнуюКонтору = Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.ВНотариальнуюКонтору");
	Элементы.бит_ДатаСмерти.Доступность = ВНотариальнуюКонтору;
	
	ПоМестуПребывания = Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.бит_ПоМестуПребывания");
	
	Если ПоТребованию ИЛИ ПоМестуПребывания Тогда
		Элементы.бит_ВыводитьПаспортныеДанные.Доступность = Истина;	
	Иначе
		Элементы.бит_ВыводитьПаспортныеДанные.Доступность = Ложь;
	КонецЕсли; 
	// -bit ISedakova 25.03.2022 
	
КонецПроцедуры // () 

#КонецОбласти

