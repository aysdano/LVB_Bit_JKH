	|		КОГДА ЕСТЬNULL(ВТ_ОбщаяПлощадьКвартир.ОбщаяПлощадьКвартир, 0) = 0
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(ВТ_ОбщаяПлощадьМОП.ОбщаяПлощадьМОП, 0) * ЕСТЬNULL(ВсеЛС.ОбщаяПлощадь, 0) / ЕСТЬNULL(ВТ_ОбщаяПлощадьКвартир.ОбщаяПлощадьКвартир, 0)
	|	КОНЕЦ КАК ПлощадьНаОДН,
	|	ЕСТЬNULL(ВТ_ОбщаяПлощадьКвартир.ОбщаяПлощадьКвартир, 0) КАК ОбщаяПлощадьКвартир,
	|	ЕСТЬNULL(ВТ_ОбщаяПлощадьМОП.ОбщаяПлощадьМОП, 0) КАК ОбщаяПлощадьМОП
	|ИЗ
	|	ВсеЛС КАК ВсеЛС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МаксПериод КАК ВТ_МаксПериод
	|		ПО ВсеЛС.ЛицевойСчет = ВТ_МаксПериод.ЛицевойСчет
	|			И (ВсеЛС.Сальдо > 0)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_МинПериод КАК ВТ_МинПериод
	|		ПО ВсеЛС.ЛицевойСчет = ВТ_МинПериод.ЛицевойСчет
	|			И (ВсеЛС.Сальдо > 0)
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ТекущиеОплаты КАК ВТ_ТекущиеОплаты
	|		ПО ВсеЛС.ЛицевойСчет = ВТ_ТекущиеОплаты.ЛицевойСчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОбщаяПлощадьКвартир КАК ВТ_ОбщаяПлощадьКвартир
	|		ПО ВсеЛС.ЗданиеСсылка = ВТ_ОбщаяПлощадьКвартир.Здание
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОбщаяПлощадьМОП КАК ВТ_ОбщаяПлощадьМОП
	|		ПО ВсеЛС.ЗданиеСсылка = ВТ_ОбщаяПлощадьМОП.Здание";
	
	Возврат Текст;
	
