		                        |УПОРЯДОЧИТЬ ПО
		                        |	Период УБЫВ";
		ЗапросПрошлыеПД.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
		ЗапросПрошлыеПД.УстановитьПараметр("ФизЛицо",  Объект.РегистрируемоеЛицо);
		
		Выборка = ЗапросПрошлыеПД.Выполнить().Выбрать();
		Выборка.Следующий();//Пропускаем текущие паспортные данные
