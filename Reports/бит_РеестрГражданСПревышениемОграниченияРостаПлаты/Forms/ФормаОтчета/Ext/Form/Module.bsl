// БИТ_ЖКХ_29012014_начало_изменений
&НаСервере
Функция ПолучитьНастройкиКомпоновкиДанных()
	
	НастройкиКомпоновкиДанных = Отчет.КомпоновщикНастроек.ПолучитьНастройки();
	
	Если Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Количество() > 0 Тогда
		
		Для Каждого Элт Из Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы Цикл
			
			ЭлементОтбора = НастройкиКомпоновкиДанных.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			
			ЭлементОтбора.ЛевоеЗначение  = Элт.ЛевоеЗначение;
			ЭлементОтбора.ВидСравнения   = Элт.ВидСравнения;
			ЭлементОтбора.ПравоеЗначение = Элт.ПравоеЗначение;
			ЭлементОтбора.Использование  = Элт.Использование;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат НастройкиКомпоновкиДанных;
	
КонецФункции
// БИТ_ЖКХ_29012014_окончание_изменений

#КонецОбласти