&НаКлиенте
Процедура СписокЧленовТСЖПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущаяСтрока = Элементы.СписокЧленовТСЖ.ТекущиеДанные;
		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацииЗаявлениеТСЖ.ВступлениеВТСЖ") Тогда
			ТекущаяСтрока.ДатаВступления = Объект.Дата;
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЧленовТСЖЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Здание", ПолучитьСписокЗданийВТСЖ(Объект.Дата, Объект.ТСЖ, Объект.Организация));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая", ПараметрыФормы, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЧленовТСЖЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.СписокЧленовТСЖ.ТекущиеДанные;
	
	Если НЕ ВыбранноеЗначение = ТекущаяСтрока.ЛицевойСчет Тогда
		ТекущаяСтрока.Проживающий = Неопределено;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЧленовТСЖПроживающийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.СписокЧленовТСЖ.ТекущиеДанные;
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		ДанныеВыбора = ПолучитьСписокВладельцев(Объект.Дата, ТекущаяСтрока.ЛицевойСчет, Объект.ТСЖ, Объект.ВидОперации);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЧленовТСЖПроживающиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.СписокЧленовТСЖ.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока = Неопределено И НЕ ВыбранноеЗначение = ТекущаяСтрока.Проживающий
		И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацииЗаявлениеТСЖ.ВыходИзТСЖ") Тогда
		
		ЗаполнитьИнформациюОЧленеТСЖвСтроке(ТекущаяСтрока.ПолучитьИдентификатор(), ВыбранноеЗначение);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЧленовТСЖДатаВыходаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.СписокЧленовТСЖ.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока = Неопределено Тогда
		
		Если ТекущаяСтрока.ДатаВступления > ТекущаяСтрока.ДатаВыхода Тогда
			ТекущаяСтрока.ДатаВыхода = ?(ТекущаяСтрока.ДатаВступления < ТекущаяДата(),ТекущаяДата(), ТекущаяСтрока.ДатаВступления); 
		КонецЕсли;
		
		ТекстСообщения = НСтр("ru = 'Дата выхода из ТСЖ не может быть позже даты встпления.'");
		ТекстСообщения = бит_ОбщегоНазначенияКлиентСервер.ПолучитьТекстСообщения("Поле", "Корректность", НСтр("ru = 'ДатаВыхода'"),,,ТекстСообщения);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , Элемент.Имя);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

