&НаКлиенте
Процедура СпособыРасчетаСпособРасчетаНачалоВыбораЗавершение1(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	ВыбранныйЭлемент = ВыбранныйЭлемент1;
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		
		УдалениеРазрешено = Истина;
		
		Если ТекущиеДанные.СпособРасчета <> ВыбранныйЭлемент.Значение Тогда
			
			Отбор = Новый Структура("СпособРасчета", ТекущиеДанные.СпособРасчета); 
			Строки = Объект.СпособыРасчета.НайтиСтроки(Отбор);
			
			Если ТекущиеДанные.СпособРасчета <> ВыбранныйЭлемент.Значение Тогда
				
				Если Строки.Количество() <= 1 Тогда
					УдалениеРазрешено = ОпределитьВозможностьУдаленияСпособаРасчета(ТекущиеДанные.СпособРасчета);
				КонецЕсли;
				
				Если НЕ УдалениеРазрешено Тогда

					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Существуют документы проведенные по способу расчета <"+ТекущиеДанные.СпособРасчета+">!
					|Изменение выбранного способа расчета не возможно.";
					Сообщение.Сообщить();
					
					Возврат;
				Иначе
					Для каждого Строка Из Объект.СпособыРасчета Цикл
						
						Строка.Основной = Ложь;
						
					КонецЦикла; 
					
					ТекущиеДанные.СпособРасчета = ВыбранныйЭлемент.Значение;
					
					Объект.ОсновнойСпособРасчета = ТекущиеДанные.СпособРасчета;
					
					ТекущиеДанные.Основной          = Истина;
					
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

