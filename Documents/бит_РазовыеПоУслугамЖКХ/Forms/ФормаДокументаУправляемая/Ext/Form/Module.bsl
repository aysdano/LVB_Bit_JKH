	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоЧекуККМ") Тогда
		
		Состояние("Подключается сканер штрихкода...");	

		ОповещенияПриПодключении = Новый ОписаниеОповещения("ПодключитьСканерШКЗавершение", ЭтотОбъект, Новый Структура("Форма", ЭтаФорма));
		МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(ОповещенияПриПодключении, УникальныйИдентификатор, "СканерШтрихкода");

		
		
	КонецЕсли;
	
	// Вывести в заголовке формы вид операции и статус документа (новый, не проведен, проведен).
	УстановитьЗаголовокФормыДокумента();
	
	// Зададим имена реквизитов, подлежащих кешированию.
	мКэшРеквизитовФормы = Новый Структура;
	
	// Запомним текущие значения реквизитов формы.
	ЗаполнитьТекущиеЗначенияРеквизитовФормы();
	
	УправлениеЭлементамиФормы();
	
	ЗаполнитьОписанияФизЛиц();
	
	ЗаполнитьКолвоДнейНедопоставки();
	
	// Установить доступность формы с учетом даты запрета редактирования.	
	УстановитьДоступностьФормыДляРедактированияНаСервере();
	
	ИнтерфейсТакси = ТекущийВариантИнтерфейсаКлиентскогоПриложения() = ВариантИнтерфейсаКлиентскогоПриложения.Такси;
	
	Если НЕ ИнтерфейсТакси Тогда
		
		Элементы.Группа7.Высота = 0;
		Элементы.Группа7.РастягиватьПоВертикали = Истина; 
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьСканерШКЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	СканерШтрихкода = РезультатВыполнения.Результат;
	Если СканерШтрихкода Тогда
		Состояние("Сканер штрихкода подключен");
	Иначе
		Состояние("Сканер штрихкода не подключен");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	
	Если СканерШтрихкода Тогда
		ТипыПО = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("СканерШтрихкода");
		ОповещенияПриПодключении = Новый ОписаниеОповещения("ОтключитьСканерШКЗавершение", ЭтотОбъект, Новый Структура("Форма", ЭтаФорма));
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПоТипу(ОповещенияПриПодключении, УникальныйИдентификатор, ТипыПО);
	КонецЕсли;
	
	Оповестить("ИзменениеУслугПоЛС",Объект.ЛицевойСчет,ТипЗнч(Объект.Ссылка));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если НЕ (ИсточникВыбора.ИмяФормы = "Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая"
		ИЛИ ИсточникВыбора.ИмяФормы = "Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая1"
		ИЛИ ИсточникВыбора.ИмяФормы = "Документ.бит_РазовыеПоУслугамЖКХ.Форма.ФормаФизЛицУправляемая") Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая"
		ИЛИ ИсточникВыбора.ИмяФормы = "Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая1" Тогда
		
		ТаблицаЛСНаСервере(ВыбранноеЗначение.АдресЛСВХранилище);
				
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Документ.бит_РазовыеПоУслугамЖКХ.Форма.ФормаФизЛицУправляемая" Тогда
		
		Отбор = Новый Структура;
		
		ТаблицаФизЛиц = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресФизЛицВХранилище);
		
		Для каждого Строка Из ТаблицаФизЛиц Цикл
			
			Отбор.Вставить("ФизЛицо"    , Строка.ФизЛицо);
			
			СтрокиПоиска = Объект.ФизЛица.НайтиСтроки(Отбор);
			
			Если СтрокиПоиска.Количество() > 0 Тогда
				
				Отбор.Удалить("ФизЛицо");
				
				Продолжить;
				
			КонецЕсли; 
			
			НоваяСтрока = Объект.ФизЛица.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
			Отбор.Удалить("ФизЛицо");
			
		КонецЦикла;
		
		ЗаполнитьОписанияФизЛиц();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ТаблицаЛСНаСервере(АдресЛСВХранилище)
	
	Отбор = Новый Структура;
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(АдресЛСВХранилище);
	
	Для каждого Строка Из ТаблицаЛС Цикл
		
		Отбор.Вставить("Услуга"     , Строка.Услуга);
		Отбор.Вставить("ЛицевойСчет", Строка.ЛицевойСчет);
		
		СтрокиПоиска = Объект.СписокУслуг.НайтиСтроки(Отбор);
		
		Если СтрокиПоиска.Количество() > 0 Тогда
			
			Отбор.Удалить("Услуга");
			Отбор.Удалить("ЛицевойСчет");
			
			Продолжить;
			
		КонецЕсли; 
		
		НоваяСтрока = Объект.СписокУслуг.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		Отбор.Удалить("Услуга");
		Отбор.Удалить("ЛицевойСчет");
		
	КонецЦикла;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеФизЛиц" Тогда
		
		ЗаполнитьОписанияФизЛиц();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Событие = "Штрихкод" Тогда
		
		
		Попытка
			
			Массив = МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам(,,МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента());
			
			Для Каждого Стр из Массив Цикл
				Если Стр.ТипОборудования=ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.СканерШтрихкода") Тогда
					Результат = бит_ОбработатьСобытиеСШК(Объект, Данные);
					
				КонецЕсли;
			КонецЦикла;
			
		Исключение
			
		КонецПопытки;		
		  
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ЧекККМ) Тогда
		
		Отмена = Ложь;
		
		Отмена2 = ПроверитьЧекНаСтроно(Объект.ЧекККМ, Отмена);
		
		Если НЕ Отмена2 Тогда
			
			ЗаполнитьПоЧекуНаСервере();
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьСканерШКЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'При отключении оборудования произошла ошибка: ""%1"".'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		СканерШтрихкода = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если СканерШтрихкода И ЗавершениеРаботы Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура НастройкаПериода(Команда)
	
	Период = Новый СтандартныйПериод;
	
	Период.ДатаНачала    = Объект.НачПериода;
	Период.ДатаОкончания = Объект.КонПериода;
	
	ДиалогРедактированияПериода = Новый ДиалогРедактированияСтандартногоПериода;
	
	ДиалогРедактированияПериода.Период = Период;
	
	ДиалогРедактированияПериода.Показать(Новый ОписаниеОповещения("НастройкаПериодаЗавершение", ЭтотОбъект, Новый Структура("ДиалогРедактированияПериода", ДиалогРедактированияПериода)));
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПериодаЗавершение(Период1, ДополнительныеПараметры) Экспорт
	
	ДиалогРедактированияПериода = ДополнительныеПараметры.ДиалогРедактированияПериода;
	
	Если ЗначениеЗаполнено(Период1) Тогда
		
		мДатаНачала    = ДиалогРедактированияПериода.Период.ДатаНачала;
		мДатаОкончания = ДиалогРедактированияПериода.Период.ДатаОкончания;
		
		Объект.НачПериода = мДатаНачала;
		Объект.КонПериода = мДатаОкончания;
		
	КонецЕсли;
	
	ЗаполнитьКолвоДнейНедопоставки();
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Организация"       , Объект.Организация);
	ПараметрыФормы.Вставить("Дата"              , Объект.Дата);
	ПараметрыФормы.Вставить("ОткрытоИзДокумента", Истина);
	
	ОткрытьФорму("Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая1", ПараметрыФормы, ЭтаФорма, Этаформа);
	
КонецПроцедуры

&НаКлиенте
Процедура Рассчитать(Команда)

	 //Михайлов 03.02.2021
	//Штатные проверки табличной части документа 
	Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое")
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое") 
		// БИТ ЖКх 10.03.2020
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды") 
		// БИТ ЖКх 12.03.2020
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетСтраховыхДобровольныхВзносов") 
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое") 
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое") 
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПереносОстатков") 
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавки") 
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетВСвязиСИзменениемПлощади") 
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетПоЕдиницамПотребления")
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавкиЗаменаСтавки")
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетПоЕдиницамПотребленияГрупповое")
		И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ГрупповыеПерерасчетыОДН") Тогда
		
		Для каждого Строка из Объект.СписокУслуг Цикл 
			
			Структура = Новый Структура;
			Структура.Вставить("Услуга",Строка.Услуга);
			
			НайденныеСтроки = Объект.СписокУслуг.НайтиСтроки(Структура);
			
			КоличествоЭлементов = НайденныеСтроки.Количество();
			
			Если КоличествоЭлементов > 1 Тогда
				
				//Если Объект.ВидОперации <> ПредопределенноеЗначение("Перечисление.битВидыОперацийРазовыеПоЖКХ.ГрупповыеПерерасчетыОДН") Тогда 
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нельзя рассчитывать с одинаковыми услугами!");    
				
				КонецЕсли;
				
				Возврат;
				
			//КонецЕсли;
			
		КонецЦикла;	
		
	Иначе
		Если не Объект.списокУслуг.количество() = 0 Тогда
			НеВозможностьРасчета = ОпределитьВозможностьРасчетаНаСервере();
			
			Если НеВозможностьРасчета Тогда
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нельзя рассчитывать с одинаковыми услугами!");
				Возврат;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	//Конец штатных проверок
	
	
	//бит +
	//Михайлов Начало Работ
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавки") Тогда
		    
	    Массив = ПерерасчетРанееПрименяемойСтавкиНаСервере();
		 		                   		
		ТекущаяСтрока = Элементы.СписокУслуг.ТекущиеДанные;
		
		Для Каждого ТекущаяСтрока Из Объект.СписокУслуг Цикл
		ТекущаяСтрока.Объем = 0;
		ТекущаяСтрока.Сумма = 0;
		ТекущаяСтрока.Услуга = объект.Услуга;
		КонецЦикла;
		Для Каждого ТекущаяСтрока Из Объект.СписокУслуг Цикл
			НомерЛС = ТекущаяСтрока.ЛицевойСчет;
			    Для Индекс = 0 По Массив.Количество() - 1 Цикл
					если Массив[Индекс]=НомерЛС ТОгда
					ТекущаяСтрока.Сумма = ТекущаяСтрока.Сумма + Массив[Индекс+2];
					КонецЕсли;
                КонецЦикла;  	
		КонецЦикла;
			Для Каждого ТкущаяСтрока из Объект.ЛицевыеСчета Цикл
				Для Индекс = 0 По Массив.Количество() - 1 Цикл
									
				    ТекущаяСтрока.ЛицевойСЧет = Массив[Индекс];
					Индекс = Индекс + 2;
                КонецЦикла;
			КонецЦикла;
	
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетВСвязиСИзменениемПлощади") Тогда	
		
		Массив = ПерерасчетИзЗаИзмененияПлощадиНаСервере();
		
		Объект.СписокУслуг.Очистить();
		РазмерМассива = Массив.Количество()-1;
		Индекс = 0;
		Пока Индекс <=РазмерМассива Цикл
			СтрокаТЧ = Объект.СписокУслуг.Добавить();
			СтрокаТЧ.Услуга = Массив[индекс].Услуга;
			СтрокаТЧ.Сумма = Массив[индекс].СУмма;
			Индекс = Индекс+1;
		КонецЦикла;  	
		
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетПоЕдиницамПотребления") Тогда	
		
		Массив = ПерерасчетПоЕдиницамПотребленияНаСервере();
		Объект.СписокУслуг.Очистить();
		Если Массив.Количество()=0 Тогда
			Сообщить ("нет данных");
		Иначе
		СтрокаТЧ = Объект.СписокУслуг.Добавить();
		СтрокаТЧ.Сумма = Массив[0].Сумма;
		СтрокаТЧ.Услуга = объект.Услуга;
		КонецЕсли;
							
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетПоЕдиницамПотребленияГрупповое") Тогда	
		
		Массив = ПерерасчетПоЕдиницамПотребленияГрупповоеНаСервере();
		
		Объект.СписокУслуг.Очистить();
		РазмерМассива = Массив.Количество()-1;
