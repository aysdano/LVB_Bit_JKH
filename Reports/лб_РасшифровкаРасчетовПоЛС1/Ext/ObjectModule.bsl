Функция СписокЗависимыхЛС(ЛС)
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("ЛС",ЛС);
	Запрос.Текст =
		 "ВЫБРАТЬ
		 |	бит_ЗависимыеЛС.ЛицевойСчетЗависимый КАК ЛС1
		 |ИЗ
		 |	РегистрСведений.бит_ЗависимыеЛС КАК бит_ЗависимыеЛС
		 |ГДЕ
		 |	бит_ЗависимыеЛС.ЛицевойСчет = &ЛС";
	СписокЛС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЛС1");
