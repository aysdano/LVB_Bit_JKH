	ВидАдреса.Добавить(Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации);
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Тип",		 Перечисления.ТипыКонтактнойИнформации.Адрес);
