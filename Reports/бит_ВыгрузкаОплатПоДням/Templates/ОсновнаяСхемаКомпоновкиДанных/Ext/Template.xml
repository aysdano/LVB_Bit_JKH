		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ КАК Услуга,
	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор КАК Ссылка,
	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодДень КАК Период,
	СУММА(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаРасход) КАК Сумма,
	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор.лб_ВидОплаты, ЗНАЧЕНИЕ(Справочник.лб_ВидыОплат.ОплатаЖильцов)) КАК VID,
	СУММА(0) КАК СуммаПени,
	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет КАК ЛицевойСчет
ПОМЕСТИТЬ ВТ_Данные
ИЗ
	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
			,
			,
			Авто,
			Организация = &amp;Организация
				И УслугаЖКХ В (&amp;Начисления)
				И 1 = 1
				И ЛицевойСчет.Здание.Район В (&amp;Участки)) КАК бит_НачисленияПоУслугамЖКХПоПериодуОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(, ) КАК бит_СведенияОКвартиреСрезПоследних
		ПО бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
ГДЕ
	НЕ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
				ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РасчетПредельногоИндекса
				ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РасчетПредельногоИндексаОбщедомовыхЗатрат
				ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
				ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам)
	И ВЫБОР
			КОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
					ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
					ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.ОперацияБух
				ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор.лб_ВидОплаты В (&amp;ВидыОплаты)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодДень,
	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор,
	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ,
	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор.лб_ВидОплаты, ЗНАЧЕНИЕ(Справочник.лб_ВидыОплат.ОплатаЖильцов)),
	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ РАЗЛИЧНЫЕ
	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ,
	бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор,
	бит_НачислениеПениПоУслугамЖКХОбороты.ПериодДень,
	СУММА(0),
	ЕСТЬNULL(бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор.лб_ВидОплаты, ЗНАЧЕНИЕ(Справочник.лб_ВидыОплат.ОплатаЖильцов)),
	СУММА(бит_НачислениеПениПоУслугамЖКХОбороты.СуммаПениРасход),
	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет
ИЗ
	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Обороты(
			,
			,
			Авто,
			Организация = &amp;Организация
				И УслугаЖКХ В (&amp;Начисления)
				И 1 = 1
				И ЛицевойСчет.Здание.Район В (&amp;Участки)) КАК бит_НачислениеПениПоУслугамЖКХОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(, ) КАК бит_СведенияОКвартиреСрезПоследних
		ПО бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
ГДЕ
	ВЫБОР
			КОГДА бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
					ИЛИ бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
					ИЛИ бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ВводНачальныхОстатковПениПоКУ
				ТОГДА бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор.лб_ВидОплаты В (&amp;ВидыОплаты)
			ИНАЧЕ ИСТИНА
		КОНЕЦ

СГРУППИРОВАТЬ ПО
	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ,
	бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор,
	бит_НачислениеПениПоУслугамЖКХОбороты.ПериодДень,
	ЕСТЬNULL(бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор.лб_ВидОплаты, ЗНАЧЕНИЕ(Справочник.лб_ВидыОплат.ОплатаЖильцов)),
	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет
;

