// Процедура - обработчик события "Нажатие" на кнопку "ВвестиПоказания" кнопки "ВвечтиПоказания" коммандной панели "Счетчики".
// Вставлено: 22.04.2009.	
//
&НаКлиенте
Процедура ВвестиПоказания(Команда)
	ТекДанные = Элементы.ТаблицаСчетчиков.ТекущиеДанные;
	
	Если ТекДанные = Неопределено Тогда 

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нет установленных счетчиков!");
		
		Возврат;
	Иначе
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Дата"              , ТекущаяДата());
		ПараметрыФормы.Вставить("ЛицевойСчет"       , Объект.Ссылка);
		ПараметрыФормы.Вставить("Улица"             , Объект.УлицаЛицевогоСчета);
		ПараметрыФормы.Вставить("Дом"               , Объект.Здание);
		ПараметрыФормы.Вставить("ТипСчетчика"       , ПредопределенноеЗначение("Перечисление.бит_ТипСчетчика.Индивидуальный"));
		ПараметрыФормы.Вставить("ВидОперации"       , ПредопределенноеЗначение("Перечисление.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний"));
		ПараметрыФормы.Вставить("ПоказанияНаселения", Истина);
		
		ОткрытьФорму("Документ.бит_ВводПоказанийПоСчетчикам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзСправочникаЛицевыеСчета", ПараметрыФормы), ЭтаФорма);
	КонецЕсли;
КонецПроцедуры

