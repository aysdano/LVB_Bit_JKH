	Если ТипЗнч(Значение) = Тип("ДанныеФормыКоллекция") Тогда
	
		Значение = ДанныеФормыВЗначение(Значение, Тип("ТаблицаЗначений"));
	
	КонецЕсли; 

	ХранилищеНастроекДанныхФорм.Сохранить(ИдентификаторОбработки, Имя, Значение);

