функция НайтиФактическийАдрес (ЛС)
	
  // БИТ ЖКХ 30.09.2020	
  если ЛС.Здание.Корпус <> "" тогда
	возврат строка(ЛС.УлицаЛицевогоСчета) + ", " + строка(ЛС.Здание) +
