&НаСервере
Процедура ОбновитьДерево()
	
	Корень = ДеревоДокументов.ПолучитьЭлементы();
	
	Корень.Очистить();
	
	СтрокаКорня = Корень.Добавить();
	СтрокаКорня.Документ  = "Документы начисления пени по лицевым счетам";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ДатаНачала" , НачалоМесяца(ДатаЗакрытия));
	Запрос.УстановитьПараметр("ДатаКонец"  , КонецМесяца(ДатаЗакрытия));
	
	// БИТ_ЖКХ 04.07.2014
	Запрос.УстановитьПараметр("Основание"  , ПредопределенноеЗначение("Документ.бит_ОплатаКУ.ПустаяСсылка"));
	// БИТ_ЖКХ 04.07.2014
	
	Текст = 
	"ВЫБРАТЬ
	|	Документы.Ссылка,
	|	Документы.Проведен,
	|	Документы.ПометкаУдаления,
	|	Документы.Улица,
	|	Документы.ДокОснование,
	|	Документы.СписокЛицевыхСчетов
	|ИЗ
	|	Документ.бит_НачислениеПениПоЛицевымСчетам КАК Документы
	|ГДЕ
	|	Документы.Организация = &Организация
	|	И Документы.Дата МЕЖДУ &ДатаНачала И &ДатаКонец
	|	И Документы.ДокОснование = &Основание";
	
	Для каждого СтрокаТаблицы Из Корень Цикл
		
		СтрокаЗамены = "";
		
		Если СтрокаТаблицы.Документ  = "Документы начисления пени по лицевым счетам" Тогда
			
			СтрокаЗамены = "бит_НачислениеПениПоЛицевымСчетам";
			
		КонецЕсли;
		
		Если СтрокаЗамены = "" Тогда
			Возврат;
		КонецЕсли; 
		
		ТекстЗапроса = СтрЗаменить(Текст, "бит_НачислениеПениПоЛицевымСчетам", СтрокаЗамены);
		Запрос.Текст = ТекстЗапроса;
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ВторойУровень = СтрокаТаблицы.ПолучитьЭлементы();
			
			НоваяСтрока = ВторойУровень.Добавить();
			НоваяСтрока.Документ = Выборка.Ссылка;
			
			НоваяСтрока.Улица = "ул. " + Выборка.Улица;
			
			НоваяСтрока.ДокументОснование = Выборка.ДокОснование;
			НоваяСтрока.СписокЛицевыхСчетов = Выборка.СписокЛицевыхСчетов;
			
			Если Выборка.ПометкаУдаления Тогда
				
				НоваяСтрока.Картинка = БиблиотекаКартинок.ДокументПомеченНаУдалениеКоннекторВерх;
				
			ИначеЕсли Выборка.Проведен Тогда
				
				НоваяСтрока.Картинка = БиблиотекаКартинок.ДокументПроведенКоннекторВерх;
				
			Иначе
				
				НоваяСтрока.Картинка = БиблиотекаКартинок.ДокументЗаписанКоннекторВерх;
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЦикла; 
	
	Элементы.ТаблицаДокументовРеализации.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
		
		СтандартнаяОбработка = Ложь;
		
		#Если ТолстыйКлиентОбычноеПриложение Тогда
			
			МетаданныеДокумента = ТекущаяСтрока.Документ.Метаданные();
			
			ПараметрыФормы = Новый Структура;
			ПараметрыФормы.Вставить("Ключ", ТекущаяСтрока.Документ);
			
			Форма = ПолучитьФорму("Документ."+МетаданныеДокумента.Имя+".Форма.ФормаДокумента", ПараметрыФормы);
			
			Если ТипЗнч(Форма) = Тип("УправляемаяФорма") Тогда
				
				Форма.Открыть();
				
			Иначе
				
				Форма = ТекущаяСтрока.Документ.ПолучитьФорму();
				Форма.Открыть();
				
			КонецЕсли; 
			
		#КонецЕсли 
		
		// БИТ_ЖКХ 17.04.2014
		МетаданныеДокументаИмя = МетаданныеДокументаНаСервере(ТекущаяСтрока.Документ);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ", ТекущаяСтрока.Документ);
		Попытка
			ОткрытьФорму("Документ."+МетаданныеДокументаИмя+".Форма.ФормаДокументаУправляемая", ПараметрыФормы);
		Исключение
			ОткрытьФорму("Документ."+МетаданныеДокументаИмя+".Форма.ФормаДокумента", ПараметрыФормы);
			
		КонецПопытки;
		// БИТ_ЖКХ 17.04.2014
		
	КонецЕсли; 
	
КонецПроцедуры

