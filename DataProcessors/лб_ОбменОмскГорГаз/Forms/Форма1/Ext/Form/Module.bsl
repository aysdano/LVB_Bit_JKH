	Объект.Период = ТекущаяДата();
	Объект.Организация = Справочники.Организации.НайтиПоНаименованию("Наша организация");
	Объект.Поставщик = Справочники.бит_ПоставщикиУслуг.НайтиПоНаименованию("ГорГаз");
	Объект.Услуга = Справочники.бит_УслугиЖКХ.НайтиПоНаименованию("ГорГаз");
	Объект.РежимНеНачислять = Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию("Не начислять");
	Объект.РежимДляСчетчиков = Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию("По счетчикам (Горгаз)");
	Объект.РежимДляНормативаПоУмолчанию = Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию("По нормативам (ГорГаз)");
	Объект.РежимДляНорматива2 = Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию("Режим номер 2");
	Объект.РежимДляНорматива3 = Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию("Режим номер 3");
	Объект.РазмерНорматива2 = 5;
	Объект.РазмерНорматива3 = 6;
КонецПроцедуры

