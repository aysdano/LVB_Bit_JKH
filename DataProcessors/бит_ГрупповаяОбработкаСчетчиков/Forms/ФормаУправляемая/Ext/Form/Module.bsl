
#Область ПроцедурыИФункцииУправленияВнешнимВидомФорм

// Процедура управляет свойствами элементов формы.
//
&НаСервере
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ВидСравненияСтатусКвартиры.Доступность  = ИспользоватьОтборСтатусКвартиры;
	Элементы.ВидСравненияТипКвартиры.Доступность     = ИспользоватьОтборТипКвартиры;
	
	Элементы.СтатусКвартиры.Доступность = ИспользоватьОтборСтатусКвартиры;
	Элементы.ТипКвартиры.Доступность    = ИспользоватьОтборТипКвартиры;
	
	Элементы.НачальныйНомер.Доступность = Объект.Нумерация = "ПоПорядку"; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьНастройкиОтбораПоУмолчанию();
	
	Объект.ДатаУстановкиСчетчиков = ТекущаяДата();
	
	Объект.Нумерация            = "ПоПорядку"; 
	Объект.ТипСчетчика          = Перечисления.бит_ТипСчетчика.Индивидуальный;
	Объект.КоэффициентУмножения = 1;
	
	МассивВидыСравнений = Новый Массив;
	МассивВидыСравнений.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	МассивВидыСравнений.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	МассивВидыСравнений.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	МассивВидыСравнений.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	Для каждого ЭлементМассива Из МассивВидыСравнений Цикл
		
		Элементы.ВидСравненияСтатусКвартиры.СписокВыбора.Добавить(ЭлементМассива);
		Элементы.ВидСравненияТипКвартиры.СписокВыбора.Добавить(ЭлементМассива);
		Элементы.ВидСравненияВидСчетчика.СписокВыбора.Добавить(ЭлементМассива);
		Элементы.ВидСравненияЛицевыеСчета.СписокВыбора.Добавить(ЭлементМассива);
		Элементы.ВидСравненияСписокЗданий.СписокВыбора.Добавить(ЭлементМассива);
		
	КонецЦикла; 
	
	ВидСравненияВидСчетчика    = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияЛицевыеСчета   = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияСписокЗданий   = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияСтатусКвартиры = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияТипКвартиры    = ВидСравненияКомпоновкиДанных.Равно;
	
	Заголовок = Элементы.ЗаведениеИУстановкаСчетчиков.Заголовок;
	
	Элементы.ДеревоСчетчиковГруппаУстановкаСЧ.Видимость = Ложь;
	
	УправлениеЭлементамиФормы();
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
КонецПроцедуры

// БИТ_ЖКХ 04.02.2015{{
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ИнтерфейсТакси = ТекущийВариантИнтерфейсаКлиентскогоПриложения() = ВариантИнтерфейсаКлиентскогоПриложения.Такси;
	
	Если ИнтерфейсТакси Тогда
		
		Элементы.ДеревоСчетчиков.Высота = 10;
		Элементы.ДеревоСчетчиков.РастягиватьПоВертикали = Ложь; 
		
	КонецЕсли;
	
КонецПроцедуры
// БИТ_ЖКХ 04.02.2015}}

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

#Область СтраницаЗаведениеИУстановкаСчетчиков

// Процедура - обработчик события "ПриИзменении" поля ввода "УлицаЛицевогоСчета".
//
&НаКлиенте
Процедура УлицаЛицевогоСчетаПриИзменении(Элемент)
	
	Объект.Здание               = Неопределено;
	Корпус                      = "";
	
	ДеревоСчетчиков.ПолучитьЭлементы().Очистить();
	Объект.Услуги.Очистить();
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "Здание".
//
&НаКлиенте
Процедура ЗданиеПриИзменении(Элемент)

	Корпус  =   ПолучитьКорпусНаСервере(Объект.Здание);
	ДеревоСчетчиков.ПолучитьЭлементы().Очистить();
	
	Объект.Услуги.Очистить();
	
КонецПроцедуры

&НаСервере
Функция  ПолучитьКорпусНаСервере(Здание)
	
	Возврат Здание.Корпус;
	
КонецФункции	

// Процедура - обработчик события "НачалоВыбора" поля ввода "Здание".
//
&НаКлиенте
Процедура ЗданиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Улица", Объект.УлицаЛицевогоСчета);
	
	ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая",Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "Нумерация".
//
&НаКлиенте
Процедура НумерацияПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	
	Если НЕ Объект.Нумерация = "ПоПорядку" Тогда
		
		Объект.НачальныйНомер = 0;
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - обработчик события "ОкончаниеВводаТекста" поля ввода "Разрядность".
//
&НаКлиенте
Процедура РазрядностьОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	ПравильныйКод = КодСимвола("9");
	
	СтрокаМаксЗначения = бит_ОбщегоНазначения.УбитьЛишнее(Текст);
	
	Длина = СтрДлина(СтрокаМаксЗначения);
	Для Значение=1 По Длина Цикл
		КодЦифры = КодСимвола(СтрокаМаксЗначения,Значение);
		Если НЕ КодЦифры = ПравильныйКод Тогда
			Объект.Разрядность = 0;

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Введены некорректные данные. ""Максимальное значение"" может содержать только цифру ""9""!");
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаИзменениеСоставаУслугПоСчетчикам

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(ВидОперации) Тогда
		ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик");
	КонецЕсли; 
	
	ВыполнитьПроверкуПоСпискуСчетчиков();
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОперацииНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ДанныеВыбора = Новый СписокЗначений;
	ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик"));
	ДанныеВыбора.Добавить(ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.УдалитьУслугиСоСчетчика"));
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСравненияВидСчетчикаПриИзменении(Элемент)
	
	Если ВидСравненияВидСчетчика = Неопределено Тогда
		
		ВидСравненияВидСчетчика = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидыСчетчикаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МножественныйВыбор = (ВидСравненияВидСчетчика = ВидСравненияКомпоновкиДанных.ВСписке ИЛИ ВидСравненияВидСчетчика = ВидСравненияКомпоновкиДанных.НеВСписке);
	
	ОткрытьФорму("Справочник.бит_ВидыСчетчиков.Форма.ФормаВыбораУправляемая",Новый Структура("МножественныйВыбор", МножественныйВыбор),Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ВидыСчетчикаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(ВыбранноеЗначение);
		
		ВыбранноеЗначение = Список;
		
	КонецЕсли;
	
КонецПроцедуры

