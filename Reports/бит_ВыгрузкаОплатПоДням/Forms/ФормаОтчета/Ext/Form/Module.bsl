&НаКлиенте
Процедура СформироватьФайлCSV(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Отчет.Каталог) Тогда
		Сообщить("Не заполнен каталог!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Отчет.НачалоПериода) Тогда
		Сообщить("Не заполнено начало периода!");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Отчет.КонецПериода) Тогда
		Сообщить("Не заполнен конец периода!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Отчет.Организация) Тогда
		Сообщить("Не заполнена организация!");
		Возврат;
	КонецЕсли;
	
	СформироватьОтчет();
	
	СохранитьФайлНаКлиенте();
	
КонецПроцедуры

&НаСервере
Процедура СформироватьОтчет()
	
	СкомпоноватьРезультат();
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");
	Результат.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), УникальныйИдентификатор);
	
	Попытка
		УдалитьФайлы(ИмяВременногоФайла);
	Исключение
		//ОписаниеОшибки()
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура СохранитьФайлНаКлиенте()
	
	ПолноеИмяФайла = Отчет.Каталог + "\" + Формат(ТекущаяДата(),"ДФ='dd-MM-yyyy HH.mm.ss'") + ".xlsx";
	
	Если ЗначениеЗаполнено(Отчет.ИмяФайла) Тогда
		ПолноеИмяФайла = Отчет.Каталог + "\" + Отчет.ИмяФайла + ".xlsx";	
	КонецЕсли; 
	
	Попытка
		
		ПолучитьФайл(АдресВоВременномХранилище, ПолноеИмяФайла, Ложь);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Создан файл: " + ПолноеИмяФайла;
		Сообщение.Сообщить();
		
	Исключение
	    Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
КонецПроцедуры
 