		ИтогГорячееВодоснобжение  = 0;
		ИтогПлатаЗаНайм           = 0;
		ИтогЭлектроэнергия        = 0;
		ИтогТехобслуживание       = 0;
		ИтогОтопление             = 0;
		ИтогХолодноеВодоснабжение = 0;
		
		// Переменные для расчета долей. 
		ИтогОбщТО = 0;
		ИтогДопТО = 0;
		ИтогОснТО = 0;
		
		ИтогОбщОТПЛ = 0;
		ИтогДопОТПЛ = 0;
