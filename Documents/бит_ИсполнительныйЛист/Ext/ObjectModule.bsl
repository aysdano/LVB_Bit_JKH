
Процедура ОбработкаПроведения(Отказ, Режим)    
	ДелатьПроводкиПоРегистрамССуммой = Истина;

	Суммы = СуммаДолгаПоУслугеПоРешениюСуда+СуммаГоспошлиныПоРешениюСуда+СуммаПредставительскихРасходовПоРешениюСуда;
	Если Суммы = 0 тогда
		ДелатьПроводкиПоРегистрамССуммой = Ложь;
	КонецЕсли;  
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка",ЭтотОбъект.ЛицевойСчет);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Организация КАК Организация
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка = &Ссылка";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Госпошлина = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000012");
	Представительские = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000013"); 
	
	ВыборкаДетальныеЗаписи.Следующий();
	Организация = ВыборкаДетальныеЗаписи.Организация;
	
	//Организация = Справочники.Организации.НайтиПоКоду("000000001");
	
	// регистр ИсторияРаботыСДолжниками
	Движения.ИсторияРаботыСДолжниками.Записывать = Истина; 
	ПериодЗаписи = ТекущаяДата();
	Для Каждого ТекСтрокаРаботаССППоИсполнительномуЛисту Из РаботаССППоИсполнительномуЛисту Цикл
		Если ЗначениеЗаполнено(ЛицевойСчет) тогда
			Движение = Движения.ИсторияРаботыСДолжниками.Добавить();
			Движение.Период = ПериодЗаписи;
			Движение.ФизическоеЛицо = ФИОДолжника;
			Движение.ЛицевойСчет = ЛицевойСчет;
			Движение.ДатаРейда = ТекСтрокаРаботаССППоИсполнительномуЛисту.ДатаРейда;
			Движение.РезультатРейда = ТекСтрокаРаботаССППоИсполнительномуЛисту.РезультатРейда;
			Движение.ФИОПриставаИсполнителя = ТекСтрокаРаботаССППоИсполнительномуЛисту.ФИОПриставаПредставителя;   
			ПериодЗаписи = ПериодЗаписи+1;
		КонецЕсли;
		
	КонецЦикла;
	
	// регистр СтатусыПоИсполнительнымЛистам
	
	//	//+bit_semenov.v_07.02.2022
	//Процедура установки статуса размещена в модуле менеджера РегистрыСведений.СтатусыПоИсполнительнымЛистам
	
	//Запрос = Новый Запрос;
	//Запрос.Текст = "ВЫБРАТЬ
	//|	СтатусыПоИсполнительнымЛистамСрезПоследних.ИсполнительныйЛист КАК Регистратор,
	//|	СтатусыПоИсполнительнымЛистамСрезПоследних.СтатусДокумента КАК СтатусДокумента
	//|ИЗ
	//|	РегистрСведений.СтатусыПоИсполнительнымЛистам.СрезПоследних(, ИсполнительныйЛист = &Регистратор) КАК СтатусыПоИсполнительнымЛистамСрезПоследних";
	//Запрос.УстановитьПараметр("Регистратор",ЭтотОбъект.Ссылка);
	//Результат = Запрос.Выполнить().Выбрать();
	//Если Результат.Следующий() Тогда
	//	Если Результат.СтатусДокумента <> Статус Тогда
	//		Набор = РегистрыСведений.СтатусыПоИсполнительнымЛистам.СоздатьНаборЗаписей();
	//		//+bit_semenov.v_07.02.2022
	//		//Набор.Отбор.Регистратор.Установить(ЭтотОбъект.Ссылка);
	//		Набор.Отбор.ИсполнительныйЛист.Установить(ЭтотОбъект.Ссылка);
	//		//+bit_semenov.v_07.02.2022
	//		Движение = Набор.Добавить();
	//		Движение.ИсполнительныйЛист = ЭтотОбъект.Ссылка;
	//		Движение.Период = ТекущаяДата();
	//		Движение.СтатусДокумента = Статус;
	//		Набор.Записать(Ложь);
	//	КонецЕсли;
	//Иначе
	//	Набор = РегистрыСведений.СтатусыПоИсполнительнымЛистам.СоздатьНаборЗаписей();
	//	Движение = Набор.Добавить();
	//	//Движение.Регистратор = ЭтотОбъект.Ссылка;
	//	Движение.ИсполнительныйЛист = ЭтотОбъект.Ссылка;
	//	Движение.Период = ТекущаяДата();
	//	Движение.СтатусДокумента = Статус;
	//КонецЕсли;
	МассивДокументов = Новый Массив;
	МассивДокументов.Добавить(ЭтотОбъект.Ссылка);
	РегистрыСведений.СтатусыПоИсполнительнымЛистам.УстановитьСтатусыДокументов(МассивДокументов, Статус);
	//-bit_semenov.v_07.02.2022
	
	// регистр ИсторияИсполнительныхЛистов
	Движения.ИсторияИсполнительныхЛистов.Записывать = Истина;
	Движение = Движения.ИсторияИсполнительныхЛистов.Добавить();
	Движение.Период = Дата;
	Движение.ТипСудебногоДокумента = ВидДокумента;
	Движение.НомерИсполнительногоЛиста = НомерИсполнительногоЛиста;
	Движение.ДатаИсполнительногоЛиста = ДатаИсполнительногоЛиста;
	Движение.ДатаВынесенияРешенияСуда = ДатаВынесенияРешенияСуда;
	Движение.ДатаВступленияВЗаконнуюСилу = ДатаВступленияВЗаконнуюСилу;
	Движение.Услуга = Услуга;
	Движение.ФИОДолжника = ФИОДолжника;
	Движение.Адрес = ""+ЛицевойСчет.Здание +" "+ЛицевойСчет.Квартира;
	Движение.ЛицевойСчет = ЛицевойСчет;
	Движение.ПериодОбразованияЗадолженностиОт = ПериодОбразованияЗадолженностиОт;
	Движение.ПериодОбразованияЗадолженностиПо = ПериодОбразованияЗадолженностиПо;
	
