// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Перечисления.
	
	КэшированныеЗначения.Вставить("РасчетСУчетомДолейВладения"                           , Ложь);
	КэшированныеЗначения.Вставить("УменьшениеНормыЛьготыВПределахФакта"                  , Ложь);
	КэшированныеЗначения.Вставить("НачислениеСУчетомДнейПроживания"                      , Ложь);
	КэшированныеЗначения.Вставить("ОбщедомовыеРасходыВГрафеНачисления"                   , Ложь);
	КэшированныеЗначения.Вставить("СчетчикиПодкрутка"                                    , Ложь);
	КэшированныеЗначения.Вставить("ЛьготаПерсонифицированная"                            , Ложь);
	КэшированныеЗначения.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	КэшированныеЗначения.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	КэшированныеЗначения.Вставить("УчитыватьНачисленияПоГрупповымСчетчикам"              , Ложь);
	КэшированныеЗначения.Вставить("УчитыватьПерерасчет"                                  , Ложь);
	КэшированныеЗначения.Вставить("СчетАбонента"                                         , Неопределено);
	КэшированныеЗначения.Вставить("Контрагент"                                            , Неопределено);
	КэшированныеЗначения.Вставить("ФормироватьАктИРеализациюПоКонтрагенту"                , Ложь);
	КэшированныеЗначения.Вставить("ФормироватьАктИРеализациюПоКонтрагентуОтветственныхЛиц", Ложь);
	
	КэшированныеЗначения.Вставить("ДокументУчетаСобственныхУслуг", Неопределено);
	
	КэшированныеЗначения.Вставить("ПорядокРаспределенияРасходовНаОказаниеУслуг", Неопределено);
	
	КэшированныеЗначения.Вставить("ПоПлановымЦенамИВыручке", Перечисления.бит_ПорядокРаспределенияРасходовНаОказаниеУслуг.ПоПлановымЦенамИВыручке);
	
	КэшированныеЗначения.Вставить("ЗначениеДаты"                                         , Неопределено);
	
КонецПроцедуры

// Процедура выполняет загрузку настроек отбора из настроек по умолчанию.
