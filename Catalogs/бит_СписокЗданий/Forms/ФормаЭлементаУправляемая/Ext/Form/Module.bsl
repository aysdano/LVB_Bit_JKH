	|	Квартиры.ТипКвартиры = ЗНАЧЕНИЕ(Справочник.бит_ТипыКвартиры.НежилоеПомещение)";
	
	Запрос.УстановитьПараметр("Владелец", Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент"  , НаДату);
	
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписей.Количество() > 0 Тогда 
		
		НежилыеПомещения.Загрузить(ТаблицаЗаписей);
		
	КонецЕсли;
	
	НежилыеПомещения.Сортировать("НомерКвартиры Возр, ПрефиксКвартиры Возр");
	
	Модифицированность = Ложь;
	
КонецПроцедуры

