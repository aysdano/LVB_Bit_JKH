Процедура ЗаполнитьСубконтоКУПеняПоНастройкамЖКХ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
    "ВЫБРАТЬ
	|	бит_НастройкаПараметровЖКХСрезПоследних.ТранзитныйСчетОплаты КАК ТранзитныйСчетОплаты,
	|	бит_НастройкаПараметровЖКХСрезПоследних.СчетПениСУ КАК СчетПениСУ,
	|	бит_НастройкаПараметровЖКХСрезПоследних.СчетПениУСО КАК СчетПениУСО,
	|	бит_НастройкаПараметровЖКХСрезПоследних.СубконтоПениУСО1 КАК СубконтоПениУСО1,
	|	бит_НастройкаПараметровЖКХСрезПоследних.СубконтоПениУСО2 КАК СубконтоПениУСО2,
	|	бит_НастройкаПараметровЖКХСрезПоследних.СубконтоПениУСО3 КАК СубконтоПениУСО3
	|ПОМЕСТИТЬ ВТ_ТранзитныйСч
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Момент, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ТранзитныйСч.ТранзитныйСчетОплаты КАК ТранзитныйСчетОплаты,
	|	ВТ_ТранзитныйСч.СчетПениСУ КАК СчетПениСУ,
	|	ВТ_ТранзитныйСч.СчетПениУСО КАК СчетПениУСО,
	|	ВТ_ТранзитныйСч.СубконтоПениУСО1 КАК СубконтоПениУСО1
	|ИЗ
	|	ВТ_ТранзитныйСч КАК ВТ_ТранзитныйСч";
	
	ДатаЗаполнения = ?(ЗначениеЗаполнено(Объект.Дата), КонецМесяца(Объект.Дата), ТекущаяДата());
	
	Запрос.УстановитьПараметр("Момент",		  Объект.Дата);
	Запрос.УстановитьПараметр("Организация",  Объект.Организация);
	Запрос.УстановитьПараметр("ЛицевойСчет",  Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("ОплатаКУ",	  Объект.ОплатаКУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	//СоответствиеСубконтоКУ = Новый Соответствие;
	Если Выборка.Следующий() Тогда
		Для Каждого Стр Из Объект.СписокУслугПеня Цикл
			Стр.СчетКУ      = Выборка.СчетПениСУ;
			//Стр.Субконто3   = Выборка.СубконтоПениУСО1;
			Стр.СубконтоКУ1 = Выборка.СубконтоПениУСО1;
			//Стр.СубконтоКУ2 = Выборка.СубконтоКУ2;
			//Стр.СубконтоКУ3 = Неопределено;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры


