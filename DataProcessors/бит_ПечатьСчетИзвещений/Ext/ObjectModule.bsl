	////			ОбластьСправочнаяИнформацияПримечание.Параметры.Свойство = Лев(мТаблицаСвойств[0].Свойство,СтрДлина(мТаблицаСвойств[0].Свойство)-16);
	////			
	////			ОбластьСправочнаяИнформацияПримечание.Параметры.Значение = мТаблицаСвойств[0].Значение;
	////			
	////		Исключение
	////		КонецПопытки;
	////		
	////	КонецЕсли;
	////	
	////	Результат.Вывести(ОбластьСправочнаяИнформацияПримечание);
	////Исключение
	////	
	////КонецПопытки;
	
	// Обращение.
	Если ЗначениеЗаполнено(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		
		Результат.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Результат, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли; 
	
	Если ИспользоватьQR = Истина Тогда
		
		Попытка	
			ОбластьШтрихкодQR                   = мМакет.ПолучитьОбласть("ШтрихкодQR");
		Исключение
		КонецПопытки;
		
		НапечататьQRКод(Результат, ОбластьШтрихкодQR);
	Иначе
		УбратьQRКод(Результат)
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

// Процедура Заполняет параметр.
