	ЗаписатьФайлВыгрузки(СписокОперацийПоЛСXDTO, ПараметрыОбмена, "transactions.xml");
	
КонецПроцедуры

//23.05.2019
Процедура ВыгрузитьЕПД(ПараметрыОбмена, Пеня = ложь) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОбмена.Организация);
	Запрос.УстановитьПараметр("СписокУлиц"	, ПараметрыОбмена.СписокУлиц);
	Запрос.УстановитьПараметр("СписокЗданий", ПараметрыОбмена.СписокЗданий);
	Запрос.УстановитьПараметр("СписокЛС"	, ПараметрыОбмена.СписокЛС);
	
	
	если ЗначениеЗаполнено(ПараметрыОбмена.ДатаНачалаПериода) = ложь тогда
	  ПараметрыОбмена.ДатаНачалаПериода = НачалоМесяца(ТекущаяДата());	
    конецесли;
  
	если ЗначениеЗаполнено(ПараметрыОбмена.ДатаОкончанияПериода) = ложь тогда
	  ПараметрыОбмена.ДатаОкончанияПериода = КонецМесяца(ТекущаяДата());	
	конецесли;	
	
	ПериодФормирования = ПараметрыОбмена.ДатаОкончанияПериода;//ТекущаяДата();
	Запрос.УстановитьПараметр("НачалоПериода"	, НачалоМесяца(ПериодФормирования));
	Запрос.УстановитьПараметр("КонецПериода"	, КонецМесяца(ПериодФормирования));
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.Организация) Тогда
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокУлиц)
		И ПараметрыОбмена.СписокУлиц.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЗданий) 
		И ПараметрыОбмена.СписокЗданий.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЛС) 
		И ПараметрыОбмена.СписокЛС.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЛС", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЛС", Истина);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	|		ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
	|ГДЕ
	|	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И НЕ бит_СписокЗданий.ПометкаУдаления
	|	И (&НеПроверятьЛС
	|			ИЛИ бит_ЛицевыеСчета.Ссылка В (&СписокЛС))
	|	И (&НеПроверятьОрганизации
	|			ИЛИ бит_ЛицевыеСчета.Организация В (&Организация))
	|	И (&НеПроверятьУлицы
	|			ИЛИ бит_СписокЗданий.Улица В (&СписокУлиц))
	|	И (&НеПроверятьЗдания
	|			ИЛИ бит_ЛицевыеСчета.Здание В (&СписокЗданий))";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	// Подготовка обработки печати.
	ОбработкаОбъект = Обработки.бит_ПечатьСчетИзвещений.Создать();
	ОбработкаОбъект.СписокЛС.Загрузить(Результат); // Фильтрация по ЛС.
	
	//23.05.2019
	если Пеня = ложь тогда
	 ОбработкаОбъект.МакетКв               = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32;
    иначе
	 ОбработкаОбъект.МакетКв               = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокументПеня;
	конецесли; 
	ОбработкаОбъект.ШаблонИзвещений       = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
	ОбработкаОбъект.Организация           = ПараметрыОбмена.Организация;
	ОбработкаОбъект.РС                    = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОбмена.Организация, "ОсновнойБанковскийСчет");
	ОбработкаОбъект.ТекущийПакет          = 1;
	ОбработкаОбъект.РазмерПакетаПечати    = 500;
	ОбработкаОбъект.РазмерПакетаПросмотра = 50;
	ОбработкаОбъект.НеПечататьУслугиБезНачислений = Истина;
	ОбработкаОбъект.Период = КонецМесяца(ПериодФормирования);
	ОбработкаОбъект.ОбновитьНастройкиЖКХ();
	ОбработкаОбъект.ОбновитьКэшОрганизации();
	ОбработкаОбъект.ОбновитьКэшПолучателяПлатежа();
	ОбработкаОбъект.ПолучитьНастройкуМакета();
	
	// Настроййки таб. док. поумолчанию.
	ТабличнйДокумент  = Новый ТабличныйДокумент;
	ТабличнйДокумент.АвтоМасштаб = Истина;
	ТабличнйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	если Пеня = ложь тогда
	 ОбработкаОбъект.МакетКв               = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32;
    иначе
	 ОбработкаОбъект.МакетКв               = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокументПеня;
	конецесли;         
	
	// Формирование данных для макета.
	ТаблицаДанных = ОбработкаОбъект.СформироватьДанныеПечати(Истина);
	
	// Создание ОбъектаXDTO с типом СписокЕПД.
	ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "СписокЕПД");
	СписокЕПДXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
	
	Для Каждого Стр Из Результат Цикл
		
		Отбор = Новый Структура;
		//Отбор.Вставить("ВладелецЛС", Стр.ЛицевойСчет); // Без иерархии.
		Отбор.Вставить("ЛицевойСчет", Стр.ЛицевойСчет);
		ПоискЛС = ТаблицаДанных.НайтиСтроки(Отбор);
		
		Если ПоискЛС.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого СтрокаТаблицы Из ПоискЛС Цикл
			
			ТабличнйДокумент.Очистить();
			//23.05.2019
			ОбработкаОбъект.ВывестиНаПечатьКвитанцию(ТабличнйДокумент, СтрокаТаблицы, Пеня);
			
			ИмяВрФайла = ПолучитьИмяВременногоФайла("pdf");
			ТабличнйДокумент.Записать(ИмяВрФайла,ТипФайлаТабличногоДокумента.PDF);
		    //23.05.2019
//			если ПараметрыОбмена.ВыгружатьОтдельнымиФайлами = истина тогда
			если ПараметрыОбмена.ВидТранспорта = 0 тогда
			 КопироватьФайл(ИмяВрФайла, ПараметрыОбмена.КаталогВыгрузки + "\\Квитанция_" + строка(СтрокаТаблицы.ЛицевойСчет) + ".pdf");
			конецесли; 
			ДД = Новый ДвоичныеДанные(ИмяВрФайла);
			
			// Создание ОбъектаXDTO с типом ЕПД.
			ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "ЕПД");
			ЕПДXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
			
			ЕПДXDTO.Номер			= СтрокаТаблицы.Значение.СтруктураДанных.ЗначениеШтрихкода;
			ЕПДXDTO.ИдентификаторЛС	= ?(ЗначениеЗаполнено(Стр.ЛицевойСчет), Строка(Стр.ЛицевойСчет.УникальныйИдентификатор()), "");
			ЕПДXDTO.Период			= КонецМесяца(ПериодФормирования);
			Попытка
				ЕПДXDTO.Сумма		= СтрокаТаблицы.Значение.СтруктураДанных.КОплате + СтрокаТаблицы.Значение.СтруктураДанных.ПроцентОтОплаты;
				
				//3.06.2019
				если ПараметрыОбмена.УчитыватьПеня = Истина тогда
					ЕПДXDTO.Сумма  = ЕПДXDTO.Сумма + СтрокаТаблицы.Значение.СтруктураДанных.ИтогПени; 
				конецесли;

			Исключение
				ЕПДXDTO.Сумма		= 0;
			КонецПопытки;
			ЕПДXDTO.Вложение		= Base64Строка(ДД);
			
			СписокЕПДXDTO.ЕПД.Добавить(ЕПДXDTO);
			
			Попытка
				УдалитьФайлы(ИмяВрФайла);
			Исключение
			КонецПопытки;
			
		КонецЦикла;	

	КонецЦикла;

	ЗаписатьФайлВыгрузки(СписокЕПДXDTO, ПараметрыОбмена, "paydocs.xml");
	
КонецПроцедуры

Процедура Выгрузить(ПараметрыОбмена) Экспорт
	
	ВыгрузитьЗдания(ПараметрыОбмена);
	ВыгрузитьКвартиры(ПараметрыОбмена);
	ВыгрузитьЛицевыеСчета(ПараметрыОбмена);
	ВыгрузитьУслуги(ПараметрыОбмена);
	ВыгрузитьУслугиПОЛС(ПараметрыОбмена);
	ВыгрузитьСчетчики(ПараметрыОбмена);
	ВыгрузитьОперацииПоЛС(ПараметрыОбмена);
	ВыгрузитьЕПД(ПараметрыОбмена);
	
КонецПроцедуры

Процедура ЗагрузитьПоказанияСчетчиков(ПараметрыОбмена) Экспорт
	
	 Если ПараметрыОбмена.ВидТранспорта = 0 Тогда
		 ЗагрузитьПоказанияСчетчиковИзКаталога(ПараметрыОбмена);
	 ИначеЕсли	 ПараметрыОбмена.ВидТранспорта = 1 Тогда
		 ЗагрузитьПоказанияСчетчиковСFTP(ПараметрыОбмена);
	 Иначе
		 Возврат; // Интеграция по http. 
	 КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьПоказанияСчетчиковИзКаталога(ПараметрыОбмена)
	
	Если НЕ ЗначениеЗаполнено(ПараметрыОбмена.КаталогВыгрузки) Тогда
		Возврат; 
	КонецЕсли;
	
	ИмяФайла = ПараметрыОбмена.КаталогВыгрузки + ПолучитьРазделительПути() + ПараметрыОбмена.ИмяФайлаПоказаний;
	
	Ошибка = Ложь;
	ЧтениеПоказанийСчетчиков(ПараметрыОбмена, ИмяФайла, Ошибка);
	
	Если Не Ошибка Тогда
		Попытка
			УдалитьФайлы(ИмяФайла);
		Исключение
			ТекстОшибки = НСтр("ru = 'Не удалось удалить файл обмена: '");
			ТекстОшибки = ТекстОшибки + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("Обмен с сайтом, ошибка удаления прочитанного файла.", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЗагрузитьПоказанияСчетчиковСFTP(ПараметрыОбмена)
	
	// Подключение к ftp.
	ПараметрыСоединения 					= FTPНастройкиСоединения(30);
	ПараметрыСоединения.Сервер				= ПараметрыОбмена.АдресFTP;
	ПараметрыСоединения.Порт				= ПараметрыОбмена.ПортFTP;
	ПараметрыСоединения.ИмяПользователя		= ПараметрыОбмена.ЛогинFTP;
	ПараметрыСоединения.ПарольПользователя	= ПараметрыОбмена.ПарольFTP;
	ПараметрыСоединения.ПассивноеСоединение  = Истина;
	Если ПараметрыОбмена.ЗащищенноеСоединение Тогда
		ПараметрыСоединения.ЗащищенноеСоединение= Новый ЗащищенноеСоединениеOpenSSL;
	Иначе
		ПараметрыСоединения.ЗащищенноеСоединение = Неопределено;
	КонецЕсли;
	
	Попытка
		FTPСоединение = ОбменДаннымиСервер.FTPСоединение(ПараметрыСоединения);
		Если СтрДлина(ПараметрыОбмена.КаталогFTP) > 1 Тогда
			ИмяПапки = ПолучитьИмяПапки(ПараметрыОбмена.КаталогFTP);
			Если НЕ ОбменДаннымиСервер.FTPКаталогСуществует(ПараметрыОбмена.КаталогFTP, ИмяПапки, FTPСоединение) Тогда
				ТекстОшибки	= НСтр("ru = 'Соединение с свервером установлено, но каталог не найден!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = СтрШаблон(НСтр("ru = '%1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	ВременныйФайл = ПолучитьИмяВременногоФайла("xml");
	FTPСоединение.УстановитьТекущийКаталог(ПараметрыОбмена.КаталогFTP);
	FTPСоединение.Получить(ПараметрыОбмена.ИмяФайлаПоказаний, ВременныйФайл);
	
	Ошибка = Ложь;
	ЧтениеПоказанийСчетчиков(ПараметрыОбмена, ВременныйФайл, Ошибка);
	
	Если Не Ошибка Тогда
		Попытка
			УдалитьФайлы(ВременныйФайл);
			FTPСоединение.Удалить(ПараметрыОбмена.ИмяФайлаПоказаний);
		Исключение
			ТекстОшибки = НСтр("ru = 'Не удалось удалить файл обмена: '");
			ТекстОшибки = ТекстОшибки + Символы.ПС + ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
			ЗаписьЖурналаРегистрации("Обмен с сайтом, ошибка удаления прочитанного файла.", УровеньЖурналаРегистрации.Ошибка,,, ТекстОшибки);
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

Процедура ЧтениеПоказанийСчетчиков(ПараметрыОбмена, ИмяФайла, Ошибка)
	
	ЧтениеXML = Новый ЧтениеXML;
	//21.11.2018
	попытка
	 ЧтениеXML.ОткрытьФайл(ИмяФайла,,, ПараметрыОбмена.Кодировка);
    исключение
	 Сообщить("Невозможно открыть файл " + строка(ИмяФайла));
	 возврат;
	конецпопытки; 

	ОбъектXDTO = ФабрикаXDTO.ПрочитатьXML(ЧтениеXML, ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "СписокСчетчиков"));
	ЧтениеXML.Закрыть();
	
	Если ТипЗнч(ОбъектXDTO.Счетчик) = Тип("СписокXDTO") Тогда
		
		ТаблицаСчетчиков = Новый ТаблицаЗначений;
		ТаблицаСчетчиков.Колонки.Добавить("Счетчик"				, Новый ОписаниеТипов("СправочникСсылка.бит_Счетчики"));
		ТаблицаСчетчиков.Колонки.Добавить("Владелец"			, Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
		ТаблицаСчетчиков.Колонки.Добавить("Услуга"				, Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
		ТаблицаСчетчиков.Колонки.Добавить("Показания"			, ОбщегоНазначения.ОписаниеТипаЧисло(16,4));
	
		Для Каждого Счетчик Из ОбъектXDTO.Счетчик Цикл
			
			НСтрСч =ТаблицаСчетчиков.Добавить();	
			НСтрСч.Счетчик				= Справочники.бит_Счетчики.ПолучитьСсылку(Новый УникальныйИдентификатор(Счетчик.Идентификатор));
			НСтрСч.Владелец				= Справочники.бит_ЛицевыеСчета.ПолучитьСсылку(Новый УникальныйИдентификатор(Счетчик.ИдентификаторВладельца));
			НСтрСч.Услуга				= Справочники.бит_УслугиЖКХ.ПолучитьСсылку(Новый УникальныйИдентификатор(Счетчик.ИдентификаторУслуги));
			НСтрСч.Показания			= Счетчик.Показания;
		 
		КонецЦикла;
	Иначе
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСчетчиков", ТаблицаСчетчиков);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаСчетчиков.Счетчик КАК Счетчик,
	|	ТаблицаСчетчиков.Владелец КАК Владелец,
	|	ТаблицаСчетчиков.Услуга КАК Услуга,
	|	ТаблицаСчетчиков.Показания КАК Показания
	|ПОМЕСТИТЬ ВТ_Счетчики
	|ИЗ
	|	&ТаблицаСчетчиков КАК ТаблицаСчетчиков
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Счетчики.Счетчик КАК Счетчик,
	|	ВТ_Счетчики.Владелец КАК Владелец,
	|	ВТ_Счетчики.Услуга КАК Услуга,
	|	ВТ_Счетчики.Показания КАК Показания,
	|	бит_ЛицевыеСчета.Здание.Улица КАК Улица,
	|	бит_ЛицевыеСчета.Здание КАК Здание,
	|	бит_ЛицевыеСчета.Квартира КАК Квартира,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета КАК УлицаЛицевогоСчета
	|ИЗ
	|	ВТ_Счетчики КАК ВТ_Счетчики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ПО ВТ_Счетчики.Владелец = бит_ЛицевыеСчета.Ссылка
	|ИТОГИ ПО
	|	УлицаЛицевогоСчета";
	
	ВыборкаУлиц = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаУлиц.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ТекДата = ТекущаяДата();
	
	Пока ВыборкаУлиц.Следующий() Цикл
		
		ПревышениеРазрядности = Ложь;
		
		ДокументВводПоказаний					= Документы.бит_ВводПоказанийПоСчетчикам.СоздатьДокумент();
		ДокументВводПоказаний.Дата				= ТекДата;
		ДокументВводПоказаний.Организация		= ПараметрыОбмена.Организация;
		ДокументВводПоказаний.ВидОперации		= Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний;
		ДокументВводПоказаний.ТипСчетчика		= Перечисления.бит_ТипСчетчика.Индивидуальный;
		ДокументВводПоказаний.ПоказанияНаселения= Истина;
		ДокументВводПоказаний.Улица				= ВыборкаУлиц.УлицаЛицевогоСчета;
		ДокументВводПоказаний.Ответственный		= бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
		ДокументВводПоказаний.Комментарий		= "Документ создан автоматически на основании данных с сайта.";
		ДокументВводПоказаний.ПоказанияПоСчетчикам.Очистить();
		ДокументВводПоказаний.ЗаполнитьТаблицуПоказаний();
		
		Если ДокументВводПоказаний.ПоказанияПоСчетчикам.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ВыборкаЛС = ВыборкаУлиц.Выбрать();
		Пока ВыборкаЛС.Следующий() Цикл
			
			ОтборСчетчиков	= Новый Структура("ЛицевойСчет, Счетчик, Услуга", ВыборкаЛС.Владелец, ВыборкаЛС.Счетчик, ВыборкаЛС.Услуга); 
			МассивСчетчик	= ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(ОтборСчетчиков);
			
			Если МассивСчетчик.Количество() = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			Для Каждого Элт Из МассивСчетчик Цикл
				
				Элт.ТекущиеПоказания = ВыборкаЛС.Показания;
				
				// Проверка перехода через 0.
				Если Элт.ТекущиеПоказания < Элт.ПредыдущиеПоказания Тогда
					Разность = Элт.Разрядность - Элт.ПредыдущиеПоказания + 1 + Элт.ТекущиеПоказания;
				Иначе
					Разность = Элт.ТекущиеПоказания - Элт.ПредыдущиеПоказания;
				КонецЕсли;	
				
				Элт.КоличествоЕдиницПоСчетчику	= Разность;
				
				Если Элт.ТекущиеПоказания > Элт.Разрядность Тогда
					ПревышениеРазрядности = Истина;	
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЦикла; // ВыборкаЛС.
		
		// Удаление счетчиков без показаний жильцов.
		ОтборБезПоказаний	= Новый Структура("ТекущиеПоказания",0);
		СтрокиБезПоказаний	= ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(ОтборБезПоказаний);

		Если СтрокиБезПоказаний.Количество() > 0 Тогда
			Для Каждого Элт Из СтрокиБезПоказаний Цикл
				ДокументВводПоказаний.ПоказанияПоСчетчикам.Удалить(Элт);
			КонецЦикла;
		КонецЕсли;
		
		Если ДокументВводПоказаний.ПоказанияПоСчетчикам.Количество() = 0 Тогда
			 Продолжить;
		КонецЕсли;
		
		Попытка
			Если ПревышениеРазрядности Тогда
				ДокументВводПоказаний.Записать(РежимЗаписиДокумента.Запись);
			Иначе
				ДокументВводПоказаний.Записать(РежимЗаписиДокумента.Проведение);
			КонецЕсли;
			Ошибка = Ложь;
		Исключение
			Ошибка = Истина;
		КонецПопытки;
		
	КонецЦикла; // ВыборкаУлиц. 
	
КонецПроцедуры

Функция ПолучитьПараметрыОбмена(Ссылка) Экспорт
	
	СтруктуруПараметровОбмена = ПолучитьСтруктуруПараметровОбмена();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_НастройкиОбменаССайтом.Организация КАК Организация,
	|	бит_НастройкиОбменаССайтом.Кодировка КАК Кодировка,
	|	бит_НастройкиОбменаССайтом.КаталогВыгрузки КАК КаталогВыгрузки,
	|	бит_НастройкиОбменаССайтом.АдресСайта КАК АдресСайта,
	|	бит_НастройкиОбменаССайтом.ЛогинСайт КАК ЛогинСайт,
	|	бит_НастройкиОбменаССайтом.ПарольСайт КАК ПарольСайт,
	|	бит_НастройкиОбменаССайтом.АдресFTP КАК АдресFTP,
	|	бит_НастройкиОбменаССайтом.ПортFTP КАК ПортFTP,
	|	бит_НастройкиОбменаССайтом.КаталогFTP КАК КаталогFTP,
	|	бит_НастройкиОбменаССайтом.ЛогинFTP КАК ЛогинFTP,
	|	бит_НастройкиОбменаССайтом.ПарольFTP КАК ПарольFTP,
	|	бит_НастройкиОбменаССайтом.ЗащищенноеСоединение КАК ЗащищенноеСоединение,
	|	бит_НастройкиОбменаССайтом.ДатаНачалаПериода КАК ДатаНачалаПериода,
	|	бит_НастройкиОбменаССайтом.ДатаОкончанияПериода КАК ДатаОкончанияПериода,
	|	бит_НастройкиОбменаССайтом.ВидТранспорта КАК ВидТранспорта,
	|	бит_НастройкиОбменаССайтом.ИмяФайлаПоказаний КАК ИмяФайлаПоказаний
	|ИЗ
	|	Справочник.бит_НастройкиОбменаССайтом КАК бит_НастройкиОбменаССайтом
	|ГДЕ
	|	НЕ бит_НастройкиОбменаССайтом.ПометкаУдаления
	|	И бит_НастройкиОбменаССайтом.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НастройкиОбменаССайтомСписокУлиц.Улица КАК Улица
	|ИЗ
	|	Справочник.бит_НастройкиОбменаССайтом.СписокУлиц КАК бит_НастройкиОбменаССайтомСписокУлиц
	|ГДЕ
	|	бит_НастройкиОбменаССайтомСписокУлиц.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НастройкиОбменаССайтомСписокЗданий.Здание КАК Здание
	|ИЗ
	|	Справочник.бит_НастройкиОбменаССайтом.СписокЗданий КАК бит_НастройкиОбменаССайтомСписокЗданий
	|ГДЕ
	|	бит_НастройкиОбменаССайтомСписокЗданий.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НастройкиОбменаССайтомСписокЛС.ЛицевойСчет КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_НастройкиОбменаССайтом.СписокЛС КАК бит_НастройкиОбменаССайтомСписокЛС
	|ГДЕ
	|	бит_НастройкиОбменаССайтомСписокЛС.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НастройкиОбменаССайтомСписокУслуг.Услуга КАК Услуга
	|ИЗ
	|	Справочник.бит_НастройкиОбменаССайтом.СписокУслуг КАК бит_НастройкиОбменаССайтомСписокУслуг
	|ГДЕ
	|	бит_НастройкиОбменаССайтомСписокУслуг.Ссылка = &Ссылка";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	Выборка = РезультатЗапроса[0].Выбрать();
	Если Выборка.Следующий() Тогда
		ЗаполнитьЗначенияСвойств(СтруктуруПараметровОбмена, Выборка);	
	КонецЕсли;
	
	СтруктуруПараметровОбмена.КаталогFTP = ПолучитьИмяКаталога(Выборка.КаталогFTP);
	
	Результат = РезультатЗапроса[1].Выгрузить();
	СтруктуруПараметровОбмена.СписокУлиц = Результат.ВыгрузитьКолонку("Улица");	
	
	Результат = РезультатЗапроса[2].Выгрузить();
	СтруктуруПараметровОбмена.СписокЗданий = Результат.ВыгрузитьКолонку("Здание");	
	
	Результат = РезультатЗапроса[3].Выгрузить();
	СтруктуруПараметровОбмена.СписокЛС = Результат.ВыгрузитьКолонку("ЛицевойСчет");	
	
	Результат = РезультатЗапроса[4].Выгрузить();
	СтруктуруПараметровОбмена.СписокУслуг = Результат.ВыгрузитьКолонку("Услуга");	
	
    СтруктуруПараметровОбмена.ВыгружатьОтдельнымиФайлами = Ссылка.ВыгружатьОтдельнымиФайлами;
	СтруктуруПараметровОбмена.УчитыватьПеня =  Ссылка.УчитыватьПеня;
	
	Возврат СтруктуруПараметровОбмена;
	
 КонецФункции
 
Функция ПолучитьСтруктуруПараметровОбмена()
	 
	ПараметрыОбмена = Новый Структура();
	
	ПараметрыОбмена.Вставить("ДатаНачалаПериода"	, Неопределено);
	ПараметрыОбмена.Вставить("ДатаОкончанияПериода"	, Неопределено);
	ПараметрыОбмена.Вставить("Организация"			, Неопределено);
	ПараметрыОбмена.Вставить("Кодировка"			, "windows-1251");
	ПараметрыОбмена.Вставить("ВидТранспорта"		, Неопределено);
	ПараметрыОбмена.Вставить("КаталогВыгрузки"		, Неопределено);
	ПараметрыОбмена.Вставить("ИмяФайлаПоказаний"	, Неопределено);
	ПараметрыОбмена.Вставить("СписокУлиц"			, Неопределено);
	ПараметрыОбмена.Вставить("СписокЗданий"			, Неопределено);
	ПараметрыОбмена.Вставить("СписокЛС"				, Неопределено);
	ПараметрыОбмена.Вставить("СписокУслуг"			, Неопределено);
	
	ПараметрыОбмена.Вставить("АдресСайта"			, Неопределено);
	ПараметрыОбмена.Вставить("ЛогинСайт"			, Неопределено);
	ПараметрыОбмена.Вставить("ПарольСайт"			, Неопределено);
	
	ПараметрыОбмена.Вставить("АдресFTP"				, Неопределено);
	ПараметрыОбмена.Вставить("ПортFTP"				, Неопределено);
	ПараметрыОбмена.Вставить("КаталогFTP"			, Неопределено);
	ПараметрыОбмена.Вставить("ЛогинFTP"				, Неопределено);
	ПараметрыОбмена.Вставить("ПарольFTP"			, Неопределено);
	ПараметрыОбмена.Вставить("ЗащищенноеСоединение"	, Неопределено);
	
	ПараметрыОбмена.Вставить("УчитыватьПеня"    	, ложь);
	ПараметрыОбмена.Вставить("ВыгружатьОтдельнымиФайлами"	, ложь);
	
	Возврат ПараметрыОбмена;
	 
 КонецФункции
 
// Запись в XML файл.
 Процедура ЗаписатьФайлВыгрузки(ОбъектXDTO, ПараметрыОбмена, ИмяФайла)
	 
	 Если ПараметрыОбмена.ВидТранспорта = 0 Тогда
		 ЗаписатьФайлВКаталог(ОбъектXDTO, ПараметрыОбмена, ИмяФайла);
	 ИначеЕсли	 ПараметрыОбмена.ВидТранспорта = 1 Тогда
		 ЗаписатьФайлНаFTP(ОбъектXDTO, ПараметрыОбмена, ИмяФайла);
	 Иначе
		 Возврат; // Интеграция по http. 
	 КонецЕсли;
 
 КонецПроцедуры
 
 Процедура ЗаписатьФайлВКаталог(ОбъектXDTO, ПараметрыОбмена, ИмяФайла)
	 
	 Если НЕ ЗначениеЗаполнено(ПараметрыОбмена.КаталогВыгрузки) Тогда
		 Возврат; 
	 КонецЕсли;
	 
	 ИмяФайла = ПараметрыОбмена.КаталогВыгрузки + ПолучитьРазделительПути() + ИмяФайла;
	 
	 ИспользоватьОтступы= Истина;
	 СимволОтступа		= Символы.Таб;
	 
	 ЗаписьXML = Новый ЗаписьXML;
	 ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML(
								 ПараметрыОбмена.Кодировка,	// Кодировка (по-умолчанию "UTF-8").
								 "1.0",						// Версия XML (по-умолчанию "1.0").
								 ИспользоватьОтступы,		// Отступ.
								 ИспользоватьОтступы,		// Отступ атрибутов.
								 СимволОтступа); 			// Символы отступа.
	 ЗаписьXML.ОткрытьФайл(ИмяФайла, ПараметрыЗаписиXML);
	 ЗаписьXML.ЗаписатьОбъявлениеXML();
	 ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO);
	 ЗаписьXML.Закрыть();
	 
 КонецПроцедуры
 
 Процедура ЗаписатьФайлНаFTP(ОбъектXDTO, ПараметрыОбмена, ИмяФайла)
	 
	// Запись временного файла.
	ИмяВрФайла = ПолучитьИмяВременногоФайла("xml");
	
	ИспользоватьОтступы= Истина;
	СимволОтступа		= Символы.Таб;
	
	ЗаписьXML = Новый ЗаписьXML;
	ПараметрыЗаписиXML = Новый ПараметрыЗаписиXML(
	ПараметрыОбмена.Кодировка,	// Кодировка (по-умолчанию "UTF-8").
	"1.0",						// Версия XML (по-умолчанию "1.0").
	ИспользоватьОтступы,		// Отступ.
	ИспользоватьОтступы,		// Отступ атрибутов.
	СимволОтступа); 			// Символы отступа.
	ЗаписьXML.ОткрытьФайл(ИмяВрФайла, ПараметрыЗаписиXML);
	ЗаписьXML.ЗаписатьОбъявлениеXML();
	ФабрикаXDTO.ЗаписатьXML(ЗаписьXML, ОбъектXDTO);
	ЗаписьXML.Закрыть();
	
	НастройкиFTP = ОбменДаннымиСервер.FTPНастройкиСоединения(10);
	НастройкиFTP.Сервер               = ПараметрыОбмена.АдресFTP;
	НастройкиFTP.Порт                 = ПараметрыОбмена.ПортFTP;
	НастройкиFTP.ИмяПользователя      = ПараметрыОбмена.ЛогинFTP;
	НастройкиFTP.ПарольПользователя   = ПараметрыОбмена.ПарольFTP;
	НастройкиFTP.ПассивноеСоединение  = Истина;
	Если ПараметрыОбмена.ЗащищенноеСоединение Тогда
		НастройкиFTP.ЗащищенноеСоединение= Новый ЗащищенноеСоединениеOpenSSL;
	Иначе
		НастройкиFTP.ЗащищенноеСоединение = Неопределено;
	КонецЕсли;
	
	Попытка
		FTPСоединение = ОбменДаннымиСервер.FTPСоединение(НастройкиFTP);
		Если СтрДлина(ПараметрыОбмена.КаталогFTP) > 1 Тогда
			ИмяПапки = ПолучитьИмяПапки(ПараметрыОбмена.КаталогFTP);
			Если НЕ ОбменДаннымиСервер.FTPКаталогСуществует(ПараметрыОбмена.КаталогFTP, ИмяПапки, FTPСоединение) Тогда
				ТекстОшибки	= НСтр("ru = 'Соединение с свервером установлено, но каталог не найден!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
				Возврат;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстОшибки = СтрШаблон(НСтр("ru = '%1'"), КраткоеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		Возврат;
	КонецПопытки;
	
	FTPСоединение.УстановитьТекущийКаталог(ПараметрыОбмена.КаталогFTP);
	
	Попытка
		FTPСоединение.Записать(ИмяВрФайла, ИмяФайла);
	Исключение
		Возврат;	  
	КонецПопытки;
	 
 КонецПроцедуры
 
 Функция Абс(Знач ВхЧисло)
Возврат Макс(ВхЧисло, -ВхЧисло);
КонецФункции 

Функция FTPСоединение(Знач Настройки)
	
	Возврат Новый FTPСоединение(
		Настройки.Сервер,
		Настройки.Порт,
		Настройки.ИмяПользователя,
		Настройки.ПарольПользователя,
		Неопределено,
		Настройки.ПассивноеСоединение,
		Настройки.Таймаут,
		Настройки.ЗащищенноеСоединение);
	
КонецФункции

Функция FTPНастройкиСоединения(Знач Таймаут = 180)
	
	Результат = Новый Структура;
	Результат.Вставить("Сервер", "");
	Результат.Вставить("Порт", 21);
	Результат.Вставить("Прокси", Новый ИнтернетПрокси(Ложь));
	Результат.Вставить("ИмяПользователя", "");
	Результат.Вставить("ПарольПользователя", "");
	Результат.Вставить("ПассивноеСоединение", Ложь);
	Результат.Вставить("Таймаут", Таймаут);
	Результат.Вставить("ЗащищенноеСоединение", Неопределено);
	
	Возврат Результат;
	
КонецФункции

// Подготовка пути FTP.
//
// Параметры:
//  Путь - Строка - путь для FTP сервера.
//
Процедура ПодготовитьПутьFTP(Путь) Экспорт
	
	Путь = СтрЗаменить(Путь, "\", "/");
	Если ЗначениеЗаполнено(Путь) Тогда
		Если НЕ Лев(Путь, 1) = "/" Тогда
			Путь = "/" + Путь;
		КонецЕсли;
		Если НЕ Прав(Путь, 1) = "/" Тогда
			Путь = Путь + "/";
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Функция ПолучитьИмяПапки(Знач Путь) Экспорт
	
	МассивИмен = СтрРазделить(Путь, "/", Ложь);
	Возврат МассивИмен[МассивИмен.ВГраница()];

КонецФункции

Функция ПолучитьИмяКаталога(Знач ИмяКаталога) Экспорт
	
	ИмяКаталога = СокрЛП(ИмяКаталога);
	
	Если НЕ ПустаяСтрока(ИмяКаталога) Тогда
		
		Если (Прав(ИмяКаталога, 1) = "\") ИЛИ (Прав(ИмяКаталога, 1) = "/") Тогда
			ИмяКаталога = Лев(ИмяКаталога, СтрДлина(ИмяКаталога) - 1);
		КонецЕсли;
		
		Возврат ИмяКаталога;
	Иначе
		Возврат ИмяКаталога;
	КонецЕсли;

КонецФункции