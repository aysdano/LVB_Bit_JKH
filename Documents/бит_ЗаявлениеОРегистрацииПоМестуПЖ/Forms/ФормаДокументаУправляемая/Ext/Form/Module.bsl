								Если Найти("0123456789",Прав(Лев(ВыборкаСН.ПроживающийСтраховойНомерПФР,Значение),1))>0 тогда
									
									ЗаявлениеОСнятии.Параметры[СНИЛС] = Прав(Лев(ВыборкаСН.ПроживающийСтраховойНомерПФР,Значение),1);	
									
