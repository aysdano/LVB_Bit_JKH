// Функция получает начало периода исходя из периодичности
//
// Параметры:
//  ДатаНачала  – Дата,
//  Периодичность - ПеречислениеСсылка.бит_ПериодичностьПланирования.
//
// Возвращаемое значение:
//  ТекущийПериод   – Дата.
//
Функция ПолучитьНачалоПериода(ДатаНачала,Периодичность) 
	
	ТекущийПериод = ДатаНачала;
	Если ЗначениеЗаполнено(Периодичность) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		|	НАЧАЛОПЕРИОДА(&ДатаНачала,"+ Периодичность+") КАК ТекущийПериод";
		
		Запрос.УстановитьПараметр("ДатаНачала",ДатаНачала);
		
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ТекущийПериод = Выборка.ТекущийПериод;
			
		КонецЕсли; // по выборке.
	КонецЕсли; // заполнена периодичность.
	
	Возврат ТекущийПериод;
	
КонецФункции

&НаСервере
// Функция получает начало периода исходя из периодичности
//
// Параметры:
//  ДатаНачала  – Дата,
//  Периодичность - ПеречислениеСсылка.бит_ПериодичностьПланирования.
//
// Возвращаемое значение:
//  ТекущийПериод   – Дата.
//
Функция ПолучитьКонецПериода(ДатаНачала,Периодичность) 
	
	ТекущийПериод = ДатаНачала;
	
	Если ЗначениеЗаполнено(Периодичность) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		|	КОНЕЦПЕРИОДА(&ДатаНачала,"+ Периодичность+") КАК ТекущийПериод";
		
		Запрос.УстановитьПараметр("ДатаНачала",ДатаНачала);
		
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ТекущийПериод = Выборка.ТекущийПериод;
			
		КонецЕсли; // по выборке.
	КонецЕсли; // заполнена периодичность.
	
	Возврат ТекущийПериод;
	
КонецФункции

// Процедура выполняет создание колонок в табличном поле ДанныеДерева.
//
&НаСервере
Процедура ИнициализироватьКолонки(ОчиститьРеквизиты = Ложь)
	
	Если ОчиститьРеквизиты Тогда
		
		УдалитьКолонки();
		
	КонецЕсли; 
	
	КоличествоИнтервалов = РазностьДат(Объект.ДатаНачалаПланирования, Объект.ДатаОкончанияПланирования, "Месяц")+1;
	
	// Добавление колонок дерева.
	ДобавляемыеРеквизиты = Новый Массив;
	
	ТипКолонки = ОбщегоНазначения.ОписаниеТипаЧисло(15,2);
	
	Для Значение = 1 По КоличествоИнтервалов Цикл
		
		ТекущийПериод = ПолучитьПериодПоСдвигу(Объект.ДатаНачалаПланирования,Значение - 1,"Месяц");
		
		Если НЕ ЗначениеЗаполнено(ТекущийПериод) Тогда
			Продолжить;
		КонецЕсли; 

		Синоним = Формат(ТекущийПериод,"ДФ='MMMM yyyy'");

		ИмяКолонки = "РеквизитДерева_" + СформироватьИмяКолонкиПериод(ТекущийПериод);
		
		Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
			
			НовыйРеквизит = Новый РеквизитФормы(ИмяКолонки, ТипКолонки, Элементы.ДанныеДерева.Имя, Синоним);
			ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	мКолонкиДерева = Новый Структура;
	
	Для каждого Реквизит Из ДобавляемыеРеквизиты Цикл
		
		ПутьКДанным = "" + Элементы.ДанныеДерева.Имя + "." + Реквизит.Имя;
		
		ЭУ = Элементы.Добавить(Реквизит.Имя, Тип("ПолеФормы"), Элементы.ДанныеДерева);
		ЭУ.ПутьКДанным = ПутьКДанным;
		
		ЭУ.Вид            = ВидПоляФормы.ПолеВвода;
		ЭУ.Видимость      = Истина;
		ЭУ.ЦветФона       = WebЦвета.Роса;
		ЭУ.Ширина         = 10;
		ЭУ.ШрифтЗаголовка = Новый Шрифт("MS Shell Dlg", 8, Истина);
		
		мКолонкиДерева.Вставить(ЭУ.Имя);
		
		ЭУ.УстановитьДействие("ПриИзменении", "ДанныеДереваПериодПриИзменении");
		
	КонецЦикла; 
	
	// Доабавление итоговой колонки.
	ДобавляемыеРеквизиты.Очистить();
	
	ИмяКолонки = "Итого";
	
	Если Элементы.Найти(ИмяКолонки) = Неопределено Тогда
		
		НовыйРеквизит = Новый РеквизитФормы(ИмяКолонки, ТипКолонки, Элементы.ДанныеДерева.Имя, ИмяКолонки);
		ДобавляемыеРеквизиты.Добавить(НовыйРеквизит);
		
	КонецЕсли;
	
	ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	Для каждого Реквизит Из ДобавляемыеРеквизиты Цикл
		
		ПутьКДанным = "" + Элементы.ДанныеДерева.Имя + "." + Реквизит.Имя;
		
		ЭУ = Элементы.Добавить(Реквизит.Имя, Тип("ПолеФормы"), Элементы.ДанныеДерева);
		ЭУ.ПутьКДанным = ПутьКДанным;
		
		ЭУ.Вид            = ВидПоляФормы.ПолеВвода;
		ЭУ.Видимость      = Истина;
		ЭУ.ТолькоПросмотр = Истина;
		ЭУ.ЦветФона       = WebЦвета.Перламутровый;
		ЭУ.Ширина         = 10;
		ЭУ.ШрифтЗаголовка = Новый Шрифт("MS Shell Dlg", 8, Истина);
		
	КонецЦикла;
	
	НазначитьОформление();
	
	Элементы.ДанныеДерева.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	
КонецПроцедуры

&НаСервере
// Процедура создания условного оформления колонкам созданым автоматически.
//
Процедура НазначитьОформление()
	
	ЭлементУО = УсловноеОформление.Элементы.Добавить();
	
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона"      , WebЦвета.Перламутровый);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ТолькоПросмотр", Истина);
	
	ЭлементУсловия  = ЭлементУО.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ЭлементУсловия.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("ДанныеДерева.ЭтоГруппа");
	ЭлементУсловия.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ЭлементУсловия.ПравоеЗначение = Истина;
	
	Для каждого ИмяПоля Из мКолонкиДерева Цикл
		
		ОформляемыеПоля = ЭлементУО.Поля.Элементы.Добавить();
		ОформляемыеПоля.Поле = Новый ПолеКомпоновкиДанных(ИмяПоля.Ключ);
		
	КонецЦикла; 
	
КонецПроцедуры

// Процедура выполняет заполнение колонок в табличном поле ДанныеДерева.
//
&НаСервере
Процедура ЗаполнитьДерево()
	
	СтруктураНастроек = Документы.бит_СметаДоходовИРасходов.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Кодификатор");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Наименование");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Ссылка");
	
	СтруктураНастроек.ШаблонСметы = ?(ЗначениеЗаполнено(Объект.ШаблонСметы), Объект.ШаблонСметы, Неопределено);
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "СтатьиОборотов";
	
	СтруктураРезультата = Документы.бит_СметаДоходовИРасходов.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	Результат = СтруктураРезультата.РезультатЗапроса;
	
	КореньДерева = ДанныеДерева.ПолучитьЭлементы();
	
	КореньДерева.Очистить();
	
	Объект.БДДС.Очистить();
	
	ДобавитьГруппировкуВДерево(Результат, КореньДерева, ОбходРезультатаЗапроса.ПоГруппировкамСИерархией);
	
КонецПроцедуры

&НаСервере
// Выводит группировку в дерево значений
// Параметры:
// ВыборкаВерхняя - РезультатЗапроса или ВыборкаИзРезультатаЗапроса,
// СтрокиДерева   - Коллекция строк дерева значений.
//
Процедура ДобавитьГруппировкуВДерево(ВыборкаВерхняя, СтрокаДерева, СпособОбхода)
	
	Выборка = ВыборкаВерхняя.Выбрать(СпособОбхода);
	
	Пока Выборка.Следующий() Цикл
		
		// Если в группе нет элементов, то не выводим её.
		Добавлять = Истина;
		
		Если Выборка.Ссылка.ЭтоГруппа  Тогда
			
			Добавлять = Ложь;
			ПроверитьНаличиеПодчиненныхЭлементов(Выборка,Добавлять);
			
		КонецЕсли;
		
		Если Добавлять Тогда
			
			ВыборкаНижняя = Выборка.Выбрать(СпособОбхода);
			ЭтоГруппа = ?(Выборка.Ссылка.ЭтоГруппа ИЛИ ВыборкаНижняя.Количество()>0,Истина,Ложь);
			
			ТекСтрока = СтрокаДерева.Добавить();
			ТекСтрока.СтатьяОборотов = Выборка.Ссылка;
			ТекСтрока.ЭтоГруппа      = ЭтоГруппа;
			ТекСтрока.Кодификатор    = Выборка.Кодификатор;
			ТекСтрока.Идентификатор  = Новый УникальныйИдентификатор;
			
			ТекСтрока = ТекСтрока.ПолучитьЭлементы();
			
		КонецЕсли;
		
		ДобавитьГруппировкуВДерево(Выборка, ТекСтрока, СпособОбхода);
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
// Процедура проверяет наличие подчиненных элементов. Рекурсивный вызов.
//
// Параметры:
//  ВыборкаВерхняя  – ВыборкаИзРезультатаЗапроса,
//  ЕстьЭлементы    - Булево.
//
Процедура ПроверитьНаличиеПодчиненныхЭлементов(ВыборкаВерхняя,ЕстьЭлементы)
	
	Выборка = ВыборкаВерхняя.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока Выборка.Следующий() Цикл
		
		Если НЕ Выборка.Ссылка.ЭтоГруппа Тогда
			
			ЕстьЭлементы = Истина;
			Возврат;
			
		КонецЕсли; 
		ПроверитьНаличиеПодчиненныхЭлементов(Выборка,ЕстьЭлементы);
		Если ЕстьЭлементы Тогда
			
			Возврат;
			
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции

// Процедура выполняет удаление реквизитов и элементов формы созданых программно.
//
&НаСервере
Процедура УдалитьКолонки()
	
	Если мКолонкиДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	УдаляемыеРеквизиты = Новый Массив;
	
	МассивРеквизитов = ПолучитьРеквизиты("ДанныеДерева");
	
	Для каждого Реквизит Из МассивРеквизитов Цикл
		
		Колонка = мКолонкиДерева.Свойство(Реквизит.Имя);
		
		Если Колонка Тогда
			
			УдаляемыеРеквизиты.Добавить(Реквизит.Путь + "." +Реквизит.Имя);
			
			УдаляемыЭлемент = Элементы.Найти(Реквизит.Имя);
			
			Если НЕ УдаляемыЭлемент = Неопределено Тогда
				
				Элементы.Удалить(УдаляемыЭлемент);
				
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	УдаляемыЭлемент = Элементы.Найти("Итого");
	
	Если НЕ УдаляемыЭлемент = Неопределено Тогда
		
		Элементы.Удалить(УдаляемыЭлемент);
		
	КонецЕсли;
	
	УдаляемыеРеквизиты.Добавить("ДанныеДерева.Итого");
	
	ИзменитьРеквизиты(, УдаляемыеРеквизиты);
	
КонецПроцедуры

// Процедура выполняет обновлени данных таблиц формы.
//
&НаСервере
Процедура ОбновитьДерво()
	
	КореньДерева = ДанныеДерева.ПолучитьЭлементы();
	
	КореньДерева.Очистить();
	
	Объект.БДДС.Очистить();
	
	ИнициализироватьКолонки(Истина);
	
	ЗаполнитьДерево();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроцентыСписокЗданий()
	
	тмпСписокЗданий = Объект.СписокЗданий.Выгрузить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокЗданий"       , тмпСписокЗданий);
	Запрос.УстановитьПараметр("СпособРаспределения", Объект.СпособРаспределения);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписокЗданий.Здание,
	|	СписокЗданий.ЗданиеПредставление,
	|	СписокЗданий.Адрес,
	|	СписокЗданий.Процент
	|ПОМЕСТИТЬ Здания
	|ИЗ
	|	&СписокЗданий КАК СписокЗданий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЗначениеСвойствОбъектовУчета.Значение,
	|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета
	|ПОМЕСТИТЬ ХаррактеристеткиЗданий
	|ИЗ
	|	РегистрСведений.бит_ЗначениеСвойствОбъектовУчета КАК бит_ЗначениеСвойствОбъектовУчета
	|ГДЕ
	|	бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = &СпособРаспределения
	|	И бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				таб.Здание
	|			ИЗ
	|				Здания КАК таб)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Здания.Здание,
	|	Здания.ЗданиеПредставление,
	|	Здания.Адрес,
	|	Здания.Процент,
	|	ЕстьNull(ХаррактеристеткиЗданий.Значение,0) КАК Значение
	|ИЗ
	|	Здания КАК Здания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ХаррактеристеткиЗданий КАК ХаррактеристеткиЗданий
	|		ПО Здания.Здание = ХаррактеристеткиЗданий.ОбъектУчета";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	ПроцентИтог = Таблица.Итог("Значение");
	
	Если ПроцентИтог <= 0 Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из Таблица Цикл
		
		СтрокаТаблицы.Процент = Окр( СтрокаТаблицы.Значение * 100 / ПроцентИтог, 2);
		
	КонецЦикла;
	
	Объект.СписокЗданий.Очистить();
	Объект.СписокЗданий.Загрузить(Таблица);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПроцентБДДС(СуммаРаспределения)
	
	ФиксированаяСтруктура = Элементы.БДДС.ОтборСтрок;
	
	Отбор = Новый Структура;
	Для каждого КлючЗначение Из ФиксированаяСтруктура Цикл
		
		Отбор.Вставить(КлючЗначение.Ключ, КлючЗначение.Значение);
		
	КонецЦикла; 
	
	СтрокиПосика = Объект.БДДС.НайтиСтроки(Отбор);
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("Здание" , Новый ОписаниеТипов("СправочникСсылка.бит_списокЗданий"));
	Таблица.Колонки.Добавить("Процент", ОбщегоНазначения.ОписаниеТипаЧисло(5,2));
	Таблица.Колонки.Добавить("Сумма"  , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	
	Для каждого СтрокаТаблицы Из СтрокиПосика Цикл
		
		НоваяСтрока = Таблица.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокЗданий"       , Таблица);
	Запрос.УстановитьПараметр("СпособРаспределения", СпособРаспределения);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписокЗданий.Здание,
	|	СписокЗданий.Сумма,
	|	СписокЗданий.Процент
	|ПОМЕСТИТЬ Здания
	|ИЗ
	|	&СписокЗданий КАК СписокЗданий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЗначениеСвойствОбъектовУчета.Значение,
	|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета
	|ПОМЕСТИТЬ ХаррактеристеткиЗданий
	|ИЗ
	|	РегистрСведений.бит_ЗначениеСвойствОбъектовУчета КАК бит_ЗначениеСвойствОбъектовУчета
	|ГДЕ
	|	бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = &СпособРаспределения
	|	И бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				таб.Здание
	|			ИЗ
	|				Здания КАК таб)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Здания.Здание,
	|	Здания.Сумма,
	|	Здания.Процент,
	|	ЕстьNull(ХаррактеристеткиЗданий.Значение,0) КАК Значение
	|ИЗ
	|	Здания КАК Здания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ХаррактеристеткиЗданий КАК ХаррактеристеткиЗданий
	|		ПО Здания.Здание = ХаррактеристеткиЗданий.ОбъектУчета";
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	ПроцентИтог = Таблица.Итог("Значение");
	
	Для каждого СтрокаТаблицы Из СтрокиПосика Цикл
		
		Процент = 0;
		
		СтрокаПроцент = Таблица.Найти(СтрокаТаблицы.Здание, "Здание");
		
		Если не СтрокаПроцент = Неопределено Тогда
			
			Если ПроцентИтог > 0 Тогда
				Процент = Окр(СтрокаПроцент.Значение * 100 / ПроцентИтог, 2);
			КонецЕсли;
			
			СтрокаТаблицы.Процент = Процент;
			
			СтрокаТаблицы.Сумма = Окр((СуммаРаспределения * Процент)/100, 2);
			
			СтрокаТаблицы.СпособРаспределения = СпособРаспределения;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоОбходом(Дерево, Строкародитель = Неопределено)
	
	Если Строкародитель = Неопределено Тогда
		ДеревоДляЗаполнения = ДанныеДерева.ПолучитьЭлементы();
	Иначе
		ДеревоДляЗаполнения = Строкародитель.ПолучитьЭлементы();
	КонецЕсли; 
	
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
		
		НоваяСтрока = ДеревоДляЗаполнения.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
		
		ЗаполнитьДеревоОбходом(СтрокаДерева, НоваяСтрока);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗданийПослеУдаления(Элемент)
	
	Если ЗначениеЗаполнено(Объект.СпособРаспределения) Тогда
		
		ЗаполнитьПроцентыСписокЗданий();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗданийПодборЗданий(Команда)
	
	ОткрытьФормуПодбораЗданий(Элементы.СписокЗданий);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуПодбораЗданий(Владелец)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Объект.Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая", ПараметрыФормы, Владелец);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗданийОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если НЕ ВыбранноеЗначение = Неопределено Тогда
		
		Для каждого Здание Из ВыбранноеЗначение Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("Здание", Здание);
			
			МассивСтрок = Объект.СписокЗданий.НайтиСтроки(Отбор);
			
			Если МассивСтрок.Количество() = 0 Тогда
				
				НоваяСтрока = Объект.СписокЗданий.Добавить();
				
				ПочтовыйАдрес = ПочтовыйАдресНаСервере(Здание);
				Улица = УлицаНаСервере(Здание);
				
				НоваяСтрока.Адрес               = ПочтовыйАдрес;
				НоваяСтрока.Здание              = Здание;
				НоваяСтрока.ЗданиеПредставление = "ул." + Улица + " ,д" + Здание;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ЗначениеЗаполнено(Объект.СпособРаспределения) Тогда
			ЗаполнитьПроцентыСписокЗданий();
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура БДДСПодборЗданий(Команда)
	
	ОткрытьФормуПодбораЗданий(Элементы.БДДС);
	
КонецПроцедуры

&НаКлиенте
Процедура БДДСОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если НЕ ВыбранноеЗначение = Неопределено Тогда
		
		Для каждого Здание Из ВыбранноеЗначение Цикл
			
			Отбор = Новый Структура;
			Отбор.Вставить("СтатьяОборотов", Элементы.БДДС.ОтборСтрок.СтатьяОборотов);
			Отбор.Вставить("Период"        , Элементы.БДДС.ОтборСтрок.Период);
			Отбор.Вставить("ИД"            , Элементы.БДДС.ОтборСтрок.ИД);
			Отбор.Вставить("Здание"        , Здание);
			
			МассивСтрок = Объект.БДДС.НайтиСтроки(Отбор);
			
			Если МассивСтрок.Количество() = 0 Тогда
				
				НоваяСтрока = Объект.БДДС.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Отбор);
				
				НоваяСтрока.Адрес               = Здание.ПочтовыйАдрес;
				НоваяСтрока.ЗданиеПредставление = "ул." + Здание.Улица + " ,д" + Здание;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		ТекущиеДанныеДрева   = Элементы.ДанныеДерева.ТекущиеДанные;
		ТекущаяЭлементДерева = Элементы.ДанныеДерева.ТекущийЭлемент;
		
		Если ТекущаяЭлементДерева = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ТекущиеДанныеДрева = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ИмяКолонки = ТекущаяЭлементДерева.Имя;
		
		Если Найти(ИмяКолонки,"РеквизитДерева_") > 0 Тогда
			СуммаРаспределения = ТекущиеДанныеДрева[ИмяКолонки];
			ЗаполнитьПроцентБДДС(СуммаРаспределения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаНачалаПланированияПриИзменении(Элемент)
	
	Если ДанныеДерева.ПолучитьЭлементы().Количество() > 0 Тогда
		
		Ответ = Неопределено;
		
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДатаНачалаПланированияПриИзмененииЗавершение", ЭтотОбъект), "Данные будут очищенны, продолжить?", РежимДиалогаВопрос.ДаНет,5,КодВозвратаДиалога.Нет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
