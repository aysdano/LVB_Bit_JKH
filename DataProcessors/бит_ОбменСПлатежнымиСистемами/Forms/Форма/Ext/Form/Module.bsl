	   ДокументВводПоказаний.Комментарий		= "Документ создан из обработки Обмен с платежными системами. " + ТекущаяДата();
	   ДокументВводПоказаний.ПоказанияПоСчетчикам.Очистить();		   
	   
	   для каждого стрЛС из списокЛС цикл
		   
		    Отбор = Новый Структура;
	        Отбор.Вставить("ЛицевойСчет", стрЛС);
			Отбор.Вставить("ДатаОплаты", стрОплат);

	        ТаблицаСчетчиковПоЛС = ТаблицаСчетчиков.НайтиСтроки(Отбор);
			
			счетчик = неопределено;
			для каждого строкаСчетчика из ТаблицаСчетчиковПоЛС цикл
				если строкаСчетчика.Счетчик <> неопределено и
					      строкаСчетчика.Счетчик <> Справочники.бит_Счетчики.ПустаяСсылка() тогда
				  счетчик = строкаСчетчика.Счетчик;	
				  прервать;	
				конецесли;	
			конеццикла;	
			
			если счетчик = неопределено тогда
			 продолжить;
			конецесли;     						
			
			для каждого строкаСчетчика из ТаблицаСчетчиковПоЛС цикл
				
			 таблицаУслуг = ПолучитьТаблицуУслуг(строкаСчетчика.Счетчик, строкаСчетчика.ДатаОплаты);	
				
