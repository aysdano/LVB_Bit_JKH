&НаСервере
Функция НайтиСтрокиДереваДокументОплатыПриходныйКассовыйОредерНаСервере(Знач ДокументОплаты);
	
	ДеревоПКОМ = РеквизитФормыВЗначение("ДеревоПКО");
	
	СтрокаДерева = ДеревоПКОМ.Строки.Найти(ДокументОплаты, "ПриходныйКассовыйОредер");
	
	СтруктураОтвета = Новый Структура;
	
	Если СтрокаДерева <> Неопределено Тогда
		
		СтруктураОтвета.Вставить("СтрокаДереваНеопределено", Истина);
		
	Иначе
		
		СтруктураОтвета.Вставить("СтрокаДереваНеопределено", Ложь);
		
	КонецЕсли;
	
	Если СтрокаДерева <> Неопределено Тогда
		
		Если СтрокаДерева.Строки.Количество() > 0 Тогда
			
			СтруктураОтвета.Вставить("СтрокаДереваСтрокиКоличество", Истина);
			
		Иначе
			
			СтруктураОтвета.Вставить("СтрокаДереваСтрокиКоличество", Ложь);
			
		КонецЕсли;
		
	Иначе
		
		СтруктураОтвета.Вставить("СтрокаДереваСтрокиКоличество", Истина);
		
	КонецЕсли;
	
	Возврат СтруктураОтвета;
	
