   списокДатОплаты = ОбщегоНазначенияКлиентСервер.СвернутьМассив(ТаблицаСчетчиковЛок.ВыгрузитьКолонку("ДатаОплаты"));
   
   тДеревоОплаты = РеквизитФормыВЗначение("ДеревоОплаты");

