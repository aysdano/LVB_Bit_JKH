&НаКлиенте
Процедура ПодборИзСпискаПроживающих(Команда)
	
	ЭтаФорма.Модифицированность = Истина;
	
	// Замена указаний типовых объектов на объекты БИТ в тексте модуля.
	мСписокЗначений = ПолучитьСписокЗначенийНаСервере(КонецМесяца(Объект.Дата), Объект.ЛицевойСчет);
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Ссылка", мСписокЗначений);
	
	//ОткрытьФорму("Справочник.бит_Проживающие.Форма.ФормаВыбораУправляемая", Новый Структура("ЗаполнитьИзДокументаИсковоеЗаявление", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЗначенийНаСервере(Знач Дата, Знач ЛицевойСчет);
	
	// Замена указаний типовых объектов на объекты БИТ в тексте модуля.
	РезультатЗапроса = ПолучитьСписокПроживающих(Дата, ЛицевойСчет);
	ТаблицаФизЛиц    = РезультатЗапроса.Выгрузить();
	
	ЗагрузитьТаблицуНаСервере(ТаблицаФизЛиц);
	
	Выборка = РезультатЗапроса.Выбрать();
	
	мСписокЗначений = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл 
		
		мСписокЗначений.Добавить(Выборка.ФизЛицо)
		
	КонецЦикла;
	
	Возврат мСписокЗначений;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокПроживающих(Знач Дата, Знач ЛицевойСчет)
	
	Запрос =  Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаЗаписи КАК ДатаЗаписи,
	|	ОтветственныеЛицаПоКУСрезПоследних.Контрагент КАК Контрагент,
	|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры КАК ВладелецКвартиры,
	|	ПроживающиеПоЛССрезПоследних.ДоляПлощади КАК ДоляПлощади,
	|	ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы КАК ПравоустанавливающиеДокументы,
	|	ПроживающиеПоЛССрезПоследних.КудаВыписан КАК КудаВыписан,
	|	ПроживающиеПоЛССрезПоследних.ОткудаПрибыл КАК ОткудаПрибыл
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныеЛицаПоКУСрезПоследних
	|		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет = ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет
	|			И ПроживающиеПоЛССрезПоследних.ФизЛицо = ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо
	|ГДЕ
	|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ НЕ ПроживающиеПоЛССрезПоследних.ДоляПлощади = 0
	|			ИЛИ ПроживающиеПоЛССрезПоследних.СтепеньРодства.Наименование = ""Ответственное лицо""
	|			ИЛИ ПроживающиеПоЛССрезПоследних.СтатусПроживания.Ссылка <> ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.НеПроживает))";
	
	
	
	
	Запрос.УстановитьПараметр("Момент"     , Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Возврат РезультатЗапроса;	
	
КонецФункции // ()

&НаСервере
Процедура ЗагрузитьТаблицуНаСервере(ТаблицаФизЛиц)
	
	СтараяТаблица = РеквизитФормыВЗначение("мТаблицаФизЛиц");
	
	МассивРеквизитов = Новый Массив;
	
	Для Каждого Колонка Из ТаблицаФизЛиц.Колонки Цикл
		
		Если СтараяТаблица.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			
			МассивРеквизитов.Добавить(Новый РеквизитФормы(Колонка.Имя, Колонка.ТипЗначения, "мТаблицаФизЛиц"));
			
		КонецЕсли;
		
	КонецЦикла;
	
	
	Объект.Ответчики.Очистить();
	
	Для каждого стр из ТаблицаФизЛиц Цикл
		
		НоваяСтрока = Объект.Ответчики.Добавить();
		
		НоваяСтрока.ФизЛицо = стр.ФизЛицо;
		
	КонецЦикла;
	
	ИзменитьРеквизиты(МассивРеквизитов);
	
	ЗначениеВРеквизитФормы(ТаблицаФизЛиц, "мТаблицаФизЛиц");
	
КонецПроцедуры



