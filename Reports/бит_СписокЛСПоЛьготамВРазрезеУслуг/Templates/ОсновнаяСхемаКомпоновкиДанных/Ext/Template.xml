		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Здание.Участок КАК Участок,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.УлицаЛицевогоСчета КАК Улица,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Здание КАК Здание,
	бит_НачислениеПоЛьготамОбороты.Услуга,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	бит_НачислениеПоЛьготамОбороты.Льгота,
	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	СУММА(бит_НачислениеПоЛьготамОбороты.НачисленоОборот) КАК Начислено,
	СУММА(бит_НачислениеПоЛьготамОбороты.СуммаОборот + бит_НачислениеПоЛьготамОбороты.СуммаСемейнойОборот) КАК Скидка,
	СУММА(бит_НачислениеПоЛьготамОбороты.КоличествоНосителейОборот) КАК КоличествоНосителей,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Квартира КАК Квартира,
	СУММА(бит_НачислениеПоЛьготамОбороты.СуммаРазовыхОборот) КАК СуммаРазовыхОборот,
	СУММА(ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.СуммаОборот, 0) + ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.СуммаСемейнойОборот, 0) - ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.СуммаРазовыхОборот, 0)) КАК НачисленоРазовые
ИЗ
	РегистрНакопления.бит_НачислениеПоЛьготам.Обороты(&amp;НачалоПериода, &amp;КонецПериода, Период, ЛицевойСчет.Организация = &amp;Организация) КАК бит_НачислениеПоЛьготамОбороты

СГРУППИРОВАТЬ ПО
	бит_НачислениеПоЛьготамОбороты.Услуга,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	бит_НачислениеПоЛьготамОбороты.Льгота,
	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Здание.Участок,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.УлицаЛицевогоСчета,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Здание,
	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Квартира</query>
