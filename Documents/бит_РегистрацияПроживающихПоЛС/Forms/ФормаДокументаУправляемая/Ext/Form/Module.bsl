функция ЗаполнитьТаблицуСобственников(статус = неопределено)
	
	если статус <> неопределено и статус <> Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо тогда
	 возврат неопределено;	
	конецесли;
	запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	бит_ПроживающиеПоЛССрезПоследних.Период КАК Период,
	               |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	               |	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	               |	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	               |	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	               |	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	               |	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	               |	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	               |	бит_ПроживающиеПоЛССрезПоследних.ДатаПраваСобственности КАК ДатаПраваСобственности
	               |ИЗ
	               |	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних КАК бит_ПроживающиеПоЛССрезПоследних
	               |ГДЕ
	               |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет = &ЛицевойСчет
	               |	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = &СтепеньРодства";
	
	запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	запрос.УстановитьПараметр("СтепеньРодства", Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо);
	
	мТаблицаСобственников = запрос.Выполнить().Выгрузить();
	мТаблицаСобственников.Сортировать("Период Убыв");
	если мТаблицаСобственников.Количество() > 0 тогда
	 если мТаблицаСобственников[0].ДатаПраваСобственности <> '00010101000000' тогда	
	  мДатаСобственности = КонецДня(мТаблицаСобственников[0].ДатаПраваСобственности) + 1;
     иначе
	  мДатаСобственности = неопределено;
	 конецесли; 
    иначе
	 мДатаСобственности = Объект.Дата;
    конецесли; 
    возврат мДатаСобственности; 
конецфункции

функция ПроверитьДатуСобственников(ДатаСобственника)
	
	запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	бит_ПроживающиеПоЛССрезПоследних.Период КАК Период,
	               |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	               |	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	               |	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	               |	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	               |	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	               |	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	               |	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	               |	бит_ПроживающиеПоЛССрезПоследних.ДатаПраваСобственности КАК ДатаПраваСобственности
	               |ИЗ
	               |	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних КАК бит_ПроживающиеПоЛССрезПоследних
	               |ГДЕ
	               |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет = &ЛицевойСчет
	               |	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = &СтепеньРодства";
	
	запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	запрос.УстановитьПараметр("СтепеньРодства", Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо);
	
	мТаблицаСобственников = запрос.Выполнить().Выгрузить();
	мТаблицаСобственников.Сортировать("Период Убыв");
	
	если мТаблицаСобственников.Количество() > 0 тогда	   
	  если мТаблицаСобственников[0].ДатаПраваСобственности > ДатаСобственника тогда 
		если мТаблицаСобственников[0].ДатаСнятияСРегистрации = '00010101000000' тогда	
		 возврат ложь; 
		конецесли; 
	  конецесли;		  
    конецесли; 
    возврат истина; 
	
конецфункции

