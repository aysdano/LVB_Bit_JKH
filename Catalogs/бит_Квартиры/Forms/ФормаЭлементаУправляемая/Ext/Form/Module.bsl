	ЗаполнитьКэшЗначений(мКэшЗначений);
	Если Параметры.Свойство("НежилыеПомещения") Тогда
		мКэшЗначений.ТипКвартиры = Параметры.НежилыеПомещения;
	КонецЕсли;
	// вызов механизма разделения прав доступа
	СправочникОбъект = РеквизитФормыВЗначение("Объект");
	
	//бит_ПраваДоступа.ПередОткрытиемФормы(Отказ,СтандартнаяОбработка,СправочникОбъект,ЭтаФорма);
	
	Если Параметры.Свойство("НаДату") Тогда
		
		НаДату = Параметры.НаДату;
		
	Иначе
		
		НаДату = ТекущаяДата();
		
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		
		
	КонецЕсли;
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборы();
	ЗаполнитьТаблицуКомнат();
	ПосчитатьПлощади();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
