#КонецОбласти

#Область ДействияКомандФормы

//  Процедура - обработчик события "Нажатие" кнопки "Добавить" коммандной панели Формы.
//
&НаКлиенте
Процедура Добавить(Команда)

	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("мТекущаяСтрока",Неопределено);
	
	ФормаЭлемента = Неопределено;

	
	ОткрытьФорму("РегистрСведений.бит_ПениПоУслугамЖКХ.Форма.ФормаРедактированияУправляемая",Новый Структура("Добавить",ПараметрыФормы),ЭтаФорма,,,, Новый ОписаниеОповещения("ДобавитьЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    ФормаЭлемента = Результат;

КонецПроцедуры

//  Процедура - обработчик события "Нажатие" кнопки "Изменить" коммандной панели "ДействияФормы".
//
&НаКлиенте
Процедура ДействияФормыИзменить(Команда)
	
// Если установлен режим редактирования в диалоге, тогда.
Если Не мКэшЗначений.ТолькоПросмотр Тогда
	
	СтандартнаяОбработка = Ложь;
	
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Ключ",Элементы.Список.ТекущаяСтрока);
	
	ФормаЭлемента = Неопределено;

	
	ОткрытьФорму("РегистрСведений.бит_ПениПоУслугамЖКХ.Форма.ФормаРедактированияУправляемая",ПараметрыФормы,ЭтаФорма,,,, Новый ОписаниеОповещения("ДействияФормыИзменитьЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
Иначе	
	Элементы.Список.ИзменитьСтроку();
КонецЕсли;
		
	
	
КонецПроцедуры

&НаКлиенте
Процедура ДействияФормыИзменитьЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    ФормаЭлемента = Результат;

КонецПроцедуры

//  Процедура - обработчик события "Нажатие" кнопки "МонопольныйРежим" коммандной панели "ДействияФормы".
//
&НаКлиенте
Процедура УстановитьРежим(Команда)
	
	УстановитьМонопольный();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляСписок

//  Процедура - обработчик события "Выбор" табличного поля "Список"
//
&НаКлиенте
Процедура СписокВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Не мКэшЗначений.ТолькоПросмотр Тогда
		
		СтандартнаяОбработка = Ложь;
		
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ",ВыбраннаяСтрока);
		
		ФормаЭлемента = Неопределено;
		
		
		ОткрытьФорму("РегистрСведений.бит_ПениПоУслугамЖКХ.Форма.ФормаРедактированияУправляемая",ПараметрыФормы,Элемент,,,, Новый ОписаниеОповещения("СписокВыборЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВыборЗавершение(Результат, ДополнительныеПараметры) Экспорт
    
    ФормаЭлемента = Результат;

КонецПроцедуры

&НаСервере
Процедура УстановитьНадписьНаСервере(ТекстСообщения)
	
	НадписьИнформация  = ТекстСообщения;
	
КонецПроцедуры

#КонецОбласти