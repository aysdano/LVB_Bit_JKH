&НаКлиенте
Процедура ПодробнееФрагмент()
	
	Перем КлючЗаписиРегистра, ПараметрыМассив, ПередаваемыеПараметры, СтруктураРегистра;
	
	СтруктураРегистра = ПолучитьСтруктуруРегистраСведеенийФИОПроживающихНаСервере(Объект.Ссылка, Объект.Наименование);
	
	ПередаваемыеПараметры = Новый Структура;
	
	ПередаваемыеПараметры.Вставить("Период" , СтруктураРегистра.Период);
	ПередаваемыеПараметры.Вставить("ФизЛицо", Объект.Ссылка);
	
	Если КлючЗаписиФИОПроживающихСуществует(ПередаваемыеПараметры) Тогда
		
		ПараметрыМассив = Новый Массив;
		
		ПараметрыМассив.Добавить(ПередаваемыеПараметры); 
		
		КлючЗаписиРегистра = Новый("РегистрСведенийКлючЗаписи.бит_ФИОПроживающих", ПараметрыМассив); 
		
		ОткрытьФорму("РегистрСведений.бит_ФИОПроживающих.Форма.ФормаЗаписиДополнительнаяУправляемая", Новый Структура("Ключ", КлючЗаписиРегистра),,,,, Новый ОписаниеОповещения("ПодробнееЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
		
	Иначе
		
		ПередаваемыеПараметры.Вставить("Фамилия" , СтруктураРегистра.Фамилия);
		ПередаваемыеПараметры.Вставить("Имя"     , СтруктураРегистра.Имя);
		ПередаваемыеПараметры.Вставить("Отчество", СтруктураРегистра.Отчество);
		
		ОткрытьФорму("РегистрСведений.бит_ФИОПроживающих.Форма.ФормаЗаписиДополнительнаяУправляемая", Новый Структура("ЗаполнитьИзСправочникаПроживающие", ПередаваемыеПараметры), ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

