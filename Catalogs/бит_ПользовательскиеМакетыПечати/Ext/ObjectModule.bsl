#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура для сохранения файла в хранилище.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура СохранитьФайлХранилище(АдресФайлаВоВременномХранилище) Экспорт
	
	Попытка
		
		ДвоичныеДанные = ПолучитьИзВременногоХранилища(АдресФайлаВоВременномХранилище);
		ФайлХранилище = Новый ХранилищеЗначения(ДвоичныеДанные, Новый СжатиеДанных(9));
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры // ()

// Процедура получения файла из хранилища. 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ПолучитьФайлХранилище(ИдентификаторФормы) Экспорт
	
	Если ФайлХранилище = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	ДвоичныеДанные = ФайлХранилище.Получить();
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	АдресФайлаВоВременномХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанные, ИдентификаторФормы);
	
	Возврат АдресФайлаВоВременномХранилище;
	
КонецФункции // () 

#КонецОбласти

#КонецЕсли