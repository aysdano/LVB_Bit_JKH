Функция ПолучитьНачальноеСальдо(ЛС, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = &ГВ
	|				ТОГДА естьNULL(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток,0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ГВ,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = &ХВ
	|				ТОГДА естьNULL(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток,0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ХВ,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = &ВО
	|				ТОГДА естьNULL(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток,0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ВО,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = &ЭЭ
	|				ТОГДА естьNULL(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток,0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ЭЭ
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&Период, ЛицевойСчет = &ЛС) КАК бит_НачисленияПоУслугамЖКХОстатки";
	ВО     	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000005");
	ГВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000003");
	ХВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000004");
	ЭЭ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000002");
	
	Запрос.УстановитьПараметр("ВО", ВО);
	Запрос.УстановитьПараметр("ГВ", ГВ);
	Запрос.УстановитьПараметр("ХВ", ХВ);
	Запрос.УстановитьПараметр("ЭЭ", ЭЭ);
	
	Запрос.УстановитьПараметр("ЛС", ЛС);
	Запрос.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		Результат = Новый ТаблицаЗначений;
		Результат.Колонки.Добавить("ГВ");
		Результат.Колонки.Добавить("ХВ");
		Результат.Колонки.Добавить("ЭЭ");
		Результат.Колонки.Добавить("ВО");
		СтрокаРез = Результат.Добавить();
		СтрокаРез.ГВ = 0 ;
		СтрокаРез.ХВ = 0 ;
		СтрокаРез.ЭЭ = 0 ;
		СтрокаРез.ВО = 0 ;
	Иначе
		Результат = РезультатЗапроса.Выгрузить();
	КонецЕсли;
	
	ВОзврат Результат;
	
КонецФункции

Функция НайтиСтрокуРазовые(ДанныеРазовые, МассивУслуг)
	
	Если не ТипЗнч(МассивУслуг) = Тип("Массив") Тогда
		Возврат  ДанныеРазовые.Найти(МассивУслуг, "УслугаЖКХ"	);
	КонецЕсли;
	
	Для каждого Услуга Из МассивУслуг Цикл
		
		СтрокаРазовые = ДанныеРазовые.Найти(Услуга, "УслугаЖКХ"	);
		Если ЗначениеЗаполнено(СтрокаРазовые) Тогда
			Возврат СтрокаРазовые;
		КонецЕсли;
		
	КонецЦикла;
	
КонецФункции