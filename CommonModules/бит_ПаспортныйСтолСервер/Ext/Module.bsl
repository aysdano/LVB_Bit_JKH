// Функция находит актуальное значение телефона в контакной информации.
//
// Параметры:
//  Объект - СправочникСсылка, объект контактной информации.
//
// Возвращаемое значение:
//  Строка - представление найденного телефона.
//
Функция ПолучитьВебСтраницуИзКонтактнойИнформации(Объект) Экспорт
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.бит_Проживающие") Тогда
		Окончание = "Проживающего";
	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.бит_ПодразделенияОрганизаций") Тогда
		Окончание = "ПодразделенияОрганизации";
	ИначеЕсли ТипЗнч(Объект) = Тип("СправочникСсылка.бит_ОрганыФМС") Тогда
		Окончание = "ОрганаФМС";
	КонецЕсли;
	
	// БИТ_ЖКХ 24.11.2014{{
	Если Объект.КонтактнаяИнформация.Количество() > 0 Тогда
		//9.11.2018
//		ВидАдреса = Справочники.бит_ВидыКонтактнойИнформацииЖКХ["ВебСтраница" + Окончание];
		ВидАдреса = Справочники.ВидыКонтактнойИнформации["ВебСтраница" + Окончание];

		
		Отбор = Новый Структура();
		Отбор.Вставить("Вид",ВидАдреса);
		
		Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
		
		Если НЕ Строки.количество() = 0 Тогда
			
			Возврат Строки[0].Представление;
			
		Иначе
			
			ВидВебСтраницы = Справочники.бит_ВидыКонтактнойИнформации["ВебСтраница" + Окончание];
			
			Запрос = Новый Запрос;
			
			Запрос.УстановитьПараметр("Объект", Объект);
			Запрос.УстановитьПараметр("Тип"   , Перечисления.бит_ТипыКонтактнойИнформации.ВебСтраница);
			Запрос.УстановитьПараметр("Вид"   , ВидВебСтраницы);
			
			
			Запрос.Текст = "
			|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
			|	КонтактнаяИнформация.Представление
			|ИЗ
			|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
			|ГДЕ
			|	КонтактнаяИнформация.Объект = &Объект
			|	И
			|	КонтактнаяИнформация.Тип = &Тип
			|	И
			|	КонтактнаяИнформация.Вид = &Вид
			|";
			
			РезультатЗапроса = Запрос.Выполнить();
			
			Если РезультатЗапроса.Пустой() Тогда
				Возврат "";
			Иначе
				Возврат РезультатЗапроса.Выгрузить()[0].Представление;
			КонецЕсли;
			
		КонецЕсли;
		
	Иначе
		
		ВидВебСтраницы = Справочники.бит_ВидыКонтактнойИнформации["ВебСтраница" + Окончание];
		
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("Объект", Объект);
		Запрос.УстановитьПараметр("Тип"   , Перечисления.бит_ТипыКонтактнойИнформации.ВебСтраница);
		Запрос.УстановитьПараметр("Вид"   , ВидВебСтраницы);
		
		
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И
		|	КонтактнаяИнформация.Тип = &Тип
		|	И
		|	КонтактнаяИнформация.Вид = &Вид
		|";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат "";
		Иначе
			Возврат РезультатЗапроса.Выгрузить()[0].Представление;
		КонецЕсли;
		
	КонецЕсли;
	// БИТ_ЖКХ 24.11.2014}}
	
