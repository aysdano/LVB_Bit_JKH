Процедура ЗаполнитьОбработанныеОстатки(Услуга)
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Услуга",Услуга);
	Запрос.УстановитьПараметр("Дата",КонецГода(Объект.Дата)+1);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток КАК СуммаОстаток,
		|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет.Представление КАК ИмяЛС
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&Дата, УслугаЖКХ = &Услуга) КАК бит_НачисленияПоУслугамЖКХОстатки";
	мУжеОбработанныеОбъекты = Запрос.Выполнить().Выгрузить();	
	мУжеОбработанныеОбъекты.Индексы.Добавить("ЛицевойСчет");
	мУжеОбработанныеОбъекты.Индексы.Добавить("ИмяЛС");
