			Выборка = ВыборкаПоПериоду.Выбрать();
			НачРасПериода = ?(Месяц(НачРасПериода) = Месяц(ВыборкаПоПериоду.ПериодНачисления),НачРасПериода , НачалоМесяца(ВыборкаПоПериоду.ПериодНачисления));
			
			Пока Выборка.Следующий()  Цикл 
				
				КолвоДней        = РазностьДатВДнях(?(НачалоДня(ВыборкаПоПериоду.ПериодНачисления)> НачалоДня(КонПериода),КонПериода,ВыборкаПоПериоду.ПериодНачисления),НачРасПериода);
				КолвоДнейВМесяце = РазностьДатВДнях(ВыборкаПоПериоду.ПериодНачисления,НачалоМесяца(НачРасПериода));
				
				НоваяСтрока = ТаблицаСбора.Добавить();
				
				НоваяСтрока.ЛицевойСчет = Выборка.ЛицевойСчет;
				НоваяСтрока.Услуга      = Выборка.Услуга;
				
				НоваяСтрока.Сумма       = ОКР(Выборка.Сумма  *  ПроцентНеДопоставки/100 * КолвоДней/КолвоДнейВМесяце,2);
				
			КонецЦикла;
			
			НачРасПериода =  НачалоМесяца(ДобавитьМесяц(НачРасПериода ,1));
			
		КонецЦикла;
		
		ТаблицаСбора.Свернуть("ЛицевойСчет,Услуга","Сумма");
		
		Отбор = Новый Структура;
		
		Для Каждого ТекСтрока Из  ТаблицаСбора  Цикл
			
			Отбор.Очистить();
			Отбор.Вставить("ЛицевойСчет", ТекСтрока.ЛицевойСчет);
			Отбор.Вставить("Услуга"     , ТекСтрока.Услуга);
			
			НайденныеСтроки = СписокУслуг.НайтиСтроки(Отбор);
			
			Для каждого Строка Из НайденныеСтроки Цикл
				
				Сумма = ?(ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое, -ТекСтрока.Сумма, ТекСтрока.Сумма);
				
				Если ЗначениеЗаполнено(КолЧасовНедопоставки) Тогда
					
					Сумма = (Сумма * КолЧасовНедопоставки)/24;
					
				КонецЕсли;
				
				Строка.Сумма = Сумма;
				
			КонецЦикла;
			
		КонецЦикла;
		
	ИначеЕсли ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчика
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчику Тогда 
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СписокУслуг.Услуга
		|ПОМЕСТИТЬ СписокУслуг
		|ИЗ
		|	&СписокУслуг КАК СписокУслуг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаНачислений.ПериодНачисления КАК ПериодНачисления,
		|	СписокУслуг.Услуга,
		|	ТаблицаНачислений.Сумма1 КАК Сумма
		|ИЗ
		|	СписокУслуг КАК СписокУслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КОНЕЦПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК ПериодНачисления,
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ,
		|			СУММА(ЕСТЬNULL(ВЫБОР
		|						КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
		|							ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|					КОНЕЦ, 0)) КАК Сумма1
		|		ИЗ
		|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачПериода, &КонПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОбороты
		|		
		|		СГРУППИРОВАТЬ ПО
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
		|			КОНЕЦПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ)) КАК ТаблицаНачислений
		|		ПО СписокУслуг.Услуга = ТаблицаНачислений.УслугаЖКХ
		|ИТОГИ ПО
		|	ПериодНачисления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СписокУслуг";
		
		
		Запрос.УстановитьПараметр("НачПериода"            ,Новый Граница(НачалоМесяца(НачПериода), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КонПериода"            ,Новый Граница(КонецМесяца(КонПериода), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ЛицевойСчет"           ,ЛицевойСчет);
		Запрос.УстановитьПараметр("СписокУслуг"           ,СписокУслуг);
		ВыборкаПоПериоду =  Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ПериодНачисления");
		НачРасПериода = НачПериода;
		ТаблицаСбора = Новый ТаблицаЗначений;
		ТаблицаСбора = СписокУслуг.ВыгрузитьКолонки();
		
		Пока ВыборкаПоПериоду.Следующий()  Цикл 
			
			Выборка = ВыборкаПоПериоду.Выбрать();
			НачРасПериода = ?(Месяц(НачРасПериода) = Месяц(ВыборкаПоПериоду.ПериодНачисления),НачРасПериода , НачалоМесяца(ВыборкаПоПериоду.ПериодНачисления));
			
			Пока Выборка.Следующий()  Цикл 
				КолвоДней        = РазностьДатВДнях(?(НачалоДня(ВыборкаПоПериоду.ПериодНачисления)> НачалоДня(КонПериода),КонПериода,ВыборкаПоПериоду.ПериодНачисления),НачРасПериода);
				КолвоДнейВМесяце = РазностьДатВДнях(ВыборкаПоПериоду.ПериодНачисления,НачалоМесяца(НачРасПериода));
				НоваяСтрока = ТаблицаСбора.Добавить();
				НоваяСтрока.Услуга = Выборка.Услуга;
				НоваяСтрока.Сумма  = Выборка.Сумма  *  ПроцентНеДопоставки/100 * КолвоДней/КолвоДнейВМесяце;
			КонецЦикла;
			
			НачРасПериода =  НачалоМесяца(ДобавитьМесяц(НачРасПериода ,1));
			
		КонецЦикла;
		
		ТаблицаСбора.Свернуть("Услуга,Объем","Сумма");
		
		Для Каждого ТекСтрока Из  ТаблицаСбора  Цикл 
			НайденнаяСтрока = СписокУслуг.Найти(ТекСтрока.Услуга, "Услуга");
