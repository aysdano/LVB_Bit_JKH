&НаКлиенте
Процедура УказатьДляВыбранных(Команда)
	
    // Нестабильный функционал.
	Реквизит = Элементы.РеквизитыОбъектаМетаданных.ТекущийЭлемент;
	ИмяРеквизита = Реквизит.Имя;
	Если ЗначениеЗаполнено(ИмяРеквизита)
		И НЕ Реквизит.ТолькоПросмотр Тогда
		ВыбЗнач = Неопределено;
		мИмяРеквизита = СтрЗаменить(ИмяРеквизита,"РеквизитыОбъектаМетаданных",""); // Удаляем лишнее.
		ТекДанные = Элементы.РеквизитыОбъектаМетаданных.ТекущиеДанные;
		ТипТекЗначения = ТипЗнч(ТекДанные[мИмяРеквизита]);
		ОписаниеОповещения = Новый ОписаниеОповещения("УказатьДляВыбранныхЗавершение", ЭтотОбъект, Элементы.РеквизитыОбъектаМетаданных.ВыделенныеСтроки);
		
		НазваниеРеквизита = ПолучитьЗаголовок(мИмяРеквизита, Объект.ДоступныеРеквизиты);
		ПоказатьВводЗначения(ОписаниеОповещения, ВыбЗнач, "Введите значение '" + НазваниеРеквизита + "':", ТипТекЗначения);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УказатьДляВыбранныхЗавершение(ВыбЗнач, Параметры) Экспорт
	
	Для Каждого Элт Из Параметры Цикл
		Стр = РеквизитыОбъектаМетаданных.НайтиПоИдентификатору(Элт);
		Если Стр = Неопределено Тогда
			Продолжить;	
		КонецЕсли;
		Стр[мИмяРеквизита] = ВыбЗнач; 
		Стр.ЭлтИзменен = Истина
	КонецЦикла;
	
	Модифицированность = Истина;
	Элементы.ФормаЗаписать.Доступность = Истина;
	
