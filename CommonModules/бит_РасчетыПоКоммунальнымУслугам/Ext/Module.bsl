	|	ПоказанияСчетчиков.ИспользоватьСтавкуПоСчетчику КАК ИспользоватьСтавкуПоСчетчику,
	|	ПоказанияСчетчиков.СпособРасчетаУменьшения КАК СпособРасчетаУменьшения,
	|	ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних1.ОсновнаяСтавка, 0) КАК ОсновнаяСтавка,
	|	ПоказанияСчетчиков.ИспользоватьПравилоУменьшения,
	|	ТаблицаСведенийПоЛС.КоличествоЕдиницПотребления,
	|	ТаблицаСведенийПоЛС.ЖилаяПлощадь,
	|	ТаблицаСведенийПоЛС.ОбщаяПлощадь,
	|	ТаблицаСведенийПоЛС.ОтапливаемаяПлощадь,
	|	ТаблицаПроживающих.КоличествоПроживающих
	|ИЗ
	|	ПоказанияСчетчиков КАК ПоказанияСчетчиков
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНорм КАК ТаблицаНорм
	|		ПО ПоказанияСчетчиков.ЛицевойСчет = ТаблицаНорм.ЛицевойСчет
	|			И ПоказанияСчетчиков.Услуга = ТаблицаНорм.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаПроживающих КАК ТаблицаПроживающих
	|		ПО ПоказанияСчетчиков.ЛицевойСчет = ТаблицаПроживающих.ЛицевойСчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСведенийПоЛС КАК ТаблицаСведенийПоЛС
	|		ПО ПоказанияСчетчиков.ЛицевойСчет = ТаблицаСведенийПоЛС.ЛицевойСчет
	|			И ПоказанияСчетчиков.Услуга = ТаблицаСведенийПоЛС.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&Момент, СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)) КАК бит_СтавкиНаУслугиСрезПоследних
	|		ПО ПоказанияСчетчиков.Услуга = бит_СтавкиНаУслугиСрезПоследних.Услуга
	|			И ПоказанияСчетчиков.Поставщик = бит_СтавкиНаУслугиСрезПоследних.Поставщик
	|			И ПоказанияСчетчиков.СтатусКвартиры = бит_СтавкиНаУслугиСрезПоследних.СтатусКвартиры
	|			И ПоказанияСчетчиков.ТипКвартиры = бит_СтавкиНаУслугиСрезПоследних.ТипКвартиры
	|			И ПоказанияСчетчиков.РежимПотребления = бит_СтавкиНаУслугиСрезПоследних.РежимПотребления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(
	|				&Момент,
	|				Услуга В
	|						(ВЫБРАТЬ
	|							ТаблицаСведенийПоЛС.Услуга
	|						ИЗ
	|							ТаблицаСведенийПоЛС)
	|					И Поставщик В
	|						(ВЫБРАТЬ
	|							ТаблицаСведенийПоЛС.Поставщик
	|						ИЗ
	|							ТаблицаСведенийПоЛС)
	|					И РежимПотребления В
	|						(ВЫБРАТЬ
	|							ТаблицаСведенийПоЛС.РежимПотребления
	|						ИЗ
	|							ТаблицаСведенийПоЛС)
	|					И СпособРасчета В
	|						(ВЫБРАТЬ
	|							ПоказанияСчетчиков.СпособРасчетаУменьшения
	|						ИЗ
	|							ПоказанияСчетчиков)
	|					И СтатусКвартиры В
	|						(ВЫБРАТЬ
	|							ТаблицаСведенийПоЛС.СтатусКвартиры
	|						ИЗ
	|							ТаблицаСведенийПоЛС)
	|					И ТипКвартиры В
	|						(ВЫБРАТЬ
	|							ТаблицаСведенийПоЛС.ТипКвартиры
	|						ИЗ
	|							ТаблицаСведенийПоЛС)) КАК бит_СтавкиНаУслугиСрезПоследних1
	|		ПО ПоказанияСчетчиков.Поставщик = бит_СтавкиНаУслугиСрезПоследних1.Поставщик
	|			И ПоказанияСчетчиков.СтатусКвартиры = бит_СтавкиНаУслугиСрезПоследних1.СтатусКвартиры
	|			И ПоказанияСчетчиков.ТипКвартиры = бит_СтавкиНаУслугиСрезПоследних1.ТипКвартиры
	|			И ПоказанияСчетчиков.РежимПотребления = бит_СтавкиНаУслугиСрезПоследних1.РежимПотребления
	|			И ПоказанияСчетчиков.Услуга = бит_СтавкиНаУслугиСрезПоследних1.Услуга
	|			И ПоказанияСчетчиков.СпособРасчетаУменьшения = бит_СтавкиНаУслугиСрезПоследних1.СпособРасчета
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛицевойСчет
	|ИТОГИ
	|	МАКСИМУМ(КоличествоЕдиниц),
	|	МАКСИМУМ(ПлановаяСтавкаДо),
	|	МАКСИМУМ(ПлановаяСтавка),
	|	СУММА(ДоляЛС),
	|	СУММА(ДоляЛСФакт),
	|	МАКСИМУМ(ПлановаяСтавкаПоСч),
	|	МАКСИМУМ(ИспользоватьСтавкуПоСчетчику),
	|	МАКСИМУМ(ОсновнаяСтавка)
	|ПО
	|	Услуга,
	|	Счетчик";
	
	ТаблицаПогрешностей = Новый ТаблицаЗначений;
	ТаблицаПогрешностей.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаПогрешностей.Колонки.Добавить("Услуга"     , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	ТаблицаПогрешностей.Колонки.Добавить("Сумма"      , ОбщегоНазначения.ОписаниеТипаЧисло(15,4));
	
	Результат    = Запрос.Выполнить();
	
	ТЗРезультат    = Результат.Выгрузить();
	
	ВыборкаУслуг = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаУслуг.Следующий() Цикл
		
		ВыборкаСчетчик = ВыборкаУслуг.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСчетчик.Следующий() Цикл  
			
			ТаблицаПогрешностей.Очистить();
			
			//МассивУслуг   = Новый Массив;
			ИтогСумма     = 0;
			ПлановаяСумма = 0;
			Счетчик       = ВыборкаСчетчик.Счетчик;
			
			СтавкаПоСчетчику = ?(ВыборкаСчетчик.ИспользоватьСтавкуПоСчетчику, ВыборкаСчетчик.ПлановаяСтавкаПоСч, ВыборкаСчетчик.ПлановаяСтавка);
			
			// БИТ_ЖКХ_23082013_начало_изменений
			СтавкаПоСчетчикуДо = ?(ВыборкаСчетчик.ИспользоватьСтавкуПоСчетчику, ВыборкаСчетчик.ПлановаяСтавкаПоСч, ВыборкаСчетчик.ПлановаяСтавкаДо);
			ИтогСуммаДо        = 0;
			СуммаДляОбъема = 0;
			ПлановаяСуммаДо    = Окр(ВыборкаСчетчик.КоличествоЕдиниц*СтавкаПоСчетчикуДо,4,1);
			// БИТ_ЖКХ_23082013_окончание_изменений
			
			// БИТ_ЖКХ 13.05.2014
			//ПлановаяСумма = Окр(ВыборкаСчетчик.КоличествоЕдиниц*СтавкаПоСчетчику,4,1);
			ПлановаяСумма = Окр(ВыборкаСчетчик.КоличествоЕдиниц*СтавкаПоСчетчику,2,1);
			// БИТ_ЖКХ 13.05.2014
			
			Выборка = ВыборкаСчетчик.Выбрать();
			
			Пока Выборка.Следующий() Цикл 
				
					Если ВыборкаСчетчик.ДоляЛС = 0 Тогда
						
						Единицы   = 0;
						Сумма     = 0;
						// БИТ_ЖКХ 02.12.2020
						СуммаДляОбъема = 0;
						
					Иначе
						Единицы 	= Окр(Выборка.КоличествоЕдиниц*Выборка.ДоляЛС/ВыборкаСчетчик.ДоляЛС,4,1); 
						// БИТ_ЖКХ_01102013_начало_изменений
						//Сумма 		= Окр(Единицы*СтавкаПоСчетчику,2,1);
						
						Сумма                 = Окр(Выборка.КоличествоЕдиниц*Выборка.ДоляЛС/ВыборкаСчетчик.ДоляЛС*СтавкаПоСчетчику,2,1);
						// БИТ_ЖКХ 24.11.2020
						СуммаДляОбъема        = Окр(Выборка.КоличествоЕдиниц*Выборка.ДоляЛС/ВыборкаСчетчик.ДоляЛС*СтавкаПоСчетчику,4,1);
						

						
						//// БИТ_ЖКХ 02.12.2014{{	
						//Если Единицы <= Выборка.Норма Тогда
						//	расчНорма  = Единицы;
						//	СверхНорма = 0;
						//Иначе
						//	расчНорма  = Выборка.Норма;
						//	СверхНорма = Единицы - Выборка.Норма;
						//КонецЕсли;
						//Норма = Выборка.Норма - расчНорма;
						//Начислено  = расчНорма * Выборка.Ставка + СверхНорма * Выборка.СверхномСтавка;
						//Сумма 		= Окр(Начислено,2,1);
						//// БИТ_ЖКХ 02.12.2014}}
						
						// БИТ_ЖКХ_01102013_окончание_изменений
						
						ИтогСумма 	= ИтогСумма + Сумма;
						
						// БИТ_ЖКХ_26082013_начало_изменений
						ИтогСуммаДо = ИтогСуммаДо + Окр(Выборка.КоличествоЕдиниц*Выборка.ДоляЛС/ВыборкаСчетчик.ДоляЛС*СтавкаПоСчетчикуДо,4,1);
						// БИТ_ЖКХ_26082013_окончание_изменений
					КонецЕсли; 
					
					//КонецЕсли; 
					
				//КонецЕсли; 
				
				СтрокаПогрешности = ТаблицаПогрешностей.Добавить();
				СтрокаПогрешности.ЛицевойСчет = Выборка.ЛицевойСчет;
				СтрокаПогрешности.Услуга      = Выборка.Услуга;
				СтрокаПогрешности.Сумма       = Сумма;
				
				Если СписокЛС.Найти(Выборка.ЛицевойСчет) = Неопределено   Тогда
					Продолжить;
				КонецЕсли;
				
				НовСтрока = ТаблицаСчетчиков.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
				НовСтрока.КоличествоЕдиницПоЛС = Единицы;
				НовСтрока.КоличествоЕдиниц     = Выборка.КоличествоЕдиниц;
				НовСтрока.Факт                 = Единицы;
				НовСтрока.СпособРасчета        = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам;
				// БИТ_ЖКХ 24.05.2017 11:33:05 Начало правки...
				//НовСтрока.Начислено            = Сумма;
				//НовСтрока.Норматив             = ?(НовСтрока.Начислено <= Выборка.Норматив, НовСтрока.Начислено, Выборка.Норматив);
				Если ЭтоЛС Тогда
					НовСтрока.Начислено			= 0;
					НовСтрока.Норматив			= 0;
				Иначе	
					НовСтрока.Начислено			= Сумма;
					НовСтрока.Норматив			= ?(НовСтрока.Начислено <= Выборка.Норматив, НовСтрока.Начислено, Выборка.Норматив);
				КонецЕсли;
				// БИТ_ЖКХ 24.05.2017 11:33:05 Конец правки.
				
				НовСтрока.Доля                 = ВыборкаСчетчик.ДоляЛСФакт;
				НовСтрока.ДоляПоЛС             = Выборка.ДоляЛСФакт;
				//НовСтрока.Ставка               = Выборка.ПлановаяСтавка;
				НовСтрока.Ставка               = СтавкаПоСчетчику;
				
				// БИТ_ЖКХ 04.12.2014{{
				Если Выборка.ИспользоватьПравилоУменьшения Тогда
					
					НовСтрока.ОсновнойСпособРасчета        = Выборка.СпособРасчетаУменьшения;
					
				КонецЕсли;
				// БИТ_ЖКХ 04.12.2014}}
				
				
				// БИТ_ЖКХ 24.05.2017 11:33:58 Начало правки... 
				//// БИТ_ЖКХ_23082013_начало_изменений
				//Если ВыборкаСчетчик.ДоляЛС = 0 Тогда
				Если ВыборкаСчетчик.ДоляЛС = 0 ИЛИ ЭтоЛС Тогда
				// БИТ_ЖКХ 24.05.2017 11:34:04 Конец правки. 		
						НовСтрока.НачисленоДо = 0;
					Иначе
						НовСтрока.НачисленоДо = Окр(Выборка.КоличествоЕдиниц*Выборка.ДоляЛС/ВыборкаСчетчик.ДоляЛС*СтавкаПоСчетчикуДо,4,1);
					КонецЕсли;
					// БИТ_ЖКХ_23082013_окончание_изменений
				
				Если НЕ Выборка.Тариф = 0 Тогда
                    // БИТ_ЖКХ 02.03.2017 14:51:49 Начало правки...
					//НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,4);
					//Если РасчетОбъемовДоТретьегоЗнака Тогда
					//	НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,3);
					//Иначе
					//	НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,4);
					//КонецЕсли;
					// БИТ_ЖКХ 02.03.2017 14:51:49 Конец правки.
					// БИТ_ЖКХ 24.11.2020
					Если РасчетОбъемовДоТретьегоЗнака Тогда
						НовСтрока.Объем = Окр(СуммаДляОбъема/Выборка.Тариф,3);
					Иначе
						НовСтрока.Объем = Окр(СуммаДляОбъема/Выборка.Тариф,4);
					КонецЕсли;

				КонецЕсли;
				// БИТ_ЖКХ_28082013_начало_изменений
				Если НЕ Выборка.ТарифДо = 0 Тогда
					
						Если НЕ ВыборкаСчетчик.ДоляЛС = 0 Тогда
							
							НовСтрока.ОбъемДо = Окр(Окр(Выборка.КоличествоЕдиниц*Выборка.ДоляЛС/ВыборкаСчетчик.ДоляЛС*СтавкаПоСчетчикуДо,4,1)/Выборка.ТарифДо,4);
							
						КонецЕсли;
					//КонецЕсли;
					
				КонецЕсли; 
				// БИТ_ЖКХ_28082013_окончание_изменений
			КонецЦикла;
			
			//Если НЕ ЭтоЛС Тогда
			Погрешность = ПлановаяСумма - ИтогСумма;
			
			Если Погрешность <> 0 Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("Счетчик", ВыборкаСчетчик.Счетчик);
				ТаблицаПогрешностей.Сортировать("Сумма Убыв");
				Если ТаблицаПогрешностей.Количество() > 0 Тогда
					
					Отбор.Вставить("ЛицевойСчет", ТаблицаПогрешностей[0].ЛицевойСчет);
					Отбор.Вставить("Услуга"     , ТаблицаПогрешностей[0].Услуга);
					
					Строки = ТаблицаСчетчиков.НайтиСтроки(Отбор);
					Если Строки.Количество() > 0 тогда 
						Строки[0].Начислено = Строки[0].Начислено + Погрешность;
						// БИТ_ЖКХ_26082013_начало_изменений
						Если НЕ Строки[0].Тариф = 0 Тогда
							// БИТ_ЖКХ 02.03.2017 16:06:33 Начало правки...
							//Строки[0].Объем = Окр(Строки[0].Начислено/Строки[0].Тариф,4);
							Если РасчетОбъемовДоТретьегоЗнака Тогда
								Строки[0].Объем = Окр(Строки[0].Начислено/Строки[0].Тариф,3);
							Иначе
								Строки[0].Объем = Окр(Строки[0].Начислено/Строки[0].Тариф,4);
							КонецЕсли;
							// БИТ_ЖКХ 02.03.2017 16:06:33 Конец правки.
						КонецЕсли;
						// БИТ_ЖКХ_26082013_начало_изменений
					КонецЕсли;
					
				КонецЕсли; 
			КонецЕсли;
			//КонецЕсли;
			
			// БИТ_ЖКХ_26082013_начало_изменений
			ПогрешностьДо = ПлановаяСуммаДо - ИтогСуммаДо;
			
			Если ПогрешностьДо <> 0 Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("Счетчик", ВыборкаСчетчик.Счетчик);
				ТаблицаПогрешностей.Сортировать("Сумма Убыв");
				Если ТаблицаПогрешностей.Количество() > 0 Тогда
					
					Отбор.Вставить("ЛицевойСчет", ТаблицаПогрешностей[0].ЛицевойСчет);
					Отбор.Вставить("Услуга"     , ТаблицаПогрешностей[0].Услуга);
					
					Строки = ТаблицаСчетчиков.НайтиСтроки(Отбор);
					Если Строки.Количество() > 0 тогда 
						Строки[0].НачисленоДо = Строки[0].НачисленоДо + ПогрешностьДо;
						
						Если НЕ Строки[0].Тариф = 0 Тогда
							// БИТ_ЖКХ 02.03.2017 16:19:38 Начало правки...
							//Строки[0].Объем = Окр(Строки[0].Начислено/Строки[0].Тариф,4);
							Если РасчетОбъемовДоТретьегоЗнака Тогда
								Строки[0].Объем = Окр(Строки[0].Начислено/Строки[0].Тариф,3);
							Иначе
								Строки[0].Объем = Окр(Строки[0].Начислено/Строки[0].Тариф,4);
							КонецЕсли;
							// БИТ_ЖКХ 02.03.2017 16:19:38 Конец правки.
						КонецЕсли;
						
					КонецЕсли;
					
				КонецЕсли; 
			КонецЕсли;
			// БИТ_ЖКХ_26082013_окончание_изменений
			
		КонецЦикла;
		
	КонецЦикла;
	
	ОбъектСравнения = Новый СравнениеЗначений;
	ТаблицаСчетчиков.Сортировать("ЛицевойСчет Возр, Приоритет Убыв", ОбъектСравнения);
	
КонецПроцедуры

// Процедура выполняет расчет начислений по Распределениям.
//
Процедура РасчитатьНачисленияПоРаспределений(СписокЛС, ТаблицаРаспределений, Запрос, ЭтоЛС = Ложь, РасчетОбъемовДоТретьегоЗнака = Ложь)
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоказанияСчетчиков.ЛицевойСчет КАК ЛицевойСчет,
	|	ПоказанияСчетчиков.Услуга КАК Услуга,
	|	ПоказанияСчетчиков.Распределение КАК Распределение,
	|	ЕСТЬNULL(ПоказанияСчетчиков.КоличествоЕдиниц, 0) КАК КоличествоЕдиниц,
	// БИТ_ЖКХ 31.08.2017 15:03:35 Начало правки... 
	|	ЕСТЬNULL(ТаблицаНорм.СтавкаНДС, ЗНАЧЕНИЕ(Перечисление.СтавкиНДС.БезНДС)) КАК СтавкаНДС,
	// БИТ_ЖКХ 31.08.2017 15:03:37 Конец правки. 
	|	ТаблицаНорм.Приоритет,
	|	ТаблицаНорм.СпособРасчета,
	|	ЕСТЬNULL(ТаблицаНорм.Ставка, 0) КАК Ставка,
	|	ЕСТЬNULL(ТаблицаНорм.СверхномСтавка, 0) КАК СверхномСтавка,
	|	ЕСТЬNULL(ТаблицаНорм.ПлановаяСтавка, 0) КАК ПлановаяСтавка,
	|	ЕСТЬNULL(ТаблицаНорм.Норма, 0) КАК Норма,
	|	ЕСТЬNULL(ТаблицаНорм.СверхНорма, 0) КАК СверхНорма,
	|	ЕСТЬNULL(ТаблицаНорм.Норматив, 0) КАК Норматив,
	|	ЕСТЬNULL(ТаблицаНорм.НормаЛьготы, 0) КАК НормаЛьготы,
	|	ТаблицаНорм.Поставщик,
	|	ТаблицаНорм.ПолучательДенежныхСредств,
	|	ЕСТЬNULL(ТаблицаНорм.Сальдо, 0) КАК Сальдо,
	|	ЕСТЬNULL(ТаблицаНорм.СальдоНаНачало, 0) КАК СальдоНаНачало,
	|	ЕСТЬNULL(ТаблицаНорм.СальдоПени, 0) КАК СальдоПени,
	|	ЕСТЬNULL(ТаблицаНорм.Оплата, 0) КАК Оплата,
	|	ЕСТЬNULL(ТаблицаНорм.Разовые, 0) КАК Разовые,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади)
	|				ТОГДА ЕСТЬNULL(ТаблицаСведенийПоЛС.ОтапливаемаяПлощадь, 0) * ЕСТЬNULL(ТаблицаНорм.ОсновнаяСтавка, 0)
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади)
	|						ТОГДА ЕСТЬNULL(ТаблицаСведенийПоЛС.ОбщаяПлощадь, 0) * ЕСТЬNULL(ТаблицаНорм.ОсновнаяСтавка, 0)
	|					ИНАЧЕ ВЫБОР
	|							КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади)
	|								ТОГДА ЕСТЬNULL(ТаблицаСведенийПоЛС.ЖилаяПлощадь, 0) * ЕСТЬNULL(ТаблицаНорм.ОсновнаяСтавка, 0)
	|							ИНАЧЕ ВЫБОР
	|									КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоПроживающим)
	|										ТОГДА ТаблицаПроживающих.КоличествоПроживающих * ЕСТЬNULL(ТаблицаНорм.ОсновнаяСтавка, 0)
	|									ИНАЧЕ ВЫБОР
	|											КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления)
	|													ИЛИ ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет)
	|												ТОГДА ЕСТЬNULL(ТаблицаСведенийПоЛС.КоличествоЕдиницПотребления, 0) * ЕСТЬNULL(ТаблицаНорм.ОсновнаяСтавка, 0)
	|										КОНЕЦ
	|								КОНЕЦ
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОНЕЦ, 0) КАК ДоляЛС,
	|	ЕСТЬNULL(ТаблицаНорм.ОсновнаяСтавка, 0) КАК ОсновнаяСтавка,
	|	ТаблицаСведенийПоЛС.ОсновнойСпособРасчета,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади)
	|				ТОГДА ЕСТЬNULL(ТаблицаСведенийПоЛС.ОтапливаемаяПлощадь, 0)
	|			ИНАЧЕ ВЫБОР
	|					КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади)
	|						ТОГДА ЕСТЬNULL(ТаблицаСведенийПоЛС.ОбщаяПлощадь, 0)
	|					ИНАЧЕ ВЫБОР
	|							КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади)
	|								ТОГДА ЕСТЬNULL(ТаблицаСведенийПоЛС.ЖилаяПлощадь, 0)
	|							ИНАЧЕ ВЫБОР
	|									КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоПроживающим)
	|										ТОГДА ЕСТЬNULL(ТаблицаПроживающих.КоличествоПроживающих, 0)
	|									ИНАЧЕ ВЫБОР
	|											КОГДА ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления)
	|													ИЛИ ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет)
	|												ТОГДА ЕСТЬNULL(ТаблицаСведенийПоЛС.КоличествоЕдиницПотребления, 0)
	|										КОНЕЦ
	|								КОНЕЦ
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОНЕЦ, 0) КАК ДоляЛСФакт,
	|	ЕСТЬNULL(ТаблицаНорм.Тариф, 0) КАК Тариф
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|		бит_РаспределенияНаУслугахСрезПоследних.Услуга КАК Услуга,
	|		бит_РаспределенияНаУслугахСрезПоследних.Распределение КАК Распределение,
	|		бит_РаспределенияОстатки.СуммаОстаток КАК КоличествоЕдиниц
	|	ИЗ
	|		РегистрСведений.бит_РаспределенияНаУслугах.СрезПоследних(
	|				&Момент,
	|				Объект В (&СписокЗданий)
	|					И ЛицевойСчет В (&СписокЛС)) КАК бит_РаспределенияНаУслугахСрезПоследних
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_Распределения.Остатки(&Момент, Объект В (&СписокЗданий)) КАК бит_РаспределенияОстатки
	|			ПО бит_РаспределенияНаУслугахСрезПоследних.Объект = бит_РаспределенияОстатки.Объект
	|				И бит_РаспределенияНаУслугахСрезПоследних.Услуга = бит_РаспределенияОстатки.Услуга
	|				И бит_РаспределенияНаУслугахСрезПоследних.Распределение = бит_РаспределенияОстатки.Распределение
	|	ГДЕ
	|		бит_РаспределенияНаУслугахСрезПоследних.Использовать = ИСТИНА) КАК ПоказанияСчетчиков
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНорм КАК ТаблицаНорм
	|		ПО ПоказанияСчетчиков.ЛицевойСчет = ТаблицаНорм.ЛицевойСчет
	|			И ПоказанияСчетчиков.Услуга = ТаблицаНорм.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаПроживающих КАК ТаблицаПроживающих
	|		ПО ПоказанияСчетчиков.ЛицевойСчет = ТаблицаПроживающих.ЛицевойСчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаСведенийПоЛС КАК ТаблицаСведенийПоЛС
	|		ПО ПоказанияСчетчиков.ЛицевойСчет = ТаблицаСведенийПоЛС.ЛицевойСчет
	|			И ПоказанияСчетчиков.Услуга = ТаблицаСведенийПоЛС.Услуга
	|ИТОГИ
	|	СУММА(ДоляЛС),
	|	СУММА(ДоляЛСФакт)
	|ПО
	|	Услуга,
	|	Распределение,
	|	ЛицевойСчет";
	
	ТаблицаПогрешностей = Новый ТаблицаЗначений;
	ТаблицаПогрешностей.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаПогрешностей.Колонки.Добавить("Сумма"      , ОбщегоНазначения.ОписаниеТипаЧисло(15,4));
	
	ВыборкаУслуг  = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаУслуг.Следующий() Цикл
		
		ВыборкаРасп = ВыборкаУслуг.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаРасп.Следующий() Цикл 
			
			ТаблицаПогрешностей.Очистить();
			
			МассивУслуг  = Новый Массив;
			ИтогСумма     = 0;
			ПлановаяСумма = 0;
			Распределение = ВыборкаРасп.Распределение;
			
			ВыборкаЛС = ВыборкаРасп.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаЛС.Следующий() Цикл 
				
				Выборка = ВыборкаЛС.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					Если ВыборкаРасп.ДоляЛС = 0 Тогда
						
						Индекс = МассивУслуг.Найти(Выборка.Услуга);
						Значение = ?(Индекс = Неопределено, Неопределено, МассивУслуг.Получить(Индекс));
						
						Если Значение <> Выборка.Услуга Тогда						
							Текст = " Установите ставку для услуги """ + Выборка.Услуга + """ по способу расчета ""по распределению"". Распределение: """+ Выборка.Распределение +""".";
							
							бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Текст);
							
							МассивУслуг.Добавить(Выборка.Услуга);
							
						КонецЕсли;
						
						Единицы   = 0;
						Сумма     = 0;
						
					Иначе
						
						Единицы 	= Окр(Выборка.КоличествоЕдиниц*Выборка.ДоляЛС/ВыборкаРасп.ДоляЛС,4,1); 
						
						// БИТ_ЖКХ 27.05.2014
						// Сумма 		= Окр(Единицы*Выборка.ПлановаяСтавка,4,1);.
						Сумма 		= Окр(Единицы*Выборка.ПлановаяСтавка,2,1);
						// БИТ_ЖКХ 27.05.2014
						
						ИтогСумма 	= ИтогСумма + Сумма;
						
					КонецЕсли; 
					
					Если СписокЛС.Найти(Выборка.ЛицевойСчет) = Неопределено   Тогда
						
						Продолжить;
						
					КонецЕсли;
					
					СтрокаПогрешности = ТаблицаПогрешностей.Добавить();
					СтрокаПогрешности.ЛицевойСчет = Выборка.ЛицевойСчет;
					СтрокаПогрешности.Сумма       = Сумма;
					
					МассивСтрок = ТаблицаРаспределений.НайтиСтроки(Новый Структура("ЛицевойСчет,Услуга",Выборка.ЛицевойСчет,Выборка.Услуга));
					
					Если МассивСтрок.количество() = 0 тогда	
						
						НовСтрока = ТаблицаРаспределений.Добавить();
						ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
						НовСтрока.КоличествоЕдиниц     = Выборка.КоличествоЕдиниц;
						НовСтрока.КоличествоЕдиницПоЛС = Единицы;
						НовСтрока.Факт                 = Единицы;
						НовСтрока.Начислено            = Сумма;
						НовСтрока.Доля                 = ВыборкаРасп.ДоляЛСФакт;
						НовСтрока.ДоляПоЛС             = Выборка.ДоляЛСФакт;
						НовСтрока.Ставка               = Выборка.Ставка;
						
						// БИТ_ЖКХ 27.05.2014
						// ПлановаяСумма = Окр(Выборка.КоличествоЕдиниц*Выборка.ПлановаяСтавка,4,1);.
						ПлановаяСумма = Окр(Выборка.КоличествоЕдиниц*Выборка.ПлановаяСтавка,2,1);
						// БИТ_ЖКХ 27.05.2014
						
						Если НЕ Выборка.Тариф = 0 Тогда
							// БИТ_ЖКХ 02.03.2017 16:21:41 Начало правки...
							//НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,4);
							Если РасчетОбъемовДоТретьегоЗнака Тогда
								НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,3);
							Иначе
								НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,4);
							КонецЕсли;
							// БИТ_ЖКХ 02.03.2017 16:21:41 Конец правки.
						КонецЕсли;
						
					иначе
						
						НовСтрока = МассивСтрок[0];
						ЗаполнитьЗначенияСвойств(НовСтрока, Выборка);
						НовСтрока.КоличествоЕдиниц     = Выборка.КоличествоЕдиниц;
						НовСтрока.КоличествоЕдиницПоЛС = Единицы;
						НовСтрока.Факт                 = Единицы;
						НовСтрока.Начислено            = Сумма;
						НовСтрока.Доля                 = ВыборкаРасп.ДоляЛСФакт;
						НовСтрока.ДоляПоЛС             = Выборка.ДоляЛСФакт;
						НовСтрока.Ставка               = Выборка.Ставка;
						
						// БИТ_ЖКХ 27.05.2014
						// ПлановаяСумма = Окр(Выборка.КоличествоЕдиниц*Выборка.ПлановаяСтавка,4,1);.
						ПлановаяСумма = Окр(Выборка.КоличествоЕдиниц*Выборка.ПлановаяСтавка,2,1);
						// БИТ_ЖКХ 27.05.2014
						
						Если НЕ Выборка.Тариф = 0 Тогда
							// БИТ_ЖКХ 02.03.2017 16:20:45 Начало правки...
							//НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,4);
							Если РасчетОбъемовДоТретьегоЗнака Тогда
								НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,3);
							Иначе
								НовСтрока.Объем = Окр(Сумма/Выборка.Тариф,4);
							КонецЕсли;
							// БИТ_ЖКХ 02.03.2017 16:20:45 Конец правки.
						КонецЕсли;
						
					КонецЕсли;	
					
				КонецЦикла;
				
			КонецЦикла;
			Если НЕ ЭтоЛС Тогда
				
				Погрешность = ПлановаяСумма - ИтогСумма;
				
				Если Погрешность <> 0 Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Распределение", ВыборкаРасп.Распределение);
					ТаблицаПогрешностей.Сортировать("Сумма Убыв");
					Если ТаблицаПогрешностей.Количество() > 0 Тогда
						
						Отбор.Вставить("ЛицевойСчет", ТаблицаПогрешностей[0].ЛицевойСчет);
						
						Строки = ТаблицаРаспределений.НайтиСтроки(Отбор);
						Если Строки.Количество() > 0 тогда 
							Строки[0].Начислено = Строки[0].Начислено + Погрешность;
							
						КонецЕсли;
						
					КонецЕсли; 
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	ОбъектСравнения = Новый СравнениеЗначений;
	ТаблицаРаспределений.Сортировать("ЛицевойСчет Возр, Приоритет Убыв", ОбъектСравнения);
	
КонецПроцедуры

// Процедура выполняет расчет начислений по Льготам.
//
Процедура РасчитатьНачисленияЛьгот(Дата, Организация, СписокЛС, ТаблицаЛьгот, ТаблицаНачислений = Неопределено, ТаблицаСчетчиков = Неопределено, ТаблицаРаспределений = Неопределено, Запрос, УменьшитьНормуЛьготы = Ложь, ТаблицаПоГрупСИндСчетчиков = Неопределено, РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика = Ложь, РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика = Ложь, Мосэнергосбыт2016 = Ложь)
	
	/////////////////////////////////////////////////////
	/////#1 - Изменения расчета с учетом долей площади.
	
	Если ТаблицаНачислений = Неопределено Тогда
		
		ТаблицаНачислений = ПолучитьТаблицуНачислений(Дата, Организация, СписокЛС);
		
	КонецЕсли; 
	
	Если ТаблицаСчетчиков = Неопределено Тогда
		
		ТаблицаСчетчиков = ПолучитьТаблицуСчетчиков(Дата, Организация, СписокЛС);
		
	КонецЕсли;
	
	Если ТаблицаРаспределений = Неопределено Тогда
		
		ТаблицаРаспределений = ПолучитьТаблицуРаспределений(Дата, Организация, СписокЛС);
		
	КонецЕсли;
	
	Если ТаблицаПоГрупСИндСчетчиков = Неопределено Тогда
		
		ТаблицаПоГрупСИндСчетчиков = ПолучитьТаблицуПоГрупСИндСчетчиков(Дата, Организация, СписокЛС);
		
	КонецЕсли;
	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСчетчиков.ЛицевойСчет КАК ЛицевойСчет,
	|	ТаблицаСчетчиков.Услуга,
	|	ТаблицаСчетчиков.Приоритет,
	|	ТаблицаСчетчиков.Норматив КАК Норматив,
	|	ТаблицаСчетчиков.НормаЛьготы КАК НормаЛьготы,
	|	ТаблицаСчетчиков.Факт КАК Факт,
	|	ТаблицаСчетчиков.Ставка КАК Ставка,
	|	ТаблицаСчетчиков.СверхномСтавка КАК СверхномСтавка,
	|	ТаблицаСчетчиков.Начислено КАК Начислено,
	|	ТаблицаСчетчиков.Норма,
	|	ТаблицаСчетчиков.Многотарифный
	|ПОМЕСТИТЬ ТаблицаСчетчиков
	|ИЗ
	|	&ТаблицаСчетчиков КАК ТаблицаСчетчиков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСчетчиков.ЛицевойСчет,
	|	ТаблицаСчетчиков.Услуга,
	|	ТаблицаСчетчиков.Приоритет,
	|	МАКСИМУМ(ТаблицаСчетчиков.Норматив) КАК Норматив,
	|	МАКСИМУМ(ТаблицаСчетчиков.НормаЛьготы) КАК НормаЛьготы,
	|	СУММА(ТаблицаСчетчиков.Факт) КАК Факт,
	|	МАКСИМУМ(ТаблицаСчетчиков.Ставка) КАК Ставка,
	|	МАКСИМУМ(ТаблицаСчетчиков.СверхномСтавка) КАК СверхномСтавка,
	|	СУММА(ТаблицаСчетчиков.Начислено) КАК Начислено,
	|	МАКСИМУМ(ТаблицаСчетчиков.Норма) КАК Норма,
	|	МАКСИМУМ(ТаблицаСчетчиков.Многотарифный) КАК Многотарифный,
	|	МАКСИМУМ(ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)) КАК СпособРасчета
	|ИЗ
	|	ТаблицаСчетчиков КАК ТаблицаСчетчиков
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаСчетчиков.ЛицевойСчет,
	|	ТаблицаСчетчиков.Услуга,
	|	ТаблицаСчетчиков.Приоритет";
	
	Запрос.УстановитьПараметр("ТаблицаСчетчиков", ТаблицаСчетчиков);
	ТаблицаПоСчетчикам = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПоГрупСИндСчетчиков.ЛицевойСчет,
	|	ТаблицаПоГрупСИндСчетчиков.Услуга,
	|	ТаблицаПоГрупСИндСчетчиков.Начислено
	|ПОМЕСТИТЬ ТаблицаГруп
	|ИЗ
	|	&ТаблицаПоГрупСИндСчетчиков КАК ТаблицаПоГрупСИндСчетчиков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаГруп.ЛицевойСчет,
	|	ТаблицаГруп.Услуга,
	|	СУММА(ТаблицаГруп.Начислено) КАК Начислено
	|ИЗ
	|	ТаблицаГруп КАК ТаблицаГруп
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаГруп.ЛицевойСчет,
	|	ТаблицаГруп.Услуга";
	Запрос.УстановитьПараметр("ТаблицаПоГрупСИндСчетчиков", ТаблицаПоГрупСИндСчетчиков);
	
	ТаблицаПоГрупСИндСчетчиков = Запрос.Выполнить().Выгрузить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаНачислений.ЛицевойСчет,
	|	ТаблицаНачислений.Услуга,
	|	ТаблицаНачислений.Норматив,
	|	ТаблицаНачислений.НормаЛьготы,
	|	ТаблицаНачислений.Факт,
	|	ТаблицаНачислений.Начислено,
	|	ТаблицаНачислений.СпособРасчета,
	|	ТаблицаНачислений.Приоритет
	|ПОМЕСТИТЬ ТаблицаНачисления
	|ИЗ
	|	&ТаблицаНачислений КАК ТаблицаНачислений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПоСчетчикам.ЛицевойСчет,
	|	ТаблицаПоСчетчикам.Услуга,
	|	ТаблицаПоСчетчикам.Норматив,
	|	ТаблицаПоСчетчикам.НормаЛьготы,
	|	ТаблицаПоСчетчикам.Факт,
	|	ТаблицаПоСчетчикам.Начислено,
	|	ТаблицаПоСчетчикам.СпособРасчета,
	|	ТаблицаПоСчетчикам.Приоритет,
	|	ТаблицаПоСчетчикам.Норма,
	|	ТаблицаПоСчетчикам.Многотарифный
	|ПОМЕСТИТЬ ТаблицаСЧ
	|ИЗ
	|	&ТаблицаПоСчетчикам КАК ТаблицаПоСчетчикам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаРаспределения.ЛицевойСчет,
	|	ТаблицаРаспределения.Услуга,
	|	ТаблицаРаспределения.Норматив,
	|	ТаблицаРаспределения.НормаЛьготы,
	|	ТаблицаРаспределения.Факт,
	|	ТаблицаРаспределения.Начислено,
	|	ТаблицаРаспределения.СпособРасчета,
	|	ТаблицаРаспределения.Приоритет
	|ПОМЕСТИТЬ ТаблицаРасп
	|ИЗ
	|	&ТаблицаРаспределений КАК ТаблицаРаспределения
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПоГрупСИндСчетчиков.ЛицевойСчет,
	|	ТаблицаПоГрупСИндСчетчиков.Услуга,
	|	ТаблицаПоГрупСИндСчетчиков.Начислено
	|ПОМЕСТИТЬ ТаблицаГрупСИнд
	|ИЗ
	|	&ТаблицаПоГрупСИндСчетчиков КАК ТаблицаПоГрупСИндСчетчиков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНачисления.ЛицевойСчет,
	|	ТаблицаНачисления.Услуга,
	|	ТаблицаНачисления.Норматив,
	|	ТаблицаНачисления.НормаЛьготы,
	|	ТаблицаНачисления.Факт,
	|	ТаблицаНачисления.Начислено,
	|	ТаблицаНачисления.СпособРасчета,
	|	ТаблицаНачисления.Приоритет,
	|	0 КАК Норма,
	|	ЛОЖЬ КАК Многотарифный
	|ПОМЕСТИТЬ ТемпТаблицаНачислений
	|ИЗ
	|	ТаблицаНачисления КАК ТаблицаНачисления
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаСЧ.ЛицевойСчет,
	|	ТаблицаСЧ.Услуга,
	|	ТаблицаСЧ.Норматив,
	|	ТаблицаСЧ.НормаЛьготы,
	|	ТаблицаСЧ.Факт,
	|	ТаблицаСЧ.Начислено,
	|	ТаблицаСЧ.СпособРасчета,
	|	ТаблицаСЧ.Приоритет,
	|	ТаблицаСЧ.Норма,
	|	ТаблицаСЧ.Многотарифный
	|ИЗ
	|	ТаблицаСЧ КАК ТаблицаСЧ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	ТаблицаРасп.ЛицевойСчет,
	|	ТаблицаРасп.Услуга,
	|	ТаблицаРасп.Норматив,
	|	ТаблицаРасп.НормаЛьготы,
	|	ТаблицаРасп.Факт,
	|	ТаблицаРасп.Начислено,
	|	ТаблицаРасп.СпособРасчета,
	|	ТаблицаРасп.Приоритет,
	|	0,
	|	ЛОЖЬ
	|ИЗ
	|	ТаблицаРасп КАК ТаблицаРасп
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТемпТаблицаНачислений.ЛицевойСчет,
	|	ТемпТаблицаНачислений.Услуга,
	|	ТемпТаблицаНачислений.Норматив,
	|	ТемпТаблицаНачислений.НормаЛьготы,
	|	ТемпТаблицаНачислений.Факт,
	|	ЕСТЬNULL(ТемпТаблицаНачислений.Начислено, 0) + ЕСТЬNULL(ТаблицаГрупСИнд.Начислено, 0) КАК Начислено,
	|	ТемпТаблицаНачислений.СпособРасчета,
	|	ТемпТаблицаНачислений.Приоритет,
	|	ТемпТаблицаНачислений.Норма,
	|	ТемпТаблицаНачислений.Многотарифный
	|ПОМЕСТИТЬ ТаблицаНач
	|ИЗ
	|	ТемпТаблицаНачислений КАК ТемпТаблицаНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаГрупСИнд КАК ТаблицаГрупСИнд
	|		ПО ТемпТаблицаНачислений.ЛицевойСчет = ТаблицаГрупСИнд.ЛицевойСчет
	|			И ТемпТаблицаНачислений.Услуга = ТаблицаГрупСИнд.Услуга";
	
	
	Запрос.УстановитьПараметр("ТаблицаНачислений"         , ТаблицаНачислений);
	Запрос.УстановитьПараметр("ТаблицаПоСчетчикам"        , ТаблицаПоСчетчикам);
	Запрос.УстановитьПараметр("ТаблицаРаспределений"      , ТаблицаРаспределений);
	Запрос.УстановитьПараметр("ТаблицаПоГрупСИндСчетчиков", ТаблицаПоГрупСИндСчетчиков);
	
	Запрос.Выполнить();
	
	// БИТ_ЖКХ 03.02.2016 12:27:14 Начало правки... 
	Если Дата >= Дата('20160101') И Мосэнергосбыт2016 Тогда
		Запрос.Текст =
		"ВЫБРАТЬ
		|	ТаблицаНач.Услуга КАК Услуга,
		|	ТаблицаНач.ЛицевойСчет КАК ЛицевойСчет,
		|	ТаблицаНач.Норматив КАК Норматив,
		|	ТаблицаНач.НормаЛьготы КАК НормаЛьготы,
		|	ТаблицаНач.Факт КАК Факт,
		|	ТаблицаНач.Начислено КАК Начислено,
		|	ТаблицаНач.СпособРасчета КАК СпособРасчета,
		|	ТаблицаНач.Приоритет КАК Приоритет,
		|	ТаблицаНач.Норма КАК Норма,
		|	ТаблицаНач.Многотарифный КАК Многотарифный
		|ПОМЕСТИТЬ ВТ_Начисления
		|ИЗ
		|	ТаблицаНач КАК ТаблицаНач
		|ГДЕ
		|	ЕСТЬNULL(ТаблицаНач.Начислено, 0) > 0
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Услуга,
		|	ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_УстановкаЛьготСрезПоследних.Услуга КАК Услуга,
		|	ТаблицаЛьгот.ЛицевойСчет КАК ЛицевойСчет,
		|	ТаблицаЛьгот.ФизЛицо КАК ФизЛицо,
		|	ТаблицаЛьгот.Льгота КАК Льгота,
		|	бит_УстановкаЛьготСрезПоследних.СемейнаяСтавка КАК СемейнаяСтавка,
		|	бит_УстановкаЛьготСрезПоследних.ЛичнаяСтавка КАК ЛичнаяСтавка,
		|	бит_УстановкаЛьготСрезПоследних.Распространение КАК Распространение,
		|	ТаблицаЛьгот.НачислятьПоНорме КАК НачислятьПоНорме,
		|	ТаблицаЛьгот.ПроживаниеВДанныйМомент КАК ПроживаниеВДанныйМомент,
		|	бит_УстановкаЛьготСрезПоследних.ИспользоватьНормуНаОдного КАК ИспользоватьНормуНаОдного,
		|	бит_УстановкаЛьготСрезПоследних.РасчетСУчетомДолейВладения КАК РасчетСУчетомДолейВладения,
		|	бит_УстановкаЛьготСрезПоследних.РасчетСУчетомСоставаСемьи КАК РасчетСУчетомСоставаСемьи,
		|	ТаблицаЛьгот.ДоляПлощади КАК ДоляПлощади,
		|	ТаблицаЛьгот.ПравоНаЛьготы КАК ПравоНаЛьготы,
		|	бит_УстановкаЛьготСрезПоследних.ФактическоеПотреблениеПоСчетчикамБезУчетаВременноПроживающих КАК ФактПотребПоСЧБезУчетаВременноПрож
		|ПОМЕСТИТЬ ВТ_ЛьготыНаУс
		|ИЗ
		|	ТаблицаЛьгот КАК ТаблицаЛьгот
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_УстановкаЛьгот.СрезПоследних(
		|				&Момент,
		|				Льгота В
		|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
		|						ТаблицаЛьгот.Льгота
		|					ИЗ
		|						ТаблицаЛьгот)) КАК бит_УстановкаЛьготСрезПоследних
		|		ПО ТаблицаЛьгот.Льгота = бит_УстановкаЛьготСрезПоследних.Льгота
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Услуга,
		|	ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Начисления.ЛицевойСчет КАК ЛицевойСчет,
		|	ВТ_Начисления.Услуга КАК Услуга,
		|	ВТ_Начисления.Приоритет КАК ПриоритетСч,
		|	ВТ_ЛьготыНаУс.ФизЛицо КАК ФизЛицо,
		|	ВТ_Начисления.Норматив,
		|	ВТ_Начисления.НормаЛьготы,
		|	ВТ_Начисления.Факт КАК Факт,
		|	ВТ_ЛьготыНаУс.Льгота КАК Льгота,
		|	ВТ_ЛьготыНаУс.НачислятьПоНорме,
		|	ВТ_ЛьготыНаУс.ПроживаниеВДанныйМомент,
		|	ВТ_Начисления.СпособРасчета КАК СпособРасчета,
		|	ЕСТЬNULL(ВТ_ЛьготыНаУс.СемейнаяСтавка, 0) КАК СемейнаяСтавка,
		|	ЕСТЬNULL(ВТ_ЛьготыНаУс.ЛичнаяСтавка, 0) КАК ЛичнаяСтавка,
		// БИТ_ЖКХ_07072015 ++
		|	ЕСТЬNULL(ТаблицаНорм.ЛьготнаяСтавка, 0) КАК ЛьготнаяСтавка,
		// БИТ_ЖКХ_07072015 ++
		|	ЕСТЬNULL(ВТ_ЛьготыНаУс.ИспользоватьНормуНаОдного, ЛОЖЬ) КАК ИспользоватьНормуНаОдного,
		|	ЕСТЬNULL(ТаблицаНорм.НаДвоих, 0) КАК НаДвоих,
		|	ЕСТЬNULL(ТаблицаНорм.НаСемью, 0) КАК НаСемью,
		|	ЕСТЬNULL(ТаблицаНорм.НаСемью4, 0) КАК НаСемью4,
		|	ЕСТЬNULL(ТаблицаНорм.НаСемью5, 0) КАК НаСемью5,
		|	ЕСТЬNULL(ТаблицаНорм.НаСемью6, 0) КАК НаСемью6,
		|	ЕСТЬNULL(ТаблицаНорм.ДопНормаНаСемью, 0) КАК ДопНормаНаСемью,
		|	ЕСТЬNULL(ТаблицаНорм.ДопНормаНаКаждого, 0) КАК ДопНормаНаКаждого,
		|	ЕСТЬNULL(ТаблицаНорм.ИспользоватьДопНормуНаОдного, 0) КАК ИспользоватьДопНормуНаОдного,
		|	ЕСТЬNULL(ТаблицаНорм.ИспользоватьДопНормуНаЛьготника, 0) КАК ИспользоватьДопНормуНаЛьготника,
		|	ЕСТЬNULL(ТаблицаПроживающих.КоличествоПроживающих, 0) КАК КоличествоПроживающих,
		|	ЕСТЬNULL(ТаблицаПроживающих.мКоличествоПоНормеЛьгота, 0) КАК мКоличествоПоНормеЛьгота,
		|	ВТ_ЛьготыНаУс.Распространение КАК Распространение,
		|	ЕСТЬNULL(ТаблицаНорм.Ставка, 0) КАК Ставка,
		|	ЕСТЬNULL(ТаблицаНорм.НаОдного, 0) КАК НаОдного,
		|	ЕСТЬNULL(ТаблицаПроживающих.мКоличествоПоНормеЛьгота, 0) КАК КоличествоНосителей,
		|	ЕСТЬNULL(ВТ_Начисления.Начислено, 0) КАК Начислено,
		|	ТаблицаНорм.НормативПотребленияПоКу,
