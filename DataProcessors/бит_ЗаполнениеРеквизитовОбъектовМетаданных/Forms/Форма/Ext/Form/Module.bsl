// Процедура отображает текущие отборы.
//
// Параметры:
//  Нет.
//
&НаКлиенте
Процедура ОтобразитьТекущиеОтборы()
	
	УстановленныеОтборы = "";
	
	Если Объект.СписокУлиц.Количество() > 0 Тогда
		Запятая = ?(НЕ УстановленныеОтборы = "", ", ","");
		УстановленныеОтборы = УстановленныеОтборы + Запятая + "Улицы";
	КонецЕсли;
	
	Если Объект.СписокЗданий.Количество() > 0 Тогда
		Запятая = ?(НЕ УстановленныеОтборы = "", ", ","");
		УстановленныеОтборы = УстановленныеОтборы + Запятая + "Здания";
	КонецЕсли;
	
	Если Объект.СписокЛицевыхСчетов.Количество() > 0 Тогда
		Запятая = ?(НЕ УстановленныеОтборы = "", ", ","");
		УстановленныеОтборы = УстановленныеОтборы + Запятая + "Лицевые счета";
	КонецЕсли;
	
	Если УстановленныеОтборы = "" Тогда
		УстановленныеОтборы = "Отбор не установлен.";
	Иначе
		УстановленныеОтборы = УстановленныеОтборы + ".";
	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
Процедура ЗаполнитьРеквизитыОбъектаМетаданныхСервер()
    
    ТЗ_Реквизиты = РеквизитФормыВЗначение("РеквизитыОбъектаМетаданных");
    
    МассивРеквизитов = Новый Массив;
    
    // Удалим ранее созданные колонки в РеквизитыОбъектаМетаданных.    
    Для Каждого Колонка Из ТЗ_Реквизиты.Колонки Цикл
        МассивРеквизитов.Добавить("РеквизитыОбъектаМетаданных." + Колонка.Имя);        
    КонецЦикла;
    ИзменитьРеквизиты(,МассивРеквизитов);
    
    // Удалим отображение таблицы на форме и создадим новую.
    ЭлементТаблица = Элементы.Найти("РеквизитыОбъектаМетаданных");
    Если ЭлементТаблица <> Неопределено Тогда
        Элементы.Удалить(ЭлементТаблица);        
    КонецЕсли;     
    
	ЭлементТаблица = Элементы.Добавить("РеквизитыОбъектаМетаданных", Тип("ТаблицаФормы"), Элементы.ГруппаСтраницаСправочников);
	ЭлементТаблица.ПутьКДанным = "РеквизитыОбъектаМетаданных";
	ЭлементТаблица.Отображение = ОтображениеТаблицы.Список;
    
    // Выполним запрос.
	ТЗ_Реквизиты = ПолучитьРеквизитыОбъектаМетаданных();
	
	Если ТЗ_Реквизиты = Неопределено Тогда
		Возврат;	
	КонецЕсли;
    
    // Создадим реквизиты РеквизитыОбъектаМетаданных.
    МассивРеквизитов.Очистить();
	Для Каждого Колонка ИЗ ТЗ_Реквизиты.Колонки Цикл
        НоваяКолонка = Новый РеквизитФормы(Колонка.Имя, Новый ОписаниеТипов(Колонка.ТипЗначения,,"Null"), "РеквизитыОбъектаМетаданных", ПолучитьЗаголовок(Колонка.Имя, Объект.ДоступныеРеквизиты));
        МассивРеквизитов.Добавить(НоваяКолонка);
    КонецЦикла;      
    ИзменитьРеквизиты(МассивРеквизитов);  
    ЗначениеВРеквизитФормы(ТЗ_Реквизиты, "РеквизитыОбъектаМетаданных");
    
    // Создаем элементы на форме для отображения колонок.
    ЭлементРеквизитыОбъектаМетаданных = Элементы.РеквизитыОбъектаМетаданных;
	
	Для Каждого Колонка ИЗ ТЗ_Реквизиты.Колонки Цикл
		
		Если Колонка.Имя = "Улица"
			ИЛИ Колонка.Имя = "НомерДома"
			ИЛИ Колонка.Имя = "ПрефиксДома"
			ИЛИ Колонка.Имя = "Корпус"
			ИЛИ Колонка.Имя = "Район"
			ИЛИ Колонка.Имя = "Квартира" Тогда
			Продолжить;
		КонецЕсли;
		
		НовыйЭлементФормы = Элементы.Добавить("РеквизитыОбъектаМетаданных"+Колонка.Имя, Тип("ПолеФормы"), ЭлементРеквизитыОбъектаМетаданных);
		
        НовыйЭлементФормы.Вид = ВидПоляФормы.ПолеВвода;
        НовыйЭлементФормы.ПутьКДанным = "РеквизитыОбъектаМетаданных." + Колонка.Имя;
		НовыйЭлементФормы.РежимРедактирования = РежимРедактированияКолонки.ВходПриВводе;
		
		// Скрываем служебные колонки, добовляем событие для отметки изменений.
		Если Колонка.Имя = "ЭлтИзменен" Тогда
			НовыйЭлементФормы.Видимость = Ложь;
			
		ИначеЕсли Колонка.Имя = "Ссылка"
			ИЛИ Колонка.Имя = "ЛС_Физ_лица"
			ИЛИ Колонка.Имя = "Здание_Физ_лица"
			ИЛИ Колонка.Имя = "Улица_Физ_лица"
			ИЛИ Колонка.Имя = "Адрес"
			ИЛИ Колонка.Имя = "Улица"
			ИЛИ Колонка.Имя = "НомерДома"
			ИЛИ Колонка.Имя = "ПрефиксДома"
			ИЛИ Колонка.Имя = "Корпус"
			ИЛИ Колонка.Имя = "Район"
			ИЛИ Колонка.Имя = "Квартира" Тогда
			НовыйЭлементФормы.ТолькоПросмотр = Истина;
		КонецЕсли;
		
    КонецЦикла;
	
	// Скрываем команды.
	ЭлементРеквизитыОбъектаМетаданных.ИзменятьСоставСтрок  = Ложь;
	
	// Добавляем команды.
	КнопкаПеречитатьВыделенныеЭлементы = Элементы.Добавить("ОтменитьДляВыбранных", Тип("КнопкаФормы"), ЭлементРеквизитыОбъектаМетаданных.КоманднаяПанель);
	КнопкаПеречитатьВыделенныеЭлементы.ИмяКоманды = "ОтменитьДляВыбранных";
	
	КнопкаПеречитатьВыделенныеЭлементы = Элементы.Добавить("УказатьДляВыбранных", Тип("КнопкаФормы"), ЭлементРеквизитыОбъектаМетаданных.КоманднаяПанель);
	КнопкаПеречитатьВыделенныеЭлементы.ИмяКоманды = "УказатьДляВыбранных";
	
	КнопкаПеречитатьВыделенныеЭлементы = Элементы.Добавить("Удалить", Тип("КнопкаФормы"), ЭлементРеквизитыОбъектаМетаданных.КоманднаяПанель);
	КнопкаПеречитатьВыделенныеЭлементы.ИмяКоманды = "Удалить";
	
	КнопкаПеречитатьВыделенныеЭлементы = Элементы.Добавить("УдалитьСтроки", Тип("КнопкаФормы"), ЭлементРеквизитыОбъектаМетаданных.КонтекстноеМеню);
	КнопкаПеречитатьВыделенныеЭлементы.Заголовок = "Удалить";
	КнопкаПеречитатьВыделенныеЭлементы.ИмяКоманды = "Удалить";

	// Задаем имя универсальной процедуры, для отметки факта модификации эл-та.
	УстановитьСобытиеИзмененияСервер();
	
	Модифицированность = Ложь;
	
	// После обновления блокируем команду записи, до модификации вновь полученных элементов справочника пользователем.
	Элементы.ФормаЗаписать.Доступность = Ложь;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьЗаголовок(ИмяКолонка, Знач ТЗ)
	
	ЗаголовокКолнки = "";
	
	Если ИмяКолонка = "Ссылка" Тогда
		Возврат ЗаголовокКолнки;
	КонецЕсли;
	
	МассивИмен = ТЗ.НайтиСтроки( Новый Структура("ИмяРеквизита",ИмяКолонка));
	Если МассивИмен.Количество() > 0  Тогда
		ЗаголовокКолнки = МассивИмен[0].Синоним;	
	КонецЕсли;
	
	Возврат ЗаголовокКолнки;
	
КонецФункции

&НаСервере
Функция ПолучитьРеквизитыОбъектаМетаданных(СписокЭлтов = Неопределено)
	
	ИменаРеквизитов = "";
	Для Каждого Стр Из Объект.ДоступныеРеквизиты Цикл
		Если НЕ Стр.Использовать Тогда
			Продолжить;
		КонецЕсли;
		ИменаРеквизитов = ИменаРеквизитов + Стр.ИмяРеквизита + ","
	КонецЦикла;
	
	Если ИменаРеквизитов = "" Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	Если Справочник = "бит_Проживающие" Тогда
		ТекстЗапрос =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Таблица.Ссылка КАК Ссылка, " + ИменаРеквизитов + "
		|	ЛОЖЬ КАК ЭлтИзменен
		|ПОМЕСТИТЬ ВТ_Проживающие
		|ИЗ
		|	Справочник.бит_Проживающие КАК Таблица
		|ГДЕ
		|	НЕ Таблица.ПометкаУдаления
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_Проживающие.Ссылка, " + ИменаРеквизитов + "
		|	ВТ_Проживающие.ЭлтИзменен,
		|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
		|ПОМЕСТИТЬ ВТ_ЛСПроживающих
		|ИЗ
		|	ВТ_Проживающие КАК ВТ_Проживающие
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
		|				,
		|				ФизЛицо В
		|					(ВЫБРАТЬ
		|						ВТ_Проживающие.Ссылка
		|					ИЗ
		|						ВТ_Проживающие)) КАК бит_ПроживающиеПоЛССрезПоследних
		|		ПО ВТ_Проживающие.Ссылка = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
		|ГДЕ
		|	НЕ бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица = ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.Выписан)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТ_ЛСПроживающих.Ссылка, " + ИменаРеквизитов + "
		|	ВТ_ЛСПроживающих.ЭлтИзменен,
		|	ВТ_ЛСПроживающих.ЛицевойСчет КАК ЛС_Физ_лица,
		|	бит_ЛицевыеСчета.Здание КАК Здание_Физ_лица,
		|	бит_ЛицевыеСчета.УлицаЛицевогоСчета КАК Улица_Физ_лица
		|ИЗ
		|	ВТ_ЛСПроживающих КАК ВТ_ЛСПроживающих
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ПО ВТ_ЛСПроживающих.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
		|ГДЕ
		|	НЕ бит_ЛицевыеСчета.ПометкаУдаления";
	Иначе	
		ТекстЗапрос =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	Ссылка КАК Ссылка, " + ИменаРеквизитов + " 
		|	ЛОЖЬ КАК ЭлтИзменен
		|
		|ИЗ
		|	Справочник." + Справочник + " КАК Таблица
		|ГДЕ
		|	НЕ Таблица.ПометкаУдаления";
	КонецЕсли;
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапрос);
	
	ОтборЗдания		  = Объект.СписокЗданий.Выгрузить(,"Здание").ВыгрузитьКолонку("Здание");
	ОтборУлица		  = Объект.СписокУлиц.Выгрузить(,"Улица").ВыгрузитьКолонку("Улица");
	ОтборЛС			  = Объект.СписокЛицевыхСчетов.Выгрузить(,"ЛицевойСчет").ВыгрузитьКолонку("ЛицевойСчет");
	ОтборТипСчетчиков = Объект.ТипыСчетчиков.Выгрузить(,"ТипСчетчика").ВыгрузитьКолонку("ТипСчетчика");
	ОтборВидСчетчиков = Объект.ВидыСчетчиков.Выгрузить(,"ВидСчетчика").ВыгрузитьКолонку("ВидСчетчика");
	
	// Отбор по ссылкам.
	Если НЕ СписокЭлтов = Неопределено Тогда
		ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбора = ЗапросСхемы.Операторы[0];
		ОператорВыбора.Отбор.Добавить("Таблица.Ссылка В (&СписокЭлтов)");
	КонецЕсли;
	
	Если Справочник = "бит_СписокЗданий" Тогда
		ЗапросСхемы		= СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбрать = ЗапросСхемы.Операторы[0];
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Улица");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.НомерДома");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.ПрефиксДома");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Корпус");
	ИначеЕсли Справочник = "бит_Квартиры" ИЛИ Справочник = "бит_Подъезды" Тогда
		ЗапросСхемы		= СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбрать = ЗапросСхемы.Операторы[0];
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.Улица");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.НомерДома");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.ПрефиксДома");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.Корпус");
		
		ЗапросСхемы.Колонки.Найти("ВладелецУлица").Псевдоним	   = "Улица";
		ЗапросСхемы.Колонки.Найти("ВладелецНомерДома").Псевдоним   = "НомерДома";
		ЗапросСхемы.Колонки.Найти("ВладелецПрефиксДома").Псевдоним = "ПрефиксДома";
		ЗапросСхемы.Колонки.Найти("ВладелецКорпус").Псевдоним	   = "Корпус";
	ИначеЕсли Справочник = "бит_Комнаты" Тогда
		ЗапросСхемы		= СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбрать = ЗапросСхемы.Операторы[0];
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.Владелец.Улица");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.Владелец");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.Владелец.НомерДома");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.Владелец.ПрефиксДома");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.Владелец.Корпус");
		ОператорВыбрать.ВыбираемыеПоля.Добавить("Таблица.Владелец.НомерКвартиры");
		
		ЗапросСхемы.Колонки.Найти("ВладелецВладелецУлица").Псевдоним	   = "Улица";
		ЗапросСхемы.Колонки.Найти("ВладелецВладелецНомерДома").Псевдоним   = "НомерДома";
		ЗапросСхемы.Колонки.Найти("ВладелецВладелецПрефиксДома").Псевдоним = "ПрефиксДома";
		ЗапросСхемы.Колонки.Найти("ВладелецВладелецКорпус").Псевдоним	   = "Корпус";
		ЗапросСхемы.Колонки.Найти("ВладелецНомерКвартиры").Псевдоним	   = "Квартира";
	ИначеЕсли Справочник = "бит_ПлатежныеДокументыГИСЖКХ" Тогда
		ЗапросСхемы		= СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбрать = ЗапросСхемы.Операторы[0];
		ОператорВыбрать.Отбор.Добавить("НЕ Таблица.ЭтоГруппа");
	КонецЕсли;
	
	// Отбор Здания.
	Если ОтборЗдания.Количество() > 0 Тогда
		ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбора = ЗапросСхемы.Операторы[0];
		
		Если Справочник = "бит_СписокЗданий" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.Ссылка В (&Здание)");
		ИначеЕсли Справочник = "бит_Квартиры" ИЛИ Справочник = "бит_Подъезды" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.Владелец В (&Здание)");
		ИначеЕсли Справочник = "бит_Комнаты" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.Владелец.Владелец В (&Здание)");
		ИначеЕсли Справочник = "бит_ЛицевыеСчета" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.Здание В (&Здание)");
		ИначеЕсли Справочник = "бит_Проживающие" Тогда
			ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[2];
			ОператорВыбора = ЗапросСхемы.Операторы[0];
			ОператорВыбора.Отбор.Добавить("бит_ЛицевыеСчета.Здание В (&Здание)");
		ИначеЕсли Справочник = "бит_ПлатежныеДокументыГИСЖКХ" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.ЛицевойСчет.Здание В (&Здание)");
		КонецЕсли;
		
	КонецЕсли;
	
	// Отбор Улицы.
	Если ОтборУлица.Количество() > 0 Тогда
		ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбора = ЗапросСхемы.Операторы[0];
		
		Если Справочник = "бит_СписокЗданий" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.Улица В (&Улица)");
		ИначеЕсли Справочник = "бит_Квартиры" ИЛИ Справочник = "бит_Подъезды" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.Владелец.Улица В (&Улица)");
		ИначеЕсли Справочник = "бит_Комнаты" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.Владелец.Владелец.Улица В (&Улица)");
		ИначеЕсли Справочник = "бит_ЛицевыеСчета" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.УлицаЛицевогоСчета В (&Улица)");
		ИначеЕсли Справочник = "бит_Проживающие" Тогда
			ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[2];
			ОператорВыбора = ЗапросСхемы.Операторы[0];
			ОператорВыбора.Отбор.Добавить("бит_ЛицевыеСчета.УлицаЛицевогоСчета В (&Улица)");
		ИначеЕсли Справочник = "бит_ПлатежныеДокументыГИСЖКХ" Тогда
			ОператорВыбора.Отбор.Добавить("Таблица.ЛицевойСчет.УлицаЛицевогоСчета В (&Улица)");
		КонецЕсли;
		
	КонецЕсли;
	
	// Отбор ЛС.
	Если Справочник = "бит_ЛицевыеСчета" И ОтборЛС.Количество() > 0 Тогда
		ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбора = ЗапросСхемы.Операторы[0];
		ОператорВыбора.Отбор.Добавить("Таблица.Ссылка В (&ЛицевойСчет)");
	ИначеЕсли Справочник = "бит_Проживающие" И ОтборЛС.Количество() > 0 Тогда
		ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[1];
		ОператорВыбора = ЗапросСхемы.Операторы[0];
		ОператорВыбора.Отбор.Добавить("бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет В (&ЛицевойСчет)");
	ИначеЕсли Справочник = "бит_ПлатежныеДокументыГИСЖКХ" И ОтборЛС.Количество() > 0 Тогда 
		ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[1];
		ОператорВыбора = ЗапросСхемы.Операторы[0];
		ОператорВыбора.Отбор.Добавить("Таблица.ЛицевойСчет В (&ЛицевойСчет)");
	КонецЕсли;
	
	// Отбор Тип/Вид счетчика.
	Если Справочник = "бит_Счетчики" Тогда
		Если ОтборТипСчетчиков.Количество() > 0 Тогда
			ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[0];
			ОператорВыбора = ЗапросСхемы.Операторы[0];
			ОператорВыбора.Отбор.Добавить("Таблица.ТипСчетчика В (&ТипСчетчика)");
		КонецЕсли;
		
		Если ОтборВидСчетчиков.Количество() > 0 Тогда
			ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[0];
			ОператорВыбора = ЗапросСхемы.Операторы[0];
			ОператорВыбора.Отбор.Добавить("Таблица.ВидСчетчика В (&ВидСчетчика)");
		КонецЕсли;
	КонецЕсли;
	
	Запрос = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());
	Запрос.УстановитьПараметр("Здание"		, ОтборЗдания);
	Запрос.УстановитьПараметр("Улица"		, ОтборУлица);
	Запрос.УстановитьПараметр("ЛицевойСчет"	, ОтборЛС);
	Запрос.УстановитьПараметр("ТипСчетчика"	, ОтборТипСчетчиков);
	Запрос.УстановитьПараметр("ВидСчетчика"	, ОтборВидСчетчиков);
	
	Если НЕ СписокЭлтов = Неопределено Тогда
		Запрос.УстановитьПараметр("СписокЭлтов", СписокЭлтов);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	// Заполнение адресного реквизита.
	Если Справочник = "бит_СписокЗданий" Тогда
		
		Результат.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"), "Адрес");
		
		Для Каждого Стр Из Результат Цикл
			Стр.Адрес = Строка(Стр.Улица) + ", д. " + Строка(Стр.НомерДома) + " "	+ Строка(Стр.ПрефиксДома)
						+ ?(ЗначениеЗаполнено(Стр.Корпус),", корп. " + Строка(Стр.Корпус),"");
		КонецЦикла;

	ИначеЕсли Справочник = "бит_Квартиры" ИЛИ Справочник = "бит_Подъезды" Тогда
		
		Результат.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"), "Адрес");
		
		Для Каждого Стр Из Результат Цикл
			Стр.Адрес = Строка(Стр.Улица) + ", д. " + Строка(Стр.НомерДома) + " "	+ Строка(Стр.ПрефиксДома)
						+ ?(ЗначениеЗаполнено(Стр.Корпус),", корп. " + Строка(Стр.Корпус),"")
						+ ?(Справочник = "бит_Квартиры" И ЗначениеЗаполнено(Стр.Ссылка),", кв. " + Строка(Стр.Ссылка),"");
		КонецЦикла;

	ИначеЕсли Справочник = "бит_Комнаты" Тогда
		
		Результат.Колонки.Добавить("Адрес", Новый ОписаниеТипов("Строка"), "Адрес");
		
		Для Каждого Стр Из Результат Цикл
			Стр.Адрес = Строка(Стр.Улица) + ", д. " + Строка(Стр.НомерДома) + " "	+ Строка(Стр.ПрефиксДома)
						+ ?(ЗначениеЗаполнено(Стр.Корпус),", корп. " + Строка(Стр.Корпус),"")
						+ ?(ЗначениеЗаполнено(Стр.Квартира),", кв. " + Строка(Стр.Квартира),"")
						+ ?(Справочник = "бит_Комнаты" И ЗначениеЗаполнено(Стр.Ссылка),", ком. " + Строка(Стр.Ссылка),"");
		КонецЦикла;

	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура УстановитьСобытиеИзмененияСервер()
	
	Для Каждого Элт Из Элементы.РеквизитыОбъектаМетаданных.ПодчиненныеЭлементы Цикл
		Если Элт.ТолькоПросмотр Тогда
			Продолжить;
		КонецЕсли;
		Элт.УстановитьДействие("ПриИзменении", "ПриИзмененииЭлементаСправочника");
	КонецЦикла;
	
	Элементы.РеквизитыОбъектаМетаданных.УстановитьДействие("Выбор", "РеквизитыОбъектаМетаданныхВыбор");

КонецПроцедуры

&НаКлиенте
Процедура ЗаполинтьТаблицуДоступныхРеквизитов(Знач ИмяСправочника)
	
	Объект.ДоступныеРеквизиты.Очистить();
	
	СтруктураРеквизитов = ПолучитьТаблицуДоступныхРеквизитовСервер(ИмяСправочника, мСтруктураИсключений);
	Если СтруктураРеквизитов.Количество() > 0 Тогда
		Для Каждого Элт Из СтруктураРеквизитов Цикл
			НСтр			  = Объект.ДоступныеРеквизиты.Добавить();
			НСтр.ИмяРеквизита = Элт.Ключ;
			НСтр.Синоним	  = Элт.Значение;
			НСтр.Использовать = Ложь;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьТаблицуДоступныхРеквизитовСервер(ИмяСправочника, мСтруктураИсключений)
	
	ИмяСправочника = ?(ИмяСправочника = "бит_ЛицевыеСчетаКР", "бит_ЛицевыеСчета", ИмяСправочника);
	Исключения = Новый Структура;
	СтруктураРеквизитов = Новый Структура;
	КолцияРевизитов = Метаданные.Справочники[ИмяСправочника].Реквизиты;
	Для Каждого Элт Из КолцияРевизитов Цикл
		Если СтрНачинаетсяС(НРег(Элт.Имя), "удалить") 
			ИЛИ (мСтруктураИсключений.Свойство(ИмяСправочника, Исключения) И Исключения.Свойство(Элт.Имя)) Тогда 
			
			Продолжить;	// Пропускаем реквизиты выведенные из работы конфигурации.
		КонецЕсли;
		СтруктураРеквизитов.Вставить(Элт.Имя, Элт.Синоним);
	КонецЦикла;
	
	Возврат СтруктураРеквизитов;
	
КонецФункции

&НаКлиенте
Процедура ИзменитьОтметкуРеквизитовСправочника(Отметка)
	
	Для Каждого Элт Из Объект.ДоступныеРеквизиты Цикл
		Элт.Использовать = Отметка;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере(ОшибкиЗаписи)
	
	ТЗ_РеквизитыОбъектаМетаданных = РеквизитФормыВЗначение("РеквизитыОбъектаМетаданных");
	МассивСтрок = ТЗ_РеквизитыОбъектаМетаданных.НайтиСтроки(Новый Структура("ЭлтИзменен", Истина));	
	
	МассивОшибокЗаписи = Новый Массив;
	
	Для Каждого Элт Из МассивСтрок Цикл
		Попытка
			Об = Элт.Ссылка.ПолучитьОбъект();
			ЗаполнитьЗначенияСвойств(Об,Элт);
			Об.Записать();
		Исключение
			// Аккумулируем сообщение об ошибке.
			ОшибкиЗаписи = ОшибкиЗаписи + "
							| ошибка при записи элемента справочника " + Строка(Элт.Ссылка) + ";";
			МассивОшибокЗаписи.Добавить(Элт);
			Продолжить;
		КонецПопытки
	КонецЦикла;
	
	// Перечитываем результаты записи с базы.
	ЗаполнитьРеквизитыОбъектаМетаданныхСервер();
	
	// Возвращяем изменения не записавшихся в базу элементов.
	Для Каждого Элт Из МассивОшибокЗаписи Цикл
		Замена = РеквизитыОбъектаМетаданных.НайтиСтроки(Новый Структура("Ссылка", Элт.Ссылка));
		Если Замена.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Замена[0], Элт);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Добавить элемент компоновки в контейнер элементов компоновки.
//
// Параметры:
//  ОбластьДобавления - контейнер с элементами и группами отбора, например Список.Отбор или группа в отборе,
//  ИмяПоля                 - Строка - имя поля компоновки данных (заполняется всегда),
//  ПравоеЗначение          - произвольный - сравниваемое значение,
//  ВидСравнения            - ВидСравненияКомпоновкиДанных - вид сравнения,
//  Представление           - Строка - представление элемента компоновки данных,
//  Использование           - Булево - использование элемента,
//  РежимОтображения        - РежимОтображенияЭлементаНастройкиКомпоновкиДанных - режим отображения,
//  ИдентификаторПользовательскойНастройки - Строка - см. ОтборКомпоновкиДанных.ИдентификаторПользовательскойНастройки
//                                                    в синтакс-помощнике.
//
&НаСервереБезКонтекста
Функция ДобавитьЭлементКомпоновки(ОбластьДобавления,
									Знач ИмяПоля,
									Знач ВидСравнения,
									Знач ПравоеЗначение = Неопределено,
									Знач Представление  = Неопределено,
									Знач Использование  = Неопределено,
									знач РежимОтображения = Неопределено,
									знач ИдентификаторПользовательскойНастройки = Неопределено)
	
	Элемент = ОбластьДобавления.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	Элемент.ЛевоеЗначение = Новый ПолеКомпоновкиДанных(ИмяПоля);
	Элемент.ВидСравнения = ВидСравнения;
	
	Если РежимОтображения = Неопределено Тогда
		Элемент.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	Иначе
		Элемент.РежимОтображения = РежимОтображения;
	КонецЕсли;
	
	Если ПравоеЗначение <> Неопределено Тогда
		Элемент.ПравоеЗначение = ПравоеЗначение;
	КонецЕсли;
	
	Если Представление <> Неопределено Тогда
		Элемент.Представление = Представление;
	КонецЕсли;
	
	Если Использование <> Неопределено Тогда
		Элемент.Использование = Использование;
	КонецЕсли;
	
	// Важно: установка идентификатора должна выполняться
	// в конце настройки элемента, иначе он будет скопирован
	// в пользовательские настройки частично заполненным.
	Если ИдентификаторПользовательскойНастройки <> Неопределено Тогда
		Элемент.ИдентификаторПользовательскойНастройки = ИдентификаторПользовательскойНастройки;
	ИначеЕсли Элемент.РежимОтображения <> РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный Тогда
		Элемент.ИдентификаторПользовательскойНастройки = ИмяПоля;
	КонецЕсли;
	
	Возврат Элемент;
	
КонецФункции

&НаСервере
Процедура ОтменитьДляВыбранныхСервер()
	
	СписокЭлтов = Новый Массив;
	ВыделенныеСтроки = Элементы.РеквизитыОбъектаМетаданных.ВыделенныеСтроки;
	Для Каждого Стр Из ВыделенныеСтроки Цикл
		СписокЭлтов.Добавить(РеквизитыОбъектаМетаданных.НайтиПоИдентификатору(Стр).Ссылка);
	КонецЦикла;
	
	ТЗ_Обновления = ПолучитьРеквизитыОбъектаМетаданных(СписокЭлтов);
	
	Для Каждого Элт Из ТЗ_Обновления Цикл
		Замена = РеквизитыОбъектаМетаданных.НайтиСтроки(Новый Структура("Ссылка", Элт.Ссылка));
		Если Замена.Количество() > 0 Тогда
			ЗаполнитьЗначенияСвойств(Замена[0], Элт);
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

// Функция считывает в табличный документ данные из файла в формате Excel.
//
// Параметры:
//  ТабличныйДокумент  - ТабличныйДокумент, в который необходимо прочитать данные,
//  ИмяФайла           - имя файла в формате Excel, из которого необходимо прочитать данные,
//  НомерЛистаExcel    - номер листа книги Excel, из которого необходимо прочитать данные.
//
// Возвращаемое значение:
//  Истина, если файл прочитан, Ложь - иначе.
//
&НаКлиенте
Функция ПрочитатьТабличныйДокументИзExcel(ТабличныйДокумент, ИмяФайла, НомерЛистаExcel = 1) Экспорт
	
	ФайлЧтения = ИмяФайла;
	НомерСтраницы = НомерЛистаExcel;
	
	xlLastCell = 11;
	
	ВыбФайл = Новый Файл(ИмяФайла);
	Если НЕ ВыбФайл.Существует() Тогда
		ТекстСообщения = НСтр("ru = 'Файл загрузки не выбран!'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		НомерСтраницы = мКэшНомерСтраницы;
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Excel = Новый COMОбъект("Excel.Application");
		Excel.WorkBooks.Open(ИмяФайла);
		Состояние("Обработка файла Microsoft Excel...");
		ExcelЛист = Excel.Sheets(НомерЛистаExcel);
	Исключение
		ТекстСообщения = НСтр("ru = 'Ошибка. Возможно неверно указан номер листа книги Excel.'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		НомерСтраницы = мКэшНомерСтраницы;
		Возврат Ложь;
	КонецПопытки;
	
	ОчиститьТабличныйДокумент(ТабличныйДокумент);
	
	ActiveCell = Excel.ActiveCell.SpecialCells(xlLastCell);
	RowCount = ActiveCell.Row;
	ColumnCount = ActiveCell.Column;
	
	Для Column = 1 По ColumnCount Цикл
		ТабличныйДокумент.Область("C" + Формат(Column, "ЧГ=")).ШиринаКолонки = ExcelЛист.Columns(Column).ColumnWidth;
	КонецЦикла;
	
	Для Row = 1 По RowCount Цикл
		Для Column = 1 По ColumnCount Цикл
			ТабличныйДокумент.Область("R" + Формат(Row, "ЧГ=") +"C" + Формат(Column, "ЧГ=")).Текст = ExcelЛист.Cells(Row,Column).Text;
		КонецЦикла;
	КонецЦикла;
	
	Excel.WorkBooks.Close();
	Excel = 0;
	
	мКэшНомерСтраницы = НомерЛистаExcel;
	
	Возврат Истина;
	
КонецФункции

&НаСервереБезКонтекста
Процедура ОчиститьТабличныйДокумент(ТабличныйДокумент) 

	ТабличныйДокумент.Очистить();
	
КонецПроцедуры

// Процедура формирует структуру колонок загружаемых реквизитов из табличной части "ТаблицаЗагружаемыхРеквизитов".
&НаСервере
Процедура СформироватьСтруктуруКолонок()
	
	ТЗЗагружаемыхРеквизитов = РеквизитФормыВЗначение("ТаблицаЗагружаемыхРеквизитов");
	НомерКолонки = 1;
	Колонки = Новый Структура;
	Для Каждого ЗагружаемыйРеквизит Из ТЗЗагружаемыхРеквизитов Цикл
		
		Если НЕ ЗагружаемыйРеквизит.Пометка Тогда
			Продолжить;	
		КонецЕсли;
		
		Колонка = Новый Структура;
		
		Для каждого КолонкаЗагружаемыхРеквизитов Из ТЗЗагружаемыхРеквизитов.Колонки Цикл
			Колонка.Вставить(КолонкаЗагружаемыхРеквизитов.Имя,ЗагружаемыйРеквизит[КолонкаЗагружаемыхРеквизитов.Имя]);
		КонецЦикла;
		
		Колонки.Вставить(Колонка.ИмяРеквизита,Колонка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьНаСервере(ОшибкиЗаписи) // Нужна оптимизация.
	
	СформироватьСтруктуруКолонок();
	КоличествоЭлементов = ТабДок.ВысотаТаблицы - ПерваяСтрокаДанных + 1;
	СтрокиПоиска = ТаблицаЗагружаемыхРеквизитов.НайтиСтроки(Новый Структура("ПолеПоиска, Пометка", Истина, Истина));
	
	// Нужна объектная модель, убрать из цикла.
	Если Справочник = "бит_Квартиры" Тогда // Заполняется только через лицевые счета.
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|Справочник.Ссылка КАК ЛС,
		|Справочник.Квартира КАК Ссылка
		|ИЗ Справочник.бит_ЛицевыеСчета КАК Справочник
		|ГДЕ";
	ИначеЕсли Справочник = "бит_ЛицевыеСчетаКР" Тогда
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|Справочник.Ссылка КАК Ссылка
		|ИЗ Справочник.бит_ЛицевыеСчета КАК Справочник
		|ГДЕ";
	Иначе	
		ТекстЗапроса =
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|Справочник.Ссылка КАК Ссылка
		|ИЗ Справочник." + Справочник + " КАК Справочник
		|ГДЕ";
	КонецЕсли;
	
	Для Каждого СтрокаПоиска Из СтрокиПоиска Цикл
		ТекстЗапроса = ТекстЗапроса +"
		|Справочник." + СтрокаПоиска.ИмяРеквизита + " = &" + СтрокаПоиска.ИмяРеквизита + "
		|И";
	КонецЦикла;
	
	ТекстЗапроса = Лев(ТекстЗапроса,СтрДлина(ТекстЗапроса) - 2);
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Индикатор = 0;
	Элементы.Индикатор.МаксимальноеЗначение = КоличествоЭлементов;
	Загружено = 0;
	МассивОбработки = Новый Массив;
	
	Для К = ПерваяСтрокаДанных По ТабДок.ВысотаТаблицы Цикл
		НомерТекущейСтроки = Индикатор + 1;
		ТекстыЯчеек = Неопределено;
		Отказ = Ложь;
		ТекущаяСтрока = КонтрольЗаполненияСтроки(ТабДок, К, ТекстыЯчеек);
			
		ОбъектЗаполнения = Неопределено;
		
		Индикатор = Индикатор + 1;
		
		Если НЕ Запрос = Неопределено Тогда
			СтрокаОшибок = "";
			Для каждого СтрокаПоиска Из СтрокиПоиска Цикл
				
				ЗначениеРеквизита = Неопределено;
				
				ТекущаяСтрока.Свойство(СтрокаПоиска.ИмяРеквизита,ЗначениеРеквизита);
				Если ПустаяСтрока(ЗначениеРеквизита) Тогда
					СтрокаОшибок = ?(ПустаяСтрока(СтрокаОшибок),"",СтрокаОшибок + ", ") + СтрокаПоиска.ПредставлениеРеквизита;
				Иначе
					Если Справочник = "бит_ЛицевыеСчетаКР" И СтрокаПоиска.ИмяРеквизита = "Наименование" Тогда
						ПараметрПоиска = ТекущаяСтрока[СтрокаПоиска.ИмяРеквизита];
						ПараметрПоиска = Прав(СокрЛП(ПараметрПоиска), СтрДлина(СокрЛП(ПараметрПоиска)) - 2);
						Запрос.УстановитьПараметр(СтрокаПоиска.ИмяРеквизита,ПараметрПоиска);
					Иначе
						Запрос.УстановитьПараметр(СтрокаПоиска.ИмяРеквизита,ТекущаяСтрока[СтрокаПоиска.ИмяРеквизита]);
					КонецЕсли;
				КонецЕсли;
				
			КонецЦикла;
			
			Если Не ПустаяСтрока(СтрокаОшибок) Тогда
				ТекстСообщения = НСтр("ru = 'Строка " + НомерТекущейСтроки + " не может быть записана.Не указано значение ключевых реквизитов: " + СтрокаОшибок + "'");
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
				Индикатор = Индикатор + 1;
				Продолжить;
			КонецЕсли;
			
			Попытка
				Выборка = Запрос.Выполнить().Выбрать();
			Исключение
				ТекстСообщения = НСтр("ru = 'Ошибка в настройке загрузки данных.'");
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
			КонецПопытки;
			
			Если Выборка.Следующий() Тогда
				
				Если НЕ МассивОбработки.Найти(Выборка.Ссылка) = Неопределено Тогда
					Продолжить;
				КонецЕсли;
				МассивОбработки.Добавить(Выборка.Ссылка);
				
				ОбъектЗаполнения = Выборка.Ссылка.ПолучитьОбъект();
			КонецЕсли;
			
		КонецЕсли;
		
		ОбъектНайден = Не ОбъектЗаполнения = Неопределено;
		Если ОбъектЗаполнения = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Для каждого КлючИЗначение Из ТекущаяСтрока Цикл
			
			Если Колонки[КлючИЗначение.Ключ].Пометка И Колонки[КлючИЗначение.Ключ].РежимЗагрузки Тогда
				Попытка
					ОбъектЗаполнения[КлючИЗначение.Ключ] = КлючИЗначение.Значение;
				Исключение
					ТекстСообщения = НСтр("ru = 'Ошибка при установки значения реквизита """ + КлючИЗначение.Ключ + "" + ОписаниеОшибки() + "'");
					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
					Отказ = Истина;
					Прервать;
				КонецПопытки;
			КонецЕсли;
			
		КонецЦикла;
		
		Если Не Отказ и ЗаписатьОбъект(ОбъектЗаполнения, ТекстыЯчеек) Тогда
			ТекстСообщения = НСтр("ru = '" + ?(ОбъектНайден,"Изменен","Загружен") + " элемент справочника: " + ОбъектЗаполнения.Ссылка + "'");
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
			Загружено = Загружено + 1;
		Иначе
			ТекстСообщения = НСтр("ru = 'Объект не " + ?(ОбъектНайден,"изменен","загружен") + ". Элемент справочника: " + ОбъектЗаполнения + ".'");
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		КонецЕсли;
		
		Индикатор = Индикатор + 1;
		
	КонецЦикла;
	МассивОбработки = Неопределено;
	
КонецПроцедуры 

&НаСервере
Функция ЗаписатьОбъект(Объект, ТекстыЯчеек = Неопределено)
	
	НачатьТранзакцию();
	
	Попытка
		Объект.Записать();
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = '%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат Ложь;
	КонецПопытки;
	
	ЗафиксироватьТранзакцию();
	Возврат Истина;
	
КонецФункции

&НаСервере
Функция КонтрольЗаполненияСтроки(ТабДок, НомерСтроки, ТекстыЯчеек = Неопределено, КоличествоОшибок = 0)
	
	ТекстыЯчеек = Новый Массив;
	ТекстыЯчеек.Добавить(Неопределено);
	Для к = 1 По ТабДок.ШиринаТаблицы Цикл
		ТекстыЯчеек.Добавить(СокрЛП(ТабДок.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(К,"ЧГ=")).Текст));
	КонецЦикла;
	
	ТекущаяСтрока     = Новый Структура;
	Для каждого КлючИЗначение Из Колонки Цикл
		
		Колонка = КлючИЗначение.Значение;
		
		Если (Колонка.РежимЗагрузки 
			ИЛИ Колонка.ПолеПоиска)
			И НЕ Колонка.НомерКолонки = 0 Тогда
			
			Если Не ОбработатьОбласть(ТабДок.Область("R"+Формат(НомерСтроки,"ЧГ=")+"C"+Формат(Колонка.НомерКолонки,"ЧГ=")), Колонка, ТекущаяСтрока, ТекстыЯчеек) Тогда
				КоличествоОшибок = КоличествоОшибок + 1;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
		
	Возврат ТекущаяСтрока;
	
КонецФункции

// Процедура выполняет обработку области табличного документа,
// заполняет расшифровку по представлению ячейки в соответствии со структурой загружаемых реквизитов,
// сообщает об ошибке и устанавливает коментарий, если ячейка содержит ошибку.
//
// Параметры:
//  Область - область табличного документа,
//  Колонка - Структура, свойства, в соответствии с которыми необходимо выполнить обработку области,
//  ТекущиеДанные  - структура загруженных значений,
//  ТекстыЯчеек    - массив текстов ячеек строки.
//
&НаСервере
Функция ОбработатьОбласть(Область, Колонка, ТекущиеДанные, ТекстыЯчеек)
	
	Представление = Область.Текст;
	Примечание = "";
	
	Если ПустаяСтрока(Представление) Тогда
		Результат = Неопределено;
	Иначе
		Результат = область.Текст;
	КонецЕсли;
	
	ТекущиеДанные.Вставить(Колонка.ИмяРеквизита,Результат);
	Если Не ПустаяСтрока(Примечание) Тогда
		ТекстСообщения = НСтр("ru = 'Ячейка["+Область.Имя+"]("+Колонка.ПредставлениеРеквизита+"): " + Примечание + "'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
	КонецЕсли;
	
	Возврат ПустаяСтрока(Примечание);
	
КонецФункции

