// Процедура - обработчик события "НачалоПеретаскивания" табличного поля "ДанныеДерева".
//
&НаКлиенте
Процедура ДанныеДереваНачалоПеретаскивания(Элемент, ПараметрыПеретаскивания, Выполнение)
	
	мПараметрыПеретаскивания = Неопределено;
	
	мСписокСтрок             =  Неопределено;
	ТекущиеДанныеДрева   = Элемент.ТекущиеДанные;
	ТекущаяЭлементДерева = Элемент.ТекущийЭлемент;
	
	Если ТекущаяЭлементДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанныеДрева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = ТекущаяЭлементДерева.Имя;
	Если Найти(ИмяКолонки,"РеквизитДерева_") > 0 Тогда
		
		ТекущийПериод = ПолучитьПериодПоИмениКолонки(ИмяКолонки);
		Если Не ЗначениеЗаполнено(ТекущийПериод) Тогда
			
			Возврат;
			
		КонецЕсли; 
		
		Отбор = Новый Структура("Период,СтатьяОборотов,ИД");
		Отбор.Период         = ТекущийПериод;
		Отбор.СтатьяОборотов = ТекущиеДанныеДрева.СтатьяОборотов;
		Отбор.ИД             = ТекущиеДанныеДрева.Идентификатор;
		
		МассивСтрок = Объект.БДДС.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество()> 0 Тогда
			
			мПараметрыПеретаскивания = Новый Структура;
			мПараметрыПеретаскивания.Вставить("МассивСтрок",МассивСтрок);
			мПараметрыПеретаскивания.Вставить("ИмяКолонки",ИмяКолонки);
			мПараметрыПеретаскивания.Вставить("ПрефиксКолонки",Лев(ИмяКолонки,15));
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ПроверкаПеретаскивания" табличного поля "ДанныеДерева".
//
&НаКлиенте
Процедура ДанныеДереваПроверкаПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка, Строка, Поле)
	
	Если Поле = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	СтрокаДерева = ДанныеДерева.НайтиПоИдентификатору(Строка);
	
	Если СтрокаДерева = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если СтрокаДерева.ЭтоГруппа Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если мПараметрыПеретаскивания <> Неопределено Тогда
		
		ИмяКолонки = Поле.Имя;
		ПрефиксКолонки = Лев(ИмяКолонки,15);
		
		Если СтрокаДерева[ИмяКолонки] <> 0 Тогда
			
			Возврат;
			
		КонецЕсли; 
		
		ТекущийПериод = ПолучитьПериодПоИмениКолонки(ИмяКолонки);
		Если Не ЗначениеЗаполнено(ТекущийПериод) Тогда
			
			Возврат;
			
		КонецЕсли; 
		
		Если ПрефиксКолонки = мПараметрыПеретаскивания.ПрефиксКолонки Тогда
			
			Итог = 0;
			
			Для каждого СтрокаИсточник Из мПараметрыПеретаскивания.МассивСтрок Цикл
				
				НоваяСтрока = Объект.БДДС.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока,СтрокаИсточник);
				НоваяСтрока.СтатьяОборотов      = СтрокаДерева.СтатьяОборотов;
				НоваяСтрока.Период              = ТекущийПериод;
				НоваяСтрока.ИД                  = СтрокаДерева.Идентификатор;
				НоваяСтрока.СпособРаспределения = СпособРаспределения;
				
				Итог = Итог + НоваяСтрока.Сумма;
				
			КонецЦикла; 
			
			СтрокаДерева[ИмяКолонки] = Итог;
			
			ВыполнитьПересчетВСтрокеДерева(СтрокаДерева);
			
			ВычислитьИтогПоВерхнимУровням(СтрокаДерева, ИмяКолонки);
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ОкончаниеПеретаскивания" табличного поля "ДанныеДерева".
//
&НаКлиенте
Процедура ДанныеДереваОкончаниеПеретаскивания(Элемент, ПараметрыПеретаскивания, СтандартнаяОбработка)
	
	Если мПараметрыПеретаскивания <> Неопределено Тогда
		
		мПараметрыПеретаскивания = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - назначаемый обработчик события "ПриИзменении", 
// созданным автоматически полям табличного поля "ДанныеДерева".
//
&НаКлиенте
Процедура ДанныеДереваПериодПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ДанныеДерева.ТекущиеДанные;
	
	Отбор = Новый Структура;
	
	ТекущиеДанныеБДДС = Элементы.БДДС.ТекущиеДанные;
	
	Отбор.Вставить("СтатьяОборотов", Элементы.БДДС.ОтборСтрок.СтатьяОборотов);
	Отбор.Вставить("Период"        , Элементы.БДДС.ОтборСтрок.Период);
	Отбор.Вставить("ИД"            , Элементы.БДДС.ОтборСтрок.ИД);
	
	СуммаИтог = ТекущиеДанные[Элемент.Имя];
	
	МассивСтрок = Объект.БДДС.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() = 0 Тогда
		
		Для каждого Строка Из Объект.СписокЗданий Цикл
			
			НоваяСтрока = Объект.БДДС.Добавить();
			НоваяСтрока.СтатьяОборотов = Элементы.БДДС.ОтборСтрок.СтатьяОборотов;
			НоваяСтрока.Здание         = Строка.Здание;
			НоваяСтрока.Процент        = Строка.Процент;
			НоваяСтрока.Период         = Элементы.БДДС.ОтборСтрок.Период;
			НоваяСтрока.ИД             = Элементы.БДДС.ОтборСтрок.ИД;
			
			ПочтовыйАдрес = ПочтовыйАдресНаСервере(Строка.Здание);
			
			НоваяСтрока.Адрес          = ПочтовыйАдрес;
			НоваяСтрока.СпособРаспределения = Объект.СпособРаспределения;
			
			Улица = УлицаНаСервере(Строка.Здание);
			
			НоваяСтрока.ЗданиеПредставление = "ул." + Улица + " ,д" + Строка.Здание;;
			
		КонецЦикла;
		
		СпособРаспределения = Объект.СпособРаспределения;
		
	КонецЕсли;
	
	РазбитьСуммуПоЗданиям(Отбор, СуммаИтог);
	
	Элементы.БДДС.Обновить();
	
	ВыполнитьПересчетВСтрокеДерева(ТекущиеДанные);
	ВычислитьИтогПоВерхнимУровням(ТекущиеДанные,Элемент.Имя);
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляБДДС

// Процедура - обработчик события "ПередНачаломДобавления" табличного поля "БДДС".
//
&НаКлиенте
Процедура БДДСПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	ТекущиеДанныеДерева = Элементы.ДанныеДерева.ТекущиеДанные;
	
	Если ТекущиеДанныеДерева = Неопределено 
		ИЛИ ТекущиеДанныеДерева.ЭтоГруппа Тогда
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ТекОтборСтрок = Элементы.БДДС.ОтборСтрок;
	
	Если ТекОтборСтрок = Неопределено ИЛИ Не ТекОтборСтрок.Свойство("ИД") ИЛИ Не ТекОтборСтрок.Свойство("Период")Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Невозможно добавить данные: не установлены отборы в таблице.";
		Сообщение.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

