ВЫБРАТЬ
	ВТ_Данные.VID КАК VID,
	ВТ_Данные.Период КАК Период,
	ВТ_Данные.Услуга КАК Услуга,
	СУММА(ВТ_Данные.Сумма) КАК Сумма,
	ВЫБОР
		КОГДА ВТ_Данные.Услуга.Код = "00-000001"
			ТОГДА 10
		КОГДА ВТ_Данные.Услуга.Код = "00-000010"
			ТОГДА 20
		КОГДА ВТ_Данные.Услуга.Код = "00-000011"
			ТОГДА 30
		КОГДА ВТ_Данные.Услуга.Код = "00-000012"
			ТОГДА 40
		КОГДА ВТ_Данные.Услуга.Код = "00-000015"
			ТОГДА 50
		КОГДА ВТ_Данные.Услуга.Код = "00-000007"
			ТОГДА 60
		КОГДА ВТ_Данные.Услуга.Код = "00-000018"
			ТОГДА 70
