#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

// Элементы справочника являются контейнерами для хранения связанных сведений об учетной политике

#Область ПрограммныйИнтерфейс

// Конструктор объекта, позволяющего работать с базовыми настройками: просматривать, редактировать, применять.
//
// Полное имя НастройкиУчетаЗатрат можно сокращать до Настройки, когда из контекста ясно, что речь идет о НастройкиУчетаЗатрат.
//
Функция НовыйБазовыеНастройкиУчетаЗатрат() Экспорт
	
	Настройки = Новый Структура;
	Настройки.Вставить("Контекст",                   НовыйКонтекстНастроекУчетаЗатрат()); // откуда получены настройки
	Настройки.Вставить("Ссылка",                     Справочники.НастройкиУчетаЗатрат.ПустаяСсылка());
	Настройки.Вставить("СчетаУчета",                 Новый Массив);       // элементы - ПланСчетовСсылка.Хозрасчетный
	Настройки.Вставить("Аналитика",                  Новый Соответствие); // Ключ - Счет, Значение - Массив видов субконто, имен измерений регистра бухгалтерии
	Настройки.Вставить("ОтображаемаяАналитика",      Новый Соответствие); // Аналитика, отображаемая пользователю, т.е. по которой предполагается фактическая вариативность
	Настройки.Вставить("БазаРаспределения",          Перечисления.БазыРаспределенияКосвенныхРасходов.ПустаяСсылка());
	Настройки.Вставить("ОсобыеПравилаРаспределения", НовыйОсобыеПравилаРаспределения());
	
	Возврат Настройки;
	
КонецФункции

// Проверяет, что переданные данные соответствуют по структуре настройкам учета затрат
//
// Параметры:
//  ПроверяемоеЗначение - Структура, см. НовыйБазовыеНастройкиУчетаЗатрат
// 
// Возвращаемое значение:
//  Булево - Истина, если переданное значение - настройки учета затрат
//
Функция ЭтоНастройкиУчетаЗатрат(Знач ПроверяемоеЗначение) Экспорт
	
	Если ТипЗнч(ПроверяемоеЗначение) <> Тип("Структура") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ЭлементБазовыхНастроек Из НовыйБазовыеНастройкиУчетаЗатрат() Цикл
		Если Не ПроверяемоеЗначение.Свойство(ЭлементБазовыхНастроек.Ключ) Тогда
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции

// Заполняет базовые настройки учета затрат значениями по умолчанию
//
// Параметры:
//  Настройки - Структура - см. НовыйБазовыеНастройкиУчетаЗатрат
//
Процедура ЗаполнитьПоУмолчанию(Настройки) Экспорт
	
	ЗаполнитьПоУмолчаниюСчетаУчета(Настройки);
	ПрименитьНастройкиПланаСчетов(Настройки.Аналитика, Настройки.ОтображаемаяАналитика, Настройки.СчетаУчета);
	Настройки.БазаРаспределения = Перечисления.БазыРаспределенияКосвенныхРасходов.ПрямыеЗатраты;
	
КонецПроцедуры

// Валидирует базовые настройки учета затрат. Незаполненные приводятся к значениям по умолчанию
//
// Параметры:
//  Настройки - Структура - см. НовыйБазовыеНастройкиУчетаЗатрат
//
Процедура Исправить(Настройки) Экспорт
	
	ИменаКоллекцийАналитики = Новый Массив; // Обрабатываемые коллекции, см. НовыйБазовыеНастройкиУчетаЗатрат
	ИменаКоллекцийАналитики.Добавить("Аналитика");
	ИменаКоллекцийАналитики.Добавить("ОтображаемаяАналитика");
		
	Если Не ЗначениеЗаполнено(Настройки.СчетаУчета) Тогда
		
		Для Каждого ИмяКоллекции Из ИменаКоллекцийАналитики Цикл
			Настройки[ИмяКоллекции].Очистить();
		КонецЦикла;
		
		ЗаполнитьПоУмолчанию(Настройки);
		Возврат;
		
	КонецЕсли;
		
	КонтрольныеНастройки = НовыйБазовыеНастройкиУчетаЗатрат();
	ЗаполнитьПоУмолчанию(КонтрольныеНастройки);
	
	Если Не ЗначениеЗаполнено(Настройки.БазаРаспределения) Тогда
		Настройки.БазаРаспределения = КонтрольныеНастройки.БазаРаспределения;
	КонецЕсли;
	
	КонтрольныеНастройки.СчетаУчета = Настройки.СчетаУчета;
	ПрименитьНастройкиПланаСчетов(
		КонтрольныеНастройки.Аналитика,
		КонтрольныеНастройки.ОтображаемаяАналитика,
		КонтрольныеНастройки.СчетаУчета);
		
	Для Каждого ИмяКоллекции Из ИменаКоллекцийАналитики Цикл
		
		Для Каждого Счет Из Настройки.СчетаУчета Цикл
			
			АналитикаСчета             = Настройки[ИмяКоллекции][Счет];
			КонтрольнаяАналитикаСчета  = КонтрольныеНастройки[ИмяКоллекции][Счет];
			Если АналитикаСчета = Неопределено Тогда
				// Убедимся, что для всех счетов определена аналитика
				Настройки[ИмяКоллекции].Вставить(Счет, КонтрольнаяАналитикаСчета);
			Иначе
				
				// Убедимся, что нет недопустимых для счета видов аналитики
				КоличествоЭлементов = АналитикаСчета.Количество();
				Для НомерСКонца = 1 По КоличествоЭлементов Цикл
					Индекс = КоличествоЭлементов - НомерСКонца;
					Если КонтрольнаяАналитикаСчета.Найти(АналитикаСчета[Индекс]) <> Неопределено Тогда
						Продолжить;
					КонецЕсли;
					АналитикаСчета.Удалить(Индекс);
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЦикла; //По счетам
		
	КонецЦикла; // По ИменаКоллекцийАналитики
	
	ИсправитьПоКонтексту(Настройки);
	
КонецПроцедуры

// Читает содержимое базовых настроек учета затрат из справочника.
//
// Параметры:
//  Настройки - Структура - см. НовыйБазовыеНастройкиУчетаЗатрат, заполняемая коллекция
//  Ссылка    - СправочникСсылка.НастройкиУчетаЗатрат - читаемая ссылка. Допустимо передавать некорректную ("битую") ссылку
//
Процедура ПрочитатьСсылку(Настройки, Ссылка) Экспорт
	
	Настройки.Ссылка = Ссылка;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.СчетУчета КАК СчетУчета,
	|	Хозрасчетный.Порядок КАК Порядок,
	|	Хозрасчетный.Код КАК Код
	|ИЗ
	|	Справочник.НастройкиУчетаЗатрат.ПланСчетов КАК Настройки
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПланСчетов.Хозрасчетный КАК Хозрасчетный
	|		ПО Настройки.СчетУчета = Хозрасчетный.Ссылка
	|ГДЕ
	|	Настройки.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	Порядок,
	|	Код,
	|	СчетУчета";
	СчетаУчета = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("СчетУчета");
	
	Настройки.СчетаУчета = Новый Массив(УчетЗатрат.СчетаРасходов(СчетаУчета));
	
	Если Не ЗначениеЗаполнено(Настройки.СчетаУчета) Тогда
		ЗаполнитьПоУмолчаниюСчетаУчета(Настройки);
	КонецЕсли;
	
	ПрименитьНастройкиПланаСчетов(Настройки.Аналитика, Настройки.ОтображаемаяАналитика, Настройки.СчетаУчета);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Настройки.БазаРаспределения КАК БазаРаспределения
	|ИЗ
	|	Справочник.НастройкиУчетаЗатрат КАК Настройки
	|ГДЕ
	|	Настройки.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	ЗаполнитьЗначенияСвойств(Настройки, Выборка);
	
	// Особые правила распределения
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Правила.НомерСтроки КАК Ссылка,
	|	Правила.Счет КАК Счет,
	|	Правила.Подразделение КАК Подразделение,
	|	Правила.СтатьяЗатрат КАК СтатьяЗатрат,
	|	Правила.БазаРаспределения КАК БазаРаспределения,
	|	Правила.СписокСтатейЗатрат КАК СписокСтатейЗатрат,
	|	Правила.СчетПрямыхЗатрат КАК СчетПрямыхЗатрат,
	|	Правила.ПодразделениеЗатрат КАК ПодразделениеЗатрат
	|ИЗ
	|	Справочник.НастройкиУчетаЗатрат.ОсобыеПравилаРаспределения КАК Правила
	|ГДЕ
	|	Правила.Ссылка = &Ссылка
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(Настройки.ОсобыеПравилаРаспределения.Добавить(), Выборка);
	КонецЦикла;
	
КонецПроцедуры

// Возвращает содержимое правила распределения - элемента настройки, выполненной пользователем
// (в частности, строки табличной части ОсобыеПравилаРаспределения)
//
// Параметры:
//  Настройки - Структура - см. НовыйБазовыеНастройкиУчетаЗатрат, прочитанные настройки
//  ИдентификаторНастройки - Число - номер строки особых правил распределения; 0 - общее правило распределения.
// 
// Возвращаемое значение:
//  Структура - набор полей как в табличной части ОсобыеПравилаРаспределения
//
Функция СодержимоеПравилаРаспределения(Настройки, ИдентификаторНастройки) Экспорт
	
	СодержимоеНастройки = Новый Структура;
	
	ОписаниеТабличнойЧасти = Метаданные.Справочники.НастройкиУчетаЗатрат.ТабличныеЧасти.ОсобыеПравилаРаспределения.Реквизиты;
	Для Каждого ОписаниеПоля Из ОписаниеТабличнойЧасти Цикл
		СодержимоеНастройки.Вставить(ОписаниеПоля.Имя, ОписаниеПоля.Тип.ПривестиЗначение(Неопределено));
	КонецЦикла;
	
	СодержимоеНастройки.БазаРаспределения = Настройки.БазаРаспределения;
	
	Если ИдентификаторНастройки = 0 Тогда
		Возврат СодержимоеНастройки;
	КонецЕсли;
	
	Если ИдентификаторНастройки > Настройки.ОсобыеПравилаРаспределения.Количество() Тогда
		Возврат СодержимоеНастройки;
	КонецЕсли;
	
	Правило = Настройки.ОсобыеПравилаРаспределения[ИдентификаторНастройки - 1];
	
	ЗаполнитьЗначенияСвойств(СодержимоеНастройки, Правило);
	
	Возврат СодержимоеНастройки;
	
КонецФункции

// Конструктор коллекции, предназначенной для редактирования настроек учета затрат.
// Расширяет настройки сведениями, необходимыми для записи их в информационную базу.
//
// Параметры:
//  Настройки - Структура - см. НовыйБазовыеНастройкиУчетаЗатрат настройки учета затрат
// 
// Возвращаемое значение:
//  Структура - созданная коллекция; состав свойств см. в теле функции
//
Функция НовыйРедактированиеНастроекУчетаЗатрат(Знач Настройки = Неопределено) Экспорт
	
	Если Настройки = Неопределено Тогда
		Настройки = НовыйБазовыеНастройкиУчетаЗатрат();
	КонецЕсли;
	
	РедактированиеНастроек = Новый Структура;
	РедактированиеНастроек.Вставить("Настройки",          Настройки);
	РедактированиеНастроек.Вставить("Ссылка",             ПустаяСсылка());
	РедактированиеНастроек.Вставить("Модифицированность", Ложь);
	РедактированиеНастроек.Вставить("КраткоеОписание",    Новый ФорматированнаяСтрока(""));
	
	ЗаполнитьКраткоеОписание(РедактированиеНастроек);
	
	Возврат РедактированиеНастроек;
	
КонецФункции

// Формирует (заполняет, обновляет) краткое описание настройки.
//
// Параметры:
//  РедактированиеНастроек - Структура - см. НовыйРедактированиеНастроекУчетаЗатрат
//
Процедура ЗаполнитьКраткоеОписание(РедактированиеНастроек) Экспорт
	
	// Пока описание включает лишь перечень счетов
	
	Если Не ЗначениеЗаполнено(РедактированиеНастроек.Настройки.СчетаУчета) Тогда
		
		ОписаниеHTML = СтрШаблон(НСтр("ru = 'Счета учета затрат: <a href = ""%1"">Настроить</a>'"), ИмяКомандыСчетаУчета());
		
	ИначеЕсли РедактированиеНастроек.Настройки.СчетаУчета.Количество() = 1 Тогда
		
		СчетУчета = РедактированиеНастроек.Настройки.СчетаУчета[0];
		
		ЭлементыПредставления = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СчетУчета, "Код, Наименование");
		
		ПредставлениеСчета = ПланыСчетов.Хозрасчетный.ПолноеПредставлениеСчета(
			СчетУчета,
			ЭлементыПредставления.Код,
			ЭлементыПредставления.Наименование);
		
		ОписаниеHTML = СтрШаблон(
			НСтр("ru = 'Затраты учитываются на счете <a href = ""%1"">%2</a>'"),
			ИмяКомандыСчетаУчета(),
			ПредставлениеСчета);
			
	Иначе
		
		ЭлементыПредставлений = ОбщегоНазначения.ЗначениеРеквизитаОбъектов(РедактированиеНастроек.Настройки.СчетаУчета, "Код");
		
		КодыСчетов = Новый Массив;
		Для Каждого Счет Из РедактированиеНастроек.Настройки.СчетаУчета Цикл
			КодСчета = ЭлементыПредставлений[Счет];
			Если КодСчета = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			КодыСчетов.Добавить(КодСчета);
		КонецЦикла;
		
		ОписаниеHTML = СтрШаблон(
			НСтр("ru = 'Затраты учитываются на счетах <a href = ""%1"">%2</a>'"),
			ИмяКомандыСчетаУчета(),
			ОбщегоНазначенияБПКлиентСервер.ПредставлениеСписка(КодыСчетов));
		
	КонецЕсли;
	
	РедактированиеНастроек.КраткоеОписание = СтроковыеФункцииКлиентСервер.ФорматированнаяСтрока(ОписаниеHTML);
	
КонецПроцедуры

// Определяет счета учета, для которых можно настроить особые правила распределения затрат
// 
// Возвращаемое значение:
//  Массив Из ПланСчетовСсылка.Хозрасчетный
//
Функция НастраиваемыеСчетаОсобыеПравилаРаспределения() Экспорт
	
	Возврат БухгалтерскийУчет.СформироватьМассивСубсчетов(ПредопределенныеСчетаПравилаРаспределения());
	
КонецФункции

// Определяет предопределенные счета учета, для которых можно настроить правила распределения затрат
// 
// Возвращаемое значение:
//  Массив Из ПланСчетовСсылка.Хозрасчетный
//
Функция ПредопределенныеСчетаПравилаРаспределения() Экспорт
	
	СчетаУчета = Новый Массив;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьМассив(СчетаУчета, УчетЗатрат.ПредопределенныеСчетаКосвенныхРасходов());
	РасширеннаяАналитикаЗатрат.ДобавитьСчетБракВПроизводстве(СчетаУчета);
	
	Возврат СчетаУчета;
	
КонецФункции

// Проверяет наличие ошибок при настройке базы распределения ОтдельныеСтатьиПрямыхЗатрат
//
// Параметры:
//  Ошибки    - ДеревоЗначений - коллекция будет дополнена результатом проверки
//  Настройки - НовыйБазовыеНастройкиУчетаЗатрат - проверяемые настройки
//
Процедура ПроверитьЗаполненСписокСтатейЗатрат(Ошибки, Настройки) Экспорт
	
	СпискиСтатейЗатрат = Новый Соответствие; // Ключ - список, Значение - массив настроек
	
	Для Каждого ДетальнаяНастройка Из Настройки.ОсобыеПравилаРаспределения Цикл
		
		Если ДетальнаяНастройка.БазаРаспределения <> Перечисления.БазыРаспределенияКосвенныхРасходов.ОтдельныеСтатьиПрямыхЗатрат Тогда
			Продолжить;
		КонецЕсли;
		
		ПрименениеСписка = СпискиСтатейЗатрат[ДетальнаяНастройка.СписокСтатейЗатрат];
		Если ПрименениеСписка = Неопределено Тогда
			ПрименениеСписка = Новый Массив;
			СпискиСтатейЗатрат.Вставить(ДетальнаяНастройка.СписокСтатейЗатрат, ПрименениеСписка);
		КонецЕсли;
		
		ПрименениеСписка.Добавить(ДетальнаяНастройка);
		
	КонецЦикла;
	
	// Не указан список
	СписокНеУказан = СпискиСтатейЗатрат[Справочники.СписокСтатейЗатратВключенныхВБазуРаспределенияКосвенныхРасходов.ПустаяСсылка()];
	Если СписокНеУказан <> Неопределено Тогда
		
		Ошибка = ВыводСообщенийОбОшибках.ДобавитьПростоеОписаниеОшибки(Ошибки);
		Ошибка.Описание = НСтр("ru = 'Не указан список статей затрат базы распределения ""Отдельные статьи прямых затрат"".'");
		
		Ошибка.Локализация = НСтр("ru = 'Проверьте особые правила распределения косвенных затрат:'");
		Ошибка.Ссылка      = СсылкаУчетнаяПолитика(Настройки);
		
		Для Каждого Правило Из СписокНеУказан Цикл
			
			МестоОшибки = Ошибка.ЛокализацияДетально.Добавить();
			МестоОшибки.Локализация = СтрШаблон(НСтр("ru = 'Строка %1'"), Правило.Ссылка);
			
		КонецЦикла;
		
	КонецЕсли;
	
	// Указан пустой список
	
	СпискиСтатейЗатратМассив = Новый Массив;
	Для Каждого ОписаниеСписка Из СпискиСтатейЗатрат Цикл
		
		Если Не ЗначениеЗаполнено(ОписаниеСписка.Ключ) Тогда
			Продолжить;
		КонецЕсли;
		
		СпискиСтатейЗатратМассив.Добавить(ОписаниеСписка.Ключ);
		
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СпискиСтатейЗатрат", СпискиСтатейЗатратМассив);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Списки.Ссылка КАК Ссылка,
	|	ПРЕДСТАВЛЕНИЕ(Списки.Ссылка) КАК Представление
	|ИЗ
	|	Справочник.СписокСтатейЗатратВключенныхВБазуРаспределенияКосвенныхРасходов КАК Списки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.СписокСтатейЗатратВключенныхВБазуРаспределенияКосвенныхРасходов.СтатьиЗатрат КАК СодержаниеСписка
	|		ПО Списки.Ссылка = СодержаниеСписка.Ссылка
	|ГДЕ
	|	Списки.Ссылка В(&СпискиСтатейЗатрат)
	|	И СодержаниеСписка.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Ошибка = ВыводСообщенийОбОшибках.ДобавитьПростоеОписаниеОшибки(Ошибки);
		Ошибка.Описание = СтрШаблон(НСтр("ru = 'Не заполнен список статей затрат %1.'"), Выборка.Представление);
		
		Ошибка.Локализация = НСтр("ru = 'Проверьте особые правила распределения косвенных затрат:'");
		Ошибка.Ссылка      = СсылкаУчетнаяПолитика(Настройки);
		
		Для Каждого Правило Из СпискиСтатейЗатрат[Выборка.Ссылка] Цикл
			
			МестоОшибки = Ошибка.ЛокализацияДетально.Добавить();
			МестоОшибки.Локализация = СтрШаблон(НСтр("ru = 'Строка %1'"), Правило.Ссылка);
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры

