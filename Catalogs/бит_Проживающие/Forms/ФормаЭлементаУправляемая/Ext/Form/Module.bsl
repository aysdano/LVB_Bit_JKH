//HD+
// Ограничивает редактирование формы для роли HD_ОтделПоРаботеСНаселением_Пользователь:
// доступны только телефон проживающего и страховой номер ПФР.
//
&НаКлиенте
Процедура HD_УстановитьДоступностьЭлементовДляОтделаПоРаботеСНаселением()
	
	Если НЕ HD_ТребуетсяОграничениеДоступаОтделаПоРаботеСНаселением() Тогда
		Возврат;
	КонецЕсли;
	
	ТолькоПросмотр = Ложь;
	
	РазрешенныеЭлементы = HD_РазрешенныеЭлементыФормыОтделаПоРаботеСНаселением();
	
	Для Каждого ЭлементФормы Из Элементы Цикл
		
		Разрешен = (РазрешенныеЭлементы.Получить(ЭлементФормы.Имя) <> Неопределено);
		HD_УстановитьДоступностьЭлементаФормы(ЭлементФормы, Разрешен);
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Возвращает соответствие разрешенных для редактирования элементов формы.
//
&НаКлиенте
Функция HD_РазрешенныеЭлементыФормыОтделаПоРаботеСНаселением()
	
	РазрешенныеЭлементы = Новый Соответствие;
	РазрешенныеЭлементы.Вставить("КонтактнаяИнформацияПолеТелефонПроживающего", Истина);
	РазрешенныеЭлементы.Вставить("СтраховойНомерПФР", Истина);
	РазрешенныеЭлементы.Вставить("КомандаКонтактнаяИнформацияПолеТелефонПроживающего", Истина);
	
	Возврат РазрешенныеЭлементы;
	
КонецФункции //HD-

//HD+
// Устанавливает доступность элемента формы в режиме ограниченного редактирования.
//
&НаКлиенте
Процедура HD_УстановитьДоступностьЭлементаФормы(ЭлементФормы, Разрешен)
	
	ТипЭлемента = ТипЗнч(ЭлементФормы);
	
	Если Разрешен Тогда
		
		Если ТипЭлемента = Тип("ПолеФормы")
			И ЭлементФормы.Вид <> ВидПоляФормы.ПолеНадписи Тогда
			ЭлементФормы.ТолькоПросмотр = Ложь;
			ЭлементФормы.Доступность = Истина;
		ИначеЕсли ТипЭлемента = Тип("КнопкаФормы") Тогда
			ЭлементФормы.Доступность = Истина;
		КонецЕсли;
		
		Возврат;
		
	КонецЕсли;
	
	Если ТипЭлемента = Тип("ПолеФормы") Тогда
		
		Если ЭлементФормы.Вид = ВидПоляФормы.ПолеНадписи Тогда
			
			Если ЭлементФормы.Гиперссылка Тогда
				ЭлементФормы.Доступность = Ложь;
			КонецЕсли;
			
		Иначе
			ЭлементФормы.ТолькоПросмотр = Истина;
		КонецЕсли;
		
	ИначеЕсли ТипЭлемента = Тип("ТаблицаФормы") Тогда
		
		ЭлементФормы.ТолькоПросмотр = Истина;
		
	ИначеЕсли ТипЭлемента = Тип("КнопкаФормы") Тогда
		
		Если HD_ЭтоСтандартнаяКомандаЗаписиФормы(ЭлементФормы.Имя) Тогда
			Возврат;
		КонецЕсли;
		
		ЭлементФормы.Доступность = Ложь;
		
	ИначеЕсли ТипЭлемента = Тип("ГруппаФормы")
		И СтрЗаканчиваетсяНа(ЭлементФормы.Имя, "КоманднаяПанель")
		И ЭлементФормы.Имя <> "ФормаКоманднаяПанель" Тогда
		
		ЭлементФормы.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Определяет, является ли кнопка стандартной командой записи или закрытия формы.
//
&НаКлиенте
Функция HD_ЭтоСтандартнаяКомандаЗаписиФормы(ИмяКоманды)
	
	Если ИмяКоманды = "ФормаЗаписать"
		ИЛИ ИмяКоманды = "ФормаЗаписатьИЗакрыть"
		ИЛИ ИмяКоманды = "ФормаЗакрыть" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат СтрНачинаетсяС(ИмяКоманды, "ФормаЗапис");
	
КонецФункции //HD-

//HD+
// Возвращает Истина, если для текущего пользователя нужно ограничить форму проживающего.
//
&НаСервере
Функция HD_ТребуетсяОграничениеДоступаОтделаПоРаботеСНаселением()
	
	ИмяРолиПользователь = "HD_ОтделПоРаботеСНаселением_Пользователь";
	
	Если Метаданные.Роли.Найти(ИмяРолиПользователь) = Неопределено
		ИЛИ НЕ РольДоступна(ИмяРолиПользователь) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если РольДоступна("ПолныеПрава") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяРолиАдминистратор = "HD_ОтделПоРаботеСНаселением_Администратор";
	Если Метаданные.Роли.Найти(ИмяРолиАдминистратор) <> Неопределено
		И РольДоступна(ИмяРолиАдминистратор) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции //HD-

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.бит_Проживающие.Форма.ФормаВводаМестаРожденияУправляемая" Тогда
		
		Объект.МестоРождения = ВыбранноеЗначение;
		
		// Представление места рождения.
		МестоРожденияФизЛица = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(Объект.МестоРождения);
		
		Если Не ЗначениеЗаполнено(МестоРожденияФизЛица) Тогда
			
			МестоРожденияФизЛица = "Ввести место рождения";
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьФорму" и (Источник = Объект.Ссылка или (ТипЗнч(Источник) = Тип("СправочникСсылка.бит_Проживающие") и Источник.Пустая())) Тогда
		
		ИмяОбновляемогоЭлемента = Параметр.ИмяЭлемента;
		
		Если ИмяОбновляемогоЭлемента = "КонтактнаяИнформация" Тогда
			
			Подключаемый_ОбновитьКонтактнуюИнформацию(Параметр.СтруктураЭлемента);
			
		Иначе
			
			ОбновитьПредставлениеЭлемента(ИмяОбновляемогоЭлемента);
			
		КонецЕсли;
		
	ИначеЕсли ИмяСобытия = "ОбновитьТрудоваяДеятельность" Тогда
		
		ОбновитьПредставлениеЭлемента("ТрудоваяДеятельность");
		
	ИначеЕсли ИмяСобытия = "ОбновитьСвидетельствоОСмерти" Тогда
		
		ОбновитьПредставлениеЭлемента("СвидетельствоОСмерти");
		
	ИначеЕсли ИмяСобытия = "ОбновитьВоинскийУчет" Тогда
		
		ОбновитьПредставлениеЭлемента("ВоинскийУчет");
		
	ИначеЕсли ИмяСобытия = "ОбновитьУдостоверениеЛичности" Тогда
		
		ОбновитьПредставлениеЭлемента("УдостоверениеЛичности");
		
	ИначеЕсли ИмяСобытия = "ОбновлениеЗначенийСвойств" И Источник = Объект.Ссылка Тогда	
		
	КонецЕсли;
	
КонецПроцедуры

