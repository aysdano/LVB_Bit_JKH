&НаКлиенте
Процедура ДеревоПКОПриАктивизацииЯчейки(Элемент)
	
	ТекДанные = Элементы.ДеревоПКО.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда	
		
		Если Не ТекДанные.ПолучитьРодителя() = Неопределено Тогда
			
			Если Элемент.ТекущийЭлемент.Имя = "ДеревоПКОСтатьяДвиженийДенСредств" Тогда
				
				Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
				
			КонецЕсли;
			
			Если Элемент.ТекущийЭлемент.Имя = "ДеревоПКОСчетУчета" Тогда
				
				Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Элемент.ТекущийЭлемент.Имя = "ДеревоПКОЛицевойСчет" Тогда
			
			Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоПКОВыборПриИзменении(Элемент)
		
	ТекущиеДанные = Элементы.ДеревоПКО.ТекущиеДанные;
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	ДокументРодитель = ?(ТипЗнч(ТекущиеДанные.ПолучитьРодителя()) = Тип("ДанныеФормыЭлементДерева"),ТекущиеДанные.ПолучитьРодителя().ПриходныйКассовыйОредер, Неопределено);


	ДеревоПКОВыборПриИзмененииНаСервере(ТекущиеДанные.ПриходныйКассовыйОредер,ДокументРодитель);
	
	КоллекцияЭлементовДерева = ДеревоПКО.ПолучитьЭлементы();
	Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
		ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
		Элементы.ДеревоПКО.Развернуть(ИдентификаторСтроки);	
	КонецЦикла;   
	
КонецПроцедуры

