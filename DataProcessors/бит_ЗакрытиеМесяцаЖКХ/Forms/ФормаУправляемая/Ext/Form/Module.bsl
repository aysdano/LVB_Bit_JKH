		Если ПервыйЭлемент Тогда
			ТекстОбороты = ТекстОбороты + 
			";
			|
			|////////////////////////////////////////////////////////////////////////////////";
		Иначе
			ТекстОбороты = ТекстОбороты + " ОБЪЕДИНИТЬ ВСЕ ";
		КонецЕсли; 
		
		ТекстОбороты = ТекстОбороты + "
		|ВЫБРАТЬ
		|	" + ?(ПервыйЭлемент, 999, ПредыдущийЭлемент) + " КАК КоличествоМесяцев,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
		|					И бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор <> &Ссылка
		|				ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаОборот * -1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Оплата,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ КАК УслугаЖКХ,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
		|					И бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор <> &Ссылка
		|				ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаРасход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Разовые,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Период КАК Период,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов";
		
		Если ПервыйЭлемент Тогда
			ТекстОбороты = ТекстОбороты + "
			|ПОМЕСТИТЬ ТаблицаОплаты ";
		КонецЕсли; 
		
		ТекстОбороты = ТекстОбороты + "
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХПоПериоду.Обороты(ДОБАВИТЬКДАТЕ(&ДатаНачала, МЕСЯЦ, -" + Выборка.КоличествоМесяцев + "), &ДатаКонца, Регистратор, ЛицевойСчет в (&ЛицевойСчет)) КАК бит_НачисленияПоУслугамЖКХПоПериодуОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ,
		|   бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Период,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодВзаиморасчетов";
		
		
		ПервыйЭлемент = Ложь;
		ПредыдущийЭлемент = Выборка.КоличествоМесяцев;
		
	КонецЦикла; 
	
	// Итоговый текст запроса. Смещаем всю сумму переплат в самый поздний период,
	// где наибольшей процент пени, чтобы уменьшить долг.
	
	
	Запрос.Текст = ТекстОстатки + ТекстОбороты +
	";
	|ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.ЛицевойСчет КАК ЛицевойСчет,
