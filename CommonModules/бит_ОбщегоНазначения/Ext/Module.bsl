// Процедура устанавливает свойство "доступность" элементов формы.
//
// Параметры:
//
//  Метаданные      – объект матаданных.
//  СписокЭлементов - массив.
//  ЭлементыФормы   - элементы формы.
//
Процедура УстановитьПраваДоступаКЭлементамФормы(Метаданные, СписокЭлементов, ЭлементыФормы) Экспорт
	
	ПравоИзменения = ПравоДоступа("Изменение", Метаданные);
	
	Для каждого Элемент Из СписокЭлементов Цикл
		
		ЭлементыФормы[Элемент].Доступность = ?(НЕ ПравоИзменения, Ложь, Истина);
		
	КонецЦикла; 
	
КонецПроцедуры

// БИТ_ЖКХ 27.05.2016 16:07:42 Начало правки...
// Предназначена для получения пустого значения заданного типа:
//	примитивного, или ссылочного. Используется
//
// Параметры:
//	ЗаданныйТип   - тип, пустое значение которого нужно получить
//
Функция ПустоеЗначениеТипа(ЗаданныйТип) Экспорт

	Если ЗаданныйТип = Тип("Число") Тогда
		Возврат 0;

	ИначеЕсли ЗаданныйТип = Тип("Строка") Тогда
		Возврат "";

	ИначеЕсли ЗаданныйТип = Тип("Дата") Тогда
		Возврат '00010101000000';

	ИначеЕсли ЗаданныйТип = Тип("Булево") Тогда
		Возврат Ложь;

	Иначе
		Возврат Новый (ЗаданныйТип);

	КонецЕсли;

КонецФункции // ПустоеЗначениеТипа();

// Функция возвращает структуру с параметрами учетной политики на заданную дату для выгрузки на сайт ВДГБ.
// Параметры:
//  Дата                - Дата             - Дата на которую получить настройки, 
//  Организация         - СправочникСсылка - Огранизация по которой получить настройки,
//  Отказ        - Булево - показывает, возникали ли ошибки
// 
// Возвращаемое значение:
//  Структура - структура с параметрами учетной политики
//
Функция ПолучитьНастройкиЖКХ_СайтВДГБ(Дата, Организация, Отказ = Ложь) Экспорт
	
	СтруктураПараметрыЖКХ = Новый Структура();
	Ресурсы = Метаданные.РегистрыСведений.бит_НастройкаПараметровЖКХ.Ресурсы;
	Для Каждого ТекРесурс Из Ресурсы Цикл
		ПустоеЗначение = ПустоеЗначениеТипа(ТекРесурс.Тип.Типы().Получить(0));
		СтруктураПараметрыЖКХ.Вставить(ТекРесурс.Имя, ПустоеЗначение);
	КонецЦикла;

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Отказ = Истина;
		Возврат СтруктураПараметрыЖКХ;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Дата) Тогда
		Отказ = Истина;
		Возврат СтруктураПараметрыЖКХ;
	КонецЕсли;
	
