&НаКлиенте
Процедура ЗагрузитьИзСправкиЗавершение3(ИмяКаталога, ДополнительныеПараметры) Экспорт
    
    ВремИмя = ДополнительныеПараметры.ВремИмя;
    
    
    КодВозврата = 0;
    ЗапуститьСистему("DESIGNER /DumpConfigFiles  """ + ВремИмя +"\"+ """ -Help", Истина, КодВозврата);
    
    Если НЕ КодВозврата = 0 Тогда
		//Сообщить("Не удалось выгрузить файлы справки.");
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Не удалось выгрузить файлы справки.'");
		Сообщение.Сообщить();
        Возврат;
    КонецЕсли;
    
    МассивФайлов = Неопределено;
    
    
    НачатьПоискФайлов(Новый ОписаниеОповещения("ЗагрузитьИзСправкиЗавершение2", ЭтотОбъект, Новый Структура("ВремИмя", ВремИмя)), ВремИмя, "*.htm");

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьИзСправкиЗавершение2(НайденныеФайлы, ДополнительныеПараметры) Экспорт
    
    ВремИмя = ДополнительныеПараметры.ВремИмя;
    
    
    МассивФайлов = НайденныеФайлы;
    Если МассивФайлов.Количество() = 0 Тогда
		//Сообщить("Не обнаружено выгруженных файлов справки.");
 		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Не обнаружено выгруженных файлов справки.'");
		Сообщение.Сообщить();
       Возврат;
    КонецЕсли;
    
    ИмяФайлаАрхива = ПолучитьИмяВременногоФайла("zip");
    
    Архив = Новый ЗаписьZipФайла(ИмяФайлаАрхива, , , МетодСжатияZIP.Сжатие, УровеньСжатияZIP.Оптимальный);
    Архив.Добавить(ВремИмя + "\*.*",
    РежимСохраненияПутейZIP.СохранятьОтносительныеПути,
    РежимОбработкиПодкаталоговZIP.ОбрабатыватьРекурсивно);
    Архив.Записать();
    
    Попытка
        УдалитьФайлы(ВремИмя, "*.*");
    Исключение
        Ошибка = ОписаниеОшибки();
    КонецПопытки;
    
    АдресФайла = "";
    НачатьПомещениеФайла(Новый ОписаниеОповещения("ЗагрузитьИзСправкиЗавершение1", ЭтотОбъект, Новый Структура("АдресФайла, ИмяФайлаАрхива", АдресФайла, ИмяФайлаАрхива)), АдресФайла,
    ИмяФайлаАрхива,
    Ложь,
    ЭтаФорма.УникальныйИдентификатор);

КонецПроцедуры

