
#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем мНеСоздДокумент  Экспорт;  // Булево, признак созданного документа.
Перем мГрафаНачисления Экспорт;  // Хранит флаг настройки ЖКХ.
Перем мУчитыватьНачисленияПоГрупповымСчетчикам Экспорт; // Хранит флаг настройки ЖКХ.
Перем мУчитыватьПерерасчет                     Экспорт; // Хранит флаг настройки ЖКХ.

Перем мУчетДнейПроживания          Экспорт; // Хранит флаг настройки ЖКХ.
Перем мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика Экспорт; // Хранит флаг настройки ЖКХ.

Перем мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика Экспорт; // Хранит флаг настройки ЖКХ.

Перем мТаблицаНачисленийЗаПредыдущиеПериоды;

Перем мТаблицаПоУслугамПеня;
#КонецОбласти

#Область ЭкспортныеПроцедурыИФункцииДокумента

Процедура ОбновитьНастройкиЖКХ()  Экспорт
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("ОбщедомовыеРасходыВГрафеНачисления"      , Ложь);
	ПараметрыЖКХ.Вставить("УчитыватьНачисленияПоГрупповымСчетчикам" , Ложь);
	ПараметрыЖКХ.Вставить("УчитыватьПерерасчет"                     , Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(Дата, Организация, ПараметрыЖКХ);
	
	мГрафаНачисления                         = ПараметрыЖКХ.ОбщедомовыеРасходыВГрафеНачисления;
	мУчитыватьНачисленияПоГрупповымСчетчикам = ПараметрыЖКХ.УчитыватьНачисленияПоГрупповымСчетчикам;
	мУчитыватьПерерасчет                     = ПараметрыЖКХ.УчитыватьПерерасчет;
	
КонецПроцедуры

// Выполняет расчет разности дат в днях.
//
// Параметры::
//  Дата1  – Дата – Первая дата.
//                 
//  Дата2  – Дата – Вторая дата.
//                 
//
// Возвращаемое значение:
//   Число   – Разность дат в днях.
//
//
Функция РазностьДатВДнях(Дата1, Дата2) Экспорт 
	
	мДлинаСуток = 86400; // В секундах.
	
	Возврат  Окр((НачалоДня(Дата1) - НачалоДня(Дата2)) / мДлинаСуток) + 1;
	
КонецФункции

// Возвращает количество проживающих в квартире.
//
// Параметры:
//  ДатаРасчета  – Дата – дата получения данных.
//
// Возвращаемое значение:
//   Число   – количество человек.
//
//
Функция ПолучитьКолвоПроживающих(ДатаРасчета) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК Колво,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&ДатаРасчета, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПроживаниеВДанныйМомент
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет";
	
	Запрос.УстановитьПараметр("ДатаРасчета" ,ДатаРасчета);
	Запрос.УстановитьПараметр("ЛицевойСчет" ,ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат  Выборка.Колво;
	Иначе 	  
		Возврат 1; 
	КонецЕсли;
	
КонецФункции	

// Возвращает способ расчета по услуге.
//
// Параметры:
//  УслугаРасчета  – СправочникСсылка.бит_УслугиЖКХ – Услуга ЖКХ.
//
//  ДатаРасчета  – Дата – дата получения данных.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.бит_СпособыРасчетаПоУслугам   – Способ расчета по услуге.
//
Функция ПолучитьСпособРасчета(УслугаРасчета,ДатаРасчета) Экспорт 
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&ДатаРасчета,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	Запрос.УстановитьПараметр("ДатаРасчета" ,ДатаРасчета);
	Запрос.УстановитьПараметр("ЛицевойСчет" ,ЛицевойСчет);
	Запрос.УстановитьПараметр("Услуга"      ,УслугаРасчета);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Возврат  Выборка.СпособРасчета;
	Иначе 	  
		Возврат Перечисления.бит_СпособыРасчетаПоУслугам.ПустаяСсылка(); 
	КонецЕсли;
	
КонецФункции	

// Возвращает способ расчета по услуге.
//
// Параметры:
//  УслугаРасчета  – СправочникСсылка.бит_УслугиЖКХ – Услуга ЖКХ.
//
//  ДатаРасчета  – Дата – дата получения данных.
//
// Возвращаемое значение:
//   ПеречислениеСсылка.бит_СпособыРасчетаПоУслугам   – Способ расчета по услуге.
//
Функция ПолучитьИсточникФинансирования(Льгота) Экспорт
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ИсточникиФинансированияЛьготСрезПоследних.ИсточникФинансированияЛьгот КАК ИсточникФин
	|ИЗ
	|	РегистрСведений.бит_ИсточникиФинансированияЛьгот.СрезПоследних(&Дата, Льгота = &Льгота) КАК бит_ИсточникиФинансированияЛьготСрезПоследних";
	Запрос.УстановитьПараметр("Дата"   ,Дата);
	Запрос.УстановитьПараметр("Льгота" ,Льгота);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда 
		Возврат Выборка.ИсточникФин.Контрагент;
	Иначе 
		Возврат Справочники.Контрагенты.ПустаяСсылка();
	КонецЕсли;
	
Конецфункции

// Процедура выполняет заполнение Счетов и Субконто.
//
Процедура ЗаполнениеСчетовКУ()Экспорт 
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьготПоНедоставкиУслуг Тогда 
		
	Иначе 	
		СтруктураСчетовЖКХ = бит_ОбщегоНазначения.ПолучитьСчетаРасчетовЖКХ(Организация,КонецМесяца(Дата));	
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ЛСПоставщики.ЛицевойСчет,
		|	ЛСПоставщики.Услуга,
		|	бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств,
		|	бит_ПолучателиДенежныхСредствСрезПоследних.ДоговорКонтрагента
		|ИЗ
		|	(ВЫБРАТЬ
		|		бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|		бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
		|		бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик
		|	ИЗ
		|		РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_СведенияПоУслугамЛССрезПоследних) КАК ЛСПоставщики
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПолучателиДенежныхСредств.СрезПоследних(&Момент, ) КАК бит_ПолучателиДенежныхСредствСрезПоследних
		|		ПО ЛСПоставщики.Услуга = бит_ПолучателиДенежныхСредствСрезПоследних.Услуга
		|			И ЛСПоставщики.Поставщик = бит_ПолучателиДенежныхСредствСрезПоследних.Поставщик";
		
		Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
		Запрос.УстановитьПараметр("Момент"      ,КонецМесяца(Дата));
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() Цикл 
			Отбор = Новый Структура();
			Отбор.Вставить("Услуга"      ,Выборка.Услуга);
			Строки = СписокУслуг.НайтиСтроки(Отбор);
			Если ТипЗнч(Выборка.ПолучательДенежныхСредств) = Тип("СправочникСсылка.Организации") тогда
				Если Строки.Количество() > 0 Тогда
					Строки[0].СчетАбонента = СтруктураСчетовЖКХ.СчетАбонента;
					
					СтрокаСубконта = Строки[0].СчетАбонента.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета, "ВидСубконто");
					Если Не СтрокаСубконта = Неопределено тогда
						Строки[0]["Субконто"+СтрокаСубконта.НомерСтроки] = Выборка.ЛицевойСчет;
					КонецЕсли;	
					Если Строки[0].Услуга.ТипыНачислений = Перечисления.бит_ТипыНачисленийПоЖКХ.Эксплуатационная	Тогда 	
						Строки[0].СчетКУ       = СтруктураСчетовЖКХ.СчетСУЦС;
						СтрокаСубконтаКУ = Строки[0].СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.НазначениеЦелевыхСредств, "ВидСубконто");
						Если Не СтрокаСубконтаКУ = Неопределено тогда
							Строки[0]["СубконтоКУ"+СтрокаСубконтаКУ.НомерСтроки] = Строки[0].Услуга.ЦелевыеСредства;
						КонецЕсли;
						
						СтрокаСубконтаКУ = Строки[0].СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ДвиженияЦелевыхСредств, "ВидСубконто");
						Если Не СтрокаСубконтаКУ = Неопределено тогда
							Строки[0]["СубконтоКУ"+СтрокаСубконтаКУ.НомерСтроки] = Строки[0].Услуга.ДвижениеЦС;
						КонецЕсли;
					ИначеЕсли Строки[0].Услуга.ТипыНачислений = Перечисления.бит_ТипыНачисленийПоЖКХ.Аренда	Тогда
						Строки[0].СчетКУ       = СтруктураСчетовЖКХ.СчетСУАренды;
						СтрокаСубконтаКУ = Строки[0].СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.НоменклатурныеГруппы, "ВидСубконто");
						Если Не СтрокаСубконтаКУ = Неопределено тогда
							Строки[0]["СубконтоКУ"+СтрокаСубконтаКУ.НомерСтроки] = Строки[0].Услуга.НоменклатурнаяГруппа;
						КонецЕсли;
					Иначе 
						Строки[0].СчетКУ       = СтруктураСчетовЖКХ.СчетСУКУ;
						
					КонецЕсли;
				КонецЕсли;
				
			ИначеЕсли ТипЗнч(Выборка.ПолучательДенежныхСредств) = Тип("СправочникСсылка.Контрагенты") тогда  
				Если Строки.Количество() > 0 Тогда
					Строки[0].СчетАбонента = СтруктураСчетовЖКХ.СчетАбонента;
					
					СтрокаСубконта = Строки[0].СчетАбонента.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета, "ВидСубконто");
					Если Не СтрокаСубконта = Неопределено тогда
						Строки[0]["Субконто"+СтрокаСубконта.НомерСтроки] = Выборка.ЛицевойСчет;
					КонецЕсли;	
					Строки[0].СчетКУ = СтруктураСчетовЖКХ.СчетСторПКУ;
					
					СтрокаСубконтаКУ = Строки[0].СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты, "ВидСубконто");
					Если Не СтрокаСубконтаКУ = Неопределено тогда
						Строки[0]["СубконтоКУ"+СтрокаСубконтаКУ.НомерСтроки] = Выборка.ПолучательДенежныхСредств;
					КонецЕсли;
					СтрокаСубконтаКУ = Строки[0].СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры, "ВидСубконто");
					Если Не СтрокаСубконтаКУ = Неопределено тогда
						Если ЗначениеЗаполнено(Выборка.ДоговорКонтрагента)
							И Выборка.ДоговорКонтрагента.Организация = Организация Тогда  	
							Строки[0]["СубконтоКУ"+СтрокаСубконтаКУ.НомерСтроки] = Выборка.ДоговорКонтрагента;
						КонецЕсли;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;	 
			
		КонецЦикла;
	КонецЕсли; 
	
КонецПроцедуры	

// Процедура выполняет вычесление данных и заполнение табличной части.
//
Процедура РассчитатьСуммыПересчета(Колонки = Неопределено) Экспорт 
	
	СписокЛС = ЛицевойСчет;
	СписокУС = Неопределено;
	Для каждого СтрокаСписокУслуг Из СписокУслуг Цикл
		СтрокаСписокУслуг.Сумма = 0;
	КонецЦикла; 
	Если Колонки = Неопределено Тогда
		
		Форма = ЭтотОбъект.ПолучитьФорму("ФормаДокументаУправляемая", Этотобъект,);
		Колонки = Форма.Элементы.СписокУслуг.ПодчиненныеЭлементы;	
		
	КонецЕсли; 	
	
	// БИТ ЖКХ 10.03.2020
	если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеЗаПрошлыеПериоды тогда
		  
		ТаблицаСбора = ПолучитьТаблицуНачисленийЗаВесьПериод(); 
		
		ПостроительЗапроса = Новый ПостроительЗапроса;
		
        ПостроительЗапроса.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТаблицаСбора);    
        СтрокаОтбора = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
        СтрокаОтбора.Значение = ЛицевойСчет;
        СтрокаОтбора.ВидСравнения = ВидСравнения.Равно;
        СтрокаОтбора.Использование = Истина;
        
        ПостроительЗапроса.Выполнить();
        ВыбрСтроки = ПостроительЗапроса.Результат.Выгрузить();   
		ВыбрСтроки.Свернуть("Услуга, Объем", "Начислено");		
		
		для каждого стр из СписокУслуг цикл
			
			Отбор = Новый Структура;
            Отбор.Вставить("Услуга", стр.Услуга);
            ВыбрСтрокиУслуг = ВыбрСтроки.НайтиСтроки(Отбор);
			
			если ВыбрСтрокиУслуг.Количество() > 0 тогда
				
				стр.Объем = ВыбрСтрокиУслуг[0].Объем; 
				стр.Сумма = ВыбрСтрокиУслуг[0].Начислено; 
				
				КолвоДней        = РазностьДатВДнях(?(НачалоДня(КонецМесяца(КонПериода))> НачалоДня(КонПериода),КонПериода,КонецМесяца(КонПериода)),НачалоМесяца(НачПериода));
				КолвоДнейВМесяце = РазностьДатВДнях(КонецМесяца(КонПериода),НачалоМесяца(НачалоМесяца(НачПериода)));
				стр.Сумма  = стр.Сумма  *  ПроцентНеДопоставки/100 * КолвоДней/КолвоДнейВМесяце;

			конецесли;	
			
		конеццикла;	

		РассчитатьОбъем(СписокУслуг);

	конецесли;	
	
	// БИТ ЖКХ 10.03.2020
	если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды тогда
		
		ТаблицаСбора = ПолучитьТаблицуНачисленийЗаВесьПериод(); 
		
		СписокЛС = Новый ТаблицаЗначений;
		СписокЛС = СписокУслуг.Выгрузить();
		СписокЛС.Свернуть("ЛицевойСчет");
		
		ПостроительЗапроса = Новый ПостроительЗапроса;
