&НаСервере
функция СоздатьОбъектЗданиеНаСервере(Улица, Дом, Корпус, Организация)

  объектЗдание = НайтиОбъектЗдания (Улица, Дом, Корпус);
  
  если объектЗдание = неопределено тогда
		
    НовоеЗдание = Справочники.бит_СписокЗданий.СоздатьЭлемент();
	
	НовоеЗдание.Улица       = Улица;
	НовоеЗдание.НомерДома   = Дом;
	если Корпус <> 0 тогда
	 НовоеЗдание.Корпус      = Корпус;
	конецесли;
	НовоеЗдание.Организация = Организация;
	НовоеЗдание.Прочее      = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(("Автоматическое создание в %1"), ТекущаяДата());
	
	Попытка
		НовоеЗдание.Записать();	
	Исключение		
		Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
	возврат НовоеЗдание.Ссылка; 
	
  иначе	
	возврат объектЗдание.Ссылка; 
  конецесли;

конецфункции


функция СформироватьНомерЛС(Владелец, НомерКвартиры, ПрефиксЛС, Постфикс, ДлинаЛС)
	
 если ПравилаНумерацииЖил = "По номеру квартиры" тогда	
	
   колвоНулей = ДлинаЛС - СтрДлина(ПрефиксЛС) - СтрДлина(ПрефиксЛС) + 2;  
   строкаФормата = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(("ЧЦ=%1;ЧВН=;ЧГ=0"), колвоНулей);//колвоНулей);
   строкаНомера = Формат(НомерКвартиры, строкаФормата);
						
   возврат ПрефиксЛС + строкаНомера + Постфикс; 	  
   
 конецесли;  

 если ПравилаНумерацииЖил = "НомерДомаКвартира" или ПравилаНумерацииЖил = "Номер дома + Квартира" тогда	
	 
   ДлинаДома = СтрДлина(Строка(Владелец));	 
   колвоНулей = ДлинаЛС - СтрДлина(ПрефиксЛС) - СтрДлина(Постфикс) - ДлинаДома + 2;  
   строкаФормата = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(("ЧЦ=%1;ЧВН=;ЧГ=0"), колвоНулей);//колвоНулей);
   строкаНомера = Формат(НомерКвартиры, строкаФормата);
						
   возврат ПрефиксЛС + строка(Владелец) + строкаНомера + Постфикс; 	  
   
 конецесли;  

  если ПравилаНумерацииЖил = "Последовательная нумерация" тогда	
	 
  если Объект.ПоследнийРассчитанныйНомерЛС = 0 тогда 	
   Объект.ПоследнийРассчитанныйНомерЛС = Объект.НомерПервогоЛС;	    
  иначе
   Объект.ПоследнийРассчитанныйНомерЛС = Объект.ПоследнийРассчитанныйНомерЛС + 1;
  конецесли; 
 
  колвоНулей = ДлинаЛС - СтрДлина(ПрефиксЛС) - СтрДлина(Постфикс);// - СтрДлина(Строка(Объект.ПоследнийРассчитанныйНомерЛС));  
  строкаФормата = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(("ЧЦ=%1;ЧВН=;ЧГ=0"), колвоНулей);//колвоНулей);
  строкаНомера = Формат(Объект.ПоследнийРассчитанныйНомерЛС, строкаФормата);
						
  возврат ПрефиксЛС + строкаНомера + Постфикс; 	  
   
 конецесли;  
	
конецфункции	

функция НайтиПоследнийНомерЛС()
	
  запрос = новый Запрос;
  запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                 |	бит_ЛицевыеСчета.Наименование КАК Наименование
                 |ИЗ
                 |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета";
				 //|ГДЕ
				 //|	бит_ЛицевыеСчета.Здание = &Здание";
  
  
//  запрос.УстановитьПараметр("Здание", Владелец);
  табЗапроса = запрос.Выполнить().Выгрузить(); 
  табЗапроса.Сортировать("Наименование Убыв");
  
  если табЗапроса.Количество() > 0 тогда
	номер = Число(табЗапроса[0].Наименование);	
	возврат номер + 1; 
  иначе	  
   возврат 0;	  
