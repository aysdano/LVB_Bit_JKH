		ДомОбъект.Код = Стру.KOD;
	КонецЕсли;	
	
	Если не ЗначениеЗаполнено(ДомОбъект.Организация) тогда
		ДомОбъект.Организация = Объект.Организация
	КонецЕсли;	

	
	
	//Адрес
	ИмяУлицы = сокрЛП(Стру.YL);
		
	Адр = сокрЛП(Стру.ADR);	
	ПозРазделеителя = СтрНайти(Адр,",");
	ИмяУлицы2 = лев(Адр,ПозРазделеителя-1);
	Если ПустаяСтрока(ИмяУлицы) тогда
		ИмяУлицы = ИмяУлицы2
	КонецЕсли;	
	
	
	ИмяДома = сокрЛП(сред(Адр,ПозРазделеителя+1));
	ДомОбъект.Наименование = ИмяДома;
	
	//Улица
	ДомОбъект.Улица = Справочники.бит_СписокУлиц.НайтиПоНаименованию(ИмяУлицы,истина);
	Если Не ЗначениеЗаполнено(ДомОбъект.Улица) тогда
		УлицаОбъект = Справочники.бит_СписокУлиц.СоздатьЭлемент();
		УлицаОбъект.Наименование = ИмяУлицы;
		УлицаОбъект.СтароеНаименование = ИмяУлицы2;
		УлицаОбъект.Записать();
		ДомОбъект.Улица = УлицаОбъект.Ссылка;
	КонецЕсли;	
		
	
	

	//выделяем номер корпуса, номер дома и префикс     	
	ПозКорпус  = СтрНайти(ИмяДома,"КОРП.");
	Если позКорпус >0 тогда
		ИмяКорпуса=сокрЛП(сред(ИмяДома,ПозКорпус+5));
		//ИмяДома = лев(ИмяДома,ПозКорпус-1);    //имя корпуса остается в суффиксе.
	иначе
		ИмяКорпуса = "";
	КонецЕсли;	
	ДомОбъект.Корпус = ИмяКорпуса;
	
	
	ДлинаНомера=0;
	Для поз = 1 по СтрДлина(ИмяДома) цикл
		Симв = сред(ИмяДома,поз,1);
		Если СтрНайти("0123456789",Симв)=0 тогда
			прервать
		иначе		
			ДлинаНомера = поз;
		КонецЕсли;	
	КонецЦикла;	
		                   
	
	Если ДлинаНомера = 0 тогда
		ДомОбъект.НомерДома = 0;
	ИначеЕсли ДлинаНомера = СтрДлина(ИмяДома) тогда
		ДомОбъект.НомерДома = Число(ИмяДома);
		ДомОбъект.ПрефиксДома = ""; 
	Иначе //есть и номер, и суффикс
		ДомОбъект.НомерДома = Число(лев(ИмяДома,ДлинаНомера));
		ДомОбъект.ПрефиксДома = сокрЛП(сред(ИмяДома,ДлинаНомера+1));		
	КонецЕсли;	
	
	//район и участок
	ИмяРайона = Стру.YCH;
	КодУчастка = Стру.POD_YCH;
	
	ДомОбъект.Район = Справочники.бит_АдминистративныеОкруга.НайтиПоНаименованию(ИмяРайона);
	Если Не ЗначениеЗаполнено(ДомОбъект.Район) тогда
		ОбъектРайон = Справочники.бит_АдминистративныеОкруга.СоздатьЭлемент();
		ОбъектРайон.Наименование = ИмяРайона;
		ОбъектРайон.Записать();
		ДомОбъект.Район = ОбъектРайон.Ссылка;
	КонецЕсли;	
	
	ДомОбъект.Участок = Справочники.бит_ТехническиеУчастки.НайтиПоКоду(КодУчастка);
	Если не ЗначениеЗаполнено(ДомОбъект.Участок) тогда
		ОбъектУчасток = Справочники.бит_ТехническиеУчастки.СоздатьЭлемент();
		ОбъектУчасток.Код = КодУчастка;
		ОбъектУчасток.Наименование = КодУчастка;
		ОбъектУчасток.Владелец = ДомОбъект.Район;
		ОбъектУчасток.Записать();
		ДомОбъект.Участок = ОбъектУчасток.Ссылка;
	КонецЕсли;	
	
	//СтепеньБлагоустройства (Основная)
	ИмяСтепени = Стру.R_POTR;
	Если не ПустаяСтрока(ИмяСтепени) тогда
		Степень = Справочники.бит_ВидыБлагоустройстваЗданий.НайтиПоНаименованию(ИмяСтепени,истина);
		Если Не ЗначениеЗаполнено(Степень) тогда
			СтепеньОбъект = Справочники.бит_ВидыБлагоустройстваЗданий.СоздатьЭлемент();
			СтепеньОбъект.Наименование = ИмяСтепени;
			СтепеньОбъект.Записать();
			Степень = СтепеньОбъект.Ссылка;
		КонецЕсли;
		ДомОбъект.ВидБлагоустройстваЗданий = Степень;
	КонецЕсли;
	
	
	//Капремонт
	НомерСчетаКапремонта = сокрЛП(стру.kr_rs);
	Если Не ПустаяСтрока(НомерСчетаКапремонта) тогда   		
		СчетКапремонта = Справочники.БанковскиеСчета.НайтиПоНаименованию(НомерСчетаКапремонта);
		Если не ЗначениеЗаполнено(СчетКапремонта) тогда
			Сообщить("Не найдено соответствие счету капремонта для дома"+ДомОбъект.Ссылка);
		КонецЕсли;
	иначе 
		СчетКапремонта = Справочники.БанковскиеСчета.ПустаяСсылка()		
	КонецЕсли;	
	ДомОбъект.БанковскийСчетКапРемонт = СчетКапремонта;		


	ДомОбъект.ПрефиксЗдания = сокрЛП(Стру.PREF); //префикс для ЛС
	ДомОбъект.КадастровыйНомер = сокрЛП(стру.KAD_N);
	ДомОбъект.КодФИАС = сокрЛП(стру.FIAS);
	
	
	СостояниеДомаСтр  = сокрЛП(стру.SOST);
	Если СостояниеДомаСтр = "Исправный" тогда
		ДомОбъект.Состояние = Перечисления.бит_СостоянияЗданий.Исправный
	ИначеЕсли СостояниеДомаСтр = "Ветхий" тогда	
		ДомОбъект.Состояние = Перечисления.бит_СостоянияЗданий.Ветхий
	ИначеЕсли СостояниеДомаСтр = "Аварийный" тогда	
		ДомОбъект.Состояние = Перечисления.бит_СостоянияЗданий.Аварийный
	иначе
		ДомОбъект.Состояние = Перечисления.бит_СостоянияЗданий.ПустаяСсылка()
	КонецЕсли;
	
	ДомОбъект.КолВоЭтажейНаименьшее = стру.ET_MIN;
	ДомОбъект.ИмеетТСЖ = стру.TSJ;
	
	
								
	//Газоснабжение
	Газ = сокрЛП(стру.GAZ);
	Если ПустаяСтрока(Газ) тогда		
		ЕстьОмскГорГаз = ложь;
		ЕстьРегионГаз = ложь;
		ДомОбъект.ПоставщикГазоснабжения =  Справочники.бит_ПоставщикиУслуг.ПустаяСсылка()
	ИначеЕсли Газ = "Гор" тогда
		ЕстьОмскГорГаз = Истина;
		ЕстьРегионГаз = ложь;
		ДомОбъект.ПоставщикГазоснабжения = Объект.ОмскГорГаз;
	Иначе
		ЕстьОмскГорГаз = ложь;		
		ЕстьРегионГаз = истина;
		ДомОбъект.ПоставщикГазоснабжения = Объект.РегионГаз;
	КонецЕсли;	

	ПоставщикТеплоснабжения = СокрЛП(Стру.TIST);
	Если ПоставщикТеплоснабжения = "МП ТК" тогда
		ДомОбъект.ПоставщикТеплоснабжения = Объект.ТеплоМПТК;
	ИначеЕсли ПоставщикТеплоснабжения = "ОмскРТС" тогда
		ДомОбъект.ПоставщикТеплоснабжения = Объект.ТеплоОмскРТС		
	ИначеЕсли ПустаяСтрока(ПоставщикТеплоснабжения) или 
				нрег(СокрЛП(ПоставщикТеплоснабжения))= "нет" тогда		
		ДомОбъект.ПоставщикТеплоснабжения = Справочники.бит_ПоставщикиУслуг.ПустаяСсылка();		
	Иначе			
		ДомОбъект.ПоставщикТеплоснабжения = Справочники.бит_ПоставщикиУслуг.
									НайтиПоНаименованию(ПоставщикТеплоснабжения,истина);
		Если не ЗначениеЗаполнено(ДомОбъект.ПоставщикТеплоснабжения) тогда
			Сообщить("Для дома "+ДомОбъект.Ссылка + " не найден теплоисточник: " + ПоставщикТеплоснабжения);
		КонецЕсли;	
	КонецЕсли;			
	              
	
	ДомОбъект.ГодПостройки = стру.GOD_POST;
	ГодВвода = стру.GOD_VVOD;
	Если ГодВвода = 0 тогда
		ГодВвода =1
	КонецЕсли;;	
	ДомОбъект.ДатаВводаВЭксплуатацию = Дата(ГодВвода,1,1) ;
	
	ДомОбъект.СформироватьНаименование();
	//Сообщить("----Здание "+ДомОбъект.Код + "   Адрес: "+СокрЛП(Стру.ADR)+" Наименование:   "+ДомОбъект.Наименование);
	
	Попытка
	//	ДомОбъект.Наименование = "" + ДомОбъект.НомерДома + ДомОбъект.ПрефиксДома + 
	//											?(ПустаяСтрока(ДомОбъект.Корпус),""," КОРП."+ДомОбъект.Корпус);
		ДомОбъект.Записать();
	Исключение
	КонецПопытки;
	
	ЧислоПодъездов = стру.K_POD;
	ДобавитьПостоянныйРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.КоличествоПодъездов,
							ДомОбъект.Ссылка, ЧислоПодъездов);	
							
	ЧислоЭтажей  = стру.ET_MAX;
	ДобавитьПостоянныйРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.КоличествоЭтажей,
							ДомОбъект.Ссылка, ЧислоЭтажей);	
	
	
	
	ДобавитьПериодическиеРеквизитыЗдания(Стру,ДомОбъект.Ссылка);
	
	
	ЗаписьПредставления = РегистрыСведений.лб_ПредставлниеЗданий.СоздатьМенеджерЗаписи();
	ЗаписьПредставления.Здание = ДомОбъект.Ссылка;
	ЗаписьПредставления.Представление = сокрЛП(стру.ADR);
	ЗаписьПредставления.Улица =  ИмяУлицы2;
	ЗаписьПредставления.Дом = ДомОбъект.Наименование;
	ЗаписьПредставления.НаправлениеОбмена = Объект.НаправлениеОбмена;
	ЗаписьПредставления.Записать(истина);
	
КонецПроцедуры


Процедура ДобавитьПериодическиеРеквизитыЗдания(Стру,Здание)
	Если ложь тогда Стру = новый структура; Здание = Справочники.бит_СписокЗданий.Выбрать().Ссылка КонецЕсли; ;
	//Режим потребления по коду
	Если Стру.Свойство("TAR") тогда
		РежимПотребл = РежимПотребления(Здание.Код,Стру.TAR);	
	иначе
		РежимПотребл = РежимПотребления(Здание.Код,1);	
	КонецЕсли;	
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ОсновнойРежимПотребления,
							Здание, РежимПотребл);	
	
	//Степени благоустройства ХГВС и ЭЭ
	СтепеньХГВС = "ХГВС "+сокрЛП(Стру.ST_BL_XG) + "." ;
	СтепеньЭЭ   = "ЭЭ " + сокрЛП(Стру.ST_BL_EL) + ".";
	СтепеньБлагоустройстваХГВС = Справочники.бит_ВидыБлагоустройстваЗданий.НайтиПоНаименованию(СтепеньХГВС);
	Если Не ЗначениеЗаполнено(СтепеньБлагоустройстваХГВС) тогда
		ОбъектСтепеньБлагоустройстваХГВС = Справочники.бит_ВидыБлагоустройстваЗданий.СоздатьЭлемент();
		ОбъектСтепеньБлагоустройстваХГВС.Наименование = СтепеньХГВС;
		ОбъектСтепеньБлагоустройстваХГВС.Записать();
		СтепеньБлагоустройстваХГВС = ОбъектСтепеньБлагоустройстваХГВС.Ссылка;
	КонецЕсли;
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.СтепеньБлагоустройстваХГВС,
							Здание, СтепеньБлагоустройстваХГВС);	
	
	
	СтепеньБлагоустройстваЭЭ = Справочники.бит_ВидыБлагоустройстваЗданий.НайтиПоНаименованию(СтепеньЭЭ);
	Если Не ЗначениеЗаполнено(СтепеньБлагоустройстваЭЭ) тогда
		ОбъектСтепеньБлагоустройстваЭЭ = Справочники.бит_ВидыБлагоустройстваЗданий.СоздатьЭлемент();
		ОбъектСтепеньБлагоустройстваЭЭ.Наименование = СтепеньЭЭ;
		ОбъектСтепеньБлагоустройстваЭЭ.Записать();
		СтепеньБлагоустройстваЭЭ = ОбъектСтепеньБлагоустройстваЭЭ.Ссылка;
	КонецЕсли;
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.СтепеньБлагоустройстваЭЭ,
							Здание, СтепеньБлагоустройстваЭЭ);	
		
	//Настройки печати квитанции
	СпособХВ = СпособРасчетаСОИ(Стру.R_XV); 
	СпособГВ = СпособРасчетаСОИ(Стру.R_GV);
	СпособВО = СпособРасчетаСОИ(Стру.R_VO);
	СпособЭЭ = СпособРасчетаСОИ(Стру.R_EL);
	ПоНорме = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу;
	ПоФакту = Перечисления.лб_СпособРасчетаСОИ.ПоФакту;
	ПоСреднему = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему;
	
	Если СпособХВ = ПоНорме и СпособГВ = ПоНорме и СпособВО = ПоНорме и СпособЭЭ = ПоНорме тогда
		Настройка = Справочники.лб_НастройкиПечатиКвитанций.НайтиПоКоду("000000003");   //по норме
	ИначеЕсли СпособХВ = ПоФакту и СпособГВ = ПоФакту и СпособВО = ПоФакту и СпособЭЭ = ПоФакту тогда
		Настройка = Справочники.лб_НастройкиПечатиКвитанций.НайтиПоКоду("000000002");	//по факту
	ИначеЕсли СпособХВ = ПоСреднему и СпособГВ = ПоСреднему и СпособВО = ПоСреднему и СпособЭЭ = ПоСреднему тогда
		Настройка = Справочники.лб_НастройкиПечатиКвитанций.НайтиПоКоду("000000001"); //по среднему	
	ИначеЕсли Не ЗначениеЗаполнено(СпособХВ) и не ЗначениеЗаполнено(СпособГВ) 
				и не ЗначениеЗаполнено(СпособВО) и не ЗначениеЗаполнено(СпособЭЭ) тогда
		Настройка = Справочники.лб_НастройкиПечатиКвитанций.ПустаяСсылка();
	иначе
		Сообщить("Для Здания " + Здание +  " не подобрана настройка вывода квитанции. " +
				"ХВ="+СпособХВ + " ГВ="+СпособГВ + "ВО="+СпособВО + " ЭЭ="+СпособЭЭ);
		Настройка =  Справочники.лб_НастройкиПечатиКвитанций.ПустаяСсылка();
	КонецЕсли;	
	
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_НастройиПечатиКвитанции,
							Здание, Настройка);	

	//Площади здания
	ПлощадьОбщая = стру.PL_ALL;
	ПлощадьЖилыхНежилых = стру.pl_ob;
	ЖилаяПлощадь = стру.pl_kom;
	ПлощадьНежилых = ПлощадьЖилыхНежилых - ЖилаяПлощадь;
	
	ПлощадьПодвалов = стру.pl_pod;
	ПлощадьЧердаков = стру.pl_cherd;
	ПлощадьБалконов = стру.pl_balk;
	ПлощадьМОП = стру.pl_mop;
	ПлощадьЗемельногоУчастка = стру.pl_grunt;

	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилогоЗдания,
							Здание,ПлощадьОбщая);
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилыхПомещений,
							Здание,ЖилаяПлощадь);
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьНежилыхПомещений,
							Здание,ПлощадьНежилых);
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ОбщаяПлощадьЖилыхИНежилыхПомещений,
							Здание,ПлощадьЖилыхНежилых);
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ОбщаяПлощадьПодвалов,
							Здание,ПлощадьПодвалов);							
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ОбщаяПлощадьЧердаков,
							Здание,ПлощадьЧердаков);
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ОбщаяПлощадьБалконов,
							Здание,ПлощадьБалконов);						
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьМестОбщегоПользования,
							Здание,ПлощадьМОП);							
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьПридомовойТерритории,
							Здание,ПлощадьЗемельногоУчастка);						
							
						
	//Газоснабжение
	Газ = сокрЛП(стру.GAZ);
	Если ПустаяСтрока(Газ) тогда		
		ЕстьОмскГорГаз = ложь;
		ЕстьРегионГаз = ложь;
//		ДомОбъект.ПоставщикГазоснабжения =  Справочники.бит_ПоставщикиУслуг.ПустаяСсылка()
	ИначеЕсли Газ = "Гор" тогда
		ЕстьОмскГорГаз = Истина;
		ЕстьРегионГаз = ложь;
//		ДомОбъект.ПоставщикГазоснабжения = Объект.ОмскГорГаз;
	Иначе
		ЕстьОмскГорГаз = ложь;		
		ЕстьРегионГаз = истина;
//		ДомОбъект.ПоставщикГазоснабжения = Объект.ОмскРегионГаз;
	КонецЕсли;	
						
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ПоставщикГазаОмскГорГаз,
	   	 					Здание,ЕстьОмскГорГаз);	
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ПоставщикГазаРегионГаз,
	   	 					Здание,ЕстьРегионГаз);	
						
	ПочтовыйИндекс = сокрЛП(стру.POST_IND);						
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ПочтовыйИндекс,
	   	 					Здание,ПочтовыйИндекс);	
							
							
							
	ДоговорВид = СокрЛП(стру.DOG_VID);
	Если НЕ ПустаяСтрока (ДоговорВид) тогда 
		ВидДог = Справочники.бит_ВидыДоговоровУправления.НайтиПоНаименованию(ДоговорВид,Истина);
		Если не ЗначениеЗаполнено(ВидДог) тогда
			СпрОбъект = Справочники.бит_ВидыДоговоровУправления.СоздатьЭлемент();
			СпрОбъект.Наименование = ДоговорВид;
			СпрОбъект.Записать();
			ВидДог = СпрОбъект.Ссылка;
		КонецЕсли;	
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияВид,
	   	 					Здание,ВидДог);	
	КонецЕсли;	
	
	ДоговорНомер = СокрЛП(стру.DOG_N);
	ДоговрДата   = СокрЛП(стру.DOG_NACH);
	ДоговорСрокПролонгации = СокрЛП(стру.DOG_SROK);
	
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияНомер,
	   	 					Здание,ДоговорНомер);	
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияДатаНачУпр,
	   	 					Здание,ДоговрДата);	
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияСрокПролонгации,
	   	 					Здание,ДоговорСрокПролонгации);	
						
							
							
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ДоговорУправленияСрокПролонгации,
	   	 					Здание,ДоговорСрокПролонгации);	
							
							
	НачальноеСальдоТекРемонта = стру.NACH_S;
	ДобавитьРеквизитЗдания(ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_НачальныйОстатокСредствТекРемонта,
	   	 					Здание,НачальноеСальдоТекРемонта);	
	
	
							
							
							
КонецПроцедуры	


Функция СпособРасчетаСОИ(знач Стр)
	Стр = СокрЛП(Стр);
	Если ПустаяСтрока(Стр) или ТипЗнч(Стр)<>Тип("Строка") тогда
		СпособРасчета = Перечисления.лб_СпособРасчетаСОИ.ПустаяСсылка();
	ИначеЕсли Стр =  "По нормативу" тогда
		СпособРасчета = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу;
	ИначеЕсли Стр =  "По факту" тогда
		СпособРасчета = Перечисления.лб_СпособРасчетаСОИ.ПоФакту;	
	иначе
		СпособРасчета = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему;
	КонецЕсли;
	возврат СпособРасчета;
	
КонецФункции	


