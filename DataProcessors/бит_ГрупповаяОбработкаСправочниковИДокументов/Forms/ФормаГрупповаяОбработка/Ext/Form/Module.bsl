
#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
// Функция получает действие по представлению.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьДействиеПоПредставлению(Представление)
	
	Результат = Неопределено;
	
	Для каждого Элемент Из СписокДействий Цикл
		
		Если Элемент.Представление = Представление Тогда
			Результат = Элемент.Значение;
			Прервать;
		КонецЕсли; 
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции // ()

&НаКлиенте
Процедура ОткрытьФормуВыбораТаблицы()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора"               , Истина);
	ПараметрыФормы.Вставить("СписокВыбранных"           , СформироватьСписокВыбранных());
	ПараметрыФормы.Вставить("ТипОбъекта"                , ТипОбъекта);
	ПараметрыФормы.Вставить("ОбрабатыватьТабличныеЧасти", ОбрабатыватьТабличныеЧасти);
	
	ОткрытьФорму("Обработка.бит_ГрупповаяОбработкаСправочниковИДокументов.Форма.ФормаВыбораТаблицы", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
	
КонецПроцедуры // ()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ОграничениеНаСтрокиНеограниченнойДлины = 999;
	
	СписокВыбора = Элементы.СписокДействий.СписокВыбора;
	СписокВыбора.Очистить();
	СписокВыбора.Добавить("","<Выберите действие>");
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если Не ОчищатьРезультаты() Тогда
		Возврат;
	КонецЕсли; 
	
	ТипОбъекта                 = ИсточникВыбора.ТипОбъекта;
	ОбрабатыватьТабличныеЧасти = ИсточникВыбора.ОбрабатыватьТабличныеЧасти;
	ТабличноеПолеВидыОбъектов.Очистить();
	
	Для каждого Значение Из ВыбранноеЗначение Цикл
		
		Строка = ТабличноеПолеВидыОбъектов.Добавить();
		Строка.ИмяТаблицы           = Значение.Значение;
		Строка.ПредставлениеТаблицы = Значение.Представление;
		
	КонецЦикла;
	
	ИнициализироватьСКД();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СписокДействийОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ВыбранноеЗначение = Неопределено Тогда
		
		ТекущееДействие = ПолучитьДействиеПоПредставлению(ВыбранноеЗначение);
		
		Если ТекущееДействие = Неопределено Тогда
			Возврат;
		КонецЕсли; 
		
		ПолеВводаДействия    = Неопределено;
		ТекущееПредставление = ТекущееДействие.ТекущееПредставление;
		
		ПолеВыбораДействия = ВыбранноеЗначение;
		
		Элементы.ПолеВводаДействия.ОграничениеТипа = ТекущееДействие.ПолеНастройки.ТипЗначения;
		ПолеВводаДействия = Элементы.ПолеВводаДействия.ОграничениеТипа.ПривестиЗначение(ПолеВводаДействия);
		
		УстановитьВидимостьКолонок();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТипОбъектаОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ТипОбъектаПриИзменении(Элемент)
	ТабличноеПолеВидыОбъектов.Очистить();
КонецПроцедуры

&НаКлиенте
Процедура ОбрабатыватьТабличныеЧастиПриИзменении(Элемент)
	
	Если ОчищатьРезультаты() Тогда
		ТабличноеПолеВидыОбъектов.Очистить();
	Иначе
		Элемент.Значение = Не Элемент.Значение;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТабличноеПолеВидыОбъектовПослеУдаления(Элемент)
	
	Если ОчищатьРезультаты() Тогда
		ИнициализироватьСКД();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипОбъектаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипОбъекта = ВыбранноеЗначение Или Не ОчищатьРезультаты() Тогда
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура Отобрать(Команда)
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.Обработка;
	ОбновитьТаблицуДокументов();
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	Для каждого СтрокаТаблицы Из ТабличноеПолеДанных Цикл
		СтрокаТаблицы.Пометка = 0;
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	Для каждого СтрокаТаблицы Из ТабличноеПолеДанных Цикл
		СтрокаТаблицы.Пометка = 1;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействие(Команда)
	
	Если ТекущееДействие = Неопределено Тогда
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ВыполнитьДействиеЗавершение1", ЭтотОбъект), "Не выбрано действие для выполнения"); 
		Возврат;
	КонецЕсли;
	
	Ответ = Неопределено;
	
	ПоказатьВопрос(Новый ОписаниеОповещения("ВыполнитьДействиеЗавершение", ЭтотОбъект), "Выполнить """ + ТекущееДействие.ТекущееПредставление+ """?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеЗавершение1(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьДействиеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьДействиеНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляТаблицаДокументов

&НаКлиенте
Процедура ТаблицаДокументовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ТабличноеПолеДанных.ТекущиеДанные;
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура("Ключ",ТекущаяСтрока.Ш_Ссылка);
	
	// БИТ_ЖКХ 23.06.2014
	ИмяОбъекта = ОбъектыНаСервере(ТекущаяСтрока.Ш_ВидПредставление);
	
	Если ТипОбъекта = 0 Тогда
		
		Попытка
			ОткрытьФорму("Справочник." + ИмяОбъекта + ".Форма.ФормаЭлементаУправляемая", ПараметрыФормы);
		Исключение
			ОткрытьФорму("Справочник." + ИмяОбъекта + ".Форма.ФормаЭлемента", ПараметрыФормы);
		КонецПопытки;	
		
	Иначе	
		
		Попытка
			ОткрытьФорму("Документ." + ИмяОбъекта + ".Форма.ФормаДокументаУправляемая", ПараметрыФормы);
		Исключение
			ОткрытьФорму("Документ." + ИмяОбъекта + ".Форма.ФормаДокумента", ПараметрыФормы);
		КонецПопытки;	
		
	КонецЕсли;
	// БИТ_ЖКХ 23.06.2014
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляТабличноеПолеВидыОбъектов

