// Процедура заполнения табличной части макета.
Процедура ЗаполнениеТЧ(стрТЗ, Макет, ТабДок,ОтветственноеЛицо, НомерСтроки,СтрокаПроживающий)
	
	СтрокаПроживающий.Параметры.Номер = НомерСтроки;
	СтрокаПроживающий.Параметры.Заполнить(стрТЗ);
	
	//+bit_semenov.v_13.04.22
	Доля = СокрЛП(стрТЗ.ДоляПлощадиСтрокой);
	
	Если Доля = "1" ИЛИ Лев(Доля, 1) = "о" Тогда
		СтрокаПроживающий.Параметры.Доля = "";
	ИначеЕсли Лев(Доля, 1) = "с" Тогда
		СтрокаПроживающий.Параметры.Доля = "ОСС";
	Иначе
		СтрокаПроживающий.Параметры.Доля = Доля;
	КонецЕсли;
	
	Если НЕ Доля = "" Тогда
		СтрокаПроживающий.Параметры.РодственнаяСвязь = "Собст-к";
	ИначеЕсли стрТЗ.РодственнаяСвязь = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо И  Доля = "" Тогда
		СтрокаПроживающий.Параметры.РодственнаяСвязь = "Наниматель";
	ИначеЕсли Доля = "" Тогда
		СтрокаПроживающий.Параметры.РодственнаяСвязь = стрТЗ.РодственнаяСвязь;
	КонецЕсли;
	//-bit_semenov.v_13.04.22
	
	//Если стрТЗ.РодственнаяСвязь = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо и НЕ (стрТЗ.ФизЛицо = ОтветственноеЛицо) Тогда
	//	СтрокаПроживающий.Параметры.РодственнаяСвязь = "";
	//КонецЕсли; 
	
	НомерСтроки = НомерСтроки + 1;
	
	Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабДок,  СтрокаПроживающий) Тогда
		
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();	
		ЗаголовокОбласть2 = Макет.ПолучитьОбласть("Заголовок2");
		ТабДок.Вывести(ЗаголовокОбласть2);
		ТабДок.Вывести(СтрокаПроживающий);
		ВтораяСтраница = Истина;
	Иначе
		ТабДок.Вывести(СтрокаПроживающий);
	КонецЕсли;
	
КонецПроцедуры

//БИТ_ЖКХ 15.10.2018	
Функция ПолучитьАдресБСП(объектЛицевойСчет = неопределено)
	
	если ТипЗнч(объектЛицевойСчет) = Тип("СправочникСсылка.бит_ЛицевыеСчета") тогда 	
		если объектЛицевойСчет.Здание.КонтактнаяИнформация.Количество() > 0 тогда 	
			АдресРезультат = РаботаСАдресами.СведенияОбАдресе(объектЛицевойСчет.Здание.КонтактнаяИнформация[0].Значение); 					
		конецесли; 
	конецесли; 
	
	если ТипЗнч(объектЛицевойСчет) = Тип("Строка") тогда 
		АдресРезультат = РаботаСАдресами.СведенияОбАдресе(объектЛицевойСчет);
	конецесли; 
	
	если ТипЗнч(объектЛицевойСчет) = Тип("СправочникСсылка.бит_СписокЗданий") тогда 
		АдресРезультат = РаботаСАдресами.СведенияОбАдресе(объектЛицевойСчет.КонтактнаяИнформация[0].Значение);
	конецесли;	 
	
	
	СтруктураАдресРегистрации = Новый Структура;	
	СтруктураАдресРегистрации.Вставить("Страна", СокрЛП(АдресРезультат.Страна));
	СтруктураАдресРегистрации.Вставить("Представление", АдресРезультат.Представление);	
	СтруктураАдресРегистрации.Вставить("Регион", СокрЛП(АдресРезультат.Регион));
	СтруктураАдресРегистрации.Вставить("Район", СокрЛП(АдресРезультат.Район+ " " + строка(АдресРезультат.РайонСокращение)));   
	СтруктураАдресРегистрации.Вставить("Город", СокрЛП(АдресРезультат.Город + " " + строка(АдресРезультат.ГородСокращение)));
	СтруктураАдресРегистрации.Вставить("НаселенныйПункт", СокрЛП(строка(АдресРезультат.НаселенныйПункт) + " " + строка(АдресРезультат.НаселенныйПунктСокращение)));
	СтруктураАдресРегистрации.Вставить("Улица", СокрЛП(АдресРезультат.Улица + " " + строка(АдресРезультат.УлицаСокращение)));
	СтруктураАдресРегистрации.Вставить("Дом", СокрЛП(АдресРезультат.Здание.Номер));	
	//СтруктураАдресРегистрации.Вставить("корпус", ?(ЗначениеЗаполнено(АдресРезультат.Корпуса), СокрЛП(АдресРезультат.Корпуса[0].Номер),""));  
	СтруктураАдресРегистрации.Вставить("корпус", ПолучитьНомерКорпуса(АдресРезультат.Здание));
	СтруктураАдресРегистрации.Вставить("Квартира", ?(ЗначениеЗаполнено(АдресРезультат.Помещения), СокрЛП(АдресРезультат.Помещения[0].Номер),"")); 
	
	если объектЛицевойСчет <> неопределено и ТипЗнч(объектЛицевойСчет) = Тип("СправочникСсылка.бит_ЛицевыеСчета") тогда
		
		если СокрЛП(СтруктураАдресРегистрации.корпус) = "" и ЗначениеЗаполнено(объектЛицевойСчет.Здание) тогда
			СтруктураАдресРегистрации.корпус = объектЛицевойСчет.Здание.Корпус;
		конецесли; 	
		если СокрЛП(СтруктураАдресРегистрации.Улица) = "" тогда
			СтруктураАдресРегистрации.Улица = СокрЛП(объектЛицевойСчет.УлицаЛицевогоСчета);
		конецесли;	
		если СокрЛП(СтруктураАдресРегистрации.Дом) = "" и ЗначениеЗаполнено(объектЛицевойСчет.Здание) тогда
			СтруктураАдресРегистрации.Дом = объектЛицевойСчет.Здание.Наименование;
		конецесли;	
		если СокрЛП(СтруктураАдресРегистрации.Дом) = "" и ЗначениеЗаполнено(объектЛицевойСчет.Здание) тогда
			СтруктураАдресРегистрации.Квартира = объектЛицевойСчет.Квартира.Наименование;
		конецесли;	
		
	конецесли;	  
	
	возврат СтруктураАдресРегистрации; 
	
КонецФункции // ПолучитьАдресБСП()

Функция ПолучитьНомерКорпуса(Строка)
	
	ИсхДанные     = СокрЛП(Строка);
	
	ВхождениеКорпуса = СтрНайти(ВРЕГ(ИсхДанные), "КОРП.");
	
	Если ВхождениеКорпуса = 0 Тогда 
		ВхождениеКорпуса = СтрНайти(ВРЕГ(ИсхДанные), "К.");
	КонецЕсли;
	
	
	Если ВхождениеКорпуса > 0 Тогда
		КоличествоСимволов = (СтрДлина(ИсхДанные) - ВхождениеКорпуса - 4);
		Корпус = Прав(ИсхДанные, КоличествоСимволов);
		Возврат Корпус;
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

Функция ПолучитьНомерДома(Строка)
	
	ИсхДанные     = СокрЛП(Строка);
	
	ВхождениеДома = СтрНайти(ВРЕГ(ИсхДанные), "Д." );
	
	Если ВхождениеДома > 0 Тогда
		
		КоличествоСимволов = (СтрДлина(ИсхДанные) - ВхождениеДома - 1);
		Дом = Прав(ИсхДанные, КоличествоСимволов);
		
		ВхождениеКорпуса = СтрНайти(ВРЕГ(Дом), "КОРП.");
		
		Если ВхождениеКорпуса > 0 Тогда
			
			ДомБезКорпуса = Лев(Дом, ВхождениеКорпуса - 1);
			Возврат ДомБезКорпуса; 
			
		КонецЕсли;
		
		
		Возврат Дом;
		
	КонецЕсли;
	
	Возврат "";
КонецФункции	


