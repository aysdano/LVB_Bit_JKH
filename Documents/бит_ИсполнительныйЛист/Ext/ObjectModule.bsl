	//	Движение = Движения.ВзаиморасчетыПоИсполнительномуПроизводству.Добавить();
	//	Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
	//	Движение.Период = Дата;
	//	Движение.ЛицевойСчет = ЛицевойСчет;
	//	Движение.ФИОДолжника = ФИОДолжника;
	//	Движение.Услуга = Услуга;
	//	Движение.Сумма = ТекСтрокаОплатыПоИсполнительномуЛисту.Сумма;
	//	Движение.СуммаГоспошлины = ТекСтрокаОплатыПоИсполнительномуЛисту.СуммаГоспошлины;
	//	Движение.СуммаПредставительскихРасходов = ТекСтрокаОплатыПоИсполнительномуЛисту.СуммаПредставительскихРасходов;
