//HD+
// Формирует текст о проведении очного/заочного голосования для макетов ПФ_DOC_Протокол, ПФ_DOC_ИтогиГолосования и ПФ_DOC_СообщениеОСобрании.
// ВариантТекста: "Протокол" | "СообщениеОСобрании" — различается формулировка («проведено» / «состоится», «будет проведено»).
// Очная форма — только очное; заочная — только заочное; иначе (очно-заочная и пр.) — оба.
// Пустые даты/место подменяются прочерками по настройкам длины.
//
Функция ПолучитьТекстПроведенияГолосованияДляПечати(НастройкиДлиныПрочерков = Неопределено, ВариантТекста = "Протокол")
	
	Если НастройкиДлиныПрочерков = Неопределено Тогда
		НастройкиДлиныПрочерков = ПолучитьНастройкиДлиныПрочерков();
	КонецЕсли;
	
	ДляСообщения = (ВариантТекста = "СообщениеОСобрании");
	
	ВыводитьОчное = Истина;
	ВыводитьЗаочное = Истина;
	
	Если ТипЗнч(ФормаПроведения) = Тип("ПеречислениеСсылка.бит_ФормыСобраний") Тогда
		Если ФормаПроведения = Перечисления.бит_ФормыСобраний.Очная Тогда
			ВыводитьЗаочное = Ложь;
		ИначеЕсли ФормаПроведения = Перечисления.бит_ФормыСобраний.Заочная Тогда
			ВыводитьОчное = Ложь;
		КонецЕсли;
	КонецЕсли;
	
	ТекстОчного = "";
	ТекстЗаочного = "";
	
	Если ВыводитьОчное Тогда
		
		МестоСтрокой = ?(ЗначениеЗаполнено(МестоПроведения), Строка(МестоПроведения),
			ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МестоПроведенияСобрания"));
		ВремяСтрокой = ПолучитьВремяПроведенияОчногоГолосования();
		Если НЕ ЗначениеЗаполнено(ВремяСтрокой) Тогда
			ВремяСтрокой = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияОчногоГолосования");
		КонецЕсли;
		МесяцСтрокой = ПолучитьМесяцПроведенияОчногоГолосования();
		Если НЕ ЗначениеЗаполнено(МесяцСтрокой) Тогда
			МесяцСтрокой = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияОчногоГолосования");
		КонецЕсли;
		ГодСтрокой = ПолучитьГодПроведенияОчногоГолосования();
		Если НЕ ЗначениеЗаполнено(ГодСтрокой) Тогда
			ГодСтрокой = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияОчногоГолосования");
		КонецЕсли;
		
		Если ДляСообщения Тогда
			ТекстОчного = "Очное голосование состоится " + МестоСтрокой
				+ " в " + ВремяСтрокой + " часов " + МесяцСтрокой + " 20" + ГодСтрокой + " г.";
		Иначе
			ТекстОчного = "Очное голосование проведено " + МестоСтрокой
				+ " в " + ВремяСтрокой + " часов " + МесяцСтрокой + " 20" + ГодСтрокой + " г.";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ВыводитьЗаочное Тогда
		
		ВремяНач = ПолучитьВремяПроведенияЗаочногоГолосования_Начало();
		Если НЕ ЗначениеЗаполнено(ВремяНач) Тогда
			ВремяНач = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Нач");
		КонецЕсли;
		МесяцНач = ПолучитьМесяцПроведенияЗаочногоГолосования_Начало();
		Если НЕ ЗначениеЗаполнено(МесяцНач) Тогда
			МесяцНач = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияЗаочногоГолосования_Нач");
		КонецЕсли;
		ГодНач = ПолучитьГодПроведенияЗаочногоГолосования_Начало();
		Если НЕ ЗначениеЗаполнено(ГодНач) Тогда
			ГодНач = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияЗаочногоГолосования_Нач");
		КонецЕсли;
		ВремяКон = ПолучитьВремяПроведенияЗаочногоГолосования_Окончание();
		Если НЕ ЗначениеЗаполнено(ВремяКон) Тогда
			ВремяКон = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ВремяПроведенияЗаочногоГолосования_Кон");
		КонецЕсли;
		МесяцКон = ПолучитьМесяцПроведенияЗаочногоГолосования_Окончание();
		Если НЕ ЗначениеЗаполнено(МесяцКон) Тогда
			МесяцКон = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "МесяцПроведенияЗаочногоГолосования_Кон");
		КонецЕсли;
		ГодКон = ПолучитьГодПроведенияЗаочногоГолосования_Окончание();
		Если НЕ ЗначениеЗаполнено(ГодКон) Тогда
			ГодКон = ПолучитьПрочеркПоКлючу(НастройкиДлиныПрочерков, "ГодПроведенияЗаочногоГолосования_Кон");
		КонецЕсли;
		
		Если ДляСообщения Тогда
			ТекстЗаочного = "Заочное голосование будет проведено в период с "
				+ ВремяНач + " часов " + МесяцНач + " 20" + ГодНач
				+ " г. по " + ВремяКон + " часов " + МесяцКон + " 20" + ГодКон
				+ " г. путем принятия решений в письменной форме и передаче таких решений инициатору общего собрания.";
		Иначе
			ТекстЗаочного = "Заочное голосование проведено в период с "
				+ ВремяНач + " часов " + МесяцНач + " 20" + ГодНач
				+ " г. по " + ВремяКон + " часов " + МесяцКон + " 20" + ГодКон
				+ " г. путем принятия решений в письменной форме и передаче таких решений инициатору общего собрания.";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ТекстОчного) И ЗначениеЗаполнено(ТекстЗаочного) Тогда
		//HD+ В сообщении оба предложения в одном абзаце (как в исходном макете); в протоколе — отдельными абзацами
		Если ДляСообщения Тогда
			Возврат ТекстОчного + " " + ТекстЗаочного;
		Иначе
			Возврат ТекстОчного + Символ(13) + ТекстЗаочного;
		КонецЕсли;
	ИначеЕсли ЗначениеЗаполнено(ТекстОчного) Тогда
		Возврат ТекстОчного;
	Иначе
		Возврат ТекстЗаочного;
	КонецЕсли;
	
КонецФункции //HD-

//HD+
