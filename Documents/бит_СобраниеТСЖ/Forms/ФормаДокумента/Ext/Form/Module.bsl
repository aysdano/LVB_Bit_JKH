&НаКлиенте
Процедура УстновитьЗначениеГолосовЗавершение(Значение, ДополнительныеПараметры) Экспорт
	
	ИдентификаторВопроса = ДополнительныеПараметры.ИдентификаторВопроса;
	ВыбЗнач = ?(Значение = Неопределено, ДополнительныеПараметры.ВыбЗнач, Значение);
	
	Если НЕ (Значение <> Неопределено) Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура;
	Отбор.Вставить("КритерийОценкиГолосов", ПредопределенноеЗначение("Перечисление.бит_КритерииОценкиГолосов.ПоКоличествуГолосов"));
	
	СтруктураЗначений = Новый Структура;
	СтруктураЗначений.Вставить("ЗначениеГолоса", ВыбЗнач);
	
	ЗаполнитьЗначениеПоДереву(ИдентификаторВопроса, СтруктураЗначений, Отбор);
	
	РазвернутьВсеУровни("ДеревоУчастниковГолосования");
	
	НесовпадаетКолГолосов         = Истина;
	ТаблицаРезультатовНеАктуальна = Истина;
	
	УстановитьТекстСообщений();
	
