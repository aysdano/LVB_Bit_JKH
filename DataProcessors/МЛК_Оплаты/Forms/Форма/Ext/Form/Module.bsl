Процедура ЗаполнитьРеестрОплат()
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПлатежки()
	Объект.ПлатежныеДокументы.Очистить();
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	|	ПоступлениеНаРасчетныйСчет.Ссылка КАК Ссылка,
	|	ПоступлениеНаРасчетныйСчет.СуммаДокумента КАК СуммаДокумента
	|ИЗ
	|	Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
	|ГДЕ
	|	ПоступлениеНаРасчетныйСчет.ПометкаУдаления = ЛОЖЬ
	|	И ПоступлениеНаРасчетныйСчет.Контрагент = &Контрагент
	|	И ПоступлениеНаРасчетныйСчет.Дата >= &Дата1
	|	И ПоступлениеНаРасчетныйСчет.Дата <= &Дата2" ;
	Запрос.УстановитьПараметр("Дата1",НачалоДня(Объект.НачалоПериода));
	Запрос.УстановитьПараметр("Дата2",КонецДня(Объект.КонецПериода));
	Запрос.УстановитьПараметр("Контрагент",Объект.Контрагент);
	Результат = Запрос.Выполнить().Выгрузить();
	Для каждого Выб Из Результат Цикл
		Нов = Объект.ПлатежныеДокументы.Добавить();
		Нов.Сумма                   = Выб.СуммаДокумента;
		Нов.ПоступлениеНаСчет       = Выб.Ссылка;
		Нов.Признак = НайтиСтатус(Выб.Ссылка);
		//Нов.Дата        = Выб.Дата;
	КонецЦикла;		
КонецПроцедуры	

&НаСервере
Функция НайтиСтатус(Платежка)
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	|	МЛК_РеестрОплат.ЛицевойСчет КАК ЛицевойСчет,
	|	МЛК_РеестрОплат.Пакет КАК Пакет,
	|	МЛК_РеестрОплат.ИД_События КАК ИД_События,
	|	МЛК_РеестрОплат.ДокОплатыБит КАК ДокОплатыБит,
	|	МЛК_РеестрОплат.ОперацияПоПлатежнойКарте КАК ОперацияПоПлатежнойКарте,
	|	МЛК_РеестрОплат.Платежка КАК Платежка
	|ИЗ
	|	РегистрСведений.МЛК_РеестрОплат КАК МЛК_РеестрОплат
	|ГДЕ
	|	МЛК_РеестрОплат.Платежка = &Платежка";
	Запрос.УстановитьПараметр("Платежка",Платежка);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	Если Выборка.Следующий() Тогда
		Если Выборка.ДокОплатыБит.Проведен Тогда
			Возврат "обработан";
		Иначе
			Возврат "не обработан";
		КонецЕсли;
	Иначе
		Возврат "не обработан";
	КонецЕсли;
	
КонецФункции	

