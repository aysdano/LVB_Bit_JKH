// Процедура устанавливает отборы для электронных писем.
&НаКлиенте
Процедура ГруппаСтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)

	Если ТекущаяСтраница.Заголовок = "Электронные письма" Тогда
		
	ТаблицаПисем.Отбор.Элементы.Очистить();
	
		Если Объект.СписокРайонов.Количество() > 0 Тогда
			
			Значение = Новый СписокЗначений;
			
			Для Каждого Строка Из Объект.СписокРайонов Цикл 
				
				Значение.Добавить(Строка.Район);
				
			КонецЦикла;
			
			Эл = ТаблицаПисем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			
			Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Район");
			Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
			Эл.ПравоеЗначение   = Значение;
			Эл.Использование    = Истина;
			Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			
		КонецЕсли; 
		
		Если Объект.СписокУчастков.Количество() > 0 Тогда
			
			Значение = Новый СписокЗначений;
			
			Для Каждого Строка Из Объект.СписокУчастков Цикл 
				
				Значение.Добавить(Строка.Участок);
				
			КонецЦикла;
			
			Эл = ТаблицаПисем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			
			Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Участок");
			Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
			Эл.ПравоеЗначение   = Значение;
			Эл.Использование    = Истина;
			Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			
		КонецЕсли;
		
		Если Объект.СписокУлиц.Количество() > 0 Тогда
			
			Значение = Новый СписокЗначений;
			
			Для Каждого Строка Из Объект.СписокУлиц Цикл 
				
				Значение.Добавить(Строка.Улица);
				
			КонецЦикла;
			
			Эл = ТаблицаПисем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			
			Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Улица");
			Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
			Эл.ПравоеЗначение   = Значение;
			Эл.Использование    = Истина;
			Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			
		КонецЕсли; 
		
		Если Объект.СписокЗданий.Количество() > 0 Тогда
			
			Значение = Новый СписокЗначений;
			
			Для Каждого Строка Из Объект.СписокЗданий Цикл 
				
				Значение.Добавить(Строка.Здание);
				
			КонецЦикла;
			
			Эл = ТаблицаПисем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			
			Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Здание");
			Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
			Эл.ПравоеЗначение   = Значение;
			Эл.Использование    = Истина;
			Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			
		КонецЕсли;
		
		Если Объект.СписокЛС.Количество() > 0 Тогда
			
			Значение = Новый СписокЗначений;
			
			Для Каждого Строка Из Объект.СписокЛС Цикл 
				
				Значение.Добавить(Строка.ЛицевойСчет);
				
			КонецЦикла;
			
			Для каждого Строка из Объект.СписокЛС Цикл
				
				Если Строка.ПечатьЗависимыхЛС = Истина Тогда
					
					ДобавитьЗависимыеВОсновнойСписокНаСервере(Значение);
					
					Прервать;
					
				КонецЕсли;
				
			КонецЦикла;	
			
			Эл = ТаблицаПисем.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			
			Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("ЛицевойСчет");
			Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
			Эл.ПравоеЗначение   = Значение;
			Эл.Использование    = Истина;
			Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура МакетКвПриИзменении(Элемент)
	
	ИзменитьСостояниеТабличногоПоля("НЕАКТУАЛЬНОСТЬОТЧЕТА");
	
