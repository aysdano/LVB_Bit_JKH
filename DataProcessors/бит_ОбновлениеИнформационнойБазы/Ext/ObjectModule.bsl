Процедура ОбновитьНазначениеЧастейПомещения()
	
	// Обработка "Комната".
	Комната = Справочники.бит_НазначениеЧастейПомещения.Комната.ПолучитьОбъект();
	
	Если НЕ ЗначениеЗаполнено(Комната.ТипКомнаты) Тогда
		Комната.ТипКомнаты = Справочники.бит_ТипыКомнат.Жилая;
	КонецЕсли;
	
	Комната.Принадлежность        = Перечисления.бит_ПринадлежностьКомнат.Внутренняя;
	Комната.КоэффициентНачислений = 1;
	
	бит_ОбщегоНазначения.ЗаписатьСправочник(Комната, , "Ошибки");
	
	// Обработка "Кухня".
	Кухня = Справочники.бит_НазначениеЧастейПомещения.Кухня.ПолучитьОбъект();
	
	Если НЕ ЗначениеЗаполнено(Кухня.ТипКомнаты) Тогда
		Кухня.ТипКомнаты = Справочники.бит_ТипыКомнат.МОП;
	КонецЕсли;
	
	Кухня.Принадлежность        = Перечисления.бит_ПринадлежностьКомнат.Внутренняя;
	Кухня.КоэффициентНачислений = 1;
	
	бит_ОбщегоНазначения.ЗаписатьСправочник(Кухня, , "Ошибки");
	
КонецПроцедуры

// Процедура переносит записи регистра счетчики на услугах.
//
Процедура ПеренестиЗаписиРеигстраСчетчикиНаУслугах() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_УстановкаСчетчикаУслуги.Услуга,
	|	бит_УстановкаСчетчикаУслуги.УдалитьСпособРасчета,
	|	бит_УстановкаСчетчикаУслуги.СпособРаспределения,
	|	бит_УстановкаСчетчикаУслуги.Ссылка КАК Документ
	|ИЗ
	|	Документ.бит_УстановкаСчетчика.Услуги КАК бит_УстановкаСчетчикаУслуги
	|ГДЕ
	|	бит_УстановкаСчетчикаУслуги.Ссылка.Проведен
	|ИТОГИ ПО
	|	Документ";
	
	ВыборкаДок = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДок.Следующий()  Цикл
		
		НаборЗаписей = РегистрыСведений.бит_СчетчикиНаУслугахОбщий.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.ВидСравнения  = ВидСравнения.Равно;
		НаборЗаписей.Отбор.Регистратор.Значение      = ВыборкаДок.Документ;
		НаборЗаписей.Отбор.Регистратор.Использование = Истина;
		
		НаборЗаписей.Прочитать();
		
		Если НаборЗаписей.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		НаборЗаписей.Очистить();
		
		Выборка = ВыборкаДок.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			НовЗапись = НаборЗаписей.Добавить();
			
			НовЗапись.Период        = Выборка.Документ.Дата;
			НовЗапись.Объект        = Выборка.Документ.Объект;
			НовЗапись.Услуга        = Выборка.Услуга;
			НовЗапись.Счетчик       = Выборка.Документ.Счетчик;
			НовЗапись.Использовать  = ?(Выборка.Документ.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика,Истина,Ложь);
			НовЗапись.ТипСчетчика   = Выборка.Документ.Счетчик.ТипСчетчика;
			НовЗапись.Многотарифный = Выборка.Документ.Многотарифный;
			НовЗапись.СпособРасчета = Выборка.УдалитьСпособРасчета;
			НовЗапись.СпособРаспределения = ?(Выборка.УдалитьСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных,
			Выборка.СпособРаспределения,
			Перечисления.бит_СпособыРаспределения.НеИспользуется);
			
		КонецЦикла; 
		
		Попытка
			
			НаборЗаписей.Записать();
			
		Исключение

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

