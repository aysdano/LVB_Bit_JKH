Процедура ЗаполнитьДокиДомов();
	Запрос = новый запрос;  
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_СписокЗданий.Ссылка КАК Ссылка,
	               |	бит_СписокЗданий.Код КАК Код,
	               |	""История проживающих по дому "" + бит_СписокЗданий.Код + "" на 01.01.2019г"" КАК СодержаниеДока,
	               |	бит_СписокЗданий.Организация КАК Организация
	               |ПОМЕСТИТЬ Дома
	               |ИЗ
	               |	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ОперацияБух.Ссылка КАК Ссылка,
	               |	ОперацияБух.Содержание КАК Содержание,
	               |	ОперацияБух.Организация КАК Организация
	               |ПОМЕСТИТЬ Доки
	               |ИЗ
	               |	Документ.ОперацияБух КАК ОперацияБух
	               |ГДЕ
	               |	ОперацияБух.ПометкаУдаления = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Дома.Ссылка КАК Дом,
	               |	Доки.Ссылка КАК ДокСсылка,
	               |	Дома.Организация КАК Организация,
	               |	Дома.СодержаниеДока КАК СодержаниеДока
	               |ИЗ
	               |	Дома КАК Дома
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Доки КАК Доки
	               |		ПО Дома.СодержаниеДока = Доки.Содержание
	               |			И Дома.Организация = Доки.Организация";
	
	мДокиДомов = Запрос.Выполнить().Выгрузить();
	Для каждого СтрокаДома из мДокиДомов цикл
		Если не ЗначениеЗаполнено(СтрокаДома.ДокСсылка) тогда
			ДокОбъект = Документы.ОперацияБух.СоздатьДокумент();
			ДокОбъект.Дата = ДобавитьМесяц(Объект.Дата,-6);
			ДокОбъект.Организация = СтрокаДома.Организация;
			ДокОбъект.Содержание = СтрокаДома.СодержаниеДока;
			ДокОбъект.Комментарий = СтрокаДома.СодержаниеДока;
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			
			СтрокаДома.ДокСсылка = ДокОбъект.Ссылка;
		КонецЕсли;	
	КонецЦикла;	
	мДокиДомов.Колонки.Добавить("Набор");
    мДокиДомов.Индексы.Добавить("Дом");
	
	
	
КонецПроцедуры	

