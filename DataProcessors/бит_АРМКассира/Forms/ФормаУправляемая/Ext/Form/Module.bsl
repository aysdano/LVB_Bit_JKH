&НаКлиенте
Процедура ЗакрытиеКассовойСмены2Нажатие(Элемент)
	
	Если ЗначениеЗаполнено(Объект.Касса) Тогда 
		
		ОборудованиеПодключено = Истина;
		
		КоличествоФР = 0;
		
		Если ОборудованиеПодключено Тогда
			
			КоличествоФР = 1;
			
		КонецЕсли;	
		
		Отказ = Истина;	
		
		Если КоличествоФР = 0 Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Для выбранной кассы не подключен фискальный регистратор";
			Сообщение.Сообщить();
			
			Отказ = Истина;
		ИначеЕсли КоличествоФР = 1 Тогда
			
			Отказ = Ложь;
		КонецЕсли;
		
		Если Не Отказ Тогда
			
			Заголовок = Элемент.Заголовок;
			
			ТаблицаЧековКоличество = ПолучитьТаблицуЧеков();
			
			Если ТаблицаЧековКоличество >0 тогда
				
				ТекстВопроса = "В базе присутствуют неархивированные чеки."+Символы.ПС+
				"Рекомендуется сначала создать документ ""Оплата КУ""."+Символы.ПС+
				" Создать его сейчас?";
				ПоказатьВопрос(Новый ОписаниеОповещения("ЗакрытиеКассовойСмены2НажатиеЗавершение1", ЭтотОбъект, Новый Структура("Отказ, ТекстВопроса, Заголовок", Отказ, ТекстВопроса, Заголовок)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
				Возврат;
				
			Иначе
				
				ТекстВопроса = "Закрыть смену?";
				ПоказатьВопрос(Новый ОписаниеОповещения("ЗакрытиеКассовойСмены2НажатиеЗавершение1", ЭтотОбъект, Новый Структура("Отказ, ТекстВопроса, Заголовок", Отказ, ТекстВопроса, Заголовок)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
				Возврат;
				
				
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не выбрана касса!";
		Сообщение.Сообщить();
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеКассовойСмены2НажатиеЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Отказ = ДополнительныеПараметры.Отказ;
	ТекстВопроса = ДополнительныеПараметры.ТекстВопроса;
	Заголовок = ДополнительныеПараметры.Заголовок;
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		
		Если мРазделитьОплату Тогда
			
			РазбитьОплатаКУПоДатамНаСервере(Отказ);
			
		Иначе
			
			СоздатьОплатаКУНаСервере(Отказ);
			
		КонецЕсли; 
		
		ОповеститьОбИзменении(Тип("ДокументСсылка.бит_ЧекККМ"));
		
		ЗакрытиеКассовойСмены2НажатиеФрагмент1(Отказ, Заголовок);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗакрытиеКассовойСмены2НажатиеФрагмент1(Знач Отказ, Знач Заголовок)
	
	Перем ЗакрытьСмену, ТекстВопроса;
	
	ЗакрытьСмену = НЕ Отказ;
	Если НЕ ЗакрытьСмену Тогда
		ТекстВопроса = "При создании документа ""Оплата КУ"" возникла ошибка."+Символы.ПС+
		"Все равно закрыть кассовую смену?";
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗакрытиеКассовойСмены2НажатиеЗавершение", ЭтотОбъект, Новый Структура("Заголовок", Заголовок)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
		Возврат;
	Иначе
		ЗакрытиеКассовойСмены2НажатиеФрагмент(ЗакрытьСмену,Заголовок)	
	КонецЕсли;
	
КонецПроцедуры

