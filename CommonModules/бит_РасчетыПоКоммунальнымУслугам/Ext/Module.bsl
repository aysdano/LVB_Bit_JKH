// БИТ_ЖКХ Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ВыполнитьРасчетПоСтроке(Приемник, Знач Источник, Знач Остаток, Знач Показатель, Знач ОбщийПоказатель, СтрокаРасчета)
	
	Если Показатель = 0 И ОбщийПоказатель = 0 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	НоваяСтрока = Приемник.Добавить();
	ЗаполнитьЗначенияСвойств(НоваяСтрока, Источник);
	
	НераспределенныйОстаток = 0;
	тмпСумма                = ОКР((Показатель*Остаток)/ОбщийПоказатель,4);
	Сумма                   = тмпСумма;
	
	РазницаРаспределения = 0;
	
	// Отрицательная сумма не должна превышать сумму начислений. 
	Если тмпСумма < 0 Тогда
		
		Сумма                   = Мин(тмпСумма * -1, СтрокаРасчета.СуммаНачислений) * -1;
		НераспределенныйОстаток = тмпСумма - Сумма;
		
		СтрокаРасчета.НераспределенныйОстаток = СтрокаРасчета.НераспределенныйОстаток + НераспределенныйОстаток;
		
	ИначеЕсли НЕ СтрокаРасчета.НераспределенныйОстаток = 0 Тогда
		
		РазницаРаспределения = СтрокаРасчета.НераспределенныйОстаток + тмпСумма;
		
		Если РазницаРаспределения > 0 Тогда
			НераспределенныйОстаток = (СтрокаРасчета.НераспределенныйОстаток * -1);
			Сумма                   = РазницаРаспределения;
			
			СтрокаРасчета.НераспределенныйОстаток = 0;
		Иначе
			
			НераспределенныйОстаток = Сумма;
			СтрокаРасчета.НераспределенныйОстаток = РазницаРаспределения;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	СтрокаРасчета.СуммаНачислений = СтрокаРасчета.СуммаНачислений + Сумма;
	
	Объем = ОКР(?(Источник.Тариф = 0, 0 ,Сумма/Источник.Тариф),4);
	
	НоваяСтрока.НераспределенныйОстаток = НераспределенныйОстаток;
	НоваяСтрока.Здание                  = НоваяСтрока.ЛицевойСчет.Здание;
	НоваяСтрока.ИсточникПоказаний       = Перечисления.бит_ИсточникПоказаний.Инспектор;
	НоваяСтрока.Начислено               = Сумма;
	НоваяСтрока.КоличествоЕдиницПоЛС    = Объем;
	// БИТ_ЖКХ 11.05.2016 11:28:54 Начало правки...
	НоваяСтрока.НачислениеПоНормативуОДН= Источник.ФактСУчетомСтавкиОДН;
	// БИТ_ЖКХ 11.05.2016 11:28:54 Конец правки.
	
	
	Возврат НоваяСтрока;
	
КонецФункции // () 

// Процедура выставляет пометку на удаление у подчиненых документов.
//
// Параметры:
//  ДокументСтруктура  - <Тип.Структура>  - Содержит данные документа владельца(Имя,Ссылка, ПометкаУдаления).
//
//  Отказ              - <Тип.Булево>     - Фдлаг.
//                 
Процедура СинхронизацияПометкиНаУдалениеУСДокументамиРаспределенияРасходов(ДокументСтруктура, Отказ = Ложь) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ Док.ПометкаУдаления
	| ИЗ 
	//|      Документ." + ДокументОбъект.Метаданные().Имя + " КАК Док 
	|      Документ." + ДокументСтруктура.Имя + " КАК Док
	|     ГДЕ Док.Ссылка = &ДокументСсылка";
	
	Запрос.УстановитьПараметр("ДокументСсылка" , ДокументСтруктура.Ссылка);
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если НЕ ДокументСтруктура.ПометкаУдаления = ?(Результат.Количество()>0,Результат[0].ПометкаУдаления, ложь) Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	АктОбОказанииПроизводственныхУслуг.Ссылка КАК Документ,
		|	АктОбОказанииПроизводственныхУслуг.ПометкаУдаления
		|ИЗ
		|	Документ.АктОбОказанииПроизводственныхУслуг КАК АктОбОказанииПроизводственныхУслуг
		|ГДЕ
		|	АктОбОказанииПроизводственныхУслуг.бит_ДокументОснование = &ДокументСсылка
		|	И АктОбОказанииПроизводственныхУслуг.ПометкаУдаления = &ПометкаУдаления
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	РеализацияТоваровУслуг.Ссылка,
		|	РеализацияТоваровУслуг.ПометкаУдаления
		|ИЗ
		|	Документ.РеализацияТоваровУслуг КАК РеализацияТоваровУслуг
		|ГДЕ
		|	РеализацияТоваровУслуг.бит_ДокументОснование = &ДокументСсылка
		|	И РеализацияТоваровУслуг.ПометкаУдаления = &ПометкаУдаления";
		Запрос.УстановитьПараметр("ПометкаУдаления", НЕ ДокументСтруктура.ПометкаУдаления);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			Попытка
				
				ДокументРаспределения = Выборка.Документ.ПолучитьОбъект();
				
				ДокументРаспределения.УстановитьПометкуУдаления(ДокументСтруктура.ПометкаУдаления);
				
				Если ДокументСтруктура.ПометкаУдаления Тогда
					
					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ <" + ДокументРаспределения + "> помечен на удаление.");
					
				Иначе
					
					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("У документа <" + ДокументРаспределения + "> снята пометка на удаление.");
					
				КонецЕсли;
				
			Исключение
				Отказ = Истина;
			КонецПопытки;
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти