		Если ТекстовыйДокумент_Нач3.КоличествоСтрок() <= 1 Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Заголовок_Нач3 + " не сформирован.");
			
		Иначе
			
			Попытка
				
				ТекстовыйДокумент_Нач3.Записать(""+Объект.КаталогНач3+"\"+Объект.ИмяФайлаНач3+".txt", "cp866");

