&НаКлиенте
Процедура УлицаПриИзменении(Элемент)
	
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("Улица");
	ДополнитьМассивИсключений(МассивИсключений);
	ОчиститьРеквизитыФормы(МассивИсключений);
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗданиеПриИзменении(Элемент)
	
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("Улица");
	МассивИсключений.Добавить("Здание");
	ДополнитьМассивИсключений(МассивИсключений);
	
	ОчиститьРеквизитыФормы(МассивИсключений);
	
	Корпус = КорпусНаСервере(Объект.Здание);
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Функция КорпусНаСервере(Здание)
	
	Возврат Здание.Корпус;
	
КонецФункции	

&НаКлиенте
Процедура КвартираПриИзменении(Элемент)
	
	МассивИсключений = Новый Массив;
	МассивИсключений.Добавить("Улица");
	МассивИсключений.Добавить("Здание");
	МассивИсключений.Добавить("Квартира");
	ДополнитьМассивИсключений(МассивИсключений);
	
	ОчиститьРеквизитыФормы(МассивИсключений);
	
	КвартираПриИзмененииНаСервере();
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗданиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура("Улица", Объект.Улица);
	
	ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая",Новый Структура("Отбор", Отбор),Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КвартираНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура("Владелец", Объект.Здание);
	
	ОткрытьФорму("Справочник.бит_Квартиры.Форма.ФормаВыбора",Новый Структура("Отбор", Отбор),Элемент);
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляУслуги

&НаКлиенте
Процедура УслугиУслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СписокУслуг = ПолучитьСписокУслуг(Объект.ЛицевойСчет, Объект.ДатаЗаведения);
	
	Отбор = Новый Структура;
	
	Если НЕ СписокУслуг = Неопределено Тогда
		Отбор.Вставить("Ссылка", СписокУслуг);
	КонецЕсли; 
	
	ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая",Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПоставщикНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Услуги.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.Услуга.Пустая() Тогда
		
		Список = ПолучитьСписокПоТаблицеУслуги(ТекущаяСтрока.Услуга, ТекущаяСтрока.Поставщик);
		Элементы.УслугиПоставщик.СписокВыбора.ЗагрузитьЗначения(Список);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиРежимПотребленияНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Услуги.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.Услуга.Пустая() Тогда
		
		Список = ПолучитьСписокПоТаблицеУслуги(ТекущаяСтрока.Услуга, ТекущаяСтрока.РежимПотребления);
		Элементы.УслугиРежимПотребления.СписокВыбора.ЗагрузитьЗначения(Список);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСпособРасчетаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Услуги.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.Услуга.Пустая() Тогда
		
		Список = ПолучитьСписокПоТаблицеУслуги(ТекущаяСтрока.Услуга, ТекущаяСтрока.СпособРасчета);
		
		Элементы.УслугиСпособРасчета.СписокВыбора.ЗагрузитьЗначения(Список);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляПроживающие

&НаКлиенте
Процедура ПроживающиеПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	НоваяСтрока = Объект.Проживающие.Добавить();
	НоваяСтрока.СтатусФизЛица    = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.ПостояннаяРегистрация");
	НоваяСтрока.СтепеньРодства   = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_НеУказано");
	НоваяСтрока.СтатусПроживания = ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Постоянно");
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживающиеВладелецКвартирыПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Проживающие.ТекущиеДанные;
	
	Если НЕ ТекущаяСтрока.ВладелецКвартиры = ПредопределенноеЗначение("Перечисление.ДаНет.Да") Тогда
		
		ТекущаяСтрока.ДоляПлощади                   = 0;
		ТекущаяСтрока.ПравоустанавливающиеДокументы = Неопределено;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживающиеФизЛицоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.Проживающие.ТекущиеДанные;
	
	// Структура   с данными адреса.
	АдресУбытия = бит_ОбщегоНазначения.ПолучитьАдресИзКонтактнойИнформацииФизЛица(ТекущиеДанные.ФизЛицо, "Убытия", Истина);
	АдресПрибытия = бит_ОбщегоНазначения.ПолучитьАдресИзКонтактнойИнформацииФизЛица(ТекущиеДанные.ФизЛицо, "Прибытия", Истина);
	
	Если ЗначениеЗаполнено(АдресУбытия) Тогда
		
		ТекущиеДанные.КудаВыписан 		= АдресУбытия.Представление;
		ТекущиеДанные.КудаВыписанАдрес 	= ФормированиеАдресаДляФормы(АдресУбытия);
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(АдресПрибытия) Тогда
		
		ТекущиеДанные.ОткудаПрибыл 		= Строка(АдресПрибытия.Представление);
		ТекущиеДанные.ОткудаПрибылАдрес = ФормированиеАдресаДляФормы(АдресПрибытия);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживающиеДоляПлощадиПриИзменении(Элемент)
	
	СуммаДолей = Объект.Проживающие.Итог("ДоляПлощади");
	
	Если СуммаДолей > 1 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Суммарная доля площади превышает максимальную (1) на " + Строка(СуммаДолей -1) +".");
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживающиеДатаСнятияСРегистрацииПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Проживающие.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекСтрока.ДатаСнятияСРегистрации) И НачалоДня(ТекСтрока.ДатаСнятияСРегистрации) <= НачалоДня(ТекущаяДата()) Тогда
		
		ТекСтрока.СтатусФизЛица = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан");

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Статус физ лица "+ТекСтрока.ФизЛицо+" изменен на ""Удален с лицевого счета""!");
		
	ИначеЕсли НЕ ЗначениеЗаполнено(ТекСтрока.ДатаСнятияСРегистрации) ИЛИ (ТекСтрока.ДатаСнятияСРегистрации >= ТекущаяДата()
		
		// БИТ_ЖКХ 15.04.2014
		// И ТекСтрока.СтатусФизЛица = Справочники.бит_СтатусФизЛица.Выписан) Тогда.
		И ТекСтрока.СтатусФизЛица = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан")) Тогда
		// БИТ_ЖКХ 15.04.2014
		
		ТекСтрока.СтатусФизЛица = Неопределено;

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните статус физ лица : " + ТекСтрока.ФизЛицо + "!");
		
	КонецЕсли; 
	
КонецПроцедуры

