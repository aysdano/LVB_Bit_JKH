	Иначе
		Запрос.УстановитьПараметр("НеПроверятьУслуги", Истина);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Наименование КАК НомерЛС,
	|	бит_ЛицевыеСчета.Здание КАК Здание,
	|	бит_ЛицевыеСчета.Квартира КАК Квартира,
	|	бит_Квартиры.Наименование КАК НомерКвартиры
	|ПОМЕСТИТЬ ВТ_ЛицевыеСчета
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	|		ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
	|ГДЕ
	|	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И НЕ бит_СписокЗданий.ПометкаУдаления
	|	И (&НеПроверятьЛС
	|			ИЛИ бит_ЛицевыеСчета.Ссылка В (&СписокЛС))
	|	И (&НеПроверятьОрганизации
	|			ИЛИ бит_ЛицевыеСчета.Организация В (&Организация))
	|	И (&НеПроверятьУлицы
	|			ИЛИ бит_СписокЗданий.Улица В (&СписокУлиц))
	|	И (&НеПроверятьЗдания
	|			ИЛИ бит_ЛицевыеСчета.Здание В (&СписокЗданий))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК УслугаЖКХ,
	|	бит_УслугиЖКХ.Наименование КАК Наименование,
	|	бит_УслугиЖКХ.ГрафаОтчетаГЦЖС КАК ГрафаОтчетаГЦЖС
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&КонецПериода,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					ВТ_ЛицевыеСчета.ЛицевойСчет
	|				ИЗ
	|					ВТ_ЛицевыеСчета)) КАК бит_СведенияПоУслугамЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	|		ПО бит_СведенияПоУслугамЛССрезПоследних.Услуга = бит_УслугиЖКХ.Ссылка
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	|	бит_УслугиЖКХ.Наименование,
	|	бит_УслугиЖКХ.ГрафаОтчетаГЦЖС";
	
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Создание ОбъектаXDTO с типом СписокУслуг.
	ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "СписокУслуг");
	СписокУслугXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
	
	
	Пока Выборка.Следующий() Цикл
		
		// Создание ОбъектаXDTO с типом Услуга.
		ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "Услуга");
		УслугаXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
		
		УслугаXDTO.Идентификатор	= Строка(Выборка.УслугаЖКХ.УникальныйИдентификатор());
		УслугаXDTO.Название			= Выборка.Наименование;
		УслугаXDTO.ТипУслуги		= Строка(Выборка.ГрафаОтчетаГЦЖС);
		
		СписокУслугXDTO.Услуга.Добавить(УслугаXDTO);
		
	КонецЦикла;
	
	ЗаписатьФайлВыгрузки(СписокУслугXDTO, ПараметрыОбмена, "services.xml");
	
КонецПроцедуры

Процедура ВыгрузитьУслугиПоЛС(ПараметрыОбмена) Экспорт
	
	Запрос = Новый Запрос;
