	|	бит_ПоставщикиУслуг.Наименование";
	
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Создание ОбъектаXDTO с типом СписокУслугПОЛС.
	ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "СписокУслугПОЛС");
	СписокУслугПОЛСXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
	
	
	Пока Выборка.Следующий() Цикл
		
