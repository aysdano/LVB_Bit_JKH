конецфункции	

функция НайтиПоследнийПорядковыйНомерЛС()
	
  запрос = новый Запрос;
  запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                 |	бит_ЛицевыеСчета.Наименование КАК Наименование
                 |ИЗ
                 |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
                 |ГДЕ
                 |	бит_ЛицевыеСчета.Наименование ПОДОБНО &Наименование";
				 //|ГДЕ
				 //|	бит_ЛицевыеСчета.Здание = &Здание";
  
  
//  запрос.УстановитьПараметр("Здание", Владелец);
  запрос.УстановитьПараметр("Наименование", строка(Объект.ПрефиксЛС) + "%");
  табЗапроса = запрос.Выполнить().Выгрузить(); 
//  табЗапроса.Сортировать("Наименование Убыв");
  
  числовойМассив = новый Массив;
  для каждого стр из табЗапроса цикл
	 числовойМассив.Добавить(СтроковыеФункцииКлиентСервер.СтрокаВЧисло(стр.Наименование));
  конеццикла;	  
  
  СписокЗначений = Новый СписокЗначений;
  СписокЗначений.ЗагрузитьЗначения(числовойМассив);
  СписокЗначений.СортироватьПоЗначению();
  числовойМассив = СписокЗначений.ВыгрузитьЗначения();  
  
  если табЗапроса.Количество() > 0 тогда
	  
	номер = ПолучитьЧисловойНомерЛС(табЗапроса[0].Наименование);;	
	возврат номер + 1; 
  иначе	  
   возврат 1;	  
  конецесли;	  
	
конецфункции

Функция ПолучитьЧисловойНомерЛС(строкаНомера)

 длинаСтрокиНомера = СтрДлина(строкаНомера)- СтрДлина(Объект.ПрефиксЛС) + СтрДлина(Объект.ПостфиксЛС); 	
 строкаПорядковогоНомера = Сред(строкаНомера, (СтрДлина(Объект.ПрефиксЛС) + 1), длинаСтрокиНомера); 	
	
 возврат Число(строкаПорядковогоНомера);
КонецФункции // ПолучитьЧисловойНомерЛС()


