//HD+
// Форматирует период (две даты) в строку
// Параметры:
//  ДатаНачала - дата начала периода
//  ДатаОкончания - дата окончания периода
// Возвращает:
//  Строка - отформатированный период
//
Функция ФорматироватьПериод(ДатаНачала, ДатаОкончания)
	
	Если НЕ ЗначениеЗаполнено(ДатаНачала) И НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаПериода = "";
	
	Если ЗначениеЗаполнено(ДатаНачала) Тогда
		СтрокаПериода = "с " + ФорматироватьДату(ДатаНачала);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаОкончания) Тогда
		Если СтрокаПериода <> "" Тогда
			СтрокаПериода = СтрокаПериода + " по ";
		Иначе
			СтрокаПериода = "по ";
		КонецЕсли;
		СтрокаПериода = СтрокаПериода + ФорматироватьДату(ДатаОкончания);
	КонецЕсли;
	
	Возврат СтрокаПериода;
	
