// Процедура - обработчик события "ПриИзменении" реквизита "СчетчикиПодкрутка".
//
&НаКлиенте
Процедура СчетчикиПодкруткаПриИзменении(Элемент)
	
	Если Не Запись.СчетчикиПодкрутка Тогда
		
		Запись.ПодкруткаНаЛС                                     = Ложь;
		
	КонецЕсли;
	
	Если Запись.СчетчикиПодкрутка И Запись.ВариантПодкрутки.Пустая() Тогда
		
		Запись.ВариантПодкрутки = ПредопределенноеЗначение("Перечисление.бит_ВариантыПодкрутки.ПоНорме");
		
	КонецЕсли; 
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

// Процедура - обработчик события "ОкончаниеВводаТекста" реквизита "Последний день приема платежей".
//
&НаКлиенте
Процедура ПоследнийДеньПриемаПлатежейОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Число(Текст) > 31 Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Последний день приема платежей не может быть больше 31");
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ПередЗаписьюНаСервере" формы.
//
&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Запись.ЛьготаПерсонифицированная И НЕ мЛьготаПерсонифицированная Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Запись.Период));
		Запрос.УстановитьПараметр("КонецПериода" , КонецМесяца(Запись.Период));
		Запрос.УстановитьПараметр("Организация"  , Запись.Организация);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)) КАК СуммаОборот,
		|	бит_НачисленияПоУслугамЖКХОбороты.Регистратор.Организация
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОбороты
		|ГДЕ
		|	бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачисленияПоУслугамЖКХОбороты.Регистратор.Организация";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() И НЕ Выборка.СуммаОборот = 0 Тогда
			
			Текст = "В текущем периоде: " + Формат(Запись.Период,"ДФ=ММMM.yyyy") + " выполнено начисление льгот.
			|Удалите документы начисления льгот. Флаг ""Льгота персонифицированная"" снят.";
			
			Запись.ЛьготаПерсонифицированная = Ложь;
			
			бит_ОбщегоНазначения.СообщитьОбОшибке(Текст);
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

