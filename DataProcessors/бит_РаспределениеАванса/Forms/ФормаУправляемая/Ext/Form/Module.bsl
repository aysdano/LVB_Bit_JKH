					СоздатьДокументРеализации(Контрагент, ДоговорКонтрагента, Основание, Выборка,,);
					// БИТ_ЖКХ 23.10.2017 11:35:57 Конец правки. 
					
				КонецЦикла; // ВыборкаДоговорКонтрагента. Обход договоров.
				
