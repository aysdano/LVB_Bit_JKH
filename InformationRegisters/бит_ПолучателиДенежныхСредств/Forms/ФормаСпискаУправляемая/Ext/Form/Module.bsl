// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения  = Новый Структура; 
	
	КэшированныеЗначения.Вставить("Ошибка", Ложь);
	
	Попытка
		
		КэшированныеЗначения.Вставить("мУслугаОтбор", Параметры.Отбор.Услуга);
		
	Исключение
		
	КонецПопытки;
	
КонецПроцедуры

#КонецОбласти

