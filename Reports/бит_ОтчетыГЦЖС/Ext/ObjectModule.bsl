	РасчетПоСчетчикам                   = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам;
	ПоПроживающим                       = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим;
	
	ДокументРезультат.Вывести(Шапка);
	ДокументРезультат.Вывести(ШапкаТаблицы);
	
	НомерПП = 0;
	
	Пока ВыборкаЛьгота.Следующий() Цикл
		
		СтрокаЛьгота.Параметры.Льгота = ВыборкаЛьгота.Льгота;
		ДокументРезультат.Вывести(СтрокаЛьгота);
		
		ВыборкаЛицевойСчет = ВыборкаЛьгота.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		ИтогВодопровод            = 0;
		ИтогВывозБытовыхОтходов   = 0;
