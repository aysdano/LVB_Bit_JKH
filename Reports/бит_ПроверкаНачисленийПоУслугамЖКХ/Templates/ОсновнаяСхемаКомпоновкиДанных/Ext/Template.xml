	бит_НачислениеПоЛицевымСчетамЛицевыеСчета.Услуга
ИЗ
	Документ.бит_НачислениеПоЛицевымСчетам.ЛицевыеСчета КАК бит_НачислениеПоЛицевымСчетамЛицевыеСчета
ГДЕ
	бит_НачислениеПоЛицевымСчетамЛицевыеСчета.Сумма = 0
	И бит_НачислениеПоЛицевымСчетамЛицевыеСчета.Ссылка.Дата &gt;= НАЧАЛОПЕРИОДА(&amp;Период, МЕСЯЦ)
	И бит_НачислениеПоЛицевымСчетамЛицевыеСчета.Ссылка.Дата &lt;= КОНЕЦПЕРИОДА(&amp;Период, МЕСЯЦ)</query>
