&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	Если РедактированиеИзДокумента Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Фамилия"  , Запись.Фамилия);
		ПараметрыФормы.Вставить("Имя"      , Запись.Имя);
		ПараметрыФормы.Вставить("Отчество" , Запись.Отчество);
		
		Оповестить("СменаФамилииПоМЖ", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;
	
КонецПроцедуры
