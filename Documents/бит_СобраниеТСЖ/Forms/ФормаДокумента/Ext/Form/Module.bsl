&НаКлиенте
Процедура ТСЖОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ДеревоРез = ДеревоРзельтатовГолосования.ПолучитьЭлементы();
	ДеревоУч  = ДеревоУчастниковГолосования.ПолучитьЭлементы();
	
	Если НЕ ВыбранноеЗначение = Объект.ТСЖ Тогда
		
		Если НЕ ДеревоРез.Количество() = 0 ИЛИ НЕ ДеревоУч.Количество() = 0 Тогда
			
			Ответ = Неопределено;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ТСЖОбработкаВыбораЗавершение", ЭтотОбъект, Новый Структура("ДеревоРез, ДеревоУч, СтандартнаяОбработка", ДеревоРез, ДеревоУч, СтандартнаяОбработка)), "Список участников и результаты голосования будут очищены. Продолжить?", РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТСЖОбработкаВыбораЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ДеревоРез = ДополнительныеПараметры.ДеревоРез;
	ДеревоУч = ДополнительныеПараметры.ДеревоУч;
	СтандартнаяОбработка = ДополнительныеПараметры.СтандартнаяОбработка;
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		ДеревоРез.Очистить();
		ДеревоУч.Очистить();
		Объект.УчастникиГолосования.Очистить();
		Объект.РезультатыГолосования.Очистить();
		
	Иначе
		СтандартнаяОбработка = Ложь;
	КонецЕсли;
	
КонецПроцедуры

