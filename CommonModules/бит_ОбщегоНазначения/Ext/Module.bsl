				СуммаСписания = ?(ИтогСальдо = 0 ИЛИ БазоваяСумма < 0
				,0
				,?(ТекСтрока.Сальдо > 0 , ТекСтрока.Сальдо,0)/ИтогСальдо) * Мин(СуммаДокумента, БазоваяСумма);
				
				ТекСтрока.Сумма = ТекСтрока.Сумма + Мин(СуммаСписания,?(ТекСтрока.Сальдо > 0 , ТекСтрока.Сальдо,0));
				СуммаДляРаспределения = СуммаДляРаспределения - Мин(СуммаСписания,?(ТекСтрока.Сальдо > 0 , ТекСтрока.Сальдо,0)); 
			КонецЦикла;
			
			Если СуммаДляРаспределения < 0 Тогда
				СуммаДляРаспределения = 0;
