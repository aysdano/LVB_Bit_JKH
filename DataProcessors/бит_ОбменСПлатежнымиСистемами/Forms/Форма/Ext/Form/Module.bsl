		|	СУММА(ЕСТЬNULL(ГрупОстатки.НачальноеСальдо, 0) + ЕСТЬNULL(ГрупОбороты.СуммаОплаты, 0)) КАК НачальноеСальдоСУчетомОплаты,
		|	СУММА(ЕСТЬNULL(ГрупОстатки.НачальноеСальдо, 0) + ЕСТЬNULL(ГрупОбороты.СуммаОплаты, 0) + ЕСТЬNULL(ГрупОстатки.НачальноеСальдоПени, 0)) КАК НачальноеСальдоСУчетомОплатыИПени,
		|	СУММА(ЕСТЬNULL(ГрупОбороты.СуммаНачислений, 0) + ЕСТЬNULL(ГрупОбороты.СуммаПени, 0)) КАК СуммаНачисленийСУчетомПени,
		|	СУММА(ЕСТЬNULL(ГрупОбороты.СуммаОплаты, 0) + ЕСТЬNULL(ГрупОбороты.СуммаНачислений, 0)) КАК СуммаНачисленийСУчетомОплаты,
		|	СУММА(ЕСТЬNULL(ГрупОбороты.СуммаОплаты, 0) + ЕСТЬNULL(ГрупОбороты.СуммаНачислений, 0) + ЕСТЬNULL(ГрупОбороты.СуммаПени, 0)) КАК СуммаНачисленийСУчетомОплатыИПени
		|ИЗ
		|	СведенияПоУслугам КАК СведенияПоУслугам
