	|	И бит_ЛицевыеСчета.Здание = &Здание
	|	И бит_ЛицевыеСчета.Квартира = &Квартира";
	Запрос.УстановитьПараметр("УлицаЛицевогоСчета" ,УлицаЛицевогоСчета);
