#Область Журнал
Функция ПроверитьЕстьЛиИнтернетСоединение()
	Прокси = Неопределено; 
	// устанавливаем соединение с сервером 
	Попытка 
		Соединение = Новый HTTPСоединение("yandex.ru", , , , Прокси, 300);
	Исключение 
		ЖурналСтрокаОписанияОшибки = Строка(ОписаниеОшибки()); 
		ИмяСобытияВЖурнал = "Проверка интернета";
		КодСостояния = "";
		СтрокаОтвета = "Интернета нет";	
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,"",СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ТекущаяДатаСеанса());	
		Возврат Ложь; 
	КонецПопытки; 
	Возврат Истина;
КонецФункции
Процедура ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,СтрокаЗапроса,СтрокаОтвета,СтрокаОшибки1С,ВремяНачало) Экспорт
	
	СтрокаЗапросаНовая = ЗначениеВСтрокуВнутр(СтрокаЗапроса);
	
	НоваяЗапись = РегистрыСведений.МЛК_ЖурналОшибокИнтеграции.СоздатьМенеджерЗаписи();
	НоваяЗапись.Период              = ТекущаяДатаСеанса();
	НоваяЗапись.ВидЗапроса          = ИмяСобытияВЖурнал;
	НоваяЗапись.КодОшибки           = КодСостояния;
	НоваяЗапись.СтрокаЗапроса       = СтрокаЗапросаНовая;
	НоваяЗапись.СтрокаОтвета        = СтрокаОтвета;
	НоваяЗапись.СтрокаОшибкиОт1с    = СтрокаОшибки1С;
	НоваяЗапись.ВремяНачало         = ВремяНачало;
	НоваяЗапись.Записать();
	
КонецПроцедуры
#КонецОбласти

#Область Создание_Справочников_МЛК
Функция СоздатьСправочникиДляРаботыСМЛК(Настройки)
	ЕстьАгент         = ПолучитьАгентаНаСервере(Настройки);
	ТипКомиссии       = ОтправитьТипКомиссииВМЛК(Настройки); 
	ДанныеОрганизации = ОтправитьДанныеОрганизацииВМЛК(Настройки);
	Если ЕстьАгент И ТипКомиссии И ДанныеОрганизации Тогда
		// Журнал
		ИмяСобытияВЖурнал = "СОЗДАНИЕ АГЕНТА ДА";
		КодСостояния = "СОЗДАНИЕ АГЕНТА ДА";
		СтрокаОтвета = "";	
		ЖурналСтрокаОписанияОшибки = "";
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,"",СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ТекущаяДатаСеанса());	
		
		Возврат Истина;
	Иначе
		// Журнал
		ИмяСобытияВЖурнал = "СОЗДАНИЕ АГЕНТА НЕТ"+СТрока(ЕстьАгент)+Строка(ТипКомиссии)+СТрока(ДанныеОрганизации);
		КодСостояния = "СОЗДАНИЕ АГЕНТА НЕТ";
		СтрокаОтвета = "";	
		ЖурналСтрокаОписанияОшибки = "";
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,"",СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ТекущаяДатаСеанса());	
		Возврат Ложь;
	КонецЕсли;
КонецФункции
Функция ПолучитьАгентаНаСервере(Настройки)
	
	АдресСервисаСтр = Настройки.АдресКабинетов;
	Соединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос        = Новый HTTPЗапрос("/api/v8/auth?login="+СокрЛП(Настройки.Логин)+"&password="+СокрЛП(Настройки.Пароль));
	ЖурналВремяНачало = ТекущаяДатаСеанса();
	ЖурналЗапросБезКодировки   = Строка(АдресСервисаСтр)+Строка("/api/v8/auth?login="+СокрЛП(Настройки.Логин)+"&password="+СокрЛП(Настройки.Пароль));
	
	Результат    = Соединение.Получить(Запрос);
	Если Результат.КодСостояния <> 200 Тогда 
		ИмяСобытияВЖурнал = "Получение ключа для создания агента";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвета = Результат.ПолучитьТелоКакСтроку();;	
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
		Возврат ложь;	
	КонецЕсли; 
	
	РезультатПроверки    = Результат.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
	ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
	ЧтениеJSON.Закрыть();
	Ключ = "";
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Значение");
	Для Каждого стр Из ЗагруженныеДанные Цикл
		Если СокрЛП(стр.Ключ)= "access_token" Тогда
			Ключ            = Стр.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		// Журнал
		ИмяСобытияВЖурнал = "Получение ключа для клонирования";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвета = Результат.ПолучитьТелоКакСтроку();;	
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
		Возврат Ложь;	
	Иначе
		
	КонецЕсли;
	
	
	Успешных=0;Всего=0;
	
	АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
	АдресРесурса = "/api/v8/agentdata/"+Строка(СокрЛП(Настройки.НомерПриложения));	
	// Журнал
	ЖурналЗапросБезКодировки = Строка(АдресСервисаСтр)+Строка(АдресРесурса);
	
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer "+Строка(Ключ));  
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		МЛК_Общий.ЗаписатьДанныеВЖурнал("Получение данных агента","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		Возврат Ложь;
	КонецПопытки;
	
	Если Ответ.КодСостояния = 200 Тогда
		СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		
		Если Не ПустаяСтрока(СтрокаОтвет) Тогда
			РезультатПроверки = СтрокаОтвет;
			Если СокрЛП(РезультатПроверки)="false" Тогда
				
			Иначе
				
				
				ЧтениеJSON = Новый ЧтениеJSON;
				ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
				ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
				ЧтениеJSON.Закрыть();
				
				ТЗ = РаспарситьДанныеАгентаИСоздатьВСправочнике(ЗагруженныеДанные,Настройки);
				// СоздатьАгентаАСправочнике(ТЗ,Настройки);
				Возврат Истина;
			КонецЕсли;
		КонецЕсли;
	Иначе
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		Возврат Ложь;
	КонецЕсли;
	Возврат Истина;
КонецФункции
Функция РаспарситьДанныеАгентаИСоздатьВСправочнике(Данные,Настройки)	
	Для Каждого стр Из Данные Цикл
		ИНН = стр.Значение[0]["attributes"]["agentdata"]["inn"];
		КПП = стр.Значение[0]["attributes"]["agentdata"]["kpp"];
		БИК = стр.Значение[0]["attributes"]["agentdata"]["inn"];
		НаименованиеБанка   = стр.Значение[0]["attributes"]["agentdata"]["bank"];
		НомерСчет           = стр.Значение[0]["attributes"]["agentdata"]["bankingAccount1"];
		КорСчет             = стр.Значение[0]["attributes"]["agentdata"]["bankingAccount2"];
		Наименование        = стр.Значение[0]["attributes"]["agentdata"]["shortName"];
		НаименованиеПолное  = стр.Значение[0]["attributes"]["agentdata"]["fullName"];
		
		
		// Создадим контрагента
		НайденнаяСсылка = Справочники.Контрагенты.НайтиПоРеквизиту("ИНН",ИНН);
		Если НайденнаяСсылка = Справочники.Контрагенты.ПустаяСсылка() Тогда
			НовыйЭлемент = Справочники.Контрагенты.СоздатьЭлемент();
			НовыйЭлемент.Наименование       = Наименование;
			НовыйЭлемент.НаименованиеПолное = НаименованиеПолное;
			НовыйЭлемент.ИНН                = ИНН;
			НовыйЭлемент.КПП                = КПП;
			ЮрФизЛицо = ?(СтрДлина(СокрЛП(НовыйЭлемент.ИНН)) = 12 И ПустаяСтрока(НовыйЭлемент.КПП),
			Перечисления.ЮридическоеФизическоеЛицо.ФизическоеЛицо,
			Перечисления.ЮридическоеФизическоеЛицо.ЮридическоеЛицо);
			НовыйЭлемент.ЮридическоеФизическоеЛицо = ЮрФизЛицо;
			Если НовыйЭлемент.ПолучитьСсылкуНового().Пустая() Тогда
				НовыйЭлемент.УстановитьСсылкуНового(Справочники.Контрагенты.ПолучитьСсылку());
			КонецЕсли;
			НовыйЭлемент.ГоловнойКонтрагент = НовыйЭлемент.ПолучитьСсылкуНового();
			НовыйЭлемент.Записать();
		Иначе
			НовыйЭлемент = НайденнаяСсылка.ПолучитьОбъект();
			НовыйЭлемент.Наименование       = Наименование;
			НовыйЭлемент.НаименованиеПолное = НаименованиеПолное;
			НовыйЭлемент.Записать();
		КонецЕсли;
		
		// Договор
		Попытка
			
			СуществующийДоговор = ПроверитьДоговор(НовыйЭлемент.Ссылка,Настройки.Организация);
			
			Если СуществующийДоговор = Справочники.ДоговорыКонтрагентов.ПустаяСсылка() Тогда
				НайденныйДоговорОбъект = Справочники.ДоговорыКонтрагентов.СоздатьЭлемент();
				НайденныйДоговорОбъект.ВалютаВзаиморасчетов = Константы.ВалютаРегламентированногоУчета.Получить();
				НайденныйДоговорОбъект.Организация          = Настройки.Организация;
				НайденныйДоговорОбъект.Владелец             = НовыйЭлемент.Ссылка;
				
				НайденныйДоговорОбъект.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее;
				
				НайденныйДоговорОбъект.Наименование = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Основной договор (%1)'"), НРег(""));
				НайденныйДоговорОбъект.Записать();
				НайденныйДоговор = НайденныйДоговорОбъект.Ссылка;
				
				ОсновнойДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
				Если НЕ РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(
					ОсновнойДоговорКонтрагента,
					НовыйЭлемент.Ссылка,
					Настройки.Организация) Тогда
					
					РаботаСДоговорамиКонтрагентовБП.УстановитьОсновнойДоговорКонтрагента(НайденныйДоговор);
				КонецЕсли;
			КонецЕсли;
			// СтекОповещений.Добавить(Новый Структура("Ссылка", НайденныйДоговор));
		Исключение
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Парсинг И создание агента","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		КонецПопытки;
		
		// Банковские счета
		НомерСчета = НомерСчет;
		
		СчетКонтрагента = ПроверитьСчетКонтрагента(НовыйЭлемент.Ссылка,НомерСчета);
		Если СчетКонтрагента = Справочники.БанковскиеСчета.ПустаяСсылка() Тогда
			НовыйСчет  = Справочники.БанковскиеСчета.СоздатьЭлемент();
			
			НовыйСчет.НомерСчета = НомерСчета;
			НовыйСчет.Владелец   = НовыйЭлемент.Ссылка;
			НовыйСчет.ВидСчета   = "Расчетный";
			НовыйСчет.ВалютаДенежныхСредств = Константы.ВалютаРегламентированногоУчета.Получить();
			
			
			НовыйБанкКорр = НайтиБанкПоБикИлиКоррСчету(БИК, КорСчет);
			Если НовыйБанкКорр = Справочники.Банки.ПустаяСсылка() Тогда
				НовыйБанкКорр = Справочники.Банки.СоздатьЭлемент();
				НовыйБанкКорр.Наименование = НаименованиеБанка;
				НовыйБанкКорр.Город        = "";
				НовыйБанкКорр.Код          = БИК;
				НовыйБанкКорр.КоррСчет     = КорСчет;
				НовыйБанкКорр.Записать();
			КонецЕсли;
			НовыйСчет.БанкДляРасчетов = НовыйБанкКорр.Ссылка;
			НовыйСчет.Банк = НовыйБанкКорр.Ссылка;
			Если ЗначениеЗаполнено(НовыйСчет.Банк) ИЛИ ЗначениеЗаполнено(НовыйСчет.БанкДляРасчетов) Тогда
				БанкДляНаименования    = ?(ЗначениеЗаполнено(НовыйСчет.Банк), НовыйСчет.Банк, НовыйСчет.БанкДляРасчетов);
				НовыйСчет.Наименование = Лев(НовыйСчет.НомерСчета + ", " + БанкДляНаименования, 100);
				НовыйСчет.Записать();
				
				Если НЕ ЗначениеЗаполнено(НовыйЭлемент.ОсновнойБанковскийСчет) Тогда
					НовыйЭлемент.ОсновнойБанковскийСчет = НовыйСчет.Ссылка;
				КонецЕсли;
				
			КонецЕсли;
		КонецЕсли;
		НовыйЭлемент.Записать();
		Если Не ЗначениеЗаполнено(Настройки.ПлатежныйАгент) Тогда
			Об = Настройки.ПолучитьОбъект();
			Об.Прочитать();
			
			Об.ПлатежныйАгент = НовыйЭлемент.Ссылка;
			об.ВидОплатыОрганизации = Справочники.ВидыОплатОрганизаций.НайтиПоНаименованию("Mobsted");
			Попытка
				Об.Записать();
			Исключение
				
			КонецПопытки;
		КонецЕсли;
		ПолучитьИСоздатьВидОплатыСКомиссиейНаСервере(Настройки);
		Возврат Истина;
	КонецЦикла;	
КонецФункции
Функция ПроверитьДоговор(Контрагент,Организация)
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	ДоговорыКонтрагентов.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ДоговорыКонтрагентов КАК ДоговорыКонтрагентов
	|ГДЕ
	|	ДоговорыКонтрагентов.Владелец = &Владелец
	|	И ДоговорыКонтрагентов.Организация = &Организация
	|	И ДоговорыКонтрагентов.ВидДоговора = &ВидДоговора";
	Запрос.УстановитьПараметр("Владелец",Контрагент);
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("ВидДоговора",Перечисления.ВидыДоговоровКонтрагентов.Прочее);
	РЗ = Запрос.Выполнить();
	ВыборДоговора = РЗ.Выбрать();
	Если ВыборДоговора.Следующий() Тогда
		Возврат ВыборДоговора.Ссылка;
	Иначе
		Возврат Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
	КонецЕсли;
КонецФункции	
Функция ПроверитьСчетКонтрагента(Контрагент,НомерСчета) 
	Запрос = Новый Запрос;
	Запрос.Текст ="ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец
	|	И БанковскиеСчета.НомерСчета = &НомерСчета";
	Запрос.УстановитьПараметр("Владелец",Контрагент);
	Запрос.УстановитьПараметр("НомерСчета",НомерСчета);
	РЗ = Запрос.Выполнить();
	ВыборСчета = РЗ.Выбрать();
	Если ВыборСчета.Следующий() Тогда
		Возврат ВыборСчета.Ссылка;
	Иначе
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;
КонецФункции
Функция НайтиБанкПоБикИлиКоррСчету(БИК, КоррСчет)
	
	НайденныйБанк = Справочники.Банки.ПустаяСсылка();
	
	Если НЕ ПустаяСтрока(БИК) Тогда
		НайденныйБанк = Справочники.Банки.НайтиПоКоду(БИК);
	КонецЕсли;
	
	Если НайденныйБанк = Справочники.Банки.ПустаяСсылка() Тогда
		НайденныйБанк = Справочники.Банки.НайтиПоРеквизиту("КоррСчет", КоррСчет);
	КонецЕсли;
	
	Возврат НайденныйБанк;
	
КонецФункции
Функция ОтправитьТипКомиссииВМЛК(Настройки)
	
	
	ЖурналВремяНачало = ТекущаяДатаСеанса();
	АдресСервисаСтр=Настройки.АдресКабинетов;
	Соединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос        = Новый HTTPЗапрос("/api/v8/auth?login="+СокрЛП(Настройки.Логин)+"&password="+СокрЛП(Настройки.Пароль));
	
	ЖурналЗапросБезКодировки   = Строка(АдресСервисаСтр)+Строка("/api/v8/auth?login="+СокрЛП(Настройки.Логин)+"&password="+СокрЛП(Настройки.Пароль));
	
	
	Результат    = Соединение.Получить(Запрос);
	Если Результат.КодСостояния <> 200 Тогда 
		ИмяСобытияВЖурнал = "Получение ключа для комиссии";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвета = Результат.ПолучитьТелоКакСтроку();;	
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
		Возврат Ложь;	
	КонецЕсли; 
	
	РезультатПроверки    = Результат.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
	ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
	ЧтениеJSON.Закрыть();
	// в теле результата запроса - json
	Ключ = "";
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Значение");
	Для Каждого стр Из ЗагруженныеДанные Цикл
		Если СокрЛП(стр.Ключ)= "access_token" Тогда
			Ключ            = Стр.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		// Журнал
		ИмяСобытияВЖурнал = "Получение ключа для комиссии";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвета = Результат.ПолучитьТелоКакСтроку();;	
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
		Возврат Ложь;	
	Иначе
		// Журнал
		ИмяСобытияВЖурнал = "Получение ключа для комиссии";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвета = Результат.ПолучитьТелоКакСтроку();;	
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
	КонецЕсли;
	
	АдресСервисаСтр = Настройки.АдресКабинетов;
	АдресРесурса1 = "/api/v8/taxtype/"+Настройки.НомерПриложения;
	
	ТипКомиссии = "";
	Если Настройки.Комиссия = Перечисления.МЛК_Комиссия.КомиссияСверху Тогда
		ТипКомиссии = "1";
	Иначе
		ТипКомиссии = "0";
	КонецЕсли;	
	
	СтрокаПараметров     = "taxtype="+Строка(КодироватьСтроку(ТипКомиссии,СпособКодированияСтроки.КодировкаURL));
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаПараметров, КодировкаТекста.UTF8);
	
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");  
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer "+Строка(Ключ));  
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		МЛК_Общий.ЗаписатьДанныеВЖурнал("Отправка типа комиссии","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		Возврат Ложь;
	КонецПопытки;
	
	Если Ответ.КодСостояния = 200 Тогда
		СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		
		Если Не ПустаяСтрока(СтрокаОтвет) Тогда
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СтрокаОтвет);
			ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
			ЧтениеJSON.Закрыть();
			
			Возврат ИстинА;
			
		КонецЕсли;
		Возврат ИстинА;
	Иначе
		Возврат Ложь;
	КонецЕсли;
КонецФункции
Функция ОтправитьДанныеОрганизацииВМЛК(Настройки)
	
	АдресСервисаСтр = Настройки.АдресКабинетов;
	Соединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос        = Новый HTTPЗапрос("/api/v8/auth?login="+СокрЛП(Настройки.Логин)+"&password="+СокрЛП(Настройки.Пароль));
	ЖурналВремяНачало = ТекущаяДатаСеанса();
	ЖурналЗапросБезКодировки   = Строка(АдресСервисаСтр)+Строка("/api/v8/auth?login="+СокрЛП(Настройки.Логин)+"&password="+СокрЛП(Настройки.Пароль));
	Результат    = Соединение.Получить(Запрос);
	Если Результат.КодСостояния <> 200 Тогда 
		ИмяСобытияВЖурнал = "Получение ключа для отправки данных в МЛК";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвета = Результат.ПолучитьТелоКакСтроку();;	
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
		Возврат Ложь;	
	КонецЕсли; 
	
	РезультатПроверки    = Результат.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
	ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
	ЧтениеJSON.Закрыть();
