&НаКлиенте
Процедура ПриОткрытии(Отказ)
	Ответ = ПриОткрытииНаСервере();
	
	Если Ответ Тогда
		Отказ=истина;
	Иначе
		Если ПроверитьДату() Тогда
			ТабДок = ВыполнитьНаСервере();
		Иначе	
			Отказ=истина;
		КонецЕсли;	
	КонецЕсли;	
КонецПроцедуры

Функция ПроверитьДату()
	Если Не ЗначениеЗаполнено(Константы.МЛК_ДатаСледующегоПоказа.Получить()) Тогда
		Возврат Истина;
	Иначе
		Если НачалоДня(ТекущаяДата())>=НачалоДня(Константы.МЛК_ДатаСледующегоПоказа.Получить()) Тогда
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	КонецЕсли;
КонецФункции	

Функция ВыполнитьНаСервере()
	
	ТД = ВебСодержимое;
	Обработка = РеквизитФормыВЗначение("Объект");
	Макет = Обработка.получитьМакет("Макет");
	Область = Макет.ПолучитьОбласть("Картинка");
	ТД.Вывести(Область);
	ТД.ТолькоПросмотр = Истина;
	Возврат ТД;
	
КонецФункции	

