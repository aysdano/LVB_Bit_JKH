&НаКлиенте
Процедура ЗаполнитьНастройкиПечатиАдресаПоУмолчанию(Команда)
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("НеПечататьУлица"                    , Ложь);
	ПараметрыЖКХ.Вставить("НеПечататьДом"                      , Ложь);
	ПараметрыЖКХ.Вставить("НеПечататьКорпус"                   , Ложь);
	ПараметрыЖКХ.Вставить("НеПечататьКвартира"                 , Ложь);
	ПараметрыЖКХ.Вставить("НеПечататьРайон"                    , Истина);
	ПараметрыЖКХ.Вставить("ПрефиксУлица"                       , "ул.");
	ПараметрыЖКХ.Вставить("ПрефиксДом"                         , "д.");
	ПараметрыЖКХ.Вставить("ПрефиксКорпус"                      , "корп.");
	ПараметрыЖКХ.Вставить("ПрефиксКвартира"                    , "кв.");
	ПараметрыЖКХ.Вставить("ПрефиксРайон"                       , "");
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(Объект.Период, Объект.Организация, ПараметрыЖКХ);
	
	Объект.НеПечататьУлицу                     = ПараметрыЖКХ.НеПечататьУлица;
	Объект.НеПечататьДом                       = ПараметрыЖКХ.НеПечататьДом;
	Объект.НеПечататьКорпус                    = ПараметрыЖКХ.НеПечататьКорпус;
	Объект.НеПечататьКвартиру                  = ПараметрыЖКХ.НеПечататьКвартира;
	Объект.НеПечататьРайон                     = ПараметрыЖКХ.НеПечататьРайон;
	Объект.ПрефиксУлица                        = ПараметрыЖКХ.ПрефиксУлица;
	Объект.ПрефиксДом                          = ПараметрыЖКХ.ПрефиксДом;
	Объект.ПрефиксКорпус                       = ПараметрыЖКХ.ПрефиксКорпус;
	Объект.ПрефиксКвартира                     = ПараметрыЖКХ.ПрефиксКвартира;
	Объект.ПрефиксРайон                        = ПараметрыЖКХ.ПрефиксРайон;
	
КонецПроцедуры

