//
Процедура Печать(ИмяМакета, КоличествоЭкземпляров = 1, НаПринтер = Ложь, НепосредственнаяПечать = Ложь) Экспорт
	
	Печать = Ложь;	
	
КонецПроцедуры

#КонецЕсли

#КонецОбласти

#Область ОбеспечениеПроведенияДокумента

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	// Проверим правильность заполнения шапки документа.
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ЛицевойСчет"              ,"ЛицевойСчет");
	СтруктураПолей.Вставить("ОтветственноеЛицо"    	   ,"ОтветственноеЛицо");
	СтруктураПолей.Вставить("Сумма"    		           ,"Сумма");
	СтруктураПолей.Вставить("СуммаБезПереплат"         ,"СуммаБезПереплат");
	СтруктураПолей.Вставить("СуммаПени" 				,"СуммаПени");
	
	РезультатЗапросаПоЛС = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "ЛицевыеСчета", СтруктураПолей);
	ТаблицаПоЛС          = РезультатЗапросаПоЛС.Выгрузить();
	
	ПроверитьДублиЛС(ТаблицаПоЛС, Отказ, Заголовок);
	
	Если НЕ Отказ Тогда
		
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоЛС, Отказ, Заголовок);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьДублиЛС(ТаблицаПоЛС, Отказ, Заголовок) 
	
	ТаблицаДублей = ТаблицаПоЛС.Скопировать();
	
	// Подсчитываем количество повторений.
	ТаблицаДублей.Колонки.Добавить("КоличествоПовторений");
	ТаблицаДублей.ЗаполнитьЗначения(1, "КоличествоПовторений");
	
	ТаблицаДублей.Свернуть("ЛицевойСчет", "КоличествоПовторений");
	
	// Если количество повторений > 1, выдаем сообщение об ошибке.
	Если ?(ТаблицаДублей.Количество() > 0, ТаблицаДублей.Итог("КоличествоПовторений") / ТаблицаДублей.Количество(), 0) > 1 Тогда
		
		ТекстСообщенияОбОшибке = "";
		
		// Цикл по каждому найденному повторению.
		Для Каждого СтрокаТаблицыДублей Из ТаблицаДублей Цикл
			
			Если СтрокаТаблицыДублей.КоличествоПовторений = 1 Тогда
				Продолжить; // повторений нет.
			КонецЕсли;
			
			// Добавим перевод строки, если требуется.
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке 
			+ ?(НЕ ЗначениеЗаполнено(ТекстСообщенияОбОшибке), "", "
			|");
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке
			+ "В строках №№ "; 
			
			// Выводим номера строк.
			СписокНомеровСтрок = "";
			
			МассивСтрок = ТаблицаПоЛС.НайтиСтроки(Новый Структура("ЛицевойСчет", СтрокаТаблицыДублей.ЛицевойСчет));
			
			Для Каждого Строка Из МассивСтрок Цикл
				СписокНомеровСтрок = СписокНомеровСтрок + ?(НЕ ЗначениеЗаполнено(СписокНомеровСтрок), "", ", ") + Строка.НомерСтроки;
			КонецЦикла;
			
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке
			+ СписокНомеровСтрок
			+ " табличной части ""ЛицевойСчет"" указан один и тот же.";
			
		КонецЦикла;
		
		бит_ОбщегоНазначения.ОшибкаПриПроведении(ТекстСообщенияОбОшибке, Отказ, Заголовок);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок)
	
	// Укажем, что надо проверить:
	ОбязательныеРеквизитыШапки = "Организация";
	
	СтруктураОбязательныхПолей = Новый Структура(ОбязательныеРеквизитыШапки);
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры

Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоЛС, Отказ, Заголовок)
	
	Для Каждого СтрокаТЧ Из ТаблицаПоЛС Цикл
		Движение = Движения.бит_ПредупрежденияЖильцам.Добавить();
		Движение.Период 			= Дата;
		Движение.ЛицевойСчет 		= СтрокаТЧ.ЛицевойСчет;
		
		Движение.ОтветственноеЛицо 	= СтрокаТЧ.ОтветственноеЛицо;
		
		Если НЕ мВыводитьСуммуБезУчетаПереплатПоУслугам Тогда
			Сумма = СтрокаТЧ.Сумма;
		Иначе
			Сумма = СтрокаТЧ.СуммаБезПереплат;
		КонецЕсли;
		Если мВключатьВРасчетСуммыДолгаПени Тогда
			Сумма = Сумма + СтрокаТЧ.СуммаПени;
		КонецЕсли;
		
		Движение.СуммаПредупреждения	= Сумма;
		Движение.МоментРасчета 			= СтруктураШапкиДокумента.МоментРасчета;
		Движение.ДатаРасчета 			= СтруктураШапкиДокумента.ДатаРасчета;
	КонецЦикла;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТЗСписокЛС = ЛицевыеСчета.Выгрузить(,"ЛицевойСчет");
	
	ТЗСписокЛС.Свернуть("ЛицевойСчет");
	
	СписокЛицевыхСчетов = "";
	
	Для каждого Строка Из ТЗСписокЛС Цикл
		
		Если ПустаяСтрока(Строка.ЛицевойСчет.Наименование) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если СписокЛицевыхСчетов = "" Тогда
			СписокЛицевыхСчетов = ""+Строка.ЛицевойСчет.Наименование;
		Иначе
			СписокЛицевыхСчетов = ""+СписокЛицевыхСчетов +", " +Строка.ЛицевойСчет.Наименование;
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	МоментРасчета = НачалоМесяца(ТекущаяДата());
	
КонецПроцедуры

#КонецОбласти

#Область ОператорыОсновнойПрограммы

мВыводитьСуммуБезУчетаПереплатПоУслугам = Ложь;
мВключатьВРасчетСуммыДолгаПени          = Ложь;

#КонецОбласти