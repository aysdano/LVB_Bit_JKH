//Печать сопроводительного письма
Функция НапечататьСопроводительноеПисьмо(МассивСсылок)
	МассивСоответствий = Новый Соответствие;  
	Статусы = Новый Массив();
	Статусы.Добавить(Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВБанк); 
	Статусы.Добавить(Перечисления.СтатусыПоИсполнительнымЛистам.ПовторноНаправленВБанк); 
	Статусы.Добавить(Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВОСП); 
	Статусы.Добавить(Перечисления.СтатусыПоИсполнительнымЛистам.ПовторноНаправленВОСП); 

	Если МассивСсылок.Количество() = 1 Тогда   
		ПолучитьСсылкиНаДокументыПоОднойСсылке(МассивСоответствий, МассивСсылок, Статусы);
	Иначе         
		ПолучитьСсылкиНаДокументыПоСписку(МассивСоответствий, МассивСсылок);
	КонецЕсли;
	
	ОфисныеДокументы = Новый Соответствие;
	МакетДокумента = ПолучитьМакет("ПФ_DOCX_Сопроводительное");
	Шаблон = НСтр("ru = 'Сопровод. письмо по заявлению исп.лист №[Номер] от [Дата]'");
	
	Индекс = 1;
	Для Каждого ИсполнительныйЛист из МассивСоответствий Цикл
		Макет = УправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(МакетДокумента, Неопределено);
		
		Если Макет = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		Если ИсполнительныйЛист.Значение.Количество() = 0 Тогда  
			Продолжить;
		КонецЕсли;
		
		ОписаниеОбластей = Новый Структура;
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Шапка",         		   "Общая");
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "СтрокаТаблицы",           "СтрокаТаблицы");
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "СчетКапРемонт",           "Общая");
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Счет",           		   "Общая");
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Подвал",         		   "Общая");
		
		ДанныеДляПечати = ПолучитьДанныеДляПечати(ИсполнительныйЛист.Значение,"ПФ_DOCX_Сопроводительное");
		
		ТЧДолжники = ДанныеДляПечати.ТЧДолжники;
		Статус = ДанныеДляПечати.Статус;
		Услуга = ДанныеДляПечати.Услуга;
		ДатаДокумента = ДанныеДляПечати.ДатаДокумента;
		
		//КоличествоЛистов = 0;       
		Текномер  = "";
		//Для Каждого  Стр Из  ИсполнительныйЛист.Значение Цикл      
		//	Если Текномер <> Стр.НомерИсполнительногоЛиста Тогда
		//		КоличествоЛистов = КоличествоЛистов + 1;   
		//		Текномер = Стр.НомерИсполнительногоЛиста;
		//	КонецЕсли;
		//КонецЦикла;
		
		ДанныеПоШапке = Новый Структура("ТекущийГод,Кому,КомуАдрес,КоличествоЛистов");
		ДанныеПоШапке.Вставить("ТекущийГод",Формат(ТекущаяДата(),"ДФ = гггг"));
		//ДанныеПоШапке.Вставить("КоличествоЛистов", ТЧДолжники.Количество());
		УслугаКапРемонт = КапитальныйРемонт(Услуга.Наименование);
		Если СтрНайти(нрег(Статус),"банк")>0 И НЕ УслугаКапРемонт Тогда     
			ДанныеПоШапке.Вставить("Кому","Омское отделение № 8634 ПАО «Сбербанк»");
			ДанныеПоШапке.Вставить("КомуАдрес","644 024, г. Омск, ул. Жукова, 4/1");
		ИначеЕсли СтрНайти(нрег(Статус),"банк")>0 И  УслугаКапРемонт Тогда     
			ДанныеПоШапке.Вставить("Кому",ДанныеДляПечати.БанковскиеРеквизиты.НаименованиеБанка);
			ДанныеПоШапке.Вставить("КомуАдрес",ДанныеДляПечати.БанковскиеРеквизиты.АдресБанка);
		ИначеЕсли СтрНайти(нрег(Статус),"в осп")>0 Тогда
			ДанныеПоШапке.Вставить("Кому","Начальнику ОСП_АО г. Омска");
			ДанныеПоШапке.Вставить("КомуАдрес","УФССП по Омской области");
		КонецЕсли;
		Если УслугаКапРемонт Тогда
			ДанныеПоШапке.Вставить("ШапкаКапРемонт"," (по капитальному ремонту)");
		Иначе
			ДанныеПоШапке.Вставить("ШапкаКапРемонт","");
		КонецЕсли;
		ПечатнаяФорма = УправлениеПечатью.ИнициализироватьПечатнуюФорму(Неопределено, Неопределено, Макет);
		Если ПечатнаяФорма = Неопределено Тогда
			УправлениеПечатью.ОчиститьСсылки(Макет);
			Возврат ОфисныеДокументы;
		КонецЕсли;
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["Шапка"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма,Область,ДанныеПоШапке);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["СтрокаТаблицы"]);
		УправлениеПечатью.ПрисоединитьИЗаполнитьКоллекцию(ПечатнаяФорма, Область, ТЧДолжники);
		
		Если УслугаКапРемонт Тогда
			Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["СчетКапРемонт"]);
			УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма,Область,ДанныеДляПечати.БанковскиеРеквизиты);
		Иначе
			Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["Счет"]);
			УправлениеПечатью.ПрисоединитьОбласть(ПечатнаяФорма, Область);
		КонецЕсли;
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["Подвал"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма,Область,Подписант(ДатаДокумента));
		
		АдресХранилищаПечатнойФормы = УправлениеПечатью.СформироватьДокумент(ПечатнаяФорма);
		УправлениеПечатью.ОчиститьСсылки(ПечатнаяФорма);
		
		ИмяДокумента = "Сопроводительное письмо по исполнительным листам " + Индекс +" от " + Строка(Формат(ТекущаяДата(),"ДФ = дд.мм.гг")) + ".docx"; 
		ОфисныеДокументы.Вставить(АдресХранилищаПечатнойФормы, ИмяДокумента);
		
		УправлениеПечатью.ОчиститьСсылки(Макет);    
		Индекс = Индекс + 1;

	КонецЦикла;
	
	Возврат ОфисныеДокументы;
	
КонецФункции 

Функция ПолучитьДанныеДляПечати(МассивСсылок,ИмяМакета)
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса();
	Запрос.УстановитьПараметр("МассивСсылок", МассивСсылок);
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	//Заводим переменные для разбора результата
	ТЧДолжники = Новый Массив();
	БанковскиеРеквизиты = Новый Структура(
	"РасчетныйСчет,НаименованиеБанка,БИКБанка,КоррСчет,ИННБанка,ОКПОБанка,КППБанка,ОГРНБанка,АдресБанка");
	Статус = "";
	Услуга = "";
	ДатаДокумента = "";
	ГосПошлина = 0;
	ДатаВыдачиПриказа = "";
	ДатаВступВСилу = "";
	
	Индекс = 0;
	ВспомИндекс = 0;
	ТекущийЛицевой = Неопределено;  
	ТекущийНомерДокумента = "";
	СуммаГоспошлины = 0;   
	МассивСтрок = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Если Индекс = 0 Тогда
			БанковскиеРеквизиты.РасчетныйСчет = Выборка.РасчетныйСчет;
			БанковскиеРеквизиты.НаименованиеБанка = Выборка.НаименованиеБанка;
			БанковскиеРеквизиты.БИКБанка = Выборка.БИК;
			БанковскиеРеквизиты.КоррСчет = Выборка.КоррСчет;
			БанковскиеРеквизиты.ИННБанка = Выборка.ИННБанка;
			БанковскиеРеквизиты.ОКПОБанка = Выборка.ОКПОБанка;
			БанковскиеРеквизиты.КППБанка = Выборка.КППБанка;
			БанковскиеРеквизиты.ОГРНБанка = Выборка.ОГРНБанка;
			БанковскиеРеквизиты.АдресБанка = Выборка.АдресБанка;
			
			Статус = Выборка.Статус;
			Услуга = Выборка.Услуга;
			ДатаДокумента = Формат(Выборка.ДатаДокумента,"ДФ = дд.ММ.гггг");
			ГосПошлина = Выборка.ГосПошлина;
		КонецЕсли; 
		ДатаВыдачиПриказа = Формат(Выборка.ДатаВыдачиПриказа,"ДФ = дд.ММ.гггг");
		ДатаВступВСилу = Формат(Выборка.ДатаВступВСилу,"ДФ = дд.ММ.гггг");
		АдресДолжника = Строка(Выборка.Здание) + ", " + Выборка.Квартира;
		//Заполняем основного должника из документа
		Если  ЗначениеЗаполнено(Выборка.ФИОДолжника) Тогда  
			ВспомИндекс = 1;   
			Индекс = Индекс + 1;

			СуммаЗадолженностиДляВывода = ?(Выборка.СуммаЗадолженности = 0, "Опл",Выборка.СуммаЗадолженности);
			ТЧДолжники.Добавить(Новый Структура("ФИОДолжника,АдресДолжника,СуммаЗадолженности,ПредставРасходы,ГосПошлина,НомерДокумента,ДатаВыдачиПриказа,ДатаВступВСилу,Ном",
			Выборка.ФИОДолжника,АдресДолжника,СуммаЗадолженностиДляВывода,
			Выборка.ПредставРасходы,Выборка.ГосПошлина,Выборка.НомерДокумента,ДатаВыдачиПриказа,ДатаВступВСилу,Строка(Индекс)));   
			СуммаГоспошлины = Выборка.ГосПошлина; 
			МассивСтрок.Добавить(ТЧДолжники[ТЧДолжники.Количество()-1]);
		КонецЕсли;

		
		
		ТЗДолжники = Выборка.Ответчики.Выгрузить(); 
		Для Каждого Должник ИЗ ТЗДолжники Цикл
			Если Должник.ФизЛицо <> Выборка.ФИОДолжника И ЗначениеЗаполнено(Должник.ФизЛицо) Тогда     
				Индекс = Индекс + 1;
				ВспомИндекс = ВспомИндекс + 1;
				СуммаЗадолженностиДляВывода = ?(Выборка.СуммаЗадолженности = 0, "Опл",Выборка.СуммаЗадолженности);
				ТЧДолжники.Добавить(Новый Структура("ФИОДолжника,ЛицевойСчет,АдресДолжника,СуммаЗадолженности,ПредставРасходы,ГосПошлина,НомерДокумента,ДатаВыдачиПриказа,ДатаВступВСилу,Ном",
				Должник.ФизЛицо,Выборка.ЛицевойСчет,АдресДолжника,СуммаЗадолженностиДляВывода,Выборка.ПредставРасходы,Выборка.ГосПошлина,
				Выборка.НомерДокумента,ДатаВыдачиПриказа,ДатаВступВСилу,Строка(Индекс)));
				СуммаГоспошлины = Выборка.ГосПошлина; 
				МассивСтрок.Добавить(ТЧДолжники[ТЧДолжники.Количество()-1]);
			КонецЕсли;
		КонецЦикла;
		Если НЕ ТекущийЛицевой = Выборка.ЛицевойСчет ИЛИ ТекущийЛицевой = Неопределено
			ИЛИ Выборка.НомерДокумента <> ТекущийНомерДокумента Тогда  
 
			Если МассивСтрок.Количество()>1 Тогда       
				ГосПошлина = Окр((СуммаГоспошлины / МассивСтрок.Количество()),2);
				Сч = 1;
				Для Каждого СтрокаПоЛС ИЗ МассивСтрок Цикл   
					//Если Сч = 1 Тогда
						СтрокаПоЛС.СуммаЗадолженности = Строка(СтрокаПоЛС.СуммаЗадолженности) + " солидарно";   
						СтрокаПоЛС.ПредставРасходы = Строка(СтрокаПоЛС.ПредставРасходы) + " солидарно";
					//Иначе
						//СтрокаПоЛС.АдресДолжника = "";
						//СтрокаПоЛС.НомерДокумента = "";
						//СтрокаПоЛС.СуммаЗадолженности = "";
						//СтрокаПоЛС.ПредставРасходы = "";  
						//СтрокаПоЛС.ДатаВыдачиПриказа ="";
					//КонецЕсли ;
					СтрокаПоЛС.ГосПошлина = ГосПошлина; 
					Сч = Сч + 1;
				КонецЦикла;
				МассивСтрок = Новый Массив;
				ТекущийЛицевой =  Выборка.ЛицевойСчет;        
				ТекущийНомерДокумента = Выборка.НомерДокумента;
				СуммаГоспошлины = 0;
			Иначе  
				МассивСтрок = Новый Массив;
				ТекущийЛицевой =  Выборка.ЛицевойСчет;     
				СуммаГоспошлины = 0;  
			КонецЕсли; 
		КонецЕсли;   
		Если ТекущийЛицевой = Неопределено Тогда    
			ТекущийЛицевой = Выборка.ЛицевойСчет;
		КонецЕсли;
		
	КонецЦикла;
	//ТЧДолжники.Сортировать("");
	//Если ВспомИндекс > 1 Тогда
	//	ГосПошлина = Окр((ГосПошлина / ТЧДолжники.Количество()),2);
	//	Для Счетчик = (ТЧДолжники.Количество()- ВспомИндекс)  по (ТЧДолжники.Количество()-1) Цикл
	//		Если Счетчик = (ТЧДолжники.Количество()- ВспомИндекс) ИЛИ ИмяМакета = "ПФ_DOCX_Сопроводительное" Тогда 
	//			ТЧДолжники[Счетчик].СуммаЗадолженности = Строка(ТЧДолжники[Счетчик].СуммаЗадолженности) + " солидарно";
	//			ТЧДолжники[Счетчик].ПредставРасходы = Строка(ТЧДолжники[Счетчик].ПредставРасходы) + " солидарно";
	//		Иначе
	//			ТЧДолжники[Счетчик].АдресДолжника = "";
	//			ТЧДолжники[Счетчик].НомерДокумента = "";
	//			ТЧДолжники[Счетчик].СуммаЗадолженности = "";
	//			ТЧДолжники[Счетчик].ПредставРасходы = "";
	//		КонецЕсли;
	//		ТЧДолжники[Счетчик].ГосПошлина = ГосПошлина;
	//	КонецЦикла;
	//КонецЕсли;
	
	ДанныеПечати = Новый Структура("Статус,Услуга,ТЧДолжники,ДатаДокумента,БанковскиеРеквизиты,ДатаВыдачиПриказа,ДатаВступВСилу",
	Статус,Услуга,ТЧДолжники,ДатаДокумента,БанковскиеРеквизиты,ДатаВыдачиПриказа,ДатаВступВСилу);
	Возврат ДанныеПечати;
	
КонецФункции

Функция ТекстЗапроса()
	Возврат "ВЫБРАТЬ
	        |	Банки.Наименование КАК НаименованиеБанка,
	        |	Банки.ИННБанка КАК ИННБанка,
	        |	Банки.ОКПОБанка КАК ОКПОБанка,
	        |	Банки.КППБанка КАК КППБанка,
	        |	Банки.ОГРНБанка КАК ОГРНБанка,
	        |	Банки.Адрес КАК АдресБанка,
	        |	лб_Тест_Дома.KR_RS КАК РасчетныйСчет,
	        |	бит_ИсполнительныйЛист.ФИОДолжника КАК ФИОДолжника,
	        |	бит_ИсполнительныйЛист.Адрес КАК АдресДолжника,
	        |	бит_ИсполнительныйЛист.СуммаДолгаПоУслугеПоРешениюСуда КАК СуммаЗадолженности,
	        |	Банки.Код КАК БИК,
	        |	бит_ИсполнительныйЛист.Дата КАК ДатаДокумента,
	        |	бит_ИсполнительныйЛист.ДатаИсполнительногоЛиста КАК ДатаИсполнительногоЛиста,
	        |	бит_ИсполнительныйЛист.ДатаВынесенияРешенияСуда КАК ДатаВыдачиПриказа,
	        |	бит_ИсполнительныйЛист.ДатаВступленияВЗаконнуюСилу КАК ДатаВступВСилу,
	        |	бит_ИсполнительныйЛист.НомерИсполнительногоЛиста КАК НомерДокумента,
	        |	бит_ИсполнительныйЛист.Статус КАК Статус,
	        |	бит_ИсполнительныйЛист.ЛицевойСчет КАК ЛицевойСчет,
	        |	бит_ИсполнительныйЛист.СуммаГоспошлиныПоРешениюСуда КАК ГосПошлина,
	        |	бит_ИсполнительныйЛист.СуммаПредставительскихРасходовПоРешениюСуда КАК ПредставРасходы,
	        |	бит_ИсполнительныйЛист.Услуга КАК Услуга,
	        |	бит_ИсполнительныйЛист.Ответчики.(
	        |		ФизЛицо КАК ФизЛицо
	        |	) КАК Ответчики,
	        |	Банки.КоррСчет КАК КоррСчет,
	        |	бит_ИсполнительныйЛист.ЛицевойСчет.Здание КАК Здание,
	        |	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК Квартира
	        |ИЗ
	        |	Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
	        |			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	        |				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
	        |				ПО БанковскиеСчета.Банк = Банки.Ссылка
	        |			ПО лб_Тест_Дома.ЛицевойСчетКР = БанковскиеСчета.Ссылка
	        |		ПО бит_ИсполнительныйЛист.ЛицевойСчет.Здание = лб_Тест_Дома.Здание
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
	        |		ПО бит_ИсполнительныйЛист.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	        |ГДЕ
	        |	бит_ИсполнительныйЛист.Ссылка В(&МассивСсылок)";
КонецФункции

//Проверяет относится ли услуга к капитальному ремонту
//НаименованиеУслуги - строка, наименование услуги
//Возвращает - ИСТИНА, если услуга относится к кап.ремонту
Функция КапитальныйРемонт(НаименованиеУслуги)
	Возврат СтрНайти(НРег(НаименованиеУслуги),"кап") > 0;
КонецФункции 

//Возвращает структуру содержащую Фамилию и инициалы подписанта, - из регистра сведений бит_ПодписантыПоИсполнительнымЛистам
//Мобильный и рабочий телефоны - из Контактной информации физического лица
//на дату ДатаДокумента
Функция Подписант(ДатаДокумента)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_Подписанты.ФИО КАК Подписант
	|ПОМЕСТИТЬ ВТ_Подписант
	|ИЗ
	|	РегистрСведений.бит_ПодписантыПоИсполнительнымЛистам.СрезПоследних(&Период, ) КАК бит_Подписанты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФизическиеЛицаКонтактнаяИнформация.Вид КАК Вид,
	|	ФизическиеЛицаКонтактнаяИнформация.Представление КАК МобильныйТелефон,
	|	ВТ_Подписант.Подписант КАК Подписант
	|ПОМЕСТИТЬ ВТ_Мобильный
	|ИЗ
	|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Подписант КАК ВТ_Подписант
	|		ПО ФизическиеЛицаКонтактнаяИнформация.Ссылка = ВТ_Подписант.Подписант
	|ГДЕ
	|	ФизическиеЛицаКонтактнаяИнформация.Вид = &Мобильный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ФизическиеЛицаКонтактнаяИнформация.Вид КАК Вид,
	|	ФизическиеЛицаКонтактнаяИнформация.Представление КАК РабочийТелефон,
	|	ВТ_Подписант.Подписант КАК Подписант
	|ПОМЕСТИТЬ ВТ_Рабочий
	|ИЗ
	|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Подписант КАК ВТ_Подписант
	|		ПО ФизическиеЛицаКонтактнаяИнформация.Ссылка = ВТ_Подписант.Подписант
	|ГДЕ
	|	ФизическиеЛицаКонтактнаяИнформация.Вид = &Рабочий
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Подписант.Подписант КАК Подписант,
	|	ВТ_Мобильный.МобильныйТелефон КАК МобильныйТелефон,
	|	ВТ_Рабочий.РабочийТелефон КАК РабочийТелефон
	|ИЗ
	|	ВТ_Подписант КАК ВТ_Подписант
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Мобильный КАК ВТ_Мобильный
	|		ПО ВТ_Подписант.Подписант = ВТ_Мобильный.Подписант
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Рабочий КАК ВТ_Рабочий
	|		ПО ВТ_Подписант.Подписант = ВТ_Рабочий.Подписант";
	
	Запрос.УстановитьПараметр("Мобильный", Справочники.ВидыКонтактнойИнформации.ТелефонМобильныйФизическиеЛица);
	Запрос.УстановитьПараметр("Рабочий", Справочники.ВидыКонтактнойИнформации.ТелефонРабочийФизическиеЛица);
	Запрос.УстановитьПараметр("Период", ТекущаяДата());
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Подписант = Выборка.Подписант;
		ТелефонДляБанка = Выборка.МобильныйТелефон;
		ТелефонДляДолжников = Выборка.РабочийТелефон;
	КонецЕсли;
	Если ЗначениеЗаполнено(Подписант) Тогда
		Подписант = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Подписант.ФИО);
	Иначе
		Подписант = ""
	КонецЕсли;
	//Подписант = ФамилияИнициалы(Подписант);
	Результат = Новый Структура("Подписант,ТелефонДляБанка,ТелефонДляДолжников", Подписант,ТелефонДляБанка,ТелефонДляДолжников);
	Возврат Результат;
КонецФункции

//Возвращает дату установки последнего статуса Исполнительного листа
Функция ПолучитьДатуСтатуса(Ссылка, Статус)
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СтатусыПоИсполнительнымЛистамСрезПоследних.ИсполнительныйЛист КАК Регистратор,
	|	СтатусыПоИсполнительнымЛистамСрезПоследних.СтатусДокумента КАК СтатусДокумента,
	|	СтатусыПоИсполнительнымЛистамСрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.СтатусыПоИсполнительнымЛистам.СрезПоследних(, ИсполнительныйЛист = &Ссылка И СтатусДокумента = &Статус) КАК СтатусыПоИсполнительнымЛистамСрезПоследних";
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Запрос.УстановитьПараметр("Статус",Статус);
	
	Результат = Запрос.Выполнить().Выбрать();
	Если Результат.Следующий() Тогда
		Возврат Результат.Период;
	КонецЕсли;
КонецФункции

Функция ФамилияИнициалы(ФизЛицо)
	ФамилияИнициалы = ФизЛицо.Фамилия + " " + Лев(ФизЛицо.Имя, 1) + ". " + Лев(ФизЛицо.Отчество, 1) + ".";
	Возврат ФамилияИнициалы;
КонецФункции


