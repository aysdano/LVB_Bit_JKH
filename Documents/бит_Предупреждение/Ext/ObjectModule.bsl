	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("ВыводитьСуммуБезУчетаПереплатПоУслугам", Ложь);
	ПараметрыЖКХ.Вставить("ВключатьВРасчетСуммыДолгаПени"         , Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(Дата, Организация, ПараметрыЖКХ);
	
	мВыводитьСуммуБезУчетаПереплатПоУслугам = ПараметрыЖКХ.ВыводитьСуммуБезУчетаПереплатПоУслугам;
	мВключатьВРасчетСуммыДолгаПени          = ПараметрыЖКХ.ВключатьВРасчетСуммыДолгаПени;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

#Если Клиент Тогда
	
// Производит замену строк в указанном табличном документе.
//
// Возвращаемое значение:
//  Булево – была ли произведена замена.
//
Функция НайтиИЗаменитьВДокументе(ТабДок, СтрокаПоиска, СтрокаЗамены)
	
	ОбластьЗамены = ТабДок.НайтиТекст(СтрокаПоиска);
	Если ОбластьЗамены = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ОбластьЗамены.Текст = СтрЗаменить(ОбластьЗамены.Текст, СтрокаПоиска, СтрокаЗамены);
	Возврат Истина;
	
КонецФункции
	
// Функция формирует табличный документ с печатной формой сличительной ведомости
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьПредупреждения() Экспорт
	
	// Получить параметры настройки.
	
	ОбновитьНастройкиЖКХ();
	
	Макет = ПолучитьМакет("Предупреждение");
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "МакетПредупреждения";
	ШапкаОбласть  = Макет.ПолучитьОбласть("ОбластьШапка");

	
	Данные = Новый Структура("СтруктурнаяЕдиница, ОтветственноеЛицо", Организация, Перечисления.ОтветственныеЛицаОрганизаций.Руководитель);
	Руководители = РегистрыСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(Дата, Данные);
	
	СтруктураПечати = Новый Структура();
	СтруктураПечати.Вставить("Организация",Организация.Наименование);
	СтруктураПечати.Вставить("ФИОРуководителя",Руководители.Руководитель);
	СтруктураПечати.Вставить("ДолжностьРуководителя",Руководители.РуководительДолжность);
	СтруктураПечати.Вставить("СрокПогашения",Формат(СрокПогашения, "ДФ='dd MMMM yyyy ""г.""'"));
	Если ЗначениеЗаполнено(ДатаРасчета) Тогда
		ДатаПросмотра = ДатаРасчета;
	Иначе	
		ДатаПросмотра = Дата;             
	КонецЕсли; 
	СтруктураПечати.Вставить("ДатаПросмотра",Формат(ДатаПросмотра, "ДФ='dd MMMM yyyy ""г.""'"));
	
	ФормСтрока = "Л = ru_RU; ДП = Истина";
	ПарПредмета="рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
	
	Для каждого Строка ИЗ ЛицевыеСчета Цикл
		
		СтруктураПечати.Вставить("ФИО",   Строка.ОтветственноеЛицо);
		СтруктураПечати.Вставить("Адрес", Строка.ЛицевойСчет.Здание.ПочтовыйАдрес + ?(ЗначениеЗаполнено(Строка.ЛицевойСчет.Квартира),", кв. " + Строка(Строка.ЛицевойСчет.Квартира),""));
		// Расчет суммы долга с учетом настроек.
		Если НЕ мВыводитьСуммуБезУчетаПереплатПоУслугам Тогда
			Сумма = Строка.Сумма;
		Иначе
			Сумма = Строка.СуммаБезПереплат;
		КонецЕсли;
		Если мВключатьВРасчетСуммыДолгаПени Тогда
			Сумма = Сумма + Строка.СуммаПени;
		КонецЕсли;
		
		СуммаПрописью = ЧислоПрописью(Сумма,ФормСтрока, ПарПредмета);
		
		СтруктураПечати.Вставить("Сумма", Сумма);
		СтруктураПечати.Вставить("СуммаПрописью", СуммаПрописью);
		
		ШапкаОбласть  = Макет.ПолучитьОбласть("ОбластьШапка");
		ШапкаОбласть.Параметры.Заполнить(СтруктураПечати);
		Для Каждого ТекПараметр Из СтруктураПечати Цикл
			Пока НайтиИЗаменитьВДокументе(ШапкаОбласть, "[" + ТекПараметр.Ключ + "]", ТекПараметр.Значение) Цикл
			КонецЦикла;
		КонецЦикла;
		
		СтрокаПредупреждения = Новый Массив;
		СтрокаПредупреждения.Добавить(ШапкаОбласть);
		
		Если Не ОбщегоНазначенияБПВызовСервера.ПроверитьВыводТабличногоДокумента(ТабДокумент, СтрокаПредупреждения) Тогда
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
		ТабДокумент.Вывести(ШапкаОбласть);
	КонецЦикла;
	
	ТабДокумент.ОбластьПечати = ТабДокумент.Область(1, 2, ТабДокумент.ВысотаТаблицы, ТабДокумент.ШиринаТаблицы);
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.ПолеСверху = 0;
	ТабДокумент.ПолеСлева  = 0;
	ТабДокумент.ПолеСнизу  = 0;
	ТабДокумент.ПолеСправа = 0;
	
	Возврат ТабДокумент;
	
КонецФункции

