&НаСервере
Процедура ФормироватьСчетНаОплату(ДокументСсылка)
	
	ДокСчет = Документы.СчетНаОплатуПокупателю.ПустаяСсылка();
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СчетНаОплатуПокупателю.Ссылка,
	|	СчетНаОплатуПокупателю.ПометкаУдаления
	|ИЗ
	|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
	|ГДЕ
	|	СчетНаОплатуПокупателю.бит_ДокРеализации = &ДокРеализации";
	
	Запрос.УстановитьПараметр("ДокРеализации", ДокументСсылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ДокСчет = ВыборкаДетальныеЗаписи.Ссылка;
		ПомеченНаУд = ВыборкаДетальныеЗаписи.ПометкаУдаления;
	КонецЦикла;	
	
	Если ДокСчет <> Документы.СчетНаОплатуПокупателю.ПустаяСсылка() Тогда
		Если ПомеченНаУд Тогда
			Сообщить("Пометка на удаления снята с документа: "+ДокСчет);
		КонецЕсли;
		ДокументСчет = ДокСчет.ПолучитьОбъект();
        ДокументСчет.ПометкаУдаления = ЛОЖЬ;
	Иначе
		ДокументСчет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	КонецЕсли;
	
	//ДокументСчет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	//ДокументСсылка = Документы.РеализацияТоваровУслуг.СоздатьДокумент();
	
	ДокументСчет.бит_ДокРеализации = ДокументСсылка;
	//17.05.2019
	если Строка(ТипЗнч(ДокументСсылка)) <> "Оказание производственных услуг" тогда
	 ДокументСчет.бит_ЛицевойСчет = ДокументСсылка.бит_ЛицевойСчет;
	конецесли; 
	ДокументСчет.бит_ПериодСчета = Формат(ДокументСсылка.Дата, "ДФ=""ММММ гггг 'г.'""");
    ДокументСчет.ОрганизацияПолучатель = ДокументСсылка.Организация;
	ДокументСчет.СтруктурнаяЕдиница = ДокументСсылка.Организация.ОсновнойБанковскийСчет;
	ДокументСчет.Дата = ДокументСсылка.Дата;
	ДокументСчет.Ответственный = ДокументСсылка.Ответственный;
	ДокументСчет.Комментарий = ДокументСсылка.Комментарий;
	ДокументСчет.Заполнить(ДокументСсылка);
	бит_ОбщегоНазначения.ЗаписатьПровестиДокумент(ДокументСчет,РежимЗаписиДокумента.Запись,,);
	
	
КонецПроцедуры
