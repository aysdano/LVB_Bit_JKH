
#Область ПеременныеМодуля

&НаКлиенте 
Перем мКэшРеквизитовФормы;       // Хранит текущие значения реквизитов формы. Клиент.

#КонецОбласти

#Область РаботаСКэшемРеквизитовФормы

// БИТ_ЖКХ Возвращает булевое значение
//
// Параметры
//  НачальноеЗначение  – старое значение.
//
//  ВыбранноеЗначение  – текущее значение. 
//
// Возвращаемое значение:
//   Булево   – истина или ложь.
//
//
&НаКлиенте
Процедура ЗадатьВопросНаОчисткуТабЧасти(Знач Оповещение, НачальноеЗначение, ВыбранноеЗначение)
	
	Если НачальноеЗначение <> ВыбранноеЗначение Тогда
		
		Если Объект.ЛицевыеСчета.Количество() > 0 Тогда
			
			Ответ = Неопределено;

			ПоказатьВопрос(Новый ОписаниеОповещения("ЗадатьВопросНаОчисткуТабЧастиЗавершение", ЭтотОбъект, Новый Структура("Оповещение,ВыбранноеЗначение", Оповещение,ВыбранноеЗначение)), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
            Возврат;

		ИначеЕсли  Строка(Типзнч(ВыбранноеЗначение)) = "Список зданий " Тогда
			
			Объект.Здание = ВыбранноеЗначение;
		ИначеЕсли  Строка(Типзнч(ВыбранноеЗначение)) = "Список улиц " Тогда
			
			Объект.Улица = ВыбранноеЗначение;
			Объект.Здание = ПредопределенноеЗначение("Справочник.бит_СписокЗданий.ПустаяСсылка");
		ИначеЕсли  Строка(Типзнч(ВыбранноеЗначение)) = "Услуги ЖКХ " Тогда
			
			Объект.Услуга = ВыбранноеЗначение;
			
		КонецЕсли;
			
	КонецЕсли;
	
	ЗадатьВопросНаОчисткуТабЧастиФрагмент(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросНаОчисткуТабЧастиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Оповещение = ДополнительныеПараметры.Оповещение;
    ВыбранноеЗначение = ДополнительныеПараметры.ВыбранноеЗначение;
       
    Ответ = РезультатВопроса;
    
    Если Ответ = КодВозвратаДиалога.Да Тогда
        
        Объект.ЛицевыеСчета.Очистить();
		
		Если  Строка(Типзнч(ВыбранноеЗначение)) = "Список зданий " Тогда
			
			Объект.Здание = ВыбранноеЗначение;
		ИначеЕсли  Строка(Типзнч(ВыбранноеЗначение)) = "Список улиц " Тогда
			
			Объект.Улица = ВыбранноеЗначение;
			Объект.Здание = ПредопределенноеЗначение("Справочник.бит_СписокЗданий.ПустаяСсылка");
		ИначеЕсли  Строка(Типзнч(ВыбранноеЗначение)) = "Услуги ЖКХ " Тогда
			
			Объект.Услуга = ВыбранноеЗначение;
			
		КонецЕсли;
		
    КонецЕсли;
    
    ЗадатьВопросНаОчисткуТабЧастиФрагмент(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ЗадатьВопросНаОчисткуТабЧастиФрагмент(Знач Оповещение)
    
    ВыполнитьОбработкуОповещения(Оповещение);

КонецПроцедуры

// Процедура открывает форму выбора элемента справочника бит_УслугиЖКХ.
// Параметры:
//	Элемент - поле ввода, для которого обрабатывается событие "НачалоВыбора".
//	СтандартнаяОбработка - флаг, указывающий будет ли выполнятся стандартная обработка события.
&НаКлиенте
Процедура ОткрытьФормуВыбораУслуги(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокУслуг = ПолучитьСписокУслуг();
	
	Отбор = Новый Структура;
	
	Если НЕ СписокУслуг = Неопределено Тогда
		
		Отбор.Вставить("Ссылка", СписокУслуг);
		
	КонецЕсли; 
	
	ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

// Процедура открывает форму выбора элемента справочника бит_ЛицевыеСчета.
// Параметры:
//	Элемент - поле ввода, для которого обрабатывается событие "НачалоВыбора".
//	СтандартнаяОбработка - флаг, указывающий будет ли выполнятся стандартная обработка события.
&НаКлиенте
Процедура ОткрытьФормуВыбораЛицевогоСчета(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Отбор = Новый Структура;
	
	Если ЗначениеЗаполнено(Объект.Улица) Тогда
		
		Отбор.Вставить("УлицаЛицевогоСчета", Объект.Улица);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Здание) Тогда
		
		Отбор.Вставить("Здание"            , Объект.Здание);
		
	КонецЕсли; 
	
	ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

// Процедура открывает форму выбора элемента справочника бит_ПоставщикиУслуг.
//
// Параметры:
//
//	Элемент              - поле ввода, для которого обрабатывается событие "НачалоВыбора".
//
//	СтандартнаяОбработка - флаг, указывающий будет ли выполнятся стандартная обработка события.
//
//  ТекущаяУслуга        - справочникссылка, ссылка хранящее значение поставщика.
//
&НаКлиенте
Процедура ОткрытьФормуВыбораПоставщика(Элемент, ТекущаяУслуга, СтандартнаяОбработка, ЗначениеЭлемента)
	
	СтандартнаяОбработка = Ложь;
	
	СписокПоставщиков = ПолучитьСписокПоставщиковНаСервере2(ТекущаяУслуга);
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("Ссылка",                  СписокПоставщиков);
	Отбор.Вставить("НачальноеЗначениеВыбора", ЗначениеЭлемента);
	
	ОткрытьФорму("Справочник.бит_ПоставщикиУслуг.Форма.ФормаВыбораУправляемая", Новый Структура("ЗаполнитьИзДокументаУстановкаИзменениеУслугПоЛС", Отбор), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьФормуВыбораРежимаПотребления(Элемент, Владелец, СтандартнаяОбработка)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СписокПоставщиков = ПолучитьСписокПоставщиковНаСервере(Объект.Услуга);
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("Ссылка", СписокПоставщиков);
		
		ОткрытьФорму("Справочник.бит_РежимыПотребленияУслуг.Форма.ФормаВыбораУправляемая", Новый Структура("ЗаполнитьИзДокументаУстановкаИзменениеУслугПоЛС", Отбор), Элемент);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииДляУправленияВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , мКэшЗначений.ВидОперации);
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры // УстановитьЗаголовокФормыДокумента()

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ЛицевойСчет.Видимость                 = (Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет);
	Элементы.Декорация1.Видимость                  = Не (Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет);
	Элементы.Услуга.Видимость 	                   = (Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета);	
	Элементы.ЛицевыеСчетаЛицевойСчет.Видимость     = (Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета);
	Элементы.ЛицевыеСчетаУслуга.Видимость 	       = (Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет);	
	Элементы.Группа6.Видимость                     = (Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета);	
	Элементы.РежимПотребления.Видимость	           = (УказыватьОтдельно = 1);
	Элементы.Поставщик.Видимость 			       = (УказыватьОтдельно = 1);
	Элементы.СпособРасчета.Видимость 		       = (УказыватьОтдельно = 1);
	Элементы.КоличествоЕдиницПотребления.Видимость = (УказыватьОтдельно = 1) и ((СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления) Или (СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет));
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет Тогда
		
		Элементы.ЛицевыеСчетаАктуальнымиУслугами.Видимость = Истина;
		Элементы.ЛицевыеСчетаЗаполнить.Видимость           = Ложь;
		Элементы.ЛицевыеСчетаПодбор.Видимость              = Ложь;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета Тогда
		
		Элементы.ЛицевыеСчетаАктуальнымиУслугами.Видимость = Ложь;
		Элементы.ЛицевыеСчетаЗаполнить.Видимость           = Истина;
		Элементы.ЛицевыеСчетаПодбор.Видимость              = Истина;
		
	КонецЕсли;
	
КонецПроцедуры // УправлениеЭлементамиФормы()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	// Вызов механизма разделения прав доступа.
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	бит_ПраваДоступа.ПередОткрытиемФормы(Отказ, СтандартнаяОбработка, ДокументОбъект, ЭтаФорма);
	
	Если Параметры.Свойство("ЗаполнитьИзСправочникаСписокЗданий") Тогда
		
		Объект.ВидОперации = Параметры.ЗаполнитьИзСправочникаСписокЗданий.ВидОперации;
		Объект.Здание      = Параметры.ЗаполнитьИзСправочникаСписокЗданий.Здание;
		Объект.Улица       = Параметры.ЗаполнитьИзСправочникаСписокЗданий.Улица;
		
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаполнитьИзСправочникаЛицевыеСчета") Тогда
		
		ЗаполнитьПоследнимиЗначениямиНаСервере();
		
		Если Объект.ЛицевыеСчета.Количество() = 0 Тогда
			
			Объект.ЛицевыеСчета.Загрузить(бит_ОбщегоНазначения.ПолучитьШаблонУслугПоАдресу(ТекущаяДата(), Объект.Улица, Объект.Здание));
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеЭлементамиФормы();
	
	АктивизироватьРеквизитВФормеНаСервере();
	
	УстановитьЗаголовокФормыДокумента();
	
	// Установить доступность формы с учетом даты запрета редактирования.	
	УстановитьДоступностьФормыДляРедактированияНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// БИТ_ЖКХ 09.09.2016 11:58:53 Начало правки...
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	// БИТ_ЖКХ 09.09.2016 11:58:53 Конец правки.
	
	Оповестить("ИзменениеУслугПоЛС", Объект.ЛицевойСчет, ТипЗнч(Объект.Ссылка));
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если УказыватьОтдельно = 1 Тогда
		
		ЗагрузитьЛицевыеСчетаНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая" Тогда
		
		ОбработкаВыбораНаСервере(ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура АктуальнымиУслугами(Команда)
	
	Если Объект.ЛицевыеСчета.Количество() > 0 Тогда
		
		Ответ = Неопределено;
		
		
		ПоказатьВопрос(Новый ОписаниеОповещения("АктуальнымиУслугамиЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	АктуальнымиУслугамиФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура АктуальнымиУслугамиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Объект.ЛицевыеСчета.Очистить();
	
	
	АктуальнымиУслугамиФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура АктуальнымиУслугамиФрагмент()
	
	ЗаполнитьПоследнимиЗначениямиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Объект.ЛицевыеСчета.Количество() > 0 Тогда
		
		Ответ = Неопределено;
		
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Объект.ЛицевыеСчета.Очистить();
	
	ЗаполнитьФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФрагмент()
	
	ЗаполнитьЛицевымиСчетамиНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Услуга) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Укажите услугу.");
		Возврат;
		
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Дата"              , Объект.Дата);
	ПараметрыФормы.Вставить("ОткрытоИзДокумента", Истина);
	
	Если ЗначениеЗаполнено(Объект.Здание) Тогда
		
		ПараметрыФормы.Вставить("Здание"     , Объект.Здание);
		ПараметрыФормы.Вставить("Организация", ПолучитьОрганизациюЗданияНаСервере(Объект.Здание));
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.Улица) Тогда
		
		ПараметрыФормы.Вставить("Улица", Объект.Улица);
		
	КонецЕсли; 
	
	ОткрытьФорму("Обработка.бит_ПодборЛицевыхСчетов.Форма", ПараметрыФормы, ЭтаФорма, ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	ПредыдущийВидОперации = мКэшЗначений.ВидОперации; // Сохраним пред видОперациия для его сравнения с новым.
	
	// Если операция не поменялась то выходим.
	Если ПредыдущийВидОперации = Объект.ВидОперации Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Объект.ЛицевыеСчета.Очистить();
	
	Объект.ЛицевойСчет = Неопределено;
	Объект.Услуга      = Неопределено;
	
	мКэшЗначений.ВидОперации = Объект.ВидОперации;
	
	// Отобразить в заголовке формы вид операции.
	УстановитьЗаголовокФормыДокумента();
	
	// Установить видимость реквизитов по виду операции.
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура УлицаПриИзменении(Элемент)
	
	Если ПолучитьУлицуЗданияНаСервере(Объект.Здание) <> объект.Улица Тогда
		
		Объект.Здание      = Неопределено;
		Объект.ЛицевойСчет = Неопределено;
		Объект.Услуга      = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

