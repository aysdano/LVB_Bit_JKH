	Пока ВыборкаРегистра.Следующий() Цикл

		Если Год(ВыборкаРегистра.Период) <> Год(Дата) ИЛИ Месяц(ВыборкаРегистра.Период) <> Месяц(Дата)Тогда
			Запись = РегистрыСведений.бит_СведенияОКвартире.СоздатьНаборЗаписей();
			ЗаписьСтрока = Запись.Добавить();
			ЗаписьСтрока.Период         = Дата;
			ЗаписьСтрока.Квартира       = Квартира;
			ЗаписьСтрока.ТипКвартиры    = ВыборкаРегистра.ТипКвартиры;
			ЗаписьСтрока.СтатусКвартиры = ВыборкаРегистра.СтатусКвартиры;
			ЗаписьСтрока.ОбщаяПлощадь   = ВыборкаРегистра.ОбщаяПлощадь;
			ЗаписьСтрока.ЖилаяПлощадь   = ВыборкаРегистра.ЖилаяПлощадь;
			ЗаписьСтрока.ОтапливаемаяПлощадь = ВыборкаРегистра.ОтапливаемаяПлощадь;
			ЗаписьСтрока.СовокупнаяПлощадь   = ВыборкаРегистра.СовокупнаяПлощадь;
			ЗаписьСтрока.МОП                 = ВыборкаРегистра.МОП;
			ЗаписьСтрока.ТипЗапирающегоУстройства = ВыборкаРегистра.ТипЗапирающегоУстройства;
			ЗаписьСтрока.ТипПлиты                 = ВыборкаРегистра.ТипПлиты;
			// БИТ_ЖКХ_17012014_начало_изменений
			ЗаписьСтрока.ЖилоеПомещениеСпециализированногоЖилищногоФонда = ВыборкаРегистра.ЖилоеПомещениеСпециализированногоЖилищногоФонда;
			// БИТ_ЖКХ_17012014_окончание_изменений
			// БИТ_ЖКХ 02.05.2017 15:54:26 Начало правки...
			ЗаписьСтрока.ПлощадьОДНСОИЭлектроснаб	= ВыборкаРегистра.ПлощадьОДНСОИЭлектроснаб;
			ЗаписьСтрока.ПлощадьОДНСОИВодоснаб		= ВыборкаРегистра.ПлощадьОДНСОИЭлектроснаб;
			// БИТ_ЖКХ 02.05.2017 15:54:26 Конец правки.  
			//Мельник 30.01.25
			ЗаписьСтрока.лб_ПредставлениеКвартиры        = ВыборкаРегистра.лб_ПредставлениеКвартиры;
			ЗаписьСтрока.лб_ИгнорироватьСальдоСвоихУслуг = ВыборкаРегистра.лб_ИгнорироватьСальдоСвоихУслуг;
			ЗаписьСтрока.лб_НеВыводитьСтрокуДомофон      = ВыборкаРегистра.лб_НеВыводитьСтрокуДомофон;
			ЗаписьСтрока.лб_ПлощадьКапремонта            = ВыборкаРегистра.лб_ПлощадьКапремонта;
			
		Иначе
			Запись = ВыборкаРегистра.ПолучитьМенеджерЗаписи();
		КонецЕсли;
	КонецЦикла;
	
	// БИТ_ЖКХ изменение кода. Начало. 26.10.2011{{
	Если Запись = Неопределено Тогда
		
		Запись = РегистрыСведений.бит_СведенияОКвартире.СоздатьМенеджерЗаписи();
