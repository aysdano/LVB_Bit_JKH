Процедура ОбновитьПараметрыЖКХ() Экспорт
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("РасчетСУчетомДолейВладения"                           , Ложь);
	ПараметрыЖКХ.Вставить("УменьшениеНормыЛьготыВПределахФакта"                  , Ложь);
	ПараметрыЖКХ.Вставить("ЛьготаПерсонифицированная"                            , Ложь);
	ПараметрыЖКХ.Вставить("НачислениеСУчетомДнейПроживания"                      , Ложь);
	ПараметрыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	
	ПараметрыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	
	ПараметрыЖКХ.Вставить("НачислятьПениСУчетомПереплаты", Ложь);
	
	Если ОплатаПоПериоду И ЗначениеЗаполнено(КонецПериодаОплаты) Тогда
		мДата = КонецМесяца(КонецПериодаОплаты);
	Иначе
		мДата = Дата;
	КонецЕсли;
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(мДата), Организация, ПараметрыЖКХ);
	
	мРасчетСУчетомДолейВладения          = ПараметрыЖКХ.РасчетСУчетомДолейВладения;
	мУменьшениеНормыЛьготыВПределахФакта = ПараметрыЖКХ.УменьшениеНормыЛьготыВПределахФакта;
	мЛьготаПерсонифицированная           = ПараметрыЖКХ.ЛьготаПерсонифицированная;
	мНачислениеСУчетомДнейПроживания     = ПараметрыЖКХ.НачислениеСУчетомДнейПроживания;
	мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика  = ПараметрыЖКХ.РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика;
	мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика  = ПараметрыЖКХ.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика;
	мНачислятьПениСУчетомПереплаты  = ПараметрыЖКХ.НачислятьПениСУчетомПереплаты;
	
КонецПроцедуры

Процедура УдалитьПустыеСтроки() Экспорт
	
	КоличествоЗаписей = СписокУслуг.Количество();
	
	Для Ном = 1 По КоличествоЗаписей Цикл
		
		ТекСтрока = СписокУслуг[КоличествоЗаписей - Ном];
		
		Если ТекСтрока.Сумма = 0 И ТекСтрока.СуммаПени = 0 Тогда
			
			СписокУслуг.Удалить(ТекСтрока);
			
		КонецЕсли;
		
	КонецЦикла;		
	
