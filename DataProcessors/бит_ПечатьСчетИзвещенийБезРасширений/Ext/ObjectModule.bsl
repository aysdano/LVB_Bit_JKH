			мТаблицаПлатежиГИСЖКХ36			= ПолучитьТаблицаПлатежиГИСЖКХ36();
			мТаблицаПлатежиГИСЖКХДПД		= ПолучитьТаблицаПлатежиГИСЖКХДПД();
			мТаблицаПлатежиГИСЖКХНеустойки	= ПолучитьТаблицаПлатежиГИСЖКХНеустойки();
			
			ТабличныйДокумент = Новый ТабличныйДокумент;
			
			УстановитьНастройкиТабличногоДокумена(ТабличныйДокумент);
			
			ПодключитьВнешнююКомпонентуПечатиШтрихкода();
			
			Отказ = Ложь;
			Для каждого СтрокаТаблица из ТаблицаДанных  Цикл
				
				//СтрокаТаблица = ТаблицаДанных[Значение];
				//СтрокаТаблица = ТаблицаДанных[0];
				
				ВывестиНаПечатьКвитанцию(ТабличныйДокумент, СтрокаТаблица, Отказ);
				
				//Если Отказ Тогда
				//	Прервать;
				//КонецЕсли; 
				
			КонецЦикла;
			
			//Попытка
			//	СтруктураПД = Новый Структура();
			//	СтруктураПД.Вставить("ТаблицаПлатежиГИСЖКХ12"		, мТаблицаПлатежиГИСЖКХ12);
			//	СтруктураПД.Вставить("ТаблицаПлатежиГИСЖКХ36"		, мТаблицаПлатежиГИСЖКХ36);
			//	СтруктураПД.Вставить("ТаблицаПлатежиГИСЖКХДПД"		, мТаблицаПлатежиГИСЖКХДПД);
			//	СтруктураПД.Вставить("ТаблицаПлатежиГИСЖКХНеустойки", мТаблицаПлатежиГИСЖКХНеустойки);
			//Исключение
			//КонецПопытки;
			
			
			ПредставлениеПериодаРегистрации = Формат(Период, "ДФ='ММММ гггг'");
			ТаблицаПлатежиГИСЖКХ12			= мТаблицаПлатежиГИСЖКХ12;
			ТаблицаПлатежиГИСЖКХ36			= мТаблицаПлатежиГИСЖКХ36;
			ТаблицаПлатежиГИСЖКХДПД			= мТаблицаПлатежиГИСЖКХДПД;
			ТаблицаПлатежиГИСЖКХНеустойки	= мТаблицаПлатежиГИСЖКХНеустойки;
			
			Если ТаблицаПлатежиГИСЖКХ12.Количество() = 0
				И ТаблицаПлатежиГИСЖКХ36.Количество() = 0
				И ТаблицаПлатежиГИСЖКХДПД.Количество() = 0 
				И ТаблицаПлатежиГИСЖКХНеустойки.Количество() = 0 Тогда
				
				ТекстСообщения = НСтр("ru = 'Отсутствуют данные для формирования документов,
				|полученные согласно макету квитанции платежного документа РК924 (ГИС ЖКХ)!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецЕсли;
			
			ТаблицаПлатежныхДокументов = ТаблицаПлатежиГИСЖКХ12.Скопировать(,"ЛицевойСчет, РасчетныйПериод, ТабличнйДокумент");
			ТаблицаПлатежныхДокументов.Свернуть("ЛицевойСчет, РасчетныйПериод, ТабличнйДокумент");
			
			ПараметрыПровеки = Новый Структура();
			ПараметрыПровеки.Вставить("Период"				 , Период);
			ПараметрыПровеки.Вставить("ЛицевыеСчета"		 , ТаблицаПлатежныхДокументов.ВыгрузитьКолонку("ЛицевойСчет"));
			ПараметрыПровеки.Вставить("ШаблонИзвещений"		 , ШаблонИзвещений);
			ПараметрыПровеки.Вставить("ПредставлениеПериода" , ПредставлениеПериодаРегистрации);
			
			Если Справочники.бит_ПлатежныеДокументыГИСЖКХ.ЕстьВыгрузка(ПараметрыПровеки) Тогда
				Возврат;	
			КонецЕсли;
			
			НачатьТранзакцию();
			
			// Создание пачки документов.
			ГруппаВыгрузки = Справочники.бит_ПлатежныеДокументыГИСЖКХ.ПолучитьГруппуДокументов(Период);
			
			Если НЕ ЗначениеЗаполнено(ГруппаВыгрузки.Ссылка) Тогда
				ГруппаВыгрузки.Наименование	= ПредставлениеПериодаРегистрации;
				ГруппаВыгрузки.РасчетныйПериод	= Период;
				Попытка
					ГруппаВыгрузки.Записать();
				Исключение
					ИнформацияОбОшибке = ИнформацияОбОшибке();
					ТекстСообщения = НСтр("ru = '%1'");
					ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					ОтменитьТранзакцию();
					Возврат;
				КонецПопытки; 
			КонецЕсли;
			
			ТЗОбновления = Справочники.бит_ПлатежныеДокументыГИСЖКХ.ПолучитьДокументы(ПараметрыПровеки);
			
			// Создание "Платежных документов".
			Для Каждого Стр Из ТаблицаПлатежныхДокументов Цикл
				
				Кэштаб = Неопределено;
				ПлатДокГИСЖКХ = ТЗОбновления.Найти(Стр.ЛицевойСчет, "ЛицевойСчет");
				Если ПлатДокГИСЖКХ = Неопределено Тогда
					ПлатежныйДокумент = Справочники.бит_ПлатежныеДокументыГИСЖКХ.СоздатьЭлемент();
				Иначе	
					ПлатежныйДокумент = ПлатДокГИСЖКХ.Ссылка.ПолучитьОбъект();	
				КонецЕсли;
				
				ПлатежныйДокумент.Наименование	  = "Платежный документ ГИС ЖКХ по ЛС " + Строка(Стр.ЛицевойСчет) + " (" + ПредставлениеПериодаРегистрации + ")";
				ПлатежныйДокумент.Родитель		  = ГруппаВыгрузки.Ссылка;
				ПлатежныйДокумент.ЛицевойСчет	  = Стр.ЛицевойСчет;
				ПлатежныйДокумент.ШаблонИзвещений = ШаблонИзвещений;
				ПлатежныйДокумент.РасчетныйПериод = Стр.РасчетныйПериод;
				ПлатежныйДокумент.Ответственный	  = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
				
				// Технические тч.
				ПлатежныйДокумент.ТаблицаПлатежиГИСЖКХ12.Загрузить(ТаблицаПлатежиГИСЖКХ12.Скопировать(Новый Структура("ЛицевойСчет", Стр.ЛицевойСчет)));
				ПлатежныйДокумент.ТаблицаПлатежиГИСЖКХ36.Загрузить(ТаблицаПлатежиГИСЖКХ36.Скопировать(Новый Структура("ЛицевойСчет", Стр.ЛицевойСчет)));
				ПлатежныйДокумент.ТаблицаПлатежиГИСЖКХДПД.Загрузить(ТаблицаПлатежиГИСЖКХДПД.Скопировать(Новый Структура("ЛицевойСчет", Стр.ЛицевойСчет)));
				ПлатежныйДокумент.ТаблицаПлатежиГИСЖКХНеустойки.Загрузить(ТаблицаПлатежиГИСЖКХНеустойки.Скопировать(Новый Структура("ЛицевойСчет", Стр.ЛицевойСчет)));
				
				// Уникальный номер документа, для ГИС ЖКХ.
				//+КлинскихПГ_2021-10-28_уменьшаем длинну номера платежного документа
				//УникальнаяНомерПД = Формат(Стр.РасчетныйПериод, "ДФ='ММгггг'") + бит_ОбщегоНазначения.ДополнитьСтроку(Строка(Стр.ЛицевойСчет),12)
				УникальнаяНомерПД = Формат(Стр.РасчетныйПериод, "ДФ='ММгг'") + Стр.ЛицевойСчет
				+ "-" + Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонИзвещений, "Код"));
				//-КлинскихПГ_2021-10-28_уменьшаем длинну номера платежного документа
				ПлатежныйДокумент.НомерПД = УникальнаяНомерПД;
				
				Попытка
					ПлатежныйДокумент.Записать();
				Исключение
					ИнформацияОбОшибке = ИнформацияОбОшибке();
					ТекстСообщения = НСтр("ru = '%1'");
					ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
					ОтменитьТранзакцию();
					Возврат;
				КонецПопытки;
				
				ПараметрыЗаписиПД = Новый Структура();
				ПараметрыЗаписиПД.Вставить("Период", Период);
				ПараметрыЗаписиПД.Вставить("Файл", Стр.ТабличнйДокумент);
				Если ФормироватьПлатежныеДокументы Тогда
					ФайлПД =  ПлатежныйДокумент.ПрисоденитьФайл(ПараметрыЗаписиПД);
					Если НЕ ЗначениеЗаполнено(ФайлПД) Тогда
						ОтменитьТранзакцию();	
					КонецЕсли;
				КонецЕсли;
			КонецЦикла;
			
			ЗафиксироватьТранзакцию();
			
КонецПроцедуры


Функция ПолучитьИмя(С)
	
	Рез = С;
	Рез = СтрЗаменить(Рез, "\", "");
	Рез = СтрЗаменить(Рез, "/", "");
	Рез = СтрЗаменить(Рез, ":", "");
	Рез = СтрЗаменить(Рез, "*", "");
	Рез = СтрЗаменить(Рез, "?", "");
	Рез = СтрЗаменить(Рез, """", "");
	Рез = СтрЗаменить(Рез, "<", "");
	Рез = СтрЗаменить(Рез, ">", "");
	Рез = СтрЗаменить(Рез, "|", "");
	Рез = СтрЗаменить(Рез, "+", "");
	
	Имя = СокрЛП(Рез);
	
	Возврат Имя;
	
КонецФункции


Функция бит_ПечатьКвитанций(Знач ТаблицаДанных, ПервыйЭлемент = 0, ПоследнийЭлемент = 0, АдресХранилщаДанных = Неопределено) Экспорт
	
	Если ПоследнийЭлемент = 0 Тогда
		ПоследнийЭлемент = ТаблицаДанных.Количество() - 1;
	КонецЕсли; 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	УстановитьНастройкиТабличногоДокумена(ТабличныйДокумент);
	//Если мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонт
	//	ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговая 
	//	ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговаяМуниципальная 
	//	ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговаяНежилая 
	//	ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтМуниципальная 
	//	ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтНежилая Тогда
	//		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	//	Иначе
	//		ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	//КонецЕсли;
		
	ПодключитьВнешнююКомпонентуПечатиШтрихкода();
	
	Отказ = Ложь;
	Сч = 0;
	Для Значение = ПервыйЭлемент По ПоследнийЭлемент  Цикл
		
		СтрокаТаблица = ТаблицаДанных[Значение];
		
		Если МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговая
			ИЛИ МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговаяМуниципальная 
			ИЛИ МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговаяНежилая Тогда
			
			ВывестиНаПечатьКвитанцию(ТабличныйДокумент, СтрокаТаблица, Отказ, Сч);// Значение % 2);
			
		Иначе
			ВывестиНаПечатьКвитанцию(ТабличныйДокумент, СтрокаТаблица, Отказ);
		КонецЕсли;
		
		Если Отказ Тогда
			Прервать;
		КонецЕсли; 
		
	КонецЦикла;
	
	Возврат ТабличныйДокумент;
	
КонецФункции


Функция бит_СформироватьДанныеПечати(ТолькоПоОтбору = Ложь, Печать = Ложь) Экспорт
	
	// Кэширование основных параметров.
	Если НЕ УстановитьМакет() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаДанных = Новый ТаблицаЗначений;        
	ТаблицаДанных.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаДанных.Колонки.Добавить("ВладелецЛС" , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаДанных.Колонки.Добавить("Значение");
	
	//Дауров 24.1.1
	//Порядок печати выбранных квитанций – сначала по названиям участков, 
	//затем по кодам домов, потом по номерам квартир, потом по номерам ЛС 
