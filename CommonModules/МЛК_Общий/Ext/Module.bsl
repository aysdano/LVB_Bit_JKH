	Если Ответ.КодСостояния = 200 Тогда
		СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		// МЛК_Общий.ЗаписатьДанныеВЖурнал("Отправка всех лицевых счетов в МЛК - 1.1",,ЖурналЗапросБезКодировкиМассив,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
