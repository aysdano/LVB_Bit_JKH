&НаСервере
Процедура ж_ЗаменитьДанныеВБазеИзРегистраНаСервере()
	ОбработатьВсеЛС = Объект.ПерезагружаемыеЛС.Количество()=0;
	Если ОбработатьВсеЛС тогда
		Запрос = новый запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_СписокЗданий.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.бит_СписокЗданий КАК бит_СписокЗданий";
		ЗданияДляОбработки = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка"); 		
	иначе
		Табл = Объект.ПерезагружаемыеЛС.Выгрузить(,"Здание");
		Табл.Свернуть("Здание");
		ЗданияДляОбработки = Табл.ВыгрузитьКолонку("Здание"); 	
	КонецЕсли;

	ж_УдалитьДанныеИзБазыНаСервере(ЗданияДляОбработки,ОбработатьВсеЛС);
	ж_ЗагрузитьДанныеВБазуНаСервере(ЗданияДляОбработки,ОбработатьВсеЛС);
	ЧислоЛС = Объект.ПерезагружаемыеЛС.Количество();
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Обновлены данные о проживающих по " + ?(ЧислоЛС=0," всем ",ЧислоЛС)+"л/с");
	
КонецПроцедуры	

&НаСервере
Процедура ж_УдалитьДанныеИзБазыНаСервере(ЗданияДляОбработки, обработатьВсеЛС)
	// Вставить содержимое обработчика.
	
	Для каждого Здание из ЗданияДляОбработки цикл
		СписокЛС = СписокЛсПоЗданию(Здание,ОбработатьВсеЛС);
		СписокДок = СписокРегистраторов(СписокЛС);
		НачатьТранзакцию();
		Для Каждого ТекРегистратор из СписокДок цикл
			Если ТипЗнч(ТекРегистратор)<> Тип("ДокументСсылка.ОперацияБух") тогда
				ДокОбъект = ТекРегистратор.ПолучитьОбъект();
				Если ложь тогда ДокОбъект = Документы.бит_РегистрацияПроживающихПоЛС.СоздатьДокумент() КонецЕсли;
				ДокОбъект.УстановитьПометкуУдаления(истина);
				ДокОбъект.Удалить();
				
			иначе
				Набор = РегистрыСведений.бит_ПроживающиеПоЛС.СоздатьНаборЗаписей();
				Набор.Отбор.Регистратор.Значение = ТекРегистратор;
				Набор.Прочитать();
				ЧислоЗаписей = Набор.Количество();
				Для СчетВниз = 1 по ЧислоЗаписей цикл Запись = Набор[ЧислоЗаписей-СчетВниз]; Если СписокЛС.Найти(Запись.ЛицевойСчет)<>Неопределено тогда Набор.Удалить(ЧислоЗаписей-СчетВниз);КонецЕсли; КонецЦикла;
				////Исходный текст цикла
				//Для СчетВниз = 1 по ЧислоЗаписей цикл
				//	Запись = Набор[ЧислоЗаписей-СчетВниз]; 
				//	Если СписокЛС.Найти(Запись.ЛицевойСчет)<>Неопределено тогда 
				//		Набор.Удалить(ЧислоЗаписей-СчетВниз);
				//	КонецЕсли;
				//КонецЦикла;
				Набор.Записать(истина);
				
				Если  Набор.Количество() = 0 тогда
					ДокОбъект = ТекРегистратор.ПолучитьОбъект();
					ДокОбъект.Удалить()
				КонецЕсли;	
			КонецЕсли;
		КонецЦикла;	
		ЗафиксироватьТранзакцию();
	КонецЦикла;;
	
	
КонецПроцедуры

&НаСервере
Функция  СписокЛсПоЗданию(Здание,ОбработатьВсеЛС);
	Если ОбработатьВсеЛС тогда
		Запрос = новый запрос;
		Запрос.УстановитьПараметр("Здание",Здание);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_ЛицевыеСчета.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
			|ГДЕ
			|	бит_ЛицевыеСчета.Здание = &Здание";
		ИсходныйСписокЛС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	иначе	
		Отбор = новый структура("Здание",Здание);
		СтрокиПоЗданию = Объект.ПерезагружаемыеЛС.НайтиСтроки(Отбор);
		ИсходныйСписокЛС = Объект.ПерезагружаемыеЛС.Выгрузить(СтрокиПоЗданию,"ЛС").ВыгрузитьКолонку("ЛС");
	КонецЕсли;
	
	
	//не перезаполняем счета, где хотя бы одна запись - игнор
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("ИсходныйСписокЛС",ИсходныйСписокЛС);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ ИсхСписок
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Ссылка В(&ИсходныйСписокЛС)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИсхСписок.Ссылка КАК ЛС,
		|	МАКСИМУМ(ЕСТЬNULL(лб_Тест_Жильцы.Игнорировать, ЛОЖЬ)) КАК Игнор
		|ПОМЕСТИТЬ СписокЛС
		|ИЗ
		|	ИсхСписок КАК ИсхСписок
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_Тест_Жильцы КАК лб_Тест_Жильцы
		|		ПО лб_Тест_Жильцы.ЛС = ИсхСписок.Ссылка
		|			И (лб_Тест_Жильцы.Игнорировать = ИСТИНА)
		|
		|СГРУППИРОВАТЬ ПО
		|	ИсхСписок.Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СписокЛС.ЛС КАК ЛС
		|ИЗ
		|	СписокЛС КАК СписокЛС
		|ГДЕ
		|	СписокЛС.Игнор = ЛОЖЬ";
	СписокЛС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЛС");;
	
	Возврат СписокЛС
	
КонецФункции

