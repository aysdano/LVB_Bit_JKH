		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_СтатьиШаблонаСметы.Ссылка КАК СтатьяШаблонаСметы,
	бит_СтатьиШаблонаСметы.СтатьяОборотов
ПОМЕСТИТЬ СтатьиШаблонаСметы
ИЗ
	Справочник.бит_СтатьиШаблонаСметы КАК бит_СтатьиШаблонаСметы
ГДЕ
	бит_СтатьиШаблонаСметы.Владелец = &amp;ШаблонСметы
	И НЕ бит_СтатьиШаблонаСметы.СтатьяОборотов ЕСТЬ NULL 
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СтатьиШаблонаСметы.СтатьяОборотов КАК СтатьяОборотов,
	бит_ОборотыПоСметамОбороты.Здание КАК Здание,
	СтатьиШаблонаСметы.СтатьяОборотов.Наименование КАК Наименование,
	СтатьиШаблонаСметы.СтатьяОборотов.Кодификатор КАК Кодификатор,
	бит_ОборотыПоСметамОбороты.Здание.Район КАК Район,
	бит_ОборотыПоСметамОбороты.Здание.Улица КАК Улица,
	бит_ОборотыПоСметамОбороты.Здание.Участок КАК Участок,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ГОД)
		ИНАЧЕ бит_ОборотыПоСметамОбороты.Период
	КОНЕЦ КАК Период,
	ВЫБОР
		КОГДА бит_ОборотыПоСметамОбороты.СтатьяОборотов.РасходДоход = ЗНАЧЕНИЕ(Перечисление.бит_РасходДоход.Доход)
			ТОГДА бит_ОборотыПоСметамОбороты.СуммаОборот
		ИНАЧЕ -бит_ОборотыПоСметамОбороты.СуммаОборот
	КОНЕЦ КАК Сумма
ИЗ
	СтатьиШаблонаСметы КАК СтатьиШаблонаСметы
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ОборотыПоСметам.Обороты(
				&amp;НачалоПериода,
				&amp;КонецПериода,
				Регистратор,
				Сценарий = &amp;Сценарий
					И Организация = &amp;Организация) КАК бит_ОборотыПоСметамОбороты
		ПО СтатьиШаблонаСметы.СтатьяОборотов = бит_ОборотыПоСметамОбороты.СтатьяОборотов
;

