// Функция получает сведения о текущей кофигурации.
//
//
// Возвращаемое значение:
//   Сведения - Структура.
//
Функция ПолучитьСведенияОПрограмме()  Экспорт
	
	Сведения = Новый Структура;
	
	ЗначенияПеречисления = Метаданные.Перечисления.бит_СведенияОПрограмме.ЗначенияПеречисления;
	
	Сведения.Вставить("Имя_1С"                  ,ЗначенияПеречисления.Имя_1С.Синоним);
	Сведения.Вставить("Синоним_1С"              ,ЗначенияПеречисления.Синоним_1С.Синоним);	
	Сведения.Вставить("НомерРелиза_1С"          ,ЗначенияПеречисления.НомерРелиза_1С.Синоним);
	Сведения.Вставить("Имя_БИТ"                 ,ЗначенияПеречисления.Имя_БИТ.Синоним);
	Сведения.Вставить("Синоним_БИТ"             ,ЗначенияПеречисления.Синоним_БИТ.Синоним);	
	Сведения.Вставить("НомерРелиза_БИТ"         ,ЗначенияПеречисления.НомерРелиза_БИТ.Синоним);
	Сведения.Вставить("Решение_БИТ"             ,ЗначенияПеречисления.Решение_БИТ.Синоним);
	Сведения.Вставить("Версия_АдаптерЗащиты"    ,ЗначенияПеречисления.Версия_АдаптерЗащиты.Синоним);
	Сведения.Вставить("Версия_КомпонентаЗащиты" ,ЗначенияПеречисления.Версия_КомпонентаЗащиты.Синоним);	
	
	Возврат Сведения;
	
