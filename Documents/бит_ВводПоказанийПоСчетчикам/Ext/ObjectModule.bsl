// Проверяет правильность заполнения шапки документа.
// Если какой-то из реквизитов шапки, влияющий на проведение не заполнен или
// заполнен не корректно, то выставляется флаг отказа в проведении.
// Проверяется также правильность заполнения реквизитов ссылочных полей документа.
// Проверка выполняется по объекту и по выборке из результата запроса по шапке.
//
// Параметры: 
//  СтруктураШапкиДокумента - выборка из результата запроса по шапке документа,
//  Отказ                   - флаг отказа в проведении,
//  Заголовок               - строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок)
	
	// Укажем, что надо проверить.
	СтруктураОбязательныхПолей = Новый Структура("ТипСчетчика");	
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры

// Процедура проверяет правильность заполнения реквизитов документа.
//
Процедура ПроверкаРеквизитовТЧ(ТаблицаТЧ,СтруктураПолей,Отказ, Заголовок) Экспорт
	
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "ПоказанияПоСчетчикам",
	СтруктураПолей, Отказ, Заголовок);
	
КонецПроцедуры

// Процедура выполняет записи движений по регистрам.
//
Процедура ЗаписатьДвижения(Организация, Выборка, ВидДвижения, ТекущиеПоказания)
	
	ДвижениеРасх = Движения.бит_ПоказанияСчетчиков.Добавить();
	ДвижениеРасх.ВидДвижения = ВидДвижения;
	ДвижениеРасх.Период = Дата;
	ДвижениеРасх.Объект = Выборка.Объект;
	ДвижениеРасх.Услуга = Выборка.Услуга;
	ДвижениеРасх.Счетчик = Выборка.Счетчик;
	ДвижениеРасх.Коэффициент = Выборка.КоэффициентУмножения;
	ДвижениеРасх.ПоследниеПоказания = Выборка.ПоследниеПоказания;
	ДвижениеРасх.Организация   = Организация;
	
	Если ВидДвижения = ВидДвиженияНакопления.Приход Тогда
		Если ВидОперации = перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний Тогда
			
			Если ПоказанияНаселения Тогда
				ДвижениеРасх.ТекущиеПоказанияНаселения  = ТекущиеПоказания;
				ДвижениеРасх.ТекущиеПоказанияИнспектора = 0;
				ДвижениеРасх.ПоказанияПодкрутка         = 0;
			Иначе
				ДвижениеРасх.ПоказанияПодкрутка         = 0;
				ДвижениеРасх.ТекущиеПоказанияНаселения  = 0;
				ДвижениеРасх.ТекущиеПоказанияИнспектора = ТекущиеПоказания;
			КонецЕсли;
			
		Иначе
			
			ДвижениеРасх.ПоказанияПодкрутка         = ТекущиеПоказания;
			ДвижениеРасх.ТекущиеПоказанияНаселения  = 0;
			ДвижениеРасх.ТекущиеПоказанияИнспектора = 0;
			
		КонецЕсли; 
	ИначеЕсли  ВидДвижения =  ВидДвиженияНакопления.Расход Тогда
		
		ДвижениеРасх.ТекущиеПоказанияНаселения  = Выборка.ТекущиеПоказанияНаселения;
		ДвижениеРасх.ТекущиеПоказанияИнспектора = Выборка.ТекущиеПоказанияИнспектора;
		ДвижениеРасх.ПоказанияПодкрутка         = Выборка.ПоказанияПодкрутка;
	КонецЕсли;
	
КонецПроцедуры

// Выполняет движения по регистрам. 
//
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам,Отказ, Заголовок)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("Момент", МоментВремени());
	
	Счетчики = ПоказанияПоСчетчикам.ВыгрузитьКолонку("Счетчик");
	
	Запрос.УстановитьПараметр("Счетчики", Счетчики);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам.Услуга,
	|	бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам.Счетчик,
	|	бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам.ТекущиеПоказания,
	|	бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам.ПереходЧерезНоль,
	|	ВЫБОР
	|		КОГДА бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам.Ссылка.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
	|			ТОГДА бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам.ЛицевойСчет
	|		ИНАЧЕ бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам.Дом
	|	КОНЕЦ КАК Объект
	|ПОМЕСТИТЬ ТаблицаДокумента
	|ИЗ
	|	Документ.бит_ВводПоказанийПоСчетчикам.ПоказанияПоСчетчикам КАК бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам
	|ГДЕ
	|	бит_ВводПоказанийПоСчетчикамПоказанияПоСчетчикам.Ссылка = &Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Объект КАК Объект,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга КАК Услуга,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик КАК Счетчик,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик.Разрядность КАК Разрядность,
	|	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0) КАК ПоследниеПоказания,
	|	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток, 0) КАК ТекущиеПоказанияИнспектора,
	|	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток, 0) КАК ТекущиеПоказанияНаселения,
	|	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0) КАК ПоказанияПодкрутка,
	|	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.КоэффициентОстаток, 1) КАК КоэффициентУмножения,
	|	ЕСТЬNULL(ТаблицаДокумента.ТекущиеПоказания, 0) КАК КонечныеПоказания,
	|	ЕСТЬNULL(ТаблицаДокумента.ПереходЧерезНоль, ЛОЖЬ) КАК ПереходЧерезНоль
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Момент, Счетчик В (&Счетчики)) КАК бит_СчетчикиНаУслугахСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(&Момент, ) КАК бит_ПоказанияСчетчиковОстатки
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Объект = бит_ПоказанияСчетчиковОстатки.Объект
	|			И бит_СчетчикиНаУслугахСрезПоследних.Услуга = бит_ПоказанияСчетчиковОстатки.Услуга
	|			И бит_СчетчикиНаУслугахСрезПоследних.Счетчик = бит_ПоказанияСчетчиковОстатки.Счетчик
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаДокумента КАК ТаблицаДокумента
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Услуга = ТаблицаДокумента.Услуга
	|			И бит_СчетчикиНаУслугахСрезПоследних.Счетчик = ТаблицаДокумента.Счетчик
	|			И бит_СчетчикиНаУслугахСрезПоследних.Объект = ТаблицаДокумента.Объект
	|ГДЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Использовать = ИСТИНА";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.КонечныеПоказания > 0 ИЛИ Выборка.ПереходЧерезНоль Тогда
			
			ЗаписатьДвижения(Организация,Выборка,ВидДвиженияНакопления.Расход, 0);
			ЗаписатьДвижения(Организация,Выборка,ВидДвиженияНакопления.Приход, Выборка.КонечныеПоказания);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Проверяем на заполнение обязательные реквизиты.
//
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(ЭтотОбъект, Отказ);
	
	// Укажем, что надо проверить.
	СтруктураРеквизитов = Новый Структура();
	СтруктураРеквизитов.Вставить("ТипСчетчика");
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураРеквизитов, Отказ
	, "Проверка заполнения обязательных реквизитов документа ""Ввод показаний счетчика"".");
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, Режим)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	// Проверим правильность заполнения шапки документа.
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	Если ЗаполнитьТаблицуСчетчиковВРучную Тогда
		
		СтруктураПолей = Новый Структура;
		
		Если НЕ ЗначениеЗаполнено(Улица) Тогда
			СтруктураПолей.Вставить("Улица" ,"Улица");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(Дом) Тогда
			СтруктураПолей.Вставить("Дом" ,"Дом");
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(ЛицевойСчет) И ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный Тогда
			СтруктураПолей.Вставить("ЛицевойСчет" ,"ЛицевойСчет");
		КонецЕсли; 
		
		СтруктураПолей.Вставить("Счетчик"                    , "Счетчик");
		СтруктураПолей.Вставить("Услуга"                     , "Услуга");
		
		РезультатЗапросаПоПоказаниям = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "ПоказанияПоСчетчикам", СтруктураПолей);
		ТаблицаПоказаний          = РезультатЗапросаПоПоказаниям.Выгрузить();
		
		ПроверкаРеквизитовТЧ(ТаблицаПоказаний, СтруктураПолей, Отказ, Заголовок);
		
	КонецЕсли; 
	
	Если НЕ Отказ Тогда
		
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоказаний, Отказ, Заголовок);
		
	КонецЕсли;
	
КонецПроцедуры


Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	ВидОперации        = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний;
	ТипСчетчика        = Перечисления.бит_ТипСчетчика.Индивидуальный;
	ПоказанияНаселения = Истина;
	Ответственный      = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Обходим строки и проверяем превышение разрядности.
	Для Индекс = 0 по ПоказанияПоСчетчикам.Количество()-1 Цикл
		СтрокаПоказаний = ПоказанияПоСчетчикам.Получить(Индекс);
		Если СтрокаПоказаний.ТекущиеПоказания > СтрокаПоказаний.Разрядность Тогда
			Сообщение = Новый СообщениеПользователю();
			НомерСтроки = Индекс + 1;
			Сообщение.Текст = "В строке " + НомерСтроки + " текущие показания превышают разрядность счетчика.";
			Сообщение.Поле	= "ПоказанияПоСчетчикам[" + Индекс + "].ТекущиеПоказания";
			Сообщение.УстановитьДанные(ЭтотОбъект);
			Сообщение.Сообщить();
			Отказ = Истина;
		КонецЕсли;
	КонецЦикла;

КонецПроцедуры


// БИТ ЖКХ 07.04.2021
//  Процедура выполняет заполнение таблицы показаний по списку счетчиков
//
Процедура ЗаполнитьТаблицуПоказанийПоСпискуСчетчиков(СписокСчетчиков, СортироватьПоНомеруКвартиры = ложь) Экспорт
	
	колвоМесяцевПодкрутки = 0;
	
	ОбновитьПараметрыЖКХ();
	
	ПоказанияПоСчетчикам.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("ТипСчетчика", ТипСчетчика);
	
	мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив;
	
    //4.11.2018
	Если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив Тогда
		//22.02.2019
		мКоличествоМесяцевПодкрутки = 6;
	КонецЕсли;
	
	
	Запрос.УстановитьПараметр("КолМесяцевПодкрутка", мКоличествоМесяцевПодкрутки);
	
	Если мКоличествоМесяцевПодкрутки = 0 Тогда
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Дата));
		Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Дата));
		
	Иначе
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДобавитьМесяц(Дата, -мКоличествоМесяцевПодкрутки)));
		Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ДобавитьМесяц(Дата, -1)));
		
	КонецЕсли; 
	
	ТекстУсловия = "ТипСчетчика = &ТипСчетчика";
	
	Если ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
		
		Если Не Дом = Справочники.бит_СписокЗданий.ПустаяСсылка() Тогда    // по дому.
			Запрос.УстановитьПараметр("Объект",Дом);
			ТекстУсловия = ТекстУсловия + " И Объект = &Объект";
		ИначеЕсли НЕ Улица = Справочники.бит_СписокУлиц.ПустаяСсылка() Тогда    // по улице.
			Запрос.УстановитьПараметр("Улица",Улица);
			ТекстУсловия = ТекстУсловия + " И Объект.Улица = &Улица"
		// БИТ ЖКХ 19.10.2020	
		ИначеЕсли СортироватьПоНомеруКвартиры = истина И НЕ Квартира = Справочники.бит_Квартиры.ПустаяСсылка() Тогда    // по квартире.
			Запрос.УстановитьПараметр("Квартира", Квартира);
			ТекстУсловия = ТекстУсловия + " И Объект.Квартира = &Квартира"
		КонецЕсли;
		
	Иначе
		
		Если НЕ ЛицевойСчет = Справочники.бит_ЛицевыеСчета.ПустаяСсылка() Тогда // по лицевому счету.
			Запрос.УстановитьПараметр("Объект",ЛицевойСчет);
			ТекстУсловия = ТекстУсловия + " И Объект = &Объект";
		ИначеЕсли Не Дом = Справочники.бит_СписокЗданий.ПустаяСсылка() Тогда    // по дому.
			Запрос.УстановитьПараметр("Здание",Дом);
			ТекстУсловия = ТекстУсловия + " И Объект.Здание = &Здание";
		ИначеЕсли НЕ Улица = Справочники.бит_СписокУлиц.ПустаяСсылка() Тогда    // по улице.
			Запрос.УстановитьПараметр("Улица",Улица);
			ТекстУсловия = ТекстУсловия + " И Объект.УлицаЛицевогоСчета = &Улица"
		КонецЕсли;	
		// БИТ ЖКХ 26.10.2020	
		Если СортироватьПоНомеруКвартиры = истина тогда
			Если НЕ Улица = Справочники.бит_СписокУлиц.ПустаяСсылка() И 
				  Не Дом = Справочники.бит_СписокЗданий.ПустаяСсылка() И
				   НЕ Квартира = Справочники.бит_Квартиры.ПустаяСсылка() Тогда    // по квартире.
				Запрос.УстановитьПараметр("Квартира", Квартира);
				ТекстУсловия = ТекстУсловия + " И Объект.Квартира = &Квартира"
			КонецЕсли;
		конецесли;
		
	КонецЕсли;
	Запрос.УстановитьПараметр("СписокСчетчиков", СписокСчетчиков);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Объект КАК Объект,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга КАК Услуга,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик КАК Счетчик,
