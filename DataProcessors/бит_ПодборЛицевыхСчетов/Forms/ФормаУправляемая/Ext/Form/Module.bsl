	Если СписокУлиц.Количество() > 0 И Объект.Улица.Пустая() Тогда
		
		Объект.Улица = СписокУлиц[0].Значение;
		
	КонецЕсли; 
	
	бит_ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(СписокЛицевыхСчетов,
	"Улица",
	Объект.Улица,
	НЕ Объект.Улица.Пустая(),
	ВидСравненияКомпоновкиДанных.Равно);
	
	бит_ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(СписокЛицевыхСчетов,
	"Здание");
	
	бит_ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(СписокЛицевыхСчетов,
	"Квартира");
	
