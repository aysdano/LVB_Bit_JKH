	Д2 = ТекущаяДата();
	Сообщить("Подговтока таблиц = "+ (д2-д1)+ " сек.");
	
	
	Пока ВыборкаЗдания.Следующий()и Сч<Счетчик  Цикл
		Если НаборП<>Неопределено тогда
