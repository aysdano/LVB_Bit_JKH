	|		ПО ОборотыИОстатки.УслугаЖКХ = НачисленияПоЛицевым.УслугаЖКХ";
	ЗапросДанныеКапРемонт.УстановитьПараметр("Период",Период);
	//ЗапросДанныеКапРемонт.УстановитьПараметр("НачалоПериода",НачалоПериода);
	ЗапросДанныеКапРемонт.УстановитьПараметр("Услуга",Услуга);
	ЗапросДанныеКапРемонт.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	ЗапросДанныеКапРемонт.УстановитьПараметр("ТипКвартиры",ТипКвартиры);
	ЗапросДанныеКапРемонт.УстановитьПараметр("СтатусКвартиры",СтатусКвартиры);
	//ЗапросДанныеКапРемонт.УстановитьПараметр("РежимПотребления",РежимПотребления);
	РезультатЗапроса = ЗапросДанныеКапРемонт.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда 
		Возврат Истина;
	Иначе 
		Возврат РезультатЗапроса;
	КонецЕсли;
	
	//Иначе 
	//	Возврат Ложь;
	//КонецЕсли;
	
