
#Область ОбщиеПроцедурыИФункции

&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Список цифр
	СписокЦифр = Новый СписокЗначений;
	
	Для Значение = 48 По 57 Цикл
		
		СписокЦифр.Добавить(Значение);	
		
	КонецЦикла;
	
	// Буквы русского,англиского алфавита, 
	СписокКодовБукв = Новый СписокЗначений;
	
	Для Значение = 1040 По 1103 Цикл
		
		СписокКодовБукв.Добавить(Значение);
		
	КонецЦикла;
	
	Для Значение = 65 По 90 Цикл
		
		СписокКодовБукв.Добавить(Значение);
		
	КонецЦикла;
	
	Для Значение = 97 По 122 Цикл
		
		СписокКодовБукв.Добавить(Значение);
		
	КонецЦикла;
	
	СписокКодовБукв.Добавить(45);
	СписокКодовБукв.Добавить(47);
	СписокКодовБукв.Добавить(95);
	СписокКодовБукв.Добавить(33);
	СписокКодовБукв.Добавить(32);
	СписокКодовБукв.Добавить(46);
	СписокКодовБукв.Добавить(44);
	
	КэшированныеЗначения.Вставить("СписокЦифр"     , СписокЦифр);
	КэшированныеЗначения.Вставить("СписокКодовБукв", СписокКодовБукв);
	КэшированныеЗначения.Вставить("ЭтоНовый"       , ?(Параметры.Ключ.Пустая(), Истина, Ложь));
	
	КэшированныеЗначения.Вставить("ТипКвартиры", Неопределено);
	
КонецПроцедуры

// Процедура устанавливает отборы 
//
&НаСервере
Процедура УстановитьОтборы()
	
	СведенияОКвартире.Отбор.Элементы.Очистить();
	
	Эл = СведенияОКвартире.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Квартира");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = Объект.Ссылка;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	Если ЗначениеЗаполнено(НаДату) Тогда
		
		Эл = СведенияОКвартире.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Период");
		Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		Эл.ПравоеЗначение   = НаДату;
		Эл.Использование    = Истина;
		Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура расчета различных типов площадей для сравнения и контроля аналогичных в справочнике Квартиры.
//
&НаСервере
Процедура ПосчитатьПлощади()
	
	ТабличноеПолеПлощадей.Очистить();
	
	Массив = Новый Массив;
	
	Массив.Вставить(0,"Общая площадь");
	Массив.Вставить(1,"Жилая площадь");
	Массив.Вставить(2,"МОП площадь");
	Массив.Вставить(3,"Отапливаемая площадь");
	Массив.Вставить(4,"Совокупная площадь");
	
	Площадь = Новый Массив(5);
	
	Для Счетчик = 0 По 4  Цикл
		
		Площадь[Счетчик] = 0;
		
	КонецЦикла; 
	
	СписокКомнат = ПолучитьСписокКомнат(Объект.Ссылка, НаДату);
	
	Для каждого СтрокаТЧ Из СписокКомнат Цикл
		
		Строка = СтрокаТЧ.Комната.ЧастьПомещения;
		
		Если Строка.КоэффициентНачислений <> 0 Тогда
			
			// Отапливаемая
			Площадь[3] = Площадь[3] + СтрокаТЧ.Площадь;
			
			Если Строка.Принадлежность = Перечисления.бит_ПринадлежностьКомнат.Внутренняя Тогда
				
				// Общая
				Площадь[0] = Площадь[0] + СтрокаТЧ.Площадь;
				
				Если Строка.ТипКомнаты = Справочники.бит_ТипыКомнат.Жилая Тогда
					
					// Жилая
					Площадь[1] = Площадь[1] + СтрокаТЧ.Площадь;
					
				КонецЕсли;	
				
			КонецЕсли;
			
		КонецЕсли;	
		
		Если Строка.ТипКомнаты = Справочники.бит_ТипыКомнат.МОП Тогда
			
			// МОП
			Площадь[2] = Площадь[2] + СтрокаТЧ.Площадь;
			
		КонецЕсли;
		
		// Совокупная
		Площадь[4] = Площадь[4] + СтрокаТЧ.Площадь;
		
	КонецЦикла;                                                                    
	
	ПлощадиКвартиры = ВывестиПлощадиКвартиры(Объект.Ссылка, НаДату);
	
	Если ЗначениеЗаполнено(ПлощадиКвартиры) Тогда
		
		Для Счетчик = 0 По 4 Цикл
			
			НоваяСтрока = ТабличноеПолеПлощадей.Добавить();
			
			НоваяСтрока.ВидыПлощадей    = Массив[Счетчик]; 
			НоваяСтрока.ПлощадиКвартиры = ПлощадиКвартиры[Счетчик];
			НоваяСтрока.ПлощадиКомнат   = Площадь[Счетчик];
			
		КонецЦикла;
		
	ИначеЕсли НЕ мКэшЗначений.ЭтоНовый Тогда
		
		// БИТ_ЖКХ 02.03.2015{{
		// Сообщить("Нет исходных данных по площадям квартиры! Проверьте регистр сведений ""Сведения о квартире""",СтатусСообщения.Важное);
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Нет исходных данных по площадям квартиры! Проверьте регистр сведений ""Сведения о квартире""";
		Сообщение.Сообщить();
		// БИТ_ЖКХ 02.03.2015}}
		
	КонецЕсли;
	
КонецПроцедуры

// Функция формирования списка комнат квартиры на дату.
&НаСервереБезКонтекста
Функция ПолучитьСписокКомнат(Знач НомерКвартиры, Знач НаДату)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_СведенияОКомнатеСрезПоследних.Комната,
	|	бит_СведенияОКомнатеСрезПоследних.Площадь
	|ИЗ
	|	РегистрСведений.бит_СведенияОКомнате.СрезПоследних(&Момент, Комната.Владелец = &Владелец) КАК бит_СведенияОКомнатеСрезПоследних"; 
	
	Запрос.УстановитьПараметр("Владелец", НомерКвартиры);
	Запрос.УстановитьПараметр("Момент"  , НаДату);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Функция формирования структуры из площадей квартиры.
//
// Параметры
//  <НомерКвартиры>  - ссылка на квартиру
//                 в регистре сведений.
//
// Возвращаемое значение:
//  <ИскомыйРезультат.Структура> - набор данных по площадям.
//
&НаСервереБезКонтекста
Функция ВывестиПлощадиКвартиры(Знач НомерКвартиры, Знач НаДату)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&ТекущаяДата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	
	Запрос.УстановитьПараметр("Квартира"   , НомерКвартиры);
	Запрос.УстановитьПараметр("ТекущаяДата", НаДату);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Отбор = Новый Структура();
	
	Отбор.Вставить("Квартира",НомерКвартиры);
	
	Строки = Результат.НайтиСтроки(Отбор);
	
	Если Строки.Количество() > 0 Тогда
		
		ИскомыйРезультат = Новый Массив;
		
		ИскомыйРезультат.Вставить(0,Строки[0].ОбщаяПлощадь);
		ИскомыйРезультат.Вставить(1,Строки[0].ЖилаяПлощадь);
		ИскомыйРезультат.Вставить(2,Строки[0].МОП);
		ИскомыйРезультат.Вставить(3,Строки[0].ОтапливаемаяПлощадь);
		ИскомыйРезультат.Вставить(4,Строки[0].СовокупнаяПлощадь);
		
	Иначе
		
		ИскомыйРезультат = Неопределено;
		
	КонецЕсли;
	
	Возврат  ИскомыйРезультат;
	
КонецФункции 

