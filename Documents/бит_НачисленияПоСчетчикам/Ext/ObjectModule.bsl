#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем мУчетДнейПроживания Экспорт; // Хранит флаг настройки ЖКХ.

Перем мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика Экспорт; // Хранит флаг настройки ЖКХ.

Перем мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика Экспорт; // Хранит флаг настройки ЖКХ.

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункцииДокумента

Процедура ОбновитьПараметрыЖКХ() Экспорт
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("НачислениеСУчетомДнейПроживания"         , Ложь);
	ПараметрыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика"         , Ложь);
	
	ПараметрыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика"         , Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Дата), Организация, ПараметрыЖКХ);
	
	мУчетДнейПроживания   = ПараметрыЖКХ.НачислениеСУчетомДнейПроживания;
	
	мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика = ПараметрыЖКХ.РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика;
	
	мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика = ПараметрыЖКХ.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика;
	
КонецПроцедуры

// Процедура заполняет данными ТЧ "Начисления".
//
Процедура РассчитатьНачисленияПоСчетчикам() Экспорт
	
	ОбновитьПараметрыЖКХ() ;
	
	Начисления.Очистить();
	
	ТабНачисления    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
	ТабРаспределения = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуРаспредилений();
	
	СписокЛС     = Новый Массив;
	СписокЗданий = Новый Массив;
	
	СписокЗданий.Добавить(Здание);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Здание = &Здание
	|	И бит_ЛицевыеСчета.УлицаЛицевогоСчета = &УлицаЛицевогоСчета";
	Запрос.УстановитьПараметр("УлицаЛицевогоСчета", Улица);
	Запрос.УстановитьПараметр("Здание"            , Здание);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокЛС = Результат.ВыгрузитьКолонку("ЛицевойСчет");
	
	бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(Дата, 
	Организация, 
	СписокЛС, 
	СписокЗданий, 
	, 
	, 
	, 
	ТабНачисления,
	ТабРаспределения,
	,
	,
	,
	мУчетДнейПроживания,
	,
	,
	,
	,
	мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика,
	мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика);
	
	ТабНачисления.Сортировать("ЛицевойСчет ВОЗР, Услуга ВОЗР");
	
	бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТабНачисления);
	бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТабРаспределения);
	
	ЗаполнениеСчетовКУ(ТабНачисления);
	ЗаполнениеСчетовКУ(ТабРаспределения);
	
	Начисления.Загрузить(ТабНачисления);
	Распределения.Загрузить(ТабРаспределения);
	
КонецПроцедуры

// Процедура заполняет данными ТЧ "НачисленияПоРаспределениям".
//
Процедура РассчитатьНачисленияПоРаспределениям() Экспорт
	
	ТабРаспределения = Распределения.Выгрузить(); 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Улица",Улица);
	Запрос.УстановитьПараметр("Здание",Здание);
	Запрос.УстановитьПараметр("Организация",Организация);
	
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Услуги.ЛицевойСчет,
	|	Показания.Объект КАК Объект,
	|	Показания.Распределение КАК Распределение,
	|	ЕСТЬNULL(Показания.КоличествоЕдиниц, 0) КАК КоличествоЕдиниц,
	|	Услуги.Квартира,
	|	Показания.Услуга КАК Услуга,
	|	ЕСТЬNULL(Услуги.ОбщаяПлощадь, 0) КАК ОбщаяПлощадь,
	|	ЕСТЬNULL(Услуги.ЖилаяПлощадь, 0) КАК ЖилаяПлощадь,
	|	ЕСТЬNULL(Услуги.ОтапливаемаяПлощадь, 0) КАК ОтапливаемаяПлощадь,
	|	ЕСТЬNULL(Услуги.КоличествоЕдиницПотребления, 0) КАК ЕдиницыПотребления,
	|	Услуги.ФизЛицо КАК ФизЛицо,
	|	Показания.Услуга.ОсновнойСпособРасчета КАК ОсновнойСпособРасчета,
	|	Услуги.РежимПотребления,
	|	Услуги.Поставщик,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади)
	|				ТОГДА ЕСТЬNULL(Услуги.ОтапливаемаяПлощадь, 0) * ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0)
	|			ИНАЧЕ ВЫБОР
	|					КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади)
	|						ТОГДА ЕСТЬNULL(Услуги.ОбщаяПлощадь, 0) * ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0)
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади)
	|								ТОГДА ЕСТЬNULL(Услуги.ЖилаяПлощадь, 0) * ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0)
	|							ИНАЧЕ ВЫБОР
	|									КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоПроживающим)
	|										ТОГДА Услуги.ФизЛицо * ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0)
	|									ИНАЧЕ ВЫБОР
	|											КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления)
	|													ИЛИ Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет)
	|												ТОГДА ЕСТЬNULL(Услуги.КоличествоЕдиницПотребления, 0) * ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0)
	|										КОНЕЦ
	|								КОНЕЦ
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОНЕЦ, 0) КАК ДоляЛС,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади)
	|				ТОГДА ЕСТЬNULL(Услуги.ОтапливаемаяПлощадь, 0)
	|			ИНАЧЕ ВЫБОР
	|					КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади)
	|						ТОГДА ЕСТЬNULL(Услуги.ОбщаяПлощадь, 0)
	|					ИНАЧЕ ВЫБОР
	|							КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади)
	|								ТОГДА ЕСТЬNULL(Услуги.ЖилаяПлощадь, 0)
	|							ИНАЧЕ ВЫБОР
	|									КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоПроживающим)
	|										ТОГДА Услуги.ФизЛицо
	|									ИНАЧЕ ВЫБОР
	|											КОГДА Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления)
	|													ИЛИ Показания.Услуга.ОсновнойСпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет)
	|												ТОГДА ЕСТЬNULL(Услуги.КоличествоЕдиницПотребления, 0)
	|										КОНЕЦ
	|								КОНЕЦ
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОНЕЦ, 0) КАК ПоЛС,
	|	ЕСТЬNULL(Услуги.ПлановаяСтавка, 0) КАК ПлановаяСтавка,
	|	ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0) КАК Ставка,
	|	ЕСТЬNULL(Услуги.НормаЛьгота, 0) * ЕСТЬNULL(Услуги.ОсновнаяСтавка, 0) КАК Норматив,
	|	Услуги.КоличествоПроживающих,
	|	Услуги.КоличествоПроживающихНорма,
	|	ЕСТЬNULL(Услуги.НормаЛьгота, 0) КАК НормаЛьготы,
	|	Услуги.КоличествоПроживающихВсего
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|		бит_РаспределенияОстатки.СуммаОстаток КАК КоличествоЕдиниц,
	|		бит_РаспределенияНаУслугахСрезПоследних.Использовать КАК Использовать,
	|		бит_РаспределенияНаУслугахСрезПоследних.Услуга КАК Услуга,
	|		бит_РаспределенияНаУслугахСрезПоследних.Распределение КАК Распределение,
	|		бит_РаспределенияНаУслугахСрезПоследних.Объект КАК Объект
	|	ИЗ
	|		РегистрСведений.бит_РаспределенияНаУслугах.СрезПоследних(
	|				&Дата,
	|				ЛицевойСчет.Организация = &Организация
	|					И ЛицевойСчет.УлицаЛицевогоСчета = &Улица
	|					И ЛицевойСчет.Здание = &Здание
	|					И Объект = &Здание) КАК бит_РаспределенияНаУслугахСрезПоследних
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_Распределения.Остатки(&Дата, Объект = &Здание) КАК бит_РаспределенияОстатки
	|			ПО бит_РаспределенияНаУслугахСрезПоследних.Объект = бит_РаспределенияОстатки.Объект
	|				И бит_РаспределенияНаУслугахСрезПоследних.Услуга = бит_РаспределенияОстатки.Услуга
	|				И бит_РаспределенияНаУслугахСрезПоследних.Распределение = бит_РаспределенияОстатки.Распределение
	|	ГДЕ
	|		бит_РаспределенияНаУслугахСрезПоследних.Использовать = ИСТИНА
	|	
	|	СГРУППИРОВАТЬ ПО
	|		бит_РаспределенияНаУслугахСрезПоследних.Использовать,
	|		бит_РаспределенияНаУслугахСрезПоследних.Услуга,
	|		бит_РаспределенияНаУслугахСрезПоследних.Распределение,
	|		бит_РаспределенияНаУслугахСрезПоследних.Объект,
	|		бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет,
	|		бит_РаспределенияОстатки.СуммаОстаток) КАК Показания
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ РАЗЛИЧНЫЕ
	|			Квартиры.ЛицевойСчет КАК ЛицевойСчет,
	|			Квартиры.Квартира КАК Квартира,
	|			Квартиры.РежимПотребления КАК РежимПотребления,
	|			Квартиры.Поставщик КАК Поставщик,
	|			Квартиры.СпособРасчета КАК СпособРасчета,
	|			Квартиры.ОбщаяПлощадь КАК ОбщаяПлощадь,
	|			Квартиры.ЖилаяПлощадь КАК ЖилаяПлощадь,
	|			Квартиры.ОтапливаемаяПлощадь КАК ОтапливаемаяПлощадь,
	|			Квартиры.ТипКвартиры КАК ТипКвартиры,
	|			Квартиры.СтатусКвартиры КАК СтатусКвартиры,
	|			КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК ФизЛицо,
	|			бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка КАК ОсновнаяСтавка,
	|			Квартиры.Услуга КАК Услуга,
	|			Квартиры.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления,
	|			бит_СтавкиНаУслугиСрезПоследних.ПлановаяСтавка КАК ПлановаяСтавка,
	|			ВЫБОР
	|				КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) = 1
	|					ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаОдного, 0)
	|				ИНАЧЕ ВЫБОР
	|						КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) = 2
	|							ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаДвоих, 0) + ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) > 2
	|									ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаСемью, 0) + ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0)
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ * КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) + ВЫБОР
	|				КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) = 1
	|						И бит_НормыНаУслугиСрезПоследних.ИспользоватьДопНормуНаОдного
	|					ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0) + ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0)
	|				ИНАЧЕ ВЫБОР
	|						КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) = 2
	|							ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) > 2
	|									ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0)
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ * КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК Норма,
	|			ВЫБОР
	|				КОГДА Квартиры.КоличествоПроживающихНорма = 1
	|					ТОГДА ВЫБОР
