&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	Если Параметры.Свойство("ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков") Тогда
		
		СписокЛСИзХран             = ПолучитьИзВременногоХранилища(Параметры.ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков.СписокЛСАдресХран);			
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда			
			
			Объект.ВидОперации   = Параметры.ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков.ВидОперации;
			Объект.Дата          = Параметры.ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков.Дата;
			Объект.Ответственный = Параметры.ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков.Ответственный;
			Объект.Документ      = Параметры.ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков.Документ;
			
			СписокЛС             = СписокЛСИзХран;		
			
			МассивНачислений     = Параметры.ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков.МассивНачислений;
			
			Если МассивНачислений <> Неопределено Тогда
				
				Для каждого Строка Из МассивНачислений Цикл
					
					НоваяСтрока = Объект.ЛицевыеСчета.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
					
				КонецЦикла;
				
			КонецЕсли;
			
			Элементы.Дата.Доступность = Ложь;
			
			Колонки = Новый Массив;
			
			Для Каждого Реквизит Из Метаданные.Документы.бит_РазовыеПоУслугамЖКХ.ТабличныеЧасти.ЛицевыеСчета.Реквизиты Цикл
				
				Колонки.Добавить(Реквизит.Имя);
				
			КонецЦикла;
			
			бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(Объект.ЛицевыеСчета, Колонки, СписокЛС, Объект.Организация , Объект.Дата);
			
		КонецЕсли;
		
	ИначеЕсли Параметры.Свойство("ЗаполнитьИзСправочникаЛицевыеСчета") Тогда
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда			
			
			// Заполнение из справочника ЛицевыеСчета.
			Объект.Организация      = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Организация;
			Объект.ЛицевойСчет      = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ЛицевойСчет;
			
			Колонки = Новый Массив;
			
			Для Каждого Реквизит Из Метаданные.Документы.бит_РазовыеПоУслугамЖКХ.ТабличныеЧасти.ЛицевыеСчета.Реквизиты Цикл
				
				Колонки.Добавить(Реквизит.Имя);
				
			КонецЦикла;
			
			бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(Объект.ЛицевыеСчета, Колонки, СписокЛС, Объект.Организация , Объект.Дата);
			
		КонецЕсли;	
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		НеСоздаватьДокумент = ДокументОбъект.мНеСоздДокумент;
		
		Если НеСоздаватьДокумент Тогда
			
			Отказ = Истина;
			
			Возврат;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(Объект.Ссылка, Отказ);
	
КонецПроцедуры

