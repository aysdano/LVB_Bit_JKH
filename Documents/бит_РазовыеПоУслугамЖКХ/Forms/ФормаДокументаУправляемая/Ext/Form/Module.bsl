			|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета
			|ПОМЕСТИТЬ ВТ
			|ИЗ
			|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_СведенияПоУслугамЛССрезПоследних
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	бит_СтавкиНаУслугиСрезПоследних.Тариф,
			|	бит_СтавкиНаУслугиСрезПоследних.Период КАК Период,
			|	ВТ.Период КАК Период1,
			|	ВТ.ЛицевойСчет,
			|	ВТ.Услуга,
			|	ВТ.РежимПотребления,
			|	ВТ.Поставщик,
			|	ВТ.Использовать,
			|	ВТ.СпособРасчета
			|ИЗ
			|	ВТ КАК ВТ
			|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&Дата, ) КАК бит_СтавкиНаУслугиСрезПоследних
			|		ПО бит_СтавкиНаУслугиСрезПоследних.Услуга = ВТ.Услуга
			|			И бит_СтавкиНаУслугиСрезПоследних.РежимПотребления = ВТ.РежимПотребления
			|			И бит_СтавкиНаУслугиСрезПоследних.СпособРасчета = ВТ.СпособРасчета
			|ГДЕ
			|	бит_СтавкиНаУслугиСрезПоследних.Услуга = &Услуга
			|	И бит_СтавкиНаУслугиСрезПоследних.СпособРасчета = &ПоСчетчикам
			|	И бит_СтавкиНаУслугиСрезПоследних.ТипКвартиры = &Тип
			|	И бит_СтавкиНаУслугиСрезПоследних.СтатусКвартиры = &Статус
			|
			|УПОРЯДОЧИТЬ ПО
			|	Период";
			
			Запрос.УстановитьПараметр("Дата", Объект.КонПериода);
