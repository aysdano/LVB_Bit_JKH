Функция ПоказатьВременнуюТаблицу(МенеджерВременныхТаблицИлиЗапрос, ИмяВременнойТаблицы) Экспорт
	
	ЗакрытьМенеджерВременныхТаблиц = Ложь;
	
	Если ТипЗнч(МенеджерВременныхТаблицИлиЗапрос) = Тип("Запрос") Тогда
		Если МенеджерВременныхТаблицИлиЗапрос.МенеджерВременныхТаблиц = Неопределено Тогда
			МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
			ЗакрытьМенеджерВременныхТаблиц = Истина;
			МенеджерВременныхТаблицИлиЗапрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
		Иначе
			МенеджерВременныхТаблиц = МенеджерВременныхТаблицИлиЗапрос.МенеджерВременныхТаблиц;
		КонецЕсли;
		МенеджерВременныхТаблицИлиЗапрос.Выполнить();
	Иначе
		МенеджерВременныхТаблиц = МенеджерВременныхТаблицИлиЗапрос;
	КонецЕсли;
	
	ДанныеТаблицы = ЗапросВыполнитьВыгрузить("ВЫБРАТЬ * ИЗ " + ИмяВременнойТаблицы,, МенеджерВременныхТаблиц);
	
	Если ЗакрытьМенеджерВременныхТаблиц Тогда
		МенеджерВременныхТаблиц.Закрыть();
		МенеджерВременныхТаблицИлиЗапрос.МенеджерВременныхТаблиц = Неопределено;
	КонецЕсли;
	
	Возврат ДанныеТаблицы;
	
КонецФункции


Процедура НапечататьQRКодИзмененный(РасчетныйСчетСсылка,РасчетныйСчет,ПолучательПлатежа,ТабДок, ОбластьQRКод = Неопределено)
	
	Если МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент 
		ИЛИ МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32
		ИЛИ МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК43
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК43 
		ИЛИ МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924
		ИЛИ МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ Тогда 
		СведенияОПолучателе   = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ЭтотОбъект.ПолучательПлатежа, ЭтотОбъект.ДатаПечатиКвитанций, ЭтотОбъект.РС);
	Иначе	
		СведенияОПолучателе   = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ЭтотОбъект.Организация, ЭтотОбъект.ДатаПечатиКвитанций, ЭтотОбъект.РС);
	КонецЕсли;
	
	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") Тогда
		ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Истина,РасчетныйСчетСсылка).Выгрузить();
	Иначе
		ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Ложь,РасчетныйСчетСсылка).Выгрузить();
	КонецЕсли;
	
	
	ФИО		= Строка(мСтруктураДанных.ЛицевойСчетФИО);
	Фамилия	= ВыделитьСлово(ФИО);
	Имя		= ВыделитьСлово(ФИО);
	Отчество= ВыделитьСлово(ФИО);
	
	РеквизитыПлатежа					= НоваяСтруктураРеквизитыПлатежаУФЭБС();
	РеквизитыПлатежа.ИННПлательщика		= ?(ЗначениеЗаполнено(мСтруктураДанных.ЛицевойСчетФИО), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(мСтруктураДанных.ЛицевойСчетФИО,"ИНН"), "");
	РеквизитыПлатежа.НомерСчетаПолучателя		= РасчетныйСчет;
	Если ДанныеОПолучателеПлатежа.Количество() > 0 Тогда
		РеквизитыПлатежа.ТекстПолучателя 			= ДанныеОПолучателеПлатежа[0].Наименование;
		РеквизитыПлатежа.НаименованиеБанкаПолучателя = ДанныеОПолучателеПлатежа[0].Банк;
		РеквизитыПлатежа.БИКБанкаПолучателя			=  ДанныеОПолучателеПлатежа[0].БИК;
		РеквизитыПлатежа.СчетБанкаПолучателя		= ДанныеОПолучателеПлатежа[0].КоррСчет;
		РеквизитыПлатежа.ИННПолучателя				= ДанныеОПолучателеПлатежа[0].ИНН;
		РеквизитыПлатежа.КПППолучателя				= ДанныеОПолучателеПлатежа[0].КПП;
	Иначе
		РеквизитыПлатежа.ТекстПолучателя 			= "";
		РеквизитыПлатежа.НаименованиеБанкаПолучателя = "";
		РеквизитыПлатежа.БИКБанкаПолучателя			=  "";
		РеквизитыПлатежа.СчетБанкаПолучателя		= "";
		РеквизитыПлатежа.ИННПолучателя				= "";
		РеквизитыПлатежа.КПППолучателя				= "";
	КонецЕсли;
	
	РеквизитыПлатежа.НомерЛицевогоСчетаПлательщика	= мСтруктураДанных.ЛицевойСчет;
	
	МассивРеквизитов =  ТаблицаРеквизитовQRКода.Выгрузить(Новый Структура("Выводить", Истина)).ВыгрузитьКолонку("Реквизит");
	Для Каждого Элт Из РеквизитыПлатежа Цикл
		Если МассивРеквизитов.Найти(Элт.Ключ) = Неопределено Тогда
			РеквизитыПлатежа[Элт.Ключ] = Неопределено;
		КонецЕсли;	
	КонецЦикла;
	
	// QR-код.
	QRСтрока = УправлениеПечатью.ФорматнаяСтрокаУФЭБС(РеквизитыПлатежа);
	
	Если НЕ ПустаяСтрока(QRСтрока) Тогда // Возникли ошибки
		
		ДанныеQRКода = УправлениеПечатью.ДанныеQRКода(QRСтрока, 0, 190);
		Если НЕ ТипЗнч(ДанныеQRКода) = Тип("ДвоичныеДанные") Тогда
			ТекстСообщения = Нстр("ru = 'Не удалось сформировать QR-код для документа.
			|Технические подробности см. в журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		Если НЕ ОбластьQRКод = Неопределено Тогда
			Попытка
				ОбластьQRКод.Рисунки.QRКод.Картинка =  Новый Картинка(ДанныеQRКода);
				ТабДок.Вывести(ОбластьQRКод);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			Для Каждого Рис Из ТабДок.Рисунки Цикл
				Если НЕ СтрНайти(НРег(Рис.Имя), "qrкод") = 0 Тогда
					Рис.Картинка = Новый Картинка(ДанныеQRКода);
				КонецЕсли;
			КонецЦикла;	
		Исключение
		КонецПопытки
	Иначе
		УбратьQRКод(ТабДок);
	КонецЕсли;
	
КонецПроцедуры


Функция ПолучитьПлощадьПоЛС(ЛицевойСчет,Период,Услуга)
	
	Запрос = Новый Запрос;
	Запрос.Текст =  
	"ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Период, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	Запрос.УстановитьПараметр("Квартира",ЛицевойСчет.Квартира);
	Запрос.УстановитьПараметр("Период",Период);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаЗапроса = РезультатЗапроса.Выбрать();
	Если ВыборкаЗапроса.Следующий()Тогда
		Возврат ВыборкаЗапроса.ОбщаяПлощадь;
	Иначе
		Возврат 0;
	КонецЕсли;
	
	
КонецФункции


Функция ЗапросВыполнитьВыгрузить(ТекстЗапроса, ПараметрыЗапроса = Неопределено, МенеджерВременныхТаблиц = Неопределено) Экспорт
	
	Запрос = Новый Запрос(ТекстЗапроса);
	
	Если МенеджерВременныхТаблиц <> Неопределено Тогда
		Запрос.МенеджерВременныхТаблиц = МенеджерВременныхТаблиц;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыЗапроса) Тогда
		Для Каждого Параметр Из ПараметрыЗапроса Цикл
			Запрос.УстановитьПараметр(Параметр.Ключ, Параметр.Значение);
		КонецЦикла;
	КонецЕсли;
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

