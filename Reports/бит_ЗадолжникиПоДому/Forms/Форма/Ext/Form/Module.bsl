
&НаСервере
Функция СформироватьНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	
	ТабДок.ПолеСверху = 2;
	ТабДок.ПолеСлева = 2;
	ТабДок.ПолеСнизу = 2;
	ТабДок.ПолеСправа = 2;
	Обработка = РеквизитФормыВЗначение("Объект");
	Макет = Обработка.ПолучитьМакет("МакетЗадолжникиПоДому");
	
	ОбластьШапкаТипыУслуг = Макет.ПолучитьОбласть("ШапкаТипыУслуг");
	ОбластьШапкаАдресПериод = Макет.ПолучитьОбласть("ШапкаАдресПериод");
	ОбластьШапкаТЧ = Макет.ПолучитьОбласть("ШапкаТЧ");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьСтрокаВсего = Макет.ПолучитьОбласть("ВсегоПоДому");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	СтрокаЗаголовок = "";
	
	Если ЗначениеЗаполнено(УслугаГруппаУслуг) Тогда

		
		Для Каждого Услуга ИЗ УслугаГруппаУслуг Цикл
			
			СтрокаЗаголовок = СтрокаЗаголовок + Услуга.Значение + "; ";
			 
		КонецЦикла;
		
		
	Иначе
		
		СтрокаЗаголовок = " все услуги";
		
	КонецЕсли;
	
	ОбластьШапкаТипыУслуг.Параметры.ТипыУслуг =    СтрокаЗаголовок;

	Данные = ПолучитьДанные();

	Подъезд = Неопределено;	
	Здание = Неопределено;
	ПерваяИтерация = Истина;
	
	ПредКвартира = Неопределено;
	
	ПлощадьВсего = 0;
	СальдоНачВсего = 0;
	НачисленоВсего = 0;
	ОплаченоВсего = 0;
	СальдоНаКонецВсего = 0;
	
	Для Каждого СтрокаД Из Данные Цикл
		
		Если ПоПодъездам И НЕ Подъезд = СтрокаД.Подъезд Тогда 
			Если Не ПерваяИтерация Тогда
				
				ОбластьСтрокаВсего.Параметры.ПлощадьВсегоПоДому		= ПлощадьВсего;
				ОбластьСтрокаВсего.Параметры.СальдоНаНачалоВсего	= СальдоНачВсего;		
				ОбластьСтрокаВсего.Параметры.НачисленоЗаМесяцВсего 	= НачисленоВсего;		
				ОбластьСтрокаВсего.Параметры.ОплаченоВсего			= ОплаченоВсего;
				ОбластьСтрокаВсего.Параметры.СальдоНаКонецВсего		= СальдоНаКонецВсего;
				
				ТабДок.Вывести(ОбластьСтрокаВсего);	
				ТабДок.Вывести(ОбластьПодвал);
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
				
				ПлощадьВсего = 0;
				СальдоНачВсего = 0;
				НачисленоВсего = 0;
				ОплаченоВсего = 0;
				СальдоНаКонецВсего = 0;

			КонецЕсли;
			
			ПерваяИтерация = Ложь;
			
			ОбластьШапкаАдресПериод.Параметры.Период = ПредставлениеМесяца(Месяц(Период.ДатаОкончания)) + " " + Формат(Период.ДатаОкончания, "ДФ=yyyy");
			ОбластьШапкаАдресПериод.Параметры.АдресДома = "" + СтрокаД.Здание + " подъезд " + СтрокаД.Подъезд;
			ТабДок.Вывести(ОбластьШапкаТипыУслуг);
			ТабДок.Вывести(ОбластьШапкаАдресПериод);
			ТабДок.Вывести(ОбластьШапкаТЧ);
			
			Подъезд = СтрокаД.Подъезд;
			Здание = СтрокаД.Здание;	

		ИначеЕсли НЕ Здание = СтрокаД.Здание Тогда
			
			Если Не ПерваяИтерация Тогда
				
				ОбластьСтрокаВсего.Параметры.ПлощадьВсегоПоДому		= ПлощадьВсего;
				ОбластьСтрокаВсего.Параметры.СальдоНаНачалоВсего	= СальдоНачВсего;		
				ОбластьСтрокаВсего.Параметры.НачисленоЗаМесяцВсего 	= НачисленоВсего;		
				ОбластьСтрокаВсего.Параметры.ОплаченоВсего			= ОплаченоВсего;
				ОбластьСтрокаВсего.Параметры.СальдоНаКонецВсего		= СальдоНаКонецВсего;
				
				ТабДок.Вывести(ОбластьСтрокаВсего);	
				ТабДок.Вывести(ОбластьПодвал);
				
				ПлощадьВсего = 0;
				СальдоНачВсего = 0;
				НачисленоВсего = 0;
				ОплаченоВсего = 0;
				СальдоНаКонецВсего = 0;

			КонецЕсли;
			
			ПерваяИтерация = Ложь;
			
			ОбластьШапкаАдресПериод.Параметры.Период = ПредставлениеМесяца(Месяц(Период.ДатаОкончания)) + " " + Формат(Период.ДатаОкончания, "ДФ=yyyy");
			ОбластьШапкаАдресПериод.Параметры.АдресДома = СтрокаД.Здание;
			ТабДок.Вывести(ОбластьШапкаТипыУслуг);
			ТабДок.Вывести(ОбластьШапкаАдресПериод);
			ТабДок.Вывести(ОбластьШапкаТЧ);
			
			Здание = СтрокаД.Здание;	
						
		КонецЕсли;
			
		ОбластьСтрока.Параметры.Квартира = СтрокаД.Квартира;
		ОбластьСтрока.Параметры.Площадь =   СтрокаД.Площадь;
		ОбластьСтрока.Параметры.СальдоНаНачало = СтрокаД.НачальныйОстаток;
		ОбластьСтрока.Параметры.НачисленоЗаМесяц =  СтрокаД.Начислено; 
		ОбластьСтрока.Параметры.Оплачено =   СтрокаД.Оплачено;
		ОбластьСтрока.Параметры.СальдоНаКонец =   СтрокаД.КонечныйОстаток;
		
		КоличествоМесяцевЗадолженности = 0;
					
		Если СтрокаД.КонечныйОстаток <> 0 И СтрокаД.Начислено <> 0 Тогда
			
			КМЗ = СтрокаД.КонечныйОстаток/СтрокаД.Начислено;
			
			КМЗ = Окр(КМЗ);
			
			КоличествоМесяцевЗадолженности =КМЗ;

		ИначеЕсли СтрокаД.Начислено = 0 ИЛИ НЕ ЗначениеЗаполнено(СтрокаД.Начислено) Тогда
			КоличествоМесяцевЗадолженности = "***";
		КонецЕсли;
		
		ОбластьСтрока.Параметры.КоличествоМесяцевЗадолженности = КоличествоМесяцевЗадолженности;
				
		ТабДок.Вывести(ОбластьСтрока);
		
		Если Не ПредКвартира = СтрокаД.Квартира Тогда
		
			ПлощадьВсего 	   = ПлощадьВсего + СтрокаД.Площадь;
		
		КонецЕсли;
		
		СальдоНачВсего     = СальдоНачВсего + СтрокаД.НачальныйОстаток;
		НачисленоВсего 	   = НачисленоВсего +  СтрокаД.Начислено;
		ОплаченоВсего	   = ОплаченоВсего + СтрокаД.Оплачено;
		СальдоНаКонецВсего = СальдоНаКонецВсего + СтрокаД.КонечныйОстаток;
		
		ПредКвартира = СтрокаД.Квартира;	
		
	КонецЦикла;
	
	Если НЕ (ПерваяИтерация) Тогда
		
	    ОбластьСтрокаВсего.Параметры.ПлощадьВсегоПоДому		= ПлощадьВсего;
		ОбластьСтрокаВсего.Параметры.СальдоНаНачалоВсего	= СальдоНачВсего;		
		ОбластьСтрокаВсего.Параметры.НачисленоЗаМесяцВсего 	= НачисленоВсего;		
		ОбластьСтрокаВсего.Параметры.ОплаченоВсего			= ОплаченоВсего;
		ОбластьСтрокаВсего.Параметры.СальдоНаКонецВсего		= СальдоНаКонецВсего;

		ТабДок.Вывести(ОбластьСтрокаВсего);
		ТабДок.Вывести(ОбластьПодвал);
		
	КонецЕсли;

	Возврат ТабДок;
КонецФункции

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если (ЗначениеЗаполнено(Адрес) Или (ЗначениеЗаполнено(Участок) И УчастокПодходит(Участок))) 
	И ЗначениеЗаполнено(Период) Тогда
		Результат = СформироватьНаСервере();
	Иначе
	 	Сообщить("Для формирования отчета необходимо установить отбор на период. И либо отбор на адрес, либо на подходящий участок");
	КонецЕсли;

КонецПроцедуры

