Функция ПолучитьМуниципальныйАдресБСП(объектЛицевойСчет = неопределено)
	
		СтруктураАдресРегистрации = Новый Структура;	
		СтруктураАдресРегистрации.Вставить("Страна", "");
		СтруктураАдресРегистрации.Вставить("Представление", "");
		СтруктураАдресРегистрации.Вставить("Регион", "");
		СтруктураАдресРегистрации.Вставить("Район", "");
		СтруктураАдресРегистрации.Вставить("Город", "");
		СтруктураАдресРегистрации.Вставить("НаселенныйПункт", "");
		СтруктураАдресРегистрации.Вставить("Улица", "");
		СтруктураАдресРегистрации.Вставить("Дом", "");
		СтруктураАдресРегистрации.Вставить("Корпус", "");
		СтруктураАдресРегистрации.Вставить("Квартира", "");

	если ТипЗнч(объектЛицевойСчет) = Тип("СправочникСсылка.бит_ЛицевыеСчета") тогда 	
		если объектЛицевойСчет.Здание.КонтактнаяИнформация.Количество() > 0 тогда 	
			АдресРезультат = РаботаСАдресами.СведенияОбАдресе(объектЛицевойСчет.Здание.КонтактнаяИнформация[0].Значение); 					
		конецесли; 
	конецесли; 
	
	если ТипЗнч(объектЛицевойСчет) = Тип("Строка") тогда 
		АдресРезультат = РаботаСАдресами.СведенияОбАдресе(объектЛицевойСчет);
	конецесли; 
	
	если ТипЗнч(объектЛицевойСчет) = Тип("СправочникСсылка.бит_СписокЗданий") тогда 
		АдресРезультат = РаботаСАдресами.СведенияОбАдресе(объектЛицевойСчет.КонтактнаяИнформация[0].Значение);
	конецесли;	 
	
	Если АдресРезультат = Неопределено Тогда
		
		Возврат СтруктураАдресРегистрации;	
		
	КонецЕсли;
	
	СтруктураАдресРегистрации.Страна = СокрЛП(АдресРезультат.Страна);
	СтруктураАдресРегистрации.Представление = АдресРезультат.Представление;	
	СтруктураАдресРегистрации.Регион = СокрЛП(АдресРезультат.Регион);
	Если ЗначениеЗаполнено(АдресРезультат.МуниципальныйРайон) Тогда
		
		СтруктураАдресРегистрации.Район = СокрЛП(АдресРезультат.МуниципальныйРайон+ " " + строка(АдресРезультат.МуниципальныйРайонСокращение));   
		
	ИначеЕсли ЗначениеЗаполнено(АдресРезультат.Район) Тогда 
		
		СтруктураАдресРегистрации.Район = СокрЛП(АдресРезультат.Район+ " " + строка(АдресРезультат.РайонСокращение));   
		
	КонецЕсли;
	
	
	СтруктураАдресРегистрации.Город = СокрЛП(АдресРезультат.Город + " " + строка(АдресРезультат.ГородСокращение));
	СтруктураАдресРегистрации.НаселенныйПункт = СокрЛП(строка(АдресРезультат.НаселенныйПункт) + " " + строка(АдресРезультат.НаселенныйПунктСокращение));
	СтруктураАдресРегистрации.Улица = СокрЛП(АдресРезультат.Улица + " " + строка(АдресРезультат.УлицаСокращение));
	СтруктураАдресРегистрации.Дом = СокрЛП(АдресРезультат.Здание.Номер);	
	СтруктураАдресРегистрации.Корпус = ?(ЗначениеЗаполнено(АдресРезультат.Корпуса), СокрЛП(АдресРезультат.Корпуса[0].Номер),"");   
	СтруктураАдресРегистрации.Квартира = ?(ЗначениеЗаполнено(АдресРезультат.Помещения), СокрЛП(АдресРезультат.Помещения[0].Номер),""); 
	
	если объектЛицевойСчет <> неопределено и ТипЗнч(объектЛицевойСчет) = Тип("СправочникСсылка.бит_ЛицевыеСчета") тогда
		
		если СокрЛП(СтруктураАдресРегистрации.корпус) = "" и ЗначениеЗаполнено(объектЛицевойСчет.Здание) тогда
			СтруктураАдресРегистрации.корпус = объектЛицевойСчет.Здание.Корпус;
		конецесли; 	
		если СокрЛП(СтруктураАдресРегистрации.Улица) = "" тогда
			СтруктураАдресРегистрации.Улица = СокрЛП(объектЛицевойСчет.УлицаЛицевогоСчета);
		конецесли;	
		если СокрЛП(СтруктураАдресРегистрации.Дом) = "" и ЗначениеЗаполнено(объектЛицевойСчет.Здание) тогда
			СтруктураАдресРегистрации.Дом = объектЛицевойСчет.Здание.Наименование;
		конецесли;	
		если СокрЛП(СтруктураАдресРегистрации.Дом) = "" и ЗначениеЗаполнено(объектЛицевойСчет.Здание) тогда
			СтруктураАдресРегистрации.Квартира = объектЛицевойСчет.Квартира.Наименование;
		конецесли;	
		
	конецесли;	  
	
	возврат СтруктураАдресРегистрации; 
	
КонецФункции // ПолучитьАдресБСП()

Функция ВысотаОбластиТабДока(ИзмеряемыйТабДок)
    МассивТабДоков = Новый Массив;
    МассивТабДоков.Добавить(ИзмеряемыйТабДок);
    
    ТабДок = Новый ТабличныйДокумент;
    ТекВысота = 512;
    ДобавВысота = 0;
    
    Пока Истина Цикл
        СтрТабДока = ТабДок.ПолучитьОбласть(,,1);
        СтрТабДока.ТекущаяОбласть.ВысотаСтроки = ТекВысота;
        МассивТабДоков.Добавить(СтрТабДока);
        
        Если ТабДок.ПроверитьВывод(МассивТабДоков) Тогда
            ДобавВысота = ДобавВысота + ТекВысота;
        Иначе    
            Если ТекВысота > 1 Тогда
                МассивТабДоков.Удалить(МассивТабДоков.ВГраница());
                ТекВысота = ТекВысота / 2;
            Иначе
                Прервать;
            КонецЕсли;
        КонецЕсли;
    КонецЦикла;
    
    ОбщВысота = 785;//вычислена ранее этой же функцией: ВысотаОбластиТабДока(Новый ТабличныйДокумент)
    Возврат ОбщВысота - ДобавВысота;
КонецФункции

#КонецОбласти