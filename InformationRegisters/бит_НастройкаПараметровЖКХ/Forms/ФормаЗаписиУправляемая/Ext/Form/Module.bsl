// Процедура - обработчик события "ПриИзменении" реквизита "Льгота персонифицированная".
//
&НаКлиенте
Процедура ЛьготаПерсонифицированнаяПриИзменении(Элемент)                   
	
	Элементы.ВыводитьЛьготыНаСчетИзвещение.Видимость = Запись.ЛьготаПерсонифицированная;
	Элементы.Декорация1.Видимость = Запись.ЛьготаПерсонифицированная;
	
	Если Не Запись.ЛьготаПерсонифицированная Тогда
		Запись.ВыводитьЛьготыНаСчетИзвещение = Ложь;	
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "СчетДохода".
// 
&НаКлиенте
Процедура СчетДоходаПриИзменении(Элемент)
	
	УстановитьЗаголовкиИДоступностьСубконтоНачисления(ЭтаФорма, Запись.СчетДохода, "", Ложь, Истина);
	
	ПоляОбъекта = Новый Структура("Субконто1, Субконто2, Субконто3", 
	"Субконто1", "Субконто2", "Субконто3");
	
	бит_БухгалтерскийУчетКлиентСервер.ПриИзмененииСчета(Запись.СчетДохода, Запись, ПоляОбъекта, Истина);
	
	мСчетЛьготСУ = Запись.СчетДохода;
	
	УстановитьВидимостьСубконто();
	
КонецПроцедуры

