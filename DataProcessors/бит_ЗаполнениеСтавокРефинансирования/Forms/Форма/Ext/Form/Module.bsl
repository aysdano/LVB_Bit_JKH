&НаКлиенте
Процедура ТаблицаУслугНачислятьПриИзменении(Элемент)
 		
  Отбор = Новый Структура();
  Отбор.Вставить("Услуга", Элементы.ТаблицаУслуг.ТекущиеДанные.Услуга);
  Отбор.Вставить("НомерСтроки", Элементы.ТаблицаУслуг.ТекущиеДанные.НомерСтроки);
  
  строкиУслуг = Объект.ТаблицаУслуг.НайтиСтроки(Отбор);  	
 
  если строкиУслуг.Количество() > 0 тогда  
   если Элементы.ТаблицаУслуг.ТекущиеДанные.Начислять	= истина тогда	  
    ставкаПроцент = ПолучитьСтавкуРефинансирования(Объект.Дата, Объект.ПериодНачисления);  	
    строкиУслуг[0].Процент = ставкаПроцент.Процент;
    строкиУслуг[0].Ставка = ставкаПроцент.Ставка;
   иначе	
	строкиУслуг[0].Процент = 0;
    строкиУслуг[0].Ставка = 0;
   конецесли;	
  КонецЕсли;                                     
 	
КонецПроцедуры

