		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.УлицаЛицевогоСчета КАК Улица,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Здание КАК Здание,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Здание.Участок КАК Участок,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Ссылка КАК ЛицевойСчет,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.Разрядность КАК КоличествоРазрядовСчетчика,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.КоэффициентУмножения КАК МасштабныйКоэффициент,
	ЕСТЬNULL(бит_ПоказанияСчетчиковОстаткиИОбороты.ПоследниеПоказанияНачальныйОстаток, 0) КАК НачальноеПоказание,
	ЕСТЬNULL(бит_ПоказанияСчетчиковОстаткиИОбороты.ПоследниеПоказанияКонечныйОстаток, 0) КАК КонечноеПоказание,
	ЕСТЬNULL(бит_ПоказанияСчетчиковОстаткиИОбороты.ПоследниеПоказанияКонечныйОстаток, 0) - ЕСТЬNULL(бит_ПоказанияСчетчиковОстаткиИОбороты.ПоследниеПоказанияНачальныйОстаток, 0) КАК Израсходовано
ИЗ
	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&amp;КонецПериода {(&amp;КонецПериода)}, ) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ПоказанияСчетчиков.ОстаткиИОбороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, , , ) КАК бит_ПоказанияСчетчиковОстаткиИОбороты
		ПО бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект = бит_ПоказанияСчетчиковОстаткиИОбороты.Объект
			И бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга = бит_ПоказанияСчетчиковОстаткиИОбороты.Услуга
			И бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = бит_ПоказанияСчетчиковОстаткиИОбороты.Счетчик
ГДЕ
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать = ИСТИНА
	И бит_СчетчикиНаУслугахОбщийСрезПоследних.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)</query>
	</dataSet>
