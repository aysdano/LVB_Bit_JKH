Функция  СоздатьОрганизациюИВыбратьДляНастройки(Организация)
	
	НайденнаяСсылка = Справочники.МЛК_Настройки.НайтиПоРеквизиту("Организация",Организация);
	Если НайденнаяСсылка<>Справочники.МЛК_Настройки.ПустаяСсылка() Тогда
		Возврат НайденнаяСсылка;
	КонецЕсли;	
	
	Нов = Справочники.МЛК_Настройки.СоздатьЭлемент();
	Нов.Наименование                     = "Интеграция с МЛК " + Строка(Организация.Наименование);
	Нов.Организация                      = Организация;
	Нов.Комиссия                         = Перечисления.МЛК_Комиссия.КомиссияСверху;
	Нов.ЭкспортКвитанции                 = Истина;
	нов.ЭкспортЛицевыеСчета              = Истина;
	Нов.ЭкспортНачисления                = Истина;
	Нов.ЭкспортПлатежи                   = Истина;
	Нов.ЭкспортСчетчики                  = Истина;
	Нов.ИмпортПоказанияСчетчиков         = Истина;
	Нов.ШаблонКвитанции                  = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ;
	
	Нов.Записать();
	
	
	Возврат Нов.Ссылка;
	
КонецФункции

