Функция ПолучитьСписокПроживающих(ФизЛицо)
	
	Запрос =  Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	ОтветственныеЛицаПоКУСрезПоследних.Контрагент,
	|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И ФизЛицо = &ФизЛицо) КАК ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныеЛицаПоКУСрезПоследних
	|		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет = ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет
	|			И ПроживающиеПоЛССрезПоследних.ФизЛицо = ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо
	|ГДЕ
	|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	Запрос.УстановитьПараметр("Момент"     , КонецМесяца(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо"    , ФизЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено
		
	КонецЕсли; 
	
	Возврат РезультатЗапроса.Выгрузить()[0];
	
КонецФункции
Функция ПечатьИсковоеЗаявление(Флаг = Истина) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекущийДокумент", ЭтотОбъект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,Дата);

	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ИсковоеЗаявление.Номер КАК Номер,
	|	бит_ИсковоеЗаявление.СуммаЗадолженности КАК СуммаЗадолженности,
	|	бит_ИсковоеЗаявление.ПериодОбразованияЗадолженностиОт КАК ПериодОбразованияЗадолженностиОт,
	|	бит_ИсковоеЗаявление.ПериодОбразованияЗадолженностиПо КАК ПериодОбразованияЗадолженностиПо,
	|	бит_ИсковоеЗаявление.Госпошлина КАК Госпошлина,
	|	бит_ИсковоеЗаявление.Адрес КАК Адрес,
	|	бит_ИсковоеЗаявление.СудебныйУчасток.НомерУчастка КАК СудебныйУчастокНомерУчастка,
	|	Организации.ИНН КАК ИННОрганизации,
	|	Организации.КПП КАК КППОрганизации,
	|	Банки.Наименование КАК НаименованиеБанка,
	|	Банки.КоррСчет КАК КоррСчет,
	|	Банки.Код КАК БИК,
	|	Банки.Адрес КАК АдресБанка,
	|	лб_Тест_Дома.KR_RS КАК НомерСчета,
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадьКвартиры,
	|	бит_ИсковоеЗаявление.Дата КАК Дата,
	|	Банки.ИННБанка КАК ИННБанка,
	|	Банки.ОКПОБанка КАК ОКПОБанка,
	|	Банки.КППБанка КАК КППБанка,
	|	Банки.ОГРНБанка КАК ОГРНБанка,
	|	бит_ИсковоеЗаявление.ПредставительскиеРасходы КАК ПредставительскиеРасходы
	|ИЗ
	|	Документ.бит_ИсковоеЗаявление КАК бит_ИсковоеЗаявление
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
	|		ПО бит_ИсковоеЗаявление.Организация = Организации.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
	|				ПО БанковскиеСчета.Банк = Банки.Ссылка
	|			ПО лб_Тест_Дома.ЛицевойСчетКР = БанковскиеСчета.Ссылка
	|		ПО бит_ИсковоеЗаявление.Здание = лб_Тест_Дома.Здание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Период, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ИсковоеЗаявление.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_ИсковоеЗаявление.Ссылка = &Ссылка";

	
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ИсковоеЗаявлениеОтветчики.ФизЛицо.Наименование КАК ФизЛицо,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо.ДатаРождения КАК ФизЛицоДатаРождения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ДокументВид,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК ДокументСерия,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК ДокументНомер,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо.ИНН КАК ФизЛицоИНН,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо.СтраховойНомерПФР КАК ФизЛицоСтраховойНомерПФР
	|ИЗ
	|	Документ.бит_ИсковоеЗаявление.Ответчики КАК бит_ИсковоеЗаявлениеОтветчики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Период, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ИсковоеЗаявлениеОтветчики.ФизЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|			И бит_ИсковоеЗаявлениеОтветчики.ФизЛицо.ДатаРождения = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо.ДатаРождения
	|			И бит_ИсковоеЗаявлениеОтветчики.ФизЛицо.ИНН = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо.ИНН
	|ГДЕ
	|	бит_ИсковоеЗаявлениеОтветчики.Ссылка = &Ссылка";
	
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	
КонецФункции



Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	ТекущийДокумент = ДополнительныеСвойства.Документ; 
	ТекущийДокумент = ТекущийДокумент.ПолучитьОбъект();
	ЭтотОбъект.Ответственный = Пользователи.ТекущийПользователь();
	
КонецПроцедуры


Функция ПроверкаСвязанныхДокументов()
	УстановитьПривилегированныйРежим(Истина);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Документ",Ссылка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	СвязанныеДокументы.Ссылка КАК Ссылка
	               |ИЗ
	               |	КритерийОтбора.СвязанныеДокументы(&Документ) КАК СвязанныеДокументы";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Связь = Истина;
	Иначе 
		Связь = Ложь;
	КонецЕсли;
	Возврат Связь;
	УстановитьПривилегированныйРежим(Ложь);

КонецФункции

