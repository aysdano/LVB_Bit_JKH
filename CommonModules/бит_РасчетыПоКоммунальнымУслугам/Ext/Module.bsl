					//КонецЕсли;
					
					КоличествоПоНормеЛьгота = 0;
					
					Запрос.Текст = ТекстЗапросаСемейнойЛьготы;
					Запрос.УстановитьПараметр("ЛицевойСчет"              , Выборка.ЛицевойСчет);
					Запрос.УстановитьПараметр("ФизЛицо"                  , Выборка.ФизЛицо);
					Запрос.УстановитьПараметр("Льгота"                   , Выборка.Льгота);
					Запрос.УстановитьПараметр("РасчетСУчетомСоставаСемьи", Выборка.РасчетСУчетомСоставаСемьи);
					
					ВыборкаОбщ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Если ВыборкаОбщ.Следующий() Тогда
						КоличествоПоНормеЛьгота = ВыборкаОбщ.КоличествоПоНормеЛьгота;
					КонецЕсли;
					
					Если Выборка.ПравоНаЛьготы И Выборка.НачислятьПоНорме Тогда
						КоличествоПоНормеЛьгота = КоличествоПоНормеЛьгота + 1;
					КонецЕсли; 
					
					ВыборкаФизЛиц = ВыборкаОбщ.Выбрать();
					
					//ДоляПлощади  = ?(Выборка.ДоляПлощади > Выборка.Факт, Выборка.Факт, Выборка.ДоляПлощади);
					
					Если Выборка.Распространение = Перечисления.бит_РаспространениеЛьготы.ПоФакту Тогда
						
						Факт = Выборка.Факт;
						
						Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим 
