&НаКлиенте
Процедура ТаблицаСчетчиковПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрока = Элементы.ТаблицаСчетчиков.ТекущиеДанные;
	
	Если НоваяСтрока И НЕ ТекущаяСтрока = Неопределено Тогда
		ТекущаяСтрока.Обрабатывать = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСчетчиковСчетчикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ПараметрыФормыВыбора = Новый Структура;
	
	ПараметрыФормыВыбора.Вставить("Дата"       , КонецДня(ТекущаяДата()));
	ПараметрыФормыВыбора.Вставить("Установлен" , Истина);
	ПараметрыФормыВыбора.Вставить("ТипСчетчика", ПредопределенноеЗначение("Перечисление.бит_ТипСчетчика.Индивидуальный"));
	ПараметрыФормыВыбора.Вставить("РежимВыбора", Истина);
	
	ОтборВидСчетчика = Новый Структура;
	ОтборВидСчетчика.Вставить("ИмяПоля"       , "ВидСчетчика");
	ОтборВидСчетчика.Вставить("ПравоеЗначение", ВидыСчетчика);
	ОтборВидСчетчика.Вставить("Использование" , ИспользоватьОтборВидСчетчика);
	ОтборВидСчетчика.Вставить("ВидСравнения"  , ВидСравненияВидСчетчика);
	
	ДополнительныеОтборы = Новый Структура;
	ДополнительныеОтборы.Вставить("ОтборВидСчетчика", ОтборВидСчетчика);
	
	ПараметрыФормыВыбора.Вставить("ДополнительныеОтборы", ДополнительныеОтборы);
	
	Если ИспользоватьОтборЛицевойСчет Тогда
		
		Если ТипЗнч(ЛицевыеСчета) = Тип("СписокЗначений") Тогда
			СписокОбъектовУчета = ЛицевыеСчета;
		Иначе
			СписокОбъектовУчета = Новый СписокЗначений;
			СписокОбъектовУчета.Добавить(ЛицевыеСчета);
		КонецЕсли;
		
		ПараметрыФормыВыбора.Вставить("СписокОбъектовУчета", СписокОбъектовУчета);
		
	ИначеЕсли ИспользоватьОтборСписокЗданий Тогда
		
		Если ТипЗнч(СписокЗданий) = Тип("СписокЗначений") Тогда
			СписокОбъектовУчета = СписокЗданий;
		Иначе
			СписокОбъектовУчета = Новый СписокЗначений;
			СписокОбъектовУчета.Добавить(СписокЗданий);
		КонецЕсли;
		
		ПараметрыФормыВыбора.Вставить("СписокОбъектовУчета", СписокОбъектовУчета);
		ПараметрыФормыВыбора.Вставить("ЭтоСписокЗданий"    , Истина);
		
	КонецЕсли;
	
	Если НЕ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика") Тогда
		ПараметрыФормыВыбора.Вставить("Многотарифный", Ложь);
	КонецЕсли;
	
	ОткрытьФорму("Справочник.бит_Счетчики.Форма.ФормаВыбораСчетчиков", ПараметрыФормыВыбора, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСчетчиковСчетчикОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ТаблицаСчетчиков.ТекущиеДанные;
	
	Результат = ОбработкаВыбораНаСервере(ВыбранноеЗначение);
	
	Если НЕ Результат = Неопределено Тогда
		
		ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Результат);
		ТекущаяСтрока.Счетчик      = ВыбранноеЗначение;
		ТекущаяСтрока.Документ     = Неопределено;
		ТекущаяСтрока.Обрабатывать = НЕ Результат.ЕстьОшибка;
		
	КонецЕсли; 
	
КонецПроцедуры

