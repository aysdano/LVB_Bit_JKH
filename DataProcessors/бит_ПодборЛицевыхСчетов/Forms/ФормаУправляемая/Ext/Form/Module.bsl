&НаСервере
Функция ПоместитьЛСВХранилище()
	
	ТаблицаЛС = Объект.ТаблицаВыбора.Выгрузить();
	
	АдресЛСВХранилище = ПоместитьВоВременноеХранилище(ТаблицаЛС, УникальныйИдентификатор);
	
	Возврат АдресЛСВХранилище;
	
КонецФункции

&НаКлиенте
Процедура ПересчитатьЭлементы()
	
	КолЭлементов = Объект.ТаблицаВыбора.Количество();
	
	Если КолЭлементов > 0 Тогда
		Элементы.НадписьВыбранного.Заголовок = "Выбрано элементов : " + Объект.ТаблицаВыбора.Количество();
	Иначе
		Элементы.НадписьВыбранного.Заголовок = "Выбрано элементов : 0";
	КонецЕсли; 
	
	Объект.ТаблицаВыбора.Сортировать("ЛицевойСчет Возр");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУслугЗначениеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая",, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура Выбрать(Команда)
	
	ТекущаяУслуга = Элементы.СписокУслуг.ТекущиеДанные;
	
	Выделение = Элементы.СписокЛицевыхСчетов.ВыделенныеСтроки;
	
	Если НЕ Выделение = Неопределено Тогда
		
		Отбор = Новый Структура;
		
		Для каждого ЭлементМассива Из Выделение Цикл
			
			Услуга = Неопределено;
			
			Если НЕ ТекущаяУслуга = Неопределено Тогда
				Услуга = ТекущаяУслуга.Значение;
			КонецЕсли;
			
			Отбор.Очистить();
			Отбор.Вставить("Услуга"     , Услуга);
			Отбор.Вставить("ЛицевойСчет", ЭлементМассива);
			
			Поиск = Объект.ТаблицаВыбора.НайтиСтроки(Отбор);
			
			Если Поиск.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			НоваяСтрока = Объект.ТаблицаВыбора.Добавить();
			
			НоваяСтрока.Услуга      = Услуга;
			НоваяСтрока.ЛицевойСчет = ЭлементМассива;
			НоваяСтрока.Адрес       = "ул. " + ПолучитьУлицуЛицевогоСчетаНаСервере(ЭлементМассива) + ", д. " + ПолучитьЗданиеНаСервере(ЭлементМассива) + ", кв. " + ПолучитьКвартируНаСервере(ЭлементМассива);			
			НоваяСтрока.Здание      = ПолучитьЗданиеНаСервере(ЭлементМассива);
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПересчитатьЭлементы();
	
КонецПроцедуры

