&НаКлиенте
Процедура РаботыЕдиницаИзмеренияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	мСписокЕдиницИзмерения.Очистить();
	
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	Работа 		  = ТекущаяСтрока.Работа;
	
	Если ЗначениеЗаполнено(Работа) Тогда
		
		мСписокЕдиницИзмерения = ЕдиницыИзмеренияНаСервере(Работа);	
		
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("Ссылка", мСписокЕдиницИзмерения);
		
		ОткрытьФорму("Документ.бит_ЗаявкаНаВыполнениеРабот.Форма.ФормаВыбораСправочникаКлассификаторЕдиницИзмерения", Новый Структура("Отбор", Отбор), Элемент);
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните поле Работа.";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ЕдиницыИзмеренияНаСервере(Работа)
	
	Для Каждого ТекСтрока Из Работа.ЕдиницыИзмерения Цикл
		
		мСписокЕдиницИзмерения.Добавить(ТекСтрока.ЕдиницаИзмерения);
		
	КонецЦикла;
	
	Возврат мСписокЕдиницИзмерения;	
	
КонецФункции

