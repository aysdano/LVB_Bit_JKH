			ТаблицаСЧ.Вывести(ТаблицаСЧСтрока);
			
			СчетчикСЧ = СчетчикСЧ + 1;
			
		КонецЦикла;
		
		ДобавитьПустыхСтрокСч = 9 - СчетчикСЧ;
		
		Если ДобавитьПустыхСтрокСч > 0 Тогда
			
			Для Значение = 1 По ДобавитьПустыхСтрокСч Цикл
				ТаблицаСЧ.Вывести(ТаблицаСЧПустаяСтрока);
			КонецЦикла;
			
		КонецЕсли;
		
		ТаблицаНаПечать.Присоединить(ТаблицаСЧ);
		Середина.Параметры.Заполнить(мСтруктураДанных);
		
