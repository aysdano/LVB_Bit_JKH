&НаСервере
Процедура ТаблицаУслугВЦикле(тмпТаблицаУслуг,ВыборкаДокумент)
	
	Контрагент = Неопределено;
	
	Если мКэшЗначений.ФормироватьАктИРеализациюПоКонтрагентуОтветственныхЛиц Тогда
		Контрагент = ВыборкаДокумент.Контрагент;
	ИначеЕсли ВыборкаДокумент.СчетАбонента.Код = "76.КУ" Тогда
		
		Контрагент = мКэшЗначений.Контрагент;
		
	Иначе
		
		СтрокаСубконта = ВыборкаДокумент.СчетАбонента.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты, "ВидСубконто");
		
		Если НЕ СтрокаСубконта = Неопределено тогда
			
			НомерСтрокиСубконтоКонтрагент = СтрокаСубконта.НомерСтроки;
			
			Контрагент = ВыборкаДокумент["Субконто" + НомерСтрокиСубконтоКонтрагент];
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Номенклатура = Неопределено;
	
	НомерСтрокиСубконтоНоменклатура = -1;
	
	СтрокаСубконта = ВыборкаДокумент.СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Номенклатура, "ВидСубконто");
	
	Если НЕ СтрокаСубконта = Неопределено Тогда
		
		НомерСтрокиСубконтоНоменклатура = СтрокаСубконта.НомерСтроки;
		
		Номенклатура = ВыборкаДокумент["СубконтоКУ"+НомерСтрокиСубконтоНоменклатура];
		
	КонецЕсли;
	
	НоменклатурнаяГруппа = Неопределено;
	СтавкаНДС            = Неопределено;
	
	Если ЗначениеЗаполнено(Номенклатура) Тогда
		
		НомерСтрокиСубконтоНоменклатурныеГруппы = -1;
		
		СтрокаСубконта = ВыборкаДокумент.СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.НоменклатурныеГруппы, "ВидСубконто");
		
		Если НЕ СтрокаСубконта = Неопределено тогда
			
			НомерСтрокиСубконтоНоменклатурныеГруппы = СтрокаСубконта.НомерСтроки;
			
			НоменклатурнаяГруппа = ВыборкаДокумент["СубконтоКУ"+НомерСтрокиСубконтоНоменклатурныеГруппы];
			
		КонецЕсли;
		
		НомерСтрокиСубконтоСтавкиНДС = -1;
		
		СтрокаСубконта = ВыборкаДокумент.СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.СтавкиНДС, "ВидСубконто");
		
		Если НЕ СтрокаСубконта = Неопределено Тогда
			
			НомерСтрокиСубконтоСтавкиНДС = СтрокаСубконта.НомерСтроки;
			
			СтавкаНДС = ВыборкаДокумент["СубконтоКУ"+НомерСтрокиСубконтоСтавкиНДС];
			
		КонецЕсли;
		
	КонецЕсли; 
	
	СчетРасходов = Неопределено;
	
	Если ВыборкаДокумент.СчетКУ = ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД Тогда
		
		СчетРасходов =  ПланыСчетов.Хозрасчетный.СебестоимостьПродажНеЕНВД;
		
	ИначеЕсли ВыборкаДокумент.СчетКУ = ПланыСчетов.Хозрасчетный.ВыручкаЕНВД Тогда
		
		СчетРасходов =  ПланыСчетов.Хозрасчетный.СебестоимостьПродажЕНВД;
		
	КонецЕсли; 
	
	Если НЕ Номенклатура = Неопределено И НЕ ВыборкаДокумент.начислено = 0 Тогда
		
		НоваяСтрока = тмпТаблицаУслуг.Добавить();
		
		НоваяСтрока.Контрагент               = Контрагент;
		НоваяСтрока.Номенклатура             = Номенклатура;
		НоваяСтрока.Количество               = 1;
		НоваяСтрока.Цена                     = ВыборкаДокумент.Начислено;
		НоваяСтрока.Сумма                    = ВыборкаДокумент.Начислено;
		НоваяСтрока.СтавкаНДС                = СтавкаНДС;
		
		НоваяСтрока.СуммаНДС                 = УчетНДСКлиентСервер.РассчитатьСуммуНДС(ВыборкаДокумент.Начислено,Истина, УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтавкаНДС));
		
		НоваяСтрока.НоменклатурнаяГруппа     = НоменклатурнаяГруппа;
		НоваяСтрока.СчетУчетаНДСПоРеализации = ПланыСчетов.Хозрасчетный.Продажи_НДС;
		НоваяСтрока.ПлановаяСтоимость        = ВыборкаДокумент.Начислено;
		НоваяСтрока.СуммаПлановая            = ВыборкаДокумент.Начислено;
		НоваяСтрока.СчетДоходов              = ВыборкаДокумент.СчетКУ;
		НоваяСтрока.СчетРасходов             = СчетРасходов;
		НоваяСтрока.ДоговорКонтрагента       = ВыборкаДокумент.ДоговорКонтрагента;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыполнитьРаспределениеАванса()
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Здание");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Улица");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДокументРаспределениеАванса");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(Объект.ДатаЗакрытия));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "РаспределениеАванса";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	Выборка = СтруктураРезультата.РезультатЗапроса.Выбрать();
	
	ДокументыНаПроведение = Новый Массив;
	Если Объект.ВыполнитьРаспределениеАванса Тогда
		
		МассивПовторов = Новый Массив;
		
		// Сброс данных по текущим документам.
		Пока Выборка.Следующий() Цикл
			
			Если ЗначениеЗаполнено(Выборка.ДокументРаспределениеАванса) 
				И МассивПовторов.Найти(Выборка.ДокументРаспределениеАванса) = Неопределено Тогда
				
				МассивПовторов.Добавить(Выборка.ДокументРаспределениеАванса);
				
				ДокументРаспределениеАванса = Выборка.ДокументРаспределениеАванса.ПолучитьОбъект();
				
				Если ДокументРаспределениеАванса.ПометкаУдаления Тогда
					ДокументРаспределениеАванса.УстановитьПометкуУдаления(Ложь);
				КонецЕсли; 
				
				ДокументРаспределениеАванса.СписокУслугПоПериоду.Очистить();
				ДокументРаспределениеАванса.СуммаДокумента = 0;
				ДокументРаспределениеАванса.Записать(РежимЗаписиДокумента.ОтменаПроведения);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Выборка.Сбросить();
		МассивПовторов.Очистить();
		
		// Пререзаполнение и создание новых документов.
		Пока Выборка.Следующий() Цикл
			
			// Проверка повторного проведения (документ на всю улицу и документы на каждый дом).
			Если ЗначениеЗаполнено(Выборка.ДокументРаспределениеАванса) Тогда 
				Если МассивПовторов.Найти(Выборка.ДокументРаспределениеАванса) = Неопределено Тогда
					МассивПовторов.Добавить(Выборка.ДокументРаспределениеАванса);	
				Иначе
					Продолжить;
				КонецЕсли;
			КонецЕсли;
			
			Если ЗначениеЗаполнено(Выборка.ДокументРаспределениеАванса) Тогда
				ДокументРаспределениеАванса = Выборка.ДокументРаспределениеАванса.ПолучитьОбъект();
			Иначе
				ДокументРаспределениеАванса				= Документы.бит_РаспределениеАванса.СоздатьДокумент();
				ДокументРаспределениеАванса.Дата        = КонецМесяца(Объект.ДатаЗакрытия) - 1;
				ДокументРаспределениеАванса.Организация = Объект.Организация;
				ДокументРаспределениеАванса.Улица       = Выборка.Улица;
				ДокументРаспределениеАванса.Здание      = Выборка.Здание;
				ДокументРаспределениеАванса.Ответственный = мОтветственный;
				ДокументРаспределениеАванса.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
			КонецЕсли;
			
			// БИТ ЖКХ 22.12.2020
			Если ЗначениеЗаполнено(ДокументРаспределениеАванса.Ответственный) = ложь Тогда 
				ДокументРаспределениеАванса.Ответственный = Пользователи.ТекущийПользователь();
			КонецЕсли;
			
			// Заполнение тч документа.
			ДокументРаспределениеАванса.ЗаполнитьСписокУслуг(Истина);
			
			Попытка
				
				Если ДокументРаспределениеАванса.СписокУслугПоПериоду.Количество() > 0 Тогда
					ДокументРаспределениеАванса.Записать(РежимЗаписиДокумента.Запись);
					ДокументыНаПроведение.Добавить(ДокументРаспределениеАванса.Ссылка);
				КонецЕсли; 
				
			Исключение
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			КонецПопытки; 
			
		КонецЦикла; // Создание и перепроведение ДокументРаспределениеАванса.
		
	КонецЕсли; // Объект.ВыполнитьРаспределениеАванса.
	
	ПровестиДокументы(ДокументыНаПроведение);
	
КонецПроцедуры

&НаСервере
Процедура НачислитьОДН()
	ДатаМес          = НачалоМесяца(Объект.ДатаЗакрытия) - 20;
	ДатаМес2         = НачалоМесяца(ДатаМес) - 20;
	//НеНачислять      = Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию("Не Начислять");
	//УслугаЭЛ         = Справочники.бит_УслугиЖКХ.НайтиПоНаименованию("ОДН Эл");
	//УслугаГВ         = Справочники.бит_УслугиЖКХ.НайтиПоНаименованию("ОДН ГВ");
	//УслугаХВ         = Справочники.бит_УслугиЖКХ.НайтиПоНаименованию("ОДН ХВ");
	//УслугаВО         = Справочники.бит_УслугиЖКХ.НайтиПоНаименованию("ОДН ВО");
	УслугаЭЛ         = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000002");
	УслугаГВ         = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000003");
	УслугаХВ         = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000004");
	УслугаВО         = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000005");
	//Газоснабжение    = Справочники.бит_УслугиЖКХ.НайтиПоНаименованию("Газоснабжение");
	СРОДН            = Перечисления.лб_СпособРасчетаСОИ;
	РассчетПосле2023 = Объект.ДатаЗакрытия > Дата(2023, 02, 01);
	//РассчетПосле2023 = Истина;
	ТекстЗапроса     = "";
	Если Объект.Организация = справочники.Организации.НайтиПоКоду("00-000001") Тогда
		ПоставщикУслуг = Справочники.бит_ПоставщикиУслуг.НайтиПоКоду("00-000001"); 
	Иначе	
		ПоставщикУслуг = Справочники.бит_ПоставщикиУслуг.НайтиПоКоду("00-000016");
	КонецЕсли; 
	
	ДокОбъемы = НайтиОбъемы(Объект.ДатаЗакрытия);
	Если ДокОбъемы = Документы.бит_ОбъемыЖКУ.ПустаяСсылка() Тогда
		ДокОбъемы = Документы.бит_ОбъемыЖКУ.СоздатьДокумент();
		ДокОбъемы.Дата = НачалоМесяца(Объект.ДатаЗакрытия);
	Иначе
		ДокОбъемы.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Если НЕ ИспользоватьОтборЗдание Тогда
			ДокОбъемы.ОбъемыЖКУ.Очистить();
		КонецЕсли;
	КонецЕсли;
	ДокСТЭЛ = ДокСтавка(Объект.ДатаЗакрытия,Объект.Организация,УслугаЭЛ);
	Если ДокСТЭЛ <> Неопределено Тогда
		ДокСТЭЛ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Если НЕ ИспользоватьОтборЗдание Тогда
			ДокСТЭЛ.СтавкиНаУслуги.Очистить();
		КонецЕсли;
	Иначе 
		ДокСтЭл = Документы.бит_УстановкаСтавокПоУслугам.СоздатьДокумент();
		ДокСТЭЛ.Дата = КонецМесяца(Объект.ДатаЗакрытия);
		ДокСтЭл.Организация = Объект.Организация;
		ДокСтЭл.Услуга = УслугаЭЛ;
	КонецЕсли;
	
	ДокСТГВ = ДокСтавка(Объект.ДатаЗакрытия,Объект.Организация,УслугаГВ);
	Если ДокСТГВ <> Неопределено Тогда
		ДокСтГв.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Если НЕ ИспользоватьОтборЗдание Тогда
			ДокСтГв.СтавкиНаУслуги.Очистить();
		КонецЕсли;
	Иначе 
		ДокСТГВ = Документы.бит_УстановкаСтавокПоУслугам.СоздатьДокумент();
		ДокСТГВ.Дата = КонецМесяца(Объект.ДатаЗакрытия);
		ДокСТГВ.Организация = Объект.Организация;
		ДокСТГВ.Услуга = УслугаГВ;
	КонецЕсли;
	
	ДокСТХВ = ДокСтавка(Объект.ДатаЗакрытия,Объект.Организация,УслугаХВ);
	Если ДокСТХВ <> Неопределено Тогда
		ДокСТХВ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Если НЕ ИспользоватьОтборЗдание Тогда
			ДокСТХВ.СтавкиНаУслуги.Очистить();
		КонецЕсли;
	Иначе 
		ДокСТХВ = Документы.бит_УстановкаСтавокПоУслугам.СоздатьДокумент();
		ДокСТХВ.Дата = КонецМесяца(Объект.ДатаЗакрытия);
		ДокСТХВ.Организация = Объект.Организация;
		ДокСТХВ.Услуга = УслугаХВ;
	КонецЕсли;
	
	ДокСТВО = ДокСтавка(Объект.ДатаЗакрытия,Объект.Организация,УслугаВО);
	Если ДокСТВО <> Неопределено Тогда
		ДокСтВо.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		Если НЕ ИспользоватьОтборЗдание Тогда
			ДокСтВо.СтавкиНаУслуги.Очистить();
		КонецЕсли;
	Иначе 
		ДокСТВО = Документы.бит_УстановкаСтавокПоУслугам.СоздатьДокумент();
		ДокСТВО.Дата = КонецМесяца(Объект.ДатаЗакрытия);
		ДокСТВО.Организация = Объект.Организация;
		ДокСТВО.Услуга = УслугаВО;
	КонецЕсли;
	
	Если ИспользоватьОтборЗдание Тогда 
		ТекстЗапроса = ТекстЗапроса + "
		|И	бит_СписокЗданий.Ссылка в (&Здание)";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СписокЗданий.Ссылка КАК Ссылка,
	|	бит_СписокЗданий.Организация КАК Орг,
	|	бит_СписокЗданий.Улица КАК Улица,
	|	бит_СписокЗданий.ВидБлагоустройстваЗданий КАК ВидБлагоустройстваЗданий
	|ПОМЕСТИТЬ Здание
	|ИЗ
	|	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|ГДЕ
	|	бит_СписокЗданий.Организация = &Организация  " + ТекстЗапроса + "
	|;
