//HD+
// Заполняет квартиру представителя собственников 1 по выбранному собственнику и МКД.
//
&НаСервере
Процедура ЗаполнитьКвартируПредставителя_1НаСервере()
	
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	
	Если НЕ ЗначениеЗаполнено(ОбъектДокумента.МКД)
		ИЛИ НЕ ЗначениеЗаполнено(ОбъектДокумента.ПредставительСобственников_1) Тогда
		ОбъектДокумента.КвартираПредставителя_1 = Справочники.бит_Квартиры.ПустаяСсылка();
		ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
