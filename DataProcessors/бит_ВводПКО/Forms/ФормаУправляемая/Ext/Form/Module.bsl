&НаКлиенте
Процедура СчетКассаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	МассивОтбора = Новый Массив;
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
		
		МассивОтбора.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.РасчетныеСчета"));
		МассивОтбора.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ВалютныеСчета"));
		МассивОтбора.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.СпециальныеСчета"));
		
		СписокВыбора = бит_РаботаСДиалогамиСервер.ЗаполнитьСписокВыбораСчетовДенежныхСредств(МассивОтбора);
		
		Элементы.СчетКасса.СписокВыбора.Очистить();
		
		Для каждого ЭлементМассива из СписокВыбора Цикл
			
			Элементы.СчетКасса.СписокВыбора.Добавить(ЭлементМассива.Значение,ЭлементМассива.Представление);
			
		КонецЦикла;	
		
	Иначе
		
		МассивОтбора = Новый Массив;
		
		МассивОтбора.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.Касса"));
		
		МассивИсключений = Новый Массив;
		
		МассивИсключений.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ДенежныеДокументы"));
		МассивИсключений.Добавить(ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.ДенежныеДокументыВал"));
		
		СписокВыбора = бит_РаботаСДиалогамиСервер.ЗаполнитьСписокВыбораСчетовДенежныхСредств(
		МассивОтбора, , ПредопределенноеЗначение("ПланСчетов.Хозрасчетный.КассаОрганизации"), МассивИсключений);
		
		Элементы.СчетКасса.СписокВыбора.Очистить();
		
		Для каждого ЭлементМассива из СписокВыбора Цикл
			
			Элементы.СчетКасса.СписокВыбора.Добавить(ЭлементМассива.Значение,ЭлементМассива.Представление);
			
		КонецЦикла;	
		
	КонецЕсли;
	
КонецПроцедуры

