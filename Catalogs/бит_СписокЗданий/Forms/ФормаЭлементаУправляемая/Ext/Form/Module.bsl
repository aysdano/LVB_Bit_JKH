&НаКлиенте
Процедура КвартирыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Ложь;
	
	Если мКэшЗначений.ЭтоНовый Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Сначала необходимо записать элемент!");
		
		Отказ = Истина;
		
		Возврат;
			
	КонецЕсли;
	
	ПараметрыФормы     = Новый Структура;
	ЗначенияЗаполнения = Новый Структура;
	
	Если Копирование Тогда
		
		ТекущиеДанные = Элементы.Квартиры.ТекущиеДанные;
		
		ЗначенияЗаполнения.Вставить("Этаж"            , ТекущиеДанные.Этаж);
		ЗначенияЗаполнения.Вставить("КоличествоКомнат", ТекущиеДанные.КоличествоКомнат);
		ЗначенияЗаполнения.Вставить("НомерКвартиры"   , ТекущиеДанные.НомерКвартиры);
		ЗначенияЗаполнения.Вставить("ПрефиксКвартиры" , ТекущиеДанные.ПрефиксКвартиры);
		
		// БИТ_ЖКХ 02.04.2014
		КодПоБТИ = ПолучитьКодПоБТИНаСервере(ТекущиеДанные.Ссылка);
		
		//ЗначенияЗаполнения.Вставить("КодПоБТИ"        , ТекущиеДанные.Ссылка.КодПоБТИ);
		ЗначенияЗаполнения.Вставить("КодПоБТИ"        , КодПоБТИ);
		// БИТ_ЖКХ 02.04.2014
		
		// БИТ_ЖКХ 23.06.2016 17:10:05 Начало правки...
		ЗначенияЗаполнения.Вставить("Подъезд"		  , ТекущиеДанные.Подъезд);
		// БИТ_ЖКХ 23.06.2016 17:10:05 Конец правки.
		
		// БИТ_ЖКХ 29.06.2016 15:38:48 Начало правки...
		ЗначенияЗаполнения.Вставить("КадастровыйНомер"   , ТекущиеДанные.КадастровыйНомер);
		// БИТ_ЖКХ 29.06.2016 15:38:48 Конец правки.
	КонецЕсли;
	
	ЗначенияЗаполнения.Вставить("Владелец", Объект.Ссылка);
	
	ПараметрыФормы.Вставить("ЗначенияЗаполнения", ЗначенияЗаполнения);		
	ПараметрыФормы.Вставить("НаДату"            , НаДату);
	
	ОткрытьФорму("Справочник.бит_Квартиры.Форма.ФормаЭлементаУправляемая", ПараметрыФормы, Элемент); 
	
КонецПроцедуры

&НаКлиенте
Процедура КвартирыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.Квартиры.ТекущиеДанные;
	
	Если ТекущиеДанные.НомерКартинки = 1 Тогда
		
		Ответ = Неопределено;
		
		
		ПоказатьВопрос(Новый ОписаниеОповещения("КвартирыПередУдалениемЗавершение1", ЭтотОбъект, Новый Структура("ТекущиеДанные", ТекущиеДанные)), "Пометить элемент на удаление?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ПоказатьВопрос(Новый ОписаниеОповещения("КвартирыПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("Ответ, ТекущиеДанные", Ответ, ТекущиеДанные)), "Снять с элемента пометку на удаление?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КвартирыПередУдалениемЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Результат = ПометитьКвартируНаУдалениеНаСервере(ТекущиеДанные.Ссылка);
		
		Если Результат Тогда
			
			ТекущиеДанные.НомерКартинки = 2;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

