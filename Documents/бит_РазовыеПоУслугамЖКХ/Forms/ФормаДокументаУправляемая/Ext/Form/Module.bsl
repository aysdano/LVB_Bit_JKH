			ИЛИ Объект.СписокУслуг.НайтиСтроки(Новый Структура("ЛицевойСчет", Элт)).Количество() > 0 Тогда
			Продолжить;	
		КонецЕсли;
		НоваяСтрока = Объект.СписокУслуг.Добавить();
		НоваяСтрока.ЛицевойСчет = Элт;
