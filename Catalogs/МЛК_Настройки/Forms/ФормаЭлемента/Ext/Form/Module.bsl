	Для Каждого стр из ЗагруженныеДанные Цикл
		Если СокрЛП(стр.Ключ)= "access_token" Тогда
			Ключ            = Стр.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Если Не ЗначениеЗаполнено(Ключ) Тогда
		// Журнал
		ИмяСобытияВЖурнал = "Получение ключа для клонирования";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвета = Результат.ПолучитьТелоКакСтроку();;	
