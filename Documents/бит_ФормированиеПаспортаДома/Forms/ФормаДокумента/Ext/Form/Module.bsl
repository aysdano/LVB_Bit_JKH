									Кодификатор = Лев(Уровень4.Кодификатор,2);
								ИначеЕсли Найти(Уровень4.Кодификатор,".") = 3 Тогда	
									Кодификатор = Лев(Уровень4.Кодификатор,3);
								КонецЕсли;	
								
								Если ЗначениеЗаполнено(Уровень4.X) Тогда
									C_4 = Уровень4.C_;
								Иначе	
									C_4 = "C_"+Кодификатор+Прав(Уровень4.Кодификатор,1) + ".";
								КонецЕсли;	
								ЗаписьXML.ЗаписатьНачалоЭлемента(C_4);
								
							КонецЕсли;	
							
						Иначе	
							Если Прав(Уровень4.Кодификатор,1) = "." Тогда
								
								
								Если ЗначениеЗаполнено(Уровень4.X) Тогда
									C_4 = Уровень4.C_;
								Иначе	
									C_4 = "C_"+Уровень0.Кодификатор+"."+Уровень4.Кодификатор;
								КонецЕсли;	
								ЗаписьXML.ЗаписатьНачалоЭлемента(C_4);
								
							Иначе	
								
								Если ЗначениеЗаполнено(Уровень4.X) Тогда
									C_4 = Уровень4.C_;
								Иначе	
									C_4 = "C_"+Уровень0.Кодификатор+"."+Уровень4.Кодификатор+".";
								КонецЕсли;
								ЗаписьXML.ЗаписатьНачалоЭлемента(C_4);
								
							КонецЕсли;	
							
						КонецЕсли;	
						
						Если Прав(Уровень4.Кодификатор,1) = "." Тогда
							ЗаписьXML.ЗаписатьАтрибут("код",Уровень0.Кодификатор+"."+Уровень4.Кодификатор);					
						Иначе	
							ЗаписьXML.ЗаписатьАтрибут("код",Уровень0.Кодификатор+"."+Уровень4.Кодификатор+".");					
						КонецЕсли;	
						
						ЗаписьXML.ЗаписатьАтрибут("наименование",Строка(Уровень4.СтатьяОборотов));
						ЗаписьXML.ЗаписатьАтрибут("тип","Строка");
						ЗаписьXML.ЗаписатьАтрибут("значение",Уровень4.Информация);      
