// Перенесен из процедуры ПриСозданииНаСервере и ПриОткрытии(оптимизация задержек).
&НаКлиенте
Процедура Группа3ПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Заголовок = "Журнал документов" Тогда
		
		ОбновитьДокументыЖКХНаСервере();
		
	ИначеЕсли ТекущаяСтраница.Заголовок = "Данные по счетчикам" или ТекущаяСтраница.Заголовок = "Доп. информация" Тогда
		
		ПосчитатьПлощади();
		ОбновитьТаблицуЗамечания();
		
	ИначеЕсли ТекущаяСтраница.Заголовок = "Льготы" Тогда
		
		ПрочитатьДанныеПолучательЛьготыНаСервере();
		
	ИначеЕсли ТекущаяСтраница.Заголовок = "Список введенных разовых" Тогда
		
		
	КонецЕсли;
	
КонецПроцедуры
// БИТ_ЖКХ 28.03.2014

&НаСервере
Процедура ИтогиНаСервере(ТаблицаНач)
	
	Элементы.ТаблицаНачислений.ПодчиненныеЭлементы.ТаблицаНачисленийЛьгота.ТекстПодвала         = Формат(ТаблицаНач.Итог("Льгота")        , "ЧДЦ=2");
	
	Элементы.ТаблицаНачислений.ПодчиненныеЭлементы.ТаблицаНачисленийОплата.ТекстПодвала         = Формат(ТаблицаНач.Итог("Оплата")        , "ЧДЦ=2");
	
	Элементы.ТаблицаНачислений.ПодчиненныеЭлементы.ТаблицаНачисленийСальдоНаНачало.ТекстПодвала = Формат(ТаблицаНач.Итог("СальдоНаНачало"), "ЧДЦ=2");
	
	Элементы.ТаблицаНачислений.ПодчиненныеЭлементы.ТаблицаНачисленийНачислено.ТекстПодвала      = Формат(ТаблицаНач.Итог("Начислено")     , "ЧДЦ=2");
	
	Элементы.ТаблицаНачислений.ПодчиненныеЭлементы.ТаблицаНачисленийРазовые.ТекстПодвала        = Формат(ТаблицаНач.Итог("Разовые")       , "ЧДЦ=2");
	
	Элементы.ТаблицаНачислений.ПодчиненныеЭлементы.ТаблицаНачисленийКОплате.ТекстПодвала        = Формат(ТаблицаНач.Итог("КОплате")       , "ЧДЦ=2");
	
КонецПроцедуры

// Процедура дополняет таблицу значений поставщиками.
//
&НаСервере
Процедура ДополнитьТаблицуПоставщиками()
	
	ТаблицаПечатиИзФормыЭлемента  = ПолучитьИзВременногоХранилища(АдресТаблицыПечатиВХранилище);
	
	Если ТаблицаПечатиИзФормыЭлемента = Неопределено ИЛИ ТаблицаПечатиИзФормыЭлемента.Количество()<= 0 Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	СписокУслуг = ТаблицаПечатиИзФормыЭлемента.ВыгрузитьКолонку("Услуга");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&Дата,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И Услуга В (&СписокУлсуг)) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	(НЕ бит_СведенияПоУслугамЛССрезПоследних.Поставщик ЕСТЬ NULL )";
	
	Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.Ссылка);
	Запрос.УстановитьПараметр("СписокУлсуг", СписокУслуг);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТаблицаПечатиИзФормыЭлемента.Колонки.Добавить("Поставщик", Новый ОписаниеТипов("СправочникСсылка.бит_ПоставщикиУслуг"));
	
	Пока Выборка.Следующий() Цикл
		
		Строка = ТаблицаПечатиИзФормыЭлемента.Найти(Выборка.Услуга, "Услуга");
		
		Если Строка <> Неопределено Тогда
			
			Строка.Поставщик = Выборка.Поставщик;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

// Функция Получение ответственного на выбранном ЛС.
// Параметры:
//  <ЛицевойСчет> – <Справочник.бит_ЛицевыеСчета> – для получения ответственного по ЛС.
//
// Возвращаемое значение:
//   <ТаблицаЗначений.Строка> – <строка с ответственным по ЛС>.
//
&НаСервере
Функция ОтветственныйНаЛС(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					ЛицевыеСчета.Ссылка
	|				ИЗ
	|					Справочник.бит_ЛицевыеСчета КАК ЛицевыеСчета
	|				ГДЕ
	|					ЛицевыеСчета.Ссылка = &ЛицевойСчет)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизЛицо";
	
	Запрос.УстановитьПараметр("Момент", 	 ТекущаяДата());
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()> 0 Тогда
		
		РезультатФизЛицо = Результат[0].ФизЛицо
	Иначе
		РезультатФизЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФизЛицо;
	
КонецФункции // 

// Процедура заполняет биллинговые услуги.
//
&НаСервере
Процедура ЗаполнитьБиллинговыеУслуги()
	
	ТабличноеПолеНачисленияБиллинговыхУслуг.Очистить();
	БиллинговыеУслуги.Очистить();
	
	Запрос = Новый Запрос;
	МВТ    = Новый МенеджерВременныхТаблиц;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Услуга,
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.РежимПотребления,
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Поставщик,
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Услуга.Приоритет КАК Приоритет,
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Использовать
	|ПОМЕСТИТЬ СведенияОбУслугах
	|ИЗ
	|	РегистрСведений.бит_бу_СведенияОБиллинговыхУслугах.СрезПоследних(
	|			&Момент,
	|			Организация = &Организация
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_бу_СведенияОБиллинговыхУслугахСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_бу_НачисленияБиллинговыхУслугОстатки.Услуга,
	|	СУММА(бит_бу_НачисленияБиллинговыхУслугОстатки.СуммаОстаток) КАК Сальдо
	|ПОМЕСТИТЬ ВходящееСальдо
	|ИЗ
	|	РегистрНакопления.бит_бу_НачисленияБиллинговыхУслуг.Остатки(
	|			НАЧАЛОПЕРИОДА(&Момент, МЕСЯЦ),
	|			Организация = &Организация
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_бу_НачисленияБиллинговыхУслугОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_бу_НачисленияБиллинговыхУслугОстатки.Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_бу_НачисленияБиллинговыхУслугОбороты.Услуга,
	|	СУММА(ВЫБОР
	|			КОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.Регистратор ССЫЛКА Документ.бит_бу_НачисленияПоБиллинговымУслугам
	|				ТОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Начисления,
	|	СУММА(ВЫБОР
	|			КОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.Регистратор ССЫЛКА Документ.бит_бу_РазовыеПоБиллинговымУслугам
	|				ТОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые,
	|	СУММА(ВЫБОР
	|			КОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.Регистратор ССЫЛКА Документ.бит_бу_ОплатаБиллинговыхУслуг
	|				ТОГДА -бит_бу_НачисленияБиллинговыхУслугОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Оплата
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.бит_бу_НачисленияБиллинговыхУслуг.Обороты(
	|			НАЧАЛОПЕРИОДА(&Момент, МЕСЯЦ),
	|			КОНЕЦПЕРИОДА(&Момент, МЕСЯЦ),
	|			Регистратор,
	|			Организация = &Организация
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_бу_НачисленияБиллинговыхУслугОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_бу_НачисленияБиллинговыхУслугОбороты.Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияОбУслугах.Услуга,
	|	СведенияОбУслугах.РежимПотребления,
	|	СведенияОбУслугах.Поставщик,
	|	СведенияОбУслугах.Приоритет,
	|	ЕстьNull(ВходящееСальдо.Сальдо,0) КАК Сальдо,
	|	ЕстьNull(Обороты.Начисления,0) КАК Начисления ,
	|	ЕстьNull(Обороты.Разовые,0) КАК Разовые ,
	|	ЕстьNull(Обороты.Оплата,0) КАК Оплата ,
	|	СведенияОбУслугах.Использовать
	|ИЗ
	|	СведенияОбУслугах КАК СведенияОбУслугах
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВходящееСальдо КАК ВходящееСальдо
	|		ПО СведенияОбУслугах.Услуга = ВходящееСальдо.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
	|		ПО СведенияОбУслугах.Услуга = Обороты.Услуга";
	Запрос.УстановитьПараметр("Момент"     , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Использовать Тогда
			
			НоваяСтрока = БиллинговыеУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЕсли; 
		
		Если Выборка.Сальдо = 0 И Выборка.Начисления = 0 И Выборка.Разовые = 0 И Выборка.Оплата = 0 Тогда
			
		Иначе
			
			НоваяСтрокаНачисления = ТабличноеПолеНачисленияБиллинговыхУслуг.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаНачисления, Выборка);
			НоваяСтрокаНачисления.Итого = НоваяСтрокаНачисления.Сальдо + НоваяСтрокаНачисления.Начисления + НоваяСтрокаНачисления.Разовые - НоваяСтрокаНачисления.Оплата;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	МВТ.Закрыть();
	
КонецПроцедуры

