&НаСервере
Процедура РассчитатьОДННаСервере()
	
	Выгрузка = Объект.СписокУслуг.Выгрузить(,"ЛицевойСчет");	
	мВыгрузка = Новый Массив; 	
	Для Каждого Строка Из Выгрузка Цикл  
   		мВыгрузка.Добавить(Строка); 	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛС", мВыгрузка);
	Запрос.УстановитьПараметр("Дата", Объект.Дата);	
	Запрос.УстановитьПараметр("УслугаОДН1", Объект.УслугаОДН1);
	Запрос.УстановитьПараметр("СуммаОДН1", Объект.СуммаОДН1);
	Запрос.УстановитьПараметр("УслугаОДН2", Объект.УслугаОДН2);
	Запрос.УстановитьПараметр("СуммаОДН2", Объект.СуммаОДН2);
	Запрос.УстановитьПараметр("УслугаОДН3", Объект.УслугаОДН3);
	Запрос.УстановитьПараметр("СуммаОДН3", Объект.СуммаОДН3);
	Запрос.УстановитьПараметр("УслугаОДН4", Объект.УслугаОДН4);
	Запрос.УстановитьПараметр("СуммаОДН4", Объект.СуммаОДН4);
	Запрос.УстановитьПараметр("ТЗ", Выгрузка);	
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЗ.ЛицевойСчет КАК ЛицевойСчет
	               |ПОМЕСТИТЬ ЛицевыеСчета
	               |ИЗ
	               |	&ТЗ КАК ТЗ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	бит_ЛицевыеСчета.Ссылка КАК бит_ЛицевыеСчета,
	               |	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	               |	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь КАК ЖилаяПлощадь,
	               |	бит_СведенияОКвартиреСрезПоследних.Квартира КАК Квартира,
	               |	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета
	               |ПОМЕСТИТЬ ВТ_Площадь
	               |ИЗ
	               |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, ) КАК бит_СведенияОКвартиреСрезПоследних
	               |		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	               |				&Дата,
	               |				ЛицевойСчет В (&ЛС)
	               |					И Услуга.Наименование = ""ОДН Эл/эн"") КАК бит_СведенияПоУслугамЛССрезПоследних
	               |		ПО (бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Ссылка = бит_ЛицевыеСчета.Ссылка)
	               |ГДЕ
	               |	бит_ЛицевыеСчета.Ссылка В(&ЛС)
	               |	И бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВЫБОР
	               |		КОГДА ВТ_Площадь.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади)
	               |			ТОГДА &СуммаОДН1 * ВТ_Площадь.ОбщаяПлощадь
	               |		ИНАЧЕ &СуммаОДН1 * ВТ_Площадь.ЖилаяПлощадь
	               |	КОНЕЦ КАК Сумма1,
	               |	ВЫБОР
	               |		КОГДА ВТ_Площадь.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади)
	               |			ТОГДА &СуммаОДН2 * ВТ_Площадь.ОбщаяПлощадь
	               |		ИНАЧЕ &СуммаОДН2 * ВТ_Площадь.ЖилаяПлощадь
	               |	КОНЕЦ КАК Сумма2,
	               |	ВЫБОР
	               |		КОГДА ВТ_Площадь.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади)
	               |			ТОГДА &СуммаОДН3 * ВТ_Площадь.ОбщаяПлощадь
	               |		ИНАЧЕ &СуммаОДН3 * ВТ_Площадь.ЖилаяПлощадь
	               |	КОНЕЦ КАК Сумма3,
	               |	ВЫБОР
	               |		КОГДА ВТ_Площадь.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади)
	               |			ТОГДА &СуммаОДН4 * ВТ_Площадь.ОбщаяПлощадь
	               |		ИНАЧЕ &СуммаОДН4 * ВТ_Площадь.ЖилаяПлощадь
	               |	КОНЕЦ КАК Сумма4,
	               |	&УслугаОДН1 КАК УслугаОДН1,
	               |	&УслугаОДН2 КАК УслугаОДН2,
	               |	&УслугаОДН3 КАК УслугаОДН3,
	               |	&УслугаОДН4 КАК УслугаОДН4,
	               |	бит_РазовыеПоУслугамЖКХ.ЛицевойСчет КАК ЛицевойСчетСсылка
	               |ИЗ
	               |	ЛицевыеСчета КАК бит_РазовыеПоУслугамЖКХ
	               |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Площадь КАК ВТ_Площадь
	               |		ПО бит_РазовыеПоУслугамЖКХ.ЛицевойСчет = ВТ_Площадь.бит_ЛицевыеСчета";  
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Объект.СписокУслуг.Очистить();
	
	Пока Выборка.Следующий() Цикл
				
		Если ЗначениеЗаполнено(Выборка.Сумма1) Тогда			
		Строка = Объект.СписокУслуг.Добавить();			
		Строка.ЛицевойСчет = Выборка.ЛицевойСчетСсылка;
		Строка.Услуга = Выборка.УслугаОДН1;
		Строка.Сумма = Выборка.Сумма1;		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Выборка.Сумма2) Тогда		
		Строка = Объект.СписокУслуг.Добавить();		
		Строка.ЛицевойСчет = Выборка.ЛицевойСчетСсылка;
		Строка.Услуга = Выборка.УслугаОДН2;
		Строка.Сумма = Выборка.Сумма2;		
	КонецЕсли;  
	
		Если ЗначениеЗаполнено(Выборка.Сумма3) Тогда		
		Строка = Объект.СписокУслуг.Добавить();		
		Строка.ЛицевойСчет = Выборка.ЛицевойСчетСсылка;
		Строка.Услуга = Выборка.УслугаОДН3;
		Строка.Сумма = Выборка.Сумма3;		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Выборка.Сумма4) Тогда    		
		Строка = Объект.СписокУслуг.Добавить();	
		Строка.ЛицевойСчет = Выборка.ЛицевойСчетСсылка;
		Строка.Услуга = Выборка.УслугаОДН4;
		Строка.Сумма = Выборка.Сумма4;		
	КонецЕсли; 
	
КонецЦикла;

Запрос = Новый Запрос;
Запрос.Текст = "ВЫБРАТЬ
               |  Хозрасчетный.Ссылка КАК Ссылка
               |ИЗ
               |  ПланСчетов.Хозрасчетный КАК Хозрасчетный
               |ГДЕ
               |  Хозрасчетный.КодБыстрогоВыбора = ""76КУ""";

Выборка = Запрос.Выполнить().Выбрать();  
Если Выборка.Следующий() Тогда
