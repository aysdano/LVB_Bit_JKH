Процедура УдалитьОплатыКУНаСервере()
	// Вставить содержимое обработчика.
	Набор = РегистрыСведений.лб_ДопСведенияОбОплате.СоздатьНаборЗаписей();
	Если Набор.Отбор.Найти("Документ") = Неопределено тогда
		Набор.Отбор.Добавить("Документ");
		Набор.Отбор.Документ.ВидСравнения = ВидСравнения.Равно;
		Набор.Отбор.Документ.Использование = Истина;
	КонецЕсли;	
	

	
	Выборка = Документы.бит_ОплатаКУ.Выбрать();
	Пока ВЫборка.Следующий() цикл
		Набор.Отбор.Документ.Значение = Выборка.Ссылка;
		Набор.Записать(истина);
		
		ДокОбъект = Выборка.ПолучитьОбъект();
		ДокОбъект.СписокЛС.Очистить();
		ДокОбъект.СписокУслуг.Очистить();
		ДокОбъект.СписокУслугПоПериоду.Очистить();
		ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		ДокОбъект.Удалить();
		
		
	КонецЦикла;	
КонецПроцедуры

