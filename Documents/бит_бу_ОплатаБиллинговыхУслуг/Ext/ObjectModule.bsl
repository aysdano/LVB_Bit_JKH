#Область ЭкспортныеПроцедурыИФункции

// БИТ_ЖКХ 22.09.2010. 
// Процедура выполняет распределение оплаты.
//
Процедура ВыполнитьРасчет(ТаблицаЛС = Неопределено, ОтборПоТекущейСтроке = Ложь)Экспорт
	
	Если ТаблицаЛС = Неопределено Тогда
		ТаблицаЛС = СписокЛС.Выгрузить();
	КонецЕсли; 
	
	БиллинговыеУслуги = СписокУслуг.ВыгрузитьКолонки();
	
	бит_РасчетыБиллинговыхУслуг.РаспределитьОплатуБиллинговыхУслуг(Дата, Организация, ТаблицаЛС, БиллинговыеУслуги);
	
	СписокУслуг.Очистить();
	СписокУслуг.Загрузить(БиллинговыеУслуги);
	
	КоличествоЗаписей = БиллинговыеУслуги.Количество();
	
	Для Ном = 1 По КоличествоЗаписей Цикл
		
		СтрокаТаблицы = БиллинговыеУслуги[КоличествоЗаписей - Ном];
		
		Если СтрокаТаблицы.Сумма = 0 Тогда
			
			БиллинговыеУслуги.Удалить(СтрокаТаблицы);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СписокУслуг.Сортировать("Приоритет Возр");
	
КонецПроцедуры

// БИТ_ЖКХ 22.09.2010. 
// Процедура выполняет заполнение счетов и субконто табличной части.
//
Процедура ЗапролнитьСчета() Экспорт
	
	тмпСписокЛС = СписокЛС.ВыгрузитьКолонку("ЛицевойСчет");
	Колонки     = СписокЛС.ВыгрузитьКолонки().Колонки;
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(СписокЛС, Колонки, тмпСписокЛС, Организация, Дата, ИсточникОплаты, Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

//  Процедура выполняет проверку табличных частей при вводе оплаты вручную
//
Процедура ПроверкаОплатыВведнойВРучную(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписокЛС.ЛицевойСчет,
	|	СписокЛС.ШаблонИзвещений,
	|	СписокЛС.Сумма
	|ПОМЕСТИТЬ ЛицевыеСчета
	|ИЗ
	|	&СписокЛС КАК СписокЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокУслуг.ЛицевойСчет,
	|	СписокУслуг.ШаблонИзвещений,
	|	СписокУслуг.Сумма
	|ПОМЕСТИТЬ СписокУслуг
	|ИЗ
	|	&СписокУслуг КАК СписокУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛицевыеСчета.ЛицевойСчет,
	|	ЛицевыеСчета.ШаблонИзвещений,
	|	ЕСТЬNULL(ЛицевыеСчета.Сумма, 0) КАК СуммаОплаты,
	|	ЕСТЬNULL(Услуги.Сумма, 0) КАК СуммаРаспределения
	|ИЗ
	|	ЛицевыеСчета КАК ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СписокУслуг.ЛицевойСчет КАК ЛицевойСчет,
	|			СписокУслуг.ШаблонИзвещений КАК ШаблонИзвещений,
	|			СУММА(СписокУслуг.Сумма) КАК Сумма
	|		ИЗ
	|			СписокУслуг КАК СписокУслуг
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СписокУслуг.ЛицевойСчет,
	|			СписокУслуг.ШаблонИзвещений) КАК Услуги
	|		ПО ЛицевыеСчета.ЛицевойСчет = Услуги.ЛицевойСчет
	|			И ЛицевыеСчета.ШаблонИзвещений = Услуги.ШаблонИзвещений";
	
	Запрос.УстановитьПараметр("СписокЛС"   , СписокЛС);
	Запрос.УстановитьПараметр("СписокУслуг", СписокУслуг);
	
	Выборка = Запрос.Выполнить().Выбрать() ;
	
	Текст = "Сумма оплаты не совпадает с распределенной суммой: ";
	
	Пока Выборка.Следующий() Цикл
		
		СуммаОплаты = Выборка.СуммаОплаты;
		СуммаРасп   = Выборка.СуммаРаспределения;
		
		Если СуммаОплаты <> СуммаРасп Тогда
			
			Отказ = Истина;	
			Текст = Текст + "
			|Лицевой счет """+ Выборка.ЛицевойСчет +""", сумма оплаты: " + СуммаОплаты + ", распределенная сумма: " + СуммаРасп;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если Отказ Тогда
		
		// БИТ_ЖКХ 03.03.2015{{
		// Сообщить(Текст, СтатусСообщения.ОченьВажное);
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		// БИТ_ЖКХ 03.03.2015}}
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ОбеспечениеПроведенияДокумента

// Процедура формирует структуру шапки документа и дополнительных полей.
//
Процедура ПодготовитьСтруктуруШапкиДокумента(Заголовок, СтруктураШапкиДокумента, Отказ) Экспорт
	
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
КонецПроцедуры

// Проверяет правильность заполнения шапки документа.
// Если какой-то из реквизтов шапки, влияющий на проведение не заполнен или
// заполнен не корректно, то выставляется флаг отказа в проведении.
// Проверяется также правильность заполнения реквизитов ссылочных полей документа.
// Проверка выполняется по объекту и по выборке из результата запроса по шапке.
//
// Параметры: 
//  СтруктураШапкиДокумента - выборка из результата запроса по шапке документа,
//  Отказ                   - флаг отказа в проведении,
//  Заголовок               - строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок)
	
	// Укажем, что надо проверить:
	СтруктураОбязательныхПолей = Новый Структура;
	СтруктураОбязательныхПолей.Вставить("Организация");
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры // ПроверитьЗаполнениеШапки()

// Процедура выполняет движения по регистрам.
//
// Параметры:
//  СтруктураШапкиДокумента - Структура.
//  СтруктураТаблиц 		- Структура.
//  Отказ 					- Булево.
//  Заголовок 				- Строка.
//
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, ТаблицаПоЛС, Отказ, Заголовок)
	
	ДатаДока = Дата;
	НачислениеПоУсл = Движения.бит_бу_НачисленияБиллинговыхУслуг;
	Для каждого СтрокаТЧ Из ТаблицаПоУслугам Цикл
		
		Движение = НачислениеПоУсл.Добавить();
		Движение.ВидДвижения        = ВидДвиженияНакопления.Расход;
		Движение.Период             = ДатаДока;
		Движение.Организация        = СтруктураШапкиДокумента.Организация;
		Движение.ЛицевойСчет        = СтрокаТЧ.ЛицевойСчет;
		Движение.Услуга             = СтрокаТЧ.Услуга;
		Движение.Сумма              = СтрокаТЧ.Сумма;
		
	КонецЦикла;
	
	Для каждого СтрокаТЧ Из ТаблицаПоЛС Цикл	
		
		Если ЗначениеЗаполнено( СтрокаТЧ.СчетАбонента) И ЗначениеЗаполнено( СтрокаТЧ.СчетКУ) Тогда
			
			Проводка = Движения.Хозрасчетный.Добавить();
			мСумма = СтрокаТЧ.Сумма;
			Проводка.Период     = СтруктураШапкиДокумента.Дата;
			Проводка.Содержание = "Оплата КУ";
			Проводка.Организация = СтруктураШапкиДокумента.Организация;
			
			Проводка.СчетКт = СтрокаТЧ.СчетАбонента;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.Субконто1);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.Субконто2);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.Субконто3);
			Проводка.СчетДт = СтрокаТЧ.СчетКУ;
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.СубконтоКУ1);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.СубконтоКУ2);
			БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.СубконтоКУ3);
			Проводка.Сумма = мСумма;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры // ДвиженияПоРегистрам()

// Функция готовит таблицы документа для проведения.
//
// Параметры:
//  СтруктураШапкиДокумента - Структура.
//
// Возвращаемое значение:
//  СтруктураТаблиц - Структура.
//
Функция ПодготовитьТаблицыДокумента(СтруктураШапкиДокумента)  Экспорт
	
	// СтруктураТаблиц.Вставить("<ИмяТабличнойЧасти>", ТаблицаПо<ИмяТабличнойЧасти>);
	СтруктураТаблиц = Новый Структура;
	
	Возврат СтруктураТаблиц;
	
КонецФункции // ПодготовитьТаблицыДокумента()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Перем СтруктураШапкиДокумента;
	
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	// Подготовим структуру шапки документа.
	ПодготовитьСтруктуруШапкиДокумента(Заголовок, СтруктураШапкиДокумента, Отказ);
	
	// Проверим правильность заполнения шапки документа.
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ЛицевойСчет" ,"ЛицевойСчет");
	СтруктураПолей.Вставить("Сумма"       ,"Сумма");
	
	СтруктураПолей.Вставить("СчетАбонента" ,"СчетАбонента");
	СтруктураПолей.Вставить("Субконто1"    ,"Субконто1");
	СтруктураПолей.Вставить("Субконто2"    ,"Субконто2");
	СтруктураПолей.Вставить("Субконто3"    ,"Субконто3");
	СтруктураПолей.Вставить("СчетКУ"       ,"СчетКУ");
	СтруктураПолей.Вставить("СубконтоКУ1"  ,"СубконтоКУ1");
	СтруктураПолей.Вставить("СубконтоКУ2"  ,"СубконтоКУ2");
	СтруктураПолей.Вставить("СубконтоКУ3"  ,"СубконтоКУ3");
	
	РезультатЗапросаПоУслугам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "СписокЛС", СтруктураПолей);
	ТаблицаПоЛС               = РезультатЗапросаПоУслугам.Выгрузить();
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ЛицевойСчет"      ,"ЛицевойСчет");
	СтруктураПолей.Вставить("Услуга"           ,"Услуга");
	СтруктураПолей.Вставить("Сумма"            ,"Сумма");
	
	РезультатЗапросаПоУслугам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "СписокУслуг", СтруктураПолей);
	ТаблицаПоУслугам          = РезультатЗапросаПоУслугам.Выгрузить();
	
	Если ВводВРучную Тогда
		
		ПроверкаОплатыВведнойВРучную(Отказ);	
		
	КонецЕсли;
	
	
	Если Не Отказ Тогда
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, ТаблицаПоЛС, Отказ, Заголовок);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ОбработкаУдаленияПроведения".
//
Процедура ОбработкаУдаленияПроведения(Отказ)
	
	бит_ОбщегоНазначения.УдалитьДвиженияРегистратора(ЭтотОбъект, Отказ, РучнаяКорректировка, Ложь);
	
КонецПроцедуры

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ТЗСписокЛС = СписокЛС.Выгрузить(,"ЛицевойСчет");
	Для каждого Строка Из СписокУслуг Цикл
		
		НоваяСтрока =  ТЗСписокЛС.Добавить();
		НоваяСтрока.ЛицевойСчет = Строка.ЛицевойСчет;
		
	КонецЦикла; 
	ТЗСписокЛС.Свернуть("ЛицевойСчет");
	
	СписокЛицевыхСчетов = "";
	Для каждого Строка Из ТЗСписокЛС Цикл
		
		Если ПустаяСтрока(Строка.ЛицевойСчет.Наименование) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если СписокЛицевыхСчетов = "" Тогда
			СписокЛицевыхСчетов = ""+Строка.ЛицевойСчет.Наименование;
		Иначе
			СписокЛицевыхСчетов = ""+СписокЛицевыхСчетов +", " +Строка.ЛицевойСчет.Наименование;
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

