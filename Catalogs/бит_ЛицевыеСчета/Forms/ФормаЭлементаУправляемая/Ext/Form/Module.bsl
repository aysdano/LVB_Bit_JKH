&НаСервере
функция ОпределитьРодство (ПолучательЛьготы)
	
  запрос = новый Запрос;
  запрос.Текст = "ВЫБРАТЬ
                 |	бит_ПроживающиеПоЛС.ФизЛицо КАК ФизЛицо,
                 |	бит_ПроживающиеПоЛС.СтепеньРодства КАК СтепеньРодства
                 |ИЗ
                 |	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
                 |ГДЕ
                 |	бит_ПроживающиеПоЛС.ФизЛицо = &ФизЛицо";
  
  запрос.УстановитьПараметр("ФизЛицо", ПолучательЛьготы.Ссылка);
  
  таб = запрос.Выполнить().Выгрузить();
  
  если таб.Количество() > 0 тогда
	  
	 возврат таб[0].СтепеньРодства; 
	  
  конецесли;	  
  
  
КонецФункции	

