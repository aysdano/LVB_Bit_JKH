КонецПроцедуры

// Процедура - обработчик события "ПослеУдаления" табличного поля "БДДС".
// 
&НаКлиенте
Процедура БДДСПослеУдаления(Элемент)
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("СтатьяОборотов", Элементы.БДДС.ОтборСтрок.СтатьяОборотов);
	Отбор.Вставить("Период"        , Элементы.БДДС.ОтборСтрок.Период);
	Отбор.Вставить("ИД"            , Элементы.БДДС.ОтборСтрок.ИД);
	
	ЗаполнитьЗначениеЯчейкиДерева(Отбор);
	
	ТекущиеДанныеДрева   = Элементы.ДанныеДерева.ТекущиеДанные;
	ТекущаяЭлементДерева = Элементы.ДанныеДерева.ТекущийЭлемент;
	
	Если ТекущаяЭлементДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанныеДрева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = ТекущаяЭлементДерева.Имя;
	
	Если Найти(ИмяКолонки,"РеквизитДерева_") > 0 И ЗначениеЗаполнено(СпособРаспределения)Тогда
		СуммаРаспределения = ТекущиеДанныеДрева[ИмяКолонки];
		ЗаполнитьПроцентБДДС(СуммаРаспределения);
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ПриНачалеРедактирования" табличного поля "БДДС".
//
&НаКлиенте
Процедура БДДСПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущиеДанные = Элементы.БДДС.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекОтборСтрок = Элементы.БДДС.ОтборСтрок;
	
	Если Не Копирование Тогда
		
		Если ТекОтборСтрок.Свойство("СтатьяОборотов") Тогда
			ТекущиеДанные.СтатьяОборотов = ТекОтборСтрок.СтатьяОборотов;
		КонецЕсли;
		Если ТекОтборСтрок.Свойство("Период") Тогда
			ТекущиеДанные.Период = ТекОтборСтрок.Период;
		КонецЕсли;
		Если ТекОтборСтрок.Свойство("ИД") Тогда
			ТекущиеДанные.ИД = ТекОтборСтрок.ИД;
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "Процент" табличного поля "БДДС".
//
&НаКлиенте
Процедура БДДСПроцентПриИзменении(Элемент)
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("СтатьяОборотов", Элементы.БДДС.ОтборСтрок.СтатьяОборотов);
	Отбор.Вставить("Период"        , Элементы.БДДС.ОтборСтрок.Период);
	Отбор.Вставить("ИД"            , Элементы.БДДС.ОтборСтрок.ИД);
	
	ПроцентИтог = ВычислитьИтогСОтбором("БДДС", Отбор, "Процент");
	
	ИмяКолонки = "РеквизитДерева_" + Формат(Отбор.Период,"ДФ=yyyyMMdd");
	
	СуммаКонтроль = Элементы.ДанныеДерева.ТекущиеДанные[ИмяКолонки];
	
	ТекстПодвала = "";
	
	Если ПроцентИтог > 100 Тогда
		
		Процент = ПроцентИтог - 100;
		
		ТекстПодвала  = "Превышен на : " + Процент
		
	Иначе
		
		РазбитьСуммуПоЗданиям(Отбор, СуммаКонтроль);
		
	КонецЕсли;
	
	Элементы.БДДСПроцент.ТекстПодвала = ТекстПодвала;
	
КонецПроцедуры

// Процедура - обработчик события "НачалоВыбора" поля ввода "Здание" табличного поля "БДДС".
//
&НаКлиенте
Процедура БДДСЗданиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	УсловияОтбора = Новый Структура;
	УсловияОтбора.Вставить("Организация", Объект.Организация);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Отбор", УсловияОтбора);
	
	ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая", ПараметрыФормы, Элемент);
	
КонецПроцедуры

// Процедура - обработчик события "ОбработкаВыбора" поля ввода "Здание" табличного поля "БДДС".
//
&НаКлиенте
Процедура БДДСЗданиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекущиеДанные = Элементы.БДДС.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Отбор.Вставить("СтатьяОборотов", Элементы.БДДС.ОтборСтрок.СтатьяОборотов);
	Отбор.Вставить("Период"        , Элементы.БДДС.ОтборСтрок.Период);
	Отбор.Вставить("ИД"            , Элементы.БДДС.ОтборСтрок.ИД);
	Отбор.Вставить("Здание"        , ВыбранноеЗначение);
	
	МассивСтрок = Объект.БДДС.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() = 0 Тогда
		
		ТекущиеДанные.Адрес               = ВыбранноеЗначение.ПочтовыйАдрес;
		ТекущиеДанные.Здание              = ВыбранноеЗначение;
		ТекущиеДанные.ЗданиеПредставление = "ул." + ВыбранноеЗначение.Улица + " ,д" + ВыбранноеЗначение;
		
		ТекущиеДанныеДрева   = Элементы.ДанныеДерева.ТекущиеДанные;
		ТекущаяЭлементДерева = Элементы.ДанныеДерева.ТекущийЭлемент;
		
		Если ТекущаяЭлементДерева = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		Если ТекущиеДанныеДрева = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		ИмяКолонки = ТекущаяЭлементДерева.Имя;
		
		Если Найти(ИмяКолонки,"РеквизитДерева_") > 0 Тогда
			СуммаРаспределения = ТекущиеДанныеДрева[ИмяКолонки];
			ЗаполнитьПроцентБДДС(СуммаРаспределения);
		КонецЕсли;
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Здание уже выбрано.";
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
КонецПроцедуры

