	|			ТОГДА 2
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК НомерКартинки,
	|	бит_Комнаты.Ссылка КАК Ссылка,
	|	бит_Комнаты.Ссылка КАК Комната,
	|	бит_Комнаты.ЧастьПомещения
	|ИЗ
	|	Справочник.бит_Комнаты КАК бит_Комнаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКомнате.СрезПоследних(&Момент, Комната.Владелец = &Владелец) КАК бит_СведенияОКомнатеСрезПоследних
	|		ПО (бит_СведенияОКомнатеСрезПоследних.Комната = бит_Комнаты.Ссылка)
	|ГДЕ
	|	бит_Комнаты.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец", Объект.Квартира);
	Запрос.УстановитьПараметр("Момент"  , ТекущаяДата());
	
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписей.Количество() > 0 Тогда 
		
		ТаблицаКомнатЗначений.Загрузить(ТаблицаЗаписей);
		
	КонецЕсли;
	
	ТаблицаКомнатЗначений.Сортировать("НомерКомнаты Возр");
	
	Модифицированность = Ложь;
	
КонецПроцедуры

