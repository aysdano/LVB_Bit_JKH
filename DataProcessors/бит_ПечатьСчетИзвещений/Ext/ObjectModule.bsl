Процедура ЗаполнитьТаблицаПлатежиГИСЖКХ36(ЛС, Источник)
	
	//// Если долговой, не заполняем таблицу.
	//Если ШаблонИзвещений.Сальдо = Перечисления.ДаНет.Да Тогда
	//	Возврат;	
	//КонецЕсли;
	
	НоваяСтр = мТаблицаПлатежиГИСЖКХ36.Добавить();
	НоваяСтр.ЛицевойСчет		= ЛС;
	НоваяСтр.Услуга				= Источник.Услуга;
	НоваяСтр.ГрафаОтчетаПоГЦЖС	= Источник.ГрафаОтчетаГЦЖС;
	НоваяСтр.ОбъемКомУслугИнд	= Источник.ОбъемИНД;
	НоваяСтр.ОбъемКомУслугОбщ	= Источник.ОбъемОбщДом;
	НоваяСтр.СпособРасчета		= Источник.СпособРасчета;
	НоваяСтр.Тариф				= Источник.НастройкаСтавки;
	НоваяСтр.Перерасчеты		= Источник.Разовые;
	НоваяСтр.Льготы				= Источник.Льгота;
	НоваяСтр.ПорядокРасчетов	= "";
	НоваяСтр.НормативИнд		= Источник.НормативИНД;
	НоваяСтр.НормативОбщ		= Источник.НормативОбщДом;
	Если Источник.ОбщедомовыеНачисления Тогда
		НоваяСтр.ТекПоказанияИнд	= Источник.КоличествоЕдиницИНД;
		НоваяСтр.ТекПоказанияОбщ	= Источник.КоличествоЕдиницГУРП;
	Иначе
		НоваяСтр.ТекПоказанияИнд	= Источник.КоличествоЕдиницИНД + Источник.КоличествоЕдиницГУРП;
		НоваяСтр.ТекПоказанияОбщ	= 0;
	КонецЕсли;
	НоваяСтр.СуммарныйОбъемИнд	= Источник.ИтогоОбъемИнд;
	НоваяСтр.СуммарныйОбъемОбщ	= Источник.ИтогоОбъемОбщедомовых;
	НоваяСтр.ИтогоКОплатеВсего	= Источник.КОплатеЗаМесяц;
	НоваяСтр.НачисленоИнд		= Источник.НачисленоИнд;
	НоваяСтр.НачисленоОбщДом	= Источник.НачисленоОбщДом;
	
// БИТ ЖКХ 26.12.2019	
	НоваяСтр.АвансНаНачалоПериода = Источник.Сальдо;
	НоваяСтр.ЗадолженностьЗаПредыдущиеПериоды = Источник.Долг;
	НоваяСтр.ИтогПени = Источник.Пени;
	НоваяСтр.ИтогоКОплате = Источник.КОплате;
	
	// БИТ ЖКХ 17.2.2020	
	НоваяСтр.ЗакрытиеВхДолга = Источник.ЗакрытиеВхДолга;

	
КонецПроцедуры

Процедура ОбновитьТаблицаПлатежиГИСЖКХ36(ЛС, Источник, ИспользоватьКомментарийКакОснование)
	
	МассивСтрок = мТаблицаПлатежиГИСЖКХ36.НайтиСтроки(Новый Структура("ЛицевойСчет, Услуга", ЛС, Источник.Услуга));
	Для Каждого Элт Из МассивСтрок Цикл
		Если ИспользоватьКомментарийКакОснование Тогда
			Элт.ОснованиеПересчетов	= Источник.Комментарий;
		Иначе	
			Элт.ОснованиеПересчетов	= Источник.Основание;
		КонецЕсли;
		Элт.СуммаПересчетов	= Источник.Сумма;
	КонецЦикла;
	
КонецПроцедуры	

