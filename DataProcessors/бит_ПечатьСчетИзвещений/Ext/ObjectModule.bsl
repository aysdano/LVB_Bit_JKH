					ОбластьРаздел5Строка.Параметры.Основание = СтрокаСведений.Комментарий;
				КонецЕсли; 
				
				ОбновитьТаблицаПлатежиГИСЖКХ36(мСтруктураДанных.ЛицевойСчет, СтрокаСведений, ИспользоватьКомментарийКакОснование);
				
				ТабДокуРаздел5.Вывести(ОбластьРаздел5Строка);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если НЕ ТабДокуРаздел5 = Неопределено Тогда
			Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(Квитанция, ТабДокуРаздел5) Тогда
				Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
				Квитанция.Вывести(ТабДокуРаздел5);
			Иначе
				Квитанция.Вывести(ТабДокуРаздел5);
			КонецЕсли;  
		КонецЕсли; 
		
		// ОбластьРаздел7.
		ТабДокуРаздел7 = Неопределено;
		Если ТабПечатиКап.Количество() > 0 Тогда
			
			ТабДокуРаздел7 = Новый ТабличныйДокумент;
			ТабДокуРаздел7.Вывести(ОбластьРаздел7Шапка);
			Для каждого СтрокаПечати Из ТабПечатиКап Цикл
				
				Если НеПечататьУслугиБезНачислений(СтрокаПечати) Тогда
					Продолжить;
				КонецЕсли;
				
				ОбластьРаздел7Строка.Параметры.Заполнить(СтрокаПечати);
				ТабДокуРаздел7.Вывести(ОбластьРаздел7Строка);
				
			КонецЦикла; 
		КонецЕсли;
		
		Если НЕ ТабДокуРаздел7 = Неопределено 
			И ТабДокуРаздел7.ВысотаТаблицы > 7 Тогда // Есть записи.
			Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(Квитанция, ТабДокуРаздел7) Тогда
				Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
				Квитанция.Вывести(ТабДокуРаздел7);
			Иначе
				Квитанция.Вывести(ТабДокуРаздел7);
			КонецЕсли;  
		КонецЕсли; 
		
		// ОбластьРаздел8.
		ТабДокуРаздел8 = Неопределено;
		Если ТабПечатиКап.Количество() > 0 Тогда
