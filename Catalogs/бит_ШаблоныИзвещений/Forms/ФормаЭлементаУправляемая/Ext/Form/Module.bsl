&НаСервереБезКонтекста
Функция ПолучитьСписокГЦЖС()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ГрафыОтчетаПоГЦЖС.Ссылка
	|ИЗ
	|	Перечисление.бит_ГрафыОтчетаПоГЦЖС КАК бит_ГрафыОтчетаПоГЦЖС
	|ГДЕ
	|	бит_ГрафыОтчетаПоГЦЖС.Ссылка <> ЗНАЧЕНИЕ(Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ЗНАЧЕНИЕ(Перечисление.бит_ГрафыОтчетаПоГЦЖС.ПустаяСсылка)";
	
	
	Возврат Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");
	
КонецФункции
// БИТ_ЖКХ 07.06.2016 18:26:27 Конец правки.

&НаКлиенте
Процедура УслугиУслугаНачалоВыбораЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
	
	Элемент = ДополнительныеПараметры.Элемент;
	
	ВыбранныйЭлемент = ВыбранныйЭлемент1;
	
	Если ВыбранныйЭлемент = Неопределено Тогда // Отказ от выбора.
		Возврат;
	КонецЕсли;
	
	ВыбранныйТип = ВыбранныйЭлемент.Значение;
	ОткрытьФорму("Справочник."+ВыбранныйТип+".ФормаВыбора",,Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиУслугаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекДанные = Элементы.Услуги.ТекущиеДанные;
	
	Если ВыбранноеЗначение = Неопределено  Тогда
		Возврат;
	КонецЕсли;
	
	Отбор = Новый Структура ("Услуга", ВыбранноеЗначение);
	
	НайденныеСтроки = Объект.Услуги.НайтиСтроки(Отбор);
	
	КоличествоСтрок = НайденныеСтроки.Количество();
	
	Если КоличествоСтрок = 0 И НЕ ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.бит_УслугиЖКХ.Пеня") Тогда
		
	Иначе	
		
		СтандартнаяОбработка = Ложь;
		ПоказатьПредупреждение(Новый ОписаниеОповещения("УслугиУслугаОбработкаВыбораЗавершение", ЭтотОбъект), "Услуги дублируются, выберите другую(кроме пени)");
		
	КонецЕсли; 
	
КонецПроцедуры

