&НаСервере
Процедура ЗаполнитьОтветственныхОбнуленныхЛСНаСервере()
	// Вставить содержимое обработчика.
	МассивСтру2 = ЗагрузитьДБФВМассивСтруктур();
	Табл = новый таблицаЗначений;               
	Табл.Колонки.Добавить("ИмяЛС",новый ОписаниеТипов("Строка"));
	Табл.Колонки.Добавить("ИмяЛС10",новый ОписаниеТипов("Строка"));

	//Для каждого Стру из МассивСтру2 цикл
	//	Если сокрЛП(Стру.OTV)="0" тогда
	//		НС = Табл.Добавить();
	//		НС.ИмяЛС = сокрЛП(Стру.LS);
	//	КонецЕсли;	
	//КонецЦикла;	
	
	//для ускорения форматируем цикл в одну строку
	Для каждого Стру из МассивСтру2 цикл Если сокрЛП(Стру.OTV)="0" тогда НС = Табл.Добавить();НС.ИмяЛС = сокрЛП(Стру.LS); НС.ИмяЛС10 = лев(НС.ИмяЛС +"         ",10);КонецЕсли;КонецЦикла;	

		
	
	//Запросом отбираем ЛС, на которых никогда не было проживающих
	ЗАпрос = новый запрос;
	Запрос.УстановитьПараметр("Дата1",'2018-12-31');	
	Запрос.УстановитьПараметр("Т",Табл);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Выразить(Т.ИмяЛС как строка(100)) КАК ИмяЛС,
		|	Выразить(Т.ИмяЛС10 как строка(10)) КАК ИмяЛС10
		|ПОМЕСТИТЬ СписокИменЛС
		|ИЗ
		|	&Т КАК Т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК Ссылка
		|ПОМЕСТИТЬ СписокЛС
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 10) В
		|			(ВЫБРАТЬ
		|				СписокИменЛС.ИмяЛС10 КАК ИмяЛС10
		|			ИЗ
		|				СписокИменЛС КАК СписокИменЛС)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	СписокЛС.Ссылка КАК ЛС,
		|	ЕСТЬNULL(бит_ПроживающиеПоЛССрезПоследних.ФизЛицо, ИСТИНА) КАК Поле1
		|ПОМЕСТИТЬ ПустыеЛС
		|ИЗ
		|	СписокЛС КАК СписокЛС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
		|				&Дата1,
		|				ЛицевойСчет В
		|					(ВЫБРАТЬ
		|						СписокЛС.Ссылка КАК Ссылка
		|					ИЗ
		|						СписокЛС КАК СписокЛС)) КАК бит_ПроживающиеПоЛССрезПоследних
		|		ПО СписокЛС.Ссылка = бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
		|ГДЕ
		|	ЕСТЬNULL(бит_ПроживающиеПоЛССрезПоследних.ФизЛицо, ИСТИНА) = ИСТИНА
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИменаОтв.ЛС КАК ЛС,
		|	МИНИМУМ(ИменаОтв.Наименование) КАК Наименование
		|ПОМЕСТИТЬ ЕстьОтв
		|ИЗ
		|	(ВЫБРАТЬ
		|		ПустыеЛС.ЛС КАК ЛС,
		|		бит_Проживающие.Наименование КАК Наименование
		|	ИЗ
		|		ПустыеЛС КАК ПустыеЛС
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие КАК бит_Проживающие
		|			ПО (ПОДСТРОКА(ПустыеЛС.ЛС.Наименование, 1, 10) = ПОДСТРОКА(бит_Проживающие.Наименование, 1, 10))) КАК ИменаОтв
		|
		|СГРУППИРОВАТЬ ПО
		|	ИменаОтв.ЛС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ЕстьОтв.ЛС КАК ЛС,
		|	ЕстьОтв.Наименование КАК Наименование,
		|	бит_Проживающие.Ссылка КАК ФизЛицо,
		|	ЕстьОтв.ЛС.Наименование КАК ИмяЛС
		|ИЗ
		|	ЕстьОтв КАК ЕстьОтв
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие КАК бит_Проживающие
		|		ПО ЕстьОтв.Наименование = бит_Проживающие.Наименование
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_Проживающие.Код
		|ИТОГИ
		|	МАКСИМУМ(ИмяЛС)
		|ПО
		|	ЛС";
	ВыборкаЛС = ЗАпрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаЛС.Количество()=0 тогда
		возврат
	КонецЕсли;	
	
	Если Не ЗначениеЗаполнено(ЭтаФорма.Регистратор) тогда
		ДокОбъект = Документы.ОперацияБух.СоздатьДокумент();
		ДокОбъект.Дата = '2018-01-01';
		ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
		Регистратор = ДокОбъект.Ссылка;
	КонецЕсли;
	Набор = РегистрыСведений.бит_ПроживающиеПоЛС.СоздатьНаборЗаписей();
	Набор.Отбор.Регистратор.Значение = Регистратор;
	
	ОтветственныйНеПроживает = Справочники.бит_СтатусФизЛица.НайтиПоНаименованию("Ответственный не проживает");
	
	Пока ВыборкаЛС.Следующий() цикл
		ЛС = ВыборкаЛС.ЛС;
		Выборка = ВыборкаЛС.Выбрать();
		Если Выборка.Следующий() тогда
