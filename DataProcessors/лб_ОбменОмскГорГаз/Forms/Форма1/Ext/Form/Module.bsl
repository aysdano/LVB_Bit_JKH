	ДБФ.Поля.Добавить("DAT_REG_LG", "D", 8);
	ДБФ.Поля.Добавить("LGOT_DOC", "S", 50);

	ДБФ.СоздатьФайл(ФайлПроживающиеРегионГазВр);
	
	Возврат ДБФ;

