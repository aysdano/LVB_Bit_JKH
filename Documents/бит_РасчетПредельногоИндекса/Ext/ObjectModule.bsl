			ДвижениеРасчет.МесячныйОбъемКоммунальныхУслугРассчитанныйПоПоказаниямПриборовУчетаВТекущемПериоде = СтрокаТЧ.ОбъемПоСчетчикам;
			ДвижениеРасчет.ПредельныйИндекс                                                                   = СтрокаТЧ.ПредельныйИндекс;
			ДвижениеРасчет.ПлатаГражданЗаКоммунальныеУслугиСУчетомТарифаПрименяемогоВПериодеСравнения         = СтрокаТЧ.НачисленоДо;
			ДвижениеРасчет.ПлатаГражданЗаКоммунальныеУслугиСУчетомТарифаПрименяемогоВТекущемПериоде           = СтрокаТЧ.Начислено;
			ДвижениеРасчет.ПревышениеСовокупнойПлатыГражданЗаКоммунальныеУслугиСУчетомПредельныхИндексов      = СтрокаТЧ.Превышение; 
			ДвижениеРасчет.СуммаНедополученныхДоходов                                                         = СтрокаТЧ.СуммаНедополученныхДоходов;
			ДвижениеРасчет.ПревышениеВПроцентах                                                               = СтрокаТЧ.ПревышениеВПроцентах;
			// БИТ_ЖКХ_10012014_начало_изменений
			ДвижениеРасчет.ПоказанияСчетчиков                                                                 = СтрокаТЧ.ПоказанияСчетчика;                  
			// БИТ_ЖКХ_10012014_окончание_изменений
			
		КонецЕсли;
		
		Если СтрокаТЧ.СуммаНедополученныхДоходов > 0 Тогда
			
			Движение                             = НачислениеПоУслугам.ДобавитьРасход();
			Движение.Сумма                       = СтрокаТЧ.СуммаНедополученныхДоходов;	
			Движение.Период                      = ДатаДока;
			Движение.ЛицевойСчет                 = СтрокаТЧ.ЛицевойСчет;
			Движение.УслугаЖКХ                   = СтрокаТЧ.Услуга;
			
			// БИТ_ЖКХ 29.05.2014	
			Движение.Организация   = СтруктураШапкиДокумента.Организация;
			// БИТ_ЖКХ 29.05.2014
			
			// БИТ_ЖКХ 15.03.2016 14:38:05 Начало правки...
			ДвижениеУслПоПериоду = НачислениеПоУслПоПериоду.ДобавитьРасход();
			ДвижениеУслПоПериоду.Сумма				  = СтрокаТЧ.СуммаНедополученныхДоходов;	
			ДвижениеУслПоПериоду.Период				  = ДатаДока;
			ДвижениеУслПоПериоду.ПериодВзаиморасчетов = ДатаДока;
			ДвижениеУслПоПериоду.ЛицевойСчет		  = СтрокаТЧ.ЛицевойСчет;
			ДвижениеУслПоПериоду.УслугаЖКХ			  = СтрокаТЧ.Услуга;
			ДвижениеУслПоПериоду.Организация		  = СтруктураШапкиДокумента.Организация;
			// БИТ_ЖКХ 15.03.2016 14:38:05 Конец правки.
			
			Если ЗначениеЗаполнено(СтрокаТЧ.СчетАбонента) И ЗначениеЗаполнено(СтрокаТЧ.СчетКУ) Тогда 
				
				Проводка             = Движения.Хозрасчетный.Добавить();
				Проводка.Период      = СтруктураШапкиДокумента.Дата;
				Проводка.Содержание  = "Предельный индекс";
				Проводка.Организация = СтруктураШапкиДокумента.Организация;
				
				// БИТ_ЖКХ 18.03.2016 17:43:23 Начало правки... требование поменять местами дт и кт 
				//Проводка.СчетДт    = СтрокаТЧ.СчетАбонента;
				
				//БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.Субконто1);
				//БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.Субконто2);
				//БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.Субконто3);

				//Проводка.СчетКт    = СтрокаТЧ.СчетКУ;
				
				//БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.СубконтоКУ1);
				//БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.СубконтоКУ2);
				//БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.СубконтоКУ3);

				Проводка.СчетДт      = СтрокаТЧ.СчетКУ;
				
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.СубконтоКУ1);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.СубконтоКУ2);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.СубконтоКУ3);
				
				Проводка.СчетКт      = СтрокаТЧ.СчетАбонента;
				
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.Субконто1);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.Субконто2);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.Субконто3);
				// БИТ_ЖКХ 18.03.2016 17:43:21 Конец правки. 
				
				Проводка.Сумма       = СтрокаТЧ.СуммаНедополученныхДоходов;
				
				Если СтрокаТЧ.СчетКУ = ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД  Тогда
					
					Если ЗначениеЗаполнено(Проводка.СубконтоКт.СтавкиНДС) Тогда
						
						
						// БИТ_ЖКХ 10.02.2014
						// НДС_Ставка = УчетНДС.ПолучитьСтавкуНДС(Проводка.СубконтоКт.СтавкиНДС);.
						НДС_Ставка = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Проводка.СубконтоКт.СтавкиНДС);
						// БИТ_ЖКХ 10.02.2014
						
						Проводка.СуммаНУКт = СтрокаТЧ.Начислено - (СтрокаТЧ.Начислено * (НДС_Ставка / (100 + НДС_Ставка)));
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

