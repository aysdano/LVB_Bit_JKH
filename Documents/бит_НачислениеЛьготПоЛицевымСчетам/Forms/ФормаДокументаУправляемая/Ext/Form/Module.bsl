#Область ПроцедурыИФункцииОбщегоНазначения

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции // ПолучитьТипОбъекта()

#КонецОбласти

#Область ПроцедурыИФункцииДляУправленияВнешнимВидомФорм

&Наклиенте
Процедура ЗадатьВопросНаОчисткуТабЧасти(НачальноеЗначение, ВыбранноеЗначение)
	
	Если НачальноеЗначение <> ВыбранноеЗначение Тогда
		
		Если Объект.ЛицевыеСчета.Количество() > 0 Тогда
			
			Ответ = Неопределено;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ЗадатьВопросНаОчисткуТабЧастиЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&Наклиенте
Процедура ЗадатьВопросНаОчисткуТабЧастиЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Объект.ЛицевыеСчета.Очистить();
	
	Если Объект.СписокЛьгот.Количество() > 0 Тогда
		
		Объект.СписокЛьгот.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры // УстановитьЗаголовокФормыДокумента()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ДокументОбъект.ОбновитьПараметрыЖКХ();
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
	Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию = ?(Объект.ВводВРучную, Истина, Ложь);			
	Элементы.ЛицевыеСчетаНачислено.ТолькоПросмотр                  = НЕ Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию;
	Элементы.СписокЛьготСуммаЛичной.ТолькоПросмотр                 = НЕ Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию;
	Элементы.СписокЛьготНачисленоСемейной.ТолькоПросмотр           = НЕ Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию;	
	
	// БИТ_ЖКХ 24.08.2016 17:52:31 Начало правки...
	Массив = Новый Массив();
	Массив.Добавить(Тип("СправочникСсылка.бит_Проживающие"));
	ОписаниеТипаПроживающие = Новый ОписаниеТипов(Массив);
	Элементы.СписокЛьготФизЛицо.ОграничениеТипа = ОписаниеТипаПроживающие;
	// БИТ_ЖКХ 24.08.2016 17:52:31 Конец правки.
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Установить доступность формы с учетом даты запрета редактирования.	
	УстановитьДоступностьФормыДляРедактированияНаСервере();
	
	УстановитьЗаголовокФормыДокумента();
	
	// БИТ_ЖКХ 13.01.2015{{
	ИнтерфейсТакси = ТекущийВариантИнтерфейсаКлиентскогоПриложения() = ВариантИнтерфейсаКлиентскогоПриложения.Такси;
	
	Если НЕ ИнтерфейсТакси Тогда
		
		Элементы.Группа4.Высота = 0;
		Элементы.Группа4.РастягиватьПоВертикали = Истина; 
		
		Элементы.Страницы.Высота = 0;
		Элементы.Страницы.РастягиватьПоВертикали = Истина; 
		
		Элементы.ЛицевыеСчета.Высота = 0;
		Элементы.ЛицевыеСчета.РастягиватьПоВертикали = Истина; 
		
	КонецЕсли;
	// БИТ_ЖКХ 13.01.2015}}
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФорм

&НаКлиенте
Процедура Рассчитать(Команда)
	
	Если Объект.ЛицевыеСчета.Количество() > 0 Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("РассчитатьЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		
	иначе	
		
		РассчитатьНачисленияПоЛицевымСчетамНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	РассчитатьНачисленияПоЛицевымСчетамНаСервере();
	
	Для Каждого Строка Из Объект.СписокЛьгот Цикл
		
		// БИТ_ЖКХ 06.12.2016 14:07:44 Начало правки... 
		//Строка.СуммаСумм = Окр(Строка.СуммаЛичной,2) + Окр(Строка.НачисленоСемейной,2);
		Строка.СуммаСумм = Строка.СуммаЛичной + Строка.НачисленоСемейной;
		// БИТ_ЖКХ 06.12.2016 14:07:45 Конец правки. 
		
	КонецЦикла;
	
	Для Каждого СтрокаЛС Из Объект.ЛицевыеСчета Цикл
		
		Отбор = Новый Структура;
		
		Отбор.Очистить();
		Отбор.Вставить("ЛицевойСчет", СтрокаЛС.ЛицевойСчет);
		Отбор.Вставить("Услуга"     , СтрокаЛС.Услуга);
		
		МассивСтрокЛьгот = Объект.СписокЛьгот.НайтиСтроки(Отбор);
		
		Если МассивСтрокЛьгот.Количество()>1 Тогда
			
			МассивСтрокЛицевыеСчета = Объект.ЛицевыеСчета.НайтиСтроки(Отбор);
			
			Для Каждого Строка Из МассивСтрокЛицевыеСчета Цикл
				
				СуммаСумм = 0;
				
				Для Каждого Строка Из МассивСтрокЛьгот Цикл
					
					СуммаСумм = СуммаСумм + Строка.СуммаСумм;
					
					Строка.Начислено = Строка.СуммаСумм; 
					
				КонецЦикла;
				
				СтрокаЛС.Начислено =  СуммаСумм;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНачисленияЛьготВручную(Команда)
	
	Если НЕ Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию Тогда
		
		Объект.ВводВручную = Истина;
		
	Иначе
		
		// Восстановим автоматические движения документа.
		ПоказатьВопрос(Новый ОписаниеОповещения("РедактироватьНачисленияЛьготВручнуюЗавершение", ЭтотОбъект), "Ручная корректировка начислений льгот по лицевым счетам отменена. 
		|Восстановить начисления сформированные автоматически?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	РедактироватьНачисленияЛьготВручнуюФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНачисленияЛьготВручнуюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОчиститьЛицевыеСчетаНаСервере();
	
	ОчиститьСписокЛьготНаСервере();
	
	РассчитатьНачисленияПоЛицевымСчетамНаСервере();
	
	Объект.ВводВручную = Ложь;
	
	РедактироватьНачисленияЛьготВручнуюФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНачисленияЛьготВручнуюФрагмент()
	
	Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию = ?(Объект.ВводВРучную, Истина, Ложь);
	Элементы.ЛицевыеСчетаНачислено.ТолькоПросмотр                  = НЕ Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию;
	Элементы.СписокЛьготСуммаЛичной.ТолькоПросмотр                 = НЕ Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию;
	Элементы.СписокЛьготНачисленоСемейной.ТолькоПросмотр           = НЕ Элементы.РедактироватьНачисленияЛьготВручную.КнопкаПоУмолчанию;
	
КонецПроцедуры 

