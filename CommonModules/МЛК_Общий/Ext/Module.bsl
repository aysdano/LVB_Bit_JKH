Функция ПолучитьСтруктуруДанныхЛицевогоСчета(ЛицевойСчет,Настройки)
	Структура = Новый Структура("Phone, Email, Имя_Отчество, Город, Улица, Дом, Корпус, Квартира, ApiSumma, Помещение");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиесяПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ПроживающиесяПоЛССрезПоследних.СтатусФизЛица,
	|	ПроживающиесяПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	ПроживающиесяПоЛССрезПоследних.СтатусПроживания,
	|	ПроживающиесяПоЛССрезПоследних.ДатаЗаписи,
	|	ПроживающиесяПоЛССрезПоследних.ДатаРегистрации,
	|	ПроживающиесяПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	ПроживающиесяПоЛССрезПоследних.ВладелецКвартиры,
	|	ПроживающиесяПоЛССрезПоследних.ДоляПлощади,
	|	ПроживающиесяПоЛССрезПоследних.СтатусФизЛицаДляИзменения
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиесяПоЛССрезПоследних
	|ГДЕ
	|	(ПроживающиесяПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиесяПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Момент"		, КонецДня(ТекущаяДатаСеанса()));
	Запрос.УстановитьПараметр("ЛицевойСчет"	, ЛицевойСчет.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл 
		
		Если Выборка.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
			ОтветственноеЛицо = Выборка.ФизЛицо;
		КонецЕсли; 
		
	КонецЦикла; 
	
	ВладелецЛицевогоСчета = ОтветственноеЛицо;
	
	Если Настройки.ПередаватьФамилию Тогда
		// Структура.Имя_Отчество        = ВладелецЛицевогоСчета.Наименование; 
		Структура.Имя_Отчество        = СтрЗаменить(ВладелецЛицевогоСчета.Наименование,"""","\"+"""");
	Иначе
		Попытка
			ИмяОтчество = ФизическиеЛицаКлиентСервер.ЧастиИмени(ВладелецЛицевогоСчета.Наименование);
			Структура.Имя_Отчество        = СтрЗаменить(Строка(ИмяОтчество.Имя)+" "+Строка(ИмяОтчество.Отчество),"""","\"+"""");
		Исключение
			Структура.Имя_Отчество        = "";
		КонецПопытки;
	КонецЕсли;
	
	// Структура.Имя_Отчество = Транслит(Структура.Имя_Отчество);
	Если ЗначениеЗаполнено(ВладелецЛицевогоСчета) Тогда
		Телефон              = бит_ОбщегоНазначения.ПолучитьТелефонИзКонтактнойИнформацииФизЛица(ВладелецЛицевогоСчета);
		Тел = СтрЗаменить(Телефон,"-","");
		Тел = СтрЗаменить(Тел,"+7","7");
		Тел = СтрЗаменить(Тел,"-","");
		Тел = СтрЗаменить(Тел,"(","");
		Тел = СтрЗаменить(Тел,")","");
		Тел = СтрЗаменить(Тел,Символы.НПП,"");
		Тел = СтрЗаменить(СокрЛП(Тел)," ","");
		Если Лев(Тел,1)="8" И СтрДлина(Тел)>6 Тогда
			//	Тел = СтрЗаменить(Лев(Тел,1),"8","7");
			тел="7" + Прав(тел,СтрДлина(тел)-1);
		КонецЕсли;
		
		Структура.Phone               = Тел;
		
		
		//Запрос = Новый Запрос;
		//Запрос.Текст = 
		//"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		//|	КонтактнаяИнформация.Представление КАК Представление,
		//|	КонтактнаяИнформация.Вид КАК Вид
		//|ИЗ
		//|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
		//|ГДЕ
		//|	КонтактнаяИнформация.Объект = &Объект
		//|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.бит_ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		//|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.бит_ВидыКонтактнойИнформации.EmailПроживающего)";
		//
		//Запрос.УстановитьПараметр("Объект", ВладелецЛицевогоСчета);
		//Выборка = Запрос.Выполнить().Выбрать();
		//
		//ЭлПочтаПроживающего = "";
		//Пока Выборка.Следующий() Цикл
		//	Если Выборка.Вид <> Справочники.Бит_ВидыКонтактнойИнформации.EmailПроживающего Тогда Продолжить; КонецЕсли;
		//	ЭлПочтаПроживающего = Выборка.Представление;
		//	Структура.Email     = ЭлПочтаПроживающего;
		//	Прервать;
		//КонецЦикла;
		Для каждого СтрЕм Из ОтветственноеЛицо.КонтактнаяИнформация Цикл
			Если Найти(Нрег(СтрЕм.Вид),"email")<>0 Тогда
				Структура.Email     = СтрЕм.Представление;
				Прервать;
			КонецЕсли;	
		КонецЦикла;
		
		
		
		Структура.Улица    = ЛицевойСчет.Здание.Улица;
		Структура.Город    = ЛицевойСчет.Здание.Район;
		Структура.Дом      = Строка(ЛицевойСчет.Здание.Улица)+", д. "+ЛицевойСчет.Здание.НомерДома+СТрока(?(ЛицевойСчет.Здание.Корпус="","",", корп. "+Строка(ЛицевойСчет.Здание.Корпус)));
		Структура.Корпус   = ЛицевойСчет.Здание.Корпус;
		Структура.Квартира = ЛицевойСчет.Квартира.Наименование;
		Структура.Помещение = ЛицевойСчет.Здание.ПочтовыйАдрес+", кв. "+Строка(ЛицевойСчет.Квартира.НомерКвартиры);
	Иначе
		Структура.Улица    = ЛицевойСчет.Здание.Улица;
		Структура.Город    = ЛицевойСчет.Здание.Район;
		Структура.Дом      = Строка(ЛицевойСчет.Здание.Улица)+", д. "+ЛицевойСчет.Здание.НомерДома+СТрока(?(ЛицевойСчет.Здание.Корпус="","",", корп. "+Строка(ЛицевойСчет.Здание.Корпус)));
		Структура.Корпус   = ЛицевойСчет.Здание.Корпус;
		Структура.Квартира = ЛицевойСчет.Квартира.Наименование;
		Структура.Помещение = ЛицевойСчет.Здание.ПочтовыйАдрес+", кв. "+Строка(ЛицевойСчет.Квартира.НомерКвартиры);
	КонецЕсли;
	// Долг + текущие начисления
	
	ДолгПоЛС           = ВывестиСуммуДолгаПоЛС(ЛицевойСчет,Настройки);
	Долг               = ДолгПоЛС.СтрокаДолга;
	Попытка
		Структура.ApiSumma = Число(Долг);
	Исключение
		Структура.ApiSumma = 0;
	КонецПопытки;
	
	Возврат Структура;
КонецФункции
Функция ПолучитьДатуДолга(Организация, Дата)
	// Взята Из конфигурации, получает дату долга
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -(ВЫБОР
	|				КОГДА ДЕНЬ(&Дата) > бит_НастройкаПараметровЖКХСрезПоследних.ПоследнийДеньПриемаПлатежей
	|					ТОГДА 0
	|				ИНАЧЕ 1
	|			КОНЕЦ + бит_НастройкаПараметровЖКХСрезПоследних.КоличествоМесяцевОтсрочкиНачисленияПени)), МЕСЯЦ) КАК Дата
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата"       , Дата);
	
	Возврат ?(Запрос.Выполнить().Пустой(), ТекущаяДатаСеанса(),Запрос.Выполнить().Выгрузить()[0].Дата);
	
КонецФункции
Функция ВывестиСуммуДолгаПоЛС(ЛицевойСчет,Настройки)
	
	ДатаДолга = ПолучитьДатуДолга(Настройки.Организация, ТекущаяДатаСеанса());
	
	// Определим сумму долга по начислениям для текущего лицевого счета.
	ЗапросПоНачислениям = Новый Запрос;
	ЗапросПоНачислениям.УстановитьПараметр("КонецПериода", КонецДня(ТекущаяДатаСеанса()));
	ЗапросПоНачислениям.УстановитьПараметр("ЛицевойСчет" , ЛицевойСчет.Ссылка);
	ЗапросПоНачислениям.УстановитьПараметр("ДатаДолга"   , ДатаДолга);
	ЗапросПоНачислениям.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Долг.СуммаОстаток, 0) + ЕСТЬNULL(ОплатаСДатыДолга.Разовые, 0) - ЕСТЬNULL(ОплатаСДатыДолга.Оплата, 0) < 0
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(Долг.СуммаОстаток, 0) + ЕСТЬNULL(ОплатаСДатыДолга.Разовые, 0) - ЕСТЬNULL(ОплатаСДатыДолга.Оплата, 0)
	|	КОНЕЦ КАК Долг
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет КАК ЛицевойСчет,
	|		СУММА(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток) КАК СуммаОстаток
	|	ИЗ
	|		РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&ДатаДолга {(&ДатаДолга)}, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки
	|	
	|	СГРУППИРОВАТЬ ПО
	|		бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет) КАК Долг
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|			СУММА(ВЫБОР
	|					КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|						ТОГДА -бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|				КОНЕЦ) КАК Оплата,
	|			СУММА(ВЫБОР
	|					КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|						ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|				КОНЕЦ) КАК Разовые
	|		ИЗ
	|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(НАЧАЛОПЕРИОДА(&ДатаДолга, МЕСЯЦ) {(&ДатаДолга)}, &КонецПериода {(&КонецПериода)}, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОбороты
	|		
	|		СГРУППИРОВАТЬ ПО
	|			бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет) КАК ОплатаСДатыДолга
	|		ПО Долг.ЛицевойСчет = ОплатаСДатыДолга.ЛицевойСчет";
	
	тмпДолг = 0;
	
	Выборка = ЗапросПоНачислениям.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		тмпДолг = Выборка.Долг;
	КонецЕсли;
	
	Если тмпДолг > 0 Тогда
		ИнфСтрока = Строка(тмпДолг);
		ЦветНадписи = Новый Цвет(255, 0, 0); // Красный.
		
	Иначе
		ИнфСтрока = "0";
		ЦветНадписи = Новый Цвет(0, 0, 0);
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СтрокаДолга", ИнфСтрока);
	СтруктураВозврата.Вставить("ЦветНадписи", ЦветНадписи);
	
	Возврат СтруктураВозврата;
	
КонецФункции  // ВывестиСуммуДолгаПоЛС()
#КонецОбласти

#Область Отправка_Счетчиков_В_Систему_МЛК
Функция ОтправитьВсеСчетчикиНаСервереПервый(Первичный)
	
	Если Не ПроверитьЕстьЛиИнтернетСоединение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	НастройкиМЛК = Справочники.МЛК_Настройки.Выбрать();
	Пока НастройкиМЛК.Следующий() Цикл
		
		Если НастройкиМЛК.НеИспользоватьИнтеграцию Тогда Продолжить; КонецЕсли;
		Если Первичный И НастройкиМЛК.ПервичнаяСинхронизацияВыполнена Тогда Продолжить; КонецЕсли;
		
		Если НачалоДня(НастройкиМЛК.ДатаПоследнейСинхронизацииПоСчетчикам) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Возврат Истина;
		КонецЕсли;
		
		ТаблицаЛС = ПолучитьТаблицуЛицевыхСчетов(НастройкиМЛК);
		Если ОтправитьВсеСчетчикиНаСервере(НастройкиМЛК,ТаблицаЛС,Истина) Тогда
			ОбъектНастройки = НастройкиМЛК.ПолучитьОбъект();
			ОбъектНастройки.ДатаПоследнейСинхронизацииПоСчетчикам       = ТекущаяДатаСеанса();
			ОбъектНастройки.Записать();
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
		
	КонецЦикла;	
КонецФункции
Функция ОтправитьВсеСчетчикиНаСервере(Настройки,ТаблицаЛС,Все)
	
	// Журнал
	ЖурналЗапросБезКодировки   = "";
	ЖурналСтрокаОписанияОшибки = "";
	ЖурналВремяНачало          = ТекущаяДатаСеанса();
	ЖурналЗапросБезКодировкиМассив = Новый Массив;
	
	// 1 сначала ацес токен 
	АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
	Соединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Запрос        = Новый HTTPЗапрос("/api/v8/auth?login="+СокрЛП(Настройки.Логин)+"&password="+СокрЛП(Настройки.Пароль));
	
	Результат    = Соединение.Получить(Запрос);
	Если Результат.КодСостояния <> 200 Тогда 
		
		ЖурналСтрокаОписанияОшибки = Строка(ОписаниеОшибки()); 
		// Журнал
		ИмяСобытияВЖурнал = "Получение ключа для отправки счетчиков";
		КодСостояния = Результат.КодСостояния;
		СтрокаОтвет = Результат.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировкиМассив,СтрокаОтвет,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
		Возврат Ложь;
	Иначе	
		
	КонецЕсли; 
	РезультатПроверки    = Результат.ПолучитьТелоКакСтроку();
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
	ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
	ЧтениеJSON.Закрыть();
	// в теле результата запроса - json
	Ключ = "";
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Значение");
	Для Каждого стр Из ЗагруженныеДанные Цикл
		Если СокрЛП(стр.Ключ)= "access_token" Тогда
			Ключ            = Стр.Значение;
			Прервать;
		КонецЕсли;
	КонецЦикла;	
	
	Счетчик = 0;
	СтрокаПараметров="";
	АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
	АдресРесурса1 = "/api/v8/list/createupdate";
	
	ЖурналЗапросБезКодировкиМассив.Добавить(Строка(АдресСервисаСтр)+Строка(АдресРесурса1));				
	
	Для каждого Выборка Из ТаблицаЛС Цикл
		ТаблицаДанныхПоСчетчикам =ПолучитьТаблицуДанныхПоСчетчикамЛицевогоСчета(Выборка.Ссылка,"ТаблицаПоСчетчикам",Настройки);
		
		ТаблицаСчетчиков = Новый ТаблицаЗначений;
		ТаблицаСчетчиков.Колонки.Добавить("ГрафаОтчетаГЦЖС");
		ТаблицаСчетчиков.Колонки.Добавить("ВидСчетчика");
		ТаблицаСчетчиков.Колонки.Добавить("Имя");
		ТаблицаСчетчиков.Колонки.Добавить("Серийный");
		ТаблицаСчетчиков.Колонки.Добавить("Код");
		ТаблицаСчетчиков.Колонки.Добавить("Показание");
		ТаблицаСчетчиков.Колонки.Добавить("ПредыдущееПоказание");
		ТаблицаСчетчиков.Колонки.Добавить("Период");
		ТаблицаСчетчиков.Колонки.Добавить("Услуга");
		ТаблицаСчетчиков.Колонки.Добавить("Активность");
		ТаблицаСчетчиков.Колонки.Добавить("Многотарифный");
		
		Для Каждого Стр Из ТаблицаДанныхПоСчетчикам Цикл
			Если Стр.Счетчик.ТипСчетчика<>Перечисления.бит_ТипСчетчика.Индивидуальный Тогда Продолжить; КонецЕсли;
			Нов = ТаблицаСчетчиков.Добавить();
			Нов.ГрафаОтчетаГЦЖС = Стр.Услуга.ГрафаОтчетаГЦЖС;
			Нов.ВидСчетчика     = "";
			Нов.Имя             = Стр.Счетчик.Наименование;
			Нов.Серийный        = Стр.Счетчик.ЗаводскойСерийныйНомерПУ; // Возможно серийный - наименование
			Нов.Код             = Стр.Счетчик.Код;
			// Нов.Показание       = Стр.ПоследниеПоказания;
			Нов.Показание       = Стр.ОтПоказаний;
			Нов.Период              = Лев(ТекущаяДатаСеанса(),10);
			Нов.Услуга          = СТр.Услуга;
			Если стр.Счетчик.ПометкаУдаления Тогда
				Нов.Активность = "0";
			Иначе
				Нов.Активность = "1";
			КонецЕсли;	
			Нов.Многотарифный              = Стр.Многотарифный;
		КонецЦикла;
		
		Если ТаблицаСчетчиков.Количество()<>0 Тогда
			ТаблицаСчетчиков.Сортировать("Услуга");
			СтрокаПараметров = "";
			Счетчик = 0;
			СтрокаПараметров="";
			Для Каждого ТекущаяСтрока Из ТаблицаСчетчиков Цикл
				
				Если  ТекущаяСтрока.Многотарифный Тогда
					Запрос1 = "{"+
					"""code"""+":"+""""+Строка(СокрЛП(ТекущаяСтрока.Код))+""""+","+
					""""+"nameCode1c"""   +":"+""""+Строка(ТекущаяСтрока.Услуга.Код)+""""+
					"}";
					Запрос2 = "{";
					Запрос2 =Запрос2 + 
					""""+"name"""   +":"+""""+Строка(ТекущаяСтрока.Услуга)+""""+","+
					""""+"serial"""   +":"+""""+Строка(ТекущаяСтрока.Серийный)+""""+","+
					""""+"lsCode1c"""     +":"+""""+Строка(Выборка.Ссылка.Код)+""""+","+
					""""+"active"""     +":"+""""+Строка(ТекущаяСтрока.Активность)+""""+","+
					""""+"value"""   +":"+""""+Строка(Формат(ТекущаяСтрока.Показание,"ЧРД=.; ЧГ=0; ЧДЦ=2"))+""""+","+
					""""+"period"""   +":"+""""+Строка(ТекущаяСтрока.Период)+""""+
					"}";
				Иначе
					Запрос1 = "{"+
					"""lsCode1c"""+":"+""""+Строка(Выборка.Ссылка.Код)+""""+","+
					""""+"code"""   +":"+""""+Строка(ТекущаяСтрока.Код)+""""+
					"}";
					Запрос2 = "{";
					Запрос2 =Запрос2 + 
					""""+"name"""   +":"+""""+Строка(ТекущаяСтрока.Услуга)+""""+","+
					""""+"serial"""   +":"+""""+Строка(ТекущаяСтрока.Серийный)+""""+","+
					""""+"nameCode1c"""     +":"+""""+Строка(ТекущаяСтрока.Услуга.Код)+""""+","+
					""""+"active"""     +":"+""""+Строка(ТекущаяСтрока.Активность)+""""+","+
					""""+"value"""   +":"+""""+Строка(Формат(ТекущаяСтрока.Показание,"ЧРД=.; ЧГ=0; ЧДЦ=2"))+""""+","+
					""""+"period"""   +":"+""""+Строка(ТекущаяСтрока.Период)+""""+
					"}";
				КонецЕсли;
				
				
				// Журнал
				Если СтрокаПараметров = "" Тогда
					ЖурналЗапросБезКодировкиМассив.Добавить("c"+Счетчик+"="+Запрос1+"&u"+Счетчик+"="+Запрос2);
				Иначе
					ЖурналЗапросБезКодировкиМассив.Добавить("&c"+Формат(Счетчик,"ЧГ=")+"="+Запрос1+"&u"+Формат(Счетчик,"ЧГ=")+"="+Запрос2);
				КонецЕсли;
				
				Запрос1 = КодироватьСтроку(Запрос1,СпособКодированияСтроки.КодировкаURL);
				Запрос2 = КодироватьСтроку(Запрос2,СпособКодированияСтроки.КодировкаURL);
				
				Если СтрокаПараметров = "" Тогда
					СтрокаПараметров = "c"+Счетчик+"="+Запрос1+"&u"+Счетчик+"="+Запрос2;
				Иначе
					СтрокаПараметров = СтрокаПараметров+"&c"+Формат(Счетчик,"ЧГ=")+"="+Запрос1+"&u"+Формат(Счетчик,"ЧГ=")+"="+Запрос2;
				КонецЕсли;
				
				Счетчик=Счетчик+1;
			КонецЦикла;
			
			СтрокаПараметров = СтрокаПараметров+"&tableName=meters"+"&listId=1";
			
			HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1);
			HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаПараметров,  "windows-1251");
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");   // тут поменялось
			HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer "+Строка(Ключ));
			HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
			
			Попытка
				Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
