#Область Отправка_Лицевых_Счетов_В_Систему_МЛК
Функция ОтправитьВсеЛицевыеСчетаНаСервере(Первичный)
	Если Не ПроверитьЕстьЛиИнтернетСоединение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл
		Если Настройки.НеИспользоватьИнтеграцию Тогда Продолжить; КонецЕсли;
		// 1. Лицевые счета
		
		Если ЗначениеЗаполнено(Настройки.ДатаПоследнейВыгрузкиПоНачислениям) И ЗначениеЗаполнено(Настройки.ДатаПоследнейВыгрузкиПоОплатам)
			И ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоЛицевымСчетам) И ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоСчетчикам)
			И Не Настройки.ПервичнаяСинхронизацияВыполнена Тогда
			ПоставитьГалочкуСинхронизацияВыполнена(Настройки);
		КонецЕсли;
		
		Если Первичный И Настройки.ПервичнаяСинхронизацияВыполнена Тогда
			Продолжить; 
		КонецЕсли;
		
		Если НачалоДня(Настройки.ДатаПоследнейСинхронизацииПоЛицевымСчетам) = НачалоДня(ТекущаяДатаСеанса()) Тогда
			Возврат Истина;
		КонецЕсли;
		
		ТаблицаЛС = ПолучитьТаблицуЛицевыхСчетов(Настройки);
		Если ОтправитьВСистемуМЛКЛицевойСчет(Настройки,ТаблицаЛС,Первичный) Тогда
			ОбъектНастройки = Настройки.ПолучитьОбъект();
			ОбъектНастройки.Прочитать();
			ОбъектНастройки.ДатаПоследнейСинхронизацииПоЛицевымСчетам   = ТекущаяДатаСеанса();
			Попытка
				ОбъектНастройки.Записать();
			Исключение
			КонецПопытки;
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;	
	КонецЦикла;	
	Возврат Ложь;
КонецФункции
Функция ПолучитьТаблицуЛицевыхСчетов(Настройки)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.ПометкаУдаления = ЛОЖЬ
	|	И бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	|	И бит_ЛицевыеСчета.Организация = &Организация";
	Запрос.УстановитьПараметр("Организация",Настройки.Организация);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса.ВыгрузитьКолонку("Ссылка");
	
КонецФункции	
Функция ОтправитьВСистемуМЛКЛицевойСчет(Настройки,ТаблицаЛС,Первичный) Экспорт
	
	// Журнал
	ЖурналЗапросБезКодировки   = "";
	ЖурналСтрокаОписанияОшибки = "";
	ЖурналВремяНачало          = ТекущаяДатаСеанса();
	ЖурналЗапросБезКодировкиМассив = Новый Массив;
	// Журнал
	
