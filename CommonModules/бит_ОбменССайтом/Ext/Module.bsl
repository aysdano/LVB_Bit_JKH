	|	СУММА(ЕСТЬNULL(ВТ_ГрупОбороты.СуммаНачислений, 0)) КАК СуммаНачислений,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОбороты.СуммаОплаты, 0)) КАК СуммаОплаты,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОбороты.СуммаПени, 0)) КАК СуммаПени,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОстатки.НачальноеСальдо, 0)) КАК НачальноеСальдо,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОстатки.КонечноеСальдо, 0)) КАК КонечноеСальдо,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОстатки.НачальноеСальдоПени, 0)) КАК НачальноеСальдоПени,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОстатки.КонечноеСальдоПени, 0)) КАК КонечноеСальдоПени,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОстатки.НачальноеСальдо, 0) + ЕСТЬNULL(ВТ_ГрупОстатки.НачальноеСальдоПени, 0)) КАК НачальноеСальдоСУчетомПени,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОстатки.КонечноеСальдоПени, 0) + ЕСТЬNULL(ВТ_ГрупОстатки.КонечноеСальдо, 0)) КАК КонечноеСальдоСУчетомПени,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОстатки.НачальноеСальдо, 0) + ЕСТЬNULL(ВТ_ГрупОбороты.СуммаОплаты, 0)) КАК НачальноеСальдоСУчетомОплаты,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОстатки.НачальноеСальдо, 0) + ЕСТЬNULL(ВТ_ГрупОбороты.СуммаОплаты, 0) + ЕСТЬNULL(ВТ_ГрупОстатки.НачальноеСальдоПени, 0)) КАК НачальноеСальдоСУчетомОплатыИПени,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОбороты.СуммаНачислений, 0) + ЕСТЬNULL(ВТ_ГрупОбороты.СуммаПени, 0)) КАК СуммаНачисленийСУчетомПени,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОбороты.СуммаОплаты, 0) + ЕСТЬNULL(ВТ_ГрупОбороты.СуммаНачислений, 0)) КАК СуммаНачисленийСУчетомОплаты,
	|	СУММА(ЕСТЬNULL(ВТ_ГрупОбороты.СуммаОплаты, 0) + ЕСТЬNULL(ВТ_ГрупОбороты.СуммаНачислений, 0) + ЕСТЬNULL(ВТ_ГрупОбороты.СуммаПени, 0)) КАК СуммаНачисленийСУчетомОплатыИПени
	|ИЗ
	|	ВТ_ЛицевыеСчета КАК ВТ_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГрупОстатки КАК ВТ_ГрупОстатки
	|		ПО ВТ_ЛицевыеСчета.ЛицевойСчет = ВТ_ГрупОстатки.ЛицевойСчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ГрупОбороты КАК ВТ_ГрупОбороты
	|		ПО ВТ_ЛицевыеСчета.ЛицевойСчет = ВТ_ГрупОбороты.ЛицевойСчет
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ЛицевыеСчета.ЛицевойСчет,
	|	ВТ_ЛицевыеСчета.НомерЛС,
	|	ВТ_ЛицевыеСчета.Здание,
	|	ВТ_ЛицевыеСчета.Квартира,
	|	ВТ_ЛицевыеСчета.НомерКвартиры";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Создание ОбъектаXDTO с типом СписокЛицевыхСчетов.
	ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "СписокЛицевыхСчетов");
	СписокЛицевыхСчетовXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
	
	
	Пока Выборка.Следующий() Цикл
		
		// Создание ОбъектаXDTO с типом ЛицевойСчет.
		ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "ЛицевойСчет");
		ЛицевойСчетXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
		
		ЛицевойСчетXDTO.Идентификатор			= Строка(Выборка.ЛицевойСчет.УникальныйИдентификатор());
		ЛицевойСчетXDTO.ИдентификаторКвартиры	= ?(ЗначениеЗаполнено(Выборка.Квартира), Строка(Выборка.Квартира.УникальныйИдентификатор()), "");
		ЛицевойСчетXDTO.ИдентификаторЗдания		= ?(ЗначениеЗаполнено(Выборка.Здание), Строка(Выборка.Здание.УникальныйИдентификатор()), "");
		ЛицевойСчетXDTO.Номер					= Выборка.НомерЛС;
		ЛицевойСчетXDTO.НомерКвартиры			= Выборка.НомерКвартиры;
		ЛицевойСчетXDTO.НачальноеСальдо			= Выборка.НачальноеСальдоПени;
		ЛицевойСчетXDTO.СуммаНачислений			= Макс(Выборка.СуммаНачислений, -Выборка.СуммаНачислений);		
		//3.06.2019
		если ПараметрыОбмена.УчитыватьПеня = Истина тогда
			ЛицевойСчетXDTO.СуммаНачислений  = Выборка.СуммаНачисленийСУчетомОплатыИПени; 
		конецесли;  

		ЛицевойСчетXDTO.СуммаОплаты				= Макс(Выборка.СуммаОплаты, -Выборка.СуммаОплаты);
		ЛицевойСчетXDTO.СуммаПени				= Макс(Выборка.СуммаПени, -Выборка.СуммаПени);
		ЛицевойСчетXDTO.КонечноеСальдо			= -ЛицевойСчетXDTO.СуммаНачислений;//22.07.2019Выборка.КонечноеСальдоПени;
		
		СписокЛицевыхСчетовXDTO.ЛицевойСчет.Добавить(ЛицевойСчетXDTO);
		
	КонецЦикла;
	
	ЗаписатьФайлВыгрузки(СписокЛицевыхСчетовXDTO, ПараметрыОбмена, "accounts.xml");
	
КонецПроцедуры

Процедура ВыгрузитьЛицевыеСчета(ПараметрыОбмена, Пеня = ложь) Экспорт
Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОбмена.Организация);
	Запрос.УстановитьПараметр("СписокУлиц"	, ПараметрыОбмена.СписокУлиц);
	Запрос.УстановитьПараметр("СписокЗданий", ПараметрыОбмена.СписокЗданий);
	Запрос.УстановитьПараметр("СписокЛС"	, ПараметрыОбмена.СписокЛС);
	
	
	если ЗначениеЗаполнено(ПараметрыОбмена.ДатаНачалаПериода) = ложь тогда
	  ПараметрыОбмена.ДатаНачалаПериода = НачалоМесяца(ТекущаяДата());	
    конецесли;
  
	если ЗначениеЗаполнено(ПараметрыОбмена.ДатаОкончанияПериода) = ложь тогда
	  ПараметрыОбмена.ДатаОкончанияПериода = КонецМесяца(ТекущаяДата());	
	конецесли;	
	
	ПериодФормирования = ПараметрыОбмена.ДатаОкончанияПериода;//ТекущаяДата();
	Запрос.УстановитьПараметр("НачалоПериода"	, НачалоМесяца(ПериодФормирования));
	Запрос.УстановитьПараметр("КонецПериода"	, КонецМесяца(ПериодФормирования));
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.Организация) Тогда
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокУлиц)
		И ПараметрыОбмена.СписокУлиц.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЗданий) 
		И ПараметрыОбмена.СписокЗданий.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЛС) 
		И ПараметрыОбмена.СписокЛС.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЛС", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЛС", Истина);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	|		ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
	|ГДЕ
	|	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И НЕ бит_СписокЗданий.ПометкаУдаления
	|	И (&НеПроверятьЛС
	|			ИЛИ бит_ЛицевыеСчета.Ссылка В (&СписокЛС))
	|	И (&НеПроверятьОрганизации
	|			ИЛИ бит_ЛицевыеСчета.Организация В (&Организация))
	|	И (&НеПроверятьУлицы
	|			ИЛИ бит_СписокЗданий.Улица В (&СписокУлиц))
	|	И (&НеПроверятьЗдания
	|			ИЛИ бит_ЛицевыеСчета.Здание В (&СписокЗданий))";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	// Подготовка обработки печати.
	ОбработкаОбъект = Обработки.бит_ПечатьСчетИзвещений.Создать();
	ОбработкаОбъект.СписокЛС.Загрузить(Результат); // Фильтрация по ЛС.
	
	//23.05.2019
	если Пеня = ложь тогда
	 ОбработкаОбъект.МакетКв               = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32;
    иначе
	 ОбработкаОбъект.МакетКв               = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокументПеня;
	конецесли; 
	ОбработкаОбъект.ШаблонИзвещений       = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
	ОбработкаОбъект.Организация           = ПараметрыОбмена.Организация;
	ОбработкаОбъект.РС                    = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПараметрыОбмена.Организация, "ОсновнойБанковскийСчет");
	ОбработкаОбъект.ТекущийПакет          = 1;
	ОбработкаОбъект.РазмерПакетаПечати    = 500;
	ОбработкаОбъект.РазмерПакетаПросмотра = 50;
	ОбработкаОбъект.НеПечататьУслугиБезНачислений = Истина;
	ОбработкаОбъект.Период = КонецМесяца(ПериодФормирования);
	ОбработкаОбъект.ОбновитьНастройкиЖКХ();
	ОбработкаОбъект.ОбновитьКэшОрганизации();
	ОбработкаОбъект.ОбновитьКэшПолучателяПлатежа();
	ОбработкаОбъект.ПолучитьНастройкуМакета();
	
	// Настроййки таб. док. поумолчанию.
	ТабличнйДокумент  = Новый ТабличныйДокумент;
	ТабличнйДокумент.АвтоМасштаб = Истина;
	ТабличнйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	если Пеня = ложь тогда
	 ОбработкаОбъект.МакетКв               = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32;
    иначе
	 ОбработкаОбъект.МакетКв               = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокументПеня;
	конецесли;         
	
	// Формирование данных для макета.
	ТаблицаДанных = ОбработкаОбъект.СформироватьДанныеПечати(Истина);	
	
	// Создание ОбъектаXDTO с типом СписокЛицевыхСчетов.
	ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "СписокЛицевыхСчетов");
	СписокЛицевыхСчетовXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
	
	Для Каждого Стр Из Результат Цикл
		
		Отбор = Новый Структура;
		//Отбор.Вставить("ВладелецЛС", Стр.ЛицевойСчет); // Без иерархии.
		Отбор.Вставить("ЛицевойСчет", Стр.ЛицевойСчет);
		ПоискЛС = ТаблицаДанных.НайтиСтроки(Отбор);
		
		Если ПоискЛС.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;

	
		Для каждого СтрокаТаблицы Из ПоискЛС Цикл
			
			ТабличнйДокумент.Очистить();
			//23.05.2019
			ОбработкаОбъект.ВывестиНаПечатьКвитанцию(ТабличнйДокумент, СтрокаТаблицы, Пеня);
			
			ИмяВрФайла = ПолучитьИмяВременногоФайла("pdf");
			ТабличнйДокумент.Записать(ИмяВрФайла,ТипФайлаТабличногоДокумента.PDF);
		    //23.05.2019
//			если ПараметрыОбмена.ВыгружатьОтдельнымиФайлами = истина тогда
			если ПараметрыОбмена.ВидТранспорта = 0 тогда
			 КопироватьФайл(ИмяВрФайла, ПараметрыОбмена.КаталогВыгрузки + "\\Квитанция_" + строка(СтрокаТаблицы.ЛицевойСчет) + ".pdf");
			конецесли; 
			ДД = Новый ДвоичныеДанные(ИмяВрФайла);

			
			// Создание ОбъектаXDTO с типом ЛицевойСчет.
			ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "ЛицевойСчет");
			ЛицевойСчетXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
			
			ЛицевойСчетXDTO.Идентификатор			= Строка(СтрокаТаблицы.ЛицевойСчет.УникальныйИдентификатор());
			ЛицевойСчетXDTO.ИдентификаторКвартиры	= ?(ЗначениеЗаполнено(СтрокаТаблицы.ВладелецЛС.Квартира), Строка(СтрокаТаблицы.ВладелецЛС.Квартира.УникальныйИдентификатор()), "");
			ЛицевойСчетXDTO.ИдентификаторЗдания		= ?(ЗначениеЗаполнено(СтрокаТаблицы.ВладелецЛС.Здание), Строка(СтрокаТаблицы.ВладелецЛС.Здание.УникальныйИдентификатор()), "");
			ЛицевойСчетXDTO.Номер					= СтрокаТаблицы.ВладелецЛС.Наименование;
			ЛицевойСчетXDTO.НомерКвартиры			= СтрокаТаблицы.ВладелецЛС.Квартира.Наименование;
			ЛицевойСчетXDTO.НачальноеСальдо			= СтрокаТаблицы.Значение.СтруктураДанных.НачисленоПениЗаПериод;
			ЛицевойСчетXDTO.СуммаНачислений			= Макс(СтрокаТаблицы.Значение.СтруктураДанных.ИтогоКОплатеСУчетомПредоплаты, -СтрокаТаблицы.Значение.СтруктураДанных.ИтогоКОплатеСУчетомПредоплаты);		
			//3.06.2019
			если ПараметрыОбмена.УчитыватьПеня = Истина тогда
				ЛицевойСчетXDTO.СуммаНачислений  = СтрокаТаблицы.Значение.СтруктураДанных.ИтогоКОплатеСУчетомПени; 
			конецесли;  

			ЛицевойСчетXDTO.СуммаОплаты				= Макс(СтрокаТаблицы.Значение.СтруктураДанных.ИтогоКОплатеСУчетомПредоплаты, -СтрокаТаблицы.Значение.СтруктураДанных.ИтогоКОплатеСУчетомПредоплаты);
			ЛицевойСчетXDTO.СуммаПени				= Макс(СтрокаТаблицы.Значение.СтруктураДанных.ИтогПени, -СтрокаТаблицы.Значение.СтруктураДанных.ИтогПени);
			ЛицевойСчетXDTO.КонечноеСальдо			= -ЛицевойСчетXDTO.СуммаНачислений;//22.07.2019СтрокаТаблицы.КонечноеСальдоПени;
			
			СписокЛицевыхСчетовXDTO.ЛицевойСчет.Добавить(ЛицевойСчетXDTO);
			
		 КонецЦикла;
		
	КонецЦикла;
	
	ЗаписатьФайлВыгрузки(СписокЛицевыхСчетовXDTO, ПараметрыОбмена, "accounts.xml");
	
КонецПроцедуры


Процедура ВыгрузитьУслуги(ПараметрыОбмена) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОбмена.Организация);
	Запрос.УстановитьПараметр("СписокУлиц"	, ПараметрыОбмена.СписокУлиц);
	Запрос.УстановитьПараметр("СписокЗданий", ПараметрыОбмена.СписокЗданий);
	Запрос.УстановитьПараметр("СписокЛС"	, ПараметрыОбмена.СписокЛС);
	Запрос.УстановитьПараметр("СписокУслуг"	, ПараметрыОбмена.СписокУслуг);
	
	ПериодФормирования = ТекущаяДата();
	Запрос.УстановитьПараметр("НачалоПериода"	, НачалоМесяца(ПериодФормирования));
	Запрос.УстановитьПараметр("КонецПериода"	, КонецМесяца(ПериодФормирования));
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.Организация) Тогда
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокУлиц)
		И ПараметрыОбмена.СписокУлиц.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЗданий) 
		И ПараметрыОбмена.СписокЗданий.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЛС) 
		И ПараметрыОбмена.СписокЛС.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЛС", Ложь);
	Иначе
