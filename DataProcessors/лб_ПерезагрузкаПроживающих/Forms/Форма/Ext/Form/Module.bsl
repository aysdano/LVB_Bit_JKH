&НаКлиенте
Процедура ПриОткрытии(Отказ)
	//Вставить содержимое обработчика
	Если ЗначениеЗаполнено(ИмяФайлаКл) тогда
		ИмяФайлаОкончаниеВыбора();
	КонецЕсли;	
КонецПроцедуры

#Область КэшированиеДанных

&НаСервере
Процедура ЗаполнитьКэшЗданий()
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("НаправлениеОбмена",Объект.НаправлениеОбмена);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	Подстрока(лб_ПредставлниеЗданий.Представление,1,1500) КАК Представление,
		|	лб_ПредставлниеЗданий.Здание КАК Здание
		|ИЗ
		|	РегистрСведений.лб_ПредставлниеЗданий КАК лб_ПредставлниеЗданий
		|ГДЕ
		|	лб_ПредставлниеЗданий.НаправлениеОбмена = &НаправлениеОбмена";
	мКэшЗданий = Запрос.Выполнить().Выгрузить();
	мКэшЗданий.Индексы.Добавить("Представление");
		
КонецПроцедуры	

&НаСервере
Функция ЗданиеИзКэша(Представление)
	СтрокаТ = мКэшЗданий.Найти(СокрЛП(Представление),"Представление");
	Если СтрокаТ=Неопределено тогда
		Сообщить("Не найдено здание "+Представление);		
		возврат Справочники.бит_СписокЗданий.ПустаяСсылка();
	КонецЕсли;	           	
	возврат СтрокаТ.Здание;	
КонецФункции	

// Функция - Данные ЛС - Выводит кэшированные данные по ЛС
//
// Параметры:
//  ИмяЛС	 - Строка	 - Номер ЛС
// 
// Возвращаемое значение:
//  СтрокаТЧ - ИмяЛС
//
&НаСервере
Функция ДанныеЛС(знач ИмяЛС)
	ИмяЛС = лев(сокрЛП(ИмяЛС)+"000000000000",10);
	СтрокаТ = мКэшКвартирЛС.Найти(ИмяЛС,"ИмяЛС10");	
	Возврат СтрокаТ;
КонецФункции	

&НаСервере
Функция СсылкаЛС(ИмяЛС)
	ДанныеЛС = ДанныеЛС(сокрЛП(ИмяЛС));
	возврат ?(ДанныеЛС = Неопределено,Справочники.бит_ЛицевыеСчета.ПустаяСсылка(),ДанныеЛС.ЛС);
КонецФункции	

&НаСервере
Процедура ЗаполнитьКэшКвартирЛицевыхСчетов()
	Запрос = новый запрос;
	ЗАпрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛС,
		|	ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 1500) КАК ИмяЛС,
		|	бит_ЛицевыеСчета.Здание КАК Здание,
		|	бит_ЛицевыеСчета.Квартира КАК Квартира,
		|	бит_ЛицевыеСчета.Квартира.Подъезд КАК Подъезд,
		|	бит_ЛицевыеСчета.УлицаЛицевогоСчета КАК Улица,
		|	ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 10) КАК ИмяЛС10,
		|	бит_ЛицевыеСчета.Здание.Код КАК ЗданиеКод
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета";
	мКэшКвартирЛС = Запрос.Выполнить().Выгрузить();
	мКэшКвартирЛС.Индексы.Добавить("ИмяЛС10");
КонецПроцедуры	

&НаСервере
Процедура ЗаменитьЕслиНовое(переменная,новоеЗначение,ЕстьИзменения=ложь)
	Если переменная<>новоеЗначение тогда
		переменная = новоеЗначение;
		ЕстьИзменения = истина;
	КонецЕсли;	
КонецПроцедуры

