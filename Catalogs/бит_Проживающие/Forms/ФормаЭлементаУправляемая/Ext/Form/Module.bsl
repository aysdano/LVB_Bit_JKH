	ИсключаемыеВиды.Добавить(Справочники.ВидыКонтактнойИнформации.АдресПрибытия);
	ИсключаемыеВиды.Добавить(Справочники.ВидыКонтактнойИнформации.АдресПрибытияДрРегион);
