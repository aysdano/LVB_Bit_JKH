&НаСервере
Процедура СоздатьКвартирыНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_Квартиры.Ссылка,
	|	бит_Квартиры.НомерКвартиры
	|ИЗ
	|	Справочник.бит_Квартиры КАК бит_Квартиры
	|ГДЕ
	|	 бит_Квартиры.Владелец = &Владелец";
	
	Запрос.УстановитьПараметр("Владелец",Объект.Ссылка);
	
	форКвартиры = Запрос.Выполнить().Выгрузить();
	
	Для Значение = НачКвартиры По КонКвартиры Цикл
		
		// Проверяем есть ли квартира с таким номером в списке.		
		Если НЕ форКвартиры.Найти(Строка(Значение),"НомерКвартиры") = Неопределено Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Квартира с номером: """ + Строка(Значение) + """ уже есть в списке!");
			
			Продолжить;
			
		Иначе
			
			НовыйЭлемент = Справочники.бит_Квартиры.СоздатьЭлемент();
			
			НовыйЭлемент.Владелец      = Объект.Ссылка;
			НовыйЭлемент.НомерКвартиры = Значение;
			НовыйЭлемент.Наименование  = Строка(Значение);
			
			СоздатьЗапись = Истина;
			
			Попытка
				
				НовыйЭлемент.Записать();
				
			Исключение
				
				СоздатьЗапись = Ложь;
				
			КонецПопытки;
			
			Если СоздатьЗапись Тогда
				
				НовыйНабор = РегистрыСведений.бит_СведенияОКвартире.СоздатьНаборЗаписей();
				
				НовыйНабор.Отбор.Квартира.Установить(НовыйЭлемент.Ссылка);
				
				НовыйНабор.Прочитать();
				
				НоваяЗапись = НовыйНабор.Добавить();
				
				НоваяЗапись.Период         = НаДату;
				НоваяЗапись.Квартира       = НовыйЭлемент.Ссылка;
				НоваяЗапись.СтатусКвартиры = Справочники.бит_СтатусыКвартиры.Приватизированная;
				НоваяЗапись.ТипКвартиры    = Справочники.бит_ТипыКвартиры.Отдельная;
				
				Попытка
					
					НовыйНабор.Записать();
					
				Исключение
					
				КонецПопытки;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

