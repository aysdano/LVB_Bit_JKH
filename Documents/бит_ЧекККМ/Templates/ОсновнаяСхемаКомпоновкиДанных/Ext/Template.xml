		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КонечноеЗначение</dataPath>
			<field>КонечноеЗначение</field>
			<valueType>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>10</v8:Digits>
					<v8:FractionDigits>3</v8:FractionDigits>
					<v8:AllowedSign>Any</v8:AllowedSign>
				</v8:NumberQualifiers>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НачальноеЗначение</dataPath>
			<field>НачальноеЗначение</field>
			<valueType>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>10</v8:Digits>
					<v8:FractionDigits>3</v8:FractionDigits>
					<v8:AllowedSign>Any</v8:AllowedSign>
				</v8:NumberQualifiers>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПериодПоСчетчику</dataPath>
			<field>ПериодПоСчетчику</field>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ДФ='MMMM yyyy'</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ
	НАЧАЛОПЕРИОДА(бит_ПоказанияСчетчиков.Период, МЕСЯЦ) КАК ПериодПоСчетчику,
	бит_ПоказанияСчетчиков.Счетчик КАК Счетчик,
	МАКСИМУМ(ЕСТЬNULL(ВЫБОР
				КОГДА бит_ПоказанияСчетчиков.ТекущиеПоказанияИнспектора &gt; бит_ПоказанияСчетчиков.ТекущиеПоказанияНаселения
					ТОГДА бит_ПоказанияСчетчиков.ТекущиеПоказанияИнспектора
				ИНАЧЕ ВЫБОР
						КОГДА бит_ПоказанияСчетчиков.ТекущиеПоказанияНаселения &gt; бит_ПоказанияСчетчиков.ПоказанияПодкрутка
							ТОГДА бит_ПоказанияСчетчиков.ТекущиеПоказанияНаселения
						ИНАЧЕ бит_ПоказанияСчетчиков.ПоказанияПодкрутка
					КОНЕЦ
			КОНЕЦ, 0)) КАК КонечноеЗначение,
	МИНИМУМ(бит_ПоказанияСчетчиков.ПоследниеПоказания) КАК НачальноеЗначение
ИЗ
	РегистрНакопления.бит_ПоказанияСчетчиков КАК бит_ПоказанияСчетчиков
ГДЕ
	бит_ПоказанияСчетчиков.Объект = &amp;ЛицевойСчет
	И бит_ПоказанияСчетчиков.Период &gt;= &amp;НачалоПериода
	И бит_ПоказанияСчетчиков.Период &lt;= &amp;КонецПериода

СГРУППИРОВАТЬ ПО
	НАЧАЛОПЕРИОДА(бит_ПоказанияСчетчиков.Период, МЕСЯЦ),
	бит_ПоказанияСчетчиков.Счетчик

УПОРЯДОЧИТЬ ПО
	Счетчик,
	ПериодПоСчетчику</query>
