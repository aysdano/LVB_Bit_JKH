&НаСервере
Процедура ТестСоединенияНаСервере()
	
	ДобавитьЛог("Тест соединения");
	
	ЕстьОтвет = Истина;
	
	АдресСервисаСтр = СокрЛП(Объект.АдресСервиса);
	АдресРесурса = "/api/v2/applications/"+Строка(СокрЛП(Объект.НомерПриложения));
	СтрокаПараметров = "";
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		ЕстьОтвет = Ложь;
		ДобавитьЛог("Тест соединения. Ошибка при отправке запроса: " + ОписаниеОшибки());
	КонецПопытки;
	
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				Если СокрЛП(РезультатПроверки)="false" Тогда
					ДобавитьЛог("Соединение не установлено");
					Сообщить("Соединение не установлено");
				Иначе
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
					ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Ложь, , ФорматДатыJSON.ISO);
					ЧтениеJSON.Закрыть();
					ДобавитьЛог("Соединение установлено с "+Строка(ЗагруженныеДанные.ShortDescription));
					Сообщить("Соединение установлено с "+Строка(ЗагруженныеДанные.ShortDescription));
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			ДобавитьЛог("Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			ДобавитьЛог("Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 301 Тогда
			ДобавитьЛог("Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
		Иначе
			ДобавитьЛог("Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
		КонецЕсли;
	КонецЕсли;
	//Теперь заполним данные о статусах обращений
	ПодгрузитьСтатусы();
	
КонецПроцедуры

Процедура ПодгрузитьСтатусы()
	//вместо objects или events пиши statuses. например api/v2/statuses
	
	ЕстьОтвет = Истина;
	
	АдресСервисаСтр = СокрЛП(Объект.АдресСервиса);
	АдресРесурса = "/api/v4/statuses?ApplicationId="+Объект.НомерПриложения;
	//Запрос1 = КодироватьСтроку(Строка(СокрЛП(Объект.НомерПриложения)),СпособКодированияСтроки.КодировкаURL);
	//СтрокаПараметров = "ApplicationId="+Запрос1;
	//
	//HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса+ СтрокаПараметров);
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		Сообщить("Ошибка при отправке запроса: " + ОписаниеОшибки());
		ЕстьОтвет = Ложь;
	КонецПопытки;
	
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				Если СокрЛП(РезультатПроверки)="false" Тогда
					Сообщить("Соединение не установлено");
				Иначе
					
					
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
					ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
					ЧтениеJSON.Закрыть();
					
					ТЗ = РаспарситьСтатусы(ЗагруженныеДанные);
					
					Для Каждого СтрСтатус Из ТЗ Цикл
						Если Найти(нрег(СтрСтатус.Статус),"закрыт")<>0 Тогда
							Объект.СтатусЗакрыто = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"отклонен")<>0 Тогда
							Объект.СтатусОтклонено = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"обработан")<>0 Тогда
							Объект.СтатусОбработано = СтрСтатус.Ид_Статуса;
	                    ИначеЕсли Найти(нрег(СтрСтатус.Статус),"работе")<>0 Тогда
							Объект.СтатусВРаботе = СтрСтатус.Ид_Статуса;
						КонецЕсли;	
						
					КонецЦикла;	
					//
					//ОтправитьДетализацию(ТЗ);
					//
					//Сообщить(РезультатПроверки);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			Сообщить("Обновление статусов. "+"Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Сообщить("Обновление статусов. "+"Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Сообщить("Обновление статусов. "+"Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
		Иначе
			Сообщить("Обновление статусов. "+"Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	
&НаКлиенте
Процедура ТестСоединения(Команда)
	ТестСоединенияНаСервере();
КонецПроцедуры

&НаСервере
Процедура ОтправитьДанныеПоЛицевымСчетамНаСервере() Экспорт
	
	Если Объект.ЭкспортНачисления Тогда
		ДетализацияНачислений();
	КонецЕсли;
	
	Если Объект.ЭкспортКвитанции Тогда
		ПроверитьЗапросыИОтправитьКвитанции();
	КонецЕсли;	
	
	
	Если Объект.ЭкспортПлатежи Тогда
		ЭкспортПлатежи();
	КонецЕсли;
	
	Если Объект.ИмпортПоказанияСчетчиков Тогда
		СДаты = НачалоМесяца(ТекущаяДата());
		ПоДату = КонецМесяца(ТекущаяДата());
		ПолучитьПоказанияСчетчиков(СДаты, ПоДату);
	Конецесли;	
	
	Если Объект.ИмпортПлатежи Тогда
		ИмпортПлатежейВМобстед();
	КонецЕсли;	
КонецПроцедуры
&НаСервере
Процедура ОтправитьИОбновитьДанныеПоЛицевымСчетамНаСервере() Экспорт
	//Phone, Email, Имя_Отчество, Город, Улица, Дом, Корпус, Квартира, ApiSumma, 	
	Для Каждого Стр Из ТаблицаЛицевыхСчетов Цикл
		Если Стр.ЕстьВМобстед Тогда
			//Сообщить(Стр.ЛицевойСчет.Наименование);
			Если Объект.ЭкспортЛицевыеСчета Тогда
				ОтправитьВМобстедЛицевойСчет(Стр.ЛицевойСчет);
			КонецЕсли;
			Если Объект.ЭкспортСчетчики Тогда
				СоздатьСчетчики(Стр.ЛицевойСчет);
			КонецЕсли;
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

Процедура ОтправитьВМобстедЛицевойСчет(ЛицевойСчет)
	
	ЕстьОтвет = Истина;
	
	Структура = ПолучитьСтруктуруДанныхЛицевогоСчета(ЛицевойСчет);
	
	АдресСервисаСтр = СокрЛП(Объект.АдресСервиса);
	АдресРесурса1 = "/api/v2/objects/createupdate";
	
	Запрос1 = "{"+"""ApplicationId"""+":"+СТрока(СокрЛП(Объект.НомерПриложения))+","+"""ЛС"""+":"+""""+СокрЛП(ЛицевойСчет.Наименование)+""""+"}"; 
	Запрос1 = КодироватьСтроку(Запрос1,СпособКодированияСтроки.КодировкаURL);
	Запрос2 = "{"+"""ApiSumma"""+":"+""""+Строка(Структура.ApiSumma)+""""+","+
	"""Phone"""   +":"+""""+Строка(Структура.Phone)+""""+","+
	//"""Phone"""   +":"+""""+Строка(Структура.Phone)+""""+","+
	"""Email"""   +":"+""""+Строка(Структура.Email)+""""+","+
	"""Наименование"""+":"+""""+Строка(Структура.Имя_Отчество)+""""+","+
	"""НомерЛицевогоСчета"""+":"+""""+Строка(ЛицевойСчет.Наименование)+""""+","+
	"""Имя_Отчество"""+":"+""""+Строка(Структура.Имя_Отчество)+""""+","+
	"""Код1С"""   +":"+""""+Строка(ЛицевойСчет.Код)+""""+","+
	"""Помещение"""   +":"+""""+Строка(Структура.Помещение)+""""+","+
	"""Улица"""   +":"+""""+Строка(Структура.Улица)+""""+","+
	"""Enabled"""   +":"+""""+Строка(1)+""""+","+
	"""Здание"""     +":"+""""+Строка(Структура.Дом)+""""+","+
	"""Корпус"""  +":"+""""+Строка(Структура.Корпус)+""""+","+
	"""Город"""   +":"+""""+Строка(Структура.Город)+""""+","+
	"""НомерКвартиры"""+":"+""""+Строка(Структура.Квартира)+""""+"}";
	Запрос2 = КодироватьСтроку(Запрос2,СпособКодированияСтроки.КодировкаURL);
	
	СтрокаПараметров = "create="+Запрос1+"&update="+Запрос2;
	//СтрокаПараметров = КодироватьСтроку(СтрокаПараметров,СпособКодированияСтроки.КодировкаURL);
	//Сообщить(СтрокаПараметров);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаПараметров, КодировкаТекста.UTF8);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");   // тут поменялось
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
	
	
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		ЕстьОтвет = Ложь;
		Сообщить("Экспорт данных по лицевому счету: "+Строка(ЛицевойСчет.Код)+". Ошибка при отправке запроса: " + ОписаниеОшибки());
	КонецПопытки;
	
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				//Сообщить(РезультатПроверки);
				Результат = Перевод(РезультатПроверки);
				
				Результат = "Добавление / обновление данных по лицевым счетам. ЛС: "+Строка(ЛицевойСчет.Наименование)+". "+ Результат;
				
				Сообщить(Результат);
			КонецЕсли;
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			Сообщить("Добавление/обновление ЛС "+"Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Сообщить("Добавление/обновление ЛС "+"Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Сообщить("Добавление/обновление ЛС "+"Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
		Иначе
			Сообщить("Добавление/обновление ЛС "+"Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры	

Процедура СоздатьСчетчики(ЛицевойСчет)
	
	ЕстьОтвет = Истина;
	
	//ТаблицаОплатПоЛицевомуСчету = ПолучитьТаблицуОплатПоЛицевомуСчету(ЛицевойСчет);
	
	//ТаблицаДанныхНачислений = ПолучитьТаблицуДанныхПоСчетчикамЛицевогоСчета(ЛицевойСчет,"ТаблицаНачислений");
	
	ТаблицаДанныхПоСчетчикам =ПолучитьТаблицуДанныхПоСчетчикамЛицевогоСчета(ЛицевойСчет,"ТаблицаПоСчетчикам");
	
	ТаблицаСчетчиков = Новый ТаблицаЗначений;
	ТаблицаСчетчиков.Колонки.Добавить("ГрафаОтчетаГЦЖС");
	ТаблицаСчетчиков.Колонки.Добавить("ВидСчетчика");
	ТаблицаСчетчиков.Колонки.Добавить("Имя");
	ТаблицаСчетчиков.Колонки.Добавить("Серийный");
	ТаблицаСчетчиков.Колонки.Добавить("Код");
	ТаблицаСчетчиков.Колонки.Добавить("Показание");
	ТаблицаСчетчиков.Колонки.Добавить("ПредыдущееПоказание");
	ТаблицаСчетчиков.Колонки.Добавить("Период");
	ТаблицаСчетчиков.Колонки.Добавить("Услуга");
	
	Для Каждого Стр Из ТаблицаДанныхПоСчетчикам Цикл
		Если Стр.Счетчик.ТипСчетчика<>Перечисления.бит_ТипСчетчика.Индивидуальный Тогда Продолжить; КонецЕсли;
		Нов = ТаблицаСчетчиков.Добавить();
		Нов.ГрафаОтчетаГЦЖС = Стр.Услуга.ГрафаОтчетаГЦЖС;
		Нов.ВидСчетчика     = "";
		Нов.Имя             = Стр.Счетчик.Наименование;
		
		Нов.Серийный        = Стр.Счетчик.ЗаводскойСерийныйНомерПУ; //Возможно серийный - наименование
		
		Нов.Код             = Стр.Счетчик.Код;
		Нов.Показание       = Стр.ДоПоказаний;
		Нов.ПредыдущееПоказание = Стр.ОтПоказаний;
		Нов.Период              = Лев(Стр.ПериодСравнения,10);
		Нов.Услуга          = СТр.Услуга;
	КонецЦикла;	
	
	Если ТаблицаСчетчиков.Количество()<>0 Тогда
		ТаблицаСчетчиков.Сортировать("ГрафаОтчетаГЦЖС");
		ТекГрафа = ""; Сч = 0;
		Для Каждого Стр Из ТаблицаСчетчиков Цикл
			Если ТекГрафа = Стр.ГрафаОтчетаГЦЖС Тогда
				Сч = СЧ + 1;
			Иначе
				Сч = 1;
			КонецЕсли;
			ТекГрафа = Стр.ГрафаОтчетаГЦЖС;
			
			//Сообщить(Строка(Стр.Имя)+"-"+Строка(Стр.ГрафаОтчетаГЦЖС));
			Если Стр.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ГорячееВодоснобжение Тогда
				Стр.ВидСчетчика = "СчГВС"+Строка(Сч);
			ИначеЕсли Стр.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ХолодноеВодоснабжение Тогда
				Стр.ВидСчетчика = "СчХВС"+Строка(Сч);
			ИначеЕсли Стр.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Отопление Тогда
				Стр.ВидСчетчика = "СчОтопление"+Строка(Сч);
			ИначеЕсли Стр.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Электроэнергия Тогда
				Если Найти(Стр.Услуга,"Т3")<>0 Тогда  //Третий   
					Стр.ВидСчетчика = "СчЭЭТретий1";
				ИначеЕсли Найти(Стр.Услуга,"Т2")<>0 Тогда //Ночь
					Стр.ВидСчетчика = "СчЭЭНочь1";
				ИначеЕсли Найти(Стр.Услуга,"Т1")<>0 Тогда   //День
					Стр.ВидСчетчика = "СчЭЭДень1";
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
		ОставитьСчетчики = ТаблицаСчетчиков.Скопировать();
		ОставитьСчетчики.Очистить();
		
