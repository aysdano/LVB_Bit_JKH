							ОбластьОДПУТаблицаСтрока.Параметры.ХВСНачПоказания = СтрокаХВС.ПоказаниеНаНачало;
							ОбластьОДПУТаблицаСтрока.Параметры.ХВСКонПоказания = СтрокаХВС.ПоказаниеНаКонец;
							ОбластьОДПУТаблицаСтрока.Параметры.ХВСКУ = СтрокаХВС.ОбъемКУ;
							
						КонецЕсли;
						
						Если ТаблицыОДПУ.ГВС.Количество() > Счетчик Тогда
							
							СтрокаГВС = ТаблицыОДПУ.ГВС[Счетчик];
							ОбластьОДПУТаблицаСтрока.Параметры.ОДПУГВС = СтрокаГВС.НомерОДПУ;
							ОбластьОДПУТаблицаСтрока.Параметры.ГВСНачПоказания = СтрокаГВС.ПоказаниеНаНачало;
							ОбластьОДПУТаблицаСтрока.Параметры.ГВСКонПоказания = СтрокаГВС.ПоказаниеНаКонец;
							ОбластьОДПУТаблицаСтрока.Параметры.ГВСКУ = СтрокаГВС.ОбъемКУ;
							
						КонецЕсли;
						
						ОбластьОДПУТаблица.Вывести(ОбластьОДПУТаблицаСтрока);
						
					КонецЦикла;
					
					ОбластьОДПУ.Присоединить(ОбластьОДПУТаблица);
					
					
					ЦентрОбщий.Вывести(ОбластьВысотаЗавершения);
