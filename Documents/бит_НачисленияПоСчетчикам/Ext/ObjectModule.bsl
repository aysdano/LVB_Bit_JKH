	|			И Показания.ЛицевойСчет = Услуги.ЛицевойСчет
	|ИТОГИ
	|	СУММА(ОбщаяПлощадь),
	|	СУММА(ЖилаяПлощадь),
	|	СУММА(ОтапливаемаяПлощадь),
	|	СУММА(ФизЛицо),
	|	СУММА(ДоляЛС),
	|	СУММА(ПоЛС)
	|ПО
	|	Услуга,
	|	Объект,
	|	Распределение";	
	
	Сумма         = 0;	
	
	ТабРаспределения = Запрос.Выполнить().Выгрузить();
	Для каждого ТекКолонка Из Распределения.ВыгрузитьКолонки().Колонки Цикл
		Если ТабРаспределения.Колонки.Найти(ТекКолонка.Имя)=Неопределено тогда
			ТабРаспределения.Колонки.Добавить(ТекКолонка.Имя,ТекКолонка.ТипЗначения);
		конецЕсли;
	КонецЦикла; 
	ТабРаспределения.Очистить();
	
	ВыборкаОбщих  = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОбщих.Следующий() Цикл
		ВыборкаОбщихВладельца = ВыборкаОбщих.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаОбщихВладельца.Следующий() Цикл  	
			
			ВыборкаРаспределение = ВыборкаОбщихВладельца.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаРаспределение.Следующий() Цикл 
				
				Выборка = ВыборкаРаспределение.Выбрать();
				МассивУслуг  = Новый Массив;
				ИтогСумма     = 0;
				ПлановаяСумма = 0;
				Распределение = ВыборкаРаспределение.Распределение;
				
				Пока Выборка.Следующий() Цикл
					
					Если ВыборкаРаспределение.ДоляЛС = 0 Тогда
						
						Индекс = МассивУслуг.Найти(Выборка.Услуга);
						Значение = ?(Индекс = Неопределено, Неопределено, МассивУслуг.Получить(Индекс));
						
						Если Значение <> Выборка.Услуга Тогда						
							Текст = " Установите ставку для услуги """ + Выборка.Услуга + """ по основному способу расчета. Распределение: """+ Выборка.Распределение +""".";
							
							Сообщение = Новый СообщениеПользователю();
							Сообщение.Текст = Текст;
							Сообщение.Сообщить();
							
							МассивУслуг.Добавить(Выборка.Услуга);
							
						КонецЕсли;
						
						Единицы   = 0;
						Сумма     = 0;
						
					Иначе
						
						Единицы 	= Окр(Выборка.КоличествоЕдиниц*Выборка.ДоляЛС/ВыборкаРаспределение.ДоляЛС,4,1); 
						Сумма 		= Окр(Единицы*Выборка.ПлановаяСтавка,2,1);
						ИтогСумма 	= ИтогСумма + Сумма;
						
					КонецЕсли; 
					
					МассивСтрок = ТабРаспределения.НайтиСтроки(Новый Структура("ЛицевойСчет,Услуга",Выборка.ЛицевойСчет,Выборка.Услуга));
					Если МассивСтрок.количество() = 0 тогда	
						НовСтрока = ТабРаспределения.Добавить();
						НовСтрока.Поставщик               		  = Выборка.Поставщик;
						НовСтрока.ЛицевойСчет              		  = Выборка.ЛицевойСчет;
						НовСтрока.Распределение           		  = Выборка.Распределение;
						НовСтрока.Услуга                    	  = Выборка.Услуга;
						НовСтрока.СпособРасчета             	  = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению;
						НовСтрока.КоличествоЕдиницПоЛС     		  = Единицы;
						НовСтрока.КоличествоЕдиницПоРаспределению = Выборка.КоличествоЕдиниц;
						НовСтрока.СтавкаПоРаспределению           = Выборка.ПлановаяСтавка;
						НовСтрока.Начисления               		  = Сумма;
						НовСтрока.КоличествоПроживающих    		  = Выборка.КоличествоПроживающих;
						НовСтрока.КоличествоПроживающихНорма	  = Выборка.КоличествоПроживающихНорма;
						НовСтрока.Норматив 				   		  = ?(НовСтрока.Начисления <= Выборка.Норматив, НовСтрока.Начисления, Выборка.Норматив);
						НовСтрока.Объект        				  = Выборка.Объект;
						НовСтрока.Факт                    		  = Единицы;
						НовСтрока.НормаЛьготы              		  = Выборка.НормаЛьготы;
						НовСтрока.КоличествоПроживающихВсего 	  = Выборка.КоличествоПроживающихВсего;
						ПлановаяСумма							  = Окр(Выборка.КоличествоЕдиниц*Выборка.ПлановаяСтавка,2,1);
					иначе
						НовСтрока = МассивСтрок[0];
						НовСтрока.ЛицевойСчет               	  = Выборка.ЛицевойСчет;
						НовСтрока.Распределение            		  = Выборка.Распределение;
						НовСтрока.Услуга                  		  = Выборка.Услуга;
						НовСтрока.Поставщик                		  = Выборка.Поставщик; 
						НовСтрока.СпособРасчета            		  = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению;
						НовСтрока.КоличествоЕдиницПоЛС     		  = Единицы;
						НовСтрока.КоличествоЕдиницПоРаспределению = Выборка.КоличествоЕдиниц;
						НовСтрока.СтавкаПоРаспределению    		  = Выборка.ПлановаяСтавка;
						НовСтрока.Объект 		         		  = Выборка.Объект;
						НовСтрока.Начисления               		  = Сумма;
						НовСтрока.КоличествоПроживающих    		  = Выборка.КоличествоПроживающих;
						НовСтрока.КоличествоПроживающихВсего	  = Выборка.КоличествоПроживающихВсего;
						НовСтрока.Норматив 			        	  = ?(НовСтрока.Начисления <= Выборка.Норматив, НовСтрока.Начисления, Выборка.Норматив);
						НовСтрока.Факт                    		  = Единицы;
						НовСтрока.НормаЛьготы             		  = Выборка.НормаЛьготы;
						ПлановаяСумма 							  = Окр(Выборка.КоличествоЕдиниц*Выборка.ПлановаяСтавка,2,1);
						
					КонецЕсли;	
					
				КонецЦикла;
				
				Погрешность = ПлановаяСумма - ИтогСумма;
				Если Погрешность <> 0 Тогда
					Отбор = Новый Структура;
					Отбор.Вставить("Распределение", ВыборкаРаспределение.Распределение);
					ТабРаспределения.Сортировать("Начисления Убыв");
					Строки = ТабРаспределения.НайтиСтроки(Отбор);
					если НЕ Строки = Неопределено тогда 
						Строки[0].Начисления = Строки[0].Начисления + Погрешность;
					конецЕсли; 
				КонецЕсли;
				
			КонецЦикла;	
		КонецЦикла;
	КонецЦикла;	
	
	ТабРаспределения.Сортировать("ЛицевойСчет ВОЗР, Услуга ВОЗР");
	ЗаполнениеСчетовКУ(ТабРаспределения);
	Распределения.Загрузить(ТабРаспределения);
	
КонецПроцедуры

// Процедура выполняет заполнение Счетов и Субконто.
//
Процедура ЗаполнениеСчетовКУ(ТабНачисления = Неопределено, ТабРаспределения = Неопределено) Экспорт 
	
	Если ТабНачисления=Неопределено тогда
		СписокЛС = Начисления.ВыгрузитьКолонку("ЛицевойСчет");
		Колонки  = Начисления.ВыгрузитьКолонки().Колонки;
		
		бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(Начисления, Колонки, СписокЛС, Организация , Дата);
		
	Иначе
		СписокЛС = ТабНачисления.ВыгрузитьКолонку("ЛицевойСчет");
		Колонки  = ТабНачисления.Колонки;
		
		бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ТабНачисления, Колонки, СписокЛС, Организация , Дата);
	КонецЕсли;
	
	Если ТабРаспределения=Неопределено тогда
		СписокЛС = Распределения.ВыгрузитьКолонку("ЛицевойСчет");
		Колонки  = Распределения.ВыгрузитьКолонки().Колонки;
		
		бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(Распределения, Колонки, СписокЛС, Организация , Дата);
		
	Иначе
		СписокЛС = ТабРаспределения.ВыгрузитьКолонку("ЛицевойСчет");
		Колонки  = ТабРаспределения.Колонки;
		
		бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ТабРаспределения, Колонки, СписокЛС, Организация , Дата);
	КонецЕсли;
	
КонецПроцедуры	

// Функция возвращают выборку, содержащую дату последнего дня.
// Примеа платежей.
//
Функция УстановитьДату() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",ТекущаяДата());
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_НастройкаПараметровЖКХСрезПоследних.ПоследнийДеньПриемаПлатежей КАК Число
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	Возврат Запрос.Выполнить().Выбрать();
	
КонецФункции	

#КонецОбласти

#Область ОбеспечениеПроведенияДокумента

// Проверяет правильность заполнения шапки документа.
// Если какой-то из реквизтов шапки, влияющий на проведение не заполнен или.
// Заполнен не корректно, то выставляется флаг отказа в проведении.
// Проверяется также правильность заполнения реквизитов ссылочных полей документа.
// Проверка выполняется по объекту и по выборке из результата запроса по шапке.
//
// Параметры: 
//  СтруктураШапкиДокумента - выборка из результата запроса по шапке документа,
//  Отказ                   - флаг отказа в проведении,
//  Заголовок               - строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок)
	
	// Укажем, что надо проверить.
	ОбязательныеРеквизитыШапки = "Организация";
	
	СтруктураОбязательныхПолей = Новый Структура(ОбязательныеРеквизитыШапки);
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры

// Процедура проверяет правильность заполнения реквизитов документа.
//
Процедура ПроверкаРеквизитовТЧ(ТаблицаОС,СтруктураШапкиДокумента,Отказ, Заголовок) Экспорт
	
	РеквизитыТабСписокУслуг = "ЛицевойСчет,Услуга,Счетчик,Начисления"; //через запятую.
	
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "Начисления", Новый Структура(РеквизитыТабСписокУслуг), Отказ, Заголовок);
	
	РеквизитыТабСписокУслуг = "ЛицевойСчет,Услуга,Распределение,Начисления"; //через запятую.
	
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "Распределения", Новый Структура(РеквизитыТабСписокУслуг), Отказ, Заголовок);
	
КонецПроцедуры

// Выполняет движения по регистрам.
//
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, ТаблицаПоРаспределениям, Отказ, Заголовок ,ТаблицаПоСчетчикам, ТаблицаПоНорме)
	
	ДатаДока = Дата;
	
	// Регистр накопления "Начисления по услугам ЖКХ".
	СведенияОНормативах = Движения.бит_СведенияОНормативахНачисленийЗакрытогоПериода;
	НачислениеПоУсл     = Движения.бит_НачисленияПоУслугамЖКХ;
	ОбъемПоУслугам      = Движения.бит_ОбъемыПоУслугамЖКХ;
	
	НачислениеПоУслПоПериоду = Движения.бит_НачисленияПоУслугамЖКХПоПериоду;
	
	Для каждого СтрокаТЧ Из ТаблицаПоНорме Цикл
		
		Если СтрокаТЧ.Норма = 0 И СтрокаТЧ.СверхНорма = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		ДвиженияСв = СведенияОНормативах.Добавить();
		ДвиженияСв.Период      = ДатаДока;
		ДвиженияСв.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
		ДвиженияСв.Услуга      = СтрокаТЧ.Услуга;
		ДвиженияСв.Норма       = СтрокаТЧ.Норма;
		ДвиженияСв.СверхНорма  = СтрокаТЧ.СверхНорма;
		
	КонецЦикла; 
	
	ТаблицаРасчетаНДС = Новый ТаблицаЗначений;
	Колонки = ТаблицаРасчетаНДС.Колонки;
	Колонки.Добавить("Номенклатура",	);
	Колонки.Добавить("СуммаНачислений",	ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Колонки.Добавить("СуммаБезНДС",		ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	
	Для каждого СтрокаТЧ Из ТаблицаПоУслугам Цикл
		Если СтрокаТЧ.Начислено <> 0 тогда	
			
			Движение = НачислениеПоУсл.Добавить();
			Движение.Период      = ДатаДока;
			Движение.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			Движение.УслугаЖКХ   = СтрокаТЧ.Услуга;
			Движение.Сумма       = СтрокаТЧ.Начислено;
			
			Движение.Организация   = СтруктураШапкиДокумента.Организация;
			
			ДвижениеУслПоПериоду					  = НачислениеПоУслПоПериоду.Добавить();
			ДвижениеУслПоПериоду.Период				  = ДатаДока;
			ДвижениеУслПоПериоду.ПериодВзаиморасчетов = КонецМесяца(ДатаДока);
			ДвижениеУслПоПериоду.ЛицевойСчет		  = СтрокаТЧ.ЛицевойСчет;
			ДвижениеУслПоПериоду.УслугаЖКХ			  = СтрокаТЧ.Услуга;
			ДвижениеУслПоПериоду.Организация		  = СтруктураШапкиДокумента.Организация;
			ДвижениеУслПоПериоду.Сумма				  = СтрокаТЧ.Начислено;
			
			Если ЗначениеЗаполнено( СтрокаТЧ.СчетАбонента) И ЗначениеЗаполнено( СтрокаТЧ.СчетКУ) Тогда
				Проводка = Движения.Хозрасчетный.Добавить();
				Проводка.Период     = СтруктураШапкиДокумента.Дата;
				Проводка.Содержание = "Начисление по ЛС";
				Проводка.Организация = СтруктураШапкиДокумента.Организация;
				
				Проводка.СчетДт = СтрокаТЧ.СчетАбонента;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.Субконто1);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.Субконто2);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.Субконто3);
				Проводка.СчетКт = СтрокаТЧ.СчетКУ;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.СубконтоКУ1);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.СубконтоКУ2);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.СубконтоКУ3);
				Проводка.Сумма = СтрокаТЧ.Начислено;
				
				//10.04.2019
				если Проводка.СчетДт.Количественный = Истина тогда 
				  Проводка.КоличествоДт = СтрокаТЧ.Объем;
				конецесли; 
				
				если Проводка.СчетКт.Количественный = Истина тогда 
				  Проводка.КоличествоКт = СтрокаТЧ.Объем;
				конецесли; 
				
				Если СтрокаТЧ.СчетКУ=ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД  Тогда
					Если ЗначениеЗаполнено(Проводка.СубконтоКт.СтавкиНДС) Тогда
						НДС_Ставка = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Проводка.СубконтоКт.СтавкиНДС);
						
						Проводка.СуммаНУКт = бит_РасчетыПоКоммунальнымУслугам.CкорректированнаяCуммаНДС(ТаблицаРасчетаНДС, СтрокаТЧ.СубконтоКУ3, СтрокаТЧ.Начислено, НДС_Ставка); 
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЕсли; 	
	КонецЦикла;
	
	ТаблицаРасчетаНДС.Очистить();
	
	Для каждого СтрокаТЧ Из ТаблицаПоРаспределениям Цикл
		Если СтрокаТЧ.Начислено <> 0 тогда	
			Движение = НачислениеПоУсл.Добавить();
			Движение.Период      = ДатаДока;
			Движение.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			Движение.УслугаЖКХ   = СтрокаТЧ.Услуга;
			Движение.Сумма       = СтрокаТЧ.Начислено;
			Движение.Организация   = СтруктураШапкиДокумента.Организация;
			
			ДвижениеУслПоПериоду					  = НачислениеПоУслПоПериоду.Добавить();
			ДвижениеУслПоПериоду.Период				  = ДатаДока;
			ДвижениеУслПоПериоду.ПериодВзаиморасчетов = ДатаДока;
			ДвижениеУслПоПериоду.ЛицевойСчет		  = СтрокаТЧ.ЛицевойСчет;
			ДвижениеУслПоПериоду.УслугаЖКХ			  = СтрокаТЧ.Услуга;
			ДвижениеУслПоПериоду.Организация		  = СтруктураШапкиДокумента.Организация;
			ДвижениеУслПоПериоду.Сумма				  = СтрокаТЧ.Начислено;
			
			ДвижениеОбъем = ОбъемПоУслугам.Добавить();
			ДвижениеОбъем.Период      = ДатаДока;
			ДвижениеОбъем.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			ДвижениеОбъем.Услуга      = СтрокаТЧ.Услуга;
			ДвижениеОбъем.Объем       = СтрокаТЧ.Объем;
			
			Если ЗначениеЗаполнено( СтрокаТЧ.СчетАбонента) И ЗначениеЗаполнено( СтрокаТЧ.СчетКУ) Тогда  			 			
				Проводка = Движения.Хозрасчетный.Добавить();
				Проводка.Период     = СтруктураШапкиДокумента.Дата;
				Проводка.Содержание = "Начисление по ЛС";
				Проводка.Организация = СтруктураШапкиДокумента.Организация;
				
				Проводка.СчетДт = СтрокаТЧ.СчетАбонента;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.Субконто1);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.Субконто2);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.Субконто3);
				Проводка.СчетКт = СтрокаТЧ.СчетКУ;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.СубконтоКУ1);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.СубконтоКУ2);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.СубконтоКУ3);	
				Проводка.Сумма = СтрокаТЧ.Начислено;
				
				Если СтрокаТЧ.СчетКУ=ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД  Тогда
					Если ЗначениеЗаполнено(Проводка.СубконтоКт.СтавкиНДС) Тогда
						НДС_Ставка = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Проводка.СубконтоКт.СтавкиНДС);
						
						Проводка.СуммаНУКт = бит_РасчетыПоКоммунальнымУслугам.CкорректированнаяCуммаНДС(ТаблицаРасчетаНДС, СтрокаТЧ.СубконтоКУ3, СтрокаТЧ.Начислено, НДС_Ставка); 
					КонецЕсли;
				КонецЕсли;
				
			КонецЕсли;	
			
		КонецЕсли; 	
	КонецЦикла;
	
	// Регистр накопления "Показания счетчиков".
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_НачисленияПоСчетчикамНачисления.ВладелецСчетчика КАК Объект,
	|	бит_НачисленияПоСчетчикамНачисления.Услуга КАК Услуга,
	|	бит_НачисленияПоСчетчикамНачисления.Счетчик КАК Счетчик,
	|	МАКСИМУМ(бит_НачисленияПоСчетчикамНачисления.ОтПоказаний) КАК ОтПоказаний,
	|	МАКСИМУМ(бит_НачисленияПоСчетчикамНачисления.ДоПоказаний) КАК ДоПоказаний,
	|	МАКСИМУМ(бит_НачисленияПоСчетчикамНачисления.КоличествоЕдиницПоСчетчику) КАК КоличествоЕдиницПоСчетчику,
	|	МАКСИМУМ(бит_НачисленияПоСчетчикамНачисления.КоличествоЕдиницПоЛС) КАК КоличествоЕдиницПоЛС,
	|	МАКСИМУМ(бит_НачисленияПоСчетчикамНачисления.СтавкаПоСчетчику) КАК СтавкаПоСчетчику,
	|	бит_НачисленияПоСчетчикамНачисления.ИсточникПоказаний
	|ПОМЕСТИТЬ СписокПоказаний
	|ИЗ
	|	Документ.бит_НачисленияПоСчетчикам.Начисления КАК бит_НачисленияПоСчетчикамНачисления
	|ГДЕ
	|	бит_НачисленияПоСчетчикамНачисления.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоСчетчикамНачисления.Услуга,
	|	бит_НачисленияПоСчетчикамНачисления.Счетчик,
	|	бит_НачисленияПоСчетчикамНачисления.ВладелецСчетчика,
	|	бит_НачисленияПоСчетчикамНачисления.ИсточникПоказаний
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект,
	|	Услуга,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ПоказанияСчетчиковОстатки.Объект КАК ОбъектРасход,
	|	бит_ПоказанияСчетчиковОстатки.Услуга КАК УслугаРасход,
	|	бит_ПоказанияСчетчиковОстатки.Счетчик КАК СчетчикРасход,
	|	бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток КАК ПоследниеПоказания,
	|	бит_ПоказанияСчетчиковОстатки.КоэффициентОстаток КАК Коэффициент,
	|	бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток КАК ТекущиеПоказанияИнспектора,
	|	бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток КАК ТекущиеПоказанияНаселения,
	|	бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток КАК ПоказанияПодкрутка
	|ПОМЕСТИТЬ ВТ_ПоказанияСчетчиков
	|ИЗ
	|	РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
	|			&Момент,
	|			(Объект, Услуга, Счетчик) В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					СписокПоказаний.Объект,
	|					СписокПоказаний.Услуга,
	|					СписокПоказаний.Счетчик
	|				ИЗ
	|					СписокПоказаний)) КАК бит_ПоказанияСчетчиковОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОбъектРасход,
	|	УслугаРасход,
	|	СчетчикРасход
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокПоказаний.Услуга,
	|	СписокПоказаний.Счетчик,
	|	СписокПоказаний.ОтПоказаний,
	|	СписокПоказаний.ДоПоказаний,
	|	СписокПоказаний.КоличествоЕдиницПоСчетчику,
	|	СписокПоказаний.КоличествоЕдиницПоЛС,
	|	СписокПоказаний.СтавкаПоСчетчику,
	|	СписокПоказаний.ИсточникПоказаний,
	|	СписокПоказаний.Объект,
	|	ВТ_ПоказанияСчетчиков.ОбъектРасход КАК ОбъектРасход,
	|	ВТ_ПоказанияСчетчиков.УслугаРасход КАК УслугаРасход,
	|	ВТ_ПоказанияСчетчиков.СчетчикРасход КАК СчетчикРасход,
	|	ВТ_ПоказанияСчетчиков.ПоследниеПоказания КАК ПоследниеПоказания,
	|	ВТ_ПоказанияСчетчиков.Коэффициент КАК Коэффициент,
	|	ВТ_ПоказанияСчетчиков.ТекущиеПоказанияИнспектора КАК ТекущиеПоказанияИнспектора,
	|	ВТ_ПоказанияСчетчиков.ТекущиеПоказанияНаселения КАК ТекущиеПоказанияНаселения,
	|	ВТ_ПоказанияСчетчиков.ПоказанияПодкрутка КАК ПоказанияПодкрутка
	|ИЗ
	|	СписокПоказаний КАК СписокПоказаний
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказанияСчетчиков КАК ВТ_ПоказанияСчетчиков
	|		ПО СписокПоказаний.Объект = ВТ_ПоказанияСчетчиков.ОбъектРасход
	|			И СписокПоказаний.Услуга = ВТ_ПоказанияСчетчиков.УслугаРасход
	|			И СписокПоказаний.Счетчик = ВТ_ПоказанияСчетчиков.СчетчикРасход";
	
	Запрос.УстановитьПараметр("Момент",МоментВремени());
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий()  Цикл 
		
		Если  Выборка.УслугаРасход <> Null тогда
			Движение = Движения.бит_ПоказанияСчетчиков.ДобавитьРасход();
			Движение.Период                     = Дата;
			Движение.Регистратор                = Ссылка;
			Движение.Объект                     = Выборка.ОбъектРасход;
			Движение.Услуга                     = Выборка.УслугаРасход;
			Движение.Счетчик                    = Выборка.СчетчикРасход;
			Движение.Коэффициент                = Выборка.Коэффициент;
			Движение.ПоследниеПоказания         = Выборка.ПоследниеПоказания;
			Движение.ТекущиеПоказанияИнспектора = Выборка.ТекущиеПоказанияИнспектора;
			Движение.ТекущиеПоказанияНаселения  = Выборка.ТекущиеПоказанияНаселения;
			Движение.ТекущиеПоказанияИнспектора = Выборка.ТекущиеПоказанияИнспектора;
			Движение.ТекущиеПоказанияНаселения  = Выборка.ТекущиеПоказанияНаселения;
			Если Выборка.ИсточникПОказаний = Перечисления.бит_ИсточникПоказаний.Подкрутка Тогда
				Движение.ПоказанияПодкрутка = Выборка.ДоПоказаний;
			КонецЕсли;
			
			Движение.ПоказанияПодкрутка         = Выборка.ПоказанияПодкрутка;
			
			Движение.Организация   = СтруктураШапкиДокумента.Организация;
			
		КонецЕсли;
		
		Движение = Движения.бит_ПоказанияСчетчиков.ДобавитьПриход();
		Движение.Период             = Дата;
		Движение.Регистратор        = Ссылка;
		Движение.Объект             = Выборка.Объект;
		Движение.Услуга             = Выборка.Услуга;
		Движение.Счетчик            = Выборка.Счетчик;
		Движение.Коэффициент        = Выборка.Счетчик.КоэффициентУмножения;
		Движение.ПоследниеПоказания = Выборка.ДоПоказаний;
		Если Выборка.ИсточникПоказаний = Перечисления.бит_ИсточникПоказаний.Инспектор Тогда
			Движение.ТекущиеПоказанияИнспектора = Выборка.ДоПоказаний;
		ИначеЕсли  Выборка.ИсточникПоказаний = Перечисления.бит_ИсточникПоказаний.Население Тогда
			Движение.ТекущиеПоказанияНаселения = Выборка.ДоПоказаний;
		ИначеЕсли Выборка.ИсточникПОказаний = Перечисления.бит_ИсточникПоказаний.Подкрутка Тогда
			Движение.ПоказанияПодкрутка = Выборка.ДоПоказаний;
		КонецЕсли;
		
		Движение.Организация   = СтруктураШапкиДокумента.Организация;
		
	КонецЦикла;
	
	// Движения по регистру бит_КоличествоЕдиницПоказанийСчетчиков.
	ДвижениеЕд = Движения.бит_КолЕдПоСчетчикам;
	
	Для каждого СтрокаТЧ Из ТаблицаПоУслугам Цикл
		
		НоваяЗапись = ДвижениеЕд.Добавить();
		НоваяЗапись.Период               = Дата;
		НоваяЗапись.ЛицевойСчет          = СтрокаТЧ.ЛицевойСчет;
		НоваяЗапись.УслугаЖКХ            = СтрокаТЧ.Услуга;
		НоваяЗапись.Счетчик              = СтрокаТЧ.Счетчик;
		НоваяЗапись.КоличествоЕдиницПоЛС = СтрокаТЧ.КоличествоЕдиницПоЛС;
		
	КонецЦикла; 
	// Движение по регистру накопления бит_КолЕдиницПоСчетчикам.
	ДвижениеЕдиниц = Движения.бит_КолЕдиницПоСчетчикам;
	
	Для каждого СтрокаТЧ Из ТаблицаПоУслугам Цикл
		
		НоваяЗапись = ДвижениеЕдиниц.Добавить();
		НоваяЗапись.Период               = Дата;
		НоваяЗапись.ЛицевойСчет          = СтрокаТЧ.ЛицевойСчет;
		НоваяЗапись.УслугаЖКХ            = СтрокаТЧ.Услуга;
		НоваяЗапись.Счетчик              = СтрокаТЧ.Счетчик;
		
		Если СтрокаТЧ.ИсточникПоказаний = Перечисления.бит_ИсточникПоказаний.Подкрутка Тогда
			НоваяЗапись.КоличествоЕдПодкрутка= СтрокаТЧ.КоличествоЕдиницПоЛС;
		Иначе
			НоваяЗапись.КоличествоЕдиницПоЛС = СтрокаТЧ.КоличествоЕдиницПоЛС;
		КонецЕсли; 
		
	КонецЦикла;
	
	Запрос  = новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_НачисленияПоСчетчикамРаспределения.Услуга,
	|	бит_НачисленияПоСчетчикамРаспределения.Распределение,
	|	СУММА(бит_НачисленияПоСчетчикамРаспределения.КоличествоЕдиницПоЛС) КАК КоличествоЕдиниц
	|ИЗ
	|	Документ.бит_НачисленияПоСчетчикам.Распределения КАК бит_НачисленияПоСчетчикамРаспределения
	|ГДЕ
	|	бит_НачисленияПоСчетчикамРаспределения.Ссылка = &Ссылка
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоСчетчикамРаспределения.Услуга,
	|	бит_НачисленияПоСчетчикамРаспределения.Распределение";
	
	Запрос.УстановитьПараметр("Момент",МоментВремени());
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	Выборка = Запрос.Выполнить().Выбрать();
	
	ДвижениеРаспределения = Движения.бит_Распределения;
	
	Пока Выборка.Следующий()  Цикл 
		
		НоваяЗапись = ДвижениеРаспределения.ДобавитьРасход();
		НоваяЗапись.Период            = Дата;
		НоваяЗапись.Объект            = Здание;
		НоваяЗапись.Услуга            = Выборка.Услуга;
		НоваяЗапись.Распределение     = Выборка.Распределение;
		НоваяЗапись.Сумма			  = Выборка.КоличествоЕдиниц;
		
		НоваяЗапись.Организация   = СтруктураШапкиДокумента.Организация;
		
	КонецЦикла; 
	
	Для каждого Строка Из ТаблицаПоСчетчикам Цикл
		
		Если НЕ Строка.Начислено = 0 Тогда
			
			НоваяЗапись = Движения.бит_НачисленияПоСчетчикам.Добавить();
			
			НоваяЗапись.Период      = Дата;
			НоваяЗапись.ЛицевойСчет = Строка.ЛицевойСчет;
			НоваяЗапись.УслугаЖКХ   = Строка.Услуга;
			НоваяЗапись.Счетчик     = Строка.Счетчик;
			НоваяЗапись.Сумма       = Строка.Начислено;
			
			ДвижениеОбъем = ОбъемПоУслугам.Добавить();
			ДвижениеОбъем.Период      = ДатаДока;
			ДвижениеОбъем.ЛицевойСчет = Строка.ЛицевойСчет;
			ДвижениеОбъем.Услуга      = Строка.Услуга;
			ДвижениеОбъем.Счетчик     = Строка.Счетчик;
			ДвижениеОбъем.Объем       = Строка.Объем;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

// Функция выполняет проверку дублирования документа при закрытии месяца.
//
// Возвращаемое значение:
//   Строка   – текст сообщения.
//
Функция ПроверкаПовторовДокументов()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоМесяца" ,НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("КонецМесяца"  ,КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Организация"  ,Организация);
	Запрос.УстановитьПараметр("Улица"        ,Улица);
	Запрос.УстановитьПараметр("Здание"       ,Здание);
	Запрос.УстановитьПараметр("Ссылка"       ,Ссылка);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НачисленияПоСчетчикам.Ссылка,
	|	НачисленияПоСчетчикам.Проведен,
	|	НачисленияПоСчетчикам.Организация,
	|	НачисленияПоСчетчикам.Улица,
	|	НачисленияПоСчетчикам.Здание,
	|	НачисленияПоСчетчикам.Дата
	|ИЗ
	|	Документ.бит_НачисленияПоСчетчикам КАК НачисленияПоСчетчикам
	|ГДЕ
	|	НачисленияПоСчетчикам.Организация = &Организация
	|	И НачисленияПоСчетчикам.Дата >= &НачалоМесяца
	|	И НачисленияПоСчетчикам.Дата <= &КонецМесяца
	|	И (НЕ НачисленияПоСчетчикам.ПометкаУдаления)
	|	И НачисленияПоСчетчикам.Улица = &Улица
	|	И НачисленияПоСчетчикам.Здание = &Здание
	|	И НачисленияПоСчетчикам.Ссылка <> &Ссылка";
	
	Результат = Запрос.Выполнить();
	
	ТекстСообщения = "";
	Если Не Результат.Пустой() тогда
		ТекстСообщения = ТекстСообщения + "Документ в данном месяц уже создан.";
	КонецЕсли;
	Возврат ТекстСообщения;
	
Конецфункции

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	// Проверим правильность заполнения шапки документа.
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ЛицевойСчет"          ,"ЛицевойСчет");
	СтруктураПолей.Вставить("Услуга"               ,"Услуга");
	СтруктураПолей.Вставить("Счетчик"              ,"Счетчик");
	СтруктураПолей.Вставить("ИсточникПоказаний"    ,"ИсточникПоказаний");
	СтруктураПолей.Вставить("ОтПоказаний"          ,"ОтПоказаний");
	СтруктураПолей.Вставить("ДоПоказаний"          ,"ДоПоказаний");
	СтруктураПолей.Вставить("ПодкруткаСчетчика"    ,"ПодкруткаСчетчика");
	СтруктураПолей.Вставить("Начислено"            ,"Начислено");
	СтруктураПолей.Вставить("Объем"                ,"Объем");
	СтруктураПолей.Вставить("СчетАбонента"         ,"СчетАбонента");
	СтруктураПолей.Вставить("Субконто1"            ,"Субконто1");
	СтруктураПолей.Вставить("Субконто2"            ,"Субконто2");
	СтруктураПолей.Вставить("Субконто3"            ,"Субконто3");
	СтруктураПолей.Вставить("СчетКУ"               ,"СчетКУ");
	СтруктураПолей.Вставить("СубконтоКУ1"          ,"СубконтоКУ1");
	СтруктураПолей.Вставить("СубконтоКУ2"          ,"СубконтоКУ2");
	СтруктураПолей.Вставить("СубконтоКУ3"          ,"СубконтоКУ3");
	СтруктураПолей.Вставить("КоличествоЕдиницПоЛС" ,"КоличествоЕдиницПоЛС");
	СтруктураПолей.Вставить("Норма"                ,"Норма");
	СтруктураПолей.Вставить("СверхНорма"           ,"СверхНорма");
	
	РезультатЗапросаПоУслугам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Начисления", СтруктураПолей);
	ТаблицаПоУслугам          = РезультатЗапросаПоУслугам.Выгрузить();
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ЛицевойСчет"          ,"ЛицевойСчет");
	СтруктураПолей.Вставить("Услуга"               ,"Услуга");
	СтруктураПолей.Вставить("Норма"                ,"Норма");
	СтруктураПолей.Вставить("СверхНорма"           ,"СверхНорма");
	
	РезультатЗапросаПоУслугам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Начисления", СтруктураПолей);
	ТаблицаПоНорме            = РезультатЗапросаПоУслугам.Выгрузить();
	ТаблицаПоНорме.Свернуть("ЛицевойСчет,Услуга","Норма,СверхНорма");
	
	СтруктураПолейРаспределений = Новый Структура;
	СтруктураПолейРаспределений.Вставить("ЛицевойСчет"       ,"ЛицевойСчет");
	СтруктураПолейРаспределений.Вставить("Услуга"            ,"Услуга");
	СтруктураПолейРаспределений.Вставить("Распределение"     ,"Распределение");
	СтруктураПолейРаспределений.Вставить("Начислено"         ,"Начислено");
	СтруктураПолейРаспределений.Вставить("Объем"             ,"Объем");
	СтруктураПолейРаспределений.Вставить("СчетАбонента"		 ,"СчетАбонента");
	СтруктураПолейРаспределений.Вставить("Субконто1"  		 ,"Субконто1");
	СтруктураПолейРаспределений.Вставить("Субконто2"  		 ,"Субконто2");
	СтруктураПолейРаспределений.Вставить("Субконто3"  		 ,"Субконто3");
	СтруктураПолейРаспределений.Вставить("СчетКУ"     		 ,"СчетКУ");
	СтруктураПолейРаспределений.Вставить("СубконтоКУ1"		 ,"СубконтоКУ1");
	СтруктураПолейРаспределений.Вставить("СубконтоКУ2" 		 ,"СубконтоКУ2");
	СтруктураПолейРаспределений.Вставить("СубконтоКУ3" 		 ,"СубконтоКУ3");
	СтруктураПолейРаспределений.Вставить("КоличествоЕдиницПоЛС"  ,"КоличествоЕдиницПоЛС");
	
	РезультатЗапросаПоРаспределениям = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Распределения", СтруктураПолейРаспределений);
	ТаблицаПоРаспределениям          = РезультатЗапросаПоРаспределениям.Выгрузить();
	
	СтруктураПолейПоСчетчикам = Новый Структура;
	СтруктураПолейПоСчетчикам.Вставить("ЛицевойСчет"       ,"ЛицевойСчет");
	СтруктураПолейПоСчетчикам.Вставить("Услуга"            ,"Услуга");
	СтруктураПолейПоСчетчикам.Вставить("Счетчик"           ,"Счетчик");
	СтруктураПолейПоСчетчикам.Вставить("Начислено"         ,"Начислено");
	СтруктураПолейПоСчетчикам.Вставить("Объем"             ,"Объем");
	
	РезультатЗапросаПоСчетчикам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Начисления", СтруктураПолейПоСчетчикам);
	ТаблицаПоСчетчикам          = РезультатЗапросаПоСчетчикам.Выгрузить();
	
	Если НЕ Отказ Тогда
		
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, ТаблицаПоРаспределениям, Отказ, Заголовок, ТаблицаПоСчетчикам, ТаблицаПоНорме);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	// При обмене проверок не выполняем.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// Для новых документов установим время в конец дня.
	Если ЭтоНовый() Тогда				
		
		ДатаБезВремени = НачалоДня(ТекущаяДата());
		
		Если ДатаБезВремени = Дата Тогда
			
			Дата = ТекущаяДата();
			
		КонецЕсли;
		
	КонецЕсли;
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	СообщенияОповторахВидовОпераций = ПроверкаПовторовДокументов();
	Если ЗначениеЗаполнено(СообщенияОповторахВидовОпераций) Тогда
		ТекстСообщения = СообщенияОповторахВидовОпераций;
		бит_ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения, Отказ, бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(ЭтотОбъект));
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	Если Организация = Справочники.Организации.ПустаяСсылка() тогда
		
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Не заполнена организация!";
			Сообщение.Сообщить();
		
		Отказ = Истина
	КонецЕсли;
	
	ТЗСписокЛС = Начисления.Выгрузить(,"ЛицевойСчет");
	ТЗСписокЛС.Свернуть("ЛицевойСчет");
	
	СписокЛицевыхСчетов = "";
	Для каждого Строка Из ТЗСписокЛС Цикл
		
		Если ПустаяСтрока(Строка.ЛицевойСчет.Наименование) Тогда
			Продолжить;
		КонецЕсли; 
		
		Если СписокЛицевыхСчетов = "" Тогда
			СписокЛицевыхСчетов = ""+Строка.ЛицевойСчет.Наименование;
		Иначе
			СписокЛицевыхСчетов = ""+СписокЛицевыхСчетов +", " +Строка.ЛицевойСчет.Наименование;
		КонецЕсли; 
		
	КонецЦикла;
	
	ДокументСтруктура = Новый Структура;
	ДокументСтруктура.Вставить("Имя"            , Метаданные().Имя);
	ДокументСтруктура.Вставить("Ссылка"         , Ссылка);
	ДокументСтруктура.Вставить("ПометкаУдаления", ПометкаУдаления);
	
	бит_РасчетыПоКоммунальнымУслугам.СинхронизацияПометкиНаУдалениеУСДокументамиРаспределенияРасходов(ДокументСтруктура);
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам;
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли