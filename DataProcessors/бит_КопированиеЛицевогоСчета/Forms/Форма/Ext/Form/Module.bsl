				Продолжить;
			КонецЕсли; 
			
			НоваяСтрока = Объект.Проживающие.Добавить();
			НоваяСтрока.ФизЛицо          = ЭлементМассива;
			НоваяСтрока.СтатусФизЛица    = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.ПостояннаяРегистрация");
			НоваяСтрока.СтепеньРодства   = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_НеУказано");
			НоваяСтрока.СтатусПроживания = ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Постоянно");
			
		КонецЦикла; 
		
	КонецЕсли; 
	
