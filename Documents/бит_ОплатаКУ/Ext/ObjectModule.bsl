// Обработчик события "ОбработкаПроведения" документа.
//
Процедура ОбработкаПроведения(Отказ)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	ПараметрыПроведения = Документы.бит_ОплатаКУ.ПодготовитьПараметрыПроведения(Ссылка, Отказ);
	
	Если ВводВРучную Тогда
		
		ПроверкаОплатыВведнойВРучную(Отказ);
		
	КонецЕсли; 
	
	Если НЕ Отказ Тогда
		
		бит_НачисленияЖКХ.СформироватьДвиженияОплатаНачисленияПоУслугамЖКХ(ПараметрыПроведения.Реквизиты.Организация, ПараметрыПроведения.СписокУслуг, ПараметрыПроведения.СписокУслугПоПериоду, ПараметрыПроведения.Реквизиты ,Движения, Отказ);
		бит_НачисленияЖКХ.СформироватьДвиженияОплатаХозрасчетный(ПараметрыПроведения.СписокУслуг,ПараметрыПроведения.СписокЛС,ПараметрыПроведения.Реквизиты,Движения,Отказ);
		бит_НачисленияЖКХ.СформироватьДвиженияПоИсполнительным(СписокЛС,ПараметрыПроведения.Реквизиты,Движения,Отказ); 
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "ПередЗаписью" документа.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	//++АнисимоваМВ 1бит восстановление после сбоя 08.11.2024
	УдалитьЛишниеСтрокиСпискаУслуг();
	//--АнисимоваМВ 1бит восстановление после сбоя 08.11.2024
	// При обмене проверок не выполняем.
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(ЭтотОбъект, Отказ);
	
	УдалитьПустыеСтроки(); 
	
	
	//+! Гаспирович ВВ. Если не бухсправка и не заполнена таблица распределения по периодам
	Если лб_ВидОплаты <> справочники.лб_ВидыОплат.НайтиПоКоду("000000004") и  СписокУслугПоПериоду.Количество()<>0 тогда 
		СписокУслугПоПериоду.Очистить();
	КонецЕсли;
	
		
КонецПроцедуры
	//++АнисимоваМВ 1бит восстановление после сбоя 08.11.2024
Процедура УдалитьЛишниеСтрокиСпискаУслуг()

	Запрос = Новый Запрос("
	| ВЫБРАТЬ * ПОМЕСТИТЬ СписокУслуг ИЗ &СписокУслуг КАК СписокУслуг;
	| ВЫБРАТЬ * ПОМЕСТИТЬ СписокЛС ИЗ &СписокЛС КАК СписокЛС;
	|ВЫБРАТЬ
	|	бит_ОплатаКУСписокУслуг.НомерСтроки КАК НомерСтроки,
	|	бит_ОплатаКУСписокУслуг.ЛицевойСчет КАК ЛицевойСчет
	|ИЗ
	|	СписокУслуг КАК бит_ОплатаКУСписокУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ СписокЛС КАК бит_ОплатаКУСписокЛС
	|		ПО (бит_ОплатаКУСписокУслуг.ЛицевойСчет = бит_ОплатаКУСписокЛС.ЛицевойСчет) 
	|		И  (бит_ОплатаКУСписокУслуг.лб_КлючСтроки = бит_ОплатаКУСписокЛС.лб_КлючСтроки)
	|ГДЕ 
	|	бит_ОплатаКУСписокЛС.НомерСтроки ЕСТЬ NULL");
	
	Запрос.УстановитьПараметр("СписокУслуг", ЭтотОбъект.СписокУслуг.Выгрузить());   
	Запрос.УстановитьПараметр("СписокЛС", ЭтотОбъект.СписокЛС.Выгрузить());   
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать(); 
	МассивСтрок = Новый Массив();
	Пока Выборка.Следующий() Цикл
		МассивСтрок.Добавить(ЭтотОбъект.СписокУслуг[Выборка.НомерСтроки-1]);
	КонецЦикла;   
	Для Каждого Стр Из МассивСтрок Цикл    
		ЭтотОбъект.СписокУслуг.Удалить(Стр);
	КонецЦикла;
	
КонецПроцедуры
	//--АнисимоваМВ 1бит восстановление после сбоя 08.11.2024

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	ВидОперации = Перечисления.бит_ВидыОперацийОплатыКУ.НачислениеОплаты;
	
КонецПроцедуры

#КонецОбласти

