функция ОтветственноеЛицоНаЛСПоВладению(ЛицевойСчет, ФизЛицо, ПериодЗапроса)          	
	
	структураВозврата = новый СТруктура();
	
	запрос = новый Запрос;
	запрос.Текст = 
		
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаПраваСобственности КАК ДатаПраваСобственности,
	|	бит_ПроживающиеПоЛССрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&ПериодЗапроса, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = &ФизЛицо
	|	И бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет = &ЛицевойСчет";
//	|	И бит_ПроживающиеПоЛС.СтатусФизЛица <> &СтатусФизЛица";
	
	запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПериодЗапроса));
	запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПериодЗапроса));
	запрос.УстановитьПараметр("СтатусФизЛица", справочники.бит_СтатусФизЛица.Выписан);
    запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	запрос.УстановитьПараметр("ПериодЗапроса", КонецМесяца(ПериодЗапроса));
	
	таблицаЗапроса = запрос.Выполнить().Выгрузить();
	
	если таблицаЗапроса.Найти(справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо, "СтепеньРодства") = неопределено тогда
	 структураВозврата.Вставить("ФизЛицо", таблицаЗапроса[0].ФизЛицо);
	 структураВозврата.Вставить("Ответственный", ложь);	
	 
	 возврат структураВозврата;
    конецесли;
	
	если таблицаЗапроса.Количество() > 0 тогда
		таблицаЗапроса.Сортировать("ДатаПраваСобственности Убыв");
		
		;
		// БИТ ЖКХ 10.04.2020 - сейчас ответственный?		
		если таблицаЗапроса[0].СтепеньРодства = справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо тогда 
		  структураВозврата.Вставить("ФизЛицо", таблицаЗапроса[0].ФизЛицо);
		  если ДатаВПериоде (таблицаЗапроса[0].ДатаПраваСобственности, ПериодЗапроса) тогда
		   структураВозврата.Вставить("Ответственный", истина); 
	      иначе
		   структураВозврата.Вставить("Ответственный", истина); 
		  конецесли; 
		  структураВозврата.Вставить("ДатаСнятияСРегистрации", таблицаЗапроса[0].ДатаСнятияСРегистрации);
		  структураВозврата.Вставить("ДатаРегистрации", таблицаЗапроса[0].ДатаПраваСобственности);
		  
	    иначе	  
		  структураВозврата.Вставить("ФизЛицо", таблицаЗапроса[0].ФизЛицо);
	      структураВозврата.Вставить("Ответственный", ложь);	
	      возврат структураВозврата;
		конецесли;	         					 
    конецесли;			
 
	возврат структураВозврата; 
конецфункции

