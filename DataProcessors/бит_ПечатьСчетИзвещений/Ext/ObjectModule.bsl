				ОбновитьТаблицаПлатежиГИСЖКХ36(мСтруктураДанных.ЛицевойСчет, СтрокаСведений, ИспользоватьКомментарийКакОснование);
				
				ТабДокуРаздел5.Вывести(ОбластьРаздел5Строка);
				
			КонецЦикла;
			
		КонецЕсли;
		
		Если НЕ ТабДокуРаздел5 = Неопределено Тогда
			Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(Квитанция, ТабДокуРаздел5) Тогда
				Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
				Квитанция.Вывести(ТабДокуРаздел5);
			Иначе
				Квитанция.Вывести(ТабДокуРаздел5);
			КонецЕсли;  
		КонецЕсли; 

	КонецЕсли; //Конец условия мКэшПараметрыЖКХ.РаздельныйУчетКапРемонта.

	
	Если ИспользоватьQR = Истина Тогда
		
		Попытка	
			ОбластьШтрихкодQR                   = мМакет.ПолучитьОбласть("ШтрихкодQR");
		Исключение
		КонецПопытки;
		
		НапечататьQRКод(Квитанция, ОбластьШтрихкодQR);
	Иначе
		УбратьQRКод(Квитанция)
	КонецЕсли;
	
	// Платежные документы ГИС ЖКХ 1-2.
	Если мТаблицаПлатежиГИСЖКХ12 = Неопределено Тогда
		Возврат Квитанция;	
	КонецЕсли;
	
	Для Каждого Стр Из ТаблицаПлатежиГИСЖКХ12Получатели Цикл
				
		ЗадолженностьЗаПредыдущиеПериоды= ОбластьРаздел2Итог.Параметры.ДолгСУчетомОплаты; 
		АвансНаНачалоПериода			= ОбластьРаздел2Итог.Параметры.Авансы;
		ИтогоКОплатеЗаРС				= ОбластьИтог.Параметры.КОплатеЗаМесяц;
		ИтогоКОплатеЗаРССальдо			= ОбластьРаздел2Итог.Параметры.Коплате;
		
		СтрПлатежГИСЖКХ = мТаблицаПлатежиГИСЖКХ12.Добавить();
		СтрПлатежГИСЖКХ.ЛицевойСчет						= мСтруктураДанных.ЛицевойСчет;
		СтрПлатежГИСЖКХ.ИдентификаторЖКУ				= мСтруктураДанных.ИдентификаторЖКУ;
		//СтрПлатежГИСЖКХ.ТипПД							= ?(ШаблонИзвещений.Сальдо = Перечисления.ДаНет.Да, "Долговой", "Текущий");
		СтрПлатежГИСЖКХ.РасчетныйПериод					= мСтруктураДанных.Дата;
		СтрПлатежГИСЖКХ.ЗадолженностьЗаПредыдущиеПериоды= ?(ЗначениеЗаполнено(ЗадолженностьЗаПредыдущиеПериоды), ЗадолженностьЗаПредыдущиеПериоды, 0);
		СтрПлатежГИСЖКХ.АвансНаНачалоПериода	 		= ?(ЗначениеЗаполнено(АвансНаНачалоПериода), АвансНаНачалоПериода, 0);
		СтрПлатежГИСЖКХ.Оплачено						= мСтруктураДанных.Оплата;
		СтрПлатежГИСЖКХ.ЧислоРасчетногоПериода			= День(КонецМесяца(мСтруктураДанных.Дата));
		СтрПлатежГИСЖКХ.ДатаПоследнейОплаты				= мСтруктураДанных.ДатаПоследнейОплатыНеКапРемГИСЖКХ;
		СтрПлатежГИСЖКХ.ДатаПоследнейОплатыКапРем		= мСтруктураДанных.ДатаПоследнейОплатыКапРемГИСЖКХ;
		СтрПлатежГИСЖКХ.ИтогоКОплатеЗаРС				= ?(ЗначениеЗаполнено(ИтогоКОплатеЗаРС), ИтогоКОплатеЗаРС, 0);
		СтрПлатежГИСЖКХ.ИтогоКОплатеЗаРССальдо			= ?(ЗначениеЗаполнено(ИтогоКОплатеЗаРССальдо), ИтогоКОплатеЗаРССальдо, 0);
		
		ЗаполнитьЗначенияСвойств(СтрПлатежГИСЖКХ, Стр);
		СтрПлатежГИСЖКХ.ТабличнйДокумент = Квитанция;
		
	КонецЦикла;
	
	ЗаполнитьТаблицаПлатежиГИСЖКХНеустойки(мСтруктураДанных.ЛицевойСчет, мСтруктураДанных.НачисленоПениЗаПериод, мСтруктураДанных.ИтогПени);
	
	Возврат Квитанция;
	
КонецФункции

Функция ПечатьПлатежныйДокументРК924ГИСЖКХ() Экспорт
	
	//20.03.2019
	Если мТаблицаПлатежиГИСЖКХ36 = Неопределено тогда
		мТаблицаПлатежиГИСЖКХ36			= ПолучитьТаблицаПлатежиГИСЖКХ36();
	конецесли;	
	
	Если мТаблицаПлатежиГИСЖКХДПД = Неопределено тогда
	    мТаблицаПлатежиГИСЖКХДПД		= ПолучитьТаблицаПлатежиГИСЖКХДПД();
	конецесли;  
    //--------
	
	
	Квитанция = Новый ТабличныйДокумент;
	ОбластьЗаголовок			= мМакет.ПолучитьОбласть("Заголовок");
	ОбластьШапка				= мМакет.ПолучитьОбласть("Шапка");
	ОбластьРаздел2Шапка			= мМакет.ПолучитьОбласть("Раздел2Шапка");
	ОбластьРаздел2Строка		= мМакет.ПолучитьОбласть("Раздел2Строка");
	ОбластьРаздел2Итог			= мМакет.ПолучитьОбласть("Раздел2Итог");
	ОбластьРаздел34Шапка		= мМакет.ПолучитьОбласть("Раздел34Шапка");
	ОбластьСтрокаГрСодержание	= мМакет.ПолучитьОбласть("ГруппаСодержание");
	ОбластьСтрокаГрКоммунальные	= мМакет.ПолучитьОбласть("ГруппаКоммунальные");
	ОбластьСтрокаГрПрочие		= мМакет.ПолучитьОбласть("ГруппаПрочие");
	ОбластьСтрока				= мМакет.ПолучитьОбласть("Строка");
	ОбластьИтог					= мМакет.ПолучитьОбласть("Итого");
	ОбластьУказания				= мМакет.ПолучитьОбласть("Указания");
	ОбластьПустаяСтрока			= мМакет.ПолучитьОбласть("ПустаяСтрока");
	ОбластьРаздел5Заголовок		= мМакет.ПолучитьОбласть("Раздел5Заголовок");
	ОбластьРаздел5Шапка			= мМакет.ПолучитьОбласть("Раздел5Шапка");
	ОбластьРаздел5НомКолонок	= мМакет.ПолучитьОбласть("Раздел5НомКолонок");
	ОбластьРаздел5Строка		= мМакет.ПолучитьОбласть("Раздел5Строка");
	ОбластьРаздел6Шапка			= мМакет.ПолучитьОбласть("Раздел6Шапка");
	ОбластьРаздел6Строка		= мМакет.ПолучитьОбласть("Раздел6Строка");
	ОбластьРаздел6Итого			= мМакет.ПолучитьОбласть("Раздел6Итого");
	
	ТаблицаПлатежиГИСЖКХ12Получатели = ПолучитьТаблицаПлатежиГИСЖКХ12Получатели();
	
	Если мКэшПараметрыЖКХ.РаздельныйУчетКапРемонта Тогда
		
		ОбластьРаздел7Шапка			= мМакет.ПолучитьОбласть("Раздел7Шапка");
		ОбластьРаздел7Строка		= мМакет.ПолучитьОбласть("Раздел7Строка");
		ОбластьРаздел8Шапка			= мМакет.ПолучитьОбласть("Раздел8Шапка");
		ОбластьРаздел8Строка		= мМакет.ПолучитьОбласть("Раздел8Строка");
		ОбластьРаздел8Итог			= мМакет.ПолучитьОбласть("Раздел8Итог");
		ИтогоКапКОплате				= 0;
		ИтогоКапКОплатеЗаМесяц		= 0;
		ИтогоКапЗакрытиеВхДолга		= 0;
		
		// Кэш итогов кап. ремонта, для корректировки.
		ТабПечатиКап = мТаблицаПечати.Скопировать(Новый Структура("ГрафаОтчетаГЦЖС", ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт")));
		Если ТабПечатиКап.Количество() > 0 Тогда
			ИтогоКапКОплате = ТабПечатиКап.Итог("КОплате");
			ИтогоКапКОплатеЗаМесяц = ТабПечатиКап.Итог("КОплатеЗаМесяц");
			ИтогоКапЗакрытиеВхДолга = ТабПечатиКап.Итог("ЗакрытиеВхДолга");
		КонецЕсли;
		
		мСтруктураДанных.ПереплатаНаНачало = мСтруктураДанных.ПереплатаНаНачало + мСтруктураДанных.Оплата;
		ОбластьЗаголовок.Параметры.Заполнить(мСтруктураДанных);
		Квитанция.Вывести(ОбластьЗаголовок);
		
		// ОбластьШапка.
		ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
		ОбластьШапка.Параметры.Заполнить(мКэшПолучателяПлатежа);
		Организация_1 = "";
		Организация_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательПредставление, 59, Организация_1 , Организация_2 );
		ЗаполнитьПараметр(ОбластьШапка, "Организация_1", Организация_1);
		ЗаполнитьПараметр(ОбластьШапка, "Организация_2", Организация_2);
		АдресОрганизация_1 = "";
		АдресОрганизация_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательАдрес, 65, АдресОрганизация_1 , АдресОрганизация_2 );
		ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизация_1", АдресОрганизация_1);
		ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизация_2", АдресОрганизация_2);
		ДопИнформацияОрганизация_1 = "";
		ДопИнформацияОрганизация_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательДопИнформация, 20, ДопИнформацияОрганизация_1 , ДопИнформацияОрганизация_2);
		ЗаполнитьПараметр(ОбластьШапка, "ДопИнформацияОрганизация_1", ДопИнформацияОрганизация_1);
		ЗаполнитьПараметр(ОбластьШапка, "ДопИнформацияОрганизация_2", ДопИнформацияОрганизация_2);
		Квитанция.Вывести(ОбластьШапка);
		
		// ОбластьРаздел2Шапка.
		ТабДокуРаздел2 = Новый ТабличныйДокумент;
		ТабДокуРаздел2.Вывести(ОбластьРаздел2Шапка);

		// ОбластьРаздел2Строка.
		Если ПолучательПлатежа924 Тогда
			
			ТабПечатиПолучатели = мТаблицаПечати.Скопировать(,
			"ПолучательПлатежа, ПолучательПлатежаИмя,ПолучательИНН,ПолучательКПП,ПолучательРС,ПолучательКоррСчет,ПолучательБИК,ПолучательБанк");
			
			ТабПечатиПолучатели.Свернуть("ПолучательПлатежа, ПолучательПлатежаИмя,ПолучательИНН,ПолучательКПП,ПолучательРС,ПолучательКоррСчет,ПолучательБИК,ПолучательБанк");
			
			Для Каждого Стр Из ТабПечатиПолучатели Цикл	// Обход Получателей.
				МассивУслугиПоставщика =  мТаблицаПечати.НайтиСтроки(Новый Структура("ПолучательПлатежа",Стр.ПолучательПлатежа));
				
				ОбластьРаздел2Строка.Параметры.ПолучательПлатежа = Стр.ПолучательПлатежаИмя;
				
				ТекстПолучательСчет = "";
				Если ЗначениеЗаполнено(Стр.ПолучательРС)
					ИЛИ ЗначениеЗаполнено(Стр.ПолучательИНН)
					ИЛИ ЗначениеЗаполнено(Стр.ПолучательКПП)
					ИЛИ ЗначениеЗаполнено(Стр.ПолучательБанк)
					ИЛИ ЗначениеЗаполнено(Стр.ПолучательКоррСчет)
					ИЛИ ЗначениеЗаполнено(Стр.ПолучательБИК) Тогда
					
					ТекстПолучательСчет = НСтр("ru='р/с: %1 ИНН: %2 КПП: %3
					|Банк: %4
					|Корр.счет.\БИК: %5'");
					
					ТекстПолучательСчет = СтрШаблон(ТекстПолучательСчет,
													Стр.ПолучательРС,
													Стр.ПолучательИНН,
													Стр.ПолучательКПП,
													Стр.ПолучательБанк,
													Стр.ПолучательКоррСчет + " \ " + Стр.ПолучательБИК);
					
				КонецЕсли;
				
				ОбластьРаздел2Строка.Параметры.ПолучательСчет = ТекстПолучательСчет;
				ОбластьРаздел2Строка.Параметры.ЛицевойСчет = Строка(мСтруктураДанных.ЛицевойСчет); 
				
				КОплатеЗаМесяц = 0;
				ВидУслуги	   = "";
				
				Для Каждого СтрУслуга Из МассивУслугиПоставщика Цикл	// Группировка  услуг поставщиков.
					Если СтрУслуга.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт") Тогда
						Продолжить;
					КонецЕсли;
					КОплатеЗаМесяц = КОплатеЗаМесяц + СтрУслуга.КОплатеЗаМесяц;
					ВидУслуги = ?(ПустаяСтрока(ВидУслуги),ВидУслуги, ВидУслуги + ", ") + Строка(СтрУслуга.УслугаПредставление);  
				КонецЦикла;
				ОбластьРаздел2Строка.Параметры.ВидУслуги	  = ВидУслуги;
				ОбластьРаздел2Строка.Параметры.КОплатеЗаМесяц = Формат(КОплатеЗаМесяц, "ЧДЦ=2; ЧН=0,00");
				
				Если НеПечататьУслугиБезНачислений
					И КОплатеЗаМесяц = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Стр.ПолучательБИК) И ЗначениеЗаполнено(Стр.ПолучательРС) Тогда
					НовыйПлучатель = ТаблицаПлатежиГИСЖКХ12Получатели.Добавить();
					НовыйПлучатель.ПолучательПлатежа = Стр.ПолучательПлатежа;
					НовыйПлучатель.БИКБанка			 = Стр.ПолучательБИК;
					НовыйПлучатель.РасчетныйСчет	 = Стр.ПолучательРС;
					НовыйПлучатель.КОплатеЗаМесяц	 = Стр.КОплатеЗаМесяц;
				КонецЕсли;
				
				ТабДокуРаздел2.Вывести(ОбластьРаздел2Строка);
			КонецЦикла;
			
		Иначе
				ТекстПолучательСчет = НСтр("ru='р/с: %1 ИНН: %2 КПП: %3
				|Банк: %4
				|Корр.счет.\БИК: %5'");
				ТекстПолучательСчет = СтрШаблон(ТекстПолучательСчет,
												мСтруктураДанных.ПолучательРС,
												мСтруктураДанных.ПолучательИНН,
												мСтруктураДанных.ПолучательКПП,
												мСтруктураДанных.ПолучательБанк,
												мСтруктураДанных.ПолучательКоррСчет2 + " \ " + мСтруктураДанных.ПолучательБИК);
				
				ОбластьРаздел2Строка.Параметры.ПолучательПлатежа	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ПолучательПлатежа,"Наименование");
				ОбластьРаздел2Строка.Параметры.ПолучательСчет		= ТекстПолучательСчет;
				ОбластьРаздел2Строка.Параметры.ЛицевойСчет			= Строка(мСтруктураДанных.ЛицевойСчет); 
				ОбластьРаздел2Строка.Параметры.КОплатеЗаМесяц		= Формат(мСтруктураДанных.КОплатеЗаМесяц - ИтогоКапКОплатеЗаМесяц, "ЧДЦ=2; ЧН=0,00");
				
				Если ЗначениеЗаполнено(мСтруктураДанных.ПолучательБИК) И ЗначениеЗаполнено(мСтруктураДанных.ПолучательРС) Тогда
					НовыйПлучатель						= ТаблицаПлатежиГИСЖКХ12Получатели.Добавить();
					НовыйПлучатель.ПолучательПлатежа	= ЭтотОбъект.ПолучательПлатежа;
					НовыйПлучатель.БИКБанка				= мСтруктураДанных.ПолучательБИК;
					НовыйПлучатель.РасчетныйСчет		= мСтруктураДанных.ПолучательРС;
					НовыйПлучатель.КОплатеЗаМесяц		= мСтруктураДанных.КОплатеЗаМесяц - ИтогоКапКОплатеЗаМесяц;
				КонецЕсли;
				
				ТабДокуРаздел2.Вывести(ОбластьРаздел2Строка);
		КонецЕсли; //ПолучательПлатежа924.
		
		// ОбластьРаздел2Итог.
		ОбластьРаздел2Итог.Параметры.Заполнить(мСтруктураДанных);
		ОбластьРаздел2Итог.Параметры.ДатаПоследнейОплаты = мСтруктураДанных.ДатаПоследнейОплатыНеКапРем;
		ОбластьРаздел2Итог.Параметры.Коплате = мСтруктураДанных.Коплате - ИтогоКапКОплате;	// Корректировка итогов за вычетом кап ремонта.
		
		Если мСтруктураДанных.Сальдо > 0 Тогда
			ОбластьРаздел2Итог.Параметры.Авансы = 0;
			ОбластьРаздел2Итог.Параметры.Долг	= мСтруктураДанных.Сальдо;
		ИначеЕсли мСтруктураДанных.Сальдо < 0 Тогда
			ОбластьРаздел2Итог.Параметры.Авансы = -мСтруктураДанных.Сальдо;
			ОбластьРаздел2Итог.Параметры.Долг	= 0;
		Иначе
			ОбластьРаздел2Итог.Параметры.Авансы = 0;
			ОбластьРаздел2Итог.Параметры.Долг	= 0;
		КонецЕсли;
		
		Если ИтогоКапЗакрытиеВхДолга <> 0 Тогда
			Долг	= 0;
			Авансы	= 0;
			Если мСтруктураДанных.Сальдо > 0 Тогда
				Долг = мСтруктураДанных.Сальдо - ИтогоКапЗакрытиеВхДолга;
			ИначеЕсли мСтруктураДанных.Сальдо < 0 Тогда
				Авансы = -мСтруктураДанных.Сальдо + ИтогоКапЗакрытиеВхДолга;
			КонецЕсли;
			
			Если Долг > 0 Тогда
				ОбластьРаздел2Итог.Параметры.Долг = Долг;
				ОбластьРаздел2Итог.Параметры.Авансы = 0;
			ИначеЕсли Авансы > 0 Тогда
				ОбластьРаздел2Итог.Параметры.Долг = 0;
				ОбластьРаздел2Итог.Параметры.Авансы = Авансы;
			КонецЕсли;
		КонецЕсли; 
	
		ТабДокуРаздел2.Вывести(ОбластьРаздел2Итог);
		
		Квитанция.Присоединить(ТабДокуРаздел2);
		
		// ОбластьРаздел34Шапка.
		Квитанция.Вывести(ОбластьРаздел34Шапка);
		
		// Строки Раздел34.
		ТабДокСодержаниеРемонтУсл = Новый ТабличныйДокумент;
		ТабДокСодержаниеРемонтУсл.Вывести(ОбластьСтрокаГрСодержание);
		
		ТабДокКоммунальныеУсл = Новый ТабличныйДокумент;
		ТабДокКоммунальныеУсл.Вывести(ОбластьСтрокаГрКоммунальные);
		
		ТабДокПрочиеУсл	= Новый ТабличныйДокумент;
		ТабДокПрочиеУсл.Вывести(ОбластьСтрокаГрПрочие);
		
		Для каждого СтрокаПечати Из мТаблицаПечати Цикл
			
			Если НеПечататьУслугиБезНачислений(СтрокаПечати) Тогда
				Продолжить;
			КонецЕсли;
			
			Если НЕ СтрокаПечати.ОбщедомовыеНачисления Тогда
				
				СтрокаПечати.ОбъемИнд = СтрокаПечати.ОбъемИнд + СтрокаПечати.ОбъемОбщДом;
				СтрокаПечати.ОбъемОбщДом = 0;
				
				СтрокаПечати.НачисленоИнд = СтрокаПечати.НачисленоИнд + СтрокаПечати.НачисленоОбщДом;
				СтрокаПечати.НачисленоОбщДом = 0;
				
				СтрокаПечати.ИтогоОбъемИнд = СтрокаПечати.ИтогоОбъемИнд + СтрокаПечати.ИтогоОбъемОбщедомовых;
				СтрокаПечати.ИтогоОбъемОбщедомовых = 0;
				
			КонецЕсли;
			
			ОбластьСтрока.Параметры.Заполнить(СтрокаПечати);
			
			Если НЕ (мТаблицаПлатежиГИСЖКХ36 = Неопределено
				ИЛИ мТаблицаПлатежиГИСЖКХДПД = Неопределено) Тогда
				ЗаполнитьТаблицаПлатежиГИСЖКХ36(мСтруктураДанных.ЛицевойСчет, СтрокаПечати);
				ЗаполнитьТаблицаПлатежиГИСЖКХДПД(мСтруктураДанных.ЛицевойСчет, СтрокаПечати);
			КонецЕсли;
			
			Если СтрокаПечати.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт") Тогда
				
				Если СтрокаПечати.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт") Тогда
					ОбновитьТаблицаПлатежиГИСЖКХ12Получатели(ТаблицаПлатежиГИСЖКХ12Получатели, СтрокаПечати);
				КонецЕсли;
				
				Продолжить;
			ИначеЕсли СтрокаПечати.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.Техобслуживание")
				ИЛИ СтрокаПечати.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.ПлатаЗаНайм") Тогда
				
				ТабДокСодержаниеРемонтУсл.Вывести(ОбластьСтрока);
			ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаПечати.ГрафаОтчетаГЦЖС) Тогда	
				
				ТабДокПрочиеУсл.Вывести(ОбластьСтрока);
			Иначе 
				
				ТабДокКоммунальныеУсл.Вывести(ОбластьСтрока);
			КонецЕсли;
			
		КонецЦикла; 
		
		Если ТабДокСодержаниеРемонтУсл.ВысотаТаблицы > 1 Тогда
			Квитанция.Вывести(ТабДокСодержаниеРемонтУсл);
		КонецЕсли;
		Если  ТабДокКоммунальныеУсл.ВысотаТаблицы > 1 Тогда
			Квитанция.Вывести(ТабДокКоммунальныеУсл);
		КонецЕсли;
		Если ТабДокПрочиеУсл.ВысотаТаблицы > 1 Тогда
			Квитанция.Вывести(ТабДокПрочиеУсл);
		КонецЕсли;
		
		ОбластьИтог.Параметры.Заполнить(мСтруктураДанных);
		ОбластьИтог.Параметры.КОплатеЗаМесяц = мСтруктураДанных.КОплатеЗаМесяц - ИтогоКапКОплатеЗаМесяц;	// Корректировка итогов за вычетом кап ремонта.
		
		Квитанция.Вывести(ОбластьИтог);
		Квитанция.Вывести(ОбластьУказания);
		
		// ОбластьРаздел5.
		ТабДокуРаздел5 = Неопределено;
