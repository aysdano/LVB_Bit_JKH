Функция ВыбратьГрупповыеСчетчикиИзЗапросаНаСервере(Услуга)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата"	, ТекущаяДата());
	Запрос.УстановитьПараметр("Здание"	, Объект.Здание);
	Запрос.УстановитьПараметр("Услуга"	, Услуга);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик КАК Групповой
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Объект = &Здание
	|				И Услуга = &Услуга
	|				И ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)) КАК бит_СчетчикиНаУслугахСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Использовать = ИСТИНА";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат  Истина;
	Иначе
		Возврат  Ложь;
	КонецЕсли;
	
КонецФункции

