	СтрокаПараметров = СтрокаПараметров + "&params=" + ПараметрыОрганизации;
	
	СтрокаПараметров = СтрокаПараметров + "&source_tenantname="+Строка("testbit");
	
	ЖурналЗапросБезКодировки = ЖурналЗапросБезКодировки + "&source_tenantname="+Строка("testbit");
	
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаПараметров, КодировкаТекста.UTF8);
	
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");  
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Bearer "+Строка(Ключ));  
	
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		Сообщить("Ошибка при отправке запроса: " + ОписаниеОшибки());
	КонецПопытки;
	
	Если Ответ.КодСостояния = 200 Тогда
		СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		
		Если Не ПустаяСтрока(СтрокаОтвет) Тогда
			
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(СтрокаОтвет);
			ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
			ЧтениеJSON.Закрыть();
			
			СоздатьНастройкиОрганизации(ЗагруженныеДанные,Организация);
			
			РезультатПроверки = СтрокаОтвет;
			Результат = РезультатПроверки;
			// Сообщить(Результат);
		КонецЕсли;
	Иначе
		ЖурналСтрокаОписанияОшибки = ОписаниеОшибки();
		// Журнал
		ИмяСобытияВЖурнал = "Клонирование тенанта";
		КодСостояния = Ответ.КодСостояния;
		СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();;
		Если Найти(СтрокаОтвета,"We found that DB is exist. Please, set another tenantname.") Тогда
			Сообщить("Приложение зарегистрированное на ИНН: "+СТрока(Объект.Организация.ИНН)+" уже существует. Обратитесь к разработчикам");
		КонецЕсли;	
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
		Возврат Ложь;	
	КонецЕсли;
	
	// // Журнал
	// ИмяСобытияВЖурнал = "Клонирование тенанта";
	// КодСостояния = Ответ.КодСостояния;
	// СтрокаОтвета = Ответ.ПолучитьТелоКакСтроку();;	
	// МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало,ТекущаяДатаСеанса(),Неопределено);	
	Возврат Истина;
КонецФункции

&НаСервере
Функция УбратьНенужныеСимволы(Элемент, Символ="")
	Перем Результат;
	Результат=Строка(Элемент);
	
	Результат = СтрЗаменить(Результат,Символы.Нпп,Символ);
	Результат = СтрЗаменить(Результат,"/",Символ);
	Результат = СтрЗаменить(Результат,"\",Символ);
	Результат = СтрЗаменить(Результат,".",Символ);
	Результат = СтрЗаменить(Результат,",",Символ);
	// Результат = СтрЗаменить(Результат,"+",Символ);
	Результат = СтрЗаменить(Результат,"-",Символ);
	Результат = СтрЗаменить(Результат,"!",Символ);
	Результат = СтрЗаменить(Результат,"@",Символ);
	Результат = СтрЗаменить(Результат,"#",Символ); 
	Результат = СтрЗаменить(Результат,"$",Символ);
	Результат = СтрЗаменить(Результат,"%",Символ);
	Результат = СтрЗаменить(Результат,"^",Символ);
	Результат = СтрЗаменить(Результат,"&",Символ);
	Результат = СтрЗаменить(Результат,"*",Символ);
	Результат = СтрЗаменить(Результат,"(",Символ);
	Результат = СтрЗаменить(Результат,")",Символ);
	Результат = СтрЗаменить(Результат,"№",Символ);
	Результат = СтрЗаменить(Результат,";",Символ);
	Результат = СтрЗаменить(Результат,":",Символ);
	Результат = СтрЗаменить(Результат,"?",Символ);
	Результат = СтрЗаменить(Результат," ",Символ);
	Возврат Результат;
	ТекНомерТелефона="";счетчик=0;ПервоеВхождение=ложь;
	Для Индекс = 1 По СтрДлина(Результат) Цикл
		Символ = Сред(Результат, Индекс, 1); 
		Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда //  Код нуля - 48, код 9-ки - 57
			// ТекНомерТелефона = ТекНомерТелефона + Символ;
			Если Символ="9" и ПервоеВхождение=ложь Тогда
				ПервоеВхождение=Истина;
				
			КонецЕсли;
			Если ПервоеВхождение  Тогда
				ТекНомерТелефона = ТекНомерТелефона + Символ;
				Счетчик=Счетчик+1;
			КонецЕсли;
			Если Счетчик=10 Тогда
				ТекНомерТелефона="+7"+ТекНомерТелефона;
				Возврат ТекНомерТелефона;
			КонецЕсли;
			
		ИначеЕсли СтрДлина(ТекНомерТелефона) > 0 Тогда
			// ТекНомерТелефона = "";
		КонецЕсли;
	КонецЦикла;
КонецФункции

&НаСервере
Процедура СоздатьНастройкиОрганизации(ЗагруженныеДанные,Организация);
	
	tenantname = ЗагруженныеДанные["data"][0]["attributes"]["tenantname"];
	servername = ЗагруженныеДанные["data"][0]["attributes"]["servername"];
	url        = ЗагруженныеДанные["data"][0]["attributes"]["url"];
	url        = СтрЗаменить(url,"https://","");
	key1       = ЗагруженныеДанные["data"][0]["attributes"]["api"]["key1"];
	key2       = ЗагруженныеДанные["data"][0]["attributes"]["api"]["key2"];
	
	Логин      = ЗагруженныеДанные["data"][0]["attributes"]["authentication"]["email"];
	Пароль     = ЗагруженныеДанные["data"][0]["attributes"]["authentication"]["password"];
	
	ДанныеДляПарсера = Строка(key1)+":"+Строка(key2); // КодироватьСтроку(
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла();
	ЗаписьТекста = Новый ЗаписьТекста(ИмяВременногоФайла,"CESU-8");
	ЗаписьТекста.Записать(ДанныеДляПарсера);
	ЗаписьТекста.Закрыть();
	
	СтрокаТокен = Новый ДвоичныеДанные(ИмяВременногоФайла);
	Токен = Base64Строка(СтрокаТокен);
	Токен = СтрЗаменить(Токен,"¶","");
	Токен = СтрЗаменить(Токен,Символ(10),"");
	Токен = СтрЗаменить(Токен,Символ(13),"");
	УдалитьФайлы(ИмяВременногоФайла);
	
	Нов = Объект;
	Нов.АдресКабинетов                   = url;
	Нов.НомерПриложения                  = 717;
	Нов.Токен                            = Токен;
	Нов.Логин                            = Логин;
	Нов.Пароль                           = Пароль;
	
	Записать();
	
	Константы.МЛК_ИспользоватьИнтеграциюСМобильнымиЛичнымиКабинетами.Установить(Истина);
	
	// потом нужно получить и записать СТАТУСЫ
	ЕстьОтвет = Истина;
	
	АдресСервисаСтр = СокрЛП(Нов.АдресКабинетов);
	АдресРесурса = "/api/v4/statuses?ApplicationId="+Нов.НомерПриложения;
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Нов.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		Сообщить("Ошибка при отправке запроса: " + ОписаниеОшибки());
		ЕстьОтвет = Ложь;
	КонецПопытки;
	
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				Если СокрЛП(РезультатПроверки)="false" Тогда
					// Сообщить("Соединение не установлено");
				Иначе
					
					
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
					ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
					ЧтениеJSON.Закрыть();
					
					ТЗ = РаспарситьСтатусы(ЗагруженныеДанные);
					
					Для Каждого СтрСтатус Из ТЗ Цикл
						Если Найти(нрег(СтрСтатус.Статус),"закрыт")<>0 или  Найти(нрег(СтрСтатус.Статус),"выполнено")<>0 Тогда
							Нов.СтатусЗакрыто = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"отклонен")<>0 Тогда
							Нов.СтатусОтклонено = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"обработан")<>0 Тогда
							Нов.СтатусОбработано = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"работе")<>0 Тогда
							Нов.СтатусВРаботе = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"отправлено в ук")<>0 Тогда
							Нов.СтатусОтправленоВУК = СтрСтатус.Ид_Статуса;
						КонецЕсли;	
					КонецЦикла;	
				КонецЕсли;
			КонецЕсли;
		Иначе
			
		КонецЕсли;
	КонецЕсли;	
	Записать();
	
КонецПроцедуры

&НаСервере
Функция РаспарситьСтатусы(Данные)	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Статус");
	ТЗ.Колонки.Добавить("ИД_Статуса");
	
	Для Каждого стр из Данные Цикл
		
		Нов = ТЗ.Добавить();
		
		Нов.Статус            = Стр["Name"];
		Нов.ИД_Статуса    = Стр["id"];       // ИД события по которому будем менять статус
		Нов.ИД_Статуса    = СтрЗаменить(СокрЛП(Нов.ИД_Статуса),Символы.НПП,"");
	КонецЦикла;	
	
	Возврат ТЗ;
	
	
КонецФункции

