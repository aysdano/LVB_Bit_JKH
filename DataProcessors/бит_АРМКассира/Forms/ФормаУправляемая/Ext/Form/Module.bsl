&НаСервере
Процедура ОтветсвенноеЛицоПриИзмененииНаСервере()
	
	Если ЗначениеЗаполнено(ОтветсвенноеЛицо) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
		|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Наименование КАК ЛицевойСчет
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
		|			&Дата,
		|			ФизЛицо = &Физлицо
		|				И СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)) КАК бит_ПроживающиеПоЛССрезПоследних";
		
		
		Запрос.УстановитьПараметр("Дата"    , КонецДня(ТекущаяДата()));
		Запрос.УстановитьПараметр("ФизЛицо" , ОтветсвенноеЛицо);
		
		Если Запрос.Выполнить().Пустой() Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "По данному Ответсвенному лицу не найдело лицевых счетов!";
			Сообщение.Сообщить();
			
		Иначе
			
			Результат = Запрос.Выполнить().Выгрузить();
			МасивЛС   = Результат.ВыгрузитьКолонку("ЛицевойСчет");
			
			СпискоЛС  = Новый СписокЗначений;
			СпискоЛС.ЗагрузитьЗначения(МасивЛС);
			
			ЛицевыеСчета.Отбор.Элементы.очистить();
			
			Эл = ЛицевыеСчета.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			
			Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Наименование");
			Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.ВСписке;
			Эл.ПравоеЗначение   = СпискоЛС;
			Эл.Использование    = ?(ЗначениеЗаполнено(СпискоЛС),Истина,Ложь);
			
			Если Эл.Использование Тогда
				
				Эл.ПравоеЗначение      = СпискоЛС;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЕсли;		
КонецПроцедуры

&НаКлиенте
Процедура ОтветсвенноеЛицоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	мСписокФизЛиц = ОтветсвенноеЛицоНачалоВыбораНаСервере();
	
	Элементы.ОтветсвенноеЛицо.СписокВыбора.ЗагрузитьЗначения(мСписокФизЛиц);
	
КонецПроцедуры

&НаСервере
Функция ОтветсвенноеЛицоНачалоВыбораНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	МАКСИМУМ(бит_ПроживающиеПоЛССрезПоследних.Период) КАК Период,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица <> &Удален
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизЛицо";
	Запрос.УстановитьПараметр("Дата"    , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Удален"    , ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан"));
	
	Если Запрос.Выполнить().Пустой() Тогда
		
	Иначе
		
		Результат = Запрос.Выполнить().Выгрузить();
		Результат.Сортировать("ЛицевойСчет Возр");
		
		Масив   = Результат.ВыгрузитьКолонку("ФизЛицо");
		
		мСписокФизЛиц  = Новый СписокЗначений;
		мСписокФизЛиц.ЗагрузитьЗначения(Масив);
		
	КонецЕсли; 
	
	Возврат Масив;
	
КонецФункции

