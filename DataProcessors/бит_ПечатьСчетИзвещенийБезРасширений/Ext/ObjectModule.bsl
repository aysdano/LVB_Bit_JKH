Функция ДолгРФКР(Услуга,ЛицевойСчет,Дата);
	
	//Период = КонецДня(КонецМесяца(Дата)); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕстьNull(бит_НачисленияПоУслугамЖКХОстатки.СуммаКонечныйОстаток,0) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|			,
	|			КОНЕЦПЕРИОДА(&Период, МЕСЯЦ),
	|			,
	|			,
	|			УслугаЖКХ = &Услуга
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
