	         |				ТОГДА ВТ1.СуммаОплачено
	         |			ИНАЧЕ 0
	         |		КОНЕЦ + ВЫБОР
	         |			КОГДА ВТ1.УслугаЖКХ = &ГВ
	         |				ТОГДА ВТ1.СуммаОплачено
	         |			ИНАЧЕ 0
	         |		КОНЕЦ + ВЫБОР
	         |			КОГДА ВТ1.УслугаЖКХ = &ВО
	         |				ТОГДА ВТ1.СуммаОплачено
	         |			ИНАЧЕ 0
	         |		КОНЕЦ + ВЫБОР
	         |			КОГДА ВТ1.УслугаЖКХ = &ЭЛ
	         |				ТОГДА ВТ1.СуммаОплачено
	         |			ИНАЧЕ 0
	         |		КОНЕЦ) КАК СуммаОплатОДН
	         |ИЗ
	         |	ВТ1 КАК ВТ1
	         |
	         |СГРУППИРОВАТЬ ПО
	         |	ВТ1.ЛицевойСчет,
	         |	ВТ1.ПериодОплаты,
	         |	ВЫБОР
	         |		КОГДА ВТ1.ЭтоИсполнительныйЛист
	         |			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
	         |		ИНАЧЕ ВТ1.ПериодОплатыОмск
	         |	КОНЕЦ,
	         |	ВТ1.РегистраторДата,
	         |	ВТ1.ЭтоИсполнительныйЛист,
	         |	ВТ1.РегистраторНомер,
	         |	ВТ1.НомерСтрокиВОплатаКУ,
	         |	ВТ1.ДатаИсполнительногоЛистаОт,
	         |	ВТ1.ДатаИсполнительногоЛистаПо,
	         |	ВТ1.ЭтоБухСправка
	         |
	         |УПОРЯДОЧИТЬ ПО
	         |	ДатаОплаты,
	         |	ПериодОплаты,
	         |	СуммаОплатОДН УБЫВ,
	         |	СуммаОплачено УБЫВ";
	
КонецФункции

