&НаСервере
Процедура ж_ДополнитьЗданияВОтборЛСНаСервере()
	// Вставить содержимое обработчика.
	ЧислоСтрок = Объект.ПерезагружаемыеЛС.Количество();
	Табл = ЭтаФорма.Объект.ПерезагружаемыеЛС.Выгрузить();
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("Т",Табл);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Т.ЛС КАК Справочник.бит_ЛицевыеСчета) КАК ЛС,
		|	ВЫРАЗИТЬ(Т.Здание КАК Справочник.бит_СписокЗданий) КАК Здание
		|ПОМЕСТИТЬ Табл
		|ИЗ
		|	&Т КАК Т
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВлЗапрос.ЛС КАК ЛС,
		|	ВлЗапрос.Здание КАК Здание
		|ИЗ
		|	(ВЫБРАТЬ
		|		Табл.ЛС КАК ЛС,
		|		Табл.ЛС.Здание КАК Здание
		|	ИЗ
		|		Табл КАК Табл
		|	ГДЕ
		|		Табл.ЛС <> ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.Пустаяссылка)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		бит_ЛицевыеСчета.Ссылка,
		|		Табл.Здание
		|	ИЗ
		|		Табл КАК Табл
		|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|			ПО Табл.Здание = бит_ЛицевыеСчета.Здание
		|				И (Табл.ЛС = ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.Пустаяссылка))) КАК ВлЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВлЗапрос.ЛС,
		|	ВлЗапрос.Здание";
	Табл = Запрос.Выполнить().Выгрузить();
	ЭтаФорма.Объект.ПерезагружаемыеЛС.Загрузить(Табл);
		
КонецПроцедуры

