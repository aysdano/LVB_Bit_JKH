
#Область РаботаСКэшемРеквизитовФормы

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	Документ       = Метаданные.Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ;
	ПравоИзменения = ПравоДоступа("Изменение", Документ);
	
	КэшированныеЗначения = Новый Структура;
	
	// Перечисления.
	КэшПеречисления = Новый Структура;
	КэшПеречисления.Вставить("бит_ВидыОпераций"            			, бит_ОбщегоНазначения.КэшироватьЗначенияПеречисления(Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ));
	КэшПеречисления.Вставить("бит_ВариантыИзмененияМестаПребывания" , бит_ОбщегоНазначения.КэшироватьЗначенияПеречисления(Перечисления.бит_ВариантыИзмененияМестаПребывания));
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	КэшированныеЗначения.Вставить("ПравоИзменения"      , ПравоИзменения);
	КэшированныеЗначения.Вставить("Перечисления"        , КэшПеречисления);
	
	КэшированныеЗначения.Вставить("ОткудаПрибылПредставление", Неопределено);
	КэшированныеЗначения.Вставить("КудаВыписанПредставление", Неопределено);
	
	ПодчиненныйДокумент = НайтиПодчиненныйДокумент(Объект.Ссылка);
	КэшированныеЗначения.Вставить("ПодчиненныйДокумент", ПодчиненныйДокумент);
	
	ПодчиненныйДокументПроживание = НайтиПодчиненныйДокументПроживание(Объект.Ссылка);
	КэшированныеЗначения.Вставить("ПодчиненныйДокументПроживание", ПодчиненныйДокументПроживание);
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , Строка(""));
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	// КЭШ Виды опреации.
	РегистрацияПМЖ = Объект.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства;
	РегистрацияПМП = Объект.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуПребывания;
	СнятиеСРег     = Объект.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета;
	СнятиеПоСмерти = Объект.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеВСвязиСоСмертью;
	
	// КЭШ Варианты изменения места пребывания.
	ДругаяПричина         = Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.ДругаяПричина;
	ВТомЖеГородеСДрАдреса = Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.ВТомЖеГородеСДругогоАдреса;
	СДругогоГорода        = Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СДругогоГорода;
	СменаПаспорта         = Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаПаспорта;
	СменаФамилии          = Объект.ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаФамилии;
	
	// Управление видимостью элементов.
	Элементы.ДатаРегистрации.Видимость        = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ДатаСнятияСРегистрации.Доступность = СнятиеСРег ИЛИ РегистрацияПМП ИЛИ СнятиеПоСмерти;
	
	Элементы.РегистрируемоеЛицо.Видимость = НЕ СнятиеСРег;
	Элементы.РешениеСуда.Видимость = СнятиеСРег;
	Элементы.ВременнаяРегистрация.Видимость = СнятиеСРег Или СнятиеПоСмерти;
	Элементы.ПравоустанавливающиеДокументы.Видимость = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ОтветственныеЗаРегистрацию.Видимость = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.СнимаемыеСРегУчета.Видимость = СнятиеСРег;
	Элементы.ПринятоеРешение.Видимость   = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ОткудаПрибыл.Видимость      = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.СнимаемыеСРегУчетаПроживающий.КнопкаСоздания = Ложь;
	
	Элементы.ГруппаКудаВыписан.Видимость = СнятиеСРег;
	
	Если  СнятиеСРег  ИЛИ СнятиеПоСмерти Тогда
		Элементы.ОрганФМС.Заголовок = "Орган ФМС выбытия";	
	Иначе
		Элементы.ОрганФМС.Заголовок = "Орган ФМС откуда прибыл";
	КонецЕсли;
	
	// Установка видимости кнопок печати.
	Элементы.ФормаПечатьЗОССРУПМЖ.Видимость = РегистрацияПМЖ;
	
	Элементы.ФормаПечатьЗОССРУПМЖ_2часть.Видимость       = РегистрацияПМЖ ИЛИ СнятиеСРег;
	Элементы.ФормаПечатьАЛП.Видимость             = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ФормаПечатьЛСУП.Видимость            = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ФормаПечатьКР.Видимость              = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ФормаПечатьСОРГ_РФ_ПМЖ.Видимость     = РегистрацияПМЖ;
	Элементы.ФормаПечатьСОРГ_РФ_ПМЖ_Old.Видимость = РегистрацияПМЖ;
	Элементы.ФормаПечатьАЛП_стар.Видимость        = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ФормаПечатьЗОРПМЖ.Видимость          = РегистрацияПМП;
	Элементы.ФормаПечатьАнкета.Видимость          = РегистрацияПМП;
	
	Элементы.ФормаПечатьЗаявлениеРФ1.Видимость  = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ФормаПечатьЗаявлениеРФ2.Видимость  = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ФормаПечатьЗаявлениеСНГ1.Видимость = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	Элементы.ФормаПечатьЗаявлениеСНГ2.Видимость = РегистрацияПМЖ ИЛИ РегистрацияПМП;
	
	Элементы.ФормаПечатьУВОРУ.Видимость    = СнятиеСРег;
	Элементы.ФормаПечатьАЛУ_стар.Видимость = СнятиеСРег;
	Элементы.ФормаПечатьСопроводительноеПисьмо.Видимость = СнятиеСРег;
	Элементы.ФормаПечатьАЛУ.Видимость  = РегистрацияПМЖ ИЛИ СнятиеСРег ИЛИ СнятиеПоСмерти;
	Элементы.ФормаПечатьЛСУВ.Видимость = РегистрацияПМЖ ИЛИ СнятиеСРег;
	
	Элементы.СвидетельствоОСмерти.Видимость  = СнятиеПоСмерти;
	Элементы.СменаФамилииНа.Видимость        = СменаФамилии;
	
	Элементы.ОрганФМСКудаПрибыл.Видимость                   = Не СнятиеПоСмерти;
	//	Элементы.ОтветственныйЗаРегистрацию.Видимость = Не СнятиеПоСмерти;
	
	Элементы.ПодборПроживающих.Видимость     = (РегистрацияПМЖ ИЛИ РегистрацияПМП);
	Элементы.УдостоверениеЛичности.Видимость = СменаПаспорта;
	
	Элементы.КонтактнаяИнформацияПолеОткудаПрибылПредставление.Доступность = НЕ Объект.ОткудаПрибылИзЛС;
	Элементы.КонтактнаяИнформацияПолеКудаВыписанПредставление.Доступность  = НЕ Объект.КудаВыписанИзЛС;
	
	Если мКэшЗначений.ПодчиненныйДокумент = Неопределено Тогда
		Элементы.ФормаСвПоМестуПребывания.Видимость = Ложь;
	Иначе
		Элементы.ФормаСвПоМестуПребывания.Видимость = Истина;
	КонецЕсли;
	
	Если мКэшЗначений.ПодчиненныйДокументПроживание = Неопределено Тогда
		Элементы.ФормаСвПоМестуПроживания.Видимость = Ложь;
	Иначе
		Элементы.ФормаСвПоМестуПроживания.Видимость = Истина;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	РазместитьКонтактнуюИнформацию();
	
	Отбор = Новый Структура();
	
	//Установить видимость реквизитов и заголовков колонок.
	УправлениеЭлементамиФормы();
	Адрес = ПолучитьУлицуЛицевогоСчета(Объект.ЛицевойСчет);
	ЭтаФорма.АдресЛицевойСчет = Адрес;
	
	// БИТ ЖКХ 14.01.2020
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды	
	// СтандартныеПодсистемы.Печать.
	//УправлениеПечатью.ПриСозданииНаСервере(ЭтаФорма, Элементы.ГруппаКнопок3);
	// Конец СтандартныеПодсистемы.Печать.
	
	Элементы.ГруппаКнопок3.Вид = ВидГруппыФормы.ГруппаКнопок;
	
	Массив = Новый Массив();
	Массив.Добавить(Тип("СправочникСсылка.бит_Проживающие"));
	ОписаниеТипаПроживающие = Новый ОписаниеТипов(Массив);
	Элементы.ФизическиеЛицаФизическоеЛицо.ОграничениеТипа = ОписаниеТипаПроживающие;
	
	
	//Автозаполнение ответственных за регистрацию из поля собственник	
	
	Если ПроверитьВозраст(Объект.РегистрируемоеЛицо) ИЛИ Объект.ЗаконныйПредставительВСвязиСНедееспособностью Тогда
		ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Истина;
		ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Истина;
		
	Иначе
		ЭтаФорма.Элементы.ЗаконныйПредставитель.Доступность = Ложь;
		ЭтаФорма.Элементы.СтепеньРодстваЗаконногоПредставителя.Доступность = Ложь;
		
		Объект.СтепеньРодстваЗаконногоПредставителя = Неопределено;
		Объект.ЗаконныйПредставитель = Неопределено;
	КонецЕсли;
	
	Если Объект.ОткудаПрибылИзЛС Тогда 
		ИзменитьОткудаПрибылИзЛС();
	КонецЕсли;
	Если Объект.КудаВыписанИзЛС Тогда
		ИзменитьКудаВыписанИзЛС();
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.РегистрируемоеЛицо) Тогда
		ЗаполнитьСвидетельствоОСмерти(Объект.РегистрируемоеЛицо);
		УстановитьДатуСнятия(Объект.ЛицевойСчет, Объект.РегистрируемоеЛицо);
		
		Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
			
			Проживающий =  Объект.РегистрируемоеЛицо;
			ДатаРегистрации =  ПолучитьДатуРегистрации(Объект.ЛицевойСчет, Объект.РегистрируемоеЛицо); 
			Объект.ДатаРегистрации = ДатаРегистрации;
			
			
			ТЗСнимаемыеСРег = Новый ТаблицаЗначений;
			ТЗСнимаемыеСРег.Колонки.Добавить("Проживающий");
			ТЗСнимаемыеСРег.Колонки.Добавить("ДатаРегистрации");
			
			СтрокаТЗ =  ТЗСнимаемыеСРег.Вставить(0);
			
			СтрокаТЗ.Проживающий = Проживающий;
			СтрокаТЗ.ДатаРегистрации = ДатаРегистрации;
			
			Объект.СнимаемыеСРегУчета.Загрузить(ТЗСнимаемыеСРег);
			Объект.РегистрируемоеЛицо = ТЗСнимаемыеСРег[0].Проживающий;
			
		КонецЕсли;
		
		
	Иначе
		
		Объект.СнимаемыеСРегУчета.Очистить();
		Объект.РегистрируемоеЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
		
	КонецЕсли;
	
	
КонецПроцедуры

