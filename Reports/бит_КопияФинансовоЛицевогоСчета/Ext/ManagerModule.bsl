// Функция получает таблицу проживающих.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьТаблицуПроживающих(Период, ЛицевойСчет, ИсторияПроживающих = Ложь)
	
	СписокПроживающих = Новый ТаблицаЗначений;
	
	СписокПроживающих.Колонки.Добавить("ФизЛицо"                      , Новый ОписаниеТипов("СправочникСсылка.бит_Проживающие"));
	СписокПроживающих.Колонки.Добавить("СтатусФизЛица"                , Новый ОписаниеТипов("СправочникСсылка.бит_СтатусФизЛица"));
	СписокПроживающих.Колонки.Добавить("СтепеньРодства"               , Новый ОписаниеТипов("СправочникСсылка.бит_СтепениРодстваФизЛиц"));
	СписокПроживающих.Колонки.Добавить("СтатусПроживания"             , Новый ОписаниеТипов("ПеречислениеСсылка.бит_СтатусПроживания"));
	СписокПроживающих.Колонки.Добавить("ДатаРегистрации"              , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	СписокПроживающих.Колонки.Добавить("ДатаСнятияСРегистрации"       , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	СписокПроживающих.Колонки.Добавить("ВладелецКвартиры"             , Новый ОписаниеТипов("ПеречислениеСсылка.ДаНет"));
	СписокПроживающих.Колонки.Добавить("ДоляПлощади"                  , ОбщегоНазначения.ОписаниеТипаЧисло(3,2));
	СписокПроживающих.Колонки.Добавить("ПравоустанавливающиеДокументы", Новый ОписаниеТипов("СправочникСсылка.бит_ПравоустанавливающиеДокументы")); 
	// БИТ_ЖКХ_25092013_начало_измерения
	СписокПроживающих.Колонки.Добавить("ДатаРождения"                 , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	// БИТ_ЖКХ_25092013_окончание_измерения
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , Период);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади,
	// БИТ_ЖКХ_25092013_начало_измерения
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	// БИТ_ЖКХ_25092013_окончание_измерения
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних";
	
	Если НЕ ИсторияПроживающих Тогда
		
		Запрос.Текст  = Запрос.Текст + " 
		|ГДЕ
		|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период
		|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
		
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = СписокПроживающих.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла;
	
	Возврат СписокПроживающих;
	
КонецФункции // ()

// Функция получает ответственного по лицевому счету.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ОтветственноеЛицоПоЛС(Период, ЛицевойСчет)
	
	Ответственный = Справочники.бит_Проживающие.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , Период);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Ответственный = Выборка.ФизЛицо;;
	КонецЕсли; 
	
	Возврат Ответственный;
	
КонецФункции // ()

// Функция получает таблицу правоустанавливающих документов.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьТаблицуПравоустанавливающихДокументов(Период, ЛицевойСчет)
	
	// БИТ_ЖКХ_22072013 изменен текст запроса
	// Добавлена проверка на статус "выписан" для правоустанавливающих документов.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы КАК НаименованиеДокумента,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы.НомерДокумента КАК НомерДокумента,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы.ДатаДокумента КАК ДатаДокумента,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы.ОрганизацияВыдавшаяДокумент КАК ОрганизацияВыдавшаяДокумент,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы.ВидДокумента КАК ПравоустанавливающиеДокументы,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И ПравоустанавливающиеДокументы <> ЗНАЧЕНИЕ(Справочник.бит_ПравоустанавливающиеДокументы.ПустаяСсылка)
	|				И СтатусФизЛица <> ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.Выписан)
	|				И ФизЛицо В
	|					(ВЫБРАТЬ
	|						бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|					ИЗ
	|						РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|					ГДЕ
	|						(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период
	|							ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)))) КАК бит_ПроживающиеПоЛССрезПоследних";
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Период"     , Период);
	
	ТаблицаСписокДокументов = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаСписокДокументов;
	
КонецФункции // ()

// Функция получает таблицу комнат.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьТаблицуКомнат(Период, Квартира)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_Комнаты.Наименование,
	|	ЕСТЬNULL(бит_СведенияОКомнатеСрезПоследних.Площадь, 0) КАК ПлощадьКомнаты,
	|	бит_Комнаты.ЧастьПомещения КАК Комната
	|ИЗ
	|	Справочник.бит_Комнаты КАК бит_Комнаты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКомнате.СрезПоследних(&Период, Комната.Владелец = &Квартира) КАК бит_СведенияОКомнатеСрезПоследних
	|		ПО (бит_СведенияОКомнатеСрезПоследних.Комната = бит_Комнаты.Ссылка)
	|ГДЕ
	|	бит_СведенияОКомнатеСрезПоследних.Комната.ЧастьПомещения.Принадлежность = ЗНАЧЕНИЕ(Перечисление.бит_ПринадлежностьКомнат.Внутренняя)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Комната";
	
	Запрос.УстановитьПараметр("Квартира", Квартира);
	Запрос.УстановитьПараметр("Период"  , Период);
	
	ТаблицаКомнат = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаКомнат;
	
КонецФункции // ()

// Функция получает таблицу информации о льготниках.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьТаблицуИнформацииОЛьготниках(Период, ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Льготы.ФизЛицо,
	|	Льготы.Льгота,
	|	Льготы.СрокДействияЛьготы,
	|	ФизЛица.СтатусФизЛица.НачислятьПоНорме КАК НачислятьПоНорме,
	|	ФизЛица.СтатусФизЛица.ПроживаниеВДанныйМомент КАК ПроживаниеВДанныйМомент,
	|	Льготы.Период,
	|	Льготы.ДокументНаЛьготуНаименование,
	|	Льготы.НомерДокумента,
	|	Льготы.ДатаВыдачи,
	|	Льготы.ДокументНаЛьготуНаименование + "" №"" + Льготы.НомерДокумента + "" выдан "" КАК ДокументНаЛьготу
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|		ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|		ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|		ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|		ПроживающиеПоЛССрезПоследних.ДатаЗаписи КАК ДатаЗаписи,
	|		ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|		ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации
	|	ИЗ
	|		РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиеПоЛССрезПоследних
	|	ГДЕ
	|		(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период
	|				ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))) КАК ФизЛица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_ЛьготыПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|			бит_ЛьготыПоЛССрезПоследних.Льготы КАК Льгота,
	|			бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы КАК СрокДействияЛьготы,
	|			бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу КАК ДокументНаЛьготу,
	|			бит_ЛьготыПоЛССрезПоследних.Период КАК Период,
	|			бит_ЛьготыПоЛССрезПоследних.НомерДокумента КАК НомерДокумента,
	|			бит_ЛьготыПоЛССрезПоследних.ДатаВыдачи КАК ДатаВыдачи,
	|			бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу.Наименование КАК ДокументНаЛьготуНаименование
	|		ИЗ
	|			РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК бит_ЛьготыПоЛССрезПоследних
	|		ГДЕ
	|			(бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы > &Период
	|					ИЛИ бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы = ДАТАВРЕМЯ(1, 1, 1))) КАК Льготы
	|		ПО ФизЛица.ФизЛицо = Льготы.ФизЛицо
	|ГДЕ
	|	ФизЛица.СтатусФизЛица.ПравоНаЛьготы = ИСТИНА";
	
	Запрос.УстановитьПараметр("Период"     , Период);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	ТаблицаЛьготников = Запрос.Выполнить().Выгрузить();
	
	Возврат ТаблицаЛьготников;
	
КонецФункции // ()

#КонецОбласти