	Объект.ТекущаяОрганизация = Элемент.ТекущиеДанные.Организация;
	Объект.ТекущаяСсылка = Элемент.ТекущиеДанные.Ссылка;
	
	НайтиКвартирыПоАдресуНаСервере();
  конецесли;	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКвартиры(Команда)
	
 если Элементы.СписокЗданий.ВыделенныеСтроки.Количество() = 0 тогда	
	Сообщить("Выберите здание в которых создаются квартиры и ЛС.");
	возврат;
 конецесли;		
	
 СоздатьЗданиеНаСервере();

 // одиночный выбор	
 если Элементы.СписокЗданий.ВыделенныеСтроки.Количество() = 1 тогда  	
		
  Объект.ПоследнийРассчитанныйНомерЛС = 0;
  если строка(Объект.ТекущаяУлица) <> "" тогда	
	
	  текущийНомерКвартиры = Объект.НомерПервойКвартиры;//НайтиПоследнийНомерКвартиры();
	  Объект.СписокКвартир.Очистить();
	  для НомерКвартиры = 1 по Объект.КолвоКвартир цикл
			
		  новыйКвартира = Объект.СписокКвартир.Добавить();	
		  новыйКвартира.Улица = Объект.ТекущаяУлица;
		  новыйКвартира.Дом = Объект.ТекущаяСсылка;
		  новыйКвартира.Корпус = Объект.ТекущийКорпус;
		  новыйКвартира.НомерКвартиры = текущийНомерКвартиры;    		  
		  новыйКвартира.ТипКвартиры = Объект.ТипКвартиры;
		  новыйКвартира.СтатусКвартиры = Объект.СтатусКвартиры; 		  
		  новыйКвартира.ЛицевойСчет = СформироватьНомерЛС(Объект.ТекущийДом, текущийНомерКвартиры, Объект.ПрефиксЛС, Объект.ПостфиксЛС, Объект.ДлинаЛС);
		  новыйКвартира.СтатусЛС = "Новый";
		  
		  текущийНомерКвартиры = текущийНомерКвартиры + 1;
			
	  конеццикла;	 
	  
	  Объект.СписокКвартир.Сортировать("Улица, Дом, Корпус, НомерКвартиры"); 	  
	  Объект.НомерПервойКвартиры = текущийНомерКвартиры;
  конецесли;
 иначе // на всех
	 
   Объект.СписокКвартир.Очистить();
   
   для каждого стр из Элементы.СписокЗданий.ВыделенныеСтроки цикл
	   
     текущийНомерКвартиры = объект.НомерПервойКвартиры;
     ТекущиеДанныеСИдентификатора = Элементы.СписокЗданий.ДанныеСтроки(стр);

	 если объект.КолвоКвартир = 0 тогда 
		 
	   новыйКвартира = Объект.СписокКвартир.Добавить();	
	   новыйКвартира.Улица = ТекущиеДанныеСИдентификатора.Улица;
	   новыйКвартира.Дом = ТекущиеДанныеСИдентификатора.Ссылка;
	   новыйКвартира.Корпус = ТекущиеДанныеСИдентификатора.Корпус;
	   новыйКвартира.НомерКвартиры = текущийНомерКвартиры;    		  
	   новыйКвартира.ТипКвартиры = Объект.ТипКвартиры;
	   новыйКвартира.СтатусКвартиры = Объект.СтатусКвартиры; 
	   новыйКвартира.ЛицевойСчет = СформироватьНомерЛС(ТекущиеДанныеСИдентификатора.Ссылка, текущийНомерКвартиры, Объект.ПрефиксЛС, Объект.ПостфиксЛС, Объект.ДлинаЛС);
	   новыйКвартира.СтатусЛС = "Новый";			 
		 
	 иначе	 
		 для ном = 1 по объект.КолвоКвартир цикл		   
		  	  
		  новыйКвартира = Объект.СписокКвартир.Добавить();	
		  новыйКвартира.Улица = ТекущиеДанныеСИдентификатора.Улица;
		  новыйКвартира.Дом = ТекущиеДанныеСИдентификатора.Ссылка;
		  новыйКвартира.Корпус = ТекущиеДанныеСИдентификатора.Корпус;
		  новыйКвартира.НомерКвартиры = текущийНомерКвартиры;    		  
		  новыйКвартира.ТипКвартиры = Объект.ТипКвартиры;
		  новыйКвартира.СтатусКвартиры = Объект.СтатусКвартиры; 		  
		  новыйКвартира.ЛицевойСчет = СформироватьНомерЛС(ТекущиеДанныеСИдентификатора.Ссылка, текущийНомерКвартиры, Объект.ПрефиксЛС, Объект.ПостфиксЛС, Объект.ДлинаЛС);
		  новыйКвартира.СтатусЛС = "Новый";
			  
		  текущийНомерКвартиры = текущийНомерКвартиры + 1;
		  
	     конеццикла;  	  
    конецесли;
   конеццикла;	
 
   Объект.СписокКвартир.Сортировать("Улица, Дом, Корпус, НомерКвартиры"); 	  
   Объект.НомерПервойКвартиры = текущийНомерКвартиры;

 конецесли;
 
   Объект.ПоследнийРассчитанныйНомерЛС = 0;

КонецПроцедуры


Функция НайтиПоследнийНомерКвартиры()

 таблицаКвартир = Объект.СписокКвартир.Выгрузить();	
	
 если таблицаКвартир.Количество() = 0 тогда
  возврат 1;
 иначе
	 
  Объект.СписокКвартир.Сортировать("Улица, Дом, Корпус, НомерКвартиры");

  НомераКвартир = таблицаКвартир.ВыгрузитьКолонку("НомерКвартиры"); 	 
  возврат НомераКвартир[НомераКвартир.Количество()-1] + 1;  
  
 конецесли;	 

КонецФункции // НайтиПоследнийНомер()

&НаКлиенте
Процедура СоздатьЗдание(Команда)
	СоздатьЗданиеНаСервере();
КонецПроцедуры

функция НайтиОбъектЗдания (Улица, Дом, Корпус = неопределено)
	
    запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	бит_СписокЗданий.Ссылка КАК Ссылка
	               |ИЗ
	               |	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	               |ГДЕ
	               |	бит_СписокЗданий.Улица = &Улица
	               |	И бит_СписокЗданий.НомерДома = &НомерДома";
	
	если Корпус <> неопределено и Корпус <> 0 тогда	
	   запрос.Текст = запрос.Текст + " И бит_СписокЗданий.Корпус = &Корпус";
	   запрос.УстановитьПараметр("Корпус", Корпус);
	конецесли;
	запрос.УстановитьПараметр("Улица", Улица);
	запрос.УстановитьПараметр("НомерДома", Число(Дом));	

    табЗапроса = запрос.Выполнить().Выгрузить();

	если табЗапроса.Количество() = 0 тогда 
	 возврат неопределено; 	
	иначе	
	 возврат табЗапроса[0].Ссылка;	
	конецесли	
	
конецфункции	

функция НайтиОбъектКвартира (Владелец, НомерКвартиры)
	
   Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_Квартиры.Ссылка
	|ИЗ
	|	Справочник.бит_Квартиры КАК бит_Квартиры
	|ГДЕ
	|	бит_Квартиры.Наименование = &Наименование
	|	И бит_Квартиры.Владелец = &Владелец";
//	|	И бит_Квартиры.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Наименование", строка(НомерКвартиры));
	Запрос.УстановитьПараметр("Владелец",Владелец);
//	Запрос.УстановитьПараметр("Ссылка",Ссылка);

	//
	//запрос.УстановитьПараметр("Владелец", Владелец);
	//запрос.УстановитьПараметр("НомерКвартиры", НомерКвартиры);
    табЗапроса = запрос.Выполнить().Выгрузить();
	
	если табЗапроса.Количество() = 0 тогда 
	  возврат неопределено; 	
    иначе	
	  возврат табЗапроса[0].Ссылка;
	конецесли;	
   
 возврат неопределено; 	
конецфункции	

функция НайтиОбъектЛС (Здание, Квартира)
	
 если ТипЗнч(Квартира) = Тип("Число") тогда
	
  запрос = новый Запрос;
  запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                 |	бит_ЛицевыеСчета.Ссылка КАК Ссылка
                 |ИЗ
                 |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
                 |ГДЕ
                 |	бит_ЛицевыеСчета.Здание = &Здание
                 |	И бит_ЛицевыеСчета.Квартира.НомерКвартиры = &Квартира";
   
 иначе 
	 
  запрос = новый Запрос;
  запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                 |	бит_ЛицевыеСчета.Ссылка КАК Ссылка
                 |ИЗ
                 |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
                 |ГДЕ
                 |	бит_ЛицевыеСчета.Здание = &Здание
                 |	И бит_ЛицевыеСчета.Квартира = &Квартира";
	  	 
 конецесли;	 
 
 запрос.УстановитьПараметр("Здание", Здание);
 запрос.УстановитьПараметр("Квартира", Квартира);
 табЗапроса = запрос.Выполнить().Выгрузить(); 
 
 если табЗапроса.Количество() = 0 тогда 

    табЗапроса = запрос.Выполнить().Выгрузить();

	если табЗапроса.Количество() = 0 тогда 
	 возврат неопределено; 	
	иначе	
	 возврат табЗапроса[0].Ссылка;	
    конецесли;	
	
 иначе		 
	возврат табЗапроса[0].Ссылка;   	
 конецесли;	

 возврат неопределено;   
 
конецфункции	

&НаСервере
Процедура СоздатьЗданиеНаСервере()
	
  Объект.НомерПервогоЛС = НайтиПоследнийПорядковыйНомерЛС();	  
	
  для каждого стр из Объект.СписокЗданий цикл			
	
	  если НайтиОбъектЗдания (стр.Улица, стр.Дом, стр.Корпус) = неопределено тогда 
		  
		НовоеЗдание = Справочники.бит_СписокЗданий.СоздатьЭлемент();
		
		НовоеЗдание.Улица       = стр.Улица;
		НовоеЗдание.НомерДома   = стр.Дом;
		если стр.Корпус <> 0 тогда
		 НовоеЗдание.Корпус      = стр.Корпус;
		конецесли;
		НовоеЗдание.Организация = стр.Организация;
		НовоеЗдание.Прочее      = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(("Автоматическое создание %1"), ТекущаяДата());
		
		Попытка
			НовоеЗдание.Записать();	
			стр.Ссылка = НовоеЗдание.Ссылка; 
		Исключение		
			рез = ОписаниеОшибки();
		КонецПопытки; 
		
	конецесли;
	
  конеццикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УдалитьАвтоматические(Команда)
	УдалитьАвтоматическиеНаСервере();
КонецПроцедуры

&НаСервере
Процедура УдалитьАвтоматическиеНаСервере()
	
	ОбщееКолвоНайденных = 0;
	КолвоУдаленных = 0;
	
	запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	бит_ЛицевыеСчета.Ссылка КАК Ссылка,
	               |	бит_ЛицевыеСчета.Комментарий КАК Комментарий
	               |ИЗ
	               |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	               |ГДЕ
	               |	бит_ЛицевыеСчета.Комментарий ПОДОБНО &Прочее";
	
	запрос.УстановитьПараметр("Прочее", "%Автоматическое создание%");   	
	
    табЗапроса = запрос.Выполнить().Выгрузить();
	ОбщееКолвоНайденных = табЗапроса.Количество();
	КолвоУдаленных = 0;
	для каждого стр из табЗапроса цикл		
	 
	  датаСоздания = ПолучитьДатуСоздания (стр.Комментарий);	  
	  если датаСоздания <> '00010101000000' и ДатаВИнтервале(датаСоздания) тогда		  
		об = стр.Ссылка.ПолучитьОбъект();
	    об.ПометкаУдаления = истина;
	    об.Записать();	
		КолвоУдаленных = КолвоУдаленных + 1;
	  конецесли;	      		
	  		
    конеццикла;

	строкаРезультата = Строка("Найдено ЛС: " + строка(ОбщееКолвоНайденных) + " , удалено: " + строка(КолвоУдаленных));
	Сообщить(строкаРезультата);

	
	запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	бит_Квартиры.Ссылка КАК Ссылка,
	               |	бит_Квартиры.Комментарий КАК Комментарий
	               |ИЗ
	               |	Справочник.бит_Квартиры КАК бит_Квартиры
	               |ГДЕ
	               |	бит_Квартиры.Комментарий ПОДОБНО &Прочее";
	
	запрос.УстановитьПараметр("Прочее", "%Автоматическое создание%"); 	
	
    табЗапроса = запрос.Выполнить().Выгрузить();
