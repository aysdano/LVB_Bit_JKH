&НаКлиенте
Процедура Многотарифные(Команда)
	
	Корень = ДеревоСчетчиков.ПолучитьЭлементы();
	
	Для каждого СтрокаДерева Из Корень Цикл
		
		Если НЕ СтрокаДерева.Обрабатывать Тогда
			Продолжить;
		КонецЕсли; 
		
		СтрокаДерева.Многотарифный      = Истина;
		СтрокаДерева.НачальныеПоказания = 0;
		СтрокаДерева.КонечныеПоказания  = 0;
		
		Веткка =  СтрокаДерева.ПолучитьЭлементы();
		Веткка.Очистить();
		
		Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
			
			НоваяСТрока = Веткка.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСТрока, СтрокаДерева);
			НоваяСТрока.Услуга = СтрокаТаблицы.Услуга;
			
		КонецЦикла; 
		
		Элементы.ДеревоСчетчиков.Развернуть(СтрокаДерева.ПолучитьИдентификатор());
		
	КонецЦикла; 
	
