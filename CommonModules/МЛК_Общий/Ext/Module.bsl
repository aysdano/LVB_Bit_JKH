	КонецЕсли;	
	
	ТекущаяСтрокаСобытия = СтрокаПараметров;
	// ТекущаяСтрокаСобытия=СоздатьСтрокаСобытиеНеКодированное(ТаблицаЛС,Действие_Для_События,Сумма_Для_События,Период_Для_События,Статус_Для_События,Номер_Док_Оплата_Для_События,НомерТекущейСтроки);
	Если СтрокаСобытий = "" Тогда
		СтрокаСобытий = ТекущаяСтрокаСобытия;
	Иначе
		СтрокаСобытий = СтрокаСобытий+"&"+ТекущаяСтрокаСобытия;
	КонецЕсли;
	
	СтрокаПриложения = "ApplicationId=" + КодироватьСтроку(Строка(СокрЛП(Настройки.НомерПриложения)),СпособКодированияСтроки.КодировкаURL) + "&";
	СтрокаСобытий=Строка(СтрокаПриложения) + СтрокаСобытий;
	
	АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
	АдресРесурса1 = "/api/v6/events/createupdate";
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаСобытий, КодировкаТекста.UTF8);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");   // тут поменялось
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Настройки.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , ,300 ,Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
		МЛК_Общий.ЗаписатьДанныеВЖурнал("Отправка истории начислений",Ответ.КодСостояния,Строка(АдресСервисаСтр)+Строка(АдресРесурса1)+Строка(СтрокаСобытий),,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		Возврат Ложь;
	КонецПопытки;
	Если Ответ.КодСостояния = 200 Тогда
		СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	Иначе
		МЛК_Общий.ЗаписатьДанныеВЖурнал("Отправка истории начислений",Ответ.КодСостояния,Строка(АдресСервисаСтр)+Строка(АдресРесурса1)+Строка(СтрокаСобытий),Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8),ОписаниеОшибки(),ТекущаяДатаСеанса());	
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
КонецФункции	
