	|			И Результата.Поставщик = бит_СтавкиНаУслугиСрезПоследних.Поставщик
	|			И Результата.СпособРасчета = бит_СтавкиНаУслугиСрезПоследних.СпособРасчета
	|			И Результата.ТипКвартиры = бит_СтавкиНаУслугиСрезПоследних.ТипКвартиры
	|			И Результата.СтатусКвартиры = бит_СтавкиНаУслугиСрезПоследних.СтатусКвартиры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НастройкиУслугВыгрузкиГЦЖС КАК бит_НастройкиУслугВыгрузкиГЦЖС
	|		ПО Результата.УслугаЖКХ = бит_НастройкиУслугВыгрузкиГЦЖС.Услуга
	|			И Результата.РежимПотребления = бит_НастройкиУслугВыгрузкиГЦЖС.РежимПотребления
	|ГДЕ
	|	Результата.Начисления > 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование
	|ИТОГИ
	|	СУММА(Начисления),
	|	СУММА(Льгота),
	|	МАКСИМУМ(КодПлательщика),
	|	МАКСИМУМ(Дом),
	|	МАКСИМУМ(Квартира),
	|	МАКСИМУМ(КодУлицы),
	|	МАКСИМУМ(КодУлицыБТИ),
	|	МАКСИМУМ(КодРайона),
	|	МАКСИМУМ(Корпус),
	|	МАКСИМУМ(КодДома),
	|	МАКСИМУМ(КодКвартиры),
	|	МАКСИМУМ(ОбщаяПлощадь),
	|	МАКСИМУМ(ЖилаяПлощадь),
	|	МАКСИМУМ(ФормаСобственности),
	|	МАКСИМУМ(ТипЗаселения),
	|	МАКСИМУМ(ТипПлиты),
	|	МАКСИМУМ(ТипЗапирающегоУстройства),
	|	МАКСИМУМ(Фамилия),
	|	МАКСИМУМ(Имя),
	|	МАКСИМУМ(Отчество),
	|	МАКСИМУМ(КоличествоПроживающих),
	|	МАКСИМУМ(Строение),
	|	МАКСИМУМ(ОбщедомовыеНачисления),
	|	МАКСИМУМ(ОтапливаемаяПлощадь),
	|	МАКСИМУМ(ПостоянноПроживающие)
	|ПО
	|	ЛицевойСчет
