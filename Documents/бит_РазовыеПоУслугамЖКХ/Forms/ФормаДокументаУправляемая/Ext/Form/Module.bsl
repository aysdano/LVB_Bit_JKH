&НаКлиенте
Процедура ЧекККМОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Отмена = Ложь;
		
		Отмена2 = ПроверитьЧекНаСтроно(ВыбранноеЗначение, Отмена);
		
		Если Отмена2 Тогда
			
			Возврат;
			
		КонецЕсли;
		
		Если Объект.ЧекККМ <> ВыбранноеЗначение Тогда
			
			Если Объект.СписокУслуг.Количество() > 0 Тогда
				
				Ответ = Неопределено;
				
				ПоказатьВопрос(Новый ОписаниеОповещения("ЧекККМОбработкаВыбораЗавершение", ЭтотОбъект, Новый Структура("ВыбранноеЗначение", ВыбранноеЗначение)), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
				
			Иначе
				
				Объект.ЧекККМ = ВыбранноеЗначение;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

