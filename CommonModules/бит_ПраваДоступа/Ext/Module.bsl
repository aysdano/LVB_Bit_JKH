КонецФункции // битПолучитьПолноеИмяОбъекта()

// Функция получает имя типа объекта.
//
// Параметры:
//  ИмяОбъекта  – Строка – Краткое имя объекта.
//  ВидОбъекта  – ПеречислениеСсылка.бит_ВидыОбъектов.
//
// Возвращаемое значение:
//   РезСтрока   – Строка.
//
Функция ПолучитьИмяТипаОбъекта(ИмяОбъекта,ВидОбъекта) Экспорт
	Если ВидОбъекта = Перечисления.бит_ВидыОбъектов.Документ 
		ИЛИ ВидОбъекта = Перечисления.бит_ВидыОбъектов.Справочник Тогда
		РезСтрока = Строка(ВидОбъекта)+"Ссылка."+ИмяОбъекта;
	ИначеЕсли ВидОбъекта = Перечисления.бит_ВидыОбъектов.Обработка 
		ИЛИ ВидОбъекта = Перечисления.бит_ВидыОбъектов.Отчет Тогда	
		РезСтрока = Строка(ВидОбъекта)+"Объект."+ИмяОбъекта;
	ИначеЕсли ВидОбъекта = Перечисления.бит_ВидыОбъектов.РегистрСведений Тогда
		РезСтрока = "РегистрСведенийНаборЗаписей."+ИмяОбъекта;
	КонецЕсли; 
	Возврат РезСтрока;
КонецФункции // битПолучитьПолноеИмяОбъекта()

