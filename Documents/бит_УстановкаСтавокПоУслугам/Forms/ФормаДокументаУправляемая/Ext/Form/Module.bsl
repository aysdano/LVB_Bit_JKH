&НаСервере
Функция ВыборПоставщикаНаСервере(СсылкаНаУслугу)
	
	Поставщики  = Объект.Услуга.Поставщики;
	
	мСписокПоставщиков = Новый СписокЗначений;
	
	мСписокПоставщиков.Очистить();
	
	Для Каждого ТекСтрока Из Поставщики Цикл
		
		мСписокПоставщиков.Добавить(ТекСтрока.Поставщик);
		
	КонецЦикла;
	
	мКэшЗначений.мСписокПоставщиков = мСписокПоставщиков;
	
	Возврат мСписокПоставщиков;
	
КонецФункции

&НаСервере
Функция ВыборРежимовПотребленияНаСервере(СсылкаНаУслугу)
	
	РежимыПотребления  = Объект.Услуга.РежимыПотребленияУслуг;
	
	мКэшЗначений.мСписокРежимовПотребления.Очистить();
	
	Для Каждого ТекСтрока Из РежимыПотребления Цикл
		
		мКэшЗначений.мСписокРежимовПотребления.Добавить(ТекСтрока.РежимПотребленияУслуг);
		
	КонецЦикла;
	
	мСписокРежимовПотребления = мКэшЗначений.мСписокРежимовПотребления;
	
	Возврат мСписокРежимовПотребления;
	
КонецФункции

&НаСервере
Функция ВыборСпособовРасчетаНаСервере(СсылкаНаУслугу)
	
	СпособыРасчета  = Объект.Услуга.СпособыРасчета;
	
	мКэшЗначений.мСписокСпособовРасчета.Очистить();
	
	Для Каждого ТекСтрока Из СпособыРасчета Цикл
		
		мКэшЗначений.мСписокСпособовРасчета.Добавить(ТекСтрока.СпособРасчета);
		
	КонецЦикла;
	
	мСписокСпособовРасчета = мКэшЗначений.мСписокСпособовРасчета;
	
	Возврат мСписокСпособовРасчета;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНормативыНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_УслугиЖКХПоставщики.Поставщик,
	|	бит_НормыНаУслугиСрезПоследних.Услуга,
	|	бит_НормыНаУслугиСрезПоследних.СпособРасчетаПоУслуге КАК СпособРасчета,
	|	бит_НормыНаУслугиСрезПоследних.РежимПотребления КАК РежимПотребления,
	|	бит_НормыНаУслугиСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	|	бит_НормыНаУслугиСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	|	бит_НормыНаУслугиСрезПоследних.НормативПотребленияПоКу
	|ИЗ
	|	Справочник.бит_УслугиЖКХ.Поставщики КАК бит_УслугиЖКХПоставщики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НормыНаУслуги.СрезПоследних(&Дата, Услуга = &Услуга) КАК бит_НормыНаУслугиСрезПоследних
	|		ПО бит_УслугиЖКХПоставщики.Ссылка = бит_НормыНаУслугиСрезПоследних.Услуга
	|ГДЕ
	|	бит_УслугиЖКХПоставщики.Ссылка = &Услуга
	|
	|УПОРЯДОЧИТЬ ПО
	|	СпособРасчета,
	|	РежимПотребления,
	|	СтатусКвартиры,
	|	ТипКвартиры";
	Запрос.УстановитьПараметр("Дата"     , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Услуга"   , Объект.Услуга);
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("Поставщик"       , Выборка.Поставщик);
		Отбор.Вставить("СпособРасчета"   , Выборка.СпособРасчета);
		Отбор.Вставить("РежимПотребления", Выборка.РежимПотребления);
		Отбор.Вставить("ТипКвартиры"     , Выборка.ТипКвартиры);
		Отбор.Вставить("СтатусКвартиры"  , Выборка.СтатусКвартиры);
		
		СтрокиПоиска = Объект.СтавкиНаУслуги.НайтиСтроки(Отбор);
		
		Для каждого Строка Из СтрокиПоиска Цикл
			
			Строка.НормативПотребленияПоКу = Выборка.НормативПотребленияПоКу;
			
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуНаСервере()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_УслугиЖКХПоставщики.Поставщик,
	|	бит_НормыНаУслугиСрезПоследних.Услуга,
	|	бит_НормыНаУслугиСрезПоследних.СпособРасчетаПоУслуге КАК СпособРасчета,
	|	бит_НормыНаУслугиСрезПоследних.РежимПотребления КАК РежимПотребления,
	|	бит_НормыНаУслугиСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	|	бит_НормыНаУслугиСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	|	бит_НормыНаУслугиСрезПоследних.НормативПотребленияПоКу
	|ИЗ
	|	Справочник.бит_УслугиЖКХ.Поставщики КАК бит_УслугиЖКХПоставщики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НормыНаУслуги.СрезПоследних(&Дата, Услуга = &Услуга) КАК бит_НормыНаУслугиСрезПоследних
	|		ПО бит_УслугиЖКХПоставщики.Ссылка = бит_НормыНаУслугиСрезПоследних.Услуга
	|ГДЕ
	|	бит_УслугиЖКХПоставщики.Ссылка = &Услуга
	|
	|УПОРЯДОЧИТЬ ПО
	|	СпособРасчета,
	|	РежимПотребления,
	|	СтатусКвартиры,
	|	ТипКвартиры";
	Запрос.УстановитьПараметр("Дата"     , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Услуга"   , Объект.Услуга);
	
	Результат = Запрос.Выполнить();
	
	Если Объект.СтавкиНаУслуги.Количество() > 0 Тогда
		
	КонецЕсли;
	
	Объект.СтавкиНаУслуги.Очистить();
	Объект.СтавкиНаУслуги.Загрузить(Результат.Выгрузить());
	
КонецПроцедуры

&НаСервере
Процедура АктивизироватьРеквизитВФормеНаСервере(СтруктураРеквизитов)
	
	ДокументОбъект = РеквизитФормыВЗначение("Объект");
	
	бит_РаботаСДиалогамиСервер.АктивизироватьРеквизитВФорме(ДокументОбъект, ЭтаФорма, СтруктураРеквизитов);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьФормыДляРедактированияНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	бит_РаботаСДиалогамиСервер.УстановитьДоступностьФормыДляРедактирования(ДокументОбъект, ЭтаФорма);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

