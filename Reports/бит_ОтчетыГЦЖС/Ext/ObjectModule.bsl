функция ПолучитьТаблицуНастроек()
	
 запрос = новый Запрос;
 запрос.Текст = "ВЫБРАТЬ
                |	бит_НастройкаОтчетаГЦЖС.ПолеДанных КАК ПолеДанных,
                |	бит_НастройкаОтчетаГЦЖС.НомерПоляExcel КАК НомерПоляExcel,
                |	бит_НастройкаОтчетаГЦЖС.ИмяПоляExcel КАК ИмяПоляExcel,
                |	бит_НастройкаОтчетаГЦЖС.ФорматКолонки КАК ФорматКолонки
                |ИЗ
                |	РегистрСведений.бит_НастройкаОтчетаГЦЖС КАК бит_НастройкаОтчетаГЦЖС";
 
 возврат запрос.Выполнить().Выгрузить();
	
конецфункции

