				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	бит_ЛицевыеСчета.КапРемИдентификаторЖКУ КАК ИдентификаторЖКУ
ПОМЕСТИТЬ ВТ_ЛицевыеСчетаОбщая
ИЗ
	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
ГДЕ
	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	И НЕ бит_СписокЗданий.ПометкаУдаления
{ГДЕ
	(бит_ЛицевыеСчета.Ссылка В (&amp;СписокЛС)),
	(бит_ЛицевыеСчета.Организация = &amp;ОтборОрганизация),
	(бит_СписокЗданий.Улица В (&amp;СписокУлиц)),
	(бит_ЛицевыеСчета.Здание В (&amp;СписокЗданий)),
	(ВЫБОР
			КОГДА &amp;ТипДомаГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.МКД)
				ТОГДА бит_СписокЗданий.ТипыДомовГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.МКД)
						ИЛИ бит_СписокЗданий.ТипыДомовГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.ПустаяСсылка)
			ИНАЧЕ бит_СписокЗданий.ТипыДомовГИСЖКХ В (&amp;ТипДомаГИСЖКХ)
		КОНЕЦ)}

ИНДЕКСИРОВАТЬ ПО
	ЛицевойСчет
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_ПлатежныеДокументыГИСЖКХ.Ссылка КАК ПлатежныйДокумент,
	бит_ПлатежныеДокументыГИСЖКХ.ЛицевойСчет КАК ЛицевойСчет,
	бит_ПлатежныеДокументыГИСЖКХ.НомерПД КАК НомерПлатежногоДокумента,
	бит_ПлатежныеДокументыГИСЖКХ.РасчетныйПериод КАК РасчетныйПериод,
	бит_ПлатежныеДокументыГИСЖКХ.ШаблонИзвещений КАК ШаблонИзвещений
ПОМЕСТИТЬ ВТ_ВсеПлатежныеДокументы
ИЗ
	Справочник.бит_ПлатежныеДокументыГИСЖКХ КАК бит_ПлатежныеДокументыГИСЖКХ
ГДЕ
	НЕ бит_ПлатежныеДокументыГИСЖКХ.Отозван
	И НЕ бит_ПлатежныеДокументыГИСЖКХ.ПометкаУдаления
	И НЕ бит_ПлатежныеДокументыГИСЖКХ.ЭтоГруппа
	И бит_ПлатежныеДокументыГИСЖКХ.ШаблонИзвещений = &amp;ШаблонИзвещений
	И бит_ПлатежныеДокументыГИСЖКХ.РасчетныйПериод МЕЖДУ НАЧАЛОПЕРИОДА(&amp;Период, МЕСЯЦ) И КОНЕЦПЕРИОДА(&amp;Период, МЕСЯЦ)
	И бит_ПлатежныеДокументыГИСЖКХ.ИдентификаторПД = ""
{ГДЕ
	(бит_ПлатежныеДокументыГИСЖКХ.ЛицевойСчет В (&amp;СписокЛС))}

ИНДЕКСИРОВАТЬ ПО
	ПлатежныйДокумент,
	ЛицевойСчет,
	бит_ПлатежныеДокументыГИСЖКХ.ШаблонИзвещений
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ВсеПлатежныеДокументы.ПлатежныйДокумент КАК ПлатежныйДокумент,
	ВТ_ВсеПлатежныеДокументы.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_ВсеПлатежныеДокументы.НомерПлатежногоДокумента КАК НомерПлатежногоДокумента,
	ВТ_ВсеПлатежныеДокументы.РасчетныйПериод КАК РасчетныйПериод,
	ВТ_ЛицевыеСчетаОбщая.ИдентификаторЖКУ КАК ИдентификаторЖКУ
ПОМЕСТИТЬ ВТ_ИтогПДЛС
ИЗ
	ВТ_ВсеПлатежныеДокументы КАК ВТ_ВсеПлатежныеДокументы
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ЛицевыеСчетаОбщая КАК ВТ_ЛицевыеСчетаОбщая
		ПО ВТ_ВсеПлатежныеДокументы.ЛицевойСчет = ВТ_ЛицевыеСчетаОбщая.ЛицевойСчет
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ШаблоныИзвещений КАК бит_ШаблоныИзвещений
		ПО ВТ_ВсеПлатежныеДокументы.ШаблонИзвещений = бит_ШаблоныИзвещений.Ссылка

ИНДЕКСИРОВАТЬ ПО
	ПлатежныйДокумент
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ИтогПДЛС.ПлатежныйДокумент КАК ПлатежныйДокумент,
	ВТ_ИтогПДЛС.ЛицевойСчет КАК ЛицевойСчет,
	КОЛИЧЕСТВО(1) КАК КолВо
ПОМЕСТИТЬ ВТ_ДПД
ИЗ
	ВТ_ИтогПДЛС КАК ВТ_ИтогПДЛС
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ПлатежныеДокументыГИСЖКХ.ТаблицаПлатежиГИСЖКХДПД КАК бит_ПлатежныеДокументыГИСЖКХТаблицаПлатежиГИСЖКХДПД
		ПО ВТ_ИтогПДЛС.ПлатежныйДокумент = бит_ПлатежныеДокументыГИСЖКХТаблицаПлатежиГИСЖКХДПД.Ссылка

СГРУППИРОВАТЬ ПО
	ВТ_ИтогПДЛС.ПлатежныйДокумент,
	ВТ_ИтогПДЛС.ЛицевойСчет
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ИтогПДЛС.ПлатежныйДокумент КАК ПлатежныйДокумент,
	ВТ_ИтогПДЛС.ЛицевойСчет КАК ЛицевойСчет,
	ПРЕДСТАВЛЕНИЕ(ВТ_ИтогПДЛС.НомерПлатежногоДокумента) КАК НомерПлатежногоДокумента,	
	ВЫБОР
		КОГДА &amp;ДолговойПД = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
			ТОГДА "Долговой"
		ИНАЧЕ "Текущий"
	КОНЕЦ КАК ТипПД,
	ВЫБОР
		КОГДА ЕСТЬNULL(бит_ПлатежныеДокументыГИСЖКХТаблицаПлатежиГИСЖКХ12.КОплатеЗаМесяц, 0) = 0
				ИЛИ &amp;ДолговойПД = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
			ТОГДА ""
		ИНАЧЕ ЕСТЬNULL(бит_ПлатежныеДокументыГИСЖКХТаблицаПлатежиГИСЖКХ12.КОплатеЗаМесяц, "")
	КОНЕЦ КАК КОплатеЗаМесяц,
	ВЫБОР
		КОГДА ЕСТЬNULL(бит_ПлатежныеДокументыГИСЖКХТаблицаПлатежиГИСЖКХ12.ЗадолженностьЗаПредыдущиеПериоды, 0) = 0
