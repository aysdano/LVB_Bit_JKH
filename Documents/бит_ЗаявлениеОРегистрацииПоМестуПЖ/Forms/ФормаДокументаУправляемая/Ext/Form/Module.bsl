&НаСервереБезКонтекста
Функция ПолучитьНомерДома(Строка)
	
	ИсхДанные     = СокрЛП(Строка);
	
	ВхождениеДома = СтрНайти(ВРЕГ(ИсхДанные), "Д." );
	
	Если ВхождениеДома > 0 Тогда
		
		КоличествоСимволов = (СтрДлина(ИсхДанные) - ВхождениеДома - 1);
		Дом = Прав(ИсхДанные, КоличествоСимволов);
		
		ВхождениеКорпуса = СтрНайти(ВРЕГ(Дом), "КОРП.");
		
		Если ВхождениеКорпуса > 0 Тогда
			
			ДомБезКорпуса = Лев(Дом, ВхождениеКорпуса - 1);
			Возврат ДомБезКорпуса; 
			
		КонецЕсли;
		
		
		Возврат Дом;
		
	КонецЕсли;
	
	Возврат "";
	
КонецФункции

