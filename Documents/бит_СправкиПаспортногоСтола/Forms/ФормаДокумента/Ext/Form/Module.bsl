#Область ДействияКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	
	Если Модифицированность Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПечатьЗавершение", ЭтотОбъект), "Данные еще не записаны.
		|Печать возможна только после записи данных.                         
		|Данные будут записаны.", РежимДиалогаВопрос.ДаНет);
		Возврат; 
		
	КонецЕсли; 
	
	// +bit ISedakova 30.03.2022 ЛТ81 
	//Новые ПФ и новая процедура печати
	//ПечатьФрагмент();
	бит_Печать();
	// -bit ISedakova 30.03.2022  
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса; 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Записать();
	Иначе
		Возврат;
	КонецЕсли; 
	
	// +bit ISedakova 30.03.2022 ЛТ81 
	//Новые ПФ и новая процедура печати
	//ПечатьФрагмент();
	бит_Печать();
	// -bit ISedakova 30.03.2022
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьФрагмент()
	
	Перем АдресТабличногоДокументаВоВременномХранилище, Макет, Результат;
	
	Результат = СформироватьОтчетНаСервере();
	
	// БИТ_ЖКХ 16.09.2014
	// УниверсальныеМеханизмы.НапечататьДокумент(Результат,,,"Справка для предоставления: " + Объект.СправкаДанаДляПредоставления);.
	
	Если Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.ВВоенкомат") Тогда
		Макет = "ВВоенкомат";	
	ИначеЕсли Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.ВНотариальнуюКонтору") Тогда
		Макет = "ВНотариальнуюКонтору";	
	ИначеЕсли Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.ПоТребованию") Тогда
		Макет = "ПоТребованию";	
	КонецЕсли;	
	
	АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
	
	бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
	,"бит_СправкиПаспортногоСтола"
	,Макет
	,"Справка для предоставления: " + Объект.СправкаДанаДляПредоставления
	
	,АдресТабличногоДокументаВоВременномХранилище
	
	,Объект.Ссылка);
	// БИТ_ЖКХ 16.09.2014
	
КонецПроцедуры

// +bit ISedakova 30.03.2022 ЛТ81
&НаКлиенте
Процедура бит_Печать()
	
	Перем АдресТабличногоДокументаВоВременномХранилище, Макет, Результат;
	
	Результат = бит_СформироватьОтчетНаСервере();
	
	Если Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.бит_ПоМестуПребывания") Тогда
		Макет = "бит_ПоМестуПребывания";	
	ИначеЕсли Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.ВНотариальнуюКонтору") Тогда
		Макет = "бит_ВНотариальнуюКонтору";	
	ИначеЕсли Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.ПоТребованию") Тогда
		Макет = "бит_ПоТребованию";	
	КонецЕсли;	
	
	АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
	
	бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
	,"бит_СправкиПаспортногоСтола"
	,Макет
	,"Справка для предоставления: " + Объект.СправкаДанаДляПредоставления	
	,АдресТабличногоДокументаВоВременномХранилище
	,Объект.Ссылка);
	
КонецПроцедуры

Функция бит_СформироватьОтчетНаСервере()
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ПараметрыОтчета = ПодготовитьПараметрыОтчета();
	
	Если Объект.СправкаДанаДляПредоставления = Перечисления.бит_ВидСправкиДляПредоставления.бит_ПоМестуПребывания Тогда
		
		бит_ЗаполнитьСправкуПоМестуПребывания(ДокументРезультат, ПараметрыОтчета);
		
	ИначеЕсли Объект.СправкаДанаДляПредоставления = Перечисления.бит_ВидСправкиДляПредоставления.ВНотариальнуюКонтору Тогда
		
		бит_ЗаполнитьСправкуВНотариальнуюКонтору(ДокументРезультат, ПараметрыОтчета);
		
	ИначеЕсли Объект.СправкаДанаДляПредоставления = Перечисления.бит_ВидСправкиДляПредоставления.ПоТребованию Тогда
		
		бит_ЗаполнитьСправкуПоТребованию(ДокументРезультат, ПараметрыОтчета);
		
	КонецЕсли;
	
	ДокументРезультат.АвтоМасштаб = Истина;
	
	Возврат ДокументРезультат;
	
КонецФункции

Процедура бит_ЗаполнитьСправкуПоМестуПребывания(ДокументРезультат, ПараметрыОтчета)
	
	Макет = Документы.бит_СправкиПаспортногоСтола.ПолучитьМакет("бит_ПоМестуПребывания");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Здание.Участок.ТелефоныПаспортиста КАК ЗданиеУчастокТелефоныПаспортиста
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ЛицевойСчет);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбластьШапка.Параметры.ТелефонПС   	= ВыборкаДетальныеЗаписи.ЗданиеУчастокТелефоныПаспортиста;
	КонецЕсли;
	СтруктураДанных = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Объект.Организация, Объект.Дата);
	ОбластьШапка.Параметры.Организация       = СтруктураДанных.НаименованиеДляПечатныхФорм;
	ОбластьШапка.Параметры.ОрганизацияИННКПП = "ИНН\КПП: " + Строка(СтруктураДанных.ИНН)+"\"+Строка(СтруктураДанных.КПП);
	ОбластьШапка.Параметры.РС                = "№"+Строка(СтруктураДанных.НомерСчета)+", "+Строка(СтруктураДанных.Банк)+"\"+Строка(СтруктураДанных.КоррСчет)+"\"+Строка(СтруктураДанных.БИК);
	
	ОбластьШапка.Параметры.АдресОрганизации  = СтруктураДанных.ФактическийАдрес;
	ОбластьШапка.Параметры.Телефон           = СтруктураДанных.Телефоны;
	
	ОбластьШапка.Параметры.Номер			= ПараметрыОтчета.Номер;
	ОбластьШапка.Параметры.ЛС 				= Объект.ЛицевойСчет;
	ОбластьШапка.Параметры.ДатаВыдачи		= Формат(ПараметрыОтчета.Период, "ДЛФ=DD");
	ОбластьШапка.Параметры.Проживающий		= ПараметрыОтчета.Проживающий;
	ОбластьШапка.Параметры.ДатаРождения		= Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.АдресПроживающего= ПараметрыОтчета.Адрес;
	
	Если Объект.бит_ВыводитьПаспортныеДанные = Истина Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Период"     , ПараметрыОтчета.Период);
		Запрос.УстановитьПараметр("ЛицевойСчет", ПараметрыОтчета.ЛицевойСчет);
		Запрос.УстановитьПараметр("Проживающий", ПараметрыОтчета.Проживающий);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
		|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
		|	бит_ПаспортныеДанныеПроживающих.Период КАК Период,
		|	бит_ПаспортныеДанныеПроживающих.ДокументВид КАК ДокументВид,
		|	бит_ПаспортныеДанныеПроживающих.ДокументСерия КАК ДокументСерия,
		|	бит_ПаспортныеДанныеПроживающих.ДокументНомер КАК ДокументНомер,
		|	бит_ПаспортныеДанныеПроживающих.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
		|	бит_ПаспортныеДанныеПроживающих.ДокументКемВыдан КАК ДокументКемВыдан,
		|	бит_ПаспортныеДанныеПроживающих.ДокументПричинаЗамены КАК ДокументПричинаЗамены,
		|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
		|			&Период,
		|			ФизЛицо = &Проживающий
		|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих КАК бит_ПаспортныеДанныеПроживающих
		|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ПаспортныеДанныеПроживающих.ФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументДатаВыдачи УБЫВ
		|ИТОГИ
		|	МАКСИМУМ(ДатаРегистрации)
		|ПО
		|	ФизЛицо";
		
		ВыборкаФизЛицо = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если ВыборкаФизЛицо.Следующий() Тогда
			
			//ОбластьШапка.Параметры.ДатаРегистрации = Формат(ВыборкаФизЛицо.ДатаРегистрации, "ДФ=dd.MM.yyyy");
			//
			//Если ЗначениеЗаполнено(ВыборкаФизЛицо.ДатаСнятияСРегистрации) Тогда
			//	ОбластьШапка.Параметры.ДатаСнятияСРегистрации = "" + " по " + Формат(ВыборкаФизЛицо.ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy");	
			//КонецЕсли; 
			
			Выборка = ВыборкаФизЛицо.Выбрать();
			
			Количество = Выборка.Количество();
			
			КолДокуметов = 0;
			
			УдостовирениеЛичности = " ";
			
			Пока Выборка.Следующий() Цикл
				
				КолДокуметов = КолДокуметов + 1;
				
				УдостовирениеЛичности = УдостовирениеЛичности 
				+ Выборка.ДокументВид 
				+ " сер. "  + ?(ПустаяСтрока(Выборка.ДокументСерия),"...",Выборка.ДокументСерия)
				+ " №"      + ?(ПустаяСтрока(Выборка.ДокументНомер),"...",Выборка.ДокументНомер) 
				+ ", выд. " + Формат(Выборка.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy")
				+ " " + Выборка.ДокументКемВыдан 
				+ ?(ПустаяСтрока(Выборка.ДокументПричинаЗамены),"", ", выдан " + Выборка.ДокументПричинаЗамены);
				Если НЕ Количество = КолДокуметов Тогда
					
					УдостовирениеЛичности = УдостовирениеЛичности + ", взамен ";
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ОбластьШапка.Параметры.ПаспортныеДанные = УдостовирениеЛичности + ", ";
		
	КонецЕсли;
	
	Если ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
		ОбластьШапка.Параметры.Был         = "была";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирована";	
	ИначеЕсли ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда		
		ОбластьШапка.Параметры.Был         = "был";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирован";	
	Иначе
		//ОбластьШапка.Параметры.Он         = "он(а)";
		ОбластьШапка.Параметры.Был         = "был(а)";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирован(а)";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"           , ПараметрыОтчета.Период);
	Запрос.УстановитьПараметр("ЛицевойСчет"      , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо"      	 , ПараметрыОтчета.Проживающий);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК Проживающий,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры КАК ВладелецКвартиры,
	|	ПроживающиеПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК ДоляПлощади,
	|	ПроживающиеПоЛССрезПоследних.лб_СтрокаРодствДляФЛС КАК лб_СтрокаРодствДляФЛС,
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	ПроживающиеПоЛССрезПоследних.бит_ПомещенВАрхив КАК бит_ПомещенВАрхив
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И НЕ лб_ИгнорироватьПериодВКопииФЛС
	|				И ФизЛицо = &ФизЛицо) КАК ПроживающиеПоЛССрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатусФизЛица УБЫВ,
	|	ДатаРегистрации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОбластьШапка.Параметры.ДатаРегистрации = Формат(Выборка.ДатаРегистрации, "ДФ=dd.MM.yyyy");
		
		Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
			ОбластьШапка.Параметры.ДатаСнятияСРегистрации = "" + " по " + Формат(Выборка.ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy");	
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ОбластьПодвал.Параметры.ДолжностьПаспортист  =  "Паспортист";
	ОбластьПодвал.Параметры.Паспортист =  ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Объект.Ответственный.Наименование);
	
	ОбластьПодвал.Параметры.СправкаДанаДляПредоставления = Объект.бит_ДляПредъявления;
	ДокументРезультат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Процедура бит_ЗаполнитьСправкуВНотариальнуюКонтору(ДокументРезультат, ПараметрыОтчета)
	
	Макет = Документы.бит_СправкиПаспортногоСтола.ПолучитьМакет("бит_ВНотариальнуюКонтору");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	СписокПроживающих = Новый СписокЗначений;
	СписокПроживающих.ЗагрузитьЗначения(ПараметрыОтчета.СписокПроживающих.ВыгрузитьКолонку("ФизЛицо"));
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"           , ПараметрыОтчета.Период);
	Запрос.УстановитьПараметр("ЛицевойСчет"      , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("Проживающий"      , ПараметрыОтчета.Проживающий);
	Запрос.УстановитьПараметр("СписокПроживающих", СписокПроживающих);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	бит_СвидетельстваОСмерти.ДатаСмерти КАК УМРДатаСмерти,
	|	бит_СвидетельстваОСмерти.ДатаВыдачи КАК УМРДатаВыдачи,
	|	бит_СвидетельстваОСмерти.ДатаСоставления КАК УМРДатаСоставления,
	|	бит_СвидетельстваОСмерти.КемВыдано КАК УМРКемВыдано,
	|	бит_СвидетельстваОСмерти.Номер КАК УМРНомер,
	|	бит_СвидетельстваОСмерти.НомерСвидетельства КАК УМРНомерСвидетельства,
	|	бит_СвидетельстваОСмерти.СерияСвидетельства КАК УМРСерияСвидетельства
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			ФизЛицо = &Проживающий
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СвидетельстваОСмерти КАК бит_СвидетельстваОСмерти
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_СвидетельстваОСмерти.ФизЛицо";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОбластьШапка.Параметры.Заполнить(Выборка);
		ОбластьШапка.Параметры.УМРДатаСмерти		= Формат(Выборка.УМРДатаСмерти, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.УМРДатаВыдачи		= Формат(Выборка.УМРДатаВыдачи, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.УМРДатаСоставления	= Формат(Выборка.УМРДатаСоставления, "ДФ=dd.MM.yyyy");
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Здание.Участок.ТелефоныПаспортиста КАК ЗданиеУчастокТелефоныПаспортиста
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ЛицевойСчет);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбластьШапка.Параметры.ТелефонПС   	= ВыборкаДетальныеЗаписи.ЗданиеУчастокТелефоныПаспортиста;
	КонецЕсли;
	СтруктураДанных = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Объект.Организация, Объект.Дата);
	ОбластьШапка.Параметры.Организация       = СтруктураДанных.НаименованиеДляПечатныхФорм;
	ОбластьШапка.Параметры.ОрганизацияИННКПП = "ИНН\КПП: " + Строка(СтруктураДанных.ИНН)+"\"+Строка(СтруктураДанных.КПП);
	ОбластьШапка.Параметры.РС                = "№"+Строка(СтруктураДанных.НомерСчета)+", "+Строка(СтруктураДанных.Банк)+"\"+Строка(СтруктураДанных.КоррСчет)+"\"+Строка(СтруктураДанных.БИК);
	
	ОбластьШапка.Параметры.АдресОрганизации  = СтруктураДанных.ФактическийАдрес;
	ОбластьШапка.Параметры.Телефон           = СтруктураДанных.Телефоны;
	
	ОбластьШапка.Параметры.Номер		= ПараметрыОтчета.Номер;
	ОбластьШапка.Параметры.ДатаВыдачи		= Формат(ПараметрыОтчета.Период, "ДЛФ=DD");
	ОбластьШапка.Параметры.Проживающий		= ПараметрыОтчета.Проживающий;
	ОбластьШапка.Параметры.ДатаРождения		= Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.АдресПроживающего= ПараметрыОтчета.Адрес;
	
	Если ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
		//ОбластьШапка.Параметры.Ним         = "ней";
		ОбластьШапка.Параметры.Был         = "была";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирована";	
	ИначеЕсли ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда		
		//ОбластьШапка.Параметры.Ним         = "ним";
		ОбластьШапка.Параметры.Был         = "был";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирован";	
	Иначе
		//ОбластьШапка.Параметры.Ним         = "ним (ней)";
		//ОбластьШапка.Параметры.Он         = "он(а)";
		ОбластьШапка.Параметры.Был         = "был(а)";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирован(а)";	
	КонецЕсли;
	
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Если Объект.ТаблицаПроживающих.Количество() > 0 И Объект.ИспользоватьОтборПроживающих = Истина Тогда
		
		ОбластьСовместно = Макет.ПолучитьОбласть("Совместно");
		Если ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
			ОбластьСовместно.Параметры.Ним         = "ней";
		ИначеЕсли ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда		
			ОбластьСовместно.Параметры.Ним         = "ним"; 
		Иначе
			ОбластьСовместно.Параметры.Ним         = "ним (ней)";
		КонецЕсли;
		ДокументРезультат.Вывести(ОбластьСовместно);
		
		НомерСтроки = 1;
		Для каждого стр Из Объект.ТаблицаПроживающих Цикл
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ОбластьСтрока.Параметры.НомерПункта = НомерСтроки;
			ОбластьСтрока.Параметры.ФИО = стр.ФизЛицо;
			ОбластьСтрока.Параметры.СтепеньРодства = стр.бит_СтепеньРодства;
			ОбластьСтрока.Параметры.ДатаРождения = Формат(стр.ФизЛицо.ДатаРождения, "ДФ=dd.MM.yyyy") + " г.р";
			Если ЗначениеЗаполнено(стр.бит_ДатаРегистрации) Тогда
				ОбластьСтрока.Параметры.ДатаРегистрации = ", с " + Формат(стр.бит_ДатаРегистрации, "ДФ=dd.MM.yyyy");
				//ОбластьСтрока.Параметры.Текст = ", - по месту жительства с";	
				Если ЗначениеЗаполнено(стр.бит_ДатаСнятияСРегистрации) Тогда
					ОбластьСтрока.Параметры.ДатаСнятияСРегистрации =  "" + " по " +Формат(стр.бит_ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy");	
				КонецЕсли;
			КонецЕсли; 
			
			ДокументРезультат.Вывести(ОбластьСтрока);
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ОбластьПодвал.Параметры.Заполнить(ПараметрыОтчета);
	ОбластьПодвал.Параметры.ДолжностьПаспортист  =  "Паспортист";
	ОбластьПодвал.Параметры.Паспортист =  ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Объект.Ответственный.Наименование);
	
	ОбластьПодвал.Параметры.СправкаДанаДляПредоставления = Объект.бит_ДляПредъявления;
	ДокументРезультат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

Процедура бит_ЗаполнитьСправкуПоТребованию(ДокументРезультат, ПараметрыОтчета)
	
	Макет = Документы.бит_СправкиПаспортногоСтола.ПолучитьМакет("бит_ПоТребованию");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Здание.Участок.ТелефоныПаспортиста КАК ЗданиеУчастокТелефоныПаспортиста
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ЛицевойСчет);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ОбластьШапка.Параметры.ТелефонПС   	= ВыборкаДетальныеЗаписи.ЗданиеУчастокТелефоныПаспортиста;
	КонецЕсли;
	СтруктураДанных = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Объект.Организация, Объект.Дата);
	ОбластьШапка.Параметры.Организация       = СтруктураДанных.НаименованиеДляПечатныхФорм;
	ОбластьШапка.Параметры.ОрганизацияИННКПП = "ИНН\КПП: " + Строка(СтруктураДанных.ИНН)+"\"+Строка(СтруктураДанных.КПП);
	ОбластьШапка.Параметры.РС                = "№"+Строка(СтруктураДанных.НомерСчета)+", "+Строка(СтруктураДанных.Банк)+"\"+Строка(СтруктураДанных.КоррСчет)+"\"+Строка(СтруктураДанных.БИК);
	
	ОбластьШапка.Параметры.АдресОрганизации  = СтруктураДанных.ФактическийАдрес;
	ОбластьШапка.Параметры.Телефон           = СтруктураДанных.Телефоны;
	
	ОбластьШапка.Параметры.Номер			= ПараметрыОтчета.Номер;
	ОбластьШапка.Параметры.ЛС 				= Объект.ЛицевойСчет;
	ОбластьШапка.Параметры.ДатаВыдачи		= Формат(ПараметрыОтчета.Период, "ДЛФ=DD");
	ОбластьШапка.Параметры.Проживающий		= ПараметрыОтчета.Проживающий;
	ОбластьШапка.Параметры.ДатаРождения		= Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.АдресПроживающего= ПараметрыОтчета.Адрес;
	
	Если Объект.бит_ВыводитьПаспортныеДанные = Истина Тогда
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Период"     , ПараметрыОтчета.Период);
		Запрос.УстановитьПараметр("ЛицевойСчет", ПараметрыОтчета.ЛицевойСчет);
		Запрос.УстановитьПараметр("Проживающий", ПараметрыОтчета.Проживающий);
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
		|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
		|	бит_ПаспортныеДанныеПроживающих.Период КАК Период,
		|	бит_ПаспортныеДанныеПроживающих.ДокументВид КАК ДокументВид,
		|	бит_ПаспортныеДанныеПроживающих.ДокументСерия КАК ДокументСерия,
		|	бит_ПаспортныеДанныеПроживающих.ДокументНомер КАК ДокументНомер,
		|	бит_ПаспортныеДанныеПроживающих.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
		|	бит_ПаспортныеДанныеПроживающих.ДокументКемВыдан КАК ДокументКемВыдан,
		|	бит_ПаспортныеДанныеПроживающих.ДокументПричинаЗамены КАК ДокументПричинаЗамены,
		|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
		|			&Период,
		|			ФизЛицо = &Проживающий
		|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих КАК бит_ПаспортныеДанныеПроживающих
		|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ПаспортныеДанныеПроживающих.ФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДокументДатаВыдачи УБЫВ
		|ИТОГИ
		|	МАКСИМУМ(ДатаРегистрации)
		|ПО
		|	ФизЛицо";
		
		ВыборкаФизЛицо = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Если ВыборкаФизЛицо.Следующий() Тогда
			
			//ОбластьШапка.Параметры.ДатаРегистрации = Формат(ВыборкаФизЛицо.ДатаРегистрации, "ДФ=dd.MM.yyyy");
			//
			//Если ЗначениеЗаполнено(ВыборкаФизЛицо.ДатаСнятияСРегистрации) Тогда
			//	ОбластьШапка.Параметры.ДатаСнятияСРегистрации = "" + " по " + Формат(ВыборкаФизЛицо.ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy");	
			//КонецЕсли; 
			
			Выборка = ВыборкаФизЛицо.Выбрать();
			
			Количество = Выборка.Количество();
			
			КолДокуметов = 0;
			
			УдостовирениеЛичности = " ";
			
			Пока Выборка.Следующий() Цикл
				
				КолДокуметов = КолДокуметов + 1;
				
				УдостовирениеЛичности = УдостовирениеЛичности 
				+ Выборка.ДокументВид 
				+ " сер. "  + ?(ПустаяСтрока(Выборка.ДокументСерия),"...",Выборка.ДокументСерия)
				+ " №"      + ?(ПустаяСтрока(Выборка.ДокументНомер),"...",Выборка.ДокументНомер) 
				+ ", выд. " + Формат(Выборка.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy")
				+ " " + Выборка.ДокументКемВыдан 
				+ ?(ПустаяСтрока(Выборка.ДокументПричинаЗамены),"", ", выдан " + Выборка.ДокументПричинаЗамены);
				Если НЕ Количество = КолДокуметов Тогда
					
					УдостовирениеЛичности = УдостовирениеЛичности + ", взамен ";
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
		ОбластьШапка.Параметры.ПаспортныеДанные = УдостовирениеЛичности + ", ";
		
	КонецЕсли;
	
	Если ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
		//ОбластьШапка.Параметры.Он         = "она";
		//ОбластьШапка.Параметры.Ним         = "ней";
		ОбластьШапка.Параметры.Был         = "была";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирована";	
	ИначеЕсли ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда		
		//ОбластьШапка.Параметры.Он         = "он";
		//ОбластьШапка.Параметры.Ним         = "ним";
		ОбластьШапка.Параметры.Был         = "был";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирован";	
	Иначе
		//ОбластьШапка.Параметры.Ним         = "ним (ней)";
		//ОбластьШапка.Параметры.Он         = "он(а)";
		ОбластьШапка.Параметры.Был         = "был(а)";
		ОбластьШапка.Параметры.Зарегистрирован = "зарегистрирован(а)";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"           , ПараметрыОтчета.Период);
	Запрос.УстановитьПараметр("ЛицевойСчет"      , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо"      , ПараметрыОтчета.Проживающий);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК Проживающий,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры КАК ВладелецКвартиры,
	|	ПроживающиеПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК ДоляПлощади,
	|	ПроживающиеПоЛССрезПоследних.лб_СтрокаРодствДляФЛС КАК лб_СтрокаРодствДляФЛС,
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	ПроживающиеПоЛССрезПоследних.бит_ПомещенВАрхив КАК бит_ПомещенВАрхив
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И НЕ лб_ИгнорироватьПериодВКопииФЛС
	|				И ФизЛицо = &ФизЛицо) КАК ПроживающиеПоЛССрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатусФизЛица УБЫВ,
	|	ДатаРегистрации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОбластьШапка.Параметры.ДатаРегистрации = Формат(Выборка.ДатаРегистрации, "ДФ=dd.MM.yyyy");
		
		Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
			ОбластьШапка.Параметры.ДатаСнятияСРегистрации = "" + " по " + Формат(Выборка.ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy");	
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Если Объект.ТаблицаПроживающих.Количество() > 0 И Объект.ИспользоватьОтборПроживающих = Истина Тогда
		
		ОбластьСовместно = Макет.ПолучитьОбласть("Совместно");
		Если ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
			ОбластьСовместно.Параметры.Ним         = "ней";
		ИначеЕсли ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда		
			ОбластьСовместно.Параметры.Ним         = "ним"; 
		Иначе
			ОбластьСовместно.Параметры.Ним         = "ним (ней)";
		КонецЕсли;
		
		ДокументРезультат.Вывести(ОбластьСовместно);
		
		НомерСтроки = 1;
		Для каждого стр Из Объект.ТаблицаПроживающих Цикл
			
			ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
			ОбластьСтрока.Параметры.НомерПункта = НомерСтроки;
			ОбластьСтрока.Параметры.ФИО = стр.ФизЛицо;
			ОбластьСтрока.Параметры.СтепеньРодства = стр.бит_СтепеньРодства;
			ОбластьСтрока.Параметры.ДатаРождения = Формат(стр.ФизЛицо.ДатаРождения, "ДФ=dd.MM.yyyy") + " г.р";
			
			Если ЗначениеЗаполнено(стр.бит_ДатаСнятияСРегистрации) Тогда
				
				Если ЗначениеЗаполнено(стр.бит_ДатаРегистрации) Тогда
					ОбластьСтрока.Параметры.ДатаРегистрации = ", с " + Формат(стр.бит_ДатаРегистрации, "ДФ=dd.MM.yyyy");
					//ОбластьСтрока.Параметры.Текст = ", - по месту жительства с";	
				КонецЕсли;
				
				ОбластьСтрока.Параметры.ДатаСнятияСРегистрации =  "" + " по " +Формат(стр.бит_ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy");	
				
			КонецЕсли;
			
			ДокументРезультат.Вывести(ОбластьСтрока);
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ОбластьПодвал.Параметры.ДолжностьПаспортист  =  "Паспортист";
	ОбластьПодвал.Параметры.Паспортист =  ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Объект.Ответственный.Наименование);
	
	ОбластьПодвал.Параметры.СправкаДанаДляПредоставления = Объект.бит_ДляПредъявления;
	ДокументРезультат.Вывести(ОбластьПодвал);	
	
КонецПроцедуры

