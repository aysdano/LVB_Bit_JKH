				Запрос.УстановитьПараметр("Объект"  , СпрЛС.Ссылка);
				Запрос.УстановитьПараметр("Квартира", Квартира); 
				Запрос.Текст = ТекстИндивидуальныеСчетчики;
			КонецЕсли; 
			
			ВыборкаСЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			
			Пока ВыборкаСЧ.Следующий() Цикл
				
				
				ТекПоказания = Стр.Показатель;
				Показания    = 0;
				Выборка   = ВыборкаСч.Выбрать();
				ПерваяСтрока = Истина;
				
				Пока Выборка.Следующий() Цикл
					// Проверка
					Если сокрЛП(Стр.ИмяСчетчика) <> СокрЛП(Выборка.Услуга) И Выборка.Многотарифный Тогда
						// ТекПоказания = 0;
						Продолжить; 
						
					КонецЕсли;
					//Если Число(ТекПоказания) < Выборка.ПредыдущиеПоказания Тогда Продолжить; КонецЕсли;
					
					
					Если ПерваяСтрока Тогда
						
						// Строка = ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиПоИдентификатору(1);
						Строка = ДокументВводПоказаний.ПоказанияПоСчетчикам.Добавить();
						
