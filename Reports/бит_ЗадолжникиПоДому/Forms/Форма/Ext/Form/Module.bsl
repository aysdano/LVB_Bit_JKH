	РезультатЗапроса = ОсновнойЗапрос.Выполнить().Выгрузить();
	
	Для каждого СтрокаРез Из РезультатЗапроса Цикл
	
		ЧастиНомераКвартиры = ОтделениеЧисловойЧастиОтПрочего(СокрЛП(Строка(СтрокаРез.Квартира)));
		СтрокаРез.СтрокаСортировки = ?(ЧастиНомераКвартиры.ЧисловаяЧ="",9999,Число(ЧастиНомераКвартиры.ЧисловаяЧ));
	
	КонецЦикла; 
	
	РезультатЗапроса.Сортировать("СтрокаСортировки, Здание, Подъезд");
	
	Возврат РезультатЗапроса;
	
