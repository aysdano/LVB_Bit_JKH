						Если УменьшитьНормуЛьготы Тогда
							
							КолЧелРасчет = ?((Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению)
							И НЕ Выборка.ФактПотребПоСЧБезУчетаВременноПрож,
							КоличествоПроживающих,
							КоличествоПоНормеЛьгота);
							
							// БИТ_ЖКХ 22.12.2011
							// Временное решение проблемы деления на 0.
							КолЧелРасчет = ?(КолЧелРасчет = 0, 1, КолЧелРасчет);
							
							Норма = ?(Норма > Выборка.Факт/КолЧелРасчет, Выборка.Факт/КолЧелРасчет, Норма);
							
							// БИТ_ЖКХ_07102013_начало_изменений
							//добавлено условие если начислено < норматива (общедомовые расходы) тогда считаем по начислено
							//иначе (нет уменьшения за счет отрицательных общедомовых расходов) тогда считаем по нормативу
							Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим Тогда
								Если Выборка.Начислено < Выборка.Норматив Тогда
									Начислено = Выборка.Начислено/КолЧелРасчет;
								Иначе
									Начислено = Выборка.Норматив/КолЧелРасчет;
								КонецЕсли;
							КонецЕсли;
							// БИТ_ЖКХ_07102013_окончание_изменений
							
						Иначе
							Норма = ?(Норма > Выборка.Факт, Выборка.Факт, Норма);
						КонецЕсли;   
						
						Если РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика И Выборка.Многотарифный Тогда
							
