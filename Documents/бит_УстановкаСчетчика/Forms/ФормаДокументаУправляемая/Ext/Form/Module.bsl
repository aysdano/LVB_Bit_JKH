		КонецЕсли;	
		Начисления  = мНорма * Выборка.Ставка + мСверхНорма * Выборка.СверхномСтавка;
		
		Сумма = Начисления/КолДнейВМесяце*КолДнейОтНачалаМесяца;
		
		СтрокаТЗ = ТаблицаУслуг.Добавить();
		СтрокаТЗ.Услуга = Выборка.Услуга;
		СтрокаТЗ.Сумма  = Сумма;
		
	КонецЦикла;
	
	// БИТ_ЖКХ добавление кода Начало: 03.08.2010 
	ТаблицаУслуг.Свернуть("Услуга", "Сумма");
	// БИТ_ЖКХ добавление кода конец : 03.08.2010
	
	Возврат ТаблицаУслуг;
	
КонецФункции

&НаСервере
// Процедура создает и заполняет документ "Разовые по услугам ЖКХ".
//
Процедура СоздатьДокумент(СсылкаНаНовыйДокумент = Неопределено)
	
	ТаблУслуг = Объект.Услуги.Выгрузить();
	
	СписокУслуг = Новый СписокЗначений;
	СписокУслуг.ЗагрузитьЗначения(ТаблУслуг.ВыгрузитьКолонку("Услуга"));
	
	Если НЕ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.СнятиеСчетчика Тогда
		
		ПроверитьНаличиеСчетчиков(СписокУслуг);
		
	КонецЕсли; 
	
	Если СписокУслуг.Количество() = 0 Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	НовДокумент = Документы.бит_РазовыеПоУслугамЖКХ.СоздатьДокумент();
	
	НовДокумент.Дата          = Объект.Дата;
	НовДокумент.ЛицевойСчет   = Объект.Объект;
	
	НовДокумент.Ответственный = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
	
	НовДокумент.Документ      = Параметры.Ключ;
	
	// БИТ_ЖКХ 19.09.2016 15:48:39 Начало правки... 
	//НовДокумент.Организация   = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");
	НовДокумент.Организация   = Объект.Организация;
	// БИТ_ЖКХ 19.09.2016 15:48:40 Конец правки. 
	
	НачисленияПоТарифам   = НачисленияПоТарифам(СписокУслуг);
	
	бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(НачисленияПоТарифам);
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(НачисленияПоТарифам, НачисленияПоТарифам.Колонки, Объект.Объект, бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация"), Объект.Дата);
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика Тогда
		
		НовДокумент.ВидОперации   = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПриУстановкеСчетчика;
		
		Для Каждого Строка из НачисленияПоТарифам Цикл
			
			Если НЕ Строка.Сумма = 0 Тогда
				
				НовСтрока        = НовДокумент.СписокУслуг.Добавить();
				ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
				НовСтрока.Услуга = Строка.Услуга;
				НовСтрока.Сумма  = Строка.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		НовДокумент.ВидОперации   = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПриСнятииСчетчика;
		
		Запрос = Новый Запрос;
		
		Запрос.УстановитьПараметр("Дата"    , КонецДня(Объект.Дата));
		Запрос.УстановитьПараметр("Квартира", Объект.Объект.Квартира);
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
		|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры
		|ИЗ
		|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда 
			
			НачисленияПоСчетчикам = НачисленияПоСчетчикам(Выборка.СтатусКвартиры,Выборка.ТипКвартиры,СписокУслуг);
			
			бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(НачисленияПоСчетчикам);
			
			бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(НачисленияПоСчетчикам, НачисленияПоСчетчикам.Колонки, Объект.Объект, бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация"), Объект.Дата);
			
		КонецЕсли;
		
		Для Каждого Строка Из НачисленияПоСчетчикам Цикл
			
			СтрокаТарифа = НачисленияПоТарифам.Найти(Строка.Услуга,"Услуга");
			
			Если СтрокаТарифа <> Неопределено Тогда
				
				тмпСумма = Строка.Начисления - ?(Строка.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
				,0,СтрокаТарифа.Сумма);
				
				Если НЕ тмпСумма = 0 Тогда
					
					НовСтрока = НовДокумент.СписокУслуг.Добавить();
					ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
					
					НовСтрока.Услуга = Строка.Услуга;
					
					НовСтрока.Сумма  = тмпСумма;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла;
		
	КонецЕсли;
	
	ДействиеВыполнено = бит_ОбщегоНазначения.ЗаписатьПровестиДокумент(НовДокумент, РежимЗаписиДокумента.Проведение,"Разовые по услугам ЖКХ.");
	
	Если ДействиеВыполнено Тогда
		
		СсылкаНаНовыйДокумент = НовДокумент.Ссылка;
		
	КонецЕсли;
	
КонецПроцедуры

