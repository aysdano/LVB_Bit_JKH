//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ПолныйСтраница2(ПараметрыОтчета, ТабличныйДокумент, СведенияОбЛС)
	
	Макет = ПолучитьМакет("ФинансовоЛицевойСчет");
	
	ШапкаОборот = Макет.ПолучитьОбласть("ШапкаОборот");
	ШапкаОборот.Параметры.НомерЛС      = СведенияОбЛС.ЛицевойСчет;
	ШапкаОборот.Параметры.Организация  = СведенияОбЛС.Организация;
	ШапкаОборот.Параметры.ДД    = Формат(ПараметрыОтчета.КонецПериода,"ДФ=dd");
	ШапкаОборот.Параметры.месяц = Формат(ПараметрыОтчета.КонецПериода,"ДФ=ММMM");
	ШапкаОборот.Параметры.ГГГГ  = Формат(ПараметрыОтчета.КонецПериода,"ДФ=yyyy");
	
	ТабличныйДокумент.Вывести(ШапкаОборот);
	
	ШапкаУслуги         = Макет.ПолучитьОбласть("ШапкаУслуги");
	ШапкаУслуга         = Макет.ПолучитьОбласть("ШапкаУслуга");
	ШапкаУслуг          = Макет.ПолучитьОбласть("ШапкаУслг");
	СтрокаМесяцГод      = Макет.ПолучитьОбласть("СтрокаМесяцГод");
	СтрокаМесяцГодКол   = Макет.ПолучитьОбласть("СтрокаМесяцГодКол");
	СтрокаВидНачисления = Макет.ПолучитьОбласть("СтрокаВидНачисления");
	СтрокаУслугаВидНач  = Макет.ПолучитьОбласть("СтрокаУслугаВидНач");
	СтрокаУслуга        = Макет.ПолучитьОбласть("СтрокаУслуга");
	СтрокаВидНачКол     = Макет.ПолучитьОбласть("СтрокаВидНачКол");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода" , КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет"  , ПараметрыОтчета.ЛицевойСчет);
	Запрос.Текст = ПолучитьТекстЗапросаПолный();
	
	Результат = Запрос.Выполнить(); 
	
	ТабличныйДокумент.Вывести(ШапкаУслуги);
	
	ВыборкаУслуга = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Услуга");
	
	Пока ВыборкаУслуга.Следующий() Цикл
		
		ШапкаУслуга.Параметры.Заполнить(ВыборкаУслуга);
		ТабличныйДокумент.Присоединить(ШапкаУслуга );
		
	КонецЦикла;
	
	ТабличныйДокумент.Присоединить(ШапкаУслуг);
	
	ТаблицаОстатков = ПолучитьОстаткиПоПериодам(ПараметрыОтчета);
	
	ВыборкаМесяцГод = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "МесяцГод");
	
	КОплате = 0;
	
	Пока ВыборкаМесяцГод.Следующий() Цикл
		
		СтрокаМесяцГод.Параметры.Заполнить(ВыборкаМесяцГод);
		
		Отбор = Новый Структура;
		СтрокаПоиска = ТаблицаОстатков.Найти(ВыборкаМесяцГод.МесяцГод, "МесяцГод");
		
		Если НЕ СтрокаПоиска = Неопределено Тогда
			ВХСальдо  = СтрокаПоиска.ВХСальдо;
			ИСХСальдо = СтрокаПоиска.ИСХСальдо;
		Иначе
			ВХСальдо  = 0;
			ИСХСальдо = 0;
		КонецЕсли; 
		
		Если ВыборкаМесяцГод.МесяцГод = НачалоМесяца(ПараметрыОтчета.НачалоПериода) Тогда
			КОплате = КОплате + ВХСальдо;
		КонецЕсли; 
		
		СтрокаМесяцГод.Параметры.ВХСальдо  = ВХСальдо;
		
		ТаблицаПроживающих = ПолучитьТаблицуПроживающих(КонецМесяца(Дата(ВыборкаМесяцГод.МесяцГод)), ПараметрыОтчета.ЛицевойСчет);
		Ответственный         = Справочники.бит_Проживающие.ПустаяСсылка();
		КоличествоПроживающих = 0;
		
		Для каждого СтрокаТабилцы Из ТаблицаПроживающих Цикл
			
			Если СтрокаТабилцы.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
				Ответственный = СтрокаТабилцы.ФизЛицо;
			КонецЕсли; 
			
			Если СтрокаТабилцы.СтатусФизЛица.ПроживаниеВДанныйМомент Тогда
				КоличествоПроживающих = КоличествоПроживающих + 1;
			КонецЕсли; 
			
		КонецЦикла; 
		
		СтрокаМесяцГод.Параметры.Ответственный = Ответственный;
		
		ТабличныйДокумент.Вывести(СтрокаМесяцГод,ВыборкаМесяцГод.Уровень(), "МесяцГод");
		
		ВыборкаУслуга = ВыборкаМесяцГод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Услуга", "ВСЕ");
		
		Пока ВыборкаУслуга.Следующий() Цикл
			СтрокаУслуга.Параметры.Заполнить(ВыборкаУслуга);
			ТабличныйДокумент.Присоединить(СтрокаУслуга);
		КонецЦикла;
		
		СтрокаМесяцГодКол.Параметры.Заполнить(ВыборкаМесяцГод);
		
		СтрокаМесяцГодКол.Параметры.ИСХСальдо  = ИСХСальдо;
		
		СтрокаМесяцГодКол.Параметры.Количество = КоличествоПроживающих;
		ТабличныйДокумент.Присоединить(СтрокаМесяцГодКол);
		
		ВыборкаВидНач = ВыборкаМесяцГод.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "ВидНачисления");
		Пока ВыборкаВидНач.Следующий() Цикл 
			
			СтрокаВидНачисления.Параметры.Заполнить(ВыборкаВидНач);
			ТабличныйДокумент.Вывести(СтрокаВидНачисления);
			
			ВыборкаУслугаВидНач = ВыборкаВидНач.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "Услуга", "ВСЕ");
			ИтогоСумма = 0;
			Пока ВыборкаУслугаВидНач.Следующий() Цикл
				СтрокаУслугаВидНач.Параметры.Заполнить(ВыборкаУслугаВидНач);
				ТабличныйДокумент.Присоединить(СтрокаУслугаВидНач);
				ИтогоСумма = ИтогоСумма + ?(ВыборкаУслугаВидНач.Сумма = Null,0,ВыборкаУслугаВидНач.Сумма);
			КонецЦикла;
			
			Если ВыборкаМесяцГод.МесяцГод = НачалоМесяца(ПараметрыОтчета.НачалоПериода) Тогда
				КОплате = КОплате + ВыборкаВидНач.Сумма;
			КонецЕсли;
			
			// Сюда положить ИСХ сальдо.
			СтрокаВидНачКол.Параметры.Заполнить(ВыборкаВидНач);
			СтрокаВидНачКол.Параметры.Итого = ИтогоСумма;
			ТабличныйДокумент.Присоединить(СтрокаВидНачКол);
			
		КонецЦикла;
		
	КонецЦикла;
	
	КОплате = ?(КОплате < 0, 0, КОплате);
	
	ПодвалОборот = Макет.ПолучитьОбласть("ПодвалОборот");
	ПодвалОборот.Параметры.ДатаФормОтчета = Формат(КонецМесяца(ПараметрыОтчета.КонецПериода),"ДФ=dd.MM.yyyy");
	ПодвалОборот.Параметры.Сумма = ?(ПараметрыОтчета.СУчетомПереплаты, ИСХСальдо, ДолгОстаток(ПараметрыОтчета));
	// БИТ_ЖКХ_05082013_начало_изменений
	ОтветственныеЛица = бит_ОбщегоНазначения.бит_ОтветственныеЛица(СведенияОбЛС.Организация, КонецДня(ПараметрыОтчета.КонецПериода));
	ПодвалОборот.Параметры.РуководительРасчетнойСлужбы = ?(ОтветственныеЛица.РуководительРасчетнойСлужбы = Неопределено, "",ОтветственныеЛица.РуководительРасчетнойСлужбы);
	ПодвалОборот.Параметры.Специалист = ?(ОтветственныеЛица.Специалист = Неопределено, "",ОтветственныеЛица.Специалист);
	ПодвалОборот.Параметры.РуководительРасчетнойСлужбыДолжность = ?(ОтветственныеЛица.РуководительРасчетнойСлужбыДолжность = Неопределено, "Руководитель расчетной службы",ОтветственныеЛица.РуководительРасчетнойСлужбыДолжность);
	ПодвалОборот.Параметры.СпециалистДолжность   = ?(ОтветственныеЛица.СпециалистДолжность = Неопределено, "Специалист",ОтветственныеЛица.СпециалистДолжность);
	// БИТ_ЖКХ_05082013_начало_изменений
	ТабличныйДокумент.Вывести(ПодвалОборот);
	
КонецПроцедуры // ()


