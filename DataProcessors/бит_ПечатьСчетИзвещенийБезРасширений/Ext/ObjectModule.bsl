	//УслугаАванс   	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000002");
	//УслугаГазоснабжение = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000017");
	//УслугаВО     	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000015");
	//УслугаГВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000011");
	//УслугаХВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000012");
	//УслугаЭЭ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");
	//УслугаХВВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000023");
	//УслугаПени    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000003");
	
	УслугаМинВзнос      = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");//+
	УслугаДопВзнос      = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000014");//+
	УслугаРФКР          = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000009");//+
	УслугаСодРем        = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001");//+
	УслугаАверс         = Справочники.бит_УслугиЖКХ.ПустаяСсылка();
	УслугаПрофи         = Справочники.бит_УслугиЖКХ.ПустаяСсылка();
	УслугаДоп           = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000007");//+
	УслугаОДПУ          = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000008");
	УслугаДомофон       = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000006");//+
	УслугаОргФКР        = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000011");//+
	УслугаАванс   	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000002");
	УслугаГазоснабжение = Справочники.бит_УслугиЖКХ.ПустаяСсылка();
	УслугаВО     	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000005");//+
	УслугаГВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000003");//+
	УслугаХВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000004");//+
	УслугаЭЭ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000002");//+
	УслугаХВВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000023");
	УслугаПени    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000003");
	
	ТелефонАверс = ПолучитьТелефоныАнтенны(УслугаАверс);
	ТелефонПрофи = ПолучитьТелефоныАнтенны(УслугаПрофи);
	
	МассивСодержание = Новый Массив;
	МассивСодержание.Добавить(УслугаСодРем);
	МассивСодержание.Добавить(УслугаВО);
	МассивСодержание.Добавить(УслугаГВ);
	МассивСодержание.Добавить(УслугаХВ);
	МассивСодержание.Добавить(УслугаЭЭ);
	
	ВсеЛС = Ложь;
	ИспользоватьОтборЛС 	 = Ложь;
	ИспользоватьОтборЗдание  = Ложь;
	ИспользоватьОтборУлица 	 = Ложь;
	ИспользоватьОтборУчасток = Ложь;
	НежилоеПомещение = Справочники.бит_ТипыКвартиры.НайтиПоКоду("000000000003");
	ДатаКвитанции = ?(Период > ТекущаяДата(), ТекущаяДата(), Период);
	
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	МакетКвитанции = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("ДолговаяКвитанция");
	
	Если СписокЛС.Количество() = 0 И СписокЗданий.Количество() = 0 
		И СписокУлиц.Количество() = 0 И СписокУчастков.Количество() = 0 Тогда
		
		ВсеЛС 					 = Истина;
	Иначе
		
		Если СписокЛС.Количество() > 0 Тогда
			ИспользоватьОтборЛС = Истина;
			ОтборЛС = ПреобразоватьТЗВМассив(СписокЛС.Выгрузить(), 2);
		КонецЕсли;
		
		Если СписокЗданий.Количество() > 0 Тогда
			ИспользоватьОтборЗдание = Истина;
			ОтборЗдание = ПреобразоватьТЗВМассив(СписокЗданий.Выгрузить());
		КонецЕсли;
		
		Если СписокУлиц.Количество() > 0 Тогда
			ИспользоватьОтборУлица = Истина;
			ОтборУлица = ПреобразоватьТЗВМассив(СписокУлиц.Выгрузить());
		КонецЕсли;
		
		Если СписокУчастков.Количество() > 0 Тогда
			ИспользоватьОтборУчасток = Истина;
			ОтборУчасток = ПреобразоватьТЗВМассив(СписокУчастков.Выгрузить());
		КонецЕсли;
		
	КонецЕсли;
	
	Если ШаблонИзвещений.Услуги.Количество() = 0 Тогда
		ПоВсемУслугам = Истина;
		ЕстьДомофон = Истина;
		ТекстУслуги = "";
	Иначе
		ПоВсемУслугам = Ложь;
		МассивУслуг = ПреобразоватьТЗВМассив(ШаблонИзвещений.Услуги.Выгрузить());
		ЕстьДомофон = МассивУслуг.Найти(УслугаДомофон) <> Неопределено;
		ТекстУслуги = " И УслугаЖКХ В (&СписокУслуг)";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ТекстОтбор = "";
	
	Если НЕ ВсеЛС Тогда
		
		Если ИспользоватьОтборЛС Тогда
			ТекстОтбор = ТекстОтбор + "
			|	И бит_ЛицевыеСчета.Ссылка В(&СписокЛС)";
			Запрос.УстановитьПараметр("СписокЛС", ОтборЛС);
		КонецЕсли;	
		
		Если ИспользоватьОтборЗдание Тогда
			ТекстОтбор = ТекстОтбор + "
			|	И бит_ЛицевыеСчета.Здание В(&СписокЗданий)";
			Запрос.УстановитьПараметр("СписокЗданий", ОтборЗдание);
		КонецЕсли;
		
		Если ИспользоватьОтборУлица Тогда
			ТекстОтбор = ТекстОтбор + "
			|	И бит_ЛицевыеСчета.Здание.Улица В(&СписокУлиц)";			
			Запрос.УстановитьПараметр("СписокУлиц", ОтборУлица);	
		КонецЕсли;
		
		Если ИспользоватьОтборУчасток Тогда
			ТекстОтбор = ТекстОтбор + "
			|	И бит_ЛицевыеСчета.Здание.Участок В(&СписокУчастков)";			
			Запрос.УстановитьПараметр("СписокУчастков", ОтборУчасток);	
		КонецЕсли;
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("НежилоеПомещение", НежилоеПомещение);
	Запрос.УстановитьПараметр("Период", ДатаКвитанции);
	Запрос.УстановитьПараметр("ШаблонКвитанции", МакетКв);
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Здание КАК Здание,
	|	бит_ЛицевыеСчета.Квартира КАК Квартира,
	|	бит_СведенияОКвартиреСрезПоследних.лб_НеВыводитьСтрокуДомофон КАК НеВыводитьДомофон,
	|	лб_ОтветственныеЗаЛицевыеСчета.Ответственный КАК Ответственный,
	|	лб_Тест_Дома.ADR КАК ЗданиеПредставление,
	|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК КвартираПредставление,
	|	бит_ЛицевыеСчета.Организация.НаименованиеСокращенное КАК Организация,
	|	бит_ЛицевыеСчета.Организация КАК ОрганизацияСсылка,
	|	бит_ЛицевыеСчета.Организация.ИНН КАК ИНН,
	|	бит_ЛицевыеСчета.Организация.КПП КАК КПП,
	|	бит_ЛицевыеСчета.Организация.ОсновнойБанковскийСчет.Ссылка КАК РасчетныйСчетСсылка,
	|	бит_ЛицевыеСчета.Организация.ОсновнойБанковскийСчет.Банк.Код КАК БИК,
	|	бит_ЛицевыеСчета.Организация.ОсновнойБанковскийСчет.НомерСчета КАК рСчет,
	|	бит_ЛицевыеСчета.Организация.ОсновнойБанковскийСчет.Банк.Наименование КАК Банк,
	|	бит_ЛицевыеСчета.Организация.ОсновнойБанковскийСчет.Банк.КоррСчет КАК кСчет,
	|	ЕСТЬNULL(бит_НадписьКвитанцииСрезПоследних.ОсновнаяНадпись, бит_НадписьКвитанцииСрезПоследнихПустая.ОсновнаяНадпись) КАК ТекстКвитанции,
	|	ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 4) + "" "" + ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 5, 7) КАК НомерЛС,
	|	бит_ЛицевыеСчета.Наименование КАК ЛСНомер,
	|	бит_ЛицевыеСчета.Здание.Участок.ТелефоныУчастка КАК Телефоны,
	|	ВложенныйЗапрос.ТелефоныОрганизация КАК ТелефоныОрганизация
	|ИЗ
