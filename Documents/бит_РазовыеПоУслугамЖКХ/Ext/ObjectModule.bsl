#Область ОбеспечениеПроведенияДокумента

// Проверяет правильность заполнения шапки документа.
// Если какой-то из реквизтов шапки, влияющий на проведение не заполнен или.
// Заполнен не корректно, то выставляется флаг отказа в проведении.
// Проверяется также правильность заполнения реквизитов ссылочных полей документа.
// Проверка выполняется по объекту и по выборке из результата запроса по шапке.
//
// Параметры:: 
//  СтруктураШапкиДокумента - выборка из результата запроса по шапке документа,
//  Отказ                   - флаг отказа в проведении,
//  Заголовок               - строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок)
	
	ОбязательныеРеквизитыШапки = "Организация"+ ?(ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПоГрупповымСчетчикамСНаличиемИндивидуальных
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое 
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое
	// БИТ ЖКХ 10.03.2020
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды
	// БИТ ЖКХ 12.03.2020
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетСтраховыхДобровольныхВзносов
	//Михайлов
	Или ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавки
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетПоЕдиницамПотребленияГрупповое
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавкиЗаменаСтавки
	//Конец работ
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое 
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоЧекуККМ
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратОплаты
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПереносОстатков,"", ",ЛицевойСчет");
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоЧекуККМ Тогда
		ОбязательныеРеквизитыШапки = ОбязательныеРеквизитыШапки + ",ЧекККМ";
	ИначеЕсли ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратОплаты ТОгда
		ОбязательныеРеквизитыШапки = ОбязательныеРеквизитыШапки + ",ОплатаКУ";
	КонецЕсли; 
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ГрупповыеПерерасчетыОДН Тогда
		ОбязательныеРеквизитыШапки = "Организация"; //Дорошенко А.Ю 22.02.2023
	КонецЕсли;
	
	СтруктураОбязательныхПолей = Новый Структура(ОбязательныеРеквизитыШапки);
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры

// Процедура проверяет правильность заполнения реквизитов документа
//
Процедура ПроверкаРеквизитовТЧ(ТаблицаОС,СтруктураШапкиДокумента,Отказ, Заголовок) Экспорт
	
	БылОтказ = Отказ;
	РеквизитыТабСписокУслуг = "Услуга"
	+?(ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое 
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое
	// БИТ ЖКХ 10.03.2020
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды
	// БИТ ЖКХ 10.03.2020
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетСтраховыхДобровольныхВзносов
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоЧекуККМ
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратОплаты
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПереносОстатков,",ЛицевойСчет",""); // Через запятую.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "СписокУслуг", Новый Структура(РеквизитыТабСписокУслуг), Отказ, Заголовок);
	
	//18.07.2019
	Если УдалятьСтрокиСПустойСуммой = истина Тогда
		УдалитьСтроки();
	конецесли;
	
	Если Отказ Тогда
		
		Отказ = БылОтказ;
		Если УдалятьСтрокиСПустойСуммой = истина Тогда
		 УдалитьСтроки();	
		 бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Строки с пустыми реквизитами удалены");
		конецесли; 
				
	КонецЕсли; 
	
КонецПроцедуры

// Процедура проверяет правильность заполнения реквизитов документа.
//
Процедура ПроверкаРеквизитовТЧСумма(ТаблицаОС,СтруктураШапкиДокумента,Отказ, Заголовок) Экспорт
	
	БылОтказ = Отказ;
	Для Каждого ТекСтр из СписокУслуг Цикл
		
		Если ТекСтр.Сумма = 0 И ТекСтр.СуммаПени = 0 Тогда
			
			Отказ = Истина;
			
		КонецЕсли;	
		
	КонецЦикла;
	
	//18.07.2019
	Если УдалятьСтрокиСПустойСуммой = истина Тогда
		УдалитьСтроки();
	конецесли;
	
	Если Отказ Тогда
		
		Отказ = БылОтказ;
		Если УдалятьСтрокиСПустойСуммой = истина Тогда
		 УдалитьСтроки();	
		 бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Строки с пустой суммой удалены");
		конецесли; 		
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура Выполняет удаление строк с пустыми значенияями.
Процедура УдалитьСтроки()
	
	КолвоЭлементов = СписокУслуг.Количество();
	
	Для ОбратныйИндекс = 1  По КолвоЭлементов Цикл
		
		Строка = СписокУслуг[КолвоЭлементов - ОбратныйИндекс];
		
		Если (НЕ ЗначениеЗаполнено(Строка.Сумма) И НЕ ЗначениеЗаполнено(Строка.СуммаПени)) ИЛИ (Строка.Сумма = 0 И Строка.СуммаПени = 0) ИЛИ НЕ ЗначениеЗаполнено(Строка.Услуга) Тогда	
			
			СписокУслуг.Удалить(Строка);
			
		ИначеЕсли (ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое  
			ИЛИ	ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое 
			// БИТ ЖКХ 10.03.2020
			ИЛИ	ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды 
			ИЛИ	ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое
			ИЛИ	ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое
			ИЛИ	ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ГрупповыеПерерасчетыОДН) 
			И (НЕ ЗначениеЗаполнено(Строка.ЛицевойСчет)) Тогда
			
			СписокУслуг.Удалить(Строка);
			
		КонецЕсли; 
		
	КонецЦикла; 	
	
КонецПроцедуры

// Процедура проверяет добли строк.
//
Процедура ПроверитьДублиУслуг(ТаблицаПоУслугам, Отказ, Заголовок)
	
	ТаблицаДублей = ТаблицаПоУслугам.Скопировать();
	
	// Подсчитываем количество повторений.
	ТаблицаДублей.Колонки.Добавить("КоличествоПовторений");
	ТаблицаДублей.ЗаполнитьЗначения(1, "КоличествоПовторений");
	ТаблицаДублей.Свернуть(?(ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое 
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое
	// БИТ ЖКХ 10.03.2020
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды
	// БИТ ЖКХ 10.03.2020
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетСтраховыхДобровольныхВзносов
	//Михайлов
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавки
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетПоЕдиницамПотребленияГрупповое
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавкиЗаменаСтавки
	// Конец работ
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоЧекуККМ
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратОплаты
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПереносОстатков,"ЛицевойСчет,","")+"Услуга", "КоличествоПовторений");
	
	// Если количество повторений > 1, выдаем сообщение об ошибке. 
	
	Если ВидОперации <> Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ГрупповыеПерерасчетыОДН Тогда
		
	Если ?(ТаблицаДублей.Количество() > 0, ТаблицаДублей.Итог("КоличествоПовторений") / ТаблицаДублей.Количество(), 0) > 1 Тогда
		
		ТекстСообщенияОбОшибке = "";
		
		
		// Цикл по каждому найденному повторению.
		Для Каждого СтрокаТаблицыДублей Из ТаблицаДублей Цикл
			
			Если СтрокаТаблицыДублей.КоличествоПовторений = 1 Тогда
				Продолжить; // Повторений нет.
			КонецЕсли;
			
			// Добавим перевод строки, если требуется.
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке 
			+ ?(НЕ ЗначениеЗаполнено(ТекстСообщенияОбОшибке), "", "
			|");
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке
			+ "В строках №№ "; 
			
			// Выводим номера строк.
			СписокНомеровСтрок = "";
			МассивСтрок = ТаблицаПоУслугам.НайтиСтроки(?(ТаблицаПоУслугам.Колонки.Найти("ЛицевойСчет") = Неопределено
			,Новый Структура("Услуга", СтрокаТаблицыДублей.Услуга)
			,Новый Структура("ЛицевойСчет,Услуга", СтрокаТаблицыДублей.ЛицевойСчет,СтрокаТаблицыДублей.Услуга )));
			
			//Если Объект.ВидОперации
			Для Каждого Строка Из МассивСтрок Цикл
				СписокНомеровСтрок = СписокНомеровСтрок + ?(НЕ ЗначениеЗаполнено(СписокНомеровСтрок), "", ", ") + Строка.НомерСтроки;
			КонецЦикла;
			
			
			ТекстСообщенияОбОшибке = ?(ТаблицаПоУслугам.Колонки.Найти("ЛицевойСчет") = Неопределено
			,ТекстСообщенияОбОшибке
			+ СписокНомеровСтрок
			+ " табличной части ""Услуга"" указаны одни и те же."
			,ТекстСообщенияОбОшибке
			+ СписокНомеровСтрок
			+ " табличной части ""Лицевой счет"" указаны одни и те же.");
			
		КонецЦикла;
		
		бит_ОбщегоНазначения.ОшибкаПриПроведении(ТекстСообщенияОбОшибке, Отказ, Заголовок);
		
	КонецЕсли; 
	
	КонецЕсли;
	
КонецПроцедуры

// Процедура проверяет добли строк.
//
Процедура ПроверитьДублиЛС(ТаблицаПоЛС, Отказ, Заголовок)
	
	ТаблицаДублей = ТаблицаПоЛС.Скопировать();
	
	// Подсчитываем количество повторений.
	ТаблицаДублей.Колонки.Добавить("КоличествоПовторений");
	ТаблицаДублей.ЗаполнитьЗначения(1, "КоличествоПовторений");
	ТаблицаДублей.Свернуть(?(ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПоГрупповымСчетчикамСНаличиемИндивидуальных 
	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков,
	"Услуга, Счетчик,","")+"ЛицевойСчет", "КоличествоПовторений");
	
	// Если количество повторений > 1, выдаем сообщение об ошибке.
	Если ?(ТаблицаДублей.Количество() > 0, ТаблицаДублей.Итог("КоличествоПовторений") / ТаблицаДублей.Количество(), 0) > 1 Тогда
		
		ТекстСообщенияОбОшибке = "";
		
		// ТаблицаПоЦБ.Индексы.Добавить("Контрагент");.
		
		// Цикл по каждому найденному повторению.
		Для Каждого СтрокаТаблицыДублей Из ТаблицаДублей Цикл
			
			Если СтрокаТаблицыДублей.КоличествоПовторений = 1 Тогда
				Продолжить; // повторений нет.
			КонецЕсли;
			
			// Добавим перевод строки, если требуется.
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке 
			+ ?(НЕ ЗначениеЗаполнено(ТекстСообщенияОбОшибке), "", "
			|");
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке
			+ "В строках №№ "; 
			
			// Выводим номера строк.
			СписокНомеровСтрок = "";
			Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПоГрупповымСчетчикамСНаличиемИндивидуальных 
				ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков  Тогда
				
				МассивСтрок = ТаблицаПоЛС.НайтиСтроки(Новый Структура("ЛицевойСчет, Услуга, Счетчик", 
				СтрокаТаблицыДублей.ЛицевойСчет,
				СтрокаТаблицыДублей.Услуга,
				СтрокаТаблицыДублей.Счетчик ));
			Иначе
				
				МассивСтрок = ТаблицаПоЛС.НайтиСтроки(Новый Структура("ЛицевойСчет", СтрокаТаблицыДублей.ЛицевойСчет));
				
			КонецЕсли; 
			
			Для Каждого Строка Из МассивСтрок Цикл
				СписокНомеровСтрок = СписокНомеровСтрок + ?(НЕ ЗначениеЗаполнено(СписокНомеровСтрок), "", ", ") + Строка.НомерСтроки;
			КонецЦикла;
			
			ТекстСообщенияОбОшибке = ТекстСообщенияОбОшибке
			+ СписокНомеровСтрок
			+ " табличной части ""ЛицевойСчет"" указаны одни и те же.";
			
		КонецЦикла;
		
		бит_ОбщегоНазначения.ОшибкаПриПроведении(ТекстСообщенияОбОшибке, Отказ, Заголовок);
		
	КонецЕсли;
	
КонецПроцедуры

// Выполняет движения по регистрам. 
//
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, ТаблицаПоЛС,Отказ, Заголовок)
	
	ДатаДока = Дата;
	НачислениеПоУсл = Движения.бит_НачисленияПоУслугамЖКХ;
	
	ОбъемПоУслугам      = Движения.бит_ОбъемыПоУслугамЖКХ;
	
	НачислениеПоУслПоПериоду = Движения.бит_НачисленияПоУслугамЖКХПоПериоду;
	
	ТаблицаРасчетаНДС = Новый ТаблицаЗначений;
	Колонки = ТаблицаРасчетаНДС.Колонки;
	Колонки.Добавить("Номенклатура",	);
	Колонки.Добавить("СуммаНачислений",	ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Колонки.Добавить("СуммаБезНДС",		ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков Тогда
		
		Для каждого СтрокаТЧ Из ТаблицаПоЛС Цикл
			
			мСумма = 0;
			Движение = НачислениеПоУсл.Добавить();
			Движение.Период = ДатаДока;
			
			Движение.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			Движение.УслугаЖКХ   = СтрокаТЧ.Услуга;
			
			Если СтрокаТЧ.Сумма > 0 Тогда
				Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
				мСумма = СтрокаТЧ.Сумма;
			ИначеЕсли СтрокаТЧ.Сумма < 0 Тогда
				Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
				мСумма = - СтрокаТЧ.Сумма;
			КонецЕсли; 
			
			Движение.Сумма       = мСумма;
			
			Движение.Организация   = СтруктураШапкиДокумента.Организация;
			
			ДвижениеУслПоПериоду					  = НачислениеПоУслПоПериоду.Добавить();
			ДвижениеУслПоПериоду.Период				  = ДатаДока;
			ДвижениеУслПоПериоду.ЛицевойСчет		  = СтрокаТЧ.ЛицевойСчет;
			ДвижениеУслПоПериоду.УслугаЖКХ			  = СтрокаТЧ.Услуга;
			ДвижениеУслПоПериоду.Организация		  = СтруктураШапкиДокумента.Организация;
			Если СтрокаТЧ.Сумма > 0 Тогда
				ДвижениеУслПоПериоду.ПериодВзаиморасчетов = КонецМесяца(ДатаДока); 
				ДвижениеУслПоПериоду.ВидДвижения		  = ВидДвиженияНакопления.Приход;
				мСумма = СтрокаТЧ.Сумма;
			ИначеЕсли СтрокаТЧ.Сумма < 0 Тогда
				ДвижениеУслПоПериоду.ПериодВзаиморасчетов = КонецМесяца(ДатаДока); 
				ДвижениеУслПоПериоду.ВидДвижения	      = ВидДвиженияНакопления.Расход;
				//ДвижениеУслПоПериоду.ВидНачисления	  = Перечисления.бит_ВидНачисленияПоУслугамЖКХ.Аванс; 
				мСумма = - СтрокаТЧ.Сумма;
			КонецЕсли; 
			ДвижениеУслПоПериоду.Сумма				  = мСумма;
			
			ДвижениеОбъем = ОбъемПоУслугам.Добавить();
			ДвижениеОбъем.Период      = ДатаДока;
			ДвижениеОбъем.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			ДвижениеОбъем.Услуга      = СтрокаТЧ.Услуга;
			ДвижениеОбъем.Объем       = СтрокаТЧ.Объем;
			
			Если ЗначениеЗаполнено( СтрокаТЧ.СчетАбонента) И ЗначениеЗаполнено( СтрокаТЧ.СчетКУ) Тогда
				Если СтрокаТЧ.Сумма < 0 и НЕ СтрокаТЧ.СчетКУ  = ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД
					и НЕ СтрокаТЧ.СчетКУ  = ПланыСчетов.Хозрасчетный.ВыручкаЕНВД и НЕ СторноПоСчетам тогда
					Проводка = Движения.Хозрасчетный.Добавить();
					Проводка.Период     = СтруктураШапкиДокумента.Дата;
					Проводка.Содержание = "Разовые по ЛС";
					Проводка.Организация = СтруктураШапкиДокумента.Организация;
					
					Проводка.СчетКт = СтрокаТЧ.СчетАбонента;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.Субконто1);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.Субконто2);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.Субконто3);
					Проводка.СчетДт = СтрокаТЧ.СчетКУ;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.СубконтоКУ1);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.СубконтоКУ2);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.СубконтоКУ3);	
					Проводка.Сумма = мСумма;
					
					//10.04.2019
					если Проводка.СчетДт.Количественный = Истина тогда 
					  Проводка.КоличествоДт = СтрокаТЧ.Объем;
					конецесли; 
					
					если Проводка.СчетКт.Количественный = Истина тогда 
					  Проводка.КоличествоКт = СтрокаТЧ.Объем;
					конецесли;     
					
				ИначеЕсли СтрокаТЧ.Сумма < 0 и (СтрокаТЧ.СчетКУ  = ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД
					или СтрокаТЧ.СчетКУ  = ПланыСчетов.Хозрасчетный.ВыручкаЕНВД)  Тогда
					
					Проводка = Движения.Хозрасчетный.Добавить();
					Проводка.Период     = СтруктураШапкиДокумента.Дата;
					Проводка.Содержание = "Разовые по ЛС";
					Проводка.Организация = СтруктураШапкиДокумента.Организация;
					
					Проводка.СчетДт = СтрокаТЧ.СчетАбонента;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.Субконто1);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.Субконто2);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.Субконто3);
					Проводка.СчетКт = СтрокаТЧ.СчетКУ;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.СубконтоКУ1);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.СубконтоКУ2);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.СубконтоКУ3);	
					Проводка.Сумма = СтрокаТЧ.Сумма;
					
					//10.04.2019
					если Проводка.СчетДт.Количественный = Истина тогда 
					  Проводка.КоличествоДт = СтрокаТЧ.Объем;
					конецесли; 
					
					если Проводка.СчетКт.Количественный = Истина тогда 
					  Проводка.КоличествоКт = СтрокаТЧ.Объем;
					конецесли; 

					Если СтрокаТЧ.СчетКУ=ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД  Тогда
						Если ЗначениеЗаполнено(Проводка.СубконтоКт.СтавкиНДС) Тогда
							НДС_Ставка= УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Проводка.СубконтоКт.СтавкиНДС);
							Проводка.СуммаНУКт = бит_РасчетыПоКоммунальнымУслугам.CкорректированнаяCуммаНДС(ТаблицаРасчетаНДС, СтрокаТЧ.СубконтоКУ3, СтрокаТЧ.Сумма, НДС_Ставка);
						КонецЕсли;
					КонецЕсли;
					
				Иначе 
					Проводка = Движения.Хозрасчетный.Добавить();
					Проводка.Период     = СтруктураШапкиДокумента.Дата;
					Проводка.Содержание = "Разовые по ЛС";
					Проводка.Организация = СтруктураШапкиДокумента.Организация;
					
					Проводка.СчетДт = СтрокаТЧ.СчетАбонента;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.Субконто1);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.Субконто2);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.Субконто3);
					Проводка.СчетКт = СтрокаТЧ.СчетКУ;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.СубконтоКУ1);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.СубконтоКУ2);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.СубконтоКУ3);	
					Проводка.Сумма = СтрокаТЧ.Сумма;
					
					//10.04.2019
					если Проводка.СчетДт.Количественный = Истина тогда 
					  Проводка.КоличествоДт = СтрокаТЧ.Объем;
					конецесли; 
					
					если Проводка.СчетКт.Количественный = Истина тогда 
					  Проводка.КоличествоКт = СтрокаТЧ.Объем;
				    конецесли;     
				  
					Если СтрокаТЧ.СчетКУ=ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД  Тогда
						Если ЗначениеЗаполнено(Проводка.СубконтоКт.СтавкиНДС) Тогда
							НДС_Ставка= УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Проводка.СубконтоКт.СтавкиНДС);
							Проводка.СуммаНУКт = бит_РасчетыПоКоммунальнымУслугам.CкорректированнаяCуммаНДС(ТаблицаРасчетаНДС, СтрокаТЧ.СубконтоКУ3, СтрокаТЧ.Сумма, НДС_Ставка);
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли; 
				
			КонецЕсли;
			
			Движение = Движения.бит_КолЕдПоСчетчикам.Добавить();
			
			Движение.Период = ДатаДока;
			Движение.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			Движение.УслугаЖКХ   = СтрокаТЧ.Услуга;
			Движение.Счетчик     = СтрокаТЧ.Счетчик;
			
			Движение.КоличествоЕдиницПоЛС =  СтрокаТЧ.КоличествоЕдиниц;
			
			// Движение по регистру накопления бит_КолЕдиницПоСчетчикам.
			ДвижениеЕд = Движения.бит_КолЕдиницПоСчетчикам.Добавить();
			ДвижениеЕд.Период = ДатаДока;
			ДвижениеЕд.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			ДвижениеЕд.УслугаЖКХ   = СтрокаТЧ.Услуга;
			ДвижениеЕд.Счетчик     = СтрокаТЧ.Счетчик;
			ДвижениеЕд.КоличествоЕдиницПоЛС =  СтрокаТЧ.КоличествоЕдиниц;
			
		КонецЦикла; 
		
	Иначе
		
		Для каждого СтрокаТЧ Из ТаблицаПоЛС Цикл
			
			//19.07.2019
			//ДвижениеОбъем = ОбъемПоУслугам.Добавить();
			//ДвижениеОбъем.Период      = ДатаДока;
			//ДвижениеОбъем.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
