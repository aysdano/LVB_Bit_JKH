	//	ПочтовыйАдресЗданияЗапятые = Объект.ПочтовыйАдресЗапятые;
	//	
	//ИначеЕсли НЕ Строки.количество() = 0 Тогда
	//	
	//	ПочтовыйАдресЗданияЗапятые = Строки[0].ПредставлениеЗапятые;
	//	
	//КонецЕсли;	
	//// БИТ_ЖКХ 20.10.2014   
	
	// БИТ_ЖКХ 17.06.2016 11:38:49 Начало правки...
	Характеристики.Параметры.УстановитьЗначениеПараметра("ОбъектУчета", Объект.Ссылка);
