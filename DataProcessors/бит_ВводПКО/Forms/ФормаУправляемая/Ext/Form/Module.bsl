// Функция возвращает контрагента на лицевом счете.
//
&НаСервере
Функция ПолучитьКонтрагентаЛицевогоСчета(Знач Дата, Знач ЛицевойСчет)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.Контрагент,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ОтветственныеЛицаПоКУСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Контрагент;
		
	Иначе
		
		Возврат Справочники.Контрагенты.ПустаяСсылка();
		
	КонецЕсли; 
	
КонецФункции

// Функция возвращает счет кт. 
//
&НаСервере
Функция ПолучитьСчет(Знач Организация)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_НастройкаПараметровЖКХСрезПоследних.Организация,
	|	бит_НастройкаПараметровЖКХСрезПоследних.ТранзитныйСчетОплаты,
	|	бит_НастройкаПараметровЖКХСрезПоследних.СчетАбонента
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата"        , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация" , Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ЗначениеЗаполнено(Выборка.СчетАбонента) Тогда
			
			СубконтоКонтрагент = Выборка.СчетАбонента.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты, "ВидСубконто");
			
			Если СубконтоКонтрагент = Неопределено Тогда
				
				Возврат Выборка.ТранзитныйСчетОплаты;
				
			Иначе
				
				Возврат Выборка.СчетАбонента;
				
			КонецЕсли;
			
		ИначеЕсли ЗначениеЗаполнено(Выборка.ТранзитныйСчетОплаты) Тогда
			
			Возврат Выборка.ТранзитныйСчетОплаты;
			
		Иначе
			
			Возврат ПланыСчетов.Хозрасчетный.ПустаяСсылка();
			
		КонецЕсли; 
		
	Иначе
		
		Возврат ПланыСчетов.Хозрасчетный.ПустаяСсылка();
		
	КонецЕсли; 
	
КонецФункции

// Процедура выполняет обновление Дерева значений.
// 
&НаСервере
Процедура ОбновитьДерево()
	
	ДеревоПКОМ = РеквизитФормыВЗначение("ДеревоПКО");
	
	ДеревоПКОМ.Строки.Очистить();
	
	ОбработкаОбъект = ДанныеФормыВЗначение(Объект, Тип("ОбработкаОбъект.бит_ВводПКО"));
	
	Для каждого Строка Из Объект.ОплатыКУ Цикл
		
		ОбработкаОбъект.ЗаполнитьДеревоПКО(Строка.ДокументОплаты, ДеревоПКОМ, Элементы.ДеревоПКО);
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоПКОМ, "ДеревоПКО");
	
	ЗначениеВДанныеФормы(ОбработкаОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьДеревоПКОНаСервере(ЭлементМассива)
	
	ОбработкаОбъект = ДанныеФормыВЗначение(Объект, Тип("ОбработкаОбъект.бит_ВводПКО"));
	
	ДеревоПКОМ = РеквизитФормыВЗначение("ДеревоПКО");
	
	ОбработкаОбъект.ЗаполнитьДеревоПКО(ЭлементМассива, ДеревоПКОМ, Элементы.ДеревоПКО);
	
	ЗначениеВРеквизитФормы(ДеревоПКОМ, "ДеревоПКО");
	
	ЗначениеВДанныеФормы(ОбработкаОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьИЗаполнитьПКОНаСервере(ЭтоПоступлениеНаРасчетныйСчет, СтрокаТЧ, Оплата, ДокументЗаписан, РазбиватьПоЛицевымСчетам, ТранзитныйСчетОплаты, ПрименениеУСН, СуммаПринимаемых, БанковскийСчет, ИсточникОплаты);
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
		ПлатежныйДокумент = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
		//31.07.2019
		если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "НомерДок") = истина тогда
    	 ПлатежныйДокумент.НомерВходящегоДокумента = СтрокаТЧ.НомерДок;
	     ПлатежныйДокумент.ДатаВходящегоДокумента = Оплата.Дата; 
		конецесли; 		
		
	ИначеЕсли ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		ПлатежныйДокумент = Документы.ОплатаПлатежнойКартой.СоздатьДокумент(); 
		
	Иначе
		ПлатежныйДокумент = Документы.ПриходныйКассовыйОрдер.СоздатьДокумент();
	КонецЕсли;
	
	ЗаполнитьПКО(ПлатежныйДокумент, СтрокаТЧ, Оплата, ДокументЗаписан, РазбиватьПоЛицевымСчетам, ТранзитныйСчетОплаты, ПрименениеУСН, СуммаПринимаемых
				,БанковскийСчет, ИсточникОплаты);
	
	Возврат ПлатежныйДокумент;
	
КонецФункции


&НаСервере
Функция ПолучитьИЗаполнитьСчетНаСервере(ПлатежныйДокумент,СтрокаТЧ, Оплата, СчетЗаписан, РазбиватьПоЛицевымСчетам, ТранзитныйСчетОплаты, ПрименениеУСН, СуммаПринимаемых, БанковскийСчет, ИсточникОплаты)

	Счет = Документы.СчетНаОплатуПокупателю.СоздатьДокумент();
	ЗаполнитьСчетНаСервере(Счет,ПлатежныйДокумент,СтрокаТЧ,Оплата,СчетЗаписан,РазбиватьПоЛицевымСчетам,ТранзитныйСчетОплаты,ПрименениеУСН,СуммаПринимаемых,БанковскийСчет,ИсточникОплаты);
	Возврат Счет 

КонецФункции

&НаСервере
Процедура ПолучитьПодстроки(Дерево)
	Для Каждого Подстрока Из Дерево.Строки Цикл
		
		Подстрока.Выбор = Ложь;
		// Обработка подстроки. 
		ПолучитьПодстроки(Подстрока);
		
	КонецЦикла;
КонецПроцедуры	

