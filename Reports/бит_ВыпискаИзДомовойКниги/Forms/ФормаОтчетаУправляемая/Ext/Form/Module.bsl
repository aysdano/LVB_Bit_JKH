// Функция формирует список физ лиц, когда-либо прописанных на ЛС (ВесьСписок = Ложь).
// Либо тех, кто прописан на момент даты документа (ВесьСписок = Истина).
&НаСервереБезКонтекста
Функция СписокПроживающих(Дата, ЛицевойСчет, ИсторияПроживающих) 
	
	ТекстЗапроса = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Фамилия, """") КАК Фамилия,
	|	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Имя, """") КАК Имя,
	|	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Отчество, """") КАК Отчество
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Дата, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапроса);

	Если НЕ ИсторияПроживающих Тогда
		ЗапросСхемы	   = СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбора = ЗапросСхемы.Операторы[0];
		ОператорВыбора.Отбор.Добавить("(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))");
	КонецЕсли; 
	
	Запрос = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	МассивФизЛиц = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ФизЛицо");
	Возврат МассивФизЛиц;   
  
КонецФункции // СписокПроживающих()

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ОбновитьСписокПроживающих();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	ОбновитьСписокПроживающих();
	ОтображениеСостояния = Элементы.ТаблицаРезультат.ОтображениеСостояния;
	ОтображениеСостояния.Видимость                      = Истина;
	ОтображениеСостояния.ДополнительныйРежимОтображения = ДополнительныйРежимОтображения.Неактуальность;
	ОтображениеСостояния.Текст                          = НСтр("ru = 'Отчет не сформирован. Нажмите ""Сформировать отчет""..'");
	Элементы.ТаблицаРезультат.Доступность				= Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсторияПроживающихПриИзменении(Элемент)
	
	ОбновитьСписокПроживающих();

КонецПроцедуры
