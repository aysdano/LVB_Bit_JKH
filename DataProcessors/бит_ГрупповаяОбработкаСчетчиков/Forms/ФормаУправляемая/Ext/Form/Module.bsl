Процедура ТаблицаСчетчиковДокументНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Процедура выполняет заполнение дерева лицевыми счетами.
//
&НаСервере
Процедура ОбновитьСписокЛС()
	
	Корень = ДеревоСчетчиков.ПолучитьЭлементы();
	
	Корень.Очистить();
		
	СтруктураНастроек = Обработки.бит_ГрупповаяОбработкаСчетчиков.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЛицевойСчет");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Наименование");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Обрабатывать");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Квартира");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"  , КонецДня(ТекущаяДата()));
	СтруктураНастроек.ПараметрыДанных.Вставить("Здание", Объект.Здание);
	СтруктураНастроек.ПараметрыДанных.Вставить("Улица" , Объект.УлицаЛицевогоСчета);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "СписокЛицевыхСчетов";
	
	СтруктураРезультата = Обработки.бит_ГрупповаяОбработкаСчетчиков.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	Выборка = СтруктураРезультата.РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Корень.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
	КонецЦикла; 
	
КонецПроцедуры

// Процедура выполняет создание элементов справочника бит_Счетчики.
//
&НаСервере
Процедура СформироватьСчетчики()
	
	Корень = ДеревоСчетчиков.ПолучитьЭлементы();
	
	Для каждого СтрокаТаблицы Из Корень Цикл
		
		Если СтрокаТаблицы.Обрабатывать и ЗначениеЗаполнено(СтрокаТаблицы.НаименованиеСчетчика) И НЕ ЗначениеЗаполнено(СтрокаТаблицы.Счетчик)Тогда
			
			НовыйСчетчик = Справочники.бит_Счетчики.СоздатьЭлемент();
			НовыйСчетчик.Наименование         = СтрокаТаблицы.НаименованиеСчетчика;
			НовыйСчетчик.ВидСчетчика          = Объект.ВидСчетчика;
			НовыйСчетчик.ТипСчетчика          = Объект.ТипСчетчика;
			НовыйСчетчик.Разрядность          = Объект.Разрядность;
			НовыйСчетчик.КоэффициентУмножения = Объект.КоэффициентУмножения;
			
			Если бит_ОбщегоНазначения.ЗаписатьСправочник(НовыйСчетчик, "Автоматическое создание счетчика: ","Ошибки") Тогда;
				
				СтрокаТаблицы.Счетчик = НовыйСчетчик.Ссылка;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

// Функция возвращает список услуг.
//
&НаСервере
Функция СформироватьСписокУслуг()
	
	Дата = ?(ЗначениеЗаполнено(Объект.ДатаУстановкиСчетчиков),Объект.ДатаУстановкиСчетчиков, ТекущаяДата());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"  , КонецДня(Дата));
	Запрос.УстановитьПараметр("Улица" , Объект.УлицаЛицевогоСчета);
	Запрос.УстановитьПараметр("Здание", Объект.Здание);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ШаблоныУслугСрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_ШаблоныУслуг.СрезПоследних(
	|			&Дата,
	|			Услуга.СпособыРасчета.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)
	|				И Улица = &Улица
	|				И Здание = &Здание) КАК бит_ШаблоныУслугСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ШаблоныУслугСрезПоследних.Услуга";
	
	СписокУслуг = Новый СписокЗначений;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокУслуг.Добавить(Выборка.Услуга);
		
	КонецЦикла; 
	
	Возврат  СписокУслуг;
	
КонецФункции // ()

// Процедура выполняет проверку возмножности установки счетчика по Услуге.
//
&НаСервере
Процедура ПроверкаУслугПоЛС()
	
	ТаблицаЛС = Новый ТаблицаЗначений;
	ТаблицаЛС.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаЛС.Колонки.Добавить("Услуга"     , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	
	Корень = ДеревоСчетчиков.ПолучитьЭлементы();
	
	Для каждого СтрокаТаблицыУслуги Из Объект.Услуги Цикл
		
		Для каждого СтрокаТаблицы Из Корень Цикл
			
			НовСтрока = ТаблицаЛС.Добавить();
			
			НовСтрока.ЛицевойСчет = СтрокаТаблицы.ЛицевойСчет;
			НовСтрока.Услуга      = СтрокаТаблицыУслуги.Услуга;
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Мвт;
	Запрос.УстановитьПараметр("Дата"        , КонецДня(?(ЗначениеЗаполнено(Объект.ДатаУстановкиСчетчиков), Объект.ДатаУстановкиСчетчиков, ТекущаяДата())));
	Запрос.УстановитьПараметр("ТаблицаЛС"   , ТаблицаЛС);
	Запрос.УстановитьПараметр("Здание"      , Объект.Здание);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЛС.ЛицевойСчет,
	|	ТаблицаЛС.Услуга
	|ПОМЕСТИТЬ ОсновнойЛС
	|ИЗ
	|	&ТаблицаЛС КАК ТаблицаЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|ПОМЕСТИТЬ ЛСсУслугами
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&Дата,
	|			Услуга В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					Таб.Услуга КАК Услуга
	|				ИЗ
	|					ОсновнойЛС КАК Таб)) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга";
	
	Запрос.Выполнить();
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ОсновнойЛС.ЛицевойСчет КАК ЛицевойСчет,
	|	ОсновнойЛС.Услуга,
	|	ЛСсУслугами.Услуга КАК НетУслуги
	|ИЗ
	|	ОсновнойЛС КАК ОсновнойЛС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ЛСсУслугами КАК ЛСсУслугами
	|		ПО ОсновнойЛС.ЛицевойСчет = ЛСсУслугами.ЛицевойСчет
	|			И ОсновнойЛС.Услуга = ЛСсУслугами.Услуга
	|ГДЕ
	|	ЛСсУслугами.Услуга ЕСТЬ NULL 
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик КАК Счетчик,
	|	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет,
	|	бит_ГрупповыеСчетчикиНаУслугахСрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_ГрупповыеСчетчики.СрезПоследних(
	|			&Дата,
	|			ЛицевойСчет.Здание = &Здание
	|				И Услуга В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Таб.Услуга
	|					ИЗ
	|						ОсновнойЛС КАК Таб)) КАК бит_ГрупповыеСчетчикиСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|				&Дата,
	|				Объект = &Здание
	|					И ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)
	|					И СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам)
	|					И Услуга В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							Таб.Услуга
	|						ИЗ
	|							ОсновнойЛС КАК Таб)) КАК бит_ГрупповыеСчетчикиНаУслугахСрезПоследних
	|		ПО бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик = бит_ГрупповыеСчетчикиНаУслугахСрезПоследних.Счетчик
	|			И бит_ГрупповыеСчетчикиСрезПоследних.Услуга = бит_ГрупповыеСчетчикиНаУслугахСрезПоследних.Услуга
	|			И бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет.Здание = бит_ГрупповыеСчетчикиНаУслугахСрезПоследних.Объект
	|ГДЕ
	|	бит_ГрупповыеСчетчикиНаУслугахСрезПоследних.Использовать
	|	И бит_ГрупповыеСчетчикиСрезПоследних.Использовать
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_РаспределенияНаУслугахСрезПоследних.Услуга,
	|	бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет
	|ИЗ
	|	РегистрСведений.бит_РаспределенияНаУслугах.СрезПоследних(
	|			&Дата,
	|			Объект = &Здание
	|				И Услуга В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Таб.Услуга
	|					ИЗ
	|						ОсновнойЛС КАК Таб)) КАК бит_РаспределенияНаУслугахСрезПоследних
	|ГДЕ
	|	бит_РаспределенияНаУслугахСрезПоследних.Использовать
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_РаспределенияНаУслугахСрезПоследних.Услуга,
	|	бит_РаспределенияНаУслугахСрезПоследних.ЛицевойСчет";
	
	Результат = Запрос.ВыполнитьПакет();
	
	СписокЛС = Результат[0].Выгрузить();
	СписокСЧ = Результат[1].Выгрузить();
	СписокРП = Результат[2].Выгрузить();
	
	Отбор    = Новый Структура;
	
	Для каждого СтрокаТаблицы Из Корень Цикл
		
		СтрокаТаблицы.Ошибка = "";
		
		Отбор.Очистить();
		
		Отбор.Вставить("ЛицевойСчет", СтрокаТаблицы.ЛицевойСчет);
		МассивСтрок = СписокЛС.НайтиСтроки(Отбор);
		
		Услуги = "";
		
		Для каждого СтрокаМассива Из МассивСтрок Цикл
			
			Услуги = Услуги +?(Услуги = ""," ",", ")+ СтрокаМассива.Услуга;
			
		КонецЦикла;
		
		Если НЕ Услуги = "" Тогда
			
			СтрокаТаблицы.Ошибка       = "На лицевом счете не установлены услуги :" + Услуги + ".";
			СтрокаТаблицы.Обрабатывать = Ложь;
			
		КонецЕсли;
		
		МассивСтрок = СписокСЧ.НайтиСтроки(Отбор);
		
		Услуги = "";
		
		Для каждого СтрокаМассива Из МассивСтрок Цикл
			
			Услуги = Услуги +?(Услуги = ""," ",", ")+ СтрокаМассива.Услуга;
			
		КонецЦикла;
		
		Если НЕ Услуги = "" Тогда
			
			СтрокаТаблицы.Обрабатывать = Ложь;
			СтрокаТаблицы.Ошибка       = СтрокаТаблицы.Ошибка + ?(СтрокаТаблицы.Ошибка = "","",",") + "На лицевом счете установлен груп. счетчик на услуги: "+Услуги+".";
			
		КонецЕсли; 
		
		МассивСтрок = СписокРП.НайтиСтроки(Отбор);
		
		Услуги = "";
		
		Для каждого СтрокаМассива Из МассивСтрок Цикл
			
			Услуги = Услуги +?(Услуги = ""," ",", ")+ СтрокаМассива.Услуга;
			
		КонецЦикла;
		
		Если НЕ Услуги = "" Тогда
			
			СтрокаТаблицы.Обрабатывать = Ложь;
			СтрокаТаблицы.Ошибка       = СтрокаТаблицы.Ошибка + ?(СтрокаТаблицы.Ошибка = "","",",") + "На лицевом счете установлено распределение на услуги: "+Услуги+".";
			
		КонецЕсли; 
		
	КонецЦикла;
	
	МВТ.Закрыть();
	
КонецПроцедуры

// Функция возвращает список счетчиков.
//
&НаСервере
Функция СформироватьСписокСчетчиков()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДата()));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Дата, ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик";
	
	СписокСЧ = Новый СписокЗначений;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокСЧ.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Счетчик"));
	
	Возврат  СписокСЧ;
	
КонецФункции // ()

// Процедура выполняет создание документов бит_УстановкаСчетчика.
//
&НаСервере
Процедура СоздатьДокументы()
	
	Корень = ДеревоСчетчиков.ПолучитьЭлементы();
	
	Если Объект.Услуги.Количество() = 0 Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не заполнена таблица услуг!");
		
		Возврат;
		
	КонецЕсли; 
	
	Для каждого СтрокаТаблицы Из Корень Цикл
		
		Если СтрокаТаблицы.Обрабатывать И ЗначениеЗаполнено(СтрокаТаблицы.Счетчик) И НЕ ЗначениеЗаполнено(СтрокаТаблицы.ДокументУстановкаСчетчика) Тогда
			
			НовыйДокумент = Документы.бит_УстановкаСчетчика.СоздатьДокумент();
			
			НовыйДокумент.ВидОперации        = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика;
			НовыйДокумент.Дата               = ?(ЗначениеЗаполнено(Объект.ДатаУстановкиСчетчиков),Объект.ДатаУстановкиСчетчиков,ТекущаяДата());
			НовыйДокумент.УстановитьВремя(РежимАвтоВремя.ТекущееИлиПоследним);
			
			НовыйДокумент.Объект                 = СтрокаТаблицы.ЛицевойСчет;
			НовыйДокумент.Организация            = СтрокаТаблицы.ЛицевойСчет.Организация;
			НовыйДокумент.Счетчик                = СтрокаТаблицы.Счетчик;
			НовыйДокумент.МестоУстановкиСчетчика = СтрокаТаблицы.МестоУстановкиСчетчика;
			НовыйДокумент.СпособРасчета          = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам;
			НовыйДокумент.Ответственный          = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
			НовыйДокумент.Комментарий            = "Документ создан автоматически из обработки ""Групповая обработка счетчиков"".";
			
			Если СтрокаТаблицы.Многотарифный Тогда
				
				Ветка = СтрокаТаблицы.ПолучитьЭлементы();
				
				Для каждого СтрокаДерева Из Ветка Цикл
					
					Если НЕ СтрокаДерева.Обрабатывать Тогда
						Продолжить;
					КонецЕсли; 
					
					НовСтрока = НовыйДокумент.Услуги.Добавить();
					НовСтрока.Услуга              = СтрокаДерева.Услуга;
					НовСтрока.СпособРаспределения = Перечисления.бит_СпособыРаспределения.НеИспользуется;
					НовСтрока.НачальныеПоказания  = СтрокаДерева.НачальныеПоказания;
					НовСтрока.КонечныеПоказания   = СтрокаДерева.КонечныеПоказания;
					
				КонецЦикла;
				
				Если НовыйДокумент.Услуги.Количество() = 1 Тогда
					
					НовыйДокумент.НачальныеПоказания = НовыйДокумент.Услуги[0].НачальныеПоказания;
					НовыйДокумент.КонечныеПоказания  = НовыйДокумент.Услуги[0].КонечныеПоказания;
					
					НовыйДокумент.Услуги[0].НачальныеПоказания = 0;
					НовыйДокумент.Услуги[0].КонечныеПоказания  = 0;
					
				Иначе
					
					НовыйДокумент.Многотарифный = Истина;
					
				КонецЕсли; 
				
			Иначе
				
				Для каждого СтрокаТаблицыУслги Из Объект.Услуги Цикл
					
					НовСтрока = НовыйДокумент.Услуги.Добавить();
					
					НовСтрока.Услуга              = СтрокаТаблицыУслги.Услуга;
					НовСтрока.СпособРаспределения = Перечисления.бит_СпособыРаспределения.НеИспользуется;
					
					
				КонецЦикла;
				
				НовыйДокумент.НачальныеПоказания = СтрокаТаблицы.НачальныеПоказания;
				НовыйДокумент.КонечныеПоказания  = СтрокаТаблицы.КонечныеПоказания;
				
			КонецЕсли; 
			
			Попытка
				
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
				СтрокаТаблицы.ДокументУстановкаСчетчика = НовыйДокумент.Ссылка;
				
				Если НЕ Ветка = Неопределено Тогда
					
					Для каждого СтрокаДерева Из Ветка Цикл
						
						СтрокаДерева.ДокументУстановкаСчетчика = НовыйДокумент.Ссылка;
						
					КонецЦикла;
					
				КонецЕсли; 
				
			Исключение

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ОписаниеОшибки());
				
			КонецПопытки; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

// Процедура сформировывает наименования счетчиков.
//
&НаСервере
Процедура СформироватьНаименования()
	
	Корень = ДеревоСчетчиков.ПолучитьЭлементы();
	
	ТекущийНомер = Объект.НачальныйНомер;
	ДлинаНомера  = 50;
	
	Для каждого СтрокаТаблицы Из Корень Цикл
		Если СтрокаТаблицы.Обрабатывать Тогда
			
			Пока Истина Цикл
				
				Если Объект.Нумерация   = "ПоПорядку" Тогда
					ПеременнаяЧастьНомера = "" + Формат(ТекущийНомер, "ЧГ=0");
					ТекущийНомер  = ТекущийНомер + 1;
				ИначеЕсли Объект.Нумерация   = "Квартира"  Тогда
					ПеременнаяЧастьНомера = "" + СтрокаТаблицы.Квартира;
				ИначеЕсли Объект.Нумерация   = "ЛицевойСчет"  Тогда
					ПеременнаяЧастьНомера = "" + СтрокаТаблицы.ЛицевойСчет;
				КонецЕсли; 
				
				КандидатВНомера = Объект.Префикс + ПеременнаяЧастьНомера + Объект.Постфикс;
				НайденыйЛС      = Справочники.бит_Счетчики.НайтиПоНаименованию(КандидатВНомера, Истина);
				
				Если НайденыйЛС.Пустая() Тогда
					Прервать;
				Иначе
					
					Если Объект.Нумерация = "ПоПорядку" Тогда

						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Номер "+КандидатВНомера+" пропущен, т.к. счетчик с таким номером уже есть");
						
					Иначе

						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Номер "+КандидатВНомера+" не может быть использован т.к. счетчик с таким номером уже есть");
						
						КандидатВНомера = "";
						Прервать;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Если НЕ СтрДлина(КандидатВНомера)>ДлинаНомера Тогда
				СтрокаТаблицы.НаименованиеСчетчика = КандидатВНомера;
			Иначе

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Внимание! Номер счетчика для лицевого счета "+СтрокаТаблицы.ЛицевойСчет+" превышает допустимые "+ДлинаНомера+" символов!");
				
			КонецЕсли;
			
		КонецЕсли; 
	КонецЦикла; 
	
КонецПроцедуры

// Процедура выполняет замену или добавление услуги для многотарифных счетчиков.
//
&НаСервере
Процедура ИзменитьДобавитьСтрокуДерева(ТекущаяУслуга, НоваяУсулга)
	
	Дерево = РеквизитФормыВЗначение("ДеревоСчетчиков");
	
	Для каждого СтрокаДерева Из Дерево.Строки Цикл
		
		Если СтрокаДерева.Обрабатывать И СтрокаДерева.Многотарифный Тогда
			
			СтрокаПоиска = СтрокаДерева.Строки.Найти(ТекущаяУслуга, "Услуга");
			
			Если СтрокаПоиска = Неопределено Тогда
				
				НоваяСтрока =  СтрокаДерева.Строки.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаДерева);
				НоваяСтрока.Услуга = НоваяУсулга;
				
			Иначе
				
				СтрокаПоиска.Услуга             = НоваяУсулга;
				СтрокаПоиска.НачальныеПоказания = 0;
				СтрокаПоиска.КонечныеПоказания  = 0;
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоСчетчиков");
	
КонецПроцедуры

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	КэшированныеЗначения.Вставить("НежилоеПомещение", Справочники.бит_ТипыКвартиры.НежилоеПомещение);
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

// Процедура выполняет загрузку настроек отбора из настроек по умолчанию.
//
&НаСервере
Процедура ЗагрузитьНастройкиОтбораПоУмолчанию()
	
	СхемаКомпоновкиДанных = Обработки.бит_ГрупповаяОбработкаСчетчиков.ПолучитьМакет("СписокЛицевыхСчетов");
	КомпоновщикНастроек.Инициализировать(
	Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ЭтаФорма.УникальныйИдентификатор))
	);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
КонецПроцедуры // ЗагрузитьНастройкиОтбораПоУмолчанию()

&НаКлиенте
Процедура ПоместитьЗначениеВОтборКомпановщика(Значение, Индекс)
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[Индекс].ПравоеЗначение = Значение;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборТипКвартирыПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	КомпоновщикНастроек.Настройки.Отбор.Элементы[0].Использование  = ИспользоватьОтборТипКвартиры;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборСтатусКвартирыПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	КомпоновщикНастроек.Настройки.Отбор.Элементы[1].Использование  = ИспользоватьОтборСтатусКвартиры;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСравненияТипКвартирыПриИзменении(Элемент)
	
	Если ВидСравненияТипКвартиры = Неопределено Тогда
		
		ВидСравненияТипКвартиры = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если (ВидСравненияТипКвартиры = ВидСравненияКомпоновкиДанных.Равно ИЛИ ВидСравненияТипКвартиры = ВидСравненияКомпоновкиДанных.НеРавно)
		И ТипЗнч(ТипКвартиры) = Тип("СписокЗначений") Тогда
		
		ТипКвартиры = Неопределено;
		ПоместитьЗначениеВОтборКомпановщика(ТипКвартиры, 0);
		
	КонецЕсли; 
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[0].ВидСравнения   = ВидСравненияТипКвартиры;
	
КонецПроцедуры

