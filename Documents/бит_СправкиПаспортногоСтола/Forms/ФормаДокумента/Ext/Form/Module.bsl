	КонецЕсли; 
	
	// +bit ISedakova 25.03.2022 #ЛТ81	
	Если Объект.СправкаДанаДляПредоставления = ПредопределенноеЗначение("Перечисление.бит_ВидСправкиДляПредоставления.ВНотариальнуюКонтору") Тогда
