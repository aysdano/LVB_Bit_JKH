			"""Код1С"""   +":"+""""+Строка(Выборка.Ссылка.Код)+""""+","+
			"""Наименование"""   +":"+""""+Строка(ТекущаяСтрока.Имя_Отчество)+""""+","+
			"""Phone"""   +":"+""""+Строка(ТекущаяСтрока.Phone)+""""+","+
			"""Email"""+":"+""""+Строка(ТекущаяСтрока.Email)+""""+","+
			"""1СТелефон"""     +":"+""""+Строка(ТекущаяСтрока.Phone)+""""+","+
			"""1СИмя"""   +":"+""""+Строка(ТекущаяСтрока.Имя_Отчество)+""""+","+
			"""1СEmail"""     +":"+""""+Строка(ТекущаяСтрока.Email)+""""+","+
			"""НомерЛицевогоСчета"""+":"+""""+Строка(Выборка.Ссылка.Наименование)+""""+","+
			"""ЛС"""+":"+""""+Строка(Выборка.Ссылка.Наименование)+""""+","+
			"""Помещение"""   +":"+""""+Строка(ТекущаяСтрока.Помещение)+""""+","+
			"""НомерКвартиры"""  +":"+""""+Строка(ТекущаяСтрока.Квартира)+""""+","+
			"""Enabled"""   +":"+""""+Строка(1)+""""+","+
			"""ApiSumma"""   +":"+""""+Формат(ТекущаяСтрока.ApiSumma,"ЧРД=.; ЧГ=0; ЧДЦ=2")+""""+","+    
			"""ApiDate"""   +":"+""""+Формат(ТекущаяДатаСеанса(),"ДЛФ=Д")+""""+"}";
		Иначе
			Запрос2 = "{"+
			"""Код1С"""   +":"+""""+Строка(Выборка.Ссылка.Код)+""""+","+
			"""1СТелефон"""     +":"+""""+Строка(ТекущаяСтрока.Phone)+""""+","+
			"""1СИмя"""   +":"+""""+Строка(ТекущаяСтрока.Имя_Отчество)+""""+","+
			"""1СEmail"""     +":"+""""+Строка(ТекущаяСтрока.Email)+""""+","+
			"""НомерЛицевогоСчета"""+":"+""""+Строка(Выборка.Ссылка.Наименование)+""""+","+
			"""ЛС"""+":"+""""+Строка(Выборка.Ссылка.Наименование)+""""+","+
			"""Помещение"""   +":"+""""+Строка(ТекущаяСтрока.Помещение)+""""+","+
			"""НомерКвартиры"""  +":"+""""+Строка(ТекущаяСтрока.Квартира)+""""+","+
			"""Enabled"""   +":"+""""+Строка(1)+""""+","+
			"""ApiSumma"""   +":"+""""+Формат(ТекущаяСтрока.ApiSumma,"ЧРД=.; ЧГ=0; ЧДЦ=2")+""""+","+    
			"""ApiDate"""   +":"+""""+Формат(ТекущаяДатаСеанса(),"ДЛФ=Д")+""""+"}";
		КонецЕсли;
		
		Если СтрокаПараметров = "" Тогда
			ЖурналЗапросБезКодировкиМассив.Добавить("create"+Счетчик+"="+Запрос1+"&update"+Счетчик+"="+Запрос2);
		Иначе
			ЖурналЗапросБезКодировкиМассив.Добавить("&create"+Формат(Счетчик,"ЧГ=")+"="+Запрос1+"&update"+Формат(Счетчик,"ЧГ=")+"="+Запрос2);
		КонецЕсли;
		
		Запрос1 = КодироватьСтроку(Запрос1,СпособКодированияСтроки.КодировкаURL);
		Запрос2 = КодироватьСтроку(Запрос2,СпособКодированияСтроки.КодировкаURL);
		
		Если СтрокаПараметров = "" Тогда
			СтрокаПараметров = "create"+Счетчик+"="+Запрос1+"&update"+Счетчик+"="+Запрос2;
		Иначе
			СтрокаПараметров = СтрокаПараметров+"&create"+Формат(Счетчик,"ЧГ=")+"="+Запрос1+"&update"+Формат(Счетчик,"ЧГ=")+"="+Запрос2;
		КонецЕсли;
		
		Счетчик=Счетчик+1;	
	КонецЦикла;
	
	
	Если Не ПроверитьЕстьЛиИнтернетСоединение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	
	
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1);
	HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаПараметров, КодировкаТекста.UTF8);
	HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");   // тут поменялось
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Настройки.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
	Исключение
