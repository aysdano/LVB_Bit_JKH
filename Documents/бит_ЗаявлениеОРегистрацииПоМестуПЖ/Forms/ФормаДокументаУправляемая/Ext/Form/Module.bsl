&НаКлиенте
Процедура УдостоверениеЛичностиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Объект.РегистрируемоеЛицо) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не указанно регистрируемо лицо");
		
		Возврат;
		
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РедактированиеИзДокумента", Истина);
	
	СтруктураКлючЗаписи = Новый Структура;
	СтруктураКлючЗаписи.Вставить("ФизЛицо", Объект.РегистрируемоеЛицо);
	СтруктураКлючЗаписи.Вставить("Период" , Объект.Дата);
	
	ДобавитьКлючЗаписи(ПараметрыФормы, СтруктураКлючЗаписи, "бит_ПаспортныеДанныеПроживающих");
	
	ОткрытьФорму("РегистрСведений.бит_ПаспортныеДанныеПроживающих.ФормаЗаписи", ПараметрыФормы, ЭтаФорма,
	ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаКлиенте
Процедура СвидетельствоОСмертиНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Объект.РегистрируемоеЛицо.Пустая() Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не указанно регистрируемо лицо";
		Сообщение.Сообщить();
		Возврат;
		
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РедактированиеИзДокумента", Истина);
	
	СтруктураКлючЗаписи = Новый Структура;
	СтруктураКлючЗаписи.Вставить("ФизЛицо", Объект.РегистрируемоеЛицо);
	
	ДобавитьКлючЗаписи(ПараметрыФормы, СтруктураКлючЗаписи, "бит_СвидетельстваОСмерти");
	
	ОткрытьФорму("РегистрСведений.бит_СвидетельстваОСмерти.ФормаЗаписи", ПараметрыФормы, ЭтаФорма,
	ЭтаФорма.УникальныйИдентификатор,,,, РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ДобавитьКлючЗаписи(ПараметрыФормы, СтруктураКлючЗаписи, ИмяРегистра)
	
	МенеджерРегистра = РегистрыСведений[ИмяРегистра];
	Запись           = МенеджерРегистра.СоздатьМенеджерЗаписи();
	
	Для каждого Измерение Из СтруктураКлючЗаписи Цикл
		Запись[Измерение.Ключ] = Измерение.Значение;
	КонецЦикла; 
	
	Запись.Прочитать();
	
	Если Запись.Выбран() Тогда
		
		КлючЗаписи = МенеджерРегистра.СоздатьКлючЗаписи(СтруктураКлючЗаписи);
		
		ПараметрыФормы.Вставить("Ключ", КлючЗаписи);
		
	Иначе
		Для каждого Измерение Из СтруктураКлючЗаписи Цикл
			ПараметрыФормы.Вставить(Измерение.Ключ, Измерение.Значение);
		КонецЦикла;
	КонецЕсли; 
	
КонецПроцедуры 

&НаКлиенте
Процедура РегистрируемоеЛицоОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если НЕ Объект.РегистрируемоеЛицо = ВыбранноеЗначение Тогда
		
