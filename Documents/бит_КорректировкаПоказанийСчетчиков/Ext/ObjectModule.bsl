Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ЛицевойСчет"               ,"ЛицевойСчет");
	СтруктураПолей.Вставить("Счетчик"                   ,"Счетчик");
	СтруктураПолей.Вставить("Услуга"                    ,"Услуга");
	СтруктураПолей.Вставить("НачальныеПоказания"        ,"НачальныеПоказания");
	СтруктураПолей.Вставить("ДатаОтПоказаний"           ,"ДатаОтПоказаний");
	СтруктураПолей.Вставить("КорректировочныеПоказания" ,"КорректировочныеПоказания");
	
	РезультатЗапросаПоПоказаниям = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "КорректировкаПоказаний", СтруктураПолей);
	ТаблицаПоказаний          = РезультатЗапросаПоПоказаниям.Выгрузить();
	
	ПроверкаРеквизитовТЧ(ТаблицаПоказаний, СтруктураШапкиДокумента,Отказ, Заголовок);
	
	ПроверитьДублиУслуг(ТаблицаПоказаний, Отказ, Заголовок);
	
	Если НЕ Отказ Тогда
		
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоказаний, Отказ, Заголовок);
		
	КонецЕсли;
	
КонецПроцедуры

