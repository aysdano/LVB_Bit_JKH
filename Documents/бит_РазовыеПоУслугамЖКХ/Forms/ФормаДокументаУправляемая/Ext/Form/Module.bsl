	ЛицевыеСчета.Свернуть("ЛицевойСчет",);
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ОбъемыПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	               |	бит_ОбъемыПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
