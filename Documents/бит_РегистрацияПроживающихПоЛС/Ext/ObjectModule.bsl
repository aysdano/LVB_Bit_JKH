// Обработчик события "ОбработкаПроведения" документа.
//
Процедура ОбработкаПроведения(Отказ)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	// Проверим правильность заполнения шапки документа.
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ФизЛицо"                     ,"ФизЛицо");
	СтруктураПолей.Вставить("СтепеньРодства"              ,"СтепеньРодства");
	СтруктураПолей.Вставить("СтатусПроживания"            ,"СтатусПроживания");
	СтруктураПолей.Вставить("ДатаРегистрации"             ,"ДатаРегистрации");
	СтруктураПолей.Вставить("СтатусФизЛица"               ,"СтатусФизЛица");
	СтруктураПолей.Вставить("ДатаЗаписи"                  ,"ДатаЗаписи");
	СтруктураПолей.Вставить("ДатаСнятияСРегистрации"      ,"ДатаСнятияСРегистрации");
	СтруктураПолей.Вставить("ВладелецКвартиры"            ,"ВладелецКвартиры");
	СтруктураПолей.Вставить("Контрагент"                  ,"Контрагент"); 
	СтруктураПолей.Вставить("ДоговорКонтрагента"      	  ,"ДоговорКонтрагента"); 
	
	СтруктураПолей.Вставить("ПричинаВыписки"              ,"ПричинаВыписки");
	СтруктураПолей.Вставить("ПричинаПрописки"              ,"ПричинаПрописки");
	СтруктураПолей.Вставить("ДатаПрибытия"                ,"ДатаПрибытия");
	
	СтруктураПолей.Вставить("КудаВыписанАдрес"                 ,"КудаВыписанАдрес");
	СтруктураПолей.Вставить("ОткудаПрибылАдрес"                ,"ОткудаПрибылАдрес");
	
	СтруктураПолей.Вставить("ДоляПлощади"                 ,"ДоляПлощади");
	СтруктураПолей.Вставить("ДоляПлощади"                 ,"ДоляПлощади");
	СтруктураПолей.Вставить("СтатусФизЛицаДляИзменения"   ,"СтатусФизЛицаДляИзменения");
	
	СтруктураПолей.Вставить("ПравоустанавливающиеДокументы","ПравоустанавливающиеДокументы");
	//++АнисимоваМВ 1бит 05.11.2024 восстановление после сбоя
	//СтруктураПолей.Вставить("лб_СтатусСтрокиДляФЛС"      ,"лб_СтатусСтрокиДляФЛС");
	//СтруктураПолей.Вставить("лб_ДоляПлощадиСтрокой"      ,"лб_ДоляПлощадиСтрокой");
	//СтруктураПолей.Вставить("лб_СтрокаРодствДляФЛС"      ,"лб_СтрокаРодствДляФЛС");
	//СтруктураПолей.Вставить("бит_ПомещенВАрхив"      ,"бит_ПомещенВАрхив");
	//--АнисимоваМВ 1бит 05.11.2024 восстановление после сбоя
	
	СтруктураПолей.Вставить("ДатаПраваСобственности"      ,"ДатаПраваСобственности");
	
	РезультатЗапросаПоФизЛицам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "СписокПроживающих", СтруктураПолей);
	ТаблицаПоФизЛицам          = РезультатЗапросаПоФизЛицам.Выгрузить();
	
	ПроверитьДублиФизлиц(ТаблицаПоФизЛицам, Отказ, Заголовок);
	
	//
	//Проверка = НазначениеОтветственногоПоЛСНаСервере();
