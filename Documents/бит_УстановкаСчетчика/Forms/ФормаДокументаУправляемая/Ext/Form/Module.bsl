// Функция возвращает таблицу значений, которая содержит услуги и начисления по счетчикам.
//
Функция НачисленияПоСчетчикам(СтатусКвартиры,ТипКвартиры,СписокУслуг)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"           , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Момент"         , Новый МоментВремени(Объект.Дата - 2, Параметры.Ключ));
	Запрос.УстановитьПараметр("Объект"         , Объект.Объект);
	Запрос.УстановитьПараметр("СтатусКвартиры" , СтатусКвартиры);
	Запрос.УстановитьПараметр("ТипКвартиры"    , ТипКвартиры);
	Запрос.УстановитьПараметр("СписокУслуг"    , СписокУслуг);
	Запрос.УстановитьПараметр("Счетчик"        , Объект.Счетчик);
	// БИТ_ЖКХ 11.10.2010.              
	// Изменен запрос.
	// Запрос должен получать начсиления по счетчику до момента проведения документа.
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ПоказанияСчетчиков.КоличествоЕдиниц > ЕСТЬNULL(Услуги.Норма, 0)
	|				ТОГДА ПоказанияСчетчиков.КоличествоЕдиниц - ЕСТЬNULL(Услуги.Норма, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ, 0) * Услуги.СверхНормативнаяСтавка + ЕСТЬNULL(ВЫБОР
	|			КОГДА Услуги.Норма > ПоказанияСчетчиков.КоличествоЕдиниц
	|				ТОГДА ПоказанияСчетчиков.КоличествоЕдиниц * Услуги.ОсновнаяСтавка
	|			ИНАЧЕ Услуги.ОсновнаяСтавка * Услуги.Норма
	|		КОНЕЦ, 0) КАК Начисления,
	|	Услуги.СпособРасчета,
	|	ПоказанияСчетчиков.Услуга
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		ЕСТЬNULL(ВЫБОР
	|				КОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0) = ВЫБОР
	|						КОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0) <> 0
	|							ТОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0)
	|						ИНАЧЕ ЕСТЬNULL(ВЫБОР
	|									КОГДА ВЫБОР
	|											КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток >= 0
	|												ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|											ИНАЧЕ ВЫБОР
	|													КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток <> 0
	|														ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток
	|													ИНАЧЕ бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток
	|												КОНЕЦ
	|										КОНЕЦ > ВЫБОР
	|											КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток >= 0
	|												ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|											ИНАЧЕ ВЫБОР
	|													КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток <> 0
	|														ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток
	|													ИНАЧЕ бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток
	|												КОНЕЦ
	|										КОНЕЦ
	|										ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток
	|									ИНАЧЕ бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток
	|								КОНЕЦ, 0)
	|					КОНЕЦ
	|					ТОГДА 0
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0) <> 0
	|							ТОГДА ВЫБОР
	|									КОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0) - ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0) >= 0
	|										ТОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0) - ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0)
	|									ИНАЧЕ ВЫБОР
	|											КОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0) <> 0
	|												ТОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность, 0) - ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0) + ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0)
	|											ИНАЧЕ ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток, 0)
	|										КОНЕЦ
	|								КОНЕЦ
	|						ИНАЧЕ ВЫБОР
	|								КОГДА ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток, 0) <> 0
	|										ИЛИ ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток, 0) <> 0
	|									ТОГДА ЕСТЬNULL(ВЫБОР
	|												КОГДА ВЫБОР
	|														КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток >= 0
	|															ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|														ИНАЧЕ ВЫБОР
	|																КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток <> 0
	|																	ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток
	|																ИНАЧЕ бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток
	|															КОНЕЦ
	|													КОНЕЦ > ВЫБОР
	|														КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток >= 0
	|															ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|														ИНАЧЕ ВЫБОР
	|																КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток <> 0
	|																	ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток
	|																ИНАЧЕ бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток
	|															КОНЕЦ
	|													КОНЕЦ
	|													ТОГДА ВЫБОР
	|															КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток >= 0
	|																ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|															ИНАЧЕ ВЫБОР
	|																	КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток <> 0
	|																		ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток + 1
	|																	ИНАЧЕ бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток
	|																КОНЕЦ
	|														КОНЕЦ
	|												ИНАЧЕ ВЫБОР
	|														КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток >= 0
	|															ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|														ИНАЧЕ ВЫБОР
	|																КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток <> 0
	|																	ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток + 1
	|																ИНАЧЕ бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток
	|															КОНЕЦ
	|													КОНЕЦ
	|											КОНЕЦ, 0)
	|								ИНАЧЕ бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ, 0) * бит_ПоказанияСчетчиковОстатки.КоэффициентОстаток КАК КоличествоЕдиниц,
	|		бит_ПоказанияСчетчиковОстатки.Услуга КАК Услуга
	|	ИЗ
	|		РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
	|				&Момент,
	|				Объект = &Объект
	|					И Счетчик = &Счетчик) КАК бит_ПоказанияСчетчиковОстатки) КАК ПоказанияСчетчиков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка КАК ОсновнаяСтавка,
	|			бит_СтавкиНаУслугиСрезПоследних.Услуга КАК Услуга,
	|			ВЫБОР
	|				КОГДА ПроживающиеНачислятьПоНорме.КолПрожив = 1
	|					ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаОдного, 0)
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПроживающиеНачислятьПоНорме.КолПрожив = 2
	|							ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаДвоих, 0) + ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА ПроживающиеНачислятьПоНорме.КолПрожив > 2
	|									ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаСемью, 0) + ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0)
	|								ИНАЧЕ 0
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ * ПроживающиеНачислятьПоНорме.КолПрожив + ВЫБОР
	|				КОГДА ПроживающиеНачислятьПоНорме.КолПрожив = 1
	|						И бит_НормыНаУслугиСрезПоследних.ИспользоватьДопНормуНаОдного
	|					ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0)
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПроживающиеНачислятьПоНорме.КолПрожив = 2
	|							ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА ПроживающиеНачислятьПоНорме.КолПрожив > 2
	|									ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0)
	|								ИНАЧЕ 0
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ * ПроживающиеНачислятьПоНорме.КолПрожив КАК Норма,
	|			бит_СтавкиНаУслугиСрезПоследних.СверхНормативнаяСтавка КАК СверхНормативнаяСтавка,
	|			бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета
	|		ИЗ
	|			РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(
	|					&Дата,
	|					ТипКвартиры = &ТипКвартиры
	|						И СтатусКвартиры = &СтатусКвартиры
	|						И СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)) КАК бит_СтавкиНаУслугиСрезПоследних
	|				ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет = &Объект) КАК бит_СведенияПоУслугамЛССрезПоследних
	|					ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_НормыНаУслуги.СрезПоследних(
	|							&Дата,
	|							ТипКвартиры = &ТипКвартиры
	|								И СтатусКвартиры = &СтатусКвартиры
	|								И СпособРасчетаПоУслуге = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)) КАК бит_НормыНаУслугиСрезПоследних
	|					ПО (бит_НормыНаУслугиСрезПоследних.Услуга = бит_СведенияПоУслугамЛССрезПоследних.Услуга)
	|						И (бит_НормыНаУслугиСрезПоследних.РежимПотребления = бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления)
	|				ПО бит_СтавкиНаУслугиСрезПоследних.Услуга = бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|					И бит_СтавкиНаУслугиСрезПоследних.РежимПотребления = бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления
	|					И бит_СтавкиНаУслугиСрезПоследних.Поставщик = бит_СведенияПоУслугамЛССрезПоследних.Поставщик,
	|			(ВЫБРАТЬ
	|				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК ФизЛицо,
	|				СУММА(1) КАК КоличествоПроживающих
	|			ИЗ
	|				РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &Объект) КАК бит_ПроживающиеПоЛССрезПоследних
	|			ГДЕ
	|				бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.НачислятьПоНорме
	|				И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПравоНаЛьготы
	|				И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата
	|						ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))) КАК ПроживающиеПоЛСЛьготы,
	|			(ВЫБРАТЬ
	|				бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|				КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК КолПрожив
	|			ИЗ
	|				РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &Объект) КАК бит_ПроживающиеПоЛССрезПоследних
	|			ГДЕ
	|				бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.НачислятьПоНорме
	|			
	|			СГРУППИРОВАТЬ ПО
	|				бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет) КАК ПроживающиеНачислятьПоНорме
	|		
	|		СГРУППИРОВАТЬ ПО
	|			бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка,
	|			бит_СтавкиНаУслугиСрезПоследних.Услуга,
	|			бит_СтавкиНаУслугиСрезПоследних.СверхНормативнаяСтавка,
	|			бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью,
	|			бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого,
	|			бит_НормыНаУслугиСрезПоследних.ИспользоватьДопНормуНаОдного,
	|			ВЫБОР
	|				КОГДА ПроживающиеНачислятьПоНорме.КолПрожив = 1
	|					ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаОдного, 0)
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПроживающиеНачислятьПоНорме.КолПрожив = 2
	|							ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаДвоих, 0) + ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА ПроживающиеНачислятьПоНорме.КолПрожив > 2
	|									ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаСемью, 0) + ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0)
	|								ИНАЧЕ 0
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ * ПроживающиеНачислятьПоНорме.КолПрожив + ВЫБОР
	|				КОГДА ПроживающиеНачислятьПоНорме.КолПрожив = 1
	|						И бит_НормыНаУслугиСрезПоследних.ИспользоватьДопНормуНаОдного
	|					ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0)
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПроживающиеНачислятьПоНорме.КолПрожив = 2
	|							ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА ПроживающиеНачислятьПоНорме.КолПрожив > 2
	|									ТОГДА ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0)
	|								ИНАЧЕ 0
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ * ПроживающиеНачислятьПоНорме.КолПрожив,
	|			бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета) КАК Услуги
	|		ПО ПоказанияСчетчиков.Услуга = Услуги.Услуга";
	
	
	Результат = Запрос.Выполнить().Выгрузить();					  
	Возврат Результат;					  
	
КонецФункции

&НаСервере
// Функция возвращает ссылку на документ "Разовые по услугам ЖКХ".
//
Функция ПолучитьДокументРазовые()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Параметры.Ключ);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_РазовыеПоУслугамЖКХ.Ссылка КАК ДокументРазовые
	|ИЗ
	|	Документ.бит_РазовыеПоУслугамЖКХ КАК бит_РазовыеПоУслугамЖКХ
	|ГДЕ
	|	бит_РазовыеПоУслугамЖКХ.Документ = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Разовые = Неопределено;
	
	Если Выборка.Следующий() Тогда
		
		Разовые = Выборка.ДокументРазовые;
		
	КонецЕсли; 
	
	Возврат Разовые;
	
КонецФункции // ()

&НаСервере
Процедура ОбработатьВыбранныеЗначения(ВыбранноеЗначение)
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресЛСВХранилище);
	
	Отбор = Новый Структура;
	
	Дерево = РеквизитФормыВЗначение("ДеревоОбъектовУчета");
	
	Для каждого ЭлементКоллекции Из ТаблицаЛС Цикл
		
		Отбор.Вставить("Услуга"     , ЭлементКоллекции.Услуга);
		Отбор.Вставить("Здание"     , ЭлементКоллекции.Здание);
		
		Корень = Дерево.Строки.НайтиСтроки(Отбор);
		
		Если НЕ Корень.Количество() = 1 Тогда
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не найдено строк по зданию: " + ЭлементКоллекции.Здание + " и услуге: " + ЭлементКоллекции.Услуга);
			
			Продолжить;
			
		КонецЕсли; 
		
		Отбор.Очистить();
		
		ПоискЛС = Корень[0].Строки.Найти(ЭлементКоллекции.ЛицевойСчет, "ЛицевойСчет");
		
		Если НЕ ПоискЛС = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Отказ = Ложь;
		
		ОтветственноеЛицо    = Неопределено;
		Индивидуальный       = Ложь;
		
		ПроверитьВозможностьУстановкиСчетчикаНаЛицевойСчет(ЭлементКоллекции.Здание, 
		ЭлементКоллекции.ЛицевойСчет, 
		ЭлементКоллекции.Услуга, 
		,
		ОтветственноеЛицо, 
		Индивидуальный, 
		, 
		Отказ);
		
		Если НЕ Отказ Тогда
			
			НоваяСтрока = Корень[0].Строки.Добавить();
			
			НоваяСтрока.ПредставлениеЗдания = НоваяСтрока.Родитель.ПредставлениеЗдания;
			НоваяСтрока.Услуга              = НоваяСтрока.Родитель.Услуга;
			НоваяСтрока.ЛицевойСчет         = ЭлементКоллекции.ЛицевойСчет;
			НоваяСтрока.ОтветственноеЛицо   = ОтветственноеЛицо;
			НоваяСтрока.Индивидуальный      = Индивидуальный;
			НоваяСтрока.Здание              = ЭлементКоллекции.Здание;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоОбъектовУчета");
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьКэшПоСчетчику()
	
	Результат = Документы.бит_УстановкаСчетчика.ОбновитьКэшДокумента(Объект);
	ЗаполнитьЗначенияСвойств(мКэшЗначений, Результат);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСпособРаспределенияПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущиеДанные;
	
	Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
		
		СтрокаТаблицы.СпособРаспределения =  ТекСтрока.СпособРаспределения;
		
	КонецЦикла;   
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Объект.Услуги.Очистить();
	Объект.ЛицевыеСчета.Очистить();
	Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
	Корень.Очистить();
	
	Объект.НачальныеПоказания = 0;
	Объект.КонечныеПоказания  = 0;
	Объект.Счетчик            = Неопределено;
	Объект.СпособРасчета      = Неопределено;
	Объект.Объект             = Неопределено;
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ФормаВыбора = ПолучитьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая",,Элемент);
	
	ОтборОрганизации = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборОрганизации.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Организация");
	ОтборОрганизации.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборОрганизации.ПравоеЗначение = Объект.Организация;
	
	ФормаВыбора.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовУчетаПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.ДеревоОбъектовУчета.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	Если Родитель = Неопределено Тогда
		
		Родитель = ТекущиеДанные;
		
	КонецЕсли;
	
	ВетвьДерева   = Родитель.ПолучитьЭлементы(); 
	ВторойУровень = ВетвьДерева.Добавить();
	
	ВторойУровень.Услуга              = Родитель.Услуга;
	ВторойУровень.Здание              = Родитель.Здание;
	ВторойУровень.ПредставлениеЗдания = Родитель.ПредставлениеЗдания;
	
	Элементы.ДеревоОбъектовУчета.ТекущаяСтрока  = ВторойУровень.ПолучитьИдентификатор();
	Элементы.ДеревоОбъектовУчета.ТекущийЭлемент = Элементы.ДеревоОбъектовУчетаЛицевойСчет;
	Элементы.ДеревоОбъектовУчета.ИзменитьСтроку();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьЗдание(Команда)
	
	Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
	ПервыйУровень = Корень.Добавить();
	ПервыйУровень.Родитель = Истина;
	
	Элементы.ДеревоОбъектовУчета.ТекущаяСтрока  = ПервыйУровень.ПолучитьИдентификатор();
	Элементы.ДеревоОбъектовУчета.ТекущийЭлемент = Элементы.ДеревоОбъектовУчетаУслуга;
	Элементы.ДеревоОбъектовУчета.ИзменитьСтроку();
	
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЛСПоЗданию(Команда)
	
	// БИТ_ЖКХ 03.10.2014
	Объект.ПодборРазныеЗдания = Ложь;
	Элементы.ПодборРазныеЗдания.Видимость = Ложь;
	// БИТ_ЖКХ 03.10.2014
	
	ТекущиеДанные = Элементы.ДеревоОбъектовУчета.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Укажите строку дерева!");
		
		Возврат;
		
	КонецЕсли; 
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	Данные = ?(Родитель = Неопределено, ТекущиеДанные, Родитель);
	
	ЗаполнитьСтрокиДереваПоЗданию(Данные.ПолучитьИдентификатор());
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовУчетаПредставлениеЗданияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущиеДанные = Элементы.ДеревоОбъектовУчета.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ВыбранноеЗначение = ТекущиеДанные.Здание Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Отказ = Ложь;
	ПроверитьВозможностьУстановкиСчетчикаНаЗдание(ВыбранноеЗначение, ТекущиеДанные.Услуга, Отказ);
	
	Если НЕ Отказ Тогда
		
		ПодчениеныеСтроки = ТекущиеДанные.ПолучитьЭлементы();
		ПодчениеныеСтроки.Очистить();
		
		ТекущиеДанные.Здание              = ВыбранноеЗначение;
		
		Улица = ПолучитьУлицуНаСервере(ВыбранноеЗначение);
		
		ТекущиеДанные.ПредставлениеЗдания = "ул. " + Улица + ", д. " + ВыбранноеЗначение;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьУлицуНаСервере(ВыбранноеЗначение)
	
	Возврат	ВыбранноеЗначение.Улица;
	
КонецФункции

&НаСервере
Процедура ПроверитьВозможностьУстановкиСчетчикаНаЗдание(Здание, Услуга, Отказ = Ложь)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата"  , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Улица" , Здание.Улица);
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("Услуга", Услуга);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ШаблоныУслугСрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_ШаблоныУслуг.СрезПоследних(
	|			&Дата,
	|			Улица = &Улица
	|				И Здание = &Здание
	|				И Услуга = &Услуга) КАК бит_ШаблоныУслугСрезПоследних
	|ГДЕ
	|	бит_ШаблоныУслугСрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ШаблоныУслугСрезПоследних.Услуга";
	
	Если Запрос.Выполнить().Пустой() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Услуга " + Услуга+ " не установлена на здании: " + Здание +", ул. " + Здание.Улица);
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовУчетаЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	ТекущиеДанные = Элементы.ДеревоОбъектовУчета.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Возврат
		
	КонецЕсли; 
	
	СписокЛС = Новый СписокЗначений;
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	Для каждого СтрокаТаблицы_Лицевыесчета Из Родитель.ПолучитьЭлементы() Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы_Лицевыесчета.ЛицевойСчет) Тогда
			
			СписокЛС.Добавить(СтрокаТаблицы_Лицевыесчета.ЛицевойСчет);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ФормаВыбора = ПолучитьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая",,Элемент, КлючУникальности);
	
	ОтборУслуг = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборУслуг.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Здание");
	ОтборУслуг.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборУслуг.ПравоеЗначение = Родитель.Здание;
	
	Если СписокЛС.Количество() > 0 Тогда
		
		ОтборЛС = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЛС.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
		ОтборЛС.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеВСписке;
		ОтборЛС.ПравоеЗначение = СписокЛС;
		
	КонецЕсли;
	
	Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик // БИТ_ЖКХ 02.12.2015 17:39:44 
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьЛицевыеСчетаСоСчетчика
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьУслугиСоСчетчика Тогда
		
		ОтборЛС = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЛС.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
		ОтборЛС.ВидСравнения   = ?(Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
									ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик // БИТ_ЖКХ 02.12.2015 17:37:17 
									,ВидСравненияКомпоновкиДанных.НеВСписке
									,ВидСравненияКомпоновкиДанных.ВСписке);
		ОтборЛС.ПравоеЗначение = мКэшЗначений.СписокЛС;
		
	КонецЕсли; 
	
	ФормаВыбора.Открыть();
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовУчетаПредставлениеЗданияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь; 
	
	ТекущиеДанные = Элементы.ДеревоОбъектовУчета.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Возврат
		
	КонецЕсли; 
	
	СписокЗданий = Новый СписокЗначений;
	
	Родитель = ТекущиеДанные.ПолучитьРодителя();
	
	Для каждого СтрокаТаблицы_ДеревоОбъектов Из ДеревоОбъектовУчета.ПолучитьЭлементы() Цикл
		
		Если ЗначениеЗаполнено(СтрокаТаблицы_ДеревоОбъектов.Здание) И СтрокаТаблицы_ДеревоОбъектов.Услуга = ТекущиеДанные.Услуга Тогда
			
			СписокЗданий.Добавить(СтрокаТаблицы_ДеревоОбъектов.Здание);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ФормаВыбора = ПолучитьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая",,Элемент);
	
	ОтборЗдания = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	ОтборЗдания.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Организация");
	ОтборЗдания.ВидСравнения   = ВидСравненияКомпоновкиДанных.Равно;
	ОтборЗдания.ПравоеЗначение = Объект.Организация;
	
	Если СписокЗданий.Количество() > 0 Тогда
		
		ОтборЗдания = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		ОтборЗдания.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
		ОтборЗдания.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеВСписке;
		ОтборЗдания.ПравоеЗначение = СписокЗданий;
		
	КонецЕсли; 
	
	ФормаВыбора.Открыть();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьСтрокиДерева(Услуга)
	
	КолСтрок = ДеревоОбъектовУчета.ПолучитьЭлементы().Количество();
	
	Если КолСтрок = 0 Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Дерево = РеквизитФормыВЗначение("ДеревоОбъектовУчета");
	
	Отбор = Новый Структура;
	Отбор.Вставить("Услуга",Услуга);
	
	МассивСтрок = Дерево.Строки.НайтиСтроки(Отбор);
	
	Для каждого СтрокаНаУдаление Из МассивСтрок Цикл
		
		Дерево.Строки.Удалить(СтрокаНаУдаление);
		
	КонецЦикла; 
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоОбъектовУчета");
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовУчетаУслугаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.ДеревоОбъектовУчета.ТекущиеДанные;
	
	СтандартнаяОбработка = Ложь;
	
	Если НЕ ВыбранноеЗначение = ТекущиеДанные.Услуга Тогда
		
		ПодчиненныеСтроки = ТекущиеДанные.ПолучитьЭлементы();
		ПодчиненныеСтроки.Очистить();
		
		ТекущиеДанные.Услуга = ВыбранноеЗначение;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОбъектовУчетаЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.ДеревоОбъектовУчета.ТекущиеДанные;
	
	Отказ = Ложь;
	
	Родитель = ТекСтрока.ПолучитьРодителя();
	
	Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.УдалитьЛицевыеСчетаСоСчетчика") Тогда
		
		ПроверитьВозможностьУстановкиСчетчикаНаЛицевойСчет(Родитель.Здание,
		ВыбранноеЗначение, 
		Родитель.Услуга, 
		, 
		ТекСтрока.ОтветственноеЛицо, 
		ТекСтрока.Индивидуальный, 
		, 
		Отказ);
		
		Если Отказ Тогда
			СтандартнаяОбработка = Ложь;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсеУровни()
	
	Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
	
	Для каждого Строка Из Корень Цикл
		
		Элементы.ДеревоОбъектовУчета.Развернуть(Строка.ПолучитьИдентификатор(), Истина);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
		
		ТекущийОбъект.ЛицевыеСчета.Очистить();
		
		ПервыйУровень = ДеревоОбъектовУчета.ПолучитьЭлементы();
		
		Для каждого ТекСтрокаПервогоУровня Из ПервыйУровень Цикл
			
			ВторойУровень = ТекСтрокаПервогоУровня.ПолучитьЭлементы();
			
			Для каждого ТекСтрокаВторогоУровня Из ВторойУровень Цикл
				
				НоваяСтрока = ТекущийОбъект.ЛицевыеСчета.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрокаВторогоУровня);
				
				// БИТ_ЖКХ 03.10.2014
				Если Объект.ПодборРазныеЗдания = Истина Тогда
					
					НоваяСтрока.Услуга = ТекСтрокаВторогоУровня.Услуга;
					НоваяСтрока.Здание = ТекСтрокаВторогоУровня.Здание;
					НоваяСтрока.Адрес  = ТекСтрокаВторогоУровня.ПредставлениеЗдания;
				Иначе
					НоваяСтрока.Услуга = ТекСтрокаПервогоУровня.Услуга;
					НоваяСтрока.Здание = ТекСтрокаПервогоУровня.Здание;
					НоваяСтрока.Адрес  = ТекСтрокаПервогоУровня.ПредставлениеЗдания;
					
				КонецЕсли;
				// БИТ_ЖКХ 03.10.2014
				
			КонецЦикла; 
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьДерево()
	
	ПервыйУровень = ДеревоОбъектовУчета.ПолучитьЭлементы();
	ПервыйУровень.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЛС", Объект.ЛицевыеСчета.Выгрузить());
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЛС.Услуга КАК Услуга,
	|	ТаблицаЛС.Здание КАК Здание,
	|	ТаблицаЛС.ЛицевойСчет,
	|	ТаблицаЛС.ОтветственноеЛицо,
	|	ТаблицаЛС.Индивидуальный,
	|	ТаблицаЛС.Адрес КАК Адрес
	|ПОМЕСТИТЬ Таблица
	|ИЗ
	|	&ТаблицаЛС КАК ТаблицаЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Услуга КАК Услуга,
	|	Таблица.Здание КАК Здание,
	|	Таблица.ЛицевойСчет,
	|	Таблица.ОтветственноеЛицо,
	|	Таблица.Индивидуальный,
	|	Таблица.Адрес КАК Адрес
	|ИЗ
	|	Таблица КАК Таблица
	|ИТОГИ
	|	МАКСИМУМ(Адрес)
	|ПО
	|	Услуга,
	|	Здание";
	
	ВыборкаУслуга = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаУслуга.Следующий() Цикл
		
		ВыборкаЗдания = ВыборкаУслуга.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаЗдания.Следующий() Цикл
			
			НоваяСтрокаПервогоУровня = ПервыйУровень.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрокаПервогоУровня,ВыборкаЗдания);
			
			// БИТ_ЖКХ 03.10.2014
			Если Объект.ПодборРазныеЗдания Тогда
				
			Иначе
				Элементы.ПодборРазныеЗдания.Видимость = Ложь;
				НоваяСтрокаПервогоУровня.ПредставлениеЗдания = ВыборкаЗдания.Адрес;
			КонецЕсли;
			// БИТ_ЖКХ 03.10.2014
			
			НоваяСтрокаПервогоУровня.Родитель            = Истина;
			
			Выборка = ВыборкаЗдания.Выбрать();
			
			ВторойУровень = НоваяСтрокаПервогоУровня.ПолучитьЭлементы();
			
			Пока Выборка.Следующий() Цикл
				
				НоваяСтрокаВторогоУровня = ВторойУровень.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрокаВторогоУровня,Выборка);
				
				НоваяСтрокаВторогоУровня.Услуга              = Выборка.Услуга;
				НоваяСтрокаВторогоУровня.ПредставлениеЗдания = Выборка.Адрес;
				
			КонецЦикла; 
			
		КонецЦикла; 
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСтрокиДереваПоЗданию(ИдентификаторСтроки)
	
	ТекущиеДанные = ДеревоОбъектовУчета.НайтиПоИдентификатору(ИдентификаторСтроки);
	
	СписокИсключений = Новый СписокЗначений;
	
	Корень = ТекущиеДанные.ПолучитьЭлементы();
	
	Для каждого СтрокаДерева Из Корень Цикл
		
		Если ЗначениеЗаполнено(СтрокаДерева.ЛицевойСчет) Тогда
			
			СписокИсключений.Добавить(СтрокаДерева.ЛицевойСчет);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	
	ПостроительЗапроса.Параметры.Вставить("Дата"            , КонецДня(Объект.Дата));
	ПостроительЗапроса.Параметры.Вставить("Здание"          , ТекущиеДанные.Здание);
	ПостроительЗапроса.Параметры.Вставить("Услуга"          , ТекущиеДанные.Услуга);
	ПостроительЗапроса.Параметры.Вставить("СписокИсключений", СписокИсключений);
	
	ПостроительЗапроса.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	|ПОМЕСТИТЬ ОтвЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, НЕ ЛицевойСчет В (&СписокИсключений)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|	И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Наименование КАК ЛицевойСчетНаименование,
	|	ОтвЛицо.ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&Дата,
	|			Услуга = &Услуга
	|				И ЛицевойСчет.Здание = &Здание
	|				И НЕ ЛицевойСчет В (&СписокИсключений)) КАК бит_СведенияПоУслугамЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОтвЛицо КАК ОтвЛицо
	|		ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет = ОтвЛицо.ЛицевойСчет
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Наименование,
	|	ОтвЛицо.ФизЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛицевойСчетНаименование";
	
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик // БИТ_ЖКХ 03.12.2015 13:10:20 
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьЛицевыеСчетаСоСчетчика
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик
		ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьУслугиСоСчетчика Тогда
		
		ОтборЛС = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
		ОтборЛС.ВидСравнения  = ?(Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
								ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик // БИТ_ЖКХ 03.12.2015 13:10:36 
								,ВидСравнения.НеВСписке
								,ВидСравнения.ВСписке);
		ОтборЛС.Значение      = мКэшЗначений.СписокЛС;
		ОтборЛС.Использование = Истина;
		
	КонецЕсли; 
	
	ПостроительЗапроса.Выполнить();
	
	Выборка = ПостроительЗапроса.Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Корень.Добавить();
		
		НоваяСтрока.Здание              = ТекущиеДанные.Здание;
		НоваяСтрока.Услуга              = ТекущиеДанные.Услуга;
		НоваяСтрока.ПредставлениеЗдания = ТекущиеДанные.ПредставлениеЗдания;
		НоваяСтрока.ЛицевойСчет         = Выборка.ЛицевойСчет;
		НоваяСтрока.ОтветственноеЛицо   = Выборка.ФизЛицо;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ПроверитьНаличиеСчетчиков(СписокУслуг)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Объект"     , Объект.Объект);
	Запрос.УстановитьПараметр("СписокУслуг", СписокУслуг);
	Запрос.УстановитьПараметр("Ссылка"     , Параметры.Ключ);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга КАК Услуга
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Объект = &Объект
	|				И Услуга В (&СписокУслуг)
	|				И (НЕ Регистратор = &Ссылка)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|ИТОГИ ПО
	|	Услуга";
	
	ВыборкаУС = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаУС.Следующий() Цикл
		
		Выборка = ВыборкаУС.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Услуга = СписокУслуг.НайтиПоЗначению(ВыборкаУС.Услуга);
			
			Если НЕ Услуга = Неопределено Тогда
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("По услуге: " + Услуга + " установлен другой счетчик начисление разовых не требуется.");
				
				СписокУслуг.Удалить(Услуга);
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

