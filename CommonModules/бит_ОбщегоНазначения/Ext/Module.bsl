// Функция находит актуальное значение адреса в контакной информации.
//
// Параметры:
//  Объект - СправочникСсылка, объект контактной информации.
//
//  ТипАдреса - тип контактной информации из перечисления(Фактический, Регистрации,Юридический,.
//	Информирования, Иностранный, Прибытия, Убытия).
//  ПолныйСписок - выбор варианта запроса: вся информация из регистра или строка.
//
// Возвращаемое значение:
//  Строка или Структура - представление найденного адреса.
//
Функция ПолучитьАдресИзКонтактнойИнформацииФизЛица(Объект, ТипАдреса = "", ПолныйСписок = Ложь) Экспорт
	
	ОбъектКонтактнойИнформации = Объект;
	
	Если НЕ ЗначениеЗаполнено(ТипАдреса) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипАдреса="Фактический" Тогда
		Начало = "Факт";
	ИначеЕсли ТипАдреса="Регистрации"
		ИЛИ ТипАдреса="Юридический" Тогда
		Начало = "Юр";
		// БИТ_ЖКХ добавление кода Начало: 06.04.2012 
	ИначеЕсли ТипАдреса="Информирования" Тогда
		Начало = "Информ";
	ИначеЕсли ТипАдреса="Иностранный" Тогда
		Начало = "Иностр";
	Иначе
		Начало = "";
	КонецЕсли;
	
	Окончание = "Проживающего";
	
	Если ТипАдреса  = "Прибытия" Тогда
		Окончание = "Прибытия";
	ИначеЕсли ТипАдреса  = "Убытия" Тогда
		Окончание = "Убытия";
	КонецЕсли;
	
	Если Начало = "" и Окончание = "Проживающего" Тогда
		Возврат "";
	КонецЕсли;
	// БИТ_ЖКХ добавление кода конец : 06.04.2012
	
	ВидАдреса = Справочники.бит_ВидыКонтактнойИнформации[Начало+"Адрес"+Окончание];
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Объект", ОбъектКонтактнойИнформации);
	// БИТ_ЖКХ 01.12.2010. 
	// Замена указаний типовых объектов на объекты БИТ в тексте модуля.
	Запрос.УстановитьПараметр("Тип"   , Перечисления.бит_ТипыКонтактнойИнформации.Адрес);
	Запрос.УстановитьПараметр("Вид"   , ВидАдреса);
	
	// БИТ_ЖКХ добавление кода Начало: 13.04.2012 
	Если ПолныйСписок Тогда
		
		Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтактнаяИнформация.Представление,
		|	КонтактнаяИнформация.Поле1,
		|	КонтактнаяИнформация.Поле2,
		|	КонтактнаяИнформация.Поле3,
		|	КонтактнаяИнформация.Поле4,
		|	КонтактнаяИнформация.Поле5,
		|	КонтактнаяИнформация.Поле6,
		|	КонтактнаяИнформация.Поле7,
		|	КонтактнаяИнформация.Поле8,
		|	КонтактнаяИнформация.Поле9,
		|	КонтактнаяИнформация.Поле10,
		|	КонтактнаяИнформация.ТипДома,
		|	КонтактнаяИнформация.ТипКорпуса,
		|	КонтактнаяИнформация.ТипКвартиры
		|ИЗ
		|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И КонтактнаяИнформация.Тип = &Тип
		|	И КонтактнаяИнформация.Вид = &Вид";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат "";
		Иначе
			СтрокаИзРегистра = РезультатЗапроса.Выгрузить()[0];
			СтруктураАдреса = Новый Структура();
			СтруктураАдреса.Вставить("Поле1",			СтрокаИзРегистра.Поле1);
			СтруктураАдреса.Вставить("Поле2",			СтрокаИзРегистра.Поле2);
			СтруктураАдреса.Вставить("Поле3",			СтрокаИзРегистра.Поле3);
			СтруктураАдреса.Вставить("Поле4",			СтрокаИзРегистра.Поле4);
			СтруктураАдреса.Вставить("Поле5",			СтрокаИзРегистра.Поле5);
			СтруктураАдреса.Вставить("Поле6",			СтрокаИзРегистра.Поле6);
			СтруктураАдреса.Вставить("Поле7",			СтрокаИзРегистра.Поле7);
			СтруктураАдреса.Вставить("Поле8",			СтрокаИзРегистра.Поле8);
			СтруктураАдреса.Вставить("Поле9",			СтрокаИзРегистра.Поле9);
			СтруктураАдреса.Вставить("Представление",	СтрокаИзРегистра.Представление);
			СтруктураАдреса.Вставить("ТипДома",			СтрокаИзРегистра.ТипДома);
			СтруктураАдреса.Вставить("ТипКорпуса",		СтрокаИзРегистра.ТипКорпуса);
			СтруктураАдреса.Вставить("ТипКвартиры",		СтрокаИзРегистра.ТипКвартиры);
			Возврат СтруктураАдреса;
		КонецЕсли;
		
	Иначе
		// БИТ_ЖКХ добавление кода конец : 13.04.2012
		
		Запрос.Текст = "
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И
		|	КонтактнаяИнформация.Тип = &Тип
		|	И
		|	КонтактнаяИнформация.Вид = &Вид
		|";
		
		РезультатЗапроса = Запрос.Выполнить();
		
		Если РезультатЗапроса.Пустой() Тогда
			Возврат "";
		Иначе
			Возврат РезультатЗапроса.Выгрузить()[0].Представление;
		КонецЕсли;
		
	КонецЕсли; 
	
