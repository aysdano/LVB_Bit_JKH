// Процедура производит действия, которые необходимо выполнить при начале работы системы.
//
Функция ДействияПриНачалеРаботыСистемы(СтрПар) Экспорт
	
	//АПК пункт 4 https://its.1c.ru/db/v8std/content/737/hdoc
	Если РольДоступна("бит_АдминистраторПравДоступа") Тогда
		
		бит_ПраваДоступа.ОбновитьОбъектыДоступа();
		
	КонецЕсли; 
	
	// БИТ_ЖКХ 17.02.2014{{
	
	РезСтр = Новый Структура;
	РезСтр.Вставить("ВыполненоОбновлениеИБ", Ложь);
	РезСтр.Вставить("ПротоколОбновлениеИБ", "");
	
	Если СтрПар.НеобходимоОбновитьИБ Тогда
		
		// Обновим информационную базу.
		РезОбновлениеИБ = ВыполнитьОбновлениеИнформационнойБазы(СтрПар);
		РезСтр.ВыполненоОбновлениеИБ = РезОбновлениеИБ.Выполнено;
		РезСтр.ПротоколОбновлениеИБ  = РезОбновлениеИБ.Протокол;
		
	КонецЕсли; 
	
	Возврат РезСтр;
	
	// БИТ_ЖКХ 17.02.2014}}
	
КонецФункции //ДействияПриНачалеРаботыСистемы()

// Выполняет обновление информационной базы при необходимости.
//
Функция ВыполнитьОбновлениеИнформационнойБазы(СтрПар) Экспорт
	
	Сведения             = СтрПар.Сведения;
	НомерРелизаБиТ       = СтрПар.НомерРелизаБИТ;
	КонстантаНомерРелиза = СтрПар.КонстантаНомерРелиза;
	ПервыйЗапуск         = СтрПар.ПервыйЗапуск;
	
	флВыполнять = СтрПар.НеобходимоОбновитьИБ;
	
	БазоваяПоставка = (Найти(ВРег(Метаданные.Имя), "БАЗОВАЯ") > 0);
	// Установка монопольного режима для обновления информационной базы.
	Если НЕ БазоваяПоставка Тогда
		
		Попытка
			УстановитьМонопольныйРежим(Истина);
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = НСтр("ru = 'Для обновления бит_ЖКХ перезапустите 1СПредприятие.
										|%2'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			флВыполнять = Ложь;
		КонецПопытки;
		
	КонецЕсли; 
	
	Протокол = "";
	Если флВыполнять Тогда
		
		// Если включен режим разделения доступа на уровне базы его необходимо выключить на период обновления.
		флВключенМеханизмПрав = Ложь;
		Если Константы.бит_ИспользоватьРазделениеДоступаНаУровнеБазы.Получить() Тогда
			
			флВключенМеханизмПрав = Истина;
			Константы.бит_ИспользоватьРазделениеДоступаНаУровнеБазы.Установить(Ложь);
			
		КонецЕсли; 
		
		// Обновление или первоначальное заполнение информационной базы.
		ОбработкаОбновления = Обработки.бит_ОбновлениеИнформационнойБазы.Создать();
		Если ПервыйЗапуск Тогда
			ОбработкаОбновления.ПервоеЗаполнение();
		Иначе
			ОбработкаОбновления.ВыполнитьОбновление();		
		КонецЕсли;
		Протокол = ОбработкаОбновления.мПротокол;
		
		// Механизм прав был выключен на период обновления - следует его включить.
		Если  флВключенМеханизмПрав Тогда
			Константы.бит_ИспользоватьРазделениеДоступаНаУровнеБазы.Установить(Истина);
		КонецЕсли;
		
	КонецЕсли; 
	
	// Откючение монопольного режима.
	Если НЕ БазоваяПоставка Тогда
		УстановитьМонопольныйРежим(Ложь);
	КонецЕсли; 	
	
	// Проверка выполнения обновления информационной базы.
	
	// БИТ_ЖКХ 19.02.2014
	
	// флВыполнено = (Константы.бит_НомерРелиза.Получить() = НомерРелизаБиТ);.
	флВыполнено = (Константы.бит_НомерВерсииКонфигурацииБИТ.Получить() = НомерРелизаБиТ);
	
	// БИТ_ЖКХ 19.02.2014
	
	РезСтр = Новый Структура("Выполнено, Протокол", флВыполнено, Протокол);
	
	Возврат РезСтр;
	
КонецФункции // ВыполнитьОбновлениеИнформационнойБазы

