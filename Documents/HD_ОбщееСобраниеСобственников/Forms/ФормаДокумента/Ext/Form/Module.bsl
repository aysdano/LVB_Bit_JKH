//
&НаСервере
Процедура НастроитьВидимостьПредставителяУКНаСервере()
	
	ИнициаторУК = Ложь;
	
	Если ЗначениеЗаполнено(Объект.ШаблонПовестки)
		И ТипЗнч(Объект.ШаблонПовестки) = Тип("СправочникСсылка.HD_ФиксированныйСписокПовесток") Тогда
		
		РеквизитИнициаторУК = Метаданные.Справочники.HD_ФиксированныйСписокПовесток.Реквизиты.Найти("ИнициаторУК");
		Если РеквизитИнициаторУК <> Неопределено Тогда
			ЗначениеФлага = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ШаблонПовестки, "ИнициаторУК");
			ИнициаторУК = (ТипЗнч(ЗначениеФлага) = Тип("Булево") И ЗначениеФлага);
		КонецЕсли;
		
	КонецЕсли;
	
	УстановитьВидимостьЭлементаФормыПоИмени("ГруппаПредставительУК", ИнициаторУК);
	УстановитьВидимостьЭлементаФормыПоИмени("ГруппаПредставитель_1", НЕ ИнициаторУК);
	УстановитьВидимостьЭлементаФормыПоИмени("ГруппаПредставитель_2", НЕ ИнициаторУК);
	
