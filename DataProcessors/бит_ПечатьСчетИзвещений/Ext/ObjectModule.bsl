			ТабДокуРаздел8.Вывести(ОбластьРаздел8Шапка);
			
			ТабПечатиПолучателиКап = ТабПечатиКап.Скопировать(,
				"КапПолучательПлатежа,КапПолучательПлатежаИмя,КапПолучательИНН,КапПолучательКПП,КапПолучательРС,КапПолучательКоррСчет,КапПолучательБИК,КапПолучательБанк");
			
			ТабПечатиПолучателиКап.Свернуть("КапПолучательПлатежа,КапПолучательПлатежаИмя,КапПолучательИНН,КапПолучательКПП,КапПолучательРС,КапПолучательКоррСчет,КапПолучательБИК,КапПолучательБанк");
			
			Для Каждого Стр Из ТабПечатиПолучателиКап Цикл	// Обход Получателей.
				МассивУслугиПоставщика =  ТабПечатиКап.НайтиСтроки(Новый Структура("КапПолучательПлатежа",Стр.КапПолучательПлатежа));
				
				ОбластьРаздел8Строка.Параметры.ПолучательПлатежа = Стр.КапПолучательПлатежаИмя;
				
				ТекстПолучательСчет = "";
				Если ЗначениеЗаполнено(Стр.КапПолучательРС)
					ИЛИ ЗначениеЗаполнено(Стр.КапПолучательИНН)
					ИЛИ ЗначениеЗаполнено(Стр.КапПолучательКПП)
					ИЛИ ЗначениеЗаполнено(Стр.КапПолучательБанк)
					ИЛИ ЗначениеЗаполнено(Стр.КапПолучательКоррСчет)
					ИЛИ ЗначениеЗаполнено(Стр.КапПолучательБИК) Тогда
					
					ТекстПолучательСчет = НСтр("ru='р/с: %1 ИНН: %2 КПП: %3
					|Банк: %4
					|Корр.счет.\БИК: %5'");
					
					ТекстПолучательСчет = СтрШаблон(ТекстПолучательСчет,
													Стр.КапПолучательРС,
													Стр.КапПолучательИНН,
													Стр.КапПолучательКПП,
													Стр.КапПолучательБанк,
													Стр.КапПолучательКоррСчет + " \ " + Стр.КапПолучательБИК);
					
				КонецЕсли;
				
				ОбластьРаздел8Строка.Параметры.ПолучательСчет = ТекстПолучательСчет;
				ОбластьРаздел8Строка.Параметры.ЛицевойСчет = Строка(мСтруктураДанных.ЛицевойСчет); 
				
				КОплатеЗаМесяц = 0;
				ВидУслуги	   = "";
				
				Для Каждого СтрУслуга Из МассивУслугиПоставщика Цикл	// Группировка  услуг поставщиков.
					Если НЕ СтрУслуга.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт") Тогда
						Продолжить;
					КонецЕсли;
					КОплатеЗаМесяц = КОплатеЗаМесяц + СтрУслуга.КОплатеЗаМесяц;
					ВидУслуги = ?(ПустаяСтрока(ВидУслуги),ВидУслуги, ВидУслуги + ", ") + Строка(СтрУслуга.УслугаПредставление);  
				КонецЦикла;
				ОбластьРаздел8Строка.Параметры.ВидУслуги	  = ВидУслуги;
				ОбластьРаздел8Строка.Параметры.КОплатеЗаМесяц = Формат(КОплатеЗаМесяц, "ЧДЦ=2; ЧН=0,00");
				
				Если НеПечататьУслугиБезНачислений
					И КОплатеЗаМесяц = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				ТабДокуРаздел8.Вывести(ОбластьРаздел8Строка);
			КонецЦикла;
			
			ОбластьРаздел8Итог.Параметры.ДатаПоследнейОплаты = мСтруктураДанных.ДатаПоследнейОплатыКапРем;
			ОбластьРаздел8Итог.Параметры.Коплате = ИтогоКапКОплате;
			Если ИтогоКапЗакрытиеВхДолга >= 0 Тогда
				ОбластьРаздел8Итог.Параметры.ДолгСУчетомОплаты = ИтогоКапЗакрытиеВхДолга;
			Иначе
				ОбластьРаздел8Итог.Параметры.Авансы = ИтогоКапЗакрытиеВхДолга * -1;
			КонецЕсли;
			
			ТабДокуРаздел8.Вывести(ОбластьРаздел8Итог);
		КонецЕсли;
	
		Если НЕ ТабДокуРаздел8 = Неопределено 
			И ТабДокуРаздел8.ВысотаТаблицы > 14 Тогда
			Если НЕ ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(Квитанция, ТабДокуРаздел8) Тогда
				Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
				Квитанция.Вывести(ТабДокуРаздел8);
			Иначе
				Квитанция.Вывести(ТабДокуРаздел8);
			КонецЕсли;  
		КонецЕсли; 
		
		
	Иначе	// НЕ мКэшПараметрыЖКХ.РаздельныйУчетКапРемонта.
		
		ТабПечатиКап = мТаблицаПечати.Скопировать(Новый Структура("ГрафаОтчетаГЦЖС", ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт")));
		мСтруктураДанных.ПереплатаНаНачало = мСтруктураДанных.ПереплатаНаНачало + мСтруктураДанных.Оплата;
		ОбластьЗаголовок.Параметры.Заполнить(мСтруктураДанных);
		Квитанция.Вывести(ОбластьЗаголовок);
		
		// ОбластьШапка.
		ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
		ОбластьШапка.Параметры.Заполнить(мКэшПолучателяПлатежа);
		Организация_1 = "";
		Организация_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательПредставление, 59, Организация_1 , Организация_2 );
		ЗаполнитьПараметр(ОбластьШапка, "Организация_1", Организация_1);
		ЗаполнитьПараметр(ОбластьШапка, "Организация_2", Организация_2);
		АдресОрганизация_1 = "";
		АдресОрганизация_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательАдрес, 65, АдресОрганизация_1 , АдресОрганизация_2 );
		ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизация_1", АдресОрганизация_1);
		ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизация_2", АдресОрганизация_2);
		ДопИнформацияОрганизация_1 = "";
		ДопИнформацияОрганизация_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ПолучательДопИнформация, 20, ДопИнформацияОрганизация_1 , ДопИнформацияОрганизация_2);
		ЗаполнитьПараметр(ОбластьШапка, "ДопИнформацияОрганизация_1", ДопИнформацияОрганизация_1);
		ЗаполнитьПараметр(ОбластьШапка, "ДопИнформацияОрганизация_2", ДопИнформацияОрганизация_2);
		Квитанция.Вывести(ОбластьШапка);
		
		// ОбластьРаздел2Шапка.
		ТабДокуРаздел2 = Новый ТабличныйДокумент;
		ТабДокуРаздел2.Вывести(ОбластьРаздел2Шапка);

		// ОбластьРаздел2Строка.
		Если ПолучательПлатежа924 Тогда
			
			ТабПечатиПолучатели = мТаблицаПечати.Скопировать(,
			"ПолучательПлатежа, ПолучательПлатежаИмя,ПолучательИНН,ПолучательКПП,ПолучательРС,ПолучательКоррСчет,ПолучательБИК,ПолучательБанк");
			
			ТабПечатиПолучатели.Свернуть("ПолучательПлатежа, ПолучательПлатежаИмя,ПолучательИНН,ПолучательКПП,ПолучательРС,ПолучательКоррСчет,ПолучательБИК,ПолучательБанк");
			
			Для Каждого Стр Из ТабПечатиПолучатели Цикл	// Обход Получателей.
				МассивУслугиПоставщика =  мТаблицаПечати.НайтиСтроки(Новый Структура("ПолучательПлатежа",Стр.ПолучательПлатежа));
				
				ОбластьРаздел2Строка.Параметры.ПолучательПлатежа = Стр.ПолучательПлатежаИмя;
				
				ТекстПолучательСчет = "";
				Если ЗначениеЗаполнено(Стр.ПолучательРС)
					ИЛИ ЗначениеЗаполнено(Стр.ПолучательИНН)
					ИЛИ ЗначениеЗаполнено(Стр.ПолучательКПП)
					ИЛИ ЗначениеЗаполнено(Стр.ПолучательБанк)
