Функция НуженСдвигПоЗданию_ЛС_Физлицу_ДатеРег(Элем1, Элем2)
	НуженСдвиг = Неопределено;
	Если Элем1=неопределено и Элем2=Неопределено  тогда
		НуженСдвиг = ложь
	ИначеЕсли Элем1 = Неопределено и Элем2<>Неопределено тогда
		НуженСдвиг = истина
	ИначеЕсли Элем1 <> Неопределено = Элем2<>Неопределено тогда
		НуженСдвиг = ложь
	КонецЕсли;	
	
	Если (Элем1 = Неопределено) или (Элем2 = Неопределено) тогда
		возврат НуженСдвиг
	КонецЕсли;
	
	
	          
	////По коду здания,  	
	//Если Элем1.ЗданиеКод>Элем2.ЗданиеКод тогда
	//	НуженСдвиг = истина;
	//ИначеЕсли Элем1.ЗданиеКод<Элем2.ЗданиеКод тогда
	//	НуженСдвиг = ложь;
	Если ложь тогда
		//отключаем по зданию
	
	//Здание совпадает, по ЛС	
	ИначеЕсли Элем1.ИмяЛС>Элем2.ИмяЛС тогда
		НуженСдвиг = истина;
	ИначеЕсли Элем1.ИмяЛС<Элем2.ИмяЛС тогда
		НуженСдвиг = ложь;
		
		//ИмяЛС совпадает, сравниваем УИДы Физлиц				
	ИначеЕсли ""+Элем1.ФЛ.УникальныйИдентификатор()	
		> ""+Элем2.ФЛ.УникальныйИдентификатор() тогда
		НуженСдвиг = истина
	ИначеЕсли ""+Элем1.ФЛ.УникальныйИдентификатор()	
		< ""+Элем2.ФЛ.УникальныйИдентификатор() тогда
		НуженСдвиг = ложь	
		
		//ИмяЛС и ФизЛицоСовпадает, сравниваем даты прописки
	Иначе 
		НуженСдвиг = Элем1.ДПрописки>Элем2.ДПрописки; 				
	КонецЕсли;
	
	возврат нуженСдвиг
КонецФункции
	
