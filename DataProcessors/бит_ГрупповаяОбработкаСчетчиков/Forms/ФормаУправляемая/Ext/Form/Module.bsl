#Область ДействияКомандФормы

#Область СтраницаМенюКоманды

&НаКлиенте
Процедура ЗаведениеИУстановкаСчетчиков(Команда)
	
	ПриВыбореПунктаМеню(Элементы.ЗаведениеИУстановкаСчетчиков);
	
	Элементы.ЗаведениеИУстановкаСчетчиков.Пометка     = Истина;
	Элементы.ИзменениеСоставаУслугПоСчетчикам.Пометка = Ложь;
	Элементы.СнятиеСчетчиков.Пометка                  = Ложь;
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаЗаведениеИУстановкаСчетчиков;
	Элементы.Страницы.ТекущаяСтраница      = Элементы.ГруппаЛицевыеСчета;
	
	Элементы.ДеревоСчетчиковГруппаСозданиеСЧ.Видимость  = Истина;
	Элементы.ДеревоСчетчиковГруппаУстановкаСЧ.Видимость = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ИзменениеСоставаУслугПоСчетчикам(Команда)
	
	ПриВыбореПунктаМеню(Элементы.ИзменениеСоставаУслугПоСчетчикам);
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаИзменениеСоставаУслугПоСчетчикам;
	
	ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик");
	Элементы.ГруппаСписокУслуг.Видимость = Истина;
	Элементы.ВидОперации.Доступность     = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура СнятиеСчетчиков(Команда)
	
	ПриВыбореПунктаМеню(Элементы.СнятиеСчетчиков);
	
	Элементы.СтраницыФормы.ТекущаяСтраница = Элементы.СтраницаИзменениеСоставаУслугПоСчетчикам;
	
	ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика");
	Элементы.ГруппаСписокУслуг.Видимость = Ложь;
	Элементы.ВидОперации.Доступность     = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область СтраницаИзменениеСоставаУслугПоСчетчикамКоманды

&НаКлиенте
Процедура ВыполнитьОперацию(Команда)
	ВыполнитьОперациюНаСервере();
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаСчетчиковУстановитьФлажки(Команда)
	
	Для каждого СтрокаТабилицы Из ТаблицаСчетчиков Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТабилицы.Документ) Тогда
			СтрокаТабилицы.Обрабатывать = НЕ СтрокаТабилицы.ЕстьОшибка;
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборУслуг(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина);
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ОткрытьФормуВыбораУслуг(ЭтаФорма,ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборСчетчиков(Команда)
	
	СтандартнаяОбработка = Ложь;
	
	ОтборВидСчетчика = Новый Структура;
	ОтборВидСчетчика.Вставить("ИмяПоля"       , "ВидСчетчика");
	ОтборВидСчетчика.Вставить("ПравоеЗначение", ВидыСчетчика);
	ОтборВидСчетчика.Вставить("Использование" , ИспользоватьОтборВидСчетчика);
	ОтборВидСчетчика.Вставить("ВидСравнения"  , ВидСравненияВидСчетчика);
	
	ДополнительныеОтборы = Новый Структура;
	ДополнительныеОтборы.Вставить("ОтборВидСчетчика", ОтборВидСчетчика);
	
	ПараметрыФормыВыбора = Новый Структура;
	
	ПараметрыФормыВыбора.Вставить("Дата"                , КонецДня(ТекущаяДата()));
	ПараметрыФормыВыбора.Вставить("Установлен"          , Истина);
	ПараметрыФормыВыбора.Вставить("ТипСчетчика"         , ПредопределенноеЗначение("Перечисление.бит_ТипСчетчика.Индивидуальный"));
	ПараметрыФормыВыбора.Вставить("РежимВыбора"         , Истина);
	ПараметрыФормыВыбора.Вставить("МножественныйВыбор"  , Истина);
	ПараметрыФормыВыбора.Вставить("ЗакрыватьПриВыборе"  , Ложь);
	ПараметрыФормыВыбора.Вставить("ДополнительныеОтборы", ДополнительныеОтборы);
	
	Если ИспользоватьОтборЛицевойСчет Тогда
		
		Если ТипЗнч(ЛицевыеСчета) = Тип("СписокЗначений") Тогда
			СписокОбъектовУчета = ЛицевыеСчета;
		Иначе
			СписокОбъектовУчета = Новый СписокЗначений;
			СписокОбъектовУчета.Добавить(ЛицевыеСчета);
		КонецЕсли;
		
		ПараметрыФормыВыбора.Вставить("СписокОбъектовУчета", СписокОбъектовУчета);
		
	ИначеЕсли ИспользоватьОтборСписокЗданий Тогда
		
		Если ТипЗнч(СписокЗданий) = Тип("СписокЗначений") Тогда
			СписокОбъектовУчета = СписокЗданий;
		Иначе
			СписокОбъектовУчета = Новый СписокЗначений;
			СписокОбъектовУчета.Добавить(СписокЗданий);
		КонецЕсли;
		
		ПараметрыФормыВыбора.Вставить("СписокОбъектовУчета", СписокОбъектовУчета);
		ПараметрыФормыВыбора.Вставить("ЭтоСписокЗданий"    , Истина);
		
	КонецЕсли;
	
	Если НЕ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика") Тогда
		ПараметрыФормыВыбора.Вставить("Многотарифный", Ложь);
	КонецЕсли; 
	
	ОткрытьФорму("Справочник.бит_Счетчики.Форма.ФормаВыбораСчетчиков", ПараметрыФормыВыбора, ЭтаФорма);
	
КонецПроцедуры

