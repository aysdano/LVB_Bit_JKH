	КонецЕсли;
	
	Если ЗначениеЗаполнено(КонтролирующийОрган) Тогда
		
		АдресКО   = бит_ПаспортныйСтолСервер.ПолучитьАдресИзКонтактнойИнформации(КонтролирующийОрган, "Фактический");
		ТелефонКО = бит_ПаспортныйСтолСервер.ПолучитьТелефонИзКонтактнойИнформации(КонтролирующийОрган);
		СайтКО    = бит_ПаспортныйСтолСервер.ПолучитьВебСтраницуИзКонтактнойИнформации(КонтролирующийОрган);
		
	КонецЕсли; 
	
КонецПроцедуры // ()

// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
&НаСервере
Процедура ЗаписатьТСЖ(ЗакрытиеТСЖ = Ложь)
	
	Если НЕ ЗначениеЗаполнено(ТСЖ) Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Отказ = Истина;
	
	Если (НЕ ТСЖ = ТСЖПриОткрытии
		ИЛИ  НЕ ДатаСоздания = ДатаСозданияПриОткрытии 
		ИЛИ  НЕ Председатель = ПредседательПриОткрытии 
		ИЛИ  НЕ КонтролирующийОрган = КонтролирующийОрганПриОткрытии
		
		ИЛИ  НЕ Период = ПериодПриОткрытии) ИЛИ ЗакрытиеТСЖ Тогда
		
		Отказ = Ложь;
		
	КонецЕсли;
	
	Если Отказ Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Здание", Объект.Ссылка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_ИнформацияТСЖСрезПоследних.ТСЖ,
	|	бит_ИнформацияТСЖСрезПоследних.ДатаСоздания КАК ДатаСоздания,
	|	бит_ИнформацияТСЖСрезПоследних.Председатель,
	|	бит_ИнформацияТСЖСрезПоследних.КонтролирующийОрган,
	|	бит_ИнформацияТСЖСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.бит_ИнформацияТСЖ.СрезПоследних(&период, Здание = &Здание) КАК бит_ИнформацияТСЖСрезПоследних
	|ГДЕ
	|	(бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия > &Период)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Выборка.Следующий();
	
	ЗаписьТСЖ = РегистрыСведений.бит_ИнформацияТСЖ.СоздатьМенеджерЗаписи();
	
	Если Выборка.Следующий() Тогда
		
		ЗаполнитьЗначенияСвойств(ЗаписьТСЖ, Выборка);
		
	Иначе
		
		ЗаписьТСЖ.Период = Период;
		ЗаписьТСЖ.Здание = Объект.Ссылка;
		
	КонецЕсли; 
	
	ЗаписьТСЖ.ТСЖ                 = ТСЖ;
	ЗаписьТСЖ.ДатаСоздания        = ДатаСоздания;
	ЗаписьТСЖ.КонтролирующийОрган = КонтролирующийОрган;
	ЗаписьТСЖ.Председатель        = Председатель;
	
	Если ЗакрытиеТСЖ Тогда
		
		ЗаписьТСЖ.ДатаЗакрытия = ТекущаяДата();
		
	КонецЕсли; 
	
	Попытка
		
		ЗаписьТСЖ.Записать(Истина);
		
	Исключение
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Неудалось записать информацию о ТСЖ.");
		
	КонецПопытки; 
	
КонецПроцедуры // ()

