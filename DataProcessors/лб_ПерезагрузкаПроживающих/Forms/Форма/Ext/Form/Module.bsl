				Набор.Отбор.Регистратор.Использование = истина;
				Набор.Очистить();
				Набор.Записать(истина); //для нового дома - очищаем старые записи
				СтрокаТекДок.Набор = набор;
			КонецЕсли;	
		КонецЕсли;	
		
		//Смена ЛС
	
		
		
		Если ТекЛС <>Стру.ЛС тогда
			//произошла смена ЛС, возможно, нужно изменить 
			//строки с ответственным, чтобы был ответственный на ЛС
			Если СтрОтветственного<>Неопределено и 
				 ЗначениеЗаполнено(СтрОтветственного.ДатаСнятияСРегистрации) 
			тогда			    
				 Если СтрОтветственного.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает тогда
					 СтрОтветственного.ДатаСнятияСРегистрации = '0001-01-01';
				 иначе
				 	 СтрОтв2 = Набор.Добавить();
					 ЗаполнитьЗначенияСвойств(СтрОтв2,СтрОтветственного,,"Регистратор");
					 СтрОтв2.ДатаРегистрации = СтрОтв2.ДатаСнятияСРегистрации;
					 СтрОтв2.ДатаСнятияСРегистрации = '0001-01-01';
					 СтрОтв2.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
					 СтрОтв2.СтатусФизЛица = ОтветственныйНеПроживает; 
					 СтрОтв2.Период = Объект.Дата + Набор.Индекс(СтрОтв2);
				 КонецЕсли; 
				 
			КонецЕсли;
			
			//настраиваемся на новый ЛС
			Ответственный = неопределено;	
			СтрОтветственного = неопределено;  		
			ТекЛС = Стру.ЛС;
		КонецЕсли;	 		
		
		Если Не ЗначениеЗаполнено(Стру.ЛС) или Не ЗначениеЗаполнено(Стру.ФЛ) тогда
			продолжить
		КонецЕсли;	
		
		//Добавляем строку ЛС
		СтрокаЖ = Набор.Добавить();				
			//СтрокаЖ.ДатаЗаписи ='0001-01-01'; //Дата окончания статуса
			СтрокаЖ.Период = Объект.Дата + Набор.Индекс(СтрокаЖ);
			СтрокаЖ.Физлицо = Стру.ФЛ;
			СтрокаЖ.ЛицевойСчет = Стру.ЛС;
			СтрокаЖ.ДатаРегистрации = Стру.ДПрописки;
			СтрокаЖ.ДатаСнятияСРегистрации = ?(Стру.ДВыписки>'2500-01-01','0001-01-01',Стру.ДВыписки);
			Строкаж.ВладелецКвартиры = ?(Стру.PR_SOB=1,Перечисления.ДаНет.Да,Перечисления.ДаНет.Нет);
			СтрокаЖ.ДоляПлощади = ?(Стру.D2=0,0,Стру.D1/Стру.D2);
			СтрокаЖ.лб_ДоляПлощадиСтрокой = СокрЛП(Стру.SOBST);
			СтрокаЖ.СтепеньРодства = Стру.СтепеньРодства;
			Если СтрокаЖ.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо тогда
				СтрокаЖ.лб_СтрокаРодствДляФЛС = сокрЛП(Стру.RODOTN);
			КонецЕсли;	
			//Контрагент
			//КудаВыписан
			//КудаВыписанАдрес
			//ОткудаПрибыл
			//ОткудаПрибылАдрес
			//ПравоустанавливающиеДокументы
			//ПричинаВыписки
			//ПричинаПрописки
			СтатусПрож = Стру.STATYS;
			ЭтоСобственник = Стру.PR_SOB=1;
			Если СтатусПрож = "постоянная" тогда
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.Постоянно;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.ПостояннаяРегистрация;
			ИначеЕсли 	СтатусПрож = "временная" тогда
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.Временно;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.ВременнаяРегистрация;
				
				//Человек не проживает. Варианты - Собственник не проживает, либо человек убран с ЛС
			иначеЕсли  СтрокаЖ.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо тогда
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
				СтрокаЖ.СтатусФизЛица = ОтветственныйНеПроживает;		

			ИначеЕсли ЭтоСобственник тогда
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.НайтиПоНаименованию("Владелец не проживает");
			иначе	
				СтрокаЖ.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
				СтрокаЖ.СтатусФизЛица = Справочники.бит_СтатусФизЛица.Выписан;				
			КонецЕсли;	
			///*** - добавить статусы для Саобственник не проживает - на него
			// Если собственник и выписан - меняем на Собственник не проживает
			// если не собственник и выписан - то меняем на Уделен с лицевого счета
			
			
			
		
		
		
	КонецЦикла;	
	
	
	Отчет = Отчет + Символы.ПС + 
			"  Этап6 - Заполнение данных для регистра: " + (ТекущаяДата()-ДТ) +  " сек." ;
	ДТ = ТекущаяДата(); 
	
	
	Для каждого СтрокаТекДок из мДокиДомов цикл
		Если СтрокаТекДок.Набор <> неопределено и 
			 	СтрокаТекДок.Набор.Количество()>0 
