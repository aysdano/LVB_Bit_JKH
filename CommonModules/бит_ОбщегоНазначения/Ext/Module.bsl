					Для Каждого ТекСтрока Из СписокКУОтбор Цикл 
						ТекСтрока.Сумма = ТекСтрока.Сумма + ?(ИтогНачисления = 0 ,0 ,ТекСтрока.Начислено/ИтогНачисления) * СуммаДляРаспределения;
					КонецЦикла;
					
					Для Каждого ТекСтрока Из СписокКУОтбор Цикл
						МассивСтрок = КоммунальныеУслуги.НайтиСтроки(Новый Структура("Услуга,ШаблонИзвещений",ТекСтрока.Услуга,ТекСтрока.ШаблонИзвещений));
						Если МассивСтрок.Количество() >0 тогда
							МассивСтрок[0].Сумма = ТекСтрока.Сумма; 
