Процедура ЗаписатьДанныеВФорматеXML(ПутьКФайлуДляЗаписи) Экспорт
	
	//ПутьКФайлуДляЗаписи = "D:\Разработка\ГЦЖС\НастрокаОтчетаГЦЖС.XML";
	
    НаборЗаписей = РегистрыСведений.бит_НастройкаОтчетаГЦЖС.СоздатьНаборЗаписей();		  
	НаборЗаписей.Прочитать();
	
	таблицаНабора = НаборЗаписей.Выгрузить();
	таблицаНабора.Сортировать("НомерПоляExcel");
 
    ЗаписьXML = Новый ЗаписьXML;
 
    ЗаписьXML.ОткрытьФайл(ПутьКФайлуДляЗаписи);
 
    ЗаписьXML.ЗаписатьОбъявлениеXML();    
 
    ЗаписьXML.ЗаписатьНачалоЭлемента("НастрокиОтчетаГЦЖС");
 
    Для Каждого строкаНастроек Из таблицаНабора Цикл
        ЗаписьXML.ЗаписатьНачалоЭлемента("Колонка");
		
        ЗаписьXML.ЗаписатьАтрибут("ИмяПоляExcel", строкаНастроек.ИмяПоляExcel);
        ЗаписьXML.ЗаписатьАтрибут("ФорматКолонки", строкаНастроек.ФорматКолонки);
        ЗаписьXML.ЗаписатьАтрибут("НомерПоляExcel", строка(строкаНастроек.НомерПоляExcel)); 
        ЗаписьXML.ЗаписатьАтрибут("ПолеДанных", строкаНастроек.ПолеДанных); 
        
        ЗаписьXML.ЗаписатьКонецЭлемента(); // Страна
    КонецЦикла;
 
    ЗаписьXML.ЗаписатьКонецЭлемента(); // Страны
 
    ЗаписьXML.Закрыть();
 
КонецПроцедуры

Процедура ПрочитатьДанныеВФорматеXML(ПутьКФайлу) Экспорт
	
	//ПутьКФайлу = "D:\Разработка\ГЦЖС\НастрокаОтчетаГЦЖС.XML";
	
    Парсер = Новый ЧтениеXML;
    Парсер.ОткрытьФайл(ПутьКФайлу);
	
	таблицаНабора = новый ТаблицаЗначений;
	таблицаНабора.Колонки.Добавить("ИмяПоляExcel");
	таблицаНабора.Колонки.Добавить("ФорматКолонки");
	таблицаНабора.Колонки.Добавить("НомерПоляExcel");//, Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(12, 3)));
	таблицаНабора.Колонки.Добавить("ПолеДанных");

	
	Пока Парсер.Прочитать() Цикл
	  если ЗначениеЗаполнено(Парсер.ЗначениеАтрибута("ИмяПоляExcel")) тогда	
		строкаНастроек = таблицаНабора.Добавить();
		строкаНастроек.ИмяПоляExcel = Парсер.ЗначениеАтрибута("ИмяПоляExcel");
		строкаНастроек.ФорматКолонки = Парсер.ЗначениеАтрибута("ФорматКолонки");
		строкаНастроек.НомерПоляExcel = Парсер.ЗначениеАтрибута("НомерПоляExcel");
		строкаНастроек.ПолеДанных = Парсер.ЗначениеАтрибута("ПолеДанных");
	  конецесли;	
      Парсер.Прочитать()	 
	конеццикла;
	
	Парсер.Закрыть();
	
	если таблицаНабора.Количество() > 0 тогда
	
	 НаборЗаписей = РегистрыСведений.бит_НастройкаОтчетаГЦЖС.СоздатьНаборЗаписей();
     НаборЗаписей.Записать();	
	 
	 для каждого стр из таблицаНабора цикл 
	 
	     Запись = РегистрыСведений.бит_НастройкаОтчетаГЦЖС.СоздатьМенеджерЗаписи();
	     Запись.НомерПоляExcel = стр.НомерПоляExcel;
	     Запись.ИмяПоляExcel = стр.ИмяПоляExcel;
		 Запись.ФорматКолонки = стр.ФорматКолонки;
	     Запись.ПолеДанных = стр.ПолеДанных;
	     Запись.Период = НачалоДня(ТекущаяДата());
	     Запись.Записать(истина);
	 
	 конеццикла;
	 
    конецесли;
 
КонецПроцедуры

