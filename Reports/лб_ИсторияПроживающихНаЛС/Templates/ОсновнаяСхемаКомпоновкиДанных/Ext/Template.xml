		<query>ВЫБРАТЬ
	МАКСИМУМ(бит_ПроживающиеПоЛС.Период) КАК Период,
	бит_ПроживающиеПоЛС.ЛицевойСчет КАК ЛицевойСчет,
	бит_ПроживающиеПоЛС.ФизЛицо КАК ФизЛицо,
	бит_ПроживающиеПоЛС.лб_ДатаРегистрацииДляФЛС КАК лб_ДатаРегистрацииДляФЛС
ПОМЕСТИТЬ ПериодыПроживания
ИЗ
	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
ГДЕ
	бит_ПроживающиеПоЛС.Период &lt;= &amp;Период
	И бит_ПроживающиеПоЛС.ЛицевойСчет = &amp;ЛицевойСчет

СГРУППИРОВАТЬ ПО
	бит_ПроживающиеПоЛС.ФизЛицо,
	бит_ПроживающиеПоЛС.ЛицевойСчет,
	бит_ПроживающиеПоЛС.лб_ДатаРегистрацииДляФЛС
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_ПроживающиеПоЛС.Период КАК Период,
	бит_ПроживающиеПоЛС.Регистратор КАК Регистратор,
	бит_ПроживающиеПоЛС.НомерСтроки КАК НомерСтроки,
	бит_ПроживающиеПоЛС.Активность КАК Активность,
	бит_ПроживающиеПоЛС.ЛицевойСчет КАК ЛицевойСчет,
	бит_ПроживающиеПоЛС.ФизЛицо КАК ФизЛицо,
	бит_ПроживающиеПоЛС.СтатусФизЛица КАК СтатусФизЛица,
	бит_ПроживающиеПоЛС.СтепеньРодства КАК СтепеньРодства,
	бит_ПроживающиеПоЛС.СтатусПроживания КАК СтатусПроживания,
	бит_ПроживающиеПоЛС.ДатаРегистрации КАК ДатаРегистрации,
	бит_ПроживающиеПоЛС.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	бит_ПроживающиеПоЛС.ДатаЗаписи КАК ДатаЗаписи,
	бит_ПроживающиеПоЛС.ВладелецКвартиры КАК ВладелецКвартиры,
	бит_ПроживающиеПоЛС.ПричинаВыписки КАК ПричинаВыписки,
	бит_ПроживающиеПоЛС.ПричинаПрописки КАК ПричинаПрописки,
	бит_ПроживающиеПоЛС.КудаВыписан КАК КудаВыписан,
	бит_ПроживающиеПоЛС.ОткудаПрибыл КАК ОткудаПрибыл,
	бит_ПроживающиеПоЛС.ДоляПлощади КАК ДоляПлощади,
	бит_ПроживающиеПоЛС.ПравоустанавливающиеДокументы КАК ПравоустанавливающиеДокументы,
	бит_ПроживающиеПоЛС.СтатусФизЛицаДляИзменения КАК СтатусФизЛицаДляИзменения,
	бит_ПроживающиеПоЛС.ДатаПрибытия КАК ДатаПрибытия,
	бит_ПроживающиеПоЛС.лб_ДоляПлощадиСтрокой КАК лб_ДоляПлощадиСтрокой,
	бит_ПроживающиеПоЛС.лб_СтрокаРодствДляФЛС КАК лб_СтрокаРодствДляФЛС,
	бит_ПроживающиеПоЛС.лб_ИгнорироватьПериодВКопииФЛС КАК лб_ИгнорироватьПериодВКопииФЛС,
	бит_ПроживающиеПоЛС.лб_ДатаРегистрацииДляФЛС КАК лб_ДатаРегистрацииДляФЛС,
	бит_ПроживающиеПоЛС.лб_ДатаВыпискиДляФЛС КАК лб_ДатаВыпискиДляФЛС
ПОМЕСТИТЬ СтрокиПериодовПроживания
ИЗ
	ПериодыПроживания КАК ПериодыПроживания
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
		ПО ПериодыПроживания.Период = бит_ПроживающиеПоЛС.Период
			И ПериодыПроживания.ЛицевойСчет = бит_ПроживающиеПоЛС.ЛицевойСчет
			И ПериодыПроживания.ФизЛицо = бит_ПроживающиеПоЛС.ФизЛицо
			И ПериодыПроживания.лб_ДатаРегистрацииДляФЛС = бит_ПроживающиеПоЛС.лб_ДатаРегистрацииДляФЛС
;

