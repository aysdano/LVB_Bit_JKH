			ОбластьПерерасчеты.Параметры.КодПоставщика = Прав(Строка(СтрокаТаблицы.Поставщик.Код),3);
			Результат.Вывести(ОбластьПерерасчеты);
		Исключение
		КонецПопытки;		
		
