// Процедура - обработчик события "ПриЗаписиНаСервере" формы.
//
&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТаблицаСоставаСемьиЗначение = ДанныеФормыВЗначение(ТаблицаСоставаСемьи, Тип("РегистрСведенийНаборЗаписей.бит_СписокСемейнойЛьготы"));
	ТаблицаСоставаСемьиЗначение.Отбор.ЛицевойСчет.Установить(Объект.Ссылка);  // БИТ_ЖКХ 31.10.2016 10:55:06 
	ТаблицаЗависимыеЛСЗначение = ДанныеФормыВЗначение(ТаблицаЗависимыеЛС, Тип("РегистрСведенийНаборЗаписей.бит_ЗависимыеЛС"));
	ТаблицаЗависимыеЛСЗначение.Отбор.ЛицевойСчет.Установить(Объект.Ссылка);  // БИТ_ЖКХ 31.10.2016 10:55:13 
	Попытка
		ТаблицаСоставаСемьиЗначение.Записать();
		ТаблицаЗависимыеЛСЗначение.Записать(Истина);
		
	Исключение

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(""+ОписаниеОшибки());
		
	КонецПопытки; 
	
КонецПроцедуры

