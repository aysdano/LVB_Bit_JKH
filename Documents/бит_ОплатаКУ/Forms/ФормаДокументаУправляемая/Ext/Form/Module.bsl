&НаКлиенте
Процедура СписокУслугУслугаПриИзменении(Элемент)
	
	ТекСтрока   = Элементы.СписокЛС.ТекущиеДанные;
	ТекСтрокаУС = Элементы.СписокУслуг.ТекущиеДанные;
	
	Если ТекСтрокаУС <> Неопределено И ТекСтрока <> Неопределено Тогда
		
		ТекСтрокаУС.ЛицевойСчет     = ТекСтрока.ЛицевойСчет;
		ТекСтрокаУС.ШаблонИзвещений = ТекСтрока.ШаблонИзвещений;
		ТекСтрокаУС.Приоритет       = ПолучитьПриоритетУслугиНаСервере(ТекСтрокаУС.Услуга);
		
	КонецЕсли;  
	
	Объект.СписокУслуг.Сортировать("Приоритет Возр");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУслугУслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.СписокЛС.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		
		Элементы.СписокУслуг.ЗакончитьРедактированиеСтроки(Истина);
		
		Возврат;
		
	КонецЕсли;
	
	Если ТекСтрока.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемУслугам")
		ИЛИ ТекСтрока.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемЗаМесяц") Тогда
		ПоВсемУслугам = Истина;
	Иначе
		ПоВсемУслугам = Ложь;
	КонецЕсли;
	ШаблонУслуг   = ПолучитьСписокУслуг(ТекСтрока.ЛицевойСчет, ТекСтрока.ШаблонИзвещений, ПоВсемУслугам);	
	
	СписокУС = Новый СписокЗначений;
	
	Для каждого Строка Из ШаблонУслуг Цикл
		
		СписокУС.Добавить(Строка.Услуга);		
		
	КонецЦикла; 
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("Ссылка", СписокУС);
	
	ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУслугУслугаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.СписокЛС.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено Тогда
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("ЛицевойСчет"     , ТекСтрока.ЛицевойСчет);
		Отбор.Вставить("ШаблонИзвещений" , ТекСтрока.ШаблонИзвещений);
		Отбор.Вставить("Услуга"          , ВыбранноеЗначение);
		
		МассивСтрок = Объект.СписокУслуг.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() > 0  Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Услуга :"+ВыбранноеЗначение + " занесена в список услуг.";
			Сообщение.Сообщить();
			
			ВыбранноеЗначение = ТекСтрока.Услуга;
			
			Элементы.СписокУслуг.ЗакончитьРедактированиеСтроки(Истина);
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУслугСуммаПриИзменении(Элемент)
	
	ОбновитьНадписьНаФорме();
	
КонецПроцедуры

&НаКлиенте
Процедура СписокУслугСуммаПениПриИзменении(Элемент)
	
	ТекСтрокаУС = Элементы.СписокУслуг.ТекущиеДанные;
	
	Если ТекСтрокаУС <> Неопределено Тогда
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("ЛицевойСчет", ТекСтрокаУС.ЛицевойСчет);
		Отбор.Вставить("Услуга"     , ТекСтрокаУС.Услуга);
		
		СтрокаПени = мТаблицаНачисленийПени.НайтиСтроки(Отбор);
		
		Если СтрокаПени.Количество() = 1 Тогда
			
			СальдоПени = СтрокаПени[0].Пени;
			СуммаПени  = ТекСтрокаУС.СуммаПени;
			
			Если СуммаПени > СальдоПени Тогда
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Сумма оплаты пени : "+ СуммаПени + " не может превышать сальдо пени: ";
				Сообщение.Сообщить();
				
				ТекСтрокаУС.СуммаПени = СальдоПени;
				
			КонецЕсли;
			
		ИначеЕсли СтрокаПени.Количество() = 0 Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "По услуге: " +  ТекСтрокаУС.Услуга + " сальдо пени равно нулю.";
			Сообщение.Сообщить();
			
			ТекСтрокаУС.СуммаПени = 0;
			
		КонецЕсли; 
		
	КонецЕсли;
	
	ОбновитьНадписьНаФорме();
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Функция выполняет поиск лицевойго счета в базе.
//
&НаСервере
Функция НайтиЛС(НаименованиеЛС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование",НаименованиеЛС);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		ЛС = Выборка.Ссылка;	
	Иначе 
		ЛС = Справочники.бит_ЛицевыеСчета.ПустаяСсылка();	
	КонецЕсли;
	
	Возврат ЛС;
	
КонецФункции

// Процедура выполняет установку отбора.
//
&НаКлиенте
Процедура УстановитьОтборСписокУслуг(мТекСтрока)
	
	Если Не мТекСтрока = Неопределено Тогда
		
		ФЛС = Новый ФиксированнаяСтруктура("ЛицевойСчет, ШаблонИзвещений", мТекСтрока.ЛицевойСчет, мТекСтрока.ШаблонИзвещений);
		
		Элементы.СписокУслуг.ОтборСтрок = ФЛС;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура выполняет заполнение таблицы услуг при вводе оплаты вручную.
//
&НаКлиенте
Процедура ЗаполнитьСписокУслугПоШаблону(СтрокаТЧ)
	
	Если СтрокаТЧ.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемУслугам")
		ИЛИ СтрокаТЧ.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемЗаМесяц") Тогда
		ПоВсемУслугам = Истина;	
	Иначе
		ПоВсемУслугам = Ложь;	
	КонецЕсли;
	ШаблонУслуг   = ПолучитьСписокУслуг(СтрокаТЧ.ЛицевойСчет, СтрокаТЧ.ШаблонИзвещений, ПоВсемУслугам);		
	
	Для каждого СтрокаУслуга Из ШаблонУслуг Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет"     , СтрокаТЧ.ЛицевойСчет);
		Отбор.Вставить("ШаблонИзвещений" , СтрокаТЧ.ШаблонИзвещений);
		Отбор.Вставить("Услуга"          , СтрокаУслуга.Услуга);
		
		МассивСтрок = Объект.СписокУслуг.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() = 0 Тогда
			
			НовСтрока = Объект.СписокУслуг.Добавить();
			
			НовСтрока.Услуга          = СтрокаУслуга.Услуга;
			НовСтрока.ЛицевойСчет     = СтрокаТЧ.ЛицевойСчет;
			НовСтрока.ШаблонИзвещений = СтрокаТЧ.ШаблонИзвещений;
			НовСтрока.Приоритет       = ПолучитьПриоритетУслугиНаСервере(СтрокаУслуга.Услуга);
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
&НаКлиенте
Процедура ПриИзмененииВСтроке(Идентификатор)
	
	ТекСтрока = Объект.СписокЛС.Получить(Идентификатор);
	
	Если НЕ ТекСтрока.ЛицевойСчет     = мКэшЗначений.мЛицевойСчет 
		ИЛИ НЕ ТекСтрока.ШаблонИзвещений = мКэшЗначений.мШаблонИзвещений Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет"    , мКэшЗначений.мЛицевойСчет);
		Отбор.Вставить("ШаблонИзвещений", мКэшЗначений.мШаблонИзвещений);
		
		МассивСтрок = Объект.СписокУслуг.НайтиСтроки(Отбор);
		
		Для каждого Строка Из МассивСтрок Цикл
			
			Объект.СписокУслуг.Удалить(Строка);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры 

// Процедруа выполняет заполнение таблицы услуг. 
//
&НаКлиенте
Процедура ЗаполнениеТаблицыУслуг()
	
	ТекСтрока = Элементы.СписокЛС.ТекущиеДанные;
	
	Если Объект.СписокЛС.Количество() > 0 И НЕ Объект.ВводВРучную Тогда
		
		Объект.СписокУслуг.Очистить();
		//Объект.СписокУслугПоПериоду.Очистить();
		
		Если Не мКэшЗначений.мНеРаспределятьОплатуПослеВводаСуммы Тогда
			ВыполнитьРасчетНаСервере();
		Иначе	
			ДокументРассчитан = Ложь;
		КонецЕсли; 
		
		УправлениеВидимостьюКолонок(ТекСтрока);
		УдалитьПустыеСтрокиНаСервере();
		
	ИначеЕсли Объект.СписокЛС.Количество() > 0 И Объект.ВводВРучную Тогда
		
		Объект.СписокУслуг.Очистить();
		//Объект.СписокУслугПоПериоду.Очистить();
		
		Для каждого Строка Из Объект.СписокЛС Цикл
			
			ЗаполнитьСписокУслугПоШаблону(Строка);
			ПолучитьНачисленияПени(Объект.Дата, Строка.ЛицевойСчет);	
			
		КонецЦикла; 
		
		Элементы.СписокУслугСуммаПени.Видимость = Истина;
		
	КонецЕсли;
	
	УстановитьОтборСписокУслуг(ТекСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьНадписьНаФорме()
	
	Если Объект.ВводВРучную Тогда
		
		ТекСтрока = Элементы.СписокЛС.ТекущиеДанные;
		
		СуммаДокумента = Объект.СписокЛС.Итог("Сумма");
		
		Если ТекСтрока <> Неопределено Тогда
			
			КонтрольнаяСумма = ТекСтрока.Сумма;
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("ЛицевойСчет"    , ТекСтрока.ЛицевойСчет);
			Отбор.Вставить("ШаблонИзвещений", ТекСтрока.ШаблонИзвещений);
			
			МассивСтрок = Объект.СписокУслуг.НайтиСтроки(Отбор);
			
			ИтогСумма = 0;
			ИтогПени  = 0;
			
			Для каждого ЭлементыМассива Из МассивСтрок Цикл
				
				ИтогСумма = ИтогСумма + ЭлементыМассива.Сумма;
				ИтогПени  = ИтогПени  + ЭлементыМассива.СуммаПени;
				
			КонецЦикла;
			
			Остаток = КонтрольнаяСумма - ИтогСумма - ИтогПени;
			
			Текст = "Оплата услуг :" + ИтогСумма + ", Пени: "+ ИтогПени + 
			?(Остаток > 0, ". 
			|Не распределенная сумма оплаты: "+ Остаток ,".");
			
			Если Остаток < 0 Тогда
				
				Элементы.НадписьИнфо.ЦветТекста = Новый Цвет(255, 0, 0);
				
				Текст = Текст + ". 
				|Распределенная сумма превышает сумму оплаты!"
				
			Иначе
				
				Элементы.НадписьИнфо.ЦветТекста = Новый Цвет(0, 0, 0);
				
			КонецЕсли; 
			
			Элементы.НадписьИнфо.Заголовок = Текст;
			
		КонецЕсли; 
		
		Если ТекСтрока = Неопределено Тогда
			
			Текст = "Сумма по документу :" + СуммаДокумента;
			
		Иначе
			
			Текст ="Сумма по документу :" + СуммаДокумента + ". 
			|Сумма оплаты :" + ТекСтрока.Сумма;
			
		КонецЕсли; 
		
		Элементы.НадписьИнфоОбщ.Заголовок = Текст;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроверитьДублиЛСПриВводеВручную(ВыбранноеЗначение, СтандартнаяОбработка, ИмяРесурса)
	
	ТекущаяСтрока = Элементы.СписокЛС.ТекущиеДанные;
	
	Если НЕ ВыбранноеЗначение = ТекущаяСтрока[ИмяРесурса] ИЛИ ТекущаяСтрока[ИмяРесурса].ПустаяСсылка() Тогда
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("ЛицевойСчет"    , ВыбранноеЗначение);
		Отбор.Вставить("ШаблонИзвещений", ТекущаяСтрока.ШаблонИзвещений);
		
		МассивСтрок = Объект.СписокЛС.НайтиСтроки(Отбор);
		
		Если НЕ МассивСтрок.Количество() = 0 Тогда
			
			ВыбранноеЗначение    = ТекущаяСтрока[ИмяРесурса];
			СтандартнаяОбработка = Ложь;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
Процедура ТаблицаЛСНаСервере(АдресЛСВХранилище)
	
	Отбор = Новый Структура;
	
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(АдресЛСВХранилище);
	
	Если ТаблицаЛС = Неопределено Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Ошибка получения данных из временного хранилища. Выполните подбор заново.";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из ТаблицаЛС Цикл
		
		Отбор.Вставить("ЛицевойСчет", СтрокаТаблицы.ЛицевойСчет);
		
		СтрокаТабличнойЧасти = Объект.СписокЛС.НайтиСтроки(Отбор);
		
		Если СтрокаТабличнойЧасти.Количество() = 0 Тогда
			
			НоваяСтрока = Объект.СписокЛС.Добавить();
			
			НоваяСтрока.ЛицевойСчет  = СтрокаТаблицы.ЛицевойСчет;
			НоваяСтрока.СчетАбонента = мКэшЗначений.мСтруктураСчетовЖКХ.СчетАбонента;
			СтрокаСубконта           = НоваяСтрока.СчетАбонента.ВидыСубконто.Найти(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета"), "ВидСубконто");
			
			Если НЕ СтрокаСубконта = Неопределено Тогда
				
				НоваяСтрока["Субконто"+СтрокаСубконта.НомерСтроки] = НоваяСтрока.ЛицевойСчет;
				
			КонецЕсли;
			
			НоваяСтрока.СчетКУ          = мКэшЗначений.мСтруктураСчетовЖКХ.ТранзитныйСчетОплаты;
			НоваяСтрока.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемУслугам");
			
		КонецЕсли;
		
	КонецЦикла; 
	
	ЗаполнитьСчетаНаСервере();
	ОбновитьДанныеКолонкиАдрес();
	ОбновитьДанныеКолонкиОтветственный();
КонецПроцедуры

// Процедура получает таблицу начислений по пени.
//
&НаСервере
Процедура ПолучитьНачисленияПени(Знач Дата, Знач ЛицевойСчет)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачислениеПениПоУслугамЖКХОстатки.ЛицевойСчет,
	|	бит_НачислениеПениПоУслугамЖКХОстатки.УслугаЖКХ КАК Услуга ,
	|	СУММА(бит_НачислениеПениПоУслугамЖКХОстатки.СуммаПениОстаток) КАК Пени
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Остатки(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачислениеПениПоУслугамЖКХОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеПениПоУслугамЖКХОстатки.ЛицевойСчет,
	|	бит_НачислениеПениПоУслугамЖКХОстатки.УслугаЖКХ";
	
	Запрос.УстановитьПараметр("Дата"       , Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если мТаблицаНачисленийПени = Неопределено Тогда
		
		мТаблицаНачисленийПени = Запрос.Выполнить().Выгрузить().СкопироватьКолонки();	
		
	КонецЕсли; 
	
	Отбор = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		
		Отбор.Очистить();
		
		Отбор.Вставить("ЛицевойСчет", Выборка.ЛицевойСчет);
		Отбор.Вставить("Услуга"     , Выборка.Услуга);
		
		МассивСтрок = мТаблицаНачисленийПени.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() > 0 Тогда
			
			Если МассивСтрок[0].Пени <> Выборка.Пени Тогда
				
				МассивСтрок[0].Пени = Выборка.Пени;	
				
			КонецЕсли; 	
			
		Иначе
			
			НоваяСтрока = мТаблицаНачисленийПени.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСчетаНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ДокументОбъект.ЗапролнитьСчета();
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	
	КэшированныеЗначения.Вставить("мТекущаяДатаДокумента", Объект.Дата);
	КэшированныеЗначения.Вставить("мВидОперации", Объект.ВидОперации);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НастройкаПараметровЖКХСрезПоследних.НеРаспределятьОплатуПослеВводаСуммы КАК НеРаспределятьОплатуПослеВводаСуммы
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НеРаспределятьОплатуПослеВводаСуммы = Выборка.НеРаспределятьОплатуПослеВводаСуммы;
	Иначе	
		НеРаспределятьОплатуПослеВводаСуммы = Ложь;
	КонецЕсли;
	
	КэшированныеЗначения.Вставить("мНеРаспределятьОплатуПослеВводаСуммы", НеРаспределятьОплатуПослеВводаСуммы);
	
	КэшированныеЗначения.Вставить("мОрганизация", Объект.Организация);
	КэшированныеЗначения.Вставить("мСтруктураСчетовЖКХ", Неопределено);
	КэшированныеЗначения.Вставить("мТекущийЛицевойСчет", Неопределено);	
	КэшированныеЗначения.Вставить("мЛицевойСчет", Неопределено);
	КэшированныеЗначения.Вставить("мШаблонИзвещений", Неопределено);
	КэшированныеЗначения.Вставить("мСумма", Неопределено);
	КэшированныеЗначения.Вставить("мВводВручную", Объект.ВводВРучную);
	
	КэшированныеЗначения.Вставить("ВыбЗначение", Неопределено);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСальдоНаЛСНаСервере(Знач Дата, Знач ЛицевойСчет);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки";
	
	Запрос.УстановитьПараметр("Момент", Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СальдоНаЛС = 0;
	
	Если Выборка.Следующий() тогда
		
		СальдоНаЛС = Выборка.Остаток;
		
	КонецЕсли;
	
	Возврат СальдоНаЛС;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСальдоДоПениВХНаСервере(Знач Дата, Знач ЛицевойСчет);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	НачислениеПениПоУслугамЖКХОстатки.СуммаПениОстаток КАК Остаток
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Остатки(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК НачислениеПениПоУслугамЖКХОстатки";
	
	Запрос.УстановитьПараметр("Момент", Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет); 
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СальдоПениВХ = 0;
	
	Если Выборка.Следующий() Тогда
		
		СальдоПениВХ = Выборка.Остаток;
		
	КонецЕсли;
	
	Возврат СальдоПениВХ;
	
КонецФункции

&НаСервере
Процедура УдалитьПустыеСтрокиНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ДокументОбъект.УдалитьПустыеСтроки();
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьРасчетНаСервере()
	
	Если Объект.ОплатаПоПериоду
		И (ПериодОплаты.ДатаНачала > ПериодОплаты.ДатаОкончания	ИЛИ НЕ ЗначениеЗаполнено(ПериодОплаты.ДатаОкончания)) Тогда
		
		ТекстСообщения = НСтр("ru = 'Перед расчетом необходимо заполнить Период оплаты'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ОплатаПоПериоду Тогда
		
		ТекстСообщения = "";
		Для каждого Стр Из Объект.СписокЛС Цикл
			Если Стр.ШаблонИзвещений.Сальдо = ПредопределенноеЗначение("Перечисление.ДаНет.Да") 
				ИЛИ Стр.ШаблонИзвещений.Кредит = ПредопределенноеЗначение("Перечисление.ДаНет.Да") Тогда
				ТекстСообщения = ТекстСообщения + СтрШаблон(
													НСтр("ru = 'Необходимо изменить ""Шаблон извещения"" для лицевого счета: ""%1""'"),
													Стр.ЛицевойСчет);
				ТекстСообщения = ТекстСообщения + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ДокументОбъект.ВыполнитьРасчет();
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
	ДокументРассчитан = Истина;
	
КонецПроцедуры

// Функция возвращает список услуг по шаблону.
//
&НаСервере
Функция ПолучитьСписокУслуг(Знач ЛицевойСчет, Знач ШаблонИзвещений, Знач ПоВсемУслугам)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Запрос.УстановитьПараметр("Дата"        , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет" , ЛицевойСчет);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если ПоВсемУслугам Тогда
		
		МассивШаблонов = бит_ОбщегоНазначения.ТаблицаЗначенийВМассив(Результат);
		
		Возврат МассивШаблонов;	
		
	Иначе
		
		Таблица = Результат.СкопироватьКолонки();
		
		Для каждого Строка Из Результат Цикл
			
			Если ШаблонИзвещений.Услуги.Найти(Строка.Услуга, "Услуга") <> Неопределено Тогда
				
				НоваяСтрока = Таблица.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока,Строка);
				
			КонецЕсли; 	
			
		КонецЦикла;
		
		МассивШаблонов = бит_ОбщегоНазначения.ТаблицаЗначенийВМассив(Таблица);
		
		Возврат МассивШаблонов;
		
	КонецЕсли;
	
КонецФункции

// Служебная процедура для заполнения колонки "Адрес" табличного поля "СписокЛС".
&НаСервере
Процедура ОбновитьДанныеКолонкиАдрес()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета,
	|	бит_ЛицевыеСчета.Здание,
	|	бит_ЛицевыеСчета.Здание.Корпус КАК Корпус,
	|	бит_ЛицевыеСчета.Квартира
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка В(&СписокЛицевыхСчетов)"
	);
	
	Запрос.УстановитьПараметр("СписокЛицевыхСчетов",Объект.СписокЛС.Выгрузить().ВыгрузитьКолонку("ЛицевойСчет"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Для Каждого Стр Из Объект.СписокЛС Цикл
		
		Если Выборка.НайтиСледующий(Стр.ЛицевойСчет,"ЛицевойСчет") Тогда
			
			Стр.Адрес = Строка(Выборка.УлицаЛицевогоСчета) + ", д. " + Строка(Выборка.Здание) + ?(ПустаяСтрока(Выборка.Корпус),"",", кор. " + Строка(Выборка.Корпус)) + ", кв. " + Строка(Выборка.Квартира);
			
		Иначе
			
			Стр.Адрес = "";
			
		КонецЕсли;
		
		Выборка.Сбросить();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура ИзменитьПараметрыВыбораПолейСубконтоСписокЛС(Форма)
	
	СтрокаПлатеж       = Форма.Объект.СписокЛС.НайтиПоИдентификатору(Форма.Элементы.СписокЛС.ТекущаяСтрока);
	
	ПараметрыДокумента = ПолучитьСписокПараметров(Форма, СтрокаПлатеж, "Субконто%Индекс%");
	
	бит_БухгалтерскийУчетКлиентСервер.ИзменитьПараметрыВыбораПолейСубконто(Форма, СтрокаПлатеж, "Субконто%Индекс%", "СписокЛССубконто%Индекс%", ПараметрыДокумента);
	
	ПараметрыДокумента = ПолучитьСписокПараметров(Форма, СтрокаПлатеж, "СубконтоКУ%Индекс%");
	
	бит_БухгалтерскийУчетКлиентСервер.ИзменитьПараметрыВыбораПолейСубконто(Форма, СтрокаПлатеж, "СубконтоКУ%Индекс%", "СписокЛССубконтоКУ%Индекс%", ПараметрыДокумента); 
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСписокПараметров(Форма, Объект, ШаблонИмяПоляОбъекта)
	
	СписокПараметров = Новый Структура;
	
	Для Индекс = 1 По 3 Цикл
		
		ИмяПоля = СтрЗаменить(ШаблонИмяПоляОбъекта, "%Индекс%", Индекс);
		
		Если ТипЗнч(Объект[ИмяПоля]) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			СписокПараметров.Вставить("Контрагент", Объект[ИмяПоля]);
			
		ИначеЕсли ТипЗнч(Объект[ИмяПоля]) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			
			СписокПараметров.Вставить("ДоговорКонтрагента", Объект[ИмяПоля]);
			
		ИначеЕсли ТипЗнч(Объект[ИмяПоля]) = Тип("СправочникСсылка.Номенклатура") Тогда
			
			СписокПараметров.Вставить("Номенклатура", Объект[ИмяПоля]);
			
		ИначеЕсли ТипЗнч(Объект[ИмяПоля]) = Тип("СправочникСсылка.Склады") Тогда
			
			СписокПараметров.Вставить("Склад", Объект[ИмяПоля]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СписокПараметров.Вставить("ОстаткиОбороты", 1);
	СписокПараметров.Вставить("Организация"   , Форма.Объект.Организация);
	
	Возврат СписокПараметров;
	
КонецФункции

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконтоСписокЛС(Форма, Счет, Постфикс = "", ЕстьПодразделение, ЭтоТаблица = Ложь)
	
	ПоляФормы = Новый Структура("Субконто1, Субконто2, Субконто3",
	"СписокЛССубконто" + Постфикс + "1", 
	"СписокЛССубконто" + Постфикс + "2", 
	"СписокЛССубконто" + Постфикс + "3");
	
	бит_БухгалтерскийУчетКлиентСервер.ПриВыбореСчета(Счет, Форма, ПоляФормы, Неопределено, ЭтоТаблица);
	
КонецПроцедуры

