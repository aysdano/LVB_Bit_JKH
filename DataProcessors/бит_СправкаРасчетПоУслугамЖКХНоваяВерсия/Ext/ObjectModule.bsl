		//СуммаНачислено = СуммаНачислено + (СтрокаОплаты.МинВзносНач + СтрокаОплаты.ДопВзносНач + СтрокаОплаты.РФКРНач)* Коэфф.Числитель / Коэфф.Знаменатель;
		ОбластьТаблица.Параметры.ЕдИзм = "м2";
		ОбластьТаблица.Параметры.Тариф = Окр(Тариф , 4); 
		ОбластьТаблица.Параметры.Объем =  Формат(Окр(Объем, 4), "ЧДЦ=2");       
		СуммаНачислено = Тариф * Объем;
		СуммаНачислено = Окр(СуммаНачислено, 2) ;//+ Окр((СтрокаОплаты.МинВзносНач + СтрокаОплаты.ДопВзносНач + СтрокаОплаты.РФКРНач)* Коэфф.Числитель / Коэфф.Знаменатель, 2);
		ОбластьТаблица.Параметры.Начислено  = СуммаНачислено;
	//ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000002") Тогда //антена
	//	ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ПрофиНач) * Коэфф, 2);
	//	СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
	//	ОбластьТаблица.Параметры.ЕдИзм = "точка";
	//	ОбластьТаблица.Параметры.Тариф = 0;
	//	ОбластьТаблица.Параметры.Объем =  1;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Домофон") Тогда//антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ДомофонНач) , 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "точка";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  1;		
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Газоснабжение") Тогда//антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ГазоснабжениеНач) , 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "м3";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  1;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Доп.услуга") Тогда//антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ДопНач) , 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  0;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Орг.ФКР") Тогда//антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ОргФКРНач) , 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  0;
	Иначе
		Возврат;
	КонецЕсли;
	
	УслугаНач = ОбластьТаблица.Параметры.Начислено;
	
КонецПроцедуры

Функция ПолучитьНачисленияПоУслуге(СтрокаОплаты, Услуга, Коэфф); 
	
	Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000009") Тогда//кап ремм
		Начислено =  Окр((СтрокаОплаты.МинВзносНач + СтрокаОплаты.ДопВзносНач + СтрокаОплаты.РФКРНач) * Коэфф.Числитель / Коэфф.Знаменатель, 2);
	//ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000002") Тогда //антена
	//	Начислено =  Окр((СтрокаОплаты.ПрофиНач) * Коэфф.Числитель / Коэфф.Знаменатель, 2);
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Домофон") Тогда//антена
		Начислено =  Окр((СтрокаОплаты.ДомофонНач) , 2);
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Газоснабжение") Тогда//антена
		Начислено =  Окр((СтрокаОплаты.ГазоснабжениеНач) , 2);
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Доп.услуга") Тогда//антена
		Начислено =  Окр((СтрокаОплаты.ДопНач) , 2);
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Орг.ФКР") Тогда//антена
		Начислено =  Окр((СтрокаОплаты.ОргФКРНач) , 2);
	Иначе
		Начислено= 0;
	КонецЕсли;
	
	Возврат Начислено;
	
КонецФункции


Функция ПолучитьСуммуОплатыПоуслуге(СтрокаОплаты, Услуга)
	
	Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000009") Тогда//кап ремм
