// Процедура формирует данные печати. 
//
// Параметры:
//  Параметр1 – Строка.
//
&НаСервере
Процедура СформироватьДанныеПечати()
	
	Обработка = Обработки.бит_ПечатьСчетИзвещений.Создать();
	
	мКэшЗначений.мСтруктураДанных        = Обработка.ПолучитьСтруктуруДанных();
	
	мТаблицаПечати = Обработка.ПолучитьТаблицуПечати();
	мТаблицаПечатиСчетчиков = Обработка.ПолучитьТаблицуПечатиСчетчиков();
	мТаблицаПерерасчетов    = Обработка.ПолучитьТаблицуПерерасчетов();
	
	// БИТ_ЖКХ 29.09.2014
	мТаблицаСвойств	= Новый ТаблицаЗначений;
	// БИТ_ЖКХ 29.09.2014
	
	// БИТ_ЖКХ 09.02.2015{{
	мТаблицаОбщедомовыхСчетчиков = Обработка.ПолучитьТаблицуОбщедомовыхСчетчиков();
	// БИТ_ЖКХ 09.02.2015}}
	
	Если Объект.Организация.Пустая() Тогда
		Возврат;
	КонецЕсли; 
	
	Обработка.Период      = КонецМесяца(ТекущаяДата());
	Обработка.Организация = Объект.Организация;
	
	Обработка.ОбновитьКэшОрганизации();
	Обработка.ОбновитьНастройкиЖКХ();
	// БИТ_ЖКХ 24.01.2017 13:36:17 Начало правки...
	Обработка.ОбновитьКэшПолучателяПлатежа();
	// БИТ_ЖКХ 24.01.2017 13:36:17 Конец правки.
	Обработка.ЗаполнитьСтруктураДанных(мКэшЗначений.мСтруктураДанных);
	
	ТаблицаН = ДанныеФормыВЗначение(ТаблицаНачислений,Тип("ТаблицаЗначений"));
	ТаблицаП = ДанныеФормыВЗначение(ТаблицаПени,Тип("ТаблицаЗначений"));
	
	ТаблицаПениИзХранилища  = ПолучитьИзВременногоХранилища(АдресТаблицыПениВХранилище);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Таблица"    , ТаблицаН);
	Запрос.УстановитьПараметр("ТаблицаПени", ТаблицаПениИзХранилища);
	Запрос.УстановитьПараметр("Дата"       , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.Ссылка);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаПени.Услуга,
	|	ТаблицаПени.Пени КАК Пени
	|ПОМЕСТИТЬ ТаблицаПени
	|ИЗ
	|	&ТаблицаПени КАК ТаблицаПени
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Таблица.Услуга,
	|	Таблица.Долг,
	|	Таблица.КОплате,
	|	Таблица.КОплатеЗаМесяц,
	|	Таблица.Факт,
	|	Таблица.Льгота,
	|	Таблица.Начислено,
	|	Таблица.Норматив,
	|	Таблица.Объем,
	|	Таблица.ПереплатаНаначало,
	|	Таблица.Приоритет,
	|	Таблица.Разовые,
	|	Таблица.Оплата,
	|	Таблица.СальдоНаНачало,
	|	Таблица.Ставка,
	|	Таблица.Тариф
	|ПОМЕСТИТЬ ТаблицаНачислений
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаНачислений.Услуга,
	|	ТаблицаНачислений.Услуга.ГруппаУслуги КАК ГруппаУслуги,
	|	ТаблицаНачислений.Услуга.ГруппаУслуги.Приоритет КАК ПриоритетГруп,
	|	ТаблицаНачислений.Долг,
	|	ТаблицаНачислений.КОплате,
	|	ТаблицаНачислений.КОплатеЗаМесяц,
	|	ТаблицаНачислений.Факт КАК Количество,
	|	ТаблицаНачислений.Льгота,
	|	ТаблицаНачислений.Начислено,
	|	ТаблицаНачислений.Норматив,
	|	ТаблицаНачислений.Объем,
	|	ТаблицаНачислений.ПереплатаНаначало,
	|	ТаблицаНачислений.Приоритет,
	|	ТаблицаНачислений.Разовые,
	|	ТаблицаНачислений.Оплата,
	|	ТаблицаНачислений.СальдоНаНачало КАК Сальдо,
	|	ТаблицаНачислений.Ставка,
	|	ТаблицаНачислений.Тариф,
	|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	бит_УслугиЖКХСпособыРасчета.ЕдИзм КАК ЕдИзм,
	|	ТаблицаПени.Пени
	|ИЗ
	|	ТаблицаНачислений КАК ТаблицаНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_СведенияПоУслугамЛССрезПоследних
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_УслугиЖКХ.СпособыРасчета КАК бит_УслугиЖКХСпособыРасчета
	|			ПО бит_СведенияПоУслугамЛССрезПоследних.Услуга = бит_УслугиЖКХСпособыРасчета.Ссылка
	|				И бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета = бит_УслугиЖКХСпособыРасчета.СпособРасчета
	|		ПО ТаблицаНачислений.Услуга = бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаПени КАК ТаблицаПени
	|		ПО ТаблицаНачислений.Услуга = ТаблицаПени.Услуга
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ИтогоПереплата         = 0;
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ Выборка.Сальдо = 0 ИЛИ НЕ Выборка.Начислено = 0 ИЛИ НЕ Выборка.Разовые = 0 Тогда
		Иначе
			Продолжить;
		КонецЕсли;
		
		Переплата         = 0;
		
		ЗакрытиеВхДолга = Выборка.Сальдо - Выборка.Оплата;
		
		ДолгСУчетомОплаты = ?(ЗакрытиеВхДолга > 0, ЗакрытиеВхДолга , 0);
		Авансы            = ?(ЗакрытиеВхДолга < 0, ЗакрытиеВхДолга * -1, 0);
		
		НоваяСтрока = мТаблицаПечати.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Если Выборка.Норматив = 0 Тогда
			НоваяСтрока.Объем = Выборка.Количество;
		КонецЕсли; 
		
		Переплата = Выборка.ПереплатаНаНачало + Выборка.Начислено +  Выборка.Разовые - Выборка.Оплата - ?(мКэшЗначений.мЛьготаПерсонифицированная,0,Выборка.Льгота);
		
		ИтогоПереплата         = ИтогоПереплата + Переплата;
		
	КонецЦикла; 
	
	СтрРайон 	= ?(мКэшЗначений.мНеПечататьРайон   , "", ""+ мКэшЗначений.мПрефиксРайон +" "+ СокрЛП(Строка(Объект.Здание.Район)) + ",");
	СтрУлица    = ?(мКэшЗначений.мНеПечататьУлица   , "", ""+ мКэшЗначений.мПрефиксУлица +" "+ СокрЛП(Строка(Объект.УлицаЛицевогоСчета)) + ",");
	СтрДом      = ?(мКэшЗначений.мНеПечататьДом     , "", " " + мКэшЗначений.мПрефиксДом +" "+ СокрЛП(Строка(Объект.Здание))+",") ;
	СтрКорпус   = ?(мКэшЗначений.мНеПечататьКорпус  , "", ?(ЗначениеЗаполнено(Корпус)," "+мКэшЗначений.мПрефиксКорпус+ " " +СокрЛП(Строка(Корпус)) + ",",""));
	СтрКвартира = ?(мКэшЗначений.мНеПечататьКвартира, "", " " + мКэшЗначений.мПрефиксКвартира +" "+ СокрЛП(Строка(Объект.Квартира)));
	
	Адрес = "" + СтрРайон + СтрУлица + СтрДом + СтрКорпус + СтрКвартира;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ОплатаКУСписокЛС.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.бит_ОплатаКУ.СписокЛС КАК бит_ОплатаКУСписокЛС
	|ГДЕ
	|	бит_ОплатаКУСписокЛС.ЛицевойСчет = &ЛицевойСчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		ДатаПоследнейОплаты = Выборка.Дата;
	КонецЕсли;
	
	мКэшЗначений.мСтруктураДанных.ГруппироватьУслуги               = Объект.ОтображатьПоГруппам;
	мКэшЗначений.мСтруктураДанных.ДатаПечатиКвитанций              = Формат(ТекущаяДата(), "ДФ=dd.MMMM.yyyy");
	мКэшЗначений.мСтруктураДанных.ДатаПоследнейОплаты              = ДатаПоследнейОплаты;
	мКэшЗначений.мСтруктураДанных.Долг                             = мТаблицаПечати.Итог("Долг");
	мКэшЗначений.мСтруктураДанных.ДолгНач                          = мТаблицаПечати.Итог("Долг") * -1;
	мКэшЗначений.мСтруктураДанных.ИтогПени                         = мТаблицаПечати.Итог("Пени");
	мКэшЗначений.мСтруктураДанных.КОплате                          = мТаблицаПечати.Итог("КОплате");
	мКэшЗначений.мСтруктураДанных.КОплатеЗаМесяц                   = мТаблицаПечати.Итог("КОплатеЗаМесяц");
	мКэшЗначений.мСтруктураДанных.КолЛьготников                    = мКоличествоЛьготников;
	мКэшЗначений.мСтруктураДанных.КоличествоКомнат                 = КоличествоКомнат;
	мКэшЗначений.мСтруктураДанных.КоличествоПроживающих            = Постоянно;
	мКэшЗначений.мСтруктураДанных.ЛицевойСчет                      = Объект.Ссылка;
	мКэшЗначений.мСтруктураДанных.ЛицевойСчетАдрес                 = Адрес;
	мКэшЗначений.мСтруктураДанных.ЛицевойСчетНомер                 = Объект.Наименование;
	мКэшЗначений.мСтруктураДанных.ЛицевойСчетФио                   = ОтветсвенноеЛицо;
	мКэшЗначений.мСтруктураДанных.Льгота                           = мТаблицаПечати.Итог("Льгота");
	мКэшЗначений.мСтруктураДанных.Начислено                        = мТаблицаПечати.Итог("Начислено");
	мКэшЗначений.мСтруктураДанных.ОписаниеЖилойПлощади             = ЖилаяПлощадь;
	мКэшЗначений.мСтруктураДанных.ОписаниеОбщейПлощади             = ОбщаяПлощадь;
	мКэшЗначений.мСтруктураДанных.ОписаниеОтапливаемойПлощади      = ОтапливаемаяПлощадь;
	мКэшЗначений.мСтруктураДанных.ОписаниеЛьгот                    = ОписаниеЛьгот;
	мКэшЗначений.мСтруктураДанных.ОписаниеСложнойЛьготы            = ОписаниеСложнойЛьготы;
	мКэшЗначений.мСтруктураДанных.Оплата                           = мТаблицаПечати.Итог("Оплата");
	мКэшЗначений.мСтруктураДанных.Переплата                        = ИтогоПереплата;
	мКэшЗначений.мСтруктураДанных.ПереплатаНаНачало                = мТаблицаПечати.Итог("ПереплатаНаначало");
	мКэшЗначений.мСтруктураДанных.Разовые                          = мТаблицаПечати.Итог("Разовые");
	мКэшЗначений.мСтруктураДанных.Сальдо                           = мТаблицаПечати.Итог("Сальдо");
	мКэшЗначений.мСтруктураДанных.СальдоЗнак                       = "";
	мКэшЗначений.мСтруктураДанных.СтатусКвартиры                   = СтатусКвартиры;
	мКэшЗначений.мСтруктураДанных.ТипКвартиры                      = ТипКвартиры;
	мКэшЗначений.мСтруктураДанных.ПроцентОтОплаты                  = 0;
	
	ТаблицаС = ДанныеФормыВЗначение(ТаблицаСчетчиков, Тип("ТаблицаЗначений"));
	
	Запрос.УстановитьПараметр("ТаблицаСЧ", ТаблицаС);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаСЧ.Счетчик,
	|	ТаблицаСЧ.Услуга,
	|	ТаблицаСЧ.Приоритет,
