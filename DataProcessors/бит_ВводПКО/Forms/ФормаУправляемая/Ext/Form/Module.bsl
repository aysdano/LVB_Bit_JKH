&НаСервере
Процедура ИзменитьСтатьяДвиженияДенежныхСредствИЗаписатьПриходныйКассовыйОрдерНаСервере(Знач ПриходныйКассовыйОредер, Знач СтатьяДвиженийДенСредств);
	
	ДокОбъект = ПриходныйКассовыйОредер.ПОлучитьОбъект();
	
	Если ДокОбъект.РасшифровкаПлатежа.Количество() > 0 Тогда
		
		СтрокаПлатеж = ДокОбъект.РасшифровкаПлатежа.Получить(0);
		
		СтрокаПлатеж.СтатьяДвиженияДенежныхСредств = СтатьяДвиженийДенСредств;
		
	КонецЕсли; 
	
	Если ДокОбъект.ПометкаУдаления Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ помечен на удаление! Изменение статьи движения денежных средств не возможно.");
		
		Возврат;
		
	КонецЕсли; 
	
	Если ДокОбъект.Проведен Тогда
		
		Попытка
			
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			
		КонецПопытки; 
		
	Иначе
		
		Попытка
			
			ДокОбъект.Записать();
			
		Исключение
			
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

