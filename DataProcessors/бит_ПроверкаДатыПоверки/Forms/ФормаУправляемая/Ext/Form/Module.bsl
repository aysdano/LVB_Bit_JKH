&НаСервере
Процедура ВыполнитьПроверкуНаСервере()
	
	ОбработкаОбъект = ДанныеФормыВЗначение(Объект, Тип("ОбработкаОбъект.бит_ПроверкаДатыПоверки"));
	ОбработкаОбъект.ВыполнитьПроверку();
	
	ЗначениеВДанныеФормы(ОбработкаОбъект, Объект);
	
	// БИТ ЖКХ 09.04.2021
	если Объект.Счетчики.Количество() > 0 тогда
	 ЭтаФорма.Элементы.СчетчикиВводПоказанийПодкрутки.Доступность = истина;	
	иначе
	 ЭтаФорма.Элементы.СчетчикиВводПоказанийПодкрутки.Доступность = ложь;	
	конецесли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивСчетчиковНаСервере()
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Счетчик");
	ТаблицаЗначений.Колонки.Добавить("ДатаПоверки");
	ТаблицаЗначений.Колонки.Добавить("ВладелецСчетчика");
	ТаблицаЗначений.Колонки.Добавить("Улица");
	ТаблицаЗначений.Колонки.Добавить("Здание");
	ТаблицаЗначений.Колонки.Добавить("Квартира");
	ТаблицаЗначений.Колонки.Добавить("НоваяДатаПоверки");
	
	Для каждого Строка Из Объект.Счетчики Цикл
		
		НоваяСтрока = ТаблицаЗначений.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
		НоваяСтрока.НоваяДатаПоверки = Строка.ДатаПоверки;
		
	КонецЦикла;
	
	МассивСчетчиков = бит_ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаЗначений);
	
	Возврат МассивСчетчиков;
	
КонецФункции

