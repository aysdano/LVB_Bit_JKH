#Область ПрочиеПроцедурыИФункции

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	Документ       = Метаданные.Документы.бит_СвидетельствоОРегистрацииПоМестуПроживания;
	ПравоИзменения = ПравоДоступа("Изменение", Документ);
	
	КэшированныеЗначения = Новый Структура;
	
	//// Перечисления.
	//КэшПеречисления = Новый Структура;
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	КэшированныеЗначения.Вставить("ПравоИзменения"      , ПравоИзменения);
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

// БИТ_ЖКХ_30012014_начало_изменений
&НаСервере
Функция ПолучитьРезультат(Знач Ссылка)
	
	Возврат Документы.бит_СвидетельствоОРегистрацииПоМестуПроживания.Печать(Ссылка);
	
КонецФункции

Функция ПолучитьРезультатДубликат(Знач Ссылка)
	
	Возврат Документы.бит_СвидетельствоОРегистрацииПоМестуПроживания.ПечатьДубликат(Ссылка);
	
КонецФункции


&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// БИТ_ЖКХ 09.09.2016 11:58:53 Начало правки...
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	// БИТ_ЖКХ 09.09.2016 11:58:53 Конец правки.

	Оповестить("ЗакрытиеПроживание");
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьДубликат(Команда)
	
	Если Модифицированность ИЛИ Параметры.Ключ.Пустая() Тогда
		
		Ответ = Неопределено;
		
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПечатьЗавершение", ЭтотОбъект), "Данные еще не записаны.
		|Печать возможна только после записи данных.                         
		|Данные будут записаны.", РежимДиалогаВопрос.ДаНет);
		Возврат; 
		
	КонецЕсли; 
	
	ПечатьФрагментДубликат();

КонецПроцедуры
