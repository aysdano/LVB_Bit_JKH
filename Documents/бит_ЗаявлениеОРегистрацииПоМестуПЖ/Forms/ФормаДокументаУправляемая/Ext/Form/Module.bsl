	СнимаемыеСРегистрации = ПолучитьВсехПроживающихПоЛС(Объект.ЛицевойСчет);
	
	Если СнимаемыеСРегистрации.Количество() > 0 Тогда 
		Элементы.СнимаемыеСРегУчетаПроживающий.СписокВыбора.Очистить();
		Для каждого Стр Из СнимаемыеСРегистрации Цикл
			Элементы.СнимаемыеСРегУчетаПроживающий.СписокВыбора.Добавить(Стр.Проживающий);		
		КонецЦикла;
	КонецЕсли;
	
