	        |ВЫБРАТЬ
	        |	СУММА(ВЫБОР
	        |			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	        |				ТОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот
	        |			ИНАЧЕ 0
	        |		КОНЕЦ) КАК Начисление,
	        |	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ КАК УслугаЖКХ
	        |ПОМЕСТИТЬ ВТ_Начисление
	        |ИЗ
	        |	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ), КОНЕЦПЕРИОДА(&Период, МЕСЯЦ), Регистратор, , ЛицевойСчет В (&ЛицевойСчет)) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	бит_ДанныеПоОбъемамЖКУСрезПоследних.Объем КАК Объем,
	        |	бит_ДанныеПоОбъемамЖКУСрезПоследних.Услуга КАК Услуга
	        |ПОМЕСТИТЬ ВТ_Объемы
	        |ИЗ
	        |	РегистрСведений.бит_ДанныеПоОбъемамЖКУ.СрезПоследних(&Период, Здание = &Здание) КАК бит_ДанныеПоОбъемамЖКУСрезПоследних
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ЕСТЬNULL(ВТ_Начисление.Начисление, 0) КАК Начисления,
	        |	ЕСТЬNULL(ВТ_Сальдо.Сальдо, 0) КАК НачальноеСальдо,
	        |	ЕСТЬNULL(ВТ_Разовые.Разовые, 0) КАК Разовые,
	        |	ВТ_Услуги.УслугаЖКХ КАК УслугаЖКХ,
	        |	ВТ_Ставки.СпособРасчета КАК СпособРасчета,
	        |	ЕСТЬNULL(ВТ_Ставки.ОсновнаяСтавка, 0) КАК ОсновнаяСтавка,
	        |	ЕСТЬNULL(ВТ_Объемы.Объем, 0) КАК Объем
	        |ИЗ
	        |	ВТ_Услуги КАК ВТ_Услуги
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Сальдо КАК ВТ_Сальдо
	        |		ПО ВТ_Услуги.УслугаЖКХ = ВТ_Сальдо.УслугаЖКХ
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Разовые КАК ВТ_Разовые
	        |		ПО ВТ_Услуги.УслугаЖКХ = ВТ_Разовые.УслугаЖКХ
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Начисление КАК ВТ_Начисление
	        |		ПО ВТ_Услуги.УслугаЖКХ = ВТ_Начисление.УслугаЖКХ
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Ставки КАК ВТ_Ставки
	        |		ПО ВТ_Услуги.УслугаЖКХ = ВТ_Ставки.Услуга
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Объемы КАК ВТ_Объемы
	        |		ПО ВТ_Услуги.УслугаЖКХ = ВТ_Объемы.Услуга";
	
КонецФункции

Процедура ЗаполнениеОБластиУслугиОДНПоТекПериоду(ЭтоУслугаСодРем, СтрокаОплаты, СуммаГВ, ГВНач, ДолгГВ, ОбластьТаблицаПараметрыОплатаТекПериодГВ, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ, СуммаОплатыТекПериод, СуммаОплатыПрошлыйПериод, ЭтоПерваяСтрока, ЭтоБухСправка, ПериодОбразованияЗадолженностиПо, ЛС = Неопределено, ДатаОстатка = Неопределено, ДанныеРазовые = Неопределено, Коэфф = 1, ГВТек = 0, ХВТек = 0, ВОТек = 0, ЭЛТек = 0, ДолженПоОДН = Ложь,
	ГВ=0, ХВ=0, ВО=0, ЭЭ=0, ОбластьТаблица = Неопределено);//, ГВНачислено = 0, ХВНачислено = 0, ВОНачислено = 0, ЭЛНачислено = 0)                                            
	
	УслугаСодРем        = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001");
	УслугаВО     	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000015");
	УслугаГВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000011");
	УслугаХВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000012");
	УслугаЭЭ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");
	
	Если ЭтоБухСправка Тогда
		
		Если СуммаОплатыТекПериод > 0 или не ДолженПоОДН  Тогда
			ОбластьТаблицаПараметрыОплатаТекПериодГВ	= ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ),"", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Формат(СуммаГВ,"ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС ;
			ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ),"", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ)+ Символы.ПС;
		Иначе
			ОбластьТаблицаПараметрыОплатаТекПериодГВ	= ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ),"", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Символы.ПС ;
			ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ),"", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ)+ Формат(СуммаГВ,"ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
		КонецЕсли;
		//СуммаОплатыТекПериод = СуммаОплатыТекПериод + СуммаГВ;
	ИначеЕсли Окр(ГВНач,5) >0 Тогда
		ОбластьТаблицаПараметрыОплатаТекПериодГВ	= ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ),"", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Формат(СуммаГВ,"ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
		ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ),"", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Символы.ПС;
		СуммаОплатыТекПериод = СуммаОплатыТекПериод + СуммаГВ;
	Иначе  
		//++Анисимова 07.11 1бит  Мешало выводу по Исп листу в текущий период минусовых сумм
		//Если Не ЭтоУслугаСодРем и ДолгГВ > 0 и СуммаГВ <= 0 Тогда
		//	ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ  = ?(ЭтоПерваяСтрока, "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Символы.ПС;
		//	ОбластьТаблицаПараметрыОплатаТекПериодГВ = ?(ЭтоПерваяСтрока, "", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Символы.ПС;
		//	Возврат;
		//КонецЕсли;
		//ДолгГВ = ДолгГВ - (-ГВНач);
		//Если 
		//--Анисимова 07.11 1бит   
		//Правки 13.11 для выпода с периодом оплаты за более ранний месяц в рамках отбора
		Если НЕ ЭтоУслугаСодРем ИЛИ СуммаГВ <= ГВНач Тогда
			//++Анисимова 07.11 1бит
			Если СтрокаОплаты.ПериодОплаты >= ПериодОбразованияЗадолженностиПо Тогда
				ОбластьТаблицаПараметрыОплатаТекПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ), "", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Формат(СуммаГВ, "ЧДЦ=2; ЧРД=,; ЧН=") + Символы.ПС;
				СуммаОплатыТекПериод = СуммаОплатыТекПериод + СуммаГВ;
			Иначе
			
			//--Анисимова 07.11 1бит
				ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ  = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Формат(-ГВНач, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
				ОбластьТаблицаПараметрыОплатаТекПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ), "", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Формат(СуммаГВ + ГВНач, "ЧДЦ=2; ЧРД=,; ЧН=") + Символы.ПС;
				СуммаОплатыТекПериод = СуммаОплатыТекПериод + СуммаГВ + ГВНач;
				СуммаОплатыПрошлыйПериод = СуммаОплатыПрошлыйПериод + (-ГВНач); 
			КонецЕсли;
		ИначеЕсли ЭтоУслугаСодРем Тогда    
			ДолгДоРасчета =ДолгГВ; 
			ДолгГВ = 0;
			//перенос суммы сод рем на другие услуги
			СуммаОплатыТП = ?(СуммаГВ - (-ГВНач + ДолгГВ)<0,0,СуммаГВ - (-ГВНач + ДолгГВ));
			СуммаОплатыПП = 0; 
				Переплата = -ГВНач;
				СуммаОплатыТП = ?(СуммаГВ - (-ГВНач)<0,0,СуммаГВ - (-ГВНач));       

					
				//СуммаОплатыПП = -ГВНач + ДолгГВ; 
				СальдоОДН = ПолучитьНачальноеСальдо(ЛС, ДатаОстатка);
				СтрокаРазовыеХВ = ДанныеРазовые.Найти(УслугаХВ, "УслугаЖКХ");
				СтрокаРазовыеГВ = ДанныеРазовые.Найти(УслугаГВ, "УслугаЖКХ");
				СтрокаРазовыеВО = ДанныеРазовые.Найти(УслугаВО, "УслугаЖКХ");
				СтрокаРазовыеЭЛ = ДанныеРазовые.Найти(УслугаЭЭ, "УслугаЖКХ");
				
				РазовыеХВ = ?(ЗначениеЗаполнено(СтрокаРазовыеХВ), СтрокаРазовыеХВ.СуммаОборот * Коэфф, 0);
				РазовыеГВ = ?(ЗначениеЗаполнено(СтрокаРазовыеГВ), СтрокаРазовыеГВ.СуммаОборот * Коэфф, 0);
				РазовыеВО = ?(ЗначениеЗаполнено(СтрокаРазовыеВО), СтрокаРазовыеВО.СуммаОборот * Коэфф, 0);
				РазовыеЭЛ = ?(ЗначениеЗаполнено(СтрокаРазовыеЭЛ), СтрокаРазовыеЭЛ.СуммаОборот * Коэфф, 0);
				Попытка
					ОстатокГВ = ?(СальдоОДН[0].ГВ + РазовыеГВ > 0, ГВТек, ГВТек +СальдоОДН[0].ГВ + РазовыеГВ);
					ОстатокХВ = ?(СальдоОДН[0].ХВ + РазовыеХВ > 0, ХВТек, ХВТек +СальдоОДН[0].ХВ + РазовыеХВ);
					ОстатокВО = ?(СальдоОДН[0].ВО + РазовыеВО > 0, ВОТек, ВОТек +СальдоОДН[0].ВО + РазовыеВО);
					ОстатокЭЛ = ?(СальдоОДН[0].ЭЭ + РазовыеЭЛ > 0, ЭлТек, ЭлТек +СальдоОДН[0].ЭЭ + РазовыеЭЛ);
					//ДолгОДН = ОстатокГВ + ОстатокХВ + ОстатокВО + ОстатокЭЛ;	 
					//Анисимова  
					ДолгОДН = 0;
					Если ОстатокГВ - СтрокаОплаты.ГВОпл >0  Тогда 
						ДолгОДН = ОстатокГВ;	
					КонецЕсли;   
					Если  ОстатокХВ - СтрокаОплаты.ХВОпл >0 Тогда 
						ДолгОДН = ДолгОДН + ОстатокХВ;	
					КонецЕсли;
					Если ОстатокВО - СтрокаОплаты.ВООпл >0  Тогда 
						ДолгОДН = ДолгОДН + ОстатокВО;	
					КонецЕсли;
					Если ОстатокЭЛ - СтрокаОплаты.ЭЛОпл >0 Тогда 
						ДолгОДН = ДолгОДН + ОстатокЭЛ;	
					КонецЕсли; 
					ДолгОДН = Окр(ДолгОДН,3);
					//Анисимова  					
				Исключение
					ДолгОДН = 0;
				КонецПопытки;
				СуммаОплатыПП = ?((-ГВНач) - ДолгОДН<0,0,(-ГВНач) - ДолгОДН);    
				Переплата = Переплата - СуммаОплатыПП;
				Если СальдоОДН.Количество() > 0 и ДолгОДН > 0 Тогда
					
					Если Переплата >= ДолгОДН Тогда
						Переплата = Переплата - ДолгОДН;
						Делитель = ДолгОДН;
					Иначе
						Делитель = Переплата;
						Переплата = 0;
					КонецЕсли;
					СуммГВ =  ?(ОстатокГВ - СтрокаОплаты.ГВОпл <= 0, 0,(ОстатокГВ / ДолгОДН * Делитель));
					СуммаХВ = ?(ОстатокХВ - СтрокаОплаты.ХВОпл <= 0, 0,(ОстатокХВ / ДолгОДН * Делитель));
					СуммаВО = ?(ОстатокВО - СтрокаОплаты.ВООпл <= 0, 0,(ОстатокВО / ДолгОДН * Делитель));
					СуммаЭЭ = ?(ОстатокЭЛ - СтрокаОплаты.ЭЛОпл <= 0, 0,(ОстатокЭЛ / ДолгОДН * Делитель));
					
					СуммаГВ =  ?(ГВ > 0 И ГВ - СуммГВ < 0, (ГВ- СтрокаОплаты.ГВОпл), СуммГВ);
					СуммаХВ = ?(ХВ > 0 И ХВ - СуммаХВ < 0, (ХВ - СтрокаОплаты.ХВОпл), СуммаХВ);
					СуммаВО = ?(ВО > 0 И ВО -СуммаВО < 0,  (ВО - СтрокаОплаты.ВООпл), СуммаВО);
					СуммаЭЭ = ?(ЭЭ > 0 И ЭЭ - СуммаЭЭ < 0, (ЭЭ - СтрокаОплаты.ЭЛОпл), СуммаЭЭ);  
					
				Иначе
					СуммГВ = 0;//Окр(ГВ / ДолгОДН * Переплата, 2);
					СуммаХВ = 0;//Окр(ХВ / ДолгОДН * Переплата, 2);
					СуммаВО = 0;//Окр(ВО / ДолгОДН * Переплата, 2);
					СуммаЭЭ = 0;//Окр(ЭЭ / ДолгОДН * Переплата, 2);
				КонецЕсли;
				СуммаОплатыТП = СуммаОплатыТП + (Переплата );
				//ГВНачислено = ГВНачислено - СуммаГВ;
				//ХВНачислено = ХВНачислено - СуммаХВ;
				//ВОНачислено = ВОНачислено - СуммаВО;
				//ЭЛНачислено = ЭЛНачислено - СуммаЭЭ;
				
				СтрокаОплаты.ГВОпл = СуммГВ + СтрокаОплаты.ГВОпл;
				СтрокаОплаты.ХВОпл = СуммаХВ + СтрокаОплаты.ХВОпл;
				СтрокаОплаты.ВООпл = СуммаВО + СтрокаОплаты.ВООпл;
				СтрокаОплаты.ЭЛОпл = СуммаЭЭ + СтрокаОплаты.ЭЛОпл;   
				ГВНач = ГВНач -СуммГВ - СуммаХВ-СуммаВО - СуммаЭЭ;
				//КонецЕсли;
				//  
				ДолгГВ = ДолгДоРасчета;
				ЗаполненПрошлыйПериод =Ложь;
				Если ГВНач <> 0 Тогда      
					ДолгГВПослеВычетаПереплаты = ДолгГВ - СуммаОплатыПП; 
					Если ДолгГВПослеВычетаПереплаты >= 0 Тогда    
						//СуммаОплатыПП =(-ГВНач);
						ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Формат(СуммаОплатыПП, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
						ДолгГВ = ДолгДоРасчета - СуммаОплатыПП;//ДолгГВ = ДолгДоРасчета - СуммаОплатыПП; 
						ЗаполненПрошлыйПериод = Истина;
					Иначе
						//++bit_AnisimovaMV_23.10.2023         
						ПереплатаПоСодРем =  -ГВНач;
						ПереплатаПоСодРем = ПеренестиПереплатуНаПрошлыйПериод(СтрокаОплаты, ДолгГВ, -ГВНач, ЭтоПерваяСтрока, ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодСодРем, 
