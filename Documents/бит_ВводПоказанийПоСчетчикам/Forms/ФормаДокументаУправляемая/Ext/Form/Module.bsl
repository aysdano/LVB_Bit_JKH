&НаСервере
Функция ПолучитьСписокЗначенийУслуг()
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет",Объект.ЛицевойСчет);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет
	|) КАК бит_СведенияПоУслугамЛССрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	СписокУслуг = Новый СписокЗначений;
	Пока Выборка.Следующий() Цикл
		СписокУслуг.Добавить(Выборка.Услуга);
	КонецЦикла;
	
	Возврат СписокУслуг;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокЛС(СписокИсключений, Дом , ЛицевойСчет)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Объект = &Объект
	|				И ТипСчетчика = &ТипСчетчика
	|				И (НЕ Счетчик В (&СписокИсключений))) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик";
	
	Запрос.УстановитьПараметр("Дата"            , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("ТипСчетчика"     , Объект.ТипСчетчика);
	Запрос.УстановитьПараметр("СписокИсключений", СписокИсключений);
	
	Если Объект.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
		Запрос.УстановитьПараметр("Объект", Дом);
	Иначе
		Запрос.УстановитьПараметр("Объект", ЛицевойСчет);
	КонецЕсли;
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокЛС = Новый СписокЗначений;
	СписокЛС.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Счетчик"));
	
	Возврат СписокЛС;
	
КонецФункции

&НаСервере
Процедура ПоказанияНаСчетчикеСчетчикОбработкаВыбораНаСервере(ВыбранноеЗначение, Дом, ЛицевойСчет, Квартира, НомерСтроки, СтароеЗначение, Многотарифный)
	
	ДокументОбъект           = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	ДокументОбъект.ОбновитьПараметрыЖКХ();
	мСчетчикиПодкруткаСервер = ДокументОбъект.мСчетчикиПодкрутка;
	мПодкруткаНаЛСНаСервере  = ДокументОбъект.мПодкруткаНаЛС;
	
	Запрос = Новый Запрос;
	МВТ    = Новый МенеджерВременныхТаблиц;
	
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	ТекстИндивидуальныеСчетчики =  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК КолПроживающих
	|ПОМЕСТИТЬ Проживающие
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &Объект) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.НачислятьПоНорме
	|	И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик,
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать КАК Использовать,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета,
	|	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления
	|ПОМЕСТИТЬ Услуги
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет = &Объект) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|	И бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Услуги.ЛицевойСчет КАК ЛицевойСчет,
	|	Услуги.Услуга КАК Услуга,
	|	Услуги.РежимПотребления КАК РежимПотребления,
	|	Услуги.Поставщик КАК Поставщик,
	|	Услуги.Использовать КАК Использовать,
	|	Услуги.СпособРасчета КАК СпособРасчета,
	|	Услуги.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	|	Проживающие.КолПроживающих КАК КолПроживающих
	|ПОМЕСТИТЬ Сведения
	|ИЗ
	|	Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО Услуги.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|		ЛЕВОЕ СОЕДИНЕНИЕ Проживающие КАК Проживающие
	|		ПО Услуги.ЛицевойСчет = Проживающие.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Сведения.ЛицевойСчет КАК ЛицевойСчет,
	|	Сведения.Услуга КАК Услуга,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаОдного, 0) КАК НаОдного,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаДвоих, 0) КАК НаДвоих,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаСемью, 0) КАК НаСемью,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаСемью4, 0) КАК НаСемью4,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаСемью5, 0) КАК НаСемью5,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаСемью6, 0) КАК НаСемью6,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.НаЛицевойСчет, 0) КАК НаЛицевойСчет,
	|	ЕСТЬNULL(Сведения.КолПроживающих, 0) КАК КолПроживающих,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0) КАК ДопНормаНаСемью,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0) КАК ДопНормаНаКаждого,
	|	ЕСТЬNULL(бит_НормыНаУслугиСрезПоследних.ИспользоватьДопНормуНаОдного, ЛОЖЬ) КАК ИспользоватьДопНормуНаОдного
	|ПОМЕСТИТЬ Нормы
	|ИЗ
	|	Сведения КАК Сведения
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НормыНаУслуги.СрезПоследних(
	|				&Дата,
	|				Услуга В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						таб.Услуга КАК Услуга
	|					ИЗ
	|						Услуги КАК таб)) КАК бит_НормыНаУслугиСрезПоследних
	|		ПО Сведения.Услуга = бит_НормыНаУслугиСрезПоследних.Услуга
	|			И Сведения.РежимПотребления = бит_НормыНаУслугиСрезПоследних.РежимПотребления
	|			И Сведения.СпособРасчета = бит_НормыНаУслугиСрезПоследних.СпособРасчетаПоУслуге
	|			И Сведения.ТипКвартиры = бит_НормыНаУслугиСрезПоследних.ТипКвартиры
	|			И Сведения.СтатусКвартиры = бит_НормыНаУслугиСрезПоследних.СтатусКвартиры
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Объект КАК Объект,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга КАК Услуга,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик КАК Счетчик,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик.Разрядность КАК Разрядность,
	|	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0) КАК ПредыдущиеПоказания,
	|	ЕСТЬNULL(Нормы.НаОдного, 0) КАК НаОдного,
	|	ЕСТЬNULL(Нормы.НаДвоих, 0) КАК НаДвоих,
	|	ЕСТЬNULL(Нормы.НаСемью, 0) КАК НаСемью,
	|	ЕСТЬNULL(Нормы.НаСемью4, 0) КАК НаСемью4,
	|	ЕСТЬNULL(Нормы.НаСемью5, 0) КАК НаСемью5,
	|	ЕСТЬNULL(Нормы.НаСемью6, 0) КАК НаСемью6,
	|	ЕСТЬNULL(Нормы.НаЛицевойСчет, 0) КАК НаЛицевойСчет,
	|	ЕСТЬNULL(Нормы.КолПроживающих, 0) КАК КолПроживающих,
	|	ЕСТЬNULL(Нормы.ДопНормаНаСемью, 0) КАК ДопНормаНаСемью,
	|	ЕСТЬNULL(Нормы.ДопНормаНаКаждого, 0) КАК ДопНормаНаКаждого,
	|	ЕСТЬNULL(Нормы.ИспользоватьДопНормуНаОдного, ЛОЖЬ) КАК ИспользоватьДопНормуНаОдного,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга.Приоритет КАК Приоритет,
	|	бит_СчетчикиНаУслугахСрезПоследних.Многотарифный
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Объект = &Объект
	|				И Счетчик = &Счетчик) КАК бит_СчетчикиНаУслугахСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
	|				&Дата,
	|				Объект = &Объект
	|					И Счетчик = &Счетчик) КАК бит_ПоказанияСчетчиковОстатки
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Объект = бит_ПоказанияСчетчиковОстатки.Объект
	|			И бит_СчетчикиНаУслугахСрезПоследних.Услуга = бит_ПоказанияСчетчиковОстатки.Услуга
	|			И бит_СчетчикиНаУслугахСрезПоследних.Счетчик = бит_ПоказанияСчетчиковОстатки.Счетчик
	|		ЛЕВОЕ СОЕДИНЕНИЕ Нормы КАК Нормы
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Объект = Нормы.ЛицевойСчет
	|			И бит_СчетчикиНаУслугахСрезПоследних.Услуга = Нормы.Услуга
	|ГДЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Использовать
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ ПО
	|	Счетчик";
	
	ТекстГрупповыеСчетчики =  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Объект КАК Объект,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга КАК Услуга,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик КАК Счетчик,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик.Разрядность КАК Разрядность,
	|	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0) КАК ПредыдущиеПоказания,
	|	0 КАК НаОдного,
	|	0 КАК НаДвоих,
	|	0 КАК НаСемью,
	|	0 КАК НаЛицевойСчет,
	|	0 КАК КолПроживающих,
	|	0 КАК ДопНормаНаСемью,
	|	0 КАК ДопНормаНаКаждого,
	|	ЛОЖЬ КАК ИспользоватьДопНормуНаОдного,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга.Приоритет КАК Приоритет,
	|	бит_СчетчикиНаУслугахСрезПоследних.Многотарифный
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Дата, Счетчик = &Счетчик) КАК бит_СчетчикиНаУслугахСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(&Дата, Счетчик = &Счетчик) КАК бит_ПоказанияСчетчиковОстатки
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Объект = бит_ПоказанияСчетчиковОстатки.Объект
	|			И бит_СчетчикиНаУслугахСрезПоследних.Услуга = бит_ПоказанияСчетчиковОстатки.Услуга
	|			И бит_СчетчикиНаУслугахСрезПоследних.Счетчик = бит_ПоказанияСчетчиковОстатки.Счетчик
	|ГДЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Использовать
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ ПО
	|	Счетчик";
	
	Запрос.УстановитьПараметр("Дата"   , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Счетчик", ВыбранноеЗначение);
	
	Если Объект.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
		Запрос.УстановитьПараметр("Объект", Дом);
		Запрос.Текст = ТекстГрупповыеСчетчики;
	Иначе
		Запрос.УстановитьПараметр("Объект"  , ЛицевойСчет);
		Запрос.УстановитьПараметр("Квартира", Квартира); 
		Запрос.Текст = ТекстИндивидуальныеСчетчики;
	КонецЕсли; 
	
	ВыборкаСЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
	Пока ВыборкаСЧ.Следующий() Цикл
		
		ТекПоказания = 0;
		Показания    = 0;
		Выборка   = ВыборкаСч.Выбрать();
		ПерваяСтрока = Истина;
		
		Пока Выборка.Следующий() Цикл
			
			Если ПерваяСтрока Тогда
				
				Строка = Объект.ПоказанияПоСчетчикам.НайтиПоИдентификатору(НомерСтроки);
				
			Иначе
				
				Строка = Объект.ПоказанияПоСчетчикам.Добавить();
				
			КонецЕсли;
			
			Если Объект.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой  Тогда
				
				Строка.Улица = Выборка.Объект.Улица;
				Строка.Дом   = Выборка.Объект;
				
			Иначе
				
				Строка.Улица       = Выборка.Объект.УлицаЛицевогоСчета;
				Строка.Дом         = Выборка.Объект.Здание;
				Строка.ЛицевойСчет = Выборка.Объект;
				
			КонецЕсли; 
			
			Строка.Счетчик                    = ВыбранноеЗначение;
			Строка.Услуга                     = Выборка.Услуга;
			Строка.Разрядность                = Выборка.Разрядность;
			Строка.ПредыдущиеПоказания        = Выборка.ПредыдущиеПоказания;
			Строка.ТекущиеПоказания           = 0;
			Строка.КоличествоЕдиницПоСчетчику = 0;
			Строка.Многотарифный              = Выборка.Многотарифный;
			
			Если Объект.ВидОперации = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ПоказанияПодкрутки Тогда
				
				Если НЕ мСчетчикиПодкруткаСервер Тогда
					
					// БИТ_ЖКХ 03.03.2015{{
					// Сообщить("Подкрутка счетчиков не ведется по этой организации!", СтатусСообщения.ОченьВажное);.
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Подкрутка счетчиков не ведется по этой организации!";
					Сообщение.Сообщить();
					// БИТ_ЖКХ 03.03.2015}}
					
					Объект.ПоказанияПоСчетчикам.Очистить();
					Возврат;
					
				КонецЕсли; 
				
				Если ТекПоказания <> 0 Тогда
					
					Строка.ТекущиеПоказания           = ТекПоказания;
					Строка.КоличествоЕдиницПоСчетчику = Показания;
					
				Иначе
					
					Норма     = 0;
					Показания = 0;
					КолПроживающих = ?(Выборка.КолПроживающих = 0, 1, Выборка.КолПроживающих);
					
					Если КолПроживающих = 1 Тогда
						
						Норма  = Выборка.НаОдного + ?(Выборка.ИспользоватьДопНормуНаОдного,Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого,0);
						
					ИначеЕсли КолПроживающих = 2 Тогда
						
						Норма  = Выборка.НаДвоих * 2 + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * 2;
						
					ИначеЕсли КолПроживающих = 3 Тогда
						
						Норма  = Выборка.НаСемью * КолПроживающих + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * КолПроживающих;
						
					ИначеЕсли КолПроживающих = 4 Тогда
						
						Норма  = Выборка.НаСемью4 * КолПроживающих + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * КолПроживающих;
						
					ИначеЕсли КолПроживающих = 5 Тогда
						
						Норма  = Выборка.НаСемью5 * КолПроживающих + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * КолПроживающих;
						
					ИначеЕсли КолПроживающих > 5 Тогда
						
						Норма  = Выборка.НаСемью6 * КолПроживающих + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * КолПроживающих;
						
					КонецЕсли;
					
					Если мПодкруткаНаЛСНаСервере Тогда
						
						Показания = Окр(Выборка.НаЛицевойСчет,4);
						
					Иначе
						
						Показания = Окр(Норма,4);
						
					КонецЕсли; 
					
					ТекПоказания = Строка.ПредыдущиеПоказания + Показания;
					
					Если ТекПоказания > Строка.Разрядность Тогда
						
						ТекПоказания = ТекПоказания - Строка.Разрядность + 1;
						Показания    = Показания + 1 ;
						
					КонецЕсли;
					
					Строка.ТекущиеПоказания           = ТекПоказания;
					Строка.КоличествоЕдиницПоСчетчику = Показания;
					
				КонецЕсли; 
				
			КонецЕсли;
			
			ПерваяСтрока  = Ложь;
			УдалитьСтарое = Истина;
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	МВТ.Закрыть();
	
	Если НЕ Многотарифный Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("Счетчик"    , СтароеЗначение);
		
		МассивСтрок = Объект.ПоказанияПоСчетчикам.НайтиСтроки(Отбор);
		
		Для каждого Строка Из МассивСтрок Цикл
			
			Объект.ПоказанияПоСчетчикам.Удалить(Строка);
			
		КонецЦикла; 
		
	КонецЕсли; 
	
КонецПроцедуры

