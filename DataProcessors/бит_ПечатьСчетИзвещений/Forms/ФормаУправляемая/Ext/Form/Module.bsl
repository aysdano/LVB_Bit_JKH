&НаСервереБезКонтекста
Функция ДобавитьЗависимыеВОсновнойСписок(СписокЛицевыйСчетов, ТаблицаЛС)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЛС", ТаблицаЛС);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЛС.ЛицевойСчет,
	|	ТаблицаЛС.ПечатьЗависимыхЛС
	|ПОМЕСТИТЬ ОсновнаяТаблица
	|ИЗ
	|	&ТаблицаЛС КАК ТаблицаЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЗависимыеЛС.ЛицевойСчетЗависимый,
	|	ОсновнаяТаблица.ЛицевойСчет
	|ИЗ
	|	ОсновнаяТаблица КАК ОсновнаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЗависимыеЛС КАК бит_ЗависимыеЛС
	|		ПО ОсновнаяТаблица.ЛицевойСчет = бит_ЗависимыеЛС.ЛицевойСчет
	|ГДЕ
	|	ОсновнаяТаблица.ПечатьЗависимыхЛС
	|	И НЕ бит_ЗависимыеЛС.ЛицевойСчетЗависимый ЕСТЬ NULL ";
	
	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокЛицевыйСчетов.Добавить(Выборка.ЛицевойСчетЗависимый);
		
	КонецЦикла; 
	
КонецФункции

&НаСервере
Процедура СоздатьЭлектронныеПисьма(ТолькоПоОтбору = Ложь)
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеКонтактнаяИнформация.Ссылка,
	|	бит_ПроживающиеКонтактнаяИнформация.Представление
	|ПОМЕСТИТЬ КИ
	|ИЗ
	|	Справочник.бит_Проживающие.КонтактнаяИнформация КАК бит_ПроживающиеКонтактнаяИнформация
	|ГДЕ
	|	бит_ПроживающиеКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
	|	И бит_ПроживающиеКонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.EmailПроживающего)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ПолучательПисьма,
	|	КИ.Представление КАК АдресПочты
	|ПОМЕСТИТЬ ОтветсвенныеЛицаКИ
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ КИ КАК КИ
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = КИ.Ссылка
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	ОтветсвенныеЛицаКИ.ПолучательПисьма,
	|	ОтветсвенныеЛицаКИ.АдресПочты
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОтветсвенныеЛицаКИ КАК ОтветсвенныеЛицаКИ
	|		ПО бит_ЛицевыеСчета.Ссылка = ОтветсвенныеЛицаКИ.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КИ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ОтветсвенныеЛицаКИ";
	
	ПостроительЗапроса.Параметры.Вставить("Дата", КонецМесяца(Объект.Период));
	
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	// Отбор по ЛС.
	Если Объект.СписокЛС.Количество() > 0 Тогда
		
		тмпСписокЛС = Объект.СписокЛС.Выгрузить();
		
		Значение = Новый СписокЗначений;
		Значение.ЗагрузитьЗначения(тмпСписокЛС.ВыгрузитьКолонку("ЛицевойСчет"));
		
		ОтборЛС = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
		ОтборЛС.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЛС.Значение      = Значение;
		ОтборЛС.Использование = Истина;
		
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	Выборка = ПостроительЗапроса.Результат.Выбрать();
	
	// Параметры для печати квитанций  Начало.
	ТабличнйДокумент  = Новый ТабличныйДокумент;
	
	ТабличнйДокумент.АвтоМасштаб = Истина;
	
	Если Объект.МакетКв = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент Тогда
		ТабличнйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Иначе
		ТабличнйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	КонецЕсли;
	
	МассивИсключений  = Новый Массив;
	
	ОбработкаОбъект = ДанныеФормыВЗначение(Объект, Тип("ОбработкаОбъект.бит_ПечатьСчетИзвещений"));
	
	ОбработкаОбъект.ПодключитьВнешнююКомпонентуПечатиШтрихкода();
	
	ОбработкаОбъект.УстановитьНастройкиТабличногоДокумена(ТабличнйДокумент);
	
	ТаблицаДанных = ОбработкаОбъект.СформироватьДанныеПечати(ТолькоПоОтбору);
	
	ШаблонСообщения = ПолучитьСтукрутуШаблонаСообщения(ШаблонТекстаПисьма);
	
	НачатьТранзакцию();
	
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ВладелецЛС", Выборка.ЛицевойСчет);
		
		ПоискЛС = ТаблицаДанных.НайтиСтроки(Отбор);
		
		Если ПоискЛС.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		ВремяИзменения  = ТекущаяДатаСеанса();
		Автор           = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
		
		Письмо = Справочники.бит_ЭлектронноеПисьмоИсходящее.СоздатьЭлемент();
		Письмо.Автор                    = Автор;
		Письмо.Ответственный            = Автор;
		Письмо.СтатусПисьма             = Перечисления.бит_СтатусыИсходящегоЭлектронногоПисьма.Черновик;
		
		
		Письмо.ДатаСоздания             = ВремяИзменения;
		Письмо.Тема                     = ТемаПисьма;
		Письмо.ЕстьВложения             = Истина;
		Письмо.ОтправкаКвитанций        = Истина;
		Письмо.Предмет                  = Выборка.ЛицевойСчет;
		Письмо.ШаблонИзвещений          = Объект.ШаблонИзвещений;
		Письмо.ПериодКвитанции          = Объект.Период;
		
		
		Письмо.Комментарий = "Созданно автоматически из обработки ""Печать счет извещений"", за период: " + ПредставлениеПериодаРегистрации;
		
		
		Если НЕ Объект.УчетнаяЗапись.Пустая() Тогда
			
			Письмо.УчетнаяЗапись = Объект.УчетнаяЗапись;
			
			РеквизитыОтправителя = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(
			Объект.УчетнаяЗапись,"Ссылка, ИмяПользователя, АдресЭлектроннойПочты");
			Письмо.ОтправительПредставление = бит_УправлениеЭлектроннойПочтойКлиентСервер.ПолучитьПредставлениеАдресата(
			РеквизитыОтправителя.ИмяПользователя, РеквизитыОтправителя.АдресЭлектроннойПочты, "");
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ПолучательПисьма) И Не ПустаяСтрока(Выборка.АдресПочты) Тогда
			Письмо.СписокПолучателейПисьма = Выборка.АдресПочты;
			НоваяСтрока = Письмо.ПолучателиПисьма.Добавить();
			НоваяСтрока.Адрес   = Выборка.АдресПочты;
			НоваяСтрока.Контакт = Выборка.ПолучательПисьма;
		КонецЕсли;
		
		Если Объект.ОставлятьПисьмаНаСервере Тогда
			
			НоваяСтрока = Письмо.ПолучателиПисьма.Добавить();
			НоваяСтрока.Адрес = Объект.УчетнаяЗапись.АдресЭлектроннойПочты;
			
		КонецЕсли; 
		
		// Перенос вторичных адресов в поле копия
		// 20.02.2019				
		если ЗначениеЗаполнено(НоваяСтрока) и СтрЧислоВхождений(НоваяСтрока.Адрес, ";") > 0 тогда
			
			АдресаПолучателейПисьма = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(НоваяСтрока.Адрес, ";");
			
			Письмо.ПолучателиПисьма.Очистить();
			
			НоваяСтрока = Письмо.ПолучателиПисьма.Добавить();
			НоваяСтрока.Адрес = АдресаПолучателейПисьма[0];
			Письмо.СписокПолучателейПисьма = НоваяСтрока.Адрес; 
			Письмо.СписокПолучателейКопий = "";
			
			АдресаПолучателейПисьма.Удалить(0);
			
			для каждого стр из АдресаПолучателейПисьма цикл				
								
				НоваяСтрока = Письмо.ПолучателиКопий.Добавить();
			    НоваяСтрока.Адрес = СокрЛП(стр);
				
				Письмо.СписокПолучателейКопий = Письмо.СписокПолучателейКопий + СокрЛП(стр) + ";" ;

			конеццикла;	
			
		конецесли;
		//-----------------
		
		Попытка
			
			Письмо.Записать();
			
		Исключение
			
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = НСтр("ru = '%1'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ОтменитьТранзакцию();
			Возврат;
			
		КонецПопытки;
		
		Для каждого СтрокаТаблицы Из ПоискЛС Цикл
			
			ТабличнйДокумент.Очистить();
			ОбработкаОбъект.ВывестиНаПечатьКвитанцию(ТабличнйДокумент, СтрокаТаблицы);
			
			РазрешениеФайла = НРег(Строка(ТипФайла));
			Если Объект.ЗапаковатьZIP Тогда
				РазрешениеФайла = НРег("ZIP");
			КонецЕсли; 
			
			ИмяФайла = "Счет извещение (" + ПредставлениеПериодаРегистрации +"_"+ СтрокаТаблицы.ЛицевойСчет + ")";
			
			АдресФайлаВоВременномХранилище = ДобавитьПрикрепленныйФайл(ТабличнйДокумент);
			
			бит_ПрисоединенныеФайлыСервер.ДобавитьФайл(Письмо.Ссылка,
														ИмяФайла,
														РазрешениеФайла,
														ВремяИзменения,
														ВремяИзменения,
														АдресФайлаВоВременномХранилище);
			
		КонецЦикла;
		
		ДобавитьТекстШаблонаСообщения(Письмо.Ссылка, ШаблонСообщения);
		
	КонецЦикла; 
	
	ЗафиксироватьТранзакцию();
	
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаНачало", НачалоМесяца(Объект.Период));
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаКонец" , КонецМесяца(Объект.Период));
	
	Элементы.ТаблицаПисем.Обновить();
	
КонецПроцедуры

&НаСервере
Процедура ОтправитьПисьма(НовыйСтатусПисьма)
	
	// Запрос переделан на построитель чтобы действовали отборы.
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Текст = 
	"ВЫБРАТЬ
	|	бит_ЭлектронноеПисьмоИсходящее.Ссылка КАК ЭлектронноеПисьмо,
	|	бит_ЭлектронноеПисьмоИсходящее.Предмет КАК ЛицевойСчет,
	|	бит_ЭлектронноеПисьмоИсходящее.СтатусПисьма,
	|	бит_ЭлектронноеПисьмоИсходящее.СписокПолучателейПисьма,
	|	бит_ЭлектронноеПисьмоИсходящее.Предмет.Здание КАК Здание,
	|	бит_ЭлектронноеПисьмоИсходящее.Предмет.Здание.Улица КАК Улица,
	|	бит_ЭлектронноеПисьмоИсходящее.Предмет.Здание.Участок КАК Участок,
	|	бит_ЭлектронноеПисьмоИсходящее.Предмет.Здание.Район КАК Район
	|ИЗ
	|	Справочник.бит_ЭлектронноеПисьмоИсходящее КАК бит_ЭлектронноеПисьмоИсходящее
	|ГДЕ
	|	бит_ЭлектронноеПисьмоИсходящее.ОтправкаКвитанций
	|	И бит_ЭлектронноеПисьмоИсходящее.Предмет ССЫЛКА Справочник.бит_ЛицевыеСчета
	|	И бит_ЭлектронноеПисьмоИсходящее.ПериодКвитанции МЕЖДУ &ДатаНачало И &ДатаКонец
	|	И НЕ бит_ЭлектронноеПисьмоИсходящее.ПометкаУдаления";
	
	ПостроительЗапроса.Параметры.Вставить("ДатаНачало", НачалоМесяца(Объект.Период));
	ПостроительЗапроса.Параметры.Вставить("ДатаКонец" , КонецМесяца(Объект.Период));
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	// Отбор по районам.
	Если Объект.СписокРайонов.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		
		Для Каждого Строка Из Объект.СписокРайонов Цикл 
			
			Значение.Добавить(Строка.Район);
			
		КонецЦикла;
		
		ОтборРайоны = ПостроительЗапроса.Отбор.Добавить("Район");
		ОтборРайоны.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборРайоны.Значение      = Значение;
		ОтборРайоны.Использование = Истина;
		
	КонецЕсли; 
	
	// Отбор по участкам.
	Если Объект.СписокУчастков.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		
		Для Каждого Строка Из Объект.СписокУчастков Цикл 
			
			Значение.Добавить(Строка.Участок);
			
		КонецЦикла;
		
		ОтборУчасток = ПостроительЗапроса.Отбор.Добавить("Участок");
		ОтборУчасток.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборУчасток.Значение      = Значение;
		ОтборУчасток.Использование = Истина;
		
	КонецЕсли;
	
	// Отбор по улицам.
	Если Объект.СписокУлиц.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		
		Для Каждого Строка Из Объект.СписокУлиц Цикл 
			
			Значение.Добавить(Строка.Улица);
			
		КонецЦикла;
		
		ОтборУлиц = ПостроительЗапроса.Отбор.Добавить("Улица");
		ОтборУлиц.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборУлиц.Значение      = Значение;
		ОтборУлиц.Использование = Истина;
		
	КонецЕсли; 
	
	// Отбор по зданиям.
	Если Объект.СписокЗданий.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		
		Для Каждого Строка Из Объект.СписокЗданий Цикл 
			
			Значение.Добавить(Строка.Здание);
			
		КонецЦикла;
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("Здание");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = Значение;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	// Отбор по лицевым счетам.
	Если Объект.СписокЛС.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		
		Для Каждого Строка Из Объект.СписокЛС Цикл 
			
			Значение.Добавить(Строка.ЛицевойСчет);
			
		КонецЦикла;
		
		Для каждого Строка из Объект.СписокЛС Цикл
			
			Если Строка.ПечатьЗависимыхЛС = Истина Тогда
				
				ДобавитьЗависимыеВОсновнойСписокНаСервере(Значение);
				
				Прервать;
				
			КонецЕсли;
			
		КонецЦикла;	
		
		ОтборЛС = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
		ОтборЛС.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЛС.Значение      = Значение;
		ОтборЛС.Использование = Истина;
		
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	Выборка = ПостроительЗапроса.Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.СтатусПисьма = Перечисления.бит_СтатусыИсходящегоЭлектронногоПисьма.Отправлено 
			ИЛИ Выборка.СтатусПисьма = НовыйСтатусПисьма Тогда
			Продолжить;
		КонецЕсли; 
		
		ПисьмоОбъект = Выборка.ЭлектронноеПисьмо.ПолучитьОбъект();
		
		Если НовыйСтатусПисьма = Перечисления.бит_СтатусыИсходящегоЭлектронногоПисьма.Исходящее Тогда
			
			ПисьмоОбъект.СтатусПисьма           = Перечисления.бит_СтатусыИсходящегоЭлектронногоПисьма.Исходящее;
			
		ИначеЕсли НовыйСтатусПисьма = Перечисления.бит_СтатусыИсходящегоЭлектронногоПисьма.Отправлено Тогда
			
			Если ЗначениеЗаполнено(Выборка.СписокПолучателейПисьма) Тогда
				Профиль =  РаботаСПочтовымиСообщениямиСлужебный.ИнтернетПочтовыйПрофиль(Объект.УчетнаяЗапись);
			Иначе
				Продолжить;
			КонецЕсли;
			
			Попытка
				Соединение = Новый ИнтернетПочта;
				Соединение.Подключиться(Профиль);
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстСообщения = НСтр("ru = 'Во время подключения к учетной записи %1 произошла ошибка!
											|%2'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, Строка(Объект.УчетнаяЗапись), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецПопытки;
			
			Попытка
				
				Если НЕ ЗначениеЗаполнено(ПисьмоОбъект.УчетнаяЗапись) Тогда
					ПисьмоОбъект.УчетнаяЗапись = Объект.УчетнаяЗапись; 
				КонецЕсли;
				
				ИдентификаторПисьма = бит_УправлениеЭлектроннойПочтойСервер.ВыполнитьОтправкуПисьма(ПисьмоОбъект, Соединение);
			Исключение
				ИнформацияОбОшибке = ИнформацияОбОшибке();
				ТекстСообщения = НСтр("ru = 'Во время отправки электронного письма %1 произошла ошибка!
											|%2'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, Строка(Выборка.ЭлектронноеПисьмо), ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Продолжить;
			КонецПопытки;
			
			ПисьмоОбъект.ИдентификаторСообщения = ИдентификаторПисьма;
			ПисьмоОбъект.СтатусПисьма           = Перечисления.бит_СтатусыИсходящегоЭлектронногоПисьма.Отправлено;
			ПисьмоОбъект.Размер                 = бит_УправлениеЭлектроннойПочтойСервер.ОценитьРазмерИсходящегоЭлектронногоПисьма(ПисьмоОбъект.Ссылка);
			ПисьмоОбъект.ДатаОтправления        = ТекущаяДатаСеанса();
			
		КонецЕсли;
		
		ПисьмоОбъект.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьПодобранныхПолучателей(Письмо, Адреса)
	
	ПисьмоОбъект = Письмо.ПолучитьОбъект();
	
	СоответствиеТабличныхЧастей = Новый Соответствие;
	СоответствиеТабличныхЧастей.Вставить("Кому" , ПисьмоОбъект.ПолучателиПисьма);
	СоответствиеТабличныхЧастей.Вставить("Копии", ПисьмоОбъект.ПолучателиКопий);
	СоответствиеТабличныхЧастей.Вставить("Ответ", ПисьмоОбъект.ПолучателиОтвета);
	
	Для Каждого ТабличнаяЧасть Из СоответствиеТабличныхЧастей Цикл
		ТабличнаяЧасть.Значение.Очистить();
	КонецЦикла;
	
	Для Каждого Элемент Из Адреса Цикл
		
		ТабличнаяЧасть = СоответствиеТабличныхЧастей.Получить(Элемент.Группа);
		Если ТабличнаяЧасть = Неопределено Тогда
			ТабличнаяЧасть = ПисьмоОбъект.ПолучателиПисьма;
		КонецЕсли;
		
		НоваяСтрока = ТабличнаяЧасть.Добавить();
		НоваяСтрока.Адрес = Элемент.Адрес;
		НоваяСтрока.Представление = Элемент.Представление;
		НоваяСтрока.Контакт = Элемент.Контакт;
		
	КонецЦикла;
	
	ПисьмоОбъект.СписокПолучателейПисьма =
	бит_УправлениеЭлектроннойПочтойКлиентСервер.ПолучитьПредставлениеСпискаАдресатов(ПисьмоОбъект.ПолучателиПисьма, Ложь);
	ПисьмоОбъект.СписокПолучателейКопий =
	бит_УправлениеЭлектроннойПочтойКлиентСервер.ПолучитьПредставлениеСпискаАдресатов(ПисьмоОбъект.ПолучателиКопий, Ложь);
	
	ПисьмоОбъект.Записать();
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПараметрыОткрытияФормыПодбора()
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"       , Объект.Организация);
	ПараметрыФормы.Вставить("Дата"              , Объект.Период);
	ПараметрыФормы.Вставить("ОткрытоИзДокумента", Истина);
	
	Если СписокУлиц.Количество() > 0 Тогда
		
		тмпСпсиокУлиц = СписокУлиц.Выгрузить();
		
		ЗначениеУлиц =  Новый СписокЗначений;
		ЗначениеУлиц.ЗагрузитьЗначения(тмпСпсиокУлиц.ВыгрузитьКолонку("Улица"));
		
		ПараметрыФормы.Вставить("СписокУлиц", ЗначениеУлиц);
		
	КонецЕсли; 
	
	Если СписокЗданий.Количество() > 0 Тогда
		
		тмпСпсиокЗданий = СписокЗданий.Выгрузить();
		
		ЗначениеЗданий =  Новый СписокЗначений;
		ЗначениеЗданий.ЗагрузитьЗначения(тмпСпсиокЗданий.ВыгрузитьКолонку("Здание"));
		
		ПараметрыФормы.Вставить("СписокЗданий", ЗначениеЗданий);
		
	КонецЕсли;
	
	Возврат ПараметрыФормы;
	
КонецФункции

&НаСервере
Процедура ТаблицаЛСНаСервере(АдресЛСВХранилище)
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(АдресЛСВХранилище);
	
	Если ТаблицаЛС = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Ошибка получения данных из временного хранилища. Выполните подбор заново.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из ТаблицаЛС Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет", СтрокаТаблицы.ЛицевойСчет);
		
		СтрокиПосика = Объект.СписокЛС.НайтиСтроки(Отбор);
		
		Если СтрокиПосика.Количество() = 0 Тогда
			
			НоваяСтрока = Объект.СписокЛС.Добавить();
			НоваяСтрока.ЛицевойСчет = СтрокаТаблицы.ЛицевойСчет;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

