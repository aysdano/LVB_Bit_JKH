#Область ПроцедурыИФункцииОплатыКоммунальныхУслуг

// Процедура распределяет сумму документа по пени".
// Параметры:
// КоммунальныеУслуги - таб. часть документа.
// СуммаДокумента - сумма для распределения.
//
Процедура РаспределитьСуммуПоПени(КоммунальныеУслуги, СуммаДокумента, СуммаДляРаспределения
	// БИТ_ЖКХ 02.07.2014
	,НачислятьПениСУчетомПереплаты
	// БИТ_ЖКХ 02.07.2014
	
	// БИТ_ЖКХ 01.09.2014
	,ИтогОплата)
	// БИТ_ЖКХ 01.09.2014
	
	ИтогКОплате   = 0;
	Для каждого ТекСтрока Из КоммунальныеУслуги Цикл
		
		// БИТ_ЖКХ 02.07.2014
		// ИтогКОплате = ИтогКОплате + ?(ТекСтрока.СальдоНаНачало > 0,Текстрока.СальдоНаНачало,0);. 
		Если НачислятьПениСУчетомПереплаты Тогда 
			ИтогКОплате = ИтогКОплате + ТекСтрока.СальдоНаНачало;
		Иначе
			ИтогКОплате = ИтогКОплате + ?(ТекСтрока.СальдоНаНачало > 0,Текстрока.СальдоНаНачало,0); 
		КонецЕсли;
		// БИТ_ЖКХ 02.07.2014
		
	КонецЦикла; 
	
	// БИТ_ЖКХ 01.09.2014
	ИтогКОплате = ИтогКОплате - ИтогОплата;
	// БИТ_ЖКХ 01.09.2014
	
	ИтогПени       = КоммунальныеУслуги.Итог("СальдоПени");
	НачислятьПеню = ?(СуммаДокумента > ИтогКОплате, Истина, Ложь);
	
	Если НачислятьПеню Тогда
		
		// БИТ_ЖКХ 03.07.2014		
		Если НачислятьПениСУчетомПереплаты Тогда
			
			Если СуммаДляРаспределения >= ИтогПени Тогда
				
				СуммаДляРаспределения = СуммаДляРаспределения - ИтогПени;
				
				Для каждого ТекСтрока Из КоммунальныеУслуги Цикл
					
					ТекСтрока.СуммаПени = ТекСтрока.СальдоПени;
					
				КонецЦикла;
			Иначе
				
				Для каждого ТекСтрока Из КоммунальныеУслуги Цикл
					
					Пени = ?(ИтогПени <= 0 , 0 , (СуммаДляРаспределения * ТекСтрока.СальдоПени)/ИтогПени);
					ТекСтрока.СуммаПени = Пени;
					
				КонецЦикла; 
				
				СуммаДляРаспределения = 0;
				
			КонецЕсли;
			// БИТ_ЖКХ 03.07.2014		
			
		ИначеЕсли СуммаДляРаспределения >= ИтогПени Тогда
			
			СуммаДляРаспределения = СуммаДляРаспределения - ИтогПени;
			
			Для каждого ТекСтрока Из КоммунальныеУслуги Цикл
				
				ТекСтрока.СуммаПени = ТекСтрока.СальдоПени;
				
			КонецЦикла;
			
		Иначе
			
			Для каждого ТекСтрока Из КоммунальныеУслуги Цикл
				
				Пени = ?(ИтогПени <= 0 , 0 , (СуммаДляРаспределения * ТекСтрока.СальдоПени)/ИтогПени);
				ТекСтрока.СуммаПени = Пени;
				
			КонецЦикла; 
			
			СуммаДляРаспределения = 0;
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

// Процедура распределяет сумму документа по таб. части "бит_КоммунальныеУслуги".
