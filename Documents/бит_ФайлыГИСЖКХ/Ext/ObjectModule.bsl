Функция ДолгРФКР(пУслуга, пЛицевойСчет, пДата);
	
	//Период = КонецДня(КонецМесяца(Дата)); 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ 
	|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(
	|			КонецПериода(&Период,Месяц),
	|			УслугаЖКХ = &Услуга
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", пЛицевойСчет);
	Запрос.УстановитьПараметр("Период", пДата);
	Запрос.УстановитьПараметр("Услуга", пУслуга);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Возврат ВыборкаДетальныеЗаписи.СуммаОстаток;
	Иначе	
		Возврат 0;	
	КонецЕсли; 
	
КонецФункции


Функция ПодготовитьТаблицуПоставщиковМО(ТЗПоставщиков)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТЗПоставщиков", ТЗПоставщиков);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТЗПоставщиков.ПоставщикУслуг КАК ПоставщикУслуг,
	|	ТЗПоставщиков.Приоритет КАК Приоритет,
	|	ТЗПоставщиков.КраткоеНаименование КАК КраткоеНаименование,
	|	ТЗПоставщиков.ПолноеНаимменование КАК ПолноеНаимменование,
	|	ТЗПоставщиков.ЮрАдрес КАК ЮрАдрес,
	|	ТЗПоставщиков.ФактАдрес КАК ФактАдрес,
	|	ТЗПоставщиков.ИНН КАК ИНН,
	|	ТЗПоставщиков.КПП КАК КПП,
	|	ТЗПоставщиков.БанковскиеРеквизиты КАК БанковскиеРеквизиты,
	|	ТЗПоставщиков.Телефон КАК Телефон,
	|	ТЗПоставщиков.Услуга1 КАК Услуга1,
	|	ТЗПоставщиков.ЭлектроннаяПочта КАК ЭлектроннаяПочта
	|ПОМЕСТИТЬ ВТ_Поставщики
	|ИЗ
	|	&ТЗПоставщиков КАК ТЗПоставщиков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Поставщики.ПоставщикУслуг КАК ПоставщикУслуг,
	|	ВТ_Поставщики.Приоритет КАК Приоритет,
	|	ВТ_Поставщики.КраткоеНаименование КАК КраткоеНаименование,
	|	ВТ_Поставщики.ПолноеНаимменование КАК ПолноеНаимменование,
	|	ВТ_Поставщики.ЮрАдрес КАК ЮрАдрес,
	|	ВТ_Поставщики.ФактАдрес КАК ФактАдрес,
	|	ВТ_Поставщики.ИНН КАК ИНН,
	|	ВТ_Поставщики.КПП КАК КПП,
	|	ВТ_Поставщики.БанковскиеРеквизиты КАК БанковскиеРеквизиты,
	|	ВТ_Поставщики.Телефон КАК Телефон,
	|	ВТ_Поставщики.Услуга1 КАК Услуга1,
	|	ВТ_Поставщики.ЭлектроннаяПочта КАК ЭлектроннаяПочта
	|ИЗ
	|	ВТ_Поставщики КАК ВТ_Поставщики
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ ПО
	|	ПоставщикУслуг";
	
	ВыборкаПоставщиков = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	ТЗПоставщиков.Очистить();
	
	Пока ВыборкаПоставщиков.Следующий() Цикл
		
		Сч = 1;
		ВыборкаУслуг = ВыборкаПоставщиков.Выбрать();
		Пока ВыборкаУслуг.Следующий() И Сч < 5 Цикл
			
			Если Сч = 1 Тогда
				НСтр = ТЗПоставщиков.Добавить();
				НСтр.ПоставщикУслуг			= ВыборкаУслуг.ПоставщикУслуг;
				НСтр.Приоритет				= ВыборкаУслуг.Приоритет;
				НСтр.КраткоеНаименование	= ВыборкаУслуг.КраткоеНаименование;
				НСтр.ПолноеНаимменование	= ВыборкаУслуг.ПолноеНаимменование;
				НСтр.ЮрАдрес				= ВыборкаУслуг.ЮрАдрес;
				НСтр.ФактАдрес				= ВыборкаУслуг.ФактАдрес;
				НСтр.ИНН					= ВыборкаУслуг.ИНН;
				НСтр.БанковскиеРеквизиты	= ВыборкаУслуг.БанковскиеРеквизиты;
				НСтр.Телефон				= ВыборкаУслуг.Телефон;
				НСтр.ЭлектроннаяПочта		= ВыборкаУслуг.ЭлектроннаяПочта;
			КонецЕсли;
			
			Если Сч = 1 Тогда
				НСтр.Услуга1 = ВыборкаУслуг.Услуга1;
			ИначеЕсли Сч = 2 Тогда	
				НСтр.Услуга2 = ВыборкаУслуг.Услуга1;
			ИначеЕсли Сч = 3 Тогда	
				НСтр.Услуга3 = ВыборкаУслуг.Услуга1;
			Иначе	
				НСтр.Услуга4 = ВыборкаУслуг.Услуга1;
			КонецЕсли;
			
			Сч = Сч + 1;
			
		КонецЦикла; // ВыборкаУслуг.
		
	КонецЦикла; // ВыборкаПоставщиков.
	
