// Процедура осуществляет печать справочника. Можно направить печать на. 
// Экран или принтер, а также распечатать необходмое количество копий.
//
//  Название макета печати передается в качестве параметра,
// По переданному названию находим имя макета в соответствии.
// Параметры:
//  НазваниеМакета - строка, название макета.
// Возвращаемое значение:
//  Нет.
//
Процедура Печать(ИмяМакета, КоличествоЭкземпляров = 1, НаПринтер = Ложь, НепосредственнаяПечать = Ложь, ФормаЭлемента = Неопределено) Экспорт
	
	// Получить экземпляр документа на печать.
	Если ИмяМакета = "СчетИзвещения" Тогда
		// БИТ_ЖКХ изменения кода . Начало: 25.10.2011
		ТабДокумент = ПечатьСчетИзвещения(Истина);
	ИначеЕсли ИмяМакета = "СчетИзвещения1"  Тогда
		ТабДокумент = ПечатьСчетИзвещения(Ложь);
		// БИТ_ЖКХ изменения кода . Конец  25.10.2011
	ИначеЕсли ИмяМакета = "СчетИзвещение2" ИЛИ ИмяМакета = "СчетИзвещение3" Тогда
		ТабДокумент = ПечатьСчетИзмещенияВариант2(ИмяМакета);
		// БИТ_ЖКХ изменения кода . Начало: 23.03.2011 
	ИначеЕсли ИмяМакета = "СчетИзвещение4" ИЛИ ИмяМакета = "СчетИзвещение5"  Тогда
		ТабДокумент = ПечатьСчетИзвещенияВариант4(ИмяМакета);
		// БИТ_ЖКХ изменения кода . Конец  23.03.2011 
	ИначеЕсли ИмяМакета = "СчетИзвещение6"  Тогда
		ТабДокумент = ПечатьСчетИзвещения6(ИмяМакета);
	ИначеЕсли ИмяМакета = "Квитанция6" ИЛИ ИмяМакета = "Квитанция6_1" Тогда
		ТабДокумент = ПечатьСчетКвитанция6(ИмяМакета);
	ИначеЕсли ИмяМакета = "Квитанция5" Тогда
		ТабДокумент = ПечатьСчетКвитанция5();
		// БИТ_ЖКХ добавление кода Начало: 23.09.2011 
	ИначеЕсли ИмяМакета = "Квитанция7" Тогда
		ТабДокумент = ПечатьСчетКвитанция7();
	ИначеЕсли ИмяМакета = "Квитанция8"  Тогда
		ТабДокумент = ПечатьКвитанции8(ИмяМакета);
		// БИТ_ЖКХ добавление кода конец : 23.09.2011	
	ИначеЕсли ИмяМакета = "СчетИзвещенияПодробно" тогда	
		ТабДокумент = ПечатьСчетИзвещенияПодробно();
	ИначеЕсли ИмяМакета = "ПоквартирнаяКарточка" тогда
		ОтчетОбъект = Отчеты.бит_ПоквартирнаяКарточка.Создать();
		ОтчетОбъект.ЛицевойСчет = Ссылка;
		ФормаОтчета = ОтчетОбъект.ПолучитьФорму("ПоквартирнаяКарточкаУправляемая");
		ФормаОтчета.Открыть();
		ОтчетОбъект.ПоквартирнаяКарточкаВывести(ФормаОтчета.ЭлементыФормы.ПолеТабличногоДокумента);
		
		Возврат;
		
	ИначеЕсли  ИмяМакета = "КопияФинансовоЛицевогоСчета" тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЛицевойСчет", Ссылка);
		
		ОткрытьФорму("Отчет.бит_КопияФинансовоЛицевогоСчета.Форма.ФормаОтчета", ПараметрыФормы);

		Возврат;
	ИначеЕсли  ИмяМакета = "ВыпискаИзДомовойКниги"  тогда
		ОтчетОбъект = Отчеты.бит_ВыпискаИзДомовойКниги.Создать();
		ОтчетОбъект.Дата        = ТекущаяДата();
		ОтчетОбъект.ЛицевойСчет = Ссылка;
		ФормаОтчета = ОтчетОбъект.ПолучитьФорму("ФормаОтчетаУправляемая");
		ФормаОтчета.Открыть();
		// БИТ_ЖКХ изменения кода . Начало: 26.09.2011
		// Добавлен второй параметр.
		ОтчетОбъект.СформироватьОтчет(ФормаОтчета.ЭлементыФормы.Результат,ИмяМакета);
		// БИТ_ЖКХ изменения кода . Конец  26.09.2011
		Возврат;
		// БИТ_ЖКХ изменение кода. Начало. 18.01.2012{{
	ИначеЕсли ИмяМакета = "КарточкаРасчетовПоЛицевомуСчету" Тогда
		
		Параметры = Новый Структура;
		Параметры.Вставить("НачалоПериода"    , НачалоМесяца(ТекущаяДата()));
		Параметры.Вставить("КонецПериода"     , КонецМесяца(ТекущаяДата()));
		Параметры.Вставить("ЛицевойСчет"      , Ссылка);
		Параметры.Вставить("СформироватьОтчет", Истина);
		
		ОткрытьФорму("Отчет.бит_КарточкаРасчетовПоЛицевомуСчету.Форма.ФормаОтчета", Параметры);
		
		Возврат;
		
	ИначеЕсли ИмяМакета = "СправкаПоПовестке" Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЛицевойСчет", Ссылка);
		
		ОткрытьФорму("Отчет.бит_СправкаПоПовестке.Форма.ФормаОтчета", ПараметрыФормы);
		
		// БИТ_ЖКХ изменения кода . Начало: 29.07.2013
	ИначеЕсли ИмяМакета = "ОтчетОДвиженияхНаЛСПомесячно" Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЛицевойСчет", Ссылка);
		
		ОткрытьФорму("Отчет.бит_ОтчетОДвиженияхНаЛСПомесячно.Форма.ФормаОтчета", ПараметрыФормы);
		// БИТ_ЖКХ изменения кода . Конец: 29.07.2013
	Иначе

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка получения дополнительной печатной формы объекта. Возможно форма была удалена");
		
	КонецЕсли;
	
КонецПроцедуры // Печать()

