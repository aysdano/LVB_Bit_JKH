
#Область ПеременныеМодуля

&НаКлиенте
Перем мФормаПодбораЛС;  // Хранит форму подбора лицевых счетов.

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура выполняет базовые проверки при изменении начальных и конечных показаний.
//
&НаКлиенте
Процедура ПриИзмененииПоказаний(Значение, НачалоСообщения, Отказ = Ложь)
	
	Если НЕ ЗначениеЗаполнено(Объект.Счетчик) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не установлен счетчик!");
		
		Значение = 0;
		Отказ    = Истина;
		Возврат;
		
	КонецЕсли; 
	
	Если Значение > мКэшЗначений.Разрядность Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(НачалоСообщения + " не могут быть больше максимального значения счетчика = " + мКэшЗначений.Разрядность);
		
		Отказ    = Истина;
		Значение = 0;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииДляУправленияВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , Строка(Объект.ВидОперации));
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры // УстановитьЗаголовокФормыДокумента()

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	// Управление видимостью элементов.
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьЛицевыеСчетаНаСчетчик
		ИЛИ Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьЗданияНаСчетчик // БИТ_ЖКХ 27.11.2015 15:32:08 
		ИЛИ Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УдалитьЛицевыеСчетаСоСчетчика Тогда
		
		Элементы.ГруппаЛицевыеСчета.Видимость                = Истина;
		Элементы.ДеревоОбъектовУчетаОбновитьЗдания.Видимость = Истина;
		// БИТ_ЖКХ 27.11.2015 15:32:33 Начало правки...
		Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьЗданияНаСчетчик Тогда
			Элементы.ДеревоОбъектовУчетаДобавитьЗдание.Видимость = Истина;
		Иначе
			Элементы.ДеревоОбъектовУчетаДобавитьЗдание.Видимость = Ложь;
		КонецЕсли;
		//Элементы.ДеревоОбъектовУчетаДобавитьЗдание.Видимость = Ложь;
		// БИТ_ЖКХ 27.11.2015 15:32:33 Конец правки. 
		
		Элементы.НачальныеПоказания.Видимость                  = Ложь;
		Элементы.КонечныеПоказания.Видимость                   = Ложь;
		Элементы.МестоУстановкиСчетчика.Видимость              = Ложь;
		Элементы.ВвестиРазовые.Видимость                       = Ложь;
		Элементы.Декорация1.Видимость                          = Ложь;
		Элементы.Объект.Видимость                              = Ложь;
		Элементы.Приоритет.Видимость                           = Ложь;
		Элементы.ИспользоватьСтавкуПоСчетчику.Видимость        = Ложь;
		Элементы.ГруппаУслуги.Видимость                        = Ложь;
		Элементы.ДатаПоверки.Видимость                         = Ложь;
		Элементы.Многотарифный.Видимость                       = Ложь;
		Элементы.СчетчикСЗависимымиУслугами.Видимость          = Ложь;
		Элементы.ИспользоватьПравилоУменьшения.Видимость       = Ложь;
		Элементы.УслугиСпособРасчетаУменьшения.Видимость       = Ложь;
		Элементы.УслугиСпособРаспределенияУменьшения.Видимость = Ложь;
		
		Элементы.ИспользоватьПравилоУменьшения.Доступность = Ложь;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик
		ИЛИ Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УдалитьУслугиСоСчетчика Тогда
		
		Элементы.ГруппаЛицевыеСчета.Видимость                = Истина;
		Элементы.ДеревоОбъектовУчетаОбновитьЗдания.Видимость = Истина;
		Элементы.ДеревоОбъектовУчетаДобавитьЗдание.Видимость = Ложь;
		
		Элементы.НачальныеПоказания.Видимость                  = Ложь;
		Элементы.КонечныеПоказания.Видимость                   = Ложь;
		Элементы.МестоУстановкиСчетчика.Видимость              = Ложь;
		Элементы.ВвестиРазовые.Видимость                       = Ложь;
		Элементы.Приоритет.Видимость                           = Ложь;
		Элементы.ИспользоватьСтавкуПоСчетчику.Видимость        = Ложь;
		Элементы.ДатаПоверки.Видимость                         = Ложь;
		Элементы.Многотарифный.Видимость                       = Ложь;
		Элементы.СчетчикСЗависимымиУслугами.Видимость          = Ложь;
		Элементы.ИспользоватьПравилоУменьшения.Видимость       = Ложь;
		Элементы.УслугиСпособРасчетаУменьшения.Видимость       = Ложь;
		Элементы.УслугиСпособРаспределенияУменьшения.Видимость = Ложь;
		Элементы.СпособРасчета.Видимость                       = Ложь;
		Элементы.УслугиОсновнаяУслуга.Видимость                = Ложь;
		
		Если НЕ Объект.Счетчик.Пустая() Тогда
			Элементы.Объект.Доступность     = Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный;
		Иначе
			Элементы.Объект.Доступность     = Истина;
		КонецЕсли;
		
		Элементы.ГруппаЛицевыеСчета.Видимость = Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой;
		
		Элементы.УслугиКонечныеПоказания.Видимость  = Объект.Многотарифный;
		Элементы.УслугиНачальныеПоказания.Видимость = Объект.Многотарифный;
		
		Элементы.УслугиСпособРаспределения.Видимость = (Объект.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных
		И Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик);
		
		Элементы.ИспользоватьСтавкуПоСчетчику.Доступность = (НЕ Объект.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам);
		Элементы.ПараметрыСтавок.Видимость                = Объект.ИспользоватьСтавкуПоСчетчику;
		Элементы.ПараметрыСтавок2.Видимость               = Объект.ИспользоватьСтавкуПоСчетчику;
		
	Иначе
		
		Элементы.ДеревоОбъектовУчетаОбновитьЗдания.Видимость = Ложь;
		Элементы.ДеревоОбъектовУчетаДобавитьЗдание.Видимость = Истина;
		
		Элементы.ГруппаУслуги.Видимость = Истина;
		Элементы.Декорация1.Видимость   = Истина;
		
		Элементы.Объект.Видимость                        = Истина;
		Элементы.ДатаПоверки.Видимость                   = Истина;
		Элементы.Многотарифный.Видимость                 = Истина;
		Элементы.МестоУстановкиСчетчика.Видимость        = Истина;
		Элементы.Приоритет.Видимость                     = Истина;
		Элементы.ИспользоватьСтавкуПоСчетчику.Видимость  = Истина;
		Попытка
			Элементы.ИспользоватьПравилоУменьшения.Видимость = Истина;
		Исключение
		КонецПопытки;
		Элементы.СчетчикСЗависимымиУслугами.Видимость    = Истина;
		Элементы.СпособРасчета.Видимость                 = Истина;
		Элементы.СчетчикСЗависимымиУслугами.Доступность  = Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой;;
		
		Элементы.Многотарифный.Доступность      = НЕ Объект.СчетчикСЗависимымиУслугами;
		Элементы.УслугиОсновнаяУслуга.Видимость = Объект.СчетчикСЗависимымиУслугами;
		
		Элементы.НачальныеПоказания.Видимость = НЕ Объект.Многотарифный;
		Элементы.КонечныеПоказания.Видимость  = НЕ Объект.Многотарифный;
		
		Элементы.УслугиКонечныеПоказания.Видимость  = Объект.Многотарифный;
		Элементы.УслугиНачальныеПоказания.Видимость = Объект.Многотарифный;
		
		Элементы.УслугиСпособРаспределения.Видимость = Объект.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных;
		
		Элементы.МестоУстановкиСчетчика.Доступность    = Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный;
		
		Если Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный И мКэшЗначений.ПравоИзменения Тогда
			Элементы.ВвестиРазовые.Доступность = Истина;
			Элементы.ВвестиРазовые.Видимость   = Истина;
		Иначе
			Элементы.ВвестиРазовые.Доступность = Ложь;
			Элементы.ВвестиРазовые.Видимость   = Ложь;
		КонецЕсли;
		
		Если НЕ Объект.Счетчик.Пустая() Тогда
			Элементы.Объект.Доступность     = Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный;
		Иначе
			Элементы.Объект.Доступность     = Истина;
		КонецЕсли; 
		
		Элементы.СпособРасчета.Доступность = (Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой И НЕ Объект.СчетчикСЗависимымиУслугами);
		
		Элементы.ГруппаЛицевыеСчета.Видимость = Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой;
		
		Элементы.Приоритет.Доступность        = Объект.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных;
		
		Элементы.ИспользоватьСтавкуПоСчетчику.Доступность = (НЕ Объект.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам);
		Элементы.ПараметрыСтавок.Видимость                = Объект.ИспользоватьСтавкуПоСчетчику;
		Элементы.ПараметрыСтавок2.Видимость               = Объект.ИспользоватьСтавкуПоСчетчику;
		
		// БИТ_ЖКХ 08.12.2014{{
		// Элементы.ИспользоватьПравилоУменьшения.Доступность     = (Объект.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных И НЕ Объект.СчетчикСЗависимымиУслугами);.
		Элементы.ИспользоватьПравилоУменьшения.Доступность     = (Объект.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных ИЛИ Объект.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам) И НЕ Объект.СчетчикСЗависимымиУслугами;
		// БИТ_ЖКХ 08.12.2014}}
		
		Элементы.УслугиСпособРасчетаУменьшения.Видимость       = Объект.ИспользоватьПравилоУменьшения;
		Элементы.УслугиСпособРаспределенияУменьшения.Видимость = Объект.ИспользоватьПравилоУменьшения;
		
	КонецЕсли; 
	
	Проведен = Объект.Проведен;
	
	Элементы.Организация.ТолькоПросмотр                = Проведен;
	Элементы.НачальныеПоказания.ТолькоПросмотр         = Проведен;
	Элементы.КонечныеПоказания.ТолькоПросмотр          = Проведен;
	Элементы.Многотарифный.ТолькоПросмотр              = Проведен;
	Элементы.Услуги.ТолькоПросмотр                     = Проведен;
	Элементы.ЛицевыеСчета.ТолькоПросмотр               = Проведен;
	Элементы.ДатаПоверки.ТолькоПросмотр                = Проведен;
	Элементы.Объект.ТолькоПросмотр                     = Проведен;
	Элементы.Счетчик.ТолькоПросмотр                    = Проведен;
	Элементы.ВидОперации.ТолькоПросмотр                = Проведен;
	Элементы.Дата.ТолькоПросмотр                       = Проведен;
	Элементы.СпособРасчета.ТолькоПросмотр              = Проведен;
	Элементы.Ответственный.ТолькоПросмотр              = Проведен;
	Элементы.Комментарий.ТолькоПросмотр                = Проведен;
	Элементы.ДеревоОбъектовУчета.ТолькоПросмотр        = Проведен;
	Элементы.МестоУстановкиСчетчика.ТолькоПросмотр     = Проведен;
	Элементы.Приоритет.ТолькоПросмотр                  = Проведен;
	Элементы.СчетчикСЗависимымиУслугами.ТолькоПросмотр = Проведен;
	
	Элементы.ИспользоватьСтавкуПоСчетчику.ТолькоПросмотр = Проведен;
	Элементы.ПараметрыСтавок.ТолькоПросмотр              = Проведен;
	Элементы.ПараметрыСтавок2.ТолькоПросмотр             = Проведен;
	
	Элементы.ДеревоОбъектовУчетаДобавитьЗдание.Доступность = НЕ Проведен;
	Элементы.ЗаполнитьДерево.Доступность                   = НЕ Проведен;
	
	Элементы.ИспользоватьПравилоУменьшения.ТолькоПросмотр = Проведен;
	
	Если НЕ Проведен Тогда
		
		// СнятиеСчетчика = Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика ИЛИ Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчикаСДомов;.
		СнятиеСчетчика = Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика;
		
		Элементы.НачальныеПоказания.ТолькоПросмотр         = СнятиеСчетчика;
		Элементы.КонечныеПоказания.ТолькоПросмотр          = СнятиеСчетчика;
		Элементы.Многотарифный.ТолькоПросмотр              = СнятиеСчетчика;
		Элементы.Услуги.ТолькоПросмотр                     = СнятиеСчетчика;
		Элементы.ЛицевыеСчета.ТолькоПросмотр               = СнятиеСчетчика;
		Элементы.ДатаПоверки.ТолькоПросмотр                = СнятиеСчетчика;
		Элементы.ДеревоОбъектовУчета.ТолькоПросмотр        = СнятиеСчетчика;
		Элементы.МестоУстановкиСчетчика.ТолькоПросмотр     = СнятиеСчетчика;
		Элементы.Приоритет.ТолькоПросмотр                  = СнятиеСчетчика;
		Элементы.СчетчикСЗависимымиУслугами.ТолькоПросмотр = СнятиеСчетчика;
		
		Элементы.ИспользоватьСтавкуПоСчетчику.ТолькоПросмотр = СнятиеСчетчика;
		Элементы.ПараметрыСтавок.ТолькоПросмотр              = СнятиеСчетчика;
		Элементы.ПараметрыСтавок2.ТолькоПросмотр             = СнятиеСчетчика;
		
		Элементы.ДеревоОбъектовУчетаДобавитьЗдание.Доступность = НЕ СнятиеСчетчика;
		Элементы.ЗаполнитьДерево.Доступность                   = НЕ СнятиеСчетчика;
		
		Элементы.ИспользоватьПравилоУменьшения.ТолькоПросмотр = СнятиеСчетчика;
		
	КонецЕсли; 
	
	СпособыПоГрупповым();
	
КонецПроцедуры // УправлениеЭлементамиФормы()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Проверка доступа к реквизитам докумиента.
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(Объект.Ссылка, Отказ);
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	Если Параметры.Свойство("ЗаполнитьИзСправочникаЛицевыеСчета") Тогда
		
		Объект.ВидОперации = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ВидОперации;
		Объект.Дата        = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Дата;
		
		Если Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Свойство("Объект") Тогда
			Объект.Объект = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Объект;
		КонецЕсли;
		
		Если Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Свойство("Организация") Тогда
			Объект.Организация = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Организация;
		КонецЕсли;
		
		Если Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Свойство("Счетчик") Тогда
			Объект.Счетчик = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Счетчик;
		КонецЕсли;
		
		// Заполним документ если он вызван из другой формы.
	ИначеЕсли Параметры.Свойство("ЗаполнитьИзСправочника") Тогда
		
		Объект.ВидОперации = Параметры.ЗаполнитьИзСправочника.ВидОперации;
		Объект.Дата        = Параметры.ЗаполнитьИзСправочника.Дата;
		
		Если Параметры.ЗаполнитьИзСправочника.Свойство("Объект") Тогда
			Объект.Объект = Параметры.ЗаполнитьИзСправочника.Объект;
		КонецЕсли;
		
		Если Параметры.ЗаполнитьИзСправочника.Свойство("ТекущийЭлемент") Тогда
			ТекущийЭлемент = Элементы[Параметры.ЗаполнитьИзСправочника.ТекущийЭлемент];
		КонецЕсли;
		
		Если Параметры.ЗаполнитьИзСправочника.Свойство("Счетчик") Тогда
			Объект.Счетчик = Параметры.ЗаполнитьИзСправочника.Счетчик;
		КонецЕсли;
		
	ИначеЕсли Параметры.Свойство("ЗаполнитьИзОбработкиПоверки") Тогда
		
		Объект.ВидОперации = Параметры.ЗаполнитьИзОбработкиПоверки.ВидОперации;
		Объект.Объект      = Параметры.ЗаполнитьИзОбработкиПоверки.Объект;
		Объект.Дата        = Параметры.ЗаполнитьИзОбработкиПоверки.Дата;
		Объект.Счетчик     = Параметры.ЗаполнитьИзОбработкиПоверки.Счетчик;
		
	ИначеЕсли Параметры.Ключ.Пустая() Тогда
		Объект.Объект = ПредопределенноеЗначение("Справочник.бит_ЛицевыеСчета.ПустаяСсылка");
	КонецЕсли;
	
	// Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчикаСДомов.
	//	ИЛИ Объект.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчикаНаДома Тогда.
	Если Объект.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
		
		ОбновитьДерево();
		
	КонецЕсли; 
	
	// Установить видимость реквизитов и заголовков колонок.	
	УправлениеЭлементамиФормы();
	ОбновитьКэшПоСчетчику();
	
	Если НЕ Объект.Объект = Неопределено И Не Объект.Объект.Пустая() Тогда
		
		ЗаполнитьКэшРеквизитовЛицевогоСчета(Объект.Объект, мКэшЗначений);
		
	КонецЕсли;
	
	Если НЕ Объект.Счетчик.Пустая() Тогда
		
		ЗаполнитьКэшРеквизитовСчетчика(Объект.Счетчик, мКэшЗначений);
		
	КонецЕсли; 
	
КонецПроцедуры // ПриСозданииНаСервере()

// Процедура - обработчик события "ПриОткрытии" формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	ЭтоНовый = ?(Параметры.Ключ.Пустая(), Истина, Ложь);

	Если ЭтоНовый тогда
		Ответственный = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");	
		Элементы.ВвестиРазовые.Заголовок = "Ввести разовые начисления по тарифу";
	Иначе
		
		ДокументРазовые = ПолучитьДокументРазовые();
		
		Если НЕ ДокументРазовые = Неопределено Тогда
			
			// БИТ_ЖКХ 28.05.2014
			ДокументРазовыеНомер = ПолучитьНомерНаСервере(ДокументРазовые);
			ДокументРазовыеДата = ПолучитьДатуНаСервере(ДокументРазовые);
			
			// Элементы.ВвестиРазовые.Заголовок = "Разовые № " + Строка(ДокументРазовые.Номер) + " от:" + Строка(ДокументРазовые.Дата);.
			Элементы.ВвестиРазовые.Заголовок = "Разовые № " + Строка(ДокументРазовыеНомер) + " от:" + Строка(ДокументРазовыеДата);
			// БИТ_ЖКХ 28.05.2014
			
		Иначе
			Элементы.ВвестиРазовые.Заголовок = "Ввести разовые начисления по тарифу";
		КонецЕсли;
		
	КонецЕсли;
	
	// Вывести в заголовке формы вид операции и статус документа (новый, не проведен, проведен).
	УстановитьЗаголовокФормыДокумента();
	
	// Зададим имена реквизитов, подлежащих кешированию.
	мКэшРеквизитовФормы = Новый Структура;
	
	// БИТ_ЖКХ 08.12.2014{{
	СпособыПоГрупповым();
	// БИТ_ЖКХ 08.12.2014}}
	
	// БИТ_ЖКХ 10.12.2014{{
	ИнтерфейсТакси = ТекущийВариантИнтерфейсаКлиентскогоПриложения() = ВариантИнтерфейсаКлиентскогоПриложения.Такси;
	
	Если НЕ ИнтерфейсТакси Тогда
		
		Элементы.Страницы.Высота = 0;
		Элементы.Страницы.РастягиватьПоВертикали = Истина; 
		
		Элементы.Услуги.Высота = 0;
		Элементы.Услуги.РастягиватьПоВертикали = Истина; 
		
	КонецЕсли;	
	// БИТ_ЖКХ 10.12.2014}}	
	
	Если мКэшЗначений.ЗаполнитьИзОбработкиПоверки = Истина Тогда
		
		Объект.Услуги.Очистить();
		Объект.ЛицевыеСчета.Очистить();
		Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
		Корень.Очистить();
		
		Объект.НачальныеПоказания = 0;
		Объект.КонечныеПоказания  = 0;
		Объект.Приоритет          = 0;
		Объект.СпособРасчета      = Неопределено;
		
		ПриИзмененииСчетчикаНаСервере();
		
		СпособыПоГрупповым();
		
	КонецЕсли;
	
КонецПроцедуры // ПриОткрытии()

