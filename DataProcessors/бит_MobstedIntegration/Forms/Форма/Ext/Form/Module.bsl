Функция ПолучитьКартинкуШтрихкода(ВнешняяКомпонента, ПараметрыШтрихкода) Экспорт
	
	// Зададим размер картинки.
	мВнешняяКомпонента.Ширина = ПараметрыШтрихкода.Ширина;
	мВнешняяКомпонента.Высота = ПараметрыШтрихкода.Высота;
	
	// Разрешим компоненте самой определять тип кода.
	мВнешняяКомпонента.АвтоТип = Ложь;
	мВнешняяКомпонента.ТипКода         = ПараметрыШтрихкода.ТипКода;
	мВнешняяКомпонента.ОтображатьТекст = ПараметрыШтрихкода.ОтображатьТекст;
	Попытка
		мВнешняяКомпонента.РазмерШрифта = ПараметрыШтрихкода.РазмерШрифта;
	Исключение
		
	КонецПопытки;
	
	мВнешняяКомпонента.СодержитКС = СтрДлина(ПараметрыШтрихкода.Штрихкод) = 43;
	
	// Если отображать контрольный символ не нужно.
	мВнешняяКомпонента.ВидимостьКС = Ложь;
	
	// Формируем картинку штрихкода.
	мВнешняяКомпонента.ЗначениеКода = ПараметрыШтрихкода.Штрихкод;
	
	// Если установленная нами ширина меньше минимально допустимой для этого штрихкода.
	Если мВнешняяКомпонента.Ширина < мВнешняяКомпонента.МинимальнаяШиринаКода Тогда
		// Скорректируем ширину.
		мВнешняяКомпонента.Ширина = мВнешняяКомпонента.МинимальнаяШиринаКода + 10;
	КонецЕсли;
	
	// Сформируем картинку.
	ДвоичныеДанныеКартинки = мВнешняяКомпонента.ПолучитьШтрихкод();
	
	// Если картинка сформировалась.
	Если ДвоичныеДанныеКартинки <> Неопределено Тогда
		// Формируем из двоичных данных.
		Возврат Новый Картинка(ДвоичныеДанныеКартинки);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура ВывестиЗамечания(ТабличныйДокумент, Знач ЛицевойСчет)
	
	ЗапросЗамечание = Новый Запрос;
	ЗапросЗамечание.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗамечанияПоЛС.ЛицевойСчет,
	|	бит_ЗамечанияПоЛС.Наименование,
	|	бит_ЗамечанияПоЛС.ТекстЗамечания,
	|	бит_ЗамечанияПоЛС.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.бит_ЗамечанияПоЛС КАК бит_ЗамечанияПоЛС
	|ГДЕ
	|	бит_ЗамечанияПоЛС.ЛицевойСчет = &ЛицевойСчет
	|	И бит_ЗамечанияПоЛС.Исполнено = ЛОЖЬ
	|	И бит_ЗамечанияПоЛС.ВыводитьНаПечать = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";
	ЗапросЗамечание.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	РезультатЗапроса = ЗапросЗамечание.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ШапкаЗамечания         = мМакет.ПолучитьОбласть("ШапкаЗамечания");
		ОбластьСтрокаОбращение = мМакет.ПолучитьОбласть("СтрокаОбращение");
		
		ТабличныйДокумент.Вывести(ШапкаЗамечания);
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ЗаполнитьПараметр(ОбластьСтрокаОбращение, "ОбращениеСтрока", Выборка.Номер + ".  " + Выборка.ТекстЗамечания);
			ТабличныйДокумент.Вывести(ОбластьСтрокаОбращение);
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

