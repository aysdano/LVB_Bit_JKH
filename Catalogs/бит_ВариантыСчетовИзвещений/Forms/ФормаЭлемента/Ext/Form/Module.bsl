&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОбновитьДеревоПолей()
	
	ОбработкаОбъект     = Обработки.бит_ПечатьСчетИзвещений.Создать();
	
	СтруктураДанных     = ОбработкаОбъект.ПолучитьСтруктуруДанных();
	ТаблицаПечати       = ОбработкаОбъект.ПолучитьТаблицуПечати();
	ТаблицаСчетчиков    = ОбработкаОбъект.ПолучитьТаблицуПечатиСчетчиков();
	ТаблицаПерерасчетов = ОбработкаОбъект.ПолучитьТаблицуПерерасчетов();
	
	// БИТ_ЖКХ 26.09.2014
	ТаблицаСвойств = Новый ТаблицаЗначений;
	ТаблицаСвойств.Колонки.Добавить("Свойство"     , Новый ОписаниеТипов("СправочникСсылка.ЗначенияСвойствОбъектов"));
	
	// ТаблицаСвойств.Колонки.Добавить("Свойство",Тип("СправочникСсылка.ЗначенияСвойствОбъектов"));.
	ТаблицаСвойств.Колонки.Добавить("Значение",Неопределено);
	// ТаблицаПерерасчетов.Колонки.Добавить("Комментарий", ОбщегоНазначения.ОписаниеТипаСтрока(999));.
	// БИТ_ЖКХ 26.09.2014
	
	ТаблицаОбщедомовыхСчетчиков    = ОбработкаОбъект.ПолучитьТаблицуОбщедомовыхСчетчиков();
	
	Корень = ДоступныеПоля.ПолучитьЭлементы();
	Корень.Очистить();
	
	ПолеДанных = Корень.Добавить();
	ПолеДанных.Поле = "Реквизиты";
	ПоляСтруктурыДанных = ПолеДанных.ПолучитьЭлементы();
	
	СтруктураДанных = СортировкаСтруктуры (СтруктураДанных);
	Для каждого КлючЗначение Из СтруктураДанных Цикл
		
		НовоеПоле      = ПоляСтруктурыДанных.Добавить();
		НовоеПоле.Поле = КлючЗначение.Ключ;
		
	КонецЦикла;
	
	ПолеТаблицыПечати = Корень.Добавить();
	ПолеТаблицыПечати.Поле = "Строка: Таблица начислений";
	ПоляТаблицыПечати      = ПолеТаблицыПечати.ПолучитьЭлементы();
	
	Для каждого Колонка Из ТаблицаПечати.Колонки Цикл
		
		НовоеПоле      = ПоляТаблицыПечати.Добавить();
		НовоеПоле.Поле = Колонка.Имя;
		
	КонецЦикла;
	
	ПолеТаблицыСчетчиков = Корень.Добавить();
	ПолеТаблицыСчетчиков.Поле = "Строка: Таблица счетчиков";
	ПоляТаблицыСчетчиков  = ПолеТаблицыСчетчиков.ПолучитьЭлементы();
	
	Для каждого Колонка Из ТаблицаСчетчиков.Колонки Цикл
		
		НовоеПоле      = ПоляТаблицыСчетчиков.Добавить();
		НовоеПоле.Поле = Колонка.Имя;
		
	КонецЦикла;
	
	ПолеТаблицыПерерасчетов = Корень.Добавить();
	ПолеТаблицыПерерасчетов.Поле = "Строка: Таблица перерасчетов";
	ПоляТаблицыПерерасчетов  = ПолеТаблицыПерерасчетов.ПолучитьЭлементы();
	
	Для каждого Колонка Из ТаблицаПерерасчетов.Колонки Цикл
		
		НовоеПоле      = ПоляТаблицыПерерасчетов.Добавить();
		НовоеПоле.Поле = Колонка.Имя;
		
	КонецЦикла;
	
	// БИТ_ЖКХ 26.09.2014
	ПолеТаблицыСвойств = Корень.Добавить();
	ПолеТаблицыСвойств.Поле = "Строка: Таблица дополнительных свойств ЛС";
	ПолеТаблицыСвойств  = ПолеТаблицыСвойств.ПолучитьЭлементы();
	
	Для каждого Колонка Из ТаблицаСвойств.Колонки Цикл
		
		НовоеПоле      = ПолеТаблицыСвойств.Добавить();
		НовоеПоле.Поле = Колонка.Имя;
		
	КонецЦикла;
	// БИТ_ЖКХ 26.09.2014
	
	// БИТ_ЖКХ 03.02.2015{{
	ПолеТаблицыОбщедомовыхСчетчиков = Корень.Добавить();
	ПолеТаблицыОбщедомовыхСчетчиков.Поле = "Строка: Таблица общедомовых счетчиков";
	ПолеТаблицыОбщедомовыхСчетчиков  = ПолеТаблицыОбщедомовыхСчетчиков.ПолучитьЭлементы();
	
	Для каждого Колонка Из ТаблицаОбщедомовыхСчетчиков.Колонки Цикл
		
		НовоеПоле      = ПолеТаблицыОбщедомовыхСчетчиков.Добавить();
		НовоеПоле.Поле = Колонка.Имя;
		
	КонецЦикла;
	// БИТ_ЖКХ 03.02.2015}}
	
КонецПроцедуры // ()

