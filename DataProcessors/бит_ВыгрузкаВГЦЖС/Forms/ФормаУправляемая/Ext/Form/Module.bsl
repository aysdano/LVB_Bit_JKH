							ИначеЕсли ВыборкаУслуг.СпособРасчетаПоСчетчикам = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам
								ИЛИ ВыборкаУслуг.СпособРасчетаПоСчетчикам = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных Тогда
								
								КодУслуги               = СокрЛП(Строка(ВыборкаУслуг.КодУслуги_ДПУ));
								
								ПорядокРасчетаУслуги = Прав(МногоНулей + "1",1);
								
								ФактОбъем   = ВыборкаУслуг.КоличествоЕдиницПоЛС;
								ОбъемЛьготы = ВыборкаУслуг.НормаЛьготы;
								
								Если НЕ ФактОбъем = 0 Тогда
									
									Площадь = Окр((ФактПлощадь * ОбъемЛьготы) / ФактОбъем, 2);
									
									ПлощадьЛьготы = Площадь;
									
								КонецЕсли; 
								
							КонецЕсли;
							
						ИначеЕсли (ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади
							ИЛИ ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади
							ИЛИ ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади)
							И ВыборкаУслуг.ТипыНачислений = Перечисления.бит_ТипыНачисленийПоЖКХ.Коммунальная Тогда
							
							ОбъемЛьготы = Окр(НормаЛьготы * ВыборкаУслуг.Норматив, 6);
							ФактОбъем   = Окр(ФактПлощадь * ВыборкаУслуг.Норматив, 6);
							
							//ОбъемНаКотПроизвРасчет = СокрЛП(СтрЗаменить(Строка(Формат(ОбъемЛьготы, "ЧДЦ=6; ЧРД=,; ЧГ=0")),",",""));
							//ФактичОбъемРасхода     = СокрЛП(СтрЗаменить(Строка(Формат(ФактОбъем  , "ЧДЦ=6; ЧРД=,; ЧГ=0")),",",""));
							ОбъемНаКотПроизвРасчет = ОбъемЛьготы;
							ФактичОбъемРасхода     = ФактОбъем;

							
						КонецЕсли; 
						
					Исключение               
						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(""+ ОписаниеОшибки());
						возврат неопределено;			
					КонецПопытки;
					
					объектУслуга.ServiceID = КодУслуги;//ВыборкаУслуг.КодУслуги;
					
					Если ВыборкаУслуг.ИспользоватьТариф Тогда

						объектУслуга.Tariff = ВыборкаУслуг.Тариф;//Прав(МногоНулей + СокрЛП(СтрЗаменить(Формат(Окр(ВыборкаУслуг.Тариф, 2), "ЧДЦ=2; ЧРД=,; ЧГ=0"),",","")),6);
							
					Иначе

						объектУслуга.Tariff = ВыборкаУслуг.ОсновнаяСтавка;//Прав(МногоНулей + СокрЛП(СтрЗаменить(Формат(Окр(ВыборкаУслуг.ОсновнаяСтавка, 2), "ЧДЦ=2; ЧРД=,; ЧГ=0"),",","")),6);
							
					КонецЕсли; 
					
					попытка
					 объектУслуга.ConsumerQty = КолПользующихсяЛьготой;//ВыборкаУслуг.КолИмеющихПравоНаЛьготу; 
					 объектУслуга.Quant = ОбъемНаКотПроизвРасчет;
					 объектУслуга.BnfSquare = ПлощадьЛьготы;
					 объектУслуга.Summa = РазмерЛьготнойСкидки;//Число(Формат(ВыборкаУслуг.СуммаСемейной +  ВыборкаУслуг.Сумма, "ЧЦ=10; ЧДЦ=2; ЧГ=0"));  
					 объектУслуга.TotalQuant = ФактичОбъемРасхода;//Число(Формат(ВыборкаУслуг.Объем, "ЧЦ=10; ЧДЦ=2; ЧГ=0"));  
					Исключение
						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(""+ ОписаниеОшибки());
						возврат неопределено;
					КонецПопытки;
 

					КонтрольнаяСумма1 = ПодсчитатьКонтрольнуюСумму1 (ВыборкаУслуг.КодУслуги, КонтрольнаяСумма1, объектУслуга.Summa); 
					КонтрольнаяСумма2 = ПодсчитатьКонтрольнуюСумму2 (ВыборкаУслуг.КодУслуги, КонтрольнаяСумма2, объектУслуга.Summa);
					КонтрольнаяСумма3 = ПодсчитатьКонтрольнуюСумму3 (ВыборкаУслуг.КодУслуги, КонтрольнаяСумма3, объектУслуга.Summa);
					КонтрольнаяСумма4 = ПодсчитатьКонтрольнуюСумму4 (ВыборкаУслуг.КодУслуги, КонтрольнаяСумма4, объектУслуга.Summa);
										
					ЗаписьТипа3 = ЗаписьТипа3 + ТипЗаписи3 + МесяцЗаКоторыйПредоствленаЛьгота + КодУслуги + ЦенаСтавкаТарифНаУслугу + КолПользующихсяЛьготой
					+ ОбъемНаКотПроизвРасчет + ПлощадьЛьготы + РазмерЛьготнойСкидки + ФактичОбъемРасхода + ПорядокРасчетаУслуги;
					
					Текст.ДобавитьСтроку(ЗаписьТипа3);
					
					ОбщееКолЗаписейТипа3 = ОбщееКолЗаписейТипа3 + 1;
					
					ИтогСуммы = ИтогСуммы + Окр((ВыборкаУслуг.Начислено),2);
					объектКатегория.Services.Service.Добавить(объектУслуга);

		    	КонецЦикла; 
				объектЛьготник.Categories.Category.Добавить(объектКатегория);
			КонецЦикла; 
			
			объектОтчета.Beneficiaries.Beneficiary.Добавить(объектЛьготник);

		КонецЦикла; 
		
	КонецЦикла;          	
	
	КонтрольнаяЦифра1 = Прав(МногоНулей + Формат(ОбщееКолЗаписейТипа1, "ЧГ=0"),8);
	КонтрольнаяЦифра2 = Прав(МногоНулей + Формат(ОбщееКолЗаписейТипа2, "ЧГ=0"),8);
	КонтрольнаяЦифра3 = Прав(МногоНулей + Формат(ОбщееКолЗаписейТипа3, "ЧГ=0"),8);
	КонтрольнаяЦифра4 = Прав(МногоНулей + СтрЗаменить(Формат(ИтогСуммы, "ЧДЦ=2; ЧРД=,; ЧГ=0"),",",""),12);
	
	ЗаписьТип4 = ЗаписьТип4 + ТипЗаписи4 + НомерДоговора + КонтрольнаяЦифра1 + КонтрольнаяЦифра2 + КонтрольнаяЦифра3+ КонтрольнаяЦифра4;
	
	объектОтчета.Check1 = КонтрольнаяСумма1; 
	объектОтчета.Check2 = КонтрольнаяСумма2; 
	объектОтчета.Check3 = КонтрольнаяСумма3; 
	объектОтчета.Check4 = КонтрольнаяСумма4; 
	
	Текст.ДобавитьСтроку(ЗаписьТип4);
	
	если объект.ТипОтчета = "Отчет" тогда
	  числоТип = 0;
	иначе  
	  числоТип = 1;
    конецесли;
	
	Путь = КаталогВременныхФайлов();
    ИмяФайла = строка(Путь) + строка("\bnf_") + строка (числоТип) + "_" + строка(объект.НомерДоговора) + "_" + Формат(объект.Период,"ДФ=""ггггММ""") + ".xml"; 
    Запись = Новый ЗаписьXML;
    Запись.ОткрытьФайл(ИмяФайла);
  
	ФабрикаXDTO.ЗаписатьXML(Запись, объектОтчета);
	ДанныеXML = Запись.Закрыть();                       
	
	ДвоичныеДанныеXML = Новый ДвоичныеДанные(ИмяФайла);
    АдресВременногоХранилища = ПоместитьВоВременноеХранилище(ДвоичныеДанныеXML);
    УдалитьФайлы(ИмяФайла);
	
    Возврат АдресВременногоХранилища;
	
КонецФункции

функция НайтиЛьготниковСредиРодственников(списокСемейнойЛьготы,  Льгота)
	
  // БИт ЖКХ 04.03.2020	
  для каждого стр из списокСемейнойЛьготы цикл	
      
    ПостроительЗапр = Новый ПостроительЗапроса;       
    ПостроительЗапр.ИсточникДанных = Новый ОписаниеИсточникаДанных(списокСемейнойЛьготы);
    т_Отбор = ПостроительЗапр.Отбор.Добавить("Льгота");
    т_Отбор.ВидСравнения = ВидСравнения.Равно;
    т_Отбор.Значение = Льгота;                  
    т_Отбор.Использование = Истина;           
    ПостроительЗапр.Выполнить();              
    ТабРезультат = ПостроительЗапр.Результат.Выгрузить();			  
      
	если ТабРезультат <> неопределено и ТабРезультат.Количество() > 0 тогда	  	   		
	   возврат ТабРезультат.Количество();
	конецесли;	   
 
  конеццикла;

  возврат  0;	  	

