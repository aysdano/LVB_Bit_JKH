&НаСервере
Процедура НайтиСозданныеНаСервере()
	
	строкаПоиска = "%Автоматическое создание в %"; 
	
	запрос = новый Запрос;
	запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	бит_Квартиры.Ссылка КАК Ссылка,
	               |	бит_Квартиры.Комментарий КАК Комментарий,
	               |	бит_Квартиры.Владелец КАК Владелец,
	               |	бит_Квартиры.НомерКвартиры КАК НомерКвартиры,
	               |	бит_Квартиры.Владелец.Улица КАК Улица,
	               |	бит_Квартиры.Владелец.НомерДома КАК НомерДома,
	               |	бит_Квартиры.Владелец.Корпус КАК Корпус,
	               |	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	               |	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	               |	бит_Квартиры.Владелец.Организация КАК Организация
	               |ИЗ
	               |	РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	               |		ПО бит_СведенияОКвартиреСрезПоследних.Квартира = бит_Квартиры.Ссылка
	               |ГДЕ
	               |	бит_Квартиры.Комментарий ПОДОБНО &Комментарий";
	
	запрос.УстановитьПараметр("Комментарий", строкаПоиска);   	
	
    табЗапроса = запрос.Выполнить().Выгрузить();
	
	списокВладельцевКвартир = новый массив;
	для каждого стр из табЗапроса цикл
		
	  датаСоздания = ПолучитьДатуСоздания (стр.Комментарий);	
	  
	  если датаСоздания <> '00010101000000' и ДатаВИнтервале(датаСоздания) тогда
		  
		  списокВладельцевКвартир.Добавить(стр.Владелец);
		  
	  конецесли;	  
		
    конеццикла;

	табЗапроса.Сортировать("Владелец, НомерКвартиры"); 	
	Объект.СписокКвартир.Очистить();
   
    для каждого стр из табЗапроса цикл	   
    
//	 для ном = 1 по объект.КолвоКвартир цикл		   
	  	  
	  новыйКвартира = Объект.СписокКвартир.Добавить();	
	  новыйКвартира.Улица = стр.Улица;
	  новыйКвартира.Дом = стр.НомерДома;
	  новыйКвартира.Корпус = стр.Корпус;
	  новыйКвартира.НомерКвартиры = стр.НомерКвартиры;    		  
	  новыйКвартира.ТипКвартиры = стр.ТипКвартиры;
	  новыйКвартира.СтатусКвартиры = стр.СтатусКвартиры; 		  
	  новыйКвартира.ЛицевойСчет = СформироватьНомерЛС(стр.Ссылка, стр.НомерКвартиры, Объект.ПрефиксЛС, Объект.ПостфиксЛС, Объект.ДлинаЛС);
	  новыйКвартира.СтатусЛС = "Создан";
		  
	  новыйДом = Объект.СписокЗданий.Добавить();	
	  новыйДом.Улица = стр.Улица;
	  новыйДом.Организация = стр.Организация;
	  новыйДом.Дом = стр.НомерДома;
	  новыйДом.Корпус = стр.Корпус;
	  новыйДом.Ссылка = НайтиОбъектЗдания(стр.Улица, новыйДом.Дом);
	  
//	 конеццикла;  	  
    конеццикла;	
	
	табЗданий = Объект.СписокЗданий.Выгрузить();
	табЗданий.Свернуть("Улица, Дом, Корпус, Организация, Ссылка");
	табЗданий.Сортировать("Улица, Дом, Корпус");

	Объект.СписокЗданий.Загрузить(табЗданий);
	
    Объект.СписокКвартир.Сортировать("Улица, Дом, Корпус, НомерКвартиры"); 	  
  	
КонецПроцедуры

Функция ДатаВИнтервале(датаСоздания)

	если датаСоздания >= Объект.НачальнаяДатаСоздания и датаСоздания <= Объект.КонечнаяДатаСоздания тогда
	 возврат истина;
    иначе
	 возврат ложь;
	конецесли;	

КонецФункции // ДатаВИнтервале()

Функция ПолучитьДатуСоздания(строкаДаты)

  позицияСтроки	= СтрДлина("Автоматическое создание в ");
  датаСтрока = Дата(СокрЛП(Сред(строкаДаты, позицияСтроки))); 
  датаСтрока = Формат(датаСтрока, "ДЛФ=Д");
  возврат СтроковыеФункцииКлиентСервер.СтрокаВДату(датаСтрока);  

КонецФункции // ПолучитьДатуСоздания()

