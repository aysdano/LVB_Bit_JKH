
#Область ПрограммныйИнтерфейс


// Разбивает входящую строку "Строка1" на две по ограничению длины "МаксДлинаСтроки1".
// Максимальную длину для областей табличных документов рекомендуется выбрать по
// формулу количество помещающихся букв обычной ширины, умноженное на коэффициент 0,92.
//
// Параметры:                                          
//  МаксДлинаСтроки1 - Максимальная ожидаемая длина первой строки;
//  Строка1          - Строка, требующая разбивки;
//  Строка2          - Вторая строка (заполняется в процедуре после разбивки).
//  

Процедура РазбитьСтроку(МаксДлинаСтроки1, Строка1, Строка2 = "") Экспорт
	
	ДлинаСтроки1 = СтрДлина(Строка1);
	Если ДлинаСтроки1 < МаксДлинаСтроки1 Тогда
		
		Строка2 = "";
		
	Иначе
		// Разбиваем строку на две подстроки, таким образом чтобы первая строка была не более МаксДлинаСтроки1
		// Для этого ищем очередной пробел и проверяем длину строк в предположении, что перенос будет выполнен по найденной позиции.
		ИсходнаяСтрока	= Строка1;
		Строка2			= Строка1;
		ПозицияПоиска	= СтрНайти(Строка2," ")+1;
		
		// Если найден очередной пробел и длина первой строки после операции будет менее 92 символов, то выполняем еще одну итерацию.
		Пока ПозицияПоиска > 1 И ДлинаСтроки1 - СтрДлина(Строка2) + ПозицияПоиска < МаксДлинаСтроки1 Цикл
			
			Строка2			= Сред(Строка2, ПозицияПоиска);
			ПозицияПоиска	= СтрНайти(Строка2," ")+1;
			
		КонецЦикла; 
		
		Строка1 = Лев(ИсходнаяСтрока, ДлинаСтроки1 - СтрДлина(Строка2));
		
	КонецЕсли;	
	
КонецПроцедуры

// Разбирает полное имя объекта.
Функция РазобратьПолноеИмяОбъекта(ИмяОбъектаПолное) Экспорт 

	РезСтр = Новый Структура("ИмяКоллекции,ИмяКласса,ИмяОбъекта","","","");
	
	ПозицияТочки = Найти(ИмяОбъектаПолное,".");
	
	Если ПозицияТочки >0 Тогда
			
		
	  РезСтр.ИмяКласса        = Лев(ИмяОбъектаПолное,ПозицияТочки-1);
	  РезСтр.ИмяОбъекта       = Сред(ИмяОбъектаПолное,ПозицияТочки+1);
	  
	  КлассыКоллекции = СоответствиеИменКлассовКоллекций();
	  ИмяКоллекции = КлассыКоллекции[РезСтр.ИмяКласса];
	  
	  Если ТипЗнч(ИмяКоллекции) = Тип("Строка") Тогда
	  
	  	  РезСтр.ИмяКоллекции = ИмяКоллекции;
	  
	  КонецЕсли; 
	  
	КонецЕсли; 

	Возврат РезСтр;
	
КонецФункции // РазобратьПолноеИмяОбъекта()

// Устанавливает соответствие имен классов объекта.
