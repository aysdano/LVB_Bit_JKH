	        |			ТОГДА ""Не прописан""
	        |		КОГДА НЕ ВТ_ФЛ.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	        |			ТОГДА ""Выписан""
	        |		КОГДА ВТ_ФЛ.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Постоянно)
	        |			ТОГДА ""Постоянно""
	        |		КОГДА ВТ_ФЛ.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Временно)
	        |			ТОГДА ""Временно""
	        |		ИНАЧЕ ""Не прописан""
	        |	КОНЕЦ КАК VID_REG,
	        |	ВЫБОР
	        |		КОГДА ВТ_ФЛ.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	        |			ТОГДА 1
	        |		ИНАЧЕ 0
	        |	КОНЕЦ КАК ВладелецКвартиры,
	        |	ВТ_Собственники.K_SOB КАК K_SOB
	        |ИЗ
	        |	ВТ_ЛС КАК ВТ_ЛС
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ФЛ КАК ВТ_ФЛ
	        |		ПО ВТ_ЛС.Ссылка = ВТ_ФЛ.Ссылка
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Проживающие КАК ВТ_Проживающие
	        |		ПО ВТ_ЛС.Ссылка = ВТ_Проживающие.Ссылка
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПлощадьКвартиры КАК ВТ_ПлощадьКвартиры
	        |		ПО ВТ_ЛС.Ссылка = ВТ_ПлощадьКвартиры.Ссылка
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Собственники КАК ВТ_Собственники
	        |		ПО ВТ_ЛС.Ссылка = ВТ_Собственники.Ссылка";
	
	Возврат Текст;

КонецФункции

Функция АдресПоЛСМассивПодробно(ЛС, Здание)
	
	Результат = Новый Массив;
	
	Улица = "";
	Дом = "";
	Корпус = "";
	Квартира = "";
	
	Если ЗначениеЗаполнено(Здание.Улица.ТипУлицы) Тогда
		Улица = Улица + Строка(Здание.Улица.ТипУлицы)
	КонецЕсли;

	Если ЗначениеЗаполнено(Здание.Улица) Тогда
		Улица = Улица + Строка(Здание.Улица)
	КонецЕсли;
	
	Дом = Дом + "д." + Строка(Здание.НомерДома);
	
	Результат.Добавить(Улица + ", " + Дом);
	
	Если ЗначениеЗаполнено(Здание.ПрефиксДома) Тогда
		Дом = Дом + Здание.ПрефиксДома 	
	КонецЕсли;
	
	Результат.Добавить(Дом);

	Если ЗначениеЗаполнено(Здание.Корпус) Тогда
		Корпус = Корпус + "кор. " + Здание.Корпус 	
	КонецЕсли;
	
	Результат.Добавить(Корпус);
	
	Квартира = ЛС.Квартира.Наименование;
	
	НомерПозиции = СтрНайти(Квартира, "=");
	
	Если НомерПозиции <> 0 Тогда
		НомерКвартиры = Лев(НомерКвартиры, НомерПозиции - 1)
	КонецЕсли;
	
	Результат.Добавить(Квартира);
	
	Возврат Результат;

КонецФункции // АдресПоЛС()


