		ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "УслугаПОЛС");
		УслугаПОЛСXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
		
		УслугаПОЛСXDTO.Идентификатор			= Строка(Выборка.УслугаЖКХ.УникальныйИдентификатор());
		УслугаПОЛСXDTO.Название					= Выборка.Наименование;
		УслугаПОЛСXDTO.ИдентификаторЛС			= ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет), Строка(Выборка.ЛицевойСчет.УникальныйИдентификатор()), "");
		УслугаПОЛСXDTO.НомерЛС					= Выборка.НомерЛС;
		УслугаПОЛСXDTO.ТипУслуги				= Строка(Выборка.ГрафаОтчетаГЦЖС);
		УслугаПОЛСXDTO.ИдентификаторПоставщика	= ?(ЗначениеЗаполнено(Выборка.Поставщик), Строка(Выборка.Поставщик.УникальныйИдентификатор()), "");
		УслугаПОЛСXDTO.НазваниеПоставщика		= ?(ЗначениеЗаполнено(Выборка.НазваниеПоставщика), Выборка.НазваниеПоставщика, "");
		
		СписокУслугПОЛСXDTO.УслугаПОЛС.Добавить(УслугаПОЛСXDTO);
		
	КонецЦикла;
	
	ЗаписатьФайлВыгрузки(СписокУслугПОЛСXDTO, ПараметрыОбмена, "services_on_accounts.xml");
	
КонецПроцедуры

