#Область ПроцедурыОбработчикиСобытийТабличногоПоляДанныеДерева

// Процедура - обработчик события "ПриАктивизацииЯчейки" табличного поля "ДанныеДерева".
//
&НаКлиенте
Процедура ДанныеДереваПриАктивизацииЯчейки(Элемент)
	
	СпособРаспределения = Неопределено;
	
	ТекущиеДанныеДрева   = Элемент.ТекущиеДанные;
	ТекущаяЭлементДерева = Элемент.ТекущийЭлемент;
	
	Если ТекущаяЭлементДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанныеДрева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = ТекущаяЭлементДерева.Имя;
	Если Найти(ИмяКолонки,"РеквизитДерева_") > 0 Тогда
		
		ТекущийПериод = ПолучитьПериодПоИмениКолонки(ИмяКолонки);
		Если Не ЗначениеЗаполнено(ТекущийПериод) Тогда
			
			Возврат;
			
		КонецЕсли; 
		
		СтруктураПараметров = Новый Структура("Период, СтатьяОборотов, ИД");
		СтруктураПараметров.Период         = ТекущийПериод;
		СтруктураПараметров.СтатьяОборотов = ТекущиеДанныеДрева.СтатьяОборотов;
		СтруктураПараметров.ИД             = ТекущиеДанныеДрева.Идентификатор;
		
		Элементы.БДДС.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПараметров);
		
		ТекущиеДанные = Объект.БДДС.НайтиСтроки(СтруктураПараметров);
		
		Если НЕ ТекущиеДанные = неопределено И ТекущиеДанные.Количество() > 0 Тогда
			
			СпособРаспределения = ТекущиеДанные[0].СпособРаспределения;
			
		КонецЕсли;
		
	Иначе
		
		СтруктураПараметров = Новый Структура("СтатьяОборотов");
		СтруктураПараметров.СтатьяОборотов = Неопределено;
		
		Элементы.БДДС.ОтборСтрок = Новый ФиксированнаяСтруктура(СтруктураПараметров);
		
	КонецЕсли; 
	
КонецПроцедуры

