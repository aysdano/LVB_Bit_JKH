
#Область ПроцедурыОбработчикиСобытийФормы

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// БИТ_ЖКХ 09.09.2014
	Если Параметры.Основание <> Неопределено Тогда
		Отказ = Объект.ЗапретитьВвод;	
	КонецЕсли;
	// БИТ_ЖКХ 09.09.2014
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	ЭтоНовый = ?(Параметры.Ключ.Пустая(), Истина, Ложь);
	
	Если ЭтоНовый И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда  
		
		// БИТ_ЖКХ 10.02.2014
		
		// Объект.Организация 		= глЗначениеПеременной("ОсновнаяОрганизация");.	
		// Объект.Ответственный 	= глЗначениеПеременной("глТекущийПользователь");.
		Объект.Организация 		= бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");	
		Объект.Ответственный 	= бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
		// БИТ_ЖКХ 10.02.2014
		
	КонецЕсли;
	
КонецПроцедуры // ПриСозданииНаСервере()

// Процедура - обработчик события "ПриОткрытии" формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Зададим имена реквизитов, подлежащих кешированию.
	мКэшРеквизитовФормы = Новый Структура;
	
	// БИТ_ЖКХ 09.09.2014
	Если ЭтаФорма.ВладелецФормы <> Неопределено Тогда
		
		Попытка
			Если Объект.ДатаРегистрации <> ЭтаФорма.ВладелецФормы.Объект.ДатаРегистрации 
				Или Объект.ДатаСнятияСРегистрации <> ЭтаФорма.ВладелецФормы.Объект.ДатаСнятияСРегистрации
				Или Объект.ЛицевойСчет <> ЭтаФорма.ВладелецФормы.Объект.ЛицевойСчет
				Или Объект.РегистрируемоеЛицо <> ЭтаФорма.ВладелецФормы.Объект.РегистрируемоеЛицо Тогда
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Выдано свидетельство о регистрации с другими данными, необходимо удалить свидетельство и создать новое для изменения данных");
				
				Элементы.Печать.Видимость = Ложь;
				
			КонецЕсли;
			
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	// БИТ_ЖКХ 09.09.2014
	
КонецПроцедуры // ПриОткрытии()

// Процедура - обработчик события "ПослеЗаписи" формы.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// БИТ_ЖКХ 09.09.2014
	Оповестить("ДокументЗаписан");
	// БИТ_ЖКХ 09.09.2014
	
КонецПроцедуры // ПослеЗаписи()

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура Печать(Команда)
	
	Если Модифицированность ИЛИ Параметры.Ключ.Пустая() Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ПечатьЗавершение", ЭтотОбъект), "Данные еще не записаны.
		|Печать возможна только после записи данных.                         
		|Данные будут записаны.", РежимДиалогаВопрос.ДаНет);
		Возврат; 
		
	КонецЕсли; 
	
	// БИТ_ЖКХ_30012014_начало_изменений
	//Результат = Документы.бит_СвидетельствоОРегистрацииПоМестуПребывания.Печать(Параметры.Ключ);
	ПечатьФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ПечатьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса; 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		Записать();
	Иначе
		Возврат;
	КонецЕсли; 
	
	ПечатьФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьФрагмент()
	
	Перем АдресТабличногоДокументаВоВременномХранилище, Результат;
	
	Результат = ПолучитьРезультат(Параметры.Ключ);

	Если Результат.НетОшибок Тогда
		АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат.ТабДокумент, АдресТабличногоДокументаВоВременномХранилище);
		
		бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
		,"бит_СвидетельствоОРегистрацииПоМестуПребывания"
		,"СОРПМЖ"
		,"Ф3:Свидетельство о регистрации по месту пребывания"
		
		,АдресТабличногоДокументаВоВременномХранилище
		
		,Объект.Ссылка);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.СообщениеОбОшибке);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьФрагментДубликат()
	
	Перем АдресТабличногоДокументаВоВременномХранилище, Результат;
	
	Результат = ПолучитьРезультатДубликат(Параметры.Ключ);

	Если Результат.НетОшибок Тогда
		АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат.ТабДокумент, АдресТабличногоДокументаВоВременномХранилище);
		
		бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
		,"бит_СвидетельствоОРегистрацииПоМестуПребывания"
		,"СОРПМЖ_ДУБЛИКАТ"
		,"Ф3:Свидетельство о регистрации по месту пребывания дубликат"
		
		,АдресТабличногоДокументаВоВременномХранилище
		
		,Объект.Ссылка);
		
	Иначе
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Результат.СообщениеОбОшибке);
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

