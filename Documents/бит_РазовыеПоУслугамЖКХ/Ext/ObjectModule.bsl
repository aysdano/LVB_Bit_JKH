		|			ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.СуммаОборот, 0) / ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.КоличествоНосителейОборот, 1) * ВЫБОР
		|				КОГДА &КолвоЧел > ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.КоличествоНосителейОборот, 1)
		|					ТОГДА ЕСТЬNULL(бит_НачислениеПоЛьготамОбороты.КоличествоНосителейОборот, 1)
		|				ИНАЧЕ &КолвоЧел
		|			КОНЕЦ КАК Сумма
		|		ИЗ
		|			РегистрНакопления.бит_НачислениеПоЛьготам.Обороты(
		|					&НачПериода,
		|					&КонПериода,
