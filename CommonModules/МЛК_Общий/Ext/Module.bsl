КонецПроцедуры
Функция ОтправитьДетализациюПервая()
	Если Не ПроверитьЕстьЛиИнтернетСоединение() Тогда 
		Возврат Ложь;
	КонецЕсли;	
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл
		Если Настройки.НеИспользоватьИнтеграцию Тогда Продолжить; КонецЕсли;
		Если Не ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоЛицевымСчетам) И
			Не ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоСчетчикам) Тогда
			Продолжить;
		КонецЕсли;
		Возврат ПроверитьИОтправитьДетализацииНаСервере(Настройки);
	КонецЦикла;
КонецФункции
Функция ПроверитьИОтправитьДетализацииНаСервере(Настройки)
	
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл
		Если Настройки.ПометкаУдаления Или Настройки.НеИспользоватьИнтеграцию Или Не ЗначениеЗаполнено(Настройки.АдресКабинетов) Тогда
			Продолжить;
		КонецЕсли;
		
		ЕстьОтвет = Истина;
		
		АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
		АдресРесурса = "/api/v4/events?ApplicationId="+Настройки.НомерПриложения+"&query=";
		
		СтрокаПараметров = 
		"["
		+"{"
		+"""field"""                +":"+ """StatusId"""+","
		+"""operation"""            +":"+ """="""+","
		+"""value"""                +":"+""""+СтрЗаменить(Строка(Настройки.СтатусОтправленоВУК),Символы.НПП,"")+""""+","
		+"""andor"""                +":"+"""and"""
		+"}"
		+","
		+"{"
		+"""field"""                +":"+ """ActionName"""+","
		+"""operation"""            +":"+ """="""+","
		+"""value"""                +":"+"""Запрос Детализации-1"""+","
		+"""andor"""                +":"+"""and"""
		+"}"
		+"]";
		
		HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Настройки.Токен));
		HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
		Попытка
			Ответ = HTTPСоединение.Получить(HTTPЗапрос);
		Исключение
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Запрос детализации","",,"Нет связи с сервером",ОписаниеОшибки(),ТекущаяДатаСеанса());	
			ЕстьОтвет = Ложь;
		КонецПопытки;
		
		Если ЕстьОтвет Тогда
			Если Ответ.КодСостояния = 200 Тогда
				СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				
				Если Не ПустаяСтрока(СтрокаОтвет) Тогда
					РезультатПроверки = СтрокаОтвет;
					Если СокрЛП(РезультатПроверки)="false" Тогда
					Иначе
						
						
						ЧтениеJSON = Новый ЧтениеJSON;
						ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
						ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
						ЧтениеJSON.Закрыть();
						
						ТЗ = РаспарситьВТаблицуЗапросКвитанции(ЗагруженныеДанные);
						
						ОтправитьДетализацию(ТЗ,Настройки);
						
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Ответ.КодСостояния = 500 Тогда
			ИначеЕсли Ответ.КодСостояния = 404 Тогда
			ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Иначе
			КонецЕсли;
		КонецЕсли;	
		
	КонецЦикла;
КонецФункции
Функция  ТаблицаДетализации(ЛицевойСчет,Настройки)
	
	ЛС  = Справочники.бит_ЛицевыеСчета.НайтиПоКоду(СокрЛП(ЛицевойСчет));
	
	ПериодНачислений = ПолучитьПериодНачисленийПоЛицевомуСчету(ЛС);
	
	Квитанция = Новый ТабличныйДокумент;
	
	Результат = Неопределено;
	
	ОбработкаОбъект = Обработки.бит_ПечатьСчетИзвещений.Создать();
	
	НоваяСтрока = ОбработкаОбъект.СписокЛС.Добавить();
	НоваяСтрока.ЛицевойСчет = ЛС;
	
	ОбработкаОбъект.МакетКв               = Настройки.ШаблонКвитанции;  // ВОТ ТУТ ШАБЛОН КВИТАНЦИИ ЭТО НЕ МАКЕТ А ЭЛЕМЕНТ СПРАВОЧНИКА
	ОбработкаОбъект.Период                = КонецМесяца(ПериодНачислений);
	ОбработкаОбъект.ШаблонИзвещений       = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
	ОбработкаОбъект.Организация           = ЛС.Организация;
	ОбработкаОбъект.РС                    = ЛС.Организация.ОсновнойБанковскийСчет;
	ОбработкаОбъект.ТекущийПакет          = 1;
	ОбработкаОбъект.РазмерПакетаПечати    = 500;
	ОбработкаОбъект.РазмерПакетаПросмотра = 50;
	
	ОбработкаОбъект.ПолучательПлатежа           = ЛС.Организация;
	
	ОбработкаОбъект.ОбновитьНастройкиЖКХ();
	ОбработкаОбъект.ОбновитьКэшОрганизации();
	ОбработкаОбъект.ОбновитьКэшПолучателяПлатежа();
	ОбработкаОбъект.ПолучитьНастройкуМакета();
	
	ТаблицаДанных = ОбработкаОбъект.СформироватьДанныеПечати();
	
	ТаблицаДанныхНачислений = Новый ТаблицаЗначений;
	ТаблицаДанныхНачислений.Колонки.Добавить("Услуга");
	ТаблицаДанныхНачислений.Колонки.Добавить("Начислено");
	ТаблицаДанныхНачислений.Колонки.Добавить("Порядок");
	
	
	Если ТаблицаДанных.количество() <> 0 Тогда
		Для Каждого СтрТабл Из ТаблицаДанных Цикл
			Счетчик=1;
			Если СтрТабл.Значение.ТаблицаПечати.Количество()<>0 Тогда
				ИтогоКОплате = 0;
				Нов = ТаблицаДанныхНачислений.Добавить();
				Нов.Услуга = "Расчетный период";
				Нов.Начислено = формат(ПериодНачислений,"ДФ='ММММ гггг'")+" г.";
				Нов.Порядок = 1;
				
				Запрос = "[";
				Для Каждого СтрУсл Из СтрТабл.Значение.ТаблицаПечати Цикл
					Услуга = Строка(СтрУсл.УслугаПредставление)+" ("+СТрока(СтрУсл.ЕдИзм)+") ";
					
					Запрос = Строка(Запрос) + "{"+""""+"key"+""""+":"+""""+Строка(Услуга)+""""+","+""""+"value"+""""+":"+""""+Строка(СтрУсл.КОплатеЗаМесяц)+""""+"},";
					
					ИтогоКОплате = ИтогоКОплате + СтрУсл.КОплатеЗаМесяц;
				КонецЦикла;
				Запрос = Лев(Запрос,СтрДлина(Запрос)-1);
				Запрос = Запрос + "]";
				Запрос = СтрЗаменить(Запрос,"""","\""");
				Запрос = """"+"info"+""""+":" +""""+Запрос+"""";
				Запрос2 = "[";
				Запрос2 = Запрос2 + "{"+""""+"key"+""""+":"+""""+Строка("Лицевой счет")+""""+","+""""+"value"+""""+":"+""""+Строка(ЛС.Наименование)+""""+"},{"
				+""""+"key"+""""+":"+""""+Строка("Итого к оплате за расчетный период")+""""+","+""""+"value"+""""+":"+""""+Строка(ИтогоКОплате)+""""+"}";
				Запрос2 = Запрос2 + "]";
				Запрос2 = СтрЗаменить(Запрос2,"""","\""");
				Запрос2 = """"+"info1"+""""+":" +""""+Запрос2+"""";
				ИтоговаяСтрока = "{"+Запрос2+","+Запрос+"}";
				Нов = ТаблицаДанныхНачислений.Добавить();
				Нов.Услуга = "Итого к оплате за расчетный период";
				Нов.Начислено = ИтогоКОплате;
				Нов.Порядок = Счетчик+1;
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли;	
	
	// ТаблицаДанныхНачислений = ПолучитьТаблицуДанныхПоСчетчикамЛицевогоСчета(ЛС,"ТаблицаНачислений");
	
	Возврат ИтоговаяСтрока;
	
КонецФункции	
Процедура ОтправитьДетализацию(ТЗ,Настройки)
	
	ТаблицаДляИзмененияСтатуса = Новый ТаблицаЗначений;
	ТаблицаДляИзмененияСтатуса.Колонки.Добавить("ИД_События");
	ИзменитьСтатусы = Ложь;
	КодСтатуса = СтрЗаменить(Строка(Настройки.СтатусЗакрыто),Символы.НПП,""); // Закрыто обращение
	Для Каждого СТр Из ТЗ Цикл
		ЕстьОтвет = Истина;
		ТаблДетализации = ТаблицаДетализации(Стр.ЛС,Настройки);
		
		АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
		АдресРесурса1 = "/api/v4/events/"+СТрока(СТр.ИД_События);
		
		СтрокаПараметров = "";
		Запрос = ТаблДетализации;
		Запрос = КодироватьСтроку(Запрос,СпособКодированияСтроки.КодировкаURL);
		СтрокаПараметров = СтрокаПараметров+"?ApplicationId="+Настройки.НомерПриложения+"&Value="+Запрос;
		
		HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1+СтрокаПараметров);
		HTTPЗапрос.УстановитьТелоИзСтроки("", КодировкаТекста.UTF8);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");   // тут поменялось
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Настройки.Токен));
		HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 300, Новый ЗащищенноеСоединениеOpenSSL);
		Попытка
			Ответ = HTTPСоединение.Записать(HTTPЗапрос);
		Исключение
			ЕстьОтвет = Ложь;
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Отправка детализации","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		КонецПопытки;
		Если ЕстьОтвет Тогда 
			Если Ответ.КодСостояния = 200 Тогда
				СтрокаОтвет1 = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				
				Результат = Перевод(СтрокаОтвет1);
				
				Результат = "Обновление детализации по лицевым счетам. ЛС: "+Строка(СТр.ЛС)+". "+ Результат;
				
				НовСТр = ТаблицаДляИзмененияСтатуса.Добавить();
				НовСтр.ИД_События = Стр.ИД_События;
				
				
				Если Не ПустаяСтрока(Результат) Тогда
					РезультатПроверки1 = Результат;
					Если СокрЛП(РезультатПроверки1)="false" Тогда
					Иначе
						
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Ответ.КодСостояния = 500 Тогда
			ИначеЕсли Ответ.КодСостояния = 404 Тогда
			ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Иначе
				
				Попытка
					СтрокаОтвет1 = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				Исключение
					МЛК_Общий.ЗаписатьДанныеВЖурнал("Отправка детализации","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
				КонецПопытки;	
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаДляИзмененияСтатуса.Количество()<>0 Тогда 
		ИзменитьСтатусыВСобытиях(ТаблицаДляИзмененияСтатуса,Строка(СтрЗаменить(Настройки.СтатусЗакрыто,Символы.НПП,"")),Настройки);
	КонецЕсли;
	
КонецПроцедуры	
