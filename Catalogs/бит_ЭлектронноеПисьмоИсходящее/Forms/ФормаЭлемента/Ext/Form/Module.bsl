&НаКлиенте
Процедура Отправить(Команда)
	
	Если НЕ Объект.СтатусПисьма = ПредопределенноеЗначение("Перечисление.бит_СтатусыИсходящегоЭлектронногоПисьма.Отправлено") Тогда
		
		Если ПроверитьЗаполнениеСписковАдресатов() Тогда
			Возврат;
		КонецЕсли;
		
		Если Объект.ПолучателиПисьма.Количество() = 0 Тогда
			
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			НСтр("ru='Необходимо указать хотя бы одного получателя письма.'"),, "Объект.СписокПолучателейПисьма");
			Возврат;
			
		КонецЕсли;
		
		ОтправитьВыполнить();
		
	КонецЕсли;
	
КонецПроцедуры

