	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецМесяца(Период), Организация, мКэшПараметрыЖКХ);
	
КонецПроцедуры

// Процедура Обновляет кэш организации.
//
// Параметры:
//  Нет.
//
Процедура ОбновитьКэшОрганизации() Экспорт
	
	мКэшОрганизации = Новый Структура;
	мКэшОрганизации.Вставить("Организация", Организация);
	мКэшОрганизации.Вставить("НаименованиеПолное"                , "");
	мКэшОрганизации.Вставить("НаименованиеСокращенное"           , "");
	мКэшОрганизации.Вставить("ВариантНаименованияДляПечатныхФорм", Перечисления.ВариантыНаименованияДляПечатныхФорм.ПустаяСсылка());
	мКэшОрганизации.Вставить("БИК"                               , "");
	мКэшОрганизации.Вставить("ПолучательИНН"                     , "");
	мКэшОрганизации.Вставить("ПолучательКПП"                     , "");
	мКэшОрганизации.Вставить("КоррСчет"                          , "");
	мКэшОрганизации.Вставить("НомерСчета"                        , "");
	мКэшОрганизации.Вставить("ПолучательБанк"                    , "");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Организации.ОсновнойБанковскийСчет,
	|	Организации.НаименованиеПолное,
	|	Организации.НаименованиеСокращенное,
	|	Организации.ВариантНаименованияДляПечатныхФорм,
	|	Организации.ОсновнойБанковскийСчет.Банк.Код КАК БИК,
	|	Организации.ОсновнойБанковскийСчет.Банк.КоррСчет КАК КоррСчет,
	|	Организации.ОсновнойБанковскийСчет.НомерСчета КАК НомерСчета,
	|	Организации.ОсновнойБанковскийСчет.Банк.Наименование КАК ПолучательБанк,
	|	Организации.ИНН КАК ПолучательИНН,
	|	Организации.КПП КАК ПолучательКПП
	|ИЗ
	|	Справочник.Организации КАК Организации
	|ГДЕ
	|	Организации.Ссылка = &Организация";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
