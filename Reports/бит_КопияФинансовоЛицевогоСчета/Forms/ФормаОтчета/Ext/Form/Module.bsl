   
#Область ПроцедурыИФункцииУправленияВнешнимВидомФормы

&НаКлиентеНаСервереБезКонтекста
Процедура ОбновитьТекстЗаголовка(Форма)
	
	Отчет = Форма.Отчет;
	
	ЗаголовокОтчета = "Копия финансово-лицевого счета " + бит_ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(Форма.ВидПериода, Отчет.НачалоПериода, Отчет.КонецПериода);
	
	Если ЗначениеЗаполнено(Отчет.ЛицевойСчет) Тогда
		ЗаголовокОтчета = ЗаголовокОтчета + " по " + Отчет.ЛицевойСчет;
	КонецЕсли;
	
	Форма.Заголовок = ЗаголовокОтчета;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УправлениеФормой(Форма)
	
	Отчет    = Форма.Отчет;
	Элементы = Форма.Элементы;
	
	Если Отчет.ВидОтчета = ПредопределенноеЗначение("Перечисление.бит_ВидыОтчетовФинансовоЛицевогоСчета.Выписка") 
		ИЛИ Отчет.ВидОтчета = ПредопределенноеЗначение("Перечисление.бит_ВидыОтчетовФинансовоЛицевогоСчета.Справка") Тогда
		
		Элементы.ИсторияПроживающих.Доступность = Ложь;
		Элементы.СведенияОЛьготах.Доступность   = Ложь;
		Элементы.СтатусФизЛица.Доступность      = Ложь;
		Элементы.СУчетомПереплаты.Доступность   = Ложь;
		Элементы.ВыводитьВсеУслугиВСправку.Доступность = Истина;
		
		Форма.ВидПериода = ПредопределенноеЗначение("Перечисление.бит_ДоступныеПериодыОтчета.День");
		Элементы.ВидПериода.Доступность   = Ложь;
		
	Иначе
		
		Элементы.ИсторияПроживающих.Доступность = Истина;
		Элементы.СведенияОЛьготах.Доступность   = Истина;
		Элементы.СтатусФизЛица.Доступность      = Истина;
		Элементы.СУчетомПереплаты.Доступность   = Истина;
		Элементы.ВыводитьВсеУслугиВСправку.Доступность = Ложь;
		
		Элементы.ВидПериода.Доступность   = Истина;
		
	КонецЕсли;
	
КонецПроцедуры // () 

#КонецОбласти
   
#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Отчет.НачалоПериода) Тогда
		Отчет.НачалоПериода = НачалоМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.КонецПериода) Тогда
		Отчет.КонецПериода = КонецМесяца(ТекущаяДатаСеанса());
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Отчет.ВидОтчета) Тогда
		Отчет.ВидОтчета = ПредопределенноеЗначение("Перечисление.бит_ВидыОтчетовФинансовоЛицевогоСчета.Полный");
	КонецЕсли;
	
	// БИТ_ЖКХ 23.05.2016 18:16:15 Начало правки...
	ПериодСтандарт.ДатаНачала	 = Отчет.НачалоПериода;
	ПериодСтандарт.ДатаОкончания = Отчет.КонецПериода;
	// БИТ_ЖКХ 23.05.2016 18:16:15 Конец правки.
	
	бит_ВыборПериодаКлиентСервер.ЗаполнитьСписокВыбораВидПериода(
	ПредопределенноеЗначение("Перечисление.бит_ДоступныеПериодыОтчета.День"),
	Элементы.ВидПериода.СписокВыбора, ВидПериода);
	
	// БИТ_ЖКХ_05082013_начало_изменений		
	Параметры.Свойство("ЛицевойСчет", Отчет.ЛицевойСчет);
	// БИТ_ЖКХ_05082013_окончание_изменений
	
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПриСохраненииПользовательскихНастроекНаСервере(Настройки)
	
	бит_ОтчетыВызовСервера.ПриСохраненииПользовательскихНастроекНаСервере(ЭтаФорма, Настройки, Истина);
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеПользовательскихНастроекНаСервере(Настройки)
	
