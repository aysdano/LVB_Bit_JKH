#Область ПрочиеПроцедурыИФункции

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	Документ       = Метаданные.Документы.бит_СвидетельствоОРегистрацииПоМестуПребывания;
	ПравоИзменения = ПравоДоступа("Изменение", Документ);
	
	КэшированныеЗначения = Новый Структура;
	
	// Перечисления.
	// КэшПеречисления = Новый Структура;
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	КэшированныеЗначения.Вставить("ПравоИзменения"      , ПравоИзменения);
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

	   &НаСервере
Функция ПолучитьИнициалы(Строка)
	
	Если НЕ ПустаяСтрока(Строка) Тогда
		
		Если СтрНайти(Строка, ".") Тогда
			Возврат Строка;
		КонецЕсли;
		
		ФИО = СтрРазделить(Строка, " ", Ложь);
		
		Отчество = "";
		Фамилия = "";
		Имя = "";
		
		Если ФИО.Количество() = 3 Тогда
			Фамилия = ФИО[0];
			Имя = ФИО[1];
			Отчество = ФИО[2];
		ИначеЕсли ФИО.Количество() = 2 Тогда
			Фамилия = ФИО[0];
			Имя = ФИО[1];	
		Иначе
			Фамилия = ФИО[0];
		КонецЕсли;
		
		ФамилияИнициалы = Фамилия 
		+?(ЗначениеЗаполнено(Имя), " " + Лев(Имя,1), "") 
		+?(ЗначениеЗаполнено(Отчество),". " + Лев(Отчество,1)+".", ""); 	
		
		Возврат ФамилияИнициалы;
	КонецЕсли;
	Возврат "";
КонецФункции

&НаКлиенте
Процедура РегистрируемоеЛицоНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;

	ОткрытьФорму("Справочник.бит_Проживающие.Форма.ФормаВыбораУправляемая", Новый Структура("ТекущаяСтрока", Объект.РегистрируемоеЛицо), Элемент); 
	
КонецПроцедуры

