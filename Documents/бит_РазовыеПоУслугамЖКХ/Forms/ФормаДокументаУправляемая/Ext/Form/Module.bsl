	СтруктураСчетовЖКХ = бит_ОбщегоНазначения.ПолучитьСчетаРасчетовЖКХ(Объект.Организация,КонецМесяца(Объект.Дата));
	
	ТекДанные = Элементы.СписокУслуг.ТекущиеДанные;
	
	ТекУслуга = ТекДанные.Услуга;
	
	ЗаполнитьСписокУслуг(ТекУслуга, СтруктураСчетовЖКХ);
	
