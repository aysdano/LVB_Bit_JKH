	Элементы.ПравилаНумерацииЖил.СписокВыбора.Очистить();
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Добавить("Квартира","По номеру квартиры",, БиблиотекаКартинок.бит_ОПрограмме);
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Добавить("ПоПорядку","Последовательная нумерация",, БиблиотекаКартинок.бит_Реквизиты);
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Добавить("НомерДомаКвартира","Номер дома + Квартира",, БиблиотекаКартинок.бит_ПодомовойУчет);
	ВыбранныйЭлемент = Неопределено;  
	
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПравилаНумерацииЖилНачалоВыбораЗавершение", ЭтотОбъект), Элементы.ПравилаНумерацииЖил.СписокВыбора, Элементы.ПравилаНумерацииЖил);

КонецПроцедуры

