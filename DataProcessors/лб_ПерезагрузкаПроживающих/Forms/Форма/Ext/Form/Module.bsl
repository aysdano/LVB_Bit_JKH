Процедура ПодключитьУслугуКДомам()
	ЗапросДокиУслуг = новый запрос;
	ЗапросДокиУслуг.УстановитьПараметр("Организация",Объект.Организация);	
	ЗапросДокиУслуг.Текст = "ВЫБРАТЬ
	               |	бит_ПодключениеУслугКЗданиям.Ссылка КАК Документ,
	               |	бит_ПодключениеУслугКЗданиям.Услуга КАК Услуга
	               |ИЗ
	               |	Документ.бит_ПодключениеУслугКЗданиям КАК бит_ПодключениеУслугКЗданиям
	               |ГДЕ
	               |	бит_ПодключениеУслугКЗданиям.Организация = &Организация
	               |	И бит_ПодключениеУслугКЗданиям.Проведен";
	ДокиУслуг = ЗапросДокиУслуг.Выполнить().Выгрузить();
	ДокиУслуг.Индексы.Добавить("Услуга");
	
		
	
	Запрос = новый запрос;	
	Запрос.УстановитьПараметр("Организация",Объект.Организация);	
	Запрос.Текст = 
	  	 "ВЫБРАТЬ
	  	 |	бит_ПодключениеУслугКЗданиямАдреса.Ссылка.Услуга КАК Услуга,
	  	 |	бит_ПодключениеУслугКЗданиямАдреса.Здание КАК Здание,
	  	 |	бит_ПодключениеУслугКЗданиямАдреса.Ссылка КАК Документ
	  	 |ПОМЕСТИТЬ ЕстьУслуги
	  	 |ИЗ
	  	 |	Документ.бит_ПодключениеУслугКЗданиям.Адреса КАК бит_ПодключениеУслугКЗданиямАдреса
	  	 |ГДЕ
	  	 |	бит_ПодключениеУслугКЗданиямАдреса.Ссылка.Проведен = ИСТИНА
	  	 |	И бит_ПодключениеУслугКЗданиямАдреса.Ссылка.Организация = &Организация
	  	 |
	  	 |ИНДЕКСИРОВАТЬ ПО
	  	 |	Услуга,
	  	 |	Здание
	  	 |;
	  	 |
	  	 |////////////////////////////////////////////////////////////////////////////////
	  	 |ВЫБРАТЬ
	  	 |	бит_СписокЗданий.Ссылка КАК Здание,
	  	 |	бит_УслугиЖКХ.Ссылка КАК Услуга,
	  	 |	бит_СписокЗданий.Улица КАК Улица
	  	 |ПОМЕСТИТЬ ВсеЗданияУслуги
	  	 |ИЗ
	  	 |	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ,
	  	 |	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	  	 |
	  	 |ИНДЕКСИРОВАТЬ ПО
	  	 |	Услуга,
	  	 |	Здание
	  	 |;
	  	 |
	  	 |////////////////////////////////////////////////////////////////////////////////
	  	 |ВЫБРАТЬ
	  	 |	ВсеЗданияУслуги.Здание КАК Здание,
	  	 |	ВсеЗданияУслуги.Услуга КАК Услуга,
	  	 |	ВсеЗданияУслуги.Улица КАК Улица
	  	 |ИЗ
	  	 |	ВсеЗданияУслуги КАК ВсеЗданияУслуги
	  	 |		ЛЕВОЕ СОЕДИНЕНИЕ ЕстьУслуги КАК ЕстьУслуги
	  	 |		ПО ВсеЗданияУслуги.Услуга = ЕстьУслуги.Услуга
	  	 |			И ВсеЗданияУслуги.Здание = ЕстьУслуги.Здание
	  	 |ГДЕ
	  	 |	ЕстьУслуги.Документ ЕСТЬ NULL
	  	 |ИТОГИ ПО
	  	 |	Услуга";
		 
	ВыборкаУ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	 
	Пока ВыборкаУ.Следующий() цикл
		СтрокаДок = ДокиУслуг.Найти(ВыборкаУ.Услуга,"Услуга");
		Если СтрокаДок <> неопределено тогда
			ДокОбъект = СтрокаДок.Документ.ПолучитьОбъект();
			ДокОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
		иначе
			ДокОбъект = Документы.бит_ПодключениеУслугКЗданиям.СоздатьДокумент();
			ДокОбъект.Дата = Объект.Дата;
			ДокОбъект.ВидОперации = Перечисления.бит_ВидыОперацийПодключениеУслугКЗданиям.ПодключениеУслуги;
			ДокОбъект.Услуга = ВыборкаУ.Услуга;
			ДокОбъект.Организация = Объект.Организация;
			
		КонецЕсли;	
		Выборка = ВыборкаУ.Выбрать();
		Пока Выборка.Следующий() цикл
			НовСтрока = ДокОбъект.Адреса.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,Выборка);
		КонецЦикла;	
		ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;	
		 
КонецПроцедуры	

