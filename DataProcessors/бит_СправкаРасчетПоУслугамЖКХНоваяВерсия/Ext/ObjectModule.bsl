Функция ПеренестиПереплатуНаПрошлыйПериод(СоответствиеУжеРаспределеноНАОДН,
	СтрокаОплаты, ДолгСодРем, ПереплатаПоСодРем, ЭтоПерваяСтрока, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем, 
	ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодХВ,
	ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодВО, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодЭЭ,  
	ОбластьТаблицаПараметрыОплатаЗаТекущийПериодГВ, ОбластьТаблицаПараметрыОплатаЗаТекущийПериодХВ,
	ОбластьТаблицаПараметрыОплатаЗаТекущийПериодВО, ОбластьТаблицаПараметрыОплатаЗаТекущийПериодЭЭ,
	ГВ = 0, ХВ = 0, ВО = 0, ЭЭ = 0, СуммаОплатыПрошлыйПериод, ОбластьДатаОплаты)
	//перенос суммы сод рем на другие услуги
	СуммаОплатыППСодРем = ?(ДолгСодРем>0,ДолгСодРем,0);     
	Переплата = ПереплатаПоСодРем - ?(ДолгСодРем>0,ДолгСодРем,0);    
	ПереплатаПоСодРем = ПереплатаПоСодРем - ?(ДолгСодРем>0,ДолгСодРем,0);
	СуммаГВ = 0;
	СуммаХВ = 0;
	СуммаВО = 0;
	СуммаЭЭ = 0;
	ДолгОДН = 0;
	//++АнисимоваМВ_07.11.2023_1бит    Добавлена проверка на оплату за ОДН, чтобы не распределялась лишняя сумма на ОДН 
	Если ГВ>0   Тогда 
		ДолгОДН = ГВ ;	
	КонецЕсли;   
	Если ХВ>0   Тогда 
		ДолгОДН = ДолгОДН + ХВ;	
	КонецЕсли;
	Если ВО>0   Тогда 
		ДолгОДН = ДолгОДН + ВО ;	
	КонецЕсли;
	Если ЭЭ>0  Тогда 
		ДолгОДН = ДолгОДН + ЭЭ ;	
	КонецЕсли;
	
	Если ДолгОДН > 0 Тогда
		СуммаГВ = ?(ГВ>0,(ГВ / ДолгОДН * Переплата),0);
		СуммаХВ = ?(ХВ>0,(ХВ / ДолгОДН * Переплата),0);
		СуммаВО = ?(ВО>0,(ВО / ДолгОДН * Переплата),0);
		СуммаЭЭ = ?(ЭЭ>0,(ЭЭ / ДолгОДН * Переплата),0);    
		Если СуммаГВ>ГВ И СуммаГВ<>0  Тогда
			СуммаГВ = ГВ;  
		КонецЕсли;  
		Если СуммаХВ>ХВ  И СуммаХВ<>0  Тогда
			СуммаХВ = ХВ;  
		КонецЕсли;
		Если СуммаВО>ВО И СуммаВО<>0 Тогда
			СуммаВО = ВО;  
		КонецЕсли;
		Если СуммаЭЭ>ЭЭ И СуммаЭЭ<>0 Тогда
			СуммаЭЭ = ЭЭ;  
		КонецЕсли;


		
		ПереплатаПоСодРем = ПереплатаПоСодРем - ОКР(СуммаГВ,2)-ОКР(СуммаХВ,2)- Окр(СуммаВО,2)	-Окр(СуммаЭЭ,2);	

	КонецЕсли;
	
	Если ДолгСодРем < 0   Тогда 
		СуммаОплатыППСодРем = 0;
	КонецЕсли; 
	
	//ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем) + Формат(СуммаОплатыППСодРем, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;		
	ДолгСодРем = ДолгСодРем - СуммаОплатыППСодРем;
	Если СуммаГВ<>0 Тогда	 
		СоответствиеУжеРаспределеноНАОДН.ГВ = СуммаГВ;
		//ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Формат(СуммаГВ, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
		//ОбластьТаблицаПараметрыОплатаЗаТекущийПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаТекущийПериодГВ), "", ОбластьТаблицаПараметрыОплатаЗаТекущийПериодГВ) + Символы.ПС;				
        ГВ= ГВ - СуммаГВ;
	КонецЕсли;
	Если СуммаХВ<>0 Тогда
		СоответствиеУжеРаспределеноНАОДН.ХВ = СуммаХВ;
		//ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодХВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодХВ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодХВ) + Формат(СуммаХВ, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
