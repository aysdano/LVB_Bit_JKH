
#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	НаборЗаписей.Очистить();
	
	Если Параметры.Свойство("Ключ") Тогда
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.Период,
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.ФизЛицо,
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.МестоРаботы,
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.НачалоРаботы,
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.ОкончаниеРаботы,
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.Должность,
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.КурсКласс,
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.ВидыЗанятости,
	    |	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.РодЗанятий
	    |ИЗ
	    |	РегистрСведений.бит_ТрудоваяДеятельностьПроживающих.СрезПоследних(, ФизЛицо = &ФизЛицо) КАК бит_ТрудоваяДеятельностьПроживающихСрезПоследних");
		
		Запрос.УстановитьПараметр("ФизЛицо", Параметры.Ключ.ФизЛицо);
				
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ЗаполнитьЗначенияСвойств(НаборЗаписей.Добавить(), Выборка);
			
		КонецЕсли;

	КонецЕсли;
	
	Если НаборЗаписей.Количество() = 0 Тогда
		
		НаборЗаписей.Добавить();
		
		ЗаписьИзНабора = НаборЗаписей[0];
		
		Если Параметры.Свойство("ЗаполнитьИзСправочникаПроживающие") Тогда
			
			Если Параметры.ЗаполнитьИзСправочникаПроживающие.Свойство("ФизЛицо") Тогда
				
				ЗаписьИзНабора.ФизЛицо = Параметры.ЗаполнитьИзСправочникаПроживающие.ФизЛицо;
				
			КонецЕсли;
			
			Если Параметры.ЗаполнитьИзСправочникаПроживающие.Свойство("Период") Тогда
				
				ЗаписьИзНабора.Период = Параметры.ЗаполнитьИзСправочникаПроживающие.Период;
				
			КонецЕсли;
		
		КонецЕсли;

	КонецЕсли;
	
	ЗаписьИзНабора = НаборЗаписей[0];
	
	Период          = ?(ЗначениеЗаполнено(ЗаписьИзНабора.Период), ЗаписьИзНабора.Период, '19000101');
	
	МестоРаботы     = ЗаписьИзНабора.МестоРаботы;
	НачалоРаботы    = ЗаписьИзНабора.НачалоРаботы;
	ОкончаниеРаботы = ЗаписьИзНабора.ОкончаниеРаботы;
	Должность       = ЗаписьИзНабора.Должность;
	КурсКласс       = ЗаписьИзНабора.КурсКласс;
	ВидыЗанятости   = ЗаписьИзНабора.ВидыЗанятости;
	ФизЛицо         = ЗаписьИзНабора.ФизЛицо;
	РодЗанятий      = ЗаписьИзНабора.РодЗанятий;

КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура История(Команда)
	
	ПараметрыФормы = Новый Структура;
	Отбор          = Новый Структура;
	
	Отбор.Вставить("ФизЛицо", ФизЛицо);
	
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("РегистрСведений.бит_ТрудоваяДеятельностьПроживающих.Форма.ФормаСпискаУправляемая", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ПодтвердитьИзменения(Команда)
	
	ЗаписатьИзменения();
	Закрыть();
	
	Оповестить("ОбновитьФорму", Новый Структура("ИмяЭлемента", "ТрудоваяДеятельность"), ФизЛицо);
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура ЗаписатьИзменения()
	
	ЗаписьИзНабораНабор = ДанныеФормыВЗначение(НаборЗаписей,Тип("РегистрСведенийНаборЗаписей.бит_ТрудоваяДеятельностьПроживающих"));
	
	// БИТ_ЖКХ 28.12.2015 10:52:53 Начало правки... 
	//Если Период <> ПериодПриОткрытии Тогда 
	//	ЗаписьИзНабора = ЗаписьИзНабораНабор.Добавить();
	//	ЗаписьИзНабора.ФизЛицо = ФизЛицо;
	//Иначе
	//	ЗаписьИзНабора = ЗаписьИзНабораНабор[0];
	//КонецЕсли;
	
	ЗаписьИзНабора = ЗаписьИзНабораНабор[0];
	// БИТ_ЖКХ 28.12.2015 10:53:11 Конец правки. 
	
	// Если что-то поменяли тогда запишем 
	Если Период <> ПериодПриОткрытии ИЛИ
		МестоРаботы <> МестоРаботыПриОткрытии ИЛИ
		НачалоРаботы <> НачалоРаботыПриОткрытии ИЛИ
		ОкончаниеРаботы <> ОкончаниеРаботыПриОткрытии ИЛИ
		Должность <> ДолжностьПриОткрытии ИЛИ
		КурсКласс <> КурсКлассПриОткрытии ИЛИ
		ВидыЗанятости <> ВидыЗанятостиПриОткрытии ИЛИ
		РодЗанятий <> РодЗанятийПриОткрытии Тогда  
	
		ЗаписьИзНабора.Период  		   = Период;
		ЗаписьИзНабора.МестоРаботы	   = МестоРаботы;
		ЗаписьИзНабора.НачалоРаботы	   = НачалоРаботы;
		ЗаписьИзНабора.ОкончаниеРаботы = ОкончаниеРаботы;
		ЗаписьИзНабора.Должность 	   = Должность;
		ЗаписьИзНабора.КурсКласс	   = КурсКласс;
		ЗаписьИзНабора.ВидыЗанятости   = ВидыЗанятости;
		ЗаписьИзНабора.РодЗанятий      = РодЗанятий;
		
		Попытка
			// БИТ_ЖКХ 28.12.2015 10:53:30 Начало правки...
			ЗаписьИзНабораНабор.Отбор.Физлицо.Использование	= Истина;
			ЗаписьИзНабораНабор.Отбор.Физлицо.Значение		= ФизЛицо;
			ЗаписьИзНабораНабор.Отбор.Период.Использование	= Истина;
			ЗаписьИзНабораНабор.Отбор.Период.Значение		= Период;
			// БИТ_ЖКХ 28.12.2015 10:53:30 Конец правки.
		    ЗаписьИзНабораНабор.Записать();
		Исключение
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ОписаниеОшибки());
		КонецПопытки;
		
		ЗначениеВДанныеФормы(ЗаписьИзНабораНабор, НаборЗаписей);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти