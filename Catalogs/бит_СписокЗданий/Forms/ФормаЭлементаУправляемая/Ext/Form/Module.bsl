#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура ПриИзмененииПериода()
	
	// Обновляем представление периода на форме.
	СтрокаНачалоПериода = бит_ВыборПериодаКлиентСервер.ПолучитьПредставлениеПериодаОтчета(
	ПредопределенноеЗначение("Перечисление.ДоступныеПериодыОтчета.Месяц"),
	НаДату, 
	КонецМесяца(НаДату));
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	НаДату = РезультатВыбора.КонецПериода;
	
	ПриИзмененииПериода();
	
КонецПроцедуры

// Процедура нажатия кнопки ДобавитьКомнаты на вкладке Квартиры табличной части.
&НаКлиенте
Процедура ДобавитьКомнаты(Команда)
	
	ТекДанные = Элементы.Квартиры.ТекущиеДанные;
	Если НЕ ТекДанные = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Здание"	  , Объект.Ссылка);		
		ПараметрыФормы.Вставить("НаДату"	  , НаДату);
		ПараметрыФормы.Вставить("Организация" , Объект.Организация);
		ПараметрыФормы.Вставить("Квартира"	  , ТекДанные.Ссылка);
		
		ОткрытьФорму("Обработка.бит_ЗаполнениеКвартир.Форма", ПараметрыФормы, ЭтаФорма);
	КонецЕсли;

КонецПроцедуры

// Процедура нажатия кнопки ЗаполнениеКомнат на вкладке Квартиры табличной части.
&НаКлиенте
Процедура ЗаполнениеКомнат(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Здание"	  , Объект.Ссылка);		
	ПараметрыФормы.Вставить("НаДату"	  , НаДату);
	ПараметрыФормы.Вставить("Организация" , Объект.Организация);
	
	ОткрытьФорму("Обработка.бит_ЗаполнениеКвартир.Форма", ПараметрыФормы, ЭтаФорма);

КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
    // СтандартныеПодсистемы.КонтактнаяИнформация
    УправлениеКонтактнойИнформацией.ПриЧтенииНаСервере(ЭтотОбъект, ТекущийОбъект);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
    // СтандартныеПодсистемы.КонтактнаяИнформация
    УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация
КонецПроцедуры

#КонецОбласти