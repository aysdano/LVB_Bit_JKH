&НаСервере
Процедура ДеревоПКОВыборПриИзмененииНаСервере(ДокументОплаты, Родитель)
	
	ДеревоПКОМ = РеквизитФормыВЗначение("ДеревоПКО");
	
	ТекущийУровень = ДеревоПКОМ.Строки.Найти(ДокументОплаты, "ПриходныйКассовыйОредер");
	Если ТекущийУровень = Неопределено Тогда
		
		Для каждого стр из ДеревоПКОМ.Строки Цикл
			
			ТекущийУровень = стр.Строки.Найти(ДокументОплаты, "ПриходныйКассовыйОредер");
			
			Если НЕ ТекущийУровень = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если ТекущийУровень = Неопределено Тогда
		
		Для каждого стр из ДеревоПКОМ.Строки Цикл
			
			ТекущийУровеньРодитель = стр.Строки.Найти(Родитель, "ПриходныйКассовыйОредер");
			
			Если НЕ ТекущийУровеньРодитель = Неопределено Тогда
				ТекущийУровень = ТекущийУровеньРодитель.Строки.Найти(ДокументОплаты, "ПриходныйКассовыйОредер");	
				Прервать;
			КонецЕсли;
			
		КонецЦикла;
		
		Если (НЕ ТекущийУровеньРодитель = Неопределено) И ТекущийУровеньРодитель.Строки.Количество()=1 Тогда
			
			ТекущийУровеньРодитель.Выбор = ТекущийУровень.Выбор;
			ТекущийУровеньРодитель.Строки[0].Выбор = ТекущийУровень.Выбор;
			ТекущийУровень = Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	
	
	
	Если Не ТекущийУровень = Неопределено Тогда
		
		Для каждого Строка Из ТекущийУровень.Строки Цикл
			
			Строка.Выбор = ТекущийУровень.Выбор;
			
			Для каждого Ещестрока Из Строка.Строки Цикл
				
				Ещестрока.Выбор = ТекущийУровень.Выбор;
				
			    // БИТ ЖКХ 12.10.2020
				Для каждого ЕщеОднастрока Из Ещестрока.Строки Цикл
				
				  ЕщеОднастрока.Выбор = ТекущийУровень.Выбор;
				  
				Конеццикла;  
				
			КонецЦикла;		
			            			
		КонецЦикла; 
		
		Если ТекущийУровень.Строки.Количество() = 0 Тогда
			
			ТекущийУровень.Родитель.Выбор = Ложь;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ДеревоПКОМ, "ДеревоПКО");
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция	ЗначениеРеквизитаНаСервере(Ссылка, ИмяРеквизита);
	
	Если ЗначениеЗаполнено(Ссылка)
		И ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, ИмяРеквизита);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

&НаСервереБезКонтекста
Функция	ЗначенияРеквизитовНаСервере(Ссылка, Реквизиты);
	
	Если ЗначениеЗаполнено(Ссылка)
		И ЗначениеЗаполнено(Реквизиты) Тогда
		Возврат ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Ссылка, Реквизиты);
	КонецЕсли;
	
	Возврат Новый Структура;
	
КонецФункции

