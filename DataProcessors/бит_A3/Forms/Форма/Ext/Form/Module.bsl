			ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата);
			
			Для каждого СтрокаВторогоУровня Из ВторойУровень Цикл
				
				Если СтрокаВторогоУровня.ВводПоказаний = Документы.бит_ВводПоказанийПоСчетчикам.ПустаяСсылка() Тогда
					
					Отбор = Новый Структура;
					Отбор.Вставить("ЛицевойСчет",СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга);
					НайденныеСтроки = ТаблицаВводПоказанийСчетчиков.НайтиСтроки(Отбор);
					
					Если НайденныеСтроки.Количество() > 0 Тогда
						
						ДокументВводПоказаний = Документы.бит_ВводПоказанийПоСчетчикам.СоздатьДокумент();
						
						ДокументВводПоказаний.Организация = Объект.Организация;
						ДокументВводПоказаний.Ответственный = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
						
						ДокументВводПоказаний.ВидОперации = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний;
						ДокументВводПоказаний.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный;
						ДокументВводПоказаний.ПоказанияНаселения = Истина;
						ДокументВводПоказаний.Дата = Дата;
						
						ДокументВводПоказаний.Комментарий    = "Документ создан автоматически из обработки ""Система А-3"".";
						ДокументВводПоказаний.Ответственный    = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
						
						ДокументВводПоказаний.ЛицевойСчет = СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга;
						
						Если НЕ ЗначениеЗаполнено(ДокументВводПоказаний.Улица) Тогда
							
							ДокументВводПоказаний.Улица = ПолучитьУлицуЛицевогоСчета(ДокументВводПоказаний.ЛицевойСчет);
							
						КонецЕсли;
						
						Если НЕ ЗначениеЗаполнено(ДокументВводПоказаний.Дом) Тогда
							
							ДокументВводПоказаний.Дом   = ПолучитьЗданиеЛицевогоСчета(ДокументВводПоказаний.ЛицевойСчет);
							
						КонецЕсли;
						
						ДокументВводПоказаний.ПоказанияПоСчетчикам.Очистить();
						
						ДокументВводПоказаний.ЗаполнитьТаблицуПоказаний();
						
						Если ДокументВводПоказаний.ПоказанияПоСчетчикам.Количество() > 0 Тогда
							
							Для Каждого Строка из ДокументВводПоказаний.ПоказанияПоСчетчикам Цикл
								
								Для Каждого СтрокаПоказания из НайденныеСтроки Цикл
									
									Если Строка.Счетчик = СтрокаПоказания.Счетчик и Строка.Услуга = СтрокаПоказания.УслугаСчетчика Тогда
										Строка.ТекущиеПоказания = СтрокаПоказания.ТекущиеПоказания;
										
										Разрядность = Строка.Счетчик.Разрядность;
										
										КонечныеПоказания   = Число(СтрокаПоказания.ТекущиеПоказания);
										
										Если КонечныеПоказания < Строка.ПредыдущиеПоказания Тогда
											Разность = Разрядность - Строка.ПредыдущиеПоказания + 1 + Число(СтрокаПоказания.ТекущиеПоказания);
											Строка.КоличествоЕдиницПоСчетчику = Разность;
											
											Если НЕ Строка.Многотарифный Тогда
												
												СтрокиПоиска = ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(Новый Структура("Счетчик", Строка.Счетчик));
												
												Для каждого СтрокаТаблицы Из СтрокиПоиска Цикл
													
													СтрокаТаблицы.ТекущиеПоказания           = КонечныеПоказания;
													СтрокаТаблицы.КоличествоЕдиницПоСчетчику = Разность;
													
													Сообщение = Новый СообщениеПользователю;
													Сообщение.Текст = "Произошел переход через ноль, так как конечные показания "+ КонечныеПоказания + " меньше предыдущих " + Строка.ПредыдущиеПоказания;
													Сообщение.Сообщить();
													
												КонецЦикла;
												
											Иначе
												
												СтрокиПоиска = ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(Новый Структура("Счетчик, Услуга", Строка.Счетчик, Строка.Услуга));
												
												Для каждого СтрокаТаблицы Из СтрокиПоиска Цикл
													
													СтрокаТаблицы.ТекущиеПоказания           = КонечныеПоказания;
													СтрокаТаблицы.КоличествоЕдиницПоСчетчику = Разность;
													
													Сообщение = Новый СообщениеПользователю;
													Сообщение.Текст = "Произошел переход через ноль, так как конечные показания "+ КонечныеПоказания + " меньше предыдущих " + Строка.ПредыдущиеПоказания;
													Сообщение.Сообщить();
													
												КонецЦикла;
												
											КонецЕсли;										
										Иначе
											Разность = КонечныеПоказания - Строка.ПредыдущиеПоказания;
											Строка.КоличествоЕдиницПоСчетчику = Разность;
										КонецЕсли;
										
										Если НЕ Строка.Многотарифный Тогда
											
											СтрокиПоиска = ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(Новый Структура("Счетчик", Строка.Счетчик));
											
											Для каждого СтрокаТаблицы Из СтрокиПоиска Цикл
												
												СтрокаТаблицы.ТекущиеПоказания           = КонечныеПоказания;
												СтрокаТаблицы.КоличествоЕдиницПоСчетчику = Разность;
												
											КонецЦикла;
											
										Иначе
											
											СтрокиПоиска = ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(Новый Структура("Счетчик, Услуга", Строка.Счетчик, Строка.Услуга));
											
											Для каждого СтрокаТаблицы Из СтрокиПоиска Цикл
												
												СтрокаТаблицы.ТекущиеПоказания           = КонечныеПоказания;
												СтрокаТаблицы.КоличествоЕдиницПоСчетчику = Разность;
												
											КонецЦикла;
											
										КонецЕсли;									
									КонецЕсли;	
									
								КонецЦикла;
								
							КонецЦикла;
								
								БезПоказаний = Новый Структура;
							БезПоказаний.Вставить("ТекущиеПоказания",0);
							
							СтрокиБезПоказаний = ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(БезПоказаний);
							
							Если СтрокиБезПоказаний.Количество() > 0 Тогда
							
								Индекс = ДокументВводПоказаний.ПоказанияПоСчетчикам.Количество() - 1;
								
								Пока Индекс >=0 Цикл
									
									СтрокаТаблицы=ДокументВводПоказаний.ПоказанияПоСчетчикам.Получить(Индекс);
									
									Если СтрокаТаблицы.ТекущиеПоказания = 0 Тогда
										
										ДокументВводПоказаний.ПоказанияПоСчетчикам.удалить(СтрокаТаблицы);	
										
									КонецЕсли;
									Индекс = Индекс - 1;
									
								КонецЦикла;	
								
							КонецЕсли;
							
							ДокументВводПоказаний.Записать(РежимЗаписиДокумента.Проведение);
							
							СтрокаВторогоУровня.ВводПоказаний = ДокументВводПоказаний.Ссылка;
							
						КонецЕсли;	
						
					КонецЕсли;	
					
				КонецЕсли;	
			КонецЦикла;
		КонецЕсли;	
	КонецЦикла;
	
КонецПроцедуры	

