Функция ПолучитьНормуНаПроживающих(Выборка)   
	
	если Выборка.КоличествоПроживающих = 1 тогда
	  возврат Выборка.НаОдного;
    конецесли;  
  
    если Выборка.КоличествоПроживающих = 2 тогда
	  возврат Выборка.НаДвоих;
	конецесли; 
	
    если Выборка.КоличествоПроживающих = 3 тогда
	  возврат Выборка.НаСемью;
    конецесли; 
  
    если Выборка.КоличествоПроживающих = 4 тогда
	  возврат Выборка.НаСемью4;
	конецесли; 
	
    если Выборка.КоличествоПроживающих = 5 тогда
	  возврат Выборка.НаСемью5;
	конецесли; 

	если Выборка.КоличествоПроживающих >= 6 тогда
	  возврат Выборка.НаСемью6;
	конецесли; 

КонецФункции // ПолучитьНормуНаПроживающих(Выборка.КоличествоПроживающих)()


