&НаСервере
Функция ВыбратьЗависимыйЛСНаСервере(ВыбранноеЗначение)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", ВыбранноеЗначение);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗависимыеЛС.ЛицевойСчет
	|ИЗ
	|	РегистрСведений.бит_ЗависимыеЛС КАК бит_ЗависимыеЛС
	|ГДЕ
	|	бит_ЗависимыеЛС.ЛицевойСчетЗависимый = &ЛицевойСчет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Выбраный лицевой счет является зависимым у ЛС: " + Выборка.ЛицевойСчет + " и не может быть зависимым.");
		
		СтандартнаяОбработка = Ложь;
		Возврат Истина;
		
	КонецЕсли;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗависимыеЛС.ЛицевойСчет
	|ИЗ
	|	РегистрСведений.бит_ЗависимыеЛС КАК бит_ЗависимыеЛС
	|ГДЕ
	|	бит_ЗависимыеЛС.ЛицевойСчет = &ЛицевойСчет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Выбраный лицевой счет имеет зависимые ЛС и не может быть зависимым.");
		
		Возврат Истина;
	КонецЕсли;
	
	Если ВыбранноеЗначение = Объект.Ссылка Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Выбран собственый лицевой счет.");
		
		Возврат Истина;
	КонецЕсли; 
КонецФункции

