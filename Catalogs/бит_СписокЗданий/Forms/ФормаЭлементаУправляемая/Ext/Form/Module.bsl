		Элементы.КвартирыКоманднаяПанель.Доступность              = Ложь;
		Элементы.ГрупповыеСчетчикиКоманднаяПанель.Доступность     = Ложь;
		Элементы.ПредоставляемыеУслугиКоманднаяПанель.Доступность = Ложь;		
		Элементы.НежилыеПомещенияКоманднаяПанель.Доступность      = Ложь;
		
	КонецЕсли;
	
	НаДату              = НачалоМесяца(ТекущаяДата());
	СтрокаНачалоПериода = бит_РаботаСДиалогами.ДатаКакМесяцПредставление(НаДату);
	
	ЗаполинтьДопСвойства();	
