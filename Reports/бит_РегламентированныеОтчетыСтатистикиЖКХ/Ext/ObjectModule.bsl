			ФактАдресОрганизации = Выборка.Представление;
		КонецЕсли;
	КонецЦикла; 
	
	//РСКонтактнаяИнформация = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	//РСКонтактнаяИнформация.Объект = Организация;
	//РСКонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	//РСКонтактнаяИнформация.Вид = Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации;
	//РСКонтактнаяИнформация.Прочитать();
	//Если РСКонтактнаяИнформация.Выбран() Тогда
	//	ЮрАдресОрганизации = РСКонтактнаяИнформация.Представление;
	//КонецЕсли;
	//РСКонтактнаяИнформация = РегистрыСведений.КонтактнаяИнформация.СоздатьМенеджерЗаписи();
	//РСКонтактнаяИнформация.Объект = Организация;
	//РСКонтактнаяИнформация.Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;
	//РСКонтактнаяИнформация.Вид = Справочники.ВидыКонтактнойИнформации.ФактАдресОрганизации;
	//РСКонтактнаяИнформация.Прочитать();
	//Если РСКонтактнаяИнформация.Выбран() Тогда
	//	ФактАдресОрганизации = РСКонтактнаяИнформация.Представление;
	//КонецЕсли;
	
	// БИТ_ЖКХ 28.10.2015 17:29:46 Конец правки.
	
	Если ЮрАдресОрганизации = ФактАдресОрганизации Тогда
