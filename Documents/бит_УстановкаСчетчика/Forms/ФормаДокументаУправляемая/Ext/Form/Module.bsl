&НаКлиенте
Процедура УслугиПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Объект.Услуги.Количество() = мКэшЗначений.СписокУС.Количество()
		И Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьУслугиСоСчетчика Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("УслугиПриОкончанииРедактированияЗавершение", ЭтотОбъект, Новый Структура("Элемент", Элемент)), "Вы указали все подключенные услуги для удаления. Вы хотите снять счетчик?", РежимДиалогаВопрос.ДаНет); 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиПриОкончанииРедактированияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Элемент = ДополнительныеПараметры.Элемент;
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.СнятиеСчетчика;
		СчетчикПриИзменении(Элементы.Счетчик);
		
	Иначе
		
		СтрокаПоиск = Объект.Услуги.Индекс(Элемент.ТекущиеДанные);
		Объект.Услуги.Удалить(СтрокаПоиск);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСпособРаспределенияУменьшенияПриИзменении(Элемент)
	
	ТекСтрока = Элементы.Услуги.ТекущиеДанные;
	
	Массив = Новый Массив;
	Массив.Добавить(ПредопределенноеЗначение("Перечисление.бит_СпособыРаспределения.ПоСпособуРасчетаНачисления"));
	Массив.Добавить(ПредопределенноеЗначение("Перечисление.бит_СпособыРаспределения.ПоСпособуРасчетаФакт"));
	
	ОчиститьСпособРасчета = Массив.Найти(ТекСтрока.СпособРаспределенияУменьшения) = Неопределено;
	
	Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
		
		СтрокаТаблицы.СпособРаспределенияУменьшения =  ТекСтрока.СпособРаспределенияУменьшения;
		
		Если ОчиститьСпособРасчета Тогда
			СтрокаТаблицы.СпособРасчетаУменьшения = Неопределено;
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

