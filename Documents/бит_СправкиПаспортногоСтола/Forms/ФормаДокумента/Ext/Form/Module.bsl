	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_СвидетельстваОСмерти.ФизЛицо";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ОбластьШапка.Параметры.Заполнить(Выборка);
		ОбластьШапка.Параметры.ДатаСнятияСРегистрацииПроживающего = Формат(Выборка.ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.УМРДатаСмерти		= Формат(Выборка.УМРДатаСмерти, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.УМРДатаВыдачи		= Формат(Выборка.УМРДатаВыдачи, "ДФ=dd.MM.yyyy");
		ОбластьШапка.Параметры.УМРДатаСоставления	= Формат(Выборка.УМРДатаСоставления, "ДФ=dd.MM.yyyy");
		
	КонецЕсли; 
	
	ЗаполнитьИнформациюОбОрганизации(ОбластьШапка, ПараметрыОтчета);
	
	ОбластьШапка.Параметры.Номер			= ПараметрыОтчета.Номер;
	ОбластьШапка.Параметры.ДатаВыдачи		= Формат(ПараметрыОтчета.Период, "ДЛФ=DD");
	ОбластьШапка.Параметры.Проживающий		= ПараметрыОтчета.Проживающий;
	ОбластьШапка.Параметры.ДатаРождения		= Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.АдресПроживающего= ПараметрыОтчета.Адрес;
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФИО,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			НЕ ФизЛицо = &Проживающий
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Постоянно)";
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	
	ПостроительЗапроса.Текст = Текст;
	
	ПостроительЗапроса.Параметры.Вставить("Период"           , ПараметрыОтчета.Период);
	ПостроительЗапроса.Параметры.Вставить("ЛицевойСчет"      , ПараметрыОтчета.ЛицевойСчет);
	ПостроительЗапроса.Параметры.Вставить("Проживающий"      , ПараметрыОтчета.Проживающий);
	
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если ПараметрыОтчета.ИспользоватьОтборПроживающих Тогда
		
		Отбор = ПостроительЗапроса.Отбор.Добавить("ФИО");
		Отбор.ВидСравнения  = ВидСравнения.ВСписке;
		Отбор.Использование = Истина;
		Отбор.Значение      = СписокПроживающих;
		
	КонецЕсли; 
	
	ПостроительЗапроса.Выполнить();
	
	Выборка = ПостроительЗапроса.Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ОбластьСтрока.Параметры.ФИО             = Выборка.ФИО;
		ОбластьСтрока.Параметры.ДатаРождения    = Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
		ОбластьСтрока.Параметры.ДатаРегистрации = Формат(Выборка.ДатаРегистрации, "ДФ=dd.MM.yyyy");
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	ОбластьПодвал.Параметры.Заполнить(ПараметрыОтчета);
	ДокументРезультат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьСправкуПоТребованию(ДокументРезультат, ПараметрыОтчета)
	
	Макет = Документы.бит_СправкиПаспортногоСтола.ПолучитьМакет("ПоТребованию");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ФизЛицо_Склон = "";
	ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ПараметрыОтчета.Проживающий.Наименование,3,ПараметрыОтчета.Пол,ФизЛицо_Склон);
	
	ОбластьШапка.Параметры.Номер        = ПараметрыОтчета.Номер;
	ОбластьШапка.Параметры.ДатаВыдачи   = Формат(ПараметрыОтчета.Период, "ДЛФ=DD");
	
	Если ИсходСклонения Тогда
		ОбластьШапка.Параметры.Проживающий = ФизЛицо_Склон;
	Иначе
		ОбластьШапка.Параметры.Проживающий = ПараметрыОтчета.Проживающий; 
	КонецЕсли; 
	
	ОбластьШапка.Параметры.ДатаРождения		= Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.АдресПроживающего= ПараметрыОтчета.Адрес;
	
	Если ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
		
		ОбластьШапка.Параметры.Пол         = "она";
		ОбластьШапка.Параметры.ПризнакПола = "на";
		
	ИначеЕсли ПараметрыОтчета.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
		
		ОбластьШапка.Параметры.Пол         = "он";
		ОбластьШапка.Параметры.ПризнакПола = "н";
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , ПараметрыОтчета.Период);
	Запрос.УстановитьПараметр("ЛицевойСчет", ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("Проживающий", ПараметрыОтчета.Проживающий);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ПаспортныеДанныеПроживающих.Период,
	|	бит_ПаспортныеДанныеПроживающих.ДокументВид,
	|	бит_ПаспортныеДанныеПроживающих.ДокументСерия,
	|	бит_ПаспортныеДанныеПроживающих.ДокументНомер,
	|	бит_ПаспортныеДанныеПроживающих.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	|	бит_ПаспортныеДанныеПроживающих.ДокументКемВыдан,
	|	бит_ПаспортныеДанныеПроживающих.ДокументПричинаЗамены
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			ФизЛицо = &Проживающий
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих КАК бит_ПаспортныеДанныеПроживающих
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ПаспортныеДанныеПроживающих.ФизЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДокументДатаВыдачи УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(ДатаРегистрации)
	|ПО
	|	ФизЛицо";
	
	ВыборкаФизЛицо = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если ВыборкаФизЛицо.Следующий() Тогда
		
		ОбластьШапка.Параметры.ДатаРегистрацииПроживающего = Формат(ВыборкаФизЛицо.ДатаРегистрации, "ДФ=dd.MM.yyyy");
		
		Выборка = ВыборкаФизЛицо.Выбрать();
		
		Количество = Выборка.Количество();
		
		КолДокуметов = 0;
		
		УдостовирениеЛичности = " ";
		
		Пока Выборка.Следующий() Цикл
			
			КолДокуметов = КолДокуметов + 1;
			
			УдостовирениеЛичности = УдостовирениеЛичности 
			+ Выборка.ДокументВид 
			+ " сер. "  + ?(ПустаяСтрока(Выборка.ДокументСерия),"...",Выборка.ДокументСерия)
			+ " №"      + ?(ПустаяСтрока(Выборка.ДокументНомер),"...",Выборка.ДокументНомер) 
			+ ", выд. " + Формат(Выборка.ДокументДатаВыдачи, "ДФ=dd.MM.yyyy")
			+ " " + Выборка.ДокументКемВыдан 
			+ ?(ПустаяСтрока(Выборка.ДокументПричинаЗамены),"", ", выдан " + Выборка.ДокументПричинаЗамены);
			Если НЕ Количество = КолДокуметов Тогда
				
				УдостовирениеЛичности = УдостовирениеЛичности + ", взамен ";
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбластьШапка.Параметры.УдостовирениеЛичности = УдостовирениеЛичности;
	
	ЗаполнитьИнформациюОбОрганизации(ОбластьШапка, ПараметрыОтчета);
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ОбластьПодвал.Параметры.Заполнить(ПараметрыОтчета);
	ДокументРезультат.Вывести(ОбластьПодвал);
	
КонецПроцедуры

&НаСервере
Функция ПодготовитьПараметрыОтчета()
	
	ПараметрыОтчета = Новый Структура;
	ПараметрыОтчета.Вставить("Период"				, Объект.Дата);
	ПараметрыОтчета.Вставить("Номер"				, Объект.НомерСправки);
	ПараметрыОтчета.Вставить("Организация"			, Объект.Организация);
	ПараметрыОтчета.Вставить("ЛицевойСчет"			, Объект.ЛицевойСчет);
	ПараметрыОтчета.Вставить("Проживающий"			, Объект.Проживающий);
	ПараметрыОтчета.Вставить("Руководитель"			, "");
	ПараметрыОтчета.Вставить("Паспортист"			, "");
	ПараметрыОтчета.Вставить("ДолжностьРуководитель", "");
	ПараметрыОтчета.Вставить("ДолжностьПаспортист"	, "");
	
	
	Запрос	= Новый Запрос;
	Запрос.УстановитьПараметр("СтруктурнаяЕдиница",	Объект.Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Период КАК Период,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.СтруктурнаяЕдиница КАК СтруктурнаяЕдиница,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо КАК ОтветственноеЛицо,
	|	ПРЕДСТАВЛЕНИЕ(ОтветственныеЛицаОрганизацийСрезПоследних.Должность) КАК ПРЕДСТАВЛЕНИЕДолжность,
	|	ПРЕДСТАВЛЕНИЕ(ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо) КАК ПРЕДСТАВЛЕНИЕФизическоеЛицо,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Должность КАК Должность,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо КАК ФизическоеЛицо,
	|	ВЫБОР
	|		КОГДА ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)
	|			ТОГДА ""Руководитель""
	|		КОГДА ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер)
	|			ТОГДА ""ГлавныйБухгалтер""
	|		КОГДА ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Кассир)
	|			ТОГДА ""Кассир""
	|		ИНАЧЕ """"
	|	КОНЕЦ КАК ИмяРеквизитаОтветственногоЛица,
	|	ФизическиеЛица.ФИО КАК ФИО
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних КАК ОтветственныеЛицаОрганизацийСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизическиеЛица
	|		ПО ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо = ФизическиеЛица.Ссылка
	|ГДЕ
	|	ОтветственныеЛицаОрганизацийСрезПоследних.СтруктурнаяЕдиница = &СтруктурнаяЕдиница
	|	И (ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)
	|			ИЛИ ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.бит_Паспортист))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ОтветственноеЛицо = Перечисления.ОтветственныеЛицаОрганизаций.Руководитель Тогда
			ПараметрыОтчета.Руководитель = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Выборка.ФИО);
			ПараметрыОтчета.ДолжностьРуководитель = Выборка.ПРЕДСТАВЛЕНИЕДолжность;
		Иначе	
			ПараметрыОтчета.Паспортист = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(Выборка.ФИО);
			ПараметрыОтчета.ДолжностьПаспортист = Выборка.ПРЕДСТАВЛЕНИЕДолжность;
		КонецЕсли;
	КонецЦикла; 
	
	СведенияОПроживающем = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.Проживающий, "ДатаРождения, Пол");
	
	ПараметрыОтчета.Вставить("ДатаРождения"     , СведенияОПроживающем.ДатаРождения);
	ПараметрыОтчета.Вставить("Пол"              , СведенияОПроживающем.Пол);
	ПараметрыОтчета.Вставить("Адрес"            , ПолучитьАдресЛС(Объект.ЛицевойСчет));
	ПараметрыОтчета.Вставить("СписокПроживающих", Объект.ТаблицаПроживающих.Выгрузить());
	ПараметрыОтчета.Вставить("Здание"           , Объект.ЛицевойСчет.Здание);
	
	ПараметрыОтчета.Вставить("ИспользоватьОтборПроживающих", Объект.ИспользоватьОтборПроживающих);
	ПараметрыОтчета.Вставить("СправкаДанаДляПредоставления", Объект.СправкаДанаДляПредоставления);
	
	Возврат ПараметрыОтчета;
	
КонецФункции 

&НаСервереБезКонтекста
Функция ПолучитьАдресЛС(ЛицевойСчет)
	
	Адрес = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Квартира КАК Квартира,
	|	ЕСТЬNULL(бит_СписокЗданий.ПочтовыйАдрес, """") КАК ПочтовыйАдрес
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка = &ЛицевойСчет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЗапросКвартира = Новый Запрос;
		ЗапросКвартира.УстановитьПараметр("Момент", ТекущаяДата());
		ЗапросКвартира.УстановитьПараметр("Квартира", выборка.Квартира);
		
		ЗапросКвартира.Текст = "ВЫБРАТЬ
		|	бит_СведенияОКвартиреСрезПоследних.Квартира КАК Квартира,
		|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК лб_ПредставлениеКвартиры
		|ИЗ
		|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, Квартира  = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
		
		РезультатЗапросКвартира = ЗапросКвартира.Выполнить().Выбрать();
		Если РезультатЗапросКвартира.Следующий() Тогда
			РезультатЗапросКвартира.Следующий();
			нКвартира =  РезультатЗапросКвартира.лб_ПредставлениеКвартиры;
		Иначе
			нКвартира = выборка.Квартира.НомерКвартиры;
		КонецЕсли;
		
		Адрес = Выборка.ПочтовыйАдрес + ", кв. " + Строка(нКвартира); 	
		
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции

