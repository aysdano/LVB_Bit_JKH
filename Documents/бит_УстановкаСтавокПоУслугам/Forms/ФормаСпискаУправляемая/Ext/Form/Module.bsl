
#Область ДействияКомандФормы

// Процедура - обработчик события "Нажатие" кнопки "Файлы" коммандной панели "ДействияФормы". 
//
&НаКлиенте
Процедура Файлы(Команда)
	
	ТекДанные = Элементы.Список.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
		
	ПараметрыФормы.Вставить("Объект", ТекДанные.Ссылка);
	
	ОткрытьФорму("Справочник.бит_рз_ХранилищеДополнительнойИнформации.Форма.ФормаСпискаУправляемая", Новый Структура("ЗаполнитьИзДокументаРазовыеПоУслугамЖКХ", ПараметрыФормы), ЭтаФорма);

КонецПроцедуры

#КонецОбласти