		<query>ВЫБРАТЬ
	бит_ОборотыПоСметамОбороты.Сценарий,
	бит_ОборотыПоСметамОбороты.СтатьяОборотов,
	бит_ОборотыПоСметамОбороты.Здание,
	бит_ОборотыПоСметамОбороты.СуммаОборот,
	бит_ОборотыПоСметамОбороты.Регистратор,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ГОД)
		ИНАЧЕ бит_ОборотыПоСметамОбороты.Период
	КОНЕЦ КАК Период,
	бит_ОборотыПоСметамОбороты.Счет,
	бит_ОборотыПоСметамОбороты.Подразделение,
	бит_ОборотыПоСметамОбороты.Субконто1,
	бит_ОборотыПоСметамОбороты.Субконто2,
	бит_ОборотыПоСметамОбороты.Субконто3,
	бит_ОборотыПоСметамОбороты.КорСчет,
	бит_ОборотыПоСметамОбороты.ПодразделениеКор,
	бит_ОборотыПоСметамОбороты.КорСубконто1,
	бит_ОборотыПоСметамОбороты.КорСубконто2,
	бит_ОборотыПоСметамОбороты.КорСубконто3,
	бит_ОборотыПоСметамОбороты.Источник
ПОМЕСТИТЬ ОборотыПлан
ИЗ
	РегистрНакопления.бит_ОборотыПоСметам.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор,
			Сценарий = &amp;СценарийПлан
				И Организация = &amp;Организация) КАК бит_ОборотыПоСметамОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_ОборотыПоСметамОбороты.Сценарий,
	бит_ОборотыПоСметамОбороты.СтатьяОборотов,
	бит_ОборотыПоСметамОбороты.Здание,
	бит_ОборотыПоСметамОбороты.СуммаОборот,
	бит_ОборотыПоСметамОбороты.Регистратор,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА НАЧАЛОПЕРИОДА(бит_ОборотыПоСметамОбороты.Период, ГОД)
		ИНАЧЕ бит_ОборотыПоСметамОбороты.Период
	КОНЕЦ КАК Период,
	бит_ОборотыПоСметамОбороты.Счет,
	бит_ОборотыПоСметамОбороты.Подразделение,
	бит_ОборотыПоСметамОбороты.Субконто1,
	бит_ОборотыПоСметамОбороты.Субконто2,
	бит_ОборотыПоСметамОбороты.Субконто3,
	бит_ОборотыПоСметамОбороты.КорСчет,
	бит_ОборотыПоСметамОбороты.ПодразделениеКор,
	бит_ОборотыПоСметамОбороты.КорСубконто1,
	бит_ОборотыПоСметамОбороты.КорСубконто2,
	бит_ОборотыПоСметамОбороты.КорСубконто3,
	бит_ОборотыПоСметамОбороты.Источник
ПОМЕСТИТЬ ОборотыФакт
ИЗ
	РегистрНакопления.бит_ОборотыПоСметам.Обороты(
			&amp;НачалоПериода,
			&amp;КонецПериода,
			Регистратор,
			Сценарий = &amp;СценарийФакт
				И Организация = &amp;Организация) КАК бит_ОборотыПоСметамОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(ОборотыПлан.Сценарий, ОборотыФакт.Сценарий) КАК Сценарий,
	ЕСТЬNULL(ОборотыПлан.СтатьяОборотов, ОборотыФакт.СтатьяОборотов) КАК СтатьяОборотов,
	ЕСТЬNULL(ОборотыПлан.Здание, ОборотыФакт.Здание) КАК Здание,
	ЕСТЬNULL(ОборотыПлан.СуммаОборот, 0) КАК План,
	ЕСТЬNULL(ОборотыПлан.Регистратор, 0) КАК Регистратор,
	ЕСТЬNULL(ОборотыПлан.Период, ОборотыФакт.Период) КАК Период,
	ЕСТЬNULL(ОборотыФакт.СуммаОборот, 0) КАК Факт,
	ЕСТЬNULL(ОборотыПлан.СуммаОборот, 0) - ЕСТЬNULL(ОборотыФакт.СуммаОборот, 0) КАК Расхождение,
	ЕСТЬNULL(ОборотыПлан.Счет, ОборотыФакт.Счет) КАК Счет,
	ЕСТЬNULL(ОборотыПлан.Подразделение, ОборотыФакт.Подразделение) КАК Подразделение,
	ЕСТЬNULL(ОборотыПлан.Субконто1, ОборотыФакт.Субконто1) КАК Субконто1,
	ЕСТЬNULL(ОборотыПлан.Субконто2, ОборотыФакт.Субконто2) КАК Субконто2,
	ЕСТЬNULL(ОборотыПлан.Субконто3, ОборотыФакт.Субконто3) КАК Субконто3,
	ЕСТЬNULL(ОборотыПлан.КорСчет, ОборотыФакт.КорСчет) КАК КорСчет,
	ЕСТЬNULL(ОборотыПлан.ПодразделениеКор, ОборотыФакт.ПодразделениеКор) КАК ПодразделениеКор,
	ЕСТЬNULL(ОборотыПлан.КорСубконто1, ОборотыФакт.КорСубконто1) КАК КорСубконто1,
	ЕСТЬNULL(ОборотыПлан.КорСубконто2, ОборотыФакт.КорСубконто2) КАК КорСубконто2,
	ЕСТЬNULL(ОборотыПлан.КорСубконто3, ОборотыФакт.КорСубконто3) КАК КорСубконто3,
	ЕСТЬNULL(ОборотыПлан.Источник, ОборотыФакт.Источник) КАК Источник
ПОМЕСТИТЬ СводнаяТаблица
ИЗ
	ОборотыПлан КАК ОборотыПлан
		ПОЛНОЕ СОЕДИНЕНИЕ ОборотыФакт КАК ОборотыФакт
		ПО ОборотыПлан.Сценарий = ОборотыФакт.Сценарий
			И ОборотыПлан.СтатьяОборотов = ОборотыФакт.СтатьяОборотов
			И ОборотыПлан.Здание = ОборотыФакт.Здание
			И ОборотыПлан.Регистратор = ОборотыФакт.Регистратор
			И ОборотыПлан.Период = ОборотыФакт.Период
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СводнаяТаблица.Сценарий,
	СводнаяТаблица.СтатьяОборотов,
	СводнаяТаблица.Здание,
	СводнаяТаблица.План,
	СводнаяТаблица.Регистратор,
	СводнаяТаблица.Период,
	СводнаяТаблица.Факт,
	СводнаяТаблица.Расхождение,
	СводнаяТаблица.Здание.Район КАК Район,
	СводнаяТаблица.Здание.Улица КАК Улица,
	СводнаяТаблица.Здание.Участок КАК Участок,
	СводнаяТаблица.СтатьяОборотов.Кодификатор КАК Кодификатор,
	СводнаяТаблица.СтатьяОборотов.Наименование КАК Наименование,
	СводнаяТаблица.Счет,
	СводнаяТаблица.Подразделение,
	СводнаяТаблица.Субконто1,
	СводнаяТаблица.Субконто2,
	СводнаяТаблица.Субконто3,
	СводнаяТаблица.КорСчет,
	СводнаяТаблица.ПодразделениеКор,
	СводнаяТаблица.КорСубконто1,
	СводнаяТаблица.КорСубконто2,
	СводнаяТаблица.КорСубконто3,
	СводнаяТаблица.Источник
ИЗ
	СводнаяТаблица КАК СводнаяТаблица</query>
