	               |	втРезультат.УслугаЖКХ = &УслугаХВС
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	втРезультат.УслугаЖКХ КАК УслугаЖКХ,
	               |	втРезультат.НомерОДПУ КАК НомерОДПУ,
