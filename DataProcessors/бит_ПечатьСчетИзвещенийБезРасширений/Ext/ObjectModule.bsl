			ОбластьНизУслугиТаблица.Параметры.ПениИтого 	= Макс(ВыборкаДетальныеЗаписи.Итого, 0);
			ОбластьНизУслугиТекст.Параметры.ПениИтого 		= Макс(ВыборкаДетальныеЗаписи.Итого, 0);
			Итого 											= Итого + Макс(ВыборкаДетальныеЗаписи.Итого, 0);
			Код2_6 = ?(Макс(ВыборкаДетальныеЗаписи.Итого, 0) = 0, 0, 7);
		КонецЕсли;
		
		//Мельник Изменение условия, на начисление текущего месяца
		СодержаниеНачислениеПрошлыйМесяц = ПолучитьНачислениеПрошлогоМесяца(МассивСодержание, ВыборкаЛС.ЛицевойСчет, КонецМесяца(ДатаКвитанции)); 
		Если СодержаниеНачислениеПрошлыйМесяц = 0 Тогда
			ВыводитьКвитанцию = Ложь;
		КонецЕсли;
		
		Если СодержаниеОстаток < 100 Тогда
			ВыводитьКвитанцию = Ложь;
		КонецЕсли;
		//Если СодНачисления = 0 Тогда
		СодержаниеНачислениеПрошлыйМесяц = ПолучитьНачислениеПрошлогоМесяца(МассивСодержание, ВыборкаЛС.ЛицевойСчет, ДобавитьМесяц(ДатаКвитанции, - 1)); 
		
		Если ВыводитьКвитанцию И ((СодержаниеНачислениеПрошлыйМесяц + 100) > СодержаниеСальдо) Тогда
			ВыводитьКвитанцию = Ложь;
		КонецЕсли;
		
		Если ВыводитьКвитанцию Тогда
			ВыводитьКвитанцию = Итого <> 0; 	
		КонецЕсли;
		
		Если ВыводитьКвитанцию Тогда                
			
			Если ПоВсемУслугам Тогда
				
				ОбластьНизУслугиТекст.Параметры.УслугаДоп		 	= "Доп. услуга";
				ОбластьНизУслугиТаблица.Параметры.УслугаДоп		 	= "Доп. услуга";
				ОбластьНизУслугиТекст.Параметры.УслугаПУ	 	= "Обсл. ПУ тепла";//
				ОбластьНизУслугиТаблица.Параметры.УслугаПУ	 	= "Обсл. ПУ тепла";//
				ОбластьНизУслугиТекст.Параметры.УслугаАнтенна 	= "Антенна";
				ОбластьНизУслугиТаблица.Параметры.УслугаАнтенна = "Антенна";
				ОбластьНизУслугиТекст.Параметры.УслугаСпецСчет 		= "Организация фонда кап. ремонта";
				ОбластьНизУслугиТаблица.Параметры.УслугаСпецСчет 	= "Организация фонда кап. ремонта";
				ОбластьНизУслугиТаблица.Параметры.УслугаХВВ 		= "Хол. водоснабжение";
				ОбластьНизУслугиТекст.Параметры.УслугаПени 		= "Пени за сод. жилья";
				ОбластьНизУслугиТаблица.Параметры.УслугаПени 	= "Пени за сод. жилья";
			Иначе
				Если МассивУслуг.Найти(УслугаДоп) <> Неопределено Тогда 
					ОбластьНизУслугиТекст.Параметры.УслугаДоп		 	= "Доп. услуга";
					ОбластьНизУслугиТаблица.Параметры.УслугаДоп		 	= "Доп. услуга";
				КонецЕсли;
				Если МассивУслуг.Найти(УслугаОДПУ) <> Неопределено Тогда 
					ОбластьНизУслугиТекст.Параметры.УслугаПУ	 	= "Обсл. ПУ тепла";//
					ОбластьНизУслугиТаблица.Параметры.УслугаПУ	 	= "Обсл. ПУ тепла";//
				КонецЕсли;
				Если МассивУслуг.Найти(УслугаАверс) <> Неопределено ИЛИ МассивУслуг.Найти(УслугаПрофи) Тогда 
					ОбластьНизУслугиТекст.Параметры.УслугаАнтенна 	= "Антенна";
					ОбластьНизУслугиТаблица.Параметры.УслугаАнтенна = "Антенна";
				КонецЕсли;
				Если МассивУслуг.Найти(УслугаОргФКР) <> Неопределено Тогда 
					ОбластьНизУслугиТекст.Параметры.УслугаСпецСчет 		= "Организация фонда кап. ремонта";
					ОбластьНизУслугиТаблица.Параметры.УслугаСпецСчет 	= "Организация фонда кап. ремонта";
				КонецЕсли;
				Если МассивУслуг.Найти(УслугаХВВ) <> Неопределено Тогда 
					ОбластьНизУслугиТаблица.Параметры.УслугаХВВ 		= "Хол. водоснабжение";
				КонецЕсли;
				Если МассивУслуг.Найти(УслугаПени) <> Неопределено Тогда 
					ОбластьНизУслугиТекст.Параметры.УслугаПени 		= "Пени за сод. жилья";
					ОбластьНизУслугиТаблица.Параметры.УслугаПени 	= "Пени за сод. жилья";
				КонецЕсли;
				
			КонецЕсли;
			
			КонтрольныйПервый = ((Код1_2 + Код1_3*3 + Код1_5 + Код1_6*3 + 51)*3)%10;
			КонтрольныйВторой = ((93 + Код2_2 + Код2_4*7 + Код2_5 + Код2_6*3 + Код2_7*7 + Код2_8)*3)%10;
			
			КодПочтыПервый = "6" + Строка(Код1_2) + Строка(Код1_3) + "0" + Строка(Код1_5) + Строка(Код1_6) + "0090" + Строка(КонтрольныйПервый);
			КодПочтыВторой = "3" + Строка(Код2_2)+ "0" + Строка(Код2_4) + Строка(Код2_5) + Строка(Код2_6) + Строка(Код2_7) + Строка(Код2_8) +"99" + Строка(КонтрольныйВторой);
			
			Штркд = Строка(ВыборкаЛС.ЛСНомер) + Формат(ДатаКвитанции, "ДФ=ММгг") + Лев(КодПочтыПервый, 10) + Лев(КодПочтыВторой, 10) + "000000000";
			ЧислоЦифр = СтрДлина(Штркд);
			СуммаШтрихКода = 0;
			Десяток = 0;
			Для Счетчик = 1 По ЧислоЦифр Цикл
				Цифра = Сред(Штркд,Счетчик,1);		
				Если Счетчик % 2 = 0 тогда
					Множитель = Счетчик / 2;
					СуммаШтрихКода = СуммаШтрихКода + (Число(Цифра) + Десяток) * Множитель;
				Иначе
					Десяток = Цифра * 10;    
				КонецЕсли;	
				
			КонецЦикла;
			
			КонтрольныйШтрихКод = (СуммаШтрихКода + 105)%103;
			ЗначениеШтрихкода = Штркд + Строка(КонтрольныйШтрихКод);
			
			Эталон = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;	
			Попытка
				Рисунок = ОбластьШапка.Рисунки.D1;
			Исключение
			КонецПопытки;	
			Попытка		
				ПараметрыШтрихкода = Новый Структура;
				ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе)+250);
				ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
				ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
				ПараметрыШтрихкода.Вставить("ТипКода",         4);
				ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
				ПараметрыШтрихкода.Вставить("РазмерШрифта",    10);
				
				КартинкаШК = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода); 
				Рисунок.Картинка	= КартинкаШК;
				Рисунок.Высота		= 22.57;
				Рисунок.Лево		= Рисунок.Лево - 8.5;
				Рисунок.Ширина		= 130;
			Исключение
			КонецПопытки;	
			Попытка 
				QRКодДолговая(ВыборкаЛС.Ответственный,ВыборкаЛС.ЛицевойСчет, ОбластьШапка, ВыборкаЛС.РасчетныйСчетСсылка);   //Печать QR-кода
			Исключение	
			КонецПопытки;	

			ОбластьШапка.Параметры.КодПочты1 = Лев(КодПочтыПервый, 2) + " ' " + Сред(КодПочтыПервый, 3, 3) + " ' " + Сред(КодПочтыПервый, 6, 3) + " ' " + Сред(КодПочтыПервый, 9, 3);
			ОбластьШапка.Параметры.КодПочты2 = Лев(КодПочтыВторой, 2) + " ' " + Сред(КодПочтыВторой, 3, 3) + " ' " + Сред(КодПочтыВторой, 6, 3) + " ' " + Сред(КодПочтыВторой, 9, 3);			ОбластьШапка.Параметры.КодПочты1 = Лев(КодПочтыПервый, 2) + " ' " + Сред(КодПочтыПервый, 3, 3) + " ' " + Сред(КодПочтыПервый, 6, 3) + " ' " + Сред(КодПочтыПервый, 9, 3);
			
			ОбластьНизУслугиТекст.Параметры.КодПочты1 = Лев(КодПочтыПервый, 2) + " ' " + Сред(КодПочтыПервый, 3, 3) + " ' " + Сред(КодПочтыПервый, 6, 3) + " ' " + Сред(КодПочтыПервый, 9, 3);
			ОбластьНизУслугиТекст.Параметры.КодПочты2 = Лев(КодПочтыВторой, 2) + " ' " + Сред(КодПочтыВторой, 3, 3) + " ' " + Сред(КодПочтыВторой, 6, 3) + " ' " + Сред(КодПочтыВторой, 9, 3);
			
			ОбластьНизУслугиТаблица.Параметры.ПериодДеньМесяц = Формат(НачалоМесяца(ДатаКвитанции), "ДФ=dd.MM.yyyy"); 
			ОбластьНизУслугиТаблица.Параметры.ПериодКонец = Формат(ДатаКвитанции, "ДФ=dd.MM.yyyy");
			ОбластьНизУслугиТаблица.Параметры.УслугаСодРем 	= "Сод. и ремонт" + Символы.ПС + 
															"в том числе"  + Символы.ПС + 
															"Общедомовые нужды на содержание общего имущества:"  + Символы.ПС + 
															"-электроэнергия"  + Символы.ПС + 
															"-горячее в/потребление"  + Символы.ПС + 
															"-холодное в/потребление"  + Символы.ПС + 
															"-водоотведение";
			ОбластьНизУслугиТаблица.Параметры.СодРемСальдо 	= СодержаниеСальдо;
			ОбластьНизУслугиТаблица.Параметры.СодРемОплаты 	= СодержаниеОплаты;
			ОбластьНизУслугиТаблица.Параметры.СодРемИтого 	= Макс(СодержаниеОстаток, 0);
			ОбластьНизУслугиТекст.Параметры.СодРемИтого 	= Макс(СодержаниеОстаток, 0);
			ОбластьНизУслугиТекст.Параметры.УслугаСод 		= "Сод. и рем. жилья";
			Итого 											= Итого + Макс(СодержаниеОстаток, 0);
			
			ОбластьНизУслугиТекст.Параметры.ИтогоКОплате    = Итого;
			ОбластьНизУслугиТаблица.Параметры.ИтогоКОплате  = Итого;
			ЗаполнитьЗначенияСвойств(ОбластьШапка.Параметры, ВыборкаЛС);
			ЗаполнитьЗначенияСвойств(ОбластьНизУслугиТаблица.Параметры, ВыборкаЛС);
			ЗаполнитьЗначенияСвойств(ОбластьНизУслугиТекст.Параметры, ВыборкаЛС);
			ОбластьШапка.Параметры.Адрес = СокрЛП(ВыборкаЛС.ЗданиеПредставление) + " кв." + ВыборкаЛС.КвартираПредставление;
			ОбластьНизУслугиТекст.Параметры.Адрес = СокрЛП(ВыборкаЛС.ЗданиеПредставление) + " кв." + ВыборкаЛС.КвартираПредставление;
			ОбластьШапка.Параметры.ПериодМесяцГод = Формат(НачалоМесяца(ДатаКвитанции), "ДФ=ММ.гггг");
			ОбластьНизУслугиТекст.Параметры.ПериодМесяцГод = Формат(НачалоМесяца(ДатаКвитанции), "ДФ=ММ.гггг");
			ОбластьНизУслугиТаблица.Параметры.ТекущаяДата = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
			ОбластьНизУслугиТекст.Параметры.ТекущаяДата = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
			
			
			ТабДок.Вывести(ОбластьШапка);
			ТабДок.Вывести(ОбластьНизУслугиТекст);
			ТабДок.Присоединить(ОбластьНизУслугиТаблица);
			ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабДок;
КонецФункции

Функция ПолучитьНачислениеПрошлогоМесяца(Услуги, ЛицевойСчет, Период)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("СписокУслуг", Услуги);
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаПриход КАК Начисления
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|			НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ),
	|			КОНЕЦПЕРИОДА(&Период, МЕСЯЦ),
	|			,
	|			,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И УслугаЖКХ В (&СписокУслуг)) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Начисления;
	Иначе
		Возврат 0;
	КонецЕсли;
		
КонецФункции

Функция КвитанцияКапРемонт()
	
	УслугаМинВзнос = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");
	УслугаДопВзнос = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000014");
	УслугаРФКР     = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000009");
	МакетКапРемонт = Новый ТабличныйДокумент;
	МакетКапРемонт.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	МакетКвитанции = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("лб_МакетКапРемонт");
	ОбластьКвитанции = МакетКвитанции.ПолучитьОбласть("ОбластьШирина|ОбластьВысота");
	//Формирование кодов почты. 10 знак - первый и второй символы кода капитального ремонта.
	ЗапросКода = Новый Запрос;
	ЗапросКода.УстановитьПараметр("Здание",МструктураДанных.КвартираСсылка.Владелец);
	ЗапросКода.Текст = 
	"ВЫБРАТЬ
	|	лб_Тест_Дома.ВладелецСчетаКР КАК Организация,
	|	лб_Тест_Дома.KR_KOD КАК КодКапРемонта,
	|	лб_Тест_Дома.KR_RS КАК РасчетныйСчет,
	|	лб_Тест_Дома.ЛицевойСчетКР КАК РасчетныйСчетСсылка
	|ИЗ
	|	РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
	|ГДЕ
	|	лб_Тест_Дома.Здание = &Здание";
	РезультатЗапроса = ЗапросКода.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаЗапроса = РезультатЗапроса.Выгрузить();
		
		Если ЗначениеЗаполнено(ВыборкаЗапроса[0].РасчетныйСчетСсылка) Тогда
			РасчетныйСчетСсылка = ВыборкаЗапроса[0].РасчетныйСчетСсылка;
		Иначе
			Возврат МакетКапРемонт; 
		КонецЕсли;
		ПолучательПлатежа   = ВыборкаЗапроса[0].Организация;
		РасчетныйСчет       = ВыборкаЗапроса[0].РасчетныйСчет;
		Если (СокрЛП(ВыборкаЗапроса[0].КодКапРемонта) <> "") И (ВыборкаЗапроса[0].КодКапРемонта <> Неопределено) Тогда
			Код1 = Лев(СокрЛП(ВыборкаЗапроса[0].КодКапРемонта),1);
			Код2 = Сред(СокрЛП(ВыборкаЗапроса[0].КодКапРемонта),2,1);
		Иначе
			Код1 = 0;
			Код2 = 0;
		КонецЕсли;
		
	Иначе 
		Возврат МакетКапРемонт;
		//ПолучательПлатежа = мСтруктураДанных.ПолучательПредставление;
		//РасчетныйСчет     = мСтруктураДанных.ПолучательРС;
		//Код1 = 0;
		//Код2 = 0;
	КонецЕсли;

	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") И НЕ ЗначениеЗаполнено(РасчетныйСчетСсылка) Тогда
		РасчетныйСчетСсылка = ПолучательПлатежа.ОсновнойБанковскийСчет;		
	КонецЕсли;	
		
	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") Тогда
