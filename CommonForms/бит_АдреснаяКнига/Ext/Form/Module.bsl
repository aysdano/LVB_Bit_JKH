
#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Пропускаем инициализацию, чтобы гарантировать получение формы при передаче параметра "АвтоТест".
	Если Параметры.Свойство("АвтоТест") Тогда
		Возврат;
	КонецЕсли;
	
	ДобавитьСтраницыФормыПодбораКонтактов();
	ЗаполнитьТаблицуПолучателей();
	УстановитьГруппуПоУмолчанию();
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеСтраницами();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	УправлениеСтраницами();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	Элемент.СписокВыбора.Очистить();
	
	ТекущиеДанные = Элементы.ПолучателиПисьма.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ПустаяСтрока(ТекущиеДанные.СписокАдресов) Тогда
		Элемент.СписокВыбора.ЗагрузитьЗначения(
		СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(ТекущиеДанные.СписокАдресов,";"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КонтактНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучателиПисьмаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		Элемент.ТекущиеДанные.Группа = "Кому";
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокСправочникаВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не ЗначениеЗаполнено(ВыбраннаяСтрока) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПолучитьНаименованиеИАдресаЭлектроннойПочтыКонтакта(ВыбраннаяСтрока);
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Адрес = Результат.Адреса[0];
	//СписокАдресов = СтроковыеФункцииКлиентСервер.ПолучитьСтрокуИзМассиваПодстрок(Результат.Адреса, ";");
	МассивАдресов = Результат.Адреса.ВыгрузитьЗначения();
	СписокАдресов = СтрСоединить(МассивАдресов, ";");
	
	ДобавитьПолучателя(Адрес, Результат.Наименование, ВыбраннаяСтрока, СписокАдресов);
	
КонецПроцедуры

&НаКлиенте
Процедура ГруппыПользователейПриАктивизацииСтроки(Элемент)
	
	СписокПользователей.Параметры.УстановитьЗначениеПараметра("ГруппаПользователей", Элементы.ГруппыПользователей.ТекущаяСтрока);
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

// Передает владельцу в качестве результата работы формы массив структур содержащих. 
// Адреса выбранных получателей и закрывает форму. 
//
&НаКлиенте
Процедура КомандаОКВыполнить()
	
	Результат = Новый Массив;
	
	Для Каждого СтрокаТаблицы Из ПолучателиПисьма Цикл
		Группа = ?(ПустаяСтрока(СтрокаТаблицы.Группа), "Кому", СтрокаТаблицы.Группа);
		Контакт = Новый Структура("Адрес, Представление, Контакт, Группа",
		СтрокаТаблицы.Адрес, СтрокаТаблицы.Представление, СтрокаТаблицы.Контакт, Группа);
		Результат.Добавить(Контакт);
	КонецЦикла;
	
	Закрыть(Результат);
	
КонецПроцедуры

// Изменяет текущую группу получателей письма на группу "Кому". 
//
&НаКлиенте
Процедура ИзменитьГруппуКомуВыполнить()
	
	ИзменитьГруппу("Кому");
	
КонецПроцедуры

// Изменяет текущую группу получателей письма на группу "Копии". 
//
&НаКлиенте
Процедура ИзменитьГруппуКопииВыполнить()
	
	ИзменитьГруппу("Копии");
	
КонецПроцедуры 

// Осуществляет поиск всех адресов электронной почты контакта из списка "Получатели письма" и.
// Предлагает пользователю сделать выбор, если у контакта более одного адреса электронной почты.
&НаКлиенте
Процедура УстановитьАдресКонтактаВыполнить()
	
	ТекущиеДанные = Элементы.ПолучателиПисьма.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено ИЛИ Не ЗначениеЗаполнено(ТекущиеДанные.Контакт) Тогда
		Возврат;
	КонецЕсли;
	
	Результат = ПолучитьАдресаЭлектроннойПочтыКонтакта(ТекущиеДанные.Контакт);
	Если Результат.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат.Количество() = 1 Тогда
		Адрес = Результат[0].АдресЭП;
		Представление = Результат[0].Представление;
	Иначе
		СписокВыбора = Новый СписокЗначений;
		Номер = 0;
		Для Каждого Элемент Из Результат Цикл
			СписокВыбора.Добавить(Номер, Элемент.АдресЭП);
			Номер = Номер + 1;
		КонецЦикла;
		
		ВыбранныйЭлемент = Неопределено;
		
		СписокВыбора.ПоказатьВыборЭлемента(Новый ОписаниеОповещения("УстановитьАдресКонтактаВыполнитьЗавершение", ЭтотОбъект, Новый Структура("Результат, ТекущиеДанные", Результат, ТекущиеДанные)));
		Возврат;
		
	КонецЕсли;
	
	УстановитьАдресКонтактаВыполнитьФрагмент(Адрес, Представление, ТекущиеДанные);
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАдресКонтактаВыполнитьЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
	
	Результат = ДополнительныеПараметры.Результат;
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	ВыбранныйЭлемент = ВыбранныйЭлемент1;
	Если ВыбранныйЭлемент = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Индекс = ВыбранныйЭлемент.Значение;
	Адрес = Результат[Индекс].АдресЭП;
	Представление = Результат[Индекс].Представление;
	
	УстановитьАдресКонтактаВыполнитьФрагмент(Адрес, Представление, ТекущиеДанные);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАдресКонтактаВыполнитьФрагмент(Знач Адрес, Представление, Знач ТекущиеДанные)
	
	Перем Позиция;
	
	Позиция = Найти(Представление, "<");
	Представление = ?(Позиция= 0, "", СокрЛП(Лев(Представление, Позиция-1)));
	
	ТекущиеДанные.Адрес = Адрес;
	Если Не ПустаяСтрока(Представление) Тогда
		ТекущиеДанные.Представление = Представление;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьИзВыбранногоВСписокВсе(Команда)
	
	ПолучателиПисьма.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьИзВыбранногоВСписок(Команда)
	
	ВыделенныеСтроки = Элементы.ПолучателиПисьма.ВыделенныеСтроки;
	Для каждого ВыделеннаяСтрока Из ВыделенныеСтроки Цикл
		
		ПолучателиПисьма.Удалить(ПолучателиПисьма.НайтиПоИдентификатору(ВыделеннаяСтрока));
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьИзСпискаВВыбранное(Команда)
	
	НомерЭлементаФормы = Неопределено;
	
	Если Элементы.СтраницыСписки.ТекущаяСтраница.ПодчиненныеЭлементы.Количество() = 1 Тогда
		
		НомерЭлементаФормы = 0;
		
	ИначеЕсли Элементы.СтраницыСписки.ТекущаяСтраница.ПодчиненныеЭлементы.Количество() = 2 Тогда
		
		Если ТекущийЭлемент.Имя = "ПереместитьИзВерхнегоСпискаВВыбранное" Тогда
			
			НомерЭлементаФормы = 0;
			
		Иначе
			
			НомерЭлементаФормы = 1;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НомерЭлементаФормы = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ПеренестиВыделенныеСтроки(
	Элементы.СтраницыСписки.ТекущаяСтраница.ПодчиненныеЭлементы[НомерЭлементаФормы].ВыделенныеСтроки);
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Получает наименование и адреса электронной почты контакта.
//
// Параметры:
//  Контакт - Ссылка - контакт, для которого получаются данные.
//
// Возвращаемое значение:
//  Структура - содержит наименование контакта и список значений электронной почты контакта.
//
&НаСервере
Функция ПолучитьНаименованиеИАдресаЭлектроннойПочтыКонтакта(Контакт)
	
	Если Не ЗначениеЗаполнено(Контакт) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если Контакт.Метаданные().Иерархический Тогда
		Если Контакт.ЭтоГруппа Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЕсли;
	
	ИмяТаблицы = Контакт.Метаданные().ПолноеИмя();
	
	// БИТ_ЖКХ 30.09.2014
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Пользователи.Ссылка,
	|	Пользователи.Наименование
	|ИЗ
	|	Справочник.Пользователи КАК Пользователи
	|ГДЕ
	|	Пользователи.Наименование = &Контакт";
	
	Запрос.УстановитьПараметр("Контакт", Контакт.Наименование);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Контакт = ВыборкаДетальныеЗаписи.Ссылка;
		
	КонецЦикла;
	
	Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Пользователи")  Тогда
		
		// ИмяТаблицыКИ = "КонтактнаяИнформация";.
		
		// БИТ_ЖКХ 30.09.2014
		// ВидКИ        = Справочники.ВидыКонтактнойИнформации.СлужебныйАдресЭлектроннойПочтыПользователя;.
		ВидКИ        = Справочники.ВидыКонтактнойИнформации.EmailПользователя;
		// БИТ_ЖКХ 30.09.2014
		
		ТипКИ        = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ПользователиКонтактнаяИнформация.Ссылка,
		|	ПользователиКонтактнаяИнформация.Тип,
		|	ПользователиКонтактнаяИнформация.Вид,
		|	ПользователиКонтактнаяИнформация.Представление,
		|	ПользователиКонтактнаяИнформация.АдресЭП
		|ИЗ
		|	Справочник.Пользователи.КонтактнаяИнформация КАК ПользователиКонтактнаяИнформация
		|ГДЕ
		|	ПользователиКонтактнаяИнформация.Тип = &ТипКИ
		|	И ПользователиКонтактнаяИнформация.Вид = &ВидКИ
		|	И ПользователиКонтактнаяИнформация.Ссылка = &Контакт";
		
		Запрос.УстановитьПараметр("ВидКИ", ВидКИ);
		Запрос.УстановитьПараметр("Контакт", Контакт);
		Запрос.УстановитьПараметр("ТипКИ", ТипКИ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	ИначеЕсли ТипЗнч(Контакт) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		
		ТипКИ        = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ФизическиеЛицаКонтактнаяИнформация.Ссылка,
		|	ФизическиеЛицаКонтактнаяИнформация.Тип,
		|	ФизическиеЛицаКонтактнаяИнформация.Вид,
		|	ФизическиеЛицаКонтактнаяИнформация.Представление,
		|	ФизическиеЛицаКонтактнаяИнформация.АдресЭП
		|ИЗ
		|	Справочник.ФизическиеЛица.КонтактнаяИнформация КАК ФизическиеЛицаКонтактнаяИнформация
		|ГДЕ
		|	ФизическиеЛицаКонтактнаяИнформация.Тип = &ТипКИ
		|	И ФизическиеЛицаКонтактнаяИнформация.Ссылка = &Контакт";
		
		Запрос.УстановитьПараметр("ТипКИ", ТипКИ);
		Запрос.УстановитьПараметр("Контакт", Контакт);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	Иначе
		
		ИмяТаблицыКИ = "бит_КонтактнаяИнформация";
//   10.10.2018		
//		ВидКИ        = Справочники.бит_ВидыКонтактнойИнформации.EmailПроживающего;
		ВидКИ        = Справочники.ВидыКонтактнойИнформации.EmailПроживающего;

		ТипКИ        = Перечисления.бит_ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПроживающиеКонтактнаяИнформация.Ссылка,
		|	бит_ПроживающиеКонтактнаяИнформация.Тип,
		|	бит_ПроживающиеКонтактнаяИнформация.Вид,
		|	бит_ПроживающиеКонтактнаяИнформация.Представление,
		|	бит_ПроживающиеКонтактнаяИнформация.АдресЭП
		|ИЗ
		|	Справочник.бит_Проживающие.КонтактнаяИнформация КАК бит_ПроживающиеКонтактнаяИнформация
		|ГДЕ
		|	бит_ПроживающиеКонтактнаяИнформация.Тип = &ТипКИ
		|	И бит_ПроживающиеКонтактнаяИнформация.Вид = &ВидКИ
		|	И бит_ПроживающиеКонтактнаяИнформация.Ссылка = &Контакт";
		
		Запрос.УстановитьПараметр("ВидКИ", ВидКИ);
		Запрос.УстановитьПараметр("Контакт", Контакт);
		Запрос.УстановитьПараметр("ТипКИ", ТипКИ);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
	КонецЕсли; 
	
	Если Не ВыборкаДетальныеЗаписи.Следующий() Тогда
		Если ТипЗнч(Контакт) = Тип("СправочникСсылка.бит_Проживающие") Тогда
			
			Адреса = Новый Структура("Наименование,Адреса", Контакт.Наименование, Новый СписокЗначений);
			Адреса.Адреса.Добавить(Контакт.EmailПроживающего);
			
		Иначе	
			
			Возврат Неопределено;
		КонецЕсли;
		
	Иначе
		
		Адреса = Новый Структура("Наименование,Адреса", ВыборкаДетальныеЗаписи.Ссылка.Наименование, Новый СписокЗначений);
		Адреса.Адреса.Добавить(ВыборкаДетальныеЗаписи.АдресЭП);
		
	КонецЕсли;
	
	Возврат Адреса;
	
КонецФункции

// Динамически формирует общие формы "Адресная книга" и "Подбор контактов" согласно возможным типам контактов.
//
&НаСервере
Процедура ДобавитьСтраницыФормыПодбораКонтактов()
	
	ОписаниеТипаДинамическийСписок = Новый ОписаниеТипов("ДинамическийСписок");
	
	ДобавляемыеРеквизиты = Новый Массив;
	МассивОписанийВозможныхКонтактов = бит_УправлениеЭлектроннойПочтойСервер.ПолучитьМассивОписанияВозможныхКонтактов();
	
	// Создадим динамические списки.
	Для каждого ЭлементМассиваОписания Из МассивОписанийВозможныхКонтактов Цикл
		Если ЭлементМассиваОписания.Имя = "Пользователи" Тогда
			Продолжить;
		КонецЕсли;
		
		ДобавляемыеРеквизиты.Добавить(
		Новый РеквизитФормы("Список_" + ЭлементМассиваОписания.Имя ,ОписаниеТипаДинамическийСписок));
		
	КонецЦикла;
	
	ЭтаФорма.ИзменитьРеквизиты(ДобавляемыеРеквизиты);
	
	// Установим в динамические списки основные таблицы и обязательное использование реквизита ЭтоГруппа.
	Для каждого ЭлементМассиваОписания Из МассивОписанийВозможныхКонтактов Цикл
		Если ЭлементМассиваОписания.Имя = "Пользователи" Тогда
			Продолжить;
		КонецЕсли;
		
		ЭтаФорма["Список_" + ЭлементМассиваОписания.Имя].ОсновнаяТаблица = "Справочник." + ЭлементМассиваОписания.Имя;
		
	КонецЦикла;
	
	Для каждого ЭлементМассиваОписания Из МассивОписанийВозможныхКонтактов Цикл
		Если ЭлементМассиваОписания.Имя = "Пользователи" Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЭлементМассиваОписания.ЕстьВладелец  Тогда
			
			ЭлементСтраница = ЭтаФорма.Элементы.Добавить(
			"Страница_" + ЭлементМассиваОписания.Имя,Тип("ГруппаФормы"),ЭтаФорма.Элементы.СтраницыСписки);
			ЭлементСтраница.Вид                  = ВидГруппыФормы.Страница;
			ЭлементСтраница.ОтображатьЗаголовок  = Истина;
			ЭлементСтраница.Заголовок            = ЭлементМассиваОписания.Представление;
			ЭлементСтраница.Группировка          = ГруппировкаПодчиненныхЭлементовФормы.Вертикальная;
			
		КонецЕсли;
		
		ЭлементТаблица = ЭтаФорма.Элементы.Добавить("Таблица_" + ЭлементМассиваОписания.Имя,
		Тип("ТаблицаФормы"),
		ЭтаФорма.Элементы[?(ЭлементМассиваОписания.ЕстьВладелец,
		"Страница_" + ЭлементМассиваОписания.ИмяВладельца,
		"Страница_" + ЭлементМассиваОписания.Имя)]);
		ЭлементТаблица.ПутьКДанным = "Список_" + ЭлементМассиваОписания.Имя;
		ЭлементТаблица.УстановитьДействие("Выбор","СписокСправочникаВыбор");
		Если ЭтаФорма.ИмяФормы = "ОбщаяФорма.ВыборКонтакта" Тогда
			ЭлементТаблица.РежимВыделения = РежимВыделенияТаблицы.Одиночный;
			ЭлементТаблица.УстановитьДействие("ПриАктивизацииСтроки","Подключаемый_СписокКонтактыПриАктивизацииСтроки");
		КонецЕсли;
		Если ЭлементМассиваОписания.ЕстьВладелец Тогда
			ЭтаФорма.Элементы["Таблица_" + ЭлементМассиваОписания.ИмяВладельца].УстановитьДействие(
			"ПриАктивизацииСтроки","Подключаемый_СписокВладелецПриАктивизацииСтроки");
			ЭлементОтбора = ЭтаФорма["Список_" + ЭлементМассиваОписания.Имя].Отбор.Элементы.Добавить(
			Тип("ЭлементОтбораКомпоновкиДанных"));
			ЭлементОтбора.ЛевоеЗначение = Новый ПолеКомпоновкиДанных("Владелец");
		КонецЕсли;
		
		КолонкаСсылка = ЭтаФорма.Элементы.Добавить(
		"Колонка_" + ЭлементМассиваОписания.Имя + "_Ссылка",Тип("ПолеФормы"),ЭлементТаблица);
		КолонкаСсылка.Вид = ВидПоляФормы.ПолеВвода;
		КолонкаСсылка.ПутьКДанным = "Список_" + ЭлементМассиваОписания.Имя + ".Ссылка";
		КолонкаСсылка.ПоложениеЗаголовка = ПоложениеЗаголовкаЭлементаФормы.Нет;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуПолучателей()
	
	табПолучатели = РеквизитФормыВЗначение("ПолучателиПисьма");
	
	Для Каждого ГруппаВыбранных Из Параметры.СписокВыбранных Цикл
		Если ГруппаВыбранных.Значение <> Неопределено Тогда
			Для Каждого Элемент Из ГруппаВыбранных.Значение Цикл
				НоваяСтрока = табПолучатели.Добавить();
				НоваяСтрока.Группа = ГруппаВыбранных.Представление;
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Элемент);
			КонецЦикла;
		КонецЕсли;
	КонецЦикла;
	
	табПолучатели.Сортировать("Группа");
	
	ЗначениеВРеквизитФормы(табПолучатели, "ПолучателиПисьма");
	
КонецПроцедуры

// Добавляет строку в таблицу "Получатели письма" и заполняет ее согласно переданным параметрам.
//
// Параметры:
//  Адрес        - Строка - адрес электронной почты.
//  Наименование - Строка - Представление адресата.
//  Контакт      - СправочникСсылка - контакт получатель.
//
&НаКлиенте
Процедура ДобавитьПолучателя(Адрес, Наименование, Контакт,СписокАдресов = "")
	
	НоваяСтрока = ПолучателиПисьма.Добавить();
	НоваяСтрока.Адрес         = Адрес;
	НоваяСтрока.Представление = Наименование;
	НоваяСтрока.Контакт       = Контакт;
	НоваяСтрока.СписокАдресов = СписокАдресов;
	НоваяСтрока.Группа        = ГруппаПоУмолчанию;
	
КонецПроцедуры

// Изменяет группу получателей письма.
//
// Параметры:
//  ИмяГруппы  - Строка - имя группы, которое будет установлено выделенным получателям письма.
//
&НаКлиенте
Процедура ИзменитьГруппу(ИмяГруппы)
	
	Для Каждого ВыделеннаяСтрока Из Элементы.ПолучателиПисьма.ВыделенныеСтроки Цикл
		Элемент = ПолучателиПисьма.НайтиПоИдентификатору(ВыделеннаяСтрока);
		Элемент.Группа = ИмяГруппы;
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПеренестиВыделенныеСтроки(ЗНАЧ ВыделенныеСтроки)
	
	// БИТ_ЖКХ 29.10.2014
	КС = Новый КвалификаторыСтроки(20);
	Массив = Новый Массив;
	Массив.Добавить(Тип("Строка"));
	ОписаниеТиповС = Новый ОписаниеТипов(Массив, , КС);
	
	Массив = Новый Массив;
	Массив.Добавить(Тип("СправочникСсылка.бит_Проживающие"));
	Массив.Добавить(Тип("СправочникСсылка.ФизическиеЛица"));
	ОписаниеТиповКонтакт = Новый ОписаниеТипов(Массив, , );
	
	Результат = Новый ТаблицаЗначений;
	Результат.Колонки.Добавить("Адрес",             ОписаниеТиповС);
	Результат.Колонки.Добавить("Группа"    ,        ОписаниеТиповС);
	Результат.Колонки.Добавить("Контакт",           ОписаниеТиповКонтакт);
	Результат.Колонки.Добавить("Представление"    , ОписаниеТиповС);
	Результат.Колонки.Добавить("СписокАдресов"    , ОписаниеТиповС);
	
	Для Каждого Строка из ВыделенныеСтроки Цикл
		
		Если Строка.КонтактнаяИнформация.Количество() > 0 Тогда
			
			Отбор = Новый Структура;
			//9.11.2018
//			Отбор.Вставить("Вид",ПредопределенноеЗначение("Справочник.бит_ВидыКонтактнойИнформацииЖКХ.EmailПроживающего"));
			Отбор.Вставить("Вид",ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.EmailПроживающего"));

			
			Строки = Строка.КонтактнаяИнформация.НайтиСтроки(Отбор);
			
			Если Строки.количество() = 0 Тогда
				
				Отбор = Новый Структура;
				Отбор.Вставить("Тип",ПредопределенноеЗначение("Перечисление.ТипыКонтактнойИнформации.АдресЭлектроннойПочты"));
				
				Строки = Строка.КонтактнаяИнформация.НайтиСтроки(Отбор);
				
				Если Строки.количество() = 0 Тогда
					
				Иначе
					
					НоваяСтрока = Результат.Добавить();
					НоваяСтрока.Адрес = Строки[0].АдресЭП;
					НоваяСтрока.Группа = ГруппаПоУмолчанию;
					НоваяСтрока.Контакт = Строка.Ссылка;
					НоваяСтрока.Представление = Строки[0].Представление;
					НоваяСтрока.СписокАдресов = Строки[0].Представление;
					
				КонецЕсли;	
				
			Иначе
				
				НоваяСтрока = Результат.Добавить();
				НоваяСтрока.Адрес = Строки[0].АдресЭП;
				НоваяСтрока.Группа = ГруппаПоУмолчанию;
				НоваяСтрока.Контакт = Строка.Ссылка;
				НоваяСтрока.Представление = Строки[0].Представление;
				НоваяСтрока.СписокАдресов = Строки[0].Представление;
				
			КонецЕсли;		
			
		КонецЕсли;	
		
	КонецЦикла;
	
	ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(Результат, ПолучателиПисьма);
	// БИТ_ЖКХ 29.10.2014
	
КонецПроцедуры

&НаСервере
Процедура УстановитьГруппуПоУмолчанию()
	
	Если Параметры.Свойство("ГруппаПоУмолчанию") Тогда
		ГруппаПоУмолчанию = Параметры.ГруппаПоУмолчанию;
	КонецЕсли;
	Если ПустаяСтрока(ГруппаПоУмолчанию) Тогда
		ГруппаПоУмолчанию = НСтр("ru = 'Кому'");
	КонецЕсли;
	
КонецПроцедуры 

&НаКлиенте
Процедура УправлениеСтраницами()
	
	Если Элементы.СтраницыСписки.ТекущаяСтраница = Элементы.СтраницаПользователей Тогда
		Элементы.СтраницыПереместить.ТекущаяСтраница = Элементы.СтраницаПереместитьДвеТаблицы;
	Иначе
		Элементы.СтраницыПереместить.ТекущаяСтраница = Элементы.СтраницаПереместитьОднаТаблица;
	КонецЕсли; 
	
КонецПроцедуры 

// Получает адреса электронной почты контакта.
//
// Параметры:
//  Контакт - Ссылка - контакт, для которого получаются данные.
//
// Возвращаемое значение:
//  Массив - массив структур содержащих адреса, виды и представления адресов.
//
&НаСервере
Функция ПолучитьАдресаЭлектроннойПочтыКонтакта(Контакт)
	
	Если Не ЗначениеЗаполнено(Контакт) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	ИмяТаблицы = Контакт.Метаданные().ПолноеИмя();
	
	Если ТипЗнч(Контакт) = Тип("СправочникСсылка.Пользователи")
		ИЛИ ТипЗнч(Контакт) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		
		ИмяТаблицыКИ = "КонтактнаяИнформация";
		
		// БИТ_ЖКХ 30.09.2014
		// ВидКИ        = Справочники.ВидыКонтактнойИнформации.СлужебныйАдресЭлектроннойПочтыПользователя;.
		ВидКИ        = Справочники.ВидыКонтактнойИнформации.EmailПользователя;
		// БИТ_ЖКХ 30.09.2014
		
		ТипКИ        = Перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		
	Иначе
		
		ИмяТаблицыКИ = "бит_КонтактнаяИнформация";
		ВидКИ        = Справочники.бит_ВидыКонтактнойИнформации.EmailПроживающего;
		ТипКИ        = Перечисления.бит_ТипыКонтактнойИнформации.АдресЭлектроннойПочты;
		
	КонецЕсли; 
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Представление  
	|ПОМЕСТИТЬ КонтактнаяИнформация
	|ИЗ
	|	РегистрСведений."+ИмяТаблицыКИ+" КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Контакт
	|	И КонтактнаяИнформация.Тип = &ТипКИ
	|	И КонтактнаяИнформация.Вид = &ВидКИ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Контакты.Наименование,
	|	ЕстьNull(КонтактнаяИнформация.Представление, """") КАК АдресЭП
	|ИЗ
	|	" +ИмяТаблицы+ " КАК Контакты
	|		ЛЕВОЕ СОЕДИНЕНИЕ КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО Контакты.Ссылка = КонтактнаяИнформация.Объект
	|ГДЕ
	|	Контакты.Ссылка = &Контакт;
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КонтактнаяИнформация";
	
	Запрос.УстановитьПараметр("Контакт", Контакт);
	Запрос.УстановитьПараметр("ВидКИ"  , ВидКИ);
	Запрос.УстановитьПараметр("ТипКИ"  , ТипКИ);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		Возврат Новый Массив;
	КонецЕсли;
	
	Результат = Новый Массив;
	Пока Выборка.Следующий() Цикл
		Адрес = Новый Структура;
		Адрес.Вставить("АдресЭП",         Выборка.АдресЭП);
		Адрес.Вставить("Представление",   Выборка.Наименование);
		Результат.Добавить(Адрес);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции

#КонецОбласти