&НаКлиенте
Процедура ВыборЧекаВозвратаЗавершение(ВыбранныйЧек, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(ВыбранныйЧек) Тогда
		Объект.ЧекОснование = ВыбранныйЧек;
	Иначе
		Возврат;
	КонецЕсли; 
	
	ЗаполнитьЧекНаСервере();
	
	УстановитьДосутпность();
	УстановитьВидимость();
	
	ЭтаФорма.ОбновитьОтображениеДанных(Элементы.Услуги);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьЧекНаСервере()
	
	РеквизитыЧекОснование = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ЧекОснование
		, "СуммаОплаты, ЛицевойСчет, ШаблонИзвещений, Касса, Итого, Плательщик, Услуги, БиллинговыеУслуги, СуммаВключаетНДС, ДокументБезНДС");
	
	Объект.СуммаОплаты		= РеквизитыЧекОснование.СуммаОплаты;
	Объект.ЛицевойСчет		= РеквизитыЧекОснование.ЛицевойСчет;
	Объект.ШаблонИзвещений	= РеквизитыЧекОснование.ШаблонИзвещений;
	Объект.Касса			= РеквизитыЧекОснование.Касса;
	Объект.Организация		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.Касса, "Владелец"); 
	Объект.Итого			= РеквизитыЧекОснование.СуммаОплаты;
	Объект.Плательщик		= РеквизитыЧекОснование.Плательщик;
	Объект.СуммаВключаетНДС = РеквизитыЧекОснование.СуммаВключаетНДС;
	Объект.ДокументБезНДС	= РеквизитыЧекОснование.ДокументБезНДС;
	
	Объект.Услуги.Очистить();
	ТЗ = РеквизитыЧекОснование.Услуги.Выгрузить();
	Объект.Услуги.Загрузить(ТЗ);
	
	Объект.БиллинговыеУслуги.Очистить();
	ТЗ = РеквизитыЧекОснование.БиллинговыеУслуги.Выгрузить();
	Объект.БиллинговыеУслуги.Загрузить(ТЗ);
	
	ЗаполнениеСправочнойИнформации(Объект.ЛицевойСчет);

КонецПроцедуры

#КонецОбласти

&НаСервере
Процедура ПодготовитьФормуНаСервере()

	Если ПравоДоступа("Чтение", Метаданные.Справочники.ПодключаемоеОборудование) Тогда
		ИспользуютсяСканерыШтрихкода = (МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам("СканерШтрихкода").Количество() > 0);
	Иначе
		ИспользуютсяСканерыШтрихкода = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , "");
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборЧекаККМВозврата()
	
	ПараметрыОтбора = Новый Структура;
	Отбор = Новый Структура;
	
	Отбор.Вставить("Архивный", Ложь);
	Отбор.Вставить("Касса", Объект.Касса);
	Отбор.Вставить("Ответственный", Объект.Ответственный);
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат") Тогда
		
		Отбор.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Продажа"));
	ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.ВозвратВнешнийБиллинг") Тогда
		
		Отбор.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.ПродажаВнешнийБиллинг"));
	КонецЕсли; 
	Отбор.Вставить("ЧекПробитНаККМ", Истина);
	
	ПараметрыОтбора.Вставить("Отбор", Отбор);
	ОткрытьФорму("Документ.бит_ЧекККМ.ФормаВыбора", ПараметрыОтбора, ЭтаФорма,ЭтаФорма.УникальныйИдентификатор,,,Новый ОписаниеОповещения("ВыборЧекаВозвратаЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьОкноВладельца);
	
КонецПроцедуры

&НаСервере 
Процедура ВводВручнуюПриИзмененииСервер()
	
	мКоммунальныеУслуги = Объект.Услуги.Выгрузить();
	ПерезагрузитьТаблицуУслуг(мКоммунальныеУслуги);
	Объект.Услуги.Загрузить(мКоммунальныеУслуги);
	
	ОбновитьОкноИнформации();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаКассаПриИзменении()
	
	Объект.КодКассы = ЗначениеРеквизитаНаСервере(Объект.Касса, "КодКассы");
	
	Объект.КодПачки = "" + Объект.КодКассы + "" + Формат(День(Объект.Дата),"ЧЦ=2; ЧВН=") + "" +Формат(Месяц(Объект.Дата),"ЧЦ=2; ЧВН=");
	
	Если Объект.ЧекПробитНаККМ Тогда
		Элементы.Чек.Доступность    = Ложь;
		//Элементы.Пречек.Доступность = Ложь;
	Иначе
		Элементы.Чек.Доступность    = Истина;
		//Элементы.Пречек.Доступность = Истина;
	КонецЕсли;
		
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКассуОрганизации(Организация)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_КассыККМ.Ссылка КАК КассаККМ
	               |ИЗ
	               |	Справочник.бит_КассыККМ КАК бит_КассыККМ
	               |ГДЕ
	               |	НЕ бит_КассыККМ.ПометкаУдаления
	               |	И бит_КассыККМ.Владелец = &Организация
	               |	И НЕ бит_КассыККМ.ПодразделениеОрганизации = ЗНАЧЕНИЕ(Справочник.бит_ПодразделенияОрганизаций.ПустаяСсылка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	бит_КассыККМ.Код";
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КассаККМ;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ПриИзмененииЛицевогоСчет_Услуги()
	
	Если ЗначениеЗаполнено(объект.ШаблонИзвещений) И ЗначениеЗаполнено(Объект.ЛицевойСчет)Тогда
		РасчетУслуг();
	КонецЕсли; 
	
	мТаблицаНачисленийПени.Очистить();
	
	ПолучитьНачисленияПени();
	
	Итог = Объект.Услуги.Итог("СуммаПени");
	
	Элементы.УслугиСуммаПени.Видимость       = ?(Итог <> 0 ИЛИ Объект.ВводВручную, Истина, Ложь);
	Элементы.УслугиДеревоСуммаПени.Видимость = ?(Итог <> 0 ИЛИ Объект.ВводВручную, Истина, Ложь);
	
КонецПроцедуры

// Процедура выполняет расчет сумм услуг табличной части "Услуги".
//
// Параметры
//   Нет.
//
&НаКлиенте
Процедура РасчетУслуг(ВводПоказаний = Ложь)
	
	Если НЕ мКэшЗначений.НуженПерерасчет Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	Объект.Услуги.Очистить();
	Объект.БиллинговыеУслуги.Очистить();
	мСписокЛС.Очистить();
	
	Строка = мСписокЛС.Добавить();
	
	Строка.ЛицевойСчет     = Объект.ЛицевойСчет;
	Строка.ШаблонИзвещений = Объект.ШаблонИзвещений;
	Строка.Сумма           = Объект.СуммаОплаты;
	
	ЗаполнитьУслугиНаСервере();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУслугиНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект,Тип("ДокументОбъект.бит_ЧекККМ"));
	
	мКоммунальныеУслуги = ДокументОбъект.Услуги.ВыгрузитьКолонки();
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("РасчетСУчетомДолейВладения"								, Ложь);
	ПараметрыЖКХ.Вставить("УменьшениеНормыЛьготыВПределахФакта"						, Ложь);
	ПараметрыЖКХ.Вставить("ЛьготаПерсонифицированная"								, Ложь);
	ПараметрыЖКХ.Вставить("НачислениеСУчетомДнейПроживания"							, Ложь);
	ПараметрыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика"	, Ложь);
	ПараметрыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	ПараметрыЖКХ.Вставить("НачислятьПениСУчетомПереплаты"							, Ложь);
	ПараметрыЖКХ.Вставить("ВариантРасчетаНДС"										, Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Объект.Дата),  Объект.Организация, ПараметрыЖКХ);
	
	Если НЕ ЗначениеЗаполнено(ПараметрыЖКХ.ВариантРасчетаНДС) Тогда
		ПараметрыЖКХ.ВариантРасчетаНДС = Перечисления.ВариантыРасчетаНДС.НДСВСумме;
	КонецЕсли; 
	
	Если ПараметрыЖКХ.ВариантРасчетаНДС = ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.ДокументБезНДС") Тогда 
		Объект.ДокументБезНДС	= Истина;
		//НДСНеВыделять			= Ложь;
		Объект.СуммаВключаетНДС	= Истина;
		//27.12.2018
		ЭтаФорма.Элементы.УслугиСтавкаНДС.АвтоОтметкаНезаполненного = Ложь;
		ЭтаФорма.Элементы.УслугиСуммаНДС.АвтоОтметкаНезаполненного = Ложь;
		ЭтаФорма.Элементы.УслугиСтавкаНДС.АвтоВыборНезаполненного = Ложь;
		ЭтаФорма.Элементы.УслугиСтавкаНДС.АвтоВыборНезаполненного = Ложь;

	ИначеЕсли ПараметрыЖКХ.ВариантРасчетаНДС = ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.НДСНеВыделять") Тогда 
		Объект.ДокументБезНДС	= Ложь;
		//НДСНеВыделять			= Истина;
		Объект.СуммаВключаетНДС	= Истина;
	ИначеЕсли ПараметрыЖКХ.ВариантРасчетаНДС = ПредопределенноеЗначение("Перечисление.ВариантыРасчетаНДС.НДСВСумме") Тогда 
		Объект.ДокументБезНДС	= Ложь;
		//НДСНеВыделять			= Ложь;
		Объект.СуммаВключаетНДС	= Истина;
	Иначе
		Объект.ДокументБезНДС	= Ложь;
		//НДСНеВыделять			= Ложь;
		Объект.СуммаВключаетНДС	= Ложь;
	КонецЕсли;
	
	лРасчетСУчетомДолейВладения          = ПараметрыЖКХ.РасчетСУчетомДолейВладения;
	лУменьшениеНормыЛьготыВПределахФакта = ПараметрыЖКХ.УменьшениеНормыЛьготыВПределахФакта;
	лЛьготаПерсонифицированная           = ПараметрыЖКХ.ЛьготаПерсонифицированная;
	лНачислениеСУчетомДнейПроживания     = ПараметрыЖКХ.НачислениеСУчетомДнейПроживания;
	лРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика  = ПараметрыЖКХ.РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика;
	лРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика  = ПараметрыЖКХ.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика;
	лНачислятьПениСУчетомПереплаты		 = ПараметрыЖКХ.НачислятьПениСУчетомПереплаты;
	
	СписокЛС = ДанныеФормыВЗначение(мСписокЛС,Тип("ТаблицаЗначений"));
	
	бит_ОбщегоНазначения.РаспределениеСуммПоОплате(Объект.Дата,
													Объект.Организация,
													СписокЛС,
													мКоммунальныеУслуги,
													лЛьготаПерсонифицированная,
													лРасчетСУчетомДолейВладения,
													лУменьшениеНормыЛьготыВПределахФакта,
													лНачислениеСУчетомДнейПроживания,
													лРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика,
													лРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
													лНачислятьПениСУчетомПереплаты);
	
	Объект.Услуги.Загрузить(мКоммунальныеУслуги);
	
	Если Объект.ВводВручную Тогда
		
		Для каждого Строка Из Объект.Услуги Цикл
			
			Строка.Сумма     = 0;
			Строка.СуммаПени = 0;
			
		КонецЦикла;
		
		Элементы.УслугиСуммаПени.Видимость = Истина;
		
	Иначе
		
		УстановитьВидимостьКолонкиПени();
		
	КонецЕсли; 
	
	УменьшитьСумму();
	
	ЗаполнитьТаблицуДолга();
	
	Если Объект.ЛицевойСчет.ОтображатьПоГруппам Тогда
		
		СформироватьДеревоУслуг();
		
	КонецЕсли; 
	
	СуммаУслуга       = 0;
	СуммаСУчПереплаты = 0;
	
	Для каждого Строка Из Объект.Услуги Цикл
		
		Если Строка.Долг >0 Тогда
			
			СуммаУслуга = СуммаУслуга + Строка.Долг;
			
		КонецЕсли;
		
		СуммаСУчПереплаты = СуммаСУчПереплаты + Строка.Долг;
		
	КонецЦикла; 
	
	Элементы.УслугиДолг.ТекстПодвала = Строка(СуммаУслуга)+"
	|" + Строка(СуммаСУчПереплаты);
	
	СуммаУслуга       = 0;
	СуммаСУчПереплаты = 0;
	
	
	мУслугиДерево = ДанныеФормыВЗначение(УслугиДерево,Тип("ДеревоЗначений")); 
	
	Для каждого Строка Из мУслугиДерево.Строки Цикл
		
		Если Строка.Долг >0 Тогда
			
			СуммаУслуга = СуммаУслуга + Строка.Долг;
			
		КонецЕсли; 
		
		СуммаСУчПереплаты = СуммаСУчПереплаты + Строка.Долг;
		
	КонецЦикла; 
	
	Если Не Объект.ВводВручную Тогда
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.бит_ЧекККМ"));
		
		ДокументОбъект.УдалитьПустыеСтроки();
		
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
		
	КонецЕсли; 
	
	Элементы.УслугиДеревоДолг.ТекстПодвала = Строка(СуммаУслуга)+"
	|" + Строка(СуммаСУчПереплаты);
	
	мКэшЗначений.НуженПерерасчет = Ложь;
	
КонецПроцедуры

// Процедура получает таблицу начислений пени.
//
&НаСервере
Процедура ПолучитьНачисленияПени()
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачислениеПениПоУслугамЖКХОстатки.ЛицевойСчет,
	|	бит_НачислениеПениПоУслугамЖКХОстатки.УслугаЖКХ КАК Услуга,
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(бит_НачислениеПениПоУслугамЖКХОстатки.СуммаПениОстаток, 0) - ЕСТЬNULL(НачислениеКасс.СуммаПениОборот, 0) < 0
	|				ТОГДА 0
	|			ИНАЧЕ ЕСТЬNULL(бит_НачислениеПениПоУслугамЖКХОстатки.СуммаПениОстаток, 0) - ЕСТЬNULL(НачислениеКасс.СуммаПениОборот, 0)
	|		КОНЕЦ) КАК СуммаПени,
	|	бит_НачислениеПениПоУслугамЖКХОстатки.УслугаЖКХ.ГруппаУслуги КАК ГруппаУслуги
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Остатки(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачислениеПениПоУслугамЖКХОстатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_НачисленияКассОбороты.Услуга КАК Услуга,
	|			СУММА(бит_НачисленияКассОбороты.СуммаПениОборот) КАК СуммаПениОборот
	|		ИЗ
	|			РегистрНакопления.бит_НачисленияКасс.Обороты(
	|					&ДатаНач,
	|					&ДатаКон,
	|					,
	|					КассаККМ = &КассаККМ
	|						И ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияКассОбороты
	|		
	|		СГРУППИРОВАТЬ ПО
	|			бит_НачисленияКассОбороты.Услуга) КАК НачислениеКасс
	|		ПО бит_НачислениеПениПоУслугамЖКХОстатки.УслугаЖКХ = НачислениеКасс.Услуга
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеПениПоУслугамЖКХОстатки.ЛицевойСчет,
	|	бит_НачислениеПениПоУслугамЖКХОстатки.УслугаЖКХ";
	
	Запрос.УстановитьПараметр("Дата"       , Объект.Дата);
	Запрос.УстановитьПараметр("ДатаНач"    , НачалоДня(Объект.Дата));
	Запрос.УстановитьПараметр("ДатаКон"    , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("КассаККМ"   , Объект.Касса);
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если мТаблицаНачисленийПени.Количество() = 0 Тогда
		
		ТаблицаНачисленийПени = Запрос.Выполнить().Выгрузить();
		
	КонецЕсли; 
	
	Отбор = Новый Структура;
	
	Пока Выборка.Следующий() Цикл
		
		Отбор.Очистить();
		
		Отбор.Вставить("ЛицевойСчет", Выборка.ЛицевойСчет);
		Отбор.Вставить("Услуга"     , Выборка.Услуга);
		
		МассивСтрок = ТаблицаНачисленийПени.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() > 0 Тогда
			
			Если МассивСтрок[0].СуммаПени <> Выборка.СуммаПени Тогда
				
				МассивСтрок[0].СуммаПени = Выборка.СуммаПени;	
				
			КонецЕсли; 	
			
		Иначе
			
			НоваяСтрока = мТаблицаНачисленийПени.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	ЗначениеВДанныеФормы(ТаблицаНачисленийПени,мТаблицаНачисленийПени);
	
КонецПроцедуры 

&НаКлиенте
Процедура ПриИзмененииЛицевогоСчет_БиллинговыеУслуги()
	
	Объект.Услуги.Очистить();
	ЗаполнитьБиллинговымиУслугами();
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьБиллинговымиУслугами()
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	
	ПостроительЗапроса.Параметры.Вставить("Момент"     , КонецДня(объект.Дата));
	ПостроительЗапроса.Параметры.Вставить("Организация", объект.Организация);
	ПостроительЗапроса.Параметры.Вставить("ЛицевойСчет", объект.ЛицевойСчет);
	
	ПостроительЗапроса.Текст = 
	"ВЫБРАТЬ
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Услуга,
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Поставщик,
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Услуга.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ СведенияОбУслугах
	|ИЗ
	|	РегистрСведений.бит_бу_СведенияОБиллинговыхУслугах.СрезПоследних(
	|			&Момент,
	|			Организация = &Организация
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_бу_СведенияОБиллинговыхУслугахСрезПоследних
	|ГДЕ
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Использовать
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Услуга,
	|	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Поставщик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект КАК ПролучательДС,
	|	КонтактнаяИнформация.Поле3 КАК Телефон
	|ПОМЕСТИТЬ КонтактнаяИнформация
	|ИЗ
	|	РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	(КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|			ИЛИ КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонОрганизации))
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияОбУслугах.Услуга,
	|	бит_бу_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств,
	|	СведенияОбУслугах.Приоритет
	|ПОМЕСТИТЬ УслугиИПолучателиДС
	|ИЗ
	|	СведенияОбУслугах КАК СведенияОбУслугах
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_бу_ПолучателиДенежныхСредств.СрезПоследних(&Момент) КАК бит_бу_ПолучателиДенежныхСредствСрезПоследних
	|		ПО СведенияОбУслугах.Услуга = бит_бу_ПолучателиДенежныхСредствСрезПоследних.Услуга
	|			И СведенияОбУслугах.Поставщик = бит_бу_ПолучателиДенежныхСредствСрезПоследних.Поставщик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	УслугиИПолучателиДС.Услуга КАК Услуга,
	|	УслугиИПолучателиДС.ПолучательДенежныхСредств КАК ПолучательДС,
	|	КонтактнаяИнформация.Телефон,
	|	УслугиИПолучателиДС.Приоритет
	|{ВЫБРАТЬ
	|	Услуга.*}
	|ИЗ
	|	УслугиИПолучателиДС КАК УслугиИПолучателиДС
	|		ЛЕВОЕ СОЕДИНЕНИЕ КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ПО УслугиИПолучателиДС.ПолучательДенежныхСредств = КонтактнаяИнформация.ПролучательДС
	|{ГДЕ
	|	УслугиИПолучателиДС.Услуга.*}
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СведенияОбУслугах
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ КонтактнаяИнформация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ УслугиИПолучателиДС";
	
	ПостроительЗапроса.Выполнить();
	
	Если НЕ объект.ШаблонИзвещений = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам И объект.ШаблонИзвещений.Услуги.Количество() > 0 Тогда
		
		СписокУслуг = Новый СписокЗначений;
		СписокУслуг.ЗагрузитьЗначения(объект.ШаблонИзвещений.Услуги.ВыгрузитьКолонку("Услуга"));
		ПостроительЗапроса.Отбор.Добавить("Услуга");
		
		ПостроительЗапроса.Отбор["Услуга"].Использование = Истина;
		ПостроительЗапроса.Отбор["Услуга"].ВидСравнения  = ВидСравнения.ВСписке;
		ПостроительЗапроса.Отбор["Услуга"].Значение      = СписокУслуг;
		
	КонецЕсли; 
	
	
	КоммунальныеУслуги.Загрузить(ПостроительЗапроса.Результат.Выгрузить());
	
	КоммунальныеУслуги.Сортировать("Приоритет Возр");
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьВидимость()
	
	УстановитьРучнойВвод();
	
	Итог = объект.Услуги.Итог("СуммаПени");
	
	Элементы.Услуги.ПодчиненныеЭлементы.УслугиСуммаПени.Видимость = ?(Итог = 0 И НЕ Объект.ВводВручную, Ложь, Истина);
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат") Тогда
		
		Элементы.Услуги.ПодчиненныеЭлементы.УслугиДолг.Видимость = Ложь;
	Иначе
		
		Элементы.Услуги.ПодчиненныеЭлементы.УслугиДолг.Видимость = Истина;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьОкноИнформации()
	
	ОтображатьПоГруппам = ЗначениеРеквизитаНаСервере(Объект.ЛицевойСчет, "ОтображатьПоГруппам");
	Если ЗначениеЗаполнено(ОтображатьПоГруппам) И ОтображатьПоГруппам Тогда
		ТаблицаУслуг = РеквизитФормыВЗначение("УслугиДерево").Строки;	
	Иначе
		ТаблицаУслуг = Объект.Услуги; 
	КонецЕсли;
	
	СуммаУслуга       = 0;
	СуммаСУчПереплаты = 0;
	
	Для каждого Строка Из Объект.Услуги Цикл
		
		Если Строка.Долг >0 Тогда
			
			СуммаУслуга = СуммаУслуга + Строка.Долг;
			
		КонецЕсли;
		
		СуммаСУчПереплаты = СуммаСУчПереплаты + Строка.Долг;
		
	КонецЦикла; 
	
	Элементы.УслугиДолг.ТекстПодвала = Строка(СуммаУслуга)+"
	|" + Строка(СуммаСУчПереплаты);
	
	Если ТаблицаУслуг.Количество() > 0 Тогда
		
		Текст ="Сумма оплаты:" + Объект.СуммаОплаты;
		КонтрольнаяСумма = Объект.СуммаОплаты;
		ИтогСумма = ТаблицаУслуг.Итог("Сумма");
		ИтогПени  = ТаблицаУслуг.Итог("СуммаПени");
		Остаток = КонтрольнаяСумма - ИтогСумма - ИтогПени;
		
		Текст = Текст + "
		|Оплата услуг :" + ИтогСумма + ", Пени: "+ ИтогПени + 
		?(Остаток > 0, ". 
		|Не распределенная сумма оплаты: "+ Остаток ,".");
		
		Если Остаток < 0 Тогда
			Элементы.НадписьИнфоОбщ.ЦветТекста = Новый Цвет(255, 0, 0);		
			Текст = Текст + ". 
			|Распределенная сумма превышает сумму оплаты на: "+ Остаток * -1 +" !"
		Иначе
			Элементы.НадписьИнфоОбщ.ЦветТекста = Новый Цвет(0, 0, 0);
		КонецЕсли; 
		
		Элементы.НадписьИнфоОбщ.Заголовок = Текст;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьНовыйДокумент()
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Касса"      , Объект.Касса);
	ПараметрыФормы.Вставить("Организация", Объект.Организация);
	
	ОткрытьФорму("Документ.бит_ЧекККМ.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаЧекККМ", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

// Процедура создает новый документ "Ввод показаний по счетчикам" 
// и заполяет его на основе таблицы "Счетчики".
//
// Параметры
//   Нет.
//
&НаКлиенте
Процедура ВводПоказанийПоСчетчикам()
	
	ПроведениеДокумента = ПроведениеДокументаВводПоказанийПоСчетчикамНаСервере();
	
	Если ПроведениеДокумента Тогда
		
		Если ЗначениеЗаполнено(Объект.СуммаОплаты)
			И (Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Продажа")
			ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат"))Тогда
			
			РасчетУслуг(Истина);
		КонецЕсли;
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Дата"              , Объект.Дата - 60);
		ПараметрыФормы.Вставить("ВидОперации"       , ПредопределенноеЗначение("Перечисление.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний"));
		ПараметрыФормы.Вставить("Организация"       , Объект.Организация);
		ПараметрыФормы.Вставить("ЛицевойСчет"       , Объект.ЛицевойСчет);
		ПараметрыФормы.Вставить("Ответственный"     , Объект.Ответственный);
		ПараметрыФормы.Вставить("Улица"             , ЗначениеРеквизитаНаСервере(Объект.ЛицевойСчет, "УлицаЛицевогоСчета"));
		ПараметрыФормы.Вставить("ТипСчетчика"       , ПредопределенноеЗначение("Перечисление.бит_ТипСчетчика.Индивидуальный"));
		ПараметрыФормы.Вставить("ПоказанияНаселения", Истина);
		
		МассивСчетчиков = ПолучитьМассивСчетчиковНаСервере();
		
		ПараметрыФормы.Вставить("МассивСчетчиков", МассивСчетчиков);
		
		ОткрытьФорму("Документ.бит_ВводПоказанийПоСчетчикам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаЧекККМ", ПараметрыФормы), ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция Печать()
	
	ТабДокумент = Новый ТабличныйДокумент;
	
	Макет = Документы.бит_ЧекККМ.ПолучитьМакет("ТоварныйЧек");
	
	ОпластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОпластьШапка.Параметры.Номер       = Объект.Номер;
	ОпластьШапка.Параметры.КодКассы    = Объект.КодКассы;
	ОпластьШапка.Параметры.ЛицевойСчет = Объект.ЛицевойСчет;
	
	Если НЕ ЗначениеЗаполнено(Объект.Адрес) Тогда
		СпрИнфо = ПолучитьСправочнуюИнформацию(Объект.ЛицевойСчет, Объект.Дата);
		ОпластьШапка.Параметры.Адрес = СпрИнфо.Адрес;
	Иначе
		ОпластьШапка.Параметры.Адрес = Объект.Адрес;
	КонецЕсли;
	
	ТабДокумент.Вывести(ОпластьШапка);
	
	Для каждого Строка Из Объект.Услуги Цикл
		
		ОбластьСтрока.Параметры.НомерСтроки = Строка.НомерСтроки;
		ОбластьСтрока.Параметры.Услуга      = Строка.Услуга;
		ОбластьСтрока.Параметры.Сумма       = Строка.Сумма + Строка.СуммаПени;
		
		ТабДокумент.Вывести(ОбластьСтрока);
		
	КонецЦикла; 
	
	ОбластьПодвал.Параметры.Итого         = Объект.Услуги.Итог("Сумма") + Объект.Услуги.Итог("СуммаПени");
	ОбластьПодвал.Параметры.Получено      = Объект.Итого;
	ОбластьПодвал.Параметры.Сдача         = Объект.Сдача;
	ОбластьПодвал.Параметры.Ответственный = Объект.Ответственный;
	
	ТабДокумент.Вывести(ОбластьПодвал);
	
	Возврат ТабДокумент;
	
КонецФункции

// Процедура заполняет табличную часть счетчики.
//
// Параметры
//	Нет.
//
&НаСервере
Процедура ЗаполнениеТаблицыСчетчиков() 
	
	Объект.Счетчики.Очистить();
	
	Если НЕ ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"	, КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Объект"	, Объект.ЛицевойСчет);
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	               |	бит_СчетчикиНаУслугахСрезПоследних.Объект КАК Объект,
	               |	бит_СчетчикиНаУслугахСрезПоследних.Услуга КАК Услуга,
	               |	бит_СчетчикиНаУслугахСрезПоследних.Счетчик КАК Счетчик,
	               |	бит_СчетчикиНаУслугахСрезПоследних.Счетчик.Разрядность КАК Разрядность,
	               |	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0) КАК ПредыдущиеПоказания
	               |ИЗ
	               |	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	               |			&Дата,
	               |			(ВЫРАЗИТЬ(Объект КАК Справочник.бит_ЛицевыеСчета)) = &Объект
	               |				И Счетчик В
	               |					(ВЫБРАТЬ
	               |						бит_Счетчики.Ссылка
	               |					ИЗ
	               |						Справочник.бит_Счетчики КАК бит_Счетчики
	               |					ГДЕ
	               |						бит_Счетчики.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный))) КАК бит_СчетчикиНаУслугахСрезПоследних
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(&Дата, ) КАК бит_ПоказанияСчетчиковОстатки
	               |		ПО бит_СчетчикиНаУслугахСрезПоследних.Объект = бит_ПоказанияСчетчиковОстатки.Объект
	               |			И бит_СчетчикиНаУслугахСрезПоследних.Услуга = бит_ПоказанияСчетчиковОстатки.Услуга
	               |			И бит_СчетчикиНаУслугахСрезПоследних.Счетчик = бит_ПоказанияСчетчиковОстатки.Счетчик
	               |ГДЕ
	               |	бит_СчетчикиНаУслугахСрезПоследних.Использовать = ИСТИНА";
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл
		НовСтрока						= Объект.Счетчики.Добавить();
		НовСтрока.Счетчик				= Выборка.Счетчик;
		НовСтрока.Услуга				= Выборка.Услуга;
		НовСтрока.Разрядность			= Выборка.Разрядность;
		НовСтрока.ПредыдущиеПоказания	= Выборка.ПредыдущиеПоказания;
	КонецЦикла; 
	
	
КонецПроцедуры

// Процедура дополняет таблицу услуги получетелями денежных средств.
//
&НаСервере
Процедура ДополнитьТаблицуПолучателямиДС(Знач СписокУслуг)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПолучателиДС.Услуга,
	|	ПолучателиДС.ПолучательДенежныхСредств КАК ПолучательДС,
	|	ЕСТЬNULL(КонтактнаяИнформация.Телефон, """") КАК Телефон
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_ПолучателиДенежныхСредствСрезПоследних.Услуга КАК Услуга,
	|		бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств КАК ПолучательДенежныхСредств
	|	ИЗ
	|		РегистрСведений.бит_ПолучателиДенежныхСредств.СрезПоследних(&Дата, Услуга В (&Услуги)) КАК бит_ПолучателиДенежныхСредствСрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|				бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|				бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик
	|			ИЗ
	|				РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|						&Дата,
	|						ЛицевойСчет = &ЛицевойСчет
	|							И Услуга В (&Услуги)) КАК бит_СведенияПоУслугамЛССрезПоследних) КАК СведенияПоУслугам
	|			ПО бит_ПолучателиДенежныхСредствСрезПоследних.Услуга = СведенияПоУслугам.Услуга
	|				И бит_ПолучателиДенежныхСредствСрезПоследних.Поставщик = СведенияПоУслугам.Поставщик) КАК ПолучателиДС
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			КонтактнаяИнформация.Объект КАК ПролучательДС,
	|			КонтактнаяИнформация.Поле3 КАК Телефон
	|		ИЗ
	|			РегистрСведений.КонтактнаяИнформация КАК КонтактнаяИнформация
	|		ГДЕ
	|			(КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонКонтрагента)
	|					ИЛИ КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонОрганизации))
	|			И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)) КАК КонтактнаяИнформация
	|		ПО ПолучателиДС.ПолучательДенежныхСредств = КонтактнаяИнформация.ПролучательДС";
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("Услуги"     , СписокУслуг);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("Услуга", Выборка.Услуга);
		
		НайденыеСтроки = Объект.Услуги.НайтиСтроки(Отбор);
		
		Для каждого Строка Из НайденыеСтроки Цикл
			
			ЗаполнитьЗначенияСвойств(Строка, Выборка);
			
		КонецЦикла;   
		
	КонецЦикла; 
	
КонецПроцедуры

// Функция получает последную дата начислений по ЛС.
//
&НаСервереБезКонтекста
Функция ПериодНачислений(Дата)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", Дата);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_НачислениеПоЛицевымСчетам.Дата КАК Дата
	|ИЗ
	|	Документ.бит_НачислениеПоЛицевымСчетам КАК бит_НачислениеПоЛицевымСчетам
	|ГДЕ
	|	бит_НачислениеПоЛицевымСчетам.Дата < &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Дата;
	Иначе
		Возврат ДобавитьМесяц(Дата, -1);
	КонецЕсли; 
	
КонецФункции

&НаСервереБезКонтекста
Функция РСНаСервере(Организация)
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();	
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Владелец", Организация);
	Запрос.Текст = "ВЫБРАТЬ
	|	БанковскиеСчета.Ссылка
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &Владелец"; 
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка;
	Иначе
		Возврат Справочники.БанковскиеСчета.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции

// Процедура выполняет заполнения элементы формы стравочной информацией.
//
// Параметры
//   ЛС - СправочникСсылка.бит_ЛицевыеСчета - текущий лицевой счет.
//
&НаСервере
Процедура ЗаполнениеСправочнойИнформации(ЛС)
	
	ПараметрыЖКХ = Новый Структура;  
	
	ПараметрыЖКХ.Вставить("ПечатьПолучателейДС"                , Перечисления.бит_ВидыПечатиПолучателейДС.НеПечатать);
	ПараметрыЖКХ.Вставить("ГруппироватьУслугиВЧеке"            , Ложь);
	ПараметрыЖКХ.Вставить("ЛьготаПерсонифицированная"          , Ложь);
	ПараметрыЖКХ.Вставить("НеПечататьРайон"                    , Ложь);
	ПараметрыЖКХ.Вставить("ПрефиксУлица"                       , "ул.");
	ПараметрыЖКХ.Вставить("ПрефиксДом"                         , "д.");
	ПараметрыЖКХ.Вставить("ПрефиксКорпус"                      , "к.");
	ПараметрыЖКХ.Вставить("ПрефиксКвартира"                    , "кв.");
	ПараметрыЖКХ.Вставить("ПрефиксРайон"                       , "г.");
	
