&НаСервере
Процедура ДополнитьТаблицуИтоговПенями(МассивУчастков, МассивТиповКвартир, МассивАдресов)
	
	МассивНачислений = Новый Массив;
	МассивНачислений.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000001"));
	МассивНачислений.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000003"));
	МассивНачислений.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("000000004"));
	МассивНачислений.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001"));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ
	|ПОМЕСТИТЬ ВТ_ЛС
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Обороты(, &ДатаОкончания, , УслугаЖКХ В (&Начисления)) КАК бит_НачисленияПоУслугамЖКХОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХ.УслугаЖКХ КАК Справочник.бит_УслугиЖКХ) КАК Начисление,
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХ.ЛицевойСчет КАК Справочник.бит_ЛицевыеСчета) КАК ЛицевойСчет,
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХ.Регистратор.Дата, МЕСЯЦ) КАК Период,
	|	СУММА(бит_НачисленияПоУслугамЖКХ.СуммаПениРасход) КАК Оплачено,
	|	бит_НачисленияПоУслугамЖКХ.Регистратор КАК Регистратор
	|ПОМЕСТИТЬ ВТ_ОборотОплаты
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			Авто,
	|			Организация = &Организация
	|				И УслугаЖКХ В (&Начисления)
	|				И 1 = 1
	|				И ЛицевойСчет.Здание.Район В (&Участки)) КАК бит_НачисленияПоУслугамЖКХ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&ДатаОкончания, ТипКвартиры В (&ТипыКвартир)) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_НачисленияПоУслугамЖКХ.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	НЕ бит_НачисленияПоУслугамЖКХ.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХ.УслугаЖКХ КАК Справочник.бит_УслугиЖКХ),
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХ.ЛицевойСчет КАК Справочник.бит_ЛицевыеСчета),
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХ.Регистратор.Дата, МЕСЯЦ),
	|	бит_НачисленияПоУслугамЖКХ.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ КАК Справочник.бит_УслугиЖКХ) КАК Начисление,
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет КАК Справочник.бит_ЛицевыеСчета) КАК ЛицевойСчет,
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание КАК Справочник.бит_СписокЗданий) КАК Адрес,
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание.Район КАК Справочник.бит_АдминистративныеОкруга) КАК Участок,
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор.Дата, МЕСЯЦ) КАК Период,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаПениОборот КАК Сумма,
	|	0 КАК Изменение
	|ПОМЕСТИТЬ ВТ_ОборотНачисленияДоГруппировки
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			Регистратор,
	|			Организация = &Организация
	|				И УслугаЖКХ В (&Начисления)
	|				И 1 = 1
