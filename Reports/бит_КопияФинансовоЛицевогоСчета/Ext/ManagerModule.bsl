	СписокУслуг.Колонки.Добавить("СуммаПени"                      , Число_15_4);

	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"        , КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет"   , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("СтатусКвартиры", СтатусКвартиры);
	Запрос.УстановитьПараметр("ТипКвартиры"   , ТипКвартиры);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления,
