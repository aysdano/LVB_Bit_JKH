&НаСервере
Функция УслугаЖКХ(знач Наименование)
	Наименование = СокрЛП(Наименование);
	Если Наименование = "Общедомовые нужды на СОИ - ЭЭ" тогда
		Наименование = "ОДН Эл"		
	ИначеЕсли Наименование = "Общедомовые нужды на СОИ - ХВС"  тогда
		Наименование = ?(СтрНайти(ЭтаФорма.ИмяФайлаКл,"odngv"),"ОДН ГВ","ОДН ХВ")
	ИначеЕсли  Наименование = "Общедомовые нужды на СОИ - ГВС" тогда
		Наименование = 	"ОДН ГВ";
	ИначеЕсли  Наименование = "Общедомовые нужды на СОИ - ВО"  тогда
		Наименование = 	"ОДН ВО";
	ИначеЕсли Наименование = "Капитальный ремонт за период РФКР" тогда
		Наименование = "Капитальный ремонт (РФКР)";
	ИначеЕсли Наименование = "Хол.водоснабжение и водоотведение" тогда
		Наименование = "Хол.водоснабжение и водоотведен"; 
	ИначеЕсли Наименование = "Пени за капитальный ремонт" тогда;	
		Наименование = "Минимальный взнос на кап.ремонт" 
	ИначеЕсли Наименование = "Пени СРЖ и ОДН" тогда;			
		Наименование = "Содержание и ремонт" 		
	ИначеЕсли Наименование = "Газоснабжение пени" тогда;			
		Наименование = "Газоснабжение" 		
		
	КонецЕсли;	
	
	//Если ПустаяСтрока(Наименование) тогда
	//	возврат Справочники.бит_СтепениРодстваФизЛиц.бит_НеУказано;
	//ИначеЕсли СтрокаРО = "Ответственный" тогда
	//	возврат Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо;		
	//КонецЕсли;	
	
	если мКэшУслуг = неопределено тогда
		мКэшУслуг = новый Соответствие;		
	КонецЕсли;	
	
	Услуга = мКэшУслуг[Наименование];
	Если Услуга <> неопределено тогда
		возврат Услуга
	КонецЕсли;
	
	
	Услуга = Справочники.бит_УслугиЖКХ.НайтиПоНаименованию(Наименование,истина);
	Если Не ЗначениеЗаполнено(Услуга) и не 
		ПустаяСтрока(Наименование) тогда  
		
		Сообщить("НЕ НАЙДЕНА УСЛУГА: "+Наименование);
		
		СпрОбъект = Справочники.бит_УслугиЖКХ.СоздатьЭлемент();
		СпрОбъект.Наименование = Наименование;
		СпрОбъект.Записать();
		Услуга = СпрОбъект.Ссылка
	КонецЕсли;	
	мКэшУслуг.Вставить(Наименование,Услуга);
	возврат Услуга;   	
	
КонецФункции	

&НаСервере
Функция РежимПотребления(знач Наименование,Тариф=1)
	Наименование = СокрЛП(Наименование);
	НаименованиеПоУмолчанию = "Не начислять";
	Если Тариф = 0 тогда
		Наименование = НаименованиеПоУмолчанию   
	ИначеЕсли 	Нрег(Наименование) = "нет" тогда
		Наименование = НаименованиеПоУмолчанию
	ИначеЕсли нрег(Наименование) = "нет услуги" тогда
		Наименование = НаименованиеПоУмолчанию;	
	ИначеЕсли ПустаяСтрока(Наименование) тогда
		Наименование = НаименованиеПоУмолчанию;	
	КонецЕсли;	
	
	//Если ПустаяСтрока(Наименование) тогда
	//	возврат Справочники.бит_СтепениРодстваФизЛиц.бит_НеУказано;
	//ИначеЕсли СтрокаРО = "Ответственный" тогда
	//	возврат Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо;		
	//КонецЕсли;	
	
	
	
	если мКэшРежимов = неопределено тогда
		мКэшРежимов = новый Соответствие;		
	КонецЕсли;	
	
	Режим = мКэшРежимов[Наименование];
	Если Режим <> неопределено тогда
		возврат Режим
	КонецЕсли;
	
	Режим = Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию(Наименование,истина);
	Если Не ЗначениеЗаполнено(Режим) тогда
		СпрОбъект = Справочники.бит_РежимыПотребленияУслуг.СоздатьЭлемент();
		СпрОбъект.Наименование = Наименование;
		СпрОбъект.Записать();
		Режим = СпрОбъект.Ссылка
	КонецЕсли;	
	мКэшРежимов.Вставить(Наименование,Режим);
	возврат Режим;   
	
КонецФункции	

