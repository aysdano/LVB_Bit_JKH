			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
		Исключение
		КонецПопытки;
		
	Иначе
		
		Попытка
			ОбластьШапкаДокумента.Рисунки.очистить();
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Попытка
		Результат.Вывести(ОбластьШапкаДокумента);
	Исключение
	КонецПопытки;
	
	Попытка
		Результат.Вывести(ШапкаПриборыУчета);
	Исключение
	КонецПопытки;
	
	Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
		
		Попытка
			СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);
			Результат.Вывести(СтрокаПриборовУчета);
		Исключение
		КонецПопытки;
		
	КонецЦикла; 
	
	Попытка
		Результат.Вывести(ОбластьПодтверждениеДанных);
	Исключение
	КонецПопытки;
	
	Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
		
		
		Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
		КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
		
		Попытка
			Рисунок = ОбластьШтрихКод.Рисунки.Шк2;
		Исключение
		КонецПопытки;
		
		Попытка    
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
		Исключение
		КонецПопытки;
		
		Попытка
			Результат.Вывести(ОбластьШтрихКод);
		Исключение
		КонецПопытки;
		
	Иначе
		
		Попытка
			ОбластьШтрихКод.Рисунки.очистить();
		Исключение
		КонецПопытки;
		
	КонецЕсли;
	
	Попытка
		Результат.Вывести(ОбластьПолучатель);
	Исключение
	КонецПопытки;		
	
	Попытка
		Результат.Вывести(ОбластьШапка);
	Исключение
	КонецПопытки;		
	
	
	Попытка
		ОбластьШапкаЗаголовки.Параметры.Период = НРег(мСтруктураДанных.Период);
		Результат.Вывести(ОбластьШапкаЗаголовки);
	Исключение
	КонецПопытки;		
	
	КодПоставщика = 0;
	
	Мас = Новый Массив;
	
	Попытка
		Мас.Добавить(СтрокаРасшифровки);
		Мас.Добавить(ОбластьИтого);
		
		Если Не ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(Результат, Мас) Тогда
			
			Результат.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЕсли;
	Исключение
	КонецПопытки;		
	
	
	ТабДокСодержаниеРемонтУсл = Новый ТабличныйДокумент;
	ТабДокСодержаниеРемонтУсл.Вывести(ОбластьГруппаСодержание);
	ТабДокКоммунальныеУсл = Новый ТабличныйДокумент;
	ТабДокКоммунальныеУсл.Вывести(ОбластьГруппаКоммунальные);
	ТабДокПрочиеУсл	= Новый ТабличныйДокумент;
	ТабДокПрочиеУсл.Вывести(ОбластьГруппаПрочие);
	ИтогоТабДокСодержаниеРемонтУсл = 0;
	ИтогоТабДокКоммунальныеУсл	   = 0;
	
	Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
		
		Если НеПечататьУслугиБезНачислений(СтрокаТаблицы) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
		Если (СтрокаТаблицы.ОбъемИНД = 0 И СтрокаТаблицы.ОбъемОбщДом = 0)
			ИЛИ (СтрокаТаблицы.ОбъемИНД <> 0 И СтрокаТаблицы.ОбъемОбщДом = 0) Тогда
			СтрокаРасшифровки.Параметры.ВидУсл = "инд.";
		ИначеЕсли СтрокаТаблицы.ОбъемОбщДом <> 0 И СтрокаТаблицы.ОбъемИНД <> 0 Тогда
			СтрокаРасшифровки.Параметры.ВидУсл = "инд./ОДН";
		Иначе
			СтрокаРасшифровки.Параметры.ВидУсл = "ОДН";
		КонецЕсли;
		
		Если СтрокаТаблицы.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.Техобслуживание")
			ИЛИ СтрокаТаблицы.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.ПлатаЗаНайм")
			ИЛИ СтрокаТаблицы.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт") Тогда
			
			ТабДокСодержаниеРемонтУсл.Вывести(СтрокаРасшифровки);
			ИтогоТабДокСодержаниеРемонтУсл = ИтогоТабДокСодержаниеРемонтУсл + СтрокаТаблицы.КОплатеЗаМесяц;
			
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаТаблицы.ГрафаОтчетаГЦЖС) Тогда	
			
			ТабДокПрочиеУсл.Вывести(СтрокаРасшифровки);
			
		Иначе 
			
			ТабДокКоммунальныеУсл.Вывести(СтрокаРасшифровки);
			ИтогоТабДокКоммунальныеУсл = ИтогоТабДокКоммунальныеУсл + СтрокаТаблицы.КОплатеЗаМесяц;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ТабДокСодержаниеРемонтУсл.ВысотаТаблицы > 1 Тогда
		ОбластьГруппаСодержаниеИтого.Параметры.Период = НРег(мСтруктураДанных.Период);
		ОбластьГруппаСодержаниеИтого.Параметры.ИтогоСодержание = ИтогоТабДокСодержаниеРемонтУсл;
		ТабДокСодержаниеРемонтУсл.Вывести(ОбластьГруппаСодержаниеИтого);
		Результат.Вывести(ТабДокСодержаниеРемонтУсл);
	КонецЕсли;
	
	Если ТабДокКоммунальныеУсл.ВысотаТаблицы > 1 Тогда
		ОбластьГруппаКоммунальныеИтого.Параметры.Период = НРег(мСтруктураДанных.Период);
		ОбластьГруппаКоммунальныеИтого.Параметры.ИтогоКоммУсл = ИтогоТабДокКоммунальныеУсл;
		ТабДокКоммунальныеУсл.Вывести(ОбластьГруппаКоммунальныеИтого);
		Результат.Вывести(ТабДокКоммунальныеУсл);
	КонецЕсли;
	
	Если ТабДокПрочиеУсл.ВысотаТаблицы > 1 Тогда
		Результат.Вывести(ТабДокПрочиеУсл);
	КонецЕсли;
	
	Попытка
		ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
		Результат.Вывести(ОбластьИтого);
	Исключение
	КонецПопытки;		
	
	Результат.ВывестиГоризонтальныйРазделительСтраниц();
	
	Попытка
		Результат.Вывести(ОбластьШапкаПерерасчеты);
	Исключение
	КонецПопытки;		
	
	Для каждого СтрокаТаблицы Из мТаблицаПерерасчетов Цикл
		
