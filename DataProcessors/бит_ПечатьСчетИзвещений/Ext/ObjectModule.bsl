		//СтрПлатежГИСЖКХ.ТипПД							= ?(ШаблонИзвещений.Сальдо = Перечисления.ДаНет.Да, "Долговой", "Текущий");
		СтрПлатежГИСЖКХ.РасчетныйПериод					= мСтруктураДанных.Дата;
		СтрПлатежГИСЖКХ.ЗадолженностьЗаПредыдущиеПериоды= ?(ЗначениеЗаполнено(ЗадолженностьЗаПредыдущиеПериоды), ЗадолженностьЗаПредыдущиеПериоды, 0);
		СтрПлатежГИСЖКХ.АвансНаНачалоПериода	 		= ?(ЗначениеЗаполнено(АвансНаНачалоПериода), АвансНаНачалоПериода, 0);
		СтрПлатежГИСЖКХ.Оплачено						= мСтруктураДанных.Оплата;
		СтрПлатежГИСЖКХ.ЧислоРасчетногоПериода			= День(КонецМесяца(мСтруктураДанных.Дата));
		СтрПлатежГИСЖКХ.ДатаПоследнейОплаты				= мСтруктураДанных.ДатаПоследнейОплатыНеКапРемГИСЖКХ;
		СтрПлатежГИСЖКХ.ДатаПоследнейОплатыКапРем		= мСтруктураДанных.ДатаПоследнейОплатыКапРемГИСЖКХ;
		СтрПлатежГИСЖКХ.ИтогоКОплатеЗаРС				= ?(ЗначениеЗаполнено(ИтогоКОплатеЗаРС), ИтогоКОплатеЗаРС, 0);
		СтрПлатежГИСЖКХ.ИтогоКОплатеЗаРССальдо			= ?(ЗначениеЗаполнено(ИтогоКОплатеЗаРССальдо), ИтогоКОплатеЗаРССальдо, 0);
		СтрПлатежГИСЖКХ.ИтогПени						= мСтруктураДанных.ИтогПени;
		
		ЗаполнитьЗначенияСвойств(СтрПлатежГИСЖКХ, Стр);
		СтрПлатежГИСЖКХ.ТабличнйДокумент = Квитанция;
		
	КонецЦикла;
	
	ЗаполнитьТаблицаПлатежиГИСЖКХНеустойки(мСтруктураДанных.ЛицевойСчет, мСтруктураДанных.НачисленоПениЗаПериод, мСтруктураДанных.ИтогПени);
	
	Возврат Квитанция;
	
КонецФункции

Функция ПечатьПлатежныйДокументРК43() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьЗаголовок						= мМакет.ПолучитьОбласть("Заголовок");
	ОбластьРаздел1							= мМакет.ПолучитьОбласть("Раздел1");
	ОбластьРаздел2Шапка						= мМакет.ПолучитьОбласть("Раздел2Шапка");
	ОбластьРаздел2Строка					= мМакет.ПолучитьОбласть("Раздел2Строка");
	ОбластьРаздел3Шапка						= мМакет.ПолучитьОбласть("Раздел3Шапка");
	ОбластьРаздел3ГруппаСодержание			= мМакет.ПолучитьОбласть("Раздел3ГруппаСодержание");
	ОбластьРаздел3ГруппаКоммунальные		= мМакет.ПолучитьОбласть("Раздел3ГруппаКоммунальные");
	ОбластьРаздел3СтрокаКапитальныйРемонт	= мМакет.ПолучитьОбласть("Раздел3СтрокаКапитальныйРемонт");
	ОбластьРаздел3ПрочиеУслуги				= мМакет.ПолучитьОбласть("Раздел3ПрочиеУслуги");
	ОбластьРаздел3Строка					= мМакет.ПолучитьОбласть("Раздел3Строка");
	ОбластьРаздел3СтрокаИтогоЗаПериод		= мМакет.ПолучитьОбласть("Раздел3СтрокаИтогоЗаПериод");
	ОбластьРаздел3СтрокаИтого				= мМакет.ПолучитьОбласть("Раздел3СтрокаИтого");
	ОбластьРаздел4Шапка						= мМакет.ПолучитьОбласть("Раздел4Шапка");
	ОбластьРаздел4Строка					= мМакет.ПолучитьОбласть("Раздел4Строка");
	ОбластьРаздел4СтрокаПредельный			= мМакет.ПолучитьОбласть("Раздел4СтрокаПредельный");
	ОбластьРаздел6Шапка						= мМакет.ПолучитьОбласть("Раздел6Шапка");
	ОбластьРаздел6Строка					= мМакет.ПолучитьОбласть("Раздел6Строка");
	
	Попытка
		ОбластьШапкаПолучатель = мМакет.ПолучитьОбласть("ШапкаПолучатель");
	Исключение
		ОбластьШапкаПолучатель = Неопределено
	КонецПопытки;
	
	Попытка
		ОбластьПолучательСтрока = мМакет.ПолучитьОбласть("ПолучательСтрока");
	Исключение
	КонецПопытки;
	
	Попытка
		ОбластьQRКод = мМакет.ПолучитьОбласть("ОбластьQRКод")
	Исключение
	КонецПопытки;
	
	// Заголовок.
	ОбластьЗаголовок.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьЗаголовок);
	
	// Раздел1.
	ОбластьРаздел1.Параметры.Заполнить(мСтруктураДанных);
	
	ДлинаСтрокиЛицевойСчетАдрес = СтрДлина(мСтруктураДанных.ЛицевойСчетАдрес);
	Если ДлинаСтрокиЛицевойСчетАдрес < 92 Тогда
		
		ЛицевойСчетАдрес1 = мСтруктураДанных.ЛицевойСчетАдрес;
		ЛицевойСчетАдрес2 = "";
		
	Иначе
		// Разбиваем строку на две подстроки, таким образом чтобы первая строка была не более 92 символов
		// Для этого ищем очередной пробел и проверяем длину строк в предположении, что перенос будет выполнен по найденной позиции.
		ЛицевойСчетАдрес2 = мСтруктураДанных.ЛицевойСчетАдрес;
		ПозицияПоиска = СтрНайти(ЛицевойСчетАдрес2," ")+1;
		
		// Если найден очередной пробел и длина первой строки после операции будет менее 92 символов, то выполняем еще одну итерацию.
		Пока ПозицияПоиска > 1 И ДлинаСтрокиЛицевойСчетАдрес - СтрДлина(ЛицевойСчетАдрес2) + ПозицияПоиска < 92 Цикл
			
			ЛицевойСчетАдрес2 = Сред(ЛицевойСчетАдрес2, ПозицияПоиска);
			ПозицияПоиска       = СтрНайти(ЛицевойСчетАдрес2," ")+1;
			
		КонецЦикла; 
		
		ЛицевойСчетАдрес1 = Лев(мСтруктураДанных.ЛицевойСчетАдрес,ДлинаСтрокиЛицевойСчетАдрес - СтрДлина(ЛицевойСчетАдрес2));
		
	КонецЕсли; 
	
	СтруктураАдресаЛС = Новый Структура;
	СтруктураАдресаЛС.Вставить("ЛицевойСчетАдрес1", ЛицевойСчетАдрес1);
	СтруктураАдресаЛС.Вставить("ЛицевойСчетАдрес2", ЛицевойСчетАдрес2);
	ОбластьРаздел1.Параметры.Заполнить(СтруктураАдресаЛС);
	Квитанция.Вывести(ОбластьРаздел1);
	
	// Раздел2/Раздел4.
	ТабДокРаздел2 = Новый ТабличныйДокумент;
	ТабДокРаздел2.Вывести(ОбластьРаздел2Шапка);
	ТабДокРаздел4 = Новый ТабличныйДокумент;
	ТабДокРаздел4.Вывести(ОбластьРаздел4Шапка);

	Если мТаблицаПечатиСчетчиков.Количество() = 0 Тогда
		ТабДокРаздел2.Вывести(ОбластьРаздел2Строка);
	Иначе
		Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
				ОбластьРаздел2Строка.Параметры.Заполнить(СтрокаТаблицы);
				ТабДокРаздел2.Вывести(ОбластьРаздел2Строка);
				
				Если Не ЗначениеЗаполнено(СтрокаТаблицы.Счетчик)  Тогда
					Продолжить;
				КонецЕсли;
				
				ДанныеСправочнойИнформации = Новый Структура;
				ДанныеСправочнойИнформации.Вставить("ИтогоОбъемОбщедомовых", СтрокаТаблицы.ОбъемОбщДом);
				ДанныеСправочнойИнформации.Вставить("КоличествоЕдиницИНД", СтрокаТаблицы.ДоПоказаний);
				
				ОбластьРаздел4Строка.Параметры.Заполнить(СтрокаТаблицы);
				ОбластьРаздел4Строка.Параметры.Заполнить(ДанныеСправочнойИнформации);
				
				ТабДокРаздел4.Вывести(ОбластьРаздел4Строка);
				
		КонецЦикла; 
	КонецЕсли;
	
	Если НЕ ОбластьШапкаПолучатель = Неопределено Тогда
		
		ТабДокПолучателяПлатежа = Новый ТабличныйДокумент;
		ТабДокПолучателяПлатежа.Вывести(ОбластьШапкаПолучатель);

		ДанныеПолучателяПлатежа = Новый Структура;
		Если ЗначениеЗаполнено(мСтруктураДанных.ПолучательРС)
			ИЛИ ЗначениеЗаполнено(мСтруктураДанных.ПолучательИНН)
			ИЛИ ЗначениеЗаполнено(мСтруктураДанных.ПолучательКПП)
			ИЛИ ЗначениеЗаполнено(мСтруктураДанных.ПолучательБанк)
			ИЛИ ЗначениеЗаполнено(мСтруктураДанных.ПолучательКоррСчет2)
			ИЛИ ЗначениеЗаполнено(мСтруктураДанных.ПолучательБИК) Тогда
			
			ТекстПолучательСчет = НСтр("ru='р/с: %1 ИНН: %2 КПП: %3
											|Банк: %4
											|Корр.счет.\БИК: %5'");
			ТекстПолучательСчет = СтрШаблон(ТекстПолучательСчет,
											мСтруктураДанных.ПолучательРС,
											мСтруктураДанных.ПолучательИНН,
											мСтруктураДанных.ПолучательКПП,
											мСтруктураДанных.ПолучательБанк,
											мСтруктураДанных.ПолучательКоррСчет2 + " \ " + мСтруктураДанных.ПолучательБИК);
			
			ДанныеПолучателяПлатежа.Вставить("ПолучательПлатежа", ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЭтотОбъект.ПолучательПлатежа,"Наименование"));
			ДанныеПолучателяПлатежа.Вставить("ПолучательСчет"	, ТекстПолучательСчет);
			ДанныеПолучателяПлатежа.Вставить("ЛицевойСчет"	, Строка(мСтруктураДанных.ЛицевойСчет));
		КонецЕсли;
		
		ОбластьПолучательСтрока.Параметры.Заполнить(ДанныеПолучателяПлатежа);
		ТабДокПолучателяПлатежа.Вывести(ОбластьПолучательСтрока);
		ТабДокРаздел2.Вывести(ТабДокПолучателяПлатежа);
		
	КонецЕсли;
	Квитанция.Присоединить(ТабДокРаздел2);
	
	// Раздел3.
	Квитанция.Вывести(ОбластьРаздел3Шапка);
	
	// Строки Раздел3.
	ТабДокСодержание = Новый ТабличныйДокумент;
	ТабДокСодержание.Вывести(ОбластьРаздел3ГруппаСодержание);
	
	ТабДокКоммунальныеУсл = Новый ТабличныйДокумент;
	ТабДокКоммунальныеУсл.Вывести(ОбластьРаздел3ГруппаКоммунальные);
	
	ТабДокКапРем = Новый ТабличныйДокумент;
	
	ТабДокПрочиеУсл	= Новый ТабличныйДокумент;
	ТабДокПрочиеУсл.Вывести(ОбластьРаздел3ПрочиеУслуги);
	
	Для каждого СтрокаПечати Из мТаблицаПечати Цикл
		
		Если НеПечататьУслугиБезНачислений(СтрокаПечати) Тогда
			Продолжить;
		КонецЕсли;
		
		КОплатеЗаМесяцСПени = Новый Структура("КОплатеЗаМесяцВсего", СтрокаПечати.КОплатеЗаМесяц + СтрокаПечати.Пени + СтрокаПечати.Сальдо);
		
		Если СтрокаПечати.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт") Тогда
			
			ОбластьРаздел3СтрокаКапитальныйРемонт.Параметры.Заполнить(СтрокаПечати);
			ОбластьРаздел3СтрокаКапитальныйРемонт.Параметры.Заполнить(КОплатеЗаМесяцСПени);
			ТабДокКапРем.Вывести(ОбластьРаздел3СтрокаКапитальныйРемонт);
			Продолжить;
		КонецЕсли;
		
		ОбластьРаздел3Строка.Параметры.Заполнить(СтрокаПечати);
		ОбластьРаздел3Строка.Параметры.Заполнить(КОплатеЗаМесяцСПени);
		Если СтрокаПечати.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.Техобслуживание")
			ИЛИ СтрокаПечати.ГрафаОтчетаГЦЖС = ПредопределенноеЗначение("Перечисление.бит_ГрафыОтчетаПоГЦЖС.ПлатаЗаНайм") Тогда
			
			ТабДокСодержание.Вывести(ОбластьРаздел3Строка);
		ИначеЕсли НЕ ЗначениеЗаполнено(СтрокаПечати.ГрафаОтчетаГЦЖС) Тогда	
			
			ТабДокПрочиеУсл.Вывести(ОбластьРаздел3Строка);
		Иначе 
			
			ТабДокКоммунальныеУсл.Вывести(ОбластьРаздел3Строка);
		КонецЕсли;
		
	КонецЦикла; 
	
	Если ТабДокСодержание.ВысотаТаблицы > 1 Тогда
		Квитанция.Вывести(ТабДокСодержание);
	КонецЕсли;
	
	Если  ТабДокКоммунальныеУсл.ВысотаТаблицы > 1 Тогда
		Квитанция.Вывести(ТабДокКоммунальныеУсл);
	КонецЕсли;
	
	Если ТабДокКапРем.ВысотаТаблицы > 0 Тогда
		Квитанция.Вывести(ТабДокКапРем);
	КонецЕсли;
	
	Если ТабДокПрочиеУсл.ВысотаТаблицы > 1 Тогда
		Квитанция.Вывести(ТабДокПрочиеУсл);
	КонецЕсли;
	
	ОбластьРаздел3СтрокаИтогоЗаПериод.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьРаздел3СтрокаИтогоЗаПериод);
	
	ИтогоКОплате = Новый Структура("ИтогоКОплате", мСтруктураДанных.КОплатеЗаМесяц + мСтруктураДанных.ИтогПени + мСтруктураДанных.Сальдо);
	ОбластьРаздел3СтрокаИтого.Параметры.Заполнить(ИтогоКОплате);
	Квитанция.Вывести(ОбластьРаздел3СтрокаИтого);
	
	Квитанция.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Раздел 4.
	Для каждого Строка из мТаблицаОбщедомовыхСчетчиков Цикл
		
		Если Не ЗначениеЗаполнено(Строка.Счетчик)  Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеСправочнойИнформации = Новый Структура;
		ДанныеСправочнойИнформации.Вставить("ИтогоОбъемОбщедомовых", СтрокаТаблицы.ОбъемОбщДом);
		ДанныеСправочнойИнформации.Вставить("КоличествоЕдиницГУРП", СтрокаТаблицы.ДоПоказаний);
		ДанныеСправочнойИнформации.Вставить("ОбъемОбщийИнд", Строка.ИтогоОбъемИндИПУ + Строка.ИтогоОбъемИндНорматив);
		
		ОбластьРаздел4Строка.Параметры.Заполнить(Строка);
		ОбластьРаздел4Строка.Параметры.Заполнить(ДанныеСправочнойИнформации);
		
		ТабДокРаздел4.Вывести(ОбластьРаздел4Строка);
		
	КонецЦикла;	

	
	ТабДокРаздел4.Вывести(ОбластьРаздел4СтрокаПредельный);
	Квитанция.Вывести(ТабДокРаздел4);
	
	// Раздел 6.
	Если мТаблицаПерерасчетов.Количество() > 0 Тогда
		
		ТабДокРаздел6 = Новый ТабличныйДокумент;
		ТабДокРаздел6.Вывести(ОбластьРаздел6Шапка);
		
		Для каждого СтрокаСведений Из мТаблицаПерерасчетов Цикл
			
			ОбластьРаздел6Строка.Параметры.Заполнить(СтрокаСведений);
			Если ИспользоватьКомментарийКакОснование Тогда
				ОбластьРаздел6Строка.Параметры.Основание = СтрокаСведений.Комментарий;
			КонецЕсли; 
			ТабДокРаздел6.Вывести(ОбластьРаздел6Строка);
			
		КонецЦикла;
		
		Квитанция.Вывести(ТабДокРаздел6);
		
	КонецЕсли;
	
	Если ИспользоватьQR Тогда
		НапечататьQRКод(Квитанция);	
	Иначе
		УбратьQRКод(Квитанция)
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Платежный документ РК 354.
//
Функция ПечатьПлатежныйДокументРКБИТ() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьПолучатель       = мМакет.ПолучитьОбласть("Получатель");
	ОбластьПлательщик       = мМакет.ПолучитьОбласть("Плательщик");
	ОбластьШтрихКод         = мМакет.ПолучитьОбласть("ШтрихКод");
	ОбластьПлательщикПодвал = мМакет.ПолучитьОбласть("ПлательщикПодвал");
	
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	Попытка
		СтрокаРасшифровкиГр = мМакет.ПолучитьОбласть("СтрокаРасшифровкиГр");
	Исключение
		СтрокаРасшифровкиГр = Неопределено;
	КонецПопытки;
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого"); 
	СтрокаПриборовУчета = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ШапкаПриборыУчета   = мМакет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	РазовыеШапка  = мМакет.ПолучитьОбласть("РазовыеШапка");
	РазовыеСтрока = мМакет.ПолучитьОбласть("РазовыеСтрока");
	
	ОбластьКассовыйСбор     = мМакет.ПолучитьОбласть("КассовыйСбор");
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	ШапкаПоказания  = мМакет.ПолучитьОбласть("ШапкаПоказания");
	СтрокаПоказания = мМакет.ПолучитьОбласть("СтрокаПоказания");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате + мСтруктураДанных.ПроцентОтОплаты;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	СчВывода = ?(мТаблицаПечатиСчетчиков.Количество() > 0, 4, 5);
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
		
		Квитанция.Вывести(ОбластьПолучатель);
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШтрихКод.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
			Квитанция.Вывести(ОбластьШтрихКод);
		Иначе
			ОбластьШапка.Рисунки.очистить();
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьПлательщик);
		
		Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
			Квитанция.Вывести(ШапкаПриборыУчета);
		КонецЕсли; 
		
		Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
			
			Если СчВывода = 0 Тогда
				Прервать;
			КонецЕсли; 
			
			СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);
			Квитанция.Вывести(СтрокаПриборовУчета);
			
			СчВывода = СчВывода - 1;
			
		КонецЦикла; 
		
		Пока НЕ СчВывода = 0 Цикл
			
			Квитанция.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
			
		КонецЦикла;
		
		Квитанция.Вывести(ОбластьПлательщикПодвал);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьШапка);
	
	Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
		Квитанция.Вывести(ШапкаПоказания);
	КонецЕсли; 
	
	Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
		
		СтрокаПоказания.Параметры.Заполнить(СтрокаТаблицы);
		ЗаполнитьПараметр(СтрокаПоказания, "Услуга", СтрокаТаблицы.СокрНаименование);
		
		СтрУслуга = мТаблицаПечати.Найти(СтрокаТаблицы.Услуга, "Услуга");
		Если НЕ СтрУслуга = Неопределено Тогда
			ЗаполнитьПараметр(СтрокаПоказания, "ОбъемИнд"		, СтрУслуга.ИтогоОбъемИнд);
		Иначе
			ЗаполнитьПараметр(СтрокаПоказания, "ОбъемИнд"		, 0);
		КонецЕсли;	
		
		Квитанция.Вывести(СтрокаПоказания);
		
	КонецЦикла;
	
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Если НЕ СтрокаРасшифровкиГр = Неопределено
		И (ГруппироватьУслуги ИЛИ мСтруктураДанных.ГруппироватьУслуги) Тогда
		
		Запрос = ПолучитьзапросГруппировки(мТаблицаПечати);
		ВыборкаГруп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруп.Следующий() Цикл
			
			СтрокаРасшифровкиГр.Параметры.Заполнить(ВыборкаГруп);
			СтрокаРасшифровкиГр.Параметры.УслугаПредставление = ВРег(ВыборкаГруп.ГруппаУслугиПредставление);
			
			Выборка = ВыборкаГруп.Выбрать();
			
			Если Выборка.Количество() = 1 Тогда // Едсинственная услуга в группировки.
				
				Выборка.Следующий();
				
				Если НеПечататьУслугиБезНачислений(Выборка) Тогда
					Продолжить;
				КонецЕсли;
				
				Квитанция.Вывести(СтрокаРасшифровкиГр);
				СтрокаРасшифровкиГр.Параметры.Заполнить(Выборка);
				СтрокаРасшифровкиГр.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
				
			ИначеЕсли Выборка.Количество() > 1 Тогда 
				
				Если НеПечататьУслугиБезНачислений(ВыборкаГруп) = Ложь Тогда 
					Квитанция.Вывести(СтрокаРасшифровкиГр);
				КонецЕсли;
				
				Пока Выборка.Следующий() И РасскрытьСоставГрупп Цикл
					
					Если НеПечататьУслугиБезНачислений(Выборка) Тогда 
						Продолжить;
					КонецЕсли;
					СтрокаРасшифровки.Параметры.Заполнить(Выборка);
					Квитанция.Вывести(СтрокаРасшифровки);
					
				КонецЦикла; 
				
			ИначеЕсли ВыборкаГруп.Услуга.Пустая() Тогда 
				
				Пока Выборка.Следующий() Цикл
					
					Если НеПечататьУслугиБезНачислений(Выборка) Тогда 
						Продолжить;
					КонецЕсли;
					
					СтрокаРасшифровкиГр.Параметры.Заполнить(Выборка);
					СтрокаРасшифровкиГр.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
					Квитанция.Вывести(СтрокаРасшифровкиГр);
					
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЦикла;
		
	Иначе
		
		Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
			Если НеПечататьУслугиБезНачислений(СтрокаТаблицы) Тогда 
				Продолжить;	
			КонецЕсли;
			СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
			Квитанция.Вывести(СтрокаРасшифровки);
		КонецЦикла; 
		
	КонецЕсли;
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		
		// Вывод информации о кассовом сборе.
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "ПроцентОтОплаты", мСтруктураДанных.ПроцентОтОплаты);
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "Процент", Процент);
		
		Если мСтруктураДанных.КОплатеЗаМесяц = мСтруктураДанных.КОплате Тогда
			мСтруктураДанных.КОплатеЗаМесяц = мСтруктураДанных.КОплатеЗаМесяц + мСтруктураДанных.ПроцентОтОплаты;
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьКассовыйСбор);
		
	КонецЕсли;
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	ЗаполнитьПараметр(ОбластьИтого, "КОплате", мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты);
	
	Квитанция.Вывести(ОбластьИтого);
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли; 
	
	Квитанция.Вывести(ОбластьЛиния);
	
	Если мТаблицаПерерасчетов.Количество() > 0 Тогда
		
		Квитанция.Вывести(РазовыеШапка);
		
		Для каждого СтрокаТаблицы Из мТаблицаПерерасчетов Цикл
			
			РазовыеСтрока.Параметры.Заполнить(СтрокаТаблицы);
			Если ИспользоватьКомментарийКакОснование Тогда
				РазовыеСтрока.Параметры.Основание= СтрокаТаблицы.Комментарий;
			КонецЕсли; 
			Квитанция.Вывести(РазовыеСтрока);
			
		КонецЦикла;
		
	КонецЕсли; 
	
	Если ИспользоватьQR = Истина Тогда
		
		Попытка	
			ОбластьШтрихкодQR                   = мМакет.ПолучитьОбласть("ШтрихкодQR");
		Исключение
		КонецПопытки;
		
		НапечататьQRКод(Квитанция, ОбластьШтрихкодQR);
	Иначе
		УбратьQRКод(Квитанция)
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Единый Платежный Документ.
//
Функция ПечатьЕдиныйПлатежныйДокумент() Экспорт
	
	Результат = Новый ТабличныйДокумент;
	
	// Области отрывной части.                           
	Попытка	
		ОбластьШапкаДокумента       = мМакет.ПолучитьОбласть("ШапкаДокумента");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьШтрихКод1            = мМакет.ПолучитьОбласть("ШтрихКод1");
	Исключение
	КонецПопытки;
	
	Попытка	
		ШапкаПриборыУчета           = мМакет.ПолучитьОбласть("ШапкаПриборыУчета");
	Исключение
	КонецПопытки;
	
	Попытка	
		СтрокаПриборовУчета         = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьПодтверждениеДанных  = мМакет.ПолучитьОбласть("ПодтверждениеДанных");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьШтрихКод             = мМакет.ПолучитьОбласть("ШтрихКод");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьПолучатель           = мМакет.ПолучитьОбласть("Получатель");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьПлательщик           = мМакет.ПолучитьОбласть("Плательщик");
	Исключение
	КонецПопытки;
	
	// Основные области печати.
	Попытка	
		ОбластьШапка                   = мМакет.ПолучитьОбласть("Шапка");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьШапкаЗаголовки          = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	Исключение
	КонецПопытки;
	
	Попытка	
		СтрокаРасшифровки              = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьИтого                   = мМакет.ПолучитьОбласть("Итого");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьШапкаПерерасчеты        = мМакет.ПолучитьОбласть("ШапкаПерерасчеты");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьПерерасчеты             = мМакет.ПолучитьОбласть("Перерасчеты");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьШапкаПоставщики         = мМакет.ПолучитьОбласть("ШапкаПоставщики");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьПоставщики              = мМакет.ПолучитьОбласть("Поставщики");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьСправочнаяИнформация    = мМакет.ПолучитьОбласть("СправочнаяИнформация");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьСправочнаяИнформацияСтрока    = мМакет.ПолучитьОбласть("СправочнаяИнформацияСтрока");
	Исключение
	КонецПопытки;
	
	Попытка	
		ОбластьСправочнаяИнформацияПримечание    = мМакет.ПолучитьОбласть("СправочнаяИнформацияПримечание");
	Исключение
	КонецПопытки;
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате        + мСтруктураДанных.ПроцентОтОплаты;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	Попытка
		ОбластьШапкаДокумента.Параметры.Заполнить(мСтруктураДанных);
		
		Если НЕ мТаблицаСвойств.Количество() = 0 Тогда
			
			Попытка
				
				ОбластьШапкаДокумента.Параметры.Свойство = Лев(мТаблицаСвойств[0].Свойство,СтрДлина(мТаблицаСвойств[0].Свойство)-16);
				
				ОбластьШапкаДокумента.Параметры.Значение = мТаблицаСвойств[0].Значение;
				
			Исключение
			КонецПопытки;
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
	Попытка
		ОбластьШтрихКод1.Параметры.Заполнить(мСтруктураДанных);
	Исключение
	КонецПопытки;
	
	Попытка
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
	Исключение
	КонецПопытки;
	
	Попытка
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
	Исключение
	КонецПопытки;
	
	Попытка
		ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	Исключение
	КонецПопытки;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета,
	|	бит_ЗначениеСвойствОбъектовУчета.ВидСвойства,
	|	ЕСТЬNULL(бит_ЗначениеСвойствОбъектовУчета.Значение, 0) КАК Значение
	|ИЗ
	|	РегистрСведений.бит_ЗначениеСвойствОбъектовУчета КАК бит_ЗначениеСвойствОбъектовУчета
	|ГДЕ
	|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета = &Здание";
	
	Запрос.УстановитьПараметр("Здание", мСтруктураДанных.ЛицевойСчет.Здание);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	ПлощадьЖилыхНежилых = 0;
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
