&НаКлиенте
Функция РазностьДатМесяц(ДатаНачала,ДатаКонца)
	
	МесяцНачала = Месяц(ДатаНачала);
	МесяцКонца = Месяц(ДатаКонца);
	ЛетМеждуДатами = Год(ДатаКонца) - Год(ДатаНачала);
	РезультатВМесяцах = ЛетМеждуДатами * 12 - МесяцНачала + МесяцКонца;
	
	Возврат РезультатВМесяцах;

КонецФункции

&НаСервере
Функция ПолучитьРазницуПлощадей(УслугаЖКХ)
	//
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_РазовыеПоУслугамЖКХ.ЛицевойСчет.Квартира КАК Квартира,
		|	бит_РазовыеПоУслугамЖКХ.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	Документ.бит_РазовыеПоУслугамЖКХ КАК бит_РазовыеПоУслугамЖКХ
		|ГДЕ
		|	бит_РазовыеПоУслугамЖКХ.ЛицевойСчет = &ЛицевойСчет";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	
	РезультатЗапроса = Запрос.Выполнить();   	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Квартира = Выборка.Квартира;
	КонецЦикла;

	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияОКвартиреСрезПоследних.Квартира КАК Квартира,
		|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры
		|ИЗ
		|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
		|ГДЕ
		|	бит_СведенияОКвартиреСрезПоследних.Квартира = &Квартира";
	
	Запрос.УстановитьПараметр("Квартира", Квартира);
	
	РезультатЗапроса = Запрос.Выполнить(); 	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ТипКвартиры = Выборка.ТипКвартиры;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот КАК СуммаОборот,
		|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ,
		|	ВложенныйЗапрос1.ОсновнаяСтавка КАК ОсновнаяСтавка,
		|	ВложенныйЗапрос.Квартира КАК Квартира,
		|	ВложенныйЗапрос1.ТипКвартиры КАК ТипКвартиры
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты КАК бит_НачисленияПоУслугамЖКХОбороты
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			бит_СведенияОКвартиреСрезПоследних.Квартира КАК Квартира
		|		ИЗ
		|			РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних) КАК ВложенныйЗапрос
		|		ПО бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет.Квартира = ВложенныйЗапрос.Квартира
		|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			бит_СтавкиНаУслугиСрезПоследних.Услуга КАК Услуга,
		|			бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка КАК ОсновнаяСтавка,
		|			бит_СтавкиНаУслугиСрезПоследних.ТипКвартиры КАК ТипКвартиры
		|		ИЗ
		|			РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних КАК бит_СтавкиНаУслугиСрезПоследних) КАК ВложенныйЗапрос1
		|		ПО бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ = ВложенныйЗапрос1.Услуга
		|ГДЕ
		|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ = &УслугаЖКХ
		|	И бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет = &ЛицевойСчет
		|	И ВложенныйЗапрос1.ТипКвартиры = &ТипКвартиры";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("УслугаЖКХ", УслугаЖКХ);
	Запрос.УстановитьПараметр("ТипКвартиры", ТипКвартиры);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Таблица = РезультатЗапроса.Выгрузить();
	
	Возврат Таблица;
	
КонецФункции


&НаСервере
Функция ОпределитьВозможностьРасчетаНаСервере()
	
	Для каждого Строка из Объект.СписокУслуг Цикл 
		
		Структура = Новый Структура;
		Структура.Вставить("ЛицевойСчет",Строка.ЛицевойСчет);
		
		НайденныеСтроки = Объект.СписокУслуг.НайтиСтроки(Структура);
		
		КоличествоЭлементов = НайденныеСтроки.Количество();
		
		Если КоличествоЭлементов > 1 Тогда
			
			НоваяТЗ = Новый ТаблицаЗначений;
			НоваяТЗ.Колонки.Добавить("Услуга");
			
			Для каждого СтрокаОдногоЛС из НайденныеСтроки Цикл
				
				Новаястрока = НоваяТЗ.Добавить();
				НоваяСтрока.Услуга = СтрокаОдногоЛС.Услуга;
				
			КонецЦикла;	
			
			ВремТЗ = НоваяТЗ.Скопировать();
			
			Для каждого СтрокаТЗ из ВремТЗ Цикл
				
				Структура = Новый Структура;
				Структура.Вставить("Услуга",СтрокаТЗ.Услуга);
				
				НайденныеСтрокиТЗ = ВремТЗ.НайтиСтроки(Структура);
				
				КоличествоЭлементовТЗ = НайденныеСтрокиТЗ.Количество();
				
				Если КоличествоЭлементовТЗ > 1 Тогда
					
					Возврат Истина;
				Иначе
					Возврат Ложь;
					
				КонецЕсли;
				
			КонецЦикла;
		КонецЕсли;
		Возврат Ложь;
	КонецЦикла;	
	
