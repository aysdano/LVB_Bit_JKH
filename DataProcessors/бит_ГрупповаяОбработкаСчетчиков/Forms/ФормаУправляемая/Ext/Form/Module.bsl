// Процедура открывает форму выбора услуг.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОткрытьФормуВыбораУслуг(ВладелецФормы, ПараметрыФормы = Неопределено)
	
	Если ПараметрыФормы = Неопределено Тогда
		ПараметрыФормы = Новый Структура;
	КонецЕсли; 
	
	СтандартнаяОбработка = Ложь; 
	
	тмпСписокУслуг = ПолучитьСписокУслуг();
	
	Для каждого ЭлементСписка Из СписокУслуг Цикл
		
		Поиск = тмпСписокУслуг.НайтиПоЗначению(ЭлементСписка.Значение);
		
		Если НЕ Поиск = Неопределено Тогда
			тмпСписокУслуг.Удалить(Поиск);
		КонецЕсли; 
		
	КонецЦикла;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Ссылка", тмпСписокУслуг);
	
	ПараметрыФормы.Вставить("Отбор", Отбор);
	
	ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая", ПараметрыФормы, ВладелецФормы);
	
КонецПроцедуры // () 

&НаСервере
Функция ПолучитьСписокУслуг()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент"     , КонецМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("ПоСчетчикам", Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_УслугиЖКХСпособыРасчета.Ссылка КАК Услуга
	|ИЗ
	|	Справочник.бит_УслугиЖКХ.СпособыРасчета КАК бит_УслугиЖКХСпособыРасчета
	|ГДЕ
	|	бит_УслугиЖКХСпособыРасчета.СпособРасчета = &ПоСчетчикам
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_УслугиЖКХСпособыРасчета.Ссылка";
	
	Результат = Новый СписокЗначений;
	
	ТаблицаРезультат = Запрос.Выполнить().Выгрузить();
	
	Результат.ЗагрузитьЗначения(ТаблицаРезультат.ВыгрузитьКолонку("Услуга"));
	
	Возврат Результат;
	
КонецФункции // ()

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая" Тогда
		
		ОбработкаВыбораУсулгНаСервере(ВыбранноеЗначение);
		
	ИначеЕсли ИсточникВыбора.ИмяФормы = "Справочник.бит_Счетчики.Форма.ФормаВыбораСчетчиков" Тогда
		
		ОбработкаВыбораСчетчикаНаСервере(ВыбранноеЗначение);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
// Процедура выбора услуг.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОбработкаВыбораУсулгНаСервере(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		
		Для каждого ЭлементМассива Из ВыбранноеЗначение Цикл
			
			Поиск = СписокУслуг.НайтиПоЗначению(ЭлементМассива);
			Если Поиск = Неопределено Тогда
				СписокУслуг.Добавить(ЭлементМассива);
			КонецЕсли; 
			
		КонецЦикла; 
		
		ВыполнитьПроверкуПоСпискуСчетчиков(); 
		
	КонецЕсли; 
	
КонецПроцедуры // ()

&НаСервере
// Процедура проверяет по списку счетчиков.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ВыполнитьПроверкуПоСпискуСчетчиков()
	
	Если ТаблицаСчетчиков.Количество() > 0 Тогда
		
		Для каждого СтрокаТаблицы Из ТаблицаСчетчиков Цикл
			
			Результат = ВыполнитьПроверкуСчетчика(СтрокаТаблицы.Счетчик, СписокУслуг, ВидОперации, Объект.ДатаУстановкиСчетчиков);
			ЗаполнитьЗначенияСвойств(СтрокаТаблицы, Результат);
			
			Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.Документ) Тогда
				СтрокаТаблицы.Обрабатывать = НЕ Результат.ЕстьОшибка;
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры // () 

&наСервере
// Процедура обработка выбора.
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	тмпТаблицаСчетчиков = ТаблицаСчетчиков.Выгрузить();
	Поиск = тмпТаблицаСчетчиков.Найти(ВыбранноеЗначение, "Счетчик");
	
	Если НЕ Поиск = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Результат = ВыполнитьПроверкуСчетчика(ВыбранноеЗначение, СписокУслуг, ВидОперации, Объект.ДатаУстановкиСчетчиков);
	
	Возврат Результат;
	
КонецФункции // () 

&НаСервере
// Процедура обработка выбора счетчика.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОбработкаВыбораСчетчикаНаСервере(ВыбранноеЗначение)
	
	тмпТаблицаСчетчиков = ТаблицаСчетчиков.Выгрузить();
	
	Для каждого Счетчик Из ВыбранноеЗначение Цикл
		
		Поиск = тмпТаблицаСчетчиков.Найти(Счетчик, "Счетчик");
		
		Если НЕ Поиск = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		НоваяСтрока = ТаблицаСчетчиков.Добавить();
		НоваяСтрока.Счетчик = Счетчик;
		
		Результат = ВыполнитьПроверкуСчетчика(Счетчик, СписокУслуг, ВидОперации, Объект.ДатаУстановкиСчетчиков);
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Результат);
		НоваяСтрока.Документ     = Неопределено;
		НоваяСтрока.Обрабатывать = НЕ Результат.ЕстьОшибка;
		
	КонецЦикла; 
	
КонецПроцедуры // ()

