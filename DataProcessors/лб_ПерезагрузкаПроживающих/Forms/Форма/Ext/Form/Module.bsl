			СтрокаТекДок.Набор.Записать(истина);
		КонецЕсли;
	КонецЦикла;	
	
	Отчет = Отчет + Символы.ПС + 
			"  Этап7 - Запись в регистр: " + (ТекущаяДата()-ДТ) +  " сек." ;
	ДТ = ТекущаяДата(); 
	
	
	Сообщить(Отчет+Символы.ПС+Символы.ПС);
