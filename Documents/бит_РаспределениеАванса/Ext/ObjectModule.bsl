	|				ТОГДА ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ЕСТЬNULL(Обороты.Льгота, 0) - ЕСТЬNULL(Обороты.СубсидияПИ, 0) - ЕСТЬNULL(ОборотыОплата.СуммаОплаты, 0)
