#Область ПроцедурыОбработчикиСобытийТабличногоПоляОплатыКУ

// Процедура - обработчик события "ПередУдалением" табличного поля "ОплатыКУ".
//
&НаКлиенте
Процедура ОплатыКУПередУдалением(Элемент, Отказ)
	
	ТекСтрока = Элементы.ОплатыКУ.ТекущиеДанные;
	
	ОтветСервера = НайтиСтрокиДереваДокументОплатыПриходныйКассовыйОредерНаСервере(ТекСтрока.ДокументОплаты);
	
	Если ОтветСервера.СтрокаДереваНеопределено И ОтветСервера.СтрокаДереваСтрокиКоличество Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОплатыКУПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("ТекСтрока", ТекСтрока)), "Пометить на удаление Приходные кассовые ордера?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатыКУПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		УстановитьПометкуУдаленияПриходныйКассовыйОредерНаСервере(ТекСтрока.ДокументОплаты);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатыКУОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		
		Для каждого ЭлементМассива Из ВыбранноеЗначение Цикл
			
			Отбор = Новый Структура("ДокументОплаты", ЭлементМассива); 
			
			Поиск = Объект.ОплатыКУ.НайтиСтроки(Отбор);
			
			Если Поиск.Количество() = 0 Тогда
				
				НоваяСтрока = Объект.ОплатыКУ.Добавить();
				
				НоваяСтрока.ДокументОплаты = ЭлементМассива;
				//19.07.2019
		        НоваяСтрока.СоздаватьСчета = Ложь;

				ЗначенияРеквизитов = ЗначенияРеквизитовНаСервере(ЭлементМассива, "Организация, ИсточникОплаты, СуммаДокумента");
				ЗначенияРеквизитов.Свойство("Организация",НоваяСтрока.Организация);
				НоваяСтрока.БанковскийСчет = ЗначениеРеквизитаНаСервере(НоваяСтрока.Организация, "ОсновнойБанковскийСчет");
				ЗначенияРеквизитов.Свойство("ИсточникОплаты",НоваяСтрока.ИсточникОплаты);
				ЗначенияРеквизитов.Свойство("СуммаДокумента",НоваяСтрока.СуммаДокумента);
				
				ЗаполнитьДеревоПКОНаСервере(ЭлементМассива);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - обработчик события "НачалоВыбора" поля ввода "ДокументОплаты".
// Табличного поля "ОплатыКУ".
//
&НаКлиенте
Процедура ОплатыКУДокументОплатыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ОплатыКУ.ТекущиеДанные;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ВидОперации", ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийОплатыКУ.ЗакрытиеКассовойСмены"));
	ПараметрыФормы.Вставить("НачальноеЗначениеВыбора", ТекущаяСтрока.ДокументОплаты);
	
	ОткрытьФорму("Документ.бит_ОплатаКУ.Форма.ФормаВыбораУправляемая", Новый Структура("ЗаполнитьИзОбработкиВводПКО", ПараметрыФормы), Элемент);
	
КонецПроцедуры

// Процедура - обработчик события "ПриИзменении" поля ввода "ДокументОплаты".
// Табличного поля "ОплатыКУ".
//
&НаКлиенте
Процедура ОплатыКУДокументОплатыПриИзменении(Элемент)
	
	ТекСтрока = Элементы.ОплатыКУ.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(ТекСтрока.ДокументОплаты) Тогда
		
		ТекСтрока.Организация    = ПолучитьОрганизациюДокументаОплатыНаСервере(ТекСтрока.ДокументОплаты);
		ТекСтрока.БанковскийСчет = ЗначениеРеквизитаНаСервере(ТекСтрока.Организация, "ОсновнойБанковскийСчет");
		ТекСтрока.ИсточникОплаты = ПолучитьИсточникОплатыДокументаОплатыНаСервере(ТекСтрока.ДокументОплаты);
		ТекСтрока.СуммаДокумента = ПолучитьСуммаДокументаДокументаОплатыНаСервере(ТекСтрока.ДокументОплаты);
		ЗаполнитьДеревоПКОНаСервере(ТекСтрока.ДокументОплаты);
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - обработчик события "ОбработкаВыбора" поля ввода "ДокументОплаты".
// Табличного поля "ОплатыКУ".
//
