	 
#Область ПеременныеМодуля

&НаКлиенте 
Перем мКэшРеквизитовФормы;       // Хранит текущие значения реквизитов формы. Клиент.

#КонецОбласти

#Область РаботаСКэшемРеквизитовФормы

// Процедура заполняет кэш реквизитов формы данными объекта.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура ЗаполнитьТекущиеЗначенияРеквизитовФормы()
	
	Для Каждого КлючИЗначение Из мКэшРеквизитовФормы Цикл
		
		мКэшРеквизитовФормы[КлючИЗначение.Ключ] = Объект[КлючИЗначение.Ключ];
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции

// Формирует текст про требование-накладную для показа в форме документа
//
// Параметры: 
//  Нет
//
// Возвращаемое значение:
//  Текстовая строка про требование-накладную.
//
&НаСервере
Функция ПолучитьТекстТребованияНакладной()
	
	Если ЗначениеЗаполнено(Объект.ТребованиеНакладная) Тогда
		
		Возврат Строка(Объект.ТребованиеНакладная)+ ?(Объект.ТребованиеНакладная.ПометкаУдаления, "; помечен на удаление", "");
		
	Иначе
		
		Возврат "Ввести требование-накладную";
		
	КонецЕсли;
	
КонецФункции

// Формирует текст про РеализациюТоваровУслуг для показа в форме документа
//
// Параметры: 
//  Нет
//
// Возвращаемое значение:
//  Текстовая строка про требование-накладную.
//
&НаСервере
Функция ПолучитьТекстРеализацииТоваровУслуг()
	
	Если ЗначениеЗаполнено(Объект.РеализацияТоваровУслуг) Тогда
		
		Возврат Строка(Объект.РеализацияТоваровУслуг)+ ?(Объект.РеализацияТоваровУслуг.ПометкаУдаления, "; помечен на удаление", "");
		
	Иначе
		
		Возврат "Ввести реализацию товаров и услуг";
		
	КонецЕсли;
	
КонецФункции

// Процедура рассчитывает поля табличной части "Работы".
&НаКлиенте
Процедура РассчитатьСтрокуТабЧастиРаботы(СтрокаТабЧастиРаботы)
	
	СтрокаТабЧастиРаботы.СуммаПлан	 = СтрокаТабЧастиРаботы.КоличествоПлан * СтрокаТабЧастиРаботы.ЦенаРаботы; 
	СтрокаТабЧастиРаботы.СуммаРаботы = СтрокаТабЧастиРаботы.Количество     * СтрокаТабЧастиРаботы.ЦенаРаботы; 
	
КонецПроцедуры

// Процедура рассчитывает поля табличной части "НарядЗаказ".
&НаКлиенте
Процедура РассчитатьСтрокуТабЧастиНарядЗаказ(СтрокаТабЧасти)
	
	// Рассчитать реквизиты табличной части.
	СтрокаТабЧасти.Сумма = СтрокаТабЧасти.Цена * ?(СтрокаТабЧасти.Количество = 0, 0, СтрокаТабЧасти.Количество);
	
	СтрокаТабЧасти.СуммаНДС = УчетНДСКлиентСервер.РассчитатьСуммуНДС(СтрокаТабЧасти.Сумма,
	Объект.УчитыватьНДС, 
	Объект.СуммаВключаетНДС,
	УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтрокаТабЧасти.СтавкаНДС));
	
	СтрокаТабЧасти.СуммаПлан = СтрокаТабЧасти.Цена * ?(СтрокаТабЧасти.КоличествоПлан = 0, 0, СтрокаТабЧасти.КоличествоПлан);
	
КонецПроцедуры

// Процедура получает значение поля ввода "ОбъемПлан" табличной части "Работы".
&НаСервереБезКонтекста
Функция ПолучитьОбъемРаботы(Знач Дата, Знач Подразделение, Знач ВидОбъекта, Знач Работа, Знач ЕдиницаИзмерения, Знач Норма)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_КоэффициентыНормСрезПоследних.Коэффициент
	|ИЗ
	|	РегистрСведений.бит_КоэффициентыНорм.СрезПоследних(
	|			&Период,
	|			Подразделение = &Подразделение
	|				И ВидОбъекта = &ВидОбъекта
	|				И Работа = &Работа
	|				И ЕдиницаИзмерения = &ЕдиницаИзмерения
	|				И Норма = &Норма) КАК бит_КоэффициентыНормСрезПоследних";
	
	Запрос.УстановитьПараметр("Период"	  	     , Дата);
	Запрос.УстановитьПараметр("Подразделение"	 , Подразделение);
	Запрос.УстановитьПараметр("ВидОбъекта"		 , ВидОбъекта);
	Запрос.УстановитьПараметр("Работа"   		 , Работа);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения" , ЕдиницаИзмерения);
	Запрос.УстановитьПараметр("Норма"			 , Норма);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Коэффициент;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли; 
	
КонецФункции

// Процедура получает значение поля ввода "Цена" табличной части "Работы".
&НаСервереБезКонтекста
Функция ПолучитьЦенуРаботы(Знач Дата, Знач ВалютаДокумента, Знач Подразделение, Знач ВидОбъекта, Знач Работа, Знач ЕдиницаИзмерения, Знач Норма)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ЦеныРаботСрезПоследних.Цена
	|ИЗ
	|	РегистрСведений.бит_ЦеныРабот.СрезПоследних(
	|			&Период,
	|			Подразделение = &Подразделение
	|				И ВидОбъекта = &ВидОбъекта
	|				И Работа = &Работа
	|				И ЕдиницаИзмерения = &ЕдиницаИзмерения
	|				И Норма = &Норма
	|				И Валюта = &Валюта) КАК бит_ЦеныРаботСрезПоследних";
	
	Запрос.УстановитьПараметр("Период"		     , Дата);
	Запрос.УстановитьПараметр("Валюта"			 , ВалютаДокумента);
	Запрос.УстановитьПараметр("Подразделение"	 , Подразделение);
	Запрос.УстановитьПараметр("ВидОбъекта"		 , ВидОбъекта);
	Запрос.УстановитьПараметр("Работа"   		 , Работа);
	Запрос.УстановитьПараметр("ЕдиницаИзмерения" , ЕдиницаИзмерения);
	Запрос.УстановитьПараметр("Норма"			 , Норма);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Возврат Выборка.Цена;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли; 
	
КонецФункции

#КонецОбласти

#Область УправлениеВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , Строка(""));
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ВыписатьРеализацию.Заголовок = ПолучитьТекстРеализацииТоваровУслуг();
	Элементы.ВыписатьСписание.Заголовок = ПолучитьТекстТребованияНакладной();
	
	Если ЗначениеЗаполнено(Объект.ВидОбъекта) Тогда
		
		Элементы.ОбъектУчета.Доступность = Истина;
		
		Если Объект.ВидОбъекта = Перечисления.бит_ВидыОбъектовУчета.Здание Тогда
			
			Элементы.ОбъектУчета.Заголовок 		= "Здание";
			Элементы.Заявитель.Доступность 		= Ложь;
			Элементы.Заявитель.Видимость 			= Ложь;
			
		Иначе
			
			Элементы.ОбъектУчета.Заголовок = "Лицевой счет";
			Элементы.Заявитель.Доступность = Истина;
			Элементы.Заявитель.Видимость   = Истина;
			
		КонецЕсли; 
		
	Иначе
		
		Элементы.ОбъектУчета.Заголовок 		= "";
		Элементы.ОбъектУчета.Доступность	= Ложь;
		Элементы.Заявитель.Доступность 		= Ложь;
		Элементы.Заявитель.Видимость 		= Ложь;
		
	КонецЕсли;
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ДолгПоЛС = ДокументОбъект.ВывестиСуммуДолгаПоЛС();
	
	Элементы.ДолгПоТекущемуЛС.Заголовок  = ДолгПоЛС.СтрокаДолга;
	Элементы.ДолгПоТекущемуЛС.ЦветТекста = ДолгПоЛС.ЦветНадписи;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

&НаСервере
Процедура ПриОткрытииНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
	ВалютаРегламентированногоУчета = Константы.ВалютаРегламентированногоУчета.Получить();
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	// Вызов механизма разделения прав доступа.
	бит_ПраваДоступа.ПередОткрытиемФормы(Отказ,СтандартнаяОбработка,ДокументОбъект,ЭтаФорма);
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	// Установить видимость реквизитов и заголовков колонок.	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Вывести в заголовке формы вид операции и статус документа (новый, не проведен, проведен).
	УстановитьЗаголовокФормыДокумента();
	
	// Зададим имена реквизитов, подлежащих кешированию.
	мКэшРеквизитовФормы = Новый Структура;
	
	// Запомним текущие значения реквизитов формы.
	ЗаполнитьТекущиеЗначенияРеквизитовФормы();
	
	УправлениеЭлементамиФормы();
	
	ПриОткрытииНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФорм

&НаКлиенте
Процедура ВыписатьРеализацию(Команда)
	
	Если (Объект.ПометкаУдаления) И Не ЗначениеЗаполнено(Объект.РеализацияТоваровУслуг) Тогда
		
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ВыписатьРеализациюЗавершение3", ЭтотОбъект), "Реализацию товаров и услуг нельзя вводить на основании документа, помеченного на удаление.");
		
		Возврат;
		
	КонецЕсли;
	
	Если (НЕ ЗначениеЗаполнено(Объект.РеализацияТоваровУслуг)) Тогда
		
		// Вводим новый документ на основании нашего.
		Если ЭтаФорма.Модифицированность Тогда
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ВыписатьРеализациюЗавершение2", ЭтотОбъект), "Документ был изменен. Сначала следует записать документ.");
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если (НЕ ЗначениеЗаполнено(Объект.РеализацияТоваровУслуг)) Тогда
		
		ВыписатьРеализациюНаСервере();
		
		ПоказатьЗначение(Новый ОписаниеОповещения("ВыписатьРеализациюЗавершение1", ЭтотОбъект), Объект.РеализацияТоваровУслуг);
		Возврат;
		
	Иначе
		
		ПоказатьЗначение(Новый ОписаниеОповещения("ВыписатьРеализациюЗавершение", ЭтотОбъект), Объект.РеализацияТоваровУслуг);
		Возврат;
		
	КонецЕсли;
	
	ВыписатьРеализациюФрагмент1();
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьРеализациюЗавершение3(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьРеализациюЗавершение2(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьРеализациюЗавершение1(ДополнительныеПараметры) Экспорт
	
	// Откроем форму для редактирования.
	ВыписатьРеализациюФрагмент1();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьРеализациюФрагмент1()
	
	ВыписатьРеализациюФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьРеализациюЗавершение(ДополнительныеПараметры) Экспорт
	
	ВыписатьРеализациюФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьРеализациюФрагмент()
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьСписание(Команда)
	
	Если (Объект.ПометкаУдаления) И Не ЗначениеЗаполнено(Объект.ТребованиеНакладная) Тогда
		
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ВыписатьСписаниеЗавершение3", ЭтотОбъект), "Требование-накладную нельзя вводить на основании документа, помеченного на удаление");
		
		Возврат;
		
	КонецЕсли;
	
	Если (НЕ ЗначениеЗаполнено(Объект.ТребованиеНакладная)) Тогда
		
		// Вводим новый документ на основании нашего.
		Если ЭтаФорма.Модифицированность Тогда
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ВыписатьСписаниеЗавершение2", ЭтотОбъект), "Документ был изменен. Сначала следует записать документ.");
			
			Возврат;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если (НЕ ЗначениеЗаполнено(Объект.ТребованиеНакладная)) Тогда
		
		ВыписатьСписаниеНаСервере();
		
		ПоказатьЗначение(Новый ОписаниеОповещения("ВыписатьСписаниеЗавершение1", ЭтотОбъект), Объект.ТребованиеНакладная);
		Возврат;
		
	Иначе
		
		ПоказатьЗначение(Новый ОписаниеОповещения("ВыписатьСписаниеЗавершение", ЭтотОбъект), Объект.ТребованиеНакладная);
		Возврат;
		
	КонецЕсли;
	
	ВыписатьСписаниеФрагмент1();
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьСписаниеЗавершение3(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьСписаниеЗавершение2(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьСписаниеЗавершение1(ДополнительныеПараметры) Экспорт
	
	ВыписатьСписаниеФрагмент1();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьСписаниеФрагмент1()
	
	ВыписатьСписаниеФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьСписаниеЗавершение(ДополнительныеПараметры) Экспорт
	
	// Откроем форму для редактирования Требования-накладной.
	ВыписатьСписаниеФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыписатьСписаниеФрагмент()
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФактПоПлану(Команда)
	
	Для каждого ТекСтрока Из Объект.Работы Цикл
		
		ТекСтрока.Объем 	  = ТекСтрока.ОбъемПлан;
		ТекСтрока.Количество  = ТекСтрока.КоличествоПлан;
		ТекСтрока.СуммаРаботы = ТекСтрока.СуммаПлан;
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Объект.НарядЗаказ.Количество() > 0 Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект), "Табличная часть """"Наряд-Заказ"""" содержит строки! Очистить?", РежимДиалогаВопрос.ДаНет, , КодВозвратаДиалога.Нет);
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Объект.НарядЗаказ.Очистить();
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФрагмент()
	
	ЗаполнитьНаСервере();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Объект.Работы.Количество() <> 0 ИЛИ Объект.НарядЗаказ.Количество() <> 0 ИЛИ ЗначениеЗаполнено(Объект.ОбъектУчета) Тогда
		
		Объект.Работы.Очистить();
		Объект.НарядЗаказ.Очистить();
		
		Если ЗначениеЗаполнено(Объект.ВидОбъекта) Тогда
			
			Если Объект.ВидОбъекта = ПолучитьВидОбъектовУчетаЗдание() Тогда
				
				Объект.ОбъектУчета = ПолучитьПустойСписокЗданий();
				
			Иначе
				
				Объект.ОбъектУчета = ПолучитьПустойЛицевойСчет();
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПодразделениеПриИзменении(Элемент)
	
	Если Объект.Работы.Количество() <> 0 ИЛИ Объект.НарядЗаказ.Количество() <> 0 Тогда
		
		Объект.Работы.Очистить();
		Объект.НарядЗаказ.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидОбъектаПриИзменении(Элемент)
	
	Если Объект.Работы.Количество() <> 0 ИЛИ Объект.НарядЗаказ.Количество() <> 0 Тогда
		
		Объект.Работы.Очистить();
		Объект.НарядЗаказ.Очистить();
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ВидОбъекта) Тогда
		
		Если Объект.ВидОбъекта = ПолучитьВидОбъектовУчетаЗдание() Тогда
			
			Если ТипЗнч(ПолучитьПустойСписокЗданий()) <> ТипЗнч(Объект.ОбъектУчета) Тогда
				
				Объект.ОбъектУчета = ПолучитьПустойСписокЗданий();
				
			КонецЕсли;
			
		Иначе
			
			Если ТипЗнч(ПолучитьПустойЛицевойСчет()) <> ТипЗнч(Объект.ОбъектУчета) Тогда
				
				Объект.ОбъектУчета = ПолучитьПустойЛицевойСчет();
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектУчетаПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Объект.ОбъектУчета) Тогда
		
		Если Объект.ВидОбъекта = ПолучитьВидОбъектовУчетаЗдание() Тогда
			
			Объект.Адрес =
			Строка(ПолучитьУлицуОбъектаУчета(Объект.ОбъектУчета))
			+ ", д." + Объект.ОбъектУчета + 
			?(ПустаяСтрока(ПолучитьКорпусОбъектаУчета(Объект.ОбъектУчета)),
			"",
			", кор. " + ПолучитьКорпусОбъектаУчета(Объект.ОбъектУчета));
			
		Иначе
			
			Объект.Адрес = Строка(ПолучитьУлицуЛицевогоСчетаОбъектаУчета(Объект.ОбъектУчета)) + ", д. " + Строка(ПолучитьЗданиеОбъектаУчета(Объект.ОбъектУчета)) + 
			?(ПустаяСтрока(ПолучитьКорпусЗданияОбъектаУчета(Объект.ОбъектУчета)),
			"",
			", кор. " + ПолучитьКорпусЗданияОбъектаУчета(Объект.ОбъектУчета) + ", кв. " + Строка(ПолучитьКвартируОбъектаУчета(Объект.ОбъектУчета)));
			
			ВывестиСуммуДолгаПоЛСНаСервере();
			
		КонецЕсли;
		
	Иначе
		
		Объект.Адрес              = "";
		Элементы.ДолгПоТекущемуЛС = "";
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбъектУчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("Организация",Объект.Организация);
		
		Если Объект.ВидОбъекта = ПолучитьВидОбъектовУчетаЗдание() Тогда
			
			ФормаВыбора = "Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая";
			
		Иначе
			
			ФормаВыбора = "Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая";
			
		КонецЕсли;
		
		ОткрытьФорму(ФормаВыбора, Новый Структура("Отбор", Отбор), Элемент);
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните поле Организация.";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаявительНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ТипЗнч(Объект.Заявитель) = Тип("СправочникСсылка.бит_Проживающие") Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ДанныеВыбора = ПолучитьСписокПроживающих(Объект.ОбъектУчета, Объект.Дата);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыРаботаПриИзменении(Элемент)
	
	ТекущаяСтрока	 = Элементы.Работы.ТекущиеДанные;
	Норма			 = ТекущаяСтрока.Норма;
	ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
	
	Если ЗначениеЗаполнено(ТекущаяСтрока.Работа) Тогда
		
		Владелец = ВладелецНаСервере(Норма);	
		
		Если Норма.Владелец <> ТекущаяСтрока.Работа Тогда
			
			ТекущаяСтрока.Норма = ПолучитьПустуюНормуТруда();	
			ТекущаяСтрока.ЕдиницаИзмерения = ПолучитьПустойКлассификаторЕдиницИзмерения();
			
		КонецЕсли;  
		
	КонецЕсли;  
	
	Коэффициент = ПолучитьОбъемРаботы(ТекущаяДата(), Объект.Подразделение, Объект.ВидОбъекта, ТекущаяСтрока.Работа, ТекущаяСтрока.ЕдиницаИзмерения, ТекущаяСтрока.Норма);
	
	Если Коэффициент <> 0 Тогда
		
		ТекущаяСтрока.КоэффициентНормы = Коэффициент;
		ТекущаяСтрока.ОбъемПлан 	   = Коэффициент;
		ТекущаяСтрока.КоличествоПлан   = 1;
		
	Иначе
		
		ТекущаяСтрока.ОбъемПлан 	   = 0;
		ТекущаяСтрока.КоэффициентНормы = 0;
		
	КонецЕсли; 
	
	ЦенаРаботы = ПолучитьЦенуРаботы(ТекущаяДата(), Объект.ВалютаДокумента, Объект.Подразделение, Объект.ВидОбъекта, ТекущаяСтрока.Работа, ТекущаяСтрока.ЕдиницаИзмерения, ТекущаяСтрока.Норма);
	
	ТекущаяСтрока.ЦенаРаботы = ЦенаРаботы;
	
	РассчитатьСтрокуТабЧастиРаботы(ТекущаяСтрока);
	
КонецПроцедуры

&НаСервере
Функция ВладелецНаСервере(Норма)
	
	Возврат Норма.Владелец;
	
КонецФункции

&НаКлиенте
Процедура РаботыЕдиницаИзмеренияПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	Норма 		  = ТекущаяСтрока.Норма;
	
	ЕдиницаИзмерения = ЕдиницаИзмеренияНаСервере(Норма);
	
	Если ЗначениеЗаполнено(Норма) Тогда
		
		Если ТекущаяСтрока.ЕдиницаИзмерения <> ЕдиницаИзмерения Тогда
			
			ТекущаяСтрока.Норма = ПолучитьПустуюНормуТруда();	
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Коэффициент = ПолучитьОбъемРаботы(ТекущаяДата(), Объект.Подразделение, Объект.ВидОбъекта, ТекущаяСтрока.Работа, ТекущаяСтрока.ЕдиницаИзмерения, ТекущаяСтрока.Норма);
	
	Если Коэффициент <> 0 Тогда
		
		ТекущаяСтрока.КоэффициентНормы = Коэффициент;
		ТекущаяСтрока.ОбъемПлан 	   = Коэффициент;
		ТекущаяСтрока.КоличествоПлан   = 1;
		
	Иначе
		
		ТекущаяСтрока.ОбъемПлан 	   = 0;
		ТекущаяСтрока.КоэффициентНормы = 0;
		
	КонецЕсли; 
	
	ЦенаРаботы = ПолучитьЦенуРаботы(ТекущаяДата(), Объект.ВалютаДокумента, Объект.Подразделение, Объект.ВидОбъекта, ТекущаяСтрока.Работа, ТекущаяСтрока.ЕдиницаИзмерения, ТекущаяСтрока.Норма);
	
	ТекущаяСтрока.ЦенаРаботы = ЦенаРаботы;
	
	РассчитатьСтрокуТабЧастиРаботы(ТекущаяСтрока);
	
КонецПроцедуры

