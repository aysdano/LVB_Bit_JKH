Процедура СвПоМестуПребывания(Команда)
	
	ПодчиненныйДокумент = НайтиПодчиненныйДокумент(Объект.Ссылка);
	
	Если ПодчиненныйДокумент <> Неопределено Тогда
		
		ОткрытьФорму("Документ.бит_СвидетельствоОРегистрацииПоМестуПребывания.Форма.ФормаДокументаУправляемая",Новый Структура("Ключ",ПодчиненныйДокумент), ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиПодчиненныйДокумент(Основание)
	
	Перем ПодчиненныйДокумент;
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", Основание);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_СвидетельствоОРегистрацииПоМестуПребывания.Ссылка КАК ПодчиненныйДокумент
	|ИЗ
	|	Документ.бит_СвидетельствоОРегистрацииПоМестуПребывания КАК бит_СвидетельствоОРегистрацииПоМестуПребывания
	|ГДЕ
	|	бит_СвидетельствоОРегистрацииПоМестуПребывания.ДокументОснование = &ДокументОснование
	|	И НЕ бит_СвидетельствоОРегистрацииПоМестуПребывания.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПодчиненныйДокумент = Выборка.ПодчиненныйДокумент;
	КонецЕсли;
	
	Возврат ПодчиненныйДокумент;
	
КонецФункции

