	Район = СтрНайти(АдресXML, "district"":");
	Город = СтрНайти(АдресXML,"city"":");
	Улица = СтрНайти(АдресXML,"street"":");
	Поселение = СтрНайти(АдресXML,"settlement"":");
	Территория = СтрНайти(АдресXML,"territory"":");
	Населенный = СтрНайти(АдресXML,"locality"":");
	Пункт = СтрНайти(АдресXML,"localityType"":");
	ДомНомер = СтрНайти(АдресXML,"houseNumber"":");
	
	КорпусНомер = СтрНайти(АдресXML,"buildings"":");
	КвартираНомер = СтрНайти(АдресXML,"apartments"":");
	
	Если Район Тогда
		Начало = Район + 12;
		Конец =   СтрНайти(АдресXML, """,",,  Начало,);
		
		СтруктураРезультат.Район = Сред(АдресXML, Начало, Конец-Начало);
		
	КонецЕсли;
	
	Если КорпусНомер Тогда
