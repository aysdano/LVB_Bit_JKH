					Строки.СубконтоКУ2 = СубконтоЛьготУСО2;
					Строки.СубконтоКУ3 = СубконтоЛьготУСО3;
				КонецЕсли;
				
				// БИТ_ЖКХ_28082013_начало_изменений
			ИначеЕсли ЭтоНачислениеРасчетаПредельногоИндекса Тогда
				
				Строки.СчетКУ      = СчетРасчетПИУСО;
				Строки.СубконтоКУ1 = СубконтоРасчетПИУСО1;
				Строки.СубконтоКУ2 = СубконтоРасчетПИУСО2;
				Строки.СубконтоКУ3 = СубконтоРасчетПИУСО3;
				// БИТ_ЖКХ_28082013_начало_изменений
				
			ИначеЕсли ЭтоПереносОстатковРазовые Тогда
				
				Строки.СчетКУ = СтруктураСчетовЖКХ.ТранзитныйСчетОплаты;
				
			Иначе
				
				Строки.СчетКУ = СтруктураСчетовЖКХ.СчетСторПКУ;
				
				// БИТ_ЖКХ 23.11.2010  Начало{
				Если Не НомерСтрокиСубконтоКонтрагентыПКУ = -1 тогда
					Строки["СубконтоКУ"+НомерСтрокиСубконтоКонтрагентыПКУ] = ПолучательДенежныхСредств;
				КонецЕсли;
				
				// БИТ_ЖКХ 11.01.2016 15:03:14 Начало правки... 
				Если Не НомерСтрокиСубконтоДоговорыПКУ = -1 Тогда
					
					ОсновнойДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
					РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ОсновнойДоговорКонтрагента,ПолучательДенежныхСредств,Организация);
					Если бит_рлс_ОбщегоНазначения.СсылкаДоступна(ОсновнойДоговорКонтрагента) Тогда
						Если ОсновнойДоговорКонтрагента.Организация = Организация Тогда
							Строки["СубконтоКУ"+НомерСтрокиСубконтоДоговорыПКУ] = ДоговорПолучателя;
						ИначеЕсли ОсновнойДоговорКонтрагента.Пустая() Тогда	
							Строки["СубконтоКУ"+НомерСтрокиСубконтоДоговорыПКУ] = ДоговорПолучателя;
						КонецЕсли;
					КонецЕсли;
					
				КонецЕсли;
				//Если Не НомерСтрокиСубконтоДоговорыПКУ = -1 И бит_рлс_ОбщегоНазначения.СсылкаДоступна(ПолучательДенежныхСредств.УдалитьОсновнойДоговорКонтрагента) тогда
				//	Если ПолучательДенежныхСредств.УдалитьОсновнойДоговорКонтрагента.Организация = Организация Тогда
				//		Строки["СубконтоКУ"+НомерСтрокиСубконтоДоговорыПКУ] = ДоговорПолучателя;
				//		
				//		// БИТ_ЖКХ 27.11.2014{{	
				//	ИначеЕсли ПолучательДенежныхСредств.УдалитьОсновнойДоговорКонтрагента.Ссылка.Пустая() Тогда	
				//		Строки["СубконтоКУ"+НомерСтрокиСубконтоДоговорыПКУ] = ДоговорПолучателя;
				//		// БИТ_ЖКХ 27.11.2014}}
				//		
				//	КонецЕсли; 
				//КонецЕсли;
				// БИТ_ЖКХ 11.01.2016 15:03:23 Конец правки. 
				
			КонецЕсли;
			
			// БИТ_ЖКХ 23.11.2010 }Конец
			
		КонецЕсли;
		
		// Изменения типа значения субконто КУ
		Если НЕ Строки.СчетКУ = Неопределено Тогда
			ОбработатьПоляСубконтаКУ(Строки, Организация);
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

