			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Кол проживающих по ЛС</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КолЛСПоКвартире</dataPath>
			<field>КолЛСПоКвартире</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Кол ЛСПо квартире</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_Квартиры.Ссылка КАК Квартира,
	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчетКвартиры,
	бит_Квартиры.КоличествоКомнат КАК КоличествоКомнат,
	бит_СписокЗданий.Район КАК Район,
	бит_СписокЗданий.Участок КАК Участок,
	бит_СписокЗданий.Улица КАК Улица,
	бит_СписокЗданий.Ссылка КАК Здание,
	бит_Квартиры.НомерКвартиры КАК НомерКвартиры,
	бит_Квартиры.ПрефиксКвартиры КАК ПрефиксКвартиры,
	бит_СписокЗданий.Корпус КАК Корпус
ПОМЕСТИТЬ СписокКвартир
ИЗ
	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
			ПО бит_СписокЗданий.Ссылка = бит_Квартиры.Владелец
		ПО (бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ЕСТЬNULL(бит_ЛицевыеСчета.Ссылка, ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)) КАК ЛицевойСчет1,
	СписокКвартир.Квартира КАК Квартира
ПОМЕСТИТЬ СписокЛицевыхСчетов
ИЗ
	СписокКвартир КАК СписокКвартир
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		ПО СписокКвартир.Квартира = бит_ЛицевыеСчета.Квартира
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	СписокЛицевыхСчетов.Квартира КАК Квартира,
	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	СписокЛицевыхСчетов.ЛицевойСчет1 КАК ЛицевойСчет1
ПОМЕСТИТЬ СписокОтветственных
ИЗ
	СписокЛицевыхСчетов КАК СписокЛицевыхСчетов
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&amp;Период, ) КАК бит_ПроживающиеПоЛССрезПоследних
		ПО СписокЛицевыхСчетов.ЛицевойСчет1 = бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
ГДЕ
	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации &gt; &amp;Период
			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	СписокКвартир.Квартира КАК Квартира,
	СписокКвартир.КоличествоКомнат КАК КоличествоКомнат,
	СписокКвартир.Район КАК Район,
	СписокКвартир.Улица КАК Улица,
	СписокКвартир.Здание КАК Здание,
	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь КАК ЖилаяПлощадь,
	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь КАК ОтапливаемаяПлощадь,
	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь КАК СовокупнаяПлощадь,
	СписокКвартир.Участок КАК Участок,
	СписокОтветственных.ФизЛицо КАК ФизЛицо,
	СписокКвартир.НомерКвартиры КАК НомерКвартиры,
	СписокКвартир.ПрефиксКвартиры КАК ПрефиксКвартиры,
	СписокКвартир.Корпус КАК Корпус,
	ВЫБОР
		КОГДА СписокЛицевыхСчетов.ЛицевойСчет1 ЕСТЬ NULL
				ИЛИ СписокЛицевыхСчетов.ЛицевойСчет1 = НЕОПРЕДЕЛЕНО
			ТОГДА ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)
		ИНАЧЕ СписокЛицевыхСчетов.ЛицевойСчет1
	КОНЕЦ КАК ЛицевойСчет
ПОМЕСТИТЬ ИтоговаяТаблица
ИЗ
	СписокКвартир КАК СписокКвартир
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&amp;Период, ) КАК бит_СведенияОКвартиреСрезПоследних
		ПО СписокКвартир.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
		ЛЕВОЕ СОЕДИНЕНИЕ СписокЛицевыхСчетов КАК СписокЛицевыхСчетов
		ПО СписокКвартир.Квартира = СписокЛицевыхСчетов.Квартира
		ЛЕВОЕ СОЕДИНЕНИЕ СписокОтветственных КАК СписокОтветственных
		ПО СписокКвартир.Квартира = СписокОтветственных.Квартира
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	СписокКвартир.Квартира КАК Квартира,
	СписокКвартир.ЛицевойСчетКвартиры КАК ЛицевойСчетКвартиры,
	1 КАК КолЛСПоКвартире
ПОМЕСТИТЬ ИтоговаяТаблицаЛС
ИЗ
	СписокКвартир КАК СписокКвартир
		ЛЕВОЕ СОЕДИНЕНИЕ СписокЛицевыхСчетов КАК СписокЛицевыхСчетов
		ПО СписокКвартир.Квартира = СписокЛицевыхСчетов.Квартира
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИтоговаяТаблицаЛС.Квартира КАК Квартира,
	СУММА(ИтоговаяТаблицаЛС.КолЛСПоКвартире) КАК КолЛСПоКвартире
ПОМЕСТИТЬ ИтоговаяТаблицаКолЛС
ИЗ
	ИтоговаяТаблицаЛС КАК ИтоговаяТаблицаЛС

СГРУППИРОВАТЬ ПО
	ИтоговаяТаблицаЛС.Квартира
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛС_Проживающего,
	1 КАК КолПроживающихПоЛС
ПОМЕСТИТЬ Проживающие
ИЗ
	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних КАК бит_ПроживающиеПоЛССрезПоследних
ГДЕ
	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = &amp;ДатаСнятияСРегистрации
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	Проживающие.ЛС_Проживающего КАК ЛС_Проживающего,
	СУММА(Проживающие.КолПроживающихПоЛС) КАК КолПроживающихПоЛС
ПОМЕСТИТЬ ИтоговаяТаблицаКолПроживающие
ИЗ
	Проживающие КАК Проживающие

СГРУППИРОВАТЬ ПО
	Проживающие.ЛС_Проживающего
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ИтоговаяТаблица.Квартира КАК Квартира,
	ИтоговаяТаблица.КоличествоКомнат КАК КоличествоКомнат,
	ИтоговаяТаблица.Район КАК Район,
	ИтоговаяТаблица.Улица КАК Улица,
	ИтоговаяТаблица.Здание КАК Здание,
	ИтоговаяТаблица.ОбщаяПлощадь КАК ОбщаяПлощадь,
	ИтоговаяТаблица.ЖилаяПлощадь КАК ЖилаяПлощадь,
	ИтоговаяТаблица.ТипКвартиры КАК ТипКвартиры,
	ИтоговаяТаблица.СтатусКвартиры КАК СтатусКвартиры,
	ИтоговаяТаблица.ОтапливаемаяПлощадь КАК ОтапливаемаяПлощадь,
	ИтоговаяТаблица.СовокупнаяПлощадь КАК СовокупнаяПлощадь,
	ИтоговаяТаблица.Участок КАК Участок,
	ИтоговаяТаблица.ФизЛицо КАК ФизЛицо,
	ИтоговаяТаблица.НомерКвартиры КАК НомерКвартиры,
	ИтоговаяТаблица.ПрефиксКвартиры КАК ПрефиксКвартиры,
	ИтоговаяТаблица.Корпус КАК Корпус,
	ИтоговаяТаблица.ЛицевойСчет КАК ЛицевойСчет,
	ВЫБОР
		КОГДА ИтоговаяТаблица.ЛицевойСчет = ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)
			ТОГДА ЛОЖЬ
		ИНАЧЕ бит_ЛицевыеСчета.Архивный
	КОНЕЦ КАК Архивный,
	ИтоговаяТаблицаКолПроживающие.КолПроживающихПоЛС КАК КолПроживающихПоЛС,
	ИтоговаяТаблицаКолЛС.КолЛСПоКвартире КАК КолЛСПоКвартире
ИЗ
	ИтоговаяТаблица КАК ИтоговаяТаблица
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		ПО ИтоговаяТаблица.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИтоговаяТаблицаКолПроживающие КАК ИтоговаяТаблицаКолПроживающие
		ПО ИтоговаяТаблица.ЛицевойСчет = ИтоговаяТаблицаКолПроживающие.ЛС_Проживающего
		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ИтоговаяТаблицаКолЛС КАК ИтоговаяТаблицаКолЛС
		ПО ИтоговаяТаблица.Квартира = ИтоговаяТаблицаКолЛС.Квартира</query>
	</dataSet>
	<calculatedField>
		<dataPath>КоличествоПроживающих</dataPath>
		<expression>бит_ОтчетыВызовСервера.ПолучитьКоличествоПроживающихНаЛС(ЛицевойСчет)</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Количество проживающих</v8:content>
