Процедура СформироватьДвиженияВводНачальныхОстатковПоКУХозрасчетный(ТаблицаУслуг,Реквизиты, Движения, Отказ) Экспорт
	
	Для каждого СтрокаТаблицы Из ТаблицаУслуг Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетАбонента) 
			ИЛИ НЕ ЗначениеЗаполнено(СтрокаТаблицы.СчетКУ) Тогда
			Продолжить;
		КонецЕсли; 
		
		Проводка = Движения.Хозрасчетный.Добавить();
		
		Проводка.Период      = Реквизиты.Дата;
		Проводка.Содержание  = "Ввод начальных остатков по КУ";
		Проводка.Организация = Реквизиты.Организация;
		
		мСумма = СтрокаТаблицы.Сумма;
		
		НаправлениеДвиженияАбонента = "Дт";
		НаправлениеДвиженияКУ       = "Кт";
		
		Если мСумма < 0 Тогда
			
			мСумма = мСумма * -1;
			НаправлениеДвиженияАбонента = "Кт";
			НаправлениеДвиженияКУ       = "Дт";
			
		КонецЕсли; 
		
		Проводка["Счет" + НаправлениеДвиженияАбонента] = СтрокаТаблицы.СчетАбонента;
		БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияАбонента], Проводка["Субконто" + НаправлениеДвиженияАбонента], 1, СтрокаТаблицы.Субконто1);
		БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияАбонента], Проводка["Субконто" + НаправлениеДвиженияАбонента], 2, СтрокаТаблицы.Субконто2);
		БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияАбонента], Проводка["Субконто" + НаправлениеДвиженияАбонента], 3, СтрокаТаблицы.Субконто3);
		Проводка["Счет" + НаправлениеДвиженияКУ] = СтрокаТаблицы.СчетКУ;
		Проводка.Сумма = мСумма;
		
	КонецЦикла;
	
	Движения.Хозрасчетный.Записывать = Истина;
	
КонецПроцедуры

