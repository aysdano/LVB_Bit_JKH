	ЗамерВремени (Д1,"Подбор основных значений из базы");
	
	жж_СоздатьОтсутствующихЖильцов(Табл);
	
	//Табл = Набор.Выгрузить();
	Табл.Колонки.Добавить("Ключ",новый описаниеТипов("Строка"));
	Для каждого СтрокаТ из Табл цикл 
		СтрокаТ.Ключ = СтрокаТ.LS + СтрокаТ.FIO+СтрокаТ.NAME + СтрокаТ.OTCH + СтрокаТ.D_R+строкаТ.D_PR; 
		Если ЗначениеЗаполнено(СтрокаТ.Жилец) Тогда
			СпрОбъект = СтрокаТ.Жилец.ПолучитьОбъект();
			СпрОбъект.СтраховойНомерПФР = СтрокаТ.SNILS;
			//СпрОбъект.Комментарий = СтрокаТ.PR;
			//СпрОбъект.ФактАдресПроживающего = СтрокаЖ.FAKT_ADR;
			Если СтрокаТ.SOGL=" " тогда
				; //ничего не делаем
			ИначеЕсли СтрНайти("0OoОо",СтрокаТ.SOGL)>0  тогда   //о - отказ, все похожие символы
				СпрОбъект.лб_СогласиеНаОбработкуПД = Перечисления.лб_ВидСогласияНаОбработкуПД.Отказ			
			ИначеЕсли СтрНайти("Пп",СтрокаТ.SOGL)>0  тогда      //п - паспортный, все похожие символы
				СпрОбъект.лб_СогласиеНаОбработкуПД = Перечисления.лб_ВидСогласияНаОбработкуПД.ЕстьПаспортныйСтол;
			ИначеЕсли СтрНайти("3зЗЭэАаaA",СтрокаТ.SOGL)>0  тогда   //з - заявление, а - абонентский, все похожие символы
				СпрОбъект.лб_СогласиеНаОбработкуПД = Перечисления.лб_ВидСогласияНаОбработкуПД.ЕстьАбонентскийОтдел;			
			КонецЕсли;	
			СпрОбъект.Записать();
		КонецЕсли;
	КонецЦикла;	
	Табл.Индексы.Добавить("Ключ");
	Табл.Сортировать("Ключ");
	ЧислоСтрок = Табл.Количество();
	Для СчетВниз=1 по ЧислоСтрок-1 цикл Инд = ЧислоСтрок-СчетВниз; Если Табл[инд].Ключ = Табл[инд-1].Ключ тогда Табл.Удалить(инд) КонецЕсли; КонецЦикла; 
	Если Табл.Количество()<>Набор.Количество() тогда
		Табл.Колонки.Удалить("Ключ");
		//Набор.Загрузить(Табл);
