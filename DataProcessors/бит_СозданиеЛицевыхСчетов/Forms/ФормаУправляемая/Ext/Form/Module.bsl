&НаКлиенте
Процедура ЗданиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("Улица", Объект.УлицаЛицевогоСчета);
	
	ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура КвартирыНомерЛСОткрытие(Элемент, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Элементы.Квартиры.ТекущиеДанные.ЛС) Тогда
		
		СтандартнаяОбработка = ЛОЖЬ;
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ",Элементы.Квартиры.ТекущиеДанные.ЛС);
		
		ФормаЛС = ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаЭлементаУправляемая",ПараметрыФормы,Элемент);	
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КвартирыНомерЛСПриИзменении(Элемент)
	
	Если ЗначениеЗаполнено(Элементы.Квартиры.ТекущиеДанные.ЛС) Тогда
		// Если ЛС уже есть, то менять его номер нельзя.
		Элементы.Квартиры.ТекущиеДанные.НомерЛС = Элементы.Квартиры.ТекущиеДанные.ЛС.Наименование;
	Иначе
		// Проверим уникальность номера лицевого счета.
		Если ЗначениеЗаполнено(Элементы.Квартиры.ТекущиеДанные.НомерЛС) Тогда
			НомерУникален = ИСТИНА;
			
			НайденыйЛС			= НайтиПоНаименованиюНаСервере(Элементы.Квартиры.ТекущиеДанные.НомерЛС);
			
			Если НЕ НайденыйЛС.Пустая() Тогда
				НомерУникален = ЛОЖЬ;
			Иначе
				Отбор = Новый Структура();
				Отбор.Вставить("НомерЛС",Элементы.Квартиры.ТекущиеДанные.НомерЛС);			
				НайденыеСтроки = Объект.Квартиры.НайтиСтроки(Отбор);
				Если НайденыеСтроки.Количество()>1 Тогда
					НомерУникален = ЛОЖЬ;
				КонецЕсли;
			КонецЕсли;
			Если НЕ НомерУникален Тогда
				Элементы.Квартиры.ТекущиеДанные.НомерЛС = "";

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("ЛС с таким номером уже есть");
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаНумерацииЖилОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)

	ВыбранноеЗначение = мКэшЗначений.ВыбранныйЭлемент;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПравилаНумерацииЖилНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Очистить();
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Добавить("Квартира","По номеру квартиры",,БиблиотекаКартинок.бит_ОПрограмме);
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Добавить("ПоПорядку","Последовательная нумерация",,БиблиотекаКартинок.бит_Реквизиты);
	
	ВыбранныйЭлемент = Неопределено;

	
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПравилаНумерацииЖилНачалоВыбораЗавершение", ЭтотОбъект), Элементы.ПравилаНумерацииЖил.СписокВыбора, Элементы.ПравилаНумерацииЖил);

КонецПроцедуры

&НаКлиенте
Процедура ПравилаНумерацииЖилНачалоВыбораЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
    
    ВыбранныйЭлемент = ВыбранныйЭлемент1;
    
    Если ВыбранныйЭлемент = Неопределено Тогда
        
        Возврат;
        
    КонецЕсли;	
    
    ПравилаНумерацииЖилНаСервере(Строка(ВыбранныйЭлемент));
    
    УправлениеВидимостью();

КонецПроцедуры

