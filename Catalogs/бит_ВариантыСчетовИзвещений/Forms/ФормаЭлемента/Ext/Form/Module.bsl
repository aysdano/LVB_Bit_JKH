&НаКлиенте
Процедура ВыполнитьПроверкуАльгоритма(Команда)
	
	Если Параметры.Ключ.Пустая() ИЛИ Модифицированность Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перед проверкой, запишите элемент.");
		
		Возврат;
		
	КонецЕсли; 
	
	Форма = ПолучитьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая");
	ЛицевойСчет = Форма.ОткрытьМодально();
	
	Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
		
		Результат = СформироватьМакетПоЛС(ЛицевойСчет, Параметры.Ключ);
		
		Если НЕ Результат = Неопределено Тогда
			Результат.Показать("Результат проверки алгоритма печати варианта счет-извещения """ + Объект.Наименование +""".",,Истина);
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервереБезконтекста
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция СформироватьМакетПоЛС(ЛицевойСчет, МакетКв)
	
	Результат = Неопределено;
	
	ОбработкаОбъект = Обработки.бит_ПечатьСчетИзвещений.Создать();
	
	ОбработкаОбъект.МакетКв               = МакетКв;
	ОбработкаОбъект.Период                = ДобавитьМесяц(КонецМесяца(ТекущаяДата()), -1);
	ОбработкаОбъект.ШаблонИзвещений       = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
	ОбработкаОбъект.Организация           = ЛицевойСчет.Организация;
	ОбработкаОбъект.РС                    = ЛицевойСчет.Организация.ОсновнойБанковскийСчет;
	ОбработкаОбъект.ТекущийПакет          = 1;
	ОбработкаОбъект.РазмерПакетаПечати    = 500;
	ОбработкаОбъект.РазмерПакетаПросмотра = 50;
	
	НоваяСтрока = ОбработкаОбъект.СписокЛС.Добавить();
	НоваяСтрока.ЛицевойСчет = ЛицевойСчет;
	
	ТаблицаДанных = ОбработкаОбъект.СформироватьДанныеПечати();
	
	Результат = ОбработкаОбъект.ПечатьКвитанций(ТаблицаДанных);
	
	Возврат Результат;
	
КонецФункции // ()

&НаСервереБезконтекста
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура СоздатьНастройкиМакета(ТекущийОбъект)
	
	Настройки = ПолучитьНостройкуМакета(ТекущийОбъект.ОсновнойВариант);
	
	НовыеНастройки = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.СоздатьЭлемент();
	
	Если ТипЗнч(Настройки) = Тип("Структура") Тогда
		ЗаполнитьЗначенияСвойств(НовыеНастройки, Настройки);
	Иначе
		СвойстваИскл = "Родитель,Владелец,Код,Наименование";
		ЗаполнитьЗначенияСвойств(НовыеНастройки, Настройки,,СвойстваИскл);
	КонецЕсли; 
	
	НовыеНастройки.УстановитьНовыйКод();
	НовыеНастройки.Наименование   = "Настройки: " + ТекущийОбъект.Наименование;
	НовыеНастройки.МакетКвитанции = ТекущийОбъект.Ссылка;
	
	// БИТ_ЖКХ 12.08.2014	
	Если НЕ ТекущийОбъект.Предопределенный Тогда
		НовыеНастройки.ИмяПредопределенныхДанных = "";
	КонецЕсли;
	// БИТ_ЖКХ 12.08.2014
	
	НовыеНастройки.Записать();
	
	НоваяЗапись = РегистрыСведений.бит_ТекущиеНастройкиМакетовСчетИзвещений.СоздатьМенеджерЗаписи();
	НоваяЗапись.МакетКвитанции  = ТекущийОбъект.Ссылка;
	
	// БИТ_ЖКХ 07.02.2014
	// НоваяЗапись.Пользователь    = глЗначениеПеременной("глТекущийПользователь");.
	НоваяЗапись.Пользователь    = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
	// БИТ_ЖКХ 07.02.2014
	
	НоваяЗапись.НастройкаМакета = НовыеНастройки.Ссылка;
	
	НоваяЗапись.Записать(Истина);
	
КонецПроцедуры // ()  

&НаСервереБезконтекста
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьНостройкуМакета(ОсновнойВариант)
	
	Настройка = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НастройкиПечатиМакетовСчетИзвещений.Ссылка
	|ИЗ
	|	Справочник.бит_НастройкиПечатиМакетовСчетИзвещений КАК бит_НастройкиПечатиМакетовСчетИзвещений
	|ГДЕ
	|	бит_НастройкиПечатиМакетовСчетИзвещений.МакетКвитанции = &МакетКвитанции
	|	И бит_НастройкиПечатиМакетовСчетИзвещений.Предопределенный";
	Запрос.УстановитьПараметр("МакетКвитанции", ОсновнойВариант);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Настройка = Выборка.Ссылка;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Настройка) Тогда
		
		Обработка = Обработки.бит_ПечатьСчетИзвещений.Создать();
		Настройка = Обработка.ПолучитьСтандартныеНастройкуМакета(ОсновнойВариант);
		
	КонецЕсли; 
	
	Возврат Настройка;
	
КонецФункции // ()

&НаСервере
Функция СортировкаСтруктуры(ОтчетСтруктура)
            //сортировка структуры
        ТЗ = Новый ТаблицаЗначений;
        ТЗ.Колонки.Добавить("Ключ");
        ТЗ.Колонки.Добавить("Значение");
        Для каждого элемент из ОтчетСтруктура Цикл
            новСтрока = ТЗ.Добавить();
            новСтрока.Ключ = Элемент.Ключ;
            новСтрока.Значение = Элемент.Значение;
        КонецЦикла;
        ТЗ.Сортировать("Ключ Возр");
        ОтчетСтруктура.Очистить();
        Для каждого строкаТЗ из ТЗ Цикл
            ОтчетСтруктура.Вставить(строкаТЗ.Ключ,строкаТЗ.Значение);
        КонецЦикла;     
        //
 
Возврат ОтчетСтруктура;
КонецФункции

