	ТекущаяСтрока = Элементы.РежимыПотребленияУслуг.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	УдалениеРазрешено = Истина;
	
	Отбор = Новый Структура("РежимПотребленияУслуг", ТекущаяСтрока.РежимПотребленияУслуг);
	
	Строки = Объект.РежимыПотребленияУслуг.НайтиСтроки(Отбор);
	
	Если Строки.Количество() <= 1 Тогда
		
		УдалениеРазрешено = ОпределитьВозможностьУдаленияРежимПотребления(ТекущаяСтрока.РежимПотребленияУслуг);	
		
	КонецЕсли; 	
	
	Если НЕ УдалениеРазрешено Тогда
		Отказ = Истина;
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Существуют документы проведенные по режиму потребления <"+ТекущаяСтрока.РежимПотребленияУслуг+">!
		|Удаление не возможно.";
		Сообщение.Сообщить();
		
		Возврат;
	КонецЕсли;
	
	Если ТекущаяСтрока.РежимПотребленияУслуг = Объект.ОсновнойРежимПотребления и Строки.Количество() <= 1 Тогда
