&НаСервере
Процедура ж_ЗагрузитьЖильцовДомаИзВременногоРегистра(СписокЛС)
	
	Д1 = ТекущаяДата();
	
	Счетчик = 1000; //количество обрабатываемых домов
	Сч=0;
	
	НаборП=Неопределено; //НаборП - набор проводок
	ТаблП= неопределено; //ТаблП = НаборП.Выгрузить();
	
	//НаборИсх = РегистрыСведений.лб_Тест_Жильцы.СоздатьНаборЗаписей();
	//НаборИсх.Прочитать();
	//ТаблИсх = НаборИсх.Выгрузить();
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("СписокЛС",СписокЛС);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	лб_Тест_Жильцы.* 
		|ИЗ
		|	РегистрСведений.лб_Тест_Жильцы КАК лб_Тест_Жильцы
		|ГДЕ
		|	лб_Тест_Жильцы.ЛС В(&СписокЛС) и (лб_Тест_Жильцы.Игнорировать = ложь)";
	ТаблИсх = Запрос.Выполнить().Выгрузить();	
	ТаблИсх.Индексы.Добавить("ЛС");
	НаборИсх = неопределено;
	
	//Список статусов ФЛ
	ПроживаетПостоянно   	 = Справочники.бит_СтатусФизЛица.ПостояннаяРегистрация;
	ПроживаетВременно    	 = Справочники.бит_СтатусФизЛица.ВременнаяРегистрация;	
	СобственникНеПроживает 	 = Справочники.бит_СтатусФизЛица.НайтиПоНаименованию("Владелец не проживает");
	ОтветственныйНеПроживает = Справочники.бит_СтатусФизЛица.НайтиПоНаименованию("Ответственный не проживает");
	УдаленСЛС 				 = Справочники.бит_СтатусФизЛица.Выписан;
	
	
	////Запрос эталон ЛС 
	//ЗапросЛС = новый запрос;
	//ЗапросЛС.Текст = 
	//	"ВЫБРАТЬ
	//	|	лб_Тест_ЛС.ЛС КАК ЛС,
	//	|	лб_Тест_ЛС.Ответственный КАК Ответственный,
	//	|	лб_Тест_ЛС.OTV КАК OTV,
	//	|	лб_Тест_ЛС.OTVETST КАК OTVETST,
	//	|	лб_Тест_ЛС.K_JIL КАК K_JIL,
	//	|	лб_Тест_ЛС.K_SOB КАК K_SOB,
	//	|	лб_Тест_ЛС.TAR КАК TAR
	//	|ИЗ
	//	|	РегистрСведений.лб_Тест_ЛС КАК лб_Тест_ЛС";
	//ТаблЛС = ЗапросЛС.Выполнить().Выгрузить();
	//ТаблЛС.Индексы.Добавить("ЛС");
	//
	
	
	
	
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Дата",КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("НеПроживает",Перечисления.бит_СтатусПроживания.НеПроживает);
	Запрос.УстановитьПараметр("Ответственный",Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо);
	Запрос.УстановитьПараметр("СписокЛС",СписокЛС);
	ЗАпрос.Текст =  ТекстЗапросаСравнитьЖильцов(СписокЛС.Количество()>0);
	ВыборкаЗдания = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	
	Д2 = ТекущаяДата();
	Сообщить("Подговтока таблиц = "+ (д2-д1)+ " сек.");
	
	
	Пока ВыборкаЗдания.Следующий()и Сч<Счетчик  Цикл
		Если НаборП<>Неопределено тогда
			НаборП.Загрузить(ТаблП);
			НаборП.Записать(истина);
		КонецЕсли;	
		Выборка = ВыборкаЗдания.Выбрать();
		Сообщить("    Обработка здания: "+ ВыборкаЗдания.Здание.Код + " -  ( "+Выборка.Количество()+ " л/с)" );
		ДокРегистратор = неопределено;
		Пока Выборка.Следующий() цикл		
			Если ДокРегистратор = неопределено тогда
				Запрос = новый запрос;
				Запрос.УстановитьПараметр("ЛС",Выборка.ЛС);
				Запрос.Текст = 
					 "ВЫБРАТЬ ПЕРВЫЕ 1
					 |	бит_ПроживающиеПоЛС.Регистратор КАК Регистратор
					 |ИЗ
					 |	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
					 |ГДЕ
					 |	бит_ПроживающиеПоЛС.ЛицевойСчет = &ЛС
					 |  и Регистратор Ссылка Документ.ОперацияБух
					 |
					 |УПОРЯДОЧИТЬ ПО
					 |	бит_ПроживающиеПоЛС.Регистратор.Дата УБЫВ";
				ВыборкаДок = Запрос.Выполнить().Выбрать();
				Если ВыборкаДок.Следующий() тогда
					ДокРегистратор = ВыборкаДок.Регистратор;
				иначе
					ДокОбъект = Документы.ОперацияБух.СоздатьДокумент();
					ДокОбъект.Дата = '2018-07-01';
					ДокОбъект.Организация = Выборка.ЛС.Организация;
					ДокОбъект.Содержание = "Данные по проживающим, дом "+Выборка.Здание.Код;
					ДокОбъект.Комментарий = ДокОбъект.Содержание;
					ДокОбъект.Записать();
					ДокРегистратор = ДокОбъект.Ссылка;					
				КонецЕсли;	
				НаборП = РегистрыСведений.бит_ПроживающиеПоЛС.СоздатьНаборЗаписей();
				НаборП.Отбор.Регистратор.Значение = ДокРегистратор;
				НаборП.Прочитать();
				ТаблП = НаборП.Выгрузить();
			КонецЕсли;	
			
						
			//обработка данных ЛС
			
			//СтрокаЛС = ТаблЛС.Найти(Выборка.ЛС,"ЛС");
			
			//Убираем старые записи
			Отбор = новый структура("ЛицевойСчет",Выборка.ЛС);
			СтрокиЛС = ТаблП.НайтиСтроки(Отбор);
			
			//Сообщить("ЛС " + Выборка.ЛС + " НАйдено записей - "+ СтрокиЛС.Количество());
			//Удаляем исходные строки
			Для каждого Строка из СтрокиЛС цикл
				Инд = ТаблП.Индекс(Строка);
				ТаблП.Удалить(Инд);			
			КонецЦикла;	        
			
			
						
			ОтборИсх = новый Структура("ЛС,Игнорировать",Выборка.ЛС,ложь);
			СтрокиИсх = ТаблИсх.НайтиСтроки(ОтборИсх);
			ТаблИсхЛС = ТаблИсх.Скопировать(СтрокиИсх);
			Если ложь тогда ТаблИсхЛС = новый ТаблицаЗначений КонецЕсли;
			ТаблИсхЛС.Сортировать("Жилец,ДатаПрописки");
			
			
			
			
			ЧислоСтрок = ТаблИсхЛС.Количество();
			Если Выборка.TAR = 0 тогда
				//Выбираем только ответственного и ставим ему "Ответственный не проживает"
				//без указания прописки и выписки
				
				 НовЗапись = ТаблП.Добавить();
				 НовЗапись.ЛицевойСчет   = Выборка.ЛС;
				 НовЗапись.ФизЛицо       = Выборка.ОтветственныйЭ;
				 НовЗапись.Период 		 = НаборП.Отбор.Регистратор.Значение.Дата;
				 НовЗапись.Активность = Истина;
				 НовЗапись.ВладелецКвартиры 	= Перечисления.ДаНет.Нет;
				 НовЗапись.СтатусФизЛица		= ОтветственныйНеПроживает;					
				 НовЗапись.СтепеньРодства       = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо;
				 НовЗапись.СтатусПроживания     = Перечисления.бит_СтатусПроживания.НеПроживает;
				 НовЗапись.ДатаРегистрации      = '0001-01-01';
				 НовЗапись.ДатаСнятияСРегистрации = '0001-01-01';
				 //НовЗапись.ДатаЗаписи             =  //дата окнчания действия 
				 НовЗапись.ДоляПлощади            = 0;
				 НовЗапись.лб_ДоляПлощадиСтрокой  = 0;
				 НовЗапись.лб_СтрокаРодствДляФЛС  = "л/с закрыт"							   
				
			 иначе
				//Найдем строку ответственного с самой большой датой
				СтрокаТекОтветственного = неопределено;
				ДатаПропискиОтветственного = '0001-01-01';			
				Для Индекс=0 по ТаблИсхЛС.Количество()-1 цикл
					ТекСтрока = ТаблИсхЛС[Индекс];
					Если ложь тогда ТекСтрока = РегистрыСведений.лб_Тест_Жильцы.СоздатьМенеджерЗаписи();  КонецЕсли;					
					Если ТекСтрока.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо и 
						 ТекСтрока.ДатаПрописки >=ДатаПропискиОтветственного 
					тогда
						 СтрокаТекОтветственного = ТекСтрока;
						 ДатаПропискиОтветственного = ТекСтрока.ДатаПрописки;
					КонецЕсли;	 
				КонецЦикла;	
				Если СтрокаТекОтветственного = неопределено тогда
					//вообще нет ответственного - добавляем ответственного сразу в регистр
					 НовЗапись = ТаблП.Добавить();
					 НовЗапись.ЛицевойСчет   = Выборка.ЛС;
					 НовЗапись.ФизЛицо       = Выборка.ОтветственныйЭ;
					 НовЗапись.Период 		 = НаборП.Отбор.Регистратор.Значение.Дата - 24*3600; //на день раньше
					 НовЗапись.Активность = Истина;
					 НовЗапись.ВладелецКвартиры 	= Перечисления.ДаНет.Нет;
					 НовЗапись.СтатусФизЛица		= ОтветственныйНеПроживает;					
					 НовЗапись.СтепеньРодства       = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо;
					 НовЗапись.СтатусПроживания     = Перечисления.бит_СтатусПроживания.НеПроживает;
					 НовЗапись.ДатаРегистрации      = '0001-01-01';
					 НовЗапись.ДатаСнятияСРегистрации = '0001-01-01';
					 //НовЗапись.ДатаЗаписи             =  //дата окнчания действия 
					 НовЗапись.ДоляПлощади            = 0;
					 НовЗапись.лб_ДоляПлощадиСтрокой  = 0;
					 НовЗапись.лб_СтрокаРодствДляФЛС  = "авто";
				ИначеЕсли  СтрокаТекОтветственного.ДатаВыписки<>'0001-01-01' тогда
					 //Был ответственный, но ушел с л/с
					 ИндексОтв = ТаблИсхЛС.Индекс(СтрокаТекОтветственного);
					 Если ИндексОтв <ТаблИсхЛС.Количество()-1 тогда
						НовСтрока =  ТаблИсхЛС.Вставить(ИндексОтв+1);
					 иначе
						НовСтрока =  ТаблИсхЛС.Добавить();
					 КонецЕсли;	 					 
					 ЗаполнитьЗначенияСвойств(НовСтрока,СтрокаТекОтветственного);
					 СтрокаТекОтветственного.ДатаВыписки = '0001-01-01';					 
					 НовСтрока.ДатаПрописки = СтрокаТекОтветственного.ДатаВыписки+24*3600;;
					 НовСтрока.СтатусФизЛица = ?(НовСтрока.PR_SOB=1,СобственникНеПроживает,ОтветственныйНеПроживает);
					 НовСтрока.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
					 НовСтрока.НужноДобавитьДопСтроку = истина;
					 НовСтрока.ДатаВыписки = '0001-01-01';	
					 
				КонецЕсли;	
				
				 
				Индекс=0;
				ЧислоСтрок = ТаблИсхЛС.Количество();
				Пока  Индекс <= ЧислоСтрок-1 цикл
					СтрокаИсх = ТаблИсхЛС[Индекс];	
					СледСтрока = ?(Индекс= ЧислоСтрок-1,Неопределено,ТаблИсхЛС[Индекс+1]);
 					Если ложь тогда СтрокаИсх = РегистрыСведений.лб_Тест_Жильцы.СоздатьМенеджерЗаписи(); СледСтрока = СтрокаИсх; КонецЕсли;					
					
					ЭтоКрайняяСтрока = СледСтрока=Неопределено или (СледСтрока.Жилец<>СтрокаИсх.Жилец);
					//Данные о собственноси дублируем до крайней записи
					Если НЕ ЭтоКрайняяСтрока и (СтрокаИсх.PR_SOB=1 ) и (СледСтрока.PR_SOB=0) тогда
						ЗаполнитьЗначенияСвойств(СледСтрока,СтрокаИсх,"PR_SOB,D1,D2,SOBST");						
					КонецЕсли;;					
					
					//Если есть дата выписки у собственника или у ответственного (не собственника),
					//в крайней строке, тогда делим строку на две, без даты выписки в каждой
					Если ЭтоКрайняяСтрока и ЗначениеЗаполнено(СтрокаИсх.ДатаВыписки) и 						
						 	(СтрокаИсх.PR_SOB=1)
					тогда	
						Если Индекс = ЧислоСтрок-1 тогда
							СледСтрока = ТаблИсхЛС.Добавить();
						иначе
							СледСтрока = ТаблИсхЛС.Вставить(Индекс+1);
						КонецЕсли;
						ЗаполнитьЗначенияСвойств(СледСтрока,СтрокаИсх);
						СледСтрока.ДатаПрописки = СтрокаИсх.ДатаВыписки+24*3600;
						СледСтрока.ДатаВыписки  = '0001-01-01';
						СледСтрока.СтатусФизЛица = СобственникНеПроживает; 													 
						//СтрокаИсх.ДатаВыписки = '0001-01-01';
						СледСтрока.НужноДобавитьДопСтроку = истина; 
						ЧислоСтрок = ЧислоСтрок+1;                  						
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(СтрокаИсх.СтатусФизлица) тогда
						Если ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) и не ЗначениеЗаполнено(СтрокаИсх.ДатаВыписки) тогда
							//прописан и не выписан
							СтрокаИсх.СтатусФизлица = ПроживаетПостоянно;
						ИначеЕсли ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) и (СтрокаИсх.ДатаВыписки>='2025-01-01') тогда	
							//прописан и выписан после 2025 года
							СтрокаИсх.СтатусФизлица = ПроживаетПостоянно;
							
						ИначеЕсли ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) и 
									(СтрокаИсх.ДатаВыписки<'2025-01-01') и 
									(СтрокаИсх.ДатаВыписки>'2019-01-31') тогда	
							//прописан и выписан в будущем, но до  2025 года							
							СтрокаИсх.СтатусФизлица = ПроживаетВременно;
						ИначеЕсли ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) и 									
									(СтрокаИсх.ДатаВыписки<='2019-01-31') тогда	
							//прописан и выписан в прошлом		
							СтрокаИсх.СтатусФизлица = ?(СтрокаИсх.REG_VR=1,
														ПроживаетВременно,
														ПроживаетПостоянно);		
						ИначеЕсли  СтрокаИсх.PR_SOB=1 и НЕ ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) тогда							
							//Собственник не был прописан
							СтрокаИсх.СтатусФизлица = СобственникНеПроживает;
						ИначеЕсли СтрокаИсх.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо и НЕ ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) тогда														
							//Отвественный (не собственник) не был прописан
							СтрокаИсх.СтатусФизлица	= ОтветственныйНеПроживает;						 
						КонецЕсли;	
							
					КонецЕсли;
				
					Если СтрокаИсх.СтатусФизлица = ПроживаетПостоянно тогда
						СтрокаИсх.СтатусПроживания = Перечисления.бит_СтатусПроживания.Постоянно
					ИначеЕсли СтрокаИсх.СтатусФизлица = ПроживаетВременно тогда
						СтрокаИсх.СтатусПроживания = Перечисления.бит_СтатусПроживания.Временно	
					иначе	
					    СтрокаИсх.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает
					КонецЕсли;	
					
					 //Заполняем строку в РС.бит_ПроживающиеНаЛС;					
					 НовЗапись = ТаблП.Добавить();
					 НовЗапись.ЛицевойСчет   = СтрокаИсх.ЛС;
					 НовЗапись.ФизЛицо       = СтрокаИсх.Жилец;
					 НовЗапись.Период 		 = НаборП.Отбор.Регистратор.Значение.Дата + Индекс*3600*24;
					 НовЗапись.Активность = Истина;
					 НовЗапись.ВладелецКвартиры =?(СтрокаИсх.PR_SOB = 1,
					 								Перечисления.ДаНет.Да,
													Перечисления.ДаНет.Нет);
					 НовЗапись.СтатусФизЛица		= СтрокаИсх.СтатусФизлица;					
					 НовЗапись.СтепеньРодства       = СтрокаИсх.СтепеньРодства;
					 НовЗапись.СтатусПроживания     = СтрокаИсх.СтатусПроживания;
					 НовЗапись.ДатаРегистрации      = СтрокаИсх.ДатаПрописки;
					 НовЗапись.ДатаСнятияСРегистрации = СтрокаИсх.ДатаВыписки;
					 //НовЗапись.ДатаЗаписи             =  //дата окончания действия 
					 НовЗапись.ДоляПлощади            = ?(СтрокаИсх.D2=0,0,СтрокаИсх.D1/СтрокаИсх.D2);
					 НовЗапись.лб_ДоляПлощадиСтрокой  = сокрЛП(СтрокаИсх.SOBST);
					 НовЗапись.лб_СтрокаРодствДляФЛС  = СтрокаИсх.ОписаниеРодства;	
					 
					 Если СтрокаИсх.НужноДобавитьДопСтроку =истина тогда
						 НовЗапись.лб_ИгнорироватьПериодВКопииФЛС = истина;
					 иначе	 
						 НовЗапись.лб_ИгнорироватьПериодВКопииФЛС = ложь;
						 НовЗапись.лб_ДатаРегистрацииДляФЛС = СтрокаИсх.ДатаПрописки;
						 НовЗапись.лб_ДатаВыпискиДляФЛС = СтрокаИсх.ДатаВыписки;
					 КонецЕсли;

						 
					 
					 Индекс = Индекс+1;
					 
				КонецЦикла;
				
			КонецЕсли;	                          		
			
		КонецЦикла;	 //Лицевой счет
				
		
		
		Сч = Сч+1;
	КонецЦикла;	  //Здание
	
	Если НаборП<>Неопределено тогда
		НаборП.Загрузить(ТаблП);
		НаборП.Записать(истина);
	КонецЕсли;	     
	
