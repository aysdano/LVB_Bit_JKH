	Таблица.Колонки.Добавить("ТипКвартиры");
	Таблица.Колонки.Добавить("ОбщаяПлощадь");
	Таблица.Колонки.Добавить("ЖилаяПлощадь");
	Таблица.Колонки.Добавить("лб_НеВыводитьСтрокуДомофон");
	Таблица.Колонки.Добавить("СтоимостьКубаХВ");
	Таблица.Колонки.Добавить("СтоимостьКВтч");
	Таблица.Колонки.Добавить("СтоимостьКубаВО");
	Таблица.Колонки.Добавить("СтоимостьГКалл");
	Таблица.Колонки.Добавить("СтоимостьКубаХВнаГВ");
	Таблица.Колонки.Добавить("НормативХВ");
	Таблица.Колонки.Добавить("НормативГВ");
	Таблица.Колонки.Добавить("НормативВО");
	Таблица.Колонки.Добавить("НормативЭЭ");
	Таблица.Колонки.Добавить("НормативНаПодогрев");
	Таблица.Колонки.Добавить("ТарифМинВзнос");
	
	СтрокаТаблицы = Таблица.Добавить();
	
	СтрокаТаблицы.ЛицевойСчет = ЛицевойСчет;
	СтрокаТаблицы.ТарифХВ = 0;
	СтрокаТаблицы.ТарифГВ = 0;
	СтрокаТаблицы.ТарифВО = 0;
	СтрокаТаблицы.ТарифЭЛ = 0;
	СтрокаТаблицы.РежимПотребления = Неопределено;
	СтрокаТаблицы.СпособРасчета = Неопределено;
	СтрокаТаблицы.СтатусКвартиры = Неопределено;
	СтрокаТаблицы.ТипКвартиры = Неопределено;
	СтрокаТаблицы.ОбщаяПлощадь = 0;
	СтрокаТаблицы.ЖилаяПлощадь = 0;
	СтрокаТаблицы.лб_НеВыводитьСтрокуДомофон = Неопределено;
	СтрокаТаблицы.СтоимостьКубаХВ = 0;
	СтрокаТаблицы.СтоимостьКВтч = 0;
	СтрокаТаблицы.СтоимостьКубаВО = 0;
	СтрокаТаблицы.СтоимостьГКалл = 0;
	СтрокаТаблицы.СтоимостьКубаХВнаГВ = 0;
	СтрокаТаблицы.НормативХВ = 0;
	СтрокаТаблицы.НормативГВ = 0;
	СтрокаТаблицы.НормативВО = 0;
