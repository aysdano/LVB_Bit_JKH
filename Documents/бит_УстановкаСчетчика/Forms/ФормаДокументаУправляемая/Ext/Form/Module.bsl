&НаКлиенте
Процедура ПодборРазныеЗдания(Команда)
	
	// БИТ_ЖКХ 03.10.2014
	Объект.ПодборРазныеЗдания = Истина;
	Элементы.ПодборРазныеЗдания.Видимость = Истина;
	// БИТ_ЖКХ 03.10.2014
	
	Если Объект.Проведен Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ проведен. Изменения невозможны!");
		
	ИначеЕсли Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.СнятиеСчетчика Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("При снятии счетчика изменения невозможны!");
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Организация"       , Объект.Организация);
		ПараметрыФормы.Вставить("Дата"              , Объект.Дата);
		ПараметрыФормы.Вставить("ОткрытоИзДокумента", Истина);
		
		СписокУслуг = Новый СписокЗначений;
		
		Корень = ДеревоОбъектовУчета.ПолучитьЭлементы();
		
		Для каждого СтрокаТаблицы Из Корень Цикл
			Если СписокУслуг.НайтиПоЗначению(СтрокаТаблицы.Услуга) = Неопределено Тогда
				СписокУслуг.Добавить(СтрокаТаблицы.Услуга);
			КонецЕсли; 
		КонецЦикла; 
		
		ПараметрыФормы.Вставить("СписокУслуг", СписокУслуг);
		
		СписокУлиц   = Новый СписокЗначений;
		СписокЗданий = Новый СписокЗначений;
		
		ПараметрыФормы.Вставить("СписокЗданий", СписокЗданий);
		ПараметрыФормы.Вставить("СписокУлиц"  , СписокУлиц);
		
		Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
			ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик // БИТ_ЖКХ 02.12.2015 17:39:44 
			ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьЛицевыеСчетаСоСчетчика
			ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьУслугиНаСчетчик 
			ИЛИ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УдалитьУслугиСоСчетчика Тогда
			
			ПараметрыФормы.Вставить("СписокЛС"  , мКэшЗначений.СписокЛС);
			ПараметрыФормы.Вставить("ВСписке "  , (НЕ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЛицевыеСчетаНаСчетчик
													И НЕ Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.ДобавитьЗданияНаСчетчик)); // БИТ_ЖКХ 03.12.2015 13:16:47 
			
		КонецЕсли; 
		
		ОткрытьФорму("Обработка.бит_ПодборЛицевыхСчетов.Форма", ПараметрыФормы, ЭтаФорма, УникальныйИдентификатор);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыбранныеЗначенияУслуга(ВыбранноеЗначение)
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресЛСВХранилище);
	
	Отбор = Новый Структура;
	
	Дерево = РеквизитФормыВЗначение("ДеревоОбъектовУчета");
	
	Для каждого ЭлементКоллекции Из ТаблицаЛС Цикл
		
		Отбор.Вставить("Услуга"     , ЭлементКоллекции.Услуга);
		
		// БИТ_ЖКХ 10.09.2014
		// Отбор.Вставить("Здание"     , ЭлементКоллекции.Здание);.
		// БИТ_ЖКХ 10.09.2014
		
		Корень = Дерево.Строки.НайтиСтроки(Отбор);
		
		Если НЕ Корень.Количество() = 1 Тогда
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не найдено строк по зданию: " + ЭлементКоллекции.Здание + " и услуге: " + ЭлементКоллекции.Услуга);
			
			Продолжить;
			
		КонецЕсли; 
		
		Отбор.Очистить();
		
		ПоискЛС = Корень[0].Строки.Найти(ЭлементКоллекции.ЛицевойСчет, "ЛицевойСчет");
		
		Если НЕ ПоискЛС = Неопределено Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		Отказ = Ложь;
		
		ОтветственноеЛицо    = Неопределено;
		Индивидуальный       = Ложь;
		
		ПроверитьВозможностьУстановкиСчетчикаНаЛицевойСчет(ЭлементКоллекции.Здание, 
		ЭлементКоллекции.ЛицевойСчет, 
		ЭлементКоллекции.Услуга, 
		,
		ОтветственноеЛицо, 
		Индивидуальный, 
		, 
		Отказ);
		
		Если НЕ Отказ Тогда
			
			// БИТ_ЖКХ 03.10.2014
			Если Объект.ПодборРазныеЗдания = Истина Тогда
				Корень[0].ПредставлениеЗдания  = "";
			КонецЕсли;
			// БИТ_ЖКХ 03.10.2014
			
			НоваяСтрока = Корень[0].Строки.Добавить();
			
			НоваяСтрока.ПредставлениеЗдания = ЭлементКоллекции.Адрес;
			НоваяСтрока.Услуга              = ЭлементКоллекции.Услуга;
			НоваяСтрока.ЛицевойСчет         = ЭлементКоллекции.ЛицевойСчет;
			НоваяСтрока.ОтветственноеЛицо   = ОтветственноеЛицо;
			НоваяСтрока.Индивидуальный      = Индивидуальный;
			НоваяСтрока.Здание              = ЭлементКоллекции.Здание;
			
		КонецЕсли;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(Дерево, "ДеревоОбъектовУчета");
	
КонецПроцедуры

// БИТ_ЖКХ 08.12.2014{{ 
&НаСервере
Процедура СпособыПоГрупповым()
	
	Если Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам Тогда
		
		Элементы.ИспользоватьПравилоУменьшения.Заголовок       = "Использовать способ расчета";
		Элементы.УслугиСпособРаспределения.Видимость           = Ложь;
		Элементы.УслугиСпособРаспределенияУменьшения.Видимость = Ложь;
		
		Если Объект.ИспользоватьПравилоУменьшения Тогда
			Элементы.УслугиСпособРасчетаУменьшения.Видимость       = Истина;
			Элементы.Услуги.ПодчиненныеЭлементы.УслугиСпособРасчетаУменьшения.Заголовок = "Способ расчета";
			Элементы.Услуги.ПодчиненныеЭлементы.УслугиСпособРасчетаУменьшения.Доступность = Истина;
		Иначе
			Элементы.УслугиСпособРасчетаУменьшения.Видимость       = Ложь;
		КонецЕсли;
	Иначе
		Элементы.ИспользоватьПравилоУменьшения.Заголовок       = "Использовать правило уменьшения объема коммунального ресурса";
		
	КонецЕсли;
	
КонецПроцедуры
