            //Раздел 3
			ОбластьДок["П033310"].Значение = ВыборкаГЦЖС.ЖилищныйФонд;
			ОбластьДок["П033311"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Техобслуживание Тогда
            //Раздел 3
			ОбластьДок["П033410"].Значение = ВыборкаГЦЖС.ЖилищныйФонд;
			ОбластьДок["П033411"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			ВыборкаВидБлагоустройстваЗданий = ВыборкаГЦЖС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаВидБлагоустройстваЗданий.Следующий() Цикл
				Если ВыборкаВидБлагоустройстваЗданий.ВидБлагоустройстваЗданий = Справочники.бит_ВидыБлагоустройстваЗданий.СЛифтами  Тогда
					ОбластьДок["П033510"].Значение = ВыборкаВидБлагоустройстваЗданий.ЖилищныйФонд;
					ОбластьДок["П033511"].Значение = ВыборкаВидБлагоустройстваЗданий.КоличествоПроживающих;
				ИначеЕсли ВыборкаВидБлагоустройстваЗданий.ВидБлагоустройстваЗданий = Справочники.бит_ВидыБлагоустройстваЗданий.БезЛифтов Тогда
					ОбластьДок["П033610"].Значение = ВыборкаВидБлагоустройстваЗданий.ЖилищныйФонд;
					ОбластьДок["П033611"].Значение = ВыборкаВидБлагоустройстваЗданий.КоличествоПроживающих;
				КонецЕсли;
			КонецЦикла;
			
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ВывозБытовыхОтходов Тогда	
            //Раздел 3
			ОбластьДок["П035110"].Значение = ВыборкаГЦЖС.ЖилищныйФонд;
			ОбластьДок["П035111"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт Тогда	
            //Раздел 3
			ОбластьДок["П033710"].Значение = ВыборкаГЦЖС.ЖилищныйФонд;
			ОбластьДок["П033711"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
		КонецЕсли;
	КонецЦикла; 
	
	
	// Справочно (Раз в год)
	Если КонецМесяца(Дата) = КонецГода(Дата) Тогда
		ОбластьДок["П045405"].Значение = ОбластьДок["П034210"].Значение;
		ОбластьДок["П045308"].Значение = ОбластьДок["П034311"].Значение;
		ОбластьДок["П045508"].Значение = ОбластьДок["П033911"].Значение;
		ОбластьДок["П045708"].Значение = ОбластьДок["П034611"].Значение;
	КонецЕсли;
	ДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
Конецпроцедуры  // ЗаполнитьДокумент_Ф22()

