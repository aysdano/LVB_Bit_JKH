Функция ТаблКолонок(ЛС,ЗависимыеЛС);
	
	
	
	СписокУслуг = новый массив;
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("ОбщийСписокУслуг",лб_Сервер.лб_ПолучитьСписокУслугИзШаблонаИзвещения(ЭтотОбъект.ШаблонИзвещения));
	Запрос.УстановитьПараметр("УслугиСРЖОДН",лб_Сервер.УслугиСодержаниеРемонтОДН());
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЗ.Услуга КАК Услуга
		|ИЗ
		|	(ВЫБРАТЬ
		|		бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга
		|	ИЗ
		|		РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет В (&СписокЛС,&ЛС)) КАК бит_СведенияПоУслугамЛССрезПоследних
		|	ГДЕ
		|		НЕ бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления В (&НеНачислять, &Нет)
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ
		|	ИЗ
		|		РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.ОстаткиИОбороты(&Дата1, &Дата2, , , ЛицевойСчет В (&СписокЛС,&ЛС)) КАК бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		бит_УслугиЖКХ.Ссылка
		|	ИЗ
		|		Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
		|	ГДЕ
		|		бит_УслугиЖКХ.Ссылка В(&СписокУслуг)) КАК ВЗ
		|
		|СГРУППИРОВАТЬ ПО
		|	ВЗ.Услуга";
	
	ТекМес = НачалоМесяца(ЭтотОбъект.ДатаНач);
	СписокЛС = новый массив;			
	Пока ТекМес<=ЭтотОбъект.ДатаКон цикл
		Если ТекМес =НачалоМесяца(ЭтотОбъект.ДатаКон) тогда
			СписокЛС = ЗависимыеЛС;
		КонецЕсли;	
		Запрос.УстановитьПараметр("Дата1",ТекМес);
		Запрос.УстановитьПараметр("Дата2",КонецМесяца(ТекМес));
		Запрос.УстановитьПараметр("ЛС",ЛС);
		Запрос.УстановитьПараметр("СписокЛС",СписокЛС);
		Запрос.УстановитьПараметр("СписокУслуг",СписокУслуг);
		
		СписокУслуг = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Услуга");
				
		ТекМес = ДобавитьМесяц(ТекМес,1);
	КонецЦикла;	
		
	
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("СписокУслуг",СписокУслуг);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_УслугиЖКХ.Ссылка КАК Ссылка,
		|	бит_УслугиЖКХ.Приоритет КАК Приоритет,
		|	бит_УслугиЖКХ.НаименованиеСокращенное КАК НаимКолонки,
		|	бит_УслугиЖКХ.ГруппаУслуги КАК ГруппаУслуги,
		|	ЛОЖЬ КАК ЭтоПени
		|ИЗ
		|	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
	ТаблКолонок = Запрос.Выполнить().Выгрузить();
	
    //Добавляем колонки пени
	//Для СРЖ+ОДН - общая, после последней из колонок СРЖ и ОДН, выводится всегда
	//для остальных - после соотв. услуги, если есть пени по этой услуге
	
	//реализация - пени по услуге СРЖ содержит все и выводится в эту колонку
	УслугаСРЖ = лб_Сервер.УслугаСодержаниеРемонт();
	УслугиСРЖОДН= лб_Сервер.УслугиСодержаниеРемонтОДН();
	
	КрайняяКолонкаОДН = 0;
	Для инд=0 по ТаблКолонок.Количество()-1 цикл 		
		Если УслугиСРЖОДН.Найти(ТаблКолонок[инд])<>Неопределено тогда
			КрайняяКолонкаОДН=инд+1;
		КонецЕсли;	
	КонецЦикла;	
		
	Если КрайняяКолонкаОДН = ТаблКолонок.Количество() тогда
		КолонкаПени = ТаблКолонок.Добавить();
	ИначеЕсли КрайняяКолонкаОДН>0 тогда	
		КолонкаПени = ТаблКолонок.Вставить(КрайняяКолонкаОДН)
	КонецЕсли;;
	
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("УслугиОДН",УслугиСРЖОДН);
	Запрос.УстановитьПараметр("СписокЛС",ЗависимыеЛС);
	Запрос.УстановитьПараметр("ЛС",ЛС);
	Запрос.УстановитьПараметр("Дата1",ЭтотОбъект.ДатаНач);
	Запрос.УстановитьПараметр("Дата2",КонецДня(ЭтотОбъект.ДатаКон));
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ КАК УслугаЖКХ
		|ИЗ
		|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.ОстаткиИОбороты(&Дата1, &Дата2, , , ЛицевойСчет В (&СписокЛС,&ЛС)) КАК бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты
		|ГДЕ
		|	НЕ бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ В (&УслугиОДН)";
	СписокПени = Запрос.Выполнить().Выгрузить();
	
	
		
		
	
	
	
	
	
	
	
	
	
	
	//КолонкиОтчета.Колонки.Добавить("Приоритет",Новый ОписаниеТипов("Число"));
	//КолонкиОтчета.Колонки.Добавить("ИмяКолонки", Новый ОписаниеТипов("Строка"));
	//возврат КолонкиОтчета
КонецФункции




