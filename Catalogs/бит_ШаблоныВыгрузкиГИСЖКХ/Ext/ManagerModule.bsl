	Если ЭтоКоманада Тогда
		Возврат ВерсииШаблоновГИСЖКХ; 	
	КонецЕсли;
	
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетГМКД"	,"1.3.2.97");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетЖД"		,"1.3.2.97");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетИПУ"	,"1.3.2.73");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетЛС"		,"1.3.2.37");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетМКД"	,"1.3.2.97");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетОДПУ"	,"1.3.2.37");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетПД"		,"1.3.2.106");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетПД2020"	,"1.3.2.115");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетПУ"		,"1.3.2.37");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетТФ"		,"1.3.2.18");
	//ВерсииШаблоновГИСЖКХ.Вставить("МакетОплаты"	,"1.3.2.99");
	
	ВерсииШаблоновГИСЖКХ.Вставить("МакетГМКД"	,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетЖД"		,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетИПУ"	,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетЛС"		,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетМКД"	,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетОДПУ"	,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетПД"		,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетПД2020"	,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетПУ"		,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетТФ"		,"1.3.3.32");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетОплаты"	,"1.3.3.32");
	// БИТ ЖКХ 25.02.2021
	ВерсииШаблоновГИСЖКХ.Вставить("МакетГМКДРСО" ,"1.3.3.55");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетЖДРСО"	 ,"1.3.3.55");
	ВерсииШаблоновГИСЖКХ.Вставить("МакетМКДРСО"	 ,"1.3.3.55") ;

	
	Возврат ВерсииШаблоновГИСЖКХ;
	
КонецФункции

Процедура ЗаполнитьШаблоны(ЭтоКоманада = Ложь) Экспорт
	
	// Проверяем необходимость заполнения СКД.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_СКДТаблицГИСЖКХ.ТаблицаШаблонаГИСЖКХ
	|ИЗ
	|	РегистрСведений.бит_СКДТаблицГИСЖКХ КАК бит_СКДТаблицГИСЖКХ";
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		ОбновитьШаблоныРелиз(ЭтоКоманада);
		Возврат;
		
	КонецЕсли;
	
	// Пометка на удаления старых шаблонов.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ШаблоныВыгрузкиГИСЖКХ.Ссылка
	|ИЗ
	|	Справочник.бит_ШаблоныВыгрузкиГИСЖКХ КАК бит_ШаблоныВыгрузкиГИСЖКХ
	|ГДЕ
	|	НЕ бит_ШаблоныВыгрузкиГИСЖКХ.ПометкаУдаления";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Попытка
			Об					= Выборка.Ссылка.ПолучитьОбъект();
			Об.ПометкаУдаления	= Истина;
			Об.Записать();
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	// Первое заполнение СКД.
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ТаблицыШаблоновГИСЖКХ.Ссылка,
	|	бит_ТаблицыШаблоновГИСЖКХ.ИмяПредопределенныхДанных
	|ИЗ
	|	Справочник.бит_ТаблицыШаблоновГИСЖКХ КАК бит_ТаблицыШаблоновГИСЖКХ
	|ГДЕ
	|	бит_ТаблицыШаблоновГИСЖКХ.Предопределенный";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Набор = РегистрыСведений.бит_СКДТаблицГИСЖКХ.СоздатьНаборЗаписей();
	Набор.Прочитать();
	Период = ТекущаяДата();
	
	Пока Выборка.Следующий() Цикл
		НовыйНабор							= Набор.Добавить();
		НовыйНабор.Период					= Период;
		НовыйНабор.ТаблицаШаблонаГИСЖКХ		= Выборка.Ссылка;
		СхемаКомпоновкиДанных				= бит_ОбщегоНазначенияКлиентСервер.ПодготовитьСхемуСКД(Справочники.бит_ТаблицыШаблоновГИСЖКХ.ПолучитьМакет("Макет" + Выборка.ИмяПредопределенныхДанных));
		НовыйНабор.СхемаКомпоновкиДанных	= Новый ХранилищеЗначения(СхемаКомпоновкиДанных);
	КонецЦикла; 
	
	Попытка
		Набор.Записать();
	Исключение
	КонецПопытки;
	
	СоздатьШаблоны(ЭтоКоманада);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

Процедура ОбновитьШаблоныРелиз(ЭтоКоманада)
	
	ВерсииШаблоновГИСЖКХ = ПолучитьВерсииШаблоновГИСЖКХ(ЭтоКоманада);
	ШаблоныНаОбновление = Новый Массив;
	
	// Отправка в архив старых шаблонов.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.Ссылка КАК бит_ШаблоныВыгрузкиГИСЖКХ,
	|	бит_ШаблоныВыгрузкиГИСЖКХ.ВерсияШаблона КАК ВерсияШаблона,
	|	бит_ШаблоныВыгрузкиГИСЖКХ.ИмяМакета КАК ИмяМакета
	|ИЗ
	|	Справочник.бит_ШаблоныВыгрузкиГИСЖКХ.ПоляШаблона КАК бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ШаблоныВыгрузкиГИСЖКХ КАК бит_ШаблоныВыгрузкиГИСЖКХ
	|		ПО бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.Ссылка = бит_ШаблоныВыгрузкиГИСЖКХ.Ссылка
	|ГДЕ
	|	НЕ бит_ШаблоныВыгрузкиГИСЖКХ.Архивный
	|	И НЕ бит_ШаблоныВыгрузкиГИСЖКХ.ПометкаУдаления
	|	И НЕ бит_ШаблоныВыгрузкиГИСЖКХ.ПользовательскийШаблон
	|	И (бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаЖилыхПомещений)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаЗданий)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаКомнат)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаЛС)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаЛСКапРем)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаНежилыхПомещений)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПодъездов)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПомещений)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПомещенийКапРем)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПУ_Инд)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПУ_Гр)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаДопКоммРесурсы_Инд)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаДопКоммРесурсы_Гр)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаДопЛСПУ)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПД1_2)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПД1_2КапРем)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПД1_2_2020)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПД1_2КапРем2020)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПД3_6)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПД3_6КапРем)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПД3_6_2020)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПД3_6КапРем2020)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПДДПД)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПДДПДКапРем)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПДНеустойки)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПДНеустойкиКапРем)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаИПУ)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаОДПУ)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаАбонентовМО)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПроживающихМО)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПоставщиковУслугМО)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаЖилогоФондаМО)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаИПУМО)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаОДПУМО)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаОплаты)
	|			ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаОплатыКапРем))";
	
	//25.11.2019     	
	Запрос.Текст = Запрос.Текст + " ИЛИ (бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаОплаты) ИЛИ бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы = ЗНАЧЕНИЕ(Справочник.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаОплатыКапРем))";
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		// Выборочное обновление.
		Если НЕ ЭтоКоманада
			И ЗначениеЗаполнено(Выборка.ИмяМакета) Тогда
			
			НоваяВерсия = Неопределено;
			ВерсииШаблоновГИСЖКХ.Свойство(Выборка.ИмяМакета, НоваяВерсия);
			Если НоваяВерсия <> Неопределено
				И СравнитьВерсии(НоваяВерсия, Выборка.ВерсияШаблона) <= 0 Тогда
				
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		ШаблоныНаОбновление.Добавить(Выборка.ИмяМакета);
		
		Попытка
			Об				= Выборка.бит_ШаблоныВыгрузкиГИСЖКХ.ПолучитьОбъект();
			Об.Архивный		= Истина;
			Об.Комментарий	= "Схема сбора данных устарела.";
			Об.Записать();
		Исключение
			Продолжить;
		КонецПопытки;
	КонецЦикла;
	
	// Перезаполнение макетов СКД.
	ВерсииТаблицШаблоновГИСЖКХ = Справочники.бит_ТаблицыШаблоновГИСЖКХ.ПолучитьВерсииТаблицШаблоновГИСЖКХ(ЭтоКоманада);
	НоваяВерсияШаблона = бит_ОбщегоНазначенияПовтИсп.ПолучитьНомерРелиза_бит();

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ТаблицыШаблоновГИСЖКХ.Ссылка КАК Ссылка,
	|	бит_ТаблицыШаблоновГИСЖКХ.ИмяПредопределенныхДанных КАК ИмяПредопределенныхДанных,
	|	бит_ТаблицыШаблоновГИСЖКХ.ВерсияТаблицы КАК ВерсияТаблицы
	|ИЗ
	|	Справочник.бит_ТаблицыШаблоновГИСЖКХ КАК бит_ТаблицыШаблоновГИСЖКХ
	|ГДЕ
	|	бит_ТаблицыШаблоновГИСЖКХ.Предопределенный";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		// Выборочное обновление.
		Если НЕ ЭтоКоманада
			И ЗначениеЗаполнено(Выборка.Ссылка) Тогда
			
			НоваяВерсия = ВерсииТаблицШаблоновГИСЖКХ[Выборка.Ссылка];
			Если НоваяВерсия <> Неопределено
				И СравнитьВерсии(НоваяВерсия, Выборка.ВерсияТаблицы) <= 0 Тогда
				
				Продолжить;
			КонецЕсли;
			
		КонецЕсли;
		
		// Поставить отметку версии.
		Об				= Выборка.Ссылка.ПолучитьОбъект();
		Об.ВерсияТаблицы= НоваяВерсияШаблона;
		Об.Записать();
		
		НаборСКДТаблицГИСЖКХ = РегистрыСведений.бит_СКДТаблицГИСЖКХ.СоздатьНаборЗаписей();  
		НаборСКДТаблицГИСЖКХ.Отбор.Период.Установить(ТекущаяДата());
		НаборСКДТаблицГИСЖКХ.Отбор.ТаблицаШаблонаГИСЖКХ.Установить(Выборка.Ссылка);
		НаборСКДТаблицГИСЖКХ.Прочитать();
		
		Макет = Справочники.бит_ТаблицыШаблоновГИСЖКХ.ПолучитьМакет("Макет" + Выборка.ИмяПредопределенныхДанных);
		
		Если НаборСКДТаблицГИСЖКХ.Количество() = 0 Тогда
			НовыйНаборСКДТаблицГИСЖКХ						= НаборСКДТаблицГИСЖКХ.Добавить();
			НовыйНаборСКДТаблицГИСЖКХ.Период				= ТекущаяДата();
			НовыйНаборСКДТаблицГИСЖКХ.ТаблицаШаблонаГИСЖКХ	= Выборка.Ссылка;
			СхемаКомпоновкиДанных							= бит_ОбщегоНазначенияКлиентСервер.ПодготовитьСхемуСКД(Макет);
			НовыйНаборСКДТаблицГИСЖКХ.СхемаКомпоновкиДанных = Новый ХранилищеЗначения(СхемаКомпоновкиДанных);
		Иначе 
			НовыйНаборСКДТаблицГИСЖКХ						= НаборСКДТаблицГИСЖКХ[0];
			СхемаКомпоновкиДанных							= бит_ОбщегоНазначенияКлиентСервер.ПодготовитьСхемуСКД(Макет);
			НовыйНаборСКДТаблицГИСЖКХ.СхемаКомпоновкиДанных	= Новый ХранилищеЗначения(СхемаКомпоновкиДанных);
		КонецЕсли;
		
		Попытка
			НаборСКДТаблицГИСЖКХ.Записать();
		Исключение
		КонецПопытки;
	КонецЦикла;
	
	СоздатьШаблоны(ЭтоКоманада, ШаблоныНаОбновление);
	
КонецПроцедуры

Процедура СоздатьШаблоны(ЭтоКоманада, ШаблоныНаОбновление = Неопределено)
	
	НоваяВерсияШаблона = бит_ОбщегоНазначенияПовтИсп.ПолучитьНомерРелиза_бит();
	
	ОбновитьШаблонЖД(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонМКД(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонГМКД(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонЛС(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонПУ(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонПД(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонИПУ(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонОДПУ(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонТФ(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонОплаты(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонПД2020(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	// БИТ ЖКХ 25.02.2021
	ОбновитьШаблонЖДРСО(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонМКДРСО(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);
	ОбновитьШаблонГМКДРСО(ЭтоКоманада, ШаблоныНаОбновление, НоваяВерсияШаблона);

КонецПроцедуры

// БИТ ЖКХ 25.02.2021
