	Разделитель              = Макет.ПолучитьОбласть("Разделитель");
	
	СтруктураСтрокаИнф = Новый Структура;
	
	Для Значение = 1 По 13 Цикл
		
		ИмяОбласти = "ИнфСтр" + Значение;
		СтруктураСтрокаИнф.Вставить(ИмяОбласти, Макет.ПолучитьОбласть(ИмяОбласти));
		
	КонецЦикла; 
	
	ТаблицаСЧ          = Новый ТабличныйДокумент;
	ТаблицаНаПечать    = Новый ТабличныйДокумент;
	
	// Заполнение параметров и вывод на печать.
	
	// Представление получателя.
	Если мСтруктураДанных.ПолучательВариантНаименования = Перечисления.ВариантыНаименованияДляПечатныхФорм.СокращенноеНаименование Тогда
		мСтруктураДанных.ПолучательПредставление =  мСтруктураДанных.ПолучательСокращенноеНаименование;
	КонецЕсли; 
	
	// Разбить адрес.
	ЛицевойСчетАдрес_1 = "";
	ЛицевойСчетАдрес_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ЛицевойСчетАдрес, 30, ЛицевойСчетАдрес_1 , ЛицевойСчетАдрес_2 );
	
	мСтруктураДанных.Вставить("ЛицевойСчетАдрес_1", ЛицевойСчетАдрес_1);
	мСтруктураДанных.Вставить("ЛицевойСчетАдрес_2", ЛицевойСчетАдрес_2);
	
	// Разбить описание льготы.
	ОписаниеЛьгот_1 = "";
	ОписаниеЛьгот_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ОписаниеЛьгот, 30, ОписаниеЛьгот_1 , ОписаниеЛьгот_2 );
	
	мСтруктураДанных.Вставить("ОписаниеЛьгот_1", ОписаниеЛьгот_1);
	мСтруктураДанных.Вставить("ОписаниеЛьгот_2", ОписаниеЛьгот_2);
	
	тмпТаблица = мТаблицаПечати.Скопировать();
	
	Для Каждого СтрокаТаблицы  Из тмпТаблица  Цикл 
		
		КОплате = СтрокаТаблицы.Начислено + СтрокаТаблицы.Разовые  
		- ?(мЛьготаПерсонифицированная, 0, СтрокаТаблицы.Льгота);
		
		СтрокаТаблицы.КОплате = КОплате;
		
		Если СтрокаТаблицы.НормативПоКу = 0 Тогда
			СтрокаТаблицы.Объем = СтрокаТаблицы.Количество;
		КонецЕсли;
		
		Если СтрокаТаблицы.Тариф = 0 Тогда
			СтрокаТаблицы.Тариф = СтрокаТаблицы.Ставка;
		КонецЕсли;
		
	КонецЦикла;
	
	мСтруктураДанных.НачисленоВТекущемПериодеДляБанка = тмпТаблица.Итог("Коплате");
	мСтруктураДанных.Коплате                          = тмпТаблица.Итог("Коплате");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты = мСтруктураДанных.СальдоНаНачалоМесяца + мСтруктураДанных.НачисленоВТекущемПериодеДляБанка - мСтруктураДанных.ОплаченоВТекущемПериоде;
	
	Шапка.Параметры.Заполнить(мСтруктураДанных);
	
	ТаблицаНаПечать.Вывести(Шапка);
	
	Если мЗагруженШтрихкод тогда
		
		СтрокаСумма = бит_ОбщегоНазначения.СформируемШтрихКод(мСтруктураДанных.ИтогоКОплатеСУчетомПени, мСтруктураДанных.ЛицевойСчетНомер, Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам.Идентификатор, Идентификатор, мНомерПолучателяПоБанку, мИспользоватьНомерПолучателяВШК);
		
		ОбластьШК.Рисунки.ШтрихКод.Объект.Сообщение = СтрокаСумма;
		
	КонецЕсли;
	
	ТаблицаНаПечать.Вывести(ОбластьШК);
	
	ТаблицаСЧ.Вывести(ТаблицаСЧШапка);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСчетчиков", мТаблицаПечатиСчетчиков);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСчетчиков.Счетчик,
	|	ТаблицаСчетчиков.Услуга,
	|	ТаблицаСчетчиков.ОтПоказаний,
	|	ТаблицаСчетчиков.ДоПоказаний,
	|	ТаблицаСчетчиков.Многотарифный,
	|	ТаблицаСчетчиков.Приоритет
	|ПОМЕСТИТЬ Счетчики
	|ИЗ
	|	&ТаблицаСчетчиков КАК ТаблицаСчетчиков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Счетчики.Счетчик,
	|	МАКСИМУМ(Счетчики.ОтПоказаний) КАК ОтПоказаний,
	|	МАКСИМУМ(Счетчики.ДоПоказаний) КАК ДоПоказаний,
	|	Счетчики.Многотарифный,
	|	СУММА(0) КАК Приоритет,
	|	СУММА(0) КАК Услуга
	|ИЗ
	|	Счетчики КАК Счетчики
	|ГДЕ
	|	НЕ Счетчики.Многотарифный
	|
	|СГРУППИРОВАТЬ ПО
	|	Счетчики.Счетчик,
	|	Счетчики.Многотарифный
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Счетчики.Счетчик,
	|	Счетчики.ОтПоказаний,
	|	Счетчики.ДоПоказаний,
	|	Счетчики.Многотарифный,
	|	Счетчики.Приоритет,
	|	Счетчики.Услуга
	|ИЗ
	|	Счетчики КАК Счетчики
	|ГДЕ
	|	Счетчики.Многотарифный
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СчетчикСЧ = 1;
	Пока Выборка.Следующий() Цикл
		
		Если СчетчикСЧ > 8 Тогда
			Прервать;
		КонецЕсли;
		
		ТаблицаСЧСтрока.Параметры.Заполнить(Выборка);
		Если Выборка.Многотарифный Тогда
			
			ТаблицаСЧСтрока.Параметры.Счетчик = "" + Выборка.Услуга;
			
		КонецЕсли; 
		
		ТаблицаСЧ.Вывести(ТаблицаСЧСтрока);
		
		СчетчикСЧ = СчетчикСЧ + 1;
		
	КонецЦикла;
	
	ДобавитьПустыхСтрокСч = 9 - СчетчикСЧ;
	
	Если ДобавитьПустыхСтрокСч > 0 Тогда
		
		Для Значение = 1 По ДобавитьПустыхСтрокСч Цикл
			ТаблицаСЧ.Вывести(ТаблицаСЧПустаяСтрока);
		КонецЦикла;
		
	КонецЕсли;
	
	ТаблицаНаПечать.Присоединить(ТаблицаСЧ);
	Середина.Параметры.Заполнить(мСтруктураДанных);
	ТаблицаНаПечать.Вывести(Середина);
	
	ТаблицаНаПечать.Вывести(ТаблицаУслугШапка);
	ИнфШапка.Параметры.Заполнить(мСтруктураДанных);
	ТаблицаНаПечать.Присоединить(ИнфШапка);
	
	ТабПоле.Вывести(ЛеваяЧасть);
	ТабПоле.Присоединить(ТаблицаНаПечать);
	
	КоличествоСтрокУс =  мТаблицаПечати.Количество();
	
	ОдинокийЛьготник = (мСтруктураДанных.КолЛьготников = 1 И мСтруктураДанных.КоличествоПроживающих = 1);
	
	СчетчикСтрокУс = 1;
	Для каждого СтрокаТаблицы Из тмпТаблица Цикл
		
		Если СтрокаТаблицы.СальдоНаНачало = 0 И СтрокаТаблицы.Начислено = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		ТаблицаУслугСтрока.Параметры.Заполнить(СтрокаТаблицы);
		
		ТаблицаУслугСтрока.Параметры.Объем = "" + СтрокаТаблицы.Объем + "" + СтрокаТаблицы.ЕдИзм;
		
		ТабПоле.Вывести(ТаблицаУслугСтрока);
		
		Если СчетчикСтрокУс < 13 Тогда
			
			СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
			ТабПоле.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
			
		Иначе
			
			ТабПоле.Присоединить(ИнфОПлатежеПустаяСтрока);
			
		КонецЕсли;
		
		СчетчикСтрокУс = СчетчикСтрокУс + 1;
		
	КонецЦикла; 
	
	Если КоличествоСтрокУс < 13 Тогда
		
		ТабПоле.Вывести(ЛеваяЧастьПустаяСтрока);
		
		ТаблицаУслугИтого.Параметры.Заполнить(мСтруктураДанных);
		ТабПоле.Присоединить(ТаблицаУслугИтого);
		
		СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
		ТабПоле.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
		
		СчетчикСтрокУс = СчетчикСтрокУс + 1;
		
		Для Значение = СчетчикСтрокУс По 13  Цикл
			
			ТабПоле.Вывести(ЛеваяЧастьПустаяСтрока);
			ТабПоле.Присоединить(ТаблицаУслугПустаяСтрока);
			
			СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
			ТабПоле.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
			
			СчетчикСтрокУс = СчетчикСтрокУс + 1;
			
		КонецЦикла;
		
		ЛеваяЧастьПодвал.Параметры.Заполнить(мСтруктураДанных);
		ТабПоле.Вывести(ЛеваяЧастьПодвал);
		ТабПоле.Присоединить(ТаблицаУслугПодвал);
		ТабПоле.Присоединить(ИнфОПлатежеПодвал);
		
	Иначе
		
		ЛеваяЧастьПодвал.Параметры.Заполнить(мСтруктураДанных);
		ТабПоле.Вывести(ЛеваяЧастьПодвал);
		
		ТаблицаУслугИтого.Параметры.Заполнить(мСтруктураДанных);
		ТабПоле.Присоединить(ТаблицаУслугИтого);
		
		ТабПоле.Присоединить(ИнфОПлатежеПодвал);
		
	КонецЕсли;
	
	ТабПоле.Вывести(Разделитель);
	
	Возврат ТабПоле;
	
КонецФункции // ()

Функция ПечатьСчетИзвещения6(ИмяМакета)  
	
	ТабДок = Новый ТабличныйДокумент();
	ТабДок.КлючПараметровПечати = "Счет-Извещение";
	
	Макет = ПолучитьМакет("СчетИзвещение5");
	
	Попытка
		КомпонентШК = Новый COMОбъект("V8.Barcod.1");
		мЗагруженШтрихкод = Истина;
	Исключение
		мЗагруженШтрихкод = Ложь;
	КонецПопытки;
	
	ОбластьШапка1       = Макет.ПолучитьОбласть("Шапка1");
	ОбластьШапка2       = Макет.ПолучитьОбласть("Шапка2");
	ОбластьПодвал       = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал1      = Макет.ПолучитьОбласть("Подвал1");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = Макет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = Макет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = Макет.ПолучитьОбласть("Итого"); 
	
	ШапкаПриборыУчета    = Макет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаПриборовУчета  = Макет.ПолучитьОбласть("СтрокаПриборовУчета");
	
	СтрокаВывода            = Макет.ПолучитьОбласть("СтрокаВывода");
	ОбластьШтрихКод         = Макет.ПолучитьОбласть("ОбластьШтрихКод");
	ОбластьКассовыйСбор     = Макет.ПолучитьОбласть("КассовыйСбор");
	ОбластьСтрокаОбращение	= Макет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = Макет.ПолучитьОбласть("Линия");
	
	ОбластьШапка1.Параметры.Заполнить(мСтруктураДанных);
	ОбластьШапка2.Параметры.Заполнить(мСтруктураДанных);
	
	ТабДок.Вывести(ОбластьШапка1);
	
	Если мЗагруженШтрихкод тогда
		
		СтрокаСумма = бит_ОбщегоНазначения.СформируемШтрихКод(мСтруктураДанных.ИтогоКОплатеСУчетомПени, мСтруктураДанных.ЛицевойСчетНомер, Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам.Идентификатор, Идентификатор, мНомерПолучателяПоБанку, мИспользоватьНомерПолучателяВШК);
		
		ОбластьШтрихКод.Рисунки.ШтрихКод.Объект.Сообщение = СтрокаСумма;
		ТабДок.Вывести(ОбластьШтрихКод);
		
	КонецЕсли;
	
	ТабДок.Вывести(ОбластьШапка2);
	
	СчВывода = 5;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаСчетчиков", мТаблицаПечатиСчетчиков);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаСчетчиков.Счетчик,
	|	ТаблицаСчетчиков.Услуга,
	|	ТаблицаСчетчиков.ОтПоказаний,
	|	ТаблицаСчетчиков.ДоПоказаний,
	|	ТаблицаСчетчиков.Многотарифный,
	|	ТаблицаСчетчиков.Приоритет,
	|	ТаблицаСчетчиков.КоличествоЕдиницПоЛС КАК Количество
	|ПОМЕСТИТЬ Счетчики
	|ИЗ
	|	&ТаблицаСчетчиков КАК ТаблицаСчетчиков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Счетчики.Счетчик,
	|	МАКСИМУМ(Счетчики.ОтПоказаний) КАК ОтПоказаний,
	|	МАКСИМУМ(Счетчики.ДоПоказаний) КАК ДоПоказаний,
	|	Счетчики.Многотарифный,
	|	МАКСИМУМ(0) КАК Приоритет,
	|	МАКСИМУМ("""") КАК Услуга,
	|	МАКСИМУМ(Счетчики.Количество) КАК Количество
	|ИЗ
	|	Счетчики КАК Счетчики
	|ГДЕ
	|	НЕ Счетчики.Многотарифный
	|
	|СГРУППИРОВАТЬ ПО
	|	Счетчики.Счетчик,
	|	Счетчики.Многотарифный
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Счетчики.Счетчик,
	|	Счетчики.ОтПоказаний,
	|	Счетчики.ДоПоказаний,
	|	Счетчики.Многотарифный,
	|	Счетчики.Приоритет,
	|	Счетчики.Услуга,
	|	Счетчики.Количество
	|ИЗ
	|	Счетчики КАК Счетчики
	|ГДЕ
	|	Счетчики.Многотарифный
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока СчВывода <> 0 цикл
		ТабДок.Вывести(СтрокаВывода);
		СчВывода = СчВывода - 1;
	КонецЦикла;
	
	Выборка.Сбросить();
	
	ТабДок.Вывести(ОбластьПодвал);
	
	мСтруктураДанных.СальдоНаНачалоМесяца = мСтруктураДанных.СальдоНаНачалоМесяца * ?(мСтруктураДанных.СальдоНаНачалоМесяца > 0,1, -1);
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	ТабДок.Вывести(ОбластьШапка);
	
	ТабДок.Вывести(ШапкаПриборыУчета);
	
	Пока Выборка.Следующий() Цикл
		
		СтрокаПриборовУчета.Параметры.Заполнить(Выборка);
		ТабДок.Вывести(СтрокаПриборовУчета);
		
	КонецЦикла;
	
	ТабДок.Вывести(ОбластьПодвал1);
	ТабДок.Вывести(ШапкаЗаголовки);
	
	Для Каждого ТекСтрока  Из мТаблицаПечати  Цикл 
		
		Если ТекСтрока.СальдоНаНачало = 0 И ТекСтрока.Начислено = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		СтрокаРасшифровки.Параметры.Заполнить(ТекСтрока);
		
		Если ТекСтрока.НормативПоКу = 0 Тогда
			СтрокаРасшифровки.Параметры.Объем = ТекСтрока.Количество;
			СтрокаРасшифровки.Параметры.Тариф = ТекСтрока.Ставка;
		КонецЕсли;
		
		ТабДок.Вывести(СтрокаРасшифровки);
		
	КонецЦикла;
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	
	ОбластьИтого.Параметры.КОплате   = мТаблицаПечати.Итог("КОплате");
	
	ТабДок.Вывести(ОбластьИтого);
	
	Возврат ТабДок;
	
КонецФункции //
