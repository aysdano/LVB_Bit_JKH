			Запрос.Текст = 
			"ВЫБРАТЬ
			|	ТаблицаУслуг.Контрагент,
			|	ТаблицаУслуг.ДоговорКонтрагента,
			|	ТаблицаУслуг.Номенклатура,
			|	ТаблицаУслуг.СтавкаНДС,
			|	ТаблицаУслуг.НоменклатурнаяГруппа,
			|	ТаблицаУслуг.СчетУчетаНДСПоРеализации,
			|	ТаблицаУслуг.СчетДоходов,
			|	ТаблицаУслуг.СчетРасходов,
			|	ТаблицаУслуг.Цена,
			|	ТаблицаУслуг.Сумма,
			|	ТаблицаУслуг.СуммаНДС,
