	<dataSet xsi:type="DataSetQuery">
		<name>ОборотыПоПени</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЛицевойСчет</dataPath>
			<field>ЛицевойСчет</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Период</dataPath>
			<field>Период</field>
			<presentationExpression>ВЫБОР
    КОГДА Не Формат(Период, "ДФ=dd.MM.yyyy") = ""
        ТОГДА
            ВЫБОР
                КОГДА &amp;Периодичность = 6
                    ТОГДА Формат(Период, "ДФ=dd.MM.yyyy")
                КОГДА &amp;Периодичность = 7
                    ТОГДА Формат(Период, "ДФ=dd.MM.yyyy") + " (неделя)"
                КОГДА &amp;Периодичность = 8
                    ТОГДА Формат(Период, "ДФ=dd.MM.yyyy") + " (декада)"
                КОГДА &amp;Периодичность = 9
                    ТОГДА Формат(Период, "ДФ='MMMM yyyy'")
                КОГДА &amp;Периодичность = 10
                    ТОГДА Формат(Период, "ДФ=q") + "-й квартал " + Формат(Период, "ДФ=yyyy") + " г."
                КОГДА &amp;Периодичность = 11
                    ТОГДА 
                        ВЫБОР 
                            КОГДА Формат(Период, "ДФ=q") = "3" ИЛИ Формат(Период, "ДФ=q") = "4"
                                ТОГДА "2-ое полугодие " + Формат(Период, "ДФ=yyyy") + " г."
                            ИНАЧЕ "1-ое полугодие " + Формат(Период, "ДФ=yyyy") + " г."
                        КОНЕЦ
                КОГДА &amp;Периодичность = 12
                    ТОГДА Формат(Период, "ДФ=yyyy") + " г."
                ИНАЧЕ Формат(Период, "ДФ=dd.MM.yyyy")
            КОНЕЦ
    ИНАЧЕ ""
КОНЕЦ</presentationExpression>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Услуга</dataPath>
			<field>Услуга</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Приоритет</dataPath>
			<field>Приоритет</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Начислено</dataPath>
			<field>Начислено</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Оплата</dataPath>
			<field>Оплата</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет.Организация КАК Организация,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, ГОД)
		ИНАЧЕ бит_НачислениеПениПоУслугамЖКХОбороты.Период
	КОНЕЦ КАК Период,
	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ.Приоритет КАК Приоритет,
	СУММА(ВЫБОР
			КОГДА бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
				ТОГДА бит_НачислениеПениПоУслугамЖКХОбороты.СуммаПениОборот
			ИНАЧЕ 0
		КОНЕЦ * -1) КАК Оплата,
	СУММА(ВЫБОР
			КОГДА НЕ бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
				ТОГДА бит_НачислениеПениПоУслугамЖКХОбороты.СуммаПениОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Начислено
{ВЫБРАТЬ
	ЛицевойСчет.*,
	Услуга.*,
	Организация.*,
	Период,
	Приоритет,
	Начислено,
	Оплата}
ИЗ
	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Обороты(&amp;НачалоПериода, &amp;КонецПериода, Регистратор, ) КАК бит_НачислениеПениПоУслугамЖКХОбороты
{ГДЕ
	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет.*,
	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ.* КАК Услуга,
	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет.Организация.* КАК Организация,
	(ВЫБОР
			КОГДА бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
				ТОГДА бит_НачислениеПениПоУслугамЖКХОбороты.СуммаПениОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Оплата,
	(ВЫБОР
			КОГДА НЕ бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
				ТОГДА бит_НачислениеПениПоУслугамЖКХОбороты.СуммаПениОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Начислено}

СГРУППИРОВАТЬ ПО
	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет,
	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ,
	ВЫБОР
		КОГДА &amp;Периодичность = 6
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, ДЕНЬ)
		КОГДА &amp;Периодичность = 7
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, НЕДЕЛЯ)
		КОГДА &amp;Периодичность = 8
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, ДЕКАДА)
		КОГДА &amp;Периодичность = 9
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, МЕСЯЦ)
		КОГДА &amp;Периодичность = 10
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, КВАРТАЛ)
		КОГДА &amp;Периодичность = 11
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, ПОЛУГОДИЕ)
		КОГДА &amp;Периодичность = 12
			ТОГДА КОНЕЦПЕРИОДА(бит_НачислениеПениПоУслугамЖКХОбороты.Период, ГОД)
		ИНАЧЕ бит_НачислениеПениПоУслугамЖКХОбороты.Период
	КОНЕЦ,
	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ.Приоритет,
	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет.Организация</query>
		<autoFillFields>false</autoFillFields>
