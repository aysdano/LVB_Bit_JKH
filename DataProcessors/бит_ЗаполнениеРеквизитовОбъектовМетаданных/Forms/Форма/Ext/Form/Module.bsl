
#Область ПеременныеМодуля

&НаКлиенте
Перем мСтруктураИсключений; // Структура исключений для реквизитов соответствующих справочников, не предназначенных для непосредственного редактирования.

&НаКлиенте
Перем мИмяРеквизита; // Имя реквизита для гурупповой записи.

&НаКлиенте
Перем мКэшНомерСтраницы; // Кэширует номер страници.

&НаСервере
Перем мСтруктураРеквизитов; // Структуру реквизитов справочников для загрузки.

&НаСервере
Перем Колонки; // Структура колонок загружаемых реквизитов, с описанием их свойств.

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	РежимЗаполнения = 0;
	НомерСтраницы = 1;
	ПерваяСтрокаДанных = 2;
	
	// Добавляем условное оформление для модифицированных элементов справочника.
	ЭлементУО			= УсловноеОформление.Элементы.Добавить();
	ПолеЭлемента 		= ЭлементУО.Поля.Элементы.Добавить();
	ПолеЭлемента.Поле 	= Новый ПолеКомпоновкиДанных("РеквизитыОбъектаМетаданных");
	
	ДобавитьЭлементКомпоновки(ЭлементУО.Отбор, "РеквизитыОбъектаМетаданных.ЭлтИзменен", ВидСравненияКомпоновкиДанных.Равно, Истина);
	ЭлементУО.Оформление.УстановитьЗначениеПараметра("ЦветФона", ЦветаСтиля.ДобавленныйРеквизитФон);
	
	Элементы.ГруппаСтраницаОтбораЛС.Видимость		   = Ложь;
	Элементы.ГруппаСтраницаОтбораТипВид.Видимость	   = Ложь;
	Элементы.ГруппаСтраницаТабличныйДокумент.Видимость = Ложь;
	Элементы.ГруппаСтраницаНастройка.Видимость		   = Ложь;
	Элементы.ФайлЧтения.Видимость					   = Ложь;
	Элементы.Загрузить.Видимость					   = Ложь;
		
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииЭлементаСправочника(Элт)
	
	ТекДанные = Элементы.РеквизитыОбъектаМетаданных.ТекущиеДанные;
	ТекДанные.ЭлтИзменен = Истина;
	Модифицированность = Истина;
	Элементы.ФормаЗаписать.Доступность = Истина;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьНастройки(ИмяСправочника)
	
	ТЗНастроек = РеквизитФормыВЗначение("ТаблицаЗагружаемыхРеквизитов");
	ЗаполнитьНастройкиСервер(ИмяСправочника, ТЗНастроек, мСтруктураРеквизитов);
	ЗначениеВРеквизитФормы(ТЗНастроек, "ТаблицаЗагружаемыхРеквизитов");
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьНастройкиСервер(ИмяСправочника, ТЗНастроек, мСтруктураРеквизитов)
	
	Если ИмяСправочника = "бит_ЛицевыеСчетаКР" Тогда
		МетаданныеИсточника = Справочники.бит_ЛицевыеСчета.ПолучитьСсылку().Метаданные();
	Иначе
		МетаданныеИсточника = Справочники[ИмяСправочника].ПолучитьСсылку().Метаданные();
	КонецЕсли;
	
	Если МетаданныеИсточника = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ИмяСправочника = "бит_Квартиры" Тогда
		
		ЗагружаемыйРеквизит = ТЗНастроек.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "Наименование";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "ЛС";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Истина;
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(12));
		
		ЗагружаемыйРеквизит = ТЗНастроек.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "ЕЛСГИСЖКХ";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "ЕЛС ГИС ЖКХ";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Истина;
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(10));
		
	ИначеЕсли  ИмяСправочника = "бит_Счетчики" Тогда
		ЗагружаемыйРеквизит = ТЗНастроек.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "ЗаводскойСерийныйНомерПУ";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Заводской (серийный) номер ПУ";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Истина;
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(50));
		
		Если МетаданныеИсточника.ДлинаНаименования > 0 Тогда
			
			ЗагружаемыйРеквизит = ТЗНастроек.Добавить();
			ЗагружаемыйРеквизит.ИмяРеквизита           = "Наименование";
			ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Наименование";
			ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Истина;
			ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(МетаданныеИсточника.ДлинаНаименования));
			
		КонецЕсли;

		
	ИначеЕсли  ИмяСправочника = "бит_ПлатежныеДокументыГИСЖКХ" Тогда
		ЗагружаемыйРеквизит = ТЗНастроек.Добавить();
		ЗагружаемыйРеквизит.ИмяРеквизита           = "НомерПД";
		ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Номер ПД";
		ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Истина;
		ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(30));
		
	Иначе
		
		Если МетаданныеИсточника.ДлинаКода > 0 Тогда
			
			ЗагружаемыйРеквизит = ТЗНастроек.Добавить();
			ЗагружаемыйРеквизит.ИмяРеквизита           = "Код";
			ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Код";
			ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Истина;
			
			Если МетаданныеИсточника.ТипКода = Метаданные.СвойстваОбъектов.ТипКодаСправочника.Строка Тогда
				ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(МетаданныеИсточника.ДлинаКода));
			Иначе
				ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Число", , , Новый КвалификаторыЧисла(МетаданныеИсточника.ДлинаКода));
			КонецЕсли;
			
		КонецЕсли;
		
		Если МетаданныеИсточника.ДлинаНаименования > 0 Тогда
			
			ЗагружаемыйРеквизит = ТЗНастроек.Добавить();
			ЗагружаемыйРеквизит.ИмяРеквизита           = "Наименование";
			ЗагружаемыйРеквизит.ПредставлениеРеквизита = "Наименование";
			ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = Истина;
			ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = Новый ОписаниеТипов("Строка", , Новый КвалификаторыСтроки(МетаданныеИсточника.ДлинаНаименования));
			
		КонецЕсли;

	КонецЕсли;
	
	Исключения = Новый Структура;
	Для Каждого Реквизит Из МетаданныеИсточника.Реквизиты Цикл
		Если НЕ Реквизит.Использование = Метаданные.СвойстваОбъектов.ИспользованиеРеквизита.ДляГруппы 
			И (мСтруктураРеквизитов.Свойство(ИмяСправочника, Исключения) И Исключения.Свойство(Реквизит.Имя)) Тогда
			
			ЗагружаемыйРеквизит                        = ТЗНастроек.Добавить();
			ЗагружаемыйРеквизит.ИмяРеквизита           = Реквизит.Имя;
			ЗагружаемыйРеквизит.ПредставлениеРеквизита = Реквизит.Представление();
			ЗагружаемыйРеквизит.МожетБытьПолемПоиска   = НЕ Реквизит.Индексирование = Метаданные.СвойстваОбъектов.Индексирование.НеИндексировать;
			ЗагружаемыйРеквизит.ДоступноеОписаниеТипов = МетаданныеИсточника.Реквизиты[ЗагружаемыйРеквизит.ИмяРеквизита].Тип;
			
		КонецЕсли;
	КонецЦикла;
	
	Для каждого ЗагружаемыйРеквизит Из ТЗНастроек Цикл
		ЗагружаемыйРеквизит.ОписаниеТипов = ЗагружаемыйРеквизит.ДоступноеОписаниеТипов;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СправочникОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение)
		И ВыбранноеЗначение <> Справочник Тогда
		
		ЗаполинтьТаблицуДоступныхРеквизитов(ВыбранноеЗначение);
		
	КонецЕсли;
	Элементы.ГруппаСтраницы.ТекущаяСтраница			= Элементы.ГруппаСтраницаРеквизитов;
	Элементы.ГруппаСтраницаОтбораЛС.Видимость		= ?(ВыбранноеЗначение = "бит_ЛицевыеСчета" ИЛИ ВыбранноеЗначение = "бит_ЛицевыеСчетаКР" ИЛИ ВыбранноеЗначение = "бит_Проживающие" ИЛИ ВыбранноеЗначение = "бит_ПлатежныеДокументыГИСЖКХ", Истина, Ложь);
	Элементы.ГруппаСтраницаОтбораТипВид.Видимость	= ?(ВыбранноеЗначение = "бит_Счетчики", 	  Истина, Ложь);
	Элементы.ГруппаСтраницаОтбораЗданий.Видимость	= ?(ВыбранноеЗначение = "бит_Счетчики", 	  Ложь,   Истина);
	Элементы.ГруппаСтраницаОтбораУлиц.Видимость		= ?(ВыбранноеЗначение = "бит_Счетчики",	  Ложь,	  Истина);
	
	Если РежимЗаполнения = 1
		И ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
			ТаблицаЗагружаемыхРеквизитов.Очистить();
			ЗаполнитьНастройки(ВыбранноеЗначение);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура РежимЗаполненияПриИзменении(Элемент)
	
	Если РежимЗаполнения = 0 Тогда
		Элементы.ФормаРедактироватьСправочник.Видимость	   = Истина;
		Элементы.ФормаЗаписать.Видимость				   = Истина;
		Элементы.Загрузить.Видимость					   = Ложь;
		Элементы.ФормаЗаписать.КнопкаПоУмолчанию		   = Истина;
		Элементы.Загрузить.КнопкаПоУмолчанию			   = Ложь;
		Элементы.ГруппаСтраницаРеквизитов.Видимость		   = Истина;
		Элементы.ГруппаСтраницаСправочников.Видимость	   = Истина;
		Элементы.ГруппаСтраницаОтборов.Видимость		   = Истина;
		Элементы.ГруппаСтраницаТабличныйДокумент.Видимость = Ложь;
		Элементы.ГруппаСтраницаНастройка.Видимость		   = Ложь;
		Элементы.УстановленныеОтборы.Видимость			   = Истина;
		Элементы.ФайлЧтения.Видимость					   = Ложь;
		Элементы.ГруппаСтраницы.ТекущаяСтраница			   = Элементы.ГруппаСтраницаРеквизитов;
		
		Элементы.Справочник.СписокВыбора.Очистить();
		Элементы.Справочник.СписокВыбора.Добавить("бит_ЛицевыеСчета"			, "Лицевые счета");
		Элементы.Справочник.СписокВыбора.Добавить("бит_СписокЗданий"			, "Список зданий");
		Элементы.Справочник.СписокВыбора.Добавить("бит_Квартиры"				, "Квартиры");
		Элементы.Справочник.СписокВыбора.Добавить("бит_Комнаты"					, "Комнаты");
		Элементы.Справочник.СписокВыбора.Добавить("бит_Подъезды"				, "Подъезды");
		Элементы.Справочник.СписокВыбора.Добавить("бит_Счетчики"				, "Счетчики");
		Элементы.Справочник.СписокВыбора.Добавить("бит_Проживающие"				, "Проживающие");
		Элементы.Справочник.СписокВыбора.Добавить("бит_ПлатежныеДокументыГИСЖКХ", "Платежные документы ГИС ЖКХ");
		
		Если Справочник = "бит_ЛицевыеСчетаКР"Тогда
			Справочник = "бит_ЛицевыеСчета";
		КонецЕсли;
		
	Иначе	
		Элементы.ФормаРедактироватьСправочник.Видимость	   = Ложь;
		Элементы.ФормаЗаписать.Видимость				   = Ложь;
		Элементы.Загрузить.Видимость					   = Истина;
		Элементы.ФормаЗаписать.КнопкаПоУмолчанию		   = Ложь;
		Элементы.Загрузить.КнопкаПоУмолчанию			   = Истина;
		Элементы.ГруппаСтраницаРеквизитов.Видимость		   = Ложь;
		Элементы.ГруппаСтраницаСправочников.Видимость	   = Ложь;
		Элементы.ГруппаСтраницаОтборов.Видимость		   = Ложь;
		Элементы.ГруппаСтраницаТабличныйДокумент.Видимость = Истина;
		Элементы.ГруппаСтраницаНастройка.Видимость		   = Истина;
		Элементы.УстановленныеОтборы.Видимость			   = Ложь;
		Элементы.ФайлЧтения.Видимость					   = Истина;
		Элементы.ГруппаСтраницы.ТекущаяСтраница			   = Элементы.ГруппаСтраницаТабличныйДокумент;
		
		Элементы.Справочник.СписокВыбора.Очистить();
		Элементы.Справочник.СписокВыбора.Добавить("бит_ЛицевыеСчета"			, "Лицевые счета");
		Элементы.Справочник.СписокВыбора.Добавить("бит_ЛицевыеСчетаКР"			, "Лицевые счета (кап. рем.)");
		Элементы.Справочник.СписокВыбора.Добавить("бит_Квартиры"				, "Квартиры");
		Элементы.Справочник.СписокВыбора.Добавить("бит_Счетчики"				, "Счетчики");
		Элементы.Справочник.СписокВыбора.Добавить("бит_ПлатежныеДокументыГИСЖКХ", "Платежные документы ГИС ЖКХ");
		
		Если ЗначениеЗаполнено(Справочник) Тогда
			ТаблицаЗагружаемыхРеквизитов.Очистить();
			ЗаполнитьНастройки(Справочник);
		КонецЕсли;	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура РеквизитыОбъектаМетаданныхВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "РеквизитыОбъектаМетаданныхСсылка" Тогда
		СтандартнаяОбработка = Ложь;
		Если НЕ Элемент.ТекущиеДанные = Неопределено  
			И ЗначениеЗаполнено(Элемент.ТекущиеДанные.Ссылка) Тогда
			
			Попытка
				Парам = Новый Структура("Ключ", Элемент.ТекущиеДанные.Ссылка);
				ОткрытьФорму("Справочник." + Справочник + ".ФормаОбъекта", Парам);
			Исключение
			КонецПопытки;
			
		КонецЕсли;
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛицевыхСчетовОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Элт Из ВыбранноеЗначение Цикл
		Если Элт = Неопределено
			ИЛИ элт = ПредопределенноеЗначение("Справочник.бит_ЛицевыеСчета.ПустаяСсылка") Тогда
			Продолжить;	
		КонецЕсли;
		НоваяСтрока = Объект.СписокЛицевыхСчетов.Добавить();
		НоваяСтрока.ЛицевойСчет = Элт;
	КонецЦикла;

КонецПроцедуры

&НаКлиенте
Процедура СписокУлицОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Элт Из ВыбранноеЗначение Цикл
		Если Элт = Неопределено
			ИЛИ Элт = ПредопределенноеЗначение("Справочник.бит_СписокУлиц.ПустаяСсылка") Тогда
			Продолжить;	
		КонецЕсли;
		НоваяСтрока = Объект.СписокУлиц.Добавить();
		НоваяСтрока.Улица = Элт;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЗданийОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Для Каждого Элт Из ВыбранноеЗначение Цикл
		Если Элт = Неопределено
			ИЛИ Элт = ПредопределенноеЗначение("Справочник.бит_СписокЗданий.ПустаяСсылка") Тогда
			Продолжить;	
		КонецЕсли;
		НоваяСтрока = Объект.СписокЗданий.Добавить();
		НоваяСтрока.Здание = Элт;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
