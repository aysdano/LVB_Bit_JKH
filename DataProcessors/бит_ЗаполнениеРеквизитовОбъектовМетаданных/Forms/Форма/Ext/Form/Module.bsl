&НаКлиенте
Процедура ПолучитьЭлементыСправочника(Команда)
	
	ОтобразитьТекущиеОтборы();
	
	Если РеквизитыОбъектаМетаданных.Количество() > 0
		И РеквизитыОбъектаМетаданных.НайтиСтроки(Новый Структура("ЭлтИзменен", Истина)).Количество() > 0 Тогда
		ПоказатьВопрос(Новый ОписаниеОповещения("ПолучитьЭлементыСправочникаЗавершение", ЭтотОбъект)
												, "Все изменения, на закладке 'Справочник', будут потеряны. Продолжить?"
												, РежимДиалогаВопрос.ДаНет); 
		Возврат;						
	КонецЕсли;
	
	// Проверка настроек.
	ИспользуемыРекты = Объект.ДоступныеРеквизиты.НайтиСтроки(Новый Структура ("Использовать", Истина));
	Если ИспользуемыРекты.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Выберите реквизиты справочника для редактирования!'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаРеквизитов;
		Возврат;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Справочник) Тогда
		ЗаполнитьРеквизитыОбъектаМетаданныхСервер();
	КонецЕсли;
	
	Элементы.ГруппаСтраницаСправочников.Заголовок = "Справочник """ + Элементы.Справочник.ТекстРедактирования + """";
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницаСправочников;
	
КонецПроцедуры

