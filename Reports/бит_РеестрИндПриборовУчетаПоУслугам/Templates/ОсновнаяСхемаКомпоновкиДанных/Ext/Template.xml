					ТОГДА ЕСТЬNULL(ВТ_РеестрИндСчетчиков.КоличествоРазрядовСчетчика, 0) - ЕСТЬNULL(ВТ_ОстатокНаНачало.НачальноеПоказание, 0) - ЕСТЬNULL(ВТ_НачальныеПоказанияСчетчиков.ПоказаниеСчетчикаПриУстановке, 0) + ЕСТЬNULL(ВТ_ОстатокНаКонец.КонечноеПоказание, 0) + 1
				ИНАЧЕ ЕСТЬNULL(ВТ_ОстатокНаКонец.КонечноеПоказание, 0) - ЕСТЬNULL(ВТ_ОстатокНаНачало.НачальноеПоказание, 0) - ЕСТЬNULL(ВТ_НачальныеПоказанияСчетчиков.ПоказаниеСчетчикаПриУстановке, 0)
			КОНЕЦ
