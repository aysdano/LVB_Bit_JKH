		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	бит_СведенияПоУслугамЛССрезПоследних.Поставщик
ИЗ
	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&amp;Период, ) КАК бит_СведенияПоУслугамЛССрезПоследних
ГДЕ
	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)</query>
