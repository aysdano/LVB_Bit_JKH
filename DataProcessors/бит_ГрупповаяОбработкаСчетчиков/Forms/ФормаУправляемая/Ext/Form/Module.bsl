// Процедура - обработчик события "НачалоВыбора" поля ввода "Счетчик" табличного поля "ДеревоСчетчиков".
//
&НаКлиенте
Процедура ДеревоСчетчиковСчетчикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.ДеревоСчетчиков.ТекущиеДанные;
	
	Если НЕ ТекСтрока = Неопределено Тогда
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ДокументУстановкаСчетчика) Тогда
			
			СписокСчетчиков = СформироватьСписокСчетчиков();
			
			Корень = ДеревоСчетчиков.ПолучитьЭлементы();
			
			Для каждого СтрокаДерева Из Корень Цикл
				
				Если НЕ СтрокаДерева.Счетчик.Пустая() Тогда
					
					СписокСчетчиков.Добавить(СтрокаДерева.Счетчик);
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			ФормаВыбора = ПолучитьФорму("Справочник.бит_Счетчики.Форма.ФормаВыбораУправляемая",,Элемент);
			
			ОтборУслуг = ФормаВыбора.Список.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
			ОтборУслуг.ЛевоеЗначение  = Новый ПолеКомпоновкиДанных("Ссылка");
			ОтборУслуг.ВидСравнения   = ВидСравненияКомпоновкиДанных.НеВСписке;
			ОтборУслуг.ПравоеЗначение = СписокСчетчиков;
			
			ФормаВыбора.Открыть();
			
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

