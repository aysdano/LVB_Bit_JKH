//HD+
// Удаляет буквенное сопровождение из доли собственности
// Параметры:
//  ДоляСобственности - доля в формате "1/24" или "1/24А"
// Возвращает:
//  Доля без буквенного сопровождения (например, "1/24")
//
Функция ОчиститьДолюОтБукв(ДоляСобственности)
	
	Если НЕ ЗначениеЗаполнено(ДоляСобственности) ИЛИ ПустаяСтрока(ДоляСобственности) Тогда
		Возврат ДоляСобственности;
	КонецЕсли;
	
	// Удаляем все буквы из строки, оставляя только цифры, "/" и пробелы
	Результат = "";
	Для Индекс = 1 По СтрДлина(ДоляСобственности) Цикл
		
		Символ = Сред(ДоляСобственности, Индекс, 1);
		// Оставляем только цифры, "/" и пробелы
		Если СтрНайти("0123456789/ ", Символ) > 0 Тогда
			Результат = Результат + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	// Убираем лишние пробелы
	Результат = СокрЛП(Результат);
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Форматирует СНИЛС в формат "123-123-123 12"
// Параметры:
//  СНИЛС - строка с СНИЛС в формате "12312312312"
// Возвращает:
//  Строка - СНИЛС в формате "123-123-123 12"
//
Функция ФорматироватьСНИЛС(СНИЛС)
	
	Если НЕ ЗначениеЗаполнено(СНИЛС) ИЛИ ПустаяСтрока(СНИЛС) Тогда
		Возврат СНИЛС;
	КонецЕсли;
	
	// Удаляем все нецифровые символы
	СНИЛСЧистый = "";
	Для Индекс = 1 По СтрДлина(СНИЛС) Цикл
		
		Символ = Сред(СНИЛС, Индекс, 1);
		Если СтрНайти("0123456789", Символ) > 0 Тогда
			СНИЛСЧистый = СНИЛСЧистый + Символ;
		КонецЕсли;
		
	КонецЦикла;
	
	// Если СНИЛС не содержит 11 цифр, возвращаем как есть
	Если СтрДлина(СНИЛСЧистый) <> 11 Тогда
		Возврат СНИЛС;
	КонецЕсли;
	
	// Форматируем: 123-123-123 12
	Результат = Лев(СНИЛСЧистый, 3) + "-" + Сред(СНИЛСЧистый, 4, 3) + "-" + Сред(СНИЛСЧистый, 7, 3) + " " + Прав(СНИЛСЧистый, 2);
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Убирает лишние пробелы в серии/номере паспорта (в регистре часто «5203          »).
//
Функция НормализоватьСериюНомерПаспорта(Знач ЗначениеПаспорта)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПаспорта) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = Строка(ЗначениеПаспорта);
	Результат = СтрЗаменить(Результат, Символы.НПП, " ");
	Результат = СтрЗаменить(Результат, Символы.Таб, " ");
	Результат = СтрЗаменить(Результат, Символы.ПС, "");
	Результат = СтрЗаменить(Результат, Символы.ВК, "");
	Результат = СокрЛП(Результат);
	
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //HD-

