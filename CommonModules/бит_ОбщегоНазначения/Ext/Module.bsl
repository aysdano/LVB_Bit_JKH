// Функция возвращает получателя денежных средств.
//
функция ПолучитьПолучателяДС(Дата, ЛицевойСчет,Услуга = Неопределено)
	
	Если Услуга <> Неопределено Тогда
		УсловиеУС = "И Услуга =&Услуга";
	Иначе
		УсловиеУС = "";
	КонецЕсли; 
	
	Результат = Новый Структура("Получатель, ДоговорКонтрагента");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ЛСПоставщики.ЛицевойСчет,
	|	ЛСПоставщики.Услуга,
	|	бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств,
	|	бит_ПолучателиДенежныхСредствСрезПоследних.ДоговорКонтрагента
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|		бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|		бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик
	|	ИЗ
	|		РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет "+ УсловиеУС +") КАК бит_СведенияПоУслугамЛССрезПоследних) КАК ЛСПоставщики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПолучателиДенежныхСредств.СрезПоследних(&Момент, ) КАК бит_ПолучателиДенежныхСредствСрезПоследних
	|		ПО ЛСПоставщики.Услуга = бит_ПолучателиДенежныхСредствСрезПоследних.Услуга
	|			И ЛСПоставщики.Поставщик = бит_ПолучателиДенежныхСредствСрезПоследних.Поставщик";
	
	
	Запрос.УстановитьПараметр("ЛицевойСчет" ,ЛицевойСчет);
	Запрос.УстановитьПараметр("Услуга"       ,Услуга);
	Запрос.УстановитьПараметр("Момент"       ,КонецМесяца(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Поставщик = Неопределено;
	
	Если Выборка.Следующий() Тогда

		Результат.Получатель         = Выборка.ПолучательДенежныхСредств;
		Результат.ДоговорКонтрагента = Выборка.ДоговорКонтрагента;
	КонецЕсли;                              
	
	// БИТ_ЖКХ 18.08.2014 раскомментирован код.
	Если Поставщик = Неопределено и типзнч(Услуга) = тип("СправочникСсылка.бит_бу_БиллинговыеУслуги") Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	ЛСПоставщики.ЛицевойСчет,
		|	ЛСПоставщики.Услуга,
		|	бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств
		|ИЗ
		|	(ВЫБРАТЬ
		|		бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|		бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
		|		бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик
		|	ИЗ
		|		РегистрСведений.бит_бу_СведенияОБиллинговыхУслугах.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет "+ УсловиеУС +") КАК бит_СведенияПоУслугамЛССрезПоследних) КАК ЛСПоставщики
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_бу_ПолучателиДенежныхСредств.СрезПоследних(&Момент, ) КАК бит_ПолучателиДенежныхСредствСрезПоследних
		|		ПО ЛСПоставщики.Услуга = бит_ПолучателиДенежныхСредствСрезПоследних.Услуга
		|			И ЛСПоставщики.Поставщик = бит_ПолучателиДенежныхСредствСрезПоследних.Поставщик";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			Поставщик = Выборка.ПолучательДенежныхСредств;
			Результат.Получатель = Выборка.ПолучательДенежныхСредств; // БИТ_ЖКХ добавлен получатель

		КонецЕсли;
		
	КонецЕсли; 
	// БИТ_ЖКХ 18.08.2014
	
	Возврат Результат;
	// БИТ_ЖКХ изменение кода. Конец. 14.11.2011}}
КонецФункции

