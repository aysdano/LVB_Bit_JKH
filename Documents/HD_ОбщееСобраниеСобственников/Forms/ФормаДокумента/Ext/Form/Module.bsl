	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Заполняет табличную часть "ПовесткаДня" из шаблона повестки
//
&НаСервере
Процедура ЗаполнитьТЧПовесткаДня()
	
	Объект.ПовесткаДня.Очистить();
	
	// Проверяем наличие шаблона повестки
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонПовестки) Тогда
		Возврат;
	КонецЕсли;
	
	// Проверяем наличие табличной части в шаблоне
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонПовестки.СписокПевесток) 
		ИЛИ Объект.ШаблонПовестки.СписокПевесток.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Инициализируем соответствие для хранения шаблонов текста из справочника
	// Ключ: "ИндексСтроки_ИмяПоля", Значение: шаблон текста из справочника
	ШаблоныТекста = Новый Соответствие;
	
	// Заполняем табличную часть ПовесткаДня данными из справочника HD_ПовесткиСобранийСобственников
	ИндексСтроки = 0;
	Для Каждого СтрокаТЧ Из Объект.ШаблонПовестки.СписокПевесток Цикл
		
		// Пропускаем строки без ссылки на повестку
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Повестка) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			ДанныеПунктаПовестки = ПолучитьДанныеПунктаПовесткиСправочника(СтрокаТЧ.Повестка);
			
			НоваяСтрокаПовестки = Объект.ПовесткаДня.Добавить();
			НоваяСтрокаПовестки.ЭтоПриложение = ДанныеПунктаПовестки.ЭтоПриложение;
			
			Если ДанныеПунктаПовестки.ЭтоПриложение Тогда
				НоваяСтрокаПовестки.Приложение = ДанныеПунктаПовестки.Приложение;
				НоваяСтрокаПовестки.Вопрос = ДанныеПунктаПовестки.Приложение;
				Если ЗначениеЗаполнено(ДанныеПунктаПовестки.Приложение) Тогда
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Приложение";
					ШаблоныТекста.Вставить(Ключ, ДанныеПунктаПовестки.Приложение);
				КонецЕсли;
			Иначе
				Если ЗначениеЗаполнено(ДанныеПунктаПовестки.Вопрос) Тогда
					НоваяСтрокаПовестки.Вопрос = ДанныеПунктаПовестки.Вопрос;
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Вопрос";
					ШаблоныТекста.Вставить(Ключ, ДанныеПунктаПовестки.Вопрос);
				КонецЕсли;
				Если ЗначениеЗаполнено(ДанныеПунктаПовестки.ФормулировкаПредложенияРешенияВопроса) Тогда
					НоваяСтрокаПовестки.ФормулировкаПредложенияРешенияВопроса = ДанныеПунктаПовестки.ФормулировкаПредложенияРешенияВопроса;
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса";
					ШаблоныТекста.Вставить(Ключ, ДанныеПунктаПовестки.ФормулировкаПредложенияРешенияВопроса);
				КонецЕсли;
			КонецЕсли;
			
			ИндексСтроки = ИндексСтроки + 1;
		
			// Сохраняем другие поля из табличной части шаблона, если они есть
		Попытка
			Если ЗначениеЗаполнено(СтрокаТЧ.СтатусВопроса) Тогда
				НоваяСтрокаПовестки.СтатусВопроса = СтрокаТЧ.СтатусВопроса;
			КонецЕсли;
		Исключение
			// Поле отсутствует в табличной части шаблона - пропускаем
		КонецПопытки;
		
		Попытка
			Если ЗначениеЗаполнено(СтрокаТЧ.Идентификатор) Тогда
				НоваяСтрокаПовестки.Идентификатор = СтрокаТЧ.Идентификатор;
			КонецЕсли;
		Исключение
			// Поле отсутствует в табличной части шаблона - пропускаем
			КонецПопытки;
			
		Исключение
			// Если не удалось получить объект справочника, пропускаем строку
			Продолжить;
		КонецПопытки;
		
	КонецЦикла;
	
	//HD+ После заполнения табличной части всегда сохраняем шаблоны из справочника
	// Это необходимо для корректной работы функционала возврата к исходному значению
	СохранитьШаблоныТекстаПовесткиДняНаСервере();
	
КонецПроцедуры //HD-

//HD+
// Вызывает процедуру печати печатной формы в модуле объекта
//
&НаСервере
Функция ПечатьПечатнойФормыНаСервере(ИмяШаблона, БезДоверенности = Ложь)
	
	ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	
	// Передаем адрес шаблонов общих областей, если он есть
	АдресШаблоновОбластей = "";
	Если ЗначениеЗаполнено(АдресШаблоновОбщихОбластейВоВременномХранилище) Тогда
		АдресШаблоновОбластей = АдресШаблоновОбщихОбластейВоВременномХранилище;
	КонецЕсли;
	
	ТабличныйДокумент = ОбъектДокумента.СформироватьПечатнуюФорму(ИмяШаблона, АдресШаблоновОбластей, БезДоверенности);
	
	Возврат ТабличныйДокумент;
	
КонецФункции //HD-

//HD+
// Выгружает макет Word во временное хранилище (вариант А: сервер не использует ПолучитьОбласть).
// ИмяШаблона — имя макета, например "ПФ_MXL_Протокол_word".
// Макет берётся из объекта формы (как в бит_ИсковоеЗаявление). Возвращает адрес во временном хранилище или пустую строку при ошибке.
//
&НаСервере
Функция ПолучитьМакетWordВоВременноеХранилище(ИмяШаблона)
	
	Попытка
		ОбъектДокумента = РеквизитФормыВЗначение("Объект");
		Макет = ОбъектДокумента.ПолучитьМакет(ИмяШаблона);
		Если Макет = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		ИмяВременногоФайла = КаталогВременныхФайлов() + "HD_OSS_Word_" + СтрЗаменить(ИмяШаблона, " ", "_") + "_" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах()) + ".docx";
		Макет.Записать(ИмяВременногоФайла);
		
		ДвоичныеДанныеШаблона = Новый ДвоичныеДанные(ИмяВременногоФайла);
		УдалитьФайлы(ИмяВременногоФайла);
		
		АдресВХранилище = ПоместитьВоВременноеХранилище(ДвоичныеДанныеШаблона);
		Возврат АдресВХранилище;
	Исключение
		Возврат "";
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Возвращает структуру с ключами АдресШаблона (двоичные данные во временном хранилище) и Данные (структура для закладок Word).
// ОболочкаActiveDocument не передаётся с сервера — макет записывается в файл на сервере, читается в ДвоичныеДанные и помещается в хранилище. Документ должен быть сохранён.
//
&НаСервере
Функция ПолучитьШаблонИДанныеДляПечатиWord(ИмяШаблона)
	
	ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Если НЕ ЗначениеЗаполнено(ОбъектДокумента.Ссылка) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ДокументОбъект = ОбъектДокумента;
	Если ТипЗнч(ДокументОбъект) <> Тип("ДокументОбъект.HD_ОбщееСобраниеСобственников") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Данные = ДокументОбъект.ПолучитьДанныеДляЗаполненияПечатнойФормыWord(ИмяШаблона);
	АдресШаблона = ПолучитьМакетWordВоВременноеХранилище(ИмяШаблона);
	Если НЕ ЗначениеЗаполнено(АдресШаблона) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат Новый Структура("АдресШаблона, Данные", АдресШаблона, Данные);
	
