
#Область ФормированиеДвижений

Процедура СформироватьДвиженияОплатаНачисленияПоУслугамЖКХ(Организация, ТаблицаУслуг, ТаблицаУслугПоПериоду, Реквизиты, Движения, Отказ) Экспорт
	
	НачислениеПоУсл 					= Движения.бит_НачисленияПоУслугамЖКХ;
	НачислениеПени  					= Движения.бит_НачислениеПениПоУслугамЖКХ;
	НачислениеПоУслПоПериоду 			= Движения.бит_НачисленияПоУслугамЖКХПоПериоду;   
	НачислениеПоУсл.Записывать 			= Истина;
	НачислениеПени.Записывать  			= Истина;
	НачислениеПоУслПоПериоду.Записывать = Истина; 
	
	Для каждого СтрокаТЧ Из ТаблицаУслуг Цикл
		Если СтрокаТЧ.Сумма<>0 тогда
			Движение = НачислениеПоУсл.Добавить();
			Движение.ВидДвижения = ВидДвиженияНакопления.Расход;
			Движение.Период      = Реквизиты.Дата;
			Движение.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			Движение.УслугаЖКХ   = СтрокаТЧ.Услуга;
			Движение.Сумма       = СтрокаТЧ.Сумма;
			Движение.Организация  = Организация;
		КонецЕсли;
		Если СтрокаТЧ.СуммаПени <> 0 Тогда
			ДвижениеПени = НачислениеПени.Добавить();
			ДвижениеПени.ВидДвижения = ВидДвиженияНакопления.Расход;
			ДвижениеПени.Период      = Реквизиты.Дата;
			ДвижениеПени.ЛицевойСчет = СтрокаТЧ.ЛицевойСчет;
			ДвижениеПени.УслугаЖКХ   = СтрокаТЧ.Услуга;
			ДвижениеПени.СуммаПени   = СтрокаТЧ.СуммаПени;
			ДвижениеПени.Организация   = Организация;
		КонецЕсли;
	КонецЦикла;
	
	//+! Гаспирович В.В. ФормируемДвиженияПоПериоду 
	Если Реквизиты.ссылка.лб_ВидОплаты = справочники.лб_ВидыОплат.найтиПоКоду("000000004")
		и Реквизиты.ссылка.СписокУслугПоПериоду.количество() <>0 тогда 
		//Если это бухсправка, то таблица распределения по периодам уже расчтана   
		для каждого СтрокаТаб из Реквизиты.ссылка.СписокУслугПоПериоду цикл  
			СтрокаПоПериоду = НачислениеПоУслПоПериоду.добавитьРасход();   
			ЗаполнитьЗначенияСвойств(СтрокаПоПериоду,СтрокаТаб);  
			СтрокаПоПериоду.период = Реквизиты.дата;
			СтрокаПоПериоду.регистратор = Реквизиты.Ссылка; 
			СтрокаПоПериоду.Организация = реквизиты.Организация; 
			СтрокаПоПериоду.УслугаЖКХ = СтрокаТаб.услуга;
		КонецЦикла;
	иначе
		
		
		
		
		
		//1. Без исполнительных листов	
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_ОплатаКУСписокЛС.ЛицевойСчет КАК ЛицевойСчет,
			|	бит_ОплатаКУСписокЛС.Ссылка.Организация КАК Организация,
			|	бит_ОплатаКУСписокЛС.ИсполнительныйЛист КАК ИсполнительныйЛист,
			|	СУММА(бит_ОплатаКУСписокУслуг.Сумма) КАК Сумма,
			|	бит_ОплатаКУСписокУслуг.Услуга КАК УслугаЖКХ,
			|	бит_ОплатаКУСписокЛС.лб_ПериодНачисления КАК лб_ПериодНачисления,
			|	бит_ОплатаКУСписокЛС.Ссылка.Дата КАК Период
			|ИЗ
			|	Документ.бит_ОплатаКУ.СписокЛС КАК бит_ОплатаКУСписокЛС
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОплатаКУ.СписокУслуг КАК бит_ОплатаКУСписокУслуг
			|		ПО бит_ОплатаКУСписокЛС.ЛицевойСчет = бит_ОплатаКУСписокУслуг.ЛицевойСчет
			|			И бит_ОплатаКУСписокЛС.лб_КлючСтроки = бит_ОплатаКУСписокУслуг.лб_КлючСтроки
			|ГДЕ
			|	бит_ОплатаКУСписокЛС.Ссылка = &Ссылка
			|	И бит_ОплатаКУСписокЛС.ИсполнительныйЛист = ЗНАЧЕНИЕ(Документ.бит_ИсполнительныйЛист.ПустаяСсылка)
			|	И бит_ОплатаКУСписокУслуг.Ссылка = &Ссылка
			|
			|СГРУППИРОВАТЬ ПО
			|	бит_ОплатаКУСписокЛС.ЛицевойСчет,
			|	бит_ОплатаКУСписокУслуг.Услуга,
			|	бит_ОплатаКУСписокЛС.лб_ПериодНачисления,
			|	бит_ОплатаКУСписокЛС.ИсполнительныйЛист,
			|	бит_ОплатаКУСписокЛС.Ссылка.Организация,
			|	бит_ОплатаКУСписокЛС.Ссылка.Дата";
		
		запрос.УстановитьПараметр("Ссылка",Реквизиты.Ссылка);
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   
			Если ВыборкаДетальныеЗаписи.Сумма <>0 тогда
				ДвижениеУслПоПериоду	 = НачислениеПоУслПоПериоду.Добавитьрасход();  
				ЗаполнитьЗначенияСвойств(ДвижениеУслПоПериоду,ВыборкаДетальныеЗаписи); 
				ДвижениеУслПоПериоду.ПериодВзаиморасчетов = ПолучитьПериодПоСтроке(реквизиты.ссылка,ВыборкаДетальныеЗаписи.лб_ПериодНачисления); 
			КонецЕсли;
		КонецЦикла;
		
		//2. ИсполнительныеЛистыСразуРаспределяемПоПериодам
		Запрос = Новый Запрос;
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_ОплатаКУСписокЛС.ЛицевойСчет КАК ЛицевойСчет,
			|	бит_ОплатаКУСписокЛС.Ссылка.Организация КАК Организация,
			|	СУММА(бит_ОплатаКУСписокУслуг.Сумма) КАК СуммаКРаспределению,
			|	бит_ОплатаКУСписокУслуг.Услуга КАК УслугаЖКХ,
			|	бит_ОплатаКУСписокЛС.ИсполнительныйЛист.ПериодОбразованияЗадолженностиОт КАК ИсполнительныйЛистПериодОбразованияЗадолженностиОт,
			|	бит_ОплатаКУСписокЛС.ИсполнительныйЛист КАК ИсполнительныйЛист
			|ПОМЕСТИТЬ вт01
			|ИЗ
			|	Документ.бит_ОплатаКУ.СписокЛС КАК бит_ОплатаКУСписокЛС
			|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОплатаКУ.СписокУслуг КАК бит_ОплатаКУСписокУслуг
			|		ПО бит_ОплатаКУСписокЛС.ЛицевойСчет = бит_ОплатаКУСписокУслуг.ЛицевойСчет
			|			И бит_ОплатаКУСписокЛС.лб_КлючСтроки = бит_ОплатаКУСписокУслуг.лб_КлючСтроки
			|ГДЕ
			|	бит_ОплатаКУСписокЛС.Ссылка = &Ссылка
			|	И бит_ОплатаКУСписокЛС.ИсполнительныйЛист <> ЗНАЧЕНИЕ(Документ.бит_ИсполнительныйЛист.ПустаяСсылка)
			|	И бит_ОплатаКУСписокУслуг.Ссылка = &Ссылка
			|	И бит_ОплатаКУСписокУслуг.Сумма <> 0
			|
			|СГРУППИРОВАТЬ ПО
			|	бит_ОплатаКУСписокЛС.ЛицевойСчет,
			|	бит_ОплатаКУСписокУслуг.Услуга,
			|	бит_ОплатаКУСписокЛС.Ссылка.Организация,
			|	бит_ОплатаКУСписокЛС.ИсполнительныйЛист.ПериодОбразованияЗадолженностиОт,
			|	бит_ОплатаКУСписокЛС.ИсполнительныйЛист
			|
			|ИМЕЮЩИЕ
			|	СУММА(бит_ОплатаКУСписокУслуг.Сумма) <> 0
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.Организация КАК Организация,
			|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.ЛицевойСчет КАК ЛицевойСчет,
			|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.УслугаЖКХ КАК УслугаЖКХ,
			|	КОНЕЦПЕРИОДА(бит_НачисленияПоУслугамЖКХПоПериодуОстатки.ПериодВзаиморасчетов, МЕСЯЦ) КАК ПериодВзаиморасчетов,
			|	СУММА(бит_НачисленияПоУслугамЖКХПоПериодуОстатки.СуммаОстаток) КАК СуммаОстаток
			|ПОМЕСТИТЬ вт02
			|ИЗ
			|	РегистрНакопления.бит_НачисленияПоУслугамЖКХПоПериоду.Остатки(
			|			&ДатаДок,
			|			(Организация, ЛицевойСчет, УслугаЖКХ) В
			|				(ВЫБРАТЬ
			|					вт01.Организация КАК Организация,
			|					вт01.ЛицевойСчет КАК ЛицевойСчет,
			|					вт01.УслугаЖКХ КАК УслугаЖКХ
			|				ИЗ
			|					вт01 КАК вт01)) КАК бит_НачисленияПоУслугамЖКХПоПериодуОстатки
			|ГДЕ
			|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.СуммаОстаток > 0
			|
			|СГРУППИРОВАТЬ ПО
			|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.Организация,
			|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.ЛицевойСчет,
			|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.УслугаЖКХ,
			|	КОНЕЦПЕРИОДА(бит_НачисленияПоУслугамЖКХПоПериодуОстатки.ПериодВзаиморасчетов, МЕСЯЦ)
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	вт01.ИсполнительныйЛист КАК ИсполнительныйЛист,
			|	вт01.ЛицевойСчет КАК ЛицевойСчет,
			|	вт01.УслугаЖКХ КАК УслугаЖКХ,
			|	вт01.Организация КАК Организация,
			|	МАКСИМУМ(ЕСТЬNULL(вт01.СуммаКРаспределению, 0)) КАК СуммаКРаспределению,
			|	вт02.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
			|	СУММА(ЕСТЬNULL(вт02.СуммаОстаток, 0)) КАК СуммаОстаток
			|ИЗ
			|	вт01 КАК вт01
			|		ЛЕВОЕ СОЕДИНЕНИЕ вт02 КАК вт02
			|		ПО вт01.Организация = вт02.Организация
			|			И вт01.ЛицевойСчет = вт02.ЛицевойСчет
			|			И вт01.УслугаЖКХ = вт02.УслугаЖКХ
			|			И вт01.ИсполнительныйЛистПериодОбразованияЗадолженностиОт <= вт02.ПериодВзаиморасчетов
			|
			|СГРУППИРОВАТЬ ПО
			|	вт01.Организация,
			|	вт01.ЛицевойСчет,
			|	вт01.УслугаЖКХ,
			|	вт02.ПериодВзаиморасчетов,
			|	вт01.ИсполнительныйЛист
			|
			|УПОРЯДОЧИТЬ ПО
			|	Организация,
			|	ЛицевойСчет,
			|	УслугаЖКХ,
			|	ИсполнительныйЛист,
			|	ПериодВзаиморасчетов
			|ИТОГИ
			|	МАКСИМУМ(СуммаКРаспределению),
			|	СУММА(СуммаОстаток)
			|ПО
			|	ИсполнительныйЛист,
			|	ЛицевойСчет,
			|	УслугаЖКХ";
		
		Запрос.УстановитьПараметр("ДатаДок", Реквизиты.Дата);
		Запрос.УстановитьПараметр("Ссылка", Реквизиты.Ссылка);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаИсполнительныйЛист = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаИсполнительныйЛист.Следующий() Цикл
		
			ВыборкаЛицевойСчет = ВыборкаИсполнительныйЛист.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
			Пока ВыборкаЛицевойСчет.Следующий() Цикл
		
				ВыборкаУслугаЖКХ = ВыборкаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
				Пока ВыборкаУслугаЖКХ.Следующий() Цикл
		            СуммаКРаспределениюПоУслуге = ВыборкаУслугаЖКХ.СуммаКРаспределению;
					Если СуммаКРаспределениюПоУслуге>0 тогда
					
						ВыборкаДетальныеЗаписи = ВыборкаУслугаЖКХ.Выбрать();
		
						Пока ВыборкаДетальныеЗаписи.Следующий() и СуммаКРаспределениюПоУслуге>0 Цикл   
								Если ВыборкаДетальныеЗаписи.СуммаОстаток>0 тогда //это условие есть в запросе. продублирую тут
								    СуммаНаПериод = мин(ВыборкаДетальныеЗаписи.СуммаОстаток,СуммаКРаспределениюПоУслуге);
									ДвижениеУслПоПериоду	 = НачислениеПоУслПоПериоду.ДобавитьРасход();  
									ЗаполнитьЗначенияСвойств(ДвижениеУслПоПериоду,ВыборкаДетальныеЗаписи);
									ДвижениеУслПоПериоду.период = Реквизиты.дата;
									ДвижениеУслПоПериоду.Регистратор = Реквизиты.ссылка;
									ДвижениеУслПоПериоду.Сумма = СуммаНаПериод;
									СуммаКРаспределениюПоУслуге=СуммаКРаспределениюПоУслуге-СуммаНаПериод;
								КонецЕсли;  
		 				КонецЦикла; 
						Если СуммаКРаспределениюПоУслуге>0 тогда //если что-то осталось нераспределенное, то пишем остаток на текущий месяц
							ДвижениеУслПоПериоду	 = НачислениеПоУслПоПериоду.ДобавитьРасход();  
							ЗаполнитьЗначенияСвойств(ДвижениеУслПоПериоду,ВыборкаУслугаЖКХ);
							ДвижениеУслПоПериоду.Период = Реквизиты.дата;
							ДвижениеУслПоПериоду.Регистратор = Реквизиты.ссылка;
							ДвижениеУслПоПериоду.Сумма = СуммаКРаспределениюПоУслуге;  
							ДвижениеУслПоПериоду.ПериодВзаиморасчетов = КонецМесяца(реквизиты.дата);
							СуммаКРаспределениюПоУслуге=0;
							ДвижениеУслПоПериоду.Организация = Организация;
						КонецЕсли;
					иначе // к распределению меньше нуля, значит пишем в текущий период (распределение авансов потом закроет переплаты)
					    ДвижениеУслПоПериоду	 = НачислениеПоУслПоПериоду.ДобавитьРасход();  
						ЗаполнитьЗначенияСвойств(ДвижениеУслПоПериоду,ВыборкаУслугаЖКХ);
						ДвижениеУслПоПериоду.Период = Реквизиты.дата;
						ДвижениеУслПоПериоду.Регистратор = Реквизиты.ссылка;
						ДвижениеУслПоПериоду.Сумма = СуммаКРаспределениюПоУслуге; 
						ДвижениеУслПоПериоду.ПериодВзаиморасчетов = КонецМесяца(реквизиты.дата);
						ДвижениеУслПоПериоду.Организация = Организация;
					КонецЕсли;
				КонецЦикла;
			КонецЦикла;
		КонецЦикла;
		
		//Запишем периоды оплаты
		ДвиженияПериоды = Движения.бит_ПериодыОплатыКУ;
		нпп =1;
		Для каждого СтрокаТЧ Из реквизиты.ссылка.списокЛС Цикл
			ДвижениеПериода					  = ДвиженияПериоды.Добавить();
			ДвижениеПериода.ДокОплаты		  = Реквизиты.ссылка;
			ДвижениеПериода.ЛицевойСчет		  = СтрокаТЧ.ЛицевойСчет;
			ДвижениеПериода.ПериодОплаты=НачалоМесяца(ПолучитьПериодПоСтроке(реквизиты.ссылка,СтрокаТЧ.лб_ПериодНачисления));
			ДвижениеПериода.нпп = нпп;
			нпп = нпп + 1;
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры  

Функция ПолучитьОстаткиУслугиПоПериодам(пВыборка) 
	//СтрокаНабора = пнабор.добавитьрасход();
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
