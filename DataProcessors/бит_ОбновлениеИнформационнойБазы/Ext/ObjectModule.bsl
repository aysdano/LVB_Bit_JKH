// Процедруа выполняет обновление / добавление счета "76.КУ".
//
Процедура ОбработатьСчет76КУ()
	
	Счет76КУ = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.КУ");
	
	Если Счет76КУ = ПланыСчетов.Хозрасчетный.ПустаяСсылка() Тогда
		
		НовыйСчет = ПланыСчетов.Хозрасчетный.СоздатьСчет();
		НовыйСчет.Код               = "76.КУ";
		НовыйСчет.КодБыстрогоВыбора = "76КУ";
		НовыйСчет.Наименование      = "Расчеты по лицевым счетам за предоставляемые услуги";
		НовыйСчет.Вид               = ВидСчета.АктивноПассивный;
		НовыйСчет.Родитель          = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76");
		НовыйСчет.НалоговыйУчет     = Истина;
		
		НовСтрока = НовыйСчет.ВидыСубконто.Добавить();
		НовСтрока.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета;
		НовСтрока.Суммовой    = Истина;
		Попытка
			
			НовыйСчет.Записать();	
			
		Исключение
			
		КонецПопытки;
		
	ИначеЕсли Счет76КУ <> Неопределено Тогда
		
		НовыйСчет = Счет76КУ.ПолучитьОбъект(); 
		
		Если НЕ НовыйСчет.НалоговыйУчет Тогда
			
			НовыйСчет.НалоговыйУчет = Истина;
			
		КонецЕсли;
		
		СтрокаСубконта = НовыйСчет.ВидыСубконто.Найти(1, "НомерСтроки");
		Если СтрокаСубконта = Неопределено Тогда
			
			НовСтрока = НовыйСчет.ВидыСубконто.Добавить();
			НовСтрока.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета;
			НовСтрока.Суммовой    = Истина;
			
		Иначе
			
			СтрокаСубконта.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета;
			СтрокаСубконта.Суммовой    = Истина;
			
		КонецЕсли;
		
		СтрокаСубконта = НовыйСчет.ВидыСубконто.Найти(2, "НомерСтроки");
		Если СтрокаСубконта = Неопределено Тогда
			
			НовСтрока = НовыйСчет.ВидыСубконто.Добавить();
			НовСтрока.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета;
			НовСтрока.Суммовой    = Истина;
			
		Иначе
			
			СтрокаСубконта.ВидСубконто = ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета;
			СтрокаСубконта.Суммовой    = Истина;
			
		КонецЕсли;
		
		Попытка
			
			НовыйСчет.Записать();	
			
		Исключение
			
		КонецПопытки;
		
	Иначе

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Произошла ошибка создания счета ""76.КУ"".");
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура загружает справочную информацию в информационную базу.
//
// Параметры:
//  ИмяМакета  - Строка.
//  ОбщийМакет - Булево.
//
Процедура ЗагрузитьСправочнуюИнформациюИзМакета(ИмяМакета) Экспорт
	
	ТекстДляЗагрузки = ПолучитьМакет(ИмяМакета).ПолучитьТекст();
	
	Если СокрЛП(ТекстДляЗагрузки)="" Тогда
		Возврат;
	КонецЕсли;
	
	ЧтениеXML = Новый ЧтениеXML;
	ЧтениеXML.УстановитьСтроку(ТекстДляЗагрузки);
	ЧтениеXML.ПерейтиКСодержимому();
	ЧтениеXML.Прочитать();
	
	Попытка
		
		Пока ВозможностьЧтенияДанных(ЧтениеXML) Цикл
			
			// Читаем очередное значение.
			Данные = ПрочитатьXML(ЧтениеXML);
			
			Если Данные = Неопределено Тогда
				
				Продолжить;
				
			КонецЕсли;
			Данные.ОбменДанными.Загрузка = Истина;
			Данные.Записать();		
			
		КонецЦикла;
		
		ЧтениеXML.Закрыть();
		
	Исключение
		
		ТекстОшибки = ОписаниеОшибки();
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстОшибки);
		
		ВызватьИсключение (ТекстОшибки);
		
	КонецПопытки;
	
КонецПроцедуры

// Функция проверяет возможность чтения данных XML.
//
// Параметры:
//  ЧтениеXML - ЧтениеXML.
//
// Возвращаемое значение:
//  ЧтениеВозможно - Булево.
//
Функция ВозможностьЧтенияДанных(ЧтениеXML)
	
	// Получаем тип данных XML, который может быть считан в данный момент.
	ТипXML = ПолучитьXMLТип(ЧтениеXML);
	Если ТипXML = Неопределено Тогда		
		Возврат Ложь;		
	ИначеЕсли ТипXML.ИмяТипа = "CatalogObject.бит_си_Статьи" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат ВозможностьЧтенияXML(ЧтениеXML);
	
КонецФункции // ВозможностьЧтенияДанных()

