	Запрос.УстановитьПараметр("ОбъектУчета", Объект.Ссылка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЗначениеСвойствОбъектовУчета.ВидСвойства,
	|	бит_ЗначениеСвойствОбъектовУчета.Значение
	|ИЗ
