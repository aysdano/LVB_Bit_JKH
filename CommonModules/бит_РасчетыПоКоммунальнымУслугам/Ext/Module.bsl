	запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПериодЗапроса));
	запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ПериодЗапроса));

	таблицаЗапроса = запрос.Выполнить().Выгрузить();
	
	если таблицаЗапроса.Найти(справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо, "СтепеньРодства") = неопределено тогда
	 структураВозврата.Вставить("ФизЛицо", таблицаЗапроса[0].ФизЛицо);
	 структураВозврата.Вставить("Ответственный", ложь);	
	 возврат структураВозврата;
    конецесли;
	
	если таблицаЗапроса.Количество() > 0 тогда
		таблицаЗапроса.Сортировать("ДатаРегистрации Убыв");
		
		// БИТ ЖКХ 10.04.2020 - сейчас ответственный?		
		если таблицаЗапроса[0].СтепеньРодства = справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо тогда 
		  структураВозврата.Вставить("ФизЛицо", таблицаЗапроса[0].ФизЛицо);
		  если ДатаВПериоде (таблицаЗапроса[0].ДатаРегистрации, ПериодЗапроса) тогда
		   структураВозврата.Вставить("Ответственный", истина); 
	      иначе
		   структураВозврата.Вставить("Ответственный", истина); 
		  конецесли; 
		  структураВозврата.Вставить("ДатаСнятияСРегистрации", таблицаЗапроса[0].ДатаСнятияСРегистрации);
		  структураВозврата.Вставить("ДатаРегистрации", таблицаЗапроса[0].ДатаРегистрации);
		  
		  возврат структураВозврата; 
		конецесли;	         		
		
		// БИТ ЖКХ 10.04.2020 - когда был ответственным?
		датаСнятияСтатуса = НайтиДатуСнятияОтветственногоПоРегистрации (таблицаЗапроса);
		
		если ДатаВПериоде (датаСнятияСтатуса, ПериодЗапроса) тогда		
		 структураВозврата.Вставить("ФизЛицо", таблицаЗапроса[0].ФизЛицо);
		 структураВозврата.Вставить("Ответственный", истина); 
		 структураВозврата.Вставить("ДатаСнятияСРегистрации",датаСнятияСтатуса);
		 структураВозврата.Вставить("ДатаРегистрации", '00010101000000');		 
	    иначе
		 структураВозврата.Вставить("ФизЛицо", таблицаЗапроса[0].ФизЛицо);
	     структураВозврата.Вставить("Ответственный", ложь);
	 конецесли; 
	 
    конецесли;			
 
	возврат структураВозврата; 
конецфункции

функция НайтиДатуСнятияОтветственногоПоВладению (ФизЛицо, таблицаЗапроса) 
	
  датаСтатуса = таблицаЗапроса[0].ДатаПраваСобственности; 	
  
  для каждого стр из таблицаЗапроса цикл
	  
	если стр.СтепеньРодства = справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо тогда  
	  возврат датаСтатуса;        	  
    иначе
	  датаСтатуса = стр.ДатаПраваСобственности; 
	конецесли;
		
  конеццикла;	  
  возврат датаСтатуса;
конецфункции	

функция НайтиДатуСнятияОтветственногоПоРегистрации (таблицаЗапроса) 
	
  датаСтатуса = таблицаЗапроса[0].ДатаРегистрации; 	
  
  для каждого стр из таблицаЗапроса цикл
	  
	если стр.СтепеньРодства = справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо тогда  
	  возврат датаСтатуса;        	  
    иначе
	  датаСтатуса = стр.ДатаРегистрации; 
	конецесли;
		
  конеццикла;	  
  возврат датаСтатуса;
конецфункции

функция ДатаВпериоде (ДатаСтатуса, Период)
	
	если ДатаСтатуса >= НачалоМесяца(Период) и ДатаСтатуса <= КонецМесяца(Период) тогда
		возврат истина;
	иначе
		возврат ложь;
	конецесли;
	
конецфункции	

// Процедура выполняет расчет начислений по групповым счетчикам с наличием индивидуальных.
//
Процедура РасчитатьНачисленияПоОбщедомовымРасходам(Дата, НачалоПериода, КонецПериода,Организация, ТаблицаОбщедомовыеНачисления, УчитыватьНачисленияПоГрупповымСчетчикам = Ложь, УчитыватьПерерасчет = Ложь) Экспорт
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	// Таблица в которой хранится сведения о начилениях лицевого счета по услуге.
	// С учетом распределенного и не распределеного остатка общедомового счетчика.
	ТаблицаРасчетов = Новый ТаблицаЗначений;
	ТаблицаРасчетов.Колонки.Добавить("ЛицевойСчет"            , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаРасчетов.Колонки.Добавить("Услуга"                 , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	ТаблицаРасчетов.Колонки.Добавить("СуммаНачислений"        , ОбщегоНазначения.ОписаниеТипаЧисло(15,4));
	ТаблицаРасчетов.Колонки.Добавить("НераспределенныйОстаток", ОбщегоНазначения.ОписаниеТипаЧисло(15,4));
	
	Запрос.УстановитьПараметр("Дата"         , КонецДня(Дата));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(НачалоПериода));
	Запрос.УстановитьПараметр("КонецПериода" , КонецМесяца(КонецПериода));
	
	Запрос.УстановитьПараметр("УчитыватьНачисленияПоГрупповымСчетчикам", УчитыватьНачисленияПоГрупповымСчетчикам);
	Запрос.УстановитьПараметр("УчитыватьПерерасчет"                    , УчитыватьПерерасчет);
	
	Запрос.УстановитьПараметр("Организация"  , Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НачисленоНорма,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|					ИЛИ бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОбщиеНачисления,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые
	|ПОМЕСТИТЬ НачисленияНорм
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачисленияПоСчетчикамОбороты.ЛицевойСчет,
	|	бит_НачисленияПоСчетчикамОбороты.УслугаЖКХ КАК Услуга,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоСчетчикамОбороты.Счетчик.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
	|				ТОГДА бит_НачисленияПоСчетчикамОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НачисленоСчетчик,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоСчетчикамОбороты.Счетчик.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)
	|					И бит_НачисленияПоСчетчикамОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|				ТОГДА бит_НачисленияПоСчетчикамОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК НачисленоГрупСчетчик
	|ПОМЕСТИТЬ НачисленияСчетчиков
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоСчетчикам.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоСчетчикамОбороты
	|ГДЕ
	|	бит_НачисленияПоСчетчикамОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоСчетчикамОбороты.ЛицевойСчет,
	|	бит_НачисленияПоСчетчикамОбороты.УслугаЖКХ";
	
	Запрос.Выполнить();
	
	ТекстОтбор = 
	"ВЫБРАТЬ
	|	ПоказанийСчетчиков.Услуга,
	|	ПоказанийСчетчиков.Счетчик КАК Счетчик,
	|	ПоказанийСчетчиков.ЛицевойСчет,
	|	ЕСТЬNULL(НачисленоПоСчетчикам.НачисленоСчетчик, 0) КАК СуммаПоСчетчикамРасч,
	|	ЕСТЬNULL(НачисленияПоНорме.НачисленоНорма, 0) КАК СуммаНормативРасч,
	|	ЕСТЬNULL(НачисленоПоСчетчикам.НачисленоГрупСчетчик, 0) КАК СуммаНачисленоГрупСчетчик
	|ИЗ
	|	ПоказанийСчетчиков КАК ПоказанийСчетчиков
	|		ЛЕВОЕ СОЕДИНЕНИЕ НачисленияСчетчиков КАК НачисленоПоСчетчикам
	|		ПО ПоказанийСчетчиков.Услуга = НачисленоПоСчетчикам.Услуга
	|			И ПоказанийСчетчиков.ЛицевойСчет = НачисленоПоСчетчикам.ЛицевойСчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ НачисленияНорм КАК НачисленияПоНорме
	|		ПО ПоказанийСчетчиков.Услуга = НачисленияПоНорме.Услуга
	|			И ПоказанийСчетчиков.ЛицевойСчет = НачисленияПоНорме.Лицевойсчет
	|ГДЕ
	|	НЕ ПоказанийСчетчиков.ЛицевойСчет В (&МассивИсключений)
	|	И ПоказанийСчетчиков.Услуга = &Услуга
	|	И ПоказанийСчетчиков.Счетчик = &Счетчик
	|ИТОГИ
	|	СУММА(СуммаПоСчетчикамРасч),
	|	СУММА(СуммаНормативРасч),
	|	СУММА(СуммаНачисленоГрупСчетчик)
	|ПО
	|	ОБЩИЕ";
	
	// БИТ_ЖКХ_01082013_изменен_текст_запроса
	// Добавлен расчет начислений с учетом ставки на услугу.	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРаспределения,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга.Приоритет КАК Приоритет,
	|	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет.Наименование КАК НаименованиеЛС,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Приоритет КАК ПриоритетСЧ,
	|	бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка КАК СтавкаСчетчика,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ИспользоватьСтавкуПоСчетчику,
	|	бит_СтавкиНаУслугиСрезПоследних.Тариф КАК ТарифСчетчика,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СчетчикСЗависимымиУслугами,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ОсновнаяУслуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ИспользоватьПравилоУменьшения,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчетаУменьшения,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРаспределенияУменьшения
	|ПОМЕСТИТЬ Счетчики
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных)
	|				И СпособРаспределения <> ЗНАЧЕНИЕ(Перечисление.бит_СпособыРаспределения.ПустаяСсылка)
	|				И ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)
	|				И Объект.Организация = &Организация) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГрупповыеСчетчики.СрезПоследних(&Дата, ) КАК бит_ГрупповыеСчетчикиСрезПоследних
	|		ПО бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик
	|			И бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга = бит_ГрупповыеСчетчикиСрезПоследних.Услуга
	|			И бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект = бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет.Здание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&Дата, СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)) КАК бит_СтавкиНаУслугиСрезПоследних
	|		ПО бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга = бит_СтавкиНаУслугиСрезПоследних.Услуга
	|			И бит_СчетчикиНаУслугахОбщийСрезПоследних.Поставщик = бит_СтавкиНаУслугиСрезПоследних.Поставщик
	|			И бит_СчетчикиНаУслугахОбщийСрезПоследних.ТипКвартиры = бит_СтавкиНаУслугиСрезПоследних.ТипКвартиры
	|			И бит_СчетчикиНаУслугахОбщийСрезПоследних.СтатусКвартиры = бит_СтавкиНаУслугиСрезПоследних.СтатусКвартиры
	|			И (ВЫБОР
	|				КОГДА бит_СчетчикиНаУслугахОбщийСрезПоследних.РежимПотребления = ЗНАЧЕНИЕ(Справочник.бит_РежимыПотребленияУслуг.ПустаяСсылка)
	|					ТОГДА бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга.ОсновнойРежимПотребления = бит_СтавкиНаУслугиСрезПоследних.РежимПотребления
	|				ИНАЧЕ бит_СчетчикиНаУслугахОбщийСрезПоследних.РежимПотребления = бит_СтавкиНаУслугиСрезПоследних.РежимПотребления
	|			КОНЕЦ)
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|	И бит_ГрупповыеСчетчикиСрезПоследних.Использовать
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счетчики.ЛицевойСчет,
	|	Счетчики.Услуга,
	|	Счетчики.Счетчик,
	|	Счетчики.СпособРаспределения,
	|	бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток КАК ОтПоказаний,
