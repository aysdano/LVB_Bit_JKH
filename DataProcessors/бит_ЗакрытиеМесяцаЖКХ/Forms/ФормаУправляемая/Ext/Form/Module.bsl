	ВыборкаДокумент = СтруктураРезультата.РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Выборка = ВыборкаДокумент.Выбрать();
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		тмпТаблицаУслуг.Очистить();
		
