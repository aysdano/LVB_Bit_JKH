	|	ИтоговаяТаблица.Долг - ЕСТЬNULL(ВР_Таб.Долг, 0) КАК ДолгДляНачисления,
	|	ИтоговаяТаблица.Период КАК Период,
	|	ИтоговаяТаблица.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	ИтоговаяТаблица.Переплата КАК Переплата,
	|	ИтоговаяТаблица.СуммаОстаток1 КАК СуммаОстаток1
	|ПОМЕСТИТЬ ВТ_Итоговая
	|ИЗ
	|	ИтоговаяТаблица КАК ИтоговаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВР_Таб КАК ВР_Таб
	|		ПО ИтоговаяТаблица.ДельтаТаблицаКоличествоМесяцев = ВР_Таб.КоличествоМесяцев
	|			И ИтоговаяТаблица.ЛицевойСчет = ВР_Таб.ЛицевойСчет
	|			И (ВР_Таб.Услуга = ИтоговаяТаблица.Услуга)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Итоговая.КоличествоМесяцев КАК КоличествоМесяцев,
	|	ВТ_Итоговая.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_Итоговая.Услуга КАК Услуга,
	|	ВТ_Итоговая.Долг КАК Долг,
	|	ВТ_Итоговая.ДолгДляНачисления КАК ДолгДляНачисления,
	|	РАЗНОСТЬДАТ(ВТ_Итоговая.Период, &ТекущаяДата, ДЕНЬ) КАК Период,
	|	ВТ_Итоговая.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	ВТ_Итоговая.Переплата КАК Переплата,
	|	ВТ_Итоговая.СуммаОстаток1 КАК СуммаОстаток1,
	|	ВТ_Итоговая.Период КАК Период1
	|ИЗ
	|	ВТ_Итоговая КАК ВТ_Итоговая
	|
	|УПОРЯДОЧИТЬ ПО
	|	ВТ_Итоговая.КоличествоМесяцев,
	|	Период УБЫВ"; 
	
	
	Возврат Запрос.Выполнить().Выгрузить();

	
КонецФункции

&НаСервере
Функция ЗаписатьОбъем(Док, Объем, Здание, Услуга)
	
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("Здание", Здание);
	ПараметрыОтбора.Вставить("Услуга", Услуга);
	СтрокиТЧ = Док.ОбъемыЖКУ.НайтиСтроки(ПараметрыОтбора);
	Если СтрокиТЧ.Количество() > 0 Тогда
		СтрокаТЧ = СтрокиТЧ[0];	
	Иначе 	
		СтрокаТЧ = Док.ОбъемыЖКУ.Добавить();
		СтрокаТЧ.Здание = Здание;
		СтрокаТЧ.Услуга = Услуга;
	КонецЕсли;
	СтрокаТЧ.ОбъемЖКУ = Объем;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСтрокуДокумента(Документ,Тариф,Вид,Здание,Организация,ПоставщикУслуг)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_РежимыПотребленияУслуг.Ссылка КАК Ссылка,
	|	бит_РежимыПотребленияУслуг.Код КАК Код
	|ИЗ
	|	Справочник.бит_РежимыПотребленияУслуг КАК бит_РежимыПотребленияУслуг
	|ГДЕ
	|	бит_РежимыПотребленияУслуг.Наименование = &Наименование
	|	И бит_РежимыПотребленияУслуг.ПометкаУдаления = Ложь";
	//Запрос.УстановитьПараметр("Наименование",Строка(Вид));
	Запрос.УстановитьПараметр("Наименование", Строка(Здание.Код));
	Результат = Запрос.Выполнить().Выбрать();
	Пока Результат.Следующий() Цикл
		Режим = Результат.Ссылка;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК Тип,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК Статус
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
	|ГДЕ
	|	бит_СведенияОКвартиреСрезПоследних.Квартира.Владелец = &Здание";
	Запрос.УстановитьПараметр("Здание", Здание);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Для Стр = 0 По РезультатЗапроса.Количество()-1 Цикл
		РЗап = РезультатЗапроса[Стр];
			СтрокаЕсть = Ложь;
		Если ИспользоватьОтборЗдание Тогда
			ЗапросСтав = Новый Запрос;
			ЗапросСтав.Текст = 
			"ВЫБРАТЬ 
			|	бит_УстановкаСтавокПоУслугамСтавкиНаУслуги.НомерСтроки КАК НомерСтроки
			|ИЗ
			|	Документ.бит_УстановкаСтавокПоУслугам.СтавкиНаУслуги КАК бит_УстановкаСтавокПоУслугамСтавкиНаУслуги
			|ГДЕ
			|	бит_УстановкаСтавокПоУслугамСтавкиНаУслуги.Ссылка = &Документ
			|	И бит_УстановкаСтавокПоУслугамСтавкиНаУслуги.ТипКвартиры = &Тип
			|	И бит_УстановкаСтавокПоУслугамСтавкиНаУслуги.СтатусКвартиры = &Статус
			|	И бит_УстановкаСтавокПоУслугамСтавкиНаУслуги.РежимПотребления = &Режим";
			ЗапросСтав.УстановитьПараметр("Документ", Документ.ссылка);
			ЗапросСтав.УстановитьПараметр("Тип", Рзап.Тип);
			ЗапросСтав.УстановитьПараметр("Режим", Режим);
			ЗапросСтав.УстановитьПараметр("Статус", Рзап.Статус);
			РезЗап = ЗапросСтав.Выполнить().Выбрать();  
			Пока РезЗап.Следующий() Цикл
				//РезЗап = РезультатЗапросаСтав[0];
				Если ВРег(СокрЛП(Строка(Режим))) = "НЕ НАЧИСЛЯТЬ" Тогда
					Тариф = 0;
				КонецЕсли;
				ДобавитьСтроку = Документ.СтавкиНаУслуги.Найти(РезЗап.НомерСтроки,"НомерСтроки"); 
				ДобавитьСтроку.ТипКвартиры             = Рзап.Тип; 
				ДобавитьСтроку.СтатусКвартиры  		   = Рзап.Статус;
				ДобавитьСтроку.РежимПотребления        = Режим;
				ДобавитьСтроку.Поставщик       		   = ПоставщикУслуг; 
				ДобавитьСтроку.ПлановаяСтавка          = Тариф;
				ДобавитьСтроку.ОсновнаяСтавка          = Тариф;
				ДобавитьСтроку.СверхнормативнаяСтавка  = Тариф;
				//ДобавитьСтроку.СпособРасчета 		   = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади;
				добавитьСтроку.Тариф                   = Тариф;
				добавитьСтроку.НормативПотребленияпоку = 1;
			//Иначе	
			//	ДобавитьСтроку = Документ.СтавкиНаУслуги.Добавить();
				СтрокаЕсть = Истина;	
			КонецЦикла;
		КонецЕсли;
		Если НЕ СтрокаЕсть Тогда	
			ДобавитьСтроку = Документ.СтавкиНаУслуги.Добавить();
		
		Если ВРег(СокрЛП(Строка(Режим))) = "НЕ НАЧИСЛЯТЬ" Тогда
			Тариф = 0;
		КонецЕсли;
		
		ДобавитьСтроку.ТипКвартиры             = Рзап.Тип; 
		ДобавитьСтроку.СтатусКвартиры  		   = Рзап.Статус;
		ДобавитьСтроку.РежимПотребления        = Режим;
		ДобавитьСтроку.Поставщик       		   = ПоставщикУслуг; 
		ДобавитьСтроку.ПлановаяСтавка          = Тариф;
		ДобавитьСтроку.ОсновнаяСтавка          = Тариф;
		ДобавитьСтроку.СверхнормативнаяСтавка  = Тариф;
		ДобавитьСтроку.СпособРасчета 		   = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади;
		добавитьСтроку.Тариф                   = Тариф;
		добавитьСтроку.НормативПотребленияпоку = 1;
			ДобавитьСтроку = Документ.СтавкиНаУслуги.Добавить();
		
		Если ВРег(СокрЛП(Строка(Режим))) = "НЕ НАЧИСЛЯТЬ" Тогда
			Тариф = 0;
		КонецЕсли;
		
		ДобавитьСтроку.ТипКвартиры             = Рзап.Тип; 
		ДобавитьСтроку.СтатусКвартиры  		   = Рзап.Статус;
		ДобавитьСтроку.РежимПотребления        = Режим;
		ДобавитьСтроку.Поставщик       		   = ПоставщикУслуг; 
		ДобавитьСтроку.ПлановаяСтавка          = Тариф;
		ДобавитьСтроку.ОсновнаяСтавка          = Тариф;
		ДобавитьСтроку.СверхнормативнаяСтавка  = Тариф;
		ДобавитьСтроку.СпособРасчета 		   = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади;
		добавитьСтроку.Тариф                   = Тариф;
		добавитьСтроку.НормативПотребленияпоку = 1;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаСервере
Функция НайтиОбъемы(Дата)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ОбъемыЖКУ.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.бит_ОбъемыЖКУ КАК бит_ОбъемыЖКУ
		|ГДЕ
		|	бит_ОбъемыЖКУ.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)";
	
	Запрос.УстановитьПараметр("Дата", Дата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
    	Возврат ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
	Иначе
		Возврат Документы.бит_ОбъемыЖКУ.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции
	
&НаСервере
Функция ДокСтавка(Дата,Организация,Услуга)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_УстановкаСтавокПоУслугам.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.бит_УстановкаСтавокПоУслугам КАК бит_УстановкаСтавокПоУслугам
	|ГДЕ
	|	бит_УстановкаСтавокПоУслугам.ПометкаУдаления = ЛОЖЬ
	|	И бит_УстановкаСтавокПоУслугам.Дата МЕЖДУ &Дата1 И &Дата2
	|	И бит_УстановкаСтавокПоУслугам.Услуга = &Услуга
	|	И бит_УстановкаСтавокПоУслугам.Организация = &Организация
	|
	|УПОРЯДОЧИТЬ ПО
	|	бит_УстановкаСтавокПоУслугам.Дата УБЫВ";
	Запрос.УстановитьПараметр("Услуга",Услуга);	
	Запрос.УстановитьПараметр("Дата1",НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("Дата2",КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Организация",Организация);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		Возврат РезультатЗапроса[0].Ссылка.ПолучитьОбъект();
	Иначе
		Возврат Неопределено
	КонецЕсли;
КонецФункции

&НаСервере
Функция НайтиДокументНПЛС(Дата,Здание,Организация);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачислениеПоЛицевымСчетам.Ссылка КАК Ссылка
	|ИЗ
	|	Документ.бит_НачислениеПоЛицевымСчетам КАК бит_НачислениеПоЛицевымСчетам
	|ГДЕ
	|	бит_НачислениеПоЛицевымСчетам.Здание = &Здание
	|	И бит_НачислениеПоЛицевымСчетам.ПометкаУдаления = ЛОЖЬ
	|	И бит_НачислениеПоЛицевымСчетам.Дата МЕЖДУ &Дата1 И &Дата2
	|	И бит_НачислениеПоЛицевымСчетам.Организация = &Организация";
	Запрос.УстановитьПараметр("Здание",Здание);	
	Запрос.УстановитьПараметр("Дата1",НачалоМесяца(Дата));
	Запрос.УстановитьПараметр("Организация",Организация);
	Запрос.УстановитьПараметр("Дата2",КонецМесяца(Дата));
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Ссылка.ПолучитьОбъект();
	Иначе 
		Возврат Неопределено;
	КонецЕсли;	
	
	
КонецФункции

