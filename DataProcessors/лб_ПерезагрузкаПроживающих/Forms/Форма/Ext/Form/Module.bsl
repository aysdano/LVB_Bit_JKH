&НаСервере
Процедура Тест_ВыверкаОтветственныхНаСервере()
	// Вставить содержимое обработчика.
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	Запрос.УстановитьПараметр("Ответственный",Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо);
	Запрос.УстановитьПараметр("НетЖильца",Справочники.бит_Проживающие.ПустаяСсылка());
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
		|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
		|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
		|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства
		|ПОМЕСТИТЬ ТекДанные
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ) КАК бит_ПроживающиеПоЛССрезПоследних
		|ГДЕ
		|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = &Ответственный
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТекДанные.ЛицевойСчет КАК ЛицевойСчет,
		|	ТекДанные.ФизЛицо КАК ФизЛицо
		|ПОМЕСТИТЬ ТекОтветственные
		|ИЗ
		|	ТекДанные КАК ТекДанные
		|ГДЕ
		|	ТекДанные.ДатаРегистрации <= &Дата
		|	И (ТекДанные.ДатаСнятияСРегистрации >= &Дата
		|			ИЛИ ТекДанные.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0))
		|	И ТекДанные.СтепеньРодства = &Ответственный
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	лб_Тест_ЛС.ЛС КАК ЛС,
		|	лб_Тест_ЛС.Ответственный КАК ТестОтветственный,
		|	ЕСТЬNULL(ТекОтветственные.ФизЛицо, &НетЖильца) КАК ТекОтветственный
		|ПОМЕСТИТЬ РасширДанные
		|ИЗ
		|	РегистрСведений.лб_Тест_ЛС КАК лб_Тест_ЛС
		|		ЛЕВОЕ СОЕДИНЕНИЕ ТекОтветственные КАК ТекОтветственные
		|		ПО лб_Тест_ЛС.ЛС = ТекОтветственные.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РасширДанные.ЛС КАК ЛС,
		|	РасширДанные.ТекОтветственный КАК ТекОтветственный,
		|	РасширДанные.ТестОтветственный КАК ТестОтветственный
		|ИЗ
		|	РасширДанные КАК РасширДанные
		|ГДЕ
		|	РасширДанные.ТестОтветственный <> РасширДанные.ТекОтветственный";
	
	Табл = Запрос.Выполнить().Выгрузить();
	
	НетОтветственного =0;
	НеверныйОтветственный = 0; 
	Для Каждого СтрокаТ из Табл цикл
		Если ЗначениеЗаполнено(СтрокаТ.ТекОтветственный) тогда
			НеверныйОтветственный = НеверныйОтветственный + 1
		иначе 
			НетОтветственного =	НетОтветственного +1;		
		КонецЕсли;	
	КонецЦикла;		
	
	
	Сообщить("Неверных Ответственных : " + Табл.Количество() +
	       " новых/неверных "+ НетОтветственного + " / "+ НеверныйОтветственный	);

	Табл.Свернуть("ЛС");
	Сообщить("Различных ЛС: " + Табл.Количество());
	
	
КонецПроцедуры

