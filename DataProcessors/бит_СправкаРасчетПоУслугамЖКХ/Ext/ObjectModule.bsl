Функция ПеренестиПереплатуНаПрошлыйПериод(СтрокаОплаты, ДолгСодРем, ПереплатаПоСодРем, ЭтоПерваяСтрока, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем, 
	ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодХВ,
	ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодВО, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодЭЭ,
	ГВ = 0, ХВ = 0, ВО = 0, ЭЭ = 0, СуммаОплатыПрошлыйПериод)
	
		//перенос суммы сод рем на другие услуги
		СуммаОплатыППСодРем = ДолгСодРем;     
		Переплата = ПереплатаПоСодРем - ДолгСодРем;    
		ПереплатаПоСодРем = ПереплатаПоСодРем - ДолгСодРем;
		СуммаГВ = 0;
		СуммаХВ = 0;
		СуммаВО = 0;
		СуммаЭЭ = 0;

		ДолгОДН = ГВ +ХВ + ВО + ЭЭ;
		Если ДолгОДН > 0 Тогда
				СуммаГВ = (ГВ / ДолгОДН * Переплата);
				СуммаХВ = (ХВ / ДолгОДН * Переплата);
				СуммаВО = (ВО / ДолгОДН * Переплата);
				СуммаЭЭ = (ЭЭ / ДолгОДН * Переплата);
				ПереплатаПоСодРем = ПереплатаПоСодРем - СуммаГВ-СуммаХВ-СуммаВО	-СуммаЭЭ;			
		КонецЕсли;
		
		Если ДолгСодРем < 0   Тогда 
			СуммаОплатыППСодРем = 0;
		КонецЕсли;  
			ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем) + Формат(СуммаОплатыППСодРем, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;		
			ДолгСодРем = ДолгСодРем - СуммаОплатыППСодРем;
			Если СуммаГВ<>0 Тогда	
				ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Формат(СуммаГВ, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
			КонецЕсли;
			Если СуммаХВ<>0 Тогда	
				ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодХВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодХВ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодХВ) + Формат(СуммаХВ, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
			КонецЕсли;
			Если СуммаВО<>0 Тогда	
				ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодВО = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодВО), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодВО) + Формат(СуммаВО, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
			КонецЕсли;
			Если СуммаЭЭ<>0 Тогда	
				ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодЭЭ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодЭЭ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодЭЭ) + Формат(СуммаЭЭ, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
			КонецЕсли;
		СуммаОплатыПрошлыйПериод = СуммаОплатыПрошлыйПериод + СуммаОплатыППСодРем + СуммаГВ+СуммаХВ+СуммаВО+СуммаЭЭ;    
		Возврат ПереплатаПоСодРем;
КонецФункции



Процедура ЗаполнениеОБластиУслугиОДНПоПрошломуПериоду(ЭтоУслугаСодРем, СтрокаОплаты, ДолгСодРем, СуммаСодРем, ЭтоПерваяСтрока, ОбластьТаблицаПараметрыОплатаТекПериодСодРем, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем, СуммаОплатыТекПериод, СуммаОплатыПрошлыйПериод, ЭтоБухСправка, БухПоПрошломуПериоду , ГВ = 0, ХВ = 0, ВО = 0, ЭЭ = 0)
	
	Если ДолгСодРем >=0 или (БухПоПрошломуПериоду и ЭтоБухСправка) Тогда
		ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем  = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем) + Формат(СуммаСодРем, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
		ОбластьТаблицаПараметрыОплатаТекПериодСодРем = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем), "", ОбластьТаблицаПараметрыОплатаТекПериодСодРем) + Символы.ПС;
		Если Не ЭтоБухСправка Тогда
			СуммаОплатыПрошлыйПериод = СуммаОплатыПрошлыйПериод + СуммаСодРем;
		КОнецЕсли;
	Иначе     
		
		//перенос суммы сод рем на другие услуги
		СуммаОплатыТП = 0;
		СуммаОплатыПП = СуммаСодРем; 
		Если  ЭтоУслугаСодРем Тогда
			Переплата = -ДолгСодРем; 
			ДолгОДН = 0;
			//++АнисимоваМВ_07.11.2023_1бит    Добавлена проверка на оплату за ОДН, чтобы не распределялась лишняя сумма на ОДН 
			Если ГВ>0  И ГВ - СтрокаОплаты.ГВОпл >0  Тогда 
				ДолгОДН = ГВ - СтрокаОплаты.ГВОпл ;	
			КонецЕсли;   
			Если ХВ>0  И ХВ - СтрокаОплаты.ХВОпл >0 Тогда 
				ДолгОДН = ДолгОДН + ХВ - СтрокаОплаты.ХВОпл;	
			КонецЕсли;
            Если ВО>0 И ВО - СтрокаОплаты.ВООпл >0  Тогда 
				ДолгОДН = ДолгОДН + ХВ - СтрокаОплаты.ХВОпл;	
			КонецЕсли;
            Если ЭЭ>0  И ЭЭ - СтрокаОплаты.ЭЛОпл >0 Тогда 
				ДолгОДН = ДолгОДН + ХВ - СтрокаОплаты.ХВОпл;	
			КонецЕсли;
			//ДолгОДН = ГВ +ХВ + ВО + ЭЭ;
			//--АнисимоваМВ_07.11.2023_1бит
			
			//ДолгОДН = СальдоОДН[0].ГВ +СальдоОДН[0].ХВ + СальдоОДН[0].ВО + СальдоОДН[0].ЭЭ;
			//Если Переплата >= ДолгОДН Тогда
			//	Переплата = Переплата - ДолгОДН;
			//	Делитель = ДолгОДН;
			//Иначе
			//	Делитель = Переплата;
			//	Переплата = 0;
			//КонецЕсли;     
			СуммаГВ = 0 ;     
			СуммаXВ = 0 ;
			СуммаВО = 0 ;
			СуммаЭЭ = 0 ;
			Если ДолгОДН > 0 Тогда   
				Если ГВ > 0 И ГВ - СтрокаОплаты.ГВОпл >0 Тогда
					СуммаГВ = (ГВ- СтрокаОплаты.ГВОпл)  / ДолгОДН * Переплата;   
				КонецЕсли;
				Если ХВ > 0 И ХВ - СтрокаОплаты.ХВОпл >0 Тогда
					СуммаXВ = (ХВ - СтрокаОплаты.ХВОпл) / ДолгОДН * Переплата;   
				КонецЕсли;
				Если ВО > 0 И ВО - СтрокаОплаты.ВООпл >0 Тогда
					СуммаВО = (ВО - СтрокаОплаты.ВООпл) / ДолгОДН * Переплата;   
				КонецЕсли;
				Если ЭЭ > 0 И ЭЭ - СтрокаОплаты.ЭЛОпл >0 Тогда
					СуммаЭЭ = (ЭЭ - СтрокаОплаты.ЭЛОпл) / ДолгОДН * Переплата;   
				КонецЕсли;
				
				//СуммаХВ = ?(ХВ>0,(ХВ / ДолгОДН * Переплата),0);
				//СуммаВО = ?(ВО>0,(ВО / ДолгОДН * Переплата),0);
				//СуммаЭЭ = ?(ЭЭ>0,(ЭЭ / ДолгОДН * Переплата),0);   

				//++АнисимоваМВ_бит__07.11_2023 чтобы переплата после распределения на ОДН переносилась на Сод рем тек периода
				СуммаГВ =  ?(ГВ > 0 И ГВ - СуммаГВ < 0, (ГВ- СтрокаОплаты.ГВОпл), СуммаГВ);
				СуммаХВ = ?(ХВ > 0 И ХВ - СуммаXВ < 0, (ХВ - СтрокаОплаты.ХВОпл), СуммаXВ);
				СуммаВО = ?(ВО > 0 И ВО -СуммаВО < 0,  (ВО - СтрокаОплаты.ВООпл), СуммаВО);
				СуммаЭЭ = ?(ЭЭ > 0 И ЭЭ - СуммаЭЭ < 0, (ЭЭ - СтрокаОплаты.ЭЛОпл), СуммаЭЭ);  
				//--АнисимоваМВ_бит__07.11_2023    
				
				СтрокаОплаты.ГВОпл = ?(ГВ>0,СуммаГВ + СтрокаОплаты.ГВОпл, СтрокаОплаты.ГВОпл);
				СтрокаОплаты.ХВОпл = ?(ХВ>0,СуммаХВ + СтрокаОплаты.ХВОпл, СтрокаОплаты.ХВОпл);
				СтрокаОплаты.ВООпл = ?(ВО>0,СуммаВО + СтрокаОплаты.ВООпл, СтрокаОплаты.ВООпл);
				СтрокаОплаты.ЭЛОпл = ?(ЭЭ>0,СуммаЭЭ + СтрокаОплаты.ЭЛОпл, СтрокаОплаты.ЭЛОпл);   
				
				//++АнисимоваМВ_бит__07.11_2023 чтобы переплата после распределения на ОДН переносилась на Сод рем тек периода
				//СтрокаОплаты.ГВОпл = ?(ГВ > 0 И ГВ - СтрокаОплаты.ГВОпл < 0, ГВ, СтрокаОплаты.ГВОпл);
				//СтрокаОплаты.ХВОпл = ?(ХВ > 0 И ХВ - СтрокаОплаты.ХВОпл < 0, ХВ, СтрокаОплаты.ХВОпл);
				//СтрокаОплаты.ВООпл = ?(ВО > 0 И ВО - СтрокаОплаты.ВООпл < 0, ВО, СтрокаОплаты.ВООпл);
				//СтрокаОплаты.ЭЛОпл = ?(ЭЭ > 0 И ЭЭ - СтрокаОплаты.ЭЛОпл < 0, ЭЭ,СтрокаОплаты.ЭЛОпл);   
				//--АнисимоваМВ_бит__07.11_2023    
				
				СуммаОплатыТП = 0;      
				 //++bit_AnisimovaMV_20.10.2023     
				 Если ДолгСодРем<0 Тогда
				     СуммаОплатыТП =(-ДолгСодРем) - СуммаГВ -СуммаХВ -СуммаВО -СуммаЭЭ;// Анисимова СуммаСодРем;
				 	 СуммаОплатыПП =СуммаСодРем + ДолгСодРем;     				 
				 Иначе
				 
				 	СуммаОплатыПП = СуммаСодРем + ДолгСодРем;
				 
				 КонецЕсли;
				 //СуммаОплатыПП = СуммаСодРем + ДолгСодРем;
				 //--bit_AnisimovaMV_20.10.2023
				
			Иначе
				СуммаОплатыТП = Переплата;
				СуммаОплатыПП = СуммаСодРем + ДолгСодРем
			КонецЕсли;
		КонецЕсли;
		Если ДолгСодРем < 0 И НЕ ЭтоУслугаСодРем Тогда 
			
			СуммаОплатыПП = ?(СуммаСодРем + ДолгСодРем >=0,СуммаСодРем + ДолгСодРем,0);    
			СуммаОплатыТП = СуммаСодРем - СуммаОплатыПП;
		КонецЕсли;
		
		ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодСодРем) + Формат(СуммаОплатыПП, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
		ОбластьТаблицаПараметрыОплатаТекПериодСодРем = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодСодРем), "", ОбластьТаблицаПараметрыОплатаТекПериодСодРем) + Формат(СуммаОплатыТП, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
		СуммаОплатыТекПериод = СуммаОплатыТекПериод + СуммаОплатыТП;
		СуммаОплатыПрошлыйПериод = СуммаОплатыПрошлыйПериод + (СуммаОплатыПП);
		ДолгСодРем = ДолгСодРем + СуммаСодРем - СуммаОплатыПП;
	КонецЕсли;
КонецПроцедуры

Функция ПериодСтрокой(ПериодОплаты)
	
	Месяц = Месяц(ПериодОплаты);
	Год = Формат(Год(ПериодОплаты),"ЧГ=") + "г.";
	СтрокаПериода = "";
	Если Месяц = 1 Тогда
		СтрокаПериода = "Январь ";
	ИначеЕсли Месяц = 2 Тогда
		СтрокаПериода = "Февраль ";
	ИначеЕсли Месяц = 3 Тогда
		СтрокаПериода = "Март ";
	ИначеЕсли Месяц = 4 Тогда
		СтрокаПериода = "Апрель ";
	ИначеЕсли Месяц = 5 Тогда
		СтрокаПериода = "Май ";
	ИначеЕсли Месяц = 6 Тогда
		СтрокаПериода = "Июнь ";
	ИначеЕсли Месяц = 7 Тогда
		СтрокаПериода = "Июль ";
	ИначеЕсли Месяц = 8 Тогда
		СтрокаПериода = "Август ";
	ИначеЕсли Месяц = 9 Тогда
		СтрокаПериода = "Сентябрь ";
	ИначеЕсли Месяц = 10 Тогда
		СтрокаПериода = "Октябрь ";
	ИначеЕсли Месяц = 11 Тогда
		СтрокаПериода = "Ноябрь ";
	Иначе
		СтрокаПериода = "Декабрь ";
	КонецЕсли;
	
	Возврат СтрокаПериода + Год;	
	
КонецФункции

Процедура ЗаполнитьНачисленияПоУслуге(ОбластьТаблица, ДанныеПоЛС, ДанныеРазовые, СтрокаОплаты, Услуга, Площадь, СуммаПерерасчеты, СуммаНачислено, УслугаНач, Коэфф); 
	
	СтрокаРазовые = НайтиСтрокуРазовые(ДанныеРазовые, ГруппаУслуг(Услуга));
	ОбластьТаблица.Параметры.Перерасчеты = ?(ЗначениеЗаполнено(СтрокаРазовые), Формат(СтрокаРазовые.СуммаОборот * Коэфф, "ЧДЦ=2; ЧН="), 0);
	СуммаПерерасчеты = СуммаПерерасчеты + ?(ЗначениеЗаполнено(СтрокаРазовые), СтрокаРазовые.СуммаОборот * Коэфф, 0);
	
	Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000003") Тогда//кап ремм
		ОбластьТаблица.Параметры.Начислено =  Формат(Окр((СтрокаОплаты.МинВзносНач + СтрокаОплаты.ДопВзносНач + СтрокаОплаты.РФКРНач) * Коэфф, 2), "ЧДЦ=2");
		СуммаНачислено = СуммаНачислено + (СтрокаОплаты.МинВзносНач + СтрокаОплаты.ДопВзносНач + СтрокаОплаты.РФКРНач)* Коэфф;
		ОбластьТаблица.Параметры.ЕдИзм = "м2";
		ОбластьТаблица.Параметры.Тариф = Окр(ДанныеПоЛС.ТарифМинВзнос , 4); 
		ОбластьТаблица.Параметры.Объем =  Формат(Окр(Площадь * Коэфф, 4), "ЧДЦ=2");
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000002") Тогда //антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ПрофиНач) * Коэфф, 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "точка";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  1;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Домофон") Тогда//антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ДомофонНач) , 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "точка";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  1;		
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Газоснабжение") Тогда//антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ГазоснабжениеНач) , 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "м3";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  1;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Доп.услуга") Тогда//антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ДопНач) , 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  0;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Орг.ФКР") Тогда//антена
		ОбластьТаблица.Параметры.Начислено =  Окр((СтрокаОплаты.ОргФКРНач) , 2);
		СуммаНачислено = СуммаНачислено + ОбластьТаблица.Параметры.Начислено;
		ОбластьТаблица.Параметры.ЕдИзм = "";
		ОбластьТаблица.Параметры.Тариф = 0;
		ОбластьТаблица.Параметры.Объем =  0;
	Иначе
		Возврат;
	КонецЕсли;
	
	УслугаНач = ОбластьТаблица.Параметры.Начислено;
	
КонецПроцедуры

Функция ПолучитьСуммуОплатыПоуслуге(СтрокаОплаты, Услуга)
	
	Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000003") Тогда//кап ремм
		Возврат (СтрокаОплаты.МинВзносОпл + СтрокаОплаты.ДопВзносОпл + СтрокаОплаты.РФКРОпл);
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000002") Тогда//антена
		Возврат СтрокаОплаты.ПрофиОпл;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Домофон") Тогда//антена
		Возврат СтрокаОплаты.ДомофонОпл;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Газоснабжение") Тогда//антена
		Возврат СтрокаОплаты.ГазоснабжениеОпл;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Доп.услуга") Тогда//антена
		Возврат СтрокаОплаты.ДопОпл;
	ИначеЕсли Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоНаименованию("Орг.ФКР") Тогда//антена
		Возврат СтрокаОплаты.ОргФКРОпл;
	Иначе
		Возврат 0;
	КонецЕсли;
	
КонецФункции

Функция ПолучитьНачальноеСальдо(ЛС, Период)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = &ГВ
		|				ТОГДА бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ГВ,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = &ХВ
		|				ТОГДА бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ХВ,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = &ВО
		|				ТОГДА бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ВО,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = &ЭЭ
		|				ТОГДА бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ЭЭ
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&Период, ЛицевойСчет = &ЛС) КАК бит_НачисленияПоУслугамЖКХОстатки";
	ВО     	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000015");
	ГВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000011");
	ХВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000012");
	ЭЭ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");
	
	Запрос.УстановитьПараметр("ВО", ВО);
	Запрос.УстановитьПараметр("ГВ", ГВ);
	Запрос.УстановитьПараметр("ХВ", ХВ);
	Запрос.УстановитьПараметр("ЭЭ", ЭЭ);
	
	Запрос.УстановитьПараметр("ЛС", ЛС);
	Запрос.УстановитьПараметр("Период", Период);
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	
	ВОзврат РезультатЗапроса;
		
КонецФункции

Функция НайтиСтрокуРазовые(ДанныеРазовые, МассивУслуг)
	
	Если не ТипЗнч(МассивУслуг) = Тип("Массив") Тогда
		Возврат  ДанныеРазовые.Найти(МассивУслуг, "УслугаЖКХ"	);
	КонецЕсли;
	
	Для каждого Услуга Из МассивУслуг Цикл
	
		СтрокаРазовые = ДанныеРазовые.Найти(Услуга, "УслугаЖКХ"	);
		Если ЗначениеЗаполнено(СтрокаРазовые) Тогда
			Возврат СтрокаРазовые;
		КонецЕсли;
	
	КонецЦикла;
	
КонецФункции