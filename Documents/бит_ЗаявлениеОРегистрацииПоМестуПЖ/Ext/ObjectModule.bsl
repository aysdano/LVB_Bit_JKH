#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ЭкспортныеПроцедурыИФункции

#Если Клиент Тогда
	
// Функция вызывает форму печати табличного документа с печатной формой.
// Инвентаризационной описи основных средств.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Неопределено.
//
Функция ПечатьЗОРПМЖ() Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	// Добавление ФИО ответственного за регистрацию из регистра.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	ВЫБОР
	|		КОГДА бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения ЕСТЬ NULL 
	|				ИЛИ бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ &Момент < бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ РАЗНОСТЬДАТ(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, &Момент, ГОД)
	|	КОНЕЦ КАК РегЛицоВозраст,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид КАК ВидДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачи,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКодПодразделения,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументКодПодразделения КАК ДокументКодПодразделенияПред,
	|	бит_СвидетельствоОРегистрацииПоМестуПребывания.Дата КАК ДатаСвидетельства,
	|	бит_СвидетельствоОРегистрацииПоМестуПребывания.Номер КАК НомерСвидетельства,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПаспортнаяСлужба КАК ПаспортнаяСлужба,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия КАК ФамилияПред,
	|	бит_ФИОПроживающихСрезПоследних.Имя КАК ИмяПред,
	|	бит_ФИОПроживающихСрезПоследних.Отчество КАК ОтчествоПред
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК ФИОФизЛицСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = ПаспортныеДанныеФизЛицСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_СвидетельствоОРегистрацииПоМестуПребывания КАК бит_СвидетельствоОРегистрацииПоМестуПребывания
	|		ПО (бит_СвидетельствоОРегистрацииПоМестуПребывания.ДокументОснование = бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";

	Макет         = ПолучитьМакет("ЗОРПМЖ_New");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	АдресПрибытия = ПолучитьКИ(Выборка.РегистрируемоеЛицо,Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Проживающие);
	СтрокаАдресПрибытия = АдресПрибытия.Найти(Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытия,"Вид");
	
	АдресПрибытия_1 = "";
	АдресПрибытия_2 = "";
	
	Если ЗначениеЗаполнено(СтрокаАдресПрибытия) Тогда
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаАдресПрибытия.Представление, 80, АдресПрибытия_1, АдресПрибытия_2);
		ШапкаОбласть.Параметры.АдресПрибытия = АдресПрибытия_1;
	КонецЕсли; 
	
	ПринятоеРешение_1 = "";
	ПринятоеРешение_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ПринятоеРешение, 80, ПринятоеРешение_1, ПринятоеРешение_2);
	ШапкаОбласть.Параметры.ПринятоеРешение = ПринятоеРешение_1;
	
	ДокументОснование_1 = "";
	ДокументОснование_2 = "";
	
	Если ЗначениеЗаполнено(ДокументОснование) Тогда
		ДокОснованиеСтр = Строка(ДокументОснование) + ?(ЗначениеЗаполнено(ДокументОснование.НомерДокумента)," №"+ Строка(ДокументОснование.НомерДокумента),"")
		+ ?(ЗначениеЗаполнено(ДокументОснование.ДатаДокумента)," от "+ Формат(ДокументОснование.ДатаДокумента,"ДФ='dd.MM.yyyy ""г.""'"),"")
		+ ?(ЗначениеЗаполнено(ДокументОснование.ОрганизацияВыдавшаяДокумент)," , выдан "+ Строка(ДокументОснование.ОрганизацияВыдавшаяДокумент.НаименованиеПолное), "");
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ДокОснованиеСтр, 95, ДокументОснование_1,ДокументОснование_2);
	КонецЕсли;
	
	ШапкаОбласть.Параметры.ДокументОснование1 = ДокументОснование_1;
	ШапкаОбласть.Параметры.ДокументОснование2 = ДокументОснование_2;
	
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	Если ЗначениеЗаполнено(Выборка.ФамилияПред) Тогда
		Ответственный = Строка(Выборка.ФамилияПред)+" "+ Строка(Выборка.ИмяПред)+" "+Строка(Выборка.ОтчествоПред);
	Иначе
		Ответственный = Строка(Выборка.Ответственный) ;
	КонецЕсли;
	ШапкаОбласть.Параметры.Ответственный = Ответственный;
	
	Если ЗначениеЗаполнено(Выборка.Фамилия) Тогда
		ФизЛицо = Строка(Выборка.Фамилия)+" "+ Строка(Выборка.Имя)+" "+Строка(Выборка.Отчество);
	Иначе
		ФизЛицо = Строка(Выборка.РегистрируемоеЛицо) ;
	КонецЕсли;
	ФизЛицо_Склон = "";
	ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФизЛицо,2,Выборка.РегистрируемоеЛицо.Пол,ФизЛицо_Склон);
	Если ИсходСклонения Тогда
		ФизЛицо = ФизЛицо_Склон;
	КонецЕсли;	
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.ДатаРождения) Тогда
		ШапкаОбласть.Параметры.ФизЛицо =  ФизЛицо +", "+Строка(Формат (Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ='dd.MM.yyyy ""г.р.""'"));
	Иначе
		ШапкаОбласть.Параметры.ФизЛицо =  ФизЛицо;
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.ЧислоРег  = Формат(Выборка.ДатаРегистрации,"ДФ=dd");
	ШапкаОбласть.Параметры.МесяцРег  = Формат(Выборка.ДатаРегистрации,"ДФ=MM");
	ШапкаОбласть.Параметры.ГодРег    = Формат(Выборка.ДатаРегистрации,"ДФ=yy");
	
	ШапкаОбласть.Параметры.ЧислоСнят = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=dd");
	ШапкаОбласть.Параметры.МесяцСнят = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=MM");
	ШапкаОбласть.Параметры.ГодСнят   = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=yy");
	
	ШапкаОбласть.Параметры.ЧислоТек = Формат(Дата,"ДФ=dd");
	ШапкаОбласть.Параметры.МесяцТек = Формат(Дата,"ДФ=MM");
	ШапкаОбласть.Параметры.ГодТек   = Формат(Дата,"ДФ=yy");
	
	ШапкаОбласть.Параметры.ЧислоВыдачи = Формат(Выборка.ДатаВыдачи ,"ДФ=dd");
	ШапкаОбласть.Параметры.МесяцВыдачи = Формат(Выборка.ДатаВыдачи ,"ДФ=MM");
	ШапкаОбласть.Параметры.ГодВыдачи   = Формат(Выборка.ДатаВыдачи ,"ДФ=yyyy");
	
	ШапкаОбласть.Параметры.ЧислоВыдачиПред = Формат(Выборка.ДатаВыдачиПред ,"ДФ=dd");
	ШапкаОбласть.Параметры.МесяцВыдачиПред = Формат(Выборка.ДатаВыдачиПред ,"ДФ=MM");
	ШапкаОбласть.Параметры.ГодВыдачиПред   = Формат(Выборка.ДатаВыдачиПред ,"ДФ=yyyy");
	Если НЕ Выборка.РегЛицоВозраст = Неопределено
		И  Выборка.РегЛицоВозраст <= 14 Тогда
		
		ЗаконныйПредставитель_1 = "";
		ЗаконныйПредставитель_2 = "";
		
		Если ФизическиеЛица.Количество()> 0 Тогда
			ТабЗнач = ФизическиеЛица.Выгрузить();
			ЗаконныйПредставитель = Строка(ТабЗнач[0].ФизическоеЛицо);
			СтепеньРодстваЗП      = Строка(ТабЗнач[0].СтепеньРодства);
			ПаспортныеДанныеЗП = бит_ПаспортныйСтолСервер.ПолучитьПаспортныеДанныеСтрокой(ТабЗнач[0].ФизическоеЛицо, Дата, Ложь);
			ЗаконныйПредставитель = ?(ЗначениеЗаполнено(СтепеньРодстваЗП),СтепеньРодстваЗП + ", ","") + ЗаконныйПредставитель;
			Если ЗначениеЗаполнено(ПаспортныеДанныеЗП) Тогда
				ЗаконныйПредставитель = ЗаконныйПредставитель + ", " + ПаспортныеДанныеЗП;
			КонецЕсли;
			
		Иначе
			
			ЗаконныйПредставитель = ?(ЗначениеЗаполнено(СтепеньРодства),НРег(Строка(СтепеньРодства)) + ", ","")
			+ Ответственный 
			+ ?(ЗначениеЗаполнено(Выборка.ВидДокументаПред),", " + Строка(Выборка.ВидДокументаПред), "") 
			+?(ЗначениеЗаполнено(Выборка.СерияДокументаПред), ", сер. "+Строка(Выборка.СерияДокументаПред), "")
			+?(ЗначениеЗаполнено(Выборка.НомерДокументаПред), ", № "+ Строка(Выборка.НомерДокументаПред), "")
			+?(ЗначениеЗаполнено(Выборка.ВыданДокументПред),", выдан " + Строка(Выборка.ВыданДокументПред),"")
			+?(ЗначениеЗаполнено(Выборка.ДокументКодПодразделенияПред), ", код орг: "+ Строка(Выборка.ДокументКодПодразделенияПред),"")
			+?(ЗначениеЗаполнено(Выборка.ДатаВыдачиПред), ", дата выдачи: "+ Формат(Выборка.ДатаВыдачиПред,"ДФ='dd.MM.yyyy ""г.""'"), "");
		КонецЕсли;	
		
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ЗаконныйПредставитель, 65, ЗаконныйПредставитель_1 , ЗаконныйПредставитель_2 );
		ШапкаОбласть.Параметры.ЗаконныйПредставитель1 = ЗаконныйПредставитель_1;
		ШапкаОбласть.Параметры.ЗаконныйПредставитель2 = ЗаконныйПредставитель_2;
	КонецЕсли; 
	
	НаборЗаписей = НЕОПРЕДЕЛЕНО;
	бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
	ИскомаяСтрока = Неопределено;
	Для каждого СтрокаНабор Из НаборЗаписей  Цикл
		Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
			И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
			Тогда 
			ИскомаяСтрока = СтрокаНабор;
		КонецЕсли;	
		
	КонецЦикла;
	
	ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
	
	Если ЗначениеЗаполнено(ЗаписьАдрес) Тогда
		СтруктураАдресРегистрации = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
		Если НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
			НасПунктАдрес = ?(ЗначениеЗаполнено(СтруктураАдресРегистрации.НаселенныйПункт),"нас.п. "+СтруктураАдресРегистрации.НаселенныйПункт+", ","")
			+ ?(ЗначениеЗаполнено(СтруктураАдресРегистрации.Город),"г. "+СтруктураАдресРегистрации.Город+", ","")
			+ ?(ЗначениеЗаполнено(СтруктураАдресРегистрации.Район),"р-н "+СтруктураАдресРегистрации.Район+", ","")
			+ ?(ЗначениеЗаполнено(СтруктураАдресРегистрации.Регион),"рег. "+СтруктураАдресРегистрации.Регион,"");
			
			ШапкаОбласть.Параметры.НаселенныйПунктРег = НасПунктАдрес; 
			ШапкаОбласть.Параметры.УлицаРег 	= СтруктураАдресРегистрации.Улица;
			ШапкаОбласть.Параметры.ДомРег		= СтруктураАдресРегистрации.Дом;
			ШапкаОбласть.Параметры.КорпусРег 	= СтруктураАдресРегистрации.Корпус;
			
		КонецЕсли; 
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.НомерСвидетельства) Тогда
		
		ШапкаОбласть.Параметры.НомерСвидетельства = Выборка.НомерСвидетельства;	
		
	КонецЕсли; 
	
	ОрганУчета_1 = "";
	ОрганУчета_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ПаспортнаяСлужба, 60, ОрганУчета_1 , ОрганУчета_2 );
	ШапкаОбласть.Параметры.ОрганУчета1 = ОрганУчета_1;
	ШапкаОбласть.Параметры.ОрганУчета2 = ОрганУчета_2;
	
	ДолжностноеЛицоОрганизации = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Организация, ДолжностноеЛицо,Дата);

	ШапкаОбласть.Параметры.ДолжностноеЛицоОрганизации = ДолжностноеЛицоОрганизации;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой сличительной ведомости
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьСОРПМЖ() Экспорт
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид КАК ВидДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКодПодразделения,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК ФИОФизЛицСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = ПаспортныеДанныеФизЛицСрезПоследних1.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = ПолучитьМакет("СОРПМЖ");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	АдресПрибытия = бит_ОбщегоНазначения.ПолучитьАдресИзКонтактнойИнформацииФизЛица(Выборка.РегистрируемоеЛицо, "Юридический");
	
	АдресПрибытия_1 = "";
	АдресПрибытия_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресПрибытия, 75, АдресПрибытия_1, АдресПрибытия_2);
	ШапкаОбласть.Параметры.АдресПрибытия_1 = АдресПрибытия_1;
	ШапкаОбласть.Параметры.АдресПрибытия_2 = АдресПрибытия_2;
	
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	Если ЗначениеЗаполнено(Выборка.Фамилия) Тогда
		
		ФизЛицо = Строка(Выборка.Фамилия)+" "+ Строка(Выборка.Имя)+" "+Строка(Выборка.Отчество);
		
	Иначе
		
		ФизЛицо = Строка(Выборка.РегистрируемоеЛицо);
		
	КонецЕсли; 
	Если ЗначениеЗаполнено(РегистрируемоеЛицо.ДатаРождения) Тогда
		
		ШапкаОбласть.Параметры.ФизЛицо = ФизЛицо + ", "+Строка(Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ='yyyy ""г.""'"));
		
	Иначе
		
		ШапкаОбласть.Параметры.ФизЛицо = ФизЛицо;
		
	КонецЕсли; 

	ШапкаОбласть.Параметры.ЧислоРег  = Формат(Выборка.ДатаРегистрации,"ДФ=dd");
	ШапкаОбласть.Параметры.МесяцРег  = Формат(Выборка.ДатаРегистрации,"ДФ=MMММ");
	ШапкаОбласть.Параметры.ГодРег    = Формат(Выборка.ДатаРегистрации,"ДФ=yy");
	
	ШапкаОбласть.Параметры.ДатаОкончанияРегистрации	 = Формат(Выборка.ДатаСнятияСРегистрации,"ДФ=dd.MM.yyyy");
	
	Если ЗначениеЗаполнено(Выборка.ДомРег) Тогда
		
		ШапкаОбласть.Параметры.ОрганУчета = Выборка.ДомРег.ПаспортнаяСлужба;				
		
	КонецЕсли;
	ТабДокумент.Вывести(ШапкаОбласть);
	
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой приказа о проведении.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьКР() Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = ПолучитьМакет("КР_New");
	Шапка1Область  = Макет.ПолучитьОбласть("Шапка1");
	СтрокаПаспорт  = Макет.ПолучитьОбласть("СтрокаПаспорт");
	Шапка2Область  = Макет.ПолучитьОбласть("Шапка2");
	
	
	ТаблицаПаспорт = ПолучитьТаблицуДокументов();
	СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.МестоРождения);
	Шапка1Область.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
	Шапка1Область.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
	Шапка1Область.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
	Шапка1Область.Параметры.НаселенныйПунктРожд = СтруктураМестоРождения.Село;
	
	СтруктураАдресПрибытия = бит_ПаспортныйСтолСервер.ПолнаяКонтактнаяИнформацияПоОбъекту(РегистрируемоеЛицо,Перечисления.бит_ТипыКонтактнойИнформации.Адрес,Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытия);
	
	Если ТипЗнч(СтруктураАдресПрибытия) =  Тип("Структура") Тогда
		
		АдресПрибытия = ?(ЗначениеЗаполнено(СтруктураАдресПрибытия.НасПункт),"нас.п. " + СтруктураАдресПрибытия.НасПункт + ", " ,"")
		+ ?(ЗначениеЗаполнено(СтруктураАдресПрибытия.Город),"г. " + СтруктураАдресПрибытия.Город + ", ","")
		+ ?(ЗначениеЗаполнено(СтруктураАдресПрибытия.Район),"р-н " + СтруктураАдресПрибытия.Район + ", ","")
		+ ?(ЗначениеЗаполнено(СтруктураАдресПрибытия.Регион),"рег. " + СтруктураАдресПрибытия.Регион,"");
		Шапка1Область.Параметры.НаселенныйПунктПриб = АдресПрибытия;
		
		Шапка1Область.Параметры.УлицаПриб 	= СтруктураАдресПрибытия.Улица;
		Шапка1Область.Параметры.ДомПриб 	= СтруктураАдресПрибытия.Дом;
		Шапка1Область.Параметры.КорпусПриб 	= СтруктураАдресПрибытия.Корпус;
		Шапка1Область.Параметры.КвартираПриб = СтруктураАдресПрибытия.Квартира;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ДатаРождения) Тогда 
		
		Шапка1Область.Параметры.ДеньРожд  	= Формат(Выборка.ДатаРождения,"ДФ=dd");
		ДатаМесяц							= Формат(Выборка.ДатаРождения,"ДФ='дд.MMMM'");
		Шапка1Область.Параметры.МесяцРожд 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
		Шапка1Область.Параметры.ГодРожд   	= Формат(Выборка.ДатаРождения,"ДФ=yyyy");
		
	КонецЕсли;
	
	Шапка1Область.Параметры.Заполнить(Выборка);
	
	Шапка1Область.Параметры.ДеньПриб  	= Формат(ДатаРегистрации,"ДФ=dd");
	ДатаМесяц							= Формат(ДатаРегистрации,"ДФ='дд.MMMM'");
	Шапка1Область.Параметры.МесяцПриб 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	Шапка1Область.Параметры.ГодПриб   	= Формат(ДатаРегистрации,"ДФ=yyyy");
	
	ТабДокумент.Вывести(Шапка1Область);
	
	НаборЗаписей = НЕОПРЕДЕЛЕНО;
	бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
	ВыборкаПочтАдр = Неопределено;
	Для каждого СтрокаНабор Из НаборЗаписей  Цикл
		Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
			И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
			Тогда 
			ВыборкаПочтАдр = СтрокаНабор;
		КонецЕсли;	
	КонецЦикла;
	
	ПочтовыйАдресСтрока = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ВыборкаПочтАдр);
	СтруктураПочтовыйАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ПочтовыйАдресСтрока);
	Если СтруктураПочтовыйАдрес <> Неопределено И НЕ СтруктураПочтовыйАдрес.Свойство("ЗаПределамиРФ") Тогда
		Если ЗначениеЗаполнено(СтруктураПочтовыйАдрес.Город) Тогда
			Шапка2Область.Параметры.НаселенныйПунктРег = СтруктураПочтовыйАдрес.Город ;
			
		ИначеЕсли ЗначениеЗаполнено(СтруктураПочтовыйАдрес.НаселенныйПункт) Тогда
			Шапка2Область.Параметры.НаселенныйПунктРег = СтруктураПочтовыйАдрес.НаселенныйПункт;
			
		КонецЕсли;
		
		Шапка2Область.Параметры.УлицаРег 	= СтруктураАдресПрибытия.Улица;
		Шапка2Область.Параметры.ДомРег 		= СтруктураАдресПрибытия.Дом;
		Шапка2Область.Параметры.КорпусРег 	= СтруктураАдресПрибытия.Корпус;
		
	КонецЕсли; 
	
	
	Для каждого Строка Из ТаблицаПаспорт Цикл
		
		СтрокаПаспорт.Параметры.Заполнить(Строка);
		Если ЗначениеЗаполнено(Строка.ВидДокумента) Тогда
			СтрокаПаспорт.Параметры.ВидДокумента = Строка.ВидДокумента.КодПФР;
		КонецЕсли; 
		Если ЗначениеЗаполнено(Строка.ВыданДокумент) Тогда
			СтрокаПаспорт.Параметры.ДатаВыдачиДок = ",  выд. " + Формат(Строка.ДатаВыдачиДокумента,"ДЛФ=Д")+ "г.";
		КонецЕсли; 
		ТабДокумент.Вывести(СтрокаПаспорт)
		
	КонецЦикла; 
	
	КолПараметров = СтрокаПаспорт.Параметры.Количество();
	НомерТекПараметра = 0;
	
	Пока КолПараметров <> 0 Цикл
		
		СтрокаПаспорт.Параметры.Установить(НомерТекПараметра,"");
		КолПараметров = КолПараметров - 1;
		НомерТекПараметра = НомерТекПараметра + 1;
		
	КонецЦикла; 
	
	КоличествоСтрокНаВывод = 4 - ТаблицаПаспорт.Количество();
	
	Если КоличествоСтрокНаВывод > 0 Тогда
		Пока КоличествоСтрокНаВывод <> 0  Цикл
			КоличествоСтрокНаВывод = КоличествоСтрокНаВывод - 1;
			ТабДокумент.Вывести(СтрокаПаспорт);
		КонецЦикла; 
	КонецЕсли; 
	
	Шапка2Область.Параметры.Заполнить(Выборка);
	
	ТабДокумент.Вывести(Шапка2Область);
	
	Возврат ТабДокумент;
	
	
КонецФункции

// Функция формирует табличный документ с печатной формой приказа о проведении.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьЛСУП() Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = ПолучитьМакет("ЛСУП");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) Тогда
		
		СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.МестоРождения);
		ШапкаОбласть.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
		ШапкаОбласть.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
		ШапкаОбласть.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
		ШапкаОбласть.Параметры.СтранаРожд          = СтруктураМестоРождения.Страна;
		Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.Пол) Тогда
			Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				
				ШапкаОбласть.Область("ПолМуж").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
				
			ИначеЕсли Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				
				ШапкаОбласть.Область("ПолЖен").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
				
			КонецЕсли;
		КонецЕсли; 
		ШапкаОбласть.Параметры.Заполнить(Выборка);
		
		Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.ДатаРождения) Тогда
			
			ШапкаОбласть.Параметры.ДеньРожд   = Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=dd");
			ДатаМесяц 							= Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРожд 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			МесяцРожд                         = Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=MM");
			ШапкаОбласть.Параметры.МесяцРожд1 = Сред(МесяцРожд,1,1);
			ШапкаОбласть.Параметры.МесяцРожд2 = Сред(МесяцРожд,2,1);
			ГодРожд                           = Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ=yyyy");
			ШапкаОбласть.Параметры.ГодРожд1   = Сред(ГодРожд,1,1);
			ШапкаОбласть.Параметры.ГодРожд2   = Сред(ГодРожд,2,1);
			ШапкаОбласть.Параметры.ГодРожд3   = Сред(ГодРожд,3,1);
			ШапкаОбласть.Параметры.ГодРожд4   = Сред(ГодРожд,4,1);
			
		КонецЕсли;
		
		ИскомаяСтрока = ПолучитьКИ(Выборка.РегистрируемоеЛицо,Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Проживающие); 
		Строка = ИскомаяСтрока.Найти(Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытия, "Вид");
		ПолныйАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(Строка);
		
		Если  ЗначениеЗаполнено(ПолныйАдресПрибытия) Тогда
			СтруктураАдресПрибытия = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ПолныйАдресПрибытия);
			Если НЕ СтруктураАдресПрибытия.Свойство("ЗаПределамиРФ") Тогда
				
				ШапкаОбласть.Параметры.ГосударствоПриб     = СтруктураАдресПрибытия.Страна;
				ШапкаОбласть.Параметры.РегионПриб          = СтруктураАдресПрибытия.Регион;
				ШапкаОбласть.Параметры.РайонПриб           = СтруктураАдресПрибытия.Район ;
				ШапкаОбласть.Параметры.ГородПриб           = СтруктураАдресПрибытия.Город ;
				ШапкаОбласть.Параметры.НаселенныйПунктПриб = СтруктураАдресПрибытия.НаселенныйПункт;
				
			КонецЕсли;
		КонецЕсли;
		
		НаборЗаписей = НЕОПРЕДЕЛЕНО;
		бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
		ИскомаяСтрока = Неопределено;
		Для каждого СтрокаНабор Из НаборЗаписей  Цикл
			Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
				И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
				Тогда 
				ИскомаяСтрока = СтрокаНабор;
			КонецЕсли;	
			
		КонецЦикла;
		
		ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
		
		Если ЗначениеЗаполнено(ЗаписьАдрес) Тогда
			
			СтруктураАдресРегистрации = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
			Если СтруктураАдресРегистрации <> Неопределено И НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
				
				ШапкаОбласть.Параметры.РегионРег 			= СтруктураАдресРегистрации.Регион;
				ШапкаОбласть.Параметры.РайонРег 			= СтруктураАдресРегистрации.Район;
				ШапкаОбласть.Параметры.ГородРег 			= СтруктураАдресРегистрации.Город;
				ШапкаОбласть.Параметры.НаселенныйПунктРег 	= СтруктураАдресРегистрации.НаселенныйПункт;
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли; 
	ДолжностноеЛицоОрганизации = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Организация, ДолжностноеЛицо, Дата);
	ШапкаОбласть.Параметры.ДолжностноеЛицоОрганизации = ДолжностноеЛицоОрганизации;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция вызывает форму печати табличного документа с печатной формой.
// Инвентаризационной описи основных средств.
//
// Параметры:
//  ПечатьДвухЧастей - булево, печатать обе части заявления (Истина) или только верхнюю (Ложь).
//
// Возвращаемое значение:
//  Неопределено.
//
Функция ПечатьЗОССРУПМЖ(ПечатьДвухЧастей) Экспорт
	
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	// Добавление регистра сведений с ФИО ответственного за регистрацию.
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	ВЫБОР
	|		КОГДА бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения ЕСТЬ NULL 
	|				ИЛИ бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения = ДАТАВРЕМЯ(1, 1, 1)
	|				ИЛИ &Момент < бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения
	|			ТОГДА НЕОПРЕДЕЛЕНО
	|		ИНАЧЕ РАЗНОСТЬДАТ(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, &Момент, ГОД)
	|	КОНЕЦ КАК РегЛицоВозраст,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
