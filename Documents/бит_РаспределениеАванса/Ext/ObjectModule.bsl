				НСтр.Сумма				  = Мин(МассивСтрок[0].Аванс, Выборка.СуммаКОплате);
				
				// Списываем распределенный аванс.
				НСтрАвансов = ТаблицаАвансов.Добавить();
				НСтрАвансов.ЛицевойСчет = Выборка.ЛицевойСчет;
				НСтрАвансов.УслугаЖКХ	= Выборка.УслугаЖКХ;
				НСтрАвансов.Аванс	    = -Мин(МассивСтрок[0].Аванс, Выборка.СуммаКОплате);
				
				ТаблицаАвансов.Свернуть("ЛицевойСчет,УслугаЖКХ","Аванс");
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
