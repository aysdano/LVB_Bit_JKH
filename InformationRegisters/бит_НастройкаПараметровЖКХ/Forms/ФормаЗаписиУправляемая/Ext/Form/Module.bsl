// Процедура - обработчик события "Нажатие" кнопки "ЗаполнитьСчетаПоУмолчанию".
//
&НаКлиенте
Процедура ЗаполнитьСчетаПоУмолчанию(Команда)
	
	СтруктураСчетов = ПланыСчетовНаСервере();
	
	Счет76_КУ   = СтруктураСчетов.Счет76_КУ;
	Счет86_03   = СтруктураСчетов.Счет86_03;
	Счет90_01_1 = СтруктураСчетов.Счет90_01_1;
	Счет76_05   = СтруктураСчетов.Счет76_05;
	Счет76_06   = СтруктураСчетов.Счет76_06;
	Счет60_01   = СтруктураСчетов.Счет60_01;
	
	ЗаполнитьСчета = Ложь;
	
	Если НЕ ЗначениеЗаполнено(Запись.СчетАбонента) ИЛИ НЕ Запись.СчетАбонента = Счет76_КУ
		ИЛИ НЕ ЗначениеЗаполнено(Запись.ТранзитныйСчетОплаты) ИЛИ НЕ Запись.ТранзитныйСчетОплаты = Счет76_06 
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетСУКУ)             ИЛИ НЕ Запись.СчетСУКУ = Счет86_03 
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетСУЦС)             ИЛИ НЕ Запись.СчетСУЦС = Счет86_03 
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетСУАренды)         ИЛИ НЕ Запись.СчетСУАренды = Счет90_01_1 
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетЛьготСУ)          ИЛИ НЕ Запись.СчетЛьготСУ = Счет76_05 
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетСторПКУ)          ИЛИ НЕ Запись.СчетСторПКУ = Счет76_05 
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетСторПКУОплата)    ИЛИ НЕ Запись.СчетСторПКУОплата = Счет60_01
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетЛьготСторП)       ИЛИ НЕ Запись.СчетЛьготСторП = Счет76_05
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетНачисленийРасчетаПредельногоИндексаСобственныхУслуг)          
		ИЛИ НЕ Запись.СчетНачисленийРасчетаПредельногоИндексаСобственныхУслуг = Счет76_05
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетНачисленийРасчетаПредельногоИндексаСоСтороннимиОрганизациями)       
		ИЛИ НЕ Запись.СчетНачисленийРасчетаПредельногоИндексаСоСтороннимиОрганизациями = Счет76_05
		ИЛИ НЕ ЗначениеЗаполнено(Запись.СчетДохода)           ИЛИ НЕ Запись.СчетДохода = Счет90_01_1 Тогда
		
		ЗаполнитьСчета = Истина;
		
	КонецЕсли;
	
	Если ЗаполнитьСчета Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьСчетаПоУмолчаниюЗавершение", ЭтотОбъект, Новый Структура("Счет60_01, Счет76_05, Счет76_06, Счет76_КУ, Счет86_03, Счет90_01_1", Счет60_01, Счет76_05, Счет76_06, Счет76_КУ, Счет86_03, Счет90_01_1)), "Все счета будут заполнены по умолчанию. Продолжить?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

