#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем мВидОтчета Экспорт;  // Хранит текущий вид отчета.

Перем мВыгрузка  Экспорт;  // Хранит формат выгрузки.

Перем мИмяФайла  Экспорт;  // Хранит имя Файла выгрузки.

Перем мПутьВыгрузки Экспорт; // Хранит путь выгрузки.

Перем мТаблицаОтчета Экспорт; // Хранит таблицу отчета.

Перем мСтруктураИтоговОтчета Экспорт; // Хранитт структуру итогов отчета.

Перем мАдресТаблицыВоВременномХранилище Экспорт; // Хранитт адрес таблицы во временном хранилище.

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункции

// Процедура формирует данные для отчета.
//
Процедура СформироватьОтчет(ДокументРезультат,мВидОтчета) Экспорт
	
	Если мВидОтчета = "НачисленияПоЛС" Тогда
		СформироватьСведенияОНачислениях(ДокументРезультат,мВидОтчета);
	ИначеЕсли мВидОтчета = "СведенияОПРоживающих" Тогда
		СформироватьСведенияОПроживающих(ДокументРезультат,мВидОтчета);
	ИначеЕсли мВидОтчета = "ВыпадающиеДоходы" Тогда
		СформироватьОтчетОВыпадающихДоходах(ДокументРезультат,мВидОтчета);
	ИначеЕсли мВидОтчета = "РасшифровкаПоЛьготе" Тогда
		СформироватьОтчетРасшифровкаПоЛьготе(ДокументРезультат,мВидОтчета);
	КонецЕсли; 
	
КонецПроцедуры

// Процедура выгружает таблицу в Excel или DBF.
//
Процедура Выгрузить(КодОрганизацииНастройка,ИмяФайлаНастройка,ФорматНастройка,ПутьДляВыгрузкиНастройка,ТаблицаО) Экспорт
	
	КодОрганизацииПоГЦЖС = КодОрганизацииНастройка;
	ИмяФайла = КодОрганизацииНастройка;
	Формат = ФорматНастройка;
	ПутьДляВыгрузки = ПутьДляВыгрузкиНастройка;
	
	мВыгрузка = ФорматНастройка;
	мПутьВыгрузки = ПутьДляВыгрузкиНастройка;
	мИмяФайла = ИмяФайлаНастройка;
	
	Если КодОрганизацииПоГЦЖС <> "" И ТаблицаО <> Неопределено Тогда
		
		ТаблицаО.ЗаполнитьЗначения(КодОрганизацииПоГЦЖС, "КодОрганизации"); 
		
	КонецЕсли;  
	
	Если мВыгрузка = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если ТаблицаО = Неопределено Тогда
		
		ТекстСообщения = НСтр("ru = 'Перед выгрузкой сформеруйте отчет.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецЕсли; 
	
	Если мВыгрузка = "Excel" Тогда
		ВыгрузитьДанныеВExcel(ТаблицаО);
	ИначеЕсли мВыгрузка = "DBF" Тогда
		ВыгрузитьДанныеВDBF(ТаблицаО);
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Функция формирует таблицу лицевых счетов и их свойств.
//
// Параметры
//    Нет.
//
// Возвращаемое значение:
//   <ТаблицаЗначений>   - Хранит список лицевых счетов и их свойства. 
//
Функция СформироватьТаблицуЛС()
	
	Если ПоВсемЛС Тогда
		Условие = "";
	Иначе
		Условие = "
		|				И ЛицевойСчет В
		|					(ВЫБРАТЬ
		|						Таб.ЛицевойСчет
		|					ИЗ
		|						ЛицевыеСчета КАК Таб)";
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛьготыПоЛССрезПоследних.ЛицевойСчет
	|ПОМЕСТИТЬ ЛицевыеСчета
	|ИЗ
	|	РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних(&КонецПериода, ) КАК бит_ЛьготыПоЛССрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&КонецПериода, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО бит_ЛьготыПоЛССрезПоследних.ЛицевойСчет = бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	|			И бит_ЛьготыПоЛССрезПоследних.ФизЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|ГДЕ
	|	(бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы > &КонецПериода
	|			ИЛИ бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы = ДАТАВРЕМЯ(1, 1, 1))
	|	И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &КонецПериода
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ЛьготыПоЛССрезПоследних.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
	|	КоличествоЕдиницПоСчетчикамСрезПоследних.Счетчик,
	|	СУММА(КоличествоЕдиницПоСчетчикамСрезПоследних.КоличествоЕдиницПоЛС) КАК КоличествоЕдиницПоЛС,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|				ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПоСчетчикам,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|				ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПоЛС,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|				ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот * -1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаЛьготам,
	|   МАКСИМУМ(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК СуммаПоОбщедомовымСчетчикам
	|ПОМЕСТИТЬ ВыборкаНачислений
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			ЛицевойСчет.Организация = &Организация "+Условие+") КАК НачисленияПоУслугамЖКХОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_КолЕдПоСчетчикам.СрезПоследних(&КонецПериода {(&КонецПериода)}, ) КАК КоличествоЕдиницПоСчетчикамСрезПоследних
	|		ПО НачисленияПоУслугамЖКХОбороты.ЛицевойСчет = КоличествоЕдиницПоСчетчикамСрезПоследних.ЛицевойСчет
	|			И НачисленияПоУслугамЖКХОбороты.УслугаЖКХ = КоличествоЕдиницПоСчетчикамСрезПоследних.УслугаЖКХ
	|ГДЕ
	|	НачисленияПоУслугамЖКХОбороты.ЛицевойСчет.Здание.ТипУправляющейОрганизации = &ТипУО
	|
	|СГРУППИРОВАТЬ ПО
	|	КоличествоЕдиницПоСчетчикамСрезПоследних.Счетчик,
	|	НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВыборкаНачислений.ЛицевойСчет,
	|	ВыборкаНачислений.Услуга,
	|	СУММА(ВыборкаНачислений.КоличествоЕдиницПоЛС) КАК КоличествоЕдиницПоЛС,
	|	МАКСИМУМ(ВыборкаНачислений.СуммаПоСчетчикам) КАК СуммаПоСчетчикам,
	|	МАКСИМУМ(ВыборкаНачислений.СуммаПоЛС) КАК СуммаПоЛС,
	|	МАКСИМУМ(ВыборкаНачислений.СуммаЛьготам) КАК СуммаЛьготам,
	|	МАКСИМУМ(ВыборкаНачислений.СуммаПоОбщедомовымСчетчикам) КАК СуммаПоОбщедомовымСчетчикам
	|ПОМЕСТИТЬ Начисления
	|ИЗ
	|	ВыборкаНачислений КАК ВыборкаНачислений
	|
	|СГРУППИРОВАТЬ ПО
	|	ВыборкаНачислений.ЛицевойСчет,
	|	ВыборкаНачислений.Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Начисления.ЛицевойСчет,
	|	Начисления.ЛицевойСчет.Наименование КАК НаименованиеЛС,
	|	Начисления.Услуга,	
	|	Начисления.КоличествоЕдиницПоЛС,
	// БИТ_ЖКХ 15.05.2017 14:59:44 Начало правки... 
	//|	Начисления.Услуга.Приоритет КАК Приоритет,
	|	Начисления.Услуга.ОбщедомовыеНачисления КАК ОбщедомовыеНачисления,
	// БИТ_ЖКХ 15.05.2017 14:59:45 Конец правки. 
	|	ЕСТЬNULL(Начисления.СуммаПоСчетчикам, 0) + ЕСТЬNULL(Начисления.СуммаПоЛС, 0) КАК Сумма,
	|	ЕСТЬNULL(Начисления.СуммаПоСчетчикам, 0) + ЕСТЬNULL(Начисления.СуммаПоЛС, 0) - ЕСТЬNULL(Начисления.СуммаЛьготам, 0) КАК СуммаБезЛьгот,
	|	ЕСТЬNULL(Начисления.СуммаПоОбщедомовымСчетчикам, 0) КАК СуммаОбщедомовых,
	|	СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	|	СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	СведенияПоУслугамЛССрезПоследних.РежимПотребления,
	|	СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь КАК ОтапливаемаяПлощадь,
	|	СведенияОКвартиреСрезПоследних.ЖилаяПлощадь КАК ЖилаяПлощадь,
	|	СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления,
	|	СведенияПоУслугамЛССрезПоследних.Поставщик,
	|	СведенияОКвартиреСрезПоследних.ТипПлиты,
	|	СведенияОКвартиреСрезПоследних.ТипЗапирающегоУстройства,
	|	Начисления.ЛицевойСчет.Здание КАК Здание,
	|	Начисления.ЛицевойСчет.Квартира КАК Квартира,
	|	Начисления.ЛицевойСчет.УлицаЛицевогоСчета КАК Улица
	|ИЗ
	|	Начисления КАК Начисления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&КонецПериода {(&КонецПериода)}, ) КАК СведенияПоУслугамЛССрезПоследних
	|		ПО Начисления.ЛицевойСчет = СведенияПоУслугамЛССрезПоследних.ЛицевойСчет
	|			И Начисления.Услуга = СведенияПоУслугамЛССрезПоследних.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&КонецПериода {(&КонецПериода)}, ) КАК СведенияОКвартиреСрезПоследних
	|		ПО Начисления.ЛицевойСчет.Квартира = СведенияОКвартиреСрезПоследних.Квартира";
	
	Запрос.УстановитьПараметр("Организация"   , Организация);
	Запрос.УстановитьПараметр("ТипУО"         , УправляющаяОрганизация);
	Запрос.УстановитьПараметр("НачалоПериода" , НачалоМесяца(КонецПериода));
	Запрос.УстановитьПараметр("КонецПериода"  , КонецМесяца(КонецПериода));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции // СформироватьТаблицуЛС()

// Процедура производит расчет долей по техобслуживанию и отоплению.
//
Процедура РасчетДолей(Выборка, СтруктураНорм, Льгота = Ложь)
	
	Факт   = 0;
	Норма  = 0;
	ДНорма = 0;
	СНорма = 0;
	
	СуммаНорма      = 0;
	СуммаДопНорма   = 0;
	СуммаСверхНорма = 0;
	
	// Расчет факта.
	Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда
		Факт = Выборка.ОбщаяПлощадь;
	ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади Тогда
		Факт = Выборка.ОтапливаемаяПлощадь;
	ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда
		Факт = Выборка.ЖилаяПлощадь;
	ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления Тогда
		Факт = Выборка.КоличествоЕдиницПотребления;
	ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим Тогда
		Факт = Выборка.КоличествоПроживающих;
	ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам Тогда
		Факт = Выборка.КоличествоЕдиницПоЛС; // ПоказанияСчетчиков(Выборка.ЛицевойСчет, Выборка.Услуга, Выборка.Здание, Выборка.Улица ,ТаблицаЛС);.
	ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет Тогда
		Факт = Выборка.КоличествоЕдиницПотребления;
		// БИТ_ЖКХ добавление кода Начало: 18.07.2011 
	ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению Тогда
		Факт = Выборка.КоличествоЕдиницПоЛС; // ПоказанияСчетчиков(Выборка.ЛицевойСчет, Выборка.Услуга, Выборка.Здание, Выборка.Улица ,ТаблицаЛС);.
		// БИТ_ЖКХ добавление кода конец : 18.07.2011
		
	КонецЕсли;
	
	// Норма.
	Если Льгота Тогда
		
		Если Выборка.КоличествоПроживающих = 1 Тогда
			Норма = Выборка.НаОдного;
		ИначеЕсли Выборка.КоличествоПроживающих = 2 Тогда
			Норма = Выборка.НаДвоих * 2;
			// БИТ_ЖКХ изменение кода. Начало. 21.05.2012{{
		ИначеЕсли Выборка.КоличествоПроживающих = 3 Тогда
			Норма = Выборка.НаСемью * Выборка.КоличествоПроживающих;
		ИначеЕсли Выборка.КоличествоПроживающих = 4 Тогда
			Норма = Выборка.НаСемью4 * Выборка.КоличествоПроживающих;
		ИначеЕсли Выборка.КоличествоПроживающих = 5 Тогда
			Норма = Выборка.НаСемью5 * Выборка.КоличествоПроживающих;
		ИначеЕсли Выборка.КоличествоПроживающих > 5 Тогда
			Норма = Выборка.НаСемью6 * Выборка.КоличествоПроживающих;
			// БИТ_ЖКХ изменение кода. Конец. 21.05.2012}}
		КонецЕсли;
		
		Если Выборка.ИспользоватьДопНормуНаЛьготника Тогда
			
			Если Выборка.КоличествоПроживающих = 1 тогда
				ДНорма  = ?(Выборка.ИспользоватьДопНормуНаОдного,Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого,0);
			ИначеЕсли Выборка.КоличествоПроживающих = 2 тогда
				ДНорма  = Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * 2;  
			ИначеЕсли Выборка.КоличествоПроживающих > 2 тогда
				ДНорма  = Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * Выборка.КоличествоПроживающих;  
			КонецЕсли;
			
		КонецЕсли; 
		
	Иначе
		
		Если Выборка.КоличествоПроживающих = 1 Тогда
			Норма = Выборка.НаОдного;
		ИначеЕсли Выборка.КоличествоПроживающих = 2 Тогда
			Норма = Выборка.НаДвоих * 2;
		ИначеЕсли Выборка.КоличествоПроживающих > 2 Тогда
			Норма = Выборка.НаСемью * Выборка.КоличествоПроживающих;
		КонецЕсли; 
		
		Если Выборка.КоличествоПроживающих = 1 тогда
			ДНорма  = ?(Выборка.ИспользоватьДопНормуНаОдного,Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого,0);
		ИначеЕсли Выборка.КоличествоПроживающих = 2 тогда
			ДНорма  = Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * 2;  
		ИначеЕсли Выборка.КоличествоПроживающих > 2 тогда
			ДНорма  = Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * Выборка.КоличествоПроживающих;  
		КонецЕсли;
		
	КонецЕсли; 
	
	Норма = ?(Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет, Выборка.КоличествоЕдиницПотребления, Норма);
	
	Норма  = ?(Норма >= Факт, Факт, Норма);
	
	ДНорма = ?(ДНорма >= (Факт - Норма),(Факт - Норма),ДНорма);  
	
	СНорма = ?(Норма + ДНорма >= Факт, 0, Факт - (Норма+ДНорма));
	
	ОбщНорма = Норма + ДНорма + СНорма;
	
	СуммаНорма      = ?(ОбщНорма = 0,0,(Выборка.Сумма* Норма)/ ОбщНорма);
	СуммаДопНорма   = ?(ОбщНорма = 0,0,(Выборка.Сумма* ДНорма)/ ОбщНорма);
	СуммаСверхНорма = ?(ОбщНорма = 0,0,(Выборка.Сумма* СНорма)/ ОбщНорма);
	
	СтруктураНорм.ОснНорма = СуммаНорма;
	СтруктураНорм.ДопНорма = СуммаДопНорма;
	СтруктураНорм.ОбщНорма = СуммаСверхНорма;
	
КонецПроцедуры

// Функция производит расчет долга лс.
//
// Параметры:
//  <ЛицевойСчет>  - <СправочникСсылка>. 
//                   Текущий лицевой счет для расчета долга.
//
// Возвращаемое значение:
//   <Число>   - <Суммадолга>.
//
Функция СуммаДолга(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОстатки.СуммаОстаток, 0) - ЕСТЬNULL(ТаблицаОплаты.Оплата, 0) < 0
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(НачисленияПоУслугамЖКХОстатки.СуммаОстаток, 0) - ЕСТЬNULL(ТаблицаОплаты.Оплата, 0)
	|	КОНЕЦ КАК Долг
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(
	|			&ДатаНачала,
	|			ЛицевойСчет = &ЛицевойСчет) КАК НачисленияПоУслугамЖКХОстатки,
	|	(ВЫБРАТЬ
	|		СУММА(ВЫБОР
	|				КОГДА ВЫБОР
	|						КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|							ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|					КОНЕЦ < 0
	|					ТОГДА ВЫБОР
	|							КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|								ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|						КОНЕЦ * -1
	|				ИНАЧЕ ВЫБОР
	|						КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|							ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|					КОНЕЦ
	|			КОНЕЦ) КАК Оплата
	|	ИЗ
	|		РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
	|				&ДатаНачала,
	|				&ДатаКонца,
	|				Регистратор,
	|				ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОбороты) КАК ТаблицаОплаты";
	
	Запрос.УстановитьПараметр("ДатаНачала"  , НачалоМесяца(КонецПериода));
	Запрос.УстановитьПараметр("ДатаКонца"   , КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет" , ЛицевойСчет);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		
		Долг = Результат.Получить(Результат.Количество()-1).Долг;
		
	Иначе
		
		Долг = 0;
		
	КонецЕсли;
	
	Возврат Долг;
	
КонецФункции // ()

// Функция получает имя руководителя.
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//  <Параметр2>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//
// Возвращаемое значение:
//   <Тип.Вид>   - <описание возвращаемого значения>.
//
Функция ПолучитьИмяРуководителя()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо = ЗНАЧЕНИЕ(Перечисление.ОтветственныеЛицаОрганизаций.Руководитель)
	|				ТОГДА ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо
	|		КОНЕЦ) КАК Руководитель,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.СтруктурнаяЕдиница
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&КонецПериода, СтруктурнаяЕдиница = &Организация) КАК ОтветственныеЛицаОрганизацийСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	ОтветственныеЛицаОрганизацийСрезПоследних.СтруктурнаяЕдиница";
	Запрос.УстановитьПараметр("Организация" , Организация);
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(КонецПериода));
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		
		Результат = Запрос.Выполнить().Выгрузить();
		Возврат Результат[0].Руководитель;
		
	Иначе
		
		Возврат "Руководитель не назначен";
		
	КонецЕсли; 
	
КонецФункции // ()

// Функция получает количество месяцев долга.
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//  <Параметр2>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//
// Возвращаемое значение:
//   <Тип.Вид>   - <описание возвращаемого значения>.
//
Функция ПолучитьКолМесяцевДолга(СуммаДолга, ЛицевойСчет)
	
	Если СуммаДолга = 0 Тогда
		
		Возврат 0;
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_НачислениеПоЛицевымСчетам.Ссылка,
	|	бит_НачислениеПоЛицевымСчетам.Дата КАК Дата
	|ИЗ
	|	Документ.бит_НачислениеПоЛицевымСчетам КАК бит_НачислениеПоЛицевымСчетам
	|ГДЕ
	|	бит_НачислениеПоЛицевымСчетам.Дата < &НачалоПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(КонецПериода));
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		
		Результат = Запрос.Выполнить().Выгрузить();
		ДатаДокумента = Результат[0].Дата;
		
	Иначе
		
		Возврат 0;
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(ВЫБОР
	|					КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|						ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|					ИНАЧЕ 0
	|				КОНЕЦ + ВЫБОР
	|					КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|						ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|					ИНАЧЕ 0
	|				КОНЕЦ + ВЫБОР
	|					КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|						ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|					ИНАЧЕ 0
	|				КОНЕЦ, 0) > 0
	|			ТОГДА ЕСТЬNULL(ВЫБОР
	|						КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|							ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|						ИНАЧЕ 0
	|					КОНЕЦ + ВЫБОР
	|						КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|							ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|						ИНАЧЕ 0
	|					КОНЕЦ + ВЫБОР
	|						КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|							ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|						ИНАЧЕ 0
	|					КОНЕЦ, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаНачислений
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК НачисленияПоУслугамЖКХОбороты";
	Запрос.УстановитьПараметр("НачалоПериода" , НачалоМесяца(ДатаДокумента));
	Запрос.УстановитьПараметр("КонецПериода"  , КонецМесяца(ДатаДокумента));
	Запрос.УстановитьПараметр("ЛицевойСчет"   , ЛицевойСчет);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		
		Результат = Запрос.Выполнить().Выгрузить();
		СуммаНачислений = Результат[0].СуммаНачислений;
		
		Если СуммаНачислений <> 0 Тогда
			КолМесяцев = Окр(СуммаДолга/Результат[0].СуммаНачислений);
		Иначе
			Возврат 0;
		КонецЕсли; 
		
		Возврат КолМесяцев;
		
	Иначе
		Возврат 0;
	КонецЕсли; 
	
КонецФункции // ()

// Процедура формирует отчет Сведения о Начисленийх.
//
Процедура СформироватьСведенияОНачислениях(ДокументРезультат,мВидОтчета)
	
	ТаблицаЛС = СформироватьТаблицуЛС();
	
	Если ТаблицаЛС.Количество() = 0 Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("По заданным настройкам не было начислений.");
		
		Возврат;
		
	КонецЕсли;
	
	мТаблицаОтчета         = СформироватьТаблицуДанных();
	мСтруктураИтоговОтчета = Новый Структура;
	
	Запрос = Новый Запрос;
	Запрос.Текст =  
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаЛС.ЛицевойСчет,
	|	ТаблицаЛС.НаименованиеЛС,
	|	ТаблицаЛС.Услуга,
	|	ТаблицаЛС.ОбщедомовыеНачисления,
	|	ТаблицаЛС.Сумма,
	|	ТаблицаЛС.СуммаОбщедомовых,
	|	ТаблицаЛС.Здание,
	|	ТаблицаЛС.Квартира,
	|	ТаблицаЛС.Улица,
	|	ТаблицаЛС.СпособРасчета,
	|	ТаблицаЛС.ОбщаяПлощадь,
	|	ТаблицаЛС.ТипКвартиры,
	|	ТаблицаЛС.СтатусКвартиры,
	|	ТаблицаЛС.РежимПотребления,
	|	ТаблицаЛС.ОтапливаемаяПлощадь,
	|	ТаблицаЛС.ЖилаяПлощадь,
	|	ТаблицаЛС.КоличествоЕдиницПотребления,
	|	ТаблицаЛС.КоличествоЕдиницПоЛС,
	|	ТаблицаЛС.Поставщик,
	|	ТаблицаЛС.ТипПлиты,
	|	ТаблицаЛС.ТипЗапирающегоУстройства,
	|	ТаблицаЛС.СуммаБезЛьгот
	|ПОМЕСТИТЬ ИнформацияПоЛС
	|ИЗ
	|	&ТаблицаЛС КАК ТаблицаЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	КОЛИЧЕСТВО(ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК КоличествоПроживающих,
	|	ОтветсвеноеЛицо.ФизЛицо КАК ОтветсвенноеЛицо,
	|	КОЛИЧЕСТВО(ВЫБОР
	|			КОГДА ПроживающиеПоЛССрезПоследних.СтатусФизЛица = ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.ПостояннаяРегистрация)
	|				ТОГДА ПроживающиеПоЛССрезПоследних.ФизЛицо
	|		КОНЕЦ) КАК КоличествоПостоянноПроживающих
	|ПОМЕСТИТЬ Проживающие
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&КонецПериода,
	|			ДатаСнятияСРегистрации > &КонецПериода
	|				ИЛИ ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)) КАК ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|			бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
	|		ИЗ
	|			РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&КонецПериода, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ГДЕ
	|			(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &КонецПериода
	|					ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|			И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|			бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК ОтветсвеноеЛицо
	|		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет = ОтветсвеноеЛицо.ЛицевойСчет
	|
	|СГРУППИРОВАТЬ ПО
	|	ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	ОтветсвеноеЛицо.ФизЛицо
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ИнформацияПоЛС.ЛицевойСчет КАК ЛицевойСчет,
	|	ИнформацияПоЛС.НаименованиеЛС КАК НаименованиеЛС,
	|	ИнформацияПоЛС.Услуга,
	|	ИнформацияПоЛС.ОбщедомовыеНачисления,
	|	ЕСТЬNULL(ИнформацияПоЛС.Сумма, 0) КАК Сумма,
	|	ЕСТЬNULL(ИнформацияПоЛС.СуммаОбщедомовых, 0) КАК СуммаОбщедомовых,
	|	ИнформацияПоЛС.Здание КАК Здание,
	|	ИнформацияПоЛС.Здание.ТипЖилФонда КАК ТипЖилФонда,
	|	ИнформацияПоЛС.Квартира КАК Квартира,
	|	ИнформацияПоЛС.Улица КАК Улица,
	|	ИнформацияПоЛС.СпособРасчета,
	|	ИнформацияПоЛС.ОбщаяПлощадь КАК ОбщаяПлощадь,
	|	ИнформацияПоЛС.ТипКвартиры,
	|	ИнформацияПоЛС.СтатусКвартиры КАК СтатусКвартиры,
	|	ИнформацияПоЛС.РежимПотребления,
	|	ИнформацияПоЛС.ОтапливаемаяПлощадь,
	|	ИнформацияПоЛС.ЖилаяПлощадь КАК ЖилаяПлощадь,
	|	ЕСТЬNULL(ИнформацияПоЛС.КоличествоЕдиницПотребления, 0) КАК КоличествоЕдиницПотребления,
	|	ЕСТЬNULL(ИнформацияПоЛС.КоличествоЕдиницПоЛС, 0) КАК КоличествоЕдиницПоЛС,
	|	ИнформацияПоЛС.Поставщик,
	|	ИнформацияПоЛС.ТипПлиты КАК ТипПлиты,
	|	ИнформацияПоЛС.ТипЗапирающегоУстройства КАК ТипЗапирающегоУстройства,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.НаОдного, 0) КАК НаОдного,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.НаДвоих, 0) КАК НаДвоих,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.НаСемью, 0) КАК НаСемью,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.НаСемью4, 0) КАК НаСемью4,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.НаСемью5, 0) КАК НаСемью5,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.НаСемью6, 0) КАК НаСемью6,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.ДопНормаНаСемью, 0) КАК ДопНормаНаСемью,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.ДопНормаНаКаждого, 0) КАК ДопНормаНаКаждого,
	|	ЕСТЬNULL(Проживающие.КоличествоПроживающих, 0) КАК КоличествоПроживающих,
	|	Проживающие.ОтветсвенноеЛицо КАК ОтветсвенноеЛицо,
	|	ЕСТЬNULL(Проживающие.КоличествоПостоянноПроживающих, 0) КАК КоличествоПостоянноПроживающих,
	|	ЕСТЬNULL(СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0) КАК ОсновнаяСтавка,
	|	ЕСТЬNULL(СтавкиНаУслугиСрезПоследних.СверхНормативнаяСтавка, 0) КАК СверхНормативнаяСтавка,
	|	ЕСТЬNULL(НормыНаУслугиСрезПоследних.ИспользоватьДопНормуНаОдного, ЛОЖЬ) КАК ИспользоватьДопНормуНаОдного,
	|	ЕСТЬNULL(ИнформацияПоЛС.СуммаБезЛьгот, 0) КАК СуммаБезЛьгот
	|ИЗ
	|	ИнформацияПоЛС КАК ИнформацияПоЛС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НормыНаУслуги.СрезПоследних(&КонецПериода, ) КАК НормыНаУслугиСрезПоследних
	|		ПО ИнформацияПоЛС.Услуга = НормыНаУслугиСрезПоследних.Услуга
	|			И ИнформацияПоЛС.СпособРасчета = НормыНаУслугиСрезПоследних.СпособРасчетаПоУслуге
	|			И ИнформацияПоЛС.ТипКвартиры = НормыНаУслугиСрезПоследних.ТипКвартиры
	|			И ИнформацияПоЛС.СтатусКвартиры = НормыНаУслугиСрезПоследних.СтатусКвартиры
	|			И ИнформацияПоЛС.РежимПотребления = НормыНаУслугиСрезПоследних.РежимПотребления
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&КонецПериода, ) КАК СтавкиНаУслугиСрезПоследних
	|		ПО ИнформацияПоЛС.Услуга = СтавкиНаУслугиСрезПоследних.Услуга
	|			И ИнформацияПоЛС.СпособРасчета = СтавкиНаУслугиСрезПоследних.СпособРасчета
	|			И ИнформацияПоЛС.Поставщик = СтавкиНаУслугиСрезПоследних.Поставщик
	|			И ИнформацияПоЛС.ТипКвартиры = СтавкиНаУслугиСрезПоследних.ТипКвартиры
	|			И ИнформацияПоЛС.СтатусКвартиры = СтавкиНаУслугиСрезПоследних.СтатусКвартиры
	|			И ИнформацияПоЛС.РежимПотребления = СтавкиНаУслугиСрезПоследних.РежимПотребления
	|		ЛЕВОЕ СОЕДИНЕНИЕ Проживающие КАК Проживающие
	|		ПО ИнформацияПоЛС.ЛицевойСчет = Проживающие.ЛицевойСчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	НаименованиеЛС
	|ИТОГИ
	|	СУММА(Сумма),
	|	МАКСИМУМ(Здание),
	|	МАКСИМУМ(ТипЖилФонда),
	|	МАКСИМУМ(Квартира),
	|	МАКСИМУМ(Улица),
	|	МАКСИМУМ(ОбщаяПлощадь),
	|	МАКСИМУМ(ЖилаяПлощадь),
	|	МАКСИМУМ(ТипПлиты),
	|	МАКСИМУМ(ТипЗапирающегоУстройства),
	|	МАКСИМУМ(КоличествоПроживающих),
	|	МАКСИМУМ(ОтветсвенноеЛицо),
	|	МАКСИМУМ(СтатусКвартиры),
	|	МАКСИМУМ(КоличествоПостоянноПроживающих),
	|	СУММА(СуммаБезЛьгот)
	|ПО
	|	Здание,
	|	ЛицевойСчет";
	Запрос.УстановитьПараметр("ТаблицаЛС"     , ТаблицаЛС);
	Запрос.УстановитьПараметр("НачалоПериода" , НачалоДня(КонецПериода));
	Запрос.УстановитьПараметр("КонецПериода"  , КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Организация"   , Организация);
	
	СтруктураНорм = Новый Структура;
	СтруктураНорм.Вставить("ОснНорма",0);
	СтруктураНорм.Вставить("ДопНорма",0);
	СтруктураНорм.Вставить("ОбщНорма",0);
	
	ВыборкаЗдание = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Макет = ПолучитьМакет("НачисленияЛС");
	
	Шапка         = Макет.ПолучитьОбласть("ШапкаОтчета");
	ШапкаТаблицы  = Макет.ПолучитьОбласть("ШапкаТаблицы");
	СтрокаАдрес   = Макет.ПолучитьОбласть("СтрокаАдрес");
	СтрокаТаблицы = Макет.ПолучитьОбласть("СтрокаТаблицы");
	Итог          = Макет.ПолучитьОбласть("Итог");
	Подвал        = Макет.ПолучитьОбласть("Подвал");
	
	Период = Строка(Формат(НачалоМесяца(КонецПериода), "ДЛФ=DD")) +" - "+ Строка(Формат(КонецМесяца(КонецПериода), "ДЛФ=DD"));
	
	Шапка.Параметры.Период      = Период;
	Шапка.Параметры.Организация = Организация;
	Шапка.Параметры.ТПО         = УправляющаяОрганизация;
	
	ПоОбщейПлощади                      = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади;
	ПоЕдиницамПотребленияНаЛицевойСчет = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет;
	ПоЕдиницамПотребления               = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления;
	ПоЖилойПлощади                      = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади;
	ПоОтапливаемойПлощади               = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади;
	РасчетПоСчетчикам                   = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам;
	ПоПроживающим                       = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим;
	
	ДокументРезультат.Вывести(Шапка);
	ДокументРезультат.Вывести(ШапкаТаблицы);
	
	// БИТ_ЖКХ 27.05.2014
	мКоличествоПостоянноПроживающих = 0;	
	мКоличествоПроживающих = 0;
	мКоличествоНеПроживающих= 0;	
	// БИТ_ЖКХ 27.05.2014
	
	Пока ВыборкаЗдание.Следующий() Цикл
		
		Адрес = Строка(ВыборкаЗдание.Улица) + ", д." + Строка(ВыборкаЗдание.Здание) ;
		СтрокаАдрес.Параметры.Адрес = Адрес;
		
		ДокументРезультат.Вывести(СтрокаАдрес);
		
		НомерПП = 0;
		ВыборкаЛС = ВыборкаЗдание.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаЛС.Следующий() Цикл
			
			// БИТ_ЖКХ 27.05.2014
			мКоличествоПостоянноПроживающих = 0;	
			мКоличествоПроживающих = 0;
			мКоличествоНеПроживающих= 0;	
			// БИТ_ЖКХ 27.05.2014
			
			НомерПП = НомерПП + 1;
			
			СтрокаТаблицы.Параметры.НомерПП                 = НомерПП;
			СтрокаТаблицы.Параметры.НомерЛС                 = Строка(ВыборкаЛС.ЛицевойСчет) + ", кв." + Строка(ВыборкаЛС.Квартира);
			СтрокаТаблицы.Параметры.ФИО                     = ВыборкаЛС.ОтветсвенноеЛицо;
			
			// БИТ_ЖКХ 27.05.2014
			СтрокаТаблицы.Параметры.КолвоПроживающих          = 0;
			
			Запрос2 = Новый Запрос;
			
			Запрос2.Текст = 
			"ВЫБРАТЬ РАЗРЕШЕННЫЕ
			|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
			|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
			|	ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
			|	ПроживающиеПоЛССрезПоследних.СтатусПроживания,
			|	ПроживающиеПоЛССрезПоследних.ДатаЗаписи,
			|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
			|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
			|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
			|	ПроживающиеПоЛССрезПоследних.ДоляПлощади,
			|	ПроживающиеПоЛССрезПоследних.СтатусФизЛицаДляИзменения
			|ИЗ
			|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиеПоЛССрезПоследних
			|ГДЕ
			|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
			|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
			
			// БИТ_ЖКХ 06.08.2014
			// Запрос2.УстановитьПараметр("Момент"		, КонецПериода);.
			Запрос2.УстановитьПараметр("Момент"		, КонецМесяца(КонецПериода));
			// БИТ_ЖКХ 06.08.2014
			
			Запрос2.УстановитьПараметр("ЛицевойСчет"	, ВыборкаЛС.ЛицевойСчет);
			Выборка2 = Запрос2.Выполнить().Выбрать();
			
			Пока Выборка2.Следующий() Цикл 
				
				СтатусФизЛица    = Выборка2.СтатусФизЛица; 
				
				// БИТ_ЖКХ 21.05.2014
				Если Выборка2.СтатусПроживания <> ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.НеПроживает") Тогда
					
					мКоличествоПроживающих = мКоличествоПроживающих + 1; 
					
				КонецЕсли;
				// БИТ_ЖКХ 21.05.2014
				
				СтрокаТаблицы.Параметры.КолвоЗарегистрированных = мКоличествоПроживающих;
				
				Если СтатусФизЛица.ПроживаниеВДанныйМомент и НЕ СтатусФизЛица = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан") тогда
					
					мКоличествоПостоянноПроживающих = мКоличествоПостоянноПроживающих +1;
					
					СтрокаТаблицы.Параметры.КолвоПроживающих          = мКоличествоПостоянноПроживающих;
				КонецЕсли;		
				
				Если НЕ СтатусФизЛица.ПроживаниеВДанныйМомент и НЕ СтатусФизЛица = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан") тогда	
					
					// БИТ_ЖКХ 21.05.2014
					Если Выборка2.СтатусПроживания <> ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.НеПроживает") Тогда
						мКоличествоНеПроживающих = мКоличествоНеПроживающих +1;
					КонецЕсли;			
					// БИТ_ЖКХ 21.05.2014
					
					СтрокаТаблицы.Параметры.КолвоНеПроживающих   = мКоличествоНеПроживающих;
				КонецЕсли;			
				
				Если мКоличествоНеПроживающих <> СтрокаТаблицы.Параметры.КолвоНеПроживающих Тогда
					
					СтрокаТаблицы.Параметры.КолвоНеПроживающих   = мКоличествоНеПроживающих;
					
				КонецЕсли;	
				
			КонецЦикла;		
			// БИТ_ЖКХ 27.05.2014					
			
			СтрокаТаблицы.Параметры.ОбщаяПлощадь            = ВыборкаЛС.ОбщаяПлощадь;
			СтрокаТаблицы.Параметры.ЖилаяПлощадь            = ВыборкаЛС.ЖилаяПлощадь;
			СтрокаТаблицы.Параметры.ТипЗУ                   = ВыборкаЛС.ТипЗапирающегоУстройства;
			СтрокаТаблицы.Параметры.ТипПлиты                = ВыборкаЛС.ТипПлиты;
			СтрокаТаблицы.Параметры.ОбщаяПлощадь            = ВыборкаЛС.ОбщаяПлощадь;
			
			// Переменные для посчета сумму по графам ГЦЖС.
			Водопровод            = 0;
			ВывозБытовыхОтходов   = 0;
			Газ                   = 0;
			ГорячееВодоснобжение  = 0;
			ПлатаЗаНайм           = 0;
			Электроэнергия        = 0;
			Техобслуживание       = 0;
			Отопление             = 0;
			ХолодноеВодоснабжение = 0;
			// БИТ ЖКХ 20.04.2021
			ХолодноеВодоснабжениеДляГВС = 0;

			
			// Переменные для расчета долей. 
			ОбщТО = 0;
			ДопТО = 0;
			ОснТО = 0;
			
			ОбщОТПЛ = 0;
			ДопОТПЛ = 0;
			ОснОТПЛ = 0;
			
			
			//// Переменные для выгрузки{.
			
			// Ставки.
			ВЫГРУЗКА_СтавкаТОПоОбщейПлощади = 0;
			ВЫГРУЗКА_СтавкаТОПоПроживающим  = 0;
			ВЫГРУЗКА_СтавкаНайм             = 0;
			ВЫГРУЗКА_СтавкаОтопление        = 0;
			// БИТ ЖКХ 20.04.2021
			ВЫГРУЗКА_СтавкаХолВодаДляГВС    = 0;
			ВЫГРУЗКА_СтавкаХолВода          = 0;
			ВЫГРУЗКА_СтавкаГорВода          = 0;
			ВЫГРУЗКА_СтавкаВодоотвод        = 0;
			ВЫГРУЗКА_СтавкаГаз              = 0;
			ВЫГРУЗКА_СтавкаЭлектроэнергия   = 0;
			// БИТ_ЖКХ 09.02.2016 14:51:34 Начало правки... 
			ВЫГРУЗКА_СтавкаКапРемонт		= 0;
			// БИТ_ЖКХ 09.02.2016 14:51:36 Конец правки. 
			// БИТ_ЖКХ 15.05.2017 15:08:43 Начало правки...
			ВЫГРУЗКА_СтавкаЭлектроэнергияОДН	= 0;
			ВЫГРУЗКА_СтавкаХолВодаОДН			= 0;
			ВЫГРУЗКА_СтавкаХВСдляГВСОДН			= 0;
			ВЫГРУЗКА_СтавкаВодоотводОДН			= 0;
			ВЫГРУЗКА_СтавкаПодогревОДН			= 0;
			// БИТ_ЖКХ 15.05.2017 15:08:43 Конец правки.
			
			// Начисления.
			ВЫГРУЗКА_ТОПоОбщейПлощади = 0;
			ВЫГРУЗКА_ТОПоПроживающим  = 0;
			ВЫГРУЗКА_Найм             = 0;
			ВЫГРУЗКА_Отопление        = 0;
			// БИТ ЖКХ 26.11.2020
			ВЫГРУЗКА_ОтоплениеОбщедомовое = 0;

			ВЫГРУЗКА_ХолВода          = 0;
			// БИТ ЖКХ 20.04.2021
