			Иначе
				
				ЗаявлениеОСнятии.Параметры.м 				  = "м";   
				
			КонецЕсли;	
			
			// Добавлен в новый макет вывод и разбиение СНИЛС.
			Попытка
				ЗначениеНеЧисло = Ложь;
				СНИЛС = "";
				Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.СтраховойНомерПФР) Тогда
					
					Для Значение = 1 по	СтрДлина(Выборка.РегистрируемоеЛицо.СтраховойНомерПФР) Цикл
						
						Если ЗначениеНеЧисло = Ложь Тогда
							Если ЗначениеЗаполнено(СНИЛС) Тогда
								
								ПредСНИЛС = Прав(СНИЛС,СтрДлина(СНИЛС)- 5);
								
								СНИЛС = Строка("СНИЛС" + (Число(ПредСНИЛС) +1));
							Иначе
								СНИЛС = Строка("СНИЛС" + 1);
								
							КонецЕсли;	
							
						КонецЕсли;
						
						Если Значение = 1 Тогда
							
							ЗаявлениеОСнятии.Параметры[СНИЛС] = Лев(Выборка.РегистрируемоеЛицо.СтраховойНомерПФР,Значение);	
						Иначе
							
							Если Найти("0123456789",Прав(Лев(Выборка.РегистрируемоеЛицо.СтраховойНомерПФР,Значение),1))>0 тогда
								
								ЗаявлениеОСнятии.Параметры[СНИЛС] = Прав(Лев(Выборка.РегистрируемоеЛицо.СтраховойНомерПФР,Значение),1);	
								
								ЗначениеНеЧисло = Ложь;
							Иначе
								
								ЗначениеНеЧисло = Истина;
								
							КонецЕсли;
						КонецЕсли;
						
					КонецЦикла;	
					
				КонецЕсли;
			Исключение
			КонецПопытки;
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ПочтовыйАдрес, 45, АдресРегистрации_1 , АдресРегистрации_2 );
