//HD+
// При выборе представителя УК подставляет основание полномочий из ТЧ бит_Доверенности физлица.
//
&НаКлиенте
Процедура ПредставительУКПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.ПредставительУК) Тогда
		Объект.ПредставительУКОснование = "";
		Возврат;
	КонецЕсли;
	
	Если ТипЗнч(Объект.ПредставительУК) <> Тип("СправочникСсылка.ФизическиеЛица") Тогда
		Объект.ПредставительУКОснование = "";
		Возврат;
	КонецЕсли;
	
	МассивПредставлений = ПолучитьПредставленияДоверенностейПредставителяУКНаСервере(Объект.ПредставительУК, Объект.Дата);
	
	Если МассивПредставлений.Количество() = 0 Тогда
		Объект.ПредставительУКОснование = "";
	ИначеЕсли МассивПредставлений.Количество() = 1 Тогда
		Объект.ПредставительУКОснование = МассивПредставлений[0];
	Иначе
		Объект.ПредставительУКОснование = "";
		СписокВыбора = Новый СписокЗначений;
		Для Каждого ПредставлениеДоверенности Из МассивПредставлений Цикл
			СписокВыбора.Добавить(ПредставлениеДоверенности);
		КонецЦикла;
		Оповещение = Новый ОписаниеОповещения("ПредставительУКОснованиеВыборЗавершение", ЭтотОбъект);
		ПоказатьВыборИзСписка(Оповещение, СписокВыбора);
	КонецЕсли;
	
КонецПроцедуры //HD-

