функция ПолучитьТаблицуНачисленийЗаВесьПериод()	
	
  ПервыйМесяц = НачалоМесяца(НачПериода); 	
  
  датаРасчета = КонецМесяца(НачПериода); 
  табВозврата = неопределено;
  
  пока датаРасчета <= КонецМесяца(КонПериода) цикл
	  
	  таблицаРасчета = ПолучитьТаблицуНачисленийЗаПрошлыйПериод(датаРасчета);
	  
	  если табВозврата = неопределено тогда
		 табВозврата = таблицаРасчета.Скопировать();
	  иначе
		  для каждого стр из таблицаРасчета цикл
			стрВ = табВозврата.Добавить();  
			ЗаполнитьЗначенияСвойств(стрВ, стр);
		  конеццикла;	  
	  конецесли;	  
	  датаРасчета = ДобавитьМесяц(датаРасчета, 1);
	  
  конеццикла;		
  
  возврат табВозврата;	
  
конецфункции	

функция ПолучитьТаблицуНачисленийЗаПрошлыйПериод(Период)	
	
	ДатаЗакрытияМ = КонецМесяца(Период);
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Здание");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Улица");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДокументНачисления");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДокументПоСч");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДокументПоЛьготам");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(ДатаЗакрытияМ));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Организация);
	
	ДатаЗакрытия = ДатаЗакрытияМ;
	мДатаТекст = Формат(ДатаЗакрытияМ, "ДФ='ММММ гггг'");	
	мОтветственный = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"); 
	
	мКэшЗначений = ЗаполнитьКэшЗначенийМодуль();
	
	ВыполнитьНачисления = истина;
	ВыполнитьНачисленияПоНормам = истина;

//	СтруктураНастроек.КомпоновщикНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьФорму("ФормаУправляемая").КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "ОсновныеНачисления";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	запрос = Новый Запрос;
	ТекстЛС = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Здание КАК Здание
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета";
		
	запрос.Текст = ТекстЛС;
	Результат = запрос.Выполнить().Выгрузить();
	Здания = Результат.Скопировать(); 
	Здания.Свернуть("Здание");
	СписокЗданий = Здания.ВыгрузитьКолонку("Здание");
	
	ЛС = Результат.Скопировать();
	ЛС.Свернуть("ЛицевойСчет");
	СписокЛС = Результат.ВыгрузитьКолонку("ЛицевойСчет");


	ТаблицаНачислений = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуНачислений();
	ТаблицаСчетчиков  = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
	ТаблицаРаспред    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуРаспредилений();
	ТаблицаПрожив     = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуПроживающих();
		
	бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(КонецМесяца(ДатаЗакрытияМ), 
		Организация, 
		СписокЛС, 
		СписокЗданий, 
		, 
		, 
		ТаблицаНачислений, 
		ТаблицаСчетчиков, 
		ТаблицаРаспред, 
		,
		,
		,
		мКэшЗначений.РасчетСУчетомДолейВладения,
		мКэшЗначений.УменьшениеНормыЛьготыВПределахФакта, 
		мКэшЗначений.НачислениеСУчетомДнейПроживания, 
		ТаблицаПрожив, 
		,
		мКэшЗначений.РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
		мКэшЗначений.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика);	

	возврат ТаблицаНачислений;
	
КонецФункции   

&НаСервере
функция ЗаполнитьКэшЗначенийМодуль()
	
	КэшированныеЗначения = Новый Структура;
	
	// Перечисления.
	
	КэшированныеЗначения.Вставить("РасчетСУчетомДолейВладения"                           , Ложь);
	КэшированныеЗначения.Вставить("УменьшениеНормыЛьготыВПределахФакта"                  , Ложь);
	КэшированныеЗначения.Вставить("НачислениеСУчетомДнейПроживания"                      , Ложь);
	КэшированныеЗначения.Вставить("ОбщедомовыеРасходыВГрафеНачисления"                   , Ложь);
	КэшированныеЗначения.Вставить("СчетчикиПодкрутка"                                    , Ложь);
	КэшированныеЗначения.Вставить("ЛьготаПерсонифицированная"                            , Ложь);
	КэшированныеЗначения.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	КэшированныеЗначения.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	КэшированныеЗначения.Вставить("УчитыватьНачисленияПоГрупповымСчетчикам"              , Ложь);
	КэшированныеЗначения.Вставить("УчитыватьПерерасчет"                                  , Ложь);
	КэшированныеЗначения.Вставить("СчетАбонента"                                         , Неопределено);
	КэшированныеЗначения.Вставить("Контрагент"                                            , Неопределено);
	КэшированныеЗначения.Вставить("ФормироватьАктИРеализациюПоКонтрагенту"                , Ложь);
	КэшированныеЗначения.Вставить("ФормироватьАктИРеализациюПоКонтрагентуОтветственныхЛиц", Ложь);
	
	КэшированныеЗначения.Вставить("ДокументУчетаСобственныхУслуг", Неопределено);
	
	КэшированныеЗначения.Вставить("ПорядокРаспределенияРасходовНаОказаниеУслуг", Неопределено);
	
	КэшированныеЗначения.Вставить("ПоПлановымЦенамИВыручке", Перечисления.бит_ПорядокРаспределенияРасходовНаОказаниеУслуг.ПоПлановымЦенамИВыручке);
	
	КэшированныеЗначения.Вставить("ЗначениеДаты"                                         , Неопределено);
	
	возврат КэшированныеЗначения;
КонецФункции


функция ПересчитатьНачисления ()
	
	    Запрос = Новый Запрос;
		Запрос.Текст ="ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СписокУслуг.Услуга
		|ПОМЕСТИТЬ СписокУслуг
		|ИЗ
		|	&СписокУслуг КАК СписокУслуг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаНачислений.ПериодНачисления КАК ПериодНачисления,
		|	СписокУслуг.Услуга,
		|	ТаблицаНачислений.Сумма1 КАК Сумма
		|ИЗ
		|	СписокУслуг КАК СписокУслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КОНЕЦПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК ПериодНачисления,
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ,
		|			СУММА(ЕСТЬNULL(ВЫБОР
		|						КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
		|							ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|					КОНЕЦ, 0)) КАК Сумма1
		|		ИЗ
		|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачПериода, &КонПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОбороты
		|		
		|		СГРУППИРОВАТЬ ПО
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
		|			КОНЕЦПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ)) КАК ТаблицаНачислений
		|		ПО СписокУслуг.Услуга = ТаблицаНачислений.УслугаЖКХ
		|ИТОГИ ПО
		|	ПериодНачисления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СписокУслуг";
		
		
		Запрос.УстановитьПараметр("НачПериода"            ,Новый Граница(НачалоМесяца(НачПериода), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КонПериода"            ,Новый Граница(КонецМесяца(КонПериода+200), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ЛицевойСчет"           ,ЛицевойСчет);
		Запрос.УстановитьПараметр("СписокУслуг"           ,СписокУслуг);
		возврат  Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ПериодНачисления");		
	
конецфункции
	
функция ПереСчитатьНачисленияГрупповые()
	СписокУС = Новый ТаблицаЗначений;
		СписокУС = СписокУслуг.Выгрузить();
