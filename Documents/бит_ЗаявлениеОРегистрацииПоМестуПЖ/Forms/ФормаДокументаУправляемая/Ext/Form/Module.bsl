	Адрес = ПолучитьАдресОткудаПрибыл(Проживающий);
	
	Если Адрес <> Неопределено Тогда
		Приемник.Значение = Адрес[0].Значение;
		Приемник.Представление = Адрес[0].Представление;	
	Иначе 
		Приемник.Значение = "";
		Приемник.Представление = "";
	КонецЕсли;
	
