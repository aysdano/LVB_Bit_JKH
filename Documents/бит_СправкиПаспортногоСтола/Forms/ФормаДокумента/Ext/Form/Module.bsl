&НаСервере
Процедура ЗаполнитьДанныеПроживающегоНаСервере(ФизЛицо)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_ПроживающиеПоЛС.ФизЛицо КАК Проживающий,
	|	бит_ПроживающиеПоЛС.СтатусФизЛица КАК СтатусФизЛица,
	|	бит_ПроживающиеПоЛС.СтепеньРодства КАК СтепеньРодства,
	|	бит_ПроживающиеПоЛС.СтатусПроживания КАК СтатусПроживания,
	|	бит_ПроживающиеПоЛС.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ПроживающиеПоЛС.лб_ДатаВыпискиДляФЛС КАК ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛС.лб_ДоляПлощадиСтрокой КАК ДоляПлощади,
	|	бит_ПроживающиеПоЛС.лб_СтрокаРодствДляФЛС КАК лб_СтрокаРодствДляФЛС,
	|	бит_ПроживающиеПоЛС.ФизЛицо.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
	|ГДЕ
	|	бит_ПроживающиеПоЛС.ЛицевойСчет = &ЛицевойСчет
	|	И бит_ПроживающиеПоЛС.ФизЛицо = &ФизЛицо
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатусФизЛица УБЫВ,
	|	ДатаРегистрации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ПараметрыОтбора = Новый Структура;
		ПараметрыОтбора.Вставить("ФизЛицо", ФизЛицо);
		
		НайденныеСтроки = Объект.ТаблицаПроживающих.НайтиСтроки(ПараметрыОтбора);
		
		Для каждого Строка Из НайденныеСтроки Цикл
			Строка.ФизЛицо = Выборка.Проживающий;
			Строка.бит_СтепеньРодства = Выборка.СтепеньРодства;
			Строка.бит_ДатаРегистрации = Выборка.ДатаРегистрации;
			Строка.бит_ДатаСнятияСРегистрации = СтрокаВДату(Выборка.ДатаСнятияСРегистрации);
			Строка.бит_СтатусФизЛица = Выборка.СтатусФизЛица;
		КонецЦикла; 	
		
	КонецЦикла; 	
	
КонецПроцедуры

&НаСервере
Процедура бит_ЗаполнитьПроживающихПоЛицевомуСчету()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("Момент", Объект.Дата);
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК Проживающий,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры КАК ВладелецКвартиры,
	|	ПроживающиеПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК ДоляПлощади,
	|	ПроживающиеПоЛССрезПоследних.лб_СтрокаРодствДляФЛС КАК лб_СтрокаРодствДляФЛС,
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	ПроживающиеПоЛССрезПоследних.бит_ПомещенВАрхив КАК бит_ПомещенВАрхив
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И НЕ лб_ИгнорироватьПериодВКопииФЛС) КАК ПроживающиеПоЛССрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	СтатусФизЛица УБЫВ,
	|	ДатаРегистрации";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Проживающий <> Объект.Проживающий Тогда
			
			Строка = Объект.ТаблицаПроживающих.Добавить();
			Строка.ФизЛицо = Выборка.Проживающий;
			Строка.бит_СтепеньРодства = Выборка.СтепеньРодства;
			Строка.бит_ДатаРегистрации = Выборка.ДатаРегистрации;
			Строка.бит_ДатаСнятияСРегистрации = СтрокаВДату(Выборка.ДатаСнятияСРегистрации);
			Строка.бит_СтатусФизЛица = Выборка.СтатусФизЛица;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция СтрокаВДату(Знач ДатаСтрока) Экспорт
	
	ПозицияПробела = СтрНайти(ДатаСтрока, " ", НаправлениеПоиска.СНачала);
	Если ПозицияПробела > 0 Тогда
		ДатаСтрока = Лев(ДатаСтрока, ПозицияПробела - 1);
	КонецЕсли;
	ДатаСтрока = СокрЛП(СтрЗаменить(ДатаСтрока, ".", ""));
	ДатаСтрока = Сред(ДатаСтрока, 5) + Сред(ДатаСтрока, 3, 2) + Лев(ДатаСтрока, 2);
	Если СтрДлина(ДатаСтрока) = 6 Тогда
		ДатаСтрока = "20" + ДатаСтрока;
	КонецЕсли;
	
	ОписаниеТипа = Новый ОписаниеТипов("Дата");
	Результат    = ОписаниеТипа.ПривестиЗначение(ДатаСтрока);
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Функция бит_ЗаполнитьДатуСмерти()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизЛицо", Объект.Проживающий);
