// Процедура распределяет суммы документа.
// 
Процедура РаспределениеСуммПоВводНачОстатков(Дата, Организация, ТаблицаЛС, КоммунальныеУслуги) Экспорт
	
	КоммунальныеУслуги.Очистить();
	
	СписокЛС     = Новый Массив;
	СписокЗданий = НОвый Массив;
	
	Для каждого Строка Из ТаблицаЛС Цикл
		
		СписокЛС.Добавить(Строка.ЛицевойСчет);
		СписокЗданий.Добавить(Строка.ЛицевойСчет.Здание);
		
	КонецЦикла;
	
	ПарамтерыЖКХ = Новый Структура;
	ПарамтерыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	// БИТ_ЖКХ_04102013_начало_изменений
	ПарамтерыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);	
	// БИТ_ЖКХ_04102013_окончание_изменений
	ПарамтерыЖКХ.Вставить("НачислениеСУчетомДнейПроживания"                      , Ложь);
	
	ПолучитьНастройкиЖКХ(Дата, Организация, ПарамтерыЖКХ);
	
	ТаблицаНачислений = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуНачислений();
	ТаблицаСчетчиков  = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
	ТаблицаРаспред    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуРаспредилений();
	ТаблицаПрож       = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуПроживающих();
	
	бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(КонецДня(Дата),
	Организация,
	СписокЛС,
	СписокЗданий,
	,
	Истина,
	ТаблицаНачислений,
	ТаблицаСчетчиков,
	ТаблицаРаспред,
	,
	,
	Истина,
	,
	,
	ПарамтерыЖКХ.НачислениеСУчетомДнейПроживания,
	ТаблицаПрож,
	,
	// БИТ_ЖКХ_04102013_начало_изменений
	// ПарамтерыЖКХ.РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика);.
	ПарамтерыЖКХ.РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика,
	ПарамтерыЖКХ.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика);
	// БИТ_ЖКХ_04102013_окончание_изменений
	
	ТаблицаЛС.Свернуть("ЛицевойСчет", "Сумма");
	
	ТаблицаДляРасчета = КоммунальныеУслуги.СкопироватьКолонки();
	
	Для каждого СтрокаШаблона Из ТаблицаЛС Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет", СтрокаШаблона.ЛицевойСчет);
		
		ТаблицаДляРасчета.Очистить();
		
		МассивСтрок = ТаблицаНачислений.НайтиСтроки(Отбор);
		
		Для каждого Строка Из МассивСтрок Цикл
			
			НоваяСтрока = ТаблицаДляРасчета.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
		КонецЦикла;
		
		// БИТ_ЖКХ 01.09.2014
		ИтогОплата = 0;
		Для каждого строкамассива из МассивСтрок Цикл
			ИтогОплата = ИтогОплата + строкамассива.Оплата;
		КонецЦикла;
		
		// РаспределитьСуммуДокумента(ТаблицаДляРасчета,Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам,СтрокаШаблона.Сумма);.
		РаспределитьСуммуДокумента(ТаблицаДляРасчета,Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам,СтрокаШаблона.Сумма,Ложь,ИтогОплата);
		// БИТ_ЖКХ 01.09.2014
		
		ТаблицаДляРасчета.Сортировать("Приоритет Возр");
		
		Для каждого Строка Из ТаблицаДляРасчета Цикл
			
			НоваяСтрока = КоммунальныеУслуги.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры

