#Область ПроцедурыИФункцииФормированияQRКода

// Процедуры печати QR-кода.
Процедура НапечататьQRКод(ТабДок, ОбластьQRКод = Неопределено)
	
	Если МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент 
		ИЛИ МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32
		ИЛИ МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК43
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК43 
		ИЛИ МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924
		ИЛИ МакетКВ.ОсновнойВариант = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ
		ИЛИ МакетКВ = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ Тогда 
		СведенияОПолучателе   = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ЭтотОбъект.ПолучательПлатежа, ЭтотОбъект.ДатаПечатиКвитанций, ЭтотОбъект.РС);
	Иначе	
		СведенияОПолучателе   = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ЭтотОбъект.Организация, ЭтотОбъект.ДатаПечатиКвитанций, ЭтотОбъект.РС);
	КонецЕсли;
	
	ФИО		= Строка(мСтруктураДанных.ЛицевойСчетФИО);
	Фамилия	= ВыделитьСлово(ФИО);
	Имя		= ВыделитьСлово(ФИО);
	Отчество= ВыделитьСлово(ФИО);
	
	РеквизитыПлатежа					= НоваяСтруктураРеквизитыПлатежаУФЭБС();
	РеквизитыПлатежа.ФамилияПлательщика	= Фамилия;
	РеквизитыПлатежа.ИмяПлательщика		= Имя;
	РеквизитыПлатежа.ОтчествоПлательщика= Отчество;
	РеквизитыПлатежа.ИННПлательщика		= ?(ЗначениеЗаполнено(мСтруктураДанных.ЛицевойСчетФИО)
												,ОбщегоНазначения.ЗначениеРеквизитаОбъекта(мСтруктураДанных.ЛицевойСчетФИО,"ИНН")
												,"");
	РеквизитыПлатежа.АдресПлательщика	= мСтруктураДанных.ЛицевойСчетАдрес;
	
	Если НЕ ЗначениеЗаполнено(СведенияОПолучателе.ПолноеНаименование) Тогда
		РеквизитыПлатежа.ТекстПолучателя = мСтруктураДанных.ПолучательПлатежа;
	Иначе
		Если ИспользоватьСокращенноеНаименование Тогда
			РеквизитыПлатежа.ТекстПолучателя = СведенияОПолучателе.СокращенноеНаименование;
		Иначе	
			РеквизитыПлатежа.ТекстПолучателя = СведенияОПолучателе.ПолноеНаименование;
		КонецЕсли;
	КонецЕсли;
	
	РеквизитыПлатежа.НомерСчетаПолучателя		= СведенияОПолучателе.НомерСчета;
	РеквизитыПлатежа.НаименованиеБанкаПолучателя= СведенияОПолучателе.Банк;
	РеквизитыПлатежа.БИКБанкаПолучателя			= СведенияОПолучателе.БИК;
	РеквизитыПлатежа.СчетБанкаПолучателя		= СведенияОПолучателе.КоррСчет;
	
	//23.07.2019
	если ИспользоватьSumCПени = Истина тогда
	 РеквизитыПлатежа.СуммаЧислом				= мСтруктураДанных.ИтогоКОплатеСУчетомПени;
	иначе	
	 РеквизитыПлатежа.СуммаЧислом				= мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты;
	конецесли; 
	РеквизитыПлатежа.ИННПолучателя				= СведенияОПолучателе.ИНН;
	РеквизитыПлатежа.КПППолучателя				= СведенияОПолучателе.КПП;
	
	Если ЗначениеЗаполнено(НазначениеПлатежа) Тогда
		РеквизитыПлатежа.НазначениеПлатежа = НазначениеПлатежа;
	Иначе
		РеквизитыПлатежа.НазначениеПлатежа = "Оплата ЖКУ";
	КонецЕсли;
	
	РеквизитыПлатежа.ВидПлатежа						= сг_КодУслугиВСистемеГород;
	РеквизитыПлатежа.НомерЛицевогоСчетаПлательщика	= мСтруктураДанных.ЛицевойСчет;
	
	Если ЗначениеЗаполнено(ФорматДаты) Тогда
		Попытка
			РеквизитыПлатежа.ПериодОплаты = Формат(мСтруктураДанных.Дата, "ДФ='" + ФорматДаты + "'");
		Исключение
			ТекстСообщения = Нстр("ru = 'Ошибка в настройках формата даты для QR-кода (Настройка параметров ЖКХ).'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ТабДок.Очистить();
			Возврат;
		КонецПопытки;
		Если СтрДлина(РеквизитыПлатежа.ПериодОплаты) > 8 Тогда
			ТекстСообщения = Нстр("ru = 'Ошибка в настройках формата даты для QR-кода (Настройка параметров ЖКХ).'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ТабДок.Очистить();
			Возврат;
		КонецЕсли;
	Иначе
		РеквизитыПлатежа.ПериодОплаты = Формат(мСтруктураДанных.Дата, "ДФ='ММгг'");
	КонецЕсли;
	
	РеквизитыПлатежа.СуммаСтраховки = ?(ЗначениеЗаполнено(мСтруктураДанных.ИтогПени),  Формат(мСтруктураДанных.ИтогПени * 100, "ЧГ="), "000");
	
	МассивРеквизитов =  ТаблицаРеквизитовQRКода.Выгрузить(Новый Структура("Выводить", Истина)).ВыгрузитьКолонку("Реквизит");
	Для Каждого Элт Из РеквизитыПлатежа Цикл
		Если МассивРеквизитов.Найти(Элт.Ключ) = Неопределено Тогда
			РеквизитыПлатежа[Элт.Ключ] = Неопределено;
		КонецЕсли;	
	КонецЦикла;
	
	Попытка      
	 // БИТ ЖКХ 12.03.2021
	 РеквизитыПлатежа.НазначениеПлатежа = РеквизитыПлатежа.НазначениеПлатежа + " " +
	  // БИТ ЖКХ 1.04.2021
      //РеквизитыПлатежа.АдресПлательщика + "; " +
          мСтруктураДанных.ЛицевойСчет + " "; 
	исключение
	конецпопытки;	  
	// QR-код.
	QRСтрока = УправлениеПечатью.ФорматнаяСтрокаУФЭБС(РеквизитыПлатежа);
	
	Если НЕ ПустаяСтрока(QRСтрока) Тогда // Возникли ошибки
		
		ДанныеQRКода = УправлениеПечатью.ДанныеQRКода(QRСтрока, 0, 190);
		Если НЕ ТипЗнч(ДанныеQRКода) = Тип("ДвоичныеДанные") Тогда
			ТекстСообщения = Нстр("ru = 'Не удалось сформировать QR-код для документа.
										|Технические подробности см. в журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		Если НЕ ОбластьQRКод = Неопределено Тогда
			Попытка
				ОбластьQRКод.Рисунки.QRКод.Картинка =  Новый Картинка(ДанныеQRКода);
				ТабДок.Вывести(ОбластьQRКод);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			Для Каждого Рис Из ТабДок.Рисунки Цикл
				Если НЕ СтрНайти(НРег(Рис.Имя), "qrкод") = 0 Тогда
					Рис.Картинка = Новый Картинка(ДанныеQRКода);
				КонецЕсли;
			КонецЦикла;	
		Исключение
		КонецПопытки
	Иначе
		 УбратьQRКод(ТабДок);
	КонецЕсли;
	
КонецПроцедуры

Функция НоваяСтруктураРеквизитыПлатежаУФЭБС()
	
	// Входящие данные функци УправлениеПечатью.ФорматнаяСтрокаУФЭБС().
	Возврат Новый Структура(
	// Обязательные поля структуры.
	"ТекстПолучателя,
	|НомерСчетаПолучателя,
	|НаименованиеБанкаПолучателя,
	|БИКБанкаПолучателя,
	|СчетБанкаПолучателя,
	// Дополнительные поля структуры.
	|СуммаЧислом,
	|НазначениеПлатежа,
	|ИННПолучателя,
	|ИННПлательщика,
	// |СтатусСоставителя,
	|КПППолучателя,
	// |КодБК,
	// |КодОКТМО,
	// |ПоказательОснования,
	// |ПоказательПериода,
	// |ПоказательНомера,
