		СписокЛС = СписокУслуг.Выгрузить();
		СписокЛС.Свернуть("ЛицевойСчет");
		
		Запрос = Новый Запрос;
		Запрос.Текст =
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	СписокУслуг.Услуга
		|ПОМЕСТИТЬ СписокУслуг
		|ИЗ
		|	&СписокУслуг КАК СписокУслуг
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	ТаблицаНачислений.ПериодНачисления КАК ПериодНачисления,
		|	ТаблицаНачислений.ЛицевойСчет,
		|	СписокУслуг.Услуга,
		|	ТаблицаНачислений.Сумма1 КАК Сумма
		|ИЗ
		|	СписокУслуг КАК СписокУслуг
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
		|			КОНЕЦПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК ПериодНачисления,
		|			бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ,
		|			СУММА(ЕСТЬNULL(ВЫБОР
		|						КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
		|							ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|					КОНЕЦ, 0)) КАК Сумма1
		|		ИЗ
		|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачПериода, &КонПериода, Регистратор, ЛицевойСчет В (&ЛицевойСчет)) КАК бит_НачисленияПоУслугамЖКХОбороты
		|		
		|		СГРУППИРОВАТЬ ПО
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
		|			КОНЕЦПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ),
		|			бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет) КАК ТаблицаНачислений
		|		ПО СписокУслуг.Услуга = ТаблицаНачислений.УслугаЖКХ
		|ИТОГИ ПО
		|	ПериодНачисления
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СписокУслуг";
		
		Запрос.УстановитьПараметр("НачПериода"            ,Новый Граница(НачалоМесяца(НачПериода), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("КонПериода"            ,Новый Граница(КонецМесяца(КонПериода+200), ВидГраницы.Включая));
		Запрос.УстановитьПараметр("ЛицевойСчет"           ,СписокЛС);
		Запрос.УстановитьПараметр("СписокУслуг"           ,СписокУС);
		возврат Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам,"ПериодНачисления");

конецфункции	
// Процедура выполняет заполнение табличной части.
//
Процедура ЗаполнитьПоЧеку(Колонки = Неопределено) Экспорт
	
	ТабДляЗаполнения = ЧекККМ.Услуги.Выгрузить();
	СписокУслуг.Загрузить(ТабДляЗаполнения);
	
	Для каждого Строка Из СписокУслуг Цикл
		
		Строка.ЛицевойСчет = ЧекККМ.ЛицевойСчет;
		
	КонецЦикла; 
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(СписокУслуг, Колонки, ЧекККМ.ЛицевойСчет, Организация , КонецМесяца(Дата));
	
КонецПроцедуры

// Процедура выполняет заполнение табличной части.
//
Процедура ЗаполнитьПоОплате(Колонки = Неопределено) Экспорт
	
	СписокУслуг.Очистить();
	// БИТ ЖКХ 16.07.2020
    СписокУслугПеня.Очистить();
	ТабДляЗаполнения = ОплатаКУ.СписокУслуг.Выгрузить();
	
	Если НЕ ЛицевойСчет.Пустая() Тогда
		
		МассивСтрок = ТабДляЗаполнения.НайтиСтроки(Новый Структура("ЛицевойСчет", ЛицевойСчет));
		
		Для каждого СтрокаТаблицы Из МассивСтрок Цикл
			
			НоваяСтрока = СписокУслуг.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
		КонецЦикла; 
		
		МассивСтрок = ТабДляЗаполнения.НайтиСтроки(Новый Структура("ЛицевойСчет", ЛицевойСчет));
		
		Для каждого СтрокаТаблицы Из МассивСтрок Цикл
			
			НоваяСтрока = СписокУслугПеня.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
		КонецЦикла; 

	Иначе
		СписокУслуг.Загрузить(ТабДляЗаполнения);	
		// БИТ ЖКХ 15.07.2020
		СписокУслугПеня.Загрузить(ТабДляЗаполнения);
	КонецЕсли; 
	
	СписокЛС = СписокУслуг.ВыгрузитьКолонку("ЛицевойСчет");
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(СписокУслуг, Колонки, СписокЛС, Организация , КонецМесяца(Дата));
	// БИТ ЖКХ 17.07.2020
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(СписокУслугПеня, Колонки, СписокЛС, Организация , КонецМесяца(Дата));
	
	ЗаполнитьСубконтоКУ();
	// БИТ ЖКХ 21.07.2020
	ЗаполнитьСубконтоКУПеня();
	
КонецПроцедуры

// БИТ ЖКХ 21.07.2020
Процедура ЗаполнитьСубконтоКУПеня()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ОплатаКУСписокЛС.СубконтоКУ1,
	|	бит_ОплатаКУСписокЛС.СубконтоКУ2
	|ПОМЕСТИТЬ ВсеСубконтоКУ
	|ИЗ
	|	Документ.бит_ОплатаКУ.СписокЛС КАК бит_ОплатаКУСписокЛС
	|ГДЕ
	|	бит_ОплатаКУСписокЛС.ЛицевойСчет = &ЛицевойСчет
	|	И бит_ОплатаКУСписокЛС.Ссылка = &ОплатаКУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НастройкаПараметровЖКХСрезПоследних.ТранзитныйСчетОплаты
	|ПОМЕСТИТЬ ВТ_ТранзитныйСч
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Момент, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеСубконтоКУ.СубконтоКУ1,
	|	ВсеСубконтоКУ.СубконтоКУ2,
	|	ВТ_ТранзитныйСч.ТранзитныйСчетОплаты
	|ИЗ
	|	ВсеСубконтоКУ КАК ВсеСубконтоКУ,
	|	ВТ_ТранзитныйСч КАК ВТ_ТранзитныйСч";
	
	ДатаЗаполнения = ?(ЗначениеЗаполнено(Дата), КонецМесяца(Дата), ТекущаяДата());
	
	Запрос.УстановитьПараметр("Момент",		  ДатаЗаполнения);
	Запрос.УстановитьПараметр("Организация",  Организация);
	Запрос.УстановитьПараметр("ЛицевойСчет",  ЛицевойСчет);
	Запрос.УстановитьПараметр("ОплатаКУ",	  ОплатаКУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СоответствиеСубконтоКУ = Новый Соответствие;
	Если Выборка.Следующий() Тогда
		Для Каждого Стр Из СписокУслугПеня Цикл
			Стр.СчетКУ      = Выборка.ТранзитныйСчетОплаты;
			Стр.СубконтоКУ1 = Выборка.СубконтоКУ1;
			Стр.СубконтоКУ2 = Выборка.СубконтоКУ2;
			Стр.СубконтоКУ3 = Неопределено;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры


Процедура ЗаполнитьСубконтоКУ()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ОплатаКУСписокЛС.СубконтоКУ1,
	|	бит_ОплатаКУСписокЛС.СубконтоКУ2
	|ПОМЕСТИТЬ ВсеСубконтоКУ
	|ИЗ
	|	Документ.бит_ОплатаКУ.СписокЛС КАК бит_ОплатаКУСписокЛС
	|ГДЕ
	|	бит_ОплатаКУСписокЛС.ЛицевойСчет = &ЛицевойСчет
	|	И бит_ОплатаКУСписокЛС.Ссылка = &ОплатаКУ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НастройкаПараметровЖКХСрезПоследних.ТранзитныйСчетОплаты
	|ПОМЕСТИТЬ ВТ_ТранзитныйСч
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Момент, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВсеСубконтоКУ.СубконтоКУ1,
	|	ВсеСубконтоКУ.СубконтоКУ2,
	|	ВТ_ТранзитныйСч.ТранзитныйСчетОплаты
	|ИЗ
	|	ВсеСубконтоКУ КАК ВсеСубконтоКУ,
	|	ВТ_ТранзитныйСч КАК ВТ_ТранзитныйСч";
	
	ДатаЗаполнения = ?(ЗначениеЗаполнено(Дата), КонецМесяца(Дата), ТекущаяДата());
	
	Запрос.УстановитьПараметр("Момент",		  ДатаЗаполнения);
	Запрос.УстановитьПараметр("Организация",  Организация);
	Запрос.УстановитьПараметр("ЛицевойСчет",  ЛицевойСчет);
	Запрос.УстановитьПараметр("ОплатаКУ",	  ОплатаКУ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	СоответствиеСубконтоКУ = Новый Соответствие;
	Если Выборка.Следующий() Тогда
		Для Каждого Стр Из СписокУслуг Цикл
			Стр.СчетКУ      = Выборка.ТранзитныйСчетОплаты;
			Стр.СубконтоКУ1 = Выборка.СубконтоКУ1;
			Стр.СубконтоКУ2 = Выборка.СубконтоКУ2;
			Стр.СубконтоКУ3 = Неопределено;
		КонецЦикла;	
	КонецЕсли;
	
КонецПроцедуры

// Выполняет расчет начислений общедомовых расходов.
//
Процедура РачитатьОбщедомовыеРасходы() Экспорт
	
	ЛицевыеСчета.Очистить();
	
	ОбновитьНастройкиЖКХ();
	
	
	Если мГрафаНачисления Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Для организации: " + Организация +" начисления общедомовых расходов ведутся в графе начисления.");
		
		Возврат;
		
	КонецЕсли; 
	
	ТаблицаОбщедомовыеНачисления = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуОбщедомовыхРасходов();
	
	бит_РасчетыПоКоммунальнымУслугам.РасчитатьНачисленияПоОбщедомовымРасходам(КонецДня(Дата)
	,НачПериода
	,КонПериода
	,Организация
	,ТаблицаОбщедомовыеНачисления
	,мУчитыватьНачисленияПоГрупповымСчетчикам
	,мУчитыватьПерерасчет);
	
	бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаОбщедомовыеНачисления);
	
	СписокЛС = ТаблицаОбщедомовыеНачисления.ВыгрузитьКолонку("ЛицевойСчет");
	Колонки  = ТаблицаОбщедомовыеНачисления.Колонки;
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ТаблицаОбщедомовыеНачисления, Колонки, СписокЛС, Организация , Дата);
	
	Для каждого СтрокаТаблицы Из ТаблицаОбщедомовыеНачисления Цикл
		
		НоваяСтрока = ЛицевыеСчета.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
		НоваяСтрока.Сумма = СтрокаТаблицы.Начислено;
		НоваяСтрока.Объем = ОКР(?(СтрокаТаблицы.Тариф = 0, 0 ,НоваяСтрока.Сумма/СтрокаТаблицы.Тариф),4);
		
	КонецЦикла; 
	
	РассчитатьОбъем(ТаблицаОбщедомовыеНачисления);
	
КонецПроцедуры

