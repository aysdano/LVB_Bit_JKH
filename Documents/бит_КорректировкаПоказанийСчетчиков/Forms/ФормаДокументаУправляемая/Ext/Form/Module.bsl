&НаКлиенте
Процедура УлицаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если мКэшЗначений.Улица <> ВыбранноеЗначение Тогда
		Объект.Здание = ПредопределенноеЗначение("Справочник.бит_СписокЗданий.ПустаяСсылка");
	КонецЕсли;
	Объект.Улица = ВыбранноеЗначение;
	мКэшЗначений.Улица = ВыбранноеЗначение;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗданиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(Объект.Улица) Тогда
		СтандартнаяОбработка = Ложь;
		Отбор = Новый Структура;
		Отбор.Вставить("Улица", Объект.Улица);
		ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоля

&НаКлиенте
Процедура КорректировкаПоказанийПриАктивизацииСтроки(Элемент)
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено Тогда
		
		Если НЕ ЗначениеЗаполнено(ТекСтрока.ДатаНачала) Тогда
			
			ТекСтрока.ДатаНачала = НачалоМесяца(Объект.Дата);
			ТекСтрока.Период     = бит_РаботаСДиалогами.ДатаКакМесяцПредставление(ТекСтрока.ДатаНачала);
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если Объект.КорректировкаПоказаний.Количество() > 0 Тогда
		
		Если мКэшЗначений.Свойство("ТекущийСчетчик") = Ложь Тогда
			
			мКэшЗначений.Вставить("ТекущийСчетчик",ТекСтрока.Счетчик);
			
		Иначе
			
			мКэшЗначений.ТекущийСчетчик = ТекСтрока.Счетчик;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПриИзменении(Элемент)
	
	НуженПерерасчет = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПередУдалением(Элемент, Отказ)
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("ЛицевойСчет", ТекСтрока.ЛицевойСчет);
	Отбор.Вставить("Счетчик"    , ТекСтрока.Счетчик);
	
	Если ТекСтрока.Многотарифный Тогда
		
		Отбор.Вставить("Услуга", ТекСтрока.Услуга);
		
	КонецЕсли; 
	
	УдалитьСписокТаблицыУслугНаСервере(Отбор);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекущиеДанные = Элементы.КорректировкаПоказаний.ТекущиеДанные;
		
		ТекущиеДанные.ИсточникПоказаний = ПредопределенноеЗначение("Перечисление.бит_ИсточникПоказаний.Население");
		ТекущиеДанные.Счетчик           = Неопределено;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	ТекДанные = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущаяСтрока;
	
	Если ТекДанные.КорректировочныеПоказания = 0 Тогда
		
		мМассивСтрок.Добавить(ТекСтрока);  
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПериодПриИзменении(Элемент)
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	ТекСтрока.Период = бит_РаботаСДиалогами.ДатаКакМесяцПредставление(ТекСтрока.ДатаНачала);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПериодНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	ПериодРегистрации = бит_РаботаСДиалогами.НачалоВыбораИзСпискаПредставленияПериодаРегистрацииФункция(ТекСтрока.Период, СтандартнаяОбработка, ТекСтрока.ДатаНачала, ЭтаФорма);
	
	ТекСтрока.ДатаНачала = ПериодРегистрации;
	
	ТекСтрока.Период = бит_РаботаСДиалогами.ДатаКакМесяцПредставление(ТекСтрока.ДатаНачала);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПериодОчистка(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПериодРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	ТекСтрока.ДатаНачала = ДобавитьМесяц(ТекСтрока.ДатаНачала, Направление);
	
	ТекСтрока.Период = бит_РаботаСДиалогами.ДатаКакМесяцПредставление(ТекСтрока.ДатаНачала);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийЛицевойСчетПриИзменении(Элемент)
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	ТекСтрока.НачисленияЗаПериод = 0;
	ТекСтрока.НачальныеПоказания = 0;
	ТекСтрока.Счетчик            = Неопределено;
	ТекСтрока.Услуга             = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПериодАвтоПодбор(Элемент, Текст, ДанныеВыбора, Ожидание, СтандартнаяОбработка)
	
	бит_РаботаСДиалогами.ДатаКакМесяцАвтоПодборТекста(Текст, ДанныеВыбора, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийСчетчикНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	СписокСчетчиков = ПолучитьСписокСчетчиков(ТекСтрока.ЛицевойСчет, Объект.Дата);
	
	ВыбранныйЭлемент = Неопределено;
	
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("КорректировкаПоказанийСчетчикНачалоВыбораИзСпискаЗавершение", ЭтотОбъект, Новый Структура("ТекСтрока", ТекСтрока)), СписокСчетчиков, Элементы.КорректировкаПоказанийСчетчик);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийСчетчикНачалоВыбораИзСпискаЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
	
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;
	
	ВыбранныйЭлемент = ВыбранныйЭлемент1;
	
	Если Не ВыбранныйЭлемент = Неопределено Тогда
		
		Если НЕ ВыбранныйЭлемент.Значение = Неопределено Тогда
			
			Если мКэшЗначений.ТекущийСчетчик <> ВыбранныйЭлемент.Значение Тогда
				
				ТекСтрока.НачальныеПоказания = 0;
				ТекСтрока.Услуга             = Неопределено;
				ТекСтрока.ИсточникПоказаний  = ПредопределенноеЗначение("Перечисление.бит_ИсточникПоказаний.Население");
				ТекСтрока.ТипДокумента       = "";
				ТекСтрока.ДатаОтПоказаний    = Неопределено;
				ТекСтрока.НачисленияЗаПериод = 0;
				
			КонецЕсли;
			
			Если НЕ ТекСтрока = Неопределено И НЕ ТекСтрока.Счетчик = ВыбранныйЭлемент.Значение Тогда
				
				Многотарифный = МноготарифныйСчетчик(ТекСтрока.ЛицевойСчет, ВыбранныйЭлемент.Значение, КонецДня(Объект.Дата));
				
				ТекСтрока.Многотарифный = Многотарифный;
				
				Отбор = Новый Структура;
				
				Отбор.Вставить("ЛицевойСчет", ТекСтрока.ЛицевойСчет);
				Отбор.Вставить("Счетчик"    , ТекСтрока.Счетчик);
				
				СтрокиУслуг = Объект.ТаблицаУслуг.НайтиСтроки(Отбор);
				
				Для каждого Строка Из СтрокиУслуг Цикл
					
					Объект.ТаблицаУслуг.Удалить(Строка);
					
				КонецЦикла; 
				
				Если НЕ Многотарифный Тогда
					
					ЗаполнитьТаблицуУслуг(ТекСтрока.ЛицевойСчет, ВыбранныйЭлемент.Значение, КонецДня(Объект.Дата));
					
				КонецЕсли; 				
				
			КонецЕсли;
			
			Если ВыбранныйЭлемент <> Неопределено Тогда
				
				ТекСтрока.Счетчик = ВыбранныйЭлемент.Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийУслугаНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СписокУслуг = ПолучитьСписокУслуг(ТекСтрока.ЛицевойСчет, ТекСтрока.Счетчик, КонецДня(Объект.Дата));
		
		ВыбранныйЭлемент = Неопределено;

		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("КорректировкаПоказанийУслугаНачалоВыбораИзСпискаЗавершение", ЭтотОбъект, Новый Структура("ТекСтрока", ТекСтрока)), СписокУслуг, Элементы.КорректировкаПоказанийУслуга);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийУслугаНачалоВыбораИзСпискаЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
    
    ТекСтрока = ДополнительныеПараметры.ТекСтрока;
    
    ВыбранныйЭлемент = ВыбранныйЭлемент1;
    
    Если ВыбранныйЭлемент <> Неопределено Тогда
        
        Если НЕ ВыбранныйЭлемент.Значение = Неопределено Тогда
            
            ТекСтрока.Услуга             = ВыбранныйЭлемент.Значение;				
            ТекСтрока.НачальныеПоказания = 0;
            ТекСтрока.ИсточникПоказаний  = ПредопределенноеЗначение("Перечисление.бит_ИсточникПоказаний.Население");
            ТекСтрока.ТипДокумента       = "";
            ТекСтрока.ДатаОтПоказаний    = Неопределено;
            ТекСтрока.НачисленияЗаПериод = 0;
            
            Отбор = Новый Структура;
            
            Отбор.Вставить("ЛицевойСчет", ТекСтрока.ЛицевойСчет);
            Отбор.Вставить("Услуга"     , ТекСтрока.Услуга);
            
            СтрокиУслуг = Объект.ТаблицаУслуг.НайтиСтроки(Отбор);
            
            Для каждого Строка Из СтрокиУслуг Цикл
                
                Объект.ТаблицаУслуг.Удалить(Строка);
                
            КонецЦикла;
            
            НоваяСтрока = Объект.ТаблицаУслуг.Добавить();
            
            НоваяСтрока.ЛицевойСчет = ТекСтрока.ЛицевойСчет;
            НоваяСтрока.Услуга      = ВыбранныйЭлемент.Значение;
            
            ТекСтрока.ПоследниеПоказания = ПолучитьПоуследниеПоказания(ТекСтрока.ЛицевойСчет, ТекСтрока.Счетчик, ВыбранныйЭлемент.Значение, Объект.Ссылка);
            
        КонецЕсли;
        
    КонецЕсли;

КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Функция выполняет заполненние списка начальных показаний.
//
&НаСервере
Функция ЗаполнитьСписокНачальныхПоказаний(Знач ЛицевойСчет, Знач Счетчик, Знач НачалоПериода, Знач КонецПериода, Знач Услуга, Знач Многотарифный = Ложь, Знач ВидОперации, Знач Ссылка);
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Регистратор КАК Регистратор,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	МАКСИМУМ(бит_СчетчикиНаУслугахОбщийСрезПоследних.Период) КАК Период
	|ПОМЕСТИТЬ ВТ_ВсеСчетчики
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Объект = &Объект
	|				И Счетчик = &Счетчик) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Регистратор
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеСчетчики.Объект,
	|	ВТ_ВсеСчетчики.Счетчик,
	|	ВТ_ВсеСчетчики.Период
	|ИЗ
	|	ВТ_ВсеСчетчики КАК ВТ_ВсеСчетчики
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_УстановкаСчетчика КАК бит_УстановкаСчетчика
	|		ПО ВТ_ВсеСчетчики.Регистратор = бит_УстановкаСчетчика.Ссылка
	|ГДЕ
	|	бит_УстановкаСчетчика.ВидОперации <> ЗНАЧЕНИЕ(Перечисление.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик)";
	
	Запрос.УстановитьПараметр("Дата"   , КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	Запрос.УстановитьПараметр("Объект" , ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		НачалоПериода = ?(Выборка.Период > НачалоПериода, Выборка.Период, НачалоПериода);
		
	КонецЕсли; 
	
	Условие = "(бит_ПоказанияСчетчиков.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам ИЛИ бит_ПоказанияСчетчиков.Регистратор ССЫЛКА Документ.бит_УстановкаСчетчика)";
	
	Если ВидОперации = Перечисления.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаНачальныхПоказаний Тогда
		
		Условие = "бит_ПоказанияСчетчиков.Регистратор ССЫЛКА Документ.бит_УстановкаСчетчика";
		
	КонецЕсли;
	
	УсловиеУслуга = "";
	Если Многотарифный Тогда
		УсловиеУслуга = " И Услуга = &Услуга";
	КонецЕсли; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|ПОМЕСТИТЬ СписокУслуг
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&КонецПериода, ЛицевойСчет = &Объект" + УсловиеУслуга + ") КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ПоказанияСчетчиков.Период КАК Период,
	|	бит_ПоказанияСчетчиков.Объект,
	|	бит_ПоказанияСчетчиков.Счетчик,
	|	бит_ПоказанияСчетчиков.ПоследниеПоказания КАК НачальныеПоказания,
	|	ВЫБОР
	|		КОГДА бит_ПоказанияСчетчиков.ТекущиеПоказанияИнспектора <> 0
	|			ТОГДА ""Инспектор""
	|		ИНАЧЕ ВЫБОР
	|				КОГДА бит_ПоказанияСчетчиков.ТекущиеПоказанияНаселения <> 0
	|					ТОГДА ""Население""
	|				ИНАЧЕ ВЫБОР
	|						КОГДА бит_ПоказанияСчетчиков.ПоказанияПодкрутка <> 0
	|							ТОГДА ""Подкрутка""
	|						ИНАЧЕ ""Насиление""
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК Метка,
	|	бит_ПоказанияСчетчиков.Регистратор
	|ИЗ
	|	РегистрНакопления.бит_ПоказанияСчетчиков КАК бит_ПоказанияСчетчиков
	|ГДЕ
	|	бит_ПоказанияСчетчиков.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И бит_ПоказанияСчетчиков.Объект = &Объект
	|	И бит_ПоказанияСчетчиков.Счетчик = &Счетчик
	|	И бит_ПоказанияСчетчиков.Регистратор <> &Ссылка
	|	И бит_ПоказанияСчетчиков.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И "+ Условие +"
	|	И бит_ПоказанияСчетчиков.Услуга В
	|			(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|				Таб.Услуга
	|			ИЗ
	|				СписокУслуг КАК Таб)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПоказанияСчетчиков.Объект,
	|	бит_ПоказанияСчетчиков.Счетчик,
	|	бит_ПоказанияСчетчиков.ПоследниеПоказания,
	|	бит_ПоказанияСчетчиков.Период,
	|	ВЫБОР
	|		КОГДА бит_ПоказанияСчетчиков.ТекущиеПоказанияИнспектора <> 0
	|			ТОГДА ""Инспектор""
	|		ИНАЧЕ ВЫБОР
	|				КОГДА бит_ПоказанияСчетчиков.ТекущиеПоказанияНаселения <> 0
	|					ТОГДА ""Население""
	|				ИНАЧЕ ВЫБОР
	|						КОГДА бит_ПоказанияСчетчиков.ПоказанияПодкрутка <> 0
	|							ТОГДА ""Подкрутка""
	|						ИНАЧЕ ""Насиление""
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ,
	|	бит_ПоказанияСчетчиков.Регистратор
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр("НачалоПериода", ДобавитьМесяц(НачалоМесяца(НачалоПериода), -1));
	Запрос.УстановитьПараметр("КонецПериода" , НачалоМесяца(КонецПериода));
	Запрос.УстановитьПараметр("Ссылка"       , Ссылка);
	Запрос.УстановитьПараметр("Услуга"       , Услуга);
	
	мСоответствие.Очистить();
	
	СписокПоказаний = Новый СписокЗначений;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = мСоответствие.Добавить();
		
		НоваяСтрока.НачальныеПоказания = Выборка.НачальныеПоказания;
		НоваяСтрока.Период             = Выборка.Период;
		НоваяСтрока.ТипДокумента       = ТипЗнч(Выборка.Регистратор);
		
		СписокПоказаний.Добавить(Выборка.НачальныеПоказания, ""+Выборка.Метка+" "+Выборка.НачальныеПоказания +" от:"+ Формат(Выборка.Период, "ДФ=dd.MM.yyyy"));
		
	КонецЦикла;
	
	Возврат СписокПоказаний;
	
КонецФункции

// Функция получает список установленых счетчиков на лицевойм счете.
//
&НаСервереБезКонтекста
Функция ПолучитьСписокСчетчиков(Знач ЛицевойСчет, Знач Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Дата, Объект = &Объект) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный";
	Запрос.УстановитьПараметр("Объект", ЛицевойСчет);
	Запрос.УстановитьПараметр("Дата"  , КонецДня(Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокСчетчиков = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		СписокСчетчиков.Добавить(Выборка.Счетчик);
		
	КонецЦикла;  
	
	Возврат СписокСчетчиков;
	
КонецФункции

// Функция возвращает начисления в периоде по счетчику.
//
&НаСервере
Функция ПолучитьНачисления(Знач ЛицевойСчет, Знач Счетчик, Знач НачалоПериода, Знач КонецПериода, Знач Услуга, Знач Многотарифный = Ложь)
	
	УсловиеУслуга = "";
	
	Если Многотарифный Тогда
		
		УсловиеУслуга = " И УслугаЖКХ = &Услуга";
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоСчетчикамОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_НачисленияПоСчетчикамОбороты.Счетчик,
	|	бит_НачисленияПоСчетчикамОбороты.УслугаЖКХ КАК Услуга,
	|	СУММА(бит_НачисленияПоСчетчикамОбороты.СуммаОборот) КАК Сумма
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоСчетчикам.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И Счетчик = &Счетчик "+УсловиеУслуга+") КАК бит_НачисленияПоСчетчикамОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоСчетчикамОбороты.ЛицевойСчет,
	|	бит_НачисленияПоСчетчикамОбороты.Счетчик,
	|	бит_НачисленияПоСчетчикамОбороты.УслугаЖКХ
	|ИТОГИ
	|	СУММА(Сумма)
	|ПО
	|	ОБЩИЕ";
	
	Запрос.УстановитьПараметр("КонецПериода" , КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(НачалоПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет"  , ЛицевойСчет);
	Запрос.УстановитьПараметр("Счетчик"      , Счетчик);
	Запрос.УстановитьПараметр("Услуга"       , Услуга);
	
	Начислено = 0;
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		Начислено = Выборка.Сумма;
		
		ВыборкаУС = Выборка.Выбрать();
		
		Пока ВыборкаУС.Следующий() Цикл
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("ЛицевойСчет", ЛицевойСчет);
			Отбор.Вставить("Счетчик"    , Счетчик);
			Отбор.Вставить("Услуга"     , ВыборкаУС.Услуга);
			
			Поиск = Объект.ТаблицаУслуг.НайтиСтроки(Отбор);
			
			Для каждого СтрокаТаблицы Из Поиск Цикл
				
				СтрокаТаблицы.НачисленияЗаПериод = ВыборкаУС.Сумма;
				
			КонецЦикла; 
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	Возврат Начислено;
	
КонецФункции

&НаСервере
Процедура ПолучитьРзовые()
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		Элементы.ВводРазовых.Заголовок = "Ввести разовые начисления.";
		Возврат;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_РазовыеПоУслугамЖКХ.Ссылка КАК ДокументРазовые
	|ИЗ
	|	Документ.бит_РазовыеПоУслугамЖКХ КАК бит_РазовыеПоУслугамЖКХ
	|ГДЕ
	|	бит_РазовыеПоУслугамЖКХ.Документ = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Элементы.ВводРазовых.Заголовок = "Разовые № " + Строка(Выборка.ДокументРазовые.Номер) + " от:" + Строка(Выборка.ДокументРазовые.Дата);
		
	Иначе
		
		Элементы.ВводРазовых.Заголовок = "Ввести разовые начисления.";
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьНачисленияНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	Начисления = Документы.бит_КорректировкаПоказанийСчетчиков.РасчитатьРазовыеПокорректировке(Объект.Ссылка, Объект.Дата);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
	МассивНачислений = бит_ОбщегоНазначения.ТаблицаЗначенийВМассив(Начисления);
	
	Возврат МассивНачислений;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокКолонокТабличнойЧастиКорректировкаПоказаний()
	
	СписокЛС = Объект.КорректировкаПоказаний.Выгрузить( , "ЛицевойСчет");
	
	АдресХран = ПоместитьВоВременноеХранилище(СписокЛС,АдресХран);
	
	СписокЛ = ПолучитьИзВременногоХранилища(АдресХран); 
	
	Возврат АдресХран;
	
КонецФункции

&НаСервере
Функция НайтиПоНомеруДокументРазовыеПоУслугамЖКХНаСервере(СтрокаНомера)
	
	ДокументРазовые = Документы.бит_РазовыеПоУслугамЖКХ.НайтиПоНомеру(СтрокаНомера, Объект.Дата);
	
	Возврат ДокументРазовые;
	
КонецФункции

&НаСервереБезКонтекста
Функция МноготарифныйСчетчик(Знач ЛицевойСчет, Знач Счетчик, Знач Дата)
	
	Многотарифный = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Счетчик"    , Счетчик);
	Запрос.УстановитьПараметр("Дата"       , Дата);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	МАКСИМУМ(ЕСТЬNULL(бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный, 0)) КАК Многотарифный
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Счетчик = &Счетчик
	|				И Объект = &ЛицевойСчет) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Многотарифный = Выборка.Многотарифный;
	КонецЕсли; 
	
	Возврат Многотарифный;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуУслуг(Знач ЛицевойСчет, Знач Счетчик, Знач Дата)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект КАК ЛицевойСчет,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Объект = &Объект
	|				И Счетчик = &Счетчик) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата"   , КонецДня(Дата));
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	Запрос.УстановитьПараметр("Объект" , ЛицевойСчет);
	
	Выборка = Запрос.Выполнить().Выбрать(); 
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.ТаблицаУслуг.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		НоваяСтрока.ПоследниеПоказания = ПолучитьПоуследниеПоказания(НоваяСтрока.ЛицевойСчет, НоваяСтрока.Счетчик, НоваяСтрока.Услуга, Объект.Ссылка);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПоуследниеПоказания(Знач ЛицевойСчет, Знач Счетчик, Знач Услуга, Знач Ссылка)
	
	Результат = 0;
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Счетчик"    , Счетчик);
	Запрос.УстановитьПараметр("Услуга"     , Услуга);
	Запрос.УстановитьПараметр("ССЫЛКА"     , ССЫЛКА);
	
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ПоказанияСчетчиков.ПоследниеПоказания,
	|	бит_ПоказанияСчетчиков.Период КАК Период,
	|	бит_ПоказанияСчетчиков.Объект,
	|	бит_ПоказанияСчетчиков.Услуга,
	|	бит_ПоказанияСчетчиков.Счетчик
	|ИЗ
	|	РегистрНакопления.бит_ПоказанияСчетчиков КАК бит_ПоказанияСчетчиков
	|ГДЕ
	|	бит_ПоказанияСчетчиков.Объект = &ЛицевойСчет
	|	И бит_ПоказанияСчетчиков.Счетчик = &Счетчик
	|	И бит_ПоказанияСчетчиков.Услуга = &Услуга
	|	И бит_ПоказанияСчетчиков.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И НЕ бит_ПоказанияСчетчиков.Регистратор = &ССЫЛКА
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Выборка.ПоследниеПоказания;
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПоказанияПодкрутки.Период КАК ПериодПодкрутки,
	|	ЕСТЬNULL(ЗакрытыеПоказания.Период, НАЧАЛОПЕРИОДА(ПоказанияПодкрутки.Период, МЕСЯЦ)) КАК ПериодПоказаний,
	|	ЕСТЬNULL(СведенияОсчетчике.Многотарифный, ЛОЖЬ) КАК Многотарифный,
	|	СведенияОсчетчике.Объект КАК Объект,
	|	СведенияОсчетчике.Услуга КАК Услуга,
	|	СведенияОсчетчике.Счетчик КАК Счетчик
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект КАК Объект,
	|		бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга КАК Услуга,
	|		бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик КАК Счетчик,
	|		бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный КАК Многотарифный
	|	ИЗ
	|		РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&КонецПериода, ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|	ГДЕ
	|		бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать) КАК СведенияОсчетчике
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_ПоказанияСчетчиков.Объект КАК Объект,
	|			бит_ПоказанияСчетчиков.Счетчик КАК Счетчик,
	|			бит_ПоказанияСчетчиков.Услуга КАК Услуга,
	|			МАКСИМУМ(бит_ПоказанияСчетчиков.Период) КАК Период
	|		ИЗ
	|			РегистрНакопления.бит_ПоказанияСчетчиков КАК бит_ПоказанияСчетчиков
	|		ГДЕ
	|			бит_ПоказанияСчетчиков.Счетчик.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
	|			И бит_ПоказанияСчетчиков.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|			И бит_ПоказанияСчетчиков.Объект.УлицаЛицевогоСчета = &УлицаЛицевогоСчета
	|			И бит_ПоказанияСчетчиков.Объект.Здание = &Здание
	|			И бит_ПоказанияСчетчиков.ПоказанияПодкрутка <> 0
	|			И бит_ПоказанияСчетчиков.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|		
	|		СГРУППИРОВАТЬ ПО
	|			бит_ПоказанияСчетчиков.Счетчик,
	|			бит_ПоказанияСчетчиков.Услуга,
	|			бит_ПоказанияСчетчиков.Объект) КАК ПоказанияПодкрутки
	|			ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|				бит_ПоказанияСчетчиков.Объект КАК Объект,
	|				бит_ПоказанияСчетчиков.Счетчик КАК Счетчик,
	|				бит_ПоказанияСчетчиков.Услуга КАК Услуга,
	|				МАКСИМУМ(бит_ПоказанияСчетчиков.Период) КАК Период
	|			ИЗ
	|				РегистрНакопления.бит_ПоказанияСчетчиков КАК бит_ПоказанияСчетчиков
	|			ГДЕ
	|				бит_ПоказанияСчетчиков.Счетчик.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
	|				И бит_ПоказанияСчетчиков.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|				И бит_ПоказанияСчетчиков.Объект.УлицаЛицевогоСчета = &УлицаЛицевогоСчета
	|				И бит_ПоказанияСчетчиков.Объект.Здание = &Здание
	|				И (бит_ПоказанияСчетчиков.ТекущиеПоказанияИнспектора <> 0
	|						ИЛИ бит_ПоказанияСчетчиков.ТекущиеПоказанияНаселения <> 0)
	|				И бит_ПоказанияСчетчиков.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|			
	|			СГРУППИРОВАТЬ ПО
	|				бит_ПоказанияСчетчиков.Услуга,
	|				бит_ПоказанияСчетчиков.Объект,
	|				бит_ПоказанияСчетчиков.Счетчик) КАК ЗакрытыеПоказания
	|			ПО (ЗакрытыеПоказания.Период <= ПоказанияПодкрутки.Период)
	|				И (ЗакрытыеПоказания.Объект = ПоказанияПодкрутки.Объект)
	|				И (ЗакрытыеПоказания.Счетчик = ПоказанияПодкрутки.Счетчик)
	|				И (ЗакрытыеПоказания.Услуга = ПоказанияПодкрутки.Услуга)
	|		ПО СведенияОсчетчике.Счетчик = ПоказанияПодкрутки.Счетчик
	|			И СведенияОсчетчике.Услуга = ПоказанияПодкрутки.Услуга
	|			И СведенияОсчетчике.Объект = ПоказанияПодкрутки.Объект
	|ИТОГИ
	|	МАКСИМУМ(Многотарифный)
	|ПО
	|	Объект,
	|	Счетчик";
	
	Запрос.УстановитьПараметр("УлицаЛицевогоСчета", Объект.Улица);
	Запрос.УстановитьПараметр("Здание"            , Объект.Здание);
	Запрос.УстановитьПараметр("КонецПериода"      , КонецДня(Объект.Дата));
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		ВыборкаСЧ = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаСЧ.Следующий() Цикл
			
			НоваяСтрока = Объект.КорректировкаПоказаний.Добавить();
			
			НоваяСтрока.ЛицевойСчет       = ВыборкаСЧ.Объект;
			НоваяСтрока.ИсточникПоказаний = Перечисления.бит_ИсточникПоказаний.Население;
			
			ВыборкаПоЛС = ВыборкаСЧ.Выбрать();
			
			Многотарифный = ВыборкаСЧ.Многотарифный;
			ТекСтрока     = 0;
			
			Пока ВыборкаПоЛС.Следующий() Цикл
				
				Если Многотарифный Тогда
					
					Если ТекСтрока > 0 Тогда
						
						НоваяСтрока = Объект.КорректировкаПоказаний.Добавить();
						
						НоваяСтрока.ЛицевойСчет       = Выборка.Объект;
						НоваяСтрока.ИсточникПоказаний = Перечисления.бит_ИсточникПоказаний.Население;
						
					КонецЕсли; 
					
					НоваяСтрока.Услуга        = ВыборкаПоЛС.Услуга;
					НоваяСтрока.Многотарифный = Истина;
					
				КонецЕсли; 
				
				ЗапросПодкрутка = Новый Запрос;
				
				ЗапросПодкрутка.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	бит_ПоказанияСчетчиков.Период КАК Период,
				|	бит_ПоказанияСчетчиков.Объект,
				|	бит_ПоказанияСчетчиков.Услуга,
				|	бит_ПоказанияСчетчиков.Счетчик КАК Счетчик,
				|	бит_ПоказанияСчетчиков.ПоказанияПодкрутка
				|ИЗ
				|	РегистрНакопления.бит_ПоказанияСчетчиков КАК бит_ПоказанияСчетчиков
				|ГДЕ
				|	бит_ПоказанияСчетчиков.Период МЕЖДУ &НачалоПериода И &КонецПериода
				|	И бит_ПоказанияСчетчиков.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
				|	И бит_ПоказанияСчетчиков.Объект = &Объект
				|	И бит_ПоказанияСчетчиков.Услуга = &Услуга
				|	И бит_ПоказанияСчетчиков.Счетчик = &Счетчик
				|	И бит_ПоказанияСчетчиков.ПоказанияПодкрутка <> 0
				|	И бит_ПоказанияСчетчиков.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
				|
				|УПОРЯДОЧИТЬ ПО
				|	Период";
				ЗапросПодкрутка.УстановитьПараметр("НачалоПериода", ВыборкаПоЛС.ПериодПоказаний);
				ЗапросПодкрутка.УстановитьПараметр("КонецПериода" , ВыборкаПоЛС.ПериодПодкрутки);
				ЗапросПодкрутка.УстановитьПараметр("Объект"       , ВыборкаПоЛС.Объект);
				ЗапросПодкрутка.УстановитьПараметр("Счетчик"      , ВыборкаПоЛС.Счетчик);
				ЗапросПодкрутка.УстановитьПараметр("Услуга"       , ВыборкаПоЛС.Услуга);
				
				ВыборкаПодкрутка = ЗапросПодкрутка.Выполнить().Выбрать();
				
				Пока ВыборкаПодкрутка.Следующий() Цикл
					
					НоваяСтрока.Период             = бит_РаботаСДиалогамиСервер.ДатаКакМесяцПредставление(ВыборкаПодкрутка.Период);
					НоваяСтрока.НачальныеПоказания = ВыборкаПодкрутка.ПоказанияПодкрутка;
					НоваяСтрока.Счетчик            = ВыборкаПодкрутка.Счетчик;
					НоваяСтрока.ДатаОтПоказаний    = ВыборкаПодкрутка.Период;
					НоваяСтрока.ДатаНачала         = ВыборкаПодкрутка.Период;
					
				КонецЦикла;
				
				НоваяСтрокаУС =  Объект.ТаблицаУслуг.Добавить();
				
				НоваяСтрокаУС.ЛицевойСчет = ВыборкаПодкрутка.Объект;
				НоваяСтрокаУС.Услуга      = ВыборкаПодкрутка.Услуга;
				НоваяСтрокаУС.Счетчик     = ВыборкаПодкрутка.Счетчик;
				
				ТекСтрока = ТекСтрока + 1;
				
				НоваяСтрока.НачисленияЗаПериод = ПолучитьНачисления(НоваяСтрока.ЛицевойСчет, НоваяСтрока.Счетчик, ДобавитьМесяц(НоваяСтрока.ДатаОтПоказаний, -1), Объект.Дата, НоваяСтрока.Услуга, НоваяСтрока.Многотарифный);
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЦикла;
	Объект.КорректировкаПоказаний.Сортировать("Период Возр, ЛицевойСчет Возр, Счетчик Возр");
	
КонецПроцедуры

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	КэшированныеЗначения.Вставить("Организация"         , Объект.Организация);
	КэшированныеЗначения.Вставить("Улица"               , Объект.Улица);
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьСписокУслуг(Знач ЛицевойСчет, Знач Счетчик, Знач Дата)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Объект = &Объект
	|				И Счетчик = &Счетчик) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать";
	
	Запрос.УстановитьПараметр("Объект" , ЛицевойСчет);
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	Запрос.УстановитьПараметр("Дата"   , Дата);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СписокУслуг = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл
		
		СписокУслуг.Добавить(Выборка.Услуга);
		
	КонецЦикла;  
	
	Возврат СписокУслуг;
	
КонецФункции

&НаСервере
Процедура УдалитьСписокТаблицыУслугНаСервере(Отбор)
	
	СтрокиУслуг = Объект.ТаблицаУслуг.НайтиСтроки(Отбор);
	
	Для каждого Строка Из СтрокиУслуг Цикл
		
		Объект.ТаблицаУслуг.Удалить(Строка);
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура УдалитьПустыеСтроки()
	
	КоличествоЗаписей = Объект.КорректировкаПоказаний.Количество();
	
	Для Ном = 1 По КоличествоЗаписей  Цикл
		
		Индекс = КоличествоЗаписей - Ном;
		
		ТекСтрока = Объект.КорректировкаПоказаний[Индекс];
		
		Если ТекСтрока.КорректировочныеПоказания = 0 И мМассивСтрок.НайтиПоЗначению(Индекс) = Неопределено Тогда
			
			Объект.КорректировкаПоказаний.Удалить(ТекСтрока);
			
		КонецЕсли;
		
	КонецЦикла;		
	
КонецПроцедуры

&НаСервере
Функция ПроверитьПустыеСтроки()
	
	КоличествоЗаписей = Объект.КорректировкаПоказаний.Количество();
	
	ЕстьПустыеСтроки = Ложь;
	
	Для Ном = 1 По КоличествоЗаписей  Цикл
		
		Индекс = КоличествоЗаписей - Ном;
		
		ТекСтрока = Объект.КорректировкаПоказаний[Индекс];
		
		Если ТекСтрока.КорректировочныеПоказания = 0 И мМассивСтрок.НайтиПоЗначению(Индекс) = Неопределено Тогда
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Есть строки с пустыми значениями корректировочных показаний.");
			ЕстьПустыеСтроки = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла;		
	
	Возврат ЕстьПустыеСтроки;
	
КонецФункции

&НаКлиенте
Процедура КорректировкаПоказанийСчетчикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	СписокСчетчиков = ПолучитьСписокСчетчиков(ТекСтрока.ЛицевойСчет, Объект.Дата);
	
	ВыбранныйЭлемент = Неопределено;
	
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("КорректировкаПоказанийСчетчикНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекСтрока", ТекСтрока)), СписокСчетчиков, Элементы.КорректировкаПоказанийСчетчик);
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийСчетчикНачалоВыбораЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
	
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;
	
	
	ВыбранныйЭлемент = ВыбранныйЭлемент1;
	
	ОчиститьСообщения();
	
	Если Не ВыбранныйЭлемент = Неопределено Тогда
		
		Если НЕ ВыбранныйЭлемент.Значение = Неопределено Тогда
			
			Если мКэшЗначений.ТекущийСчетчик <> ВыбранныйЭлемент.Значение Тогда
				
				ТекСтрока.НачальныеПоказания = 0;
				ТекСтрока.Услуга             = Неопределено;
				ТекСтрока.ИсточникПоказаний  = ПредопределенноеЗначение("Перечисление.бит_ИсточникПоказаний.Население");
				ТекСтрока.ТипДокумента       = "";
				ТекСтрока.ДатаОтПоказаний    = Неопределено;
				ТекСтрока.НачисленияЗаПериод = 0;
				
			КонецЕсли;
			
			Если НЕ ТекСтрока = Неопределено И НЕ ТекСтрока.Счетчик = ВыбранныйЭлемент.Значение Тогда
				
				Многотарифный = МноготарифныйСчетчик(ТекСтрока.ЛицевойСчет, ВыбранныйЭлемент.Значение, КонецДня(Объект.Дата));
				
				ТекСтрока.Многотарифный = Многотарифный;
				
				Отбор = Новый Структура;
				
				Отбор.Вставить("ЛицевойСчет", ТекСтрока.ЛицевойСчет);
				Отбор.Вставить("Счетчик"    , ТекСтрока.Счетчик);
				
				СтрокиУслуг = Объект.ТаблицаУслуг.НайтиСтроки(Отбор);
				
				Для каждого Строка Из СтрокиУслуг Цикл
					
					Объект.ТаблицаУслуг.Удалить(Строка);
					
				КонецЦикла; 
				
				Если НЕ Многотарифный Тогда
					
					ЗаполнитьТаблицуУслуг(ТекСтрока.ЛицевойСчет, ВыбранныйЭлемент.Значение, КонецДня(Объект.Дата));
					
				КонецЕсли; 				
				
			КонецЕсли;
			
			Если ВыбранныйЭлемент <> Неопределено Тогда
				
				ТекСтрока.Счетчик = ВыбранныйЭлемент.Значение;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийНачальныеПоказанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено Тогда
		
		Если ТекСтрока.Многотарифный И НЕ ЗначениеЗаполнено(ТекСтрока.Услуга) Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Укажите услугу.");
			
			СтандартнаяОбработка = Ложь;
			
			Возврат;
			
		КонецЕсли; 
		
		СписокВыбораНачальныеПоказания = ЗаполнитьСписокНачальныхПоказаний(ТекСтрока.ЛицевойСчет,
		ТекСтрока.Счетчик,
		ТекСтрока.ДатаНачала,
		Объект.Дата,
		ТекСтрока.Услуга,
		ТекСтрока.Многотарифный,
		Объект.ВидОперации,
		Объект.Ссылка);
		
		ВыбранныйЭлемент = Неопределено;
		
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("КорректировкаПоказанийНачальныеПоказанияНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекСтрока", ТекСтрока)), СписокВыбораНачальныеПоказания, Элементы.КорректировкаПоказанийНачальныеПоказания);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийНачальныеПоказанияНачалоВыбораЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
	
	ТекСтрока = ДополнительныеПараметры.ТекСтрока;
	
	
	ВыбранныйЭлемент = ВыбранныйЭлемент1;
	
	ОчиститьСообщения();
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		
		Если ВыбранныйЭлемент.Значение <> Неопределено Тогда
			
			Если ТекСтрока <> Неопределено Тогда
				
				Отбор = Новый Структура;
				
				Отбор.Вставить("НачальныеПоказания", ВыбранныйЭлемент.Значение);
				
				ЗначенияНачислений = мСоответствие.НайтиСтроки(Отбор);
				
				Если ЗначенияНачислений.Количество() > 0 Тогда
					
					ТекСтрока.НачальныеПоказания = ЗначенияНачислений[0].НачальныеПоказания;
					ТекСтрока.ДатаОтПоказаний    = ЗначенияНачислений[0].Период;
					ТекСтрока.ТипДокумента       = ЗначенияНачислений[0].ТипДокумента;
					
				КонецЕсли;
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ТекСтрока = Неопределено И НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаНачальныхПоказаний") Тогда
		
		КолМесяцев = ?(ТекСтрока.ТипДокумента = Строка(Тип("ДокументСсылка.бит_УстановкаСчетчика")),0,1);
		
		ТекСтрока.НачисленияЗаПериод = ПолучитьНачисления(ТекСтрока.ЛицевойСчет, ТекСтрока.Счетчик, ДобавитьМесяц(ТекСтрока.ДатаОтПоказаний, КолМесяцев), Объект.Дата, ТекСтрока.Услуга, ТекСтрока.Многотарифный);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийПериодНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	ПараметрыОтбора = Новый Структура("НачалоПериода, КонецПериода", НачалоМесяца(ТекСтрока.ДатаНачала), КонецМесяца(ТекСтрока.ДатаНачала));
	ОписаниеОповещения = Новый ОписаниеОповещения("ВыбратьПериодЗавершение", ЭтотОбъект);
	ОткрытьФорму("ОбщаяФорма.ВыборСтандартногоПериодаМесяц", ПараметрыОтбора, ТекСтрока.Период, , , , ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииПериода()
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	// Обновляем представление периода на форме.
	ТекСтрока.Период = бит_РаботаСДиалогами.ДатаКакМесяцПредставление(ТекСтрока.ДатаНачала);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	ТекСтрока.ДатаНачала = РезультатВыбора.КонецПериода;
	
	ПриИзмененииПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийУслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.КорректировкаПоказаний.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено Тогда
		
		СписокУслуг = ПолучитьСписокУслуг(ТекСтрока.ЛицевойСчет, ТекСтрока.Счетчик, КонецДня(Объект.Дата));
		
		ВыбранныйЭлемент = Неопределено;

		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("КорректировкаПоказанийУслугаНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекСтрока", ТекСтрока)), СписокУслуг, Элементы.КорректировкаПоказанийУслуга);	
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КорректировкаПоказанийУслугаНачалоВыбораЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
    
    ТекСтрока = ДополнительныеПараметры.ТекСтрока;
    
    ВыбранныйЭлемент = ВыбранныйЭлемент1;
    
    ОчиститьСообщения();
    
    Если ВыбранныйЭлемент <> Неопределено Тогда
        
        Если НЕ ВыбранныйЭлемент.Значение = Неопределено Тогда
            
            ТекСтрока.Услуга             = ВыбранныйЭлемент.Значение;
            
            ТекСтрока.НачальныеПоказания = 0;
            ТекСтрока.ИсточникПоказаний  = ПредопределенноеЗначение("Перечисление.бит_ИсточникПоказаний.Население");
            ТекСтрока.ТипДокумента       = "";
            ТекСтрока.ДатаОтПоказаний    = Неопределено;
            ТекСтрока.НачисленияЗаПериод = 0;
            
            Отбор = Новый Структура;
            
            Отбор.Вставить("ЛицевойСчет", ТекСтрока.ЛицевойСчет);
            Отбор.Вставить("Услуга"     , ТекСтрока.Услуга);
            
            СтрокиУслуг = Объект.ТаблицаУслуг.НайтиСтроки(Отбор);
            
            Для каждого Строка Из СтрокиУслуг Цикл
                
                Объект.ТаблицаУслуг.Удалить(Строка);
                
            КонецЦикла;
            
            НоваяСтрока = Объект.ТаблицаУслуг.Добавить();
            
            НоваяСтрока.ЛицевойСчет = ТекСтрока.ЛицевойСчет;
            НоваяСтрока.Услуга      = ВыбранныйЭлемент.Значение;
            
            ТекСтрока.ПоследниеПоказания = ПолучитьПоуследниеПоказания(ТекСтрока.ЛицевойСчет, ТекСтрока.Счетчик, ВыбранныйЭлемент.Значение, Объект.Ссылка);
            
        КонецЕсли;
        
    КонецЕсли;
    
    Элементы.КорректировкаПоказаний.Обновить();

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	ПолучитьРзовые();
	УправлениеЭлементамиФормы();	
	
КонецПроцедуры

