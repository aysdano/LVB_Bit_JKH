	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период, МЕСЯЦ),
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|				ИЛИ бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|				ИЛИ бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|			ТОГДА ""Начисления""
	|		КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|			ТОГДА ""Льгота""
	|		КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|			ТОГДА ""Разовые""
	|		КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_ВводНачальныхОстатковПоКУ
	|			ТОГДА ""Ввод нач. остатков""
	|		КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|			ТОГДА ""Оплата""
	|	КОНЕЦ,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ.Приоритет,
	|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ
	|
	|УПОРЯДОЧИТЬ ПО
	|	МесяцГод,
	|	Приоритет
	|ИТОГИ
	|	СУММА(Оплата),
	|	СУММА(Сумма)
	|ПО
	|	МесяцГод,
	|	ВидНачисления,
	|	Услуга";
	
	Возврат Текст;
	
КонецФункции // ()


// Функция получает остатки по периодам.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьОстаткиПоПериодам(ПараметрыОтчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода" , КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет"  , ПараметрыОтчета.ЛицевойСчет);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток) КАК ВхСальдо,
	|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток) КАК ИсхСальдо,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период КАК МесяцГод
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Месяц, , ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции // ()

Функция ДолгОстаток(ПараметрыОтчета)
	
	ДолгОстаток = Новый Запрос;
	ДолгОстаток.УстановитьПараметр("ЛицевойСчет"  , ПараметрыОтчета.ЛицевойСчет);
	ДолгОстаток.УстановитьПараметр("КонецПериода" , КонецМесяца(ПараметрыОтчета.КонецПериода));
	ДолгОстаток.УстановитьПараметр("НачалоПериода", НачалоМесяца(ПараметрыОтчета.КонецПериода));
	ДолгОстаток.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК МесяцГод,
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ * -1) КАК Оплата,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|					ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|					ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Начисления,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ * -1) КАК Льгота
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ЛицевойСчет = &ЛицевойСчет) КАК НачисленияПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ),
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток КАК Остаток,
	|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&НачалоПериода, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(Остатки.Остаток, 0) + ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ЕСТЬNULL(Обороты.Оплата, 0) - ЕСТЬNULL(Обороты.Льгота, 0) > 0
	|				ТОГДА ЕСТЬNULL(Остатки.Остаток, 0) + ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ЕСТЬNULL(Обороты.Оплата, 0) - ЕСТЬNULL(Обороты.Льгота, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КОплате,
	|	Остатки.ЛицевойСчет
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
	|		ПО Остатки.УслугаЖКХ = Обороты.Услуга
	|
	|СГРУППИРОВАТЬ ПО
	|	Остатки.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки";
	
	РезультатТаблицы = ДолгОстаток.Выполнить().Выгрузить();
	Если НЕ ДолгОстаток.Выполнить().Пустой() Тогда
		
		Долг = РезультатТаблицы.Получить(РезультатТаблицы.Количество()-1).КОплате;
		
	Иначе
		
		Долг = 0;
		
	КонецЕсли;
	
	
	Возврат Долг;
	
КонецФункции // ()

// Функция текст запроса макета остатки.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьТекстЗапросаОстатки()
	
	Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОстатков.Услуга,
	|	ТаблицаОстатков.МесяцГод,
	|	ТаблицаОстатков.ВхСальдо,
	|	ТаблицаОстатков.ИсхСальдо,
	|	ТаблицаОстатков.Приоритет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	&ТаблицаОстатков КАК ТаблицаОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|					ИЛИ бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|					ИЛИ бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Начислено,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|				ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ * -1) КАК Оплата,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|				ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ * -1) КАК Льгота,
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период, МЕСЯЦ) КАК МесяцГод
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период, МЕСЯЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Остатки.МесяцГод КАК МесяцГод,
	|	Остатки.Услуга КАК Услуга,
	|	Остатки.ВхСальдо КАК ВхСальдо,
	|	Остатки.ИсхСальдо КАК ИсхСальдо,
	|	ЕСТЬNULL(Обороты.Начислено, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ЕСТЬNULL(Обороты.Льгота, 0) КАК Сумма,
	|	ВЫБОР
	|		КОГДА Остатки.ВхСальдо + ЕСТЬNULL(Обороты.Начислено, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ЕСТЬNULL(Обороты.Льгота, 0) - ЕСТЬNULL(Обороты.Оплата, 0) > 0
	|			ТОГДА Остатки.ВхСальдо + ЕСТЬNULL(Обороты.Начислено, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ЕСТЬNULL(Обороты.Льгота, 0) - ЕСТЬNULL(Обороты.Оплата, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КОплате,
	|	ЕСТЬNULL(Обороты.Оплата, 0) КАК Оплата,
	|	Остатки.Приоритет КАК Приоритет
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
	|		ПО Остатки.Услуга = Обороты.УслугаЖКХ
	|			И Остатки.МесяцГод = Обороты.МесяцГод
	|
	|УПОРЯДОЧИТЬ ПО
	|	МесяцГод,
	|	Приоритет
	|ИТОГИ
	|	СУММА(ВхСальдо),
	|	СУММА(ИсхСальдо),
	|	СУММА(Сумма),
	|	СУММА(КОплате),
	|	СУММА(Оплата)
	|ПО
	|	МесяцГод,
	|	Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Обороты";
	
	Возврат Текст;
	
КонецФункции // ()

Функция ПолучитьТаблицуОстатков(ПараметрыОтчета)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ЛицевойСчет"  , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("КонецПериода" , КонецМесяца(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("НачалоПериода", ПараметрыОтчета.НачалоПериода);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период, МЕСЯЦ) КАК МесяцГод,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток, 0) КАК СуммаНачальныйОстаток,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток, 0) КАК СуммаКонечныйОстаток,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Месяц, , ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.МесяцГод КАК МесяцГод,
	|	Остатки.УслугаЖКХ КАК Услуга,
	|	Остатки.СуммаНачальныйОстаток КАК ВхСальдо,
	|	Остатки.СуммаКонечныйОстаток КАК ИсхСальдо,
	|	Остатки.Приоритет КАК Приоритет
	|ИЗ
	|	Остатки КАК Остатки
	|
	|УПОРЯДОЧИТЬ ПО
	|	МесяцГод,
	|	Приоритет
	|ИТОГИ
	|	СУММА(ВхСальдо),
	|	СУММА(ИсхСальдо)
	|ПО
	|	Услуга,
	|	МесяцГод ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки";
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("МесяцГод" , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Таблица.Колонки.Добавить("Услуга"   , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	Таблица.Колонки.Добавить("ВхСальдо" , ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Таблица.Колонки.Добавить("ИсхСальдо", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Таблица.Колонки.Добавить("Приоритет", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		ВыборкаУС = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "МесяцГод", "ВСЕ");
		
		Пока ВыборкаУС.Следующий() Цикл
			
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаУС);
			
		КонецЦикла; 
		
	КонецЦикла;               
	
	Возврат Таблица;
	
КонецФункции // () 

// Функция текст запроса выписки.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьТекстЗапросаВыписка_Список()
	
	Текст = 
	"ВЫБРАТЬ
	|	СписокУслуг.Услуга,
	|	СписокУслуг.ЕдИзм,
	|	СписокУслуг.Тариф,
	|	СписокУслуг.ОсновнаяСтавка,
	|	СписокУслуг.ГрафаОтчетаГЦЖС,
	|	СписокУслуг.СпособРасчета
	|ПОМЕСТИТЬ тмпСписокУслуг
	|ИЗ
	|	&СписокУслуг КАК СписокУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток КАК ВхСальдо,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток КАК ИсхСальдо,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|					ИЛИ бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|					ИЛИ бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Начислено,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|				ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ * -1) КАК Оплата,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|				ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ * -1) КАК Льгота
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ОбъемыПоУслугамЖКХОбороты.Услуга,
	|	СУММА(бит_ОбъемыПоУслугамЖКХОбороты.ОбъемОборот) КАК ОбъемОборот
	|ПОМЕСТИТЬ Объемы
	|ИЗ
	|	РегистрНакопления.бит_ОбъемыПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, , ЛицевойСчет = &ЛицевойСчет) КАК бит_ОбъемыПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ОбъемыПоУслугамЖКХОбороты.Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	тмпСписокУслуг.Услуга,
	// БИТ_ЖКХ_03102013_начало_изменений
	// Остатки.ВхСальдо КАК ВхСальдо,.
	// Остатки.ИсхСальдо КАК ИсхСальдо,.
	|	ЕСТЬNULL(Остатки.ВхСальдо, 0) КАК ВхСальдо,
	|	ЕСТЬNULL(Остатки.ИсхСальдо, 0) КАК ИсхСальдо,
	// БИТ_ЖКХ_03102013_окончание_изменений
	|	ЕСТЬNULL(Обороты.Начислено, 0) КАК Начислено,
	|	ЕСТЬNULL(Обороты.Разовые, 0) КАК Разовые,
	|	ЕСТЬNULL(Обороты.Оплата, 0) КАК Оплата,
	|	ЕСТЬNULL(Обороты.Льгота, 0) КАК Льгота,
	|	Остатки.Приоритет КАК Приоритет,
	|	ЕСТЬNULL(Объемы.ОбъемОборот, 0) КАК Объем,
	|	тмпСписокУслуг.ЕдИзм,
	|	тмпСписокУслуг.Тариф,
	|	тмпСписокУслуг.ОсновнаяСтавка,
	|	тмпСписокУслуг.ГрафаОтчетаГЦЖС,
	|	тмпСписокУслуг.СпособРасчета
	|ИЗ
	|	тмпСписокУслуг КАК тмпСписокУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
	|		ПО тмпСписокУслуг.Услуга = Остатки.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
	|		ПО тмпСписокУслуг.Услуга = Обороты.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Объемы КАК Объемы
	|		ПО тмпСписокУслуг.Услуга = Объемы.Услуга
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ
	|	СУММА(ВхСальдо),
	|	СУММА(ИсхСальдо),
	|	СУММА(Начислено),
	|	СУММА(Разовые),
	|	СУММА(Оплата),
	|	СУММА(Льгота)
	|ПО
	|	ОБЩИЕ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Объемы
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ тмпСписокУслуг";
	
	Возврат Текст;
	
КонецФункции // ()

// Функция получает сведения о лицевом счете.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСведенияОбЛицевомСчете(ПараметрыОтчета)
	
	СведенияОбЛс = Новый Структура;
	СведенияОбЛс.Вставить("ЛицевойСчет"             , Справочники.бит_ЛицевыеСчета.ПустаяСсылка());
	СведенияОбЛс.Вставить("Организация"             , Справочники.Организации.ПустаяСсылка());
	СведенияОбЛс.Вставить("НаименованиеЛС"          , "");
	СведенияОбЛс.Вставить("ПочтовыйАдрес"           , "");
	СведенияОбЛс.Вставить("Район"                   , Справочники.бит_АдминистративныеОкруга.ПустаяСсылка());
	СведенияОбЛс.Вставить("Участок"                 , Справочники.бит_ТехническиеУчастки.ПустаяСсылка());
	СведенияОбЛс.Вставить("Улица"                   , Справочники.бит_СписокУлиц.ПустаяСсылка());
	СведенияОбЛс.Вставить("Здание"                  , Справочники.бит_СписокЗданий.ПустаяСсылка());
	СведенияОбЛс.Вставить("Корпус"                  , "");
	СведенияОбЛс.Вставить("Строение"                , "");
	СведенияОбЛс.Вставить("Этаж"                    , 0);
	СведенияОбЛс.Вставить("Квартира"                , Справочники.бит_Квартиры.ПустаяСсылка());
	СведенияОбЛс.Вставить("Идентификатор"           , 0);
	СведенияОбЛс.Вставить("ОбщаяПлощадь"            , 0);
	СведенияОбЛс.Вставить("ЖилаяПлощадь"            , 0);
	СведенияОбЛс.Вставить("МОП"                     , 0);
	СведенияОбЛс.Вставить("ОтапливаемаяПлощадь"     , 0);
	СведенияОбЛс.Вставить("СовокупнаяПлощадь"       , 0);
	СведенияОбЛс.Вставить("ТипКвартиры"             , Справочники.бит_ТипыКвартиры.ПустаяСсылка());
	СведенияОбЛс.Вставить("СтатусКвартиры"          , Справочники.бит_СтатусыКвартиры.ПустаяСсылка());
	СведенияОбЛс.Вставить("ТипПлиты"                , Справочники.бит_ТипыПлиты.ПустаяСсылка());
	СведенияОбЛс.Вставить("ТипЗапирающегоУстройства", Справочники.бит_ТипыЗапирающихУстройств.ПустаяСсылка());
	СведенияОбЛс.Вставить("Ответственный"            , Справочники.бит_Проживающие.ПустаяСсылка());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , КонецДня(ПараметрыОтчета.КонецПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет", ПараметрыОтчета.ЛицевойСчет);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Наименование КАК НаименованиеЛС,
	|	бит_ЛицевыеСчета.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ЛицевыеСчета.Здание.Район КАК Район,
	|	бит_ЛицевыеСчета.Здание.Участок КАК Участок,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета КАК Улица,
	|	бит_ЛицевыеСчета.Здание,
	|	бит_ЛицевыеСчета.Здание.Корпус КАК Корпус,
	|	бит_ЛицевыеСчета.Здание.Строение КАК Строение,
	|	бит_ЛицевыеСчета.Квартира,
	|	бит_ЛицевыеСчета.Идентификатор,
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ТипПлиты,
	|	бит_СведенияОКвартиреСрезПоследних.ТипЗапирающегоУстройства,
	|	бит_ЛицевыеСчета.Организация,
	|	бит_ЛицевыеСчета.Квартира.Этаж КАК Этаж
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Период, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка = &ЛицевойСчет";
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ЗаполнитьЗначенияСвойств(СведенияОбЛс, Выборка);
	
	СведенияОбЛс.Ответственный = ОтветственноеЛицоПоЛС(КонецДня(ПараметрыОтчета.КонецПериода), ПараметрыОтчета.ЛицевойСчет);
	
	СведенияОбЛс.Вставить("СписокУслуг"      , ПолучитьТаблицуУслуг(ПараметрыОтчета, СведенияОбЛс.СтатусКвартиры, СведенияОбЛс.ТипКвартиры));
	
	Возврат СведенияОбЛс;
	
КонецФункции // ()

// Функция получает таблицу услуг.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьТаблицуУслугСПеней(ПараметрыОтчета, СтатусКвартиры, ТипКвартиры)
	
	Число_17_4 = ОбщегоНазначения.ОписаниеТипаЧисло(17,4);
	Число_15_4 = ОбщегоНазначения.ОписаниеТипаЧисло(17,4);
	
	СписокУслуг = Новый ТаблицаЗначений;
	СписокУслуг.Колонки.Добавить("Услуга"                         , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	СписокУслуг.Колонки.Добавить("РежимПотребления"               , Новый ОписаниеТипов("СправочникСсылка.бит_РежимыПотребленияУслуг"));
	СписокУслуг.Колонки.Добавить("Поставщик"                      , Новый ОписаниеТипов("СправочникСсылка.бит_ПоставщикиУслуг"));
	СписокУслуг.Колонки.Добавить("СпособРасчета"                  , Новый ОписаниеТипов("ПеречислениеСсылка.бит_СпособыРасчетаПоУслугам"));
	СписокУслуг.Колонки.Добавить("ГрафаОтчетаГЦЖС"                , Новый ОписаниеТипов("ПеречислениеСсылка.бит_ГрафыОтчетаПоГЦЖС"));
	СписокУслуг.Колонки.Добавить("КоличествоЕдиницПотребления"    , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	СписокУслуг.Колонки.Добавить("ПлановаяСтавка"                 , Число_17_4);
	СписокУслуг.Колонки.Добавить("ОсновнаяСтавка"                 , Число_17_4);
	СписокУслуг.Колонки.Добавить("СверхНормативнаяСтавка"         , Число_17_4);
	СписокУслуг.Колонки.Добавить("Тариф"                          , Число_15_4);
	СписокУслуг.Колонки.Добавить("НаОдного"                       , Число_15_4);
	СписокУслуг.Колонки.Добавить("НаДвоих"                        , Число_15_4);
	СписокУслуг.Колонки.Добавить("НаСемью"                        , Число_15_4);
	СписокУслуг.Колонки.Добавить("ДопНормаНаСемью"                , Число_15_4);
	СписокУслуг.Колонки.Добавить("ДопНормаНаКаждого"              , Число_15_4);
	СписокУслуг.Колонки.Добавить("ИспользоватьДопНормуНаОдного"   , Новый ОписаниеТипов("Булево"));
	СписокУслуг.Колонки.Добавить("ИспользоватьДопНормуНаЛьготника", Новый ОписаниеТипов("Булево"));
	СписокУслуг.Колонки.Добавить("НаЛицевойСчет"                  , Число_15_4);
	СписокУслуг.Колонки.Добавить("НормативПотребленияПоКу"        , Число_15_4);
	СписокУслуг.Колонки.Добавить("НаСемью4"                       , Число_15_4);
	СписокУслуг.Колонки.Добавить("НаСемью5"                       , Число_15_4);
