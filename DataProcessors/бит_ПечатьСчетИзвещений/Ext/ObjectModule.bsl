#Область ПроцедурыИФункцииПечатиКвитанций

// Печать макета по алгоритму пользовательской функции.
//
// Параметры:
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ВыполнитьПользовательскуюФункцию()
	
	Результат = Неопределено;
	
	Попытка
		Выполнить(МакетКв.КодФункции);
	Исключение	
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Ошибка выполнения пользовательской функции:
									|%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции

// Печать макета Счет - извещение.
//
Функция ПечатьСчетИзвещение(ДляКиева = Ложь) Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	// Области отрвной части.
	ОбластьПолучатель       = мМакет.ПолучитьОбласть("Получатель");
	ОбластьПлательщик       = мМакет.ПолучитьОбласть("Плательщик");
	ОбластьПлательщикПодвал = мМакет.ПолучитьОбласть("ПлательщикПодвал");
	ОбластьШтрихКод         = мМакет.ПолучитьОбласть("ШтрихКод");
	
	// Основные области печати.
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	Попытка
		СтрокаРасшифровкиГр = мМакет.ПолучитьОбласть("СтрокаРасшифровкиГр");
	Исключение
		СтрокаРасшифровкиГр = Неопределено;
	КонецПопытки;
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого"); 
	СтрокаПриборовУчета = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ШапкаПриборыУчета   = мМакет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	ОбластьКассовыйСбор     = мМакет.ПолучитьОбласть("КассовыйСбор");
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	Если ДляКиева Тогда
		СтрокаПриборовУчета = мМакет.ПолучитьОбласть("СтрокаПриборовУчета_2");
	КонецЕсли; 
	
	СчВывода = ?(мТаблицаПечатиСчетчиков.Количество() > 0,4,5);
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате        + мСтруктураДанных.ПроцентОтОплаты;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
		
		Квитанция.Вывести(ОбластьПолучатель);
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШтрихКод.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
			Квитанция.Вывести(ОбластьШтрихКод);
		Иначе
			ОбластьШтрихКод.Рисунки.очистить();
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьПлательщик);
		
		Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
			Квитанция.Вывести(ШапкаПриборыУчета);
		КонецЕсли; 
		
		Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
			
			Если СчВывода = 0 Тогда
				Прервать;
			КонецЕсли; 
			
			СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);
			
			Квитанция.Вывести(СтрокаПриборовУчета);
			
			СчВывода = СчВывода - 1;
			
		КонецЦикла; 
		
		Пока НЕ СчВывода = 0 Цикл
			
			Квитанция.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
			
		КонецЦикла;
		
		Квитанция.Вывести(ОбластьПлательщикПодвал);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьШапка);
	
	Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
		Квитанция.Вывести(ШапкаПриборыУчета);
	КонецЕсли; 
	
	Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
		
		СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
		ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);

		Квитанция.Вывести(СтрокаПриборовУчета);
		
		СчВывода = СчВывода - 1;
		
	КонецЦикла;
	
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Если НЕ СтрокаРасшифровкиГр = Неопределено
		И (ГруппироватьУслуги ИЛИ мСтруктураДанных.ГруппироватьУслуги) Тогда
		
		Запрос = ПолучитьзапросГруппировки(мТаблицаПечати);
		ВыборкаГруп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруп.Следующий() Цикл
			
			СтрокаРасшифровкиГр.Параметры.Заполнить(ВыборкаГруп);
			СтрокаРасшифровкиГр.Параметры.УслугаПредставление = ВРег(ВыборкаГруп.ГруппаУслугиПредставление);
			
			Выборка = ВыборкаГруп.Выбрать();
			
			Если Выборка.Количество() = 1 Тогда // Едсинственная услуга в группировки.
				
				Выборка.Следующий();
				
				СтрокаРасшифровкиГр.Параметры.Заполнить(Выборка);
				СтрокаРасшифровкиГр.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
				Квитанция.Вывести(СтрокаРасшифровкиГр);
				
			ИначеЕсли Выборка.Количество() > 1 Тогда 
				
				Квитанция.Вывести(СтрокаРасшифровкиГр);
				
				Пока Выборка.Следующий() И РасскрытьСоставГрупп Цикл
					СтрокаРасшифровки.Параметры.Заполнить(Выборка);
					Квитанция.Вывести(СтрокаРасшифровки);
				КонецЦикла; 
				
			ИначеЕсли ВыборкаГруп.Услуга.Пустая() Тогда 
				
				Пока Выборка.Следующий() Цикл
					СтрокаРасшифровкиГр.Параметры.Заполнить(Выборка);
					СтрокаРасшифровкиГр.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
					Квитанция.Вывести(СтрокаРасшифровкиГр);
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЦикла;
		
	Иначе
		
		Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
			СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
			Квитанция.Вывести(СтрокаРасшифровки);
		КонецЦикла;
	
	КонецЕсли;
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		
		// Вывод информации о кассовом сборе.
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "ПроцентОтОплаты", мСтруктураДанных.ПроцентОтОплаты);
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "Процент"        , Процент);
		
		Если мСтруктураДанных.КОплатеЗаМесяц = мСтруктураДанных.КОплате Тогда
			мСтруктураДанных.КОплатеЗаМесяц = мСтруктураДанных.КОплатеЗаМесяц + мСтруктураДанных.ПроцентОтОплаты;
		КонецЕсли; 
		
		Квитанция.Вывести(ОбластьКассовыйСбор);
		
	КонецЕсли;
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьИтого);
	
	Если ЗначениеЗаполнено(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли; 
	
	Если ИспользоватьQR = Истина Тогда
		
		Попытка	
			ОбластьШтрихкодQR                   = мМакет.ПолучитьОбласть("ШтрихкодQR");
		Исключение
		КонецПопытки;
		
		НапечататьQRКод(Квитанция, ОбластьШтрихкодQR);
	Иначе
	    УбратьQRКод(Квитанция)
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Счет - извещение с 8-мью счетчиками.
//
Функция ПечатьСчетИзвещение1() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьПолучатель       = мМакет.ПолучитьОбласть("Получатель");
	ОбластьПлательщик       = мМакет.ПолучитьОбласть("Плательщик");
	ОбластьШтрихКод         = мМакет.ПолучитьОбласть("ШтрихКод");
	ОбластьПлательщикПодвал = мМакет.ПолучитьОбласть("ПлательщикПодвал");
	
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого"); 
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	ОбластьКассовыйСбор     = мМакет.ПолучитьОбласть("КассовыйСбор");
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	ШапкаПриборыУчетаЛево    = мМакет.ПолучитьОбласть("ШапкаПриборыУчетаЛево");
	СтрокаПриборовУчетаЛево  = мМакет.ПолучитьОбласть("СтрокаПриборовУчетаЛево");
	ШапкаПриборыУчетаПраво   = мМакет.ПолучитьОбласть("ШапкаПриборыУчетаПраво");
	СтрокаПриборовУчетаПраво = мМакет.ПолучитьОбласть("СтрокаПриборовУчетаПраво");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате + мСтруктураДанных.ПроцентОтОплаты;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	КолВоСч       = мТаблицаПечатиСчетчиков.Количество();
	СчВыводаЛево  = ?(КолВоСч > 0, 4, 5);
	СчВыводаПраво = 0;
	Если КолВоСч > 4 Тогда
		СчВыводаПраво = Мин(КолВоСч - 4, 4);
	КонецЕсли;
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
		
		// Вывод информаци о получателе.
		Квитанция.Вывести(ОбластьПолучатель);
		
		// Формирование картинки штрихкода.
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШтрихКод.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
			Квитанция.Вывести(ОбластьШтрихКод);
		Иначе
			ОбластьШтрихКод.Рисунки.очистить();
		КонецЕсли;
		
		// Вывод информации о плательщике.
		Квитанция.Вывести(ОбластьПлательщик);
		
		// Вывод счетчиков в машинопечатный блок.
		
		Если КолВоСч > 0 Тогда
			Квитанция.Вывести(ШапкаПриборыУчетаЛево);
		КонецЕсли;
		
		Если КолВоСч > 4 Тогда
			Квитанция.Присоединить(ШапкаПриборыУчетаПраво);
		КонецЕсли; 
		
		Для Значение = 1 По КолВоСч Цикл
			
			Если СчВыводаЛево = 0 И СчВыводаПраво = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если НЕ СчВыводаЛево = 0 Тогда
				
				СтрокаТаблицы = мТаблицаПечатиСчетчиков[Значение-1];
				
				СтрокаПриборовУчетаЛево.Параметры.Заполнить(СтрокаТаблицы);
				ЗаполнитьПараметр(СтрокаПриборовУчетаЛево, "Услуга", СтрокаТаблицы.СокрНаименование);
				Квитанция.Вывести(СтрокаПриборовУчетаЛево);
				
				СчВыводаЛево = СчВыводаЛево - 1;
				
			КонецЕсли;
			
			Если НЕ СчВыводаПраво = 0 Тогда
				
				СтрокаТаблицы = мТаблицаПечатиСчетчиков[Значение+4-1];
				
				СтрокаПриборовУчетаПраво.Параметры.Заполнить(СтрокаТаблицы);
				ЗаполнитьПараметр(СтрокаПриборовУчетаПраво, "Услуга", СтрокаТаблицы.СокрНаименование);
				Квитанция.Присоединить(СтрокаПриборовУчетаПраво);
				
				СчВыводаПраво = СчВыводаПраво - 1;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		Пока НЕ СчВыводаЛево = 0 Цикл
			
			Квитанция.Вывести(СтрокаВывода);
			СчВыводаЛево = СчВыводаЛево - 1;
			
		КонецЦикла;
		
		Квитанция.Вывести(ОбластьПлательщикПодвал);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьШапка);
	
	// Вывод счетчиков в отрывной блок.
	
	Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
		Квитанция.Вывести(ШапкаПриборыУчетаЛево);
	КонецЕсли;
	
	СчВыводаЛево  = КолВоСч;
	СчВыводаПраво = 0;
	Половина      = 0;
	
	Если КолВоСч > 4 Тогда
		
		Квитанция.Присоединить(ШапкаПриборыУчетаПраво);
		
		Половина = Окр(КолВоСч/2,0, РежимОкругления.Окр15как20);
		СчВыводаЛево  = Макс(4,Половина);
		СчВыводаПраво = КолВоСч - СчВыводаЛево;
		Половина      = СчВыводаЛево;
		
	КонецЕсли; 
	
	Для Значение = 1 По КолВоСч Цикл
		
		Если СчВыводаЛево = 0 И СчВыводаПраво = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если НЕ СчВыводаЛево = 0 Тогда
			
			СтрокаТаблицы = мТаблицаПечатиСчетчиков[Значение-1];
			
			СтрокаПриборовУчетаЛево.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(СтрокаПриборовУчетаЛево, "Услуга", СтрокаТаблицы.СокрНаименование);
			Квитанция.Вывести(СтрокаПриборовУчетаЛево);
			
			СчВыводаЛево = СчВыводаЛево - 1;
			
		КонецЕсли;
		
		Если НЕ СчВыводаПраво = 0 Тогда
			
			СтрокаТаблицы = мТаблицаПечатиСчетчиков[Значение+Половина-1];
			
			СтрокаПриборовУчетаПраво.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(СтрокаПриборовУчетаПраво, "Услуга", СтрокаТаблицы.СокрНаименование);
			Квитанция.Присоединить(СтрокаПриборовУчетаПраво);
			
			СчВыводаПраво = СчВыводаПраво - 1;
			
		КонецЕсли;
		
	КонецЦикла;
	// Вывод таблицы с данными о начислениях.
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
		
		СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
		Квитанция.Вывести(СтрокаРасшифровки);
		
	КонецЦикла; 
	
	// Вывод итоговой информации.
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		
		// Вывод информации о кассовом сборе.
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "ПроцентОтОплаты", мСтруктураДанных.ПроцентОтОплаты);
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "Процент", Процент);
		
		Если мСтруктураДанных.КОплатеЗаМесяц = мСтруктураДанных.КОплате Тогда
			мСтруктураДанных.КОплатеЗаМесяц = мСтруктураДанных.КОплатеЗаМесяц + мСтруктураДанных.ПроцентОтОплаты;
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьКассовыйСбор);
		
	КонецЕсли;
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьИтого);
	
	// Вывод произвольного сообщения.
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		Квитанция.Вывести(ОбластьЛиния);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
		Квитанция.Вывести(ОбластьЛиния);
	КонецЕсли; 
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Счет - извещение №2.
//
Функция ПечатьСчетИзвещение2() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьПолучатель       = мМакет.ПолучитьОбласть("Получатель");
	ОбластьПлательщик       = мМакет.ПолучитьОбласть("Плательщик");
	ОбластьШтрихКод         = мМакет.ПолучитьОбласть("ШтрихКод");
	ОбластьПлательщикПодвал = мМакет.ПолучитьОбласть("ПлательщикПодвал");
	
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого");
	ОбластьИтогоПени    = мМакет.ПолучитьОбласть("ИтогоПени");
	СтрокаПриборовУчета = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ШапкаПриборыУчета   = мМакет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	СчВывода = ?(мТаблицаПечатиСчетчиков.Количество() > 0,4,5);
	
	// Блок отрывной печати начало:
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
		
		Квитанция.Вывести(ОбластьПолучатель);
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШтрихКод.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
			Квитанция.Вывести(ОбластьШтрихКод);
		Иначе
			ОбластьШтрихКод.Рисунки.очистить();
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьПлательщик);
		
		Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
			Квитанция.Вывести(ШапкаПриборыУчета);
		КонецЕсли; 
		
		Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
			
			Если СчВывода = 0 Тогда
				Прервать;
			КонецЕсли; 
			
			СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);
			Квитанция.Вывести(СтрокаПриборовУчета);
			
			СчВывода = СчВывода - 1;
			
		КонецЦикла; 
		
		Пока НЕ СчВывода = 0 Цикл
			
			Квитанция.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
			
		КонецЦикла;
		
		Квитанция.Вывести(ОбластьПлательщикПодвал);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьШапка);
	
	Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
		Квитанция.Вывести(ШапкаПриборыУчета);
	КонецЕсли; 
	
	Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
		
		СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
		ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);
		Квитанция.Вывести(СтрокаПриборовУчета);
		
		СчВывода = СчВывода - 1;
		
	КонецЦикла;
	
	ШапкаЗаголовки.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
		
		СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
		Квитанция.Вывести(СтрокаРасшифровки);
		
	КонецЦикла; 
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	
	Если мСтруктураДанных.ИтогПени > 0 Тогда
		
		ОбластьИтогоПени.Параметры.Заполнить(мСтруктураДанных);
		Квитанция.Вывести(ОбластьИтогоПени);
		
	КонецЕсли;
	
	Квитанция.Вывести(ОбластьИтого);
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли; 
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Счет - извещение №3.
//
Функция ПечатьСчетИзвещение3() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьПолучатель       = мМакет.ПолучитьОбласть("Получатель");
	ОбластьПлательщик       = мМакет.ПолучитьОбласть("Плательщик");
	ОбластьШтрихКод         = мМакет.ПолучитьОбласть("ШтрихКод");
	ОбластьПлательщикПодвал = мМакет.ПолучитьОбласть("ПлательщикПодвал");
	
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого");
	ОбластьИтогоПени    = мМакет.ПолучитьОбласть("ИтогоПени");
	СтрокаПриборовУчета = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ШапкаПриборыУчета   = мМакет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	СчВывода = ?(мТаблицаПечатиСчетчиков.Количество() > 0,4,5);
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
		
		Квитанция.Вывести(ОбластьПолучатель);
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШтрихКод.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
			Квитанция.Вывести(ОбластьШтрихКод);
		Иначе
			ОбластьШтрихКод.Рисунки.очистить();
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьПлательщик);
		
		Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
			Квитанция.Вывести(ШапкаПриборыУчета);
		КонецЕсли;
		
		Квитанция.Вывести(ШапкаПриборыУчета);
		
		Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
			
			Если СчВывода = 0 Тогда
				Прервать;
			КонецЕсли; 
			
			СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);
			Квитанция.Вывести(СтрокаПриборовУчета);
			
			СчВывода = СчВывода - 1;
			
		КонецЦикла; 
		
		Пока НЕ СчВывода = 0 Цикл
			
			Квитанция.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
			
		КонецЦикла;
		
		Квитанция.Вывести(ОбластьПлательщикПодвал);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьШапка);
	
	Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
		Квитанция.Вывести(ШапкаПриборыУчета);
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
		
		СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
		Квитанция.Вывести(СтрокаПриборовУчета);
		
		СчВывода = СчВывода - 1;
		
	КонецЦикла;
	
	ШапкаЗаголовки.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
		
		СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
		Квитанция.Вывести(СтрокаРасшифровки);
		
	КонецЦикла; 
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	
	Если мСтруктураДанных.ИтогПени > 0 Тогда
		
		ОбластьИтогоПени.Параметры.Заполнить(мСтруктураДанных);
		Квитанция.Вывести(ОбластьИтогоПени);
		
	КонецЕсли;
	
	Квитанция.Вывести(ОбластьИтого);
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли; 
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Счет - извещение №4 Счет - извещение №5.
//
Функция ПечатьСчетИзвещение4(УчетОплатыВСальдо = Ложь) Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьПолучатель       = мМакет.ПолучитьОбласть("Получатель");
	ОбластьПлательщик       = мМакет.ПолучитьОбласть("Плательщик");
	ОбластьШтрихКод         = мМакет.ПолучитьОбласть("ШтрихКод");
	ОбластьПлательщикПодвал = мМакет.ПолучитьОбласть("ПлательщикПодвал");
	
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого"); 
	СтрокаПриборовУчета = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ШапкаПриборыУчета   = мМакет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	СчВывода = ?(мТаблицаПечатиСчетчиков.Количество() > 0, 4, 5);
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
		
		Квитанция.Вывести(ОбластьПолучатель);
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШтрихКод.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
			Квитанция.Вывести(ОбластьШтрихКод);
		Иначе
			ОбластьШтрихКод.Рисунки.очистить();
		КонецЕсли;
		
		Квитанция.Вывести(ОбластьПлательщик);
		
		Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
			Квитанция.Вывести(ШапкаПриборыУчета);
		КонецЕсли;
		
		Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
			
			Если СчВывода = 0 Тогда
				Прервать;
			КонецЕсли; 
			
			СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
			ЗаполнитьПараметр(СтрокаПриборовУчета, "Услуга", СтрокаТаблицы.СокрНаименование);
			Квитанция.Вывести(СтрокаПриборовУчета);
			
			СчВывода = СчВывода - 1;
			
		КонецЦикла; 
		
		Пока НЕ СчВывода = 0 Цикл
			
			Квитанция.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
			
		КонецЦикла;
		
		Квитанция.Вывести(ОбластьПлательщикПодвал);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьШапка);
	
	Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
		Квитанция.Вывести(ШапкаПриборыУчета);
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из мТаблицаПечатиСчетчиков Цикл
		
		СтрокаПриборовУчета.Параметры.Заполнить(СтрокаТаблицы);
		Квитанция.Вывести(СтрокаПриборовУчета);
		
		СчВывода = СчВывода - 1;
		
	КонецЦикла;
	
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
		
		СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
		Квитанция.Вывести(СтрокаРасшифровки);
		
	КонецЦикла; 
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьИтого);
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли; 
	
	Если ИспользоватьQR = Истина Тогда
		
		Попытка	
			ОбластьШтрихкодQR                   = мМакет.ПолучитьОбласть("ШтрихкодQR");
		Исключение
		КонецПопытки;
		
		НапечататьQRКод(Квитанция, ОбластьШтрихкодQR);
	Иначе
		УбратьQRКод(Квитанция)
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

// Печать макета Счет - извещение №4 с 8-мью счетчиками.
//
Функция ПечатьСчетИзвещение5() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьПолучатель       = мМакет.ПолучитьОбласть("Получатель");
	ОбластьПлательщик       = мМакет.ПолучитьОбласть("Плательщик");
	ОбластьШтрихКод         = мМакет.ПолучитьОбласть("ШтрихКод");
	ОбластьПлательщикПодвал = мМакет.ПолучитьОбласть("ПлательщикПодвал");
	
	ОбластьШапка        = мМакет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = мМакет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = мМакет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = мМакет.ПолучитьОбласть("Итого"); 
	СтрокаВывода        = мМакет.ПолучитьОбласть("СтрокаВывода");
	
	ОбластьЛиния            = мМакет.ПолучитьОбласть("Линия");
	
	ШапкаПриборыУчетаЛево    = мМакет.ПолучитьОбласть("ШапкаПриборыУчетаЛево");
	СтрокаПриборовУчетаЛево  = мМакет.ПолучитьОбласть("СтрокаПриборовУчетаЛево");
	ШапкаПриборыУчетаПраво   = мМакет.ПолучитьОбласть("ШапкаПриборыУчетаПраво");
	СтрокаПриборовУчетаПраво = мМакет.ПолучитьОбласть("СтрокаПриборовУчетаПраво");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	КолВоСч = мТаблицаПечатиСчетчиков.Количество();
	СчВыводаЛево = ?(КолВоСч > 0, 4, 5);
	
	СчВыводаПраво = 0;
	
	Если КолВоСч > 4 Тогда
		СчВыводаПраво = Мин(КолВоСч - 4, 4);
	КонецЕсли;
	
	// Блок отрывной печати начало:.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		ОбластьПолучатель.Параметры.Заполнить(мСтруктураДанных);
		ОбластьПлательщик.Параметры.Заполнить(мСтруктураДанных);
		
		// Вывод информаци о получателе.
		Квитанция.Вывести(ОбластьПолучатель);
		
		// Формирование картинки штрихкода.
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШтрихКод.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0,0,СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
			Квитанция.Вывести(ОбластьШтрихКод);
		Иначе
			ОбластьШтрихКод.Рисунки.очистить();
		КонецЕсли;
		
		// Вывод информации о плательщике.
		Квитанция.Вывести(ОбластьПлательщик);
		
		// Вывод счетчиков в машинопечатный блок.
		
		Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда

			Квитанция.Вывести(ШапкаПриборыУчетаЛево);

		КонецЕсли;
		
		Если КолВоСч > 4 Тогда
			Квитанция.Присоединить(ШапкаПриборыУчетаПраво);
		КонецЕсли; 
		
		Для Значение = 1 По КолВоСч Цикл
			
			Если СчВыводаЛево = 0 И СчВыводаПраво = 0 Тогда
				Прервать;
			КонецЕсли;
			
			Если НЕ СчВыводаЛево = 0 Тогда
				
				СтрокаТаблицы = мТаблицаПечатиСчетчиков[Значение-1];
				
				СтрокаПриборовУчетаЛево.Параметры.Заполнить(СтрокаТаблицы);
				ЗаполнитьПараметр(СтрокаПриборовУчетаЛево, "Услуга", СтрокаТаблицы.СокрНаименование);
				Квитанция.Вывести(СтрокаПриборовУчетаЛево);
				
				СчВыводаЛево = СчВыводаЛево - 1;
				
			КонецЕсли;
			
			Если НЕ СчВыводаПраво = 0 Тогда
				
				СтрокаТаблицы = мТаблицаПечатиСчетчиков[Значение+4-1];
				
				СтрокаПриборовУчетаПраво.Параметры.Заполнить(СтрокаТаблицы);
				ЗаполнитьПараметр(СтрокаПриборовУчетаПраво, "Услуга", СтрокаТаблицы.СокрНаименование);
				Квитанция.Присоединить(СтрокаПриборовУчетаПраво);
				
				СчВыводаПраво = СчВыводаПраво - 1;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		Пока НЕ СчВыводаЛево = 0 Цикл
			
			Квитанция.Вывести(СтрокаВывода);
			СчВыводаЛево = СчВыводаЛево - 1;
			
		КонецЦикла;
		
		Квитанция.Вывести(ОбластьПлательщикПодвал);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьШапка);
	
	// Вывод счетчиков в отрывной блок.
	
	Если мТаблицаПечатиСчетчиков.Количество() > 0 Тогда
		Квитанция.Вывести(ШапкаПриборыУчетаЛево);
	КонецЕсли;
	
	СчВыводаЛево  = КолВоСч;
	СчВыводаПраво = 0;
	Половина      = 0;
	
	Если КолВоСч > 4 Тогда
		
		Квитанция.Присоединить(ШапкаПриборыУчетаПраво);
		
		Половина = Окр(КолВоСч/2,0, РежимОкругления.Окр15как20);
		СчВыводаЛево  = Макс(4,Половина);
		СчВыводаПраво = КолВоСч - СчВыводаЛево;
		Половина      = СчВыводаЛево;
		
	КонецЕсли; 
	
	Для Значение = 1 По КолВоСч Цикл
		
		Если СчВыводаЛево = 0 И СчВыводаПраво = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Если НЕ СчВыводаЛево = 0 Тогда
			
			СтрокаТаблицы = мТаблицаПечатиСчетчиков[Значение-1];
			
			СтрокаПриборовУчетаЛево.Параметры.Заполнить(СтрокаТаблицы);
			Квитанция.Вывести(СтрокаПриборовУчетаЛево);
			
			СчВыводаЛево = СчВыводаЛево - 1;
			
		КонецЕсли;
		
		Если НЕ СчВыводаПраво = 0 Тогда
			
			СтрокаТаблицы = мТаблицаПечатиСчетчиков[Значение+Половина-1];
			
			СтрокаПриборовУчетаПраво.Параметры.Заполнить(СтрокаТаблицы);
			Квитанция.Присоединить(СтрокаПриборовУчетаПраво);
			
			СчВыводаПраво = СчВыводаПраво - 1;
			
		КонецЕсли;
		
	КонецЦикла;
	// Вывод таблицы с данными о начислениях.
	Квитанция.Вывести(ШапкаЗаголовки);
	
	Для каждого СтрокаТаблицы Из мТаблицаПечати Цикл
		
		СтрокаРасшифровки.Параметры.Заполнить(СтрокаТаблицы);
		Квитанция.Вывести(СтрокаРасшифровки);
		
	КонецЦикла; 
	
	// Вывод итоговой информации.
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьИтого);
	
	// Вывод произвольного сообщения.
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		Квитанция.Вывести(ОбластьЛиния);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
		Квитанция.Вывести(ОбластьЛиния);
	КонецЕсли; 
	
	Возврат Квитанция;
	
КонецФункции

// Печать макет Квитанции #1 Квитанции #1 чек слева.
//
Функция ПечатьКвитанция()
	
	Квитанция = Новый ТабличныйДокумент;

	ОбластьКассовыйСбор    = мМакет.ПолучитьОбласть("КассовыйСбор");
	ОбластьШапка           = мМакет.ПолучитьОбласть("Шапка");
	ОбластьШапка2          = мМакет.ПолучитьОбласть("Шапка2");
	Попытка
		ОбластьСтрокаГр = мМакет.ПолучитьОбласть("СтрокаГр");
	Исключение
		ОбластьСтрокаГр = Неопределено;
	КонецПопытки;
	ОбластьСтрока          = мМакет.ПолучитьОбласть("Строка");
	ОбластьВсего           = мМакет.ПолучитьОбласть("Всего");
	ОбластьПодвал          = мМакет.ПолучитьОбласть("Подвал");
	ОбластьПодвал2         = мМакет.ПолучитьОбласть("Подвал2");
	ПустаяСтрока           = мМакет.ПолучитьОбласть("ПустаяСтрока");
	СтрокаПРиборы          = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ОбластьСтрокаОбращение = мМакет.ПолучитьОбласть("СтрокаОбращение");
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		мСтруктураДанных.КОплате = мСтруктураДанных.КОплате + мСтруктураДанных.ПроцентОтОплаты;
	КонецЕсли;
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШапка.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
		Иначе
			ОбластьШапка.Рисунки.очистить();
		КонецЕсли;
		
		ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
		ЗаполнитьПараметр(ОбластьШапка, "ПолучательПредставление", мСтруктураДанных.ПолучательПредставление);
		ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизации", мСтруктураДанных.ПолучательАдрес);
		ЗаполнитьПараметр(ОбластьШапка, "ИННОрганизации", мСтруктураДанных.ПолучательИНН);
		
		Квитанция.Вывести(ОбластьШапка);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка2.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьШапка2);
	
	Отбор = Новый Структура;
	
	Если НЕ ОбластьСтрокаГр = Неопределено
		И (ГруппироватьУслуги ИЛИ мСтруктураДанных.ГруппироватьУслуги) Тогда
		
		Запрос = ПолучитьзапросГруппировки(мТаблицаПечати);
		ВыборкаГруп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
		
		Пока ВыборкаГруп.Следующий() Цикл
			
			ОбластьСтрокаГр.Параметры.Заполнить(ВыборкаГруп);
			ОбластьСтрокаГр.Параметры.УслугаПредставление = ВРег(ВыборкаГруп.ГруппаУслугиПредставление);
			
			Выборка = ВыборкаГруп.Выбрать();
			
			Если Выборка.Количество() = 1 Тогда // Едсинственная услуга в группировки
				
				Выборка.Следующий();
				
				ОбластьСтрокаГр.Параметры.Заполнить(Выборка);
				ОбластьСтрокаГр.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
				
				Отбор.Очистить();
				Отбор.Вставить("Услуга"     , Выборка.Услуга);
				СтрокиСЧ = мТаблицаПечатиСчетчиков.НайтиСтроки(Отбор);
				
				Если СтрокиСЧ.Количество() = 1 Тогда
					ОбластьСтрокаГр.Параметры.Заполнить(СтрокиСЧ[0]);
					Если СтрокиСЧ[0].ОтПоказаний = СтрокиСЧ[0].ДоПоказаний и ВыборкаГруп.Количество <> 0 Тогда
						ПоказанияОт = СтрокиСЧ[0].ДоПоказаний - ВыборкаГруп.Количество;
						Если ПоказанияОт < 0 Тогда
							ПоказанияОт = СтрокиСЧ[0].Счетчик.Разрядность - СтрокиСЧ[0].ДоПоказаний;
						КонецЕсли;
						ЗаполнитьПараметр(ОбластьСтрокаГр, "ОтПоказаний", ПоказанияОт);
					КонецЕсли; 
				КонецЕсли;
				
				ОбластьСтрокаГр.Параметры.Заполнить(Выборка);
				Квитанция.Вывести(ОбластьСтрокаГр);
				
				Для Значение=0 по ОбластьСтрокаГр.Параметры.Количество() - 1 Цикл
					ОбластьСтрокаГр.Параметры.Установить(Значение, "");
				КонецЦикла;
				
				Если СтрокиСЧ.Количество() > 1 Тогда
					Для каждого СЧ Из СтрокиСЧ Цикл
						СтрокаПРиборы.Параметры.Заполнить(СЧ);
						Если СЧ.ОтПоказаний = СЧ.ДоПоказаний и ВыборкаГруп.Количество <> 0 Тогда
							ПоказанияОт = СЧ.ДоПоказаний - ВыборкаГруп.Количество;
							Если ПоказанияОт < 0 Тогда
								ПоказанияОт = СЧ.Счетчик.Разрядность - СЧ.ДоПоказаний;
							КонецЕсли;
						КонецЕсли; 
						Квитанция.Вывести(СтрокаПРиборы);
					КонецЦикла;
				КонецЕсли;
				
				Для Значение=0 по СтрокаПРиборы.Параметры.Количество() - 1 Цикл
					СтрокаПРиборы.Параметры.Установить(Значение, "");
				КонецЦикла;
				
			ИначеЕсли Выборка.Количество() > 1 Тогда 
				
				Квитанция.Вывести(ОбластьСтрокаГр);
				
				Пока Выборка.Следующий() Цикл
					
					ОбластьСтрока.Параметры.Заполнить(Выборка);
					
					Отбор.Очистить();
					Отбор.Вставить("Услуга"     , Выборка.Услуга);
					СтрокиСЧ = мТаблицаПечатиСчетчиков.НайтиСтроки(Отбор);
					
					Если РасскрытьСоставГрупп Тогда
						
						Если СтрокиСЧ.Количество() = 1 Тогда
							ОбластьСтрока.Параметры.Заполнить(СтрокиСЧ[0]);
							Если СтрокиСЧ[0].ОтПоказаний = СтрокиСЧ[0].ДоПоказаний и ВыборкаГруп.Количество <> 0 Тогда
								ПоказанияОт = СтрокиСЧ[0].ДоПоказаний - ВыборкаГруп.Количество;
								Если ПоказанияОт < 0 Тогда
									ПоказанияОт = СтрокиСЧ[0].Счетчик.Разрядность - СтрокиСЧ[0].ДоПоказаний;
								КонецЕсли;
								ЗаполнитьПараметр(ОбластьСтрока, "ОтПоказаний", ПоказанияОт);
							КонецЕсли; 
						КонецЕсли;
						
						ОбластьСтрока.Параметры.Заполнить(Выборка);
						Квитанция.Вывести(ОбластьСтрока);
						
						Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
							ОбластьСтрока.Параметры.Установить(Значение, "");
						КонецЦикла;
						
					КонецЕсли; // РасскрытьСоставГрупп.
					
					Если СтрокиСЧ.Количество() > 1 Тогда
						Для каждого СЧ Из СтрокиСЧ Цикл
							СтрокаПРиборы.Параметры.Заполнить(СЧ);
							Если СЧ.ОтПоказаний = СЧ.ДоПоказаний и ВыборкаГруп.Количество <> 0 Тогда
								ПоказанияОт = СЧ.ДоПоказаний - ВыборкаГруп.Количество;
								Если ПоказанияОт < 0 Тогда
									ПоказанияОт = СЧ.Счетчик.Разрядность - СЧ.ДоПоказаний;
								КонецЕсли;
							КонецЕсли; 
							Квитанция.Вывести(СтрокаПРиборы);
						КонецЦикла;
					КонецЕсли;
					
					Для Значение=0 по СтрокаПРиборы.Параметры.Количество() - 1 Цикл
						СтрокаПРиборы.Параметры.Установить(Значение, "");
					КонецЦикла;
					
				КонецЦикла; 
				
			ИначеЕсли ВыборкаГруп.Услуга.Пустая() Тогда 
				
				Пока Выборка.Следующий() Цикл
					ОбластьСтрокаГр.Параметры.Заполнить(Выборка);
					ОбластьСтрокаГр.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
					Квитанция.Вывести(ОбластьСтрокаГр);
					
					Для Значение=0 по ОбластьСтрокаГр.Параметры.Количество() - 1 Цикл
						ОбластьСтрокаГр.Параметры.Установить(Значение, "");
					КонецЦикла;
					
				КонецЦикла; 
				
			КонецЕсли;			
			
		КонецЦикла;
		
	Иначе
		Для каждого Строка Из мТаблицаПечати Цикл
			
			Отбор.Очистить();
			Отбор.Вставить("Услуга"     , Строка.Услуга);
			СтрокиСЧ = мТаблицаПечатиСчетчиков.НайтиСтроки(Отбор);
			
			Если СтрокиСЧ.Количество() = 1 Тогда
				ОбластьСтрока.Параметры.Заполнить(СтрокиСЧ[0]);
				Если СтрокиСЧ[0].ОтПоказаний = СтрокиСЧ[0].ДоПоказаний и Строка.Количество <> 0 Тогда
					
					ПоказанияОт = СтрокиСЧ[0].ДоПоказаний - Строка.Количество;
					Если ПоказанияОт < 0 Тогда
						
						ПоказанияОт = СтрокиСЧ[0].Счетчик.Разрядность - СтрокиСЧ[0].ДоПоказаний;
						
					КонецЕсли;
					ЗаполнитьПараметр(ОбластьСтрока, "ОтПоказаний", ПоказанияОт);
				КонецЕсли; 
			КонецЕсли;
			
			ОбластьСтрока.Параметры.Заполнить(Строка);
			Квитанция.Вывести(ОбластьСтрока);
			
			Если СтрокиСЧ.Количество() > 1 Тогда
				Для каждого СЧ Из СтрокиСЧ Цикл
					
					СтрокаПРиборы.Параметры.Заполнить(СЧ);
					Если СЧ.ОтПоказаний = СЧ.ДоПоказаний и Строка.Количество <> 0 Тогда
						
						ПоказанияОт = СЧ.ДоПоказаний - Строка.Количество;
						Если ПоказанияОт < 0 Тогда
							
							ПоказанияОт = СЧ.Счетчик.Разрядность - СЧ.ДоПоказаний;
							
						КонецЕсли;
						ЗаполнитьПараметр(ОбластьСтрока, "ОтПоказаний", ПоказанияОт);
					КонецЕсли; 
					
					Квитанция.Вывести(СтрокаПРиборы);
					
				КонецЦикла;
			КонецЕсли;
			
			Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
				
				ОбластьСтрока.Параметры.Установить(Значение, "");
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		
		// Вывод информации о кассовом сборе.
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "ПроцентОтОплаты", мСтруктураДанных.ПроцентОтОплаты);
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "Процент"        , Процент);
		
		Квитанция.Вывести(ОбластьКассовыйСбор);
		
	КонецЕсли;
	
	ОбластьВсего.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьВсего);
	
	КолПустСтрок = 12;
	
	Если КолПустСтрок > мТаблицаПечати.Количество() Тогда
		
		КолПустСтрок = КолПустСтрок - мТаблицаПечати.Количество();
		Пока КолПустСтрок <> 0 Цикл
			
			Квитанция.Вывести(ПустаяСтрока);
			КолПустСтрок = КолПустСтрок - 1;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ОбластьПодвал.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьПодвал);
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли;
	
	Квитанция.Вывести(ОбластьПодвал2);		
	
	Возврат Квитанция;
	
КонецФункции

Функция ПечатьКвитанцияСПБ()
	
	Квитанция = Новый ТабличныйДокумент;

	ОбластьКассовыйСбор    = мМакет.ПолучитьОбласть("КассовыйСбор");
	ОбластьШапка           = мМакет.ПолучитьОбласть("Шапка");
	ОбластьШапка2          = мМакет.ПолучитьОбласть("Шапка2");
	Попытка
		ОбластьСтрокаГр = мМакет.ПолучитьОбласть("СтрокаГр");
	Исключение
		ОбластьСтрокаГр = Неопределено;
	КонецПопытки;
	ОбластьСтрока          = мМакет.ПолучитьОбласть("Строка");
	ОбластьВсего           = мМакет.ПолучитьОбласть("Всего");
	ОбластьПодвал          = мМакет.ПолучитьОбласть("Подвал");
	ОбластьПодвал2         = мМакет.ПолучитьОбласть("Подвал2");
	ПустаяСтрока           = мМакет.ПолучитьОбласть("ПустаяСтрока");
	СтрокаПРиборы          = мМакет.ПолучитьОбласть("СтрокаПриборовУчета");
	ОбластьСтрокаОбращение = мМакет.ПолучитьОбласть("СтрокаОбращение");
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		мСтруктураДанных.КОплате = мСтруктураДанных.КОплате + мСтруктураДанных.ПроцентОтОплаты;
	КонецЕсли;
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
		
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШапка.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
		Иначе
			//ОбластьШапка.Рисунки.очистить();
		КонецЕсли;
		
		ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
		ЗаполнитьПараметр(ОбластьШапка, "ПолучательПредставление", мСтруктураДанных.ПолучательПредставление);
		ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизации", мСтруктураДанных.ПолучательАдрес);
		ЗаполнитьПараметр(ОбластьШапка, "ИННОрганизации", мСтруктураДанных.ПолучательИНН);
		
		Квитанция.Вывести(ОбластьШапка);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка2.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьШапка2);
	
	Отбор = Новый Структура;
	
	Если НЕ ОбластьСтрокаГр = Неопределено
		И (ГруппироватьУслуги ИЛИ мСтруктураДанных.ГруппироватьУслуги) Тогда
		
		Запрос = ПолучитьзапросГруппировки(мТаблицаПечати);
		ВыборкаГруп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);	
		
		Пока ВыборкаГруп.Следующий() Цикл
			
			ОбластьСтрокаГр.Параметры.Заполнить(ВыборкаГруп);
			ОбластьСтрокаГр.Параметры.УслугаПредставление = ВРег(ВыборкаГруп.ГруппаУслугиПредставление);
			
			Выборка = ВыборкаГруп.Выбрать();
			
			Если Выборка.Количество() = 1 Тогда // Едсинственная услуга в группировки
				
				Выборка.Следующий();
				
				ОбластьСтрокаГр.Параметры.Заполнить(Выборка);
				ОбластьСтрокаГр.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
				
				Отбор.Очистить();
				Отбор.Вставить("Услуга"     , Выборка.Услуга);
				СтрокиСЧ = мТаблицаПечатиСчетчиков.НайтиСтроки(Отбор);
				
				Если СтрокиСЧ.Количество() = 1 Тогда
					ОбластьСтрокаГр.Параметры.Заполнить(СтрокиСЧ[0]);
					Если СтрокиСЧ[0].ОтПоказаний = СтрокиСЧ[0].ДоПоказаний и ВыборкаГруп.Количество <> 0 Тогда
						ПоказанияОт = СтрокиСЧ[0].ДоПоказаний - ВыборкаГруп.Количество;
						Если ПоказанияОт < 0 Тогда
							ПоказанияОт = СтрокиСЧ[0].Счетчик.Разрядность - СтрокиСЧ[0].ДоПоказаний;
						КонецЕсли;
						ЗаполнитьПараметр(ОбластьСтрокаГр, "ОтПоказаний", ПоказанияОт);
					КонецЕсли; 
				КонецЕсли;
				
				ОбластьСтрокаГр.Параметры.Заполнить(Выборка);
				Квитанция.Вывести(ОбластьСтрокаГр);
				
				Для Значение=0 по ОбластьСтрокаГр.Параметры.Количество() - 1 Цикл
					ОбластьСтрокаГр.Параметры.Установить(Значение, "");
				КонецЦикла;
				
				Если СтрокиСЧ.Количество() > 1 Тогда
					Для каждого СЧ Из СтрокиСЧ Цикл
						СтрокаПРиборы.Параметры.Заполнить(СЧ);
						Если СЧ.ОтПоказаний = СЧ.ДоПоказаний и ВыборкаГруп.Количество <> 0 Тогда
							ПоказанияОт = СЧ.ДоПоказаний - ВыборкаГруп.Количество;
							Если ПоказанияОт < 0 Тогда
								ПоказанияОт = СЧ.Счетчик.Разрядность - СЧ.ДоПоказаний;
							КонецЕсли;
						КонецЕсли; 
						Квитанция.Вывести(СтрокаПРиборы);
					КонецЦикла;
				КонецЕсли;
				
				Для Значение=0 по СтрокаПРиборы.Параметры.Количество() - 1 Цикл
					СтрокаПРиборы.Параметры.Установить(Значение, "");
				КонецЦикла;
				
			ИначеЕсли Выборка.Количество() > 1 Тогда 
				
				Квитанция.Вывести(ОбластьСтрокаГр);
				
				Пока Выборка.Следующий() Цикл
					
					ОбластьСтрока.Параметры.Заполнить(Выборка);
					
					Отбор.Очистить();
					Отбор.Вставить("Услуга"     , Выборка.Услуга);
					СтрокиСЧ = мТаблицаПечатиСчетчиков.НайтиСтроки(Отбор);
					
					Если РасскрытьСоставГрупп Тогда
						
						Если СтрокиСЧ.Количество() = 1 Тогда
							ОбластьСтрока.Параметры.Заполнить(СтрокиСЧ[0]);
							Если СтрокиСЧ[0].ОтПоказаний = СтрокиСЧ[0].ДоПоказаний и ВыборкаГруп.Количество <> 0 Тогда
								ПоказанияОт = СтрокиСЧ[0].ДоПоказаний - ВыборкаГруп.Количество;
								Если ПоказанияОт < 0 Тогда
									ПоказанияОт = СтрокиСЧ[0].Счетчик.Разрядность - СтрокиСЧ[0].ДоПоказаний;
								КонецЕсли;
								ЗаполнитьПараметр(ОбластьСтрока, "ОтПоказаний", ПоказанияОт);
							КонецЕсли; 
						КонецЕсли;
						
						ОбластьСтрока.Параметры.Заполнить(Выборка);
						Квитанция.Вывести(ОбластьСтрока);
						
						Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
							ОбластьСтрока.Параметры.Установить(Значение, "");
						КонецЦикла;
						
					КонецЕсли; // РасскрытьСоставГрупп.
					
					Если СтрокиСЧ.Количество() > 1 Тогда
						Для каждого СЧ Из СтрокиСЧ Цикл
							СтрокаПРиборы.Параметры.Заполнить(СЧ);
							Если СЧ.ОтПоказаний = СЧ.ДоПоказаний и ВыборкаГруп.Количество <> 0 Тогда
								ПоказанияОт = СЧ.ДоПоказаний - ВыборкаГруп.Количество;
								Если ПоказанияОт < 0 Тогда
									ПоказанияОт = СЧ.Счетчик.Разрядность - СЧ.ДоПоказаний;
								КонецЕсли;
							КонецЕсли; 
							Квитанция.Вывести(СтрокаПРиборы);
						КонецЦикла;
					КонецЕсли;
					
					Для Значение=0 по СтрокаПРиборы.Параметры.Количество() - 1 Цикл
						СтрокаПРиборы.Параметры.Установить(Значение, "");
					КонецЦикла;
					
				КонецЦикла; 
				
			ИначеЕсли ВыборкаГруп.Услуга.Пустая() Тогда 
				
				Пока Выборка.Следующий() Цикл
					ОбластьСтрокаГр.Параметры.Заполнить(Выборка);
					ОбластьСтрокаГр.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
					Квитанция.Вывести(ОбластьСтрокаГр);
					
					Для Значение=0 по ОбластьСтрокаГр.Параметры.Количество() - 1 Цикл
						ОбластьСтрокаГр.Параметры.Установить(Значение, "");
					КонецЦикла;
					
				КонецЦикла; 
				
			КонецЕсли;			
			
		КонецЦикла;
		
	Иначе
		Для каждого Строка Из мТаблицаПечати Цикл
			
			Отбор.Очистить();
			Отбор.Вставить("Услуга"     , Строка.Услуга);
			СтрокиСЧ = мТаблицаПечатиСчетчиков.НайтиСтроки(Отбор);
			
			Если СтрокиСЧ.Количество() = 1 Тогда
				ОбластьСтрока.Параметры.Заполнить(СтрокиСЧ[0]);
				Если СтрокиСЧ[0].ОтПоказаний = СтрокиСЧ[0].ДоПоказаний и Строка.Количество <> 0 Тогда
					
					ПоказанияОт = СтрокиСЧ[0].ДоПоказаний - Строка.Количество;
					Если ПоказанияОт < 0 Тогда
						
						ПоказанияОт = СтрокиСЧ[0].Счетчик.Разрядность - СтрокиСЧ[0].ДоПоказаний;
						
					КонецЕсли;
					ЗаполнитьПараметр(ОбластьСтрока, "ОтПоказаний", ПоказанияОт);
				КонецЕсли; 
			КонецЕсли;
			
			ОбластьСтрока.Параметры.Заполнить(Строка);
			Квитанция.Вывести(ОбластьСтрока);
			
			Если СтрокиСЧ.Количество() > 1 Тогда
				Для каждого СЧ Из СтрокиСЧ Цикл
					
					СтрокаПРиборы.Параметры.Заполнить(СЧ);
					Если СЧ.ОтПоказаний = СЧ.ДоПоказаний и Строка.Количество <> 0 Тогда
						
						ПоказанияОт = СЧ.ДоПоказаний - Строка.Количество;
						Если ПоказанияОт < 0 Тогда
							
							ПоказанияОт = СЧ.Счетчик.Разрядность - СЧ.ДоПоказаний;
							
						КонецЕсли;
						ЗаполнитьПараметр(ОбластьСтрока, "ОтПоказаний", ПоказанияОт);
					КонецЕсли; 
					
					Квитанция.Вывести(СтрокаПРиборы);
					
				КонецЦикла;
			КонецЕсли;
			
			Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
				
				ОбластьСтрока.Параметры.Установить(Значение, "");
				
			КонецЦикла;
			
		КонецЦикла;
		
	КонецЕсли;
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		
		// Вывод информации о кассовом сборе.
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "ПроцентОтОплаты", мСтруктураДанных.ПроцентОтОплаты);
		ЗаполнитьПараметр(ОбластьКассовыйСбор, "Процент"        , Процент);
		
		Квитанция.Вывести(ОбластьКассовыйСбор);
		
	КонецЕсли;
	
	ОбластьВсего.Параметры.Заполнить(мСтруктураДанных);
	
	Квитанция.Вывести(ОбластьВсего);
	
	КолПустСтрок = 12;
	
	Если КолПустСтрок > мТаблицаПечати.Количество() Тогда
		
		КолПустСтрок = КолПустСтрок - мТаблицаПечати.Количество();
		Пока КолПустСтрок <> 0 Цикл
			
			Квитанция.Вывести(ПустаяСтрока);
			КолПустСтрок = КолПустСтрок - 1;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ОбластьПодвал.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(ОбластьПодвал);
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли;
	
	Квитанция.Вывести(ОбластьПодвал2);	
	
	
	Если ИспользоватьQR = Истина Тогда
		
		//Попытка	
		//	ОбластьШтрихкодQR                   = мМакет.ПолучитьОбласть("ШтрихкодQR");
		//Исключение
		//КонецПопытки;
		
		НапечататьQRКод(Квитанция);
	Иначе
	    УбратьQRКод(Квитанция)
	КонецЕсли;

	Возврат Квитанция;
	
КонецФункции

// Печать макет Квитанции #2.
//
Функция ПечатьКвитанция2()
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьШапка       = мМакет.ПолучитьОбласть("Шапка");
	ОбластьШапка2      = мМакет.ПолучитьОбласть("Шапка2");
	ОбластьСтрока      = мМакет.ПолучитьОбласть("Строка|Часть1");
	ДопСтрока          = мМакет.ПолучитьОбласть("Строка|Часть2");
	ОбластьВсего       = мМакет.ПолучитьОбласть("Всего");
	ОбластьПодвал      = мМакет.ПолучитьОбласть("Подвал");
	ПустаяСтрока       = мМакет.ПолучитьОбласть("ПустаяСтрока");
	ОбластьСтрокаОбращение = мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния           = мМакет.ПолучитьОбласть("Линия");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	// Блок отрывной печати начало:.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШапка.Рисунки.Шк;
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0 ,0, СуммаШтрихКода),
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			
		Иначе
			ОбластьШапка.Рисунки.очистить();
		КонецЕсли;
		
		ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
		
		ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизации", мСтруктураДанных.ПолучательАдрес);
		ЗаполнитьПараметр(ОбластьШапка, "ИННОрганизации", мСтруктураДанных.ПолучательИНН);
		ЗаполнитьПараметр(ОбластьШапка, "Месяц", мСтруктураДанных.ПериодМесяц);
		ЗаполнитьПараметр(ОбластьШапка, "Год", мСтруктураДанных.ПериодГод);
		ЗаполнитьПараметр(ОбластьШапка, "ДатаПоследнейОплаты", ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПоследнейОплаты),Формат(мСтруктураДанных.ДатаПоследнейОплаты,"ДФ=dd.MM.yyyy"),""));
		
		Квитанция.Вывести(ОбластьШапка);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка2.Параметры.Заполнить(мСтруктураДанных);
	ЗаполнитьПараметр(ОбластьШапка2, "Месяц", мСтруктураДанных.ПериодМесяц);
	ЗаполнитьПараметр(ОбластьШапка2, "Год"	, мСтруктураДанных.ПериодГод);
	Квитанция.Вывести(ОбластьШапка2);
	
	ИндексСтроки   = 0;
	КолПустыхСтрок = 12;
	Вывести        = Истина;
	
	Для каждого Строка Из мТаблицаПечати Цикл
		
		ИндексСтроки = ИндексСтроки + 1;
		
		Если ИндексСтроки <> 23 Тогда
			
			Если Вывести Тогда
				
				ОбластьСтрока.Параметры.Заполнить(Строка);
				Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг") Тогда
					ЗаполнитьПараметр(ОбластьСтрока, "Количество", Null);
				КонецЕсли;
				Квитанция.Вывести(ОбластьСтрока);
				
			Иначе 
				
				ДопСтрока.Параметры.Заполнить(Строка);
				Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг") Тогда
					ЗаполнитьПараметр(ДопСтрока, "Количество", Null);
				КонецЕсли;
				Квитанция.Присоединить(ДопСтрока);
				
			КонецЕсли;
			
			Вывести = ?(Вывести, ложь,Истина);
			
		КонецЕсли;
		
	КонецЦикла;   
	
	Если Вывести Тогда
		
		ИндексСтроки = ИндексСтроки + 2;
		
		Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
			
			ОбластьСтрока.Параметры.Установить(Значение, "");
			
		КонецЦикла;
		Квитанция.Вывести(ОбластьСтрока);
		
		Для Значение=0 по ДопСтрока.Параметры.Количество() - 1 Цикл
			ДопСтрока.Параметры.Установить(Значение, "");
		КонецЦикла;  
		
		ЗаполнитьПараметр(ДопСтрока, "УслугаПредставление", "ИТОГО");
		ЗаполнитьПараметр(ДопСтрока, "Начислено", мТаблицаПечати.итог("Начислено"));
		ЗаполнитьПараметр(ДопСтрока, "КОплатеЗаМесяц", мТаблицаПечати.итог("КОплатеЗаМесяц"));
		
		Квитанция.Присоединить(ДопСтрока);
		
	Иначе
		
		ИндексСтроки = ИндексСтроки + 1;
		Для Значение=0 по ДопСтрока.Параметры.Количество() - 1 Цикл
			ДопСтрока.Параметры.Установить(Значение, "");
		КонецЦикла;
		
		ЗаполнитьПараметр(ДопСтрока, "УслугаПредставление", "ИТОГО");
		ЗаполнитьПараметр(ДопСтрока, "Начислено", мТаблицаПечати.итог("Начислено"));
		ЗаполнитьПараметр(ДопСтрока, "КОплатеЗаМесяц", мТаблицаПечати.итог("КОплатеЗаМесяц"));
		
		Квитанция.Присоединить(ДопСтрока);
		
	КонецЕсли; 
	
	КолПустыхСтрок = КолПустыхСтрок - (ИндексСтроки/2);
	
	Пока КолПустыхСтрок > 0 Цикл
		КолПустыхСтрок = КолПустыхСтрок - 1;
		Квитанция.Присоединить(ПустаяСтрока);
	КонецЦикла;
	
	НомерСчетчика  = 0;
	КолвоСчетчиков = 6;
	
	Для каждого СтрокаСЧ Из мТаблицаПечатиСчетчиков Цикл
		
		Если КолвоСчетчиков = НомерСчетчика Тогда
			Прервать;
		КонецЕсли; 
		
		НомерСчетчика    =  НомерСчетчика + 1;
		
		НазваниеСчетчика = "НазваниеСчетчика" + НомерСчетчика;
		ЕдИзмСч          = "ЕдИзмСч"          + НомерСчетчика;
		ДоПоказаний      = "ДоПоказаний"      + НомерСчетчика;
		
		Если СтрокаСЧ.Многотарифный Тогда
			Если НомерСчетчика > 4 Тогда
				ЗаполнитьПараметр(ОбластьВсего, НазваниеСчетчика, Лев(Строка(СтрокаСЧ.Счетчик) +" "+ Строка(СтрокаСЧ.СокрНаименование), 15));
			Иначе
				ЗаполнитьПараметр(ОбластьВсего, НазваниеСчетчика, Лев(Строка(СтрокаСЧ.Счетчик) +" "+ Строка(СтрокаСЧ.СокрНаименование), 22));
			КонецЕсли; 
		Иначе
			ЗаполнитьПараметр(ОбластьВсего, НазваниеСчетчика, СтрокаСЧ.Счетчик);
		КонецЕсли; 
		
		СтрокаУслуга = мТаблицаПечати.Найти(СтрокаСЧ.Услуга, "Услуга");
		Если НЕ СтрокаУслуга = Неопределено Тогда
			ЗаполнитьПараметр(ОбластьВсего, ЕдИзмСч, СтрокаУслуга.ЕдИзм);
		КонецЕсли; 
		
		ЗаполнитьПараметр(ОбластьВсего, ДоПоказаний, СтрокаСЧ.ДоПоказаний);
		
	КонецЦикла; 
	
	ЗаполнитьПараметр(ОбластьВсего, "ИтогоКОплатеСУчетомПени", "ИТОГО: " + мСтруктураДанных.ИтогоКОплатеСУчетомПени +" "+
	?(мСтруктураДанных.ИтогПени<> 0,"в т. ч. Пени: " + мСтруктураДанных.ИтогПени,""));

	Квитанция.Вывести(ОбластьВсего);
	
	ЗаполнитьПараметр(ОбластьПодвал, "СтрЗадолженность", "Задолженность на " + мСтруктураДанных.Период + " : " + мСтруктураДанных.Долг);
	ЗаполнитьПараметр(ОбластьПодвал, "СтрОплата", "Оплачено после "+ мСтруктураДанных.Период + " : " + мСтруктураДанных.Оплата);
	
	Текст = "Вид собственности: " + мСтруктураДанных.СтатусКвартиры+ " К-во комнат: " + мСтруктураДанных.КоличествоКомнат
	+ " Площадь общ.: " + мСтруктураДанных.ОписаниеОбщейПлощади + " жилая: " 
	+ мСтруктураДанных.ОписаниеЖилойПлощади + " К-во проживающих:" + мСтруктураДанных.КоличествоПроживающих + "; льготников: " 
	+ мСтруктураДанных.КолЛьготников + " "+ ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПоследнейОплаты), "Дата последней оплаты: "+мСтруктураДанных.ДатаПоследнейОплаты, "") 
	+"  Дата создания: "+ Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	
	ЗаполнитьПараметр(ОбластьПодвал, "СтрИнфо", Текст);
	
	Квитанция.Вывести(ОбластьПодвал);
	
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

// Печать макет Квитанция №3 и Квитанция №3 с учетов пени.
//
Функция ПечатьКвитанция3(УчетПени = Ложь)
	
	Квитанция = Новый ТабличныйДокумент;
	
	ОбластьШапка       = мМакет.ПолучитьОбласть("Шапка");
	ОбластьШапка2      = мМакет.ПолучитьОбласть("Шапка2");
	ОбластьСтрока      = мМакет.ПолучитьОбласть("Строка|Часть1");
	ДопСтрока          = мМакет.ПолучитьОбласть("Строка|Часть2");
	ОбластьВсего       = мМакет.ПолучитьОбласть("Всего");
	ОбластьПодвал      = мМакет.ПолучитьОбласть("Подвал");
	ПустаяСтрока       = мМакет.ПолучитьОбласть("ПустаяСтрока");
	ОбластьСтрокаОбращение	= мМакет.ПолучитьОбласть("СтрокаОбращение");
	ОбластьЛиния 			= мМакет.ПолучитьОбласть("Линия");
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Рисунок = ОбластьШапка.Рисунки.Шк;
			
			СуммаШК = ?(СуммаШтрихКода < 0, 0, СуммаШтрихКода);
			
			ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(СуммаШК,
			мСтруктураДанных.ЛицевойСчетНомер,
			ШаблонИзвещений.Идентификатор,
			мСтруктураДанных.ЛицевойСчет.Идентификатор,
			мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
			мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
			
			ПараметрыШтрихкода = Новый Структура;
			ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
			ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
			ПараметрыШтрихкода.Вставить("ТипКода",         4);
			ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
			ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
			
			Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
		Иначе
			ОбластьШапка.Рисунки.очистить();
		КонецЕсли;
		
		ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
		
		ЗаполнитьПараметр(ОбластьШапка, "АдресОрганизации", мСтруктураДанных.ПолучательАдрес);
		ЗаполнитьПараметр(ОбластьШапка, "ИННОрганизации", мСтруктураДанных.ПолучательИНН);
		ЗаполнитьПараметр(ОбластьШапка, "Месяц", мСтруктураДанных.ПериодМесяц);
		ЗаполнитьПараметр(ОбластьШапка, "Год", мСтруктураДанных.ПериодГод);
		ЗаполнитьПараметр(ОбластьШапка, "ДатаПоследнейОплаты", ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПоследнейОплаты),Формат(мСтруктураДанных.ДатаПоследнейОплаты,"ДФ=dd.MM.yyyy"),""));
		ЗаполнитьПараметр(ОбластьШапка, "ДатаПечатиКвитанций", ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПечатиКвитанций),Формат(мСтруктураДанных.ДатаПечатиКвитанций,"ДФ=dd.MM.yyyy"),""));
		
		Квитанция.Вывести(ОбластьШапка);
	КонецЕсли;
	// Блок отрывной печати конец.
	
	ОбластьШапка2.Параметры.Заполнить(мСтруктураДанных);
	ЗаполнитьПараметр(ОбластьШапка2, "Месяц", мСтруктураДанных.ПериодМесяц);
	ЗаполнитьПараметр(ОбластьШапка2, "Год", мСтруктураДанных.ПериодГод);
	Квитанция.Вывести(ОбластьШапка2);
	
	ИндексСтроки = 0;
	КолПустыхСтрок = 12;
	Вывести = Истина;
	
	Для каждого Строка Из мТаблицаПечати Цикл
		
		ИндексСтроки = ИндексСтроки + 1;
		
		Если ИндексСтроки <> 23 Тогда
			
			Если Вывести Тогда
				
				ОбластьСтрока.Параметры.Заполнить(Строка);
				Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг")ИЛИ Строка.Количество = 0  Тогда
					ЗаполнитьПараметр(ОбластьСтрока, "Количество", Null);
				КонецЕсли;
				
				// БИТ ЖКХ 20.10.2020
				Если НеПечататьУслугиБезНачислений
					И Строка.Начислено = 0 Тогда
					Продолжить;
				КонецЕсли;
				
				Квитанция.Вывести(ОбластьСтрока);
				
			Иначе 
				
				ДопСтрока.Параметры.Заполнить(Строка);
				Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг")ИЛИ Строка.Количество = 0 Тогда
					ЗаполнитьПараметр(ДопСтрока, "Количество", Null);
				КонецЕсли;
				Квитанция.Присоединить(ДопСтрока);
				
			КонецЕсли;
			
			Вывести = ?(Вывести, ложь,Истина);
			
		КонецЕсли;
		
	КонецЦикла;   
	
	Если Вывести Тогда
		
		ИндексСтроки = ИндексСтроки + 2;
		
		Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
			
			ОбластьСтрока.Параметры.Установить(Значение, "");
			
		КонецЦикла;
		Квитанция.Вывести(ОбластьСтрока);
		
		Для Значение=0 по ДопСтрока.Параметры.Количество() - 1 Цикл
			ДопСтрока.Параметры.Установить(Значение, "");
		КонецЦикла;  
		
		ЗаполнитьПараметр(ДопСтрока, "УслугаПредставление", "ИТОГО");
		ЗаполнитьПараметр(ДопСтрока, "Начислено", мСтруктураДанных.Начислено);
		ЗаполнитьПараметр(ДопСтрока, "КОплатеЗаМесяц", мСтруктураДанных.КОплатеЗаМесяц);
		ЗаполнитьПараметр(ДопСтрока, "Разовые", мСтруктураДанных.Разовые);
		ЗаполнитьПараметр(ДопСтрока, "Льгота", мСтруктураДанных.Льгота);
		
		Квитанция.Присоединить(ДопСтрока);
		
	Иначе
		
		ИндексСтроки = ИндексСтроки + 1;
		
		Для Значение=0 по ДопСтрока.Параметры.Количество() - 1 Цикл
			ДопСтрока.Параметры.Установить(Значение, "");
		КонецЦикла;  
		
		ЗаполнитьПараметр(ДопСтрока, "УслугаПредставление", "ИТОГО");
		ЗаполнитьПараметр(ДопСтрока, "Начислено", мСтруктураДанных.Начислено);
		ЗаполнитьПараметр(ДопСтрока, "КОплатеЗаМесяц", мСтруктураДанных.КОплатеЗаМесяц);
		ЗаполнитьПараметр(ДопСтрока, "Разовые", мСтруктураДанных.Разовые);
		ЗаполнитьПараметр(ДопСтрока, "Льгота", мСтруктураДанных.Льгота);
		
		Квитанция.Присоединить(ДопСтрока);
		
	КонецЕсли; 
	
	КолПустыхСтрок = КолПустыхСтрок - (ИндексСтроки/2);
	
	Пока КолПустыхСтрок > 0 Цикл
		КолПустыхСтрок = КолПустыхСтрок - 1;
		Квитанция.Присоединить(ПустаяСтрока);
	КонецЦикла;
	
	НомерСчетчика  = 0;
	КолвоСчетчиков = 6;
	
	Для каждого СтрокаСЧ Из мТаблицаПечатиСчетчиков Цикл
		
		Если КолвоСчетчиков = НомерСчетчика Тогда
			Прервать;
		КонецЕсли; 
		
		НомерСчетчика =  НомерСчетчика + 1;
		
		НазваниеСчетчика = "НазваниеСчетчика" +НомерСчетчика;
		ЕдИзмСч = "ЕдИзмСч" + НомерСчетчика;
		
		ДоПоказаний  = "ДоПоказаний" + НомерСчетчика;
		
		Если СтрокаСЧ.Многотарифный Тогда
			Если НомерСчетчика > 4 Тогда
				ЗаполнитьПараметр(ОбластьВсего, НазваниеСчетчика, Лев(Строка(СтрокаСЧ.Счетчик) +" "+ Строка(СтрокаСЧ.СокрНаименование), 15));
			Иначе
				ЗаполнитьПараметр(ОбластьВсего, НазваниеСчетчика, Лев(Строка(СтрокаСЧ.Счетчик) +" "+ Строка(СтрокаСЧ.СокрНаименование), 22));
			КонецЕсли; 
		Иначе
			ЗаполнитьПараметр(ОбластьВсего, НазваниеСчетчика, СтрокаСЧ.Счетчик);
		КонецЕсли; 
		
		СтрокаУслуга = мТаблицаПечати.Найти(СтрокаСЧ.Услуга, "Услуга");
		Если НЕ СтрокаУслуга = Неопределено Тогда
			ЗаполнитьПараметр(ОбластьВсего, ЕдИзмСч, СтрокаУслуга.ЕдИзм);
		КонецЕсли; 
		
		ЗаполнитьПараметр(ОбластьВсего, ДоПоказаний, СтрокаСЧ.ДоПоказаний);
		
	КонецЦикла; 
	
	Если УчетПени Тогда
		ЗаполнитьПараметр(ОбластьВсего, "КОплате", Строка(мСтруктураДанных.ИтогоКОплатеСУчетомПени)+ ", в т.ч. пени " + Строка(мСтруктураДанных.ИтогПени));
	Иначе
		ЗаполнитьПараметр(ОбластьВсего, "КОплате", мСтруктураДанных.КОплате);
	КонецЕсли; 
	
	Квитанция.Вывести(ОбластьВсего);
	
	Если УчетПени Тогда
		ЗаполнитьПараметр(ОбластьПодвал, "СтрЗадолженность", "Задолженность на "+ ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаНачалоМесяца),Формат(мСтруктураДанных.ДатаНачалоМесяца,"ДФ=dd.MM.yyyy"),"") 
			+ " : " + мСтруктураДанных.Сальдо + ", пени: " + мСтруктураДанных.ИтогПени);
		
		ЗаполнитьПараметр(ОбластьПодвал, "СтрОплата", "Оплачено за период: с "+ ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаНачалоМесяца),Формат(мСтруктураДанных.ДатаНачалоМесяца,"ДФ=dd.MM.yyyy"),"") 
			+ " по " + ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаОкончанияМесяца),Формат(мСтруктураДанных.ДатаОкончанияМесяца,"ДФ=dd.MM.yyyy"),"") + " : " + мСтруктураДанных.Оплата + ", в т.ч. пени: " + мСтруктураДанных.ОплатаПени);
		
	Иначе	
		ЗаполнитьПараметр(ОбластьПодвал, "СтрЗадолженность", "Задолженность на "+ ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаНачалоМесяца),Формат(мСтруктураДанных.ДатаНачалоМесяца,"ДФ=dd.MM.yyyy"),"") 
			+ " : " + мСтруктураДанных.Сальдо);
		
		ЗаполнитьПараметр(ОбластьПодвал, "СтрОплата", "Оплачено за период: с "+ ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаНачалоМесяца),Формат(мСтруктураДанных.ДатаНачалоМесяца,"ДФ=dd.MM.yyyy"),"") 
			+ " по " + ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаОкончанияМесяца),Формат(мСтруктураДанных.ДатаОкончанияМесяца,"ДФ=dd.MM.yyyy"),"") + " : " + мСтруктураДанных.Оплата);
		
	КонецЕсли;
	
	Текст = "Вид собственности: " + мСтруктураДанных.СтатусКвартиры+ " К-во комнат: " + мСтруктураДанных.КоличествоКомнат
	+ " Площадь общ.: " + мСтруктураДанных.ОписаниеОбщейПлощади + " жилая: " 
	+ мСтруктураДанных.ОписаниеЖилойПлощади + " К-во проживающих:" + мСтруктураДанных.КоличествоПроживающих + "; льготников: " 
	+ мСтруктураДанных.КолЛьготников + " "+ ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПоследнейОплаты), "Дата последней оплаты: "+мСтруктураДанных.ДатаПоследнейОплаты, "") 
	+"  Дата создания: "+ Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	
	ЗаполнитьПараметр(ОбластьПодвал, "СтрИнфо", Текст);
	ЗаполнитьПараметр(ОбластьПодвал, "ДатаПечатиКвитанций", ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПечатиКвитанций),Формат(мСтруктураДанных.ДатаПечатиКвитанций,"ДФ=dd.MM.yyyy"),""));
	
	Квитанция.Вывести(ОбластьПодвал);
	
	
	Если НЕ ПустаяСтрока(Обращение) Тогда
		
		ОбращениеКГражданам = мМакет.ПолучитьОбласть("Обращение");
		ЗаполнитьПараметр(ОбращениеКГражданам, "Обращение", "" + Обращение);
		Квитанция.Вывести(ОбращениеКГражданам);
		
	КонецЕсли;
	
	// Вывод замечаний по лицевому счету.
	Если мКэшПараметрыЖКХ.ВыводитьЗамечанияЖКХ Тогда
		ВывестиЗамечания(Квитанция, мСтруктураДанных.ЛицевойСчет);
	КонецЕсли;
	
	Если УчетПени Тогда
		
		Секция = мМакет.ПолучитьОбласть("ОбластьПени");
		ЗаполнитьПараметр(Секция, "КОплате", мСтруктураДанных.ИтогоКОплатеСУчетомПени);
		
		Квитанция.ВставитьОбласть(Секция.Область(), Квитанция.Область("R14C2:R14C8"),,Истина);
		
	КонецЕсли;
	
	Возврат Квитанция;
	
КонецФункции

// Печать макет Квитанция №4.
//
Функция ПечатьКвитанция4() Экспорт
	
	Квитанция = Новый ТабличныйДокумент;
	
	Шапка                    = мМакет.ПолучитьОбласть("Шапка");
	ЛеваяЧасть               = мМакет.ПолучитьОбласть("ЛеваяЧасть");
	ЛеваяЧастьПустаяСтрока   = мМакет.ПолучитьОбласть("ЛеваяЧастьПустаяСтрока");
	
	ЛеваяЧастьПодвал         = мМакет.ПолучитьОбласть("ЛеваяЧастьПодвал");
	
	ОбластьШК                = мМакет.ПолучитьОбласть("ОбластьШК");
	
	ТаблицаСЧПустаяСтрока    = мМакет.ПолучитьОбласть("ТаблицаСЧПустаяСтрока");
	ТаблицаСЧСтрока          = мМакет.ПолучитьОбласть("ТаблицаСЧСтрока");
	ТаблицаСЧШапка           = мМакет.ПолучитьОбласть("ТаблицаСЧШапка");
	
	Середина                 = мМакет.ПолучитьОбласть("Середина");
	Середина2                = мМакет.ПолучитьОбласть("Середина2");
	
	ИнфШапка                 = мМакет.ПолучитьОбласть("ИнфШапка");
	
	ИнфОПлатежеПустаяСтрока  = мМакет.ПолучитьОбласть("ИнфОПлатежеПустаяСтрока");
	ИнфОПлатежеПодвал        = мМакет.ПолучитьОбласть("ИнфОПлатежеПодвал");
	
	ТаблицаУслугШапка        = мМакет.ПолучитьОбласть("ТаблицаУслугШапка");
	ТаблицаУслугСтрока       = мМакет.ПолучитьОбласть("ТаблицаУслугСтрока");
	Попытка
		ТаблицаГрУслугСтрока	= мМакет.ПолучитьОбласть("ТаблицаГрУслугСтрока");
	Исключение
		ТаблицаГрУслугСтрока	= Неопределено;
	КонецПопытки;
	
	ТаблицаУслугИтого        = мМакет.ПолучитьОбласть("ТаблицаУслугИтого");
	ТаблицаУслугПустаяСтрока = мМакет.ПолучитьОбласть("ТаблицаУслугПустаяСтрока");
	ТаблицаУслугПодвал       = мМакет.ПолучитьОбласть("ТаблицаУслугПодвал");
	
	Разделитель              = мМакет.ПолучитьОбласть("Разделитель");
	
	ОбращениеКГражданам      = мМакет.ПолучитьОбласть("Обращение");
	
	ОбластьКассовыйСбор      = мМакет.ПолучитьОбласть("КассовыйСбор");
	
	Если НЕ мСтруктураДанных.ПроцентОтОплаты = 0 Тогда
		мСтруктураДанных.КОплате = мСтруктураДанных.КОплате + мСтруктураДанных.ПроцентОтОплаты;
	КонецЕсли;
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   = мСтруктураДанных.КОплате;
	
	мСтруктураДанных.ИтогоКОплатеСУчетомПени         = мСтруктураДанных.ИтогоКОплатеСУчетомПредоплаты   + мСтруктураДанных.ИтогПени;
	
	Попытка
		СуммаШтрихКода = мСтруктураДанных[мНастройкиМакета.ПолеСуммыШК];
	Исключение
		СуммаШтрихКода = 0;
	КонецПопытки;
	
	СтруктураСтрокаИнф = Новый Структура;
	
	Для Значение = 1 По 13 Цикл
		
		ИмяОбласти = "ИнфСтр" + Значение;
		СтруктураСтрокаИнф.Вставить(ИмяОбласти, мМакет.ПолучитьОбласть(ИмяОбласти));
		
	КонецЦикла; 
	
	ТаблицаСЧ          = Новый ТабличныйДокумент;
	ТаблицаНаПечать    = Новый ТабличныйДокумент;
	
	тмпТаблица = мТаблицаПечати.Скопировать();
	
	// Блок отрывной печати начало.
	Если НЕ мНастройкиМакета.БезОтрывнойЧасти Тогда
		
		// Разбить адрес.
		ЛицевойСчетАдрес_1 = "";
		ЛицевойСчетАдрес_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ЛицевойСчетАдрес, 30, ЛицевойСчетАдрес_1 , ЛицевойСчетАдрес_2 );
		
		мСтруктураДанных.Вставить("ЛицевойСчетАдрес_1", ЛицевойСчетАдрес_1);
		мСтруктураДанных.Вставить("ЛицевойСчетАдрес_2", ЛицевойСчетАдрес_2);
		
		// Разбить описание льготы.
		ОписаниеЛьгот_1 = "";
		ОписаниеЛьгот_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(мСтруктураДанных.ОписаниеЛьгот, 30, ОписаниеЛьгот_1 , ОписаниеЛьгот_2 );
		
		мСтруктураДанных.Вставить("ОписаниеЛьгот_1", ОписаниеЛьгот_1);
		мСтруктураДанных.Вставить("ОписаниеЛьгот_2", ОписаниеЛьгот_2);
		
		Если НЕ мВнешняяКомпонента = Неопределено И мНастройкиМакета.ФормироватьШтрихКод Тогда
			
			Эталон = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("Эталон");
			КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;
			
			Попытка
				Рисунок = ОбластьШК.Рисунки.Шк;
				
				ЗначениеШтрихкода = бит_ОбщегоНазначения.СформируемШтрихКод(?(СуммаШтрихКода < 0, 0, СуммаШтрихКода),
				мСтруктураДанных.ЛицевойСчетНомер,
				ШаблонИзвещений.Идентификатор,
				мСтруктураДанных.ЛицевойСчет.Идентификатор,
				мКэшПараметрыЖКХ.НомерПолучателяПоБанку,
				мКэшПараметрыЖКХ.ИспользоватьНомерПолучателяВШК);
				
				ПараметрыШтрихкода = Новый Структура;
				ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе));
				ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
				ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
				ПараметрыШтрихкода.Вставить("ТипКода",         4);
				ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
				ПараметрыШтрихкода.Вставить("РазмерШрифта",    8);
				
				Рисунок.Картинка = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода);
			Исключение
			КонецПопытки
		Иначе
			ОбластьШК.Рисунки.очистить();
		КонецЕсли;
		
		Шапка.Параметры.Заполнить(мСтруктураДанных);
		
		ТаблицаНаПечать.Вывести(Шапка);
		
		ТаблицаНаПечать.Вывести(ОбластьШК);
		
		ТаблицаСЧ.Вывести(ТаблицаСЧШапка);
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ТаблицаСчетчиков", мТаблицаПечатиСчетчиков);
		Запрос.УстановитьПараметр("ЛицевойСчет"     , мСтруктураДанных.ЛицевойСчет);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблицаСчетчиков.Счетчик,
		|	ТаблицаСчетчиков.Услуга,
		|	ТаблицаСчетчиков.ОтПоказаний,
		|	ТаблицаСчетчиков.ДоПоказаний,
		|	ТаблицаСчетчиков.Многотарифный,
		|	ТаблицаСчетчиков.ДатаПоверки,
		|	ТаблицаСчетчиков.Приоритет,
		|	ТаблицаСчетчиков.СокрНаименование
		|ПОМЕСТИТЬ Счетчики
		|ИЗ
		|	&ТаблицаСчетчиков КАК ТаблицаСчетчиков
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Счетчики.Счетчик,
		|	МАКСИМУМ(Счетчики.ОтПоказаний) КАК ОтПоказаний,
		|	МАКСИМУМ(Счетчики.ДоПоказаний) КАК ДоПоказаний,
		|	Счетчики.Многотарифный,
		|	МАКСИМУМ(Счетчики.ДатаПоверки),
		|	СУММА(0) КАК Приоритет,
		|	СУММА(0) КАК Услуга,
		|	СУММА(0) КАК СокрНаименование
		|ИЗ
		|	Счетчики КАК Счетчики
		|ГДЕ
		|	НЕ Счетчики.Многотарифный
		|
		|СГРУППИРОВАТЬ ПО
		|	Счетчики.Счетчик,
		|	Счетчики.Многотарифный
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	Счетчики.Счетчик,
		|	Счетчики.ОтПоказаний,
		|	Счетчики.ДоПоказаний,
		|	Счетчики.Многотарифный,
		|	Счетчики.ДатаПоверки,
		|	Счетчики.Приоритет,
		|	Счетчики.Услуга,
		|	Счетчики.СокрНаименование
		|ИЗ
		|	Счетчики КАК Счетчики
		|ГДЕ
		|	Счетчики.Многотарифный
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		СчетчикСЧ = 1;
		Пока Выборка.Следующий() Цикл
			
			Если СчетчикСЧ > 8 Тогда
				Прервать;
			КонецЕсли;
			
			ТаблицаСЧСтрока.Параметры.Заполнить(Выборка);
