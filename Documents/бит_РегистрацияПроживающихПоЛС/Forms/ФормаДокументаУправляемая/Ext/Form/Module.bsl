// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	КэшированныеЗначения.Вставить("Дата"                , Объект.Дата);
	
	// БИТ ЖКХ 08.04.2020
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(ТекущаяДата()));
//	Запрос.УстановитьПараметр("Организация", Объект.ЛицевойСчет.Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НастройкаПараметровЖКХСрезПоследних.НачислениеСоДняПраваСобственности КАК НачислениеСоДняПраваСобственности
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата,) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		НачислениеСоДняПраваСобственности = Выборка.НачислениеСоДняПраваСобственности;
	Иначе	
		НачислениеСоДняПраваСобственности = Ложь;
	КонецЕсли;

	КэшированныеЗначения.Вставить("НачислениеСоДняПраваСобственности", НачислениеСоДняПраваСобственности);
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

// Процедура <формирование запроса содержащего список проживающих по текущему лицевому счету и их долей площади.
&НаСервере
Процедура бит_СформироватьСписокДолей(Знач Дата, Знач ЛицевойСчет)
	Запрос =  Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ПроживающиеПоЛССрезПоследних.ДоляПлощади
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныеЛицаПоКУСрезПоследних
	|		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет = ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет
	|			И ПроживающиеПоЛССрезПоследних.ФизЛицо = ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо
	|ГДЕ
	|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	Запрос.УстановитьПараметр("Момент",КонецМесяца(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	
	РезультатЗапроса   = Запрос.Выполнить(); 
	ТаблицаДолейФизЛиц = РезультатЗапроса.Выгрузить();
	
	ЗагрузитьТаблицуДолейНаСервере(ТаблицаДолейФизЛиц);
	
КонецПроцедуры //битСформироватьСписокДолей()

&НаСервере
Процедура УстановитьДоступностьФормыДляРедактированияНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	бит_РаботаСДиалогамиСервер.УстановитьДоступностьФормыДляРедактирования(ДокументОбъект, ЭтаФорма);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЗначенийНаСервере(Знач Дата, Знач ЛицевойСчет);
	
	// Замена указаний типовых объектов на объекты БИТ в тексте модуля.
	РезультатЗапроса = ПолучитьСписокПроживающих(Дата, ЛицевойСчет);
	ТаблицаФизЛиц    = РезультатЗапроса.Выгрузить();
	
	ЗагрузитьТаблицуНаСервере(ТаблицаФизЛиц);
	
	Выборка = РезультатЗапроса.Выбрать();
	
	мСписокЗначений = Новый СписокЗначений;
	
	Пока Выборка.Следующий() Цикл 
		
		мСписокЗначений.Добавить(Выборка.ФизЛицо)
		
	КонецЦикла;
	
	Возврат мСписокЗначений;
	
КонецФункции

// <Описание функции>
//  Получен результат запроса - список проживающих по лицевому счету на дату документа.
// Параметры:
//  <Дата>  - <Дата> - <текущая дата документа>
//  <ЛицевойСчет>  - <СправочникСсылка.бит_ЛицевыеСчета> - <текущий лицевой счет>.
//
// Возвращаемое значение:
//   <РезультатЗапроса.РезультатЗапроса>   - результат запроса для дальнейшего использования.
//
&НаСервере
Функция ПолучитьСписокПроживающих(Знач Дата, Знач ЛицевойСчет)
	
	Запрос =  Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтепеньРодства,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаЗаписи,
	|	ОтветственныеЛицаПоКУСрезПоследних.Контрагент,
	|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
	|	ПроживающиеПоЛССрезПоследних.ДоляПлощади,
	|	ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы,
	// БИТ_ЖКХ 14.01.2015{{
	|	ПроживающиеПоЛССрезПоследних.КудаВыписан,
	|	ПроживающиеПоЛССрезПоследних.ОткудаПрибыл
	// БИТ_ЖКХ 14.01.2015}}
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныеЛицаПоКУСрезПоследних
	|		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет = ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет
	|			И ПроживающиеПоЛССрезПоследних.ФизЛицо = ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо
	|ГДЕ
	|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Момент"     , Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	РезультатЗапроса = Запрос.Выполнить(); 
	
	Возврат РезультатЗапроса;	
	
КонецФункции // ()

&НаСервереБезКонтекста
Функция ПолучитьСтруктуруРегистрации(Знач Дата, Знач ЛицевойСчет, Знач ФизЛицо, Знач ДатаРегистрации, Знач ДатаСнятияСРегистрации)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&КонецПериода,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И ФизЛицо = &ФизЛицо) КАК бит_ПроживающиеПоЛССрезПоследних";
	
	Запрос.УстановитьПараметр("КонецПериода", Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет" , ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо"     , ФизЛицо);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Ответ = Ложь;
	
	Если Выборка.Следующий() Тогда
		
		Если ДатаРегистрации < Выборка.ДатаСнятияСРегистрации ИЛИ ДатаРегистрации > Выборка.ДатаРегистрации Тогда
			
			Ответ = Истина;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат Ответ;
	
КонецФункции

&НаСервере
Процедура ДобавитьСтрокуВСписокПроживающихНаСервере(ВыбранноеЗначение)
	
	Если Не мТаблицаФизЛиц.Количество() = 0 Тогда
		
		Отбор = Новый Структура("ФизЛицо", ВыбранноеЗначение);
		
		ТаблицаФизЛиц = РеквизитФормыВЗначение("мТаблицаФизЛиц");
		
		НайденнаяСтрока = ТаблицаФизЛиц.НайтиСтроки(Отбор);	 
		
		Если НайденнаяСтрока.Количество() = 0 тогда
			
			НоваяСтрока = Объект.СписокПроживающих.Добавить();
			
			НоваяСтрока.ФизЛицо = ВыбранноеЗначение;
			
			// БИТ_ЖКХ 02.09.2014	
			НоваяСтрока.СтатусФизЛица    = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.ПостояннаяРегистрация");
			НоваяСтрока.СтепеньРодства   = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_НеУказано");
			НоваяСтрока.СтатусПроживания = ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Постоянно");
			// БИТ_ЖКХ 02.09.2014	
			
		Иначе
			
			НоваяСтрока = Объект.СписокПроживающих.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденнаяСтрока[0]);
			
			// БИТ_ЖКХ 14.01.2015{{
			НоваяСтрока.КудаВыписанАдрес = НайденнаяСтрока[0].КудаВыписан;                   	
			НоваяСтрока.ОткудаПрибылАдрес = НайденнаяСтрока[0].ОткудаПрибыл;
			// БИТ_ЖКХ 14.01.2015}}
			
		КонецЕсли;
		
	Иначе
		
		НоваяСтрока = Объект.СписокПроживающих.Добавить();
		
		НоваяСтрока.ФизЛицо          = ВыбранноеЗначение;
		НоваяСтрока.СтатусФизЛица    = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.ПостояннаяРегистрация");
		НоваяСтрока.СтепеньРодства   = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_НеУказано");
		НоваяСтрока.СтатусПроживания = ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Постоянно");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьТаблицуНаСервере(ТаблицаФизЛиц)
	
	СтараяТаблица = РеквизитФормыВЗначение("мТаблицаФизЛиц");
	
	МассивРеквизитов = Новый Массив;
	
	Для Каждого Колонка Из ТаблицаФизЛиц.Колонки Цикл
		
		Если СтараяТаблица.Колонки.Найти(Колонка.Имя) = Неопределено Тогда
			
