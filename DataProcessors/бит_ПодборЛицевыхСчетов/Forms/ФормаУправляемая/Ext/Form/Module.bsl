#Область ПроцедурыИФункцииУправленияВнешнимВидомФорм

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ПанельВыбранного.Видимость = ОтобразитьВыбранное;
	
КонецПроцедуры // УправлениеЭлементамиФормы()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СписокУслуг = Параметры.СписокУслуг;
	
	Элементы.СписокУслуг.ТолькоПросмотр = СписокУслуг.Количество() > 0;
	
	Объект.Улица = Параметры.Улица;
	
	СписокУлиц = Параметры.СписокУлиц;
	
	Если НЕ Объект.Улица.Пустая() Тогда
		
		бит_ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(СписокЛицевыхСчетов,
		"Улица",
		Объект.Улица,
		Истина,
		ВидСравненияКомпоновкиДанных.Равно);
		
		Элементы.Улица.Доступность = СписокУлиц.Количество() > 0;
		
	КонецЕсли;
	
	Объект.Здание = Параметры.Здание;
	
	СписокЗданий = Параметры.СписокЗданий;
	
	Если НЕ Объект.Здание.Пустая() Тогда
		
		бит_ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(СписокЛицевыхСчетов,
		"Здание",
		Объект.Здание,
		Истина,
		ВидСравненияКомпоновкиДанных.Равно);
		
		Элементы.Здание.Доступность = СписокЗданий.Количество() > 0;
		
	КонецЕсли;
	
	Если НЕ Параметры.СписокЛС.Количество() = 0 Тогда
		
		бит_ОтборыСписковКлиентСервер.ИзменитьЭлементОтбораСписка(СписокЛицевыхСчетов,
		"ЛицевойСчет",
		Параметры.СписокЛС,
		Истина,
		?(Параметры.ВСписке, ВидСравненияКомпоновкиДанных.ВСписке, ВидСравненияКомпоновкиДанных.НеВСписке));
		
	КонецЕсли; 
	
	Дата = ТекущаяДата();
	
	Если ЗначениеЗаполнено(Параметры.Дата) Тогда
		
		Дата = Параметры.Дата;
		
	КонецЕсли; 
	
	СписокЛицевыхСчетов.Параметры.УстановитьЗначениеПараметра("Дата", КонецДня(Дата));
	
	ТекОтбор = "ПоАдресу";
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	// Установить видимость реквизитов и заголовков колонок.	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры // ПриСозданииНаСервере()

// Процедура - обработчик события "ПриОткрытии" формы.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ Параметры.ОткрытоИзДокумента Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Обработка подбора лицевых счетов предназначена для открытия только из документов.");
		
		Отказ = Истина;
		
	КонецЕсли; 
	
	ЗакрытьБезВопроса = Ложь;
	
КонецПроцедуры // ПриОткрытии()

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	// БИТ_ЖКХ 08.09.2016 18:26:49 Начало правки... 
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	// БИТ_ЖКХ 08.09.2016 18:26:51 Конец правки.

	
	Если Не ПеренестиВДокумент И Объект.ТаблицаВыбора.Количество() > 0 Тогда
		
		Если ЗакрытьБезВопроса = Ложь Тогда
			Отказ = Истина;
			
			ОтветНаВопрос = Неопределено;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), "Подобранные лицевые счета не перенесены в документ. Перенести?", РежимДиалогаВопрос.ДаНетОтмена);
			
		КонецЕсли;
		
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    ОтветНаВопрос = РезультатВопроса;
    
    Если ОтветНаВопрос = КодВозвратаДиалога.Отмена Тогда
        ЗакрытьБезВопроса = Ложь;
    ИначеЕсли ОтветНаВопрос = КодВозвратаДиалога.Нет Тогда
        ЗакрытьБезВопроса = Истина;
        Этаформа.Закрыть();
		
    ИначеЕсли ОтветНаВопрос = КодВозвратаДиалога.Да Тогда
        ПеренестиВДокумент = Истина;
        ЗакрытьБезВопроса = Истина;
        
        Этаформа.Закрыть();
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// БИТ_ЖКХ 08.09.2016 18:26:49 Начало правки... 
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	// БИТ_ЖКХ 08.09.2016 18:26:51 Конец правки.

	Если ПеренестиВДокумент Тогда
		
		АдресЛСВХранилище = ПоместитьЛСВХранилище();
		Структура = Новый Структура("АдресЛСВХранилище", АдресЛСВХранилище);
		ПеренестиВДокумент = Истина;
		ОповеститьОВыборе(Структура);
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

