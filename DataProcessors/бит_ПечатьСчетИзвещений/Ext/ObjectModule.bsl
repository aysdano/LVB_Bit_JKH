#КонецОбласти

#Область ПроцедурыИФункцииФормированияДанных

// Процедура устанавливает макет.
//
// Параметры:
//  Нет.
//
Функция УстановитьМакет() Экспорт
	
	Попытка
		
		Если МакетКв.Предопределенный Тогда
			мОсновнойВариантМакета = МакетКВ;
			мМакет = ПолучитьМакет(МакетКв.ПутьКМакету);
		Иначе
			мОсновнойВариантМакета = МакетКВ.ОсновнойВариант;
			мМакет = МакетКв.ШаблонПечатнойФормы.Получить();
		КонецЕсли; 
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось получить макет.'"));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции 

// Функция получает лицевой счет по отбору.
//
// Параметры:
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьЛСПоОтбору() Экспорт
	
	мЕстьПечатьЗависимых = Ложь;
	
	Отбор = Новый Структура("ПечатьЗависимыхЛС", Истина);
	
	МассивСтрок = СписокЛС.НайтиСтроки(Отбор);
	
	Если МассивСтрок.Количество() > 0  Тогда
		мЕстьПечатьЗависимых = Истина;
	КонецЕсли;
	
	тмпСписокЛС = СписокЛС.Выгрузить();
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Параметры.Вставить("КонецПериода", КонецМесяца(Период));
	ПостроительЗапроса.Параметры.Вставить("Организация" , Организация);
	ПостроительЗапроса.Параметры.Вставить("ТипКвартиры" , ТипКвартиры);
	
	ПостроительЗапроса.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Здание,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета КАК Улица,
	|	бит_ЛицевыеСчета.Здание.Участок КАК Участок,
	|	бит_ЛицевыеСчета.Здание.Район КАК Район,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_ЛицевыеСчета.Наименование КАК Наименование
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&КонецПериода, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_ЛицевыеСчета.Организация = &Организация
	|	И ВЫБОР
	|			КОГДА НЕ &ТипКвартиры = ЗНАЧЕНИЕ(Справочник.бит_ТипыКвартиры.ПустаяСсылка)
	|				ТОГДА бит_СведенияОКвартиреСрезПоследних.ТипКвартиры = &ТипКвартиры
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если СписокРайонов.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		Значение.ЗагрузитьЗначения(СписокРайонов.ВыгрузитьКолонку("Район"));
		
		ОтборРайоны = ПостроительЗапроса.Отбор.Добавить("Район");
		ОтборРайоны.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборРайоны.Значение      = Значение;
		ОтборРайоны.Использование = Истина;
		
	КонецЕсли; 
	
	Если СписокУчастков.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		Значение.ЗагрузитьЗначения(СписокУчастков.ВыгрузитьКолонку("Участок"));
		
		ОтборУчасток = ПостроительЗапроса.Отбор.Добавить("Участок");
		ОтборУчасток.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборУчасток.Значение      = Значение;
		ОтборУчасток.Использование = Истина;
		
	КонецЕсли;
	
	Если СписокУлиц.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		Значение.ЗагрузитьЗначения(СписокУлиц.ВыгрузитьКолонку("Улица"));
		
		ОтборУлиц = ПостроительЗапроса.Отбор.Добавить("Улица");
		ОтборУлиц.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборУлиц.Значение      = Значение;
		ОтборУлиц.Использование = Истина;
		
	КонецЕсли; 
	
	Если СписокЗданий.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		Значение.ЗагрузитьЗначения(СписокЗданий.ВыгрузитьКолонку("Здание"));
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("Здание");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = Значение;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если СписокЛС.Количество() > 0 Тогда
		
		Значение = Новый СписокЗначений;
		Значение.ЗагрузитьЗначения(СписокЛС.ВыгрузитьКолонку("ЛицевойСчет"));
		
		Если мЕстьПечатьЗависимых Тогда
			ДобавитьЗависимыеВОсновнойСписок(Значение, тмпСписокЛС);
		КонецЕсли; 
		
		ОтборЛС = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
		ОтборЛС.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЛС.Значение      = Значение;
		ОтборЛС.Использование = Истина;
		
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	Результат = ПостроительЗапроса.Результат.Выгрузить();
	
	КоличествоПакетов = Окр((Результат.Количество()/РазмерПакетаПросмотра), 0, РежимОкругления.Окр15как20);
	КоличествоПакетов = ?(КоличествоПакетов <= 0, 1,КоличествоПакетов);
	
	КоличествоПакетовПечати = Окр((Результат.Количество()/РазмерПакетаПечати), 0, РежимОкругления.Окр15как20);
	КоличествоПакетовПечати = ?(КоличествоПакетовПечати <= 0, 1,КоличествоПакетовПечати);
	
	Возврат Результат;
	
КонецФункции

Функция ДобавитьЗависимыеВОсновнойСписок(СписокЛицевыйСчетов, ТаблицаЛС)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ТаблицаЛС", ТаблицаЛС);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЛС.ЛицевойСчет,
	|	ТаблицаЛС.ПечатьЗависимыхЛС
	|ПОМЕСТИТЬ ОсновнаяТаблица
	|ИЗ
	|	&ТаблицаЛС КАК ТаблицаЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЗависимыеЛС.ЛицевойСчетЗависимый,
	|	ОсновнаяТаблица.ЛицевойСчет
	|ИЗ
	|	ОсновнаяТаблица КАК ОсновнаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЗависимыеЛС КАК бит_ЗависимыеЛС
	|		ПО ОсновнаяТаблица.ЛицевойСчет = бит_ЗависимыеЛС.ЛицевойСчет
	|ГДЕ
	|	ОсновнаяТаблица.ПечатьЗависимыхЛС
	|	И НЕ бит_ЗависимыеЛС.ЛицевойСчетЗависимый ЕСТЬ NULL ";
	
	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокЛицевыйСчетов.Добавить(Выборка.ЛицевойСчетЗависимый);
		
	КонецЦикла; 
	
КонецФункции

// Фукнция возрващает таблицу содеражащую данные для печати квитанций по Лицевым счета.
//
// Параметры:
//    ТолькоПоОтбору - Булево - Флаг определеяет количество лицевых счетов по отбору либо по размеру пакета просмотра.
//
Функция СформироватьДанныеПечати(ТолькоПоОтбору = Ложь, Печать = Ложь) Экспорт
	
	// Кэширование основных параметров.
	
	Если НЕ УстановитьМакет() Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ТаблицаДанных = Новый ТаблицаЗначений;        
	ТаблицаДанных.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаДанных.Колонки.Добавить("ВладелецЛС" , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаДанных.Колонки.Добавить("Значение");
	
	ОбновитьНастройкиЖКХ();
	ОбновитьКэшОрганизации();
	ОбновитьКэшПолучателяПлатежа();
	
	ПолучитьНастройкуМакета();
	
	// Отбор лицевых счетов.
	
	тмпСписокЛС = СписокЛС.Выгрузить();
	
	ТекущийПакет = ?(ТекущийПакет  = 0 ,1,ТекущийПакет);
	
	тмпТаблицаОтбор =  ПолучитьЛСПоОтбору();
	
	ТекущийПакет       = ?(ТекущийПакет > КоличествоПакетов      , 1, ТекущийПакет);
	ТекущийПакетПечати = ?(ТекущийПакетПечати > КоличествоПакетов, 1, ТекущийПакетПечати);
	
	Если ТолькоПоОтбору Тогда
		
		ОтборЛС = тмпТаблицаОтбор.ВыгрузитьКолонку("ЛицевойСчет");
		
	Иначе
		
		РазмерПакета = ?(Печать, РазмерПакетаПечати     , РазмерПакетаПросмотра);
		НомерПакета  = ?(Печать, ТекущийПакетПечати     , ТекущийПакет);
		КолПакетов   = ?(Печать, КоличествоПакетовПечати,КоличествоПакетов);
		
		МаксимальныйЭлемент = НомерПакета * РазмерПакета;
		МинимальныйЭлемент  = МаксимальныйЭлемент - РазмерПакета;
		МаксимальныйЭлемент = ?(НомерПакета = КолПакетов, тмпТаблицаОтбор.Количество(), МаксимальныйЭлемент);
		
		ОтборЛС = Новый СписокЗначений;
		
		Для Значение = МинимальныйЭлемент По МаксимальныйЭлемент - 1 Цикл
			ОтборЛС.Добавить(тмпТаблицаОтбор[Значение].ЛицевойСчет);
		КонецЦикла;
		
	КонецЕсли;
	
	// БИТ ЖКХ 22.01.2020
	мТаблицаПлощадейСчетчиков = ПолучитьТаблицуПлощадейСчетчиков(ЭтотОбъект.Период);
	
	// БИТ ЖКХ 13.04.2020
    мТаблицаГрупповыхСчетчиковНаУслугах = ПолучитьТаблицуГрупповыхСчетчиковНаУслугах(ЭтотОбъект.Период);	
	мТаблицаСчетчиковНаУслугах = ПолучитьТаблицуСчетчиковНаУслугах(ЭтотОбъект.Период);
	

	// Получение данных по отбору. 
	
	Сальдо = ШаблонИзвещений.Сальдо;
	Кредит = ШаблонИзвещений.Кредит;
	
	МВТ = Новый МенеджерВременныхТаблиц;
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
	
	Запрос.УстановитьПараметр("НачалоПериода"			, НачалоМесяца(Период));
	Запрос.УстановитьПараметр("КонецПериода"			, КонецМесяца(Период));
	Запрос.УстановитьПараметр("Организация"				, Организация);
	Запрос.УстановитьПараметр("ДатаНачалаВеденияПоКУ"	, мКэшПараметрыЖКХ.ДатаНачалаВеденияПоКУ);
	Запрос.УстановитьПараметр("ВыводитьЗависимыеЛС"		, мКэшПараметрыЖКХ.ВыводитьЗависимыеЛС);
	Запрос.УстановитьПараметр("ТаблицаНостроек"			, тмпСписокЛС);
	Запрос.УстановитьПараметр("СписокЛС"				, ОтборЛС);
	Запрос.УстановитьПараметр("ШаблонИзвещений"			, ШаблонИзвещений);
	
	ЕстьОтборУслуг = Ложь;
	
	СписокУС = Новый СписокЗначений;
	
	Если НЕ ШаблонИзвещений = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам Тогда
		СписокУС.ЗагрузитьЗначения(ШаблонИзвещений.Услуги.ВыгрузитьКолонку("Услуга"));
		ЕстьОтборУслуг = СписокУС.Количество() > 0;
	КонецЕсли;
	
	дополнительныйТекстЗапроса = "";
	если мОсновнойВариантМакета.Наименование = "Единый платежный документ №761/32" тогда 
	
	  дополнительныйТекстЗапроса = " И 
	      | // 21.11.2018
	      |                   (бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Постоянно) ИЛИ
	      |                      бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Временно)) ";   
	  
	конецесли;

	
	Запрос.УстановитьПараметр("СписокУС"      , СписокУС);
	Запрос.УстановитьПараметр("ЕстьОтборУслуг", ЕстьОтборУслуг);
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ТаблицаНостроек.ЛицевойСчет КАК ЛицевойСчет,
	|	ТаблицаНостроек.ГруппироватьУслуги КАК ГруппироватьУслуги,
	|	ТаблицаНостроек.ПечатьЗависимыхЛС КАК ПечатьЗависимыхЛС
	|ПОМЕСТИТЬ НастройкиЛС
	|ИЗ
	|	&ТаблицаНостроек КАК ТаблицаНостроек
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЗависимыеЛС.ЛицевойСчет КАК ЛицевойСчет,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НастройкиЛС.ПечатьЗависимыхЛС, ЛОЖЬ)
	|				ИЛИ &ВыводитьЗависимыеЛС
	|			ТОГДА бит_ЗависимыеЛС.ЛицевойСчетЗависимый
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК ЛицевойСчетЗависимый,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(НастройкиЛС.ПечатьЗависимыхЛС, ЛОЖЬ)
	|				ИЛИ &ВыводитьЗависимыеЛС
	|			ТОГДА бит_ЗависимыеЛС.ЛицевойСчет.Наименование
	|		ИНАЧЕ NULL
	|	КОНЕЦ КАК НаименованиеВладелец
	|ПОМЕСТИТЬ ЗависимыеЛС
	|ИЗ
	|	РегистрСведений.бит_ЗависимыеЛС КАК бит_ЗависимыеЛС
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиЛС КАК НастройкиЛС
	|		ПО бит_ЗависимыеЛС.ЛицевойСчет = НастройкиЛС.ЛицевойСчет
	|ГДЕ
	|	бит_ЗависимыеЛС.ЛицевойСчет В(&СписокЛС)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	бит_ЗависимыеЛС.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
