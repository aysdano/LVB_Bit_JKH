Процедура ЗагрузитьВсеПени(Команда)
	// Вставить содержимое обработчика.
		СписокФайлов = НАйтиФайлы(ИмяПапкиКл,"ns_peny*.dbf");
		СписокФайлов2  = НайтиФайлы(ИмяПапкиКл,"ns_kap_p*.dbf");
		Для каждого ИнфоФайла из СписокФайлов2 цикл
			СписокФайлов.Добавить(ИнфоФайла);
		КонецЦикла;	
			
		Для Каждого ИнфоФ из СписокФайлов цикл		
			Если ложь тогда ИнфоФ = новый Файл КонецЕсли;;		
			ЭтаФорма.ИмяФайлаКл = ИнфоФ.ПолноеИмя;
			
			
			Сообщить("Начата обработка ... "+ИнфоФ.Имя);
			
			Мас = новый массив(1);          //передаем файл на сервер
			Мас[0] = ЭтаФорма.ИмяФайлаКл;
			ИмяФайлаОкончаниеВыбора(Мас); 
			
			ПередатьФайлНаСервер();
			ЗагрузитьОстаткиПениНаСервере(); //и обрабатываем файл
			Сообщить("Обработан файл ... "+ИнфоФ.Имя);
		КонецЦикла;	  

КонецПроцедуры


&НаСервере
Процедура ЗагрузитьОстаткиПениНаСервере()
	// Вставить содержимое обработчика.
	МассивСтру = ЗагрузитьДБФВМассивСтруктур();	

	ЗаполнитьКэшКвартирЛицевыхСчетов();
	
	
	ДобавитьПодучасткиВМассивСтру();
	
	ОбработаноЭлементов = 0;
	ЧислоСтрокВДокумненте = 0;  //если =0, то группирируем в документы по подучасткам  Стру.Подучасток, идущим подряд
	Подучасток = ""; 
	Пока ОбработаноЭлементов<МассивСтру.Количество()  цикл				
		ДокОбъект = Документы.бит_ВводНачальныхОстатковПениПоКУ.СоздатьДокумент();
		ДокОбъект.Дата = КонецДня(Объект.Дата);
		ДокОбъект.Организация = Объект.Организация;		
		ЗаполнитьСтрокиДокументаОстаткиПениКУ(ДокОбъект,ОбработаноЭлементов,ЧислоСтрокВДокумненте,Подучасток);
		Если ДокОбъект.СписокЛС.Количество() >0 тогда
			ПозСлэша = СтрНайти(ЭтаФорма.ИмяФайлаКл,"\",НаправлениеПоиска.СКонца,,2);
			ИмяФ = ?(ПозСлэша=0,ЭтаФорма.ИмяФайлаКл,Сред(ЭтаФорма.ИмяФайлаКл,ПозСлэша+1));
			Если ПустаяСтрока(Подучасток) или (Подучасток = Неопределено) тогда
				ДокОбъект.Комментарий = "Из файла " + ИмяФ;
			иначе
				ДокОбъект.Комментарий = "Подуч "+Подучасток + " из файла " + ИмяФ; 
			КонецЕсли;	
			ДокОбъект.СуммаДокумента = ДокОбъект.СписокЛС.Итог("Сумма");	
			ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
			ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);				
		иначе	
			Сообщить("В файле "+ ЭтаФорма.ИмяФайлаКл + " нет ненулевых строк");
		КонецЕсли;	
	Конеццикла;	
	
	
	
КонецПроцедуры



&НаСервере
Процедура  ЗаполнитьСтрокиДокументаОстаткиПениКУ(ДокОбъект,НачИндекс, ЧислоСтрокВДокументе,ТекПодучасток);
	Если ложь тогда ДокОбъект = Документы.бит_ВводНачальныхОстатковПениПоКУ.СоздатьДокумент(); КонецЕсли;
	Если ТипЗнч(МассивСтру)<>Тип("Массив") тогда 
		возврат
	КонецЕсли;	
	Счет76КУ = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.КУ");
	Счет000  = ПланыСчетов.Хозрасчетный.НайтиПоКоду("000");
	
	
	//Определим загружаемые элементы МассивСтру
	ВГраница = МассивСтру.ВГраница();
	Если ЧислоСтрокВДокументе =0 и НачИндекс<=ВГраница тогда
		ТекПодучасток = МассивСтру[НачИндекс].Подучасток;				
		Для МаксИндекс = НачИндекс+1 по ВГраница цикл
			Если МассивСтру[МаксИндекс].Подучасток<>ТекПодучасток тогда
				прервать;
			КонецЕсли;	
		КонецЦикла;	
		Если (МаксИндекс>ВГраница) или  (МассивСтру[МаксИндекс].Подучасток<>ТекПодучасток) тогда
			МаксИндекс = МаксИндекс-1;
		КонецЕсли;	              		
	иначе		
		МаксИндекс = мин(НачИндекс + ЧислоСтрокВДокументе-1,МассивСтру.ВГраница());			
	КонецЕсли;
	
	Для Инд = НачИндекс по МаксИндекс цикл	  		
		Стру = МассивСтру[Инд]; 
		ЛС = СсылкаЛС(Стру.LS);		
		Услуга = УслугаЖКХ(Стру.YSL);
		Сумма = стру.SALDO;
		Если Сумма = 0 тогда
			продолжить
		КонецЕсли;;	
		Если Не ЗначениеЗаполнено(ЛС) тогда
			Сообщить("Не найден ЛС:" + сокрЛП(Стру.LS));
			Продолжить;
		КонецЕсли;
		
		НовСтрока = ДокОбъект.СписокЛС.Добавить();
		НовСтрока.ЛицевойСчет = ЛС;
		НовСтрока.Услуга = Услуга;
		НовСтрока.СальдоНаЛС = Сумма;
		НовСтрока.СчетКУ = Счет000;
		НовСтрока.СчетАбонента = Счет76КУ;
		НовСтрока.Субконто1 = ЛС;
		НовСтрока.Субконто2 = Услуга;
		НовСтрока.Сумма = Сумма;  
		НовСтрока.СуммаДолга = Сумма;	
	КонецЦикла;;	
	
	НачИндекс = МаксИндекс+1;
КонецПроцедуры	

