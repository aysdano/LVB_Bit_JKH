			<field>НомерИсполнительногоЛиста</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИсторияИсполнительныхЛистовСрезПоследних.Регистратор КАК Регистратор,
	ИсторияИсполнительныхЛистовСрезПоследних.НомерИсполнительногоЛиста КАК НомерИЛ,
	ИсторияИсполнительныхЛистовСрезПоследних.ТипСудебногоДокумента КАК ТипСудебногоДокумента,
	ИсторияИсполнительныхЛистовСрезПоследних.ФИОДолжника КАК ФИОДолжника,
	ИсторияИсполнительныхЛистовСрезПоследних.Адрес КАК Адрес,
	ИсторияИсполнительныхЛистовСрезПоследних.ДатаИсполнительногоЛиста КАК ДатаИсполнительногоЛиста,
	бит_ИсполнительныйЛист.СуммаПредставительскихРасходовПоРешениюСуда КАК СуммаПРпоРешениюСуда,
	бит_ИсполнительныйЛист.СуммаГоспошлиныПоРешениюСуда КАК СуммаГПпоРешениюСуда,
	бит_ИсполнительныйЛист.ЛицевойСчет КАК ЛицевойСчет,
	бит_ИсполнительныйЛист.Услуга КАК Услуга,
	бит_ИсполнительныйЛист.СуммаДолгаПоУслугеПоРешениюСуда КАК СуммаДолгаПоРешениюСуда,
	бит_ИсковоеЗаявление.СуммаЗадолженности КАК СуммаПоИску,
	бит_ИсковоеЗаявление.Госпошлина КАК СуммаГПпоИску,
	бит_ИсковоеЗаявление.ПредставительскиеРасходы КАК СуммаПРпоИску
ПОМЕСТИТЬ ВТ_ИсторияИЛ
ИЗ
	РегистрСведений.ИсторияИсполнительныхЛистов.СрезПоследних(, ) КАК ИсторияИсполнительныхЛистовСрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
			ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ИсковоеЗаявление КАК бит_ИсковоеЗаявление
			ПО бит_ИсполнительныйЛист.ЛицевойСчет = бит_ИсковоеЗаявление.ЛицевойСчет
				И бит_ИсполнительныйЛист.Услуга = бит_ИсковоеЗаявление.Услуга
		ПО ИсторияИсполнительныхЛистовСрезПоследних.Регистратор = бит_ИсполнительныйЛист.Ссылка
ГДЕ
	ИсторияИсполнительныхЛистовСрезПоследних.Период МЕЖДУ &amp;Дата1 И &amp;Дата2
	И бит_ИсполнительныйЛист.Проведен = ИСТИНА
	И ИсторияИсполнительныхЛистовСрезПоследних.Активность = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_ИсполнительныйЛист.Ссылка КАК Ссылка,
	НаправлениеБанк.СтатусДокумента КАК СтатусНаправлениеБанк,
	МАКСИМУМ(НаправлениеБанк.Период) КАК ДатаНаправленияБанк,
	0 КАК СтатусСПП,
	0 КАК ДатаНаправленияСПП,
	0 КАК СтатусСнятие,
	0 КАК ДатаСнятияСУчета
ПОМЕСТИТЬ ВТ_ПервичныеСтатусы
ИЗ
	Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоИсполнительнымЛистам КАК НаправлениеБанк
		ПО бит_ИсполнительныйЛист.Ссылка = НаправлениеБанк.ИсполнительныйЛист
ГДЕ
	бит_ИсполнительныйЛист.Проведен = ИСТИНА
	И бит_ИсполнительныйЛист.Дата МЕЖДУ &amp;Дата1 И &amp;Дата2
	И НаправлениеБанк.СтатусДокумента.Ссылка В(&amp;СтатусНаправлениеБанк)

СГРУППИРОВАТЬ ПО
	бит_ИсполнительныйЛист.Ссылка,
	НаправлениеБанк.СтатусДокумента

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	бит_ИсполнительныйЛист.Ссылка,
	0,
	0,
	НаправлениеСПП.СтатусДокумента,
	МАКСИМУМ(НаправлениеСПП.Период),
	0,
	0
ИЗ
	Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоИсполнительнымЛистам КАК НаправлениеСПП
		ПО бит_ИсполнительныйЛист.Ссылка = НаправлениеСПП.ИсполнительныйЛист
ГДЕ
	бит_ИсполнительныйЛист.Проведен = ИСТИНА
	И бит_ИсполнительныйЛист.Дата МЕЖДУ &amp;Дата1 И &amp;Дата2
	И НаправлениеСПП.СтатусДокумента.Ссылка В(&amp;СтатусНаправлениеСПП)

СГРУППИРОВАТЬ ПО
	бит_ИсполнительныйЛист.Ссылка,
	НаправлениеСПП.СтатусДокумента

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	бит_ИсполнительныйЛист.Ссылка,
	0,
	0,
	0,
	0,
	СнятиеСУчета.СтатусДокумента,
	МАКСИМУМ(СнятиеСУчета.Период)
ИЗ
	Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоИсполнительнымЛистам КАК СнятиеСУчета
		ПО бит_ИсполнительныйЛист.Ссылка = СнятиеСУчета.ИсполнительныйЛист
ГДЕ
	бит_ИсполнительныйЛист.Проведен = ИСТИНА
	И бит_ИсполнительныйЛист.Дата МЕЖДУ &amp;Дата1 И &amp;Дата2
	И СнятиеСУчета.СтатусДокумента.Ссылка В(&amp;СтатусСнятиеСУчета)

СГРУППИРОВАТЬ ПО
	бит_ИсполнительныйЛист.Ссылка,
	СнятиеСУчета.СтатусДокумента
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ПервичныеСтатусы.Ссылка КАК Ссылка,
	МАКСИМУМ(ВТ_ПервичныеСтатусы.СтатусНаправлениеБанк) КАК СтатусНаправлениеБанк,
	МАКСИМУМ(ВТ_ПервичныеСтатусы.ДатаНаправленияБанк) КАК ДатаНаправленияБанк,
	МАКСИМУМ(ВТ_ПервичныеСтатусы.СтатусСПП) КАК СтатусСПП,
	МАКСИМУМ(ВТ_ПервичныеСтатусы.ДатаНаправленияСПП) КАК ДатаНаправленияСПП,
	МАКСИМУМ(ВТ_ПервичныеСтатусы.СтатусСнятие) КАК СтатусСнятие,
	МАКСИМУМ(ВТ_ПервичныеСтатусы.ДатаСнятияСУчета) КАК ДатаСнятияСУчета
ПОМЕСТИТЬ ВТ_Статусы
ИЗ
	ВТ_ПервичныеСтатусы КАК ВТ_ПервичныеСтатусы

СГРУППИРОВАТЬ ПО
	ВТ_ПервичныеСтатусы.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ИсторияРаботыСДолжниками.Регистратор КАК Регистратор,
	ИсторияРаботыСДолжниками.ДатаРейда КАК ДатаРейда,
	ИсторияРаботыСДолжниками.РезультатРейда КАК РезультатРейда
ПОМЕСТИТЬ ВТ_Рейд
ИЗ
	РегистрСведений.ИсторияРаботыСДолжниками КАК ИсторияРаботыСДолжниками
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
		ПО ИсторияРаботыСДолжниками.Регистратор = бит_ИсполнительныйЛист.Ссылка
ГДЕ
	бит_ИсполнительныйЛист.Дата МЕЖДУ &amp;Дата1 И &amp;Дата2
	И бит_ИсполнительныйЛист.Проведен = ИСТИНА
	И ИсторияРаботыСДолжниками.Активность = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_ИсполнительныйЛист.Ссылка КАК ИЛ,
	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.ЛицевойСчет КАК ЛицевойСчет,
	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.ФИОДолжника КАК ФИОДолжника,
	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.Услуга КАК Услуга,
	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.СуммаОстаток КАК СуммаОстаток,
	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.СуммаГоспошлиныОстаток КАК СуммаГПОстаток,
	ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.СуммаПредставительскихРасходовОстаток КАК СуммаПРОстаток
ПОМЕСТИТЬ ВТ_Взаиморасчеты
ИЗ
	РегистрНакопления.ВзаиморасчетыПоИсполнительномуПроизводству.Остатки(
			&amp;Дата2,
			ИсполнительныйЛист В
				(ВЫБРАТЬ
					ВТ_ИсторияИЛ.Регистратор КАК Регистратор
				ИЗ
					ВТ_ИсторияИЛ КАК ВТ_ИсторияИЛ)) КАК ВзаиморасчетыПоИсполнительномуПроизводствуОстатки
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
		ПО ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.ЛицевойСчет = бит_ИсполнительныйЛист.ЛицевойСчет
			И ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.ФИОДолжника = бит_ИсполнительныйЛист.ФИОДолжника
			И ВзаиморасчетыПоИсполнительномуПроизводствуОстатки.Услуга = бит_ИсполнительныйЛист.Услуга
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	ВТ_ИсторияИЛ.ФИОДолжника КАК ФИОДолжника,
	ВТ_ИсторияИЛ.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_ИсторияИЛ.Адрес КАК Адрес,
	ВТ_ИсторияИЛ.ТипСудебногоДокумента КАК ТипСудебногоДокумента,
	ВТ_ИсторияИЛ.Услуга КАК Услуга,
	ВТ_ИсторияИЛ.НомерИЛ КАК НомерИЛ,
	ВТ_ИсторияИЛ.СуммаПоИску КАК СуммаПоИску,
	ВТ_ИсторияИЛ.СуммаДолгаПоРешениюСуда КАК СуммаДолгаПоРешениюСуда,
