
#Область ПеременныеМодуля

&НаКлиенте 
Перем мКэшРеквизитовФормы;       // Хранит текущие значения реквизитов формы. Клиент.
&НаКлиенте
Перем тмпКонечныеПоказания;      // Хранит конечные показания. Клиент.
&НаКлиенте
Перем тмпПоказания;              // Хранит показания. Клиент.

#КонецОбласти

#Область РаботаСКэшемРеквизитовФормы

// Процедура заполняет кэш реквизитов формы данными объекта.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура ЗаполнитьТекущиеЗначенияРеквизитовФормы()
	
	Для Каждого КлючИЗначение Из мКэшРеквизитовФормы Цикл
		мКэшРеквизитовФормы[КлючИЗначение.Ключ] = Объект[КлючИЗначение.Ключ];
	КонецЦикла; 
	
КонецПроцедуры // ЗаполнитьТекущиеЗначенияРеквизитовФормы()

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции // ПолучитьТипОбъекта()

#КонецОбласти

#Область УправлениеВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , Строка(""));
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры // УстановитьЗаголовокФормыДокумента()

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ПоказанияПоСчетчикамУлица.Видимость       = ?(Объект.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой,Ложь,(Объект.Улица = Справочники.бит_СписокУлиц.ПустаяСсылка())); 
	Элементы.ПоказанияПоСчетчикамЛицевойСчет.Видимость = ?(Объект.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой,Ложь,(Объект.ЛицевойСчет = Справочники.бит_ЛицевыеСчета.ПустаяСсылка()));
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ПоказанияПодкрутки Тогда
		
		Элементы.ЧислоПоказанияНаселения.Видимость                   = Ложь;
		Элементы.ПоказанияПоСчетчикамТекущиеПоказания.ТолькоПросмотр = Истина;
		
	Иначе
		
		Элементы.ЧислоПоказанияНаселения.Видимость                   = Истина;
		Элементы.ПоказанияПоСчетчикамТекущиеПоказания.ТолькоПросмотр = Ложь;
		
	КонецЕсли;
	
	Если Объект.ЗаполнитьТаблицуСчетчиковВРучную Тогда
		
		Элементы.ПоказанияПоСчетчикамСменаВвода.Пометка = Истина;
		Элементы.ПоказанияПоСчетчикамСменаВвода.Заголовок = "Режим заполнения: ""Ручной"""; 
		
	КонецЕсли;
	
	Если Объект.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
		
		Элементы.ЧислоПоказанияНаселения.Доступность = Ложь;
		Элементы.ЛицевойСчет.Видимость               = Ложь;
		
	Иначе
		
		Элементы.ЧислоПоказанияНаселения.Доступность = Истина;
		Элементы.ЛицевойСчет.Видимость               = Истина;
		
	КонецЕсли;
	
	// БИТ ЖКХ 02.04.2021
	ЧислоПоказанияНаселения = НЕ Объект.ПоказанияНаселения;
	
	
	Элементы.ПоказанияПоСчетчикамСчетчик.КнопкаВыбора     = Объект.ЗаполнитьТаблицуСчетчиковВРучную;
	Элементы.ПоказанияПоСчетчикамЛицевойСчет.КнопкаВыбора = ?(Объект.ЗаполнитьТаблицуСчетчиковВРучную, НЕ ЗначениеЗаполнено(Объект.ЛицевойСчет), Ложь);
	Элементы.ПоказанияПоСчетчикамДом.КнопкаВыбора         = ?(Объект.ЗаполнитьТаблицуСчетчиковВРучную, НЕ ЗначениеЗаполнено(Объект.Дом), Ложь);
	Элементы.ПоказанияПоСчетчикамУлица.КнопкаВыбора       = Объект.ЗаполнитьТаблицуСчетчиковВРучную;
	
	Элементы.ПоказанияПоСчетчикамУлица.ПропускатьПриВводе       = НЕ Объект.ЗаполнитьТаблицуСчетчиковВРучную;
	Элементы.ПоказанияПоСчетчикамЛицевойСчет.ПропускатьПриВводе = НЕ Объект.ЗаполнитьТаблицуСчетчиковВРучную;
	Элементы.ПоказанияПоСчетчикамДом.ПропускатьПриВводе         = НЕ Объект.ЗаполнитьТаблицуСчетчиковВРучную;
	Элементы.ПоказанияПоСчетчикамСчетчик.ПропускатьПриВводе     = НЕ Объект.ЗаполнитьТаблицуСчетчиковВРучную;
	
КонецПроцедуры // УправлениеЭлементамиФормы()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Вывести в заголовке формы вид операции и статус документа (новый, не проведен, проведен).
	УстановитьЗаголовокФормыДокумента();
	
	// Зададим имена реквизитов, подлежащих кешированию.
	мКэшРеквизитовФормы = Новый Структура;

	// Запомним текущие значения реквизитов формы.
	ЗаполнитьТекущиеЗначенияРеквизитовФормы();
	
	УправлениеЭлементамиФормы();
	
	// БИТ_ЖКХ 10.12.2014{{
	ИнтерфейсТакси = ТекущийВариантИнтерфейсаКлиентскогоПриложения() = ВариантИнтерфейсаКлиентскогоПриложения.Такси;
	
	Если НЕ ИнтерфейсТакси Тогда
		
		Элементы.Группа6.Высота = 0;
		Элементы.Группа6.РастягиватьПоВертикали = Истина; 
		
	КонецЕсли;	
	// БИТ_ЖКХ 10.12.2014}}	
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФорм

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Объект.ПоказанияПоСчетчикам.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru='Таблица показаний счетчиков будет очищена. Продолжить?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	иначе	
		ЗаполнитьТаблицуПоказанийНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнитьТаблицуПоказанийНаСервере();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура УслугаНеРассчитывается(Команда)
	
	УслугаНеРассчитывается = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура СменаВвода(Команда)
	
	Если Элементы.ПоказанияПоСчетчикамСменаВвода.Пометка Тогда
		
		Элементы.ПоказанияПоСчетчикамСменаВвода.Пометка   = Ложь;
		Элементы.ПоказанияПоСчетчикамСменаВвода.Заголовок = "Режим заполнения: ""Автоматический""";
		Объект.ЗаполнитьТаблицуСчетчиковВРучную           = Ложь;
		
	Иначе
		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацииВводПоказанийПоСчетчикам.ПоказанияПодкрутки") Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Для вида операции ""Показания подкрутки"" ручной режим заполнения не доступен.'"),, "Объект");
			Возврат;	
		КонецЕсли;
		
		Элементы.ПоказанияПоСчетчикамСменаВвода.Пометка   = Истина;
		Элементы.ПоказанияПоСчетчикамСменаВвода.Заголовок = "Режим заполнения: ""Ручной""";
		Объект.ЗаполнитьТаблицуСчетчиковВРучную           = Истина;
		
	КонецЕсли; 
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФорм

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если Объект.ЗаполнитьТаблицуСчетчиковВРучную Тогда
		Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Для вида операции ""Показания подкрутки"" ручной режим заполнения не доступен.'"),, "Объект");
	КонецЕсли;
	
	Объект.ПоказанияПоСчетчикам.Очистить();
	
	УправлениеЭлементамиФормы();
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСчетчикаПриИзменении(Элемент)
	
	Объект.ЛицевойСчет = ПолучитьПустойЛицевойСчет(); 
	Объект.ПоказанияПоСчетчикам.Очистить();
	
	УправлениеЭлементамиФормы();
	
	Объект.ПоказанияНаселения = НЕ Объект.ТипСчетчика = ПолучитьГрупповойТипСчетчика();
	
КонецПроцедуры

&НаКлиенте
Процедура УлицаПриИзменении(Элемент)
	
	Объект.Дом         = ПолучитьПустойСписокЗданий();
	Объект.ЛицевойСчет = ПолучитьПустойЛицевойСчет();
	
	Объект.ПоказанияПоСчетчикам.Очистить();
	
	//ЗаполнитьТаблицуПоказанийНаСервере();
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДомПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.Улица) Тогда
		
		Объект.Улица = ПолучитьУлицуДома(Объект.Дом);
		
	КонецЕсли;
	
	Объект.ЛицевойСчет = Неопределено;
	
	Объект.ПоказанияПоСчетчикам.Очистить();
	
	ЗаполнитьТаблицуПоказанийНаСервере();
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ДомНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;
	Отбор.Вставить("Организация", Объект.Организация);
	Отбор.Вставить("Улица"      , Объект.Улица);
	
	ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.Улица) Тогда
		
		Объект.Улица = ПолучитьУлицуЛицевогоСчета(Объект.ЛицевойСчет);
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Дом) Тогда
		
		Объект.Дом   = ПолучитьЗданиеЛицевогоСчета(Объект.ЛицевойСчет);
		
	КонецЕсли;
	
	Объект.ПоказанияПоСчетчикам.Очистить();
	
	ЗаполнитьТаблицуПоказанийНаСервере();
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;
	
	Если ЗначениеЗаполнено(Объект.Улица) Тогда
		
		Отбор.Вставить("УлицаЛицевогоСчета", Объект.Улица);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Дом) Тогда
		
		Отбор.Вставить("Здание", Объект.Дом);
		
	КонецЕсли;
	
	ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УслугаПриИзменении(Элемент)
	
	Объект.ПоказанияПоСчетчикам.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ Объект.ЛицевойСчет = ПолучитьПустойЛицевойСчет() Тогда
		
		СтандартнаяОбработка = Ложь;
		
		СписокУслуг = ПолучитьСписокЗначенийУслуг();
		
		Отбор = Новый Структура;
		Отбор.Вставить("Ссылка", СписокУслуг);
		
		ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТипСчетчикаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.ВидОперации = ПолучитьВидОперацииПоказанияПодкрутки() Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Если ВыбранноеЗначение = ПолучитьГрупповойТипСчетчика() Тогда
			
			// БИТ_ЖКХ 03.03.2015{{
			// Сообщить("Показания подкрутки вводятся только по индивидуальному счетчику.", СтатусСообщения.ОченьВажное);.
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Показания подкрутки вводятся только по индивидуальному счетчику.";
			Сообщение.Сообщить();
			// БИТ_ЖКХ 03.03.2015}}
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗначениеПриИзменении(Элемент)
	
	Если ЭтаФорма.Значение.Количество() > 0 Тогда
		
		ЭтаФорма.ФлагОтбора = Истина;
		
	Иначе
		
		ЭтаФорма.ФлагОтбора = Ложь;
		
	КонецЕсли;
	
	Если ЭтаФорма.ФлагОтбора = Истина Тогда
		
		ИзменитьУсловноеОформлениеНаСервере(Истина);
		
	Иначе
		
		ИзменитьУсловноеОформлениеНаСервере(Ложь);
		
	КонецЕсли;
	
	ЭтаФорма.Модифицированность = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование Тогда
		
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли; 
	
	Отказ = НЕ Объект.ЗаполнитьТаблицуСчетчиковВРучную;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамПередУдалением(Элемент, Отказ)
	
	ТекСтрока = Элементы.ПоказанияПоСчетчикам.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ТекСтрока.Многотарифный Тогда
		
		Отказ = Истина;
		
		Отбор = Новый Структура;
		Отбор.Вставить("Счетчик"    , ТекСтрока.Счетчик);
		
		МассивСтрок = Объект.ПоказанияПоСчетчикам.НайтиСтроки(Отбор);
		
		Для каждого Строка Из МассивСтрок Цикл
			
			Объект.ПоказанияПоСчетчикам.Удалить(Строка);
			
		КонецЦикла;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПоказанияПоСчетчикам.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные = Неопределено И НЕ тмпКонечныеПоказания = Неопределено Тогда
		
		ТекущиеДанные.ТекущиеПоказания = Число(тмпКонечныеПоказания);
		
	КонецЕсли; 
	
	тмпКонечныеПоказания = Неопределено;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Тогда
		
		ТекСтрока = Элементы.ПоказанияПоСчетчикам.ТекущиеДанные;
		
		Если ЗначениеЗаполнено(Объект.Дом) Тогда
			
			ТекСтрока.Дом         = Объект.Дом;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
			
			ТекСтрока.ЛицевойСчет = Объект.ЛицевойСчет;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Объект.Улица) Тогда
			
			ТекСтрока.Улица       = Объект.Улица;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказанияПоСчетчикамДомНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекСтрока = Элементы.ПоказанияПоСчетчикам.ТекущиеДанные;
	
	ТекУлица = ПолучитьПустуюУлицу();
	
	Если НЕ ТекСтрока = Неопределено Тогда
		
		ТекУлица = ТекСтрока.Улица;
		
	ИначеЕсли ЗначениеЗаполнено(Объект.Улица) Тогда
		
		ТекУлица = Объект.Улица;
		
	КонецЕсли;
	
	Отбор = Новый Структура;
	
	Если ЗначениеЗаполнено(ТекУлица) Тогда
		
		Отбор.Вставить("Улица", ТекУлица);
		
	Иначе
		
		// БИТ_ЖКХ 03.03.2015{{
		// Сообщить("Укажите улицу.", СтатусСообщения.Информация);.
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Укажите улицу.";
		Сообщение.Сообщить();
		// БИТ_ЖКХ 03.03.2015}}
		
		Возврат;
		
	КонецЕсли;
	
	ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
	
