КонецПроцедуры

&НаКлиенте
Процедура СформироватьФайлCSV(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		Сообщить("Не заполнен каталог!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда
		Сообщить("Не заполнено начало периода!");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(КонецПериода) Тогда
		Сообщить("Не заполнен конец периода!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Не заполнена организация!");
		Возврат;
	КонецЕсли;
	
	ПолучитьДанныеНаСервере();
	//Если Не ТаблицаИтог.Количество() = 0 Тогда
		СформироватьФайлCSVНаКлиенте();	
	//Иначе	
	//	Сообщить("Не найдены данные для сохранения в файл csv!");	
	//КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеНаСервере()
	
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.Период) КАК Период,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира КАК Квартира
	|ПОМЕСТИТЬ ВТ_ДатыКвартир
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&ДатаОкончания, ) КАК бит_СведенияОКвартиреСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияОКвартиреСрезПоследних.Квартира
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДатыКвартир.Квартира КАК Квартира
	|ПОМЕСТИТЬ ВТ_КвартирыПоТипу
	|ИЗ
	|	ВТ_ДатыКвартир КАК ВТ_ДатыКвартир
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире КАК бит_СведенияОКвартире
	|		ПО ВТ_ДатыКвартир.Период = бит_СведенияОКвартире.Период
	|			И ВТ_ДатыКвартир.Квартира = бит_СведенияОКвартире.Квартира
	|ГДЕ
	|	бит_СведенияОКвартире.ТипКвартиры В(&ТипыКвартир)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет КАК Справочник.бит_ЛицевыеСчета) КАК LS,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ КАК Услуга,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор КАК Ссылка,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.НомерСтроки КАК НомерСтроки,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодСекунда КАК Период,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодМесяц КАК PER,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаРасход КАК Сумма,
	|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание.Район КАК Справочник.бит_АдминистративныеОкруга) КАК F,
	|	ВЫБОР
	|		КОГДА бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры ЕСТЬ NULL
	|				ИЛИ бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры = """"
	|			ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира
	|		ИНАЧЕ бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры
	|	КОНЕЦ КАК NKV,
	|	ЕСТЬNULL(лб_ПредставлниеЗданий.Представление, бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание) КАК ADR,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор.лб_ВидОплаты, ЗНАЧЕНИЕ(Справочник.лб_ВидыОплат.ОплатаЖильцов)) КАК VID,
	|	0 КАК СуммаПени
	|ПОМЕСТИТЬ ВТ_Данные
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
	|			&ДатаНачала,
	|			&ДатаОкончания,
	|			Авто,
	|			Организация = &Организация
	|				И УслугаЖКХ В (&Начисления)
	|				И 1 = 1
	|				И ЛицевойСчет.Здание.Район В (&Участки)
	|				И ЛицевойСчет.Квартира В
	|					(ВЫБРАТЬ
	|						ВТ_КвартирыПоТипу.Квартира КАК Квартира
	|					ИЗ
	|						ВТ_КвартирыПоТипу КАК ВТ_КвартирыПоТипу)) КАК бит_НачисленияПоУслугамЖКХПоПериодуОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&ДатаОкончания, ТипКвартиры В (&ТипыКвартир)) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_ПредставлниеЗданий КАК лб_ПредставлниеЗданий
	|		ПО бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание = лб_ПредставлниеЗданий.Здание
	|ГДЕ
	|	НЕ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|				ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РасчетПредельногоИндекса
	|				ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РасчетПредельногоИндексаОбщедомовыхЗатрат
	|				ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам)
	|	И ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|					ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|					ИЛИ бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.ОперацияБух
	|				ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор.лб_ВидОплаты В (&ВидыОплаты)
	|			ИНАЧЕ ИСТИНА
	|		КОНЕЦ
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВЫРАЗИТЬ(бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет КАК Справочник.бит_ЛицевыеСчета),
	|	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ,
	|	бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор,
	|	бит_НачислениеПениПоУслугамЖКХОбороты.НомерСтроки,
	|	бит_НачислениеПениПоУслугамЖКХОбороты.ПериодСекунда,
	|	бит_НачислениеПениПоУслугамЖКХОбороты.ПериодМесяц,
	|	0,
	|	ВЫРАЗИТЬ(бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет.Здание.Район КАК Справочник.бит_АдминистративныеОкруга),
	|	ВЫБОР
	|		КОГДА бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры ЕСТЬ NULL
	|				ИЛИ бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры = """"
	|			ТОГДА бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет.Квартира
	|		ИНАЧЕ бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры
	|	КОНЕЦ,
	|	ЕСТЬNULL(лб_ПредставлниеЗданий.Представление, бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет.Здание),
	|	ЕСТЬNULL(бит_НачислениеПениПоУслугамЖКХОбороты.Регистратор.лб_ВидОплаты, ЗНАЧЕНИЕ(Справочник.лб_ВидыОплат.ОплатаЖильцов)),
