КонецПроцедуры


Функция ПеняПоУслугеНаЛС (ЛС, Услуга, СчетКУ)
	
  СуммаПени = 0;	
  Отбор = Новый Структура;
  Отбор.Вставить("ЛицевойСчет", ЛС);
  Отбор.Вставить("Услуга", Услуга);
  Отбор.Вставить("СчетКУ", СчетКУ);

  // БИТ ЖКХ 17.07.2020
  если мТаблицаПоУслугамПеня.Количество() > 0 тогда
   СтрокиПени = мТаблицаПоУслугамПеня.НайтиСтроки(Отбор);
   Для Каждого Стр Из СтрокиПени Цикл
     СуммаПени = СуммаПени + Стр.СуммаПени;
	 Стр.Подсчитано  = истина;
   КонецЦикла;	  
  конецесли;
  
  возврат СуммаПени;
КонецФункции
#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Обработчик события "ОбработкаПроведения" документа.
//
Процедура ОбработкаПроведения(Отказ)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	// Проверим правильность заполнения шапки документа.
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	СтруктураПолей = Новый Структура;
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое 
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое
		// БИТ ЖКХ 10.03.2020
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды
		// БИТ ЖКХ 12.03.2020
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетСтраховыхДобровольныхВзносов
		//Михайлов
	    ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавки
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетПоЕдиницамПотребленияГрупповое
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетРанееПрименяемойСтавкиЗаменаСтавки
	    //Конец работ
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоЧекуККМ
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратОплаты
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ГрупповыеПерерасчетыОДН
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПереносОстатков	Тогда
		
		
		СтруктураПолей.Вставить("ЛицевойСчет" ,"ЛицевойСчет");
		
	КонецЕсли;
	
	СтруктураПолей.Вставить("Услуга" ,"Услуга");
	СтруктураПолей.Вставить("Сумма"  ,"Сумма");
	СтруктураПолей.Вставить("СчетАбонента" ,"СчетАбонента");
	СтруктураПолей.Вставить("Субконто1"    ,"Субконто1");
	СтруктураПолей.Вставить("Субконто2"    ,"Субконто2");
	СтруктураПолей.Вставить("Субконто3"    ,"Субконто3");
	СтруктураПолей.Вставить("СчетКУ"       ,"СчетКУ");
	СтруктураПолей.Вставить("СубконтоКУ1"  ,"СубконтоКУ1");
	СтруктураПолей.Вставить("СубконтоКУ2"  ,"СубконтоКУ2");
	СтруктураПолей.Вставить("СубконтоКУ3"  ,"СубконтоКУ3");
	
	СтруктураПолей.Вставить("Объем"  ,"Объем");
	
	СтруктураПолейЛС = Новый Структура;
	
	СтруктураПолейЛС.Вставить("ЛицевойСчет"         , "ЛицевойСчет");
	СтруктураПолейЛС.Вставить("Счетчик"             , "Счетчик");
	
	Для каждого Элемент Из СтруктураПолей Цикл
		
		Если НЕ СтруктураПолейЛС.Свойство(Элемент.Ключ) Тогда
			
			СтруктураПолейЛС.Вставить(Элемент.Ключ, Элемент.Значение);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков Тогда
		
		СтруктураПолейЛС.Вставить("НачисленияЗаПериод" , "НачисленияЗаПериод");
		СтруктураПолейЛС.Вставить("КоличествоЕдиниц"   , "КоличествоЕдиниц");
		
	Иначе
		
		СтруктураПолейЛС.Вставить("СпособРаспределения" , "СпособРаспределения");
		
	КонецЕсли; 
	
	РезультатЗапросПоЛС       = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "ЛицевыеСчета", СтруктураПолейЛС);
	ТаблицаПоЛС               = РезультатЗапросПоЛС.Выгрузить();
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоЧекуККМ
		ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратОплаты Тогда
		
		СтруктураПолей.Вставить("СуммаПени"  ,"СуммаПени");
		
	КонецЕсли; 
	
	// БИТ ЖКХ 14.07.2020
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ТехническаяКорректировкаПени Тогда
		
		СтруктураПолей.Вставить("СуммаПени"  ,"СуммаПени");
		СтруктураПолей.Вставить("ЛицевойСчет" , "ЛицевойСчет");		
		
	КонецЕсли; 

	
	РезультатЗапросаПоУслугам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "СписокУслуг", СтруктураПолей);
	ТаблицаПоУслугам          = РезультатЗапросаПоУслугам.Выгрузить();
	
	// БИТ ЖКХ 14.07.2020
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ТехническаяКорректировкаПени 
		 ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратОплаты Тогда
		
		СтруктураПолей.Вставить("Подсчитано"  ,"Подсчитано");				
		
	КонецЕсли; 

	РезультатЗапросаПоУслугамПеня = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "СписокУслугПеня", СтруктураПолей);
	мТаблицаПоУслугамПеня          = РезультатЗапросаПоУслугамПеня.Выгрузить();
	
	ПроверкаРеквизитовТЧ(ТаблицаПоУслугам, СтруктураШапкиДокумента,Отказ, Заголовок);
	ПроверкаРеквизитовТЧСумма(ТаблицаПоУслугам,СтруктураШапкиДокумента,Отказ, Заголовок);
	
	ПроверитьДублиУслуг(ТаблицаПоУслугам, Отказ, Заголовок);
	
	ПроверитьДублиЛС(ТаблицаПоЛС, Отказ, Заголовок);
	
			
	Если НЕ Отказ Тогда 
		
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, ТаблицаПоЛС, Отказ, Заголовок);
		
	КонецЕсли; 
	

	
КонецПроцедуры

Процедура ОбработкаЗаполнения(Основание)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.бит_РазовыеПоУслугамЖКХ") Тогда
		Если НЕ (Основание.ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслуги ИЛИ  Основание.ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчика ИЛИ
			Основание.ВидОперации =  Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоОтсутствующим) Тогда
			мНеСоздДокумент = Истина;
			Возврат;
		КонецЕсли;
		
		Организация         = Основание.Организация;
		ДокументОснование   = Основание;
		Дата                = Основание.Дата;
		ЛицевойСчет         = Основание.ЛицевойСчет;
		НачПериода          = Основание.НачПериода;
		КонПериода          = Основание.КонПериода;
		ПроцентНеДопоставки = Основание.ПроцентНеДопоставки;
		
		Если Основание.ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслуги или Основание.ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчика Тогда 
			ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьготПоНедоставкиУслуг;
			МассивУслуг = Основание.СписокУслуг.ВыгрузитьКолонку("Услуга");
			Для Каждого ТекСтрока Из МассивУслуг Цикл 
				НоваяСтрока = СписокУслуг.Добавить();
				НоваяСтрока.Услуга = ТекСтрока;
			КонецЦикла;	
			РассчитатьСуммыПересчета();
		ИначеЕсли Основание.ВидОперации =  Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоОтсутствующим Тогда 	
			ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьготПоОтсутствующим;
			МассивУслуг = Основание.СписокУслуг.ВыгрузитьКолонку("Услуга");
			Для Каждого ТекСтрока Из МассивУслуг Цикл 
				НоваяСтрока = СписокУслуг.Добавить();
				НоваяСтрока.Услуга = ТекСтрока;
			КонецЦикла;	
			
		КонецЕсли;
		
	КонецЕсли;
	
	МассивИсключений = Новый Массив;
	
	МассивИсключений.Добавить("ВозвратПоСчетчикам");
	МассивИсключений.Добавить("КорректировкаПоказанийСчетчиков");
	МассивИсключений.Добавить("ПриУстановкеСчетчика");
	МассивИсключений.Добавить("ПриСнятииСчетчика");
	
	ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ТехническаяКорректировка;
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслуги или ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчика Тогда
		
		ПроцентНеДопоставки = 100;
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(ЭтотОбъект, Отказ);
	
