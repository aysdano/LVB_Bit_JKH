		бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(Объект.Дата, Объект.Организация, СписокЛ, СписокЗданий, , , ТабЛицевыеСчета,ТабНачисления,,,,,,,,);
		
		Массив = Новый Массив;
		
		Для каждого СтрокаСбора из ТаблицаСбора Цикл
			
			Для каждого Строка из ТабЛицевыеСчета Цикл
				
				Если СтрокаСбора.Услуга = Строка.Услуга Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						СтрокаСбора.Объем = СтрокаСбора.Сумма/Строка.Тариф;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Попытка 	
				Массив.Добавить(СтрокаСбора.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		
		Для каждого СтрокаСбора из ТаблицаСбора Цикл
			
			Для каждого Строка из ТабНачисления Цикл
				
				Если СтрокаСбора.Услуга = Строка.Услуга Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						СтрокаСбора.Объем = СтрокаСбора.Сумма/Строка.Тариф;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Попытка 	
				Массив.Добавить(СтрокаСбора.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		
		Объект.СписокУслуг.Загрузить(ТаблицаСбора);

		
	ИначеЕсли Объект.ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ПереносОстатков Тогда
		
		ТаблицаСбора = Новый ТаблицаЗначений;
		ТаблицаСбора = Объект.СписокУслуг.Выгрузить();
		
		ТабЛицевыеСчета    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуНачислений();
		
		ТаблицаПроживающих = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуПроживающих();
		ТабНачисления    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
		ТабРаспределения = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуРаспредилений();
		
		СписокЛ = Объект.СписокУслуг.Выгрузить(,"ЛицевойСчет").ВыгрузитьКолонку("ЛицевойСчет");
		
		СписокЗданий = Новый Массив;
		
		Для каждого СтрокаЗ из СписокЛ Цикл
			
			СписокЗданий.Добавить(СтрокаЗ.Здание);
			
		КонецЦикла;
		
		бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(Объект.Дата, Объект.Организация, СписокЛ, СписокЗданий, , , ТабЛицевыеСчета,ТабНачисления,,,,,,,,);
		
		Массив = Новый Массив;
		
		Для каждого СтрокаСбора из ТаблицаСбора Цикл
			
			Для каждого Строка из ТабЛицевыеСчета Цикл
				
				Если СтрокаСбора.Услуга = Строка.Услуга Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						СтрокаСбора.Объем = СтрокаСбора.Сумма/Строка.Тариф;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Попытка 	
				Массив.Добавить(СтрокаСбора.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		
		Для каждого СтрокаСбора из ТаблицаСбора Цикл
			
			Для каждого Строка из ТабНачисления Цикл
				
				Если СтрокаСбора.Услуга = Строка.Услуга Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						СтрокаСбора.Объем = СтрокаСбора.Сумма/Строка.Тариф;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Попытка 	
				Массив.Добавить(СтрокаСбора.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		
		Объект.СписокУслуг.Загрузить(ТаблицаСбора);
	
	Иначе
		
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Процедура УстановитьЗаголовкиИДоступностьСубконтоНачисления(Форма, Счет, Постфикс = "", ЕстьПодразделение, ЭтоТаблица = Ложь)
	
	ПоляФормы = Новый Структура("Субконто1, Субконто2, Субконто3",
	"СписокУслугСубконто" + Постфикс + "1", 
	"СписокУслугСубконто" + Постфикс + "2", 
	"СписокУслугСубконто" + Постфикс + "3");
	
	бит_БухгалтерскийУчетКлиентСервер.ПриВыбореСчета(Счет, Форма, ПоляФормы, Неопределено, ЭтоТаблица);
	
КонецПроцедуры

&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСписокПараметров(Форма, Объект, ШаблонИмяПоляОбъекта)
	
	СписокПараметров = Новый Структура;
	
	Для Индекс = 1 По 3 Цикл
		
		ИмяПоля = СтрЗаменить(ШаблонИмяПоляОбъекта, "%Индекс%", Индекс);
		
		Если ТипЗнч(Объект[ИмяПоля]) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			СписокПараметров.Вставить("Контрагент", Объект[ИмяПоля]);
			
		ИначеЕсли ТипЗнч(Объект[ИмяПоля]) = Тип("СправочникСсылка.ДоговорыКонтрагентов") Тогда
			
			СписокПараметров.Вставить("ДоговорКонтрагента", Объект[ИмяПоля]);
			
		ИначеЕсли ТипЗнч(Объект[ИмяПоля]) = Тип("СправочникСсылка.Номенклатура") Тогда
			
			СписокПараметров.Вставить("Номенклатура", Объект[ИмяПоля]);
			
		ИначеЕсли ТипЗнч(Объект[ИмяПоля]) = Тип("СправочникСсылка.Склады") Тогда
			
			СписокПараметров.Вставить("Склад", Объект[ИмяПоля]);
			
		КонецЕсли;
		
	КонецЦикла;
	
	СписокПараметров.Вставить("ОстаткиОбороты", 1);
	СписокПараметров.Вставить("Организация"   , Форма.Объект.Организация);
	
	Возврат СписокПараметров;
	
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьСписокУслугОтбораНаСервере(Знач Дата, Знач ЛС)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&ДатаРасчета,
	|			ЛицевойСчет = &ЛицевойСчет
	|				) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Запрос.УстановитьПараметр("ДатаРасчета" ,Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет" ,ЛС);
	
	СписокУслугОтбора = Новый СписокЗначений;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СписокУслугОтбора.Добавить(Выборка.Услуга); 
		
	КонецЦикла;
	
	Возврат СписокУслугОтбора;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьСписокУслуг(Услуга, СтруктураСчетовЖКХ)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств,
	|	ЛСПоставщики.Услуга,
	|	ЛСПоставщики.ЛицевойСчет,
	|	бит_ПолучателиДенежныхСредствСрезПоследних.ДоговорКонтрагента
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|		бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|		бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик
	|	ИЗ
	|		РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|				&Момент,
	|				ЛицевойСчет = &ЛицевойСчет
	|					И Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних) КАК ЛСПоставщики
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПолучателиДенежныхСредств.СрезПоследних(&Момент, ) КАК бит_ПолучателиДенежныхСредствСрезПоследних
	|		ПО ЛСПоставщики.Поставщик = бит_ПолучателиДенежныхСредствСрезПоследних.Поставщик
	|			И ЛСПоставщики.Услуга = бит_ПолучателиДенежныхСредствСрезПоследних.Услуга";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("Услуга"     , Услуга);
	Запрос.УстановитьПараметр("Момент"     , КонецМесяца(Объект.Дата));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Отбор = Новый Структура();
		
		Отбор.Вставить("Услуга", Выборка.Услуга);
		
		Строки = Объект.СписокУслуг.НайтиСтроки(Отбор);
		
		Если ТипЗнч(Выборка.ПолучательДенежныхСредств) = Тип("СправочникСсылка.Организации") Тогда
			
			Если Строки.Количество() > 0 Тогда
				
				Строки[0].СчетАбонента = СтруктураСчетовЖКХ.СчетАбонента;
				
				СтрокаСубконта = Строки[0].СчетАбонента.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета, "ВидСубконто");
				
				Если Не СтрокаСубконта = Неопределено Тогда
					
					Строки[0]["Субконто"+СтрокаСубконта.НомерСтроки] = Объект.ЛицевойСчет;
					
				КонецЕсли;
				
				Строки[0].СчетКУ = СтруктураСчетовЖКХ.СчетСУКУ;
				
			КонецЕсли;
			
		ИначеЕсли ТипЗнч(Выборка.ПолучательДенежныхСредств) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			Если Строки.Количество() > 0 Тогда
				
				Строки[0].СчетАбонента = СтруктураСчетовЖКХ.СчетАбонента;
				
				СтрокаСубконта = Строки[0].СчетАбонента.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета, "ВидСубконто");
				
				Если Не СтрокаСубконта = Неопределено Тогда
					
					Строки[0]["Субконто"+СтрокаСубконта.НомерСтроки] = Объект.ЛицевойСчет;
					
				КонецЕсли;
				
				Строки[0].СчетКУ = СтруктураСчетовЖКХ.СчетСторПКУ;
				
				СтрокаСубконтаКУ = Строки[0].СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты, "ВидСубконто");
				
				Если Не СтрокаСубконтаКУ = Неопределено Тогда
					
					Строки[0]["СубконтоКУ"+СтрокаСубконтаКУ.НомерСтроки] = Выборка.ПолучательДенежныхСредств;
				КонецЕсли;
				СтрокаСубконтаКУ = Строки[0].СчетКУ.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Договоры, "ВидСубконто");
				
				Если Не СтрокаСубконтаКУ = Неопределено Тогда
					
					Если ЗначениеЗаполнено(Выборка.ДоговорКонтрагента)
						И Выборка.ДоговорКонтрагента.Организация = Объект.Организация Тогда  	
						Строки[0]["СубконтоКУ"+СтрокаСубконтаКУ.НомерСтроки] = Выборка.ДоговорКонтрагента;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьМассивФизЛицНаСервере()
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	
	ТаблицаЗначений.Колонки.Добавить("ФизЛицо");
	
	Для каждого Строка Из Объект.ФизЛица Цикл
		
		НоваяСтрока = ТаблицаЗначений.Добавить();
		
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
		
	КонецЦикла;
	
	МассивФизЛиц = бит_ОбщегоНазначения.ТаблицаЗначенийВМассив(ТаблицаЗначений);
	
	Возврат МассивФизЛиц;
	
КонецФункции

&НаСервере
Процедура РассчитатьОбщедомовыеРасходыНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ДокументОбъект.РачитатьОбщедомовыеРасходы();
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

// Процедура выполняет проверку был ли чек ккм сторнирован.
//
&НаСервере
Функция ПроверитьЧекНаСтроно(Чек, Отмена)
	
	Если НЕ Чек.Архивный Тогда
		
		Отмена = Истина;
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Чек не был архивирован, архивирование чеков происходит при закрытии кассовой смены.
		|Для возврата продаж заведите чек с видом операции ""Сторнирование оплаты услуг""!");
		
	Иначе
		
		Если Чек.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Продажа Тогда
			
			Запрос = Новый Запрос;
			
			Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_ЧекККМ.Ссылка
			|ИЗ
			|	Документ.бит_ЧекККМ КАК бит_ЧекККМ
			|ГДЕ
			|	бит_ЧекККМ.ЧекОснование = &ЧекОснование
			|	И бит_ЧекККМ.Архивный
			|	И бит_ЧекККМ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОперацийЧекККМ.Возврат)";
			
			Запрос.УстановитьПараметр("ЧекОснование", Чек);
			
			Выборка = Запрос.Выполнить().Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Чек был сторнирован.");
				Отмена = Истина;
				
			КонецЕсли; 
			
		ИначеЕсли Чек.ВидОперации = Перечисления.бит_ВидыОперацийЧекККМ.Возврат Тогда
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("По чеку с видом операции ""Сторнирование оплаты услуг"", не возможно произвести возврат.");
			Объект.ЧекККМ = Документы.бит_ЧекККМ.ПустаяСсылка();
			
			Отмена = Истина;
			
		Иначе
			
			Отмена = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат Отмена;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПоЧекуНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	МассивРеквизитовТабличнойЧастиСписокУслуг = Новый Массив;
	
	Для Каждого Реквизит Из Метаданные.Документы.бит_РазовыеПоУслугамЖКХ.ТабличныеЧасти.СписокУслуг.Реквизиты Цикл
		
		МассивРеквизитовТабличнойЧастиСписокУслуг.Добавить(Реквизит.Имя);
		
	КонецЦикла;
	
	ДокументОбъект.ЗаполнитьПоЧеку(МассивРеквизитовТабличнойЧастиСписокУслуг);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);	
	
КонецПроцедуры

&НаСервере
Функция ВыгрузитьКолонкуЛицевойСчетОплатаКУСписокЛСНаСервере()
	
	Возврат Объект.ОплатаКУ.СписокЛС.ВыгрузитьКолонку("ЛицевойСчет");
	
