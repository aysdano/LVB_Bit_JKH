//
&НаКлиенте
Процедура СоздатьНовыйЧек(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Касса) Тогда
		ТекстСообщения = НСтр("ru = 'Для создания чеков необходимо указать кассу.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		ТекстСообщения = НСтр("ru = 'Для создания чеков необходимо указать организацию.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли; 
	ПарметрыФормы = Новый Структура;
	ПарметрыФормы.Вставить("Касса",Объект.Касса);
	ПарметрыФормы.Вставить("Организация",Объект.Организация);
	
	Форма = ОткрытьФорму("Документ.бит_ЧекККМ.Форма.ФормаДокументаУправляемая",Новый Структура("ЗаполнитьИзДокументаЧекККМ",ПарметрыФормы),ЭтаФорма);
	
