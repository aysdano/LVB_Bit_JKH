	ПараметрыЖКХ.Вставить("ОбщедомовыеРасходыВГрафеНачисления" , Ложь);
	ПараметрыЖКХ.Вставить("СчетчикиПодкрутка"                  , Ложь);
	ПараметрыЖКХ.Вставить("ЛьготаПерсонифицированная"          , Ложь);   
	ПараметрыЖКХ.Вставить("УчитыватьПерерасчет"                , Ложь);
	ПараметрыЖКХ.Вставить("СчетАбонента"                       , Неопределено);
	ПараметрыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика" , Ложь);
	ПараметрыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика" , Ложь);
	ПараметрыЖКХ.Вставить("ФормироватьАктИРеализациюПоКонтрагентуОтветственныхЛиц", Ложь);
	ПараметрыЖКХ.Вставить("Контрагент"                             , Неопределено);
	ПараметрыЖКХ.Вставить("ФормироватьАктИРеализациюПоКонтрагенту" , Ложь);
	ПараметрыЖКХ.Вставить("УчитыватьНачисленияПоГрупповымСчетчикам", Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецМесяца(Объект.ДатаЗакрытия), Объект.Организация, ПараметрыЖКХ);
	
	ЗаполнитьЗначенияСвойств(мКэшЗначений, ПараметрыЖКХ);
	
	Запрос = Новый Запрос();
