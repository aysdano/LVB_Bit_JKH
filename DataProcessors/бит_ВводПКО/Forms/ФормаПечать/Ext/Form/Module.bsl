	Иначе
		ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].ПокупательНомер = "";
		ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].Отправляет1СSMS = Ложь;			
	КонецЕсли;
	
