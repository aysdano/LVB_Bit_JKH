//  Функция получает адрес, телефон и т.д. из контактной информации.
// Параметры:
// Объект - СправочникСсылка;.
// Тип - Перечисления.бит_ТипыКонтактнойИнформации;.
// Вид - Справочники.бит_ВидыКонтактнойИнформации;.
// Результат:
// Структура/массив структур - строка/строки из регистра сведений  бит_КонтактнаяИнформация.
Функция ПолнаяКонтактнаяИнформацияПоОбъекту(Объект,Тип = Неопределено, Вид = Неопределено) Экспорт 
	// БИТ_ЖКХ добавление кода Начало: 16.08.2012 
	Если НЕ ЗначениеЗаполнено(Объект) Тогда
		СтруктураДанных = Неопределено;
		Возврат СтруктураДанных;                        
	КонецЕсли;	
	// БИТ_ЖКХ добавление кода конец : 16.08.2012
	
	ЗапросАдрес = Новый Запрос;
	ЗапросАдрес.УстановитьПараметр("Объект", 	Объект);
	
	Если ТипЗнч(Объект) = Тип("СправочникСсылка.Организации") ИЛИ ТипЗнч(Объект) = Тип("СправочникСсылка.ФизическиеЛица") Тогда
		регистр = "РегистрСведений.КонтактнаяИнформация";
		
		// БИТ_ЖКХ Комментирование кода: 16.08.2012
		// Если Тип = Неопределено Тогда.
		//	Тип = Перечисления.ТипыКонтактнойИнформации.Адрес;.
		// КонецЕсли;.
		
		Если Вид = Неопределено Тогда              
			условие = "";
		ИначеЕсли ТипЗнч(Вид) = Тип("СправочникСсылка.ВидыКонтактнойИнформации") Тогда
			условие = "И КонтактнаяИнформация.Вид = &Вид";
		Иначе
			условие = "";
		КонецЕсли;
		
	Иначе	                             
		регистр = "РегистрСведений.бит_КонтактнаяИнформация";
		
		// БИТ_ЖКХ Комментирование кода: 16.08.2012
		// Если Тип = Неопределено Тогда.
		//	Тип = Перечисления.бит_ТипыКонтактнойИнформации.Адрес;.
		// КонецЕсли;.
		
		Если Вид = Неопределено Тогда              
			условие = "";
		ИначеЕсли ТипЗнч(Вид) = Тип("СправочникСсылка.бит_ВидыКонтактнойИнформации") Тогда
			условие = " И КонтактнаяИнформация.Вид = &Вид";
		Иначе
			условие = "";
		КонецЕсли;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Тип) Тогда
		условие = условие + " И КонтактнаяИнформация.Тип = &Тип";
	КонецЕсли;
	
	ЗапросАдрес.УстановитьПараметр("Тип", 		Тип);
	ЗапросАдрес.УстановитьПараметр("Вид", 		Вид);
	ЗапросАдрес.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Поле1 КАК Индекс,
	|	КонтактнаяИнформация.Поле2 КАК Регион,
	|	КонтактнаяИнформация.Поле3 КАК Район,
	|	КонтактнаяИнформация.Поле4 КАК Город,
	|	КонтактнаяИнформация.Поле5 КАК НасПункт,
	|	КонтактнаяИнформация.Поле6 КАК Улица,
	|	КонтактнаяИнформация.Поле7 КАК Дом,
	|	КонтактнаяИнформация.Поле8 КАК Корпус,
	|	КонтактнаяИнформация.Поле9 КАК Квартира,
	|	КонтактнаяИнформация.Поле10 КАК Страна,
	|	КонтактнаяИнформация.Комментарий,
	|	КонтактнаяИнформация.ЗначениеПоУмолчанию,
	|	КонтактнаяИнформация.ТипДома,
	|	КонтактнаяИнформация.ТипКорпуса,
	|	КонтактнаяИнформация.ТипКвартиры,
	|	КонтактнаяИнформация.ПользовательЛичногоКонтакта
	|ИЗ
	|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект" ;
	
	
	Выборка = ЗапросАдрес.Выполнить();
	Результат = Выборка.Выгрузить();
	// БИТ_ЖКХ изменения кода . Начало: 16.08.2012
	Если НЕ ЗначениеЗаполнено(Тип) Тогда
		
		СтруктураДанных = Новый Структура("Тип,Вид,Представление,
		|Поле1,Поле2,Поле3,Поле4,Поле5,Поле6,Поле7,Поле8,Поле9,Поле10,
		|Комментарий,ЗначениеПоУмолчанию,ТипДома,ТипКорпуса,ТипКвартиры,ПользовательЛичногоКонтакта");
		Если Результат.Количество()>0 Тогда
			Если Результат.Количество() = 1 Тогда
				Итог = Результат[0];
				ЗаполнитьЗначенияСвойств(СтруктураДанных,Итог);
				СтруктураДанных.Поле1 	= Итог.Индекс;
				СтруктураДанных.Поле2 	= Итог.Регион;
				СтруктураДанных.Поле3 	= Итог.Район;
				СтруктураДанных.Поле4 	= Итог.Город;
				СтруктураДанных.Поле5 	= Итог.НасПункт;
				СтруктураДанных.Поле6 	= Итог.Улица;
				СтруктураДанных.Поле7 	= Итог.Дом;
				СтруктураДанных.Поле8 	= Итог.Корпус;
				СтруктураДанных.Поле9 	= Итог.Квартира;
				СтруктураДанных.Поле10 	= Итог.Страна;
				
			Иначе
				МассивСтруктур = Новый Массив;
				Для каждого СтрокаРезультат Из Результат Цикл
					
					СтруктураДанных = Новый Структура("Тип,Вид,Представление,
					|Поле1,Поле2,Поле3,Поле4,Поле5,Поле6,Поле7,Поле8,Поле9,Поле10,
					|Комментарий,ЗначениеПоУмолчанию,ТипДома,ТипКорпуса,ТипКвартиры,ПользовательЛичногоКонтакта");
					
					ЗаполнитьЗначенияСвойств(СтруктураДанных,СтрокаРезультат);
					СтруктураДанных.Поле1 	= СтрокаРезультат.Индекс;
					СтруктураДанных.Поле2 	= СтрокаРезультат.Регион;
					СтруктураДанных.Поле3 	= СтрокаРезультат.Район;
					СтруктураДанных.Поле4 	= СтрокаРезультат.Город;
					СтруктураДанных.Поле5 	= СтрокаРезультат.НасПункт;
					СтруктураДанных.Поле6 	= СтрокаРезультат.Улица;
					СтруктураДанных.Поле7 	= СтрокаРезультат.Дом;
					СтруктураДанных.Поле8 	= СтрокаРезультат.Корпус;
					СтруктураДанных.Поле9 	= СтрокаРезультат.Квартира;
					СтруктураДанных.Поле10 	= СтрокаРезультат.Страна;
					
					МассивСтруктур.Добавить(СтруктураДанных);	
				КонецЦикла;
				
			КонецЕсли;
		КонецЕсли;		
	Иначе
		
		Если Тип = Перечисления.бит_ТипыКонтактнойИнформации.Телефон Тогда
			СтруктураДанных = Новый Структура("Тип,Вид,Представление,КодСтраны,КодГорода,
			|Телефон, Добавочный,Комментарий");
			Если Результат.Количество()>0 Тогда
				Если Результат.Количество() = 1 Тогда
					Итог = Результат[0];
					ЗаполнитьЗначенияСвойств(СтруктураДанных,Итог);
					СтруктураДанных.КодСтраны 	= Итог.Индекс;
					СтруктураДанных.КодГорода 	= Итог.Регион;
					СтруктураДанных.Телефон 	= Итог.Район;
					СтруктураДанных.Добавочный 	= Итог.Город;
				Иначе
					МассивСтруктур = Новый Массив;
					Для каждого СтрокаРезультат Из Результат Цикл
						
						СтруктураДанных = Новый Структура("Тип,Вид,Представление,КодСтраны,КодГорода,
						|Телефон, Добавочный,Комментарий");
						ЗаполнитьЗначенияСвойств(СтруктураДанных,СтрокаРезультат);
						СтруктураДанных.КодСтраны 	= СтрокаРезультат.Индекс;
						СтруктураДанных.КодГорода 	= СтрокаРезультат.Регион;
						СтруктураДанных.Телефон 	= СтрокаРезультат.Район;
						СтруктураДанных.Добавочный 	= СтрокаРезультат.Город;
						МассивСтруктур.Добавить(СтруктураДанных);	
					КонецЦикла;
				КонецЕсли;
			КонецЕсли; 
			
		ИначеЕсли Тип = Перечисления.бит_ТипыКонтактнойИнформации.АдресЭлектроннойПочты
			ИЛИ Тип = Перечисления.бит_ТипыКонтактнойИнформации.ВебСтраница
			ИЛИ Тип = Перечисления.бит_ТипыКонтактнойИнформации.Другое Тогда
			СтруктураДанных = Новый Структура("Тип,Вид,Представление,Комментарий");
			Если Результат.Количество()>0 Тогда
				Если Результат.Количество() = 1 Тогда
					Итог = Результат[0];
					ЗаполнитьЗначенияСвойств(СтруктураДанных,Итог);
				Иначе
					МассивСтруктур = Новый Массив;
					Для каждого СтрокаРезультат Из Результат Цикл
						СтруктураДанных = Новый Структура("Тип,Вид,Представление,Комментарий");
						ЗаполнитьЗначенияСвойств(СтруктураДанных,СтрокаРезультат);
						МассивСтруктур.Добавить(СтруктураДанных);	
					КонецЦикла;
				КонецЕсли;	
			КонецЕсли; 
			
		Иначе
			СтруктураДанных = Новый Структура("Тип,Вид,Представление,Индекс,Регион,
			|Район,Город,НасПункт,Улица,Дом,Корпус,Квартира,Страна,Комментарий,
			|ЗначениеПоУмолчанию,ТипДома, ТипКорпуса, ТипКвартиры, ПользовательЛичногоКонтакта");
			
			Если Результат.Количество()>0 Тогда
				Если Результат.Количество() = 1 Тогда
					Итог = Результат[0];
					ЗаполнитьЗначенияСвойств(СтруктураДанных,Итог);
