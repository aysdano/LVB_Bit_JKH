				// Расчет поргешности только для льгот распространяющихся по факту начислений
				Если ВыборкаУслуга.Распространение = Перечисления.бит_РаспространениеЛьготы.ПоФакту
					И НЕ ВыборкаУслуга.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет Тогда
					
					СтавкаЛьготы       = ?(НЕ ВыборкаУслуга.СемейнаяСтавка = 0, ВыборкаУслуга.СемейнаяСтавка, ВыборкаУслуга.ЛичнаяСтавка);
					
					СуммаДляПроверки   = НачисленоПоПрож * КоличествоПроживающих; 
					ФактДляПроверки    = ФактПоПрож      * КоличествоПроживающих;
					
					ПогрешностьНачислений = НачисленоПоУслуге - СуммаДляПроверки;
					ПогрешностьФакта      = ФактПоУслуге      - ФактДляПроверки;
					
				КонецЕсли;
				// Пересчет погрешности }Конец
				
				Выборка = ВыборкаУслуга.Выбрать();
				
				КэшФизЛицо = Неопределено;
				КэшНорма = 0;
				Пока Выборка.Следующий() Цикл //Обход Льготников
					
					ПоПлощадям = (Выборка.СпособРасчета   = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади
					ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади
					ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади);
					
					Норма         = 0;
					Начислено     = 0;
					НормаСемейная = 0;
					
					КоличествоПоНормеЛьгота = 0;
					
					Запрос.Текст = ТекстЗапросаСемейнойЛьготы;
					Запрос.УстановитьПараметр("ЛицевойСчет"              , Выборка.ЛицевойСчет);
					Запрос.УстановитьПараметр("ФизЛицо"                  , Выборка.ФизЛицо);
					Запрос.УстановитьПараметр("Льгота"                   , Выборка.Льгота);
					Запрос.УстановитьПараметр("РасчетСУчетомСоставаСемьи", Выборка.РасчетСУчетомСоставаСемьи);
					
					ВыборкаОбщ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
					
					Если ВыборкаОбщ.Следующий() Тогда
						КоличествоПоНормеЛьгота = ВыборкаОбщ.КоличествоПоНормеЛьгота;
					КонецЕсли;
					
					Если Выборка.ПравоНаЛьготы И Выборка.НачислятьПоНорме Тогда
						КоличествоПоНормеЛьгота = КоличествоПоНормеЛьгота + 1;
					КонецЕсли; 
					
					ВыборкаФизЛиц = ВыборкаОбщ.Выбрать();
					
					
					Если Выборка.Распространение = Перечисления.бит_РаспространениеЛьготы.ПоФакту Тогда
						
						Факт = Выборка.Факт;
						
						Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим 
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению Тогда
							
							Норма         = Факт/КоличествоПроживающих;
							
							Если Выборка.ФактПотребПоСЧБезУчетаВременноПрож = Истина Тогда
								КоличествоПроживающих = КоличествоПоНормеЛьгота;
							КонецЕсли;
							
							КоличествоПроживающих = ?(КоличествоПроживающих = 0,1,КоличествоПроживающих); // БИТ_ЖКХ 15.12.2016 16:42:55 
							Начислено     = Выборка.Начислено/КоличествоПроживающих;
							НормаСемейная = Норма;
							
						ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет Тогда
							
							Норма = Факт;
							
							Начислено     = Выборка.Начислено;
							НормаСемейная = Выборка.Факт;
							
						Иначе
							
							КоличествоПоНормеЛьгота = ?(КоличествоПоНормеЛьгота = 0,1,КоличествоПоНормеЛьгота);
							Норма         = Факт/КоличествоПоНормеЛьгота;
							Начислено     = Выборка.Начислено/КоличествоПоНормеЛьгота;
							НормаСемейная = Выборка.Факт/ КоличествоПоНормеЛьгота;
							
						КонецЕсли;
						
					Иначе
						
						Если КоличествоПоНормеЛьгота = 0 Тогда
							Продолжить;
						КонецЕсли; 
						
						Факт    = Выборка.Факт;
						
						Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет 
							ИЛИ ((Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению) И Выборка.ОсновнойСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет)
							Тогда
							
							Норма = Выборка.НаЛицевойСчет;
							
						Иначе
							
							Если КоличествоПоНормеЛьгота = 1 Тогда
								Норма = Выборка.НаОдного;
							ИначеЕсли КоличествоПоНормеЛьгота = 2 Тогда
								Норма = Выборка.НаДвоих;
							ИначеЕсли КоличествоПоНормеЛьгота = 3 Тогда
								Норма = Выборка.НаСемью;
							ИначеЕсли КоличествоПоНормеЛьгота = 4 Тогда
								Норма = Выборка.НаСемью4;
							ИначеЕсли КоличествоПоНормеЛьгота = 5 Тогда
								Норма = Выборка.НаСемью5;
							ИначеЕсли КоличествоПоНормеЛьгота > 5 Тогда
								Норма = Выборка.НаСемью6;
							КонецЕсли;
							
							Если Выборка.ИспользоватьДопНормуНаЛьготника Тогда
								
								Норма = Норма + Выборка.ДопНормаНаКаждого;
								
							КонецЕсли;
							
						КонецЕсли;
						
						лНорма = Норма;
						НормаСемейная = Норма;//!!!!!
						
						Если РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика
							И НЕ Выборка.Норма = 0 Тогда
							
							ОстатокЛьготы = СоответствиеОстаткаНормыЛьготника.Получить(Выборка.ФизЛицо);
							
							Если ОстатокЛьготы = Неопределено Тогда
								Норма = Мин(Норма, ФактПоУслуге);
								Если Выборка.ФизЛицо <> КэшФизЛицо Тогда
									
									КэшФизЛицо = Выборка.ФизЛицо;
									
									//Получить остаток факта
									кэшФактПоУслуге =  СоответОстатокФактаСчетчика.Получить(КэшСчетчик);
									Если кэшФактПоУслуге = Неопределено Тогда
										кэшФактПоУслуге = 0;
									КонецЕсли;
									
									//Получить остаток номы
									КэшЛьгота =  СоответОстатокНормыСчетчика.Получить(КэшСчетчик);
									Если КэшЛьгота = Неопределено Тогда
										КэшЛьгота = 0;
									КонецЕсли;
									
									//Обновление остатка по счетчику
									СоответОстатокНормыСчетчика.Вставить(КэшСчетчик, КэшЛьгота + лНорма - кэшФактПоУслуге);
									
									//Списать с остатка факта
									Если кэшФактПоУслуге - лНорма > 0 Тогда
										СоответОстатокФактаСчетчика.Вставить(КэшСчетчик, кэшФактПоУслуге - лНорма);
									Иначе
										СоответОстатокФактаСчетчика.Вставить(КэшСчетчик, 0);
									КонецЕсли;
									
									//Кэшируем доступную норму
									нстрОстатки = тз_остатки.Добавить();
									нстрОстатки.ФизЛИцо = Выборка.ФизЛИцо;
									нстрОстатки.Услуга	= Выборка.Услуга;
									нстрОстатки.Норма	= лНорма;
									
								КонецЕсли;
							Иначе
								
								Норма = Мин(Норма + ОстатокЛьготы, ФактПоУслуге);
								
								Если Выборка.ФизЛицо <> КэшФизЛицо Тогда
									
									КэшФизЛицо = Выборка.ФизЛицо;
									
									//Получить остаток факта
									кэшФактПоУслуге =  СоответОстатокФактаСчетчика.Получить(КэшСчетчик);
									Если кэшФактПоУслуге = Неопределено Тогда
										кэшФактПоУслуге = 0;
									КонецЕсли;
									
									//Получить остаток номы
									КэшЛьгота =  СоответОстатокНормыСчетчика.Получить(КэшСчетчик);
									Если КэшЛьгота = Неопределено Тогда
										КэшЛьгота = 0;
									КонецЕсли;
									
									//Обновление остатка по счетчику
									Разность = кэшФактПоУслуге - Норма;
									Если кэшФактПоУслуге <= 0 Тогда
										СоответОстатокФактаСчетчика.Вставить(КэшСчетчик, 0);
										СоответОстатокНормыСчетчика.Вставить(КэшСчетчик, КэшЛьгота - кэшФактПоУслуге);
									Иначе
										СоответОстатокФактаСчетчика.Вставить(КэшСчетчик, Разность);
										СоответОстатокНормыСчетчика.Вставить(КэшСчетчик, КэшЛьгота - Норма);
									КонецЕсли;
									
									////СоответОстатокНормыСчетчика.Вставить(КэшСчетчик, КэшЛьгота + лНорма - кэшФактПоУслуге);
									//СоответОстатокНормыСчетчика.Вставить(КэшСчетчик, КэшЛьгота - Норма);
									
									////Списать с остатка факта
									//Если кэшФактПоУслуге - лНорма > 0 Тогда
									//	СоответОстатокФактаСчетчика.Вставить(КэшСчетчик, кэшФактПоУслуге - лНорма);
									//Иначе
									//	СоответОстатокФактаСчетчика.Вставить(КэшСчетчик, 0);
									//КонецЕсли;
									
									//Кэшируем доступную норму
									нстрОстатки = тз_остатки.Добавить();
									нстрОстатки.ФизЛИцо = Выборка.ФизЛИцо;
									нстрОстатки.Услуга	= Выборка.Услуга;
									нстрОстатки.Норма	= лНорма + ОстатокЛьготы;
									
								КонецЕсли;
								
							КонецЕсли;
							
						КонецЕсли;
						
						
						//НормаСемейная = Норма;
						
						// БИТ_ЖКХ 31.05.2018 16:29:52 Начало правки... Не нужно для многотарифных 
						//Если Выборка.ИспользоватьНормуНаОдного Тогда
						//	
						//	// БИТ_ЖКХ 22.12.2011
						//	// Попртавка льгота при использовании нормы на одного не уменьшать факт до фактического потребления.
						//	Норма = ?(Выборка.НаОдного > Факт , Факт, Выборка.НаОдного);
						//	Начислено = 0;
						//	
						//КонецЕсли;
						// БИТ_ЖКХ 31.05.2018 16:29:55 Конец правки. 
						
					КонецЕсли;
					
					
					НачислитьСуммуЛьготы = Истина;
					
					Если (НЕ Выборка.НачислятьПоНорме И Выборка.Распространение = Перечисления.бит_РаспространениеЛьготы.ПоНорме) Тогда
						НачислитьСуммуЛьготы = Ложь;
					ИначеЕсли НЕ Выборка.ПроживаниеВДанныйМомент И(Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим
						ИЛИ ((Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
						ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам
						ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам
						ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных) 
						И Выборка.ОсновнойСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим)) Тогда
						
						НачислитьСуммуЛьготы = Ложь;
						
					КонецЕсли; 
					
					Если Выборка.ЛичнаяСтавка <> 0  Тогда
						
						СуммаЛичной = ОКР(?(Начислено = 0,Норма * Выборка.Ставка,Начислено) * Выборка.ЛичнаяСтавка / 100, 4, РежимОкругления.Окр15как10);
						
						// БИТ_ЖКХ_07072015++
						Если Выборка.ЛьготнаяСтавка > 0 Тогда
							СуммаЛичной = ОКР(?(Начислено = 0,Норма * Выборка.ЛьготнаяСтавка, Начислено / Выборка.Ставка* Выборка.ЛьготнаяСтавка ) * Выборка.ЛичнаяСтавка / 100, 4, РежимОкругления.Окр15как10);
						КонецЕсли;	
						// БИТ_ЖКХ_07072015--
						
						//Если НЕ Выборка.ПроживаниеВДанныйМомент И(Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим
						//	ИЛИ ((Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
						//	ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам
						//	ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам
						//	ИЛИ Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных) 
						//	И Выборка.ОсновнойСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим)) Тогда
						//Иначе
						
						НоваяСтрока = тмпТаблицаЛьгот.Добавить();
						ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
						
						НоваяСтрока.СуммаЛичной   = ?(НачислитьСуммуЛьготы,СуммаЛичной,0);
						НоваяСтрока.Приоритет     = 1;
						НоваяСтрока.ПравоНаЛьготы = Истина;
						НоваяСтрока.Норма         = ?(НачислитьСуммуЛьготы,Норма,0);
						// БИТ_ЖКХ 28.06.2013
						// #1
						//Если Выборка.Распространение = Перечисления.бит_РаспространениеЛьготы.ПоНорме Тогда
						НоваяСтрока.РасчетДолей   = ?(ПоПлощадям, Выборка.РасчетСУчетомДолейВладения, Ложь);
						//КонецЕсли;
						
						Если ПоПлощадям Тогда
							НоваяСтрока.ДоляПлощади = Выборка.ДоляПлощади;
						КонецЕсли; 
						
						НоваяСтрока.ВладелецЛьготы =  Выборка.ФизЛицо;
						
						НоваяСтрока.ПриоритетУслуги = Выборка.Услуга.Приоритет;
						
						Если  Выборка.НормативПотребленияПоКу <> 0 Тогда
							
							НоваяСтрока.Объем                   = Выборка.НормаЛьготы * Выборка.НормативПотребленияПоКу;
							НоваяСтрока.НормативПотребленияПоКу = Выборка.НормативПотребленияПоКу;
						Иначе
							НоваяСтрока.Объем = Выборка.НормаЛьготы;
							
						КонецЕсли;
						
					КонецЕсли;
					
					
					//Семейные ставки
					Если Выборка.СемейнаяСтавка <> 0  Тогда
						
						//Остаток семеной льготы
						КэшСеменыйСчетчик		= СоответствиеСчетчиков.Получить(Выборка.Услуга);
						КэшОстатокСеменойЛьготы =  СоответствиеОстатокСемейнойЛьготы.Получить(КэшСчетчик);
						Если КэшОстатокСеменойЛьготы = Неопределено Тогда
							КэшОстатокСеменойЛьготы = 0;
						КонецЕсли;
						
						Если Выборка.НормаЛьготы - Выборка.Норма > 0 Тогда
							Если КэшОстатокСеменойЛьготы = 0 Тогда
								СоответствиеОстатокСемейнойЛьготы.Вставить(КэшСеменыйСчетчик, Выборка.НормаЛьготы - Выборка.Норма);
							Иначе
								СоответствиеОстатокСемейнойЛьготы.Вставить(КэшСеменыйСчетчик, Выборка.НормаЛьготы - Выборка.Норма + КэшОстатокСеменойЛьготы);
							КонецЕсли;
						ИначеЕсли НормаСемейная = 0 И КэшОстатокСеменойЛьготы > 0 Тогда
							НормаСемейная = Мин(Выборка.Факт, КэшОстатокСеменойЛьготы)/?(Выборка.мКоличествоПоНормеЛьгота = 0, 1, Выборка.мКоличествоПоНормеЛьгота);
							КэшОстатокСеменойЛьготы = ?(КэшОстатокСеменойЛьготы - Выборка.Факт > 0 ,КэшОстатокСеменойЛьготы - Выборка.Факт, 0);
