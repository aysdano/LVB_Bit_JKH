// Обработчик события "ОбработкаЗаполнения" документа.
//
Процедура ОбработкаЗаполнения(Основание)
	
	Если ТипЗнч(Основание) = Тип("ДокументСсылка.бит_ЗаявлениеОРегистрацииПоМестуПЖ")  Тогда
		
		СуществующийДок = НайтиПодчиненнуюРегистрациюПРоживающих(Основание);
		
		Если ЗначениеЗаполнено(СуществующийДок) Тогда
			
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
			НСтр("ru='На основании документа %1 был введен %2'"),
			Основание,
			СуществующийДок);
			
			ДополнительныеСвойства.Вставить("ПовтроныйВводНаОсновании", Истина);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Возврат;
			
		КонецЕсли;
		
		// Заполним реквизиты из стандартного набора по документу основанию.
		бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокументаПоОснованию(ЭтотОбъект, Основание);
		
		Дата = Основание.Дата;
		
		
		ПараметрыДокументаОснования = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(Основание);
		ВидДокументаОснования       = Основание.Метаданные().Имя;
		
		ДокументОснование = ПараметрыДокументаОснования.Ссылка;
		
		ЛицевойСчет = ДокументОснование.ЛицевойСчет;
		
		НоваяСтрокаФизЛиц = СписокПроживающих.Добавить();
		НоваяСтрокаФизЛиц.ФизЛицо                = ДокументОснование.РегистрируемоеЛицо;
		
		СведенияИзИстори = ПолучитьСписокПроживающих(ДокументОснование.РегистрируемоеЛицо);
		
		Если НЕ СведенияИзИстори = Неопределено Тогда
			ЗаполнитьЗначенияСвойств(НоваяСтрокаФизЛиц, СведенияИзИстори);
		КонецЕсли; 
		
		НоваяСтрокаФизЛиц.ДатаРегистрации        = ?(ЗначениеЗаполнено(ДокументОснование.ДатаРегистрации)       ,ДокументОснование.ДатаРегистрации        ,НоваяСтрокаФизЛиц.ДатаРегистрации);
		НоваяСтрокаФизЛиц.ДатаСнятияСРегистрации = ?(ЗначениеЗаполнено(ДокументОснование.ДатаСнятияСРегистрации),ДокументОснование.ДатаСнятияСРегистрации ,НоваяСтрокаФизЛиц.ДатаСнятияСРегистрации );
		
		Если ЗначениеЗаполнено(ДокументОснование.ДатаСнятияСРегистрации) Тогда
			НоваяСтрокаФизЛиц.ПричинаВыписки   = Справочники.бит_ПричиныВыписки.ОкончаниеВремениРегистрации;
		КонецЕсли; 
		
		НоваяСтрокаФизЛиц.СтатусФизЛица          = ?(ЗначениеЗаполнено(НоваяСтрокаФизЛиц.СтатусФизЛица)         ,НоваяСтрокаФизЛиц.СтатусФизЛица          ,Справочники.бит_СтатусФизЛица.ВременнаяРегистрация);
		НоваяСтрокаФизЛиц.СтепеньРодства         = ?(ЗначениеЗаполнено(НоваяСтрокаФизЛиц.СтепеньРодства)        ,НоваяСтрокаФизЛиц.СтепеньРодства         ,Справочники.бит_СтепениРодстваФизЛиц.бит_НеУказано);
		НоваяСтрокаФизЛиц.СтатусПроживания       = ?(ЗначениеЗаполнено(НоваяСтрокаФизЛиц.СтатусПроживания)      ,НоваяСтрокаФизЛиц.СтатусПроживания       ,Перечисления.бит_СтатусПроживания.Временно);
		
		НоваяСтрокаФизЛиц.ОткудаПрибылАдрес      = ДокументОснование.ОткудаПрибылАдрес;
		НоваяСтрокаФизЛиц.КудаВыписанАдрес       = ДокументОснование.КудаВыписанАдрес;
		НоваяСтрокаФизЛиц.ОткудаПрибыл           = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ДокументОснование, Справочники.ВидыКонтактнойИнформации.ОткудаПрибылПредставление);
		НоваяСтрокаФизЛиц.КудаВыписан            = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ДокументОснование, Справочники.ВидыКонтактнойИнформации.КудаВыписанПредставление);
		НоваяСтрокаФизЛиц.ДатаПрибытия           = ДокументОснование.ДатаПрибытия;
		
		Если ДокументОснование.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеВСвязиСоСмертью Тогда
			
			НоваяСтрокаФизЛиц.СтатусФизЛица    = Справочники.бит_СтатусФизЛица.Выписан;
			НоваяСтрокаФизЛиц.ПричинаВыписки   = Справочники.бит_ПричиныВыписки.ПоСмертно;
			НоваяСтрокаФизЛиц.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
			
		ИначеЕсли ДокументОснование.ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета Тогда
			
			НоваяСтрокаФизЛиц.СтатусФизЛица    = Справочники.бит_СтатусФизЛица.Выписан;
			НоваяСтрокаФизЛиц.ПричинаВыписки   = Справочники.бит_ПричиныВыписки.ОкончаниеВремениРегистрации;
			
		КонецЕсли;
		
	Иначе
		
		бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаЗаполнения()

Функция ПолучитьСписокПроживающих(ФизЛицо)
	
	Запрос =  Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтепеньРодства,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаЗаписи,
	|	ОтветственныеЛицаПоКУСрезПоследних.Контрагент,
	|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
	|	ПроживающиеПоЛССрезПоследних.ДоляПлощади,
	|	ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И ФизЛицо = &ФизЛицо) КАК ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ОтветственныеЛицаПоКУСрезПоследних
	|		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет = ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет
	|			И ПроживающиеПоЛССрезПоследних.ФизЛицо = ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо
	|ГДЕ
	|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	Запрос.УстановитьПараметр("Момент"     , КонецМесяца(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо"    , ФизЛицо);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Возврат Неопределено
		
	КонецЕсли; 
	
	Возврат РезультатЗапроса.Выгрузить()[0];
	
КонецФункции

// Процедура - обработчик события "ПередЗаписью". 
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СписокЛицевыхСчетов = ""+ЛицевойСчет.Наименование;
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Результат = Документы.бит_РегистрацияПроживающихПоЛС.ОбновитьПараметрыЖКХ(Дата, ЛицевойСчет.Организация);
	
	Если НЕ Результат.НачислениеСУчетомДнейПроживания Тогда
		
		Реквизит = ПроверяемыеРеквизиты.Найти("СписокПроживающих.ДатаРегистрации");
		
		Если НЕ Реквизит = Неопределено Тогда
			ПроверяемыеРеквизиты.Удалить(Реквизит);
		КонецЕсли;
		
	КонецЕсли;  
	
	// БИТ_ЖКХ_начало_изменений_22072013
	ПроверитьДатуРегистрацииВручную = Ложь;
	
	// Удалим дату регистрации из списка проверяемых реквизитов,
	// Если  у "Статуса ФЛ" нет галочки "Проживание в данный момент".
	// И "Статус проживания" выставлен в значение "Не проживает". 
	Для Индекс = 0 по СписокПроживающих.Количество()-1 Цикл
		СтрокаСписокПроживающих = СписокПроживающих.Получить(Индекс);
		Если (НЕ СтрокаСписокПроживающих.СтатусФизЛица.ПроживаниеВДанныйМомент)
			И (СтрокаСписокПроживающих.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает) Тогда
			
			Реквизит = ПроверяемыеРеквизиты.Найти("СписокПроживающих.ДатаРегистрации");
			
			Если НЕ Реквизит = Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(Реквизит);
				ПроверитьДатуРегистрацииВручную = Истина;
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	// Обходим строки и проверяем заполнение реквизита "Дата регистрации".
	Если ПроверитьДатуРегистрацииВручную Тогда
		Для Индекс = 0 по СписокПроживающих.Количество()-1 Цикл
			СтрокаСписокПроживающих = СписокПроживающих.Получить(Индекс);
			Если Не ЗначениеЗаполнено(СтрокаСписокПроживающих.ДатаРегистрации) Тогда
				Если (НЕ СтрокаСписокПроживающих.СтатусФизЛица.ПроживаниеВДанныйМомент)
					И (СтрокаСписокПроживающих.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает) Тогда
				Иначе
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "В строке " + (Индекс + 1) + " не заполнена дата регистрации";
					Сообщение.Сообщить();
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// БИТ_ЖКХ_окончание_изменений_22072013
	
	// БИТ_ЖКХ 19.09.2014
	ПроверитьПричинуВыпискиВручную = Ложь;
	
	Для Индекс = 0 по СписокПроживающих.Количество()-1 Цикл
		СтрокаСписокПроживающих = СписокПроживающих.Получить(Индекс);
		Если НЕ ЗначениеЗаполнено(СтрокаСписокПроживающих.ДатаСнятияСРегистрации) Тогда
			
			Реквизит = ПроверяемыеРеквизиты.Найти("СписокПроживающих.ПричинаВыписки");
			
			Если НЕ Реквизит = Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(Реквизит);
				ПроверитьПричинуВыпискиВручную = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЦикла;
	
	Если ПроверитьПричинуВыпискиВручную Тогда
		Для Индекс = 0 по СписокПроживающих.Количество()-1 Цикл
			СтрокаСписокПроживающих = СписокПроживающих.Получить(Индекс);
			Если Не ЗначениеЗаполнено(СтрокаСписокПроживающих.ПричинаВыписки) Тогда
				Если НЕ ЗначениеЗаполнено(СтрокаСписокПроживающих.ДатаСнятияСРегистрации) Тогда
				Иначе
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "В строке " + (Индекс + 1) + " не заполнена причина выписки";
					Сообщение.Сообщить();
					Отказ = Истина;
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	// БИТ_ЖКХ 19.09.2014

КонецПроцедуры

Функция НайтиПодчиненнуюРегистрациюПРоживающих(Основание) Экспорт
	
	Перем ПодчиненныйДокумент;
	
	Если НЕ ЗначениеЗаполнено(Основание) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДокументОснование", Основание);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_РегистрацияПроживающихПоЛС.Ссылка КАК ПодчиненныйДокумент
	|ИЗ
	|	Документ.бит_РегистрацияПроживающихПоЛС КАК бит_РегистрацияПроживающихПоЛС
	|ГДЕ
	|	бит_РегистрацияПроживающихПоЛС.ДокументОснование = &ДокументОснование
	|	И НЕ бит_РегистрацияПроживающихПоЛС.ПометкаУдаления";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		ПодчиненныйДокумент = Выборка.ПодчиненныйДокумент;
	КонецЕсли;
	
	Возврат ПодчиненныйДокумент;
	
КонецФункции

#КонецОбласти

#КонецЕсли