&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		// Замена указаний типовых объектов на объекты БИТ в тексте модуля.
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.бит_Проживающие") Тогда
			
			Отбор = Новый Структура("ФизЛицо", ВыбранноеЗначение);
			
			СтрокаТабличнойЧасти = Объект.СписокПроживающих.НайтиСтроки(Отбор);
			
			Если СтрокаТабличнойЧасти.Количество() = 0 Тогда
				
				ДобавитьСтрокуВСписокПроживающихНаСервере(ВыбранноеЗначение);	
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИсточникВыбора.ИмяФормы = "Документ.бит_РегистрацияПроживающихПоЛС.Форма.ФормаВыбораИзСпискаПроживающих" Тогда
			
			ДобавитьФизЛицНаСервере(ВыбранноеЗначение);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

