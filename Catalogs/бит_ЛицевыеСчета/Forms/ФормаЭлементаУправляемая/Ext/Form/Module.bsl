// Процедура - обработчик события "ОкончаниеВводаТекста" поля ввода Наименование.
//
&НаКлиенте
Процедура НаименованиеОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	// БИТ_ЖКХ 23.05.2017 13:36:24 Начало правки...
	Если РазрешитьТекстЛС() Тогда
		Возврат;	
	КонецЕсли;
	// БИТ_ЖКХ 23.05.2017 13:36:24 Конец правки.
	
	Ошибка = Ложь;
	
	СписокКодовЧисел = ПолучитьСписокКодовЧиселНаСервере();	
	
	Для Значение = 1 По СтрДлина(Текст) Цикл
		Если мКэШЗначений.СписокКодовЧисел.НайтиПоЗначению(КодСимвола(Текст,Значение)) = Неопределено Тогда		
			ПоказатьПредупреждение(Новый ОписаниеОповещения("НаименованиеОкончаниеВводаТекстаЗавершение", ЭтотОбъект, Новый Структура("Текст", Текст)), "Введены некорректыне данные! Лицевой счет может содержать только цифры.");
			Возврат;
			
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	НаименованиеОкончаниеВводаТекстаФрагмент(Ошибка, Текст);
КонецПроцедуры

