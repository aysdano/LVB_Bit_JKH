&НаСервере
Функция УбитьЛишнее(ИсходнаяСтрока)
	
	ИнтересныйСимвол = Символ(160); 
	
	Результат =  СтрЗаменить(ИсходнаяСтрока,ИнтересныйСимвол,"");
	
	Результат =  СтрЗаменить(Результат," ","");
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура Запаковать7Z(ИмяФайлаSA1,ПутьКФайлуSA1,ПутьКФайлуSA17z,ИмяФайлаSL1,ПутьКФайлуSL1,ПутьКФайлуSL17z)
	
	#Если Не ВебКлиент Тогда
		
	ФайлSA1 = """"+""""+Объект.ПутьКАрхиватору7z+"\"+"7z.exe"+""""+" a -t7z """ + ПутьКФайлуSA17z+""""+" "+""""+ПутьКФайлуSA1+""""+" -mx=9"+"""";	
	
	Попытка
		КомандаСистемы(ФайлSA1);
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Архив файла " + ИмяФайлаSA1 + ".7z сохранен." ;
		Сообщение.Сообщить();
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
	КонецПопытки;
	
	ФайлSL1 = """"+""""+Объект.ПутьКАрхиватору7z+"\"+"7z.exe"+""""+" a -t7z """ + ПутьКФайлуSL17z+""""+" "+""""+ПутьКФайлуSL1+""""+" -mx=9"+"""";	
	
	Попытка
		КомандаСистемы(ФайлSL1);
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Архив файла " + ИмяФайлаSL1 + ".7z сохранен." ;
		Сообщение.Сообщить();
	Исключение
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = ОписаниеОшибки();
		Сообщение.Сообщить();
	КонецПопытки;
	
	#КонецЕсли

КонецПроцедуры

&НаСервере
Процедура сгПрочитатьФайл(МассивОшибок, ТекстФайл, Отказ)
	
	КоличествоСтрок = ТекстФайл.КоличествоСтрок();
	
	ИсправленныйТекстФайл = Новый ТекстовыйДокумент;
	
	Для Значение=1 По КоличествоСтрок Цикл
		
		Строка = ТекстФайл.ПолучитьСтроку(Значение);
		
		Если Найти(Строка,">") > 0 Тогда
			
			ИсправленнаяСтрока = Лев(Строка,Найти(Строка,">"));
			ИсправленныйТекстФайл.ДобавитьСтроку(ИсправленнаяСтрока);
			
			ОсталосьИсправить = Сред(Строка,Найти(Строка,">")+1,СтрДлина(Строка));	
			
			Пока ЗначениеЗаполнено(ОсталосьИсправить) Цикл
				
				ИсправленнаяСтрока = Лев(ОсталосьИсправить,Найти(ОсталосьИсправить,">"));
				ИсправленныйТекстФайл.ДобавитьСтроку(ИсправленнаяСтрока);
				
				ОсталосьИсправить = Сред(ОсталосьИсправить,СтрДлина(ИсправленнаяСтрока)+1,СтрДлина(ОсталосьИсправить));	
				
			КонецЦикла;	
			
		КонецЕсли;		
		
	КонецЦикла;
	
	КоличествоСтрок = ИсправленныйТекстФайл.КоличествоСтрок();
	
	Если КоличествоСтрок = 0 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл пуст!");
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ Отказ Тогда
		
		ТаблицаОплаты = Новый ТаблицаЗначений;
		ТаблицаОплаты.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
		ТаблицаОплаты.Колонки.Добавить("Услуга"     , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
		ТаблицаОплаты.Колонки.Добавить("Сумма"      , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТаблицаОплаты.Колонки.Добавить("СуммаСУчетомПроцента", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТаблицаОплаты.Колонки.Добавить("ДатаОплаты" , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
		
		ТаблицаУслуг.Очистить();
		ТаблицаВводПоказанийСчетчиков.Очистить();
		
		ТаблицаВводПоказаний =ДанныеФормыВЗначение(ТаблицаВводПоказанийСчетчиков,Тип("ТаблицаЗначений"));
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Идентификатор = &Идентификатор";
		
		Номер = 0;
		СуммаКПеречислению = 0;
		НомерРеестра = 0;
		
		Для Значение=1 По КоличествоСтрок Цикл
			
			Строка = ИсправленныйТекстФайл.ПолучитьСтроку(Значение);
			
			Если Найти(Строка,"AccountID=") > 0 Тогда
				
				НачалоЛС = Найти(Строка,"AccountID=") + 11;	
				КонецЛС = Найти(Строка,"Type=") - 2;	
				РазницаЛС = КонецЛС - НачалоЛС;
				
				ЛС = Сред(Строка,НачалоЛС,РазницаЛС);
				
				НачалоСумма = Найти(Строка,"Value=") + 7;	
				КонецСумма = Найти(Строка,"ValueP=") - 2;	
				РазницаСумма = КонецСумма - НачалоСумма;
				
				Сумма = Сред(Строка,НачалоСумма,РазницаСумма);
				
				НачалоДата = Найти(Строка,"DateTime=") + 10;	
				КонецДата = Найти(Строка,">") - 1;	
				РазницаДата = КонецДата - НачалоДата;
				
				Дата = Сред(Строка,НачалоДата,РазницаДата);
				
			Иначе
				
				Если Найти(Строка,"CounterID=") > 0 Тогда
					
					НачалоСчетчик = Найти(Строка,"CounterID=") + 11;	
					КонецСчетчик = Найти(Строка,"CounterValue=") - 2;	
					РазницаСчетчик = КонецСчетчик - НачалоСчетчик;
					
					СчетчикИзФайла = Сред(Строка,НачалоСчетчик,РазницаСчетчик);
					
					
					ЛицевойСчет = Неопределено;
					
					ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(ЛС, Истина);
					
					ЛицевойСчетИдентификатор = бит_ОбщегоНазначения.УбитьЛишнее(ЛицевойСчет.Идентификатор);
					
					Счетчик = Прав(СчетчикИзФайла,9); 
					Счетчик = Справочники.бит_Счетчики.НайтиПоКоду(Счетчик, Истина);
					
					Услуга = Лев(Прав(СчетчикИзФайла,18),9);
					
					УслугаСчетчика = Справочники.бит_УслугиЖКХ.НайтиПоКоду(Услуга, Истина);
					
					
					КолСимволов = стрдлина(строка);	
					
					НачалоТекущииеПоказания = Найти(Строка,"CounterValue=") + 13;
					
					ОтрезатьСлева = КолСимволов - НачалоТекущииеПоказания;
					
					НовСтрока = Прав(Строка,ОтрезатьСлева);	
					
					Кавычка = сг_ВспомогательныйСимвол;
					Кавычки = Найти(НовСтрока,Кавычка);
					
					ТекущииеПоказания = Лев(НовСтрока,Кавычки-1);
					
					НоваяСтрокаВводПоказаний = ТаблицаВводПоказаний.Добавить();
					
					НоваяСтрокаВводПоказаний.ЛицевойСчет = ЛицевойСчет;
					НоваяСтрокаВводПоказаний.Дата = Дата;					
					Счетчик = Справочники.бит_Счетчики.НайтиПоНаименованию(Счетчик, Истина);
					НоваяСтрокаВводПоказаний.Счетчик = Счетчик;
					НоваяСтрокаВводПоказаний.УслугаСчетчика = УслугаСчетчика;
					
					НоваяСтрокаВводПоказаний.ТекущиеПоказания = ТекущииеПоказания;
				Иначе
					
					Если Найти(Строка,"Service Number=") > 0 Тогда
						
						НачалоУслуга = Найти(Строка,"Service Number=") + 16;	
						КонецУслуга = Найти(Строка,"ValueS=") - 2;	
						РазницаУслуга = КонецУслуга - НачалоУслуга;
						
						УслугаИзФайла = Сред(Строка,НачалоУслуга,РазницаУслуга);
						
						Услуга = Неопределено;
						
						Услуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду(УслугаИзФайла, Истина);
						
						НачалоСумма = Найти(Строка,"ValueS=") + 8;
						
						Если Найти(Строка," />") > 0 Тогда
							КонецСумма = Найти(Строка,">") - 3;	
						Иначе
							КонецСумма = Найти(Строка,">") - 2;	
						КонецЕсли;	
						
						РазницаСумма = КонецСумма - НачалоСумма;
						
						СуммаИзФайла = Сред(Строка,НачалоСумма,РазницаСумма);
						
						НоваяСтрокаТаблицаУслуг = ТаблицаУслуг.Добавить();
						
						НоваяСтрокаТаблицаУслуг.ЛицевойСчет = ЛицевойСчет;
						
						НоваяСтрокаТаблицаУслуг.Услуга = Услуга;
						НоваяСтрокаТаблицаУслуг.Сумма = число(СуммаИзФайла);
						
					КонецЕсли;
					
				КонецЕсли;
				
				Продолжить;
			КонецЕсли; 
			
			НоваяСтрока = ТаблицаОплаты.Добавить();
			
			ДлиннаСтроки = СтрДлина(Строка);
			
			Пока ДлиннаСтроки > 0 Цикл
				
				ЛицевойСчет = Неопределено;
				
				ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(ЛС, Истина);
				
				Если ЛицевойСчет.Пустая() Тогда
					
					Попытка
						Идентификатор =	 Число(ЛС);
					Исключение
						Возврат;
					КонецПопытки;
					
					Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
					
					Выборка = Запрос.Выполнить().Выбрать();
					
					Если Выборка.Следующий() Тогда
						
						ЛицевойСчет = Выборка.ЛицевойСчет;
						
					КонецЕсли;
					
				КонецЕсли; 
				
				НоваяСтрока.ЛицевойСчет = ЛицевойСчет;
				
				Попытка
					НоваяСтрока.Сумма                = Число(Сумма);
					НоваяСтрока.СуммаСУчетомПроцента = Число(Сумма);
				Исключение
				КонецПопытки; 
				
				ДлиннаСтроки = 0;
				
				Попытка
					
					Дата = Дата("20"+Сред(Дата,9,2)+Сред(Дата,4,2)+Сред(Дата,0,2));
					
					
					НоваяСтрока.ДатаОплаты = Дата;
					
				Исключение
				КонецПопытки;
				
			КонецЦикла; 
			
		КонецЦикла; 
		
		ЗначениеВДанныеФормы(ТаблицаВводПоказаний,ТаблицаВводПоказанийСчетчиков);
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таблица.ЛицевойСчет,
		|	Таблица.Услуга,
		|	Таблица.Сумма,
		|	Таблица.ДатаОплаты,
		|	Таблица.СуммаСУчетомПроцента
		|ПОМЕСТИТЬ ТаблицаОплаты
		|ИЗ
		|	&Таблица КАК Таблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаОплаты.ЛицевойСчет КАК ЛицевойСчет,
		|	ТаблицаОплаты.Услуга КАК Услуга,
		|	СУММА(ТаблицаОплаты.Сумма) КАК Сумма,
		|	ТаблицаОплаты.ДатаОплаты КАК ДатаОплаты,
		|	СУММА(ТаблицаОплаты.СуммаСУчетомПроцента) КАК СуммаСУчетомПроцента
		|ИЗ
		|	ТаблицаОплаты КАК ТаблицаОплаты
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаОплаты.ЛицевойСчет,
		|	ТаблицаОплаты.Услуга,
		|	ТаблицаОплаты.ДатаОплаты
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОплаты,
		|	ЛицевойСчет,
		|	Услуга
		|ИТОГИ
		|	СУММА(Сумма),
		|	СУММА(СуммаСУчетомПроцента)
		|ПО
		|	ДатаОплаты,
		|	ЛицевойСчет";
		Запрос.УстановитьПараметр("Таблица", ТаблицаОплаты);
		
		ВыборкаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Корень = ДеревоОплаты.ПолучитьЭлементы();
		Корень.Очистить();
		
		НеУказаноДат = 0;
		
		Пока ВыборкаДата.Следующий() Цикл
			
			СтрокаДерева = Корень.Добавить();
			СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаДата.ДатаОплаты;
			СтрокаДерева.Сумма                         = ВыборкаДата.Сумма;
			
			Если НЕ ЗначениеЗаполнено(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
				НеУказаноДат = НеУказаноДат + 1;
			КонецЕсли; 
			
			ВыборкаЛС = ВыборкаДата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			ВторойУровень = СтрокаДерева.ПолучитьЭлементы();
			
			ИтогПоДокументу      = ВыборкаДата.Сумма;
			СуммаИтогПоДокументу = 0;
			
			МассивЛС = Новый Массив;
			
			НеНайденоЛС = 0;
			
			Пока ВыборкаЛС.Следующий() Цикл
				
				СтрокаВеткиДерева = ВторойУровень.Добавить();
				
				СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаЛС.ЛицевойСчет;
				СтрокаВеткиДерева.Сумма                         = ВыборкаЛС.Сумма;
				
				СтрокаВеткиДерева.СуммаСУчетомПроцента          = ВыборкаЛС.СуммаСУчетомПроцента;
				
				СтрокаДерева.СуммаСУчетомПроцента          = ВыборкаДата.СуммаСУчетомПроцента;
				
				СтруктураОплаты = НайтиДокументОплаты(ВыборкаДата.ДатаОплаты,НомерРеестра,ВыборкаЛС.ЛицевойСчет,ВыборкаЛС.Сумма);
				Если СтруктураОплаты.Свойство("Ссылка") Тогда
					СтрокаДерева.ДокументОплаты = СтруктураОплаты.Ссылка;
				КонецЕсли;
				
				СтруктураВводПоказаний = НайтиДокументВводПоказаний(ВыборкаЛС.ЛицевойСчет);
				Если СтруктураВводПоказаний.Свойство("Ссылка") Тогда
					СтрокаВеткиДерева.ВводПоказаний = СтруктураВводПоказаний.Ссылка;
				КонецЕсли;
				
				Если СтруктураОплаты.Свойство("ИсточникОплаты") Тогда
					СтрокаДерева.ИсточникОплаты = СтруктураОплаты.ИсточникОплаты;
				КонецЕсли;
				
				ИтокСуммаЛС = ВыборкаЛС.Сумма;
				ИтогПоЛС    = 0;
				
				ТретийУровень =  СтрокаВеткиДерева.ПолучитьЭлементы();
				Выборка = ВыборкаЛС.Выбрать();
				УслугВДОкументе = 0;
				
				Пока Выборка.Следующий() Цикл
					
					Если Выборка.Услуга.Пустая() И Выборка.Количество() = 1 Тогда
						
						Отбор = Новый Структура;
						Отбор.Вставить("ЛицевойСчет",СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга);
						НайденныеСтрокиУслуг = ТаблицаУслуг.НайтиСтроки(Отбор);
						
						для каждого строка из НайденныеСтрокиУслуг цикл	
							
							Если не строка.Сумма = 0 Тогда
								СтрокаВеткиДерева2 = ТретийУровень.Добавить();
								СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга = строка.Услуга;
								СтрокаВеткиДерева2.Сумма                         = строка.Сумма;
								
								СтрокаВеткиДерева2.СуммаСУчетомПроцента          = строка.Сумма;
								
								Если ЗначениеЗаполнено(СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
									ИтогПоЛС = ИтогПоЛС + строка.Сумма;
									УслугВДОкументе = УслугВДОкументе + 1;
								КонецЕсли; 
							КонецЕсли; 
							
						КонецЦикла;	
						
					Иначе
						СтрокаВеткиДерева2 = ТретийУровень.Добавить();
						СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга = Выборка.Услуга;
						СтрокаВеткиДерева2.Сумма                         = Выборка.Сумма;
						
						СтрокаВеткиДерева2.СуммаСУчетомПроцента          = Выборка.СуммаСУчетомПроцента;
						
						Если ЗначениеЗаполнено(СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
							ИтогПоЛС = ИтогПоЛС + Выборка.Сумма;
							УслугВДОкументе = УслугВДОкументе + 1;
						КонецЕсли; 
						
					КонецЕсли; 
					
				КонецЦикла;
				
				Если УслугВДОкументе = 0 Тогда
					ИтогПоЛС = ИтогПоДокументу;
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + ИтогПоЛС;
				Иначе
					НеНайденоЛС = НеНайденоЛС + 1;
				КонецЕсли; 
				
				Если ИтокСуммаЛС = ИтогПоЛС Тогда
					
					МассивЛС.Добавить(ВыборкаЛС.ЛицевойСчет.Наименование);
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			Если НЕ СуммаИтогПоДокументу = ИтогПоДокументу Тогда
				
				Разница =  ИтогПоДокументу - СуммаИтогПоДокументу;
				
				Текст = "Оплаты от " + Формат(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга, "ДФ=dd.MM.yyyy") + " сумма документа("+СуммаИтогПоДокументу+") не сходится с суммой файла(" + ИтогПоДокументу + "), разница: " + Разница + ".";
				
				ТекстЛС = "Сумма не сходится по лицевым счетам: ";
				
				Если МассивЛС.Количество() > 0 Тогда
					
					Для каждого ЭлементМассива Из МассивЛС Цикл
						
						ТекстЛС = ТекстЛС + "" + ЭлементМассива + " ";
						
					КонецЦикла; 
					
					Текст = Текст + "
					|" + ТекстЛС;
					
				КонецЕсли;
				
				Если НеНайденоЛС > 0 Тогда
					
					Текст = Текст + "
					|Не найдено лицевых счетов: " + НеНайденоЛС;
					
				КонецЕсли; 
				
				МассивОшибок.Добавить(Текст);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если НеНайденоЛС > 0 Тогда
			
			МассивОшибок.Добавить("Не указанна дата у " + НеНайденоЛС + " позиций.");
			
		КонецЕсли; 
		
		Элементы.ДеревоОплаты.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
		
		Корень = ДеревоОплаты.ПолучитьЭлементы();
		
		Если Корень.Количество() = 0 Тогда
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Таблица платежей не заполнена.");
			
			Возврат;
			
		КонецЕсли; 
		
		Если НЕ ПроверитьЗаполнение() Тогда
			
			Возврат;
			
		КонецЕсли; 
		
		СуммаИтоИтогов = 0;
		
		Для каждого СтрокаКорня Из Корень Цикл
			
			Дата = СтрокаКорня.ДатаОплаты_ЛицевойСчет_Услуга;
			
			Если НЕ ЗначениеЗаполнено(Дата) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ИтогПоДокументу      = СтрокаКорня.Сумма;
			СуммаИтогПоДокументу = 0;
			
			ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
			
			МассивЛС = Новый Массив;
			
			ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата);
			
			Для каждого СтрокаВторогоУровня Из ВторойУровень Цикл
				
				Если ЗначениеЗаполнено(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаВторогоУровня.Сумма = 0 Тогда
					
					ИтогПоЛС      = СтрокаВторогоУровня.Сумма;
					СуммаИтогПоЛС = 0;
					
					ТретийУровень = СтрокаВторогоУровня.ПолучитьЭлементы();
					
					Если ТретийУровень.Количество() = 0 Тогда
						
						СуммаИтогПоДокументу = СуммаИтогПоДокументу + СтрокаВторогоУровня.Сумма;
						
					Иначе
						
						Для каждого СтрокаТретьегоУрованя Из ТретийУровень Цикл
							
							Если ЗначениеЗаполнено(СтрокаТретьегоУрованя.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаТретьегоУрованя.Сумма = 0 Тогда
								
								СуммаИтогПоЛС = СуммаИтогПоЛС + СтрокаТретьегоУрованя.Сумма;
								
							КонецЕсли;
							
						КонецЦикла; 
						
						Если НЕ СуммаИтогПоЛС = ИтогПоЛС Тогда
							
							МассивЛС.Добавить(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга);
							
						КонецЕсли; 
						
						СуммаИтогПоДокументу = СуммаИтогПоДокументу + СуммаИтогПоЛС;
						
					КонецЕсли;
					
				КонецЕсли; 
			КонецЦикла; 
			СуммаИтоИтогов = СуммаИтоИтогов + СуммаИтогПоДокументу;
		КонецЦикла;
		
		Объект.ТекстИтогоДокумент = "Итого по дереву минус процент: "+Строка(СуммаИтоИтогов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура сгПрочитатьФайлБезРазбивкиПоУслугам(МассивОшибок, ТекстФайл, Отказ)
	
	КоличествоСтрок = ТекстФайл.КоличествоСтрок();
	
	ИсправленныйТекстФайл = Новый ТекстовыйДокумент;
	
	Для Значение=1 По КоличествоСтрок Цикл
		
		Строка = ТекстФайл.ПолучитьСтроку(Значение);
		
		Если Найти(Строка,">") > 0 Тогда
			
			ИсправленнаяСтрока = Лев(Строка,Найти(Строка,">"));
			ИсправленныйТекстФайл.ДобавитьСтроку(ИсправленнаяСтрока);
			
			ОсталосьИсправить = Сред(Строка,Найти(Строка,">")+1,СтрДлина(Строка));	
			
			Пока ЗначениеЗаполнено(ОсталосьИсправить) Цикл
				
				ИсправленнаяСтрока = Лев(ОсталосьИсправить,Найти(ОсталосьИсправить,">"));
				ИсправленныйТекстФайл.ДобавитьСтроку(ИсправленнаяСтрока);
				
				ОсталосьИсправить = Сред(ОсталосьИсправить,СтрДлина(ИсправленнаяСтрока)+1,СтрДлина(ОсталосьИсправить));	
				
			КонецЦикла;	
			
		КонецЕсли;		
		
	КонецЦикла;
	
	КоличествоСтрок = ИсправленныйТекстФайл.КоличествоСтрок();	
	Если КоличествоСтрок = 0 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл пуст!");
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ Отказ Тогда
		
		ТаблицаОплаты = Новый ТаблицаЗначений;
		ТаблицаОплаты.Колонки.Добавить("ЛицевойСчет"         , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
		ТаблицаОплаты.Колонки.Добавить("Услуга"              , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
		ТаблицаОплаты.Колонки.Добавить("Сумма"               , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТаблицаОплаты.Колонки.Добавить("СуммаСУчетомПроцента", ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
		ТаблицаОплаты.Колонки.Добавить("ДатаОплаты"          , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
		
		
		ТаблицаВводПоказанийСчетчиков.Очистить();
		
		ТаблицаВводПоказаний =ДанныеФормыВЗначение(ТаблицаВводПоказанийСчетчиков,Тип("ТаблицаЗначений"));
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Идентификатор = &Идентификатор";
		
		Номер = 0;
		СуммаКПеречислению = 0;
		НомерРеестра = 0;
		
		Для Значение=1 По КоличествоСтрок Цикл
			
			Строка = ИсправленныйТекстФайл.ПолучитьСтроку(Значение);
			
			Если Найти(Строка,"AccountID=") > 0 Тогда
				
				НачалоЛС = Найти(Строка,"AccountID=") + 11;	
				КонецЛС = Найти(Строка,"Type=") - 2;	
				РазницаЛС = КонецЛС - НачалоЛС;
				
				ЛС = Сред(Строка,НачалоЛС,РазницаЛС);
				
				НачалоСумма = Найти(Строка,"Value=") + 7;	
				КонецСумма = Найти(Строка,"ValueP=") - 2;	
				РазницаСумма = КонецСумма - НачалоСумма;
				
				Сумма = Сред(Строка,НачалоСумма,РазницаСумма);
				
				НачалоДата = Найти(Строка,"DateTime=") + 10;	
				КонецДата = Найти(Строка,">") - 1;	
				РазницаДата = КонецДата - НачалоДата;
				
				Дата = Сред(Строка,НачалоДата,РазницаДата);
				
			Иначе	
				
				Если Найти(Строка,"CounterID=") > 0 Тогда
					
					НачалоСчетчик = Найти(Строка,"CounterID=") + 11;	
					КонецСчетчик = Найти(Строка,"CounterValue=") - 2;	
					РазницаСчетчик = КонецСчетчик - НачалоСчетчик;
					
					СчетчикИзФайла = Сред(Строка,НачалоСчетчик,РазницаСчетчик);
					
					
					ЛицевойСчет = Неопределено;
					
					ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(ЛС, Истина);
					
					ЛицевойСчетИдентификатор = бит_ОбщегоНазначения.УбитьЛишнее(ЛицевойСчет.Идентификатор);
					
					Счетчик = Прав(СчетчикИзФайла,9); 
					Счетчик = Справочники.бит_Счетчики.НайтиПоКоду(Счетчик, Истина);
					
					Услуга = Лев(Прав(СчетчикИзФайла,18),9);
					
					УслугаСчетчика = Справочники.бит_УслугиЖКХ.НайтиПоКоду(Услуга, Истина);
					
					
					КолСимволов = стрдлина(строка);	
					
					НачалоТекущииеПоказания = Найти(Строка,"CounterValue=") + 13;
					
					ОтрезатьСлева = КолСимволов - НачалоТекущииеПоказания;
					
					НовСтрока = Прав(Строка,ОтрезатьСлева);	
					
					Кавычка = сг_ВспомогательныйСимвол;
					Кавычки = Найти(НовСтрока,Кавычка);
					
					ТекущииеПоказания = Лев(НовСтрока,Кавычки-1);
					
					НоваяСтрокаВводПоказаний = ТаблицаВводПоказаний.Добавить();
					
					НоваяСтрокаВводПоказаний.ЛицевойСчет = ЛицевойСчет;
					НоваяСтрокаВводПоказаний.Дата = Дата;
					Счетчик = Справочники.бит_Счетчики.НайтиПоНаименованию(Счетчик, Истина);
					НоваяСтрокаВводПоказаний.Счетчик = Счетчик;
					НоваяСтрокаВводПоказаний.УслугаСчетчика = УслугаСчетчика;
					
					НоваяСтрокаВводПоказаний.ТекущиеПоказания = ТекущииеПоказания;
					
				КонецЕсли;				
				Продолжить;
			КонецЕсли; 
			
			НоваяСтрока = ТаблицаОплаты.Добавить();
			
			ДлиннаСтроки = СтрДлина(Строка);
			
			Пока ДлиннаСтроки > 0 Цикл
				
				ЛицевойСчет = Неопределено;
				
				ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(ЛС, Истина);
				
				Если ЛицевойСчет.Пустая() Тогда
					
					Попытка
						Идентификатор =	 Число(ЛС);
					Исключение
						Возврат;
					КонецПопытки;
					
					Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
					
					Выборка = Запрос.Выполнить().Выбрать();
					
					Если Выборка.Следующий() Тогда
						
						ЛицевойСчет = Выборка.ЛицевойСчет;
						
					КонецЕсли;
					
				КонецЕсли; 
				
				НоваяСтрока.ЛицевойСчет = ЛицевойСчет;
				
				Попытка
					НоваяСтрока.Сумма                = Число(Сумма);
					НоваяСтрока.СуммаСУчетомПроцента = Число(Сумма);
				Исключение
				КонецПопытки; 
				
				ДлиннаСтроки = 0;
				
				Попытка
					
					Дата = Дата("20"+Сред(Дата,9,2)+Сред(Дата,4,2)+Сред(Дата,0,2) + стрзаменить(Сред(Дата,12,5),":",""));
					
					НоваяСтрока.ДатаОплаты = Дата;
					
				Исключение
				КонецПопытки;
				
			КонецЦикла; 
			
		КонецЦикла; 
		
		ЗначениеВДанныеФормы(ТаблицаВводПоказаний,ТаблицаВводПоказанийСчетчиков);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Таблица.ЛицевойСчет,
		|	Таблица.Услуга,
		|	Таблица.Сумма,
		|	Таблица.ДатаОплаты,
		|	Таблица.СуммаСУчетомПроцента
		|ПОМЕСТИТЬ ТаблицаОплаты
		|ИЗ
		|	&Таблица КАК Таблица
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТаблицаОплаты.ЛицевойСчет КАК ЛицевойСчет,
		|	ТаблицаОплаты.Услуга КАК Услуга,
		|	СУММА(ТаблицаОплаты.Сумма) КАК Сумма,
		|	ТаблицаОплаты.ДатаОплаты КАК ДатаОплаты,
		|	СУММА(ТаблицаОплаты.СуммаСУчетомПроцента) КАК СуммаСУчетомПроцента
		|ИЗ
		|	ТаблицаОплаты КАК ТаблицаОплаты
		|
		|СГРУППИРОВАТЬ ПО
		|	ТаблицаОплаты.ЛицевойСчет,
		|	ТаблицаОплаты.Услуга,
		|	ТаблицаОплаты.ДатаОплаты
		|
		|УПОРЯДОЧИТЬ ПО
		|	ДатаОплаты,
		|	ЛицевойСчет,
		|	Услуга
		|ИТОГИ
		|	СУММА(Сумма),
		|	СУММА(СуммаСУчетомПроцента)
		|ПО
		|	ДатаОплаты,
		|	ЛицевойСчет";
		Запрос.УстановитьПараметр("Таблица", ТаблицаОплаты);
		ВыборкаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Корень = ДеревоОплаты.ПолучитьЭлементы();
		Корень.Очистить();
		
		НеУказаноДат = 0;
		
		Пока ВыборкаДата.Следующий() Цикл
			
			СтрокаДерева = Корень.Добавить();
			СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаДата.ДатаОплаты;
			СтрокаДерева.Сумма                         = ВыборкаДата.Сумма;
			СтрокаДерева.СуммаСУчетомПроцента          = ВыборкаДата.СуммаСУчетомПроцента;
			
			Если НЕ ЗначениеЗаполнено(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
				НеУказаноДат = НеУказаноДат + 1;
			КонецЕсли; 
			
			ВыборкаЛС = ВыборкаДата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			ВторойУровень = СтрокаДерева.ПолучитьЭлементы();
			
			ИтогПоДокументу      = ВыборкаДата.СуммаСУчетомПроцента;
			СуммаИтогПоДокументу = 0;
			
			МассивЛС = Новый Массив;
			
			НеНайденоЛС = 0;
			
			Пока ВыборкаЛС.Следующий() Цикл
				
				СтрокаВеткиДерева = ВторойУровень.Добавить();
				СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаЛС.ЛицевойСчет;
				СтрокаВеткиДерева.Сумма                         = ВыборкаЛС.Сумма;
				СтрокаВеткиДерева.СуммаСУчетомПроцента          = ВыборкаЛС.СуммаСУчетомПроцента;
				
				СтруктураОплаты = НайтиДокументОплаты(ВыборкаДата.ДатаОплаты,НомерРеестра,ВыборкаЛС.ЛицевойСчет,ВыборкаЛС.Сумма);
				Если СтруктураОплаты.Свойство("Ссылка") Тогда
					СтрокаДерева.ДокументОплаты = СтруктураОплаты.Ссылка;
				КонецЕсли;
				
				СтруктураВводПоказаний = НайтиДокументВводПоказаний(ВыборкаЛС.ЛицевойСчет);
				Если СтруктураВводПоказаний.Свойство("Ссылка") Тогда
					СтрокаВеткиДерева.ВводПоказаний = СтруктураВводПоказаний.Ссылка;
				КонецЕсли;
				
				Если СтруктураОплаты.Свойство("ИсточникОплаты") Тогда
					СтрокаДерева.ИсточникОплаты = СтруктураОплаты.ИсточникОплаты;
				КонецЕсли;
				
				ИтокСуммаЛС = ВыборкаЛС.СуммаСУчетомПроцента;
				ИтогПоЛС    = 0;
				
				ТретийУровень =  СтрокаВеткиДерева.ПолучитьЭлементы();
				Выборка = ВыборкаЛС.Выбрать();
				УслугВДОкументе = 0;
				
				Пока Выборка.Следующий() Цикл
					
					Если Выборка.Услуга.Пустая() И Выборка.Количество() = 1 Тогда
						Продолжить;
					КонецЕсли; 
					
					СтрокаВеткиДерева2 = ТретийУровень.Добавить();
					СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга = Выборка.Услуга;
					СтрокаВеткиДерева2.Сумма                         = Выборка.Сумма;
					СтрокаВеткиДерева2.СуммаСУчетомПроцента          = Выборка.СуммаСУчетомПроцента;
					
					Если ЗначениеЗаполнено(СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
						ИтогПоЛС = ИтогПоЛС + Выборка.СуммаСУчетомПроцента;
						УслугВДОкументе = УслугВДОкументе + 1;
					КонецЕсли; 
					
				КонецЦикла;
				
				Если УслугВДОкументе = 0 Тогда
					ИтогПоЛС = ИтогПоДокументу;
				КонецЕсли; 
				
				Если ЗначениеЗаполнено(СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + ИтокСуммаЛС;
				Иначе
					НеНайденоЛС = НеНайденоЛС + 1;
				КонецЕсли; 
				
				Если ИтокСуммаЛС = ИтогПоЛС Тогда
					
					МассивЛС.Добавить(ВыборкаЛС.ЛицевойСчет.Наименование);
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			Если НЕ СуммаИтогПоДокументу = ИтогПоДокументу Тогда
				
				Разница =  ИтогПоДокументу - СуммаИтогПоДокументу;
				
				Текст = "Оплаты от " + Формат(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга, "ДФ=dd.MM.yyyy") + " сумма документа("+СуммаИтогПоДокументу+") не сходится с суммой файла(" + ИтогПоДокументу + "), разница: " + Разница + ".";
				
				ТекстЛС = "Сумма не сходится по лицевым счетам: ";
				
				Если МассивЛС.Количество() > 0 Тогда
					
					Для каждого ЭлементМассива Из МассивЛС Цикл
						
						ТекстЛС = ТекстЛС + "" + ЭлементМассива + " ";
						
					КонецЦикла; 
					
					Текст = Текст + "
					|" + ТекстЛС;
					
				КонецЕсли;
				
				Если НеНайденоЛС > 0 Тогда
					
					Текст = Текст + "
					|Не найдено лицевых счетов: " + НеНайденоЛС;
					
				КонецЕсли; 
				
				МассивОшибок.Добавить(Текст);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если НеНайденоЛС > 0 Тогда
			
			МассивОшибок.Добавить("Не указанна дата у " + НеНайденоЛС + " позиций.");
			
		КонецЕсли; 
		
		Элементы.ДеревоОплаты.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
		
		Корень = ДеревоОплаты.ПолучитьЭлементы();
		
		Если Корень.Количество() = 0 Тогда
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Таблица платежей не заполнена.");
			
			Возврат;
			
		КонецЕсли; 
		
		Если НЕ ПроверитьЗаполнение() Тогда
			
			Возврат;
			
		КонецЕсли; 
		
		СуммаИтоИтогов = 0;
		
		Для каждого СтрокаКорня Из Корень Цикл
			
			Дата = СтрокаКорня.ДатаОплаты_ЛицевойСчет_Услуга;
			
			Если НЕ ЗначениеЗаполнено(Дата) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ИтогПоДокументу      = СтрокаКорня.Сумма;
			СуммаИтогПоДокументу = 0;
			
			ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
			
			МассивЛС = Новый Массив;
			
			ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата);
			
			Для каждого СтрокаВторогоУровня Из ВторойУровень Цикл
				
				Если ЗначениеЗаполнено(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаВторогоУровня.Сумма = 0 Тогда
					
					ИтогПоЛС      = СтрокаВторогоУровня.Сумма;
					СуммаИтогПоЛС = 0;
					
					ТретийУровень = СтрокаВторогоУровня.ПолучитьЭлементы();
					
					Если ТретийУровень.Количество() = 0 Тогда
						
						СуммаИтогПоДокументу = СуммаИтогПоДокументу + СтрокаВторогоУровня.Сумма;
						
					Иначе
						
						Для каждого СтрокаТретьегоУрованя Из ТретийУровень Цикл
							
							Если ЗначениеЗаполнено(СтрокаТретьегоУрованя.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаТретьегоУрованя.Сумма = 0 Тогда
								
								СуммаИтогПоЛС = СуммаИтогПоЛС + СтрокаТретьегоУрованя.Сумма;
								
							КонецЕсли;
							
						КонецЦикла; 
						
						Если НЕ СуммаИтогПоЛС = ИтогПоЛС Тогда
							
							МассивЛС.Добавить(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга);
							
						КонецЕсли; 
						
						СуммаИтогПоДокументу = СуммаИтогПоДокументу + СуммаИтогПоЛС;
						
					КонецЕсли;
					
				КонецЕсли; 
			КонецЦикла; 
			СуммаИтоИтогов = СуммаИтоИтогов + СуммаИтогПоДокументу;
		КонецЦикла; 
		
		Объект.ТекстИтогоДокумент = "Итого по дереву минус процент: "+Строка(СуммаИтоИтогов);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция НайтиДокументОплаты(ДатаОплаты,НомерРеестра,ЛицевойСчет,Сумма)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	бит_ОплатаКУ.ИсточникОплаты,
	|	бит_ОплатаКУ.Ссылка
	|ИЗ
	|	Документ.бит_ОплатаКУ КАК бит_ОплатаКУ
	|ГДЕ
	|	бит_ОплатаКУ.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаОплаты, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОплаты, ДЕНЬ)
	|	И бит_ОплатаКУ.НомерРеестра = &НомерРеестра");
	Запрос.УстановитьПараметр("ДатаОплаты",ДатаОплаты);
	Запрос.УстановитьПараметр("НомерРеестра",НомерРеестра);
	Выборка = Запрос.Выполнить().Выбрать();
	Структура = Новый Структура();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Ссылка.СписокЛС.Количество() > 0 и ЗначениеЗаполнено(ЛицевойСчет) Тогда
			Если Выборка.Ссылка.СписокЛС[0].ЛицевойСчет = ЛицевойСчет и Выборка.Ссылка.СписокЛС[0].Сумма = Сумма Тогда
				Структура.Вставить("ИсточникОплаты", Выборка.ИсточникОплаты);
				Структура.Вставить("Ссылка", Выборка.Ссылка);
				Продолжить;
			Иначе
				Продолжить;
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	Возврат Структура;
КонецФункции

&НаСервере
Функция НайтиДокументВводПоказаний(ЛицевойСчет)
	
	Отбор = Новый Структура;
	Отбор.Вставить("ЛицевойСчет",ЛицевойСчет);
	НайденныеСтроки = ТаблицаВводПоказанийСчетчиков.НайтиСтроки(Отбор);
	
	Если НайденныеСтроки.Количество() > 0 Тогда
		
		ДатаВводаПоказаний = НайденныеСтроки[0].Дата;
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	бит_ВводПоказанийПоСчетчикам.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.бит_ВводПоказанийПоСчетчикам КАК бит_ВводПоказанийПоСчетчикам
		|ГДЕ
		|	бит_ВводПоказанийПоСчетчикам.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаВводаПоказаний, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаВводаПоказаний, ДЕНЬ)");
		Запрос.УстановитьПараметр("ДатаВводаПоказаний",ДатаВводаПоказаний);
		Выборка = Запрос.Выполнить().Выбрать();
		Структура = Новый Структура();
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Ссылка.ПоказанияПоСчетчикам.Количество() > 0 и ЗначениеЗаполнено(ЛицевойСчет) Тогда
				Если Выборка.Ссылка.ПоказанияПоСчетчикам[0].ЛицевойСчет = ЛицевойСчет Тогда
					Структура.Вставить("Ссылка", Выборка.Ссылка);
					Продолжить;
				Иначе
					Продолжить;
				КонецЕсли;
			Иначе
				Продолжить;
			КонецЕсли;
			
		КонецЦикла;
		Возврат Структура;
		
	Иначе
		Возврат Новый Структура;
	КонецЕсли;
	
КонецФункции

&НаСервере
Процедура сг_СоздатьОплаты(ВводПоказаний)
	
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	
	Если Корень.Количество() = 0 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Таблица платежей не заполнена.");
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Для каждого СтрокаКорня Из Корень Цикл
		
		Если СтрокаКорня.ДокументОплаты <> Документы.бит_ОплатаКУ.ПустаяСсылка() Тогда
			
			Документ = СтрокаКорня.ДокументОплаты.ПолучитьОбъект();
			бит_ОбщегоНазначения.ЗаписатьПровестиДокумент(Документ, РежимЗаписиДокумента.ОтменаПроведения,,"Ошибки");
			
			Документ.ИсточникОплаты = СтрокаКорня.ИсточникОплаты;
			
			Документ.СписокЛС.Очистить();
			Документ.СписокУслуг.Очистить();
			
			Дата = СтрокаКорня.ДатаОплаты_ЛицевойСчет_Услуга;
			
			Если НЕ ЗначениеЗаполнено(Дата) Тогда
				
				Продолжить;
				
			КонецЕсли;
			
			ИтогПоДокументу      = СтрокаКорня.Сумма;
			
			СуммаИтогПоДокументу = 0;
			
			ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
			
			МассивЛС = Новый Массив;
			
			ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата);
			
			Для каждого СтрокаВторогоУровня Из ВторойУровень Цикл
				
				
				Если ЗначениеЗаполнено(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаВторогоУровня.Сумма = 0 Тогда
					
					НоваяСтрокаЛС = Документ.СписокЛС.Добавить();
					НоваяСтрокаЛС.ЛицевойСчет     = СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга;
					НоваяСтрокаЛС.ШаблонИзвещений = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
					
