&НаСервере
Процедура ТаблицаЛСНаСервере(ВыбранноеЗначение)
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресЛСВХранилище);
	
	Если ТаблицаЛС = Неопределено Тогда
		
		// БИТ_ЖКХ 03.03.2015{{
		// Сообщить("Ошибка получения данных из временного хранилища. Выполните подбор заново.", СтатусСообщения.ОченьВажное);.
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Ошибка получения данных из временного хранилища. Выполните подбор заново.";
		Сообщение.Сообщить();
		// БИТ_ЖКХ 03.03.2015}}
		
		Возврат;
		
	КонецЕсли; 
	
	Для каждого СтрокаТаблицы Из ТаблицаЛС Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет", СтрокаТаблицы.ЛицевойСчет);
		
		СтрокиПоиска = Объект.СписокЛС.НайтиСтроки(Отбор);
		
		Отбор1 = Новый Структура;
		Отбор1.Вставить("ЛицевойСчет", СтрокаТаблицы.ЛицевойСчет);
		Отбор1.Вставить("Услуга"	 , СтрокаТаблицы.Услуга);
		
		СтрокиПоиска1 = Объект.СписокЛС.НайтиСтроки(Отбор1);
		
		
		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийВводНачальныхОстатковПоКУ.ВводИнтегральногоНачальногоСальдо") Тогда				
			
			Если СтрокиПоиска.Количество() = 0 Тогда
				
				НоваяСтрока                 = Объект.СписокЛС.Добавить();
				НоваяСтрока.ЛицевойСчет     = СтрокаТаблицы.ЛицевойСчет;
				
				НоваяСтрока.ШаблонИзвещений = ПолучитьШаблонИзвещений();
				НоваяСтрока.Адрес           = Строка(СтрокаТаблицы.ЛицевойСчет.УлицаЛицевогоСчета)+", д. "+Строка(СтрокаТаблицы.ЛицевойСчет.Здание)+?(ПустаяСтрока(СтрокаТаблицы.ЛицевойСчет.Здание.Корпус),"",", кор. "+СтрокаТаблицы.ЛицевойСчет.Здание.Корпус)+", кв. "+Строка(СтрокаТаблицы.ЛицевойСчет.Квартира);
			КонецЕсли; 	
			
		ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийВводНачальныхОстатковПоКУ.ВводДифференциальногоНачальногоСальдо") Тогда				
			
			Если СтрокиПоиска1.Количество() = 0 Тогда
				
				НоваяСтрока                 = Объект.СписокЛС.Добавить();
				НоваяСтрока.ЛицевойСчет     = СтрокаТаблицы.ЛицевойСчет;
				
				// БИТ_ЖКХ 27.02.2014			
				НоваяСтрока.Услуга     = СтрокаТаблицы.Услуга;
				// БИТ_ЖКХ 27.02.2014			
				
				НоваяСтрока.ШаблонИзвещений = ПолучитьШаблонИзвещений();
				НоваяСтрока.Адрес           = Строка(СтрокаТаблицы.ЛицевойСчет.УлицаЛицевогоСчета)+", д. "+Строка(СтрокаТаблицы.ЛицевойСчет.Здание)+?(ПустаяСтрока(СтрокаТаблицы.ЛицевойСчет.Здание.Корпус),"",", кор. "+СтрокаТаблицы.ЛицевойСчет.Здание.Корпус)+", кв. "+Строка(СтрокаТаблицы.ЛицевойСчет.Квартира);
			КонецЕсли;	
		// БИТ_ЖКХ 29.09.2016 16:17:49 Начало правки... 	
		ИначеЕсли Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийВводНачальныхОстатковПоКУ.ВводНачальныхОстатковПоПериоду") Тогда				
			
			Если СтрокиПоиска1.Количество() = 0 Тогда
				
				НоваяСтрока                 = Объект.СписокЛС.Добавить();
				НоваяСтрока.ЛицевойСчет     = СтрокаТаблицы.ЛицевойСчет;
				НоваяСтрока.Услуга			= СтрокаТаблицы.Услуга;
				НоваяСтрока.ШаблонИзвещений = ПолучитьШаблонИзвещений();
				НоваяСтрока.Адрес           = Строка(СтрокаТаблицы.ЛицевойСчет.УлицаЛицевогоСчета)+", д. "+Строка(СтрокаТаблицы.ЛицевойСчет.Здание)+?(ПустаяСтрока(СтрокаТаблицы.ЛицевойСчет.Здание.Корпус),"",", кор. "+СтрокаТаблицы.ЛицевойСчет.Здание.Корпус)+", кв. "+Строка(СтрокаТаблицы.ЛицевойСчет.Квартира);
			КонецЕсли;
		// БИТ_ЖКХ 29.09.2016 16:17:52 Конец правки. 	
			
		КонецЕсли; 
		
	КонецЦикла; 	
КонецПроцедуры	
