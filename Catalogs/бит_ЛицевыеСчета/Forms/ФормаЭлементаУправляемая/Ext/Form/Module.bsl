// Процедура - обработчик события "ПриАктивизацииСтроки".
// Выводит на форму данные о текущем счетчике.
//
&НаКлиенте
Процедура ТаблицаСчетчиковПриАктивизацииСтроки(Элемент)
	
	ТекДанные  = Элемент.ТекущиеДанные;
	
	Если НЕ ТекДанные = Неопределено Тогда
		
		ТекСчетчик = ТекДанные.Счетчик;
		
		Если НЕ ТекСчетчик = Null Тогда
			
			ТипСчетчика = ПолучитьТипСчетчикаНаСервере(ТекСчетчик);
			КоэффициентУмножения = ПолучитьКоэффициентУмноженияНаСервере(ТекСчетчик);
			
			ТипСчетчика 		= ТипСчетчика;
			Коэффициент 		= КоэффициентУмножения;
			ПоследнееПоказание 	= Элемент.ТекущиеДанные.ДоПоказаний;
			
			Если ВыбратьГрупповыеСчетчикиИзЗапросаНаСервере(ТекДанные.Услуга) = Истина Тогда
				Групповой = Истина;	
			Иначе	
				Групповой = Ложь;	
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - обработчик события "Выбор".
//
&НаКлиенте
Процедура ТаблицаСчетчиковВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	Если Поле.Имя = "ТаблицаСчетчиковНачислено" Тогда
		
		АдресТаблицыРасшифровкиСчетчиковВХранилище = ПоместитьТаблицуРасшифровкиСчетчиковВХранилище();
		
		ПараметрыФормы = Новый Структура("АдресТаблицыРасшифровкиСчетчиковВХранилище", АдресТаблицыРасшифровкиСчетчиковВХранилище);
		
		ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаРасшифровкиСтавкиУправляемая", ПараметрыФормы, Элемент);
		
	ИначеЕсли Поле.Имя = "ТаблицаСчетчиковКоличествоЕдиницПоЛС" Тогда
		
		АдресТаблицыРасшифровкиВХранилище = ПоместитьТаблицуРасшифровкиСчетчиковВХранилище();
		
		ПараметрыФормы = Новый Структура("АдресТаблицыРасшифровкиВХранилище", АдресТаблицыРасшифровкиВХранилище);
		
		ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаРасшифровкиКоличестваЕдиницУправляемая", ПараметрыФормы, Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

