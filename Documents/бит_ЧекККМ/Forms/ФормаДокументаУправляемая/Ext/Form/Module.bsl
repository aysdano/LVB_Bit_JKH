// Процедура выполняет востановление значений долга, суммы и суммыпени в таблице услуги.
//
&НаСервере
Процедура ПерезагрузитьТаблицуУслуг(Таблица)
	
	Если ТипЗнч(Таблица) = Тип("ТаблицаЗначений") Тогда
		Таблица.ЗаполнитьЗначения(0, "Сумма, СуммаПени");
	Иначе  
		МассивЗначений = Новый Массив;
		МассивЗначений.Добавить(0);
		Таблица.ЗагрузитьКолонку(МассивЗначений, "Сумма");
		Таблица.ЗагрузитьКолонку(МассивЗначений, "СуммаПени");
	КонецЕсли; 
	
	Если мТаблицаДолга.Количество() > 0 Тогда
		Для Каждого Строка Из мТаблицаДолга Цикл
			Отбор = Новый Структура;
			Отбор.Вставить("Услуга", Строка.Услуга);
			СтрокаПоиска = Таблица.НайтиСтроки(Отбор);
			
			Если НЕ СтрокаПоиска.Количество() = 0 Тогда
				СтрокаПоиска[0].Долг = Строка.Долг;
			Иначе
				НоваяСтрока = Объект.Услуги.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
			КонецЕсли; 
		КонецЦикла;
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере	
Процедура ЗаписатьНаСервере(РежимЗаписиДокумента)
	
	Попытка
		ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.бит_ЧекККМ"));
	Исключение
		ДокументОбъект = Объект.Ссылка.ПолучитьОбъект();
	КонецПопытки;
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента);	
	Исключение
	КонецПопытки;
	
	ЗначениеВДанныеФормы(ДокументОбъект,Объект);
	Модифицированность = Ложь;
	
КонецПроцедуры

&НаСервере
Функция бит_ОбработатьСобытиеСШК(Клиент, ШК)
	
	Результат = Неопределено;
	
	Если ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_ОплатаКУ") ИЛИ 
		ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_ЧекККМ") ИЛИ 
		ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_РазовыеПоУслугамЖКХ") Тогда
	Иначе
		возврат Результат;
	КонецЕсли;
	
	ДлинаШК = СтрДлина(ШК);
	
	ЧекККМ = Документы.бит_ЧекККМ.ПустаяСсылка();
	
	Если ДлинаШК > 37 Тогда
		
		СтрокаСумма = Лев(ШК,40);
		
		Если ДлинаШК > 43 Тогда
			СтрокаСумма = Сред(ШК,6,40);
		КонецЕсли; 
		
		КонтрольнаяСумма = 0;
		Для Значение = 1 по СтрДлина(СтрокаСумма)-1 Цикл
			КонтрольнаяСумма = КонтрольнаяСумма +  Число(Лев(СтрокаСумма,Значение))*33;
		КонецЦикла;
		КонтрольнаяСумма = КонтрольнаяСумма%1000;
		
		СуммаДляПроверки = Число(Прав(ШК, ДлинаШК- 40));
		Если ДлинаШК > 43 Тогда
			СуммаДляПроверки = Число(Прав(ШК, ДлинаШК- 45));
		КонецЕсли; 
		
		Если СуммаДляПроверки <> КонтрольнаяСумма тогда
			Возврат "Не правильно считан штрихкод!!!";
		КонецЕсли;
		
		РезШК = бит_РазберемШтрихКодИД(ШК);
		НаименованиеЛС	= РезШК.НаименованиеЛС;
		КодШаблона		= РезШК.КодШаблона;
		СуммаЦелых		= РезШК.СуммаЦелых;
		
	ИначеЕсли ДлинаШК = 13 Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЧекККМ.Ссылка
		|ИЗ
		|	Документ.бит_ЧекККМ КАК бит_ЧекККМ
		|ГДЕ
		|	бит_ЧекККМ.ШтрихКодФР = &ШтрихКодФР";
		Запрос.УстановитьПараметр("ШтрихКодФР", ШК);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ЧекККМ = Выборка.Ссылка;
			
		КонецЕсли; 
		
	ИначеЕсли ДлинаШК = 37 Тогда
		
		СтрокаСумма = Лев(ШК,34);
		КонтрольнаяСумма = 0;
		Для Значение = 1 по СтрДлина(СтрокаСумма)-1 Цикл
			КонтрольнаяСумма = КонтрольнаяСумма +  Число(Лев(СтрокаСумма,Значение))*33;
		КонецЦикла;
		КонтрольнаяСумма = КонтрольнаяСумма%1000;
		СуммаДляПроверки = Число(Прав(ШК, СтрДлина(ШК)-34));
		Если СуммаДляПроверки <> КонтрольнаяСумма тогда
			Возврат "Не правильно считан штрихкод!!!";
		КонецЕсли;
		
		РезШК = бит_РазберемШтрихКод(ШК);
		НаименованиеЛС	= РезШК.НаименованиеЛС;
		КодШаблона		= РезШК.КодШаблона;
		СуммаЦелых		= РезШК.СуммаЦелых;
		
	Иначе
		
		Возврат "Считанный штрих код не распознан!!!";
		
	КонецЕсли; 
	
	Если ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_ОплатаКУ") Тогда
		
		МассивСтрок = Клиент.СписокЛС.НайтиСтроки(новый Структура("ЛицевойСчет",НаименованиеЛС));
		
		Если МассивСтрок.Количество() = 0 тогда	 
			
			мСтруктураСчетовЖКХ  = бит_ОбщегоНазначения.ПолучитьСчетаРасчетовЖКХ(Клиент.Организация,КонецМесяца(Клиент.Дата));
			НоваяСтрока = Объект.СписокЛС.добавить();
			НоваяСтрока.ЛицевойСчет = НаименованиеЛС;
			НоваяСтрока.ШаблонИзвещений = КодШаблона;
			НоваяСтрока.Сумма = СуммаЦелых;
			НоваяСтрока.СчетАбонента = мСтруктураСчетовЖКХ.СчетАбонента;
			СтрокаСубконта = НоваяСтрока.СчетАбонента.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета, "ВидСубконто");
			Если Не СтрокаСубконта = Неопределено тогда
				НоваяСтрока["Субконто"+СтрокаСубконта.НомерСтроки] = НоваяСтрока.ЛицевойСчет;
			КонецЕсли;	
			НоваяСтрока.СчетКУ = мСтруктураСчетовЖКХ.ТранзитныйСчетОплаты;
			
		КонецЕсли;	 
		
		Возврат Результат;
		
	ИначеЕсли ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_ЧекККМ") Тогда
		
		Объект.ЛицевойСчет     = НаименованиеЛС;
		Объект.ШаблонИзвещений = КодШаблона;
		Объект.СуммаОплаты     = СуммаЦелых;
		Объект.ШтрихКОд        = ШК;
		
		Возврат Результат;
		
	ИначеЕсли ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_РазовыеПоУслугамЖКХ") Тогда
		
		Клиент.ЧекККМ = ЧекККМ;
		
		Возврат Результат;
		
	КонецЕсли; 
	
КонецФункции

// Функция разбора штрих кода.
//
&НаСервере
Функция бит_РазберемШтрихКодИД(ШК)
	
	Рез = Новый Структура("НаименованиеЛС, КодШаблона, СуммаЦелых");
	СтрокаСумма = Лев(ШК,40);
	
	Если СтрДлина(ШК) > 43 Тогда
		
		СтрокаСумма = Сред(ШК,6,40);
		
	КонецЕсли; 
	
	// Код шаблона извещения (9 символов).
	КодШаблона = "";

	Для Значение = 13 по 21 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		КодШаблона = КодШаблона + СимволСтроки;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ШаблоныИзвещений.Ссылка
	|ИЗ
	|	Справочник.бит_ШаблоныИзвещений КАК бит_ШаблоныИзвещений
	|ГДЕ
	|	(бит_ШаблоныИзвещений.Код = &Код
	|			ИЛИ бит_ШаблоныИзвещений.Идентификатор = &Код)";
	Запрос.УстановитьПараметр("Код",КодШаблона);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Рез.КодШаблона = Выборка.Ссылка;	
	Иначе 
		Рез.КодШаблона = Справочники.бит_ШаблоныИзвещений.ПустаяСсылка();	
	КонецЕсли;
	
	ИД = "";
	ПерваяУжеБылаНеНоль = Ложь;
	
	Для Значение = 22 По 27 Цикл
		
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		Если СимволСтроки = "0" тогда	
			Если ПерваяУжеБылаНеНоль тогда
				ИД = ИД + СимволСтроки;
				ПерваяУжеБылаНеНоль =  Истина;
			КонецЕсли;	
		иначе	 
			ИД = ИД + СимволСтроки;
			ПерваяУжеБылаНеНоль =  Истина;
		КонецЕсли;
		
	КонецЦикла; 
	
	ИД = Число(ИД);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор",ИД);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Рез.НаименованиеЛС = Выборка.Ссылка;	
	Иначе 
		Рез.НаименованиеЛС = Справочники.бит_ЛицевыеСчета.ПустаяСсылка();	
	КонецЕсли;
	
	СуммаЦелых = "";
	
	// Целая часть суммы (было 13, сделали 11 символов).

	Для Значение = 28 по 38 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		СуммаЦелых = СуммаЦелых + СимволСтроки;
	КонецЦикла;
	СуммаЦелых = СуммаЦелых + ",";
	
	// Дробная часть суммы (два знака после запятой).
	Для Значение = 39 по 40 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		СуммаЦелых = СуммаЦелых + СимволСтроки;
	КонецЦикла;
	
	Рез.СуммаЦелых = Число(СуммаЦелых);
	
	возврат Рез;
	
КонецФункции

// Разберем штрих код.
&НаСервере
Функция бит_РазберемШтрихКод(ШК)
	
	Рез = Новый Структура("НаименованиеЛС, КодШаблона, СуммаЦелых");
	СтрокаСумма = Лев(ШК,34);
	
	НаименованиеЛС = "";
	ПерваяУжеБылаНеНоль = Ложь; 
	
	СтрокаРазбора = СокрЛП(Лев(СтрокаСумма,12));
	ДлинаСтроки = СтрДлина(СтрокаРазбора);
	
	СписокЛС = Новый СписокЗначений;
	
	Для Значение = 1  По 12 Цикл
		
		ЛицевойСчет = НайтиЛС(СтрокаРазбора);
		
		Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
			
			СписокЛС.Добавить(ЛицевойСчет);
			
		КонецЕсли; 
		
		Если Лев(СтрокаРазбора, 1)="0" Тогда
			ДлинаСтроки =  ДлинаСтроки - 1;
			СтрокаРазбора = СокрЛП(Прав(СтрокаРазбора,ДлинаСтроки));
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 
	
	Если СписокЛС.Количество() > 1 Тогда
		
		ЛС = бит_РазберемШтрихКодФрагмент(СписокЛС);
		
		Рез.НаименованиеЛС = ЛС.Значение
		
	ИначеЕсли СписокЛС.Количество() > 0 Тогда 
		
		Рез.НаименованиеЛС = СписокЛС[0].Значение;
		
	КонецЕсли; 
	
	// Код шаблона извещения (9 символов).
	КодШаблона = "";

	Для Значение = 13 по 21 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		КодШаблона = КодШаблона + СимволСтроки;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ШаблоныИзвещений.Ссылка
	|ИЗ
	|	Справочник.бит_ШаблоныИзвещений КАК бит_ШаблоныИзвещений
	|ГДЕ
	|	(бит_ШаблоныИзвещений.Код = &Код
	|			ИЛИ бит_ШаблоныИзвещений.Идентификатор = &Код)";
	Запрос.УстановитьПараметр("Код",КодШаблона);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Рез.КодШаблона = Выборка.Ссылка;	
	Иначе 
		Рез.КодШаблона = Справочники.бит_ШаблоныИзвещений.ПустаяСсылка();	
	КонецЕсли;
	
	СуммаЦелых = "";
	
	// Целая часть суммы (было 13, сделали 11 символов).

	Для Значение = 22 по 32 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		СуммаЦелых = СуммаЦелых + СимволСтроки;
	КонецЦикла;
	СуммаЦелых = СуммаЦелых + ",";
	
	// Дробная часть суммы (два знака после запятой).
	Для Значение = 33 по 34 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		СуммаЦелых = СуммаЦелых + СимволСтроки;
	КонецЦикла;
	
	Рез.СуммаЦелых = Число(СуммаЦелых);
	
	возврат Рез;
	
КонецФункции

&НаСервере
Функция бит_РазберемШтрихКодФрагмент(Знач СписокЛС)
	
	Перем ЛС;
	
	ЛС = СписокЛС.ВыбратьЭлемент("Пожалуйста выберете лицевой счет.");
	Возврат ЛС;
	
КонецФункции

// Функция выполняет поиск лицевойго счета в базе.
//
&НаСервере
Функция НайтиЛС(НаименованиеЛС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование",НаименованиеЛС);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		ЛС = Выборка.Ссылка;	
	Иначе 
		ЛС = Справочники.бит_ЛицевыеСчета.ПустаяСсылка();	
	КонецЕсли;
	
	Возврат ЛС;
	
КонецФункции

&НаСервереБезКонтекста
Функция МноготарифныйНаСервере(Счетчик)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный
		|ИЗ
		|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(, Счетчик = &Счетчик) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Период УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Многотарифный;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

// Процедра управляет свойствами элементов формы.
//
&НаКлиенте
Процедура УстановитьДосутпность()

	Если Объект.ВводВручную Тогда
		Элементы.Услуги.ТолькоПросмотр       = Ложь;
		Элементы.УслугиДерево.ТолькоПросмотр = Ложь;
		Элементы.НадписьИнфоОбщ.Видимость	 = Истина;
	Иначе
		Элементы.Услуги.ТолькоПросмотр       = Истина;
		Элементы.УслугиДерево.ТолькоПросмотр = Истина;
		Элементы.НадписьИнфоОбщ.Видимость	 = Ложь;
	КонецЕсли; 	
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат") Тогда
		
		Элементы.СуммаОплаты.Доступность              = Ложь;
		Элементы.ШаблонИзвещений.Доступность          = Ложь; 
		Элементы.ЛицевойСчет.Доступность              = Ложь;
		Элементы.СчетчикиВвестиПоказания.Доступность  = Ложь;
		Элементы.СчетчикиЗаполнить.Доступность        = Ложь;
		Элементы.ОплатаБезСдачи.Доступность           = Ложь;
		Элементы.Плательщик.Доступность               = Ложь;
		
	Иначе
		
		Элементы.СуммаОплаты.Доступность              = Истина;
		Элементы.ШаблонИзвещений.Доступность          = Истина; 
		Элементы.ЛицевойСчет.Доступность              = Истина;
		Элементы.СчетчикиВвестиПоказания.Доступность  = Истина;
		Элементы.СчетчикиЗаполнить.Доступность        = Истина;
		Элементы.ОплатаБезСдачи.Доступность           = Истина;
		Элементы.Плательщик.Доступность               = Истина;
		
	КонецЕсли; 
	
	// Активировать кнопку "ручного" режима печати чека ККМ.
	Если Объект.ЧекПробитНаККМ Тогда
		Элементы.Чек.Доступность = Ложь;
	КонецЕсли;
	
	// Активировать кнопку "ручного" режима печати чека ККМ.
	Если Объект.ЧекПробитНаККМ Тогда
		ЭтаФорма.ТолькоПросмотр = Истина;
	КонецЕсли;
	
	Элементы.ОплатаБезСдачи.Доступность           = НЕ ЭтаФорма.ТолькоПросмотр;
	Элементы.СчетчикиЗаполнить.Доступность        = НЕ ЭтаФорма.ТолькоПросмотр;	
	Элементы.СчетчикиВвестиПоказания.Доступность  = НЕ ЭтаФорма.ТолькоПросмотр;
	
КонецПроцедуры

// Процедура выполняет учет введных ранее чеков по ЛС.
//
&НаСервере
Процедура УменьшитьСумму()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект,Тип("ДокументОбъект.бит_ЧекККМ"));
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияКассОбороты.Услуга,
	|	СУММА(бит_НачисленияКассОбороты.СуммаОплатыОборот) КАК СуммаОплатыОборот,
	|	СУММА(бит_НачисленияКассОбороты.СуммаПениОборот) КАК СуммаПениОборот
	|ПОМЕСТИТЬ НачисленияКасс
	|ИЗ
	|	РегистрНакопления.бит_НачисленияКасс.Обороты(
	|			&ДатаНач,
	|			&ДатаКон,
	|			Регистратор,
	|			КассаККМ = &КассаККМ
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияКассОбороты
	|ГДЕ
	|	(НЕ бит_НачисленияКассОбороты.Регистратор = &ССЫЛКА)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияКассОбороты.Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.Услуга,
	|	Услуги.Сумма,
	|	Услуги.СуммаПени,
	|	Услуги.Долг,
	|	Услуги.Сальдо,
	|	Услуги.Начислено,
	|	Услуги.Приоритет,
	|	Услуги.ЛицевойСчет,
	|	Услуги.ШаблонИзвещений,
	|	Услуги.СальдоПени,
	|	Услуги.СальдоНаНачало,
	|	Услуги.Факт,
	|	Услуги.НормаЛьготы,
	|	Услуги.КОплате,
	|	Услуги.СтавкаНДС
	|ПОМЕСТИТЬ Услуги
	|ИЗ
	|	&Услуги КАК Услуги
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Услуги.Услуга,
	|	ВЫБОР
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОперацийЧекККМ.Продажа)
	|			ТОГДА ЕСТЬNULL(Услуги.Сумма, 0)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НачисленияКасс.СуммаОплатыОборот > 0
	|					ТОГДА ЕСТЬNULL(Услуги.Сумма, 0) * -1
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК Сумма,
	|	ВЫБОР
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОперацийЧекККМ.Продажа)
	|			ТОГДА ЕСТЬNULL(Услуги.СуммаПени, 0)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА НачисленияКасс.СуммаПениОборот > 0
	|					ТОГДА ЕСТЬNULL(Услуги.СуммаПени, 0) * -1
	|				ИНАЧЕ 0
	|			КОНЕЦ
	|	КОНЕЦ КАК СуммаПени,
	|	ВЫБОР
	|		КОГДА &ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОперацийЧекККМ.Продажа)
	|			ТОГДА ЕСТЬNULL(Услуги.Долг, 0) - ЕСТЬNULL(Услуги.СуммаПени, 0) - ЕСТЬNULL(НачисленияКасс.СуммаПениОборот, 0) - ЕСТЬNULL(Услуги.Сумма, 0) - ЕСТЬNULL(НачисленияКасс.СуммаОплатыОборот, 0)
	|		ИНАЧЕ ВЫБОР
	|				КОГДА ЕСТЬNULL(НачисленияКасс.СуммаОплатыОборот, 0) > 0
	|					ТОГДА ЕСТЬNULL(Услуги.Долг, 0) + ЕСТЬNULL(Услуги.СуммаПени, 0) + ЕСТЬNULL(Услуги.Сумма, 0) - ЕСТЬNULL(НачисленияКасс.СуммаПениОборот, 0) - ЕСТЬNULL(НачисленияКасс.СуммаОплатыОборот, 0)
	|				ИНАЧЕ ЕСТЬNULL(Услуги.Долг, 0)
	|			КОНЕЦ
	|	КОНЕЦ КАК Долг,
	|	Услуги.Сальдо,
	|	Услуги.Начислено,
	|	Услуги.Приоритет,
	|	Услуги.ЛицевойСчет,
	|	Услуги.ШаблонИзвещений,
	|	Услуги.СальдоПени,
	|	Услуги.СальдоНаНачало,
	|	Услуги.Факт,
	|	Услуги.НормаЛьготы,
	|	Услуги.КОплате,
	|	Услуги.СтавкаНДС
	|ИЗ
	|	Услуги КАК Услуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ НачисленияКасс КАК НачисленияКасс
	|		ПО Услуги.Услуга = НачисленияКасс.Услуга";
	
	Запрос.УстановитьПараметр("ДатаНач"    , НачалоДня(Объект.Дата));
	Запрос.УстановитьПараметр("ДатаКон"    , КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("КассаККМ"   , Объект.Касса);
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("Услуги"     , ДокументОбъект.Услуги);
	Запрос.УстановитьПараметр("ВидОперации", Объект.ВидОперации);
	Запрос.УстановитьПараметр("Ссылка"     , Объект.Ссылка);
	
	//Если НЕ Запрос.Выполнить().Пустой() Тогда
	//	
	//	Результат = Запрос.Выполнить().Выгрузить();
	//	
	//	Объект.Услуги.Очистить();
	//	
	//	Объект.Услуги.Загрузить(Результат);
	//	
	//КонецЕсли; 
	
	Результат = Запрос.Выполнить();
	Если НЕ Результат.Пустой() Тогда
		
		Объект.Услуги.Очистить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Стр = Объект.Услуги.Добавить();
			ЗаполнитьЗначенияСвойств(Стр, Выборка);
			
			Если НЕ ЗначениеЗаполнено(Выборка.СтавкаНДС) Тогда
				ТекстСообщения = НСтр("ru='Для услуги ""%1"" отсутствует ставка НДС!'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, Строка(Выборка.Услуга));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЕсли;
			
			Если Объект.ДокументБезНДС Тогда
				Стр.СтавкаНДС = Перечисления.СтавкиНДС.БезНДС;
				Продолжить;
			КонецЕсли;
			//
			//если Стр.СтавкаНДС = Перечисления.ВидыСтавокНДС.Общая тогда
			//	Стр.СтавкаНДС = Перечисления.СтавкиНДС.НДС20; 
			//конецесли;	
			// НДС.     10.01.2019
			бит_ОбщегоНазначения.РассчитатьСуммуНДСТабЧасти(Стр, Объект.СуммаВключаетНДС);
			Стр.Сумма = Стр.Сумма + ?(Объект.СуммаВключаетНДС, 0, Стр.СуммаНДС);
			
		КонецЦикла;
		
	КонецЕсли;
	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ЗначениеРеквизитаНаСервере(Ссылка, Реквизит)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, Реквизит);	
	
КонецФункции

&НаКлиенте
Процедура ОбновитьСправочнуюИнформацию()
	
	СправочнаяИнформация	= ПолучитьСправочнуюИнформацию(Объект.ЛицевойСчет, Объект.Дата);
	Объект.Адрес			= СправочнаяИнформация.Адрес;
	Объект.КвартироСъемщик	= СправочнаяИнформация.КвартироСъемщик;
	мКэшЗначений.Адрес		= СправочнаяИнформация.Адрес;
	
КонецПроцедуры

&НаСервереБезКонтекста
// Процедура выполняет заполнения элементы формы стравочной информацией.
//
// Параметры
//
//   ЛС - СправочникСсылка.бит_ЛицевыеСчета - текущий лицевой счет.
//
Функция ПолучитьСправочнуюИнформацию(ЛС, ДатаДок)
	
	СправочнаяИнформация = Новый Структура("Адрес, Квартиросъемщик");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	Запрос.УстановитьПараметр("Дата"       , ДатаДок);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Квартира КАК Квартира,
	|	бит_СписокЗданий.ПочтовыйАдрес КАК ПочтовыйАдрес
	|ПОМЕСТИТЬ ВТ_ВсеЛС
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка = &ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
	|ПОМЕСТИТЬ ВТ_Квартиросъемщик
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Дата,
	|			СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|				И СтатусФизЛица <> ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.Выписан)
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	бит_ПроживающиеПоЛССрезПоследних.Период УБЫВ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеЛС.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ВТ_ВсеЛС.Квартира КАК Квартира,
	|	ВТ_Квартиросъемщик.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	ВТ_ВсеЛС КАК ВТ_ВсеЛС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Квартиросъемщик КАК ВТ_Квартиросъемщик
	|		ПО ВТ_ВсеЛС.ЛицевойСчет = ВТ_Квартиросъемщик.ЛицевойСчет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СправочнаяИнформация.Адрес = ?(ЗначениеЗаполнено(Выборка.ПочтовыйАдрес), Строка(Выборка.ПочтовыйАдрес) + ?(ЗначениеЗаполнено(Выборка.Квартира), ", кв." + Строка(Выборка.Квартира),""), "");
		СправочнаяИнформация.Квартиросъемщик = Строка(Выборка.ФизЛицо);
	Иначе
		СправочнаяИнформация.Адрес = "";
		СправочнаяИнформация.Квартиросъемщик = "";
	КонецЕсли; 
	
	Возврат СправочнаяИнформация;
	
КонецФункции

#КонецОбласти