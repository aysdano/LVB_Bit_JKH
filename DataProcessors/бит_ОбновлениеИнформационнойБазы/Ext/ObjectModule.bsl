  если ПредопределенныйОбъект.Наименование = "Справочник ""Виды счетчиков""" тогда 
   ПредопределенныйОбъект.Наименование = "Виды счетчиков";
  конецесли; 

  если ПредопределенныйОбъект.Наименование = "Справочник ""ЛицевыеСчета""" тогда 
   ПредопределенныйОбъект.Наименование = "Лицевые счета";
