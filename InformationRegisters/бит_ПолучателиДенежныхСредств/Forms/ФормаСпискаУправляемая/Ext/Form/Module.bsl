&НаСервере
// БИТ_ЖКХ 12.02.2014
// Функция ПолучитьЭтоГруппаПолучателяДенежныхСредств(Знач ПолучательДенежныхСредств).
Функция ПолучитьЭтоГруппаПолучателяДенежныхСредств(ПолучательДенежныхСредств)
	
	Возврат ПолучательДенежныхСредств.ЭтоГруппа;
	
КонецФункции

&НаСервере
Функция ПолучитьСписокПоставщикиНаСервере(Услуга)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка", Услуга);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_УслугиЖКХПоставщики.Поставщик
	|ИЗ
	|	Справочник.бит_УслугиЖКХ.Поставщики КАК бит_УслугиЖКХПоставщики
	|ГДЕ
	|	бит_УслугиЖКХПоставщики.Ссылка = &Ссылка";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокПоставщики = Новый СписокЗначений;
	
	СписокПоставщики.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Поставщик"));
	
	Возврат СписокПоставщики;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТаблицуСписок()
	// БИТ_ЖКХ 25.03.2014
	Попытка 	
		
		Если ОтборПоУслуге Тогда
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	бит_ПолучателиДенежныхСредств.Период,
			|	бит_ПолучателиДенежныхСредств.Услуга,
			|	бит_ПолучателиДенежныхСредств.Поставщик,
			|	бит_ПолучателиДенежныхСредств.ПолучательДенежныхСредств,
			|	бит_ПолучателиДенежныхСредств.ДоговорКонтрагента,
			|	0 КАК НомерКартинки
			|ИЗ
			|	РегистрСведений.бит_ПолучателиДенежныхСредств КАК бит_ПолучателиДенежныхСредств
			|ГДЕ
			|	бит_ПолучателиДенежныхСредств.Услуга = &Услуга");
			
			
			Запрос.УстановитьПараметр("Услуга",мКэшЗначений.мУслугаОтбор);
			
		Иначе
			
			Запрос = Новый Запрос(
			"ВЫБРАТЬ
			|	бит_ПолучателиДенежныхСредств.Период,
			|	бит_ПолучателиДенежныхСредств.Услуга,
			|	бит_ПолучателиДенежныхСредств.Поставщик,
			|	бит_ПолучателиДенежныхСредств.ПолучательДенежныхСредств,
			|	бит_ПолучателиДенежныхСредств.ДоговорКонтрагента,
			|	0 КАК НомерКартинки
			|ИЗ
			|	РегистрСведений.бит_ПолучателиДенежныхСредств КАК бит_ПолучателиДенежныхСредств");
			
		КонецЕсли;
		
	Исключение
		
		Запрос = Новый Запрос(
		"ВЫБРАТЬ
		|	бит_ПолучателиДенежныхСредств.Период,
		|	бит_ПолучателиДенежныхСредств.Услуга,
		|	бит_ПолучателиДенежныхСредств.Поставщик,
		|	бит_ПолучателиДенежныхСредств.ПолучательДенежныхСредств,
		|	бит_ПолучателиДенежныхСредств.ДоговорКонтрагента,
		|	0 КАК НомерКартинки
		|ИЗ
		|	РегистрСведений.бит_ПолучателиДенежныхСредств КАК бит_ПолучателиДенежныхСредств");
		
		мКэшЗначений.Ошибка = Истина;
		
		
	КонецПопытки;
	
	
	Список.Загрузить(Запрос.Выполнить().Выгрузить());
	// БИТ_ЖКХ 25.03.2014
КонецПроцедуры

&НаСервере
Процедура ДобавитьЗаписьНаСервере(Знач Период, Знач Услуга, Знач Поставщик, Знач ПолучательДенежныхСредств, Знач ДоговорКонтрагента)
	
	МенеджерЗаписи = РегистрыСведений.бит_ПолучателиДенежныхСредств.СоздатьМенеджерЗаписи();
	
	МенеджерЗаписи.Период                    = Период;
	МенеджерЗаписи.Услуга                    = Услуга;
	МенеджерЗаписи.Поставщик                 = Поставщик;
	МенеджерЗаписи.ПолучательДенежныхСредств = ПолучательДенежныхСредств;
	МенеджерЗаписи.ДоговорКонтрагента        = ДоговорКонтрагента;
	
	МенеджерЗаписи.Записать();
	
КонецПроцедуры

&НаСервере
Процедура УдалитьЗаписьНаСервере(Знач Период, Знач Услуга, Знач Поставщик)
	
	НаборЗаписей = РегистрыСведений.бит_ПолучателиДенежныхСредств.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.Период.Установить(Период);
	НаборЗаписей.Отбор.Услуга.Установить(Услуга);
	НаборЗаписей.Отбор.Поставщик.Установить(Поставщик);
	
	НаборЗаписей.Записать();
	
КонецПроцедуры

#КонецОбласти