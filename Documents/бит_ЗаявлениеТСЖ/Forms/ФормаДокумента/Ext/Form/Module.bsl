&НаКлиенте
Процедура ПодборПоЛС(Команда)
	
	Отбор = Новый Структура;
	Отбор.Вставить("Здание", ПолучитьСписокЗданийВТСЖ(Объект.Дата, Объект.ТСЖ, Объект.Организация));
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("МножественныйВыбор", Истина); 
	ПараметрыФормы.Вставить("Отбор"             , Отбор);
	
	ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая", ПараметрыФормы, ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая" Тогда
		
		ЗаполнитьСписокПоЛС(ВыбранноеЗначение);
		
	КонецЕсли; 
	
КонецПроцедуры 

&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьСписокПоЛС(ВыбранноеЗначение)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		
		Для каждого ЭлементМассива Из ВыбранноеЗначение Цикл
			
			СписокВладельцев = ПолучитьСписокВладельцев(Объект.Дата, ЭлементМассива, Объект.ТСЖ, Объект.ВидОперации);
			
			Для каждого ЭлементСписка Из СписокВладельцев Цикл
				
				Проживающий = ЭлементСписка.Значение;
				
				Отбор = Новый Структура;
				Отбор.Вставить("ЛицевойСчет", ЭлементМассива);
				Отбор.Вставить("Проживающий", Проживающий);
				
				Поиск = Объект.СписокЧленовТСЖ.НайтиСтроки(Отбор);
				
				Если Поиск.Количество() = 0 Тогда
					
					НоваяСтрока = Объект.СписокЧленовТСЖ.Добавить();
					НоваяСтрока.ЛицевойСчет = ЭлементМассива; 
					НоваяСтрока.Проживающий = Проживающий;
					
					Если Объект.ВидОперации = Перечисления.бит_ВидыОперацииЗаявлениеТСЖ.ВыходИзТСЖ Тогда
						ЗаполнитьИнформациюОЧленеТСЖвСтроке(НоваяСтрока.ПолучитьИдентификатор(), Проживающий);
					Иначе
						НоваяСтрока.ДатаВступления = Объект.Дата;
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
КонецПроцедуры // ()

&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьИнформациюОЧленеТСЖвСтроке(Идентификатор, Проживающий)
	
	ТекущаяСтрока = Объект.СписокЧленовТСЖ.НайтиПоИдентификатору(Идентификатор);
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ИнформацияОЧленеТСЖ = ПолучитьИнформациюОЧленеТСЖ(Объект.Дата, Объект.ТСЖ,
	ТекущаяСтрока.ЛицевойСчет, Проживающий); 
	
	Если ИнформацияОЧленеТСЖ.ДатаВступления = Дата("00010101") Тогда
		
		СтандартнаяОбработка = Ложь;
		ТекстСообщения = НСтр("ru = 'Проживающий не является членом ТСЖ.'");
		ТекстСообщения = бит_ОбщегоНазначенияКлиентСервер.ПолучитьТекстСообщения("ПОЛЕ", "КОРРЕКТНОСТЬ", НСтр("ru = 'Проживающий'"),,,ТекстСообщения);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, , "СписокЧленовТСЖПроживающие");
		
		Возврат;
		
	КонецЕсли; 
	
	ТекущаяСтрока.ДатаВступления = ИнформацияОЧленеТСЖ.ДатаВступления;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.ДатаВыхода) Тогда
		
		Если НЕ ЗначениеЗаполнено(ИнформацияОЧленеТСЖ.ДатаВыхода) Тогда
			ТекущаяСтрока.ДатаВыхода = ?(ТекущаяСтрока.ДатаВступления < ТекущаяДата(),ТекущаяДата(), ТекущаяСтрока.ДатаВступления);;
		Иначе
			ТекущаяСтрока.ДатаВыхода = ИнформацияОЧленеТСЖ.ДатаВыхода;
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры // () 

#КонецОбласти