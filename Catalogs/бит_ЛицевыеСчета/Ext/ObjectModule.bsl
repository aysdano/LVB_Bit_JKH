	ТаблицаСЧШапка           = Макет.ПолучитьОбласть("ТаблицаСЧШапка");
	
	Середина                 = Макет.ПолучитьОбласть("Середина");
	
	ИнфШапка                 = Макет.ПолучитьОбласть("ИнфШапка");
	
	ИнфОПлатежеПустаяСтрока  = Макет.ПолучитьОбласть("ИнфОПлатежеПустаяСтрока");
	ИнфОПлатежеПодвал        = Макет.ПолучитьОбласть("ИнфОПлатежеПодвал");
	
