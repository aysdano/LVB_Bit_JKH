			ПлатежныйДокумент = ПолучитьИЗаполнитьПКОНаСервере(ЭтоПоступлениеНаРасчетныйСчет, СтрокаТЧ, Оплата, ДокументЗаписан
			,СтрокаТЧ.РазбиватьПоЛицевымСчетам, ТранзитныйСчетОплаты, ПрименениеУСН
			,СуммаПринимаемых, СтрокаТЧ.БанковскийСчет, СтрокаТЧ.ИсточникОплаты);
			
			
			Если ДокументЗаписан Тогда
				
				Если СтрокаТЧ.СоздаватьСчета Тогда
					
					СчетДокумент = ПолучитьИЗаполнитьСчетНаСервере(ПлатежныйДокумент,СтрокаЛС, Оплата, СчетЗаписан
					,СтрокаТЧ.РазбиватьПоЛицевымСчетам, ТранзитныйСчетОплаты, ПрименениеУСН
					,СуммаПринимаемых, СтрокаТЧ.БанковскийСчет, СтрокаТЧ.ИсточникОплаты);
					
					Если СчетЗаписан Тогда
						
						//08.08.2019
						ПерезаполнитьРасшифровкуПоступленияПоСчету(ПлатежныйДокумент, СчетДокумент);
						
						ВторойУровень = ПервыйУровень.Строки.Добавить();
						
						ВторойУровень.Выбор                    = Истина;
						ВторойУровень.ПриходныйКассовыйОредер  = СчетДокумент.Ссылка;
						ВторойУровень.Сумма                    = СчетДокумент.СуммаДокумента;
						ВторойУровень.Этоновый                 = СчетДокумент.ЭтоНовый();
						ВторойУровень.СчетУчета                = Объект.СчетКасса;
						ВторойУровень.СтатьяДвиженийДенСредств = Объект.СтатьяДвиженияДенежныхСредств;
						
						ТретийУровень = ВторойУровень.Строки.Добавить();
						
						ТретийУровень.Выбор                    = Истина;
						ТретийУровень.ПриходныйКассовыйОредер  = ПлатежныйДокумент.Ссылка;
						ТретийУровень.Сумма                    = ПлатежныйДокумент.СуммаДокумента;
						ТретийУровень.Этоновый                 = ПлатежныйДокумент.ЭтоНовый();
						ТретийУровень.СчетУчета                = Объект.СчетКасса;
						ТретийУровень.СтатьяДвиженийДенСредств = Объект.СтатьяДвиженияДенежныхСредств;
						
					КонецЕсли;
					
				Иначе
					
					ВторойУровень = ПервыйУровень.Строки.Добавить();
					
					ВторойУровень.Выбор                    = Истина;
					ВторойУровень.ПриходныйКассовыйОредер  = ПлатежныйДокумент.Ссылка;
					ВторойУровень.Сумма                    = ПлатежныйДокумент.СуммаДокумента;
					ВторойУровень.Этоновый                 = ПлатежныйДокумент.ЭтоНовый();
					ВторойУровень.СчетУчета                = Объект.СчетКасса;
					ВторойУровень.СтатьяДвиженийДенСредств = Объект.СтатьяДвиженияДенежныхСредств;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЕсли;
		
		ПервыйУровень.Сумма = ПервыйУровень.Строки.Итог("Сумма");
		
		Если ПервыйУровень.Строки.Количество()= 0 Тогда
			
			ДеревоПКОМ.Строки.Удалить(ПервыйУровень);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоПКОМ, "ДеревоПКО");
	
	ПровестиДеревоПКОНаСервере(ПрименениеУСН, СуммаПринимаемых);
	
КонецПроцедуры

функция СвернутьПоЛицевымСчетам(табИсходная)

  табЛC = табИсходная.Скопировать();
  табЛC.Свернуть("ЛицевойСчет");
  списокЛС = табЛC.ВыгрузитьКолонку("ЛицевойСчет");
  
  для каждого стр из списокЛС цикл
	  
	строкиЛС = табИсходная.Найти(стр, "ЛицевойСчет");  
	
	для каждого стрЛС из табИсходная цикл
	  если стрЛС.ЛицевойСчет = стр тогда 	
		стрЛС.ПлательщикБИК = строкиЛС.ПлательщикБИК; 
		стрЛС.ПлательщикИНН = строкиЛС.ПлательщикИНН;
		стрЛС.ПлательщикКПП = строкиЛС.ПлательщикКПП;
		стрЛС.ПлательщикСчет = строкиЛС.ПлательщикСчет;
		стрЛС.НомерДок = строкиЛС.НомерДок;		
	  конецесли;		
	конеццикла;	
	
  конеццикла;	  
  
  возврат табИсходная;
конецфункции	
	
//08.08.2019
Процедура ПерезаполнитьРасшифровкуПоступленияПоСчету(ПлатежныйДокумент, СчетДокумент)
	
   СтруктураКурсаДокумента = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СчетДокумент.ВалютаДокумента, СчетДокумент.Дата);
   КурсДокумента           = СтруктураКурсаДокумента.Курс;
   КратностьДокумента      = СтруктураКурсаДокумента.Кратность;
   Если НЕ ЗначениеЗаполнено(КурсДокумента) Тогда
	КурсДокумента       = 1;
	КратностьДокумента  = 1;
   КонецЕсли;
		
   ВалютаВзаиморасчетов = СчетДокумент.ДоговорКонтрагента.ВалютаВзаиморасчетов;
   СтруктураКурсаВзаиморасчетов = РаботаСКурсамиВалют.ПолучитьКурсВалюты(ВалютаВзаиморасчетов, СчетДокумент.Дата);
	
   ПлатежныйДокумент.РасшифровкаПлатежа.Очистить();
   ВалютаВзаиморасчетов = СчетДокумент.ДоговорКонтрагента.ВалютаВзаиморасчетов;	
   ВалютаРегламентированногоУчета = ОбщегоНазначенияБПВызовСервераПовтИсп.ПолучитьВалютуРегламентированногоУчета();

   ТаблицаПлатежей = ПлатежныйДокумент.РасшифровкаПлатежа.Выгрузить();
	
   ТаблицаСуммДокументаОснования = СтатусыДокументов.ТаблицаСуммКОплатеВРазрезеСтавокНДС(
				Новый Структура("Основание, ДатаОснования, Организация", СчетДокумент.Ссылка, СчетДокумент.Дата, СчетДокумент.Организация),
					УчетНДСПереопределяемый.ПолучитьСуммуДокументаСНДСВРазрезеСтавокНДС(СчетДокумент.Ссылка));
   ТаблицаСуммДокументаОснования.Колонки.Сумма.Имя = "СуммаПлатежа";
	
   ОбщегоНазначенияБПВызовСервера.ЗагрузитьВТаблицуЗначений(ТаблицаСуммДокументаОснования, ТаблицаПлатежей);
   Если ТаблицаПлатежей.Количество() = 0 Тогда
		ТаблицаПлатежей.Добавить();
   КонецЕсли;
   ТаблицаПлатежей.ЗаполнитьЗначения(ПлатежныйДокумент.ДоговорКонтрагента,                     "ДоговорКонтрагента");
   ТаблицаПлатежей.ЗаполнитьЗначения(СтруктураКурсаВзаиморасчетов.Курс,      "КурсВзаиморасчетов");
   ТаблицаПлатежей.ЗаполнитьЗначения(Перечисления.СпособыПогашенияЗадолженности.Автоматически, "СпособПогашенияЗадолженности");
   ТаблицаПлатежей.ЗаполнитьЗначения(СчетДокумент, "Сделка");
   // БИТ ЖКХ 20.01.2020   
   Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ПлатежныйДокумент, "СтатьяДвиженияДенежныхСредств") = истина тогда
    ТаблицаПлатежей.ЗаполнитьЗначения(ПлатежныйДокумент.СтатьяДвиженияДенежныхСредств, "СтатьяДвиженияДенежныхСредств");
   конецесли;
		
   ТаблицаПлатежей.ЗагрузитьКолонку(ТаблицаПлатежей.ВыгрузитьКолонку("СуммаПлатежа"), "СуммаВзаиморасчетов");  
 
		
   Для каждого СтрокаПлатеж Из ТаблицаПлатежей Цикл
		ПроверкаКурсовВалют(СтрокаПлатеж, СчетДокумент.КурсВзаиморасчетов, СчетДокумент.КратностьВзаиморасчетов);
		Если СчетДокумент.ДоговорКонтрагента.РасчетыВУсловныхЕдиницах Тогда
			Если СчетДокумент.ВалютаДокумента = ВалютаРегламентированногоУчета Тогда
				СтрокаПлатеж.СуммаВзаиморасчетов = РаботаСКурсамиВалютКлиентСервер.ПересчитатьИзВалютыВВалюту(
					СтрокаПлатеж.СуммаПлатежа,
					ВалютаРегламентированногоУчета, СчетДокумент.ВалютаВзаиморасчетов,
					1, СчетДокумент.КурсВзаиморасчетов,
					1, СчетДокумент.КратностьВзаиморасчетов);
				СтрокаПлатеж.СуммаНДС            = РаботаСКурсамиВалютКлиентСервер.ПересчитатьИзВалютыВВалюту(
					СтрокаПлатеж.СуммаНДС,
					ВалютаРегламентированногоУчета, СчетДокумент.ВалютаДокумента,
					1, СчетДокумент.КурсВзаиморасчетов,
					1, СчетДокумент.КратностьВзаиморасчетов);
			КонецЕсли;
			
			СтрокаПлатеж.СуммаПлатежа = РаботаСКурсамиВалютКлиентСервер.ПересчитатьИзВалютыВВалюту(
				СтрокаПлатеж.СуммаВзаиморасчетов,
				СчетДокумент.ВалютаДокумента, ВалютаРегламентированногоУчета,
				СтрокаПлатеж.КурсВзаиморасчетов, 1,
				СтрокаПлатеж.КратностьВзаиморасчетов, 1);
			СтрокаПлатеж.СуммаНДС = РаботаСКурсамиВалютКлиентСервер.ПересчитатьИзВалютыВВалюту(
				СтрокаПлатеж.СуммаНДС,
				СчетДокумент.ВалютаДокумента, ВалютаРегламентированногоУчета,
				СтрокаПлатеж.КурсВзаиморасчетов, 1,
				СтрокаПлатеж.КратностьВзаиморасчетов, 1);
		КонецЕсли;
   КонецЦикла;
	
   ТаблицаПлатежей.ЗаполнитьЗначения(СчетДокумент.Ссылка, "СчетНаОплату");			
   ПлатежныйДокумент.РасшифровкаПлатежа.Загрузить(ТаблицаПлатежей);
	
   об = ПлатежныйДокумент.Ссылка.ПолучитьОбъект();
   об.РасшифровкаПлатежа.Загрузить(ТаблицаПлатежей);	
   //21.08.2019
   если ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") тогда   
    для каждого стр из об.РасшифровкаПлатежа цикл
	 стр.СтатьяДвиженияДенежныхСредств = ПлатежныйДокумент.СтатьяДвиженияДенежныхСредств;    
    конеццикла;
   конецесли;

   об.СуммаДокумента = об.РасшифровкаПлатежа.Итог("СуммаПлатежа");
   //21.08.2019
   если ТипЗнч(ПлатежныйДокумент) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") тогда
    об.СтатьяДвиженияДенежныхСредств = ПлатежныйДокумент.СтатьяДвиженияДенежныхСредств; 
   конецесли;	
   СчетаУчетаВДокументах.ЗаполнитьПередОтображениемПользователю(об);

   об.Записать();
  
КонецПроцедуры
// Процедура заполняет дерево документов введеных на основании.
//
&НаКлиенте
Процедура Сформировать(Знач Оповещение)
	
	ЭтаФорма.ОбновитьОтображениеДанных();
	
	мСписокИсключений.Очистить();
	
	Текст = "";
	
	Если Объект.ОплатыКУ.Количество() = 0 Тогда
		
		ВыполнитьОбработкуОповещения(Оповещение);
		Возврат;	
		
	КонецЕсли; 
	
	Текст = "Не заполнены реквизиты: ";
	
	Если НЕ ЗначениеЗаполнено(Объект.СчетКасса) 
		И НЕ ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		
		Текст = Текст + """Счет учета"" ";
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		
		Текст = Текст +"""Вид операции"" ";
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств)
		И НЕ ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		
		Текст = Текст +"""Статья движения ден. средств"" ";
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ВидОплаты)
		И ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		
		Текст = Текст +"""Вид оплаты"" ";
		
	КонецЕсли;
	
	Текст = Текст + ". Продолжить?";
	
	Если (НЕ ЗначениеЗаполнено(Объект.СчетКасса) И НЕ ЭтоПоступлениеНаРасчетныйСчет = 2)
		ИЛИ (НЕ ЗначениеЗаполнено(Объект.СтатьяДвиженияДенежныхСредств) И НЕ ЭтоПоступлениеНаРасчетныйСчет = 2) 
		ИЛИ (НЕ ЗначениеЗаполнено(Объект.ВидОплаты) И ЭтоПоступлениеНаРасчетныйСчет = 2)
		ИЛИ НЕ ЗначениеЗаполнено(Объект.ВидОперации) Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СформироватьЗавершение", ЭтотОбъект, Новый Структура("Оповещение", Оповещение)), Текст, РежимДиалогаВопрос.ДаНет);
        Возврат; 
		
	КонецЕсли; 
	
	СформироватьФрагмент(Оповещение);
КонецПроцедуры

&НаКлиенте
Процедура СформироватьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Оповещение = ДополнительныеПараметры.Оповещение;
    
    Ответ = РезультатВопроса;
    
    Если Ответ = КодВозвратаДиалога.Нет Тогда
        
        ВыполнитьОбработкуОповещения(Оповещение);
        Возврат;
        
    КонецЕсли; 
    
    СформироватьФрагмент(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура СформироватьФрагмент(Знач Оповещение)
    
    Перем ИдентификаторСтроки, КоллекцияЭлементовДерева, Строка;
    
    СформироватьДеревоПКОНаСервере();
    
    КоллекцияЭлементовДерева=ДеревоПКО.ПолучитьЭлементы();
    // Развернуть дерево. 
    Для Каждого Строка Из КоллекцияЭлементовДерева Цикл    
        ИдентификаторСтроки=Строка.ПолучитьИдентификатор();
        Элементы.ДеревоПКО.Развернуть(ИдентификаторСтроки);
    КонецЦикла;   
    
    ВыполнитьОбработкуОповещения(Оповещение);

КонецПроцедуры
// Процедура выполняет проверку на дублирование документов ПКО. 
//

&НаСервере
Процедура ПроверитьПовторныйВводДокумента(Отказ, Оплата)
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
		
		ВидДокумента           	= "ПоступлениеНаРасчетныйСчет";
		ВидДокументаНаПроверку	= "ПриходныйКассовыйОрдер";
		ВидДокументаНаПроверку2 = "ОплатаПлатежнойКартой";
		
	ИначеЕсли ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		ВидДокумента           	= "ОплатаПлатежнойКартой";
		ВидДокументаНаПроверку	= "ПриходныйКассовыйОрдер";
		ВидДокументаНаПроверку2 = "ПоступлениеНаРасчетныйСчет";
		
	Иначе
		ВидДокумента          	= "ПриходныйКассовыйОрдер";
		ВидДокументаНаПроверку	= "ПоступлениеНаРасчетныйСчет";
		ВидДокументаНаПроверку2 = "ОплатаПлатежнойКартой"; // БИТ_ЖКХ 22.08.2016 15:22:08 	
		
	КонецЕсли;
	
	
	Отказ = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	СчетНаОплатуПокупателю.Ссылка КАК Ссылка
		|ИЗ
		|	Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		|ГДЕ
		|	СчетНаОплатуПокупателю.бит_ДокументОснование = &Основание";
	
	Запрос.УстановитьПараметр("Основание", Оплата);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	МассивОснование = Новый Массив();
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
	МассивОснование.Добавить(ВыборкаДетальныеЗаписи.Ссылка);	
	КонецЦикла;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Документ.Ссылка
	|ИЗ
	|	Документ."+ВидДокумента+" КАК Документ
	|ГДЕ
	|	(Документ.ДокументОснование В(&МассивОснование)
	|	ИЛИ Документ.ДокументОснование = &Основание)
	|	И НЕ Документ.Ссылка В (&СписокИскл)
	|	И НЕ Документ.ПометкаУдаления
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка
	|ИЗ
	|	Документ."+ВидДокументаНаПроверку+" КАК Документ
	|ГДЕ
	|	Документ.ДокументОснование В(&МассивОснование)
	|	ИЛИ Документ.ДокументОснование = &Основание
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	Документ.Ссылка
	|ИЗ
	|	Документ."+ВидДокументаНаПроверку2+" КАК Документ
	|ГДЕ
	|	Документ.ДокументОснование В(&МассивОснование)
	|	ИЛИ Документ.ДокументОснование = &Основание";
		
	Запрос.УстановитьПараметр("МассивОснование", МассивОснование);
	Запрос.УстановитьПараметр("Основание", Оплата);
	Запрос.УстановитьПараметр("СписокИскл", мСписокИсключений);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Отказ = Истина;
		
	КонецЕсли; 
	
	
КонецПроцедуры

// Процедура выполняет проверку на дублирование документов ПКО. 
