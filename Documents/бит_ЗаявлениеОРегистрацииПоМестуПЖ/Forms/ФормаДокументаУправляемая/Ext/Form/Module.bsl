					СтрокаФизЛицо = "" + ВыборкаСН.Проживающий
					+?(ЗначениеЗаполнено(ВыборкаСН.ПроживающийДатаРождения), " " + Формат(ВыборкаСН.ПроживающийДатаРождения, "ДФ=dd.MM.yyyy") + " г.р. ", "") 
					+?(ЗначениеЗаполнено(МестоРождения), " Место рождения:" + ПолучитьАдресБезПодписей(МестоРождения) + "", "");
					
					ФизЛицо_1 = "";
					ФизЛицо_2 = "";
					
					бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаФизЛицо,ДлиннаСтрокиПФ ,ФизЛицо_1, ФизЛицо_2);
					
					ЗаявлениеОСнятии.Параметры.ФизЛицо1 = ФизЛицо_1;
					ЗаявлениеОСнятии.Параметры.Физлицо2 = ФизЛицо_2;
					
					Если ЗначениеЗаполнено(ВыборкаСН.ВидДокумента) Тогда
						
						ЗаявлениеОСнятии.Параметры.ВидДокумента_1 =  ВыборкаСН.ВидДокумента;
						ЗаявлениеОСнятии.Параметры.СерияДокумента =  ВыборкаСН.СерияДокумента;
						ЗаявлениеОСнятии.Параметры.НомерДокумента =  ВыборкаСН.НомерДокумента;
						ЗаявлениеОСнятии.Параметры.ВыданДокумент_1 =  ВыборкаСН.ВыданДокумент;
						
						ЗаявлениеОСнятии.Параметры.ДокументКодПодразделения = ВыборкаСН.ДокументКодПодразделения;
						
						ЗаявлениеОСнятии.Параметры.ДатаВыдачиДокумента  = Формат(ВыборкаСН.ДатаВыдачиДокумента,"ДФ='дд'");
						ДатаМесяц 									    = Формат(ВыборкаСН.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
						ЗаявлениеОСнятии.Параметры.МесяцВыдачиДокумента = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
						ЗаявлениеОСнятии.Параметры.ГодВыдачиДокумента   = Формат(ВыборкаСН.ДатаВыдачиДокумента,"ДФ='yyyy'");	
						
					КонецЕсли;	
					//ВыборкаСН.Проживающий
					Если ЗначениеЗаполнено(ВыборкаСН.ЗаконныйПредставитель) И (ПроверитьВозраст(Объект.РегистрируемоеЛицо) ИЛИ Объект.ЗаконныйПредставительВСвязиСНедееспособностью)  Тогда
						
						ЗаконныйПредставительСтрока = "" +?(ЗначениеЗаполнено(ВыборкаСН.СтепеньРодстваЗаконногоПредставителя), " " + ВыборкаСН.СтепеньРодстваЗаконногоПредставителя + " ", "")
						+ ВыборкаСН.ЗаконныйПредставитель 
						+?(ЗначениеЗаполнено(ВыборкаСН.ЗаконныйПредставитель.ДатаРождения),  " " + Формат(ВыборкаСН.ЗаконныйПредставитель.ДатаРождения,"ДФ=dd.MM.yyyy" )+ " г.р.", "")
						+?(ЗначениеЗаполнено(ВыборкаСН.ЗПДВид), ", " + ВыборкаСН.ЗПДВид, "")
						+?(ЗначениеЗаполнено(ВыборкаСН.ЗПДСерия), ", сер." + ВыборкаСН.ЗПДСерия, "")
						+?(ЗначениеЗаполнено(ВыборкаСН.ЗПДНомер), ", № " + ВыборкаСН.ЗПДНомер, "")
						+?(ЗначениеЗаполнено(ВыборкаСН.ЗПДДатаВыдачи), ", выдан: " + Формат(ВыборкаСН.ЗПДДатаВыдачи, "ДФ=dd.MM.yyyy"), "")
						+?(ЗначениеЗаполнено(ВыборкаСН.ЗПДВыдан), " " + ВыборкаСН.ЗПДВыдан, "")
						+?(ЗначениеЗаполнено(ВыборкаСН.ЗПДКодПодразделения), ", код: " + ВыборкаСН.ЗПДКодПодразделения, "");	
						
						ЗаконныйПредставительСтрока= СокрЛП(ЗаконныйПредставительСтрока);
						
						бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ЗаконныйПредставительСтрока, ДлиннаСтрокиПФ, ЗаконныйПредставитель1,ЗаконныйПредставитель2);
						
						ЗаявлениеОСнятии.Параметры.ЗаконныйПредставитель_1 =  ЗаконныйПредставитель1;
						ЗаявлениеОСнятии.Параметры.ЗаконныйПредставитель_2 =  ЗаконныйПредставитель2;
						
					КонецЕсли;		
					
					АдресРегистрации_1 = "";
					АдресРегистрации_2 = "";
					
					АдресРегистрацииСтр = "";
					
					Если ВыборкаСН.КудаВыписанИЗЛС ТОгда 
						
						АдресРегистрацииСтр = ВыборкаСН.КудаВыбыл;
						
						бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресРегистрацииСтр, 45, АдресРегистрации_1, АдресРегистрации_2);
						ЗаявлениеОСнятии.Параметры.АдресРегистрации_1 = АдресРегистрации_1;
						ЗаявлениеОСнятии.Параметры.АдресРегистрации_2 = АдресРегистрации_2;
						
					КонецЕсли;
				
					АдресПрибытия_1 = "";
					АдресПрибытия_2 = "";
					
					Если ВыборкаСН.ОткудаПрибылИЗЛС Тогда
						СтрокаАдресПриб = ВыборкаСН.ОткудаПрибыл;
						
						Если ВыборкаСН.ВременнаяРегистрация Тогда
						
						СтрокаАдресПриб = "" + СтрокаАдресПриб
						+?(ЗначениеЗаполнено(ВыборкаСН.ДатаРегистрации), " с " + Формат(ВыборкаСН.ДатаРегистрации, "ДФ=dd.MM.yyyy"), "")
						+?(ЗначениеЗаполнено(ВыборкаСН.ДатаСнятияСРегистрации), " по " + Формат(ВыборкаСН.ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy"), "");
						КонецЕсли;
					Иначе
						СтрокаАдресПриб = АдрПрибГрупп +?(ЗначениеЗаполнено(ВыборкаСН.ДатаРегистрации), " с " + Формат(ВыборкаСН.ДатаРегистрации, "ДФ=dd.MM.yyyy"), "")
						+?(ЗначениеЗаполнено(ВыборкаСН.ДатаСнятияСРегистрации), " по " + Формат(ВыборкаСН.ДатаСнятияСРегистрации, "ДФ=dd.MM.yyyy"), "");
				        
					КонецЕсли;					
					бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаАдресПриб, 25, АдресПрибытия_1, АдресПрибытия_2);
					
					ЗаявлениеОСнятии.Параметры.АдресПрибытия_2_1 = АдресПрибытия_1;
					ЗаявлениеОСнятии.Параметры.АдресПрибытия_2_2 = АдресПрибытия_2;
					
					Если ВыборкаСН.Проживающий.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				
						ЗаявлениеОСнятии.Параметры.ж 				  = "ж";   
				
					Иначе
				
						ЗаявлениеОСнятии.Параметры.м 				  = "м";   
				
					КонецЕсли;
					
					ТабДокумент.Вывести(ЗаявлениеОСнятии);
					
				КонецЦикла;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если Выборка.ВидОперации <> Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета И НЕ ПечатьДвухЧастей Тогда
			ДокОснование 	= Выборка.ДокументОснование;
			
			ДокументОснование_1 = "";
			ДокументОснование_2 = "";				
			
			ОбластьПередОснованиями.Параметры.Заполнить(Выборка);
			ОбластьПослеОснований.Параметры.Заполнить(Выборка);
			
			ОрганУчета_1 = "";
			ОрганУчета_2 = "";
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ОрганФМСКудаПрибыл, 70, ОрганУчета_1 , ОрганУчета_2);
			ОбластьПередОснованиями.Параметры.ОрганУчета_1			= ОрганУчета_1;
			ОбластьПередОснованиями.Параметры.ОрганУчета_2			= ОрганУчета_2;
			
			ФизЛицо = "" + Выборка.РегистрируемоеЛицо + 
			?(ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.ДатаРождения), " " + Формат(Выборка.РегистрируемоеЛицо.ДатаРождения, "ЧЦ=; ДФ=dd.MM.yyyy"), ""); 
			 
			ФизЛицоМР = "" + ФизЛицо +  " " + бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(Выборка.РегистрируемоеЛицо.МестоРождения);
			ФЛМР1 = "";
			ФЛМР2 = "";
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ФизЛицоМР, ДлиннаПолнойСтрокиПФ, ФЛМР1 , ФЛМР2);
			
			ОбластьПередОснованиями.Параметры.ФизЛицоМестоРождения1 = ФЛМР1;   
			ОбластьПередОснованиями.Параметры.ФизЛицоМестоРождения2 = ФЛМР2;
			
			// Заполнение пола регистрируемого лица.
			Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				ОбластьПередОснованиями.Параметры.ж 				  = "ж";   
			Иначе
				ОбластьПередОснованиями.Параметры.м 				  = "м";   	
			КонецЕсли;
			
			ДатаПрибытия = Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуС, "ДФ=dd.MM.yyyy");
			ДатаУбытия =  Формат(Выборка.ПериодРегистрацииПоПрежнемуАдресуПо, "ДФ=dd.MM.yyyy");
			АдресПрибытия = "";
			
			Если ЗначениеЗаполнено(АдрПриб) Тогда
				АдресПрибытия = АдрПриб 
				+?(ЗначениеЗаполнено(ДатаПрибытия), ", с " + ДатаПрибытия, "")
				+?(ЗначениеЗаполнено(ДатаУбытия)," по "+ ДатаУбытия, "");
			КонецЕсли;
			
			АдресПрибытия = АдресПрибытия + ",	" + Выборка.ДанныеОПрибытии;
			
			АдресПрибытия_1 = "";
			АдресПрибытия_2 = "";
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресПрибытия, ДлиннаСтрокиПФ, АдресПрибытия_1, АдресПрибытия_2);
			
			ОбластьПередОснованиями.Параметры.АдресПрибытия1     	  = АдресПрибытия_1;
			
			
			ТабДокумент.Вывести(ОбластьПередОснованиями);
			
			ОбластьАдресПрибытияСтрока = Макет.ПолучитьОбласть("АдресПрибытияСтрока");
			
			АдресПрибытияДлинна = СтрДлина(АдресПрибытия);
			АдресПрибытияВыведено = ДлиннаСтрокиПФ;
			
			Пока  АдресПрибытияВыведено <АдресПрибытияДлинна  Цикл			
				
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресПрибытия_2, ДлиннаПолнойСтрокиПФ, АдресПрибытия_1, АдресПрибытия_2);
				
				ОбластьАдресПрибытияСтрока.Параметры.АдресПрибытия2 = АдресПрибытия_1;
				
				АдресПрибытияВыведено = АдресПрибытияВыведено + ДлиннаПолнойСтрокиПФ;
				
				ТабДокумент.Вывести(ОбластьАдресПрибытияСтрока);
				
			КонецЦикла;
			
			//Законный представитель
			Если ЗначениеЗаполнено(Выборка.ЗаконныйПредставитель) Тогда
				ОбластьЗаконныйПредставительШапка = Макет.ПолучитьОбласть("ЗаконныйПредставительШапка");
				ОбластьЗаконныйПредставительСтрока = Макет.ПолучитьОБласть("ЗаконныйПредставительСтрока");
				ЗаконныйПредставительСтрока = "" + Выборка.ЗаконныйПредставитель.Наименование 
				+?(ЗначениеЗаполнено(Выборка.ЗаконныйПредставитель.ДатаРождения),  " " + Формат(Выборка.ЗаконныйПредставитель.ДатаРождения,"ДФ=dd.MM.yyyy" )+ " г.р.", "")
				//+?(ЗначениеЗаполнено(Выборка.СтепеньРодстваЗаконногоПредставителя), " " + Выборка.СтепеньРодстваЗаконногоПредставителя, "")
				+?(ЗначениеЗаполнено(ПаспортныеДанныеЗП.ВидДокумента), ", " + ПаспортныеДанныеЗП.ВидДокумента, "")
				+?(ЗначениеЗаполнено(ПаспортныеДанныеЗП.СерияДокумента), ", сер." + ПаспортныеДанныеЗП.СерияДокумента, "")
				+?(ЗначениеЗаполнено(ПаспортныеДанныеЗП.НомерДокумента), ", № " + ПаспортныеДанныеЗП.НомерДокумента, "")
				+?(ЗначениеЗаполнено(ПаспортныеДанныеЗП.ДатаВыдачиДокумента), ", выдан: " + Формат(ПаспортныеДанныеЗП.ДатаВыдачиДокумента, "ДФ=dd.MM.yyyy"), "")
				+?(ЗначениеЗаполнено(ПаспортныеДанныеЗП.ДокументКемВыдан), " " + ПаспортныеДанныеЗП.ДокументКемВыдан, "")
				+?(ЗначениеЗаполнено(ПаспортныеДанныеЗП.КодПодразделенияДокумента), ", код: " + ПаспортныеДанныеЗП.КодПодразделенияДокумента, "");	
				
				ЗаконныйПредставительСтрока= СокрЛП(ЗаконныйПредставительСтрока);
				ЗаконныйПредставитель1 = "";
				ЗаконныйПредставитель2 = "";
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ЗаконныйПредставительСтрока, ДлиннаСтрокиПФ, ЗаконныйПредставитель1,ЗаконныйПредставитель2);
				
				ОбластьЗаконныйПредставительШапка.Параметры.ЗаконныйПредставитель_1 = ?(ЗначениеЗаполнено(Выборка.СтепеньРодстваЗаконногоПредставителя), " " + Выборка.СтепеньРодстваЗаконногоПредставителя, "") + " " + ЗаконныйПредставитель1;
				ТабДокумент.Вывести(ОбластьЗаконныйПредставительШапка);
				
				ДлиннаНужнойСтрокиЗП = СтрДлина(ЗаконныйПредставительСтрока);
				ВыведеноЗП = ДлиннаСтрокиПФ;
				
				Пока ВыведеноЗП < ДлиннаНужнойСтрокиЗП Цикл
					
					бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ЗаконныйПредставитель2, ДлиннаПолнойСтрокиПФ, ЗаконныйПредставитель1,ЗаконныйПредставитель2);
					
					ОбластьЗаконныйПредставительСтрока.Параметры.ЗаконныйПредставитель_2 = ЗаконныйПредставитель1;
					
					ВыведеноЗП = ВыведеноЗП + ДлиннаПолнойСтрокиПФ;
					
					ТабДокумент.Вывести(ОбластьЗаконныйПредставительСтрока);
				КонецЦикла;
				
			КонецЕсли;		
			
			//ОтветственныеЗаРегистрацию
			ОбластьОтветственныеШапка = Макет.ПолучитьОбласть("ОтветственныеШапка");
			ОбластьОтветственныеСтрока = Макет.ПолучитьОбласть("ОтветственныеСтрока");			
			
			СтрокаОтветственные = "";
			
			ПервыйОтветственный = Истина;
			МассивПодписиОтветственных = Новый Массив;
			Для Каждого Строка из мОтветственные Цикл 
				СтрокаОтветственные = "" + СтрокаОтветственные + Строка.Ответственный.Наименование 
				+?(ЗначениеЗаполнено(Строка.Ответственный.ДатаРождения)," " + Формат(Строка.Ответственный.ДатаРождения, "ДФ=dd.MM.yyyy") + " г.р", "");
				
				СтруктураПодписиОтветственных = Новый Структура;
				
				СтруктураПодписиОтветственных.Вставить("ФИО", ПолучитьИнициалы(Строка.Ответственный.Наименование));
				СтруктураПодписиОтветственных.Вставить("ВидДокумента", Строка.ВидДокумента);
				СтруктураПодписиОтветственных.Вставить("СерияДокумента", Строка.СерияДокумента);
				СтруктураПодписиОтветственных.Вставить("НомерДокумента", Строка.НомерДокумента);
				СтруктураПодписиОтветственных.Вставить("ДокументКемВыдан", Строка.ДокументКемВыдан);
				СтруктураПодписиОтветственных.Вставить("КодПодразделенияДокумента", Строка.КодПодразделенияДокумента);
				СтруктураПодписиОтветственных.Вставить("ДатаВыдачиДокументаПред", Формат(Строка.ДатаВыдачиДокумента ,"ДФ=dd"));
				СтруктураПодписиОтветственных.Вставить("МесяцВыдачиДокументаПред",Формат(Строка.ДатаВыдачиДокумента ,"ДФ=MM")); 
				СтруктураПодписиОтветственных.Вставить("ГодВыдачиДокументаПред", Формат(Строка.ДатаВыдачиДокумента ,"ДФ=yyyy"));
				
				МассивПодписиОтветственных.Добавить(СтруктураПодписиОтветственных);
				
				СтрокаОтветственные = СтрокаОтветственные + "; ";
				
			КонецЦикла;	
			
			СтрокаОтветственные = УбратьПоследнийСимвол(СтрокаОтветственные,  ",");
			Ответственные1 = "";
			Ответственные2 = "";
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаОтветственные, ДлиннаСтрокиПФ, Ответственные1,Ответственные2);
			
			ОбластьОтветственныеШапка.Параметры.ОтветственныеШапка =  Ответственные1;
			ТабДокумент.Вывести(ОбластьОтветственныеШапка);
			
			ДлиннаВыведеноОтветственные = ДлиннаСтрокиПФ;
			ДлиннаОтветственные = СтрДлина(СтрокаОтветственные);
			
			Пока ДлиннаВыведеноОтветственные < ДлиннаОтветственные Цикл
				
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Ответственные2, ДлиннаПолнойСтрокиПФ, Ответственные1,Ответственные2);
				
