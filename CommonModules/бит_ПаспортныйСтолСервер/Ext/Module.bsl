					КонецЦикла;
				КонецЕсли;	
			КонецЕсли; 
		КонецЕсли;
	КонецЕсли;
	
	Если Результат.Количество()>1 Тогда
		
		Возврат МассивСтруктур;
	Иначе
		Возврат СтруктураДанных;
	КонецЕсли;
	// БИТ_ЖКХ изменения кода . Конец  16.08.2012
КонецФункции 

// функция формирует краткое ФИО проживающего или физлица.
// Параметры:
//  <ФизЛицо>  – <Справочник.бит_Проживающие или Справочник.ФизическиеЛица>.
//  <Флаг>  – булево, при истине: данные берет из регистра ФИОФизЛиц.
// При значении ложь: данные берет из регистра бит_ФИОПроживающих.
//
// Возвращаемое значение:
//   <Строка>   – <краткое ФИО владельца ЛС>.
//
Функция ПолучитьСокращенноеФИО(ФизЛицо = Неопределено,ДатаК = Неопределено, Флаг = ложь) Экспорт
	
	Если ФизЛицо = Неопределено Тогда
		
		Если Флаг Тогда
			
			ФизЛицо = Справочники.ФизическиеЛица.ПустаяСсылка();
			
		Иначе
			
			ФизЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если  ДатаК = Неопределено Тогда
		
		ДатаК  = ТекущаяДата();
	КонецЕсли;
	ФИО = ""; 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ФИОПроживающихСрезПоследних.Период,
	|	бит_ФИОПроживающихСрезПоследних.ФизЛицо,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество
	|ИЗ
	|	РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ФизЛицо = &ФизЛицо) КАК бит_ФИОПроживающихСрезПоследних";
	
	Запрос.УстановитьПараметр("Момент", КонецМесяца(ДатаК));
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ИнициалИмени = Лев(ВыборкаДетальныеЗаписи.Имя, 1);
		ИнициалОтчества = Лев(ВыборкаДетальныеЗаписи.Отчество, 1);
		Если ЗначениеЗаполнено(ИнициалИмени) Тогда
			
			ИнициалИмени = ИнициалИмени + ".";	
			
		КонецЕсли; 
		Если ЗначениеЗаполнено(ИнициалОтчества) Тогда
			
			ИнициалОтчества  =  ИнициалОтчества + ".";
			
		КонецЕсли; 
		ФИО = ВыборкаДетальныеЗаписи.Фамилия + " " + ИнициалИмени + ИнициалОтчества;
	КонецЦикла;
	
	Если Результат.Пустой() Тогда
		Фамилия = СокрЛП(Строка(ФизЛицо));
		Если СтрЧислоВхождений(Фамилия, ".") = 0 Тогда
			
			Имя = "";
			Отчество = "";
			
			Если Найти(ФизЛицо, " ") > 0 Тогда
				
				КолвоСимволов = Найти(ФизЛицо, " ");
				Фамилия = Сред(ФизЛицо, 1, КолвоСимволов - 1);
				
				ИмяОтчество = СокрЛП(Прав(ФизЛицо, СтрДлина(ФизЛицо) - КолвоСимволов));
				
			КонецЕсли;
			
			Если Найти(ИмяОтчество," ") > 0 Тогда
				КолвоСимволов = Найти(ИмяОтчество, " ");
				Имя =  Сред(ИмяОтчество, 1, КолвоСимволов - 1);
				Отчество = Прав(ИмяОтчество, СтрДлина(ИмяОтчество) - КолвоСимволов);
				
				ИнициалИмени = Лев(Имя, 1);
				ИнициалОтчества = Лев(Отчество, 1);
				ФИО =  Фамилия + " " + ИнициалИмени + "." + ИнициалОтчества + ".";
			Иначе
				Имя = ИмяОтчество;
				ИнициалИмени = Лев(Имя, 1);
				ФИО =  Фамилия + " " + ?(ЗначениеЗаполнено(ИнициалИмени), ИнициалИмени + ".","");
			КонецЕсли;
		Иначе
			ФИО = Фамилия;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат ФИО;
	
КонецФункции // ПолучитьСокращенноеФИО()

// Функция формирует структуру с данными Ответственного по ЛС.
Функция ПолучитьОтветственногоПоЛС(ЛицевойСчет = Неопределено, Момент) Экспорт
	
	СтруктураДанных = Новый Структура("ЛицевойСчет,ФизЛицо,Контрагент");
	Если НЕ ЗначениеЗаполнено(Момент) Тогда
		
		Момент = ТекущаяДата();
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.Контрагент
	|ИЗ
	|	РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_ОтветственныеЛицаПоКУСрезПоследних";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", 	ЛицевойСчет);
	Запрос.УстановитьПараметр("Момент", 		Момент);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()>0 Тогда
		
		ЗаполнитьЗначенияСвойств(СтруктураДанных,Результат[0]);
		
	КонецЕсли; 
	
	Возврат СтруктураДанных;                            
	
КонецФункции // ()

// функция формирует таблицу значений данных комнат квартиры на дату.
Функция ПолучитьДанныеКомнатКвартиры(Квартира,Момент ) Экспорт
	Если Момент = Неопределено Тогда
		
		Момент = Дата('00010101000000');
		
	КонецЕсли; 
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЕСТЬNULL(бит_СведенияОКомнатеСрезПоследних.Площадь, 0) КАК Площадь,
	|	бит_СведенияОКомнатеСрезПоследних.Комната.ЧастьПомещения.Наименование КАК Комната,
	|	бит_СведенияОКомнатеСрезПоследних.Комната.ЧастьПомещения.ТипКомнаты КАК ТипКомнаты,
	|	бит_СведенияОКомнатеСрезПоследних.Комната.ЧастьПомещения.Принадлежность КАК Принадлежность,
	|	бит_СведенияОКомнатеСрезПоследних.Комната.ЧастьПомещения.КоэффициентНачислений КАК КоэффициентНачислений,
	|	бит_СведенияОКомнатеСрезПоследних.Комната.ЧастьПомещения КАК ЧастьПомещения,
	|	бит_СведенияОКомнатеСрезПоследних.Комната.НомерКомнаты КАК НомерКомнаты
	|ИЗ
	|	РегистрСведений.бит_СведенияОКомнате.СрезПоследних(&Момент, Комната.Владелец = &Квартира) КАК бит_СведенияОКомнатеСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерКомнаты";
	
	Запрос.УстановитьПараметр("Квартира", 	Квартира);
	Запрос.УстановитьПараметр("Момент", 	Момент);
	
	ВыборкаКомнат = Запрос.Выполнить().Выгрузить();
	
	Возврат ВыборкаКомнат;
	
КонецФункции // ПолучитьДанныеКомнатКвартиры()

// Функция находит общую площадь кухни (число) из таблицы значений.
// Можно использовать результат функции ПолучитьДанныеКомнатКвартиры.
Функция ПолучитьПлощадьКухни(ВыборкаКомнат) Экспорт
	
	ПлощадьКухни = 0;
	Для каждого СтрокаКухня Из ВыборкаКомнат Цикл
		Если СтрокаКухня.Комната = Справочники.бит_НазначениеЧастейПомещения.Кухня.Наименование Тогда
			ПлощадьКухни = ПлощадьКухни + СтрокаКухня.Площадь;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ПлощадьКухни;
	
КонецФункции // ПолучитьДанныеКухни()

// Массив площадей квартиры из таблицы значений комнат.
// Можно использовать результат функции ПолучитьДанныеКомнатКвартиры.
Функция ПолучитьПлощадиКвартирыИзКомнат(СписокКомнат) Экспорт
	
	Массив = Новый Массив;
	Массив.Вставить(0,"ОбщаяПлощадь");
	Массив.Вставить(1,"ЖилаяПлощадь");
	Массив.Вставить(2,"МОП_площадь");
	Массив.Вставить(3,"ОтапливаемаяПлощадь");
	Массив.Вставить(4,"СовокупнаяПлощадь");
	Массив.Вставить(5,"ВнешняяПлощадь");
	
	Площадь = Новый Массив(6);
	
	Для Счетчик = 0 По 5  Цикл

		Площадь[Счетчик] = 0;
	КонецЦикла; 
	
	Для каждого СтрокаТЧ Из СписокКомнат Цикл
		Строка = СтрокаТЧ.ЧастьПомещения;
		Если Строка.КоэффициентНачислений <> 0 Тогда 
			// Отапливаемая.
			Площадь[3] = Площадь[3] + СтрокаТЧ.Площадь;
			Если Строка.Принадлежность = Перечисления.бит_ПринадлежностьКомнат.Внутренняя Тогда
				// Общая.
				Площадь[0] = Площадь[0] + СтрокаТЧ.Площадь;
				
				Если Строка.ТипКомнаты = Справочники.бит_ТипыКомнат.Жилая 
					Тогда
					// Жилая.
					Площадь[1] = Площадь[1] + СтрокаТЧ.Площадь;
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЕсли;
		
		Если Строка.Принадлежность = Перечисления.бит_ПринадлежностьКомнат.Внешняя Тогда
			// Внешняя.
			Площадь[5] = Площадь[5] + СтрокаТЧ.Площадь;
		КонецЕсли;	
		
		Если Строка.ТипКомнаты = Справочники.бит_ТипыКомнат.МОП Тогда
			// МОП.
			Площадь[2] = Площадь[2] + СтрокаТЧ.Площадь;
		КонецЕсли;
		
		// Совокупная.
		Площадь[4] = Площадь[4] + СтрокаТЧ.Площадь;
	КонецЦикла;  
	
	Возврат Площадь; 
	
КонецФункции //

// Функция получает таблицу значений услуг, подключенных на ЛС на Момент времени.
