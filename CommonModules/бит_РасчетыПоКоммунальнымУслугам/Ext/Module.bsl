//Функция рассчитывает скорректированную сумму без НДС, в разрезе номенклатуры 
// Возвращаемое значение:
//   <СуммаБезНДС>   - Сумма за вычетом НДС, с учетом набегающей погрешности.
Функция CкорректированнаяCуммаНДС(ТЗНДС, Номенклатура, Начислено, НДССтавка) Экспорт
	
	ТЗНДС.Свернуть("Номенклатура", "СуммаНачислений, СуммаБезНДС");
	СтрТЗ = ТЗНДС.Найти(Номенклатура, "Номенклатура");
	
	Если СтрТЗ = Неопределено Тогда //Если первая запись о номенклатуре
		//НДС от общей суммы начислений
		СуммаПоНачислениямБезНДС = Начислено - (Начислено*(НДССтавка/(100+НДССтавка)));
		//Скорректированная суммма без НДС
		СуммаБезНДС = Окр(СуммаПоНачислениямБезНДС, 2);
	Иначе
		СуммаНачислений = СтрТЗ.СуммаНачислений + Начислено;
		//НДС от общей суммы начислений
		СуммаПоНачислениямБезНДС = СуммаНачислений - (СуммаНачислений*(НДССтавка/(100+НДССтавка)));
		//Скорректированная суммма без НДС
		СуммаБезНДС = Окр(СуммаПоНачислениямБезНДС, 2) - СтрТЗ.СуммаБезНДС;
	КонецЕсли;
	
	//Заполним ТЗ для расчета следующей суммы
	Строка = ТЗНДС.Добавить();
	Строка.Номенклатура =  Номенклатура;
	Строка.СуммаНачислений = Начислено;
	Строка.СуммаБезНДС = СуммаБезНДС;
	
	Возврат СуммаБезНДС;
	
КонецФункции
