#Область ПроцедурыИФункцииФормированияШтрихкода

// Функция выполняет подключение внешней компоненты и ее первоначальную настройку.
// 
// Параметры: 
//  Нет. 
// 
// Возвращаемое значение: 
//  Картинка - Картинка со сформированным штрихкодом или НЕОПРЕДЕЛЕНО.
Функция ПодключитьВнешнююКомпонентуПечатиШтрихкода() Экспорт
	
	// В зависимости от типа платформы подключим соответствующую внешнюю компоненту.
	ПодключениеВыполнено = Неопределено;
	СистемнаяИнформация = Новый СистемнаяИнформация;
	Если СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86 Тогда
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту("Обработка.бит_ПечатьСчетИзвещений.Макет.КомпонентаПечатиШтрихкодовWindows32", "КартинкаШтрихкода", ТипВнешнейКомпоненты.Native);
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Windows_x86_64 Тогда
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту("Обработка.бит_ПечатьСчетИзвещений.Макет.КомпонентаПечатиШтрихкодовWindows64", "КартинкаШтрихкода", ТипВнешнейКомпоненты.Native);
	ИначеЕсли СистемнаяИнформация.ТипПлатформы = ТипПлатформы.Linux_x86 Тогда
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту("Обработка.бит_ПечатьСчетИзвещений.Макет.КомпонентаПечатиШтрихкодовLinux32", "КартинкаШтрихкода", ТипВнешнейКомпоненты.Native);
	Иначе
		ПодключениеВыполнено = ПодключитьВнешнююКомпоненту("Обработка.бит_ПечатьСчетИзвещений.Макет.КомпонентаПечатиШтрихкодовLinux64", "КартинкаШтрихкода", ТипВнешнейКомпоненты.Native);
	КонецЕсли;
	
	// Создадим объект внешней компоненты.
	Если ПодключениеВыполнено Тогда
		мВнешняяКомпонента = Новый("AddIn.КартинкаШтрихкода.Barcode");
	Иначе
		Возврат Неопределено;
	КонецЕсли;
	
	// Если нет возможности рисовать.
	Если НЕ мВнешняяКомпонента.ГрафикаУстановлена Тогда
		// То картинку сформировать не сможем.
		Возврат Неопределено;
	Иначе
		
		// Установим основные параметры компоненты.
		
		// Если в системе установлен шрифт Tahoma.
		Если мВнешняяКомпонента.НайтиШрифт("Tahoma") = Истина Тогда
			// Выбираем его как шрифт для формирования картинки.
			мВнешняяКомпонента.Шрифт = "Tahoma";
		Иначе
			
			// Шрифт Tahoma в системе отсутствует.
			// Обойдем все доступные компоненте шрифты.
			Для Сч = 0 По мВнешняяКомпонента.КоличествоШрифтов -1 Цикл
				// Получим очередной шрифт, доступный компоненте.
				ТекущийШрифт = мВнешняяКомпонента.ШрифтПоИндексу(Сч);
				// Если шрифт доступен.
				Если ТекущийШрифт <> Неопределено Тогда
					// Они и будет шрифтом для формирования штри-кода.
					мВнешняяКомпонента.Шрифт = ТекущийШрифт;
					Прервать;
				КонецЕсли;
			КонецЦикла;
		КонецЕсли;
		
		// Утановим размер шрифта.
		мВнешняяКомпонента.РазмерШрифта = 12;
		
		Возврат мВнешняяКомпонента;
		
	КонецЕсли;
	
КонецФункции

// Функция выполняет формирование изображения штрихкода.
// 
// Параметры: 
//  ВнешняяКомпонента, ПараметрыШтрихкода.
// 
// Возвращаемое значение: 
//  Картинка - Картинка со сформированным штрихкодом или НЕОПРЕДЕЛЕНО.
Функция ПолучитьКартинкуШтрихкода(ВнешняяКомпонента, ПараметрыШтрихкода) Экспорт
	
	// Зададим размер картинки.
	мВнешняяКомпонента.Ширина = ПараметрыШтрихкода.Ширина;
	мВнешняяКомпонента.Высота = ПараметрыШтрихкода.Высота;
	
	// Разрешим компоненте самой определять тип кода.
	мВнешняяКомпонента.АвтоТип = Ложь;
	мВнешняяКомпонента.ТипКода         = ПараметрыШтрихкода.ТипКода;
	мВнешняяКомпонента.ОтображатьТекст = ПараметрыШтрихкода.ОтображатьТекст;
	Попытка
		мВнешняяКомпонента.РазмерШрифта = ПараметрыШтрихкода.РазмерШрифта;
	Исключение
		
	КонецПопытки;
	
	мВнешняяКомпонента.СодержитКС = СтрДлина(ПараметрыШтрихкода.Штрихкод) = 43;
	
	// Если отображать контрольный символ не нужно.
	мВнешняяКомпонента.ВидимостьКС = Ложь;
	
	// Формируем картинку штрихкода.
	мВнешняяКомпонента.ЗначениеКода = ПараметрыШтрихкода.Штрихкод;
	
	// Если установленная нами ширина меньше минимально допустимой для этого штрихкода.
	Если мВнешняяКомпонента.Ширина < мВнешняяКомпонента.МинимальнаяШиринаКода Тогда
		// Скорректируем ширину.
		мВнешняяКомпонента.Ширина = мВнешняяКомпонента.МинимальнаяШиринаКода + 10;
	КонецЕсли;
	
	// Сформируем картинку.
	ДвоичныеДанныеКартинки = мВнешняяКомпонента.ПолучитьШтрихкод();
	
	// Если картинка сформировалась.
	Если ДвоичныеДанныеКартинки <> Неопределено Тогда
		// Формируем из двоичных данных.
		Возврат Новый Картинка(ДвоичныеДанныеКартинки);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции

Процедура УбратьШККод(ТабДок)
	
	РисункиШК = Новый Массив;
	Для Каждого Рис Из ТабДок.Рисунки Цикл
		Если СтрНайти(НРег(Рис.Имя), "шк") > 0 Тогда
			РисункиШК.Добавить(Рис);
		КонецЕсли;
	КонецЦикла;
	Если РисункиШК.Количество() > 0 Тогда
		Для Каждого РисШК Из РисункиШК Цикл
			ТабДок.Рисунки.Удалить(РисШК);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииПечатиДополнительнойИнформации

Функция СформироватьДонесениеОПоказанияхВодосчетчиков(ЛицевойСчет, ОтветсвенноеЛицо, Дата) Экспорт
	
	Донесение = Новый ТабличныйДокумент;
	
	Донесение.АвтоМасштаб = Истина;
	Донесение.ПолеСверху  = 0;
	Донесение.ПолеСнизу   = 0;
	
	Если мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент Тогда
		Донесение.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Иначе
		Донесение.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	КонецЕсли;
	
	Макет = ПолучитьМакет("СрочноеДонесениеОПоказанияхВодосчетчиков");
	
	Шапка  = Макет.ПолучитьОбласть("Шапка");
	Строка = Макет.ПолучитьОбласть("Строка");
	Подвал = Макет.ПолучитьОбласть("Подвал");
	
	ТаблицаСтрок = Новый ТабличныйДокумент;
	
	Запрос= Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Дата"       , КонецМесяца(Дата));
	Запрос.УстановитьПараметр("СписокГЦЖС" , СписокГЦЖС);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.МестоУстановкиСчетчика,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга.ГрафаОтчетаГЦЖС КАК ГрафаОтчетаГЦЖС
	|ПОМЕСТИТЬ Счетчики
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Объект = &ЛицевойСчет
	|				И НЕ Многотарифный
	|				И Услуга.ГрафаОтчетаГЦЖС В (&СписокГЦЖС)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	Счетчики.Счетчик КАК Счетчик,
	|	Счетчики.МестоУстановкиСчетчика КАК Комната,
	|	МАКСИМУМ(бит_ПоказанияСчетчиковОстаткиИОбороты.ПоследниеПоказанияНачальныйОстаток) КАК НачПок,
	|	МАКСИМУМ(бит_ПоказанияСчетчиковОстаткиИОбороты.ПоследниеПоказанияКонечныйОстаток) КАК КонПок
	|ИЗ
	|	Счетчики КАК Счетчики
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ПоказанияСчетчиков.ОстаткиИОбороты(НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, 1), МЕСЯЦ), КОНЕЦПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, 1), МЕСЯЦ), , , ) КАК бит_ПоказанияСчетчиковОстаткиИОбороты
	|		ПО Счетчики.Счетчик = бит_ПоказанияСчетчиковОстаткиИОбороты.Счетчик
	|			И Счетчики.Услуга = бит_ПоказанияСчетчиковОстаткиИОбороты.Услуга
	|			И Счетчики.Объект = бит_ПоказанияСчетчиковОстаткиИОбороты.Объект
	|
	|СГРУППИРОВАТЬ ПО
	|	Счетчики.Счетчик,
	|	Счетчики.МестоУстановкиСчетчика
	|
	|УПОРЯДОЧИТЬ ПО
	|	Счетчик
	|ИТОГИ ПО
	|	Комната";
	
	ВыборкаКомната = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НомерПоследнейСтроки = 0;
	НомерПервойСтроки    = 1;
	
	Пока ВыборкаКомната.Следующий() Цикл
		
		Выборка = ВыборкаКомната.Выбрать();
		КоличествоСтрок = Выборка.Количество();
		
		Пока Выборка.Следующий() Цикл
			
			Строка.Параметры.Заполнить(Выборка);
			
			ТаблицаСтрок.Вывести(Строка);
			
		КонецЦикла; 
		
		НомерПоследнейСтроки = НомерПоследнейСтроки + КоличествоСтрок; 
		
		Область = ТаблицаСтрок.Область("R"+НомерПервойСтроки+"C1:R"+НомерПоследнейСтроки+"C2");
		Область.Объединить();
		Область.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		Область.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
		
		НомерПервойСтроки = НомерПоследнейСтроки + 1;
		
	КонецЦикла;
	
	Если ТаблицаСтрок.ВысотаТаблицы = 0 Тогда
		
		Возврат Неопределено;
		
	КонецЕсли; 
	
	Шапка.Параметры.ОтвЛицо     = ОтветсвенноеЛицо;
	Шапка.Параметры.ЛицевойСчет = ЛицевойСчет;
	Шапка.Параметры.ТекМесяц    = Формат(ДобавитьМесяц(Дата, 1), "ДФ= ММММ");
	
	Если Месяц(Дата) = 12 Тогда
		Шапка.Параметры.ЧислоГод    = Прав(Формат(Год(Дата)+1, "ДФ= ММММ"),2);
	Иначе
		Шапка.Параметры.ЧислоГод    = Прав(Формат(Дата, "ДФ= yyyy"), 2);
	КонецЕсли;
	
	Шапка.Параметры.НаименованиеСрочногоДонесения = НаименованиеСрочногоДонесения;
	
	Донесение.Вывести(Шапка);
	Донесение.Вывести(ТаблицаСтрок);
	Донесение.Вывести(Подвал);
	
	Возврат Донесение;
	
КонецФункции

Процедура ВывестиЗамечания(ТабличныйДокумент, Знач ЛицевойСчет)
	
	ЗапросЗамечание = Новый Запрос;
	ЗапросЗамечание.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗамечанияПоЛС.ЛицевойСчет,
	|	бит_ЗамечанияПоЛС.Наименование,
	|	бит_ЗамечанияПоЛС.ТекстЗамечания,
	|	бит_ЗамечанияПоЛС.Номер КАК Номер
	|ИЗ
	|	РегистрСведений.бит_ЗамечанияПоЛС КАК бит_ЗамечанияПоЛС
	|ГДЕ
	|	бит_ЗамечанияПоЛС.ЛицевойСчет = &ЛицевойСчет
	|	И бит_ЗамечанияПоЛС.Исполнено = ЛОЖЬ
	|	И бит_ЗамечанияПоЛС.ВыводитьНаПечать = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	Номер";
	ЗапросЗамечание.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	РезультатЗапроса = ЗапросЗамечание.Выполнить();
	
	Если НЕ РезультатЗапроса.Пустой() Тогда
		
		ШапкаЗамечания         = мМакет.ПолучитьОбласть("ШапкаЗамечания");
		ОбластьСтрокаОбращение = мМакет.ПолучитьОбласть("СтрокаОбращение");
		
		ТабличныйДокумент.Вывести(ШапкаЗамечания);
		
		Выборка = РезультатЗапроса.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			ЗаполнитьПараметр(ОбластьСтрокаОбращение, "ОбращениеСтрока", Выборка.Номер + ".  " + Выборка.ТекстЗамечания);
			ТабличныйДокумент.Вывести(ОбластьСтрокаОбращение);
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

Функция СформироватьПлатежныйДокументПени(ВходящееСальдоПени,НачисленоПениЗаПериод,ПолучательКоррСчет,ПолучательБанк,ИтогПени,ПолучательТелефон,ПолучательПредставление,ПолучательКПП,ПолучательИНН,ПолучательРС,ПолучательАдрес,ЛицевойСчет, ОтветсвенноеЛицо, Дата) Экспорт
	
	ДокументПени = Новый ТабличныйДокумент;
	
	ДокументПени.АвтоМасштаб = Истина;
	ДокументПени.ПолеСверху  = 0;
	ДокументПени.ПолеСнизу   = 0;
	
	Если мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924 
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ Тогда
		ДокументПени.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Иначе
		ДокументПени.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	КонецЕсли;
	
	Если мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924 
		ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументРК924ГИСЖКХ Тогда 
		
		Макет = ПолучитьМакет("ПлатежныйДокументПени");
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент1 Тогда
		
		Макет = ПолучитьМакет("ПлатежныйДокументПениРКБИТ");
		
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент Тогда 
		
		Макет = ПолучитьМакет("ПлатежныйДокументПениРК354");
	ИначеЕсли мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.ПлатежныйДокументПени Тогда 
		
		Макет = ПолучитьМакет("ПлатежныйДокументПениРКБИТ");
		
	КонецЕсли;
	
	Шапка   = Макет.ПолучитьОбласть("Шапка");
	Раздел1 = Макет.ПолучитьОбласть("Раздел1");
	Раздел2 = Макет.ПолучитьОбласть("Раздел2");
	Справка = Макет.ПолучитьОбласть("Справка");
	
	
	Раздел1.Параметры.ЛицевойСчет         = ЛицевойСчет;
	Раздел1.Параметры.ЛицевойСчетФИО      = ОтветсвенноеЛицо;
	Раздел1.Параметры.Период              = Формат(Период,"ДФ=MM.yyyy");
	//Раздел1.Параметры.ЛицевойСчетАдрес    = Строка(ЛицевойСчет.УлицаЛицевогоСчета) +""+ Строка(ЛицевойСчет.Здание);
	Раздел1.Параметры.ЛицевойСчетАдрес    = мСтруктураДанных.ЛицевойСчетАдрес;
		
	Раздел1.Параметры.ПолучательПредставление    =  ПолучательПредставление;
	
	СтруктураАдресаПолучателя = РазбитьСтроку(ПолучательАдрес, 51, "ПолучательАдрес_1", "ПолучательАдрес_2");
	Раздел1.Параметры.Заполнить(СтруктураАдресаПолучателя);
	
	Раздел1.Параметры.ПолучательТелефон            =  ПолучательТелефон;
	Раздел1.Параметры.ПолучательРС               =  ПолучательРС;
	Раздел1.Параметры.ПолучательИНН              =  ПолучательИНН;
	Раздел1.Параметры.ПолучательКПП              =  ПолучательКПП;
	Раздел1.Параметры.ПолучательБанк              =  ПолучательБанк;
	Раздел1.Параметры.ПолучательКоррСчет              =  ПолучательКоррСчет;
	
	Раздел2.Параметры.ПениИтого               =  ИтогПени;
	Раздел2.Параметры.ВходящееСальдоПени       =  ВходящееСальдоПени;
	Раздел2.Параметры.НачисленоПениЗаПериод    =  НачисленоПениЗаПериод;
	
	Если ЗначениеЗаполнено(ИтогПени) или ЗначениеЗаполнено(ВходящееСальдоПени) или ЗначениеЗаполнено(НачисленоПениЗаПериод) Тогда
		
		ДокументПени.Вывести(Шапка);
		ДокументПени.Вывести(Раздел1);
		ДокументПени.Вывести(Раздел2);
		ДокументПени.Вывести(Справка);
		
	КонецЕсли;
	
	Возврат ДокументПени;
	
КонецФункции

Функция ЗаполнитьТаблицуЗначенийСвойств(ЛицевойСчет)
	
	// Заполнение дерева значениями свойств.
	ЗначенияСвойств = ПрочитатьЗначенияСвойствИзРегистраСведений(ЛицевойСчет);
	
	Индекс = 0;
	
	ЗначенияСвойств.Колонки.Добавить("Индекс");	
	
	Для Каждого Строка из ЗначенияСвойств Цикл
		Индекс = Индекс + 1;
		
		Строка.Индекс = Индекс;	 
		
	КонецЦикла;	 
	
	ЗначенияСвойств.Сортировать("Индекс Убыв");
	
	Возврат ЗначенияСвойств;
	
КонецФункции

Функция ПрочитатьЗначенияСвойствИзРегистраСведений(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ДополнительныеСведения.Свойство,
	|	ДополнительныеСведения.Значение
	|ИЗ
	|	РегистрСведений.ДополнительныеСведения КАК ДополнительныеСведения
	|ГДЕ
	|	ДополнительныеСведения.Объект = &Объект";
	Запрос.УстановитьПараметр("Объект", ЛицевойСчет);
	
	Возврат Запрос.Выполнить().Выгрузить();
	
КонецФункции

