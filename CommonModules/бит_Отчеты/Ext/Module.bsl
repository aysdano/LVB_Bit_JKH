	ПараметрыФормы.Вставить("ИсключенныеПоля"      , Форма.Подключаемый_ПолучитьЗапрещенныеПоля("Выбор"));
	ПараметрыФормы.Вставить("ТекущаяСтрока"        , Неопределено);
	ПараметрыВыбранногоПоля = Неопределено;

	ОткрытьФорму("ОбщаяФорма.бит_ФормаВыбораДоступногоПоля", ПараметрыФормы,,,,, Новый ОписаниеОповещения("ДополнительныеПоляПередНачаломДобавленияЗавершение", бит_Отчеты, Новый Структура("Форма", Форма)), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
