					ФайлОплаты.S4	= "";
				КонецЕсли;
				ФайлОплаты.S5	= Выборка.Начислено; 
				ФайлОплаты.PER	= 1;
				ФайлОплаты.CHET	= (Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам"));
				ФайлОплаты.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
				ФайлОплаты.ITOG	= ?(Выборка.ОбщеДом = 0,Ложь,Истина);
				
				ФайлОплаты.Записать();
				НомерСтр = НомерСтр + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ФайлОплаты.Открыта() Тогда
			ФайлОплаты.ЗакрытьФайл();
		КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла ""Суммы оплаты услуг"".
		|" + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыгрузитьНачисления()
	
	ВсеРеквизитыЗаполнены = ПроверитьЗаполнение();
	
	Если ВсеРеквизитыЗаполнены Тогда
		
		ТекстовыйДокумент_Нач1 = Новый ТекстовыйДокумент;
		ТекстовыйДокумент_Нач2 = Новый ТекстовыйДокумент;
		ТекстовыйДокумент_Нач3 = Новый ТекстовыйДокумент;
		
		Заголовок_Нач1 = "Файл: ""Сведения о плательщике за жилищно-коммунальные и прочие услуги: """;
		Заголовок_Нач2 = "Файл: ""Сведения о начисленной плате за жилые помещения,
		|       коммунальные и прочие услуги, в том числе о
		|       плате за прошедший период, измененной в результате перерасчета: """;
		Заголовок_Нач3 = "Файл: ""Сведения о лицах (влючая плательщика), которые учитываются
		|       при расчете платы за жилищно-коммунальные и прочие услуги: """;
		
		СформироватьФайлыВыгрузкиНачислений(ТекстовыйДокумент_Нач1, ТекстовыйДокумент_Нач2, ТекстовыйДокумент_Нач3);
		
		Если ТекстовыйДокумент_Нач1.КоличествоСтрок() < 1 Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Заголовок_Нач1 + " не сформирован.");
			
		Иначе
			
			Попытка
				
				ТекстовыйДокумент_Нач1.Записать(""+Объект.КаталогНач1+"\"+Объект.ИмяФайлаНач1+".txt", "cp866");

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Заголовок_Нач1 + " сохранен.");
				
			Исключение
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Заголовок_Нач1 + " не сохранен.
				|"+ ОписаниеОшибки());
				
			КонецПопытки;
			
		КонецЕсли;
		
		Если ТекстовыйДокумент_Нач2.КоличествоСтрок() <= 1 Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Заголовок_Нач2 + " не сформирован.");
			
		Иначе
			
			Попытка
				
				ТекстовыйДокумент_Нач2.Записать(""+Объект.КаталогНач2+"\"+Объект.ИмяФайлаНач2+".txt", "cp866");

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Заголовок_Нач2 + " сохранен.");
				
			Исключение

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Заголовок_Нач2 + " не сохранен.
				|"+ ОписаниеОшибки());
				
			КонецПопытки;
			
