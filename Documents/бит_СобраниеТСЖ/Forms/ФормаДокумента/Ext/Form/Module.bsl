	|		ЛЕВОЕ СОЕДИНЕНИЕ СписокВопросов КАК СписокВопросов
	|		ПО РезультатыГолосования.ИдентификаторВопроса = СписокВопросов.Идентификатор
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВариантыВыбораГолосования КАК ВариантыВыбораГолосования
	|		ПО РезультатыГолосования.ИдентификаторРешения = ВариантыВыбораГолосования.Идентификатор
	|ГДЕ
	|	РезультатыГолосования.Ссылка = &Ссылка
	|ИТОГИ
	|	МАКСИМУМ(Вопрос)
	|ПО
	|	ИдентификаторВопроса
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СписокВопросов
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ВариантыВыбораГолосования";
	
	ВыборкаВопрос = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	УровеньВопрос = ДеревоРзельтатовГолосования.ПолучитьЭлементы();
