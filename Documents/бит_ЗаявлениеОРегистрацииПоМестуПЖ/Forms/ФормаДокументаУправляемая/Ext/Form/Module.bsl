	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаПрибытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаУбытия,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибылАдресЗапятые,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.КудаВыписанАдресЗапятые
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) И ЗначениеЗаполнено(Выборка.ЛицевойСчет) Тогда
		
		ТабДокумент   = Новый ТабличныйДокумент();
		ТабДокумент.КлючПараметровПечати = "СведенияОРегистрацииГражданинаРоссийскойФедерацииПоМестуЖительства";
		
		Если ВерсияМакета Тогда
			
			Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("СОРГ_РФ_ПМЖ");
			ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
			
		Иначе
			
			Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("СОРГ_РФ_ПМЖ_Old");
			ШапкаОбласть  	= Макет.ПолучитьОбласть("Шапка");
			СтрокаОбласть = Макет.ПолучитьОбласть("СтрокаТЧ");
			ПодвалОбласть	= Макет.ПолучитьОбласть("Подвал");
			
		КонецЕсли; 
		
		КИОрганизации = ПолучитьКИ(Выборка.Организация, 
		Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Организации);
		
		Адрес   = КИОрганизации.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, "Вид");
		Телефон = КИОрганизации.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации, "Вид"); 
		АдресПочтовый = КИОрганизации.Найти(Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации, "Вид");
		
		НазваниеОрганизации_1	= "";
		НазваниеОрганизации_2	= "";
		НазваниеОрганизации		= "";
		Если ЗначениеЗаполнено(Выборка.ЛицевойСчет)Тогда 
			
			Если ТипЗнч(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба) = Тип("СправочникСсылка.Контрагенты") Тогда
				
				НазваниеОрганизации = Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба.НаименованиеПолное;
				
			Иначе
				НазваниеОрганизации = Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба;
			КонецЕсли;
			
			// ИНН.
			ИНН = Объект.Организация.ИНН;
			ДлинаИНН = СтрДлина(Инн);
			
			Индекс = 0;
			Пока Индекс <> ДлинаИнн И Индекс < 10  Цикл
				
				Индекс = Индекс + 1;
				ИННИндекс = "ИНН" + Индекс;
				ШапкаОбласть.Параметры[ИННИндекс] = Сред(ИНН,Индекс,1);
				
			КонецЦикла;
			
			// КПП.
			КПП = Объект.Организация.КПП;
			ДлинаИНН = СтрДлина(КПП);
			
			Индекс = 0;
			Пока Индекс <> ДлинаИнн Цикл
				
				Индекс = Индекс + 1;
				КППИндекс = "КПП" + Индекс;
				ШапкаОбласть.Параметры[КППИндекс] = Сред(КПП,Индекс,1);
				
			КонецЦикла;
			
			// ОГРН.
			ОГРН = Объект.Организация.ОГРН;
			ДлинаИНН = СтрДлина(ОГРН);
			
			Индекс = 0;
			Пока Индекс <> ДлинаИнн Цикл
				
				Индекс = Индекс + 1;
				ОГРНИндекс = "ОГРН" + Индекс;
				ШапкаОбласть.Параметры[ОГРНИндекс] = Сред(ОГРН,Индекс,1);
				
			КонецЦикла;
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(НазваниеОрганизации, 35, НазваниеОрганизации_1 , НазваниеОрганизации_2 );
		КонецЕсли; 
		
		ШапкаОбласть.Параметры.НазваниеОрганизации_1 = НазваниеОрганизации_1;
		ШапкаОбласть.Параметры.НазваниеОрганизации_2 = НазваниеОрганизации_2;
		
		// ИМНС.
		НалоговыйОрган_1 = "";
		НалоговыйОрган_2 = "";
		НалоговыйОрган_3 = "";
		
		Если ЭтаФорма.Объект.Ссылка.Пустая() Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Сначала запишите документ";
			Сообщение.Сообщить();
			Возврат Неопределено;
			
		КонецЕсли;
		
		Попытка
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.Организация.НаименованиеИМНС, 35, НалоговыйОрган_1 , НалоговыйОрган_2 );
		Исключение
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.Организация.НаименованиеНалоговогоОргана, 35, НалоговыйОрган_1 , НалоговыйОрган_2 );
		КонецПопытки;
		
		ШапкаОбласть.Параметры.НалоговыйОрган_1 = НалоговыйОрган_1;
		ШапкаОбласть.Параметры.НалоговыйОрган_2 = НалоговыйОрган_2;
		
		Попытка
			ИМНС = Выборка.Организация.КодИМНС;
		Исключение
			ИМНС = Выборка.Организация.КодНалоговогоОргана;
		КонецПопытки;
		
		ДлинаИНН = СтрДлина(ИМНС);
		
		Индекс = 0;
		Пока Индекс <> ДлинаИнн Цикл
			
			Индекс = Индекс + 1;
			ИМНСИндекс = "ГНИ" + Индекс;
			ШапкаОбласть.Параметры[ИМНСИндекс] = Сред(ИМНС,Индекс,1);
			
		КонецЦикла;
		
		// Сведения о физ лице.
		ШапкаОбласть.Параметры.Фамилия  = Выборка.Фамилия;
		ШапкаОбласть.Параметры.Имя      = Выборка.Имя;
		ШапкаОбласть.Параметры.Отчество = Выборка.Отчество;
		
		Если ЗначениеЗаполнено(Выборка.Пол) Тогда
			
			Если Выборка.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				
				ШапкаОбласть.Параметры.ПолМ  = "V";
				
			ИначеЕсли Выборка.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				
				ШапкаОбласть.Параметры.ПолЖ  = "V";
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		ШапкаОбласть.Параметры.ДатаРождения  = Формат(Выборка.ДатаРождения, "ДЛФ=DD");
		
		МестоРожденияСтруктура = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.МестоРождения);
		МестоРождения = "";
		Если ЗначениеЗаполнено(МестоРожденияСтруктура.НаселенныйПункт) Тогда
			МестоРождения = МестоРождения + МестоРожденияСтруктура.НаселенныйПункт;
		КонецЕсли; 
		Если ЗначениеЗаполнено(МестоРожденияСтруктура.Село) Тогда	
			МестоРождения = МестоРождения +", "+ МестоРожденияСтруктура.Село + " село";
		КонецЕсли;
		Если ЗначениеЗаполнено(МестоРожденияСтруктура.Район) Тогда	
			МестоРождения = МестоРождения +", "+ МестоРожденияСтруктура.Район + " р-на";
		КонецЕсли;  
		Если ЗначениеЗаполнено(МестоРожденияСтруктура.Область) Тогда	
			МестоРождения = МестоРождения +", "+ МестоРожденияСтруктура.Область + " обл.";
		КонецЕсли;  
		Если ЗначениеЗаполнено(МестоРожденияСтруктура.Страна) Тогда	
			МестоРождения = МестоРождения +", "+ МестоРожденияСтруктура.Страна;
		КонецЕсли; 
		ШапкаОбласть.Параметры.МестоРождения = МестоРождения;
		
		// ШапкаОбласть.Параметры.ВидДокумента  = Выборка.ВидДокумента;.
		Если ЗначениеЗаполнено(Выборка.ВидДокумента) Тогда
			Если ЗначениеЗаполнено(Выборка.ВидДокумента.КодПФР) Тогда
				ШапкаОбласть.Параметры.ВидДокумента 		= Выборка.ВидДокумента.КодПФР; 
			Иначе	
				ШапкаОбласть.Параметры.ВидДокумента 		= Выборка.ВидДокумента;
			КонецЕсли;
		КонецЕсли;
		
		ШапкаОбласть.Параметры.Серия         = Выборка.СерияДокумента;
		ШапкаОбласть.Параметры.Номер         = Выборка.НомерДокумента;
		
		КемВыдан_1 = "";
		КемВыдан_2 = "";
		Если ЗначениеЗаполнено(Выборка.ВыданДокумент) Тогда
			КемВыдан = Строка(Выборка.ВыданДокумент) + ", код " + Строка(Выборка.ДокументКодПодразделения);
		ИначеЕсли ЗначениеЗаполнено(Выборка.ДокументКодПодразделения) Тогда
			КемВыдан = Строка(Выборка.ДокументКодПодразделения);
		КонецЕсли; 
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(КемВыдан, 25, КемВыдан_1, КемВыдан_2 );
		ШапкаОбласть.Параметры.КемВыдан_1 = КемВыдан_1;
		ШапкаОбласть.Параметры.КемВыдан_2 = КемВыдан_2;
		
		Если ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента) Тогда
			ШапкаОбласть.Параметры.ДатаВыдачиДокумента = Формат(Выборка.ДатаВыдачиДокумента, "ДФ='dd.MM.yyyy ""г.""'");
		КонецЕсли; 
		
		// Сведения о постановке на учет.
		КИФизЛица = ПолучитьКИ(Выборка.РегистрируемоеЛицо, Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Проживающие);
		
		НаборЗаписей = НЕОПРЕДЕЛЕНО;
		
		Если Выборка.ДомРег.КонтактнаяИнформация.Количество() > 0 Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗдания);
			
			Строки = Выборка.ДомРег.КонтактнаяИнформация.НайтиСтроки(Отбор);
			
			
			Если Строки.количество() = 0 и ЗначениеЗаполнено(Выборка.ДомРег.ПочтовыйАдрес) Тогда
				
				СтруктураПочтовыйАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ДомРег.ПочтовыйАдрес);
				
			ИначеЕсли НЕ Строки.количество() = 0 Тогда
				
				//15.10.2018
				Если ЗначениеЗаполнено(Строки[0].Значение) Тогда
					
					ПочтовыйАдресПредставление = Строки[0].Представление;
					СтруктураПочтовыйАдрес = ПолучитьАдресБСП(Строки[0].Значение);
					
					//---	
				ИначеЕсли ЗначениеЗаполнено(Выборка.ДомРег.ПочтовыйАдресЗапятые) Тогда
					
					СтруктураПочтовыйАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ДомРег.ПочтовыйАдресЗапятые);
					
				ИначеЕсли ЗначениеЗаполнено(Выборка.ДомРег.ПочтовыйАдрес) Тогда
					
					бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
					
					
					ВыборкаПочтАдр = Неопределено;
					Для каждого СтрокаНабор Из НаборЗаписей  Цикл
						Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
							И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
							Тогда 
							ВыборкаПочтАдр = СтрокаНабор;
						КонецЕсли;	
					КонецЦикла;
					
					ПочтовыйАдресСтрока = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ВыборкаПочтАдр);
					СтруктураПочтовыйАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ПочтовыйАдресСтрока);
					
				Иначе
					
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Перезаполните поле откуда прибыл адрес";
					Сообщение.Сообщить();
					Возврат Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;			
			
		Иначе
			
			бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
			
			ВыборкаПочтАдр = Неопределено;
			Для каждого СтрокаНабор Из НаборЗаписей  Цикл
				Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
					И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
					Тогда 
					ВыборкаПочтАдр = СтрокаНабор;
				КонецЕсли;	
			КонецЦикла;
			
			СтруктураПочтовыйАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ВыборкаПочтАдр);
			СтруктураПочтовыйАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ПочтовыйАдресСтрока);
			
		КонецЕсли;
		
		Если СтруктураПочтовыйАдрес <> Неопределено И НЕ СтруктураПочтовыйАдрес.Свойство("ЗаПределамиРФ") Тогда
			
			Если ЗначениеЗаполнено(СтруктураПочтовыйАдрес.Страна) Тогда
				ШапкаОбласть.Параметры.Республика = СтруктураПочтовыйАдрес.Страна;
			ИначеЕсли ЗначениеЗаполнено(СтруктураПочтовыйАдрес.Регион) Тогда
				ШапкаОбласть.Параметры.Республика = СтруктураПочтовыйАдрес.Регион;
			КонецЕсли; 
			ШапкаОбласть.Параметры.Район      = СтруктураПочтовыйАдрес.Район;
			//12.12.2018
			если Найти(НРег(СтруктураПочтовыйАдрес.Регион), "москва") <> 0 тогда
				ШапкаОбласть.Параметры.Город      = СтруктураПочтовыйАдрес.Регион;
			иначе	
				ШапкаОбласть.Параметры.Город      = СтруктураПочтовыйАдрес.Город;
			конецесли; 
			
			ШапкаОбласть.Параметры.Село       = СтруктураПочтовыйАдрес.НаселенныйПункт;
			ШапкаОбласть.Параметры.Улица      = СтруктураПочтовыйАдрес.Улица;
			ШапкаОбласть.Параметры.Дом        = СтруктураПочтовыйАдрес.Дом;
			ШапкаОбласть.Параметры.Корпус     = СтруктураПочтовыйАдрес.Корпус;
			
		Иначе
			ШапкаОбласть.Параметры.Улица      = Выборка.УлицаРег;
			ШапкаОбласть.Параметры.Дом        = Выборка.ДомРег;
			ШапкаОбласть.Параметры.Корпус     = Выборка.КорпусРег;
			
		КонецЕсли; 
		ШапкаОбласть.Параметры.Квартира   = Выборка.КвартираРег;
		
		// Предыдущее место пребывания.
		Если Объект.КонтактнаяИнформация.Количество() > 0 Тогда
			
			Отбор = Новый Структура();
			Отбор.Вставить("Вид", Справочники.ВидыКонтактнойИнформации.ОткудаПрибылПредставление);
			
			Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
			
			
			Если Строки.количество() = 0 и ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) Тогда
				
				АдресИнформированияСтруктура = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
				
			ИначеЕсли НЕ Строки.количество() = 0 Тогда
				
				//15.10.2018
				Если ЗначениеЗаполнено(Строки[0].Значение) Тогда
					
					АдресПрибытияПредставление = Строки[0].Представление;
					АдресИнформированияСтруктура = ПолучитьАдресБСП(Строки[0].Значение);
					
					//---
				ИначеЕсли ЗначениеЗаполнено(Выборка.ОткудаПрибылАдресЗапятые) Тогда
					
					АдресИнформированияСтруктура = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдресЗапятые);
					
				ИначеЕсли ЗначениеЗаполнено(Выборка.ОткудаПрибылАдрес) Тогда
					
					Если Объект.ОткудаПрибылИзЛС Тогда
						
						
						Если НЕ ПустаяСтрока(Объект.ОткудаПрибылАдрес) Тогда
							
							ОткудаПрибылПредставление = бит_УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдресаПоСтрока(Объект.ОткудаПрибылАдрес);
							ОткудаПрибылКонтактнаяИнформацияНаСервере();	
							
						КонецЕсли;
						
						
						Если ЗначениеЗаполнено(ОткудаПрибылПредставлениеЗапятые) Тогда
							
							АдресИнформированияСтруктура = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ОткудаПрибылПредставлениеЗапятые);
							
						КонецЕсли; 
						
					Иначе
						
						Попытка
							АдресИнформированияСтруктура = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Объект.ОткудаПрибылАдрес);
							
						Исключение
							Сообщение = Новый СообщениеПользователю();
							Сообщение.Текст = "Перезаполните откуда прибыл адрес";
							Сообщение.Сообщить();
							АдресИнформированияСтруктура = Неопределено;
						КонецПопытки;
						
					КонецЕсли; 
					
				Иначе
					
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Заполните откуда прибыл адрес";
					Сообщение.Сообщить();
					АдресИнформированияСтруктура = Неопределено;
					
				КонецЕсли;
				
			КонецЕсли;			
			
		Иначе
			
			АдресИнформированияСтруктура = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибылАдрес);
			
		КонецЕсли;		
		
		Если АдресИнформированияСтруктура <> Неопределено И НЕ АдресИнформированияСтруктура.Свойство("ЗаПределамиРФ") Тогда
			
			ШапкаОбласть.Параметры.ПредРеспублика = АдресИнформированияСтруктура.Страна;
			ШапкаОбласть.Параметры.ПредРайон      = АдресИнформированияСтруктура.Район;
			//12.12.2018
			если Найти(НРег(АдресИнформированияСтруктура.Регион), "москва") <> 0 тогда
				ШапкаОбласть.Параметры.ПредГород      = АдресИнформированияСтруктура.Регион;
			иначе	
				ШапкаОбласть.Параметры.ПредГород      = АдресИнформированияСтруктура.Город;
			конецесли; 
			ШапкаОбласть.Параметры.ПредСело       = АдресИнформированияСтруктура.НаселенныйПункт;
			ШапкаОбласть.Параметры.ПредУлица      = АдресИнформированияСтруктура.Улица;
			ШапкаОбласть.Параметры.ПредДом        = АдресИнформированияСтруктура.Дом;
			ШапкаОбласть.Параметры.ПредКорпус     = АдресИнформированияСтруктура.Корпус;
			ШапкаОбласть.Параметры.ПредКвартира   = АдресИнформированияСтруктура.Квартира;
			
		КонецЕсли; 
		
		ШапкаОбласть.Параметры.стДатаПостановки       = Формат(Выборка.ДатаРегистрации, "ДФ='dd.MM.yyyy ""г""'");
		ШапкаОбласть.Параметры.ДатаСнятияСрегистрации = Формат(Выборка.ДатаСнятияСРегистрации, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если ВерсияМакета Тогда
			ШапкаОбласть.Параметры.ДатаДокумента          = Формат(Выборка.Дата, "ДФ='dd.MM.yyyy ""г.""'");
			
			ДолжностноеЛицоФИО = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Выборка.Организация, Выборка.ДолжностноеЛицо, Выборка.Дата, Ложь);
			Если ТипЗнч(ДолжностноеЛицоФИО) = Тип("Структура") Тогда
				ШапкаОбласть.Параметры.ДолжностноеЛицо 	= ДолжностноеЛицоФИО.ДолжностноеЛицо;
				ШапкаОбласть.Параметры.Должность 		= ДолжностноеЛицоФИО.Должность;
			КонецЕсли;
			
		КонецЕсли;
		ТабДокумент.Вывести(ШапкаОбласть);
		
		// Выбран макет с данными детей до 14 лет. 
		Если НЕ ВерсияМакета Тогда                                 
			
			СписокДетей = Объект.ФизическиеЛица.Выгрузить();
			МассивДляУдаления = Новый Массив;
			Для каждого ДанныеРебенка Из СписокДетей Цикл
				
				ДатаРождения = ДанныеРебенка.ФизическоеЛицо.ДатаРождения;
				
				ЧислоЛет = бит_ПаспортныйСтолКлиетСервер.КолвоПолныхЛет(ДатаРождения,Выборка.ДатаРегистрации);
				
				Если ЧислоЛет > 14 Тогда
					
					МассивДляУдаления.Добавить(ДанныеРебенка);
					
				КонецЕсли;
				
			КонецЦикла;
			
			Для каждого СтрокаМассива Из МассивДляУдаления  Цикл
				
				СписокДетей.Удалить(СтрокаМассива);
				
			КонецЦикла; 
			
			Если СписокДетей.Количество()>0 Тогда
				
				Для каждого СтрокаТЧ Из СписокДетей Цикл
					
					если СтрокаТЧ.ФизическоеЛицо = неопределено тогда
						продолжить
					конецесли; 
					
					ФИОФизЛица      = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(СтрокаТЧ.ФизическоеЛицо,Выборка.Дата, Ложь);
					
					Если ЗначениеЗаполнено(ФИОФизЛица) Тогда
						СтрокаОбласть.Параметры.ФизЛицо = ФИОФизЛица;
					Иначе
						СтрокаОбласть.Параметры.ФизЛицо = СтрокаТЧ.ФизическоеЛицо.Наименование;
					КонецЕсли;
					
					Если СтрокаТЧ.ФизическоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
						
						СтрокаОбласть.Параметры.Пол = "жен";
						
					ИначеЕсли СтрокаТЧ.ФизическоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
						
						СтрокаОбласть.Параметры.Пол = "муж";
						
					КонецЕсли;
					
					СтрокаОбласть.Параметры.ДатаРождения = Формат(СтрокаТЧ.ФизическоеЛицо.ДатаРождения,"ДФ=dd.MM.yyyy");
					
					Если ЗначениеЗаполнено(СтрокаТЧ.ФизическоеЛицо.МестоРождения) Тогда
						
						МестоРождения = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(СтрокаТЧ.ФизическоеЛицо.МестоРождения);
						СтрокаОбласть.Параметры.МестоРождения = МестоРождения;
						
					КонецЕсли; 
					
					ДокументФизЛица = бит_ПаспортныйСтолСервер.ПолучитьДанныеДокументаФизЛица(СтрокаТЧ.ФизическоеЛицо,Выборка.Дата);
					
					СтрокаОбласть.Параметры.СерияДок 	= ДокументФизЛица.ДокументСерия;
					СтрокаОбласть.Параметры.НомерДок 	= ДокументФизЛица.ДокументНомер;
					СтрокаОбласть.Параметры.ДатаДок  	= Формат(ДокументФизЛица.ДокументДатаВыдачи,"ДФ=dd.MM.yyyy" );
					СтрокаОбласть.Параметры.КемВыданДок = ДокументФизЛица.ДокументКемВыдан + ?(ЗначениеЗаполнено(ДокументФизЛица.ДокументКодПодразделения),"код " + ДокументФизЛица.ДокументКодПодразделения,"");
					
					ТабДокумент.Вывести(СтрокаОбласть);
				КонецЦикла; 
				
			КонецЕсли;
			
			ПодвалОбласть.Параметры.ДатаДокумента = Выборка.Дата;
			
			ТабДокумент.Вывести(ПодвалОбласть);
			
		КонецЕсли;
		
	Иначе
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните обязательные поля - Лицевой счет и Регистрируемое лицо и запишите документ";
		Сообщение.Сообщить();
	КонецЕсли; 
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ с печатной формой сличительной ведомости.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьСОРПМП()
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	ПОДСТРОКА(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения, 3, 200) КАК МестоРождения,
	|	ЕСТЬNULL(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("СОРПМП");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	Если Выборка.ПочтовыйАдрес <> Неопределено И Выборка.ПочтовыйАдрес <> NULL Тогда
		АдресПрибытия = Строка(Выборка.ПочтовыйАдрес)+", кв."+Строка(Выборка.КвартираРег);
		АдресПрибытия_1 = "";
		АдресПрибытия_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресПрибытия, 60, АдресПрибытия_1, АдресПрибытия_2);
		ШапкаОбласть.Параметры.АдресПрибытия_1 = АдресПрибытия_1;
		ШапкаОбласть.Параметры.АдресПрибытия_2 = АдресПрибытия_2;
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	
	Если Выборка.РегистрируемоеЛицо <> Неопределено Тогда
		
		МестоРождения_1 = "";
		МестоРождения_2 = "";
		
		МестоРожденияСтруктура = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.РегистрируемоеЛицо.МестоРождения);
		Если ЗначениеЗаполнено(МестоРожденияСтруктура) Тогда
			МестоРожденияСтрока = ?(ЗначениеЗаполнено(МестоРожденияСтруктура.НаселенныйПункт),МестоРожденияСтруктура.НаселенныйПункт +", ","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Село),", село (дер.): " + СокрЛП(МестоРожденияСтруктура.Село), "")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Район),МестоРожденияСтруктура.Район + " р-н, ","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Область),МестоРожденияСтруктура.Область + " обл.,","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Страна)," страна "+МестоРожденияСтруктура.Страна,"");
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(МестоРожденияСтрока, 60, МестоРождения_1, МестоРождения_2);
			ШапкаОбласть.Параметры.МестоРождения_1 = МестоРождения_1;
			ШапкаОбласть.Параметры.МестоРождения_2 = МестоРождения_2;
		КонецЕсли; 
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Выборка.Фамилия) Тогда
		ФИОФизЛицо = Строка(Выборка.Фамилия)+" "+ Строка(Выборка.Имя)+" "+Строка(Выборка.Отчество);
	Иначе
		ФИОФизЛицо = Строка(Выборка.РегистрируемоеЛицо);
	КонецЕсли; 
	
	// Перевод в родительный падеж.
	//ФизЛицо_Склон = "";
	//ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФИОФизЛицо,3,Выборка.РегистрируемоеЛицо.Пол,ФизЛицо_Склон);
	//Если ИсходСклонения Тогда
	//	ФизЛицо = ФизЛицо_Склон;
	//КонецЕсли;	
	
	ФизЛицо = ФИОФизЛицо + ", "+Строка(Формат(Выборка.ДатаРождения,"ДФ='yyyy ""г.р.""'"));
	ШапкаОбласть.Параметры.ФизЛицо = ФизЛицо;
	
	Если ЗначениеЗаполнено(Выборка.ДомРег) Тогда
		
		ШапкаОбласть.Параметры.ОрганУчета = Выборка.ДомРег.ПаспортнаяСлужба;				
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Выборка.ДатаРегистрации) Тогда
		
		ШапкаОбласть.Параметры.ЧислоРег    	= День(Выборка.ДатаРегистрации);
		ДатаМесяц 							= Формат(Выборка.ДатаРегистрации,"ДФ='дд.MMMM'");
		ШапкаОбласть.Параметры.МесяцРег 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
		ШапкаОбласть.Параметры.ГодРег     	= Формат(Выборка.ДатаРегистрации,"ДФ=yy");
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
		
		ШапкаОбласть.Параметры.ЧислоСнят    = День(Выборка.ДатаСнятияСРегистрации);
		ДатаМесяц 							= Формат(Выборка.ДатаСнятияСРегистрации,"ДФ='дд.MMMM'");
		ШапкаОбласть.Параметры.МесяцСнят 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
		ШапкаОбласть.Параметры.ГодСнят     	= Формат(Выборка.ДатаСнятияСРегистрации,"ДФ='yy'");
	КонецЕсли;
	ШапкаОбласть.Параметры.ЧислоТек    	= Выборка.Дата;
	ДатаМесяц 							= Формат(Выборка.Дата,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.МесяцТек 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ШапкаОбласть.Параметры.ГодТек     	= Выборка.Дата;
	
	ДолжностноеЛицоФИО = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Выборка.Организация, Выборка.ДолжностноеЛицо, Выборка.Дата, Ложь);
	Если ТипЗнч(ДолжностноеЛицоФИО) = Тип("Структура") Тогда
		ШапкаОбласть.Параметры.ДолжностноеЛицо = ДолжностноеЛицоФИО.ДолжностноеЛицо;
	КонецЕсли;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ с печатной формой сличительной ведомости.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьСОРПМПЖ()
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	ПОДСТРОКА(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения, 3, 200) КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ЕСТЬNULL(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДолжностноеЛицо
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("СОРПМПЖ");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	Если ЗначениеЗаполнено(Выборка.ПочтовыйАдрес) Тогда
		АдресПрибытия = Строка(Выборка.ПочтовыйАдрес)+", кв."+Строка(Выборка.КвартираРег);
		АдресПрибытия_1 = "";
		АдресПрибытия_2 = "";
		
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресПрибытия, 74, АдресПрибытия_1, АдресПрибытия_2);
		ШапкаОбласть.Параметры.АдресПрибытия_1 = АдресПрибытия_1;
		ШапкаОбласть.Параметры.АдресПрибытия_2 = АдресПрибытия_2;
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	
	Если Выборка.РегистрируемоеЛицо <> Неопределено Тогда
		МестоРождения_1 = "";
		МестоРождения_2 = "";
		МестоРожденияСтруктура = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.РегистрируемоеЛицо.МестоРождения);
		Если ЗначениеЗаполнено(МестоРожденияСтруктура) Тогда
			МестоРожденияСтрока = ?(ЗначениеЗаполнено(МестоРожденияСтруктура.НаселенныйПункт),МестоРожденияСтруктура.НаселенныйПункт +", ","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Село),", село (дер.): " + СокрЛП(МестоРожденияСтруктура.Село), "")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Район),МестоРожденияСтруктура.Район + " р-н, ","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Область),МестоРожденияСтруктура.Область + " обл.,","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Страна)," страна "+МестоРожденияСтруктура.Страна,"");
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(МестоРожденияСтрока, 60, МестоРождения_1, МестоРождения_2);
			ШапкаОбласть.Параметры.МестоРождения_1 = МестоРождения_1;
			ШапкаОбласть.Параметры.МестоРождения_2 = МестоРождения_2;
		КонецЕсли; 
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.ЧислоТек = Формат(Выборка.Дата,"ДФ=dd");
	ДатаМесяц 						= Формат(Выборка.Дата,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.МесяцТек	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ШапкаОбласть.Параметры.ГодТек	= Формат(Выборка.Дата,"ДФ=yy");
	
	Если ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента) Тогда 
		ШапкаОбласть.Параметры.ДеньДатаВыдачиДокумента  = Формат(Выборка.ДатаВыдачиДокумента,"ДФ=dd");
		ДатаМесяц 										= Формат(Выборка.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
		ШапкаОбласть.Параметры.МесяцДатаВыдачиДокумента	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
		ШапкаОбласть.Параметры.ГодДатаВыдачиДокумента	= Формат(Выборка.ДатаВыдачиДокумента,"ДФ=yy");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Фамилия) Тогда
		ФизЛицо = Строка(Выборка.Фамилия) + " " + Строка(Выборка.Имя) + " " + Строка(Выборка.Отчество);
	Иначе
		ФизЛицо = Строка(Выборка.РегистрируемоеЛицо);
	КонецЕсли;
	ФизЛицо = ФизЛицо + ", "+ Строка(Формат(Выборка.ДатаРождения,"ДФ='dd.MM.yyyy ""г.р.""'"));
	ШапкаОбласть.Параметры.ФизЛицо = ФизЛицо;
	
	Если ЗначениеЗаполнено(Выборка.ДомРег) Тогда
		
		ОрганУчета = Строка(Выборка.ДомРег.ПаспортнаяСлужба);
		ОрганУчета_1 = "";
		ОрганУчета_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ОрганУчета, 30, ОрганУчета_1, ОрганУчета_2);
		ШапкаОбласть.Параметры.ОрганУчета_1 = ОрганУчета_1;
		ШапкаОбласть.Параметры.ОрганУчета_2 = ОрганУчета_2;
		
	КонецЕсли;
	
	ДолжностноеЛицоФИО = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Выборка.Организация,Выборка.ДолжностноеЛицо, Выборка.Дата, Ложь);
	Если ТипЗнч(ДолжностноеЛицоФИО) = Тип("Структура") Тогда
		ШапкаОбласть.Параметры.ДолжностноеЛицо = ДолжностноеЛицоФИО.ДолжностноеЛицо;
		
	КонецЕсли;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ. 
// С макетом заявления.
// Параметры:
//  ВидЗаявления - логический, формирует шаблон в макете.
//  ТипМакета - логический, выбирает версии макета (версия 1 = Истина). 
// Возвращаемое значение:
//  Табличный документ - печатная форма заявления.
//
Функция ПечатьЗаявление(ВидЗаявления = Истина, ТипМакета = Истина)
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Объект.Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Дата,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.СтепеньРодства,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) И ЗначениеЗаполнено(Выборка.ЛицевойСчет) Тогда
		
		ТабДокумент  = Новый ТабличныйДокумент;
		
		ТабДокумент.КлючПараметровПечати = "ЗаявлениеСНГиРФ";
		Макет         = Документы.бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПолучитьМакет("Заявление");                       
		ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
		
		Если ТипМакета Тогда
			
			ШапкаТекст		  = Макет.ПолучитьОбласть("Текст1");
			СтрокаОбласть	  = Макет.ПолучитьОбласть("СтрокаЖильцов");
			ПодвалОбласть	  = Макет.ПолучитьОбласть("Подвал1");
			
			Если ВидЗаявления Тогда
				ВидМеста = "пребывания";
			Иначе
				ВидМеста = "проживания";
			КонецЕсли;
			
		Иначе
			
			ШапкаТекст		  = Макет.ПолучитьОбласть("Текст2");
			ПодвалОбласть	  = Макет.ПолучитьОбласть("Подвал2");
			
			Если ВидЗаявления Тогда
				ВидМеста = "пребывания";
			Иначе
				ВидМеста = "жительства";
			КонецЕсли;
			
			ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
			
		КонецЕсли;
		
		Кому = "";
		ОтКого = "";
		
		РегистрируемоеЛицо_1 = "";
		РегистрируемоеЛицо_2 = "";
		
		СрокРегистрации 	= Неопределено;
		АдресПрибытия 		= Неопределено;
		
		Если Выборка.ВидОперации <> Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета Тогда
			Если ЗначениеЗаполнено(Выборка.ЛицевойСчет)И ЗначениеЗаполнено(Выборка.ЛицевойСчет.Здание) И ЗначениеЗаполнено(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба) Тогда
				РуководительУФМС = "";
				Если ТипЗнч(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба) = Тип("СправочникСсылка.Контрагенты") Тогда
					КонтактЛицо = Строка(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба.ОсновноеКонтактноеЛицо);
					Если ЗначениеЗаполнено(КонтактЛицо) Тогда
						РуководительУФМС_1 = "";
						РуководительУФМС = КонтактЛицо;
						ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(КонтактЛицо,3,,РуководительУФМС_1);
						РуководительУФМС = ВРег(РуководительУФМС_1);
					КонецЕсли;
					
				КонецЕсли;
				
				СтрокаПаспортСлужба = Строка(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба);  
				ПервыйПробел = Найти(СтрокаПаспортСлужба, " "); 
				
				Если ПервыйПробел > 0 Тогда
					ПервоеСлово = Сред(СтрокаПаспортСлужба,1,ПервыйПробел-1);
					ПервоеСловоВерхРег = ВРег(ПервоеСлово);
					
					Если ПервоеСловоВерхРег <> ПервоеСлово  Тогда
						
						СтрокаПаспортСлужба = СтрЗаменить(СтрокаПаспортСлужба,ПервоеСлово,"");
						ПервоеСловоСклон = "";
						ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ПервоеСлово,2,,ПервоеСловоСклон);
						
						Если ИсходСклонения Тогда
							СтрокаПаспортСлужба = ПервоеСловоСклон + СтрокаПаспортСлужба;
						Иначе
							СтрокаПаспортСлужба = Строка(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба);
						КонецЕсли;
						
					КонецЕсли; 
					
					Кому = "Начальнику " + СтрокаПаспортСлужба;
					
				Иначе 
					
					Кому = "Начальнику ";
					
				КонецЕсли;
				
				Кому = Кому + " " + Символ(13) + РуководительУФМС;
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.ОтветственныйЗаРегистрацию) Тогда
				ШапкаОбласть.Параметры.Заполнить(Объект);
				// Перевод в родительный падеж.
				ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(Строка(Выборка.ОтветственныйЗаРегистрацию),2,Выборка.ОтветственныйЗаРегистрацию.Пол,ОтКого);
				
				ДанныеПаспорта = бит_ПаспортныйСтолСервер.ПолучитьПаспортныеДанныеСтрокой(Выборка.ОтветственныйЗаРегистрацию, Выборка.Дата, Ложь);
				Если ЗначениеЗаполнено(ДанныеПаспорта) Тогда
					ДанныеПаспорта = "";
				КонецЕсли;
				
				Если НЕ ИсходСклонения Тогда
					ОтКого = Строка(Выборка.ОтветственныйЗаРегистрацию);
				КонецЕсли;
				
				Если ЗначениеЗаполнено(Выборка.ОтветственныйЗаРегистрацию.ДатаРождения) Тогда
					
					ДатаРождения = Формат(Выборка.ОтветственныйЗаРегистрацию.ДатаРождения,"ДФ='dd.MM.yyyy ""г.р.""'");
					ОтКого  = "от " + ОтКого + " "+ ДатаРождения + Символ(13) + ДанныеПаспорта;
					
				Иначе
					
					ОтКого  = "от " + ОтКого + Символ(13) + ДанныеПаспорта;
				КонецЕсли;
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) Тогда
				
				РегистрируемоеЛицоЛС = "";
				
				ФИОРегЛица = "";
				ФИОРегЛица = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(Выборка.РегистрируемоеЛицо, Выборка.Дата, Ложь);
				Если ФИОРегЛица = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ФИОРегЛица) Тогда
					ФИОРегЛица = Строка(Выборка.РегистрируемоеЛицо);
				КонецЕсли;
				
				//Если ТипМакета Тогда
				//	ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФИОРегЛица,4,Выборка.РегистрируемоеЛицо.Пол,РегистрируемоеЛицоЛС);
				//	// ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФИОРегЛица,2,ПолРегЛица,РегистрируемоеЛицоЛС);.
				//Иначе
				//	ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФИОРегЛица,3,Выборка.РегистрируемоеЛицо.Пол,РегистрируемоеЛицоЛС);
				//КонецЕсли;
				
				//Если ИсходСклонения Тогда
				//	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(РегистрируемоеЛицоЛС, 70, РегистрируемоеЛицо_1, РегистрируемоеЛицо_2);
				//	РегЛицо = РегистрируемоеЛицоЛС;
				//Иначе
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Строка(Выборка.РегистрируемоеЛицо), 70, РегистрируемоеЛицо_1, РегистрируемоеЛицо_2);
				РегЛицо = Строка(Выборка.РегистрируемоеЛицо);
				//КонецЕсли; 
				
			КонецЕсли; 
			
			АдресЛС = "";
			Если ЗначениеЗаполнено(Выборка.ОтветственныйЗаРегистрацию) Тогда
				АдресПоПрописке = бит_ПаспортныйСтолСервер.ПолучитьАдресИзКонтактнойИнформации(Выборка.ОтветственныйЗаРегистрацию, "Юридический");
				Если НЕ ПустаяСтрока(АдресПоПрописке) Тогда
					АдресЛС = АдресПоПрописке;
					
				ИначеЕсли ЗначениеЗаполнено(Выборка.ЛицевойСчет) Тогда
					
					Если ЗначениеЗаполнено(Выборка.ЛицевойСчет.Здание.ПочтовыйАдрес) Тогда
						
						АдресЛС = Строка(Выборка.ЛицевойСчет.Здание.ПочтовыйАдрес)+ ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.Квартира), ", кв." + Строка(Выборка.ЛицевойСчет.Квартира),"");
						
					Иначе
						УлицаАдреса = ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.УлицаЛицевогоСчета),"ул. " + Строка(Выборка.ЛицевойСчет.УлицаЛицевогоСчета),"");
						ДомАдреса = ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.Здание),", д. " + Строка(Выборка.ЛицевойСчет.Здание),"");
						КорпусАдреса = ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.Здание.Корпус),", корп. " + Строка(Выборка.ЛицевойСчет.Здание.Корпус),"");
						КвартираАдреса = ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.Квартира),", кв. " + Строка(Выборка.ЛицевойСчет.Квартира),"");
						
						АдресЛС =  УлицаАдреса + ДомАдреса + КорпусАдреса + КвартираАдреса;  
						
					КонецЕсли; 
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Формирования срока прописки прописью.
			Если ЗначениеЗаполнено(Выборка.ДатаРегистрации) и ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
				
				СрокРегистрации = бит_ПаспортныйСтолКлиетСервер.ПериодПрописью(Выборка.ДатаРегистрации,Выборка.ДатаСнятияСРегистрации);
				
			КонецЕсли;
			
			АдресПрибытия = "";
			Если ЗначениеЗаполнено(Выборка.ЛицевойСчет) Тогда
				
				Если ЗначениеЗаполнено(Выборка.ЛицевойСчет.Здание.ПочтовыйАдрес) Тогда
					
					АдресПрибытия = Строка(Выборка.ЛицевойСчет.Здание.ПочтовыйАдрес)+ ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.Квартира), ", кв." + Строка(Выборка.ЛицевойСчет.Квартира),"");
					
				Иначе
					УлицаАдреса = ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.УлицаЛицевогоСчета),"ул. " + Строка(Выборка.ЛицевойСчет.УлицаЛицевогоСчета),"");
					ДомАдреса = ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.Здание),", д. " + Строка(Выборка.ЛицевойСчет.Здание),"");
					КорпусАдреса = ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.Здание.Корпус),", корп. " + Строка(Выборка.ЛицевойСчет.Здание.Корпус),"");
					КвартираАдреса = ?(ЗначениеЗаполнено(Выборка.ЛицевойСчет.Квартира),", кв. " + Строка(Выборка.ЛицевойСчет.Квартира),"");
					
					АдресПрибытия =  УлицаАдреса + ДомАдреса + КорпусАдреса + КвартираАдреса;  
					
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли;
		
		СтруктураДляМакета = Новый Структура("Кому,ОтКого,РегЛицо, РегистрируемоеЛицо_1,РегистрируемоеЛицо_2,АдресЛС,ВидМеста,СрокРегистрации,АдресПрибытия,ОтветственныйЗаРегистрацию"
		,Кому,ОтКого,РегЛицо, РегистрируемоеЛицо_1,РегистрируемоеЛицо_2,АдресЛС,ВидМеста,СрокРегистрации,АдресПрибытия,Строка(Выборка.ОтветственныйЗаРегистрацию));
		
		ШапкаОбласть.Параметры.Заполнить(СтруктураДляМакета);
		ТабДокумент.Вывести(ШапкаОбласть);
		
		ШапкаТекст.Параметры.Заполнить(СтруктураДляМакета);
		Если НЕ ТипМакета тогда
			
			ДокументОсн = Выборка.ДокументОснование;
			ШапкаТекст.Параметры.ДокументОснование = ДокументОсн.Наименование + ?(ЗначениеЗаполнено(ДокументОсн.НомерДокумента)," №" + ДокументОсн.НомерДокумента,"")
			+ ?(ЗначениеЗаполнено(ДокументОсн.ДатаДокумента)," от " + Формат(ДокументОсн.ДатаДокумента,"ДЛФ=DD"),"");
			
			СтепеньРодстваИтог = "";
			Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				СтепеньРодстваИтог = "моему ";
			ИначеЕсли Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				СтепеньРодстваИтог = "моей ";
			КонецЕсли;
			
			СтепеньРодстваЛС = "";
			//ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(Строка(Выборка.СтепеньРодства),3,,СтепеньРодстваЛС);
			//Если ИсходСклонения Тогда
			//	СтепеньРодстваИтог = СтепеньРодстваИтог + СтепеньРодстваЛС;
			//Иначе
			СтепеньРодстваИтог = СтепеньРодстваИтог + Строка(Выборка.СтепеньРодства);
			//КонецЕсли; 
			ШапкаТекст.Параметры.СтепеньРодства = СтепеньРодстваИтог;
			
		КонецЕсли;
		
		ТабДокумент.Вывести(ШапкаТекст);
		
		Если ТипМакета Тогда
			// Вывод строк с проживающими по ЛС.
			Если Выборка.ВидОперации <> Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета Тогда
				
				// Формирование списка совершеннолетних, заполненных в таб части формы на вкладке "Доп. данные".
				СписокПроживающих = Объект.ФизическиеЛица.Выгрузить();
				МассивДляУдаления = Новый Массив;
				Для каждого ДанныеПроживающего Из СписокПроживающих Цикл
					
					ДатаРождения = ДанныеПроживающего.ФизическоеЛицо.ДатаРождения;
					
					ЧислоЛет = бит_ПаспортныйСтолКлиетСервер.КолвоПолныхЛет(ДатаРождения,Выборка.ДатаРегистрации);
					
					Если ЧислоЛет < 18 Тогда
						МассивДляУдаления.Добавить(ДанныеПроживающего);
					КонецЕсли;
					
				КонецЦикла;
				
				Для каждого СтрокаМассива Из МассивДляУдаления  Цикл
					
					СписокПроживающих.Удалить(СтрокаМассива);
					
				КонецЦикла; 
				Если СписокПроживающих.Количество()>0 Тогда
					
					Для каждого СтрокаТЧ Из СписокПроживающих Цикл
						
						ФИОФизЛица = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(СтрокаТЧ.ФизическоеЛицо,Выборка.Дата, Ложь);
						
						Если ЗначениеЗаполнено(ФИОФизЛица) Тогда
							СтрокаОбласть.Параметры.ЖилецЛС = ФИОФизЛица;
						Иначе
							СтрокаОбласть.Параметры.ЖилецЛС = СтрокаТЧ.ФизическоеЛицо.Наименование;
						КонецЕсли;
						ТабДокумент.Вывести(СтрокаОбласть);
					КонецЦикла;
					
				Иначе 
					
					КолвоСтрок = 3;
					Для Счетчик = 1 По КолвоСтрок Цикл
						ТабДокумент.Вывести(СтрокаОбласть);
					КонецЦикла; 
					
				КонецЕсли;		
			Иначе
				
				КолвоСтрок = 3;
				Для Счетчик = 1 По КолвоСтрок Цикл
					ТабДокумент.Вывести(СтрокаОбласть);
				КонецЦикла; 
				
			КонецЕсли;
			
		КонецЕсли;     
		
		Если ЗначениеЗаполнено(Выборка.ДатаРегистрации) тогда
			ДатаЗаявления = Выборка.ДатаРегистрации;
		ИначеЕсли ЗначениеЗаполнено(Выборка.Дата) Тогда
			ДатаЗаявления = Выборка.Дата;
		Иначе 
			ДатаЗаявления = ТекущаяДата();
		КонецЕсли;
		
		Если ТипМакета Тогда
			
			ПодвалОбласть.Параметры.День 	= Формат(ДатаЗаявления ,"ДФ=dd");
			ПодвалОбласть.Параметры.Месяц 	= Формат(ДатаЗаявления ,"ДФ=MM");
			ПодвалОбласть.Параметры.Год 	= Формат(ДатаЗаявления ,"ДФ='yyyy ""г.""'");
		Иначе
			ПодвалОбласть.Параметры.ДатаРегистрации = Формат(ДатаЗаявления, "ДЛФ=DD");
			КолвоСтрок = 3;
			Для Счетчик = 1 По КолвоСтрок Цикл
				ТабДокумент.Вывести(ОбластьПустаяСтрока);
			КонецЦикла; 
			
		КонецЕсли;	
		
		ТабДокумент.Вывести(ПодвалОбласть);
		
	Иначе
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните обязательные поля - Лицевой счет и Регистрируемое лицо и запишите документ");
		
	КонецЕсли; 
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Параметры:
//  Объект      - СправочникСсылка - Физ лицо/Контрагент/Организация,
//  ВидОбъекта  - ПеречислениеСсылка - Вид объекта контактной информации.
//
// Возвращаемое значение:
//   Таблица значений   - содержит контактную информацию.
//
Функция ПолучитьКИ(Объект, ВидОбъекта)
	
	Запрос = Новый Запрос;
	
	// Замена указаний типовых объектов на объекты БИТ в тексте модуля.
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВложенныйЗапрос.Вид КАК Вид,
	|	ВложенныйЗапрос.Тип КАК Тип,
	|	ВложенныйЗапрос.Объект КАК Объект,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле1) КАК Поле1,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле2) КАК Поле2,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле3) КАК Поле3,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле4) КАК Поле4,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле5) КАК Поле5,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле6) КАК Поле6,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле7) КАК Поле7,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле8) КАК Поле8,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле9) КАК Поле9,
	|	МАКСИМУМ(ВложенныйЗапрос.Поле10) КАК Поле10,
	|	МАКСИМУМ(ВложенныйЗапрос.ТипДома) КАК ТипДома,
	|	МАКСИМУМ(ВложенныйЗапрос.ТипКорпуса) КАК ТипКорпуса,
	|	МАКСИМУМ(ВложенныйЗапрос.ТипКвартиры) КАК ТипКвартиры,
	|	МАКСИМУМ(ВложенныйЗапрос.Представление) КАК Представление,
	|	МАКСИМУМ(ВложенныйЗапрос.Комментарий) КАК Комментарий,
	|	МАКСИМУМ(ВложенныйЗапрос.ЗначениеПоУмолчанию) КАК ЗначениеПоУмолчанию
	|ИЗ
	|	(ВЫБРАТЬ
	|		&Объект КАК Объект,
	|		ВидыКонтактнойИнформации.Тип КАК Тип,
	|		ВидыКонтактнойИнформации.Ссылка КАК Вид,
	|		"""" КАК Представление,
	|		"""" КАК Поле1,
	|		"""" КАК Поле2,
	|		"""" КАК Поле3,
	|		"""" КАК Поле4,
	|		"""" КАК Поле5,
	|		"""" КАК Поле6,
	|		"""" КАК Поле7,
	|		"""" КАК Поле8,
	|		"""" КАК Поле9,
	|		"""" КАК Поле10,
	|		"""" КАК ТипДома,
	|		"""" КАК ТипКорпуса,
	|		"""" КАК ТипКвартиры,
	|		"""" КАК Комментарий,
	|		"""" КАК ЗначениеПоУмолчанию
	|	ИЗ
	|		"+?(ТипЗнч(Объект) = Тип("СправочникСсылка.бит_Проживающие"),"Справочник.бит_ВидыКонтактнойИнформации", "Справочник.бит_ВидыКонтактнойИнформации")+" КАК ВидыКонтактнойИнформации
	|	ГДЕ
	|		(НЕ ВидыКонтактнойИнформации.ПометкаУдаления)
	|		И ВидыКонтактнойИнформации.ВидОбъектаКонтактнойИнформации = &ВидОбъектаКонтактнойИнформации
	|	
	|	ОБЪЕДИНИТЬ
	|	
	|	ВЫБРАТЬ
	|		РегистрСведенийКонтактнаяИнформация.Объект,
	|		РегистрСведенийКонтактнаяИнформация.Тип,
	|		РегистрСведенийКонтактнаяИнформация.Вид,
	|		ВЫРАЗИТЬ(РегистрСведенийКонтактнаяИнформация.Представление КАК СТРОКА(1000)),
	|		РегистрСведенийКонтактнаяИнформация.Поле1,
	|		РегистрСведенийКонтактнаяИнформация.Поле2,
	|		РегистрСведенийКонтактнаяИнформация.Поле3,
	|		РегистрСведенийКонтактнаяИнформация.Поле4,
	|		РегистрСведенийКонтактнаяИнформация.Поле5,
	|		РегистрСведенийКонтактнаяИнформация.Поле6,
	|		РегистрСведенийКонтактнаяИнформация.Поле7,
	|		РегистрСведенийКонтактнаяИнформация.Поле8,
	|		РегистрСведенийКонтактнаяИнформация.Поле9,
	|		РегистрСведенийКонтактнаяИнформация.Поле10,
	|		РегистрСведенийКонтактнаяИнформация.ТипДома,
	|		РегистрСведенийКонтактнаяИнформация.ТипКорпуса,
	|		РегистрСведенийКонтактнаяИнформация.ТипКвартиры,
	|		ВЫРАЗИТЬ(РегистрСведенийКонтактнаяИнформация.Комментарий КАК СТРОКА(1000)),
	|		РегистрСведенийКонтактнаяИнформация.ЗначениеПоУмолчанию
	|	ИЗ
	|		"+?(ТипЗнч(Объект) = Тип("СправочникСсылка.бит_Проживающие"),"РегистрСведений.бит_КонтактнаяИнформация", "РегистрСведений.бит_КонтактнаяИнформация")+" КАК РегистрСведенийКонтактнаяИнформация
	|	ГДЕ
	|		РегистрСведенийКонтактнаяИнформация.Объект = &Объект) КАК ВложенныйЗапрос
	|
	|СГРУППИРОВАТЬ ПО
	|	ВложенныйЗапрос.Вид,
	|	ВложенныйЗапрос.Тип,
	|	ВложенныйЗапрос.Объект
	|
	|УПОРЯДОЧИТЬ ПО
	|	Представление УБЫВ,
	|	ВложенныйЗапрос.Тип.Порядок,
	|	Вид";
	
	Запрос.УстановитьПараметр("ВидОбъектаКонтактнойИнформации", ВидОбъекта);
	Запрос.УстановитьПараметр("Объект", Объект);
	
