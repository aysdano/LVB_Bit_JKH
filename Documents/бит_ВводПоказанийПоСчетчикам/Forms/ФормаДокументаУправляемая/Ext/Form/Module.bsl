&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ДокументОбъект           = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	// Вызов механизма разделения прав доступа.
	бит_ПраваДоступа.ПередОткрытиемФормы(Отказ,СтандартнаяОбработка,ДокументОбъект,ЭтаФорма);
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	Если Параметры.Свойство("ЗаполнитьИзСправочникаЛицевыеСчета") Тогда
		
		Объект.Дата               = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Дата;
		Объект.ЛицевойСчет        = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ЛицевойСчет;
		Объект.Улица              = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Улица;
		Объект.Дом                = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Дом;
		Объект.ТипСчетчика        = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ТипСчетчика;
		Объект.ВидОперации        = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ВидОперации;
		Объект.ПоказанияНаселения = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ПоказанияНаселения;
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		ДокументОбъект.ЗаполнитьТаблицуПоказаний();
		
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
		ПодготовитьФормуНаСервере();
		
	КонецЕсли;
	
	Если Параметры.Свойство("ЗаполнитьИзДокументаЧекККМ") Тогда
		
		Объект.Дата               = Параметры.ЗаполнитьИзДокументаЧекККМ.Дата;
		Объект.ВидОперации        = Параметры.ЗаполнитьИзДокументаЧекККМ.ВидОперации;
		Объект.Организация        = Параметры.ЗаполнитьИзДокументаЧекККМ.Организация;
		Объект.ЛицевойСчет        = Параметры.ЗаполнитьИзДокументаЧекККМ.ЛицевойСчет;
		Объект.Ответственный      = Параметры.ЗаполнитьИзДокументаЧекККМ.Ответственный;
		Объект.Улица              = Параметры.ЗаполнитьИзДокументаЧекККМ.Улица;
		Объект.ТипСчетчика        = Параметры.ЗаполнитьИзДокументаЧекККМ.ТипСчетчика;
		Объект.ПоказанияНаселения = Параметры.ЗаполнитьИзДокументаЧекККМ.ПоказанияНаселения;
		
		Объект.ПоказанияПоСчетчикам.Очистить();
		
		Для каждого Счетчик Из Параметры.ЗаполнитьИзДокументаЧекККМ.МассивСчетчиков Цикл
			
			Если Счетчик.ТекущиеПоказания <> 0  Тогда
				
				НоваяСтрока = Объект.ПоказанияПоСчетчикам.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Счетчик);
				
				НоваяСтрока.ЛицевойСчет = Параметры.ЗаполнитьИзДокументаЧекККМ.ЛицевойСчет;
				
				КолЕдиниц = 0 ;
				
				Если Счетчик.ПредыдущиеПоказания > Счетчик.ТекущиеПоказания Тогда
					
					КолЕдиниц = Счетчик.Разрядность - Счетчик.ПредыдущиеПоказания + Счетчик.ТекущиеПоказания + 1;
					
				Иначе
					
					КолЕдиниц = Счетчик.ТекущиеПоказания - Счетчик.ПредыдущиеПоказания;
					
				КонецЕсли; 
				
				НоваяСтрока.КоличествоЕдиницПоСчетчику = КолЕдиниц;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		ДокументОбъект.Записать(РежимЗаписиДокумента.Запись);
		
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
		
	КонецЕсли;
	
	// Установить видимость реквизитов и заголовков колонок.	
	УправлениеЭлементамиФормы();
	
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(ДокументОбъект, Отказ);
	
	ПриОткрытииНаСервере();
	
КонецПроцедуры

&НаСервере
