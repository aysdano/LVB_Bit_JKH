
#Область ВыводМакета

// Процедура формирует и выводит отчет.
//
// Параметры:
//       ТабДок  - ЭлементФормы.
//
Процедура СпискиПроживающихРодившихсяЗаПериодВывести(Момент,ДатаНач, ДатаКон, ТабДок,РезультатЗапроса) Экспорт 
	
	ТабДок.Очистить();
	
	Выборка =РезультатЗапроса.Выбрать();
	Макет = ЭтотОбъект.ПолучитьМакет("Форма8");
	ЗаголовокОбласть = Макет.ПолучитьОбласть("Заголовок");
	ДеталиОбласть = Макет.ПолучитьОбласть("Детали");
	
	ЗаголовокОбласть.Параметры.ГодРождНач = Формат(ДатаНач,"ДФ=dd.MM.yyyy");
	ЗаголовокОбласть.Параметры.ГодРождКон = Формат(ДатаКон,"ДФ=dd.MM.yyyy");
	ТабДок.Вывести(ЗаголовокОбласть);
	
	НомерСтроки = 1;
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.Физлицо) Тогда
			
			ДеталиОбласть.Параметры.НомерСтроки = НомерСтроки;
			
			Если ЗначениеЗаполнено(Выборка.Фамилия) Тогда
				ФИО = Выборка.Фамилия +" "+ Выборка.Имя + " " + Выборка.Отчество;
			Иначе
				ФИО = Выборка.ФизЛицо;
			КонецЕсли; 
			
			Если Выборка.ФизЛицоПол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				Пол = "(М)"	;
			Иначе
				Пол = "(Ж)"	;
			КонецЕсли; 
			ДеталиОбласть.Параметры.ФИО = Строка(ФИО) + " " + Пол;
			
			Если ЗначениеЗаполнено(Выборка.ФактАдрес) Тогда
			
				МестоРегистрации  = Выборка.ФактАдрес;
			
			ИначеЕсли ЗначениеЗаполнено(Выборка.ЮрАдрес) Тогда
				МестоРегистрации  = Выборка.ЮрАдрес;
			ИначеЕсли ЗначениеЗаполнено(Выборка.Здание.ПочтовыйАдрес) Тогда
				МестоРегистрации = Выборка.Здание.ПочтовыйАдрес +", кв."+ Строка(Выборка.Квартира);
			КонецЕсли; 
			
			ДеталиОбласть.Параметры.МестоРегистрации = МестоРегистрации;
			ДеталиОбласть.Параметры.ДатаРождения  = Формат(Выборка.ДатаРождения,"ДФ=dd.MM.yyyy");
			
			НомерСтроки = НомерСтроки + 1;
			ТабДок.Вывести(ДеталиОбласть);
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти