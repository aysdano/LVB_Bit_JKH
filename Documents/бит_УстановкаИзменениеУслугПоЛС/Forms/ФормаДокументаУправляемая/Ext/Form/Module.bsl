	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	мКэшЗначений.мРежимПотребления = ТекущаяСтрока.РежимПотребления;
	
	бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ввод по строке не доступен. Воспользуйтесь кнопкой выбора элемента.");
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаСпособРасчетаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если Не (ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления")
		Или ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет")) Тогда
		
		ТекущаяСтрока.КоличествоЕдиницПотребления = 0;
		
	Иначе 
		
		СведенияПоУслуге = ЗаполнитьСведенияПоУслуге(Объект.Дата,
		?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет"),
		Объект.ЛицевойСчет,
		ТекущаяСтрока.ЛицевойСчет),
		?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета"),
		Объект.Услуга,
		ТекущаяСтрока.Услуга));
		
		ТекущаяСтрока.КоличествоЕдиницПотребления = СведенияПоУслуге.КоличествоЕдиницПотребления;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.СпособРасчета) Тогда
		
		ТекущаяСтрока.СпособРасчета = мКэшЗначений.мСпособРасчета;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаСпособРасчетаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета") Тогда
		
		РеквизитУслуга = Объект.Услуга;
		
	Иначе
		
		РеквизитУслуга = ТекущаяСтрока.Услуга;
		
	КонецЕсли;
	
	СписокВыбора = СформироватьСписокВыбораСпособовРасчета(РеквизитУслуга);
	
	// БИТ_ЖКХ 11.02.2015{{ избавление от модального вызова.
	// ВыбранныйЭлемент = ВыбратьИзСписка(СписокВыбора, Элементы.ЛицевыеСчетаСпособРасчета);.
	Оповещение = Новый ОписаниеОповещения("ОбработкаВыбораКлиента", ЭтаФорма,ТекущаяСтрока);
	//СписокВыбора.ПоказатьВыборЭлемента(Оповещение, "Выберите элемент");
	// БИТ ЖКХ 23.03.2020
	ПоказатьВыборИзСписка(Оповещение, СписокВыбора, ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбораКлиента(ВыбранныйЭлемент,ТекущаяСтрока) Экспорт
	
	Если ВыбранныйЭлемент <> Неопределено Тогда
		
		ТекущаяСтрока.СпособРасчета = ВыбранныйЭлемент.Значение;
		
	КонецЕсли;
	
	Если Не (ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления")
		Или ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет")) Тогда
		
		ТекущаяСтрока.КоличествоЕдиницПотребления = 0;
		
	Иначе 
		
		СведенияПоУслуге = ЗаполнитьСведенияПоУслуге(Объект.Дата,
		?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет"),
		Объект.ЛицевойСчет,
		ТекущаяСтрока.ЛицевойСчет),
		?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета"),
		Объект.Услуга,
		ТекущаяСтрока.Услуга));
		
		ТекущаяСтрока.КоличествоЕдиницПотребления = СведенияПоУслуге.КоличествоЕдиницПотребления;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ТекущаяСтрока.СпособРасчета) Тогда
		
		ТекущаяСтрока.СпособРасчета = мКэшЗначений.мСпособРасчета;
		
	КонецЕсли;
	
	мКэшЗначений.мСпособРасчета = ТекущаяСтрока.СпособРасчета;
	
КонецПроцедуры
// БИТ_ЖКХ 11.02.2015}}

