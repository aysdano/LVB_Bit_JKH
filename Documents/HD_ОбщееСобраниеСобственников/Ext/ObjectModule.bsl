//HD+
// Получает период проведения заочного голосования
// Возвращает:
//  Строка - период в формате "с 9:00 часов 01.01.2026 г. по 14:00 часов 12.01.2026 г."
//
Функция ПолучитьПериодПроведенияЗаочногоГолосования()
	
	Если НЕ ЗначениеЗаполнено(ДатаЗаочногоГолосования_Начало) И НЕ ЗначениеЗаполнено(ДатаЗаочногоГолосования_Окончание) Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаПериода = "";
	
	Если ЗначениеЗаполнено(ДатаЗаочногоГолосования_Начало) Тогда
		ВремяНачала = ФорматироватьВремяБезЛидирующегоНуля(ДатаЗаочногоГолосования_Начало);
		
		ДатаБезВремениНачала = НачалоДня(ДатаЗаочногоГолосования_Начало);
		ДатаНачала = Формат(ДатаБезВремениНачала, "ДФ=dd.MM.yyyy") + " г.";
		
		СтрокаПериода = "с " + ВремяНачала + " часов " + ДатаНачала;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ДатаЗаочногоГолосования_Окончание) Тогда
		ВремяОкончания = ФорматироватьВремяБезЛидирующегоНуля(ДатаЗаочногоГолосования_Окончание);
		
		ДатаБезВремениОкончания = НачалоДня(ДатаЗаочногоГолосования_Окончание);
		ДатаОкончания = Формат(ДатаБезВремениОкончания, "ДФ=dd.MM.yyyy") + " г.";
		
		Если СтрокаПериода <> "" Тогда
			СтрокаПериода = СтрокаПериода + " по " + ВремяОкончания + " часов " + ДатаОкончания;
		Иначе
			СтрокаПериода = "по " + ВремяОкончания + " часов " + ДатаОкончания;
		КонецЕсли;
	КонецЕсли;
	
	Возврат СтрокаПериода;
	
КонецФункции //HD-

