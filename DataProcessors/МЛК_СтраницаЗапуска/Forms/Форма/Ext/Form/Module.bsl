&НаСервере
Функция ПолучитьТаблицуОрганизаций()
	
	Запрос = Новый Запрос;
	Запрос.Текст =  "ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Организация КАК Организация
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.ПометкаУдаления = ЛОЖЬ" ;
	ТЗОрганизаций = Запрос.Выполнить().Выгрузить();
	Если ТЗОрганизаций.Количество()<>0 Тогда
		ТЗОрганизаций.Свернуть("Организация","");
		Возврат ТЗОрганизаций;
	Иначе
		ТЗОрганизаций = Новый ТаблицаЗначений;
		Возврат ТЗОрганизаций;
	КонецЕсли;
	
КонецФункции	

