#Область ПроцедурыОбработчикиСобытийТабличногоПоляСписокЛицевыхСчетов

&НаКлиенте
Процедура СписокЛицевыхСчетовВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяУслуга = Элементы.СписокУслуг.ТекущиеДанные;
	
	Если НЕ ВыбраннаяСтрока = Неопределено Тогда
		
		Отбор = Новый Структура;
		
		Для каждого ЭлементМассива Из ВыбраннаяСтрока Цикл
			
			Услуга = мКэшЗначений.ПустаяУслуга;
			
			Если НЕ ТекущаяУслуга = Неопределено Тогда
				Услуга = ТекущаяУслуга.Значение;
			КонецЕсли;
			
			Отбор.Очистить();
			Отбор.Вставить("Услуга"     , Услуга);
			Отбор.Вставить("ЛицевойСчет", ЭлементМассива);
			
			Поиск = Объект.ТаблицаВыбора.НайтиСтроки(Отбор);
			
			Если Поиск.Количество() > 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			НоваяСтрока = Объект.ТаблицаВыбора.Добавить();
			
			НоваяСтрока.Услуга      = Услуга;
			НоваяСтрока.ЛицевойСчет = ЭлементМассива;
			УлицаЛицевогоСчета = ПолучитьУлицуЛицевогоСчетаНаСервере(ЭлементМассива);
			Здание = ПолучитьЗданиеНаСервере(ЭлементМассива);
			Квартира = ПолучитьКвартируНаСервере(ЭлементМассива);
			НоваяСтрока.Адрес       = "ул. " + УлицаЛицевогоСчета + ", д. " + Здание + ", кв. " + Квартира;
			НоваяСтрока.Здание      = Здание
			
		КонецЦикла;
		
	КонецЕсли;
	
	ПересчитатьЭлементы();
	
КонецПроцедуры


