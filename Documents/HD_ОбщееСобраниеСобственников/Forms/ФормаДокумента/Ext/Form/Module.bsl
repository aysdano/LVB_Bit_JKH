//HD+
// Признак параметра/пути составного списка предложенных членов совета.
//
&НаСервере
Функция ЭтоИмяИлиПутьСпискаПредложенныхЧленовСовета(Знач ИмяПараметра, Знач ПутьСвязи)
	
	ИмяЭталон = ВРег(ИмяПараметраСпискаПредложенныхЧленовСовета());
	ПутьЭталон = ВРег(ПутьСвязиСпискаПредложенныхЧленовСовета());
	
	Если ЗначениеЗаполнено(ИмяПараметра) И ВРег(СокрЛП(Строка(ИмяПараметра))) = ИмяЭталон Тогда
		Возврат Истина;
	КонецЕсли;
	
	ПутьСтрокой = ВРег(СокрЛП(Строка(ПутьСвязи)));
	Если НЕ ЗначениеЗаполнено(ПутьСтрокой) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ПутьСтрокой = ПутьЭталон ИЛИ ПутьСтрокой = ИмяЭталон Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции //HD-

//HD+
// Собирает список «ФИО кв.N» (каждый с новой строки) только по заполненным ролям ПредложенныйЧленСовета_1.._5.
//
&НаСервере
Функция СформироватьСписокПредложенныхЧленовСовета()
	
	ЧастиСписка = Новый Массив;
	
	Для НомерРоли = 1 По 5 Цикл
		
		ИмяРоли = "ПредложенныйЧленСовета_" + Формат(НомерРоли, "ЧГ=");
		РольУчастника = ПолучитьРольУчастникаПоИмени(ИмяРоли);
		Если НЕ ЗначениеЗаполнено(РольУчастника) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаУчастника = НайтиСтрокуОргановСобранияПоРоли(РольУчастника);
		Если СтрокаУчастника = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
			Продолжить;
		КонецЕсли;
		
		ФИО = СокрЛП(Строка(СтрокаУчастника.Собственник));
		Если НЕ ЗначениеЗаполнено(ФИО) Тогда
			Продолжить;
		КонецЕсли;
		
		Квартира = СокрЛП(Строка(СтрокаУчастника.НомерКвартиры));
		Если ЗначениеЗаполнено(Квартира) Тогда
			ЧастиСписка.Добавить(ФИО + " кв." + Квартира);
		Иначе
			ЧастиСписка.Добавить(ФИО);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат СобратьМногострочныйСписокЧленовСоветаСРазделителями(ЧастиСписка);
	
КонецФункции //HD-

