		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Фамилия, "") КАК Фамилия,
	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Имя, "") КАК Имя,
	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Отчество, "") КАК Отчество,
	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия,
	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер,
	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан,
	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи,
	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.УлицаЛицевогоСчета КАК Улица,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание.НомерДома КАК НомерДома,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание.Корпус КАК Корпус,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира КАК Квартира,
	ЕСТЬNULL(АдресПрописки.Поле2, "") КАК Поле2,
	ЕСТЬNULL(АдресПрописки.Поле4, "") КАК Поле4,
	ЕСТЬNULL(АдресПрописки.Поле5, "") КАК Поле5
ИЗ
	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(, ФизЛицо = &amp;ФизЛицо) КАК бит_ПроживающиеПоЛССрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(, ФизЛицо = &amp;ФизЛицо) КАК бит_ФИОПроживающихСрезПоследних
		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(, ФизЛицо = &amp;ФизЛицо) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			бит_КонтактнаяИнформация.Объект КАК Объект,
			бит_КонтактнаяИнформация.Поле2 КАК Поле2,
			бит_КонтактнаяИнформация.Поле4 КАК Поле4,
			бит_КонтактнаяИнформация.Поле5 КАК Поле5
		ИЗ
			РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
		ГДЕ
			бит_КонтактнаяИнформация.Объект ССЫЛКА Справочник.бит_СписокЗданий
			И бит_КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.бит_ТипыКонтактнойИнформации.Адрес)
			И бит_КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания)) КАК АдресПрописки
		ПО бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание = АдресПрописки.Объект</query>
