			Оповещение = Новый ОписаниеОповещения("ВыбратьИзМенюЗавершение", ЭтотОбъект, ДополнительныеПараметры);
			ФормаОтчета.ПоказатьВыборИзМеню(Оповещение, СписокПунктовМеню, Элемент);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

Процедура ВыбратьИзМенюЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат <> Неопределено Тогда
		Если ТипЗнч(Результат.Значение) = Тип("Строка") Тогда
			
			СписокПолей = ДополнительныеПараметры.СписокПолей;
			ПоследняяГруппировка = ДополнительныеПараметры.ПоследняяГруппировка;
			
			
			Если ДополнительныеПараметры.ИдентификаторОбъекта = "бит_ВедомостьПоНачислениюПени" Тогда
				ФормаРасшифровка = ОткрытьФорму("Отчет.бит_РасшифровкаПоПене.Форма.ФормаОтчетаУправляемая");
			Иначе
				ФормаРасшифровка = ОткрытьФорму("Отчет.бит_РасшифровкаЛС.Форма.ФормаОтчетаУправляемая");
			КонецЕсли;
			
			ПараметрОрганизация   = ДополнительныеПараметры.ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
			
			Если ПараметрОрганизация  <> Неопределено Тогда
				ПараметрОрганизация.Значение = ДополнительныеПараметры.ФормаОтчета.Отчет.Организация; 
			КонецЕсли;
		
			ФормаРасшифровка.Отчет.НачалоПериода = ДополнительныеПараметры.ФормаОтчета.Отчет.НачалоПериода;
			ФормаРасшифровка.Отчет.КонецПериода = ДополнительныеПараметры.ФормаОтчета.Отчет.КонецПериода;
			
			ОрганизацияФорма          = ДополнительныеПараметры.ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Организация"));
			
			Если ОрганизацияФорма  <> Неопределено Тогда
				
				ОрганизацияФорма.Значение = ПараметрОрганизация.Значение;
				ОрганизацияФорма.Использование = Истина;
				
			КонецЕсли; 
			
			// Заполнение отборов.
			
			ФормаРасшифровка.Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
			
			Отбор = ФормаРасшифровка.Отчет.КомпоновщикНастроек.Настройки.Отбор.Элементы;
			
			Для каждого строка из ДополнительныеПараметры.СписокПунктовМеню Цикл
				
				Если ТипЗнч(строка.Значение) = Тип("СправочникСсылка.бит_ЛицевыеСчета") Тогда
					ЛицевойСчет = строка.Значение;
				ИначеЕсли ТипЗнч(строка.Значение) = Тип("СправочникСсылка.бит_СписокЗданий") Тогда 
					Здание = строка.Значение;
				ИначеЕсли ТипЗнч(строка.Значение) = Тип("СправочникСсылка.бит_УслугиЖКХ") Тогда 
					Услуга = строка.Значение;
				ИначеЕсли ТипЗнч(строка.Значение) = Тип("СправочникСсылка.бит_ПоставщикиУслуг") Тогда 
					Поставщик = строка.Значение;
				КонецЕсли;
				
			КонецЦикла;	
			
			Если ЛицевойСчет <> Неопределено Тогда
				
				Количество = Отбор.Количество();
				Для Индекс = 1 По Количество Цикл
					
					ЭлементСКонца = Отбор[Количество - Индекс];
					
					Поле = Новый ПолеКомпоновкиДанных("ЛицевойСчет");
					
					Если ЭлементСКонца.ЛевоеЗначение = Поле Тогда
						
						Отбор.Удалить(ЭлементСКонца);
						
					КонецЕсли;
					
				КонецЦикла;
				
				ДобавитьОтбор(ФормаРасшифровка.Отчет.КомпоновщикНастроек, "ЛицевойСчет", ЛицевойСчет, ВидСравненияКомпоновкиДанных.Равно);
				
			КонецЕсли; 
			
			Если Здание <> Неопределено Тогда
				
				Количество = Отбор.Количество();
				Для Индекс = 1 По Количество Цикл
					
					ЭлементСКонца = Отбор[Количество - Индекс];
					
					Поле = Новый ПолеКомпоновкиДанных("Здание");
					
					Если ЭлементСКонца.ЛевоеЗначение = Поле Тогда
						
						Отбор.Удалить(ЭлементСКонца);
						
					КонецЕсли;
					
				КонецЦикла;
				
				ДобавитьОтбор(ФормаРасшифровка.Отчет.КомпоновщикНастроек, "Здание", Здание, ВидСравненияКомпоновкиДанных.Равно);
				
			КонецЕсли; 
			
			Если Услуга <> Неопределено Тогда
				
				Количество = Отбор.Количество();
				Для Индекс = 1 По Количество Цикл
					
					ЭлементСКонца = Отбор[Количество - Индекс];
					
					Поле = Новый ПолеКомпоновкиДанных("Услуга");
					
					Если ЭлементСКонца.ЛевоеЗначение = Поле Тогда
						
						Отбор.Удалить(ЭлементСКонца);
						
					КонецЕсли;
					
				КонецЦикла;
				
				ДобавитьОтбор(ФормаРасшифровка.Отчет.КомпоновщикНастроек, "Услуга", Услуга, ВидСравненияКомпоновкиДанных.Равно);
				
			КонецЕсли; 
			
			Если Поставщик <> Неопределено Тогда
				
				Количество = Отбор.Количество();
				Для Индекс = 1 По Количество Цикл
					
					ЭлементСКонца = Отбор[Количество - Индекс];
					
					Поле = Новый ПолеКомпоновкиДанных("Поставщик");
					
					Если ЭлементСКонца.ЛевоеЗначение = Поле Тогда
						
						Отбор.Удалить(ЭлементСКонца);
						
					КонецЕсли;
					
				КонецЦикла;
				
				ДобавитьОтбор(ФормаРасшифровка.Отчет.КомпоновщикНастроек, "Поставщик", Поставщик, ВидСравненияКомпоновкиДанных.Равно);
				
			КонецЕсли; 
			
			// Заполняем Структуру группировок.
			
			Источник = ДополнительныеПараметры.ФормаОтчета.Отчет.КомпоновщикНастроек.Настройки.Структура;
			Приемник = ФормаРасшифровка.Отчет.КомпоновщикНастроек.Настройки.Структура;
			
			НастройкаСтруктурыСКД(Источник, Приемник, ФормаРасшифровка.Отчет.КомпоновщикНастроек,,ПоследняяГруппировка);
			
			ДобавитьОтбор(ФормаРасшифровка.Отчет.КомпоновщикНастроек, ПоследняяГруппировка, , ВидСравненияКомпоновкиДанных.НеРавно);
			
			// Заполнение полей выбора.
			
			ПоляВыбора = ФормаРасшифровка.Отчет.КомпоновщикНастроек.Настройки.Выбор.Элементы;
			ПоляВыбора.Очистить();
			
			Для каждого Элемент Из СписокПолей Цикл
				
				ПолеВыбора = ФормаРасшифровка.Отчет.КомпоновщикНастроек.Настройки.ДоступныеПоляВыбора.НайтиПоле(Новый ПолеКомпоновкиДанных(Элемент.Значение));
				Если ПолеВыбора <> Неопределено Тогда
					
					НовоеПолеВыбора = ПоляВыбора.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных")); 
					НовоеПолеВыбора.Поле = ПолеВыбора.Поле;
					
					Если ДополнительныеПараметры.ИдентификаторОбъекта <> "бит_ВедомостьПоНачислениюПени" Тогда
					
					ДобавитьОтбор(ФормаРасшифровка.Отчет.КомпоновщикНастроек, Элемент.Значение, 0, ВидСравненияКомпоновкиДанных.НеРавно);
					КонецЕсли;
				
				КонецЕсли;
				
			КонецЦикла;
			Оповестить("Расшифровка");	
			
			бит_ОтчетыКлиентСервер.УстановитьСостояниеПоляТабличногоДокумента(ДополнительныеПараметры.ФормаОтчета.Элементы.Результат,);
			// БИТ_ЖКХ 15.01.2015}}
			
		Иначе
			ПоказатьЗначение( , Результат.Значение);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
