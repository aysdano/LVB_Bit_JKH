			|ИЗ
			|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
			
			Запрос2.УстановитьПараметр("Момент"   ,КонецМесяца(ТекущаяДата()));
			Запрос2.УстановитьПараметр("Квартира" ,Строка.ЛицевойСчет.Квартира);
			
			Выборка = Запрос2.Выполнить().Выбрать();
			
