&НаСервере
Процедура ЗаполнитьВРегистреДокиПраваНаСервере()
	// Вставить содержимое обработчика.
	Запрос = новый запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПравоустанавливающиеДокументы.лб_НомерЛС10 КАК лб_НомерЛС10,
		|	бит_ПравоустанавливающиеДокументы.Ссылка КАК ПравоустанавливающиеДокументы,
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ПравоустанавливающиеДокументы КАК бит_ПравоустанавливающиеДокументы
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ПО (бит_ПравоустанавливающиеДокументы.лб_НомерЛС10 = ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 10))";
	Табл = Запрос.Выполнить().Выгрузить();
	Табл.Индексы.Добавить("ЛицевойСчет");
	
	ЗапросР = новый запрос;
	ЗапросР.УстановитьПараметр("Регистратор",ЭтаФорма.Регистратор);
	ЗапросР.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	бит_ПроживающиеПоЛС.Регистратор КАК Регистратор
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
		|ГДЕ
		|	бит_ПроживающиеПоЛС.Регистратор ССЫЛКА Документ.ОперацияБух
		|	И бит_ПроживающиеПоЛС.ПравоустанавливающиеДокументы = ЗНАЧЕНИЕ(Справочник.бит_ПравоустанавливающиеДокументы.ПустаяСсылка)
		|	И бит_ПроживающиеПоЛС.Регистратор = &Регистратор";
	
	Если не ЗначениеЗаполнено(Регистратор) тогда
		ЗапросР.Текст = СтрЗаменить(ЗапросР.Текст,"И бит_ПроживающиеПоЛС.Регистратор = &Регистратор","");
	КонецЕсли;
	
	ВыборкаР = ЗапросР.Выполнить().Выбрать();
	Пока ВыборкаР.Следующий() цикл  		
		Набор = РегистрыСведений.бит_ПроживающиеПоЛС.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Значение = ВыборкаР.Регистратор;
		Набор.Прочитать();
		
		ТекЛС = неопределено;
		ТекД = Табл[0];   		
		
		Для Каждого Зап из Набор цикл 	Если ТекЛС = Зап.ЛицевойСчет тогда СтокаД = ТекД иначе ТекЛС = Зап.ЛицевойСчет; СтрокаД = Табл.Найти(ТекЛС,"ЛицевойСчет") КонецЕсли; Если ТекД <>Неопределено тогда Зап.ПравоустанавливающиеДокументы = ТекД.ПравоустанавливающиеДокументы КонецЕсли; КонецЦикла;
		
		Если Набор.Модифицированность() тогда
			Набор.Записать(Истина)
		КонецЕсли;	
	КонецЦикла;	
КонецПроцедуры

