|		ПО (бит_ЛицевыеСчета.Здание = бит_НадписьКвитанцииСрезПоследних.Здание)
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НадписьКвитанции.СрезПоследних(
|				&Период,
|				Здание = ЗНАЧЕНИЕ(Справочник.бит_СписокЗданий.ПустаяСсылка)
|					И ШаблонКвитанции = &ШаблонКвитанции) КАК бит_НадписьКвитанцииСрезПоследнихПустая
|		ПО (ИСТИНА)
|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
|			ОрганизацииКонтактнаяИнформация.Ссылка КАК Ссылка,
|			ОрганизацииКонтактнаяИнформация.Представление КАК ТелефоныОрганизация
|		ИЗ
|			Справочник.Организации.КонтактнаяИнформация КАК ОрганизацииКонтактнаяИнформация
|		ГДЕ
|			ОрганизацииКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)) КАК ВложенныйЗапрос
|		ПО (бит_ЛицевыеСчета.Организация = ВложенныйЗапрос.Ссылка)
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
|		ПО (бит_ЛицевыеСчета.Здание = лб_Тест_Дома.Здание)
|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
|			КОЛИЧЕСТВО(бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК КоличествоПроживающих,
|			бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
|		ИЗ
|			РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ) КАК бит_ПроживающиеПоЛССрезПоследних
|		ГДЕ
|			НЕ бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.НеПроживает)
|		
|		СГРУППИРОВАТЬ ПО
|			бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет) КАК ПроживающиеПоЛС
|		ПО (бит_ЛицевыеСчета.Ссылка = ПроживающиеПоЛС.ЛицевойСчет)
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_НормативыОДН.СрезПоследних(&Период, ) КАК лб_НормативыОДНСрезПоследних
|		ПО (бит_ЛицевыеСчета.Здание = лб_НормативыОДНСрезПоследних.Адрес)
|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
|			ЕСТЬNULL(лб_ОДН_факт.ОДН_ХВ_М, 0) КАК ОДН_ХВ_М,
|			ЕСТЬNULL(лб_ОДН_факт.ОДН_ХВ_Р, 0) КАК ОДН_ХВ_Р,
|			ЕСТЬNULL(лб_ОДН_факт.ОДН_ГВ_М, 0) КАК ОДН_ГВ_М,
|			ЕСТЬNULL(лб_ОДН_факт.ОДН_ГВ_Р, 0) КАК ОДН_ГВ_Р,
|			ЕСТЬNULL(лб_ОДН_факт.ОДН_ЭЭ_кВт, 0) КАК ОДН_ЭЭ_кВт,
|			ЕСТЬNULL(лб_ОДН_факт.ОДН_ЭЭ_Р, 0) КАК ОДН_ЭЭ_Р,
|			ЕСТЬNULL(лб_ОДН_факт.ОДН_ВО_М, 0) КАК ОДН_ВО_М,
|			ЕСТЬNULL(лб_ОДН_факт.ОДН_ВО_Р, 0) КАК ОДН_ВО_Р,
|			лб_ОДН_факт.Адрес КАК Адрес
|		ИЗ
|			РегистрНакопления.лб_ОДН_факт КАК лб_ОДН_факт
|		ГДЕ
|			НАЧАЛОПЕРИОДА(лб_ОДН_факт.Период, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, -2), МЕСЯЦ)) КАК ФактОДН
|		ПО (бит_ЛицевыеСчета.Здание = ФактОДН.Адрес)
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЗначенияСвойствОбъектовУчетаПериодические.СрезПоследних(, ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ОсновнойРежимПотребления)) КАК бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних
|		ПО (бит_ЛицевыеСчета.Здание = бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних.ОбъектУчета)
|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
|			бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних.Значение КАК СпособРасчетаОДН,
|			бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних.ОбъектУчета КАК ОбъектУчета
|		ИЗ
|			РегистрСведений.бит_ЗначенияСвойствОбъектовУчетаПериодические.СрезПоследних(, ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_НастройиПечатиКвитанции)) КАК бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних) КАК СпособРасчета
|		ПО (бит_ЛицевыеСчета.Здание = СпособРасчета.ОбъектУчета)
|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Организации КАК Организации
|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.БанковскиеСчета КАК БанковскиеСчета
|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Банки КАК Банки
|				ПО (БанковскиеСчета.Банк = Банки.Ссылка)
|			ПО (Организации.ОсновнойБанковскийСчет = БанковскиеСчета.Ссылка)
|		ПО (бит_ЛицевыеСчета.Организация = Организации.Ссылка)
|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ТехническиеУчастки КАК бит_ТехническиеУчастки
|			ПО (бит_СписокЗданий.Участок = бит_ТехническиеУчастки.Ссылка)
|		ПО (бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка)
	|ГДЕ
	|	НЕ бит_ЛицевыеСчета.Архивный " + ТекстОтбор + "
	|	И ПОДСТРОКА(бит_ТехническиеУчастки.Код, 3, 1) <> """"
	|	И бит_СведенияОКвартиреСрезПоследних.ТипКвартиры " + ?(ДляНежилых, "=", "<>") + " &НежилоеПомещение
	|
	|УПОРЯДОЧИТЬ ПО
	|	Здание,
	|	ЛицевойСчет";  
	
КонецФункции

Функция ТекстЗапросаОсновная2023(ТекстОтборЗдания, ТекстОтборЛС, ДляНежилых) 
	
	Возврат "ВЫБРАТЬ
	        |	КОЛИЧЕСТВО(бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК КоличествоПроживающих,
	        |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	        |ПОМЕСТИТЬ ВТ_КоличествоПроживающих
	        |ИЗ
	        |	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ) КАК бит_ПроживающиеПоЛССрезПоследних
	        |ГДЕ
	        |	НЕ бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.НеПроживает)
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	        |	бит_ЛицевыеСчета.Здание КАК Здание,
	        |	бит_ЛицевыеСчета.ДомовойКомитет КАК ДомовойКомитет,
	        |	бит_ЛицевыеСчета.Квартира КАК Квартира,
	        |	бит_ЛицевыеСчета.Квартира.бит_НомерКвартирыДляСортировки КАК бит_НомерКвартирыДляСортировки,
	        |	бит_СведенияОКвартиреСрезПоследних.лб_НеВыводитьСтрокуДомофон КАК НеВыводитьДомофон,
	        |	лб_ОтветственныеЗаЛицевыеСчета.Ответственный КАК Ответственный,
	        |	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК КвартираПредставление,
	        |	бит_ЛицевыеСчета.Организация КАК ОрганизацияСсылка,
	        |	ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 4) + "" "" + ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 5, 7) КАК НомерЛС,
	        |	бит_ЛицевыеСчета.Наименование КАК ЛСНомер,
	        |	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	        |	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь КАК ЖилаяПлощадь,
	        |	бит_СведенияОКвартиреСрезПоследних.лб_НеВыводитьСтрокуДомофон КАК лб_НеВыводитьСтрокуДомофон,
	        |	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	        |	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	        |	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК лб_ПредставлениеКвартиры,
	        |	бит_ЛицевыеСчета.ЕЛСГИСЖКХ КАК ЕЛСГИСЖКХ,
	        |	ВТ_КоличествоПроживающих.КоличествоПроживающих КАК КоличествоПроживающих
	        |ПОМЕСТИТЬ ВТ_ЛицевыеСчета
	        |ИЗ
	        |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Период, ) КАК бит_СведенияОКвартиреСрезПоследних
	        |		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_ОтветственныеЗаЛицевыеСчета КАК лб_ОтветственныеЗаЛицевыеСчета
	        |		ПО бит_ЛицевыеСчета.Ссылка = лб_ОтветственныеЗаЛицевыеСчета.ЛицевойСчет
	        |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоПроживающих КАК ВТ_КоличествоПроживающих
	        |		ПО бит_ЛицевыеСчета.Ссылка = ВТ_КоличествоПроживающих.ЛицевойСчет
	        |ГДЕ
	        |	НЕ бит_ЛицевыеСчета.Архивный " + ТекстОтборЛС + "
	        |	И бит_СведенияОКвартиреСрезПоследних.ТипКвартиры  " + ?(ДляНежилых, "=", "<>") + " &НежилоеПомещение  
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ЕСТЬNULL(лб_ОДН_факт.ОДН_ХВ_М, 0) КАК ОДН_ХВ_М,
	        |	ЕСТЬNULL(лб_ОДН_факт.ОДН_ХВ_Р, 0) КАК ОДН_ХВ_Р,
	        |	ЕСТЬNULL(лб_ОДН_факт.ОДН_ГВ_М, 0) КАК ОДН_ГВ_М,
	        |	ЕСТЬNULL(лб_ОДН_факт.ОДН_ГВ_Р, 0) КАК ОДН_ГВ_Р,
	        |	ЕСТЬNULL(лб_ОДН_факт.ОДН_ЭЭ_кВт, 0) КАК ОДН_ЭЭ_кВт,
	        |	ЕСТЬNULL(лб_ОДН_факт.ОДН_ЭЭ_Р, 0) КАК ОДН_ЭЭ_Р,
	        |	ЕСТЬNULL(лб_ОДН_факт.ОДН_ВО_М, 0) КАК ОДН_ВО_М,
	        |	ЕСТЬNULL(лб_ОДН_факт.ОДН_ВО_Р, 0) КАК ОДН_ВО_Р,
	        |	лб_ОДН_факт.Адрес КАК Адрес
	        |ПОМЕСТИТЬ ВТ_Факт
	        |ИЗ
	        |	РегистрНакопления.лб_ОДН_факт КАК лб_ОДН_факт
	        |ГДЕ
	        |	НАЧАЛОПЕРИОДА(лб_ОДН_факт.Период, МЕСЯЦ) = НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Период, МЕСЯЦ, -2), МЕСЯЦ)
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	лб_НормативыОДНСрезПоследних.Адрес КАК Адрес,
	        |	лб_НормативыОДНСрезПоследних.НормативГВ КАК НормативГВ,
	        |	лб_НормативыОДНСрезПоследних.НормативВО КАК НормативВО,
	        |	лб_НормативыОДНСрезПоследних.НормативЭЭ КАК НормативЭЭ,
	        |	лб_НормативыОДНСрезПоследних.НормативНаПодогрев КАК НормативНаПодогрев,
	        |	лб_НормативыОДНСрезПоследних.МОП КАК МОП,
	        |	лб_НормативыОДНСрезПоследних.Подвал КАК Подвал,
	        |	лб_НормативыОДНСрезПоследних.Чердак КАК Чердак,
	        |	лб_НормативыОДНСрезПоследних.Жилая КАК Жилая,
	        |	лб_НормативыОДНСрезПоследних.Нежилая КАК Нежилая,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаХВ КАК СтоимостьКубаХВ,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКВтч КАК СтоимостьКВтч,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаВО КАК СтоимостьКубаВО,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьГКалл КАК СтоимостьГКалл,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаХВнаГВ КАК СтоимостьКубаХВнаГВ,
	        |	лб_НормативыОДНСрезПоследних.НормативХВ КАК НормативХВ,
			//shevtsov 04/05/26 Начало
			|	лб_НормативыОДНСрезПоследних.СпособНачисленияОДН КАК СпособНачисленияОДН,
			//shevtsov 04/05/26 Окончание
	        |	лб_НормативыОДНСрезПоследних.РежимПотребления КАК РежимПотребления
	        |ПОМЕСТИТЬ ВТ_Норматив
	        |ИЗ
	        |	РегистрСведений.лб_НормативыОДН.СрезПоследних(&Период, ) КАК лб_НормативыОДНСрезПоследних
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних.Значение КАК СпособРасчетаОДН,
	        |	бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних.ОбъектУчета КАК ОбъектУчета
	        |ПОМЕСТИТЬ ВТ_СпособРасчетаОДН
	        |ИЗ
	        |	РегистрСведений.бит_ЗначенияСвойствОбъектовУчетаПериодические.СрезПоследних(, ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_НастройиПечатиКвитанции)) КАК бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних.Значение КАК РежимПотребления,
	        |	бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних.ОбъектУчета КАК ОбъектУчета
	        |ПОМЕСТИТЬ ВТ_РежимПотребления
	        |ИЗ
	        |	РегистрСведений.бит_ЗначенияСвойствОбъектовУчетаПериодические.СрезПоследних(, ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.лб_ОсновнойРежимПотребления)) КАК бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	лб_Тест_Дома.ADR КАК ЗданиеПредставление,
	        |	бит_ТехническиеУчастки.ВремяРаботыУчастка КАК ВремяРаботыУчастка,
