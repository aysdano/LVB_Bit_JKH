// Процедура выполняет проверку заполнения шапки и таб. частей.
//
// Параметры:
// Отказ - булево.
// Заголовок  – Строка.
Процедура ПроверкаРеквизитов(Отказ,Заголовок)
	
	// Проверим заполнение шапки.
	СтруктураОбязательныхПолей = Новый Структура;
	СтруктураОбязательныхПолей.Вставить("Подразделение");
	СтруктураОбязательныхПолей.Вставить("ВидОбъекта");
	
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект,  СтруктураОбязательныхПолей,   Отказ, Заголовок);
	
КонецПроцедуры //ПроверкаРеквизитов()

// Проверяет правильность заполнения строк табличной части "Номенклатура".
//
// Параметры: 
//  ТаблицаСтавок - результат запроса, содержащий данные для проведения и проверки ТЧ СтавкиНаУслуги.
//  СтруктураШапкиДокумента   - структура, содержащая рексвизиты шапки документа и результаты запроса по шапке.
//  Отказ                     - флаг отказа в проведении.
//  Заголовок                 - строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеТабличнойЧастиЦеныНаРаботы(ТаблицаЦенНаРаботы, СтруктураШапкиДокумента, Отказ, Заголовок)
	
	ИмяТабличнойЧасти = "ЦеныНаРаботы";
	
	// Укажем, что надо проверить:
	СтруктураОбязательныхПолей = Новый Структура("Работа, ЕдиницаИзмерения, Норма, Цена, Валюта");
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "ЦеныНаРаботы", СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры // ПроверитьЗаполнениеТабличнойЧастиНоменклатура()

// Выгружает результат запроса в табличную часть, добавляет ей необходимые колонки для проведения.
//
// Параметры: 
//  РезультатЗапросаПоТоварам - результат запроса по табличной части "СтавкиНаУслуги",
//  СтруктураШапкиДокумента   - структура, содержащая рексвизиты шапки документа и результаты запроса по шапке.
//
// Возвращаемое значение:
//  Сформированная таблиица значений.
//
Функция ПодготовитьТаблицуЦенНаРаботы(РезультатЗапросаПоЦенам, СтруктураШапкиДокумента)
	
	ТаблицаЦенНаРаботы = РезультатЗапросаПоЦенам.Выгрузить();
	
	Возврат ТаблицаЦенНаРаботы;
	
КонецФункции // ПодготовитьТаблицуНоменклатуры()

// Процедура выполняет заполнение таблицы номенклатура.
//
Процедура ПодготовитьТаблицыДокумента(СтруктураШапкиДокумента, ТаблицаЦенНаРаботы) Экспорт
	
	// Получим необходимые данные для проведения и проверки заполенения данные по табличной части "ЦеныНаРаботы".
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("Работа"	       , "Работа");
	СтруктураПолей.Вставить("ЕдиницаИзмерения" , "ЕдиницаИзмерения");
	СтруктураПолей.Вставить("Норма"		       , "Норма");
	СтруктураПолей.Вставить("Цена"		       , "Цена");
	СтруктураПолей.Вставить("Валюта"	       , "Валюта");
	
	РезультатЗапросаПоЦенам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "ЦеныНаРаботы", СтруктураПолей);
	
	// Подготовим таблицы товаров для проведения.
	ТаблицаЦенНаРаботы      = ПодготовитьТаблицуЦенНаРаботы(РезультатЗапросаПоЦенам, СтруктураШапкиДокумента);
	
КонецПроцедуры	

// Процедура выполняет движения по регистрам.
//                
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента,ТаблицаЦенНаРаботы,Отказ,Заголовок)
	
	// Движения по регистру бит_СоставРабот.
	
	НаборЗаписей = Движения.бит_ЦеныРабот; 
	
	Для Каждого ТекСтрока Из ТаблицаЦенНаРаботы Цикл
		СтрокаДвижений = НаборЗаписей.Добавить();
		СтрокаДвижений.Период 			      = СтруктураШапкиДокумента.Дата;
		СтрокаДвижений.Подразделение		  = СтруктураШапкиДокумента.Подразделение;
		СтрокаДвижений.ВидОбъекта		      = СтруктураШапкиДокумента.ВидОбъекта;
		СтрокаДвижений.Работа 			      = ТекСтрока.Работа;
		СтрокаДвижений.ЕдиницаИзмерения	      = ТекСтрока.ЕдиницаИзмерения;
		СтрокаДвижений.Норма			      = ТекСтрока.Норма;
		СтрокаДвижений.Цена					  = ТекСтрока.Цена;
		СтрокаДвижений.Валюта		 	      = ТекСтрока.Валюта;
	КонецЦикла;
	
КонецПроцедуры //ДвиженияПоРегистрам()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	бит_ОбщегоНазначения.ПередЗаписьюДокументаДляУдаленияДвиженийПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
	ТЗРабот = ЦеныНаРаботы.Выгрузить(,"Работа");
	ТЗРабот.Свернуть("Работа");
	
	СписокРабот = "";
	Для каждого Строка Из ТЗРабот Цикл
		
		Если СписокРабот = "" Тогда
			СписокРабот = ""+Строка.Работа.Код;
		Иначе
			СписокРабот = ""+СписокРабот +", " +Строка.Работа.Код;
		КонецЕсли; 
		
	КонецЦикла; 
КонецПроцедуры

// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Перем ТаблицаЦенНаРаботы; // Хранит таблицу номенклатуры.
	
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	ПроверкаРеквизитов(Отказ,Заголовок);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	ПодготовитьТаблицыДокумента(СтруктураШапкиДокумента, ТаблицаЦенНаРаботы);
	
	ПроверитьЗаполнениеТабличнойЧастиЦеныНаРаботы(ТаблицаЦенНаРаботы, СтруктураШапкиДокумента, Отказ, Заголовок);
	
	// Выполним движения.
	Если НЕ Отказ Тогда
		ДвиженияПоРегистрам(СтруктураШапкиДокумента,ТаблицаЦенНаРаботы,Отказ,Заголовок);
	КонецЕсли; 
	
КонецПроцедуры

