						ЗаписьXML.ЗаписатьАтрибут("дата_окончания",Строка(Формат(Объект.ДатаОкончанияПланирования, "ДФ=dd.MM.yyyy")));
						
						ЗаписьXML.ЗаписатьКонецЭлемента(); // "C_"+Уровень4.Кодификатор+".".
						
						Если (Уровень3.Кодификатор = "4.2.1." или Уровень3.Кодификатор = "4.2.2.") Тогда
							
							СтрокиКоличество = Уровень3.Строки.Количество(); 
							ИндексТекСтроки = Уровень3.Строки.Индекс(Уровень4);
							
							Если ИндексТекСтроки = СтрокиКоличество-1 Тогда
								ЗаписьXML.ЗаписатьКонецЭлемента(); // Список.
							КонецЕсли;	
						КонецЕсли;
						
						ПредX = Уровень4.X;
						
					КонецЦикла;
					
					Если Уровень3.Кодификатор <> "4.2.1." и Уровень3.Кодификатор <> "4.2.2." Тогда
						ЗаписьXML.ЗаписатьКонецЭлемента(); // "C_"+Уровень3.Кодификатор+".".
					КонецЕсли;
					
				КонецЦикла;
				ЗаписьXML.ЗаписатьКонецЭлемента(); // "C_"+Уровень2.Кодификатор+".".
				
			КонецЦикла;
			ЗаписьXML.ЗаписатьКонецЭлемента(); // "C_"+Уровень1.Кодификатор+".".
			
		КонецЦикла;	
		
		ЗаписьXML.ЗаписатьКонецЭлемента(); // "C_"+Уровень0.Кодификатор+".".
	КонецЦикла;	
	
	ЗаписьXML.ЗаписатьКонецЭлемента(); // C_ЭП_МКД.
	ЗаписьXML.ЗаписатьКонецЭлемента(); // data.
	ЗаписьXML.Закрыть();
	
