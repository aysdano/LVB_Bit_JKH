&НаКлиенте
Процедура КоманднаяПанельНормыТрудаОсновная(Команда)
	
	
	ТекущаяСтрока = Элементы.НормыТруда.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		УстановитьОсновнаяНормаТрудаЛожьНаСервере(ТекущаяСтрока.Ссылка);
		
		Объект.ОсновнаяНормаТруда = ТекущаяСтрока.Ссылка;
		
		ТекущаяСтрока.Основная          = Истина;
		
		Элементы.НормыТруда.Обновить();
		
	КонецЕсли;
		
КонецПроцедуры

&НаСервере
Процедура УстановитьОсновнаяНормаТрудаЛожьНаСервере(СсылкаОсновная)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НормыТруда.Основная,
		|	бит_НормыТруда.Ссылка,
		|	бит_НормыТруда.Владелец
		|ИЗ
		|	Справочник.бит_НормыТруда КАК бит_НормыТруда
		|ГДЕ
		|	бит_НормыТруда.Владелец = &Ссылка";
		
	Запрос.УстановитьПараметр("Ссылка",Объект.Ссылка);	
		
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НормаОбъект = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		
		Если Не СсылкаОсновная = ВыборкаДетальныеЗаписи.Ссылка Тогда
			
			
			Если НЕ НормаОбъект.Основная = Ложь Тогда
				
				
				НормаОбъект.Основная = Ложь;
				Попытка
					НормаОбъект.Записать();
				Исключение
				КонецПопытки;
				
			КонецЕсли;
		Иначе	
			
			
			НормаОбъект.Основная = Истина;
			Попытка
				НормаОбъект.Записать();
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры	

