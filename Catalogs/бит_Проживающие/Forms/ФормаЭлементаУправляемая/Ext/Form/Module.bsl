// Меняем тип значения на Перечисление.ПолФизическогоЛица.
&НаКлиенте
Процедура ПолОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если НЕ ТипЗнч(ВыбранноеЗначение) = ТипЗнч(ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской")) Тогда
		СоответствиеПола = Новый Соответствие;
		
		СоответствиеПола.Вставить(ПредопределенноеЗначение("Перечисление.УдалитьПолФизическихЛиц.Мужской")      , ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской"));
		СоответствиеПола.Вставить(ПредопределенноеЗначение("Перечисление.УдалитьПолФизическихЛиц.Женский")      , ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский"));
		СоответствиеПола.Вставить(ПредопределенноеЗначение("Перечисление.УдалитьПолФизическихЛиц.ПустаяСсылка") , ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.ПустаяСсылка"));
		
		ВыбранноеЗначение = СоответствиеПола[ВыбранноеЗначение];
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПолНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Пол = Новый СписокЗначений;
	Пол.Вставить(0,ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской"),"Мужской");
	Пол.Вставить(1,ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский"),"Женский");
	
	ВыбранныйЭлемент = Неопределено;
	
	ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ПолНачалоВыбораЗавершение", ЭтотОбъект), Пол, Элементы.Пол);
	
КонецПроцедуры

