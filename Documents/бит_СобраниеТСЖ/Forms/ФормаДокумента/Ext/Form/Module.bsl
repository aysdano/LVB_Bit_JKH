&НаСервереБезКонтекста
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокТСЖ(Период, Организация)
	
	СписокТСЖ = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , КонецДня(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ИнформацияТСЖСрезПоследних.ТСЖ
	|ИЗ
	|	РегистрСведений.бит_ИнформацияТСЖ.СрезПоследних(&Период, ) КАК бит_ИнформацияТСЖСрезПоследних
	|ГДЕ
	|	(бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия > &Период)
	|	И бит_ИнформацияТСЖСрезПоследних.Здание.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ИнформацияТСЖСрезПоследних.ТСЖ";
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Таблица = Результат.Выгрузить();
		СписокТСЖ.ЗагрузитьЗначения(Таблица.ВыгрузитьКолонку("ТСЖ"));
		
	КонецЕсли; 
	
	Возврат СписокТСЖ;
	
КонецФункции // ПолучитьСписокТСЖ()

&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОбновитьСписокЗданийНаСервере()
	
	Объект.СписокЗданий.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ТСЖ"        , Объект.ТСЖ);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ИнформацияТСЖСрезПоследних.Здание
	|ИЗ
	|	РегистрСведений.бит_ИнформацияТСЖ.СрезПоследних(&Период, ТСЖ = &ТСЖ) КАК бит_ИнформацияТСЖСрезПоследних
	|ГДЕ
	|	(бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия > &Период)
	|	И бит_ИнформацияТСЖСрезПоследних.Здание.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ИнформацияТСЖСрезПоследних.Здание";
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = Объект.СписокЗданий.Добавить();
		НоваяСтрока.Здание       = Выборка.Здание;
		НоваяСтрока.Использовать = Истина;
		
	КонецЦикла;
	
КонецПроцедуры // ОбновитьСписокЗданийНаСервере() 

&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОбновитьСписокГолосований()
	
	ДеревоУчастников = РеквизитФормыВЗначение("ДеревоУчастниковГолосования", Тип("ДеревоЗначений"));
	
	ПервыйУровень = ДеревоУчастников.Строки; // Вопросы
	
	Для каждого СтрокаСписокВопросов Из Объект.СписокВопросов Цикл
		
		ИдентификаторВопроса = СтрокаСписокВопросов.Идентификатор;
		
		СтрокаВопрос = ПервыйУровень.Найти(ИдентификаторВопроса, "ИдентификаторВопроса", Истина);
		
		Если СтрокаВопрос = Неопределено Тогда
			
			СтрокаВопрос = ПервыйУровень.Добавить();
			СтрокаВопрос.Представление        = СтрокаСписокВопросов.Вопрос;
			СтрокаВопрос.ИдентификаторВопроса = ИдентификаторВопроса;
			
		КонецЕсли;
		
		Если НЕ СтрокаВопрос = Неопределено Тогда
			СтрокаВопрос.Представление = СтрокаСписокВопросов.Вопрос;
			СтрокаВопрос.УровеньВопрос = Истина;
		КонецЕсли;
		
		Попытка
			ВторойУровень = СтрокаВопрос.Строки; // Здания.
		Исключение
			Продолжить;
		КонецПопытки; 
		
		Для каждого СтрокаТаблицы Из Объект.СписокЗданий Цикл
			
			СтрокаЗдание = ВторойУровень.Найти(СтрокаТаблицы.Здание, "ЗданиеУчастник", Истина);
			
			Если СтрокаЗдание = Неопределено И СтрокаТаблицы.Использовать Тогда
				
				СтрокаЗдание = ВторойУровень.Добавить();
				СтрокаЗдание.ЗданиеУчастник       = СтрокаТаблицы.Здание;
				СтрокаЗдание.ИдентификаторВопроса = ИдентификаторВопроса;
				СтрокаЗдание.УровеньЗдание        = Истина;
				СтрокаЗдание.Представление        = "ул. " + СтрокаТаблицы.Здание.Улица + ", д." + СтрокаТаблицы.Здание;
				
			ИначеЕсли НЕ СтрокаТаблицы.Использовать И НЕ СтрокаЗдание = Неопределено Тогда
				
				ВторойУровень.Удалить(СтрокаЗдание);
				Продолжить;
				
			КонецЕсли;
			
			Попытка
				ТретийУровень = СтрокаЗдание.Строки; // Участники.
			Исключение
				Продолжить;
			КонецПопытки;
			
			СписокЗданий = Новый Массив;
			СписокЗданий.Добавить(СтрокаТаблицы.Здание);
			
			ТолькоСобственики = СтрокаСписокВопросов.Участники = Перечисления.бит_ВидыУчастниковГолосования.Собственики;
			
			СписокУчастников = ПолучитьСписокУчастников(Объект.Дата, Объект.ТСЖ, СписокЗданий, ТолькоСобственики);
			
			тмпУчастники = СкопироватьУровень(ТретийУровень, "ЗданиеУчастник", "ИдентификаторРешения");
			ТретийУровень.Очистить();
			
			Для каждого СтрокаТаблицы Из СписокУчастников Цикл
				
				СтрокаУчастник = ТретийУровень.Добавить();
				СтрокаУчастник.Использовать         = Истина;
				СтрокаУчастник.Квартира             = СтрокаТаблицы.Квартира;
				СтрокаУчастник.ЗданиеУчастник       = СтрокаТаблицы.ФизЛицо;
				СтрокаУчастник.ИдентификаторВопроса = ИдентификаторВопроса;
				СтрокаУчастник.Представление        = "" + СтрокаТаблицы.ФизЛицо + ", кв." + СтрокаТаблицы.Квартира;
				СтрокаУчастник.УровеньУчастник      = Истина;
				СтрокаУчастник.КритерийОценкиГолосов = СтрокаСписокВопросов.КритерийОценкиГолосов;
				
				Если СтрокаСписокВопросов.КритерийОценкиГолосов = Перечисления.бит_КритерииОценкиГолосов.ПоДолиПлощади Тогда
					СтрокаУчастник.ЗначениеГолоса = СтрокаТаблицы.ДоляПлощади;
				ИначеЕсли СтрокаСписокВопросов.КритерийОценкиГолосов = Перечисления.бит_КритерииОценкиГолосов.ПоКоличествуГолосов Тогда
					СтрокаУчастник.ЗначениеГолоса = СтрокаТаблицы.КоличествоГолосов;
					СтрокаУчастник.ЗначениеГолоса    = ?(СтрокаУчастник.ЗначениеГолоса = 0, 1, СтрокаУчастник.ЗначениеГолоса);
				ИначеЕсли СтрокаСписокВопросов.КритерийОценкиГолосов = Перечисления.бит_КритерииОценкиГолосов.ПоКоличествуПроживающих Тогда
					СтрокаУчастник.ЗначениеГолоса = СтрокаТаблицы.КолПроживающих;
				КонецЕсли;
				
				ИдентификаторРешения =  тмпУчастники.Получить(СтрокаТаблицы.ФизЛицо);
				
				Если НЕ ИдентификаторРешения = Неопределено Тогда
					
					Отбор = Новый Структура("Идентификатор", ИдентификаторРешения);
					
					Поиск = Объект.ВариантыВыбораГолосования.НайтиСтроки(Отбор);
					
					Попытка
						СтрокаУчастник.ИдентификаторРешения = ИдентификаторРешения;
						СтрокаУчастник.Решение              = Поиск[0].ВариантРешения;
					Исключение
						Продолжить;
					КонецПопытки;
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЦикла;
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоУчастников, "ДеревоУчастниковГолосования");
	
КонецПроцедуры // () 

&НаСервереБезКонтекста
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокУчастников(Период, ТСЖ, СписокЗданий, ТолькоСобственики = Ложь)
	
	ИмяТаблицыСлева  = "СписокЧленовТСЖ";
	ИмяТаблицыСправа = "СписокСобствеников";
	
	Если ТолькоСобственики Тогда
		
		ИмяТаблицыСлева = "СписокСобствеников";
		ИмяТаблицыСправа  = "СписокЧленовТСЖ";
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", КонецДня(Период));
	Запрос.УстановитьПараметр("ТСЖ"   , ТСЖ);
	Запрос.УстановитьПараметр("СписокЗданий", СписокЗданий);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК КолПроживающих,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	|ПОМЕСТИТЬ Проживающие
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет.Здание В (&СписокЗданий)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период)
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Постоянно)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	1 КАК КоличествоГолосов,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира КАК Квартира,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади
	|ПОМЕСТИТЬ СписокСобствеников
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет.Здание В (&СписокЗданий)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период)
	|	И бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.даНет.да)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЧленыТСЖСрезПоследних.ФизЛицо,
	|	бит_ЧленыТСЖСрезПоследних.КоличествоГолосов,
	|	бит_ЧленыТСЖСрезПоследних.ЛицевойСчет.Квартира КАК Квартира,
	|	бит_ЧленыТСЖСрезПоследних.ЛицевойСчет,
	|	СписокСобствеников.ДоляПлощади
	|ПОМЕСТИТЬ СписокЧленовТСЖ
	|ИЗ
	|	РегистрСведений.бит_ЧленыТСЖ.СрезПоследних(
	|			&Период,
	|			ТСЖ = &ТСЖ
	|				И ЛицевойСчет.Здание В (&СписокЗданий)) КАК бит_ЧленыТСЖСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ СписокСобствеников КАК СписокСобствеников
	|		ПО бит_ЧленыТСЖСрезПоследних.ЛицевойСчет = СписокСобствеников.ЛицевойСчет
	|			И бит_ЧленыТСЖСрезПоследних.ФизЛицо = СписокСобствеников.ФизЛицо
	|			И бит_ЧленыТСЖСрезПоследних.ЛицевойСчет.Квартира = СписокСобствеников.Квартира
	|ГДЕ
	|	(бит_ЧленыТСЖСрезПоследних.ДатаВыхода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ЧленыТСЖСрезПоследних.ДатаВыхода > &Период)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЛеваяТаблица.ФизЛицо,
	|	ЕСТЬNULL(ЛеваяТаблица.КоличествоГолосов, 0) КАК КоличествоГолосов,
	|	ЛеваяТаблица.Квартира,
	|	ЛеваяТаблица.ЛицевойСчет,
	|	ЕСТЬNULL(Проживающие.КолПроживающих, 0) КАК КолПроживающих,
	|	ВЫРАЗИТЬ(ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь, 0) * ЕСТЬNULL(ЛеваяТаблица.ДоляПлощади, 0) КАК ЧИСЛО(15, 2)) КАК ДоляПлощади
	|ИЗ
	|	"+ИмяТаблицыСлева+" КАК ЛеваяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Проживающие КАК Проживающие
	|		ПО ЛеваяТаблица.ЛицевойСчет = Проживающие.ЛицевойСчет
	|		ЛЕВОЕ СОЕДИНЕНИЕ "+ИмяТаблицыСправа+" КАК ПраваяТаблица
	|		ПО ЛеваяТаблица.ФизЛицо = ПраваяТаблица.ФизЛицо
	|			И ЛеваяТаблица.ЛицевойСчет = ПраваяТаблица.ЛицевойСчет
	|			И ЛеваяТаблица.Квартира = ПраваяТаблица.Квартира
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Период, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО ЛеваяТаблица.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Проживающие
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СписокСобствеников
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ СписокЧленовТСЖ";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции // ()

&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОбновитьДеревоРешенийНаСервере()
	
	ДеревоУчастников = РеквизитФормыВЗначение("ДеревоУчастниковГолосования", Тип("ДеревоЗначений"));
	
	ДеревоРезультата = РеквизитФормыВЗначение("ДеревоРзельтатовГолосования", Тип("ДеревоЗначений"));
	УровеньВопрос    = ДеревоРезультата.Строки;
	
	УровеньВопрос.Очистить();
	
	Для каждого СтрокаВопрос Из Объект.СписокВопросов Цикл
		
		Отбор = Новый Структура;
		Отбор.Вставить("ИдентификаторВопроса", СтрокаВопрос.Идентификатор);
		
		ПоискРешений = Объект.ВариантыВыбораГолосования.НайтиСтроки(Отбор);
		
		НоваяСтрокаВопрос = УровеньВопрос.Добавить();
		НоваяСтрокаВопрос.ИдентификаторВопроса = СтрокаВопрос.Идентификатор;
		НоваяСтрокаВопрос.Вопрос               = СтрокаВопрос.Вопрос;
		
		УровеньРешения = НоваяСтрокаВопрос.Строки;
		
		Для каждого СтрокаРешения Из ПоискРешений Цикл
			
			НоваяСтрокаРешения =  УровеньРешения.Добавить();
			НоваяСтрокаРешения.ИдентификаторВопроса = СтрокаВопрос.Идентификатор;
			НоваяСтрокаРешения.ИдентификаторРешения = СтрокаРешения.Идентификатор;
			НоваяСтрокаРешения.Вопрос               = СтрокаРешения.ВариантРешения;
			
			Отбор = Новый Структура;
			Отбор.Вставить("ИдентификаторРешения", СтрокаРешения.Идентификатор);
			Отбор.Вставить("УровеньУчастник"     , Истина);
			Отбор.Вставить("Использовать"        , Истина);
			
			ПоискУчастников = ДеревоУчастников.Строки.НайтиСтроки(Отбор, Истина);
			
			Для каждого СтрокаУчастник Из ПоискУчастников Цикл
				
				НоваяСтрокаРешения.ЗначениеГолоса = НоваяСтрокаРешения.ЗначениеГолоса + СтрокаУчастник.ЗначениеГолоса;
				
			КонецЦикла;  
			
		КонецЦикла;
		
		ПроцентноеЗначениеКворума = 100;
		
		Кворум = СтрокаВопрос.Кворум;
		
		Если Кворум = Перечисления.бит_Кворум.Более12 Тогда
			ПроцентноеЗначениеКворума = 50.01;
		ИначеЕсли Кворум = Перечисления.бит_Кворум.НеМеньше23 Тогда
			ПроцентноеЗначениеКворума = 66.67;
		ИначеЕсли Кворум = Перечисления.бит_Кворум.НеМеньше34 Тогда
			ПроцентноеЗначениеКворума = 25;
		КонецЕсли;
		
		ИтогЗначениеГолоса = УровеньРешения.Итог("ЗначениеГолоса");
		
		Если ИтогЗначениеГолоса = 0 Тогда
			Продолжить;
		КонецЕсли; 
		
		Для каждого СтрокаТаблицы Из УровеньРешения Цикл
			
			СтрокаТаблицы.ПроцентГолосов = ОКР((СтрокаТаблицы.ЗначениеГолоса / ИтогЗначениеГолоса) * 100, 2);
			
			Если СтрокаТаблицы.ПроцентГолосов >= ПроцентноеЗначениеКворума Тогда
				СтрокаТаблицы.ПринятоеРешение = Истина;
			КонецЕсли; 
			
		КонецЦикла;
		
		НоваяСтрокаВопрос.ЗначениеГолоса = ИтогЗначениеГолоса;
		НоваяСтрокаВопрос.ПроцентГолосов    = 100;
		
	КонецЦикла; 
	
	ЗначениеВРеквизитФормы(ДеревоРезультата, "ДеревоРзельтатовГолосования");
	
КонецПроцедуры // () 

