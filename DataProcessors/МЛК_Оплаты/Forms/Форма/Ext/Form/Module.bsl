&НаСервере
Процедура ОбработатьДокументыНаСервере()
	
	ТаблицаДляИзмененияСтатуса = Новый ТаблицаЗначений;
	ТаблицаДляИзмененияСтатуса.Колонки.Добавить("ИД_События");
	
	ТаблицаЛС = Новый ТаблицаЗначений;
	ТаблицаЛС.Колонки.Добавить("Ссылка");
	
	ИзменитьСтатус = Ложь;	
	Для Каждого СтрДок Из Объект.ПлатежныеДокументы Цикл
		Если Не СтрДок.ВЫбран Тогда Продолжить; КонецЕсли;
		
		//Запрос в регистр
		
		Запрос = Новый Запрос;
		Запрос.Текст =  "ВЫБРАТЬ
		|	МЛК_РеестрОплат.ЛицевойСчет КАК ЛицевойСчет,
		|	МЛК_РеестрОплат.Пакет КАК Пакет,
		|	МЛК_РеестрОплат.ИД_События КАК ИД_События,
		|	МЛК_РеестрОплат.ДокОплатыБит КАК ДокОплатыБит,
		|	МЛК_РеестрОплат.ОперацияПоПлатежнойКарте КАК ОперацияПоПлатежнойКарте,
		|	МЛК_РеестрОплат.Платежка КАК Платежка
		|ИЗ
		|	РегистрСведений.МЛК_РеестрОплат КАК МЛК_РеестрОплат
		|ГДЕ
		|	МЛК_РеестрОплат.Платежка = &Платежка";
		Запрос.УстановитьПараметр("Платежка",СтрДок.ПоступлениеНаСчет);
		
		ОплатыПоКартам = Запрос.Выполнить().Выгрузить();
		Если ОплатыПоКартам.Количество() <> 0 Тогда
			МассивОплат = ОплатыПоКартам.ВыгрузитьКолонку("ОперацияПоПлатежнойКарте");	
		КонецЕсли;	
		
		
		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		Пока Выборка.Следующий() Цикл
			Если ПровелДокумент(Выборка.ДокОплатыБит,МассивОплат) Тогда
				ИзменитьСтатус = Истина;
				НовСтрСтатус = ТаблицаДляИзмененияСтатуса.Добавить();
				НовСтрСтатус.ИД_События   = Выборка.ИД_События;
				
				
				НовСтрСтатус = ТаблицаЛС.Добавить();
				НовСтрСтатус.Ссылка   = Выборка.ЛицевойСчет;
			КонецЕсли;
		КонецЦикла;	
	КонецЦикла;
	
	Если ИзменитьСтатус Тогда
		Настройки = Справочники.МЛК_Настройки.Выбрать();
		Пока Настройки.Следующий() Цикл
			Если Настройки.Организация=Объект.Организация Тогда
				
				ИзменитьСтатусыВСобытиях(ТаблицаДляИзмененияСтатуса,Строка(СтрЗаменить(Настройки.СтатусЗакрыто,Символы.НПП,"")),Настройки);
				ОтправитьВМобстедЛицевойСчет(Настройки,ТаблицаЛС);
				
			КонецЕсли;
			Прервать;
		КонецЦикла;
	КонецЕсли;
	
	
	
КонецПроцедуры	

&НаСервере
Процедура ИзменитьСтатусыВСобытиях(ТаблицаДляИзмененияСтатуса,КодСтатуса,Настройки)
	
	Для Каждого СТрСтатус Из ТаблицаДляИзмененияСтатуса Цикл
		
		ЕстьОтвет = Истина;
		
		АдресСервисаСтр = СокрЛП(Настройки.АдресКабинетов);
		
		//АдресРесурса1 = "/api/v2/events/"+СТрока(СТрСтатус.ИД_События);
		АдресРесурса1 = "/api/v4/events/"+СТрока(СТрСтатус.ИД_События);
		СтрокаПараметров = "?StatusId="+СТрока(КодСтатуса);
		HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1+СтрокаПараметров);
		HTTPЗапрос.УстановитьТелоИзСтроки("", КодировкаТекста.UTF8);
		HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");   // тут поменялось
		HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Настройки.Токен));
		HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
		Попытка
			Ответ = HTTPСоединение.Записать(HTTPЗапрос);
		Исключение
			ЕстьОтвет = Ложь;
			Сообщить("Изменение статуса события: "+СТрока(СТрСтатус.ИД_События)+". Ошибка при отправке запроса: " + ОписаниеОшибки());
		КонецПопытки;
		
		Если ЕстьОтвет Тогда
			Если Ответ.КодСостояния = 200 Тогда
				СтрокаОтвет1 = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				
				//СтрокаОтвет1 = Перевод(СтрокаОтвет1);
				
				СтрокаОтвет1 = "Изменение статуса события. Событие: "+Строка(СТрСтатус.ИД_События)+". "+ СтрокаОтвет1;
				
				
				Сообщить(СтрокаОтвет1);
				Если Не ПустаяСтрока(СтрокаОтвет1) Тогда
					РезультатПроверки1 = СтрокаОтвет1;
					
					Если СокрЛП(РезультатПроверки1)="false" Тогда
						Сообщить("Соединение не установлено");
					Иначе
						
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Ответ.КодСостояния = 500 Тогда
				Сообщить("Изменение статусов события. "+"Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
			ИначеЕсли Ответ.КодСостояния = 404 Тогда
				Сообщить("Изменение статусов события. "+"Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
			ИначеЕсли Ответ.КодСостояния = 301 Тогда
				Сообщить("Изменение статусов события. "+"Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
			Иначе
				Сообщить("Изменение статусов события. "+"Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры	

&НаСервере
Функция ПолучитьСтруктуруДанныхЛицевогоСчета(ЛицевойСчет,Настройки)
	Структура = Новый Структура("Phone, Email, Имя_Отчество, Город, Улица, Дом, Корпус, Квартира, ApiSumma, Помещение");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиесяПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ПроживающиесяПоЛССрезПоследних.СтатусФизЛица,
	|	ПроживающиесяПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	ПроживающиесяПоЛССрезПоследних.СтатусПроживания,
	|	ПроживающиесяПоЛССрезПоследних.ДатаЗаписи,
	|	ПроживающиесяПоЛССрезПоследних.ДатаРегистрации,
	|	ПроживающиесяПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	ПроживающиесяПоЛССрезПоследних.ВладелецКвартиры,
	|	ПроживающиесяПоЛССрезПоследних.ДоляПлощади,
	|	ПроживающиесяПоЛССрезПоследних.СтатусФизЛицаДляИзменения
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиесяПоЛССрезПоследних
	|ГДЕ
	|	(ПроживающиесяПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиесяПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Момент"		, КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет"	, ЛицевойСчет.Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();	
	Пока Выборка.Следующий() Цикл 
		
		Если Выборка.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
			ОтветсвенноеЛицо = Выборка.ФизЛицо;
		КонецЕсли; 
		
	КонецЦикла; 
	
	ВладелецЛицевогоСчета = ОтветсвенноеЛицо;
	
	Если Настройки.ПередаватьФамилию Тогда
		//Структура.Имя_Отчество        = ВладелецЛицевогоСчета.Наименование; 
		Структура.Имя_Отчество        = СтрЗаменить(ВладелецЛицевогоСчета.Наименование,"""","\"+"""");
	Иначе
		Попытка
			ИмяОтчество = ФизическиеЛицаКлиентСервер.ЧастиИмени(ВладелецЛицевогоСчета.Наименование);
			Структура.Имя_Отчество        = СтрЗаменить(Строка(ИмяОтчество.Имя)+" "+Строка(ИмяОтчество.Отчество),"""","\"+"""");
		Исключение
			Структура.Имя_Отчество        = "";
		КонецПопытки;
	КонецЕсли;
	
	//Структура.Имя_Отчество = Транслит(Структура.Имя_Отчество);
	Если ЗначениеЗаполнено(ВладелецЛицевогоСчета) Тогда
		Телефон              = бит_ОбщегоНазначения.ПолучитьТелефонИзКонтактнойИнформацииФизЛица(ВладелецЛицевогоСчета);
		Тел = СтрЗаменить(Телефон,"-","");
		Тел = СтрЗаменить(Тел,"+7","7");
		Тел = СтрЗаменить(Тел,"-","");
		Тел = СтрЗаменить(Тел,"(","");
		Тел = СтрЗаменить(Тел,")","");
		Тел = СтрЗаменить(Тел,Символы.НПП,"");
		Тел = СтрЗаменить(сокрлп(Тел)," ","");
		Если Лев(Тел,1)="8" и СтрДлина(Тел)>6 Тогда
			//	Тел = СтрЗаменить(Лев(Тел,1),"8","7");
			тел="7" + Прав(тел,СтрДлина(тел)-1);
		КонецЕсли;
		
		Структура.Phone               = Тел;
		
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	КонтактнаяИнформация.Представление
		|ИЗ
		|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
		|ГДЕ
		|	КонтактнаяИнформация.Объект = &Объект
		|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.бит_ТипыКонтактнойИнформации.АдресЭлектроннойПочты)
		|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.бит_ВидыКонтактнойИнформации.EmailПроживающего)";
		
		Запрос.УстановитьПараметр("Объект", ВладелецЛицевогоСчета);
		Выборка = Запрос.Выполнить().Выбрать();
		
		ЭлПочтаПроживающего = "";
		Если Выборка.Следующий() Тогда
			ЭлПочтаПроживающего = Выборка.Представление;
			Структура.Email     = ЭлПочтаПроживающего;
		КонецЕсли;
		Структура.Улица    = ЛицевойСчет.Здание.Улица;
		Структура.Город    = ЛицевойСчет.Здание.Район;
		Структура.Дом      = Строка(ЛицевойСчет.Здание.Улица)+", д. "+ЛицевойСчет.Здание.НомерДома+СТрока(?(ЛицевойСчет.Здание.Корпус="","",", корп. "+Строка(ЛицевойСчет.Здание.Корпус)));
		Структура.Корпус   = ЛицевойСчет.Здание.Корпус;
		Структура.Квартира = ЛицевойСчет.Квартира.Наименование;
		Структура.Помещение = ЛицевойСчет.Здание.ПочтовыйАдрес+", кв. "+Строка(ЛицевойСчет.Квартира.НомерКвартиры);
	Иначе
		Структура.Улица    = ЛицевойСчет.Здание.Улица;
		Структура.Город    = ЛицевойСчет.Здание.Район;
		Структура.Дом      = Строка(ЛицевойСчет.Здание.Улица)+", д. "+ЛицевойСчет.Здание.НомерДома+СТрока(?(ЛицевойСчет.Здание.Корпус="","",", корп. "+Строка(ЛицевойСчет.Здание.Корпус)));
		Структура.Корпус   = ЛицевойСчет.Здание.Корпус;
		Структура.Квартира = ЛицевойСчет.Квартира.Наименование;
		Структура.Помещение = ЛицевойСчет.Здание.ПочтовыйАдрес+", кв. "+Строка(ЛицевойСчет.Квартира.НомерКвартиры);
	КонецЕсли;
	//Структура.Улица    = Транслит(ЛицевойСчет.Здание.Улица);
	//Структура.Город    = Транслит(ЛицевойСчет.Здание.Район);
	//Структура.Дом      = ЛицевойСчет.Здание.НомерДома;
	//Структура.Корпус   = ЛицевойСчет.Здание.Корпус;
	//Структура.Квартира = ЛицевойСчет.Квартира.Наименование;
	
	
	//Долг + текущие начисления
	
	ДолгПоЛС = ВывестиСуммуДолгаПоЛС(ЛицевойСчет,Настройки);
	Долг     = ДолгПоЛС.СтрокаДолга;
	Структура.ApiSumma = Долг;
	
	Возврат Структура;
	
