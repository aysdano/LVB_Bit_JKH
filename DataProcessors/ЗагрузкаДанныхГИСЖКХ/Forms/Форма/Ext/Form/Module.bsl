&НаСервере
Процедура ЗагрузитьОЖФНаСервере(Адрес) Экспорт
	ВремяНачала = ТекущаяДата();
	
	
	Файл = ПолучитьИзВременногоХранилища(Адрес);
	ТабличныйДокумент = Новый ТабличныйДокумент;
	ТабличныйДокумент.Прочитать(Файл, СпособЧтенияЗначенийТабличногоДокумента.Значение);
	ПЗ = Новый ПостроительЗапроса;
	ПЗ.ИсточникДанных = Новый ОписаниеИсточникаДанных(ТабличныйДокумент.Область());//передаем ТЗ
	ПЗ.ДобавлениеПредставлений = ТипДобавленияПредставлений.НеДобавлять;
	ПЗ.ЗаполнитьНастройки();
	ПЗ.Выполнить();
	ТабличноеПоле = ПЗ.Результат.Выгрузить();
	
	Для Каждого Стр Из ТабличноеПоле Цикл
		Если Стр.УникальныйНомерПомещения = "" Тогда
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("УникальныйНомерГИСЖКХ", Стр.УникальныйНомерДома);
			Запрос.Текст = "ВЫБРАТЬ
			|	бит_СписокЗданий.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
			|ГДЕ
			|	бит_СписокЗданий.УникальныйНомерГИСЖКХ ПОДОБНО ""%"" + &УникальныйНомерГИСЖКХ + ""%""";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Здание = Выборка.Ссылка.ПолучитьОбъект();
				Здание.КадастровыйНомер = Стр.КадастровыйНомер;
				//Здание.КодФИАС = Стр.ГлобальныйУникальныйИдентификаторОбъектаЖилищногоФонда;
				Здание.Записать();
			КонецЕсли;
		Иначе
			Запрос = Новый Запрос;
			Запрос.УстановитьПараметр("УникальныйНомерГИСЖКХ", Стр.УникальныйНомерПомещения);
			Запрос.Текст = "ВЫБРАТЬ
			|	бит_Квартиры.Ссылка КАК Ссылка
			|ИЗ
			|	Справочник.бит_Квартиры КАК бит_Квартиры
			|ГДЕ
			|	бит_Квартиры.УникальныйНомерГИСЖКХ ПОДОБНО ""%"" + &УникальныйНомерГИСЖКХ + ""%""";
			Выборка = Запрос.Выполнить().Выбрать();
			Если Выборка.Следующий() Тогда
				Квартира = Выборка.Ссылка.ПолучитьОбъект();
				Квартира.КадастровыйНомер = Стр.КадастровыйНомер;
				//Здание.КодФИАС = Стр.;
				Квартира.Записать();
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

