	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформации.ТелефонПодразделенияОрганизации , Справочники.ВидыКонтактнойИнформации.ТелефонПодразделенияОрганизации);
	
	СоответствиеГруппВидовКИ = Новый Соответствие;
	
	СоответствиеГруппВидовКИ.Вставить(Тип("СправочникСсылка.бит_Проживающие")                             , Справочники.ВидыКонтактнойИнформации.Справочникбит_Проживающие);
	СоответствиеГруппВидовКИ.Вставить(Тип("СправочникСсылка.бит_ОрганыФМС")                               , Справочники.ВидыКонтактнойИнформации.Справочникбит_ОрганыФМС);
	СоответствиеГруппВидовКИ.Вставить(Тип("СправочникСсылка.бит_ПодразделенияОрганизаций")                , Справочники.ВидыКонтактнойИнформации.Справочникбит_ПодразделенияОрганизаций);
	СоответствиеГруппВидовКИ.Вставить(Тип("СправочникСсылка.бит_СписокЗданий")                            , Справочники.ВидыКонтактнойИнформации.Справочникбит_СписокЗданий);
	
	// Перенос контактной информации из РС в табличные части справочников.
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_ПроживающиеКонтактнаяИнформация.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ОбъектыСКИ
	|ИЗ
	|	Справочник.бит_Проживающие.КонтактнаяИнформация КАК бит_ПроживающиеКонтактнаяИнформация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_ОрганыФМСКонтактнаяИнформация.Ссылка
	|ИЗ
	|	Справочник.бит_ОрганыФМС.КонтактнаяИнформация КАК бит_ОрганыФМСКонтактнаяИнформация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_ПодразделенияОрганизацийКонтактнаяИнформация.Ссылка
	|ИЗ
	|	Справочник.бит_ПодразделенияОрганизаций.КонтактнаяИнформация КАК бит_ПодразделенияОрганизацийКонтактнаяИнформация
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_СписокЗданийКонтактнаяИнформация.Ссылка
	|ИЗ
	|	Справочник.бит_СписокЗданий.КонтактнаяИнформация КАК бит_СписокЗданийКонтактнаяИнформация
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_КонтактнаяИнформация.Объект КАК Объект,
	|	бит_КонтактнаяИнформация.Тип КАК Тип,
	|	бит_КонтактнаяИнформация.Вид КАК Вид,
	|	бит_КонтактнаяИнформация.Вид.Наименование КАК ВидНаименование,
	|	бит_КонтактнаяИнформация.Вид.Тип КАК ВидТип,
	|	бит_КонтактнаяИнформация.Вид.Порядок КАК ВидПорядок,
	|	бит_КонтактнаяИнформация.Вид.МожноРедактироватьТолькоВДиалоге КАК ВидМожноРедактироватьТолькоВДиалоге,
	|	бит_КонтактнаяИнформация.Представление КАК Представление,
	|	бит_КонтактнаяИнформация.Поле1 КАК Поле1,
	|	бит_КонтактнаяИнформация.Поле2 КАК Поле2,
	|	бит_КонтактнаяИнформация.Поле3 КАК Поле3,
	|	бит_КонтактнаяИнформация.Поле4 КАК Поле4,
	|	бит_КонтактнаяИнформация.Поле5,
	|	бит_КонтактнаяИнформация.Поле6 КАК Поле6,
	|	бит_КонтактнаяИнформация.Поле7 КАК Поле7,
	|	бит_КонтактнаяИнформация.Поле8 КАК Поле8,
	|	бит_КонтактнаяИнформация.Поле9 КАК Поле9,
	|	бит_КонтактнаяИнформация.Поле10 КАК Поле10
	|ИЗ
	|	РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбъектыСКИ КАК ОбъектыСКИ
	|		ПО бит_КонтактнаяИнформация.Объект = ОбъектыСКИ.Ссылка
	|ИТОГИ ПО
	|	Объект";
	
	ВыборкаОбъект = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаОбъект.Следующий() Цикл
		
		Если НЕ ЗначениеЗаполнено(ВыборкаОбъект.Объект) Тогда
			Продолжить;
		КонецЕсли;
		
		Выборка = ВыборкаОбъект.Выбрать();
		
		ОбъектВладелец = ВыборкаОбъект.Объект.ПолучитьОбъект();
		Если Метаданные.Справочники.Содержит(ОбъектВладелец.Метаданные())
			И ОбъектВладелец.ЭтоГруппа Тогда
			Продолжить;
		КонецЕсли;
		
		Пока Выборка.Следующий() Цикл
			Если СоответствиеВидовКИ[Выборка.Вид] = Неопределено Тогда 
				НайденныйВидКИ = Справочники.ВидыКонтактнойИнформации.НайтиПоНаименованию(Выборка.ВидНаименование, Истина, СоответствиеГруппВидовКИ[ТипЗнч(Выборка.Объект)]);
				Если Не ЗначениеЗаполнено(НайденныйВидКИ) Тогда
					СправочникВидыКИ = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
					СправочникВидыКИ.Наименование                      = СокрЛП(Выборка.ВидНаименование);
					СправочникВидыКИ.Родитель                          = СоответствиеГруппВидовКИ[ТипЗнч(Выборка.Объект)];
					СправочникВидыКИ.Тип                               = ПолучитьТипКонтактнойИнформации1С (Выборка.ВидТип);//Выборка.ВидТип;
					СправочникВидыКИ.РеквизитДопУпорядочивания         = Выборка.ВидПорядок;
					// БИТ ЖКХ 05.02.2020
					//СправочникВидыКИ.РедактированиеТолькоВДиалоге      = Выборка.ВидМожноРедактироватьТолькоВДиалоге;
					СправочникВидыКИ.МожноИзменятьСпособРедактирования = Ложь;
					//07.11.2018
				    //СправочникВидыКИ.АдресТолькоРоссийский             = Ложь;

					
					СправочникВидыКИ.Записать();
					СоответствиеВидовКИ.Вставить(Выборка.Вид, СправочникВидыКИ.Ссылка);
				Иначе
					СоответствиеВидовКИ.Вставить(Выборка.Вид, НайденныйВидКИ);
				КонецЕсли;
			КонецЕсли;
			НоваяСтрока = ОбъектВладелец.КонтактнаяИнформация.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			НоваяСтрока.Вид = СоответствиеВидовКИ[Выборка.Вид];
			НоваяСтрока.Тип = СоответствиеТиповКИ[Выборка.Тип];
			
			Если Выборка.Тип = Перечисления.бит_ТипыКонтактнойИнформации.Адрес Тогда
				НоваяСтрока.ЗначенияПолей = "Индекс=" + Выборка.Поле1 + Символы.ПС
				+ "Регион="           + Выборка.Поле2 + Символы.ПС
				+ "Район="            + Выборка.Поле3 + Символы.ПС
				+ "Город="            + Выборка.Поле4 + Символы.ПС
				+ "НаселенныйПункт="  + Выборка.Поле5 + Символы.ПС
				+ "Улица="            + Выборка.Поле6 + Символы.ПС
				+ "Дом="              + Выборка.Поле7 + Символы.ПС
				+ "Корпус="           + Выборка.Поле8 + Символы.ПС
				+ "Квартира="         + Выборка.Поле9 + Символы.ПС
				+ "ТипДома=дом"       + Символы.ПС
				+ "ТипКорпуса=корпус" + Символы.ПС
				+ "ТипКвартиры=кв.";
			ИначеЕсли Выборка.Тип = Перечисления.бит_ТипыКонтактнойИнформации.Телефон Тогда
				НоваяСтрока.ЗначенияПолей = "КодСтраны=" + Выборка.Поле1 + Символы.ПС
				+ "КодГорода="     + Выборка.Поле2 + Символы.ПС
				+ "НомерТелефона=" + Выборка.Поле3 + Символы.ПС
				+ "Добавочный="    + Выборка.Поле4;
				
				НоваяСтрока.НомерТелефонаБезКодов = Выборка.Поле3;
				НоваяСтрока.НомерТелефона         = Выборка.Поле1 + Выборка.Поле2 + Выборка.Поле3;
			ИначеЕсли Выборка.Тип = Перечисления.бит_ТипыКонтактнойИнформации.АдресЭлектроннойПочты Тогда
				НоваяСтрока.АдресЭП = Выборка.Представление;
			КонецЕсли;
			
			// Удаление символов переноса строк.
			НоваяСтрока.Представление = СтрЗаменить(НоваяСтрока.Представление, Символы.ПС," ");
			
		КонецЦикла;
		
		Попытка
			ОбъектВладелец.Записать();
			
		Исключение

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не удалось перенести КИ в ТЧ для "+ОбъектВладелец+" по причине" +ОписаниеОшибки());
			
		КонецПопытки;	
		
	КонецЦикла;
	
КонецПроцедуры

Функция ПолучитьТипКонтактнойИнформации1С (строкаТипа)
	
  если строка(строкаТипа) = "Адрес" тогда
	 возврат перечисления.ТипыКонтактнойИнформации.Адрес;	
  конецесли;	
  
  если строка(строкаТипа) = "Телефон" тогда
	 возврат перечисления.ТипыКонтактнойИнформации.Телефон;	
  конецесли;
 
  если строка(строкаТипа) = "АдресЭлектроннойПочты" тогда
	 возврат перечисления.ТипыКонтактнойИнформации.АдресЭлектроннойПочты;	
  конецесли;
 
  если строка(строкаТипа) = "ВебСтраница" тогда
	 возврат перечисления.ТипыКонтактнойИнформации.ВебСтраница;	
  конецесли;

  если строка(строкаТипа) = "Другое" тогда
	 возврат перечисления.ТипыКонтактнойИнформации.Другое;	
  конецесли;

КонецФункции

