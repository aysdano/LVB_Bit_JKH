//  
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства тогда
		
		СтруктураМакетов =  Новый Структура("ЗОССРУПМЖ,ЗОССРУПМЖ_2части,АЛП,КР,ЛСУП,СОРГ_РФ_ПМЖ,СОРГ_РФ_ПМЖ_Old,СОРПМПЖ, АЛП_стар,АЛУ,ЛСУВ"
		,"Ф6:Заявление о регистрации по месту жительства"
		,"Ф6:Заявление о регистрации и снятии по месту жительства"
		,"Ф2:Адресный листок прибытия","Ф9:Карточка регистрации"
		,"Ф12П:Листок статистического учета прибытия"
		,"РФЛ1:Сведения в ГНИ"
		,"РФЛ1:Сведения в ГНИ, с детьми до 14 лет"
		,"Ф8:Свидетельство о регистрации по месту жительства"
		,"Ф2:Адресный листок прибытия (старая версия)"
		,"Ф7:Адресный листок убытия"
		,"Ф12В:Листок статистического учета выбытия");
		
	ИначеЕсли ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуПребывания тогда	 
		
		СтруктураМакетов =  Новый Структура("ЗОРПМЖ,АЛП,Анкета,ЛСУП,СОРПМП,АЛП_стар"
		,"Ф1:Заявление о регистрации по месту пребывания"
		,"Ф2:Адресный листок прибытия","Ф5:Анкета"
		,"Ф12П:Листок статистического учета прибытия"
		,"Ф3:Свидетельство о регистрации по месту пребывания"
		,"Ф2:Адресный листок прибытия (старая версия)");
		
	ИначеЕсли ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета тогда 
		
		СтруктураМакетов =  Новый Структура("ЗОССРУПМЖ,АЛУ,ЛСУВ,УВОРУ, АЛУ_стар"
		,"Ф6:Заявление о снятии с регистрационного учета"
		,"Ф7:Адресный листок убытия"
		,"Ф12В:Листок статистического учета выбытия"
		,"Ф14:Уведомление в орган регистрационного учета"
		,"Ф7:Адресный листок убытия (старая версия)");
		
	КонецЕсли;
	
	Если ВидОперации <> Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета Тогда
		// В дальнейшем преобразуется в разделитель.					
		СтруктураМакетов.Вставить("РазделительСобств","--");
		// Формирование блаков нерегламентированных документов.
		СтруктураМакетов.Вставить("ЗаявлениеСНГ1","Бланк заявления проживания (для СНГ, версия 1)");
		СтруктураМакетов.Вставить("ЗаявлениеРФ1", "Бланк заявления пребывания (для РФ, версия 1)");
		СтруктураМакетов.Вставить("ЗаявлениеСНГ2","Бланк заявления проживания (для СНГ, версия 2)");
		СтруктураМакетов.Вставить("ЗаявлениеРФ2", "Бланк заявления пребывания (для РФ, версия 2)");
	КонецЕсли;
	Возврат СтруктураМакетов;
	
