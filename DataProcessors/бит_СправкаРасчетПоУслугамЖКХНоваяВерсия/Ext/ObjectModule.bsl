Функция ПериодСтрокой(ПериодОплаты)
	
	Месяц = Месяц(ПериодОплаты);
	Год = Формат(Год(ПериодОплаты),"ЧГ=") + "г.";
	СтрокаПериода = "";
	Если Месяц = 1 Тогда
		СтрокаПериода = "Январь ";
	ИначеЕсли Месяц = 2 Тогда
		СтрокаПериода = "Февраль ";
	ИначеЕсли Месяц = 3 Тогда
		СтрокаПериода = "Март ";
	ИначеЕсли Месяц = 4 Тогда
		СтрокаПериода = "Апрель ";
	ИначеЕсли Месяц = 5 Тогда
		СтрокаПериода = "Май ";
	ИначеЕсли Месяц = 6 Тогда
		СтрокаПериода = "Июнь ";
	ИначеЕсли Месяц = 7 Тогда
		СтрокаПериода = "Июль ";
	ИначеЕсли Месяц = 8 Тогда
		СтрокаПериода = "Август ";
	ИначеЕсли Месяц = 9 Тогда
		СтрокаПериода = "Сентябрь ";
	ИначеЕсли Месяц = 10 Тогда
		СтрокаПериода = "Октябрь ";
	ИначеЕсли Месяц = 11 Тогда
		СтрокаПериода = "Ноябрь ";
	Иначе
		СтрокаПериода = "Декабрь ";
	КонецЕсли;
	
	Возврат СтрокаПериода + Год;	
	
КонецФункции

Процедура ЗаполнитьНачисленияПоУслуге(ОбластьТаблица, ДанныеПоЛС, ДанныеРазовые, СтрокаОплаты, Услуга, Площадь, СуммаПерерасчеты, СуммаНачислено, УслугаНач, Коэфф); 
	
	СтрокаРазовые = НайтиСтрокуРазовые(ДанныеРазовые, ГруппаУслуг(Услуга));
	ОбластьТаблица.Параметры.Перерасчеты = ?(ЗначениеЗаполнено(СтрокаРазовые), Формат(СтрокаРазовые.СуммаОборот * Коэфф, "ЧДЦ=2; ЧН="), 0);
	СуммаПерерасчеты = СуммаПерерасчеты + ?(ЗначениеЗаполнено(СтрокаРазовые), СтрокаРазовые.СуммаОборот * Коэфф, 0);
	
	Если Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000009") Тогда//кап ремм
		//ОбластьТаблица.Параметры.Начислено =  Формат(Окр((СтрокаОплаты.МинВзносНач + СтрокаОплаты.ДопВзносНач + СтрокаОплаты.РФКРНач) * Коэфф.Числитель / Коэфф.Знаменатель, 2), "ЧДЦ=2");
		Тариф = ДанныеПоЛС.ТарифМинВзнос;   
