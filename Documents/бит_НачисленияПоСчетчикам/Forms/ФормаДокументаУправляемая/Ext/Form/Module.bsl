
#Область ПеременныеМодуля

&НаКлиенте 
Перем мКэшРеквизитовФормы;       // Хранит текущие значения реквизитов формы. Клиент.

#КонецОбласти

#Область РаботаСКэшемРеквизитовФормы

// Процедура заполняет кэш реквизитов формы данными объекта.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура ЗаполнитьТекущиеЗначенияРеквизитовФормы()
	
	Для Каждого КлючИЗначение Из мКэшРеквизитовФормы Цикл
		
		мКэшРеквизитовФормы[КлючИЗначение.Ключ] = Объект[КлючИЗначение.Ключ];
		
	КонецЦикла; 
	
КонецПроцедуры // ЗаполнитьТекущиеЗначенияРеквизитовФормы()

#КонецОбласти

#Область ПроцедурыИФункцииДляУправленияВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , Строка(""));
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры // УстановитьЗаголовокФормыДокумента()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	Элементы.РаспределенияРассчитатьПоРаспределениям.Доступность              = Ложь;
	Элементы.ФормаРедактироватьНачисленияПоСчетчикамВручную.КнопкаПоУмолчанию = ?(Объект.ВводВРучную, Истина, Ложь);
	Элементы.НачисленияНачисления.ТолькоПросмотр                              = НЕ Элементы.ФормаРедактироватьНачисленияПоСчетчикамВручную.КнопкаПоУмолчанию;
	Элементы.РаспределенияНачисления.ТолькоПросмотр                           = НЕ Элементы.ФормаРедактироватьНачисленияПоСчетчикамВручную.КнопкаПоУмолчанию;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Вывести в заголовке формы вид операции и статус документа (новый, не проведен, проведен).
	УстановитьЗаголовокФормыДокумента();
	
	// Зададим имена реквизитов, подлежащих кешированию.
	мКэшРеквизитовФормы = Новый Структура;
	
	// Запомним текущие значения реквизитов формы.
	ЗаполнитьТекущиеЗначенияРеквизитовФормы();
	
	// Установить доступность формы с учетом даты запрета редактирования	
	// БИТ_ЖКХ_25112013_начало_изменений
	// бит_РаботаСДиалогами.УстановитьДоступностьФормыДляРедактирования(Объект, ЭтаФорма);
	УстановитьДоступностьФормыДляРедактированияНаСервере();
	// БИТ_ЖКХ_25112013_окончание_изменений
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФорм

// БИТ_ЖКХ 13.10.2011
//
&НаКлиенте
Процедура ВыполнитьРасчетПоСчетчикам(Команда)
	
	Если ПолучитьКоличествоНачисленийНаСервере() > 0 Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ВыполнитьРасчетПоСчетчикамЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ВыполнитьРасчетПоСчетчикамФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасчетПоСчетчикамЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОчиститьНачисленияНаСервере();
	
	ВыполнитьРасчетПоСчетчикамФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьРасчетПоСчетчикамФрагмент()
	
	ВызватьРасчетПоСчетчикам();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоРаспределениям(Команда)
	
	Если ПолучитьКоличествоРаспределенийНаСервере() > 0 Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("РассчитатьПоРаспределениямЗавершение", ЭтотОбъект), "Табличная часть ""По распределениям"" будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	РассчитатьПоРаспределениямФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоРаспределениямЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ОчиститьРаспределенияНаСервере();
	
	РассчитатьПоРаспределениямФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура РассчитатьПоРаспределениямФрагмент()
	
	ВызватьРасчетПоРаспределениям();
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНачисленияПоСчетчикамВручную(Команда)
	
	Если Не Элементы.ФормаРедактироватьНачисленияПоСчетчикамВручную.КнопкаПоУмолчанию Тогда
		
		Объект.ВводВручную = Истина;
		
	Иначе
		
		// Восстановим автоматические движения документа.
		ПоказатьВопрос(Новый ОписаниеОповещения("РедактироватьНачисленияПоСчетчикамВручнуюЗавершение", ЭтотОбъект), "Ручная корректировка начислений по счетчикам отменена. 
		|Восстановить начисления сформированные автоматически?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	РедактироватьНачисленияПоСчетчикамВручнуюФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНачисленияПоСчетчикамВручнуюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ПолучитьКоличествоНачисленийНаСервере() > 0 Тогда
		
		ОчиститьНачисленияНаСервере();
		
	КонецЕсли;
	
	ВызватьРасчетПоСчетчикам();
	
	Если ПолучитьКоличествоРаспределенийНаСервере() > 0 Тогда
		
		ОчиститьРаспределенияНаСервере();
		
	КонецЕсли;
	
	ВызватьРасчетПоСчетчикам();
	
	Объект.ВводВручную = Ложь;
	
	РедактироватьНачисленияПоСчетчикамВручнуюФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура РедактироватьНачисленияПоСчетчикамВручнуюФрагмент()
	
	Элементы.ФормаРедактироватьНачисленияПоСчетчикамВручную.КнопкаПоУмолчанию = ?(Элементы.ФормаРедактироватьНачисленияПоСчетчикамВручную.КнопкаПоУмолчанию, Ложь, Истина);
	Элементы.НачисленияНачисления.ТолькоПросмотр                              = НЕ Элементы.ФормаРедактироватьНачисленияПоСчетчикамВручную.КнопкаПоУмолчанию;
	Элементы.РаспределенияНачисления.ТолькоПросмотр                           = НЕ Элементы.ФормаРедактироватьНачисленияПоСчетчикамВручную.КнопкаПоУмолчанию;
	
КонецПроцедуры

#КонецОбласти

