&НаКлиенте
Процедура ОчиститьОтборы(Команда)
	
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("СписокЛС");
	ЭлементыФормы.Добавить("СписокРайонов");
	ЭлементыФормы.Добавить("СписокУчастков");
	ЭлементыФормы.Добавить("СписокЗданий");
	ЭлементыФормы.Добавить("СписокУлиц");
	
	Для каждого Элемент Из ЭлементыФормы Цикл
		
		Объект[Элемент].Очистить();
		
		Если Элемент = "СписокЗданий" Тогда
			Объект.ТипКвартиры = Неопределено;
		КонецЕсли; 
		
	КонецЦикла;
	
	ОтобразитьТекущиеОтборы();
	
	ИзменитьСостояниеТабличногоПоля("НЕАКТУАЛЬНОСТЬОТЧЕТА");
	
КонецПроцедуры

