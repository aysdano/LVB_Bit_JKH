			НоваяСтрока.ВЫГРУЗКА_НормаБытОтходы     = ВЫГРУЗКА_НормаБытОтходы;
			
		КонецЦикла;
		
	КонецЦикла;
	
	мСтруктураИтоговОтчета.Вставить("Организация"           , Организация);
