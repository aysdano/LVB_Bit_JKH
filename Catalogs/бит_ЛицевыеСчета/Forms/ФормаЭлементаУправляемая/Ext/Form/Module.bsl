&НаСервере
Функция ЗапросДляРасшифровкиРазовыхНаСервере(Услуга)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка КАК Документ,
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Услуга,
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Сумма
	|ИЗ
	|	Документ.бит_РазовыеПоУслугамЖКХ.СписокУслуг КАК бит_РазовыеПоУслугамЖКХСписокУслуг
	|ГДЕ
	|	бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.Дата >= НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ)
	|	И бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.Дата <= КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ)
	|	И бит_РазовыеПоУслугамЖКХСписокУслуг.Услуга = &Услуга
	|	И бит_РазовыеПоУслугамЖКХСписокУслуг.Ссылка.ЛицевойСчет = &ЛицевойСчет";
	Запрос.УстановитьПараметр("Дата"        ,ТекущаяДата());
	Запрос.УстановитьПараметр("Услуга"      ,Услуга);
	Запрос.УстановитьПараметр("ЛицевойСчет" ,Объект.Ссылка);
	
	Возврат  Запрос.Выполнить().Выгрузить();
	
КонецФункции

