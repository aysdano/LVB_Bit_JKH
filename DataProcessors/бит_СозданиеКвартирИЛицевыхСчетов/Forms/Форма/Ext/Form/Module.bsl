Функция НайтиВладельцаКвартиры(Улица, Дом, Корпус)

 запрос = новый запрос;
 запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
                |	бит_СписокЗданий.Ссылка КАК Ссылка
                |ИЗ
                |	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
                |ГДЕ
                |	бит_СписокЗданий.Улица = &Улица
                |	И бит_СписокЗданий.НомерДома = &НомерДома
                |	И бит_СписокЗданий.Корпус = &Корпус";
 
 запрос.УстановитьПараметр("Улица", Улица);
 запрос.УстановитьПараметр("НомерДома", Дом);
 запрос.УстановитьПараметр("Корпус", Корпус);

 табЗапроса = запрос.Выполнить().Выгрузить(); 
 
 если табЗапроса.Количество() > 0 тогда
	 возврат табЗапроса[0].Ссылка;
 иначе 
	 возврат неопределено;
 конецесли; 	

