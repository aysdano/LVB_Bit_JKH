&НаКлиенте
Процедура кнВыбораПериода(Команда)
	
	Форма = ПолучитьФорму("Отчет.бит_ОтчетОДвиженияхНаЛСПомесячно.Форма.БыстрыйВыборСтандартногоПериода");
	Форма.СтандартныйПериод.ДатаНачала = Отчет.НачалоПериода;
	Форма.СтандартныйПериод.ДатаОкончания = Отчет.КонецПериода;
	Форма.Дата = Отчет.НачалоПериода;
	
	РезультатВыбора = Форма.ОткрытьМодально();
	
	Если РезультатВыбора <> Неопределено Тогда
		
		Отчет.НачалоПериода = РезультатВыбора.ДатаНачала;
		Отчет.КонецПериода  = РезультатВыбора.ДатаОкончания; 
		
	КонецЕсли;
	
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура кнМесяцРегулирование(Команда)
	
	ИмяКоманды = Команда.Имя;
	
	Если ИмяКоманды = "кнТекущийМесяц" Тогда
		
		Отчет.НачалоПериода = НачалоМесяца(ТекущаяДата());
		Отчет.КонецПериода  = КонецМесяца(ТекущаяДата());
		
	Иначе
		
		Если ИмяКоманды = "кнМесяцНазад" Тогда 
			
			ЧислоМесяцев = -1;
			
		ИначеЕсли ИмяКоманды = "кнМесяцВперед" Тогда
			
			ЧислоМесяцев = 1;
			
		КонецЕсли;
		
		Отчет.НачалоПериода = НачалоМесяца(ДобавитьМесяц(Отчет.НачалоПериода, ЧислоМесяцев));
		Отчет.КонецПериода  = КонецМесяца(Отчет.НачалоПериода);
		
	КонецЕсли;
	
	ОбновитьТекстЗаголовка(ЭтаФорма);
	
КонецПроцедуры

