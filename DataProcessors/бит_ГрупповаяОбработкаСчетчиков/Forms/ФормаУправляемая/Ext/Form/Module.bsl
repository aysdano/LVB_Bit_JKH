	ПоместитьЗначениеВОтборКомпановщика(СтатусКвартиры, 1);
	
	СписокЗданий = Неопределено;
	ЛицевыеСчета = Неопределено;
	ВидыСчетчика = Неопределено;
	
	ВидСравненияЛицевыеСчета = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияСписокЗданий = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияВидСчетчика  = ВидСравненияКомпоновкиДанных.Равно;
	
	ИспользоватьОтборВидСчетчика  = Ложь;
	ИспользоватьОтборЛицевойСчет  = Ложь;
	ИспользоватьОтборСписокЗданий = Ложь;
	
КонецПроцедуры // () 

&НаСервереБезКонтекста
// Процедура проверяет счетчик. 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ВыполнитьПроверкуСчетчика(Знач Счетчик, Знач СписокУслуг, Знач ВидОперации, Знач Дата)
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли; 
	
	СтруктураРезультат = Новый Структура;
	СтруктураРезультат.Вставить("ОбъектУчета", Неопределено);
	СтруктураРезультат.Вставить("ЕстьОшибка" , Ложь);
	СтруктураРезультат.Вставить("Сообщение"  , "");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("Счетчик"    , Счетчик);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект КАК Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Счетчик = &Счетчик
	|				И ИСТИНА) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|ИТОГИ ПО
	|	Объект";
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		СтруктураРезультат.ЕстьОшибка = Истина;
		СтруктураРезультат.Сообщение  = СтруктураРезультат.Сообщение + " Счетчик не установлен;";
		
	Иначе
		
		ВыборкаОбъект = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаОбъект.Следующий() Цикл
			
			СтруктураРезультат.ОбъектУчета = ВыборкаОбъект.Объект;
			
			Если НЕ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика Тогда
				
				РезультатЛС = ПроверитьНаличиеУслугНаОбъектеУчета(ВыборкаОбъект.Объект, СписокУслуг, Дата);
				
				Если РезультатЛС.ЕстьОшибка Тогда
					СтруктураРезультат.ЕстьОшибка = Истина;
					СтруктураРезультат.Сообщение  = СтруктураРезультат.Сообщение + РезультатЛС.Сообщение; 
				КонецЕсли;
				
			КонецЕсли; 
			
			Выборка = ВыборкаОбъект.Выбрать();
			
			СписокУслугНаСчетчик = Новый СписокЗначений;
			
			Пока Выборка.Следующий() Цикл
				СписокУслугНаСчетчик.Добавить(Выборка.Услуга);
			КонецЦикла;
			
			Если ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик Тогда
				
				Для каждого ЭлементСписка Из СписокУслугНаСчетчик Цикл
					
					Услуга =  ЭлементСписка.Значение;
					
					Если НЕ СписокУслуг.НайтиПоЗначению(Услуга) = Неопределено Тогда
						
						СтруктураРезультат.ЕстьОшибка = Истина;
						СтруктураРезультат.Сообщение  = СтруктураРезультат.Сообщение + " Услуга : " + Услуга + " установлена на счетчике;";
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла; 
				
			ИначеЕсли ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УдалитьУслугиСоСчетчика Тогда
				
				Для каждого ЭлементСписка Из СписокУслуг Цикл
					
					Услуга =  ЭлементСписка.Значение;
					
					Если СписокУслугНаСчетчик.НайтиПоЗначению(Услуга) = Неопределено Тогда
						
						СтруктураРезультат.ЕстьОшибка = Истина;
						СтруктураРезультат.Сообщение  = СтруктураРезультат.Сообщение + " Услуга : " + Услуга + " не установлена на счетчике;";
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли; 
			
		КонецЦикла; 
	КонецЕсли;
	
	Возврат СтруктураРезультат;
	
КонецФункции // () 

&НаСервереБезКонтекста
// Процедура проверяет наличие услуг на объекте учета.
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ПроверитьНаличиеУслугНаОбъектеУчета(Знач ОбъектУчета, Знач СписокУслуг, Знач Дата)
	
	Если НЕ ЗначениеЗаполнено(Дата) Тогда
		Дата = ТекущаяДата();
	КонецЕсли;
	
	ЕстьОшибка = Ложь;
	
	Результат = Новый Структура;
	Результат.Вставить("ЕстьОшибка", ЕстьОшибка);
	Результат.Вставить("Сообщение" , "");
	
	Запрос = Новый запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ОбъектУчета);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	ТаблицаУслуг = Запрос.Выполнить().Выгрузить();
	
	ТекстСообщения = "";
	
	Для каждого ЭлементСписка Из СписокУслуг Цикл
		
		Если ТаблицаУслуг.Найти(ЭлементСписка.Значение) = Неопределено Тогда
			
			Результат.ЕстьОшибка = Истина;
			ТекстСообщения = ТекстСообщения + ?(ПустаяСтрока(ТекстСообщения),"",",") + ЭлементСписка.Значение ;
			
		КонецЕсли; 
		
	КонецЦикла;
	
	Если Результат.ЕстьОшибка Тогда
		Результат.Сообщение  = " На личевом счете не установлены услуги: " + ТекстСообщения + ";";
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции // () 

&НаСервере
// Процедура создает установку счетчика. 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ВыполнитьОперациюНаСервере()
	
	Для каждого СтрокаТаблицы Из ТаблицаСчетчиков Цикл
		
		Если НЕ СтрокаТаблицы.Обрабатывать Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаТаблицы.Обрабатывать = Ложь;
		
		ДокументОбъект = Документы.бит_УстановкаСчетчика.СоздатьДокумент();
		
		ДокументОбъект.Дата        = Объект.ДатаУстановкиСчетчиков;
		ДокументОбъект.ВидОперации = ВидОперации;
		ДокументОбъект.Организация = СтрокаТаблицы.ОбъектУчета.Организация;
		ДокументОбъект.Счетчик     = СтрокаТаблицы.Счетчик;
		ДокументОбъект.Объект      = СтрокаТаблицы.ОбъектУчета;
		
		КэшДокумента = Документы.бит_УстановкаСчетчика.ОбновитьКэшДокумента(ДокументОбъект);
		
		Если НЕ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика Тогда
			
			ЗаполнитьЗначенияСвойств(ДокументОбъект, КэшДокумента);
			
			Для каждого ЭлементСписка Из СписокУслуг Цикл
				
				НоваяСтрока = ДокументОбъект.Услуги.Добавить();
				НоваяСтрока.Услуга = ЭлементСписка.Значение;
				
			КонецЦикла; 
			
		КонецЕсли; 
		
		Попытка
			
			ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
			СтрокаТаблицы.Документ = ДокументОбъект.Ссылка;
			
		Исключение
			
			СтрокаТаблицы.ЕстьОшибка = Истина;
			СтрокаТаблицы.Сообщение  = ОписаниеОшибки(); 
			
		КонецПопытки; 
		
	КонецЦикла; 
	
КонецПроцедуры // () 

&НаКлиенте
Процедура СкрытьПоказатьМеню(Команда)
	
	Элементы.Меню.Видимость = Не Элементы.Меню.Видимость;
	
	Если Элементы.Меню.Видимость Тогда
		Элементы.ФормаСкрытьПоказатьМеню.Заголовок = "Скрыть меню";
	Иначе
		Элементы.ФормаСкрытьПоказатьМеню.Заголовок = "Показать меню";
	КонецЕсли; 
	
КонецПроцедуры

