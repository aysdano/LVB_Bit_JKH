	СтрОтветственного = неопределено;
	ЧислоЗаписей = МассивСтру.Количество();
	Для Инд=0 по ЧислоЗаписей-1 цикл
		//Проверим согласиеПД
		Стру = МассивСтру[Инд];
		Если Стру=Неопределено тогда 
			продолжить
		КонецЕсли;	
		ПроверитьОбновитьСогласиеПД(Стру);
		Если ТекЗданиеКод<>Стру.ЗданиеКод тогда   		
						
			СтрокаТекДок = мДокиДомов.Найти(Стру.Здание);
			
			Если СтрокаТекДок<>Неопределено тогда 
				ТекДок = СтрокаТекДок.ДокСсылка;
