					ЗаявлениеОСнятии.Параметры.ж 				  = "";
					ЗаявлениеОСнятии.Параметры.м 				  = ""; 
					
					Если ЗначениеЗаполнено(ВыборкаСН.ПроживающийСтраховойНомерПФР) Тогда
						
						Для Значение = 1 по	СтрДлина(ВыборкаСН.ПроживающийСтраховойНомерПФР) Цикл
							
							Если ЗначениеНеЧисло = Ложь Тогда
								Если ЗначениеЗаполнено(СНИЛС) Тогда
									
									ПредСНИЛС = Прав(СНИЛС,СтрДлина(СНИЛС)- 5);
									
									СНИЛС = Строка("СНИЛС" + (Число(ПредСНИЛС) +1));
