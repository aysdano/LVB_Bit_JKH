перем мОтладка;



Функция РасшифровкаПоЛицевомуСчету(ЛС,ДляЗависимых=ложь,ТолькоПоследнийМесяц = ложь) экспорт
	
	Если ДляЗависимых = истина тогда
		СводныйТабДок = новый ТабличныйДокумент;
		ЗависимыеЛС = СписокЗависимыхЛС(ЛС);
		ВыводитьРазделитель = ложь;
		Для каждого ЛС1 из ЗависимыеЛС цикл
			Если ВыводитьРазделитель тогда
				СводныйТабДок.ВывестиГоризонтальныйРазделительСтраниц();
			КонецЕсли;	
			ТабДок = РасшифровкаПоЛицевомуСчету(ЛС1,ложь);
			СводныйТабДок.Вывести(ТабДок);
			ВыводитьРазделитель = Истина;
		КонецЦикла;	
		возврат СводныйТабДок;
	КонецЕсли;	
	
	
	
	
	//Данные -  за весь период раздельно по основному и по зависимым
	
	ЗависимыеЛС  = СписокЗависимыхЛС(ЛС);
	
	 	
	ТаблСуммыЛС= СуммыДляОтчета(ЛС,ЗависимыеЛС,ЭтотОбъект.ДатаНач,ЭтотОбъект.ДатаКон);
	
	
	ТаблСуммыПениЛС = СуммыПениДляОтчета(ЛС,ЭтотОбъект.ДатаНач,ЭтотОбъект.ДатаКон);
	ТаблПараметрыЛС = ПараметрыЛС(ЛС,ЭтотОбъект.ДатаНач,ЭтотОбъект.ДатаКон);
	ТаблРасшОплат = ДанныеРасшифровкиОплат(ЛС);
	ТаблРасшРазовых = ДанныеРасшифровкиРазовых(ЛС);
	
	
    ТаблКолонок = ПолучитьКолонкиОтчета(ЛС,ЗависимыеЛС,ТаблСуммыЛС,ТаблСуммыПениЛС);

	НачалоМесяцаКон = НачалоМесяца(ЭтотОбъект.ДатаКон);
	//ТаблСуммыЗависимых = СуммыДляОтчета(ЗависимыеЛС,НачалоМесяцаКон,ЭтотОбъект.ДатаКон);
	ТаблПараметровЛС = ПараметрыЛС(ЗависимыеЛС,ЭтотОбъект.ДатаНач,ЭтотОбъект.ДатаКон);
	
		
	                                                                                                       		
	//ДобавитьКолонкиОтчета(КолонкиОтчета,ЛС,ТаблСуммыЛС);
	//ДобавитьКолонкиОтчета(КолонкиОтчета,ЗависимыеЛС,ТаблСуммыЗависимых);
	
	ТабДок = новый ТабличныйДокумент;

 	ОбластиМакета = СтруктураОбластейМакета();

	ВывестиЗаголовокОтчетаЛС(ТабДок,ЛС,ОбластиМакета) ;                                            
	ТекМес = ?(ТолькоПоследнийМесяц,НачалоМесяца(ЭтотОбъект.ДатаКон),НачалоМесяца(ЭтотОбъект.ДатаНач));
	Пока ТекМес<=ЭтотОбъект.ДатаКон цикл
		ВывестиБлокРасшифровки(ТабДок,ЛС,ТекМес,ОбластиМакета,ТаблКолонок,ТаблПараметровЛС,ТаблСуммыЛС,ТаблСуммыПениЛС,
								ТаблРасшРазовых,ТаблРасшОплат);
		ТекМес = ДобавитьМесяц(ТекМес,1);						
	КонецЦикла;		
	
	
	Для каждого ЛС1 из ЗависимыеЛС цикл
		ВывестиПримечаниеЗависимого(ТабДок,ЛС1,ОбластиМакета);
		ТабДок1 = РасшифровкаПоЛицевомуСчету(ЛС1,ложь,истина);
		ТабДок.Вывести(ТабДок1);
	КонецЦикла;	
	
	
	возврат ТабДок
КонецФункции	

Процедура ВывестиПримечаниеЗависимого(ТабДок,ЛС1,ОбластиМакета);
	Область = ОбластиМакета.ПримЗависимого;
	Область.Параметры.ЛС = ЛС1;
	Табдок.Вывести(Область);
КонецПроцедуры 

Процедура ВывестиЗаголовокОтчетаЛС(ТабДок,ЛС,ОбластиМакета)
	Если ложь тогда ЛС = Справочники.бит_ЛицевыеСчета.Выбрать().Ссылка КонецЕсли;
	АдресЛС = лб_Адрес(ЛС.Квартира);
	Область = ОбластиМакета.Шапка;
	Область.Параметры.НомерЛС    = ЛС;
	Область.Параметры.ЛС = ЛС;
	Область.Параметры.Адрес = АдресЛС;
	Область.Параметры.Район = ЛС.Здание.Район;
	ТабДок.Вывести(Область);
КонецПроцедуры	


Функция лб_Адрес(Квартира,Сокращенный=истина,Дата=неопределено) экспорт
	Если ложь тогда Квартира = Справочники.бит_Квартиры.Выбрать().Ссылка КонецЕсли;
	Дом = Квартира.Владелец;
	
	Если Сокращенный = истина тогда
		АдресДома = ""+Дом.Улица + ", д."+Дом.НомерДома+Дом.ПрефиксДома;
	Иначе
		ВидКИ = Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания;
		ТипКИ = Перечисления.бит_ТипыКонтактнойИнформации.Адрес;
		ЗАпрос = новый запрос;
		Запрос.УстановитьПараметр("Вид",ВидКИ);
		Запрос.УстановитьПараметр("Тип",ТипКИ);
		ЗАпрос.УстановитьПараметр("Объект",Дом);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_КонтактнаяИнформация.Представление
			|ИЗ
			|	РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
			|ГДЕ
			|	бит_КонтактнаяИнформация.Объект = &Объект
			|	И бит_КонтактнаяИнформация.Тип = &Тип
			|	И бит_КонтактнаяИнформация.Вид = &Вид";
		Выборка = ЗАпрос.Выполнить().Выбрать();
		Если Выборка.Следующий() тогда
			АдресДома = Выборка.Представление;
		иначеЕсли Не ПустаяСтрока(Дом.ПочтовыйАдрес) тогда
			АдресДома = Дом.ПочтовыйАдрес; 
		иначе	
			АдресДома = "*** Почтовый адрес дома "+ Дом.Код + " не заполнен ***";
		КонецЕсли;
	КонецЕсли;
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Квартира",Квартира);
	ЗАпрос.УстановитьПараметр("Дата",Дата);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК ПредставлениеКвартиры
		|ИЗ
		|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() и НЕ ПустаяСтрока(Выборка.ПредставлениеКвартиры) тогда
		ПервыйСимволПредставления = лев(Выборка.ПредставлениеКвартиры,1);
		пр1 = ?(СтрНайти("0123456789",ПервыйСимволПредставления)>0,"кв.",""); 
		Адрес = АдресДома + ", "+пр1+ Выборка.ПредставлениеКвартиры;
	иначе
		Адрес = АдресДома + ", кв."+Квартира.НомерКвартиры + Квартира.ПрефиксКвартиры
	КонецЕсли;	
		
	возврат Адрес	
КонецФункции

Процедура ВывестиБлокРасшифровки(ТабДок,ЛС,ТекМес,ОбластиМакета,ТаблКолонок,ТаблПараметровЛС,ТаблСуммыЛС,
									ТаблСуммыПениЛС,ТаблРасшРазовых,ТаблРасшОплат);
	СообщитьОтладка("ВывестиБлокРасшифровки" + " ЛС=" + ЛС + " ТекМес="+ТекМес);							
								
								
КонецПроцедуры

Функция СтруктураОбластейМакета()
	Макет = ЭтотОбъект.ПолучитьМакет("Макет");
	
	
	Области = новый структура;
	
    Области.Вставить("НазванияУслуг_Лев"	, Макет.ПолучитьОбласть("НазванияУслуг|Лев"));
	Области.Вставить("НазванияУслуг_Услуга" , Макет.ПолучитьОбласть("НазванияУслуг|Услуга"));
	Области.Вставить("НазванияУслуг_Пени"   , Макет.ПолучитьОбласть("НазванияУслуг|Пени"));
	Области.Вставить("НМОО_Лев"     , Макет.ПолучитьОбласть("НМООО|Лев"));
	Области.Вставить("НМООО_Услуга" , Макет.ПолучитьОбласть("НМООО|Услуга"));
	Области.Вставить("НМООО_Пени"   , Макет.ПолучитьОбласть("НМООО|Пени"));
	Области.Вставить("НМ_Лев"       , Макет.ПолучитьОбласть("НМ|Лев"));
	Области.Вставить("НМ_Услуга"	, Макет.ПолучитьОбласть("НМ|Услуга"));
	Области.Вставить("НМ_Пени"   	, Макет.ПолучитьОбласть("НМ|Пени"));
	Области.Вставить("Нач1_Лев"     , Макет.ПолучитьОбласть("Нач1|Лев"));
	Области.Вставить("Нач1_Услуга" 	, Макет.ПолучитьОбласть("Нач1|Услуга"));
	Области.Вставить("Нач1_Пени"   	, Макет.ПолучитьОбласть("Нач1|Пени"));
	Области.Вставить("Раз1_Лев"     , Макет.ПолучитьОбласть("Раз1|Лев"));
	Области.Вставить("Раз1_Услуга" 	, Макет.ПолучитьОбласть("Раз1|Услуга"));
	Области.Вставить("Раз1_Пени"   	, Макет.ПолучитьОбласть("Раз1|Пени"));
	Области.Вставить("Опл1_Лев"     , Макет.ПолучитьОбласть("Опл1|Лев"));
	Области.Вставить("Опл1_Услуга" 	, Макет.ПолучитьОбласть("Опл1|Услуга"));
	Области.Вставить("Опл1_Пени"   	, Макет.ПолучитьОбласть("Опл1|Пени"));
	Области.Вставить("КМ_Лев"       , Макет.ПолучитьОбласть("КМ|Лев"));
	Области.Вставить("КМ_Услуга" 	, Макет.ПолучитьОбласть("КМ|Услуга"));
	Области.Вставить("КМ_Пени"   	, Макет.ПолучитьОбласть("КМ|Пени"));
	Области.Вставить("Пустая_Лев"   , Макет.ПолучитьОбласть("Пустая|Лев"));
	Области.Вставить("Пустая_Услуга", Макет.ПолучитьОбласть("Пустая|Услуга"));
	Области.Вставить("Пустая_Пени"  , Макет.ПолучитьОбласть("Пустая|Пени"));
	
	Области.Вставить("ИтогоСРЖ"	, Макет.ПолучитьОбласть("ИтогоСРЖ"));
	Области.Вставить("Шапка"    , Макет.ПолучитьОбласть("Шапка"));
	Области.Вставить("ШапкаБл1" , Макет.ПолучитьОбласть("ШапкаБл1"));
	Области.Вставить("ШапкаБл2" , Макет.ПолучитьОбласть("ШапкаБл2"));
	Области.Вставить("ПримЗависимого", Макет.ПолучитьОбласть("ПримЗависимого"));
	
	возврат Области;
КонецФункции	

