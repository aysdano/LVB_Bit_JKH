функция ПолучитьТаблицуГрупповыхСчетчиковНаУслугах(ПериодЗапроса)
  запрос = новый запрос;
  
  запрос.Текст = "ВЫБРАТЬ
                 |	бит_ГрупповыеСчетчикиСрезПоследних.Услуга КАК Услуга,
                 |	бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик КАК ГрупповойСчетчик,
                 |	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
                 |	бит_ГрупповыеСчетчикиСрезПоследних.Использовать КАК Использовать
                 |ИЗ
                 |	РегистрСведений.бит_ГрупповыеСчетчики.СрезПоследних(&ПериодЗапроса,) КАК бит_ГрупповыеСчетчикиСрезПоследних";	
	
  запрос.УстановитьПараметр("ПериодЗапроса", ПериодЗапроса);

  возврат запрос.Выполнить().Выгрузить();
	
КонецФункции

