	Запрос.УстановитьПараметр("PREDS", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000013"));   //
	Запрос.УстановитьПараметр("RFRK", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000009"));  //
	Запрос.УстановитьПараметр("SOD_J", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001")); //
	Запрос.УстановитьПараметр("VO_J", Справочники.бит_УслугиЖКХ.ПустаяСсылка());
	Запрос.УстановитьПараметр("XV_J", Справочники.бит_УслугиЖКХ.ПустаяСсылка());
	Запрос.УстановитьПараметр("ААС", Справочники.бит_УслугиЖКХ.ПустаяСсылка());    //
	Запрос.УстановитьПараметр("АГТ", Справочники.бит_УслугиЖКХ.ПустаяСсылка());   //
	Запрос.УстановитьПараметр("АПТ", Справочники.бит_УслугиЖКХ.ПустаяСсылка());     //
	Запрос.УстановитьПараметр("ОбслуживаниеПУ", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000008"));
	Запрос.УстановитьПараметр("ОтоплениеОКСК", Справочники.бит_УслугиЖКХ.ПустаяСсылка());
	Запрос.УстановитьПараметр("ДатаНачала", НачалоПериода);
	Запрос.УстановитьПараметр("ДатаОкончания", Новый Граница(КонецДня(КонецПериода), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Начисления", МассивНачислений);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Участки", МассивУчастков);
	Запрос.УстановитьПараметр("ТипыКвартир", МассивТиповКвартир);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ОбластьШапка = Макет.ПолучитьОбласть("Шапка");
	ОбластьДетальныхЗаписей = Макет.ПолучитьОбласть("Строка");
	
	ТабДок.Очистить();
	ТабДок.Вывести(ОбластьШапка);
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ОбластьДетальныхЗаписей.Параметры.Заполнить(ВыборкаДетальныеЗаписи);
		ТабДок.Вывести(ОбластьДетальныхЗаписей);
	КонецЦикла;
	
	ИмяВременногоФайла = ПолучитьИмяВременногоФайла("xlsx");    
	
	ТабДок.Записать(ИмяВременногоФайла, ТипФайлаТабличногоДокумента.XLSX);
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(Новый ДвоичныеДанные(ИмяВременногоФайла), УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьФайлXLSНаКлиенте()
	
	ПолноеИмяФайла = Каталог + "\" + Формат(ТекущаяДата(),"ДФ='dd-MM-yyyy HH.mm.ss'") + ".xlsx";
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		ПолноеИмяФайла = Каталог + "\" + ИмяФайла + ".xlsx";	
	КонецЕсли; 
	
	Попытка
		
		ПолучитьФайл(АдресВоВременномХранилище, ПолноеИмяФайла, Ложь);
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Создан файл: " + ПолноеИмяФайла;
		Сообщение.Сообщить();
		
	Исключение
	    Сообщить(ОписаниеОшибки());
	КонецПопытки; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьПредставлениеСпособаДетализации()
	
	Если СпособДетализации = "1" Тогда
		Возврат "по участкам";	
	ИначеЕсли СпособДетализации = "2" Тогда 
		Возврат "по адресам";	
	Иначе	
		Возврат "по лицевым счетам";	
	КонецЕсли; 
	
КонецФункции
 
&НаСервере
Функция ПолучитьМассивНачислений()
	
	МассивНачислений = Новый Массив;
	
	Отбор = Новый Структура("ВыполняетсяОтбор", Истина);
	НайденныеСтроки = Начисления.НайтиСтроки(Отбор);
	Если НайденныеСтроки.Количество() = 0 Тогда
		МассивНачислений = Начисления.Выгрузить(,"Начисление").ВыгрузитьКолонку("Начисление");
	Иначе 	
		Для каждого НайденнаяСтрока Из НайденныеСтроки Цикл
			МассивНачислений.Добавить(НайденнаяСтрока.Начисление);	
		КонецЦикла; 	
	КонецЕсли; 
	
	Возврат МассивНачислений;
	
КонецФункции

