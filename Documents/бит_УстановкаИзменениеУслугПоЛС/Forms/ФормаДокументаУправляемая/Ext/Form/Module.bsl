    ВыбранноеЗначение = ДополнительныеПараметры.ВыбранноеЗначение;
    
    
    Если ЗначениеЗаполнено(Объект.Услуга) И ПроверитьУслугуНаЗдании(КонецДня(Объект.Дата), ВыбранноеЗначение, Объект.Услуга) Тогда
        
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Услуга :" + Объект.Услуга + """ не подключена по адресу: ул. " + ПолучитьУлицуЗданияНаСервере(ВыбранноеЗначение) + ", д." + ВыбранноеЗначение + ".");
        Объект.Услуга = Неопределено;
        
    КонецЕсли;

