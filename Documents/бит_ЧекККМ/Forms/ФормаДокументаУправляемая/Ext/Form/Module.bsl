	мПечатьГруппУслуг                    = ПараметрыЖКХ.ГруппироватьУслугиВЧеке;
	мНеПечататьРайон                     = ПараметрыЖКХ.НеПечататьРайон;
	мПрефиксУлица                        = ПараметрыЖКХ.ПрефиксУлица;
	мПрефиксДом                          = ПараметрыЖКХ.ПрефиксДом;
	мПрефиксКорпус                       = ПараметрыЖКХ.ПрефиксКорпус;
	мПрефиксКвартира                     = ПараметрыЖКХ.ПрефиксКвартира;
	мПрефиксРайон                        = ПараметрыЖКХ.ПрефиксРайон;
