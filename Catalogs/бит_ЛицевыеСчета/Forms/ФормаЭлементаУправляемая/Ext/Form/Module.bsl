// Процедура - обработчик события "ОбработкаОповещения" формы.
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если (ИмяСобытия = "ИзменениеУслугПоЛС" И Параметр = Объект.Ссылка) 
		или (ИмяСобытия = "ИзменениеКвартирыдляЛС" И Параметр = Объект.Квартира) 
		или (ИмяСобытия = "ИзменениеПроживающихПоЛС" И Параметр = Объект.Ссылка) тогда
		
		ЗаполнитьОписания();	
	КонецЕсли;	
	
