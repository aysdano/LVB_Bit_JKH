				Для каждого ТекСтрока Из КоммунальныеУслуги Цикл
					ТекСтрока.Сумма = ?(ИтогНачисления = 0 ,0 ,ТекСтрока.Начислено/ИтогНачисления) * СуммаДокумента;
				КонецЦикла;
				
			КонецЕсли;
			
			
		ИначеЕсли (ШаблонИзвещения.Сальдо = Перечисления.ДаНет.Нет И ШаблонИзвещения.Кредит = Перечисления.ДаНет.Нет) Тогда	// Для НачислятьПениСУчетомПереплаты
			
			НетПени		= Истина;
			ИтогСальдо  = КоммунальныеУслуги.Итог("Сальдо");
			
			
			//Начисление Суммы по будущим Начислениям.
			Для Каждого ТекСтрока Из КоммунальныеУслуги Цикл 
				ТекСтрока.Сумма = ?(ИтогНачисления = 0 ,0 ,ТекСтрока.Начислено/ИтогНачисления) * СуммаДокумента;
			КонецЦикла;
			
		КонецЕсли;
		
		
		//Распределение погрешности округлений при распределении Суммы и СуммыПени.  // Для НачислятьПениСУчетомПереплаты
		Если КоммунальныеУслуги.Количество() > 0  Тогда
			
			СуммаПени = КоммунальныеУслуги.Итог("СуммаПени");
			СуммаПроверки = КоммунальныеУслуги.Итог("Сумма") + ?(НетПени, 0, СуммаПени);
			
			Если СуммаПроверки <> СуммаДокумента Тогда
				
				Если СуммаДокумента > 0 Тогда
					КоммунальныеУслуги.Сортировать("Сумма Убыв");
				Иначе
					КоммунальныеУслуги.Сортировать("Сумма Возр");
				КонецЕсли;
				
				Остаток = СуммаДокумента - СуммаПроверки;
				
				Если НЕ НетПени Тогда
					
					СальдоПени = КоммунальныеУслуги.Итог("СальдоПени");
					Если СуммаПени > 0 
						И СуммаПени < СальдоПени Тогда
						
						Для Каждого Стр Из КоммунальныеУслуги Цикл
							Если Стр.СуммаПени < Стр.СальдоПени Тогда
								СвободныйОстаток = Мин(Остаток, Стр.СальдоПени - Стр.СуммаПени); 
								Стр.СуммаПени = Стр.СуммаПени + СвободныйОстаток;
								Остаток = Остаток - СвободныйОстаток;
								Если Остаток = 0 ИЛИ  КоммунальныеУслуги.Итог("СальдоПени") =  КоммунальныеУслуги.Итог("СуммаПени") Тогда
									Прервать;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
					
				КонецЕсли; 
				
				Если Остаток <> 0 Тогда
					
					// БИТ_ЖКХ 12.05.2016 15:17:10 Начало правки... Адресуем остаток на не отключенную услугу
					Если НЕ ДатаОплаты = Неопределено Тогда
						Запрос = Новый Запрос;
						Запрос.Текст = 
						"ВЫБРАТЬ
						|	КоммунальныеУслуги.ЛицевойСчет КАК ЛицевойСчет,
						|	КоммунальныеУслуги.Услуга КАК Услуга
						|ПОМЕСТИТЬ ВТ_КоммунальныеУслуги
						|ИЗ
						|	&КоммунальныеУслуги КАК КоммунальныеУслуги
						|;
						|
						|////////////////////////////////////////////////////////////////////////////////
						|ВЫБРАТЬ
						|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
						|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
						|ИЗ
						|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
						|			&ДатаОплаты,
						|			(ЛицевойСчет, Услуга) В
						|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
						|					ВТ_КоммунальныеУслуги.ЛицевойСчет,
						|					ВТ_КоммунальныеУслуги.Услуга
						|				ИЗ
						|					ВТ_КоммунальныеУслуги)) КАК бит_СведенияПоУслугамЛССрезПоследних
						|ГДЕ
						|	НЕ бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления = ЗНАЧЕНИЕ(Справочник.бит_РежимыПотребленияУслуг.Нет)";
						
						Запрос.УстановитьПараметр("ДатаОплаты", ДатаОплаты );
						Запрос.УстановитьПараметр("КоммунальныеУслуги", КоммунальныеУслуги);
						
						Результат = Запрос.Выполнить().Выгрузить();
						
						Если Результат.Количество() = 0 Тогда
							ТабЛСКоммунальныеУслуги = КоммунальныеУслуги.Скопировать(,"ЛицевойСчет");
							ТабЛСКоммунальныеУслуги.Свернуть("ЛицевойСчет");
