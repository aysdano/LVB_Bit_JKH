//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьУВОРУ() Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_КонтактнаяИнформация.Вид,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачи,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ФИОПроживающихСрезПоследних.ФизЛицо.МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПаспортнаяСлужба,
	|	бит_КонтактнаяИнформация.Представление КАК АдресПаспортнойСлужбы
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПаспортнаяСлужба = бит_КонтактнаяИнформация.Объект
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = ПолучитьМакет("УВОРУ");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	ШапкаОбласть.Параметры.ЧислоТек = Формат(Дата,"ДФ=dd");
	ДатаМесяц 						= Формат(Дата,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.МесяцТек = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ШапкаОбласть.Параметры.ГодТек   = Формат(Дата,"ДФ=yy");
	
	Если ЗначениеЗаполнено(Выборка.ДомРег) Тогда
		ШапкаОбласть.Параметры.ОрганУчета = Выборка.ДомРег.ПаспортнаяСлужба;
	КонецЕсли;
	
	ШапкаОбласть.Параметры.ЧислоСнят = Формат(ДатаСнятияСРегистрации,"ДФ=dd");
	ДатаМесяц 						= Формат(ДатаСнятияСРегистрации,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.МесяцСнят = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ШапкаОбласть.Параметры.ГодСнят   = Формат(ДатаСнятияСРегистрации,"ДФ=yy");
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) Тогда
		
		Если ЗначениеЗаполнено(Выборка.ФизЛицоМестоРождения) Тогда

			СтрокаМестоРождения = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(Выборка.РегистрируемоеЛицо.МестоРождения, Истина);

		Иначе

			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "В справочнике ""Проживающие"" заполните место рождения регистрируемого лица!";
			Сообщение.Сообщить();
			
		КонецЕсли; 
		
		ФизЛицо = ?(ЗначениеЗаполнено(Выборка.Фамилия),Строка(Выборка.Фамилия),"")
		+ ?(ЗначениеЗаполнено(Выборка.Имя)," " + Строка(Выборка.Имя),"")
		+?(ЗначениеЗаполнено(Выборка.Отчество)," "+Строка(Выборка.Отчество),"")
		+?(ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.ДатаРождения), ", "+Формат(Выборка.РегистрируемоеЛицо.ДатаРождения,"ДФ='yyyy ""г.р.""'"), "")
		+ ?(ЗначениеЗаполнено(Выборка.ФизЛицоМестоРождения),", "  + СтрокаМестоРождения,"");
		ФизЛицо_1 = "";
		ФизЛицо_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ФизЛицо, 70, ФизЛицо_1 , ФизЛицо_2 );
		ШапкаОбласть.Параметры.ФизЛицо_1 = ФизЛицо_1;
		ШапкаОбласть.Параметры.ФизЛицо_2 = ФизЛицо_2;
		
	КонецЕсли; 
	
	ОрганУчетаАдрес_1 = "";
	ОрганУчетаАдрес_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.АдресПаспортнойСлужбы, 40, ОрганУчетаАдрес_1 , ОрганУчетаАдрес_2 );
	ШапкаОбласть.Параметры.ОрганУчетаАдрес_1 = ОрганУчетаАдрес_1;
	ШапкаОбласть.Параметры.ОрганУчетаАдрес_2 = ОрганУчетаАдрес_2;
	
	ПредставлениеРег_1 = "";
	ПредставлениеРег_2 = "";
	Если ЗначениеЗаполнено(Выборка.ПочтовыйАдрес) Тогда
		СтрокаАдресРегистрации = Выборка.ПочтовыйАдрес + ", кв." + Строка(Выборка.КвартираРег);
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаАдресРегистрации, 75, ПредставлениеРег_1 , ПредставлениеРег_2 );
	КонецЕсли; 
	ШапкаОбласть.Параметры.ПредставлениеРег_1 = ПредставлениеРег_1;
	ШапкаОбласть.Параметры.ПредставлениеРег_2 = ПредставлениеРег_2;
	
	Если ЗначениеЗаполнено(Организация) Тогда
		Если Организация.ВариантНаименованияДляПечатныхФорм = Перечисления.ВариантыНаименованияДляПечатныхФорм.СокращенноеНаименование Тогда
			НаименованиеОрганизации = Организация.НаименованиеСокращенное; 
		Иначе
			НаименованиеОрганизации = Организация.НаименованиеПолное; 
		КонецЕсли;
		ШапкаОбласть.Параметры.НаименованиеОрганизации = НаименованиеОрганизации;
	КонецЕсли;
	ДолжностноеЛицоФИО = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Организация, ДолжностноеЛицо, Дата, Ложь);
	Если ТипЗнч(ДолжностноеЛицоФИО) = Тип("Структура") Тогда
		ШапкаОбласть.Параметры.ДолжностноеЛицо = ДолжностноеЛицоФИО.ДолжностноеЛицо;
	КонецЕсли;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой сличительной ведомости.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьАЛУ(ВидМакета) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ЕСТЬNULL(бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_КонтактнаяИнформация.Представление КАК ОткудаПрибыл,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	ЕСТЬNULL(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПаспортнаяСлужба КАК ПаспортнаяСлужба,
	|	ЕСТЬNULL(бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРегистрации
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_КонтактнаяИнформация.Объект
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	Выборка1 = Запрос.Выполнить().Выгрузить();
	
	// Запрос с учетом возможных записей в журнале бит_ЖурналУчетаРегистрацииПребывания.
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЖурналУчетаРегистрацииПребывания.Ссылка.ВидОперации КАК ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ЕСТЬNULL(бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_КонтактнаяИнформация.Представление КАК ОткудаПрибыл,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	ЕСТЬNULL(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПаспортнаяСлужба КАК ПаспортнаяСлужба,
	|	ЕСТЬNULL(бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРегистрации
	|ИЗ
	|	ЖурналДокументов.бит_ЖурналУчетаРегистрацииПребывания КАК бит_ЖурналУчетаРегистрацииПребывания
	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|			ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|			ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|			ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|			ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|			ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
	|			ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_КонтактнаяИнформация.Объект
	|		ПО бит_ЖурналУчетаРегистрацииПребывания.РегистрируемоеЛицо = бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо
	|			И бит_ЖурналУчетаРегистрацииПребывания.ЛицевойСчет = бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка
	|	И бит_КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.бит_ВидыКонтактнойИнформации.АдресПрибытия)
	|	И (бит_ЖурналУчетаРегистрацииПребывания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства)
	|			ИЛИ бит_ЖурналУчетаРегистрацииПребывания.ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуПребывания))";
	
	Результат = Запрос.Выполнить();
	Выборка2 = Результат.Выгрузить();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	
	Если ВидМакета Тогда
		Макет         = ПолучитьМакет("АЛУ_New");
	Иначе
		Макет         = ПолучитьМакет("АЛУ");
	КонецЕсли; 
	
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	ВыборкаИсходник = Неопределено;
	ВыборкаПриемник = Новый ТаблицаЗначений;
	
	Если Выборка2.Количество()>0 Тогда
		ВыборкаИсходник = Выборка2[0];
		Для каждого Строки Из Выборка2.Колонки Цикл
			ВыборкаПриемник.Колонки.Добавить(Строки.Имя);
		КонецЦикла;
		
	ИначеЕсли Выборка1.Количество()>0 Тогда
		
		ВыборкаИсходник = Выборка1[0];
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Записей по регистрируемому лицу в журнале учета по месту жительства нет. Проверьте правильность заполнения оборотной стороны!";
		Сообщение.Сообщить();
		
		Для каждого Строки Из Выборка1.Колонки Цикл
			ВыборкаПриемник.Колонки.Добавить(Строки.Имя);
		КонецЦикла;
	Иначе
		Возврат ТабДокумент;
	КонецЕсли; 
	
	Выборка = ВыборкаПриемник.Добавить();
	
	ЗаполнитьЗначенияСвойств(Выборка, ВыборкаИсходник);
	// Перевод текста параметров к верхнему регистру.
	// Перевод к типу строка всех данных, имеющих другие типы.
	Выборка.ДокументОснование  = ВРег(Строка(ВыборкаИсходник.ДокументОснование));
	Выборка.ПринятоеРешение    = ВРег(Строка(ВыборкаИсходник.ПринятоеРешение));
	Выборка.ОткудаПрибыл       = ВРег(ВыборкаИсходник.ОткудаПрибыл);
	Выборка.УлицаРег           = ВРег(Строка(ВыборкаИсходник.УлицаРег));
	Выборка.ДомРег             = ВРег(Строка(ВыборкаИсходник.ДомРег));
	Выборка.КвартираРег        = ВРег(Строка(ВыборкаИсходник.КвартираРег));
	Выборка.КорпусРег          = ВРег(Строка(ВыборкаИсходник.КорпусРег));
	Выборка.ПочтовыйАдрес      = ВРег(ВыборкаИсходник.ПочтовыйАдрес);
	Выборка.ВидДокумента       = ВРег(Строка(ВыборкаИсходник.ВидДокумента));
	Выборка.СерияДокумента     = ВРег(Строка(ВыборкаИсходник.СерияДокумента));
	Выборка.НомерДокумента     = ВРег(Строка(ВыборкаИсходник.НомерДокумента));
	Выборка.ВыданДокумент      = ВРег(Строка(ВыборкаИсходник.ВыданДокумент));
	Выборка.ДокументКодПодразделения  = ВРег(Строка(ВыборкаИсходник.ДокументКодПодразделения));
	Выборка.ВидДокументаПред   = ВРег(Строка(ВыборкаИсходник.ВидДокументаПред));
	Выборка.СерияДокументаПред = ВРег(Строка(ВыборкаИсходник.СерияДокументаПред));
	Выборка.НомерДокументаПред = ВРег(Строка(ВыборкаИсходник.НомерДокументаПред));
	Выборка.ВыданДокументПред  = ВРег(Строка(ВыборкаИсходник.ВыданДокументПред));
	Выборка.ПаспортнаяСлужба   = ВРег(Строка(ВыборкаИсходник.ПаспортнаяСлужба));
	Выборка.Фамилия            = ВРег(ВыборкаИсходник.Фамилия);
	Выборка.Имя                = ВРег(ВыборкаИсходник.Имя);
	Выборка.Отчество           = ВРег(ВыборкаИсходник.Отчество);
	
	ВыданДокумент_1 = "";
	ВыданДокумент_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ВыданДокумент, 60, ВыданДокумент_1 , ВыданДокумент_2 );
	ШапкаОбласть.Параметры.ВыданДокумент_1 = ВыданДокумент_1;
	ШапкаОбласть.Параметры.ВыданДокумент_2 = ВыданДокумент_2;
	
	Если ЗначениеЗаполнено(Выборка.МестоРождения) Тогда
		СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.РегистрируемоеЛицо.МестоРождения);
		Если ВидМакета Тогда
			ШапкаОбласть.Параметры.СтранаРожд      = СтруктураМестоРождения.Страна; 
		КонецЕсли;
		ШапкаОбласть.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
		ШапкаОбласть.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
		ШапкаОбласть.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
		Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.Пол) Тогда
			Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
				
				ШапкаОбласть.Область("ПолМуж").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
				
			ИначеЕсли Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
				
				ШапкаОбласть.Область("ПолЖен").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
				
			КонецЕсли; 
			
		КонецЕсли; 
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.Заполнить(Выборка); 
	
	Если ВидМакета Тогда
		Если ТипЗнч(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба) = Тип("СправочникСсылка.Контрагенты") Тогда
			ШапкаОбласть.Параметры.КодПаспортнойСлужбы = Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба.КодПоОКПО;
			
		КонецЕсли;
	КонецЕсли;
	// ФлагПрибытия хранит тип операции. 
	ФлагПрибытия = Ложь;
	Если ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства Тогда
		
		ФлагПрибытия = Истина;
		ШапкаОбласть.Параметры.ПаспортнаяСлужба = "";
		ШапкаОбласть.Параметры.КодПаспортнойСлужбы = "";
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Выборка.Фамилия) Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните поле ФИО в справочнике ""Проживающие""";
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
	НаборЗаписей = НЕОПРЕДЕЛЕНО;
	бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ЛицевойСчет.Здание);
	
	ИскомаяСтрока 	= Неопределено;
	
	Для Каждого СтрокаНабора Из НаборЗаписей Цикл
		Если СтрокаНабора.Вид = Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания Тогда
			ИскомаяСтрока = СтрокаНабора;
		КонецЕсли;
	КонецЦикла;
	
	ЗаписьАдрес 	= бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
	
	Если ЗначениеЗаполнено(ЗаписьАдрес) Тогда
		
		СтруктураАдресРегистрации = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
		Если НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
			Если НЕ ФлагПрибытия Тогда
				ШапкаОбласть.Параметры.РегионРег 			= ВРег(СтруктураАдресРегистрации.Регион);
				ШапкаОбласть.Параметры.РайонРег 			= ВРег(СтруктураАдресРегистрации.Район);
				ШапкаОбласть.Параметры.ГородРег 			= ВРег(СтруктураАдресРегистрации.Город);
				ШапкаОбласть.Параметры.НаселенныйПунктРег 	= ВРег(СтруктураАдресРегистрации.НаселенныйПункт);
				ШапкаОбласть.Параметры.УлицаРег 			= ВРег(СтруктураАдресРегистрации.Улица);
				ШапкаОбласть.Параметры.ДомРег 				= ВРег(СтруктураАдресРегистрации.Дом);
				ШапкаОбласть.Параметры.КорпусРег 			= ВРег(СтруктураАдресРегистрации.Корпус);
				ШапкаОбласть.Параметры.КвартираРег 			= ВРег(Выборка.КвартираРег);
			Иначе
				ШапкаОбласть.Параметры.РегионВыб 			= ВРег(СтруктураАдресРегистрации.Регион);
				ШапкаОбласть.Параметры.РайонВыб 			= ВРег(СтруктураАдресРегистрации.Район);
				ШапкаОбласть.Параметры.ГородВыб 			= ВРег(СтруктураАдресРегистрации.Город);
				ШапкаОбласть.Параметры.НаселенныйПунктВыб 	= ВРег(СтруктураАдресРегистрации.НаселенныйПункт);
				ШапкаОбласть.Параметры.УлицаВыб 			= ВРег(СтруктураАдресРегистрации.Улица);
				ШапкаОбласть.Параметры.ДомВыб 				= ВРег(СтруктураАдресРегистрации.Дом);
				ШапкаОбласть.Параметры.КорпусВыб 			= ВРег(СтруктураАдресРегистрации.Корпус);
				ШапкаОбласть.Параметры.КвартираВыб 			= ВРег(Выборка.КвартираРег);
				
			КонецЕсли;
		КонецЕсли;
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Для п.8: заполните почтовый адрес у дома в справочнике ""Список зданий""";
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
	Если ВидМакета Тогда
		Если НЕ ФлагПрибытия Тогда
			ЗаписьАдресПриб = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(Выборка.ОткудаПрибыл);
			
			Если ЗначениеЗаполнено(ЗаписьАдресПриб) Тогда
				
				СтруктураАдресРегистрацииПриб 		= бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдресПриб);
				
				ШапкаОбласть.Параметры.СтранаПриб 	= ВРег(СтруктураАдресРегистрацииПриб.Страна);
			КонецЕсли;	
		КонецЕсли;	
		
		ИскомаяСтрока 	= ПолучитьКИ(Выборка.РегистрируемоеЛицо,Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Проживающие); 
		Строка 			= ИскомаяСтрока.Найти(Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытия, "Вид");
		Если Строка <> Неопределено Тогда
			Если ФлагПрибытия Тогда
				
				ШапкаОбласть.Параметры.РегионРег          = ВРег(Строка.Поле2);
				ШапкаОбласть.Параметры.РайонРег           = ВРег(Строка.Поле3) ;
				ШапкаОбласть.Параметры.ГородРег           = ВРег(Строка.Поле4) ;
				ШапкаОбласть.Параметры.НаселенныйПунктРег = ВРег(Строка.Поле5) ;
				ШапкаОбласть.Параметры.УлицаРег           = ВРег(Строка.Поле6) ;
				ШапкаОбласть.Параметры.ДомРег             = ВРег(Строка.Поле7) ;
				ШапкаОбласть.Параметры.КорпусРег          = ВРег(Строка.Поле8) ;
				ШапкаОбласть.Параметры.КвартираРег        = ВРег(Строка.Поле9) ;
				
			Иначе
				
				ШапкаОбласть.Параметры.РегионПриб          = ВРег(Строка.Поле2);
				ШапкаОбласть.Параметры.РайонПриб           = ВРег(Строка.Поле3) ;
				ШапкаОбласть.Параметры.ГородПриб           = ВРег(Строка.Поле4) ;
				ШапкаОбласть.Параметры.НаселенныйПунктПриб = ВРег(Строка.Поле5) ;
				ШапкаОбласть.Параметры.УлицаПриб           = ВРег(Строка.Поле6) ;
				ШапкаОбласть.Параметры.ДомПриб             = ВРег(Строка.Поле7) ;
				ШапкаОбласть.Параметры.КорпусПриб          = ВРег(Строка.Поле8) ;
				ШапкаОбласть.Параметры.КвартираПриб        = ВРег(Строка.Поле9) ;
				
			КонецЕсли;
		КонецЕсли;
	КонецЕсли; 
	
	ИскомаяСтрока 	= ПолучитьКИ(Выборка.РегистрируемоеЛицо,Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Проживающие); 
	Строка 			= ИскомаяСтрока.Найти(Справочники.бит_ВидыКонтактнойИнформации.АдресУбытия, "Вид");
	Если Строка <> Неопределено И НЕ ФлагПрибытия Тогда
		
		ШапкаОбласть.Параметры.РегионВыб          = ВРег(Строка.Поле2);
		ШапкаОбласть.Параметры.РайонВыб           = ВРег(Строка.Поле3) ;
		ШапкаОбласть.Параметры.ГородВыб           = ВРег(Строка.Поле4) ;
		ШапкаОбласть.Параметры.НаселенныйПунктВыб = ВРег(Строка.Поле5) ;
		ШапкаОбласть.Параметры.УлицаВыб           = ВРег(Строка.Поле6) ;
		ШапкаОбласть.Параметры.ДомВыб             = ВРег(Строка.Поле7) ;
		ШапкаОбласть.Параметры.КорпусВыб          = ВРег(Строка.Поле8) ;
		ШапкаОбласть.Параметры.КвартираВыб        = ВРег(Строка.Поле9) ;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ДатаРождения) Тогда
		Если ВидМакета Тогда
			ШапкаОбласть.Параметры.ДеньРождения     = День(Выборка.ДатаРождения);
			ДатаМесяц 								= Формат(Выборка.ДатаРождения,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРождения 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодРождения      = Формат(Выборка.ДатаРождения,"ДФ='yyyy'");
			
		Иначе
			
			ШапкаОбласть.Параметры.ДатаРождения     = Формат(Выборка.ДатаРождения,"ДЛФ=DD");
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ДатаРегистрации) И НЕ ФлагПрибытия Тогда
		Если ВидМакета  Тогда
			ШапкаОбласть.Параметры.ДеньРегистрации      = День(Выборка.ДатаРегистрации);
			ДатаМесяц 									= Формат(Выборка.ДатаРегистрации,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРегистрации 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодРегистрации       = Формат(Выборка.ДатаРегистрации,"ДФ='yyyy '");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента) И НЕ ФлагПрибытия Тогда
		Если ВидМакета Тогда
			
			ШапкаОбласть.Параметры.ДеньВыдачиДокумента  = День(Выборка.ДатаВыдачиДокумента);
			ДатаМесяц 									= Формат(Выборка.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцВыдачиДокумента = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодВыдачиДокумента   = Формат(Выборка.ДатаВыдачиДокумента,"ДФ='yyyy'");
		Иначе
			ШапкаОбласть.Параметры.ДатаВыдачиДокумента  = Формат(Выборка.ДатаВыдачиДокумента,"ДФ=dd.MM.yy");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если  НЕ ФлагПрибытия Тогда
		Если ВидМакета  Тогда
			
			ШапкаОбласть.Параметры.ДеньСоставил     = День(Дата);
			ДатаМесяц 								= Формат(Дата,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцСоставил 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодСоставил      = Формат(Дата,"ДФ='yyyy '");
		Иначе
			ШапкаОбласть.Параметры.ДатаСоставления  = Формат(Дата,"ДЛФ=DD");
			
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда 
			Если ВидМакета Тогда
				
				ШапкаОбласть.Параметры.ДеньСнятияСРегистрации 	= День(Выборка.ДатаСнятияСРегистрации);
				ДатаМесяц 										= Формат(Выборка.ДатаСнятияСРегистрации,"ДФ='дд.MMMM'");
				ШапкаОбласть.Параметры.МесяцСнятияСРегистрации 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
				ШапкаОбласть.Параметры.ГодСнятияСРегистрации 	= Формат(Дата,"ДФ='yyyy '");
			КонецЕсли; 
			
		КонецЕсли; 
	КонецЕсли; 
	
	ИскомаяСтрока = ПолучитьКИ(Выборка.РегистрируемоеЛицо,Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Проживающие); 
	Строка = ИскомаяСтрока.Найти(Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытия, "Вид");
	Если Строка <> Неопределено Тогда
		
		Если Выборка2.Количество()>0 И НЕ ФлагПрибытия Тогда
			Если ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СДругогоГорода Тогда
				
				Если ВидМакета Тогда
					ШапкаОбласть.Параметры.РегионПриб 			= ВРег(Строка.Поле2);
					ШапкаОбласть.Параметры.РайонПриб 			= ВРег(Строка.Поле3);
					ШапкаОбласть.Параметры.ГородПриб 			= ВРег(Строка.Поле4);
					ШапкаОбласть.Параметры.НаселенныйПунктПриб  = ВРег(Строка.Поле5);
					ШапкаОбласть.Параметры.УлицаПриб 			= ВРег(Строка.Поле6);
					ШапкаОбласть.Параметры.ДомПриб 				= ВРег(Строка.Поле7);
					ШапкаОбласть.Параметры.КорпусПриб 			= ВРег(Строка.Поле8);
					ШапкаОбласть.Параметры.КвартираПриб 		= ВРег(Строка.Поле9);
				КонецЕсли;
				
			ИначеЕсли ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.ВТомЖеГородеСДругогоАдреса Тогда	
				
				ШапкаОбласть.Параметры.УлицаВыбТГ 			= ВРег(Строка.Поле6);
				ШапкаОбласть.Параметры.ДомВыбТГ 			= ВРег(Строка.Поле7);
				ШапкаОбласть.Параметры.КорпусВыбТГ 			= ВРег(Строка.Поле8);
				ШапкаОбласть.Параметры.КвартираВыбТГ 		= ВРег(Строка.Поле9);
				
			ИначеЕсли ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаФамилии Тогда
				Если ВидМакета Тогда
					ШапкаОбласть.Параметры.ФамилияСмена  				= Выборка.Фамилия;
					ШапкаОбласть.Параметры.ИмяСмена      				= Выборка.Имя;
					ШапкаОбласть.Параметры.ОтчествоСмена 				= Выборка.Отчество;
					ШапкаОбласть.Параметры.ДеньРожденияСмена  			= День(Выборка.ДатаРождения);
					ДатаМесяц 											= Формат(Выборка.ДатаРождения,"ДФ='дд.MMMM'");
					ШапкаОбласть.Параметры.МесяцРожденияСмена 			= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
					ШапкаОбласть.Параметры.ГодРожденияСмена            	= Формат(Выборка.ДатаРождения,"ДФ='yyyy'");
				КонецЕсли;
				Если ВидМакета И ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.Пол) Тогда
					Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
						
						ШапкаОбласть.Область("ПолМуж1").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
						
					ИначеЕсли Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
						
						ШапкаОбласть.Область("ПолЖен1").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
						
					КонецЕсли;
				КонецЕсли;		
				
			Иначе
				Если ВидМакета Тогда
					ШапкаОбласть.Параметры.ПрочиеПричины = Комментарий;
				КонецЕсли;		
				
			КонецЕсли;
			
			Иначе Если Выборка1.Количество()>0 И ЗначениеЗаполнено(СтруктураАдресРегистрации)И НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
				Если Строка.Поле2  = СтруктураАдресРегистрации.Регион
					И Строка.Поле3 = СтруктураАдресРегистрации.Район
					И Строка.Поле4 = СтруктураАдресРегистрации.Город
					И Строка.Поле5 = СтруктураАдресРегистрации.НаселенныйПункт
					Тогда	
					ШапкаОбласть.Параметры.УлицаВыбТГ 			= ВРег(Строка.Поле6);
					ШапкаОбласть.Параметры.ДомВыбТГ 			= ВРег(Строка.Поле7);
					ШапкаОбласть.Параметры.КорпусВыбТГ 			= ВРег(Строка.Поле8);
					ШапкаОбласть.Параметры.КвартираВыбТГ 		= ВРег(Строка.Поле9);
					
				Иначе
					Если ВидМакета И НЕ ФлагПрибытия Тогда
						ШапкаОбласть.Параметры.РегионПриб 			= ВРег(Строка.Поле2);
						ШапкаОбласть.Параметры.РайонПриб 			= ВРег(Строка.Поле3);
						ШапкаОбласть.Параметры.ГородПриб 			= ВРег(Строка.Поле4);
						ШапкаОбласть.Параметры.НаселенныйПунктПриб  = ВРег(Строка.Поле5);
						ШапкаОбласть.Параметры.УлицаПриб 			= ВРег(Строка.Поле6);
						ШапкаОбласть.Параметры.ДомПриб 				= ВРег(Строка.Поле7);
						ШапкаОбласть.Параметры.КорпусПриб 			= ВРег(Строка.Поле8);
						ШапкаОбласть.Параметры.КвартираПриб 		= ВРег(Строка.Поле9);
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли; 
		
		Если Выборка2.Количество()>0  И ФлагПрибытия  Тогда
			Если ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.ВТомЖеГородеСДругогоАдреса Тогда
				
				ШапкаОбласть.Параметры.УлицаВыбТГ 			= ВРег(Выборка.УлицаРег);
				ШапкаОбласть.Параметры.ДомВыбТГ 			= ВРег(Выборка.ДомРег);
				ШапкаОбласть.Параметры.КорпусВыбТГ 			= ВРег(Выборка.КорпусРег);
				ШапкаОбласть.Параметры.КвартираВыбТГ 		= ВРег(Выборка.КвартираРег);
				
			ИначеЕсли ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СДругогоГорода Тогда
				
				Если ЗначениеЗаполнено(ЗаписьАдрес) Тогда
					ШапкаОбласть.Параметры.РегионВыб 			= ВРег(СтруктураАдресРегистрации.Регион);
					ШапкаОбласть.Параметры.РайонВыб 			= ВРег(СтруктураАдресРегистрации.Район);
					ШапкаОбласть.Параметры.ГородВыб 			= ВРег(СтруктураАдресРегистрации.Город);
					ШапкаОбласть.Параметры.НаселенныйПунктВыб  = ВРег(СтруктураАдресРегистрации.НаселенныйПункт);
				КонецЕсли;
				
				ШапкаОбласть.Параметры.УлицаВыб 			= ВРег(Выборка.УлицаРег);
				ШапкаОбласть.Параметры.ДомВыб 				= ВРег(Выборка.ДомРег);
				ШапкаОбласть.Параметры.КорпусВыб 			= ВРег(Выборка.КорпусРег);
				ШапкаОбласть.Параметры.КвартираВыб	 		= ВРег(Выборка.КвартираРег);
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЕсли;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой анкета.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьАнкета() Экспорт  
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = ПолучитьМакет("Анкета_New");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.МестоРождения);
	ШапкаОбласть.Параметры.СтранаРожд          = СтруктураМестоРождения.Страна; 
	
	ШапкаОбласть.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
	ШапкаОбласть.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
	ШапкаОбласть.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
	ШапкаОбласть.Параметры.НаселенныйПунктРожд = СтруктураМестоРождения.НаселенныйПункт;
	
	ШапкаОбласть.Параметры.ДеньРожд  = Формат(Выборка.ДатаРождения,"ДФ=dd");
	ДатаМесяц						 = Формат(Выборка.ДатаРождения,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.МесяцРожд = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ШапкаОбласть.Параметры.ГодРожд   = Формат(Выборка.ДатаРождения,"ДФ=yyyy");
	
	ШапкаОбласть.Параметры.ЧислоВыдачи 	= Формат(Выборка.ДатаВыдачиДокумента ,"ДФ=dd");
	ДатаМесяц						 	= Формат(Выборка.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.МесяцВыдачи 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ШапкаОбласть.Параметры.ГодВыдачи   	= Формат(Выборка.ДатаВыдачиДокумента ,"ДФ=yyyy");
	
	ДатаМесяц 							= Формат(ДатаРегистрации,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.ДатаРегистрацииМесяц = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ДатаМесяц 							= Формат(ДатаСнятияСРегистрации,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.ДатаСнятияСРегистрацииМесяц = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ДатаМесяц 							= Формат(Дата,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.ДатаМесяц = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) Тогда
		Если Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
			
			ШапкаОбласть.Область("ПолМуж").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
			
		ИначеЕсли Выборка.РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
			
			ШапкаОбласть.Область("ПолЖен").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная, 1);
			
		КонецЕсли;
	КонецЕсли; 
	
	АдресЖительства = ПодробныйАдрес();
	Если АдресЖительства.Следующий() Тогда
		Если ЗначениеЗаполнено(АдресЖительства.Страна) Тогда
			ШапкаОбласть.Параметры.Республика 	= АдресЖительства.Страна;
		Иначе
			ШапкаОбласть.Параметры.Республика 	= "";	
		КонецЕсли; 
		ШапкаОбласть.Параметры.Регион 		= АдресЖительства.Регион;
		ШапкаОбласть.Параметры.Район 		= АдресЖительства.Район;
		ШапкаОбласть.Параметры.НасПункт 	= АдресЖительства.НасПункт;
		ШапкаОбласть.Параметры.Улица 		= АдресЖительства.Улица;
		ШапкаОбласть.Параметры.Дом 			= АдресЖительства.Дом;
		ШапкаОбласть.Параметры.Корпус 		= АдресЖительства.Корпус;
		ШапкаОбласть.Параметры.Квартира 	= АдресЖительства.Квартира;
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.Дата = Дата;
	КИОрганизации = ПолучитьКИ(Организация, 
	Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Организации);
	
	Адрес   = КИОрганизации.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, "Вид");
	ШапкаОбласть.Параметры.АдресОрганизации = Адрес.Представление;
	
	ВыданДокумент_1 = "";
	ВыданДокумент_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ВыданДокумент, 40, ВыданДокумент_1 , ВыданДокумент_2 );
	ШапкаОбласть.Параметры.ВыданДокумент_1 = ВыданДокумент_1;
	ШапкаОбласть.Параметры.ВыданДокумент_2 = ВыданДокумент_2;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция вызывает форму печати табличного документа с печатной формой.
// Инвентаризационной описи основных средств.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Неопределено.
//
Функция ПечатьСОРГ_РФ_ПМЖ(ВерсияМакета = Истина) Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение.ПринятоеРешение КАК ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ЕСТЬNULL(бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.Пол КАК Пол,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна КАК Гражданство
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "СведенияОРегистрацииГражданинаРоссийскойФедерацииПоМестуЖительства";
	
	Если ВерсияМакета Тогда
		
		Макет         = ПолучитьМакет("СОРГ_РФ_ПМЖ");
		ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
		
	Иначе
		
		Макет         = ПолучитьМакет("СОРГ_РФ_ПМЖ_Old");
		ШапкаОбласть  	= Макет.ПолучитьОбласть("Шапка");
		СтрокаОбласть = Макет.ПолучитьОбласть("СтрокаТЧ");
		ПодвалОбласть	= Макет.ПолучитьОбласть("Подвал");
		
	КонецЕсли; 
	
	КИОрганизации = ПолучитьКИ(Организация, 
	Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Организации);
	
	Адрес   = КИОрганизации.Найти(Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации, "Вид");
	Телефон = КИОрганизации.Найти(Справочники.ВидыКонтактнойИнформации.ТелефонОрганизации, "Вид"); 
	АдресПочтовый = КИОрганизации.Найти(Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресОрганизации, "Вид");

	НазваниеОрганизации_1	= "";
	НазваниеОрганизации_2	= "";
	НазваниеОрганизации		= "";
	Если ЗначениеЗаполнено(Выборка.ЛицевойСчет)Тогда 
		
		Если ТипЗнч(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			НазваниеОрганизации = Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба.НаименованиеПолное;
			
			// ИНН.
			ИНН = Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба.ИНН;
			ДлинаИНН = СтрДлина(Инн);
			
			Индекс = 0;
			Пока Индекс <> ДлинаИнн И Индекс < 10  Цикл
				
				Индекс = Индекс + 1;
				ИННИндекс = "ИНН" + Индекс;
				ШапкаОбласть.Параметры[ИННИндекс] = Сред(ИНН,Индекс,1);
				
			КонецЦикла;
			
			// КПП.
			КПП = Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба.КПП;
			ДлинаИНН = СтрДлина(КПП);
			
			Индекс = 0;
			Пока Индекс <> ДлинаИнн Цикл
				
				Индекс = Индекс + 1;
				КППИндекс = "КПП" + Индекс;
				ШапкаОбласть.Параметры[КППИндекс] = Сред(КПП,Индекс,1);
				
			КонецЦикла;
		Иначе
			НазваниеОрганизации = Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба;
		КонецЕсли;
		
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(НазваниеОрганизации, 35, НазваниеОрганизации_1 , НазваниеОрганизации_2 );
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.НазваниеОрганизации_1 = НазваниеОрганизации_1;
	ШапкаОбласть.Параметры.НазваниеОрганизации_2 = НазваниеОрганизации_2;
	
	НалоговыйОрган_1 = "";
	НалоговыйОрган_2 = "";
	НалоговыйОрган_3 = "";
	
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки("", 35, НалоговыйОрган_1 , НалоговыйОрган_2 );
	
	ШапкаОбласть.Параметры.НалоговыйОрган_1 = НалоговыйОрган_1;
	ШапкаОбласть.Параметры.НалоговыйОрган_2 = НалоговыйОрган_2;

	ИМНС = "";
	
	ДлинаИНН = СтрДлина(ИМНС);
	
	Индекс = 0;
	Пока Индекс <> ДлинаИнн Цикл
		
		Индекс = Индекс + 1;
		ИМНСИндекс = "ГНИ" + Индекс;
		ШапкаОбласть.Параметры[ИМНСИндекс] = Сред(ИМНС,Индекс,1);
		
	КонецЦикла;
	
	// Сведения о физ лице.
	ШапкаОбласть.Параметры.Фамилия  = Выборка.Фамилия;
	ШапкаОбласть.Параметры.Имя      = Выборка.Имя;
	ШапкаОбласть.Параметры.Отчество = Выборка.Отчество;
	Если ЗначениеЗаполнено(Выборка.Пол) Тогда
		
		Если Выборка.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
			
			ШапкаОбласть.Параметры.ПолМ  = "V";
			
		ИначеЕсли Выборка.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
			
			ШапкаОбласть.Параметры.ПолЖ  = "V";
			
		КонецЕсли; 
		
	КонецЕсли; 

	ШапкаОбласть.Параметры.ДатаРождения  = Формат(Выборка.ДатаРождения, "ДЛФ=DD");
	
	МестоРожденияСтруктура = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.МестоРождения);
	МестоРождения = "";
	Если ЗначениеЗаполнено(МестоРожденияСтруктура.НаселенныйПункт) Тогда
		МестоРождения = МестоРождения + МестоРожденияСтруктура.НаселенныйПункт;
	КонецЕсли;  
	Если ЗначениеЗаполнено(МестоРожденияСтруктура.Район) Тогда	
		МестоРождения = МестоРождения +", "+ МестоРожденияСтруктура.Район + " р-на";
	КонецЕсли;  
	Если ЗначениеЗаполнено(МестоРожденияСтруктура.Область) Тогда	
		МестоРождения = МестоРождения +", "+ МестоРожденияСтруктура.Область + " обл.";
	КонецЕсли;  
	Если ЗначениеЗаполнено(МестоРожденияСтруктура.Страна) Тогда	
		МестоРождения = МестоРождения +", "+ МестоРожденияСтруктура.Страна;
	КонецЕсли; 
	ШапкаОбласть.Параметры.МестоРождения = МестоРождения;
	
	ШапкаОбласть.Параметры.ВидДокумента  = Выборка.ВидДокумента;
	ШапкаОбласть.Параметры.Серия         = Выборка.СерияДокумента;
	ШапкаОбласть.Параметры.Номер         = Выборка.НомерДокумента;

	КемВыдан_1 = "";
	КемВыдан_2 = "";
	Если ЗначениеЗаполнено(Выборка.ВыданДокумент) Тогда
		КемВыдан = Строка(Выборка.ВыданДокумент) + ", код " + Строка(Выборка.ДокументКодПодразделения);
	ИначеЕсли ЗначениеЗаполнено(Выборка.ДокументКодПодразделения) Тогда
		КемВыдан = Строка(Выборка.ДокументКодПодразделения);
	КонецЕсли; 
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(КемВыдан, 25, КемВыдан_1, КемВыдан_2 );
	ШапкаОбласть.Параметры.КемВыдан_1 = КемВыдан_1;
	ШапкаОбласть.Параметры.КемВыдан_2 = КемВыдан_2;
	
	Если ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента) Тогда
		ШапкаОбласть.Параметры.ДатаВыдачиДокумента = Формат(Выборка.ДатаВыдачиДокумента, "ДФ='dd.MM.yyyy ""г.""'");
	КонецЕсли; 
	
	// Сведения о постановке на учет.
	КИФизЛица = ПолучитьКИ(Выборка.РегистрируемоеЛицо, Перечисления.бит_ВидыОбъектовКонтактнойИнформации.Проживающие);
	
	НаборЗаписей = НЕОПРЕДЕЛЕНО;
	бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ДомРег);
	ВыборкаПочтАдр = Неопределено;
	Для каждого СтрокаНабор Из НаборЗаписей  Цикл
		Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
			И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
			Тогда 
			ВыборкаПочтАдр = СтрокаНабор;
		КонецЕсли;	
	КонецЦикла;
	
	ПочтовыйАдресСтрока =  бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ВыборкаПочтАдр);
	СтруктураПочтовыйАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ПочтовыйАдресСтрока);
	Если СтруктураПочтовыйАдрес <> Неопределено И НЕ СтруктураПочтовыйАдрес.Свойство("ЗаПределамиРФ") Тогда
		Если ЗначениеЗаполнено(СтруктураПочтовыйАдрес.Страна) Тогда
			ШапкаОбласть.Параметры.Республика = СтруктураПочтовыйАдрес.Страна;
		ИначеЕсли ЗначениеЗаполнено(СтруктураПочтовыйАдрес.Регион) Тогда
			ШапкаОбласть.Параметры.Республика = СтруктураПочтовыйАдрес.Регион;
		КонецЕсли; 
		ШапкаОбласть.Параметры.Район      = СтруктураПочтовыйАдрес.Район;
		ШапкаОбласть.Параметры.Город      = СтруктураПочтовыйАдрес.Город;
		ШапкаОбласть.Параметры.Село       = СтруктураПочтовыйАдрес.НаселенныйПункт;
		ШапкаОбласть.Параметры.Улица      = СтруктураПочтовыйАдрес.Улица;
		ШапкаОбласть.Параметры.Дом        = СтруктураПочтовыйАдрес.Дом;
		ШапкаОбласть.Параметры.Корпус     = СтруктураПочтовыйАдрес.Корпус;
		
	Иначе
		ШапкаОбласть.Параметры.Улица      = Выборка.УлицаРег;
		ШапкаОбласть.Параметры.Дом        = Выборка.ДомРег;
		ШапкаОбласть.Параметры.Корпус     = Выборка.КорпусРег;
		
	КонецЕсли; 
	ШапкаОбласть.Параметры.Квартира   = Выборка.КвартираРег;
	
	// Предыдущее место пребывания.
	АдресИнформирования = КИФизЛица.Найти(Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытия, "Вид");
	Если АдресИнформирования <> Неопределено Тогда
		
		АдресИнформированияСтрока = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(АдресИнформирования);
		АдресИнформированияСтруктура = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(АдресИнформированияСтрока);
		Если АдресИнформированияСтруктура <> Неопределено И НЕ АдресИнформированияСтруктура.Свойство("ЗаПределамиРФ") Тогда
			
			ШапкаОбласть.Параметры.ПредРеспублика = АдресИнформированияСтруктура.Страна;
			ШапкаОбласть.Параметры.ПредРайон      = АдресИнформированияСтруктура.Район;
			ШапкаОбласть.Параметры.ПредГород      = АдресИнформированияСтруктура.Город;
			ШапкаОбласть.Параметры.ПредСело       = АдресИнформированияСтруктура.НаселенныйПункт;
			ШапкаОбласть.Параметры.ПредУлица      = АдресИнформированияСтруктура.Улица;
			ШапкаОбласть.Параметры.ПредДом        = АдресИнформированияСтруктура.Дом;
			ШапкаОбласть.Параметры.ПредКорпус     = АдресИнформированияСтруктура.Корпус;
			ШапкаОбласть.Параметры.ПредКвартира   = АдресИнформированияСтруктура.Квартира;
			
		КонецЕсли; 
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.стДатаПостановки       = Формат(ДатаРегистрации, "ДФ='dd.MM.yyyy ""г""'");
	ШапкаОбласть.Параметры.ДатаСнятияСрегистрации = Формат(ДатаСнятияСРегистрации, "ДФ='dd.MM.yyyy ""г.""'");
	
	Если ВерсияМакета Тогда
		ШапкаОбласть.Параметры.ДатаДокумента          = Формат(Дата, "ДФ='dd.MM.yyyy ""г.""'");
		ДолжностноеЛицоФИО = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Организация, ДолжностноеЛицо, Дата, Ложь);
		Если ТипЗнч(ДолжностноеЛицоФИО) = Тип("Структура") Тогда
			ШапкаОбласть.Параметры.ДолжностноеЛицо 	= ДолжностноеЛицоФИО.ДолжностноеЛицо;
			ШапкаОбласть.Параметры.Должность 		= ДолжностноеЛицоФИО.Должность;
		КонецЕсли;
		
	КонецЕсли;
	ТабДокумент.Вывести(ШапкаОбласть);
	
	// Выбран макет с данными детей до 14 лет. 
	Если НЕ ВерсияМакета Тогда                                 
		
		СписокДетей = ФизическиеЛица.Выгрузить();
		МассивДляУдаления = Новый Массив;
		Для каждого ДанныеРебенка Из СписокДетей Цикл
			
			ДатаРождения = ДанныеРебенка.ФизическоеЛицо.ДатаРождения;
			
			ЧислоЛет = бит_ПаспортныйСтолКлиетСервер.КолвоПолныхЛет(ДатаРождения,ДатаРегистрации);
			
			Если ЧислоЛет > 14 Тогда
				
				МассивДляУдаления.Добавить(ДанныеРебенка);
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого СтрокаМассива Из МассивДляУдаления  Цикл
			
			СписокДетей.Удалить(СтрокаМассива);
			
		КонецЦикла; 
		
		Если СписокДетей.Количество()>0 Тогда
			
			Для каждого СтрокаТЧ Из СписокДетей Цикл
				
				ФИОФизЛица      = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(СтрокаТЧ.ФизическоеЛицо,Дата, Ложь);
				
				Если ЗначениеЗаполнено(ФИОФизЛица) Тогда
					СтрокаОбласть.Параметры.ФизЛицо = ФИОФизЛица;
				Иначе
					СтрокаОбласть.Параметры.ФизЛицо = СтрокаТЧ.ФизическоеЛицо.Наименование;
				КонецЕсли;
				
				Если СтрокаТЧ.ФизическоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
					
					СтрокаОбласть.Параметры.Пол = "жен";
					
				ИначеЕсли СтрокаТЧ.ФизическоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
					
					СтрокаОбласть.Параметры.Пол = "муж";
					
				КонецЕсли;
				
				СтрокаОбласть.Параметры.ДатаРождения = Формат(СтрокаТЧ.ФизическоеЛицо.ДатаРождения,"ДФ=dd.MM.yyyy");
				
				Если ЗначениеЗаполнено(СтрокаТЧ.ФизическоеЛицо.МестоРождения) Тогда
					
					МестоРождения = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(СтрокаТЧ.ФизическоеЛицо.МестоРождения);
					СтрокаОбласть.Параметры.МестоРождения = МестоРождения;
					
				КонецЕсли; 
				
				ДокументФизЛица = бит_ПаспортныйСтолСервер.ПолучитьДанныеДокументаФизЛица(СтрокаТЧ.ФизическоеЛицо,Дата);
				
				СтрокаОбласть.Параметры.СерияДок 	= ДокументФизЛица.ДокументСерия;
				СтрокаОбласть.Параметры.НомерДок 	= ДокументФизЛица.ДокументНомер;
				СтрокаОбласть.Параметры.ДатаДок  	= Формат(ДокументФизЛица.ДокументДатаВыдачи,"ДФ=dd.MM.yyyy" );
				СтрокаОбласть.Параметры.КемВыданДок = ДокументФизЛица.ДокументКемВыдан + ?(ЗначениеЗаполнено(ДокументФизЛица.ДокументКодПодразделения),"код " + ДокументФизЛица.ДокументКодПодразделения,"");
				
				ТабДокумент.Вывести(СтрокаОбласть);
			КонецЦикла; 
			
		КонецЕсли;
		
		ПодвалОбласть.Параметры.ДатаДокумента = Дата;
		ТабДокумент.Вывести(ПодвалОбласть);
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой сличительной ведомости.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьСОРПМП() Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	ПОДСТРОКА(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения, 3, 200) КАК МестоРождения,
	|	ЕСТЬNULL(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = ПолучитьМакет("СОРПМП");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	Если Выборка.ПочтовыйАдрес <> Неопределено И Выборка.ПочтовыйАдрес <> NULL Тогда
		АдресПрибытия = Строка(Выборка.ПочтовыйАдрес)+", кв."+Строка(Выборка.КвартираРег);;
		АдресПрибытия_1 = "";
		АдресПрибытия_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресПрибытия, 60, АдресПрибытия_1, АдресПрибытия_2);
		ШапкаОбласть.Параметры.АдресПрибытия_1 = АдресПрибытия_1;
		ШапкаОбласть.Параметры.АдресПрибытия_2 = АдресПрибытия_2;
	КонецЕсли; 

	ШапкаОбласть.Параметры.Заполнить(Выборка);
	
	Если Выборка.РегистрируемоеЛицо <> Неопределено Тогда
		
		МестоРождения_1 = "";
		МестоРождения_2 = "";
		
		МестоРожденияСтруктура = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.РегистрируемоеЛицо.МестоРождения);
		Если ЗначениеЗаполнено(МестоРожденияСтруктура) Тогда
			МестоРожденияСтрока = ?(ЗначениеЗаполнено(МестоРожденияСтруктура.НаселенныйПункт),МестоРожденияСтруктура.НаселенныйПункт +", ","")+ 
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Район),МестоРожденияСтруктура.Район + " р-н, ","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Область),МестоРожденияСтруктура.Область + " обл.,","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Страна)," страна "+МестоРожденияСтруктура.Страна,"");

			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(МестоРожденияСтрока, 60, МестоРождения_1, МестоРождения_2);
			ШапкаОбласть.Параметры.МестоРождения_1 = МестоРождения_1;
			ШапкаОбласть.Параметры.МестоРождения_2 = МестоРождения_2;

		КонецЕсли; 
	КонецЕсли; 
	
	ФизЛицо = "";
	Если ЗначениеЗаполнено(Выборка.Фамилия) Тогда
		ФизЛицо = Строка(Выборка.Фамилия)+" "+ Строка(Выборка.Имя)+" "+Строка(Выборка.Отчество);
	Иначе
		ФизЛицо = Строка(Выборка.РегистрируемоеЛицо);
	КонецЕсли; 
	
	// Перевод в родительный падеж.
	ФизЛицо_Склон = "";
	ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФизЛицо,3,Выборка.РегистрируемоеЛицо.Пол,ФизЛицо_Склон);
	Если ИсходСклонения Тогда
		ФизЛицо = ФизЛицо_Склон;
	КонецЕсли;	
	
	ФизЛицо = ФизЛицо + ", "+Строка(Формат(Выборка.ДатаРождения,"ДФ='yyyy ""г.р.""'"));
	ШапкаОбласть.Параметры.ФизЛицо = ФизЛицо;
	
	Если ЗначениеЗаполнено(Выборка.ДомРег) Тогда
		
		ШапкаОбласть.Параметры.ОрганУчета = Выборка.ДомРег.ПаспортнаяСлужба;				
		
	КонецЕсли; 
	Если ЗначениеЗаполнено(Выборка.ДатаРегистрации) Тогда
		
		ШапкаОбласть.Параметры.ЧислоРег    	= День(Выборка.ДатаРегистрации);
		ДатаМесяц 							= Формат(Выборка.ДатаРегистрации,"ДФ='дд.MMMM'");
		ШапкаОбласть.Параметры.МесяцРег 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
		ШапкаОбласть.Параметры.ГодРег     	= Формат(Выборка.ДатаРегистрации,"ДФ=yy");
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
		
		ШапкаОбласть.Параметры.ЧислоСнят    = День(Выборка.ДатаСнятияСРегистрации);
		ДатаМесяц 							= Формат(Выборка.ДатаСнятияСРегистрации,"ДФ='дд.MMMM'");
		ШапкаОбласть.Параметры.МесяцСнят 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
		ШапкаОбласть.Параметры.ГодСнят     	= Формат(Выборка.ДатаСнятияСРегистрации,"ДФ='yy'");
	КонецЕсли;
	ШапкаОбласть.Параметры.ЧислоТек    	= Дата;
	ДатаМесяц 							= Формат(Дата,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.МесяцТек 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ШапкаОбласть.Параметры.ГодТек     	= Дата;
	ДолжностноеЛицоФИО = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Организация, ДолжностноеЛицо, Дата, Ложь);
	Если ТипЗнч(ДолжностноеЛицоФИО) = Тип("Структура") Тогда
		ШапкаОбласть.Параметры.ДолжностноеЛицо = ДолжностноеЛицоФИО.ДолжностноеЛицо;
	КонецЕсли;
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой сличительной ведомости
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьСОРПМПЖ() Экспорт
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ВидДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДатаВыдачиДокумента,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	бит_ПаспортныеДанныеПроживающихСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаСнятияСРегистрации,
	|	ПОДСТРОКА(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения, 3, 200) КАК МестоРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ЕСТЬNULL(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних1.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	Макет         = ПолучитьМакет("СОРПМПЖ");
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	Если ЗначениеЗаполнено(Выборка.ПочтовыйАдрес) Тогда
		АдресПрибытия = Строка(Выборка.ПочтовыйАдрес)+", кв."+Строка(Выборка.КвартираРег);
		АдресПрибытия_1 = "";
		АдресПрибытия_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресПрибытия, 74, АдресПрибытия_1, АдресПрибытия_2);
		ШапкаОбласть.Параметры.АдресПрибытия_1 = АдресПрибытия_1;
		ШапкаОбласть.Параметры.АдресПрибытия_2 = АдресПрибытия_2;
	КонецЕсли; 
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	
	Если Выборка.РегистрируемоеЛицо <> Неопределено Тогда
		МестоРождения_1 = "";
		МестоРождения_2 = "";
		МестоРожденияСтруктура = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.РегистрируемоеЛицо.МестоРождения);
		Если ЗначениеЗаполнено(МестоРожденияСтруктура) Тогда
			МестоРожденияСтрока = ?(ЗначениеЗаполнено(МестоРожденияСтруктура.НаселенныйПункт),МестоРожденияСтруктура.НаселенныйПункт +", ","")+ 
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Район),МестоРожденияСтруктура.Район + " р-н, ","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Область),МестоРожденияСтруктура.Область + " обл.,","")+
			?(ЗначениеЗаполнено(МестоРожденияСтруктура.Страна)," страна "+МестоРожденияСтруктура.Страна,"");
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(МестоРожденияСтрока, 60, МестоРождения_1, МестоРождения_2);
			ШапкаОбласть.Параметры.МестоРождения_1 = МестоРождения_1;
			ШапкаОбласть.Параметры.МестоРождения_2 = МестоРождения_2;
		КонецЕсли; 
	КонецЕсли; 
	
	ШапкаОбласть.Параметры.ЧислоТек = Формат(Дата,"ДФ=dd");
	ДатаМесяц 						= Формат(Дата,"ДФ='дд.MMMM'");
	ШапкаОбласть.Параметры.МесяцТек	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
	ШапкаОбласть.Параметры.ГодТек	= Формат(Дата,"ДФ=yy");
	
	Если ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента) Тогда 
		ШапкаОбласть.Параметры.ДеньДатаВыдачиДокумента  = Формат(Выборка.ДатаВыдачиДокумента,"ДФ=dd");
		ДатаМесяц 										= Формат(Выборка.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
		ШапкаОбласть.Параметры.МесяцДатаВыдачиДокумента	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
		ШапкаОбласть.Параметры.ГодДатаВыдачиДокумента	= Формат(Выборка.ДатаВыдачиДокумента,"ДФ=yy");
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Фамилия) Тогда
		ФизЛицо = Строка(Выборка.Фамилия) + " " + Строка(Выборка.Имя) + " " + Строка(Выборка.Отчество);
	Иначе
		ФизЛицо = Строка(Выборка.РегистрируемоеЛицо);
	КонецЕсли;
	ФизЛицо = ФизЛицо + ", "+ Строка(Формат(Выборка.ДатаРождения,"ДФ='yyyy ""г.р.""'"));
	ШапкаОбласть.Параметры.ФизЛицо = ФизЛицо;
	
	Если ЗначениеЗаполнено(Выборка.ДомРег) Тогда
		
		ОрганУчета = Строка(Выборка.ДомРег.ПаспортнаяСлужба);
		ОрганУчета_1 = "";
		ОрганУчета_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ОрганУчета, 30, ОрганУчета_1, ОрганУчета_2);
		ШапкаОбласть.Параметры.ОрганУчета_1 = ОрганУчета_1;
		ШапкаОбласть.Параметры.ОрганУчета_2 = ОрганУчета_2;
		
	КонецЕсли;
	
	ДолжностноеЛицоФИО = бит_ПаспортныйСтолСервер.ПолучитьОтветственногоОрганизации(Организация,ДолжностноеЛицо, Дата, Ложь);
	Если ТипЗнч(ДолжностноеЛицоФИО) = Тип("Структура") Тогда
		ШапкаОбласть.Параметры.ДолжностноеЛицо = ДолжностноеЛицоФИО.ДолжностноеЛицо;
		
	КонецЕсли;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ. 
// С макетом заявления.
// Параметры:
//  ВидЗаявления - логический, формирует шаблон в макете.
//  ТипМакета - логический, выбирает версии макета (версия 1 = Истина). 
// Возвращаемое значение:
//  Табличный документ - печатная форма заявления.
//
Функция ПечатьЗаявление(ВидЗаявления = Истина, ТипМакета = Истина)Экспорт
	
	ТабДокумент  = Новый ТабличныйДокумент;
	
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеСНГиРФ";
	Макет         = ПолучитьМакет("Заявление");                       
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	Если ТипМакета Тогда
		ШапкаТекст		  = Макет.ПолучитьОбласть("Текст1");
		СтрокаОбласть	  = Макет.ПолучитьОбласть("СтрокаЖильцов");
		ПодвалОбласть	  = Макет.ПолучитьОбласть("Подвал1");
		Если ВидЗаявления Тогда
			ВидМеста = "пребывания";
		Иначе
			ВидМеста = "проживания";
		КонецЕсли;
	Иначе
		ШапкаТекст		  = Макет.ПолучитьОбласть("Текст2");
		ПодвалОбласть	  = Макет.ПолучитьОбласть("Подвал2");
		Если ВидЗаявления Тогда
			ВидМеста = "пребывания";
		Иначе
			ВидМеста = "жительства";
		КонецЕсли;
		ОбластьПустаяСтрока = Макет.ПолучитьОбласть("ПустаяСтрока");
	КонецЕсли;
	
	Кому = "";
	ОтКого = "";
	
	РегистрируемоеЛицо_1 = "";
	РегистрируемоеЛицо_2 = "";
	
	СрокРегистрации 	= Неопределено;
	АдресПрибытия 		= Неопределено;
	
	Если ЭтотОбъект.ВидОперации <> Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета Тогда
		Если ЗначениеЗаполнено(ЛицевойСчет)И ЗначениеЗаполнено(ЛицевойСчет.Здание) И ЗначениеЗаполнено(ЛицевойСчет.Здание.ПаспортнаяСлужба) Тогда
			РуководительУФМС = "";
			Если ТипЗнч(ЛицевойСчет.Здание.ПаспортнаяСлужба) = Тип("СправочникСсылка.Контрагенты") Тогда
				КонтактЛицо = Строка(ЛицевойСчет.Здание.ПаспортнаяСлужба.ОсновноеКонтактноеЛицо);
				Если ЗначениеЗаполнено(КонтактЛицо) Тогда
					РуководительУФМС_1 = "";
					ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(КонтактЛицо,3,,РуководительУФМС_1);
					РуководительУФМС = ВРег(РуководительУФМС_1);
				КонецЕсли;
				
			КонецЕсли;
			
			СтрокаПаспортСлужба = Строка(ЛицевойСчет.Здание.ПаспортнаяСлужба);  
			ПервыйПробел = Найти(СтрокаПаспортСлужба, " "); 
			
			Если ПервыйПробел > 0 Тогда
				ПервоеСлово = Сред(СтрокаПаспортСлужба,1,ПервыйПробел-1);
				ПервоеСловоВерхРег = ВРег(ПервоеСлово);
				Если ПервоеСловоВерхРег <> ПервоеСлово  Тогда
					
					СтрокаПаспортСлужба = СтрЗаменить(СтрокаПаспортСлужба,ПервоеСлово,"");
					ПервоеСловоСклон = "";
					ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ПервоеСлово,2,,ПервоеСловоСклон);
					Если ИсходСклонения Тогда
						СтрокаПаспортСлужба = ПервоеСловоСклон + СтрокаПаспортСлужба;
					Иначе
						СтрокаПаспортСлужба = Строка(ЛицевойСчет.Здание.ПаспортнаяСлужба);
					КонецЕсли;
				КонецЕсли; 
				
				Кому = "Начальнику " + СтрокаПаспортСлужба;
			Иначе 
				Кому = "Начальнику ";
			КонецЕсли;
			Кому = Кому + " " + Символ(13) + РуководительУФМС;
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(ОтветственныйЗаРегистрацию) Тогда
			ШапкаОбласть.Параметры.Заполнить(ЭтотОбъект);
			// Перевод в родительный падеж.
			ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(Строка(ОтветственныйЗаРегистрацию),2,ОтветственныйЗаРегистрацию.Пол,ОтКого);
			ДанныеПаспорта = бит_ПаспортныйСтолСервер.ПолучитьПаспортныеДанныеСтрокой(ОтветственныйЗаРегистрацию, Дата, Ложь);
			Если ЗначениеЗаполнено(ДанныеПаспорта) Тогда
				ДанныеПаспорта = "";
			КонецЕсли;
			
			Если НЕ ИсходСклонения Тогда
				ОтКого = Строка(ОтветственныйЗаРегистрацию);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ОтветственныйЗаРегистрацию.ДатаРождения) Тогда
				
				ДатаРождения = Формат(ОтветственныйЗаРегистрацию.ДатаРождения,"ДФ='dd.MM.yyyy ""г.р.""'");
				ОтКого  = "от " + ОтКого + " "+ ДатаРождения + Символ(13) + ДанныеПаспорта;
				
			Иначе
				
				ОтКого  = "от " + ОтКого + Символ(13) + ДанныеПаспорта;
			КонецЕсли;
			
		КонецЕсли; 
		
		Если ЗначениеЗаполнено(РегистрируемоеЛицо) Тогда
			
			РегистрируемоеЛицоЛС = "";
			
			ФИОРегЛица = "";
			ФИОРегЛица = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(РегистрируемоеЛицо, Дата, Ложь);
			Если ФИОРегЛица = Неопределено ИЛИ НЕ ЗначениеЗаполнено(ФИОРегЛица) Тогда
				ФИОРегЛица = Строка(РегистрируемоеЛицо);
			КонецЕсли;
			
			Если ТипМакета Тогда
				ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФИОРегЛица,2,РегистрируемоеЛицо.Пол,РегистрируемоеЛицоЛС);
			Иначе
				ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ФИОРегЛица,3,РегистрируемоеЛицо.Пол,РегистрируемоеЛицоЛС);
			КонецЕсли;
			
			Если ИсходСклонения Тогда
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(РегистрируемоеЛицоЛС, 70, РегистрируемоеЛицо_1, РегистрируемоеЛицо_2);
				РегЛицо = РегистрируемоеЛицоЛС;
			Иначе
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Строка(РегистрируемоеЛицо), 70, РегистрируемоеЛицо_1, РегистрируемоеЛицо_2);
				РегЛицо = Строка(РегистрируемоеЛицо);
			КонецЕсли; 
			
		КонецЕсли; 
		
		АдресЛС = "";
		Если ЗначениеЗаполнено(ОтветственныйЗаРегистрацию) Тогда
			АдресПоПрописке = бит_ПаспортныйСтолСервер.ПолнаяКонтактнаяИнформацияПоОбъекту(ОтветственныйЗаРегистрацию,Перечисления.бит_ТипыКонтактнойИнформации.Адрес,Справочники.бит_ВидыКонтактнойИнформации.ЮрАдресПроживающего);
			Если АдресПоПрописке <> Неопределено И ЗначениеЗаполнено(АдресПоПрописке.Представление) Тогда
				АдресЛС = АдресПоПрописке.Представление;
				
			ИначеЕсли ЗначениеЗаполнено(ЛицевойСчет) Тогда
				
				Если ЗначениеЗаполнено(ЛицевойСчет.Здание.ПочтовыйАдрес) Тогда
					
					АдресЛС = Строка(ЛицевойСчет.Здание.ПочтовыйАдрес)+ ?(ЗначениеЗаполнено(ЛицевойСчет.Квартира), ", кв." + Строка(ЛицевойСчет.Квартира),"");
					
				Иначе
					УлицаАдреса = ?(ЗначениеЗаполнено(ЛицевойСчет.УлицаЛицевогоСчета),"ул. " + Строка(ЛицевойСчет.УлицаЛицевогоСчета),"");
					ДомАдреса = ?(ЗначениеЗаполнено(ЛицевойСчет.Здание),", д. " + Строка(ЛицевойСчет.Здание),"");
					КорпусАдреса = ?(ЗначениеЗаполнено(ЛицевойСчет.Здание.Корпус),", корп. " + Строка(ЛицевойСчет.Здание.Корпус),"");
					КвартираАдреса = ?(ЗначениеЗаполнено(ЛицевойСчет.Квартира),", кв. " + Строка(ЛицевойСчет.Квартира),"");
					
					АдресЛС =  УлицаАдреса + ДомАдреса + КорпусАдреса + КвартираАдреса;  
					
				КонецЕсли; 
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ДатаРегистрации) и ЗначениеЗаполнено(ДатаСнятияСРегистрации) Тогда
			
			СрокРегистрации = бит_ПаспортныйСтолКлиетСервер.ПериодПрописью(ДатаРегистрации,ДатаСнятияСРегистрации);
			
		КонецЕсли;
		АдресПрибытия = "";
		Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
			
			Если ЗначениеЗаполнено(ЛицевойСчет.Здание.ПочтовыйАдрес) Тогда
				
				АдресПрибытия = Строка(ЛицевойСчет.Здание.ПочтовыйАдрес)+ ?(ЗначениеЗаполнено(ЛицевойСчет.Квартира), ", кв." + Строка(ЛицевойСчет.Квартира),"");
				
			Иначе
				УлицаАдреса = ?(ЗначениеЗаполнено(ЛицевойСчет.УлицаЛицевогоСчета),"ул. " + Строка(ЛицевойСчет.УлицаЛицевогоСчета),"");
				ДомАдреса = ?(ЗначениеЗаполнено(ЛицевойСчет.Здание),", д. " + Строка(ЛицевойСчет.Здание),"");
				КорпусАдреса = ?(ЗначениеЗаполнено(ЛицевойСчет.Здание.Корпус),", корп. " + Строка(ЛицевойСчет.Здание.Корпус),"");
				КвартираАдреса = ?(ЗначениеЗаполнено(ЛицевойСчет.Квартира),", кв. " + Строка(ЛицевойСчет.Квартира),"");
				
				АдресПрибытия =  УлицаАдреса + ДомАдреса + КорпусАдреса + КвартираАдреса;  
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	СтруктураДляМакета = Новый Структура("Кому,ОтКого,РегЛицо, РегистрируемоеЛицо_1,РегистрируемоеЛицо_2,АдресЛС,ВидМеста,СрокРегистрации,АдресПрибытия,ОтветственныйЗаРегистрацию"
	,Кому,ОтКого,РегЛицо, РегистрируемоеЛицо_1,РегистрируемоеЛицо_2,АдресЛС,ВидМеста,СрокРегистрации,АдресПрибытия,Строка(ОтветственныйЗаРегистрацию));
	
	ШапкаОбласть.Параметры.Заполнить(СтруктураДляМакета);
	ТабДокумент.Вывести(ШапкаОбласть);
	ШапкаТекст.Параметры.Заполнить(СтруктураДляМакета);
	Если НЕ ТипМакета тогда
		
		СписокПроживающих = бит_ПаспортныйСтолСервер.ПолучитьСписокПроживающихПоЛС(ЛицевойСчет, Дата);
		НайденнаяСтрока = СписокПроживающих.Найти(ОтветственныйЗаРегистрацию,"ФизЛицо");
		Если НайденнаяСтрока <> Неопределено Тогда
			Если ЗначениеЗаполнено(НайденнаяСтрока.ПравоустанавливающиеДокументы) Тогда
				ДокСтрока = НайденнаяСтрока.ПравоустанавливающиеДокументы;
				
				СтрокаДляСклонения = "";
				ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(ДокСтрока.Наименование,2,,СтрокаДляСклонения);
				Если ИсходСклонения Тогда
					ДокИтогСтрока = СтрокаДляСклонения;
				Иначе
					ДокИтогСтрока = ДокСтрока.Наименование;
				КонецЕсли; 
				ДокИтогСтрока = ДокИтогСтрока + ?(ЗначениеЗаполнено(ДокСтрока.НомерДокумента)," №" + ДокСтрока.НомерДокумента,"")
				+ ?(ЗначениеЗаполнено(ДокСтрока.ДатаДокумента)," от " + Формат(ДокСтрока.ДатаДокумента,"ДЛФ=DD"),"");
				ШапкаТекст.Параметры.ПравоустанавливающиеДокументы = ДокИтогСтрока;
			КонецЕсли;
		КонецЕсли;
		
		СтепеньРодстваИтог = "";
		Если РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Мужской Тогда
			СтепеньРодстваИтог = "моему ";
		ИначеЕсли РегистрируемоеЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
			СтепеньРодстваИтог = "моей ";
		КонецЕсли;
		
		СтепеньРодстваЛС = "";
		ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(Строка(СтепеньРодства),3,,СтепеньРодстваЛС);
		Если ИсходСклонения Тогда
			СтепеньРодстваИтог = СтепеньРодстваИтог + СтепеньРодстваЛС;
		Иначе
			СтепеньРодстваИтог = СтепеньРодстваИтог + Строка(СтепеньРодства);
		КонецЕсли; 
		ШапкаТекст.Параметры.СтепеньРодства = СтепеньРодстваИтог;
	КонецЕсли;
	ТабДокумент.Вывести(ШапкаТекст);
	Если ТипМакета Тогда
		// Вывод строк с проживающими по ЛС.
		Если ЭтотОбъект.ВидОперации <> Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета Тогда
			
			// Формирование списка совершеннолетних, заполненных в таб части формы на вкладке "Доп. данные".
			СписокПроживающих = ФизическиеЛица.Выгрузить();
			МассивДляУдаления = Новый Массив;
			Для каждого ДанныеПроживающего Из СписокПроживающих Цикл
				
				ДатаРождения = ДанныеПроживающего.ФизическоеЛицо.ДатаРождения;
				
				ЧислоЛет = бит_ПаспортныйСтолКлиетСервер.КолвоПолныхЛет(ДатаРождения,ДатаРегистрации);
				
				Если ЧислоЛет < 18 Тогда
					МассивДляУдаления.Добавить(ДанныеПроживающего);
				КонецЕсли;
				
			КонецЦикла;
			
			Для каждого СтрокаМассива Из МассивДляУдаления  Цикл
				
				СписокПроживающих.Удалить(СтрокаМассива);
				
			КонецЦикла; 
			Если СписокПроживающих.Количество()>0 Тогда
				
				Для каждого СтрокаТЧ Из СписокПроживающих Цикл
					
					ФИОФизЛица      = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(СтрокаТЧ.ФизическоеЛицо,Дата, Ложь);
					
					Если ЗначениеЗаполнено(ФИОФизЛица) Тогда
						СтрокаОбласть.Параметры.ЖилецЛС = ФИОФизЛица;
					Иначе
						СтрокаОбласть.Параметры.ЖилецЛС = СтрокаТЧ.ФизическоеЛицо.Наименование;
					КонецЕсли;
					ТабДокумент.Вывести(СтрокаОбласть);
				КонецЦикла;
				
			Иначе 
				КолвоСтрок = 3;
				Для Счетчик = 1 По КолвоСтрок Цикл
					ТабДокумент.Вывести(СтрокаОбласть);
				КонецЦикла; 
			КонецЕсли;		
		Иначе
			
			КолвоСтрок = 3;
			Для Счетчик = 1 По КолвоСтрок Цикл
				ТабДокумент.Вывести(СтрокаОбласть);
			КонецЦикла; 
			
		КонецЕсли;
		
	КонецЕсли;     
	
	Если ЗначениеЗаполнено(ДатаРегистрации) тогда
		ДатаЗаявления = ДатаРегистрации;
	ИначеЕсли ЗначениеЗаполнено(Дата) Тогда
		ДатаЗаявления = Дата;
	Иначе 
		ДатаЗаявления = ТекущаяДата();
	КонецЕсли;
	
	Если ТипМакета Тогда
		
		ПодвалОбласть.Параметры.День 	= Формат(ДатаЗаявления ,"ДФ=dd");
		ПодвалОбласть.Параметры.Месяц 	= Формат(ДатаЗаявления ,"ДФ=MM");
		ПодвалОбласть.Параметры.Год 	= Формат(ДатаЗаявления ,"ДФ='yyyy ""г.""'");
	Иначе
		ПодвалОбласть.Параметры.ДатаРегистрации = Формат(ДатаЗаявления, "ДЛФ=DD");
		КолвоСтрок = 3;
		Для Счетчик = 1 По КолвоСтрок Цикл
			ТабДокумент.Вывести(ОбластьПустаяСтрока);
		КонецЦикла; 
		
	КонецЕсли;	
	
	ТабДокумент.Вывести(ПодвалОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

//Функция формирует табличный документ  с макетом СопроводительноеПисьмо

// Процедура осуществляет печать документа. Можно направить печать на. 
// Экран или принтер, а также распечатать необходмое количество копий.
//
//  Название макета печати передается в качестве параметра,
// По переданному названию находим имя макета в соответствии.
//
// Параметры:
//  НазваниеМакета - строка, название макета.
//
Процедура Печать(ИмяМакета, КоличествоЭкземпляров = 1, НаПринтер = Ложь, НепосредственнаяПечать = Ложь) Экспорт
	
	// Получить экземпляр документа на печать.
	Если ИмяМакета = "ЗОРПМЖ" тогда
		
		ТабДокумент = ПечатьЗОРПМЖ();
		
	ИначеЕсли ИмяМакета = "СОРПМЖ" тогда
		
		ТабДокумент = ПечатьСОРПМЖ();
		
	ИначеЕсли ИмяМакета = "КР" тогда
		
		ТабДокумент = ПечатьКР();
		
	ИначеЕсли ИмяМакета = "ЛСУП" тогда
		
		ТабДокумент = ПечатьЛСУП();
		
	ИначеЕсли ИмяМакета = "ЗОССРУПМЖ" тогда
		
		ТабДокумент = ПечатьЗОССРУПМЖ(Ложь);
		
	ИначеЕсли ИмяМакета = "ЗОССРУПМЖ_2части" тогда
		
		ТабДокумент = ПечатьЗОССРУПМЖ(Истина);
		
	ИначеЕсли ИмяМакета = "АЛУ" тогда
		
		ВидМакета = истина;
		ТабДокумент = ПечатьАЛУ(ВидМакета);
		
	ИначеЕсли ИмяМакета = "АЛУ_стар" тогда
		
		ВидМакета = ложь;
		ТабДокумент = ПечатьАЛУ(ВидМакета);
		
	ИначеЕсли ИмяМакета = "ЛСУВ" тогда
		
		ТабДокумент = ПечатьЛСУВ();
		
	ИначеЕсли ИмяМакета = "УВОРУ" тогда
		
		ТабДокумент = ПечатьУВОРУ();
		
	ИначеЕсли  ИмяМакета = "АЛП" тогда	
		
		ВидМакета = Истина;
		ТабДокумент = ПечатьАЛП(ВидМакета);
		
	ИначеЕсли  ИмяМакета = "АЛП_стар" тогда	
		
		ВидМакета = Ложь;
		ТабДокумент = ПечатьАЛП(ВидМакета);
		
	ИначеЕсли  ИмяМакета = "Анкета" тогда	
		
		ТабДокумент = ПечатьАнкета();
		
	ИначеЕсли  ИмяМакета = "СОРГ_РФ_ПМЖ" тогда	
		
		ТабДокумент = ПечатьСОРГ_РФ_ПМЖ();
	ИначеЕсли  ИмяМакета = "СОРГ_РФ_ПМЖ_Old" тогда	
		
		ТабДокумент = ПечатьСОРГ_РФ_ПМЖ(Ложь);
	ИначеЕсли ИмяМакета = "СОРПМП" Тогда
		
		ТабДокумент = ПечатьСОРПМП();
		
	ИначеЕсли ИмяМакета = "СОРПМПЖ" Тогда
		
		ТабДокумент = ПечатьСОРПМПЖ();
		
	ИначеЕсли ИмяМакета = "ЗаявлениеСНГ1" Тогда
		
		ТабДокумент = ПечатьЗаявление(Ложь);
		
	ИначеЕсли ИмяМакета = "ЗаявлениеРФ1" Тогда
		
		ТабДокумент = ПечатьЗаявление();
	ИначеЕсли ИмяМакета = "ЗаявлениеСНГ2" Тогда
		
		ТабДокумент = ПечатьЗаявление(Ложь, Ложь);
		
	ИначеЕсли ИмяМакета = "ЗаявлениеРФ2" Тогда
		
		ТабДокумент = ПечатьЗаявление(, Ложь);
		
		
	КонецЕсли;
	
КонецПроцедуры

