	|				ТОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)
	|			ИНАЧЕ Остатки.СуммаКонечныйОстаток
	|		КОНЕЦ) КАК СуммаКонечныйОстатокКт,
	|	ПоставщикиИУслуги.ЛицевойСчет КАК ЛицевойСчет,
	|	ПоставщикиИУслуги.Организация
	|ИЗ
	|	ПоставщикиИУслуги КАК ПоставщикиИУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК Остатки
	|		ПО ПоставщикиИУслуги.ЛицевойСчет = Остатки.ЛицевойСчет
	|			И ПоставщикиИУслуги.Услуга = Остатки.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_УслугиНачисления КАК ВТ_УслугиНачисления
	|		ПО ПоставщикиИУслуги.ЛицевойСчет = ВТ_УслугиНачисления.ЛицевойСчет
	|
	|СГРУППИРОВАТЬ ПО
	|	ПоставщикиИУслуги.Услуга,
	//|	ЕСТЬNULL(ВТ_УслугиНачисления.Услуга, ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)),
	|	ПоставщикиИУслуги.ЛицевойСчет,
	|	ПоставщикиИУслуги.Организация
	|
	|ИМЕЮЩИЕ
	|	СУММА(ВЫБОР
	|			КОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0) > 0
	|				ТОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)
	|			ИНАЧЕ Остатки.СуммаКонечныйОстаток
	|		КОНЕЦ) > 0";
	
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапрос);

	Если МассивЛС.Количество() > 0 Тогда
		
		ЗапросСхемы0	= СхемаЗапроса.ПакетЗапросов[0];
		ОператорВыбора0 = ЗапросСхемы0.Операторы[0];
		ОператорВыбора0.Отбор.Добавить("бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет В (&ЛицевыеСчета)");

		ЗапросСхемы1	= СхемаЗапроса.ПакетЗапросов[1];
		ОператорВыбора1 = ЗапросСхемы1.Операторы[0];
		ОператорВыбора1.Отбор.Добавить("бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет В (&ЛицевыеСчета)");
		
