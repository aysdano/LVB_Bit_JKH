// Служебная процедура для заполнения колонки "Адрес" табличного поля "СписокЛС".
&НаСервере
Процедура ОбновитьДанныеКолонкиАдрес()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета,
	|	бит_ЛицевыеСчета.Здание,
	|	бит_ЛицевыеСчета.Здание.Корпус КАК Корпус,
	|	бит_ЛицевыеСчета.Квартира
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка В(&СписокЛицевыхСчетов)"
	);
	
	Запрос.УстановитьПараметр("СписокЛицевыхСчетов",Объект.СписокЛС.Выгрузить().ВыгрузитьКолонку("ЛицевойСчет"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Для Каждого Стр Из Объект.СписокЛС Цикл
		
		Если Выборка.НайтиСледующий(Стр.ЛицевойСчет,"ЛицевойСчет") Тогда
			
			Стр.Адрес = Строка(Выборка.УлицаЛицевогоСчета) + ", д. " + Строка(Выборка.Здание) + ?(ПустаяСтрока(Выборка.Корпус),"",", кор. " + Строка(Выборка.Корпус)) + ", кв. " + Строка(Выборка.Квартира);
			
		Иначе
			
			Стр.Адрес = "";
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокЗначенийУслуг(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);   
	Запрос.УстановитьПараметр("Момент"     ,Объект.Дата);
	
	СписокЗнУслуг = Новый СписокЗначений;
	СписокЗнУслуг.ЗагрузитьЗначения(Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Услуга"));
	
	Возврат СписокЗнУслуг;
	
КонецФункции

&НаСервере
Функция ПолучитьСальдоНаЛицевомСчете(ЛицевойСчет)
	
	Если Объект.ВидОперации = Перечисления.бит_ВидыОперацийВводНачальныхОстатковПоКУ.ВводИнтегральногоНачальногоСальдо Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = "ВЫБРАТЬ
		|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток КАК Остаток
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки";
		
		Запрос.УстановитьПараметр("Момент"     ,Объект.Дата);
		Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			СальдоНаЛС = Выборка.Остаток;
			
		КонецЕсли;
		
	Иначе
		
		СальдоНаЛС = 0;
		
	КонецЕсли;
	
	Возврат СальдоНаЛС;
	
КонецФункции

&НаСервере
Процедура УдалитьСтрокиСпискаУслуг(ЛицевойСчет)
	
	НайденныеСтроки = Объект.СписокУслуг.НайтиСтроки(Новый Структура("ЛицевойСчет",ЛицевойСчет));
	
	Для Каждого ТекСтрокаМассива Из НайденныеСтроки Цикл
		
		Объект.СписокУслуг.Удалить(ТекСтрокаМассива);
		
	КонецЦикла;
	
КонецПроцедуры

