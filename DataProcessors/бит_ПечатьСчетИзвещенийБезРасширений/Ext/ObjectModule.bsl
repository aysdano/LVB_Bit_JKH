КонецФункции

Функция ПреобразоватьТЗВМассив(ТЗ, НомерКолонки = 1)
	Массив = Новый Массив;
	НаименованиеКолонки = ТЗ.Колонки[НомерКолонки].Имя;
	
	Для Каждого Стр Из ТЗ Цикл
		Массив.Добавить(Стр[НаименованиеКолонки]);	
	КонецЦикла;
	
	Возврат Массив;	
КонецФункции

Функция РазложитьСтрокуВМассивПодстрок(Знач Строка, Знач Разделитель = ",",
    Знач ПропускатьПустыеСтроки = Неопределено)
 
    Результат = Новый Массив;
 
    // для обеспечения обратной совместимости
    Если ПропускатьПустыеСтроки = Неопределено Тогда
        ПропускатьПустыеСтроки = ?(Разделитель = " ", Истина, Ложь);
        Если ПустаяСтрока(Строка) Тогда 
            Если Разделитель = " " Тогда
                Результат.Добавить("");
            КонецЕсли;
            Возврат Результат;
        КонецЕсли;
    КонецЕсли;
    //
 
    Позиция = Найти(Строка, Разделитель);
    Пока Позиция > 0 Цикл
        Подстрока = Лев(Строка, Позиция - 1);
        Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Подстрока) Тогда
            Результат.Добавить(Подстрока);
        КонецЕсли;
        Строка = Сред(Строка, Позиция + СтрДлина(Разделитель));
        Позиция = Найти(Строка, Разделитель);
    КонецЦикла;
 
    Если Не ПропускатьПустыеСтроки Или Не ПустаяСтрока(Строка) Тогда
        Результат.Добавить(Строка);
    КонецЕсли;
 
    Возврат Результат;
 
КонецФункции

Функция ПолучитьТелефоныАнтенны(Услуга)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КонтрагентыКонтактнаяИнформация.Значение КАК Значение
	|ИЗ
	|	(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|		бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств КАК ПолучательДенежныхСредств
	|	ИЗ
	|		РегистрСведений.бит_ПолучателиДенежныхСредств.СрезПоследних(, Услуга = &Услуга) КАК бит_ПолучателиДенежныхСредствСрезПоследних) КАК ВложенныйЗапрос
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Контрагенты.КонтактнаяИнформация КАК КонтрагентыКонтактнаяИнформация
	|		ПО ВложенныйЗапрос.ПолучательДенежныхСредств = КонтрагентыКонтактнаяИнформация.Ссылка
	|ГДЕ
	|	КонтрагентыКонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)";
	
	Запрос.УстановитьПараметр("Услуга", Услуга);
	РезультатЗапроса = Запрос.Выполнить();
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	СтрокаТелефон = "";
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл

		Текст = ВыборкаДетальныеЗаписи.Значение;
		Текст = СтрЗаменить(Текст, "{", "");
		Текст = СтрЗаменить(Текст, "}", "");
		Текст = СтрЗаменить(Текст, """", "");
		Мас = РазложитьСтрокуВМассивПодстрок(Текст, Символы.ПС);
		Комметарий = "";
		Для Каждого Эл Из Мас Цикл
			
			Если СтрНайти(Эл, "value:") <> 0 Тогда
				ЧислоСимволов = СтрДлина(Эл);
				Тел = (Сред(Эл, 8, ЧислоСимволов - 9));
			КонецЕсли;
			
			Если СтрНайти(Эл, "comment:") <> 0 Тогда
				ЧислоСимволов = СтрДлина(Эл);
				Комметарий = (Сред(Эл, 9, ЧислоСимволов - 10)) + ": ";
			КонецЕсли;

		КонецЦикла;
		СтрокаТелефон = СтрокаТелефон + Комметарий + Тел + Символы.ПС;
	КонецЦикла;
	
	Возврат СтрокаТелефон;
КонецФункции

Функция QRКодДолговая(ФИОСтрока, ЛицевойСчет, ТабДок, РасчетныйСчетСсылка, ОбластьQRКод = Неопределено)
	
	//СведенияОПолучателе   = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Организация, ДатаПечатиКвитанций, РС);
	
	//Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") Тогда
		//ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Истина,РасчетныйСчетСсылка).Выгрузить();
	//Иначе
	//	ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
	//	ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Ложь,РасчетныйСчетСсылка).Выгрузить();
	//КонецЕсли;
	
	
	ФИО		= ФИОСтрока;
	Фамилия	= ВыделитьСлово(ФИО);
	Имя		= ВыделитьСлово(ФИО);
	Отчество= ВыделитьСлово(ФИО);
	
	РеквизитыПлатежа					= НоваяСтруктураРеквизитыПлатежаУФЭБС();
	РеквизитыПлатежа.ИННПлательщика		= ?(ЗначениеЗаполнено(ФИОСтрока), ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ФИОСтрока,"ИНН"), "");
	//РеквизитыПлатежа.НомерСчетаПолучателя		= РасчетныйСчетСсылка;
	РеквизитыПлатежа.НомерСчетаПолучателя		= РасчетныйСчетСсылка.НомерСчета;
	Если ДанныеОПолучателеПлатежа.Количество() > 0 Тогда
		РеквизитыПлатежа.ТекстПолучателя 			= ДанныеОПолучателеПлатежа[0].Наименование;
		РеквизитыПлатежа.НаименованиеБанкаПолучателя = "ОАО АКБ ИТ Банк";
		РеквизитыПлатежа.БИКБанкаПолучателя			=  ДанныеОПолучателеПлатежа[0].БИК;
		РеквизитыПлатежа.СчетБанкаПолучателя		= ДанныеОПолучателеПлатежа[0].КоррСчет;
		РеквизитыПлатежа.ИННПолучателя				= ДанныеОПолучателеПлатежа[0].ИНН;
		РеквизитыПлатежа.КПППолучателя				= ДанныеОПолучателеПлатежа[0].КПП;
	Иначе
		РеквизитыПлатежа.ТекстПолучателя 			= "";
		РеквизитыПлатежа.НаименованиеБанкаПолучателя = "";
		РеквизитыПлатежа.БИКБанкаПолучателя			=  "";
		РеквизитыПлатежа.СчетБанкаПолучателя		= "";
		РеквизитыПлатежа.ИННПолучателя				= "";
		РеквизитыПлатежа.КПППолучателя				= "";
	КонецЕсли;
	
	РеквизитыПлатежа.НомерЛицевогоСчетаПлательщика	= ЛицевойСчет;
	
	МассивРеквизитов =  ТаблицаРеквизитовQRКода.Выгрузить(Новый Структура("Выводить", Истина)).ВыгрузитьКолонку("Реквизит");
	Для Каждого Элт Из РеквизитыПлатежа Цикл
		Если МассивРеквизитов.Найти(Элт.Ключ) = Неопределено Тогда
			РеквизитыПлатежа[Элт.Ключ] = Неопределено;
		КонецЕсли;	
	КонецЦикла;
	
	// QR-код.
	QRСтрока = УправлениеПечатью.ФорматнаяСтрокаУФЭБС(РеквизитыПлатежа);
	
	Если НЕ ПустаяСтрока(QRСтрока) Тогда // Возникли ошибки
		
		ДанныеQRКода = УправлениеПечатью.ДанныеQRКода(QRСтрока, 0, 190);
		Если НЕ ТипЗнч(ДанныеQRКода) = Тип("ДвоичныеДанные") Тогда
			ТекстСообщения = Нстр("ru = 'Не удалось сформировать QR-код для документа.
			|Технические подробности см. в журнале регистрации.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
		Если НЕ ОбластьQRКод = Неопределено Тогда
			Попытка
				ОбластьQRКод.Рисунки.QRКод.Картинка =  Новый Картинка(ДанныеQRКода);
				ТабДок.Вывести(ОбластьQRКод);
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Попытка
			Для Каждого Рис Из ТабДок.Рисунки Цикл
				Если НЕ СтрНайти(НРег(Рис.Имя), "qrкод") = 0 Тогда
					Рис.Картинка = Новый Картинка(ДанныеQRКода);
				КонецЕсли;
			КонецЦикла;	
		Исключение
		КонецПопытки
	Иначе
		УбратьQRКод(ТабДок);
	КонецЕсли;
КонецФункции

