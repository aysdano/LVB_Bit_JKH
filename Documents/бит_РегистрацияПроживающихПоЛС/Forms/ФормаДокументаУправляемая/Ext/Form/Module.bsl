Функция РассчитатьСуммуДолейНаСервере(Знач Физлицо, Знач ДоляПлощади)
	
	Отбор = Новый Структура("ФизЛицо", Физлицо);
	
	ТаблицаФизЛицДолей = РеквизитФормыВЗначение("мТаблицаФизЛицДолей");
	
	СтрокаПоиска = ТаблицаФизЛицДолей.НайтиСтроки(Отбор);
	
	Если СтрокаПоиска.Количество() <>  0 Тогда
		
		ТекДоля = СтрокаПоиска[0].ДоляПлощади;
		
		ТаблицаФизЛицДолей.Удалить(СтрокаПоиска[0]);
		
		СуммаДолей = ТаблицаФизЛицДолей.Итог("ДоляПлощади") + ДоляПлощади;
		
		НоваяСтрока = ТаблицаФизЛицДолей.Добавить();
		
		НоваяСтрока.ФизЛицо     = Физлицо;
		НоваяСтрока.ДоляПлощади = ДоляПлощади;
		
	Иначе
		
		СуммаДолей = ТаблицаФизЛицДолей.Итог("ДоляПлощади") + ДоляПлощади;
		
		НоваяСтрока = ТаблицаФизЛицДолей.Добавить();
		
		НоваяСтрока.ФизЛицо     = Физлицо;
		НоваяСтрока.ДоляПлощади = ДоляПлощади;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ТаблицаФизЛицДолей,"мТаблицаФизЛицДолей");
	
	Возврат СуммаДолей;
	
КонецФункции

