Процедура ЗафиксироватьОшибку(ТаблицаОшибок, ТекстОшибки, ТекстРекомендации = "")
	
	НоваяОшибка = ТаблицаОшибок.Добавить();
	НоваяОшибка.Ошибка       = ТекстОшибки;
	НоваяОшибка.Рекомендации = ТекстРекомендации;
	
КонецПроцедуры
