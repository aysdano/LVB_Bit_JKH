Процедура ЗагрузитьТаблицуВДокумент(ТЗ,Настройки)
	
	ТаблицаДляИзмененияСтатуса = Новый ТаблицаЗначений;
	ТаблицаДляИзмененияСтатуса.Колонки.Добавить("ИД_События");
	ИзменитьСтатусы = Ложь;
	
	ДокументВводПоказаний = Документы.бит_ВводПоказанийПоСчетчикам.СоздатьДокумент();
	
	ДокументВводПоказаний.Организация = Настройки.Организация;
	ДокументВводПоказаний.Ответственный = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
	
	ДокументВводПоказаний.ВидОперации = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний;
	ДокументВводПоказаний.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный;
	ДокументВводПоказаний.ПоказанияНаселения = Истина;
	ДокументВводПоказаний.Дата = ТекущаяДатаСеанса();
	
	ДокументВводПоказаний.Комментарий    = "# загружен автоматически из системы МЛК";
	ДокументВводПоказаний.Ответственный    = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
	
	Для Каждого Стр Из ТЗ Цикл
		Если Стр.Статус = Строка(Настройки.СтатусЗакрыто) Тогда Продолжить; КонецЕсли;
		
		СпрЛС  = Справочники.бит_ЛицевыеСчета.НайтиПоКоду(Стр.ЛС);
		Если СпрЛС<>Справочники.бит_ЛицевыеСчета.ПустаяСсылка() Тогда
