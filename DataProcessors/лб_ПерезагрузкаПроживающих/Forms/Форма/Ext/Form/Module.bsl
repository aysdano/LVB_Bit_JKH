					ЭтоКрайняяСтрока = СледСтрока=Неопределено или (СледСтрока.Жилец<>СтрокаИсх.Жилец);
					//Данные о собственноси дублируем до крайней записи
					Если НЕ ЭтоКрайняяСтрока и (СтрокаИсх.PR_SOB=1 ) и (СледСтрока.PR_SOB=0) тогда
						ЗаполнитьЗначенияСвойств(СледСтрока,СтрокаИсх,"PR_SOB,D1,D2,SOBST");						
					КонецЕсли;;					
					
					//Если есть дата выписки у собственника или у ответственного (не собственника),
					//в крайней строке, тогда делим строку на две, без даты выписки в каждой
					Если ЭтоКрайняяСтрока и ЗначениеЗаполнено(СтрокаИсх.ДатаВыписки) и 						
						 	(СтрокаИсх.PR_SOB=1)
					тогда	
						Если Индекс = ЧислоСтрок-1 тогда
							СледСтрока = ТаблИсхЛС.Добавить();
						иначе
							СледСтрока = ТаблИсхЛС.Вставить(Индекс+1);
						КонецЕсли;
						ЗаполнитьЗначенияСвойств(СледСтрока,СтрокаИсх);
						СледСтрока.ДатаПрописки = СтрокаИсх.ДатаВыписки;
						СледСтрока.ДатаВыписки  = '0001-01-01';
						СледСтрока.СтатусФизЛица = СобственникНеПроживает; 													 
						СтрокаИсх.ДатаВыписки = '0001-01-01';
						ЧислоСтрок = ЧислоСтрок+1;                						
					КонецЕсли;
					
					Если Не ЗначениеЗаполнено(СтрокаИсх.СтатусФизлица) тогда
						Если ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) и не ЗначениеЗаполнено(СтрокаИсх.ДатаВыписки) тогда
							//прописан и не выписан
							СтрокаИсх.СтатусФизлица = ПроживаетПостоянно;
						ИначеЕсли ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) и (СтрокаИсх.ДатаВыписки>='2025-01-01') тогда	
							//прописан и выписан после 2025 года
							СтрокаИсх.СтатусФизлица = ПроживаетПостоянно;
							
						ИначеЕсли ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) и 
									(СтрокаИсх.ДатаВыписки<'2025-01-01') и 
									(СтрокаИсх.ДатаВыписки>'2019-01-31') тогда	
							//прописан и выписан в будущем, но до  2025 года							
							СтрокаИсх.СтатусФизлица = ПроживаетВременно;
						ИначеЕсли ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) и 									
									(СтрокаИсх.ДатаВыписки<='2019-01-31') тогда	
							//прописан и выписан в прошлом		
							СтрокаИсх.СтатусФизлица = ?(СтрокаИсх.REG_VR=1,
														ПроживаетВременно,
														ПроживаетПостоянно);		
						ИначеЕсли  СтрокаИсх.PR_SOB=1 и НЕ ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) тогда							
							//Собственник не был прописан
							СтрокаИсх.СтатусФизлица = СобственникНеПроживает;
						ИначеЕсли СтрокаИсх.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо и НЕ ЗначениеЗаполнено(СтрокаИсх.ДатаПрописки) тогда														
							//Отвественный (не собственник) не был прописан
							СтрокаИсх.СтатусФизлица	= ОтветственныйНеПроживает;						 
						КонецЕсли;	
							
					КонецЕсли;
				
					Если СтрокаИсх.СтатусФизлица = ПроживаетПостоянно тогда
						СтрокаИсх.СтатусПроживания = Перечисления.бит_СтатусПроживания.Постоянно
					ИначеЕсли СтрокаИсх.СтатусФизлица = ПроживаетВременно тогда
						СтрокаИсх.СтатусПроживания = Перечисления.бит_СтатусПроживания.Временно	
					иначе	
					    СтрокаИсх.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает
					КонецЕсли;	
					
					 //Заполняем строку в РС.бит_ПроживающиеНаЛС;					
					 НовЗапись = ТаблП.Добавить();
					 НовЗапись.ЛицевойСчет   = СтрокаИсх.ЛС;
					 НовЗапись.ФизЛицо       = СтрокаИсх.Жилец;
					 НовЗапись.Период 		 = НаборП.Отбор.Регистратор.Значение.Дата + Индекс*3600*24;
					 НовЗапись.Активность = Истина;
					 НовЗапись.ВладелецКвартиры =?(СтрокаИсх.PR_SOB = 1,
					 								Перечисления.ДаНет.Да,
													Перечисления.ДаНет.Нет);
					 НовЗапись.СтатусФизЛица		= СтрокаИсх.СтатусФизлица;					
					 НовЗапись.СтепеньРодства       = СтрокаИсх.СтепеньРодства;
					 НовЗапись.СтатусПроживания     = СтрокаИсх.СтатусПроживания;
					 НовЗапись.ДатаРегистрации      = СтрокаИсх.ДатаПрописки;
					 НовЗапись.ДатаСнятияСРегистрации = СтрокаИсх.ДатаВыписки;
					 //НовЗапись.ДатаЗаписи             =  //дата окончания действия 
					 НовЗапись.ДоляПлощади            = ?(СтрокаИсх.D2=0,0,СтрокаИсх.D1/СтрокаИсх.D2);
					 НовЗапись.лб_ДоляПлощадиСтрокой  = сокрЛП(СтрокаИсх.SOBST);
					 НовЗапись.лб_СтрокаРодствДляФЛС  = СтрокаИсх.ОписаниеРодства;	
					 
					 
					 Индекс = Индекс+1;
					 
				КонецЦикла;
				
			КонецЕсли;	                          		
			
		КонецЦикла;	 //Лицевой счет
				
		
		
		Сч = Сч+1;
	КонецЦикла;	  //Здание
	
	Если НаборП<>Неопределено тогда
		НаборП.Загрузить(ТаблП);
		НаборП.Записать(истина);
	КонецЕсли;	

	
	
		
	
	
	
