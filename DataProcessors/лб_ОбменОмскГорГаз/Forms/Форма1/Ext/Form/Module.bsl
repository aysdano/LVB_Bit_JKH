	        |		КОГДА НЕ ВТ_Финал.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	        |			ТОГДА ""Выписан""
	        |		КОГДА ВТ_Финал.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Постоянно)
	        |			ТОГДА ""Постоянно""
	        |		КОГДА ВТ_Финал.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Временно)
	        |			ТОГДА ""Временно""
	        |		ИНАЧЕ ""Не прописан""
	        |	КОНЕЦ КАК VID_REG,
	        |	ВТ_Финал.ДатаРегистрации КАК DAT_REG,
	        |	ВТ_Финал.ДатаСнятияСРегистрации КАК DAT_UNREG,
	        |	ВЫБОР
	        |		КОГДА ВТ_Финал.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	        |			ТОГДА 1
	        |		ИНАЧЕ 0
	        |	КОНЕЦ КАК ВладелецКвартиры
	        |ИЗ
	        |	ВТ_Финал КАК ВТ_Финал";
	
	Возврат Текст

КонецФункции // ТекстЗапросаПроживающиеГорГаз()

Функция АдресПоЛСМассив(ЛС, Здание)
	
	Результат = Новый Массив;
	
	Адрес = "";
	НомерКвартиры = "";
	
	Если ЗначениеЗаполнено(Здание.Улица.ТипУлицы) Тогда
		Адрес = Адрес + Строка(Здание.Улица.ТипУлицы)
	КонецЕсли;

	Если ЗначениеЗаполнено(Здание.Улица) Тогда
		Адрес = Адрес + Строка(Здание.Улица) + ", "
	КонецЕсли;
	
	Адрес = Адрес + "д." + Строка(Здание.НомерДома);
	
	Если ЗначениеЗаполнено(Здание.ПрефиксДома) Тогда
		Адрес = Адрес + Здание.ПрефиксДома 	
	КонецЕсли;

	Если ЗначениеЗаполнено(Здание.Корпус) Тогда
		Адрес = Адрес + "кор. " + Здание.Корпус 	
	КонецЕсли;
	
	Результат.Добавить(Адрес);
	
	НомерКвартиры = ЛС.Квартира.Наименование;
	
	НомерПозиции = СтрНайти(НомерКвартиры, "=");
	
	Если НомерПозиции <> 0 Тогда
		НомерКвартиры = Лев(НомерКвартиры, НомерПозиции - 1)
	КонецЕсли;
	
	Результат.Добавить(НомерКвартиры);
	
	Возврат Результат;

КонецФункции // АдресПоЛС()

Функция ФИО(Проживающий)
	
	Структура = Новый Структура;
	Структура.Вставить("Фамилия", "");
	Структура.Вставить("Имя", "");
	Структура.Вставить("Отчество", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ФИОПроживающихСрезПоследних.Фамилия КАК Фамилия,
	               |	бит_ФИОПроживающихСрезПоследних.Имя КАК Имя,
	               |	бит_ФИОПроживающихСрезПоследних.Отчество КАК Отчество
	               |ИЗ
	               |	РегистрСведений.бит_ФИОПроживающих.СрезПоследних КАК бит_ФИОПроживающихСрезПоследних
	               |ГДЕ
	               |	бит_ФИОПроживающихСрезПоследних.ФизЛицо = &ФизЛицо";
	
	Запрос.УстановитьПараметр("ФизЛицо", Проживающий);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		ЗаполнитьЗначенияСвойств(Структура, Выборка);
	КонецЕсли;
	
	Возврат Структура;

КонецФункции

Функция Дробь(Число)
	
	Знаменатель = 10000;
	Числитель = Число * 10000;
	
	Пока Истина Цикл
		
		Попытка
			ЗнаменательВр = Знаменатель/5;
			ЧислительВр = Числитель/5;
		Исключение
			ЗнаменательВр = 0.1;
			ЧислительВр = 0.1;
		КонецПопытки;
		
		ЦелоеЗн = ЗнаменательВр - Цел(ЗнаменательВр);
		ЦелоеЧис = ЧислительВр - Цел(ЧислительВр);
		
		Если ЦелоеЗн = 0  И ЦелоеЧис = 0 Тогда
			
			Знаменатель = ЗнаменательВр;
			Числитель = ЧислительВр;
			Продолжить
			
		КонецЕсли;
		
		
		Попытка
			ЗнаменательВр = Знаменатель/2;
			ЧислительВр = Числитель/2;
		Исключение
			ЗнаменательВр = 0.1;
			ЧислительВр = 0.1;
		КонецПопытки;
		
		ЦелоеЗн = ЗнаменательВр - Цел(ЗнаменательВр);
		ЦелоеЧис = ЧислительВр - Цел(ЧислительВр);
		
		Если ЦелоеЗн = 0  И ЦелоеЧис = 0 Тогда
			
			Знаменатель = ЗнаменательВр;
			Числитель = ЧислительВр;
			Продолжить
			
		КонецЕсли;
		
		Прервать;
			
	КонецЦикла;
	
	
	Результат = Строка(Числитель) + "/" + Строка(Знаменатель);
	
	Возврат Результат;	

КонецФункции 

