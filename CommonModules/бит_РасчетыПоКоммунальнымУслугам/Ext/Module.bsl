	|		ПО ТаблицаСведенийПоЛС.ЛицевойСчет = Обороты.ЛицевойСчет
	|			И ТаблицаСведенийПоЛС.Услуга = Обороты.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ СальдоНаКонец КАК СальдоНаКонец
	|		ПО ТаблицаСведенийПоЛС.ЛицевойСчет = СальдоНаКонец.ЛицевойСчет
	|			И ТаблицаСведенийПоЛС.Услуга = СальдоНаКонец.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТекСальдо КАК ТекСальдо
	|		ПО ТаблицаСведенийПоЛС.ЛицевойСчет = ТекСальдо.ЛицевойСчет
	|			И ТаблицаСведенийПоЛС.Услуга = ТекСальдо.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТекСальдоПени КАК ТекСальдоПени
	|		ПО ТаблицаСведенийПоЛС.ЛицевойСчет = ТекСальдоПени.ЛицевойСчет
	|			И ТаблицаСведенийПоЛС.Услуга = ТекСальдоПени.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ бит_СтавкиНаУслугиСрезПоследнихПоОС КАК бит_СтавкиНаУслугиСрезПоследнихПоОС
	|		ПО ТаблицаСведенийПоЛС.Услуга = бит_СтавкиНаУслугиСрезПоследнихПоОС.Услуга
	|			И ТаблицаСведенийПоЛС.Поставщик = бит_СтавкиНаУслугиСрезПоследнихПоОС.Поставщик
	|			И ТаблицаСведенийПоЛС.РежимПотребления = бит_СтавкиНаУслугиСрезПоследнихПоОС.РежимПотребления
	|			И ТаблицаСведенийПоЛС.ОсновнойСпособРасчета = бит_СтавкиНаУслугиСрезПоследнихПоОС.СпособРасчета
	|			И ТаблицаСведенийПоЛС.СтатусКвартиры = бит_СтавкиНаУслугиСрезПоследнихПоОС.СтатусКвартиры
	|			И ТаблицаСведенийПоЛС.ТипКвартиры = бит_СтавкиНаУслугиСрезПоследнихПоОС.ТипКвартиры
	|		ЛЕВОЕ СОЕДИНЕНИЕ бит_СтавкиНаУслугиСрезПоследнихПлановая КАК бит_СтавкиНаУслугиСрезПоследнихПлановая
	|		ПО ТаблицаСведенийПоЛС.Услуга = бит_СтавкиНаУслугиСрезПоследнихПлановая.Услуга
	|			И ТаблицаСведенийПоЛС.Поставщик = бит_СтавкиНаУслугиСрезПоследнихПлановая.Поставщик
	|			И ТаблицаСведенийПоЛС.ОсновнойРежимПотребления = бит_СтавкиНаУслугиСрезПоследнихПлановая.РежимПотребления
	|			И ТаблицаСведенийПоЛС.СпособРасчета = бит_СтавкиНаУслугиСрезПоследнихПлановая.СпособРасчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ бит_СтавкиНаУслугиГрупСИнд КАК бит_СтавкиНаУслугиГрупСИнд
	|		ПО ТаблицаСведенийПоЛС.Услуга = бит_СтавкиНаУслугиГрупСИнд.Услуга
	|			И ТаблицаСведенийПоЛС.Поставщик = бит_СтавкиНаУслугиГрупСИнд.Поставщик
	|			И ТаблицаСведенийПоЛС.ОсновнойРежимПотребления = бит_СтавкиНаУслугиГрупСИнд.РежимПотребления
	|		ЛЕВОЕ СОЕДИНЕНИЕ бит_СведенияОРазмереПредельногоИндексаПоГруппеУслугСрезПоследних КАК бит_СведенияОРазмереПредельногоИндексаПоГруппеУслугСрезПоследних
	|		ПО ТаблицаСведенийПоЛС.Услуга = бит_СведенияОРазмереПредельногоИндексаПоГруппеУслугСрезПоследних.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ Объемы КАК Объемы
	|		ПО ТаблицаСведенийПоЛС.ЛицевойСчет = Объемы.ЛицевойСчет
	|			И ТаблицаСведенийПоЛС.Услуга = Объемы.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.Номенклатура КАК ВТ_Номенклатура
	|		ПО ТаблицаСведенийПоЛС.Номенклатура  = ВТ_Номенклатура.Ссылка";

	ТаблицаНорм = СформироватьТаблицуНорм();
	Результат = Запрос.Выполнить();
	Выборка   = Результат.Выбрать();
	Пока Выборка.Следующий() Цикл
		
