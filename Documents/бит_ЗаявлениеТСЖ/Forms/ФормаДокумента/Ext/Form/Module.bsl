&НаСервереБезКонтекста
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокТСЖ(Период, Организация)
	
	СписокТСЖ = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , КонецДня(Период));
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ИнформацияТСЖСрезПоследних.ТСЖ
	|ИЗ
	|	РегистрСведений.бит_ИнформацияТСЖ.СрезПоследних(&Период, ) КАК бит_ИнформацияТСЖСрезПоследних
	|ГДЕ
	|	(бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия > &Период)
	|	И бит_ИнформацияТСЖСрезПоследних.Здание.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ИнформацияТСЖСрезПоследних.ТСЖ";
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Таблица = Результат.Выгрузить();
		СписокТСЖ.ЗагрузитьЗначения(Таблица.ВыгрузитьКолонку("ТСЖ"));
		
	КонецЕсли; 
	
	Возврат СписокТСЖ;
	
КонецФункции // ()

&НаСервереБезКонтекста
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокЗданийВТСЖ(Период, ТСЖ, Организация)
	
	СписокЗданий = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , КонецДня(Период));
	Запрос.УстановитьПараметр("ТСЖ"        , ТСЖ);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ИнформацияТСЖСрезПоследних.Здание
	|ИЗ
	|	РегистрСведений.бит_ИнформацияТСЖ.СрезПоследних(&Период, ТСЖ = &ТСЖ) КАК бит_ИнформацияТСЖСрезПоследних
	|ГДЕ
	|	(бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия > &Период)
	|	И бит_ИнформацияТСЖСрезПоследних.Здание.Организация = &Организация
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ИнформацияТСЖСрезПоследних.Здание";
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Таблица = Результат.Выгрузить();
		СписокЗданий.ЗагрузитьЗначения(Таблица.ВыгрузитьКолонку("Здание"));
		
	КонецЕсли;
	
	Возврат СписокЗданий;
	
КонецФункции // ()

&НаСервереБезКонтекста
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокВладельцев(Период, ЛицевойСчет, ТСЖ, ВидОперации)
	
	СписокВладельцев = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , КонецДня(Период));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("ТСЖ"        , ТСЖ);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЧленыТСЖСрезПоследних.ЛицевойСчет,
	|	бит_ЧленыТСЖСрезПоследних.ФизЛицо
	|ПОМЕСТИТЬ ЧленыТСЖ
	|ИЗ
	|	РегистрСведений.бит_ЧленыТСЖ.СрезПоследних(
	|			&Период,
	|			ТСЖ = &ТСЖ
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ЧленыТСЖСрезПоследних
	|ГДЕ
	|	(бит_ЧленыТСЖСрезПоследних.ДатаВыхода = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ЧленыТСЖСрезПоследних.ДатаВыхода > &Период)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Проживающие.ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Период,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И НЕ ФизЛицо В
	|						(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|							Таб.ФизЛицо
	|						ИЗ
	|							ЧленыТСЖ КАК Таб)) КАК Проживающие
	|ГДЕ
	|	Проживающие.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.данет.да)
	|	И (Проживающие.ДатаСнятияСРегистрации > &Период
	|			ИЛИ Проживающие.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|
	|СГРУППИРОВАТЬ ПО
	|	Проживающие.ФизЛицо";
	
	Если НЕ ВидОперации = Перечисления.бит_ВидыОперацииЗаявлениеТСЖ.ВступлениеВТСЖ Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "НЕ ФизЛицо В", "ФизЛицо В");
	КонецЕсли; 
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Таблица = Результат.Выгрузить();
		СписокВладельцев.ЗагрузитьЗначения(Таблица.ВыгрузитьКолонку("ФизЛицо"));
		
	КонецЕсли;
	
	Возврат СписокВладельцев;
	
КонецФункции // ()

&НаСервереБезКонтекста
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ПолучитьИнформациюОЧленеТСЖ(Период, ТСЖ, ЛицевойСчет, Проживающий)
	
	ИнформацияОЧленеТСЖ = Новый Структура;
	ИнформацияОЧленеТСЖ.Вставить("ДатаВступления", Дата("00010101"));
	ИнформацияОЧленеТСЖ.Вставить("ДатаВыхода"    , ТекущаяДата());
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"     , КонецДня(Период));
	Запрос.УстановитьПараметр("ТСЖ"        , ТСЖ);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Проживающий", Проживающий);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЧленыТСЖ.ДатаВступления,
	|	ЧленыТСЖ.ДатаВыхода
	|ИЗ
	|	РегистрСведений.бит_ЧленыТСЖ.СрезПоследних(
	|			&Период,
	|			ТСЖ = &ТСЖ
	|				И ЛицевойСчет = &ЛицевойСчет
	|				И ФизЛицо = &Проживающий) КАК ЧленыТСЖ
	|ГДЕ
	|	(ЧленыТСЖ.ДатаВыхода > &Период
	|			ИЛИ ЧленыТСЖ.ДатаВыхода = ДАТАВРЕМЯ(1, 1, 1))";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ИнформацияОЧленеТСЖ.ДатаВступления = Выборка.ДатаВступления; 
		ИнформацияОЧленеТСЖ.ДатаВыхода     = Выборка.ДатаВыхода;
		
	КонецЕсли;
	
	Возврат ИнформацияОЧленеТСЖ;
	
КонецФункции // () 

