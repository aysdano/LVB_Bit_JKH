&НаСервере
 Процедура ТестЖильцыУбратьДругиеЛСНаСервере()
	 // Вставить содержимое обработчика.
	 Набор = РегистрыСведений.лб_Тест_Жильцы.СоздатьНаборЗаписей();
	 Набор.Прочитать();
	
	 Для каждого Запись из Набор цикл 
		 ЭтоДругойЛС = неопределено;
		 СтепеньРО = Запись.RODOTN;
		 Если СтрНайти(нрег(СтепеньРО),"др") = 0 тогда
			 ЭтоДругойЛС = ложь
		 ИначеЕсли СтрНайти(нрег(СтепеньРО),"сч") = 0 
			 		и СтрНайти(нрег(СтепеньРО),"л/с")=0 
					и СтрНайти(нрег(СтепеньРО),"л.с") = 0 
		 тогда	 
			 ЭтоДругойЛС = ложь
		 иначе
			 ЭтоДругойЛС = истина;
		 КонецЕсли;	 
		 
		 Если Запись.Игнорировать<>ЭтоДругойЛС тогда
			 Запись.Игнорировать = ЭтоДругойЛС
 		 КонецЕсли;	 	 
	 КонецЦикла;
	 
	 Если Набор.Модифицированность() тогда
		 Набор.Записать(истина)
	 КонецЕсли;	 
		 
 КонецПроцедуры

&НаСервере
 Процедура Тест_ПодобратьОтветственныхЛСНаСервере()
	 // Вставить содержимое обработчика.
	 Набор = РегистрыСведений.лб_Тест_ЛС.СоздатьНаборЗаписей();
	 Набор.Прочитать();
	 
	 Запрос = новый запрос;
	 Запрос.Текст = 
	 	 "ВЫБРАТЬ
	 	 |	лб_Тест_Жильцы.ЛС КАК ЛС,
	 	 |	лб_Тест_Жильцы.Жилец КАК Жилец,
	 	 |	лб_Тест_Жильцы.Жилец.Наименование КАК ФИО,
	 	 |	лб_Тест_Жильцы.ДатаРождения КАК ДатаРождения
	 	 |ИЗ
	 	 |	РегистрСведений.лб_Тест_Жильцы КАК лб_Тест_Жильцы";
	 Табл = Запрос.Выполнить().Выгрузить();
	 Табл.Индексы.Добавить("ЛС,ФИО");
	 Табл.Индексы.Добавить("ФИО");
	 
	 	 
	 
	 
	 ЧислоСтрок = Набор.Количество();
	 Для Инд=0 по ЧислоСтрок-1 цикл	
		  
		 Запись = Набор[Инд];
		 СтрокаОтв = СокрЛП(Запись.OTV);
		 
		 Если ЗначениеЗаполнено(Запись.Ответственный) тогда
			 продолжить
		 КонецЕсли;	 
		 
		 Если СтрНайти("0123456789?",лев(СтрокаОтв,1))=0 тогда
			 Отбор = новый структура("ЛС,ФИО",Запись.ЛС,СтрокаОтв);		
			 Строки = Табл.НайтиСтроки(Отбор);
			 Если Строки.Количество()>0 тогда
				 Ответственный = Строки[0].Жилец;
			 КонецЕсли;
		 КонецЕсли;
		 
		 Если Не ЗначениеЗаполнено(Ответственный) тогда
			 Ответственный = Справочники.бит_Проживающие.НайтиПоНаименованию(СтрокаОтв,"ФИО");
		 КонецЕсли;	 
			 
		 
		 Если Запись.Ответственный <>Ответственный тогда
			 Запись.Ответственный = Ответственный;
		 КонецЕсли;
		 
		 
	 КонецЦикла;	 
	 
