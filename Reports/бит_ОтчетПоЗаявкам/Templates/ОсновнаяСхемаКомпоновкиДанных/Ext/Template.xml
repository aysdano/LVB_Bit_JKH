				</v8:NumberQualifiers>
			</valueType>
		</field>
		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ РАЗЛИЧНЫЕ
	бит_ЗаявкаНаВыполнениеРабот.Ссылка КАК Заявка,
	ВЫБОР
		КОГДА бит_ЗаявкаНаВыполнениеРабот.Ссылка.СтатусВыполнения = ЗНАЧЕНИЕ(Справочник.бит_СтатусыВыполнения.Выполнено)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ КАК ВыполненыхЗаявок,
	1 КАК ВсегоЗаявокВОтчете
ИЗ
	Документ.бит_ЗаявкаНаВыполнениеРабот КАК бит_ЗаявкаНаВыполнениеРабот

СГРУППИРОВАТЬ ПО
	бит_ЗаявкаНаВыполнениеРабот.Ссылка,
	ВЫБОР
		КОГДА бит_ЗаявкаНаВыполнениеРабот.Ссылка.СтатусВыполнения = ЗНАЧЕНИЕ(Справочник.бит_СтатусыВыполнения.Выполнено)
			ТОГДА 1
		ИНАЧЕ 0
	КОНЕЦ</query>
