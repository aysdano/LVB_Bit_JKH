&НаСервере
// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция СкопироватьЛицевойСчетНаСервере()
	
	Результат = Новый Структура;
	Результат.Вставить("НетОшибок"  , Истина);
	Результат.Вставить("ТекстОшибки", "");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Наименование = &Наименование";
	Запрос.УстановитьПараметр("Наименование",Объект.НаименованиеЛицевогоСчета);
	
	Если Не Запрос.Выполнить().Пустой() тогда
		Результат.НетОшибок   = Ложь;
		Результат.ТекстОшибки = "Введенный лицевой счет уже существует.";
		Возврат Результат;
	КонецЕсли;
	
	НовыйЛС = Справочники.бит_ЛицевыеСчета.СоздатьЭлемент();
	
	СписокИсключений = "Родитель,Владелец";
	ЗаполнитьЗначенияСвойств(НовыйЛС, Объект.ЛицевойСчет,,СписокИсключений);
	
	НовыйЛС.УстановитьНовыйКод();
	НовыйЛС.Наименование       = Объект.НаименованиеЛицевогоСчета;
	НовыйЛС.Идентификатор      = 0;
	НовыйЛС.УлицаЛицевогоСчета = Объект.Улица;
	НовыйЛС.Здание             = Объект.Здание;
	НовыйЛС.Квартира           = Объект.Квартира;
	
	Попытка
		НовыйЛС.Записать();
		Объект.НовыйЛицевойСчет = НовыйЛС.Ссылка;
	Исключение
		Результат.НетОшибок   = Ложь;
		Результат.ТекстОшибки = ОписаниеОшибки();
		Возврат Результат;
	КонецПопытки; 
	
	Если ИзменитьСведенияОКвартире Тогда
		
		НоваяЗаписьСВ = РегистрыСведений.бит_СведенияОКвартире.СоздатьМенеджерЗаписи();
		НоваяЗаписьСВ.Период   = НачалоМесяца(Объект.ДатаЗаведения);
		НоваяЗаписьСВ.Квартира = Объект.Квартира;
		НоваяЗаписьСВ.Прочитать();
		
		ЗаполнитьЗначенияСвойств(НоваяЗаписьСВ, Объект);
		
		Попытка
			НоваяЗаписьСВ.Записать();
		Исключение
			Результат.НетОшибок   = Ложь;
			Результат.ТекстОшибки = ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки;
		
	КонецЕсли; 
	
	Если Объект.Услуги.Количество() > 0 Тогда
		
		ДокументУслуги = Документы.бит_УстановкаИзменениеУслугПоЛС.СоздатьДокумент();
		
		бит_ОбщегоНазначения.ЗаполнитьШапкуДокумента(ДокументУслуги

		,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
		
		ДокументУслуги.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет;
		ДокументУслуги.Дата        = Объект.ДатаЗаведения;
		ДокументУслуги.ЛицевойСчет = Объект.НовыйЛицевойСчет;
		ДокументУслуги.Улица       = Объект.Улица;
		ДокументУслуги.Здание      = Объект.Здание;
		ДокументУслуги.Комментарий = "Документ создан автоматически из обработки ""Копирование лицевого счета"".";
		
		Для каждого СтрокаТаблицы Из Объект.Услуги Цикл
			
			НоваяСтрока = ДокументУслуги.ЛицевыеСчета.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
		КонецЦикла; 
		
		Попытка
			ДокументУслуги.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Результат.НетОшибок   = Ложь;
			Результат.ТекстОшибки = ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки; 
		
	КонецЕсли;
	
	Если Объект.Проживающие.Количество() > 0 Тогда
		
		ДокументПроживающие = Документы.бит_РегистрацияПроживающихПоЛС.СоздатьДокумент();
		
		бит_ОбщегоНазначения.ЗаполнитьШапкуДокумента(ДокументПроживающие

		,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
		
		ДокументПроживающие.Дата        = Объект.ДатаЗаведения;
		ДокументПроживающие.ЛицевойСчет = Объект.НовыйЛицевойСчет;
		ДокументПроживающие.Комментарий = "Документ создан автоматически из обработки ""Копирование лицевого счета"".";
		
		Для каждого СтрокаТаблицы Из Объект.Проживающие Цикл
			
			НоваяСтрока = ДокументПроживающие.СписокПроживающих.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
		КонецЦикла; 
		
		Попытка
			ДокументПроживающие.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Результат.НетОшибок   = Ложь;
			Результат.ТекстОшибки = ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки; 
		
	КонецЕсли;
	
	Если ОтключитьУслуги Тогда
		
		ДокументУслугиУдаление = Документы.бит_УстановкаИзменениеУслугПоЛС.СоздатьДокумент();
		
		бит_ОбщегоНазначения.ЗаполнитьШапкуДокумента(ДокументУслугиУдаление
		
		,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
		
		ДокументУслугиУдаление.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет;
		ДокументУслугиУдаление.Дата        = Объект.ДатаЗаведения;
		ДокументУслугиУдаление.ЛицевойСчет = Объект.ЛицевойСчет;
		ДокументУслугиУдаление.Улица       = Объект.ЛицевойСчет.УлицаЛицевогоСчета;
		ДокументУслугиУдаление.Здание      = Объект.ЛицевойСчет.Здание;
		ДокументУслугиУдаление.Комментарий = "Документ создан автоматически из обработки ""Копирование лицевого счета"".";
		
		ДокументУслугиУдаление.ЗаполнитьПоследнимиЗначениями();
		
		Для каждого СтрокаТаблицы Из ДокументУслугиУдаление.ЛицевыеСчета Цикл
			СтрокаТаблицы.РежимПотребления = Справочники.бит_РежимыПотребленияУслуг.Нет;
		КонецЦикла; 
		
		Попытка
			ДокументУслугиУдаление.Записать(РежимЗаписиДокумента.Проведение);
		Исключение
			Результат.НетОшибок   = Ложь;
			Результат.ТекстОшибки = ОписаниеОшибки();
			Возврат Результат;
		КонецПопытки; 
		
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции // () 

&НаСервере
// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура КвартираПриИзмененииНаСервере()
	
	Если Не ИзменитьСведенияОКвартире Тогда
		Обработки.бит_КопированиеЛицевогоСчета.ЗаполнитьСведенияОКвартире(Объект, Объект.Квартира);
	КонецЕсли;
	
	// Проверка наличия других ЛС по адресу.
	СообщениеАдрес = ПроверитьНаличиеЛСПоАдресу(Объект.ЛицевойСчет, Объект.Квартира);
	
КонецПроцедуры // ()

&НаСервереБезКонтекста
// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ПроверитьНаличиеЛСПоАдресу(ЛицевойСчет, Квартира)
	
	Сообщение = "";
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Квартира"   , Квартира);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Наименование
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Квартира = &Квартира
	|	И бит_ЛицевыеСчета.Ссылка <> &ЛицевойСчет";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Текст = "По данному адресу найдены лицевые счета: ";
	
	Пока Выборка.Следующий() Цикл
		Сообщение = Сообщение + Выборка.Наименование + " ";
	КонецЦикла;
	
	Если НЕ ПустаяСтрока(Сообщение) Тогда
		Сообщение = Текст + Сообщение; 
	КонецЕсли; 
	
	Возврат Сообщение;
	
КонецФункции // ПроверитьНаличиеЛСПоАдресу()

&НаСервере
// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЛицевойСчетПриИзмененииНаСервере()
	
	Обработки.бит_КопированиеЛицевогоСчета.ЗаполнитьОбъект(Объект, Объект.ЛицевойСчет, Истина, Истина);
	
	СообщениеАдрес = ПроверитьНаличиеЛСПоАдресу(Объект.ЛицевойСчет, Объект.Квартира);
	
КонецПроцедуры // () 

#КонецОбласти