// Процедура выполняет заполнение реквизита организация документа ВводПоказанийПоСчетчикам.
//
Процедура ЗаполнитьШапкуВводаПоказаний() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ВводПоказанийПоСчетчикам.Ссылка
	|ИЗ
	|	Документ.бит_ВводПоказанийПоСчетчикам КАК бит_ВводПоказанийПоСчетчикам
	|ГДЕ
	|	(НЕ бит_ВводПоказанийПоСчетчикам.ПометкаУдаления)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		Модиф = Ложь;
		Если НЕ ЗначениеЗаполнено(Выборка.Ссылка.Организация) Тогда
			
			ДокОбъект.Организация = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");
			Модиф = Истина;
			
		КонецЕсли; 
		
		Если НЕ ЗначениеЗаполнено(Выборка.Ссылка.ВидОперации) Тогда
			
			ДокОбъект.ВидОперации = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ВводПоказаний;
			Модиф = Истина;
			
		КонецЕсли; 
		
		Если Модиф Тогда
			
			Попытка
				
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				
			Исключение
				
			КонецПопытки; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

// Процедура выполняет заполнение предопределенне элементы справочника "Услуги ЖКХ".
//
Процедура ЗаполнитьПредопределенныеУслуги()
	
	СсылкаУслуга = Справочники.бит_УслугиЖКХ.Пеня;
	
	Если СсылкаУслуга <> Неопределено Тогда
		
		Услуга = СсылкаУслуга.ПолучитьОбъект();
		
		Услуга.НаименованиеПолное       = Услуга.Наименование;
		Услуга.ТипУслуги                = Перечисления.бит_ТипыУслуг.Внутренняя;
		Услуга.ОсновнойРежимПотребления = Справочники.бит_РежимыПотребленияУслуг.Нет;
		Услуга.ОсновнойСпособРасчета    = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления;
		
		Услуга.Приоритет = 9999999999;
		
		Попытка
			
			Услуга.Записать();
			
		Исключение
			
		КонецПопытки;
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура выполняет очистку регстров от записей не проведенных документов.
//
Процедура УдалитьДвиженияНеПроведенныхДокументов() Экспорт
	
	НачатьТранзакцию();
	
	Отмена = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПодключениеУслугКЗданиям.Ссылка
	|ИЗ
	|	Документ.бит_ПодключениеУслугКЗданиям КАК бит_ПодключениеУслугКЗданиям
	|ГДЕ
	|	(НЕ бит_ПодключениеУслугКЗданиям.Проведен )
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	бит_УстановкаИзменениеУслугПоЛС.Ссылка
	|ИЗ
	|	Документ.бит_УстановкаИзменениеУслугПоЛС КАК бит_УстановкаИзменениеУслугПоЛС
	|ГДЕ
	|	(НЕ бит_УстановкаИзменениеУслугПоЛС.Проведен)
	|
	|ОБЪЕДИНИТЬ ВСЕ
	|
	|ВЫБРАТЬ
	|	бит_УстановкаСтавокПоУслугам.Ссылка
	|ИЗ
	|	Документ.бит_УстановкаСтавокПоУслугам КАК бит_УстановкаСтавокПоУслугам
	|ГДЕ
	|	(НЕ бит_УстановкаСтавокПоУслугам.Проведен)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Для каждого Движение Из ДокОбъект.Движения  Цикл
			
			ИмяРегистра = Строка(Движение);
			ИмяРегистра = Прав(ИмяРегистра, СтрДлина(ИмяРегистра) - Найти(ИмяРегистра,"."));
			
			НаборЗаписей = РегистрыСведений[ИмяРегистра].СоздатьНаборЗаписей();
			Регистратор = НаборЗаписей.Отбор.Регистратор;
			
			Регистратор.Значение      = Выборка.ссылка;
			Регистратор.ВидСравнения  = ВидСравнения.Равно;
			Регистратор.Использование = Истина;
			
			НаборЗаписей.Прочитать();
			
			НаборЗаписей.Очистить();
			
			Попытка
				
				НаборЗаписей.Записать();
				
			Исключение
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
				
				Отмена = Истина;
				
			КонецПопытки; 
			
		КонецЦикла;  
		
	КонецЦикла; 
	
	Если Отмена Тогда
		
		ОтменитьТранзакцию();
		
	Иначе
		
		Заголовок = "Удаление движений непроведенных документов  ""Подключение услуг к зданиям"",""Установка изменение услуг по ЛС"", ""Установка ставок по услугам"" - ";
		ТекстСообщения = НСтр("ru = '%1 выполнено.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Заголовок);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ЗаписьЖурналаРегистрации("ИнформационнаяБаза.ОбновлениеИБ", УровеньЖурналаРегистрации.Информация, , , "Выполнено " + Заголовок);
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
КонецПроцедуры

// Перенос записей из регистра сведений бит_КолЕдПоСчетчикам.
// В регистр накопления бит_КолЕдиницПоСчетчикам.
Процедура ПереносЗаписейКолЕдПоСчетчикам() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_КолЕдПоСчетчикам.Период,
	|	бит_КолЕдПоСчетчикам.Регистратор КАК Регистратор,
	|	бит_КолЕдПоСчетчикам.НомерСтроки,
	|	бит_КолЕдПоСчетчикам.Активность,
	|	бит_КолЕдПоСчетчикам.ЛицевойСчет,
	|	бит_КолЕдПоСчетчикам.УслугаЖКХ,
	|	бит_КолЕдПоСчетчикам.Счетчик,
	|	бит_КолЕдПоСчетчикам.КоличествоЕдиницПоЛС
	|ИЗ
	|	РегистрСведений.бит_КолЕдПоСчетчикам КАК бит_КолЕдПоСчетчикам
	|ИТОГИ ПО
	|	Регистратор";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаПоРегистратору = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаПоРегистратору.Следующий() Цикл
		
		НаборЗаписей = РегистрыНакопления.бит_КолЕдиницПоСчетчикам.СоздатьНаборЗаписей();
		
		НаборЗаписей.Отбор.Регистратор.Установить(ВыборкаПоРегистратору.Регистратор,Истина);
		
		НаборЗаписей.Прочитать();
		НаборЗаписей.Очистить();
		
		ВыборкаДетальныеЗаписи = ВыборкаПоРегистратору.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			НоваяЗапись = НаборЗаписей.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяЗапись, ВыборкаДетальныеЗаписи);
			
		КонецЦикла; 
		
		Попытка
			
			НаборЗаписей.Записать();
			
		Исключение
			
		КонецПопытки; 
		
	КонецЦикла; 
	
КонецПроцедуры 

// Процедура выполняет перенос записей регистра льгот по лс.
//
Процедура ПереносЗаписейЛьгот()Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ЛьготыПоЛС.Регистратор
	|ИЗ
	|	РегистрСведений.бит_УдалитьЛьготыПоЛС КАК ЛьготыПоЛС";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий()  Цикл
		
		НаборЗап = РегистрыСведений.бит_УдалитьЛьготыПоЛС.СоздатьНаборЗаписей();
		НаборЗап.Отбор.Регистратор.Установить(Выборка.Регистратор, Истина);
		НаборЗап.Прочитать();
		
		Таб = НаборЗап.Выгрузить();
		
		НовыйНабор = РегистрыСведений.бит_ЛьготыПоЛС.СоздатьНаборЗаписей();
		НовыйНабор.Отбор.Регистратор.Установить(Выборка.Регистратор, Истина);
		НовыйНабор.Прочитать();                                
		
		НовыйНабор.Загрузить(Таб);
		
		Попытка
			
			НовыйНабор.Записать();
			
		Исключение
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура выполняет заполнение новых реквизитов в документах начисления.
//
Процедура ЗаполнениеДокументовНачислений() Экспорт
	
	НачатьТранзакцию();
	
	Отмена = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачислениеПоЛицевымСчетам.Ссылка
	|ИЗ
	|	Документ.бит_НачислениеПоЛицевымСчетам КАК бит_НачислениеПоЛицевымСчетам
	|ГДЕ
	|	бит_НачислениеПоЛицевымСчетам.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеПоЛицевымСчетам.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстСообщения = НСтр("ru = 'Выполнение операции ""Выполннить обработку документов начислений."": '");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Модиф = Ложь;
		
		Для каждого Строка Из ДокОбъект.ЛицевыеСчета Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.Начислено) Тогда
				
				Модиф = Истина;
				Строка.Начислено = Строка.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			Если Модиф Тогда
				
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				
			КонецЕсли; 
			
		Исключение
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			
			Отмена = Истина;
			
		КонецПопытки; 
		
	КонецЦикла; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоСчетчикам.Ссылка
	|ИЗ
	|	Документ.бит_НачисленияПоСчетчикам КАК бит_НачисленияПоСчетчикам
	|ГДЕ
	|	бит_НачисленияПоСчетчикам.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоСчетчикам.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Модиф = Ложь;
		
		Для каждого Строка Из ДокОбъект.Начисления Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.Начислено) Тогда
				
				Модиф = Истина;
				Строка.Начислено = Строка.Начисления;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Строка.КоличествоЕдиниц) Тогда
				
				Модиф = Истина;
				Строка.КоличествоЕдиниц = Строка.КоличествоЕдиницПоСчетчику
				
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(Строка.Ставка) Тогда
				
				Модиф = Истина;
				Строка.Ставка = Строка.СтавкаПоСчетчику;
				
				Если НЕ ЗначениеЗаполнено(Строка.Ставка) Тогда
					
					ЗапросСтавка = Новый Запрос;
					ЗапросСтавка.Текст = 
					"ВЫБРАТЬ
					|	ИнфОКв.ЛицевойСчет,
					|	ИнфОКв.Услуга,
					|	ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0) КАК Ставка
					|ИЗ
					|	(ВЫБРАТЬ
					|		бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
					|		бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
					|		бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
					|		бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
					|		бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления,
					|		бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик,
					|		бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета
					|	ИЗ
					|		РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
					|				&Дата,
					|				ЛицевойСчет = &ЛицевойСчет
					|					И Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
					|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних
					|			ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира) КАК ИнфОКв
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&Дата, ) КАК бит_СтавкиНаУслугиСрезПоследних
					|		ПО ИнфОКв.Услуга = бит_СтавкиНаУслугиСрезПоследних.Услуга
					|			И ИнфОКв.ТипКвартиры = бит_СтавкиНаУслугиСрезПоследних.ТипКвартиры
					|			И ИнфОКв.СтатусКвартиры = бит_СтавкиНаУслугиСрезПоследних.СтатусКвартиры
					|			И ИнфОКв.РежимПотребления = бит_СтавкиНаУслугиСрезПоследних.РежимПотребления
					|			И ИнфОКв.Поставщик = бит_СтавкиНаУслугиСрезПоследних.Поставщик
					|			И ИнфОКв.СпособРасчета = бит_СтавкиНаУслугиСрезПоследних.СпособРасчета";
					ЗапросСтавка.УстановитьПараметр("Дата"       , КонецДня(ДокОбъект.Дата));
					ЗапросСтавка.УстановитьПараметр("Квартира"   , Строка.ЛицевойСчет.Квартира);
					ЗапросСтавка.УстановитьПараметр("ЛицевойСчет", Строка.ЛицевойСчет);
					ЗапросСтавка.УстановитьПараметр("Услуга"     , Строка.Услуга);
					
					ВыборкаСТ = ЗапросСтавка.Выполнить().Выбрать();
					
					Если ВыборкаСТ.Следующий() Тогда
						
						Строка.Ставка = ВыборкаСТ.Ставка;
						
					КонецЕсли; 
					
				КонецЕсли;
				
			КонецЕсли;
			
			
		КонецЦикла;
		
		Для каждого Строка Из ДокОбъект.Распределения Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.Начислено) Тогда
				
				Модиф = Истина;
				Строка.Начислено = Строка.Начисления;
				
			КонецЕсли;
			
			Если НЕ ЗначениеЗаполнено(Строка.КоличествоЕдиниц) Тогда
				
				Модиф = Истина;
				Строка.КоличествоЕдиниц = Строка.КоличествоЕдиницПоРаспределению
				
			КонецЕсли; 
			
			Если НЕ ЗначениеЗаполнено(Строка.Ставка) Тогда
				
				Модиф = Истина;
				Строка.Ставка = Строка.СтавкаПоРаспределению;
				
				Если НЕ ЗначениеЗаполнено(Строка.Ставка) Тогда
					
					ЗапросСтавка = Новый Запрос;
					ЗапросСтавка.Текст = 
					"ВЫБРАТЬ
					|	ИнфОКв.ЛицевойСчет,
					|	ИнфОКв.Услуга,
					|	ЕСТЬNULL(бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка, 0) КАК Ставка
					|ИЗ
					|	(ВЫБРАТЬ
					|		бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
					|		бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
					|		бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
					|		бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
					|		бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления,
					|		бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик,
					|		бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета
					|	ИЗ
					|		РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
					|				&Дата,
					|				ЛицевойСчет = &ЛицевойСчет
					|					И Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
					|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних
					|			ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира) КАК ИнфОКв
					|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&Дата, ) КАК бит_СтавкиНаУслугиСрезПоследних
					|		ПО ИнфОКв.Услуга = бит_СтавкиНаУслугиСрезПоследних.Услуга
					|			И ИнфОКв.ТипКвартиры = бит_СтавкиНаУслугиСрезПоследних.ТипКвартиры
					|			И ИнфОКв.СтатусКвартиры = бит_СтавкиНаУслугиСрезПоследних.СтатусКвартиры
					|			И ИнфОКв.РежимПотребления = бит_СтавкиНаУслугиСрезПоследних.РежимПотребления
					|			И ИнфОКв.Поставщик = бит_СтавкиНаУслугиСрезПоследних.Поставщик
					|			И ИнфОКв.СпособРасчета = бит_СтавкиНаУслугиСрезПоследних.СпособРасчета";
					ЗапросСтавка.УстановитьПараметр("Дата"       , КонецДня(ДокОбъект.Дата));
					ЗапросСтавка.УстановитьПараметр("Квартира"   , Строка.ЛицевойСчет.Квартира);
					ЗапросСтавка.УстановитьПараметр("ЛицевойСчет", Строка.ЛицевойСчет);
					ЗапросСтавка.УстановитьПараметр("Услуга"     , Строка.Услуга);
					
					ВыборкаСТ = ЗапросСтавка.Выполнить().Выбрать();
					
					Если ВыборкаСТ.Следующий() Тогда
						
						Строка.Ставка = ВыборкаСТ.Ставка;
						
					КонецЕсли; 
					
				КонецЕсли;
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			
			Если Модиф Тогда
				
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				
			КонецЕсли; 
			
		Исключение
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			
			Отмена = Истина;
			
		КонецПопытки;
		
	КонецЦикла; 
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачислениеЛьготПоЛицевымСчетам.Ссылка
	|ИЗ
	|	Документ.бит_НачислениеЛьготПоЛицевымСчетам КАК бит_НачислениеЛьготПоЛицевымСчетам
	|ГДЕ
	|	бит_НачислениеЛьготПоЛицевымСчетам.Проведен
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеЛьготПоЛицевымСчетам.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
		
		Модиф = Ложь;
		
		Для каждого Строка Из ДокОбъект.ЛицевыеСчета Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.Начислено) Тогда
				
				Модиф = Истина;
				Строка.Начислено = Строка.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Для каждого Строка Из ДокОбъект.СписокЛьгот Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.СуммаЛичной) Тогда
				
				Модиф = Истина;
				Строка.СуммаЛичной = Строка.Сумма;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			
			Если Модиф Тогда
				
				ДокОбъект.Записать(РежимЗаписиДокумента.Запись);
				
			КонецЕсли; 
			
		Исключение
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			Отмена = Истина;
			
		КонецПопытки;
		
	КонецЦикла; 
	
	Если Отмена Тогда
		
		ОтменитьТранзакцию();
		
	Иначе
		
		Заголовок = "Обработка документов начисления - ";
		ТекстСообщения = НСтр("ru = '%1 выполнено.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Заголовок);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ЗаписьЖурналаРегистрации("ИнформационнаяБаза.ОбновлениеИБ", УровеньЖурналаРегистрации.Информация, , ,  "Выполнено " + Заголовок);
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура выполняет заполнение владельца счетчика в табличной части начисления по счетчикам.
//
Процедура ИсправлениеДвиженийДокументаНачислений() Экспорт
	
	НачатьТранзакцию();
	Отмена = Ложь;
	
	ТекстСообщения = НСтр("ru = 'Выполнение операции ""Выполннить исправление и перепроведение документов ""Начисления по счетчикам"": '");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоСчетчикамНачисления.Ссылка
	|ИЗ
	|	Документ.бит_НачисленияПоСчетчикам.Начисления КАК бит_НачисленияПоСчетчикамНачисления
	|ГДЕ
	|	бит_НачисленияПоСчетчикамНачисления.ВладелецСчетчика = НЕОПРЕДЕЛЕНО
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоСчетчикамНачисления.Ссылка";
	
	Результат = Запрос.Выполнить().Выгрузить();
	Если Результат.Количество() = 0  Тогда
		
		ЗафиксироватьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Документов на исправление не найдено - выполнение обработки не требуется.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецЕсли; 
	
	Ответ = Результат.ВыбратьСтроку("Список документов подлежащих обработке.");
	
	Если Ответ = Неопределено Тогда
		
		ЗафиксироватьТранзакцию();
		ТекстСообщения = НСтр("ru = 'Выполнение обработки отменено пользователем.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецЕсли; 
	
	Для каждого Строка Из Результат Цикл
		
		ДокОбъект = Строка.Ссылка.ПолучитьОбъект();
		Модиф = Ложь;
		
		Для каждого Строка Из ДокОбъект.Начисления Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.ВладелецСчетчика) Тогда
				
				Модиф = Истина;
				
				Если Строка.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
					Строка.ВладелецСчетчика = ДокОбъект.Здание;
				ИначеЕсли Строка.Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный Тогда
					Строка.ВладелецСчетчика = Строка.ЛицевойСчет;
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Попытка
			
			Если Модиф Тогда
				
				ДокОбъект.Записать(РежимЗаписиДокумента.Проведение);
				
			КонецЕсли; 
			
		Исключение
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			Отмена = Истина;
			
		КонецПопытки; 
		
	КонецЦикла; 
	
	Если Отмена Тогда
		
		ОтменитьТранзакцию();
		
	Иначе
		
		Заголовок = "Перепроведение документов ""Начисления по счетчикам"" - ";
		
		ТекстСообщения = НСтр("ru = '%1 выполнено.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Заголовок);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ЗаписьЖурналаРегистрации("ИнформационнаяБаза.ОбновлениеИБ", УровеньЖурналаРегистрации.Информация, , ,  "Выполнено " + Заголовок);
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура выполняет заполнение документа "бит_ИзменениеДатыПоверки".
//
Процедура ЗаполнитьПоверкуСчетчиков() Экспорт
	
	НачатьТранзакцию();
	Отмена = Ложь;
	
	ТекстСообщения = НСтр("ru = 'Выполнение операции ""Выполннить установку даты поверки счетчиков"": '");
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект КАК ВладелецСчетчика,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.ДатаПоверки КАК НоваяДатаПоверки,
	|	бит_ПоверкаСчетчиковСрезПоследних.Счетчик КАК СчетчикВПоверке
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПоверкаСчетчиков.СрезПоследних(&Дата, ) КАК бит_ПоверкаСчетчиковСрезПоследних
	|		ПО бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = бит_ПоверкаСчетчиковСрезПоследних.Счетчик
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|	И бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.ДатаПоверки > &Дата
	|	И бит_ПоверкаСчетчиковСрезПоследних.Счетчик ЕСТЬ NULL ";
	
	Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДата()));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() = 0 Тогда
		
		ТекстСообщения = НСтр("ru = 'Счетчиков для установки даты поверки не найдено.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ОтменитьТранзакцию();
		Возврат;
		
	КонецЕсли; 
	
	НовыйДокумент = Документы.бит_ИзменениеДатыПоверки.СоздатьДокумент();
	НовыйДокумент.Дата = ТекущаяДата();
	НовыйДокумент.Организация = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");
	НовыйДокумент.Комментарий = "Документ создан автоматически при обновлении информационной базы.";
	
	НовыйДокумент.Счетчики.Загрузить(Результат);
	
	Попытка
		
		НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		
	Исключение
		
		Отмена = Истина
		
	КонецПопытки;
	
	Если Отмена Тогда
		
		ОтменитьТранзакцию();
		
	Иначе
		
		Заголовок = "Установка даты поверки на счетчики - ";
		
		ТекстСообщения = НСтр("ru = '%1 выполнено.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Заголовок);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		ЗаписьЖурналаРегистрации("ИнформационнаяБаза.ОбновлениеИБ", УровеньЖурналаРегистрации.Информация, , ,  "Выполнено " + Заголовок);
		
		ЗафиксироватьТранзакцию();
		
	КонецЕсли;
	
	Форма = НовыйДокумент.ПолучитьФорму();
	
	Форма.Открыть();
	
КонецПроцедуры

// Процедура заполняет префикс адреса.
//
Процедура ЗаполнениеПрефиксаАдреса()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НастройкаПараметровЖКХ.Организация,
	|	бит_НастройкаПараметровЖКХ.Период
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ КАК бит_НастройкаПараметровЖКХ
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НастройкаПараметровЖКХ.Организация,
	|	бит_НастройкаПараметровЖКХ.Период";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = РегистрыСведений.бит_НастройкаПараметровЖКХ.СоздатьМенеджерЗаписи();
		Запись.Организация = Выборка.Организация;
		Запись.Период      = Выборка.Период;
		
		Запись.Прочитать();
		
		Запись.ПрефиксДом      = ?(ЗначениеЗаполнено(Запись.ПрефиксДом)     ,Запись.ПрефиксДом      ,"д."   );
		Запись.ПрефиксКвартира = ?(ЗначениеЗаполнено(Запись.ПрефиксКвартира),Запись.ПрефиксКвартира ,"кв."  );
		Запись.ПрефиксКорпус   = ?(ЗначениеЗаполнено(Запись.ПрефиксКорпус)  ,Запись.ПрефиксКорпус   ,"корп.");
		Запись.ПрефиксУлица    = ?(ЗначениеЗаполнено(Запись.ПрефиксУлица)   ,Запись.ПрефиксУлица    ,"ул."  );
		Запись.ПрефиксРайон    = ?(ЗначениеЗаполнено(Запись.ПрефиксРайон)   ,Запись.ПрефиксРайон    ,""     );
		Запись.НеПечататьРайон = Истина;
		
		Запись.Записать();
		
	КонецЦикла; 
	
КонецПроцедуры // ЗаполнениеПрефиксаАдреса() 

// Процедура формирует движения по начислениям счетчиков.
// 
Процедура СформироватьДвиденияПоНачислениямСчетчиков() Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоСчетчикам.Ссылка
	|ИЗ
	|	Документ.бит_НачисленияПоСчетчикам КАК бит_НачисленияПоСчетчикам
	|ГДЕ
	|	бит_НачисленияПоСчетчикам.Проведен";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		НаборЗаписей = РегистрыНакопления.бит_НачисленияПоСчетчикам.СоздатьНаборЗаписей();
		НаборЗаписей.Отбор.Регистратор.Установить(Выборка.Ссылка, Истина);
		НаборЗаписей.Прочитать();
		
		Для каждого Строка Из Выборка.ССылка.Начисления Цикл
			
			Если НЕ Строка.Начислено = 0 Тогда
				
				НоваяЗапись             = НаборЗаписей.Добавить();
				НоваяЗапись.Период      = Выборка.Ссылка.Дата;
				НоваяЗапись.ЛицевойСчет = Строка.ЛицевойСчет;
				НоваяЗапись.УслугаЖКХ   = Строка.Услуга;
				НоваяЗапись.Счетчик     = Строка.Счетчик;
				НоваяЗапись.Сумма       = Строка.Начислено;
				
			КонецЕсли;
			
		КонецЦикла; 
		
		Попытка
			
			НаборЗаписей.Записать();
			
		Исключение

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			
		КонецПопытки; 
		
	КонецЦикла;
	
КонецПроцедуры

// Заполняет реквизит "ПринятоеРешение" справочника бит_ПринятыеРешения.
// У незаполненных предопределенных элементов.
Процедура Добавить_Справочник_ПринятыеРешения()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПринятыеРешения.Ссылка,
	|	бит_ПринятыеРешения.ВерсияДанных,
	|	бит_ПринятыеРешения.ПометкаУдаления,
	|	бит_ПринятыеРешения.Предопределенный,
	|	бит_ПринятыеРешения.Код,
	|	бит_ПринятыеРешения.Наименование,
	|	бит_ПринятыеРешения.ПринятоеРешение
	|ИЗ
	|	Справочник.бит_ПринятыеРешения КАК бит_ПринятыеРешения
	|ГДЕ
	|	бит_ПринятыеРешения.Предопределенный";
	
	Результат = Запрос.Выполнить().Выбрать();
	
	ЧастСтроки1 = " Зарегистрировать ";
	ЧастСтроки2 = " Постановления Правительства РФ от 17.07.1995г. №713 ""Об утверждении Правил регистрации и снятия граждан РФ с рег.учета по м/пребывания и по м/жительства в пределах РФ и Перечня должностных лиц, ответственных за регистрацию""";
	
	Пока Результат.Следующий() Цикл
		
		ПроверкаПринятогоРешения = СокрЛП(Результат.ПринятоеРешение);
		
		Если НЕ ЗначениеЗаполнено(ПроверкаПринятогоРешения) Тогда
			
			ЭлементСправочника = Результат.Ссылка.ПолучитьОбъект();
			ПринятоеРешение    = ЧастСтроки1 + Результат.Наименование + ЧастСтроки2;
			
			ЭлементСправочника.ПринятоеРешение = ПринятоеРешение;
			
			Заголовок = "Обновление данных в справочнике ""Принятые решения"" по заполнению предопределенного: ";
			
			Если бит_ОбщегоНазначения.ЗаписатьСправочник(ЭлементСправочника, Заголовок , "Ошибки") Тогда
				ТекстСообщения = НСтр("ru = '%1 %2 выполнено.'");
