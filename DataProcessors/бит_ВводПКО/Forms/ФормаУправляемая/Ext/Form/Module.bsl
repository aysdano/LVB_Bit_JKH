&НаСервере
Функция ПолучитьДокументыДляПечати()
	
	ДеревоПКОМ = РеквизитФормыВЗначение("ДеревоПКО");
	
	Массив = Новый Массив();
	
	Для Каждого ПервыйУровень из ДеревоПКОМ.Строки Цикл
		
		Для Каждого ВторойУровень из ПервыйУровень.Строки Цикл
			
			Если ТипЗнч(ВторойУровень.ПриходныйКассовыйОредер) <> Тип("ДокументСсылка.СчетНаОплатуПокупателю") Тогда
				Если ВторойУровень.Выбор Тогда
					Массив.Добавить(ВторойУровень.ПриходныйКассовыйОредер);
				КонецЕсли;
			Иначе
				
				Для Каждого ТретийУровень из ВторойУровень.Строки Цикл
					Если ТретийУровень.Выбор Тогда
						Массив.Добавить(ТретийУровень.ПриходныйКассовыйОредер);
					КонецЕсли;
				КонецЦикла;	
				
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;	
	
Возврат	 Массив;
	
	
КонецФункции


&НаКлиенте
Процедура ГрупповаяПечать(Команда)
	
	Массив = ПолучитьДокументыДляПечати();
	Параметр = Новый Структура("МассивДокументов", Массив);
	Параметр.Вставить("ФИО", Объект.ФизЛицаФИО);
	Параметр.Вставить("Адрес", Объект.ФизЛицаАдрес);
	Параметр.Вставить("ЛС", Объект.ФизЛицаЛС);
	Параметр.Вставить("УчитыватьАванс", Объект.УчитыватьАванс);

    СтандартнаяОбработка=Ложь;
