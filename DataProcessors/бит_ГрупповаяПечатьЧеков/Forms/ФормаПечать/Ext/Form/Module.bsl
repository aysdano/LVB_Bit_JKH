	Строка = Объект.Документы.НайтиСтроки(Новый Структура("Документ", Элементы.Документы.ТекущиеДанные.Документ))[0];	
	Строка.ПараметрыДокумента = Неопределено;
	ПечатнаяФорма.Очистить();
	
	ОтправлятьEmail = Ложь;
	
	ОтправлятьSMS = Ложь;
	
	АдресЭлектроннойПочты = "";
	
	НомерТелефона = "";
	
	Элементы.ПробитьЧек.Доступность = Ложь;
	
	//Организация = "";
	
	СистемаНалогообложения = Неопределено;
	
	ПечатнаяФорма.УстановитьТекст("");

КонецПроцедуры

&НаКлиенте
Процедура ДокументыПриОкончанииРедактированияНаСервере()
    ОчиститьСообщения();
	
	Если НЕ ЗначениеЗаполнено(Элементы.Документы.ТекущиеДанные.Документ) Тогда
		Возврат
	КонецЕсли;
	
	ТекущиеДанные = Объект.Документы.НайтиСтроки(Новый Структура("Документ",Элементы.Документы.ТекущиеДанные.Документ))[0];
	
	Элементы.Меню.Доступность = Истина;
	
	Если НЕ ЗначениеЗаполнено(ТекущиеДанные.ПараметрыДокумента) Тогда
		ПолучитьДанныеДляПечати(ТекущиеДанные)	
	КонецЕсли;
	
	
	Попытка
		Если ТекущиеДанные.ПараметрыДокумента.МассивЧеков.Количество()>0 Тогда
			АдресЭлектроннойПочты = ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail;
			НомерТелефона = ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].ПокупательНомер;

			НастройкиОтправкиСообщений = ПолучитьНастройки(ТекущиеДанные.Документ);
			
			Если НастройкиОтправкиСообщений <> Неопределено Тогда
				ЗаполнитьЗначенияСвойств(ЭтаФорма, НастройкиОтправкиСообщений, "ОтправлятьEmail, ОтправлятьSMS");
			КонецЕсли;
			
			ОтправлятьEmail = ОтправлятьEmail И ЗначениеЗаполнено(АдресЭлектроннойПочты);
			ОтправлятьSMS   = ОтправлятьEmail И ЗначениеЗаполнено(НомерТелефона);			
			
			ОбновитьПечатнуюФорму(ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0]);
			Организация = Строка(ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].Организация);
			СистемаНалогообложения = ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].СистемаНалогообложения;
			
		КонецЕсли;
	Исключение
		
		ОтправлятьEmail = Ложь;
		
		ОтправлятьSMS = Ложь;
		
		АдресЭлектроннойПочты = "";
		
		НомерТелефона = "";
		
		Элементы.ПробитьЧек.Доступность = Ложь;
				
		//Организация = "";
		
		СистемаНалогообложения = Неопределено;
		
		ПечатнаяФорма.УстановитьТекст("");
		
	КонецПопытки;

КонецПроцедуры

&НаКлиенте
Процедура ДокументыПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
  попытка	
		
   для каждого стр из Элемент.ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].ПозицииЧека цикл	  
	стр.ПризнакСпособаРасчета = Элемент.ТекущиеДанные.ПризнакиСпособаРасчета;
   конеццикла;
   ДокументыПриОкончанииРедактированияНаСервере();
  исключение
  конецпопытки;

КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТаблицуДокументовНаСервере()
	Если КассаККМ.Пустая() Тогда
		Сообщить("Необходимо выбрать кассу ККМ и вид оплаты");
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВидОплаты) Тогда
		Сообщить("Необходимо выбрать вид оплаты");
		Возврат;
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ПериодОплат) Тогда
		Сообщить("Необходимо указать период оплат");
		Возврат;
	КонецЕсли;
	
	Если ПериодОплат.ДатаОкончания < ПериодОплат.ДатаНачала Тогда
		Сообщить("Начало периода оплат не может быть позже конца периода");
		Возврат;
	КонецЕсли;
	
	Если (ПериодОплат.ДатаОкончания - ПериодОплат.ДатаНачала) / (60 * 60 * 24) > 5 Тогда
		Сообщить("Выбран слишком большой период оплат. Период не может быть более 5 дней.");
		Возврат;
	КонецЕсли;
	
	Объект.Документы.Очистить();
	МассивДокументов = ПолучитьМассивДокументов();

	Для каждого стр из МассивДокументов Цикл
		Добавить = Объект.Документы.Добавить();
		Добавить.Документ = стр.Ссылка;
		Добавить.ИмяДок = стр.Метаданные().Имя;
		Добавить.ПризнакиСпособаРасчета = перечисления.ПризнакиСпособаРасчета.ПередачаСПолнойОплатой;
		Если стр.НомерЧекаККМ <> 0 Тогда
			Добавить.Пробит = Истина;
		Иначе
			Добавить.Пробит = Ложь;
		КонецЕсли;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
