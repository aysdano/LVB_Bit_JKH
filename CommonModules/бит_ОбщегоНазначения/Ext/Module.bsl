Функция ПолучитьСтруктуруИзРезультатаЗапроса(РезультатЗапроса) Экспорт
	
	СтруктураПараметров = Новый Структура;
	
	Выборка = РезультатЗапроса.Выбрать();
	Выборка.Следующий();
	Для каждого КолонкаРезультата Из РезультатЗапроса.Колонки Цикл
		СтруктураПараметров.Вставить(КолонкаРезультата.Имя, Выборка[КолонкаРезультата.Имя]);
	КонецЦикла;
	
	Возврат СтруктураПараметров;
	
КонецФункции

// Функция формирует стркутуру значений содержащую данные об отвественных лицах организации.
//
// Параметры:
//  Организация    - СправочникСсылка - тек значение Организации.
//  ДатаДокумента  - Дата - Тек дата документа.
//
// Возвращаемое значение:
//   Структура   - Содержит данные  об отвественных лицах организации. 
// 
Функция бит_ОтветственныеЛица(Организация, ДатаДокумента)Экспорт 
	
	Результат = Новый Структура("Руководитель, РуководительДолжность, РуководительФИО, РуководительПредставление, 
	|ГлавныйБухгалтер, ГлавныйБухгалтерДолжность, ГлавныйБухгалтерФИО, ГлавныйБухгалтерПредставление,

	|Паспортист, ПаспортистДолжность, ПаспортистФИО, ПаспортистПредставление,
	|РуководительРасчетнойСлужбы, РуководительРасчетнойСлужбыДолжность, РуководительРасчетнойСлужбыФИО, РуководительРасчетнойСлужбыПредставление,
	|Специалист, СпециалистДолжность, СпециалистФИО, СпециалистПредставление");
	
	// Замена типовых объектов на объекты БИТ в тексте модуля.
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ОтветственноеЛицо,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо,
	|	ОтветственныеЛицаОрганизацийСрезПоследних.Должность,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество
	|ИЗ
	|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&ДатаСреза, СтруктурнаяЕдиница = &Организация) КАК ОтветственныеЛицаОрганизацийСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&ДатаСреза, ФизЛицо ССЫЛКА Справочник.бит_Проживающие) КАК ФИОФизЛицСрезПоследних
	|		ПО ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо = ФИОФизЛицСрезПоследних.ФизЛицо";
	Запрос.УстановитьПараметр("ДатаСреза"   ,ДатаДокумента);
	Запрос.УстановитьПараметр("Организация" ,Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		ФИО = Новый Структура("Фамилия, Имя, Отчество, Представление");
		Если НЕ (НЕ ЗначениеЗаполнено(Выборка.Фамилия) или Выборка.Фамилия = NULL) Тогда
			ФИО.Фамилия = Выборка.Фамилия;
		КонецЕсли;
		Если НЕ (НЕ ЗначениеЗаполнено(Выборка.Имя) или Выборка.Имя = NULL) Тогда
			ФИО.Имя = Выборка.Имя;
		КонецЕсли;
		Если НЕ (НЕ ЗначениеЗаполнено( Выборка.Отчество) или Выборка.Отчество = NULL) Тогда
			ФИО.Отчество =  Выборка.Отчество;
		КонецЕсли;
		Представление = ПолучитьФамилиюИмяОтчество(ФИО.Фамилия, ФИО.Имя, ФИО.Отчество);
		
		Если  Выборка.ОтветственноеЛицо      = Перечисления.ОтветственныеЛицаОрганизаций.Руководитель Тогда
			Результат.Руководитель               = Выборка.ФизическоеЛицо;
			Результат.РуководительДолжность      = Выборка.Должность;
			Результат.РуководительФИО            = ФИО;
			Результат.РуководительПредставление  = Представление;
			
		ИначеЕсли Выборка.ОтветственноеЛицо = Перечисления.ОтветственныеЛицаОрганизаций.ГлавныйБухгалтер Тогда
			Результат.ГлавныйБухгалтер           = Выборка.ФизическоеЛицо;
			Результат.ГлавныйБухгалтерДолжность  = Выборка.Должность;
			Результат.ГлавныйБухгалтерФИО        = ФИО;
			Результат.ГлавныйБухгалтерПредставление  = Представление;
			
		ИначеЕсли  Выборка.ОтветственноеЛицо = Перечисления.ОтветственныеЛицаОрганизаций.бит_Паспортист Тогда
			Результат.Паспортист              = Выборка.ФизическоеЛицо;
			Результат.ПаспортистДолжность     = Выборка.Должность;
			Результат.ПаспортистФИО           = ФИО;
			Результат.ПаспортистПредставление = Представление;
			
			// БИТ_ЖКХ_05082013_начало_изменений
		ИначеЕсли  Выборка.ОтветственноеЛицо = Перечисления.ОтветственныеЛицаОрганизаций.бит_РуководительРасчетнойСлужбы Тогда
			Результат.РуководительРасчетнойСлужбы              = Выборка.ФизическоеЛицо;
			Результат.РуководительРасчетнойСлужбыДолжность     = Выборка.Должность;
			Результат.РуководительРасчетнойСлужбыФИО           = ФИО;
			Результат.РуководительРасчетнойСлужбыПредставление = Представление;
			
		ИначеЕсли  Выборка.ОтветственноеЛицо = Перечисления.ОтветственныеЛицаОрганизаций.бит_Специалист Тогда
			Результат.Специалист              = Выборка.ФизическоеЛицо;
			Результат.СпециалистДолжность     = Выборка.Должность;
			Результат.СпециалистФИО           = ФИО;
			Результат.СпециалистПредставление = Представление;	
			// БИТ_ЖКХ_05082013_окончание_изменений
			
		КонецЕсли;
		
	КонецЦикла;
	Возврат Результат;
КонецФункции

// Функция возвращает дату Закрытия. 
//
//
// Возвращаемое значение:
//   Дата   - Дата Закрытия.
//
Функция ПолучитьДатуЗакрытия(ТекДата, Организация) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"        , КонецДня(ТекДата));
	Запрос.УстановитьПараметр("Организация" , Организация);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА бит_НастройкаПараметровЖКХСрезПоследних.ПоследнийДеньПриемаПлатежей > ДЕНЬ(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ))
	|			ТОГДА НАЧАЛОПЕРИОДА(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), ДЕНЬ)
	|		ИНАЧЕ ДОБАВИТЬКДАТЕ(НАЧАЛОПЕРИОДА(&Дата, МЕСЯЦ), ДЕНЬ, бит_НастройкаПараметровЖКХСрезПоследних.ПоследнийДеньПриемаПлатежей - 1)
	|	КОНЕЦ КАК Дата
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		
		Дата = НачалоДня(Результат.Получить(Результат.Количество()-1).Дата);
		
	Иначе
		
		Текст = "Для организации: """+Организация+""" не заполнена дата последнего платежа ЖКХ.
		| Дата установлена на конец месяца:"+ КонецМесяца(ТекДата) +" !!";
		СообщитьОбОшибке(Текст,,,СтатусСообщения.ОченьВажное);
		
		Дата = КонецМесяца(ТекДата);
		
	КонецЕсли;
	
	Возврат Дата;
	
КонецФункции // ()

// БИТ_ЖКХ 09.02.2011 19:01:26
// Формирует штрих код извещения.
функция СформируемШтрихКод(Сумма, НаименованиеЛС, НаименованиеШаблона, ИД, НомерПолучателяПоБанку, ИспользоватьНомерПолучателя = Ложь) Экспорт
	
	МногоНулей = "000000000000000000000000000000"; // Здесь их тридцать, будет мало - добавьте сами.
	// Под число отведено 11+2 символа.	
	СтрокаСумма = Строка( Формат(Окр(Сумма*100,0),"ЧДЦ=0") );
	СтрокаСумма = МногоНулей + УбитьЛишнее(СтрокаСумма);
	СтрокаСумма = Прав(СтрокаСумма, 13);
	
	СтрокаНаименованиеЛС = Прав(МногоНулей + Строка(СокрЛП(НаименованиеЛС)), 12);
	СтрокаНаименованиеШаблона = Прав(МногоНулей + Строка(СокрЛП(НаименованиеШаблона)), 9);
	
	// БИТ_ЖКХ добавление кода Начало: 16.03.2011 
	СтрокаИД = Прав(МногоНулей + Формат(ИД, "ЧГ=0"),6);
	// БИТ_ЖКХ добавление кода конец : 16.03.2011
	
	СтрокаСумма = СтрокаНаименованиеЛС + СтрокаНаименованиеШаблона + СтрокаИД + СтрокаСумма;
	
	КонтрольнаяСумма = 0;
	
	Попытка
		ПроверкаШК = Число(СтрокаСумма);
	Исключение
		Возврат "000000000000000000000000000000";
	КонецПопытки;
	
	Для Значение = 1 по СтрДлина(СтрокаСумма)-1 Цикл
		КонтрольнаяСумма = КонтрольнаяСумма +  Число(Лев(СтрокаСумма,Значение))*33;
	КонецЦикла;
	
	КонтрольнаяСумма = КонтрольнаяСумма%1000;
	
	НПБ = "";
	
	Если ИспользоватьНомерПолучателя Тогда
		НПБ = Прав(МногоНулей + Формат(НомерПолучателяПоБанку, "ЧГ=0"), 5);
	КонецЕсли; 
	
	// БИТ_ЖКХ 08.04.2015{{
	Если СтрДлина(КонтрольнаяСумма) = 2 Тогда
		
		СтрокаСумма = НПБ + СтрокаСумма + "0" + Строка(КонтрольнаяСумма);
		
	ИначеЕсли СтрДлина(КонтрольнаяСумма) = 1 Тогда
		
		СтрокаСумма = НПБ + СтрокаСумма + + "00" +Строка(КонтрольнаяСумма);
		
	Иначе	
		
		СтрокаСумма = НПБ + СтрокаСумма + Строка(КонтрольнаяСумма);
		
	КонецЕсли;
	// БИТ_ЖКХ 08.04.2015}}
	
	Возврат СтрокаСумма;
	
КонецФункции

