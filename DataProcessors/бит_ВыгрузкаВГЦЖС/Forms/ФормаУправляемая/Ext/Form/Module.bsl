функция ЗаполнитьНулями (ЗначениеДляЗаполнения, длинаЗначения)
	
 если СтрДлина(ЗначениеДляЗаполнения) > 7 тогда
   возврат Лев(ЗначениеДляЗаполнения, 7);		
 иначе	 
   строкаФормата = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(("ЧЦ=%1;ЧВН=;ЧГ=0"), длинаЗначения);//колвоНулей);
   строкаЗначения = Формат(Число(ЗначениеДляЗаполнения), строкаФормата);
 конецесли;  
 возврат строкаЗначения;
