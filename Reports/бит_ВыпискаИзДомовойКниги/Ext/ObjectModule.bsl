
#Область ПеременныеМодуля

Перем мСписокФизЛиц Экспорт; // Хранит список физических лиц.

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Процедура формирует отчет.
// Параметры:
// ТаблицаРезультат - табличное поле документа;.
// ВариантМакета - выбор варианта макета  для вывода в табличное поле.
Процедура СформироватьОтчет(ТаблицаРезультат, ВариантМакета) Экспорт
	
	мСписокФизЛиц = СписокПроживающих();
	
	ТаблицаРезультат.Очистить();
	Отказ = Ложь;
	ПроверкаШапки(Отказ);
	Если Отказ Тогда
		
		Возврат;
		
	КонецЕсли;
	
	// Получим подробный адрес дома.
	ПочтовыйАдресЗдания = ПодробныйАдрес(ЛицевойСчет.Здание);
	
	// БИТ_ЖКХ добавление кода Начало: 05.06.2012 
	// Вызов функции формирования списка проживающих. 
	Таблица = ФормироватьСписокОсновныхДанных();
	ТаблицаДанных = АдресаПрибытияУбытия(Дата,ЛицевойСчет);
	
	Если ВариантМакета = "ВыпискаИзДомовойКниги" Тогда
		
		Макет = ПолучитьМакет("ВыпискаИзДомовойКниги");
		
		ОбластьШапка    = Макет.ПолучитьОбласть("Шапка");
		
		ОбластьШапкаТаб = Макет.ПолучитьОбласть("ШапкаТаб");
		ОбластьШапкаТаб.Защита = Истина;
		
		ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
		
		// БИТ_ЖКХ добавление кода Начало: 05.06.2012 
		Если ИсторияПрописки Тогда
			
			ОбластьПодСтрока = Макет.ПолучитьОбласть("ПодстрокаРасшифровки");
			
		КонецЕсли; 
		// БИТ_ЖКХ добавление кода конец : 05.06.2012
		
		ОбластьШапка.Параметры.Номер       = Номер;
		// БИТ_ЖКХ изменения кода . Начало: 06.06.2012
		ОбластьШапка.Параметры.НомерДома   = Строка(ЛицевойСчет.Здание) 
		+ ?(ЗначениеЗаполнено(ЛицевойСчет.Здание.Корпус),", корп." + Строка(ЛицевойСчет.Здание.Корпус),"");

		// БИТ_ЖКХ изменения кода . Конец  06.06.2012
		ОбластьШапка.Параметры.Улица       = ЛицевойСчет.УлицаЛицевогоСчета;
		
		Если ПочтовыйАдресЗдания.Следующий() Тогда
			// БИТ ЖКХ 26.01.2021
			//ОбластьШапка.Параметры.Город =  ?(ЗначениеЗаполнено(ПочтовыйАдресЗдания.Город),ПочтовыйАдресЗдания.Город,ПочтовыйАдресЗдания.Регион);
			если ЗначениеЗаполнено(ЛицевойСчет.Здание.КонтактнаяИнформация) И
				  ЛицевойСчет.Здание.КонтактнаяИнформация.Количество() > 0 тогда
			 ОбластьШапка.Параметры.Город = ПолучитьАдресДляСправки(строка(ЛицевойСчет.Здание.КонтактнаяИнформация[0].Значение));
			иначе			 
			 ОбластьШапка.Параметры.Город =  ?(ЗначениеЗаполнено(ПочтовыйАдресЗдания.Город), ПочтовыйАдресЗдания.Объект.ПочтовыйАдрес,ПочтовыйАдресЗдания.Регион);			    
		    конецесли;
		 
		КонецЕсли;
		
		ТаблицаРезультат.Вывести(ОбластьШапка);
		ТаблицаРезультат.Вывести(ОбластьШапкаТаб);
		НомерСтроки = 0;
		
		// Цикл заполнения макета.	                                                  
		Для каждого Строка_ Из мСписокФизЛиц Цикл
			АдресПрибытияИзСправочника = Неопределено;
			
			ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаРазшифровки");
			Строка = Таблица.Найти(Строка_.ФизЛицо,"ФизЛицо");
			Отбор = Новый Структура;
			Отбор.Вставить("ФизЛицо",Строка_.ФизЛицо);
			СтрокиМассив = Таблица.НайтиСтроки(Отбор);
			СтрокиДанных = ТаблицаДанных.НайтиСтроки(Отбор);
			Индекс = 0;
			Если СтрокиМассив.Количество() > 0 Тогда                          
				
				Выборка = Новый Структура;
				Для каждого СтрокаМассив_ Из СтрокиМассив Цикл
					СтрокаВидСведений = СтрокаМассив_.ВидСведений;
					
					Если СтрокаВидСведений <> Null Тогда
						
						ПредопределенныеИзПВХ = ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.ПолучитьИмяПредопределенного(СтрокаВидСведений);
						Если ПредопределенныеИзПВХ = "КогдаИОткудаПрибыл" Тогда
							
							АдресПрибытияИзСправочника = СтрокаМассив_.Значение;
							
						КонецЕсли;
						Если ЗначениеЗаполнено(ПредопределенныеИзПВХ) Тогда
							ДанныеПВХ =  ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих;
							Выборка.Вставить(ПредопределенныеИзПВХ,СтрокаМассив_.Значение);
							ОбластьСтрока.Параметры.Заполнить(Выборка);
						КонецЕсли; 
					КонецЕсли;
					
				КонецЦикла;
				
			КонецЕсли; 
			
			// Заполнение параметров макета.
			
			// БИТ_ЖКХ изменения кода - МестоРождения. Начало: 05.06.2012
			Если ЗначениеЗаполнено(Строка.МестоРождения) Тогда
				
				МестоРождения = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(Строка.МестоРождения, Истина);
				
			Иначе
				
				МестоРождения = "";
				
			КонецЕсли; 
			
			// Заполнение столбца с ФИО, местом рождения, семейным положением.
			
			ОбластьСтрока.Параметры.Заполнить(Строка);
			// БИТ_ЖКХ изменения кода . Начало: 07.06.2012
			
			ПолноеФИО = СокрЛП(Строка(Строка_.Фамилия + " " + Строка_.Имя + " " + Строка_.Отчество));
			
			
			Если НЕ ЗначениеЗаполнено(СокрЛП(ПолноеФИО)) Тогда
				
				ПолноеФИО =  Строка.ФизЛицо.Наименование;
				
			КонецЕсли; 
			
			Если Выборка.Свойство("СемейноеПоложение") Тогда
				
				ОбластьСтрока.Параметры.ЛичныеДанные = ПолноеФИО +  " " + МестоРождения
				+ ", " + Выборка["СемейноеПоложение"];
			Иначе
				ОбластьСтрока.Параметры.ЛичныеДанные = ПолноеФИО + " " + МестоРождения;
				
			КонецЕсли; 
			// БИТ_ЖКХ изменения кода . Конец  05.06.2012 И  07.06.2012
			
			ОбластьСтрока.Параметры.ВидДеятельности = "";
			
			Если ЗначениеЗаполнено(Строка.РодЗанятий) Тогда
				ОбластьСтрока.Параметры.ВидДеятельности = Строка.РодЗанятий;
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.Должность) И СтрДлина(ОбластьСтрока.Параметры.ВидДеятельности) > 0 Тогда
				ОбластьСтрока.Параметры.ВидДеятельности = ОбластьСтрока.Параметры.ВидДеятельности + ", " + Строка.Должность;
			Иначе
				Если ЗначениеЗаполнено(Строка.Должность) Тогда
					ОбластьСтрока.Параметры.ВидДеятельности = Строка.Должность;
				КонецЕсли;				
			КонецЕсли;
			Если ЗначениеЗаполнено(Строка.МестоРаботы) И СтрДлина(ОбластьСтрока.Параметры.ВидДеятельности) > 0 Тогда
				ОбластьСтрока.Параметры.ВидДеятельности = ОбластьСтрока.Параметры.ВидДеятельности + ", " + Строка.МестоРаботы;
			Иначе
				Если ЗначениеЗаполнено(Строка.МестоРаботы) Тогда
					ОбластьСтрока.Параметры.ВидДеятельности = Строка.МестоРаботы;
				КонецЕсли;				
			КонецЕсли;
			// БИТ_ЖКХ_09082013_окончание_изменений
			
			НомерСтроки = НомерСтроки + 1;
			ОбластьСтрока.Параметры.НомерПП          = НомерСтроки;
			Если ЗначениеЗаполнено(Строка.ДокументВид) Тогда
				ОбластьСтрока.Параметры.ПаспортныеДанные = Строка(Строка.ДокументВид)
				+?(ЗначениеЗаполнено(Строка.ПаспортСерия), " сер." + Строка.ПаспортСерия, "")
				+?(ЗначениеЗаполнено(Строка.ПаспортНомер), " " + Строка.ПаспортНомер , "")
				+?(ЗначениеЗаполнено(Строка.ПаспортДатаВыдачи), ", выд." + Формат(Строка.ПаспортДатаВыдачи, "ДФ='dd.MM.yyyy ""г.""'"), "")
				+?(ЗначениеЗаполнено(Строка.ПаспортКемВыдан), " " + Строка.ПаспортКемВыдан, "");
				// БИТ_ЖКХ изменения кода . Конец  07.06.2012
			Иначе 
				ОбластьСтрока.Параметры.ПаспортныеДанные = Неопределено;
				
			КонецЕсли;
			
			// БИТ_ЖКХ_09082013_начало_изменений
			Если ЗначениеЗаполнено(Строка.ОтношениеКВоинскойОбязанности)
				ИЛИ ЗначениеЗаполнено(Строка.ОтметкаОПриемеНаВоинскийУчетИСнятииСВоинскогоУчета) Тогда
				Если Строка.ОтметкаОПриемеНаВоинскийУчетИСнятииСВоинскогоУчета = Перечисления.бит_ОтметкаОПриемеНаВоинскийУчетИСнятииСВоинскогоУчета.ПринятНаВоинскийУчет Тогда
					ОбластьСтрока.Параметры.ОтношениеКВоеннойСлужбе = 
					?(ЗначениеЗаполнено(Строка.ОтношениеКВоинскойОбязанности), Строка(Строка.ОтношениеКВоинскойОбязанности) + ",", "")
					+ ?(ЗначениеЗаполнено(Строка.КемПринятНаВоинскийУчетИлиСнятСВоинскогоУчета), " " + Строка.КемПринятНаВоинскийУчетИлиСнятСВоинскогоУчета, "")
					+ ?(ЗначениеЗаполнено(Строка.КогдаПринятНаВоинскийУчетИлиСнятСВоинскогоУчета), " " + Формат(Строка.КогдаПринятНаВоинскийУчетИлиСнятСВоинскогоУчета, "ДФ='dd.MM.yyyy ""г.""'"), "");
				Иначе
					ОбластьСтрока.Параметры.ОтношениеКВоеннойСлужбе = 
					?(ЗначениеЗаполнено(Строка.ОтношениеКВоинскойОбязанности), Строка.ОтношениеКВоинскойОбязанности, "");
				КонецЕсли;
			Иначе
				ОбластьСтрока.Параметры.ОтношениеКВоеннойСлужбе = "";
			КонецЕсли;
			// БИТ_ЖКХ_09082013_окончание_изменений
			
			// БИТ_ЖКХ добавление кода Начало: 06.06.2012 
			Для каждого СтрокаИзДанных Из СтрокиДанных Цикл
				ОбластьСтрока.Параметры.Заполнить(СтрокаИзДанных);
			КонецЦикла;  
			
			// БИТ_ЖКХ добавление кода Начало: 05.06.2012 
			Если ИсторияПрописки Тогда
				
				Если СтрокиДанных.Количество()> 0 Тогда
					СчетчикСтрок = 0;
					
					Для каждого Строка Из СтрокиДанных Цикл
						
						Если СчетчикСтрок = 0 Тогда
							
							ОбластьСтрока.Параметры.Заполнить(Строка);
							ТаблицаРезультат.Вывести(ОбластьСтрока);
							
						Иначе
							ОбластьПодСтрока.Параметры.Заполнить(Строка);
							ТаблицаРезультат.Вывести(ОбластьПодСтрока);
						КонецЕсли; 
						
						СчетчикСтрок = СчетчикСтрок + 1;
					КонецЦикла; 
					
				КонецЕсли; 
			Иначе
				
				// БИТ_ЖКХ добавление кода Начало: 08.06.2012 
				Если ЗначениеЗаполнено(АдресПрибытияИзСправочника) Тогда
					
					ОбластьСтрока.Параметры.КогдаИОткудаПрибыл = АдресПрибытияИзСправочника;
					
				КонецЕсли; 
				// БИТ_ЖКХ добавление кода конец : 08.06.2012
				//	ТаблицаДанных = АдресаПрибытияУбытия(Дата,ЛицевойСчет);.
				ТаблицаРезультат.Вывести(ОбластьСтрока);
				
			КонецЕсли; 
			// БИТ_ЖКХ добавление кода конец : 05.06.2012
			
		КонецЦикла;
		
		ОбластьПодвал.Параметры.Дата = Формат(Дата, "ДФ=dd.MM.yyyy") ;
		
		// БИТ_ЖКХ добавление кода Начало: 05.06.2012 
		Отбор = Новый Структура;
		Отбор.Вставить("СтруктурнаяЕдиница",ЛицевойСчет.Организация);
		Отбор.Вставить("ОтветственноеЛицо",Перечисления.ОтветственныеЛицаОрганизаций.бит_Паспортист);
		ОтветственныеЛица = РегистрыСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(Дата, Отбор);
		
		ПаспортистФИО = "";
		Если ОтветственныеЛица.Количество() > 0 Тогда
			ПаспортистФИО =  ОтветственныеЛица[0].ФизическоеЛицо;
			КраткоеФИО = бит_ПаспортныйСтолСервер.ПолучитьСокращенноеФИО(ПаспортистФИО,Дата, Истина);
			Если ЗначениеЗаполнено(КраткоеФИО) Тогда
				
				ПаспортистФИО = КраткоеФИО;
				
			КонецЕсли; 
		КонецЕсли; 
		ОбластьПодвал.Параметры.ПаспортистФИО = ПаспортистФИО;
		// БИТ_ЖКХ добавление кода конец : 05.06.2012
		
		ТаблицаРезультат.Вывести(ОбластьПодвал);
		
	Иначе
		
		Макет = ПолучитьМакет("ДомоваяКнига");
		// БИТ_ЖКХ добавление кода Начало: 14.06.2012 
		ТаблицаВладельцев = СписокВладельцев();
		// БИТ_ЖКХ добавление кода конец : 14.06.2012
		
		ОбластьШапка    		= Макет.ПолучитьОбласть("Шапка");
		ОбластьРаздел1 			= Макет.ПолучитьОбласть("Раздел1");
		ОбластьРаздел2 			= Макет.ПолучитьОбласть("Раздел2");
		
		// Заполнение первой страницы.
		// БИТ_ЖКХ изменения кода . Начало: 11.11.2011
		Если ЗначениеЗаполнено(ЛицевойСчет.Здание.Корпус) Тогда
			ОбластьШапка.Параметры.Здание	 	= Строка(ЛицевойСчет.Здание) + ", корп." + ЛицевойСчет.Здание.Корпус;
		Иначе
			ОбластьШапка.Параметры.Здание	 	= Строка(ЛицевойСчет.Здание);
		КонецЕсли; 
		// БИТ_ЖКХ изменения кода . Конец  11.11.2011
		ОбластьШапка.Параметры.Квартира 	= ЛицевойСчет.Квартира;
		ОбластьШапка.Параметры.Улица 		= ЛицевойСчет.УлицаЛицевогоСчета;
		ТаблицаРезультат.Вывести(ОбластьШапка);
		ОбластьШапка.Защита = Истина;
		
		ТаблицаРезультат.ВывестиГоризонтальныйРазделительСтраниц();
		
		ТаблицаРезультат.Вывести(ОбластьРаздел1);
		НомерСтроки = 0;  
		
		Для каждого Строка_ Из ТаблицаВладельцев Цикл
			
			ОбластьДанныеРаздел1 = Макет.ПолучитьОбласть("ДанныеРаздел1");
			НомерСтроки = НомерСтроки + 1;
			ОбластьДанныеРаздел1.Параметры.НомерПП = НомерСтроки;
			ОбластьДанныеРаздел1.Параметры.Заполнить(Строка_);
			ТаблицаРезультат.Вывести(ОбластьДанныеРаздел1);
			
		КонецЦикла; 
		
		ТаблицаРезультат.Вывести(ОбластьРаздел2);
		НомерСтроки = 0;
		
		Для каждого Строка_ Из мСписокФизЛиц Цикл
			ОбластьДанныеРаздел2 	= Макет.ПолучитьОбласть("ДанныеРаздел2");
			
			Строка 			= Таблица.Найти(Строка_.ФизЛицо,"ФизЛицо");
			// БИТ_ЖКХ добавление кода Начало: 07.06.2012
			Отбор = Новый Структура;
			Отбор.Вставить("ФизЛицо",Строка_.ФизЛицо);
			СтрокиДанных = ТаблицаДанных.НайтиСтроки(Отбор);
			
			// БИТ_ЖКХ добавление кода конец : 07.06.2012
			НомерСтроки = НомерСтроки + 1;
			ОбластьДанныеРаздел2.Параметры.НомерПП = НомерСтроки;
			
			// БИТ_ЖКХ изменения кода МестоРождения. Начало: 05.06.2012
			Если ЗначениеЗаполнено(Строка.МестоРождения) Тогда
				
				МестоРождения = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(Строка.МестоРождения, Истина);
				
			Иначе
				
				МестоРождения = "";
				
			КонецЕсли; 
			// БИТ_ЖКХ добавление кода Начало: 07.06.2012 
			ПолноеФИО = Строка_.Фамилия + " " + Строка_.Имя + " " + Строка_.Отчество;
			Если НЕ ЗначениеЗаполнено(СокрЛП(ПолноеФИО)) Тогда
				
				ПолноеФИО =  Строка.ФизЛицо.Наименование;
			КонецЕсли;
			ОбластьДанныеРаздел2.Параметры.ЛичныеДанные = ПолноеФИО + ?(ЗначениеЗаполнено(МестоРождения),", " + МестоРождения, "");
			
			Если ЗначениеЗаполнено(Строка.ДокументВид) Тогда
				
				ОбластьДанныеРаздел2.Параметры.ПаспортныеДанные = Строка(Строка.ДокументВид)
				+?(ЗначениеЗаполнено(Строка.ПаспортСерия), " сер." + Строка.ПаспортСерия, "")
				+?(ЗначениеЗаполнено(Строка.ПаспортНомер), " " + Строка.ПаспортНомер , "")
				+?(ЗначениеЗаполнено(Строка.ПаспортДатаВыдачи), ", выд." + Формат(Строка.ПаспортДатаВыдачи, "ДФ='dd.MM.yyyy ""г.""'"), "")
				+?(ЗначениеЗаполнено(Строка.ПаспортКемВыдан), " " + Строка.ПаспортКемВыдан, "");
				
			Иначе ОбластьДанныеРаздел2.Параметры.ПаспортныеДанные = Неопределено;
				
			КонецЕсли; 
			Отбор = Новый Структура;
			Отбор.Вставить("ФизЛицо",Строка_.ФизЛицо);
			СтрокиМассив = Таблица.НайтиСтроки(Отбор);
			Индекс = 0;
			// БИТ_ЖКХ добавление кода Начало: 08.06.2012 
			АдресПрибытияИзСправочника = Неопределено;
			// БИТ_ЖКХ добавление кода конец : 08.06.2012
			Если СтрокиМассив.Количество() > 0 Тогда                          
				
				Выборка = Новый Структура;
				Для каждого СтрокаМассив_ Из СтрокиМассив Цикл
					СтрокаВидСведений = СтрокаМассив_.ВидСведений;
					
					Если СтрокаВидСведений <> Null Тогда
						
						ПредопределенныеИзПВХ = ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.ПолучитьИмяПредопределенного(СтрокаВидСведений);
						Если ЗначениеЗаполнено(ПредопределенныеИзПВХ) Тогда
							// БИТ_ЖКХ добавление кода Начало: 08.06.2012 
							Если ПредопределенныеИзПВХ = "КогдаИОткудаПрибыл" Тогда
								
								АдресПрибытияИзСправочника = СтрокаМассив_.Значение;
								
							КонецЕсли;
							// БИТ_ЖКХ добавление кода конец : 08.06.2012
							ДанныеПВХ =  ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих;
							Выборка.Вставить(ПредопределенныеИзПВХ,СтрокаМассив_.Значение);
							ОбластьДанныеРаздел2.Параметры.Заполнить(Выборка);
							
						КонецЕсли; 
						
					КонецЕсли;
					
					ОбластьДанныеРаздел2.Параметры.Заполнить(СтрокаМассив_);
					
				КонецЦикла;
				
			Для каждого СтрокаИзДанных Из СтрокиДанных Цикл
				ОбластьДанныеРаздел2.Параметры.Заполнить(СтрокаИзДанных);
			КонецЦикла;  
				
				// Заполнение параметров макета.
				
			КонецЕсли;                               
			
			Если СтрокиДанных.Количество()> 0 Тогда
				Если ИсторияПрописки Тогда
					
					ОбластьПодСтрока 	= Макет.ПолучитьОбласть("ПодстрокаРасшифровки");
					СчетчикСтрок = 0;
					
					Для каждого Строка Из СтрокиДанных Цикл
						
						Если СчетчикСтрок = 0 Тогда
							
							ОбластьДанныеРаздел2.Параметры.Заполнить(Строка);
							ТаблицаРезультат.Вывести(ОбластьДанныеРаздел2);
							
						Иначе
							ОбластьПодСтрока.Параметры.Заполнить(Строка);
							ТаблицаРезультат.Вывести(ОбластьПодСтрока);
						КонецЕсли; 
						
						СчетчикСтрок = СчетчикСтрок + 1;
					КонецЦикла; 
				Иначе
					ОбластьДанныеРаздел2.Параметры.Заполнить(СтрокиДанных[0]);
					// БИТ_ЖКХ добавление кода Начало: 08.06.2012 
					Если ЗначениеЗаполнено(АдресПрибытияИзСправочника) Тогда
						
						ОбластьДанныеРаздел2.Параметры.КогдаИОткудаПрибыл = АдресПрибытияИзСправочника;
						
					КонецЕсли; 
					// БИТ_ЖКХ добавление кода конец : 08.06.2012
					ТаблицаРезультат.Вывести(ОбластьДанныеРаздел2);
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли; 
	
КонецПроцедуры

// БИТ ЖКХ 27.01.2021
Функция ПолучитьАдресДляСправки (стрАдреса)
	
  строкаАдреса = "";
  
  попытка
   ЧтениеJSON = Новый ЧтениеJSON;
   ЧтениеJSON.УстановитьСтроку(стрАдреса);
   address = ПрочитатьJSON(ЧтениеJSON, ложь);	
   ЧтениеJSON.Закрыть();
  исключение
   возврат ""; 
  конецпопытки; 
  
  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "area") = истина тогда
   строкаАдреса = строкаАдреса + строка(address.area);  	  
  конецесли;

  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "areaType") = истина тогда
   строкаАдреса = строкаАдреса + " " + строка(address.areaType);  	  
  конецесли;

  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "district") = истина тогда
   строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса) + " " + строка(address.district);  	  
  конецесли;

  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "districtType") = истина тогда
   строкаАдреса = строкаАдреса + " " + строка(address.districtType);  	  
  иначе
	  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "district") = истина тогда
		строкаАдреса = строкаАдреса + " р-н"; 
      конецесли;
  конецесли;

  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "city") = истина тогда
	  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "districtType") = истина тогда
		строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса);  
	  конецесли;       	  
   строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса) + " " + строка(address.city);  	  
  конецесли;

  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "cityType") = истина тогда
   строкаАдреса = строкаАдреса + " " + строка(address.cityType);  	  
  конецесли;
  
  если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(address, "locality") = истина тогда
   строкаАдреса = строкаАдреса + ДобавитьРазделитель(строкаАдреса) + " " + строка(address.locality);  	  
  конецесли;

  возврат строкаАдреса;	
		

конецфункции	
			  
// БИТ ЖКХ 27.01.2021
функция ДобавитьРазделитель(ЗначениеИзСтроки)
	
	если ЗначениеЗаполнено(ЗначениеИзСтроки) = истина тогда
		возврат ", ";
	конецесли;
	
конецфункции

//  Функция получает адрес из контактной информации.
//
Функция ПодробныйАдрес(Объект)
	
	// БИТ_ЖКХ 01.12.2010. 
	// Замена указаний типовых объектов на объекты БИТ в тексте модуля.
	ЗапросАдрес = Новый Запрос;
	ЗапросАдрес.УстановитьПараметр("Объект" , Объект);
	ЗапросАдрес.Текст = 
	"ВЫБРАТЬ
	|	КонтактнаяИнформация.Объект,
	|	КонтактнаяИнформация.Тип,
	|	КонтактнаяИнформация.Вид,
	|	КонтактнаяИнформация.Представление,
	|	КонтактнаяИнформация.Поле1 КАК Индекс,
	|	КонтактнаяИнформация.Поле2 КАК Регион,
	|	КонтактнаяИнформация.Поле3 КАК Район,
	|	КонтактнаяИнформация.Поле4 КАК Город,
	|	КонтактнаяИнформация.Поле5 КАК НасПункт,
	|	КонтактнаяИнформация.Поле6 КАК Улица,
	|	КонтактнаяИнформация.Поле7 КАК Дом,
	|	КонтактнаяИнформация.Поле8 КАК Корпус,
	|	КонтактнаяИнформация.Поле9 КАК Квартира,
	|	КонтактнаяИнформация.Поле10 КАК Страна,
	|	КонтактнаяИнформация.Комментарий,
	|	КонтактнаяИнформация.ЗначениеПоУмолчанию,
	|	КонтактнаяИнформация.ТипДома,
	|	КонтактнаяИнформация.ТипКорпуса,
	|	КонтактнаяИнформация.ТипКвартиры,
	|	КонтактнаяИнформация.ПользовательЛичногоКонтакта
	|ИЗ
	|	РегистрСведений.бит_КонтактнаяИнформация КАК КонтактнаяИнформация
	|ГДЕ
	|	КонтактнаяИнформация.Объект = &Объект
	|	И КонтактнаяИнформация.Тип = ЗНАЧЕНИЕ(Перечисление.бит_ТипыКонтактнойИнформации.Адрес)
	|	И КонтактнаяИнформация.Вид = ЗНАЧЕНИЕ(Справочник.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания)";
	
	Выборка = ЗапросАдрес.Выполнить().Выбрать();
	
	Возврат Выборка;
	
КонецФункции 

