&НаКлиенте
Процедура СписокПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	Если НоваяСтрока Или Копирование Тогда
		
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		
		Если Не ТекущиеДанные = Неопределено Тогда
			
			ТекущиеДанные.Период        = НачалоМесяца(ТекущаяДата());
			ТекущиеДанные.НомерКартинки = 0;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если Не ТекущиеДанные = Неопределено Тогда
		
		Если ТекущиеДанные.Период = Дата(1, 1, 1) Или
			ТекущиеДанные.Услуга = ПредопределенноеЗначение("Справочник.бит_УслугиЖКХ.ПустаяСсылка") Или
			ТекущиеДанные.Поставщик = ПредопределенноеЗначение("Справочник.бит_ПоставщикиУслуг.ПустаяСсылка") Тогда
			
			// БИТ_ЖКХ_31012014_начало_изменений
			Если Не ОтменаРедактирования Тогда
				// БИТ_ЖКХ_31012014_окончание_изменений
				
				
				Отказ = Истина;
				
				Если ТекущиеДанные.Период = Дата(1, 1, 1) Тогда

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перед записью заполните измерение ""Период"" ");
					
				КонецЕсли;	
				
				Если ТекущиеДанные.Услуга = ПредопределенноеЗначение("Справочник.бит_УслугиЖКХ.ПустаяСсылка") Тогда

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перед записью заполните измерение ""Услуга"" ");
					
				КонецЕсли;
				
				Если ТекущиеДанные.Поставщик = ПредопределенноеЗначение("Справочник.бит_ПоставщикиУслуг.ПустаяСсылка") Тогда

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перед записью заполните измерение ""Поставщик"" ");
					
				КонецЕсли;
				
				// БИТ_ЖКХ_31012014_начало_изменений	
			КонецЕсли; 
			// БИТ_ЖКХ_31012014_окончание_изменений
			
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Не ОтменаРедактирования Тогда
		
		ТекущиеДанные = Элементы.Список.ТекущиеДанные;
		
		ДобавитьЗаписьНаСервере(ТекущиеДанные.Период, ТекущиеДанные.Услуга, ТекущиеДанные.Поставщик, ТекущиеДанные.ПолучательДенежныхСредств, ТекущиеДанные.ДоговорКонтрагента);
		
		ЗаполнитьТаблицуСписок();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПослеУдаления(Элемент)
	
	ЗаполнитьТаблицуСписок();
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучательДенежныхСредствОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	// БИТ_ЖКХ 12.02.2014	
	Если НЕ ТипЗнч(ВыбранноеЗначение) = Тип("Тип") Тогда
		// БИТ_ЖКХ 12.02.2014		
		
		Если ТипЗнч(ТекущиеДанные.ПолучательДенежныхСредств) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			Если НЕ ВыбранноеЗначение = Неопределено И ПолучитьЭтоГруппаПолучателяДенежныхСредств(ВыбранноеЗначение) Тогда
				
				СтандартнаяОбработка = Ложь;

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нельзя указывать группу контрагентов как получателя денежных средств.");
				
			КонецЕсли;
			
		КонецЕсли; 
		
		// БИТ_ЖКХ 12.02.2014
	КонецЕсли; 
	// БИТ_ЖКХ 12.02.2014	
	
КонецПроцедуры

&НаКлиенте
Процедура ПоставщикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Список.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	СтандартнаяОбработка = Ложь;
	
	СписокПоставщики = ПолучитьСписокПоставщикиНаСервере(ТекущаяСтрока.Услуга);
	
	ОтборВФорме = Новый Структура("Ссылка", СписокПоставщики);
	
	ОткрытьФорму("Справочник.бит_ПоставщикиУслуг.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", ОтборВФорме), Элемент);
	
КонецПроцедуры

