// Процедура выполняет операции связанные с распределением суммы оплаты по услугам.
//
Процедура ВыполнитьРасчет(ТаблицаЛС = Неопределено, ОтборПоТекущейСтроке = Ложь)Экспорт
	
	ОбновитьПараметрыЖКХ();
	
	Если ТаблицаЛС = Неопределено Тогда
		ТаблицаЛС = СписокЛС.Выгрузить();
	КонецЕсли; 
	
	КоммунальныеУслуги = СписокУслуг.ВыгрузитьКолонки();
	
	Если ОплатаПоПериоду И ЗначениеЗаполнено(КонецПериодаОплаты) Тогда
		мДата = КонецПериодаОплаты;
	Иначе
		мДата = Дата;
	КонецЕсли;
	бит_ОбщегоНазначения.РаспределениеСуммПоОплате(мДата,
	Организация,
	ТаблицаЛС,
	КоммунальныеУслуги,
	мЛьготаПерсонифицированная,
	мРасчетСУчетомДолейВладения,
	мУменьшениеНормыЛьготыВПределахФакта,
	мНачислениеСУчетомДнейПроживания,
	мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика,
	мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
	мНачислятьПениСУчетомПереплаты,
	ОплатаПоПериоду,
	НачалоПериодаОплаты);
	
	СписокУслуг.Очистить();
	СписокУслуг.Загрузить(КоммунальныеУслуги);
	
КонецПроцедуры

// Процедура выполняет заполнение счетов и субконто табличной части.
//
Процедура ЗапролнитьСчета(ТабЛицевыеСчета = Неопределено) Экспорт
	
	Если ТабЛицевыеСчета=Неопределено тогда
		
		тмпСписокЛС = СписокЛС.ВыгрузитьКолонку("ЛицевойСчет");
		Колонки     = СписокЛС.ВыгрузитьКолонки().Колонки;
		
		УдалитКолоку = Колонки.Найти("Услуга");
		
		Колонки.Удалить(УдалитКолоку);
		
		бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(СписокЛС, Колонки, тмпСписокЛС, Организация , Дата, ИсточникОплаты, Истина);
		
	Иначе
		
		тмпСписокЛС = ТабЛицевыеСчета.ВыгрузитьКолонку("ЛицевойСчет");
		Колонки  = ТабЛицевыеСчета.Колонки;
		
		УдалитКолоку = Колонки.Найти("Услуга");
		
		Колонки.Удалить(УдалитКолоку);
		
		бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ТабЛицевыеСчета, Колонки, тмпСписокЛС, Организация , Дата, ИсточникОплаты, Истина);
		
	КонецЕсли;
	
КонецПроцедуры

//16.04.2019
// Процедура выполняет операции связанные с распределением суммы оплаты по услугам.
//
Процедура ВыполнитьРасчетСУчетомНачисленийМесяца(ТаблицаЛС = Неопределено, ОтборПоТекущейСтроке = Ложь)Экспорт
	
	ОбновитьПараметрыЖКХ();
	
	Если ТаблицаЛС = Неопределено Тогда
		ТаблицаЛС = СписокЛС.Выгрузить();
	КонецЕсли; 
	
	КоммунальныеУслуги = СписокУслуг.ВыгрузитьКолонки();
	
	Если ОплатаПоПериоду И ЗначениеЗаполнено(КонецПериодаОплаты) Тогда
		мДата = КонецПериодаОплаты;
	Иначе
		мДата = Дата;
	КонецЕсли;
	
    мДата = КонецМесяца(мДата);	
	бит_ОбщегоНазначения.РаспределениеСуммПоОплате(мДата,
	Организация,
	ТаблицаЛС,
	КоммунальныеУслуги,
	мЛьготаПерсонифицированная,
	мРасчетСУчетомДолейВладения,
	мУменьшениеНормыЛьготыВПределахФакта,
	мНачислениеСУчетомДнейПроживания,
	мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика,
	мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
	мНачислятьПениСУчетомПереплаты,
	ОплатаПоПериоду,
	НачалоПериодаОплаты);
	
	СписокУслуг.Очистить();
	
	//19.04.2019
	Индекс = КоммунальныеУслуги.Количество() - 1; 
	Пока Индекс >= 0 Цикл 
		строкаКоммунальныеУслуги = КоммунальныеУслуги[Индекс];
		Если строкаКоммунальныеУслуги.Сумма = 0 Тогда 
			КоммунальныеУслуги.Удалить(Индекс); 
		конецесли; 
		Индекс = Индекс - 1; 
	КонецЦикла; 

	СписокУслуг.Загрузить(КоммунальныеУслуги);
	
КонецПроцедуры

#КонецОбласти

#Область ОбеспечениеПроведенияДокумента

//  Процедура выполняет проверку табличных частей при вводе оплаты вручную.
//
Процедура ПроверкаОплатыВведнойВРучную(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	СписокЛС.ЛицевойСчет,
	|	СписокЛС.ШаблонИзвещений,
	|	СписокЛС.Сумма
	|ПОМЕСТИТЬ ЛицевыеСчета
	|ИЗ
	|	&СписокЛС КАК СписокЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СписокУслуг.ЛицевойСчет,
	|	СписокУслуг.ШаблонИзвещений,
	|	СписокУслуг.Сумма,
	|	СписокУслуг.СуммаПени
	|ПОМЕСТИТЬ СписокУслуг
	|ИЗ
	|	&СписокУслуг КАК СписокУслуг
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЛицевыеСчета.ЛицевойСчет,
	|	ЛицевыеСчета.ШаблонИзвещений,
	|	ЕСТЬNULL(ЛицевыеСчета.Сумма, 0) КАК СуммаОплаты,
	|	ЕСТЬNULL(Услуги.Сумма, 0) КАК СуммаРаспределения,
	|	ЕСТЬNULL(Услуги.Пени, 0) КАК Пени
	|ИЗ
	|	ЛицевыеСчета КАК ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			СписокУслуг.ЛицевойСчет КАК ЛицевойСчет,
	|			СписокУслуг.ШаблонИзвещений КАК ШаблонИзвещений,
	|			СУММА(СписокУслуг.Сумма) КАК Сумма,
	|			СУММА(СписокУслуг.СуммаПени) КАК Пени
	|		ИЗ
	|			СписокУслуг КАК СписокУслуг
	|		
	|		СГРУППИРОВАТЬ ПО
	|			СписокУслуг.ЛицевойСчет,
	|			СписокУслуг.ШаблонИзвещений) КАК Услуги
	|		ПО ЛицевыеСчета.ЛицевойСчет = Услуги.ЛицевойСчет
	|			И ЛицевыеСчета.ШаблонИзвещений = Услуги.ШаблонИзвещений";
	
	Запрос.УстановитьПараметр("СписокЛС"   , СписокЛС);
	Запрос.УстановитьПараметр("СписокУслуг", СписокУслуг);
	
	Выборка = Запрос.Выполнить().Выбрать() ;
	
	Текст = "Сумма оплаты не совпадает с распределенной суммой: ";
	
	Пока Выборка.Следующий() Цикл
		
		СуммаОплаты = Выборка.СуммаОплаты;
		СуммаРасп   = Выборка.СуммаРаспределения + Выборка.Пени;
		
		Если СуммаОплаты <> СуммаРасп Тогда
			
			Отказ = Истина;	
			Текст = Текст + "
			|Лицевой счет """+ Выборка.ЛицевойСчет +""", сумма оплаты: " + СуммаОплаты + ", распределенная сумма: " + СуммаРасп;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если Отказ Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = Текст;
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура проверяет правильность заполнения реквизитов документа
//
Процедура ПроверкаРеквизитовТЧ(ТаблицаОС,СтруктураШапкиДокумента,Отказ, Заголовок) Экспорт
	
	// Заменен вид операции.
	РеквизитыТабСписокУслуг = "ЛицевойСчет,Сумма"; // через запятую.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "СписокЛС", Новый Структура(РеквизитыТабСписокУслуг), Отказ, Заголовок);
	
КонецПроцедуры

