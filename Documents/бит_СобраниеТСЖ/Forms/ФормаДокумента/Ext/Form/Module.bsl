// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ДобавитьОтборПроживающих()
	
	ТаблицаЗданий = Объект.СписокЗданий.Выгрузить();
	СписокЗданий  = ТаблицаЗданий.ВыгрузитьКолонку("Здание");
	
	ТаблицаСобствеников = ПолучитьСписокСобствениковДляОтбора(Объект.Дата, СписокЗданий);
	
	Отбор = Новый СписокЗначений;
	Отбор.ЗагрузитьЗначения(ТаблицаСобствеников.ВыгрузитьКолонку("ФизЛицо"));
	
	Возврат Отбор;
	
КонецФункции // ДобавитьОтборПроживающих()

&НаСервереБезКонтекста
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокСобствениковДляОтбора(Период, СписокЗданий)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"      , КонецДня(Период));
	Запрос.УстановитьПараметр("СписокЗданий", СписокЗданий);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет.Здание В (&СписокЗданий)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период)
	|	И бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.даНет.да)";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции // ()

&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьЗначениеПоДереву(ИдентификаторВопроса, СтруктураЗначений, Отбор = Неопределено)
	
	ДеревоГолосования = РеквизитФормыВЗначение("ДеревоУчастниковГолосования", Тип("ДеревоЗначений"));
	
	ПоискВопроса = ДеревоГолосования.Строки.Найти(ИдентификаторВопроса, "ИдентификаторВопроса");
	
	Если ПоискВопроса = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Для каждого СтрокаОбъектаУчета Из ПоискВопроса.Строки Цикл
		
		Участники = СтрокаОбъектаУчета.Строки;
		
		Для каждого СтрокаУчастник Из Участники Цикл
			
			Если НЕ Отбор = Неопределено Тогда
				
				Отказ = Ложь;
				
				Для каждого ЭлементОтбора Из Отбор Цикл
					
					ЗначениеОтбора  = ЭлементОтбора.Значение;
					ЗначениеВСтроке = СтрокаУчастник[ЭлементОтбора.Ключ];
					
					Если НЕ ЗначениеВСтроке = ЗначениеОтбора Тогда
						Отказ = Истина;
					КонецЕсли; 
					
				КонецЦикла; 
				
				Если Отказ Тогда
					Продолжить;
				КонецЕсли;  
				
			КонецЕсли; 
			
			Для каждого ЭлементПоля Из СтруктураЗначений Цикл
				СтрокаУчастник[ЭлементПоля.Ключ] = ЭлементПоля.Значение;
			КонецЦикла; 
			
		КонецЦикла; 
		
	КонецЦикла;
	
	ЗначениеВРеквизитФормы(ДеревоГолосования, "ДеревоУчастниковГолосования");
	
КонецПроцедуры // () 

#КонецОбласти