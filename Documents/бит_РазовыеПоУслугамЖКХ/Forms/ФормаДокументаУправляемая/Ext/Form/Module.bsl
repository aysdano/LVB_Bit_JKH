&НаСервере
Функция ПерерасчетРанееПрименяемойСтавкиЗАМЕНАСтавкиНаСервере()
	
	//готовим данные для передачи в функцию
	ЛицевыеСчета = объект.СписокУслуг.Выгрузить(,"ЛицевойСчет"); 
	ЛицевыеСчета.Свернуть("ЛицевойСчет",);
	Услуги = Объект.Услуга;
	ВключаяРазовые = объект.ВключаяРазовые;
	КонецПериода = КонецМесяца(объект.КонПериода);
	НачалоПериода = НачалоМесяца(Объект.НачПериода);
	Организация = объект.Организация;
	ДолиПериода = ПолучитьДолюПериодаНаСервере();
	//Данные нужные для расчета
	Ставка = объект.Сумма;
	//Получаем данные для расчета
	ДанныеДляРасчета = ПолучитьДанныеДляРасчетаНаСервере(ЛицевыеСчета,Услуги,НачалоПериода,КонецПериода,ВключаяРазовые,Организация,ДолиПериода);
	//Создаем таблицу значений в которую будем писать результат расчета 	
	РезультатРасчета = Новый ТаблицаЗначений;
	РезультатРасчета.Колонки.Добавить("ЛицевойСчет");
	РезультатРасчета.Колонки.Добавить("Сумма");
	//Для каждого лицевого счета из ТЧ формы определяем сумму
	Для Каждого ТекущаяСтрока из объект.СписокУслуг Цикл
		Период = НачалоМесяца(объект.НачПериода);
		ЛицевойСчет = ТекущаяСтрока.ЛицевойСчет;
		Сумма = 0;
		Индекс = 0;
		Пока Период <= КонецМесяца(Объект.КонПериода) Цикл
			//Ищем в полученной таблице данные по периоду и лицевому счету
		    Отбор = Новый Структура;
		        Отбор.Вставить("Период",Период);
    			Отбор.Вставить("ЛицевойСчет",ЛицевойСчет);
       			СтрокаДанных = ДанныеДляРасчета.НайтиСтроки(Отбор);
			//Делаем проверку, что в таблице есть только одна строка удовлетворяющая отбору, если их меньше значит нет данных, если их больше значит запрос написан неверно
    		Если СтрокаДанных.Количество()<>1 Тогда
    			Сообщить("Нет данных за "+Период+" для Лицевого счета "+ЛицевойСчет);
    			Период = добавитьмесяц(Период,1);
			Иначе
			//Определяем объем
			    Способ = СтрокаДанных[0].СпособРасчета;
				//Если объем равен нулю, тогда объем принимаем равным площади или количеству ед. измерения
			    Если СтрокаДанных[0].Объем = 0 или СтрокаДанных[0].Объем = null Тогда
				    Если Способ = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади ТОгда 
					   	Объем = СтрокаДанных[0].ОбщаяПлощадь;
			    	ИначеЕсли Способ = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади ТОгда 
				    	Объем = СтрокаДанных[0].ЖилаяПлощадь;
					ИначеЕсли Способ = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления ТОгда 
	    				Объем = СтрокаДанных[0].КоличествоЕдиницПотребления;
					Иначе
					//Если способ расчета не входит в группу, тогда объем принимаем равным нулю, чтобы в формуле был 0, а не null
						Объем = 0;
					КонецЕсли;
				Иначе
					Объем = СтрокаДанных[0].Объем;
				КонецЕсли;
				//Проверяем что начисление не равно null
				Если СтрокаДанных[0].СуммаОборот = null Тогда Начислено = 0 Иначе Начислено = СтрокаДанных[0].СуммаОборот КонецЕсли;
				//Накапливаем сумму по месяцам
			    Итог = (Объем * Ставка - Начислено) * СтрокаДанных[0].ДоляПериода * СтрокаДанных[0].Коэффициент;
				Сумма = сумма + итог;
			    Период = добавитьмесяц(Период,1);
			КонецЕсли;
		КонецЦикла;
		//ДОбавляем строку в ТЗ
		СтрокаНТ = РезультатРасчета.Добавить();
    		СтрокаНТ.ЛицевойСчет = ЛицевойСчет;
    		СтрокаНТ.Сумма = Сумма; 
		КонецЦикла;
	//Конвертируем ТЗ в Масив и отправляем на клиента
	Массив = общегоНазначения.ТаблицаЗначенийВМассив(РезультатРасчета);
	Возврат Массив;
		
КонецФункции
