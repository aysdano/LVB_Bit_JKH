// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция СкопироватьУровень(Источник, ИмяКлюча, ИмяЗначения)
	
	Результат = Новый Соответствие;
	
	Для каждого СтрокаТаблицы Из Источник Цикл
		
		Результат.Вставить(СтрокаТаблицы[ИмяКлюча], СтрокаТаблицы[ИмяЗначения]);
		
	КонецЦикла; 
	
	Возврат Результат;
	
КонецФункции // ()

