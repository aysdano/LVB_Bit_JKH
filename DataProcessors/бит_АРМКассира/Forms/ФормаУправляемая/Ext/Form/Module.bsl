
#Область ПеременныеМодуля

Перем мСписокФизЛиц;    // Хранит список физ лиц.

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	МенеджерОборудованияВызовСервераПереопределяемый.ОбновитьПоставляемыеДрайвера();
	
КонецПроцедуры

&НаКлиенте
Процедура бит_УслугиЖКХ5Нажатие(Элемент)
	
	Заголовок = Элемент.Заголовок;
	ТекстВопроса = "Открыть кассовую смену?";
	ПоказатьВопрос(Новый ОписаниеОповещения("ОткрытиеКассовойСменыНажатиеЗавершение", ЭтотОбъект, Новый Структура("ТекстВопроса, Заголовок", ТекстВопроса, Заголовок)), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытиеКассовойСменыНажатиеЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Если РезультатВопроса=КодВозвратаДиалога.Да Тогда
		
		ПоддерживаемыеТипыВО = Новый Массив();
		ПоддерживаемыеТипыВО.Добавить("ФискальныйРегистратор");
		ПоддерживаемыеТипыВО.Добавить("ПринтерЧеков");
		ПоддерживаемыеТипыВО.Добавить("ККТ");
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ОткрытьСменуПослеВыбораУстройства", ЭтотОбъект);
		МенеджерОборудованияКлиент.ПредложитьВыбратьУстройство(ОписаниеОповещения, ПоддерживаемыеТипыВО,
			НСтр("ru='Выберите фискальное устройство'"), 
			НСтр("ru='Фискальное устройство не подключено.'"), 
			НСтр("ru='Фискальное устройство не выбрано.'"), 
			Истина,,Объект.Касса);
			
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОткрытьСменуПослеВыбораУстройства(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ОчиститьСообщения();
	ЭтотОбъект.Доступность = Ложь;
	
	ПараметрыОперации = МенеджерОборудованияКлиентСервер.ПараметрыВыполненияОперации();
	Кассир = "";
	СтандартнаяОбработка = Истина;
	МенеджерОборудованияКлиентСерверПереопределяемый.ОбработкаЗаполненияИмяКассира(Кассир, СтандартнаяОбработка); 
	ПараметрыОперации.Кассир = ?(Не СтандартнаяОбработка, Кассир, НСтр("ru='Администратор'")); 
	
	ДополнительныеПараметры = Новый Структура();
	Если МенеджерОборудованияКлиентПовтИсп.ИспользуетсяПодсистемыФискальныхУстройств() Тогда
		МодульКассовыеСменыКлиентПереопределяемый = МенеджерОборудованияКлиентПовтИсп.ОбщийМодуль("КассовыеСменыКлиентПереопределяемый");
		МодульКассовыеСменыКлиентПереопределяемый.УправлениеФУЗаполнитьДополнительныеПараметрыПередОткрытиемСмены(РезультатВыбора, ДополнительныеПараметры);
	КонецЕсли;
	
	ОповещениеПриЗавершении = Новый ОписаниеОповещения("ОперацияЗавершение", ЭтотОбъект);
	МенеджерОборудованияКлиент.НачатьОткрытиеСменыНаФискальномУстройстве(ОповещениеПриЗавершении, УникальныйИдентификатор, ПараметрыОперации, РезультатВыбора,, ДополнительныеПараметры);
	//МенеджерОборудованияКлиент.НачатьОткрытиеСменыНаФискальномУстройстве(ОповещениеПриЗавершении, УникальныйИдентификатор,,,,Объект.Касса);
	
КонецПроцедуры

&НаКлиенте
Процедура ОперацияЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	ЭтотОбъект.Доступность = Истина;
	
	ТекстСообщения = ?(РезультатВыполнения.Результат, НСтр("ru='Операция успешна завершена.'"), РезультатВыполнения.ОписаниеОшибки);
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Элементы.ПанельПоискаАдрес.Видимость = Истина;
	Элементы.ПанельПоискаОтветственный.Видимость = Ложь;
	Элементы.ПанельПоискаЛицевойСчет.Видимость = Ложь;
	
	ОборудованиеПодключено = Истина;
	
	Объект.Организация = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");
	
	ОбновитьПараметрыЖКХ();
	
	Объект.Касса = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("бит_ОсновнаяКассаККМ",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	глКассаККМ = Объект.Касса;
	
	Если НЕ ЗначениеЗаполнено(Объект.Касса) Тогда
		Объект.Касса = НайтиКассуОрганизации(Объект.Организация);
	КонецЕсли; 
	
	УстановитьВидимость();
	
	УстановкаОтбораЧекККМ();
	
КонецПроцедуры

// Процедура Установка отбора таб части чеки ккм.
//
&НаКлиенте
Процедура УстановкаОтбораЧекККМ()
	
	ЧекиККМ.Отбор.Элементы.Очистить();
	
	Эл = ЧекиККМ.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Ответственный");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнойОтветственный"
														,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	Эл = ЧекиККМ.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Касса");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = Объект.Касса;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	Эл = ЧекиККМ.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Архивный");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = Ложь;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
	Эл = ЧекиККМ.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("ПометкаУдаления");
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = Ложь;
	Эл.Использование    = Истина;
	Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьПараметрыЖКХ()
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("РазбитьОплатуКУПоДатам", Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(ТекущаяДата()), Объект.Организация, ПараметрыЖКХ);
	
	мРазделитьОплату = ПараметрыЖКХ.РазбитьОплатуКУПоДатам;
	
КонецПроцедуры

// Процедура управляет видимостью элементов формы.
//
&НаКлиенте
Процедура УстановитьВидимость()
	
	Элементы.СуммаПриход.Видимость            = Объект.ОтображатьИтог;
	Элементы.КоличествоЧеков.Видимость        = Объект.ОтображатьИтог;
	
	Элементы.ОплатаБУ.Видимость        = Истина;
	Элементы.НачисленияБУ.Видимость    = Истина;
	
	РольДоступна = РольДоступнаНаСервере("ПолныеПрава");
	
	Если РольДоступна Тогда
		
		Элементы.ОплатаБУ.Видимость        = Истина;
		Элементы.НачисленияБУ.Видимость    = Истина;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция РольДоступнаНаСервере(Роль)
	
	//АПК пункт 4 https://its.1c.ru/db/v8std/content/737/hdoc
	Возврат РольДоступна(Роль);	
	
КонецФункции	

&НаКлиенте
Процедура ПоискАдрес(Команда)
	
	Элементы.ПанельПоискаАдрес.Видимость = Истина;
	Элементы.ПанельПоискаОтветственный.Видимость = Ложь;
	Элементы.ПанельПоискаЛицевойСчет.Видимость = Ложь;
	
	ЛицевыеСчета.Отбор.Элементы.Очистить();
	Элементы.ЛицевыеСчета.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьТекущихНачислений(Команда)
	
	ТекЛицевойСчет = Элементы.ЛицевыеСчета.ТекущаяСтрока;
	
	Если ТекЛицевойСчет <> Неопределено Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ",ТекЛицевойСчет);
		ПараметрыФормы.Вставить("КлючНазначенияИспользования","АРМКассира");
		
		Форма = ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаЭлементаУправляемая",ПараметрыФормы,ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВнестиСумму(Команда)
	
	ОчиститьСообщения();
	
	ОписаниеОшибки = "";
	
	Если МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда
		
		ДополнительныеПараметры = Новый Структура;
		ДополнительныеПараметры.Вставить("Заголовок",Заголовок);
		
		ОписаниеОповещения = Новый ОписаниеОповещения("ВнестиСуммуЗавершение", ЭтотОбъект, ДополнительныеПараметры);
		МенеджерОборудованияКлиент.ПредложитьВыбратьУстройство(ОписаниеОповещения, "ФискальныйРегистратор",
		НСтр("ru = 'Выберите фискальный регистратор'"), НСтр("ru = 'Фискальный регистратор не подключен.'"));
	Иначе
		ТекстСообщения = НСтр("ru = 'Предварительно необходимо выбрать рабочее место внешнего оборудования текущего сеанса.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтобразитьИтог(Команда)
	
	Элементы.ОтобразитьИтог.Пометка = ?(Элементы.ОтобразитьИтог.Пометка, Ложь, Истина);
	Объект.ОтображатьИтог = Элементы.ОтобразитьИтог.Пометка;
	
	Элементы.СуммаПриход.Видимость            = Элементы.ОтобразитьИтог.Пометка;
	Элементы.КоличествоЧеков.Видимость        = Элементы.ОтобразитьИтог.Пометка;
	
	Если Элементы.ОтобразитьИтог.Пометка Тогда
		
		РасчетИтогов();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбнАвто(Команда)
	
	Элементы.ОбнАвто.Пометка             = ?(Элементы.ОбнАвто.Пометка, Ложь, Истина);
	Объект.ОбновлятьИтогАвтоматически = Элементы.ОбнАвто.Пометка;
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	РасчетИтогов();
	
КонецПроцедуры

// Процедура выполняет расчет итогов по чекам.
//
&НаСервере
Процедура РасчетИтогов()
	
	мОтветсвенный = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнойОтветственный",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	СуммаПриход     = 0;
	КоличествоЧеков = 0;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ЧекККМ.Ссылка) КАК КоличествоЧеков,
	|	СУММА(ВЫБОР
	|			КОГДА бит_ЧекККМ.ВидОперации = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОперацийЧекККМ.Возврат)
	|				ТОГДА -бит_ЧекККМ.СуммаОплаты
	|			ИНАЧЕ бит_ЧекККМ.СуммаОплаты
	|		КОНЕЦ) КАК СуммаОплаты
	|ИЗ
	|	Документ.бит_ЧекККМ КАК бит_ЧекККМ
	|ГДЕ
	|	бит_ЧекККМ.Касса = &Касса
	|	И (НЕ бит_ЧекККМ.ПометкаУдаления)
	|	И бит_ЧекККМ.Ответственный = &Ответственный
	|	И (НЕ бит_ЧекККМ.Архивный)";
	
	Запрос.УстановитьПараметр("Касса", Объект.Касса);
	Запрос.УстановитьПараметр("Ответственный" , мОтветсвенный);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		СуммаПриход     = Выборка.СуммаОплаты;
		КоличествоЧеков = Выборка.КоличествоЧеков;
		
	КонецЕсли; 
	
КонецПроцедуры


&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если ЗавершениеРаботы Тогда 
		ТекстПредупреждения = НСтр("ru = 'Перед завершением работы необходимо закрыть ""Рабочее место кассира"".'");
		Отказ = Истина;
		Возврат;
	КонецЕсли;
		
	ТаблицаЧековКоличество = ПолучитьТаблицуЧеков();
	
	Если НЕ ОтрицательныйОтвет
		И ТаблицаЧековКоличество >0 тогда
		ТекстВопроса = "В базе присутствуют неархивированные чеки."+Символы.ПС+
		"Рекомендуется сначала создать документ ""Оплата КУ""."+Символы.ПС+
		" Создать его сейчас? (Отмена - Не выходить из программы)";
		Отказ = Истина;

		ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗакрытиемЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНетОтмена);
        Возврат;
	КонецЕсли;
	
	ПередЗакрытиемФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        
        Если мРазделитьОплату Тогда
            
            РазбитьОплатаКУПоДатамНаСервере(Ложь);
        Иначе
            
            СоздатьОплатаКУНаСервере(Ложь);
        КонецЕсли; 
        
		Закрыть();
        
    ИначеЕсли РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		ОтрицательныйОтвет = Истина;
		Закрыть();
        
    КонецЕсли;
    
    ПередЗакрытиемФрагмент();

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытиемФрагмент()
    
    Перем НастройкиОтображенияАРМ;
    
    НастройкиОтображенияАРМ = Новый Структура("ОтображатьИтог,ОбновлятьИтогАвтоматически",Объект.ОтображатьИтог,Объект.ОбновлятьИтогАвтоматически);

КонецПроцедуры

// Процедура возвращает таблицу чеков за кассовую смену.
//
&НаСервере
Функция ПолучитьТаблицуЧеков()
	
	мОтветсвенный = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнойОтветственный",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	ТабЧеков = Новый ТаблицаЗначений;
	ТабЧеков.Колонки.Добавить("Чек", 	Новый ОписаниеТипов("ДокументСсылка.бит_ЧекККМ"));
	ТабЧеков.Колонки.Добавить("Дата", 	ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.ДатаВремя));
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЧекККМ.Ссылка КАК Чек,
	|	бит_ЧекККМ.Дата КАК Дата
	|ИЗ
	|	Документ.бит_ЧекККМ КАК бит_ЧекККМ
	|ГДЕ
	|	(НЕ бит_ЧекККМ.Архивный)
	|	И (НЕ бит_ЧекККМ.ПометкаУдаления)
	|	И бит_ЧекККМ.Касса = &Касса
	|	И бит_ЧекККМ.Ответственный = &Ответственный
	|	И бит_ЧекККМ.Проведен";
	
	Запрос.УстановитьПараметр("Касса"         , Объект.Касса);
	Запрос.УстановитьПараметр("Ответственный" , мОтветсвенный);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Чек.ЧекПробитНаККМ Тогда
			
			НоваяСтрока = ТабЧеков.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока,Выборка);
			
		Иначе
			
			Чек = Выборка.Чек.ПолучитьОбъект();
			Попытка
				
				Чек.УстановитьПометкуУдаления(Истина);
				Чек.Записать(РежимЗаписиДокумента.Запись);
				
			Исключение
				
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТабЧеков.Количество();
	
КонецФункции 

