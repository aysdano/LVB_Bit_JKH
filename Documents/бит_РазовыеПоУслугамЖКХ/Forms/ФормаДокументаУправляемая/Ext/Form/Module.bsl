|		ПО (ИСТИНА)
|ГДЕ
|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет = &ЛицевойСчет
|	И бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодВзаиморасчетов МЕЖДУ &НачалоПериода И &КонецПериода
|	И (ВложенныйЗапрос.СпособРасчета = &СпособРасчета
|			ИЛИ ВложенныйЗапрос.СпособРасчета = &СпособРасчета1)
|
|СГРУППИРОВАТЬ ПО
|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодВзаиморасчетов, МЕСЯЦ),
|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет,
|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ,
|	ВложенныйЗапрос.СпособРасчета";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("СпособРасчета", Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади);
	Запрос.УстановитьПараметр("СпособРасчета1", Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади);
	Запрос.УстановитьПараметр("НачалоПериода", Объект.НачПериода);
	Запрос.УстановитьПараметр("КонецПериода", Объект.КонПериода);
		
	РезультатЗапроса = Запрос.Выполнить();	
	НачисленныеУслуги = РезультатЗапроса.Выгрузить();
	
	//Получаем данные о площадях
	Запрос = Новый Запрос;
	Запрос.Текст = "Выбрать
|	бит_ЛицевыеСчета.Ссылка КАК Ссылка,
|	ВложенныйЗапрос.Период КАК Период,
|	ВложенныйЗапрос.ОбщаяПлощадь КАК ОбщаяПлощадь,
|	ВложенныйЗапрос.ЖилаяПлощадь КАК ЖилаяПлощадь
|ИЗ
|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
|			бит_СведенияОКвартире.Период КАК Период,
|			бит_СведенияОКвартире.Квартира КАК Квартира,
|			бит_СведенияОКвартире.ОбщаяПлощадь КАК ОбщаяПлощадь,
|			бит_СведенияОКвартире.ЖилаяПлощадь КАК ЖилаяПлощадь
|					ИЗ
|			РегистрСведений.бит_СведенияОКвартире КАК бит_СведенияОКвартире
|		ГДЕ
|			бит_СведенияОКвартире.Квартира = &Квартира) КАК ВложенныйЗапрос
|		ПО (ИСТИНА)
|ГДЕ
|	бит_ЛицевыеСчета.Ссылка = &Ссылка
|УПОРЯДОЧИТЬ ПО
|	Период";
	
		Запрос.УстановитьПараметр("Ссылка", Объект.ЛицевойСчет);
		Запрос.УстановитьПараметр("Квартира", Объект.ЛицевойСчет.Квартира);
		
		РезультатЗапроса = Запрос.Выполнить();	
	    ДанныеПоПлощадям = РезультатЗапроса.Выгрузить();
		//ЗаполняемПустыеПериоды
				
		Площадь = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(15, 2));

		Площади = новый таблицаЗначений;
		Площади.Колонки.Добавить("Период", Новый ОписаниеТипов("Дата"));
		Площади.Колонки.Добавить("ОбщаяПлощадь", Площадь);
		Площади.Колонки.Добавить("ЖилаяПлощадь", Площадь);
				
		Период = НачалоМесяца(Объект.НачПериода);
		ТекущаяДата = ДанныеПоПлощадям[0].Период;
		ТекущаяОбщаяПлощадь = ДанныеПоПлощадям[0].ОбщаяПлощадь;
		ТекущаяЖилаяПлощадь = ДанныеПоПлощадям[0].ЖилаяПлощадь;
		
		Пока Период <= НачалоМесяца(Объект.КонПериода) Цикл
			НайденнаяСтрока = ДанныеПоПлощадям.Найти(Период,"Период");
			Если НайденнаяСтрока <> неопределено Тогда НС=НайденнаяСтрока.Период	КонецЕсли;
			Если Период < ТекущаяДата Тогда
			    Строка = Площади.Добавить();
                Строка.Период = Период;
			    Строка.ОбщаяПлощадь = 0;
			    Строка.ЖилаяПлощадь = 0; 			    
			ИначеЕсли Период = НС Тогда
			    ТекущаяДата = Период;
		        ТекущаяОбщаяПлощадь = НайденнаяСтрока.ОбщаяПлощадь;
		        ТекущаяЖилаяПлощадь = НайденнаяСтрока.ЖилаяПлощадь;	
		        Строка = Площади.Добавить();
                Строка.Период = Период;
			    Строка.ОбщаяПлощадь = НайденнаяСтрока.ОбщаяПлощадь;
			    Строка.ЖилаяПлощадь = НайденнаяСтрока.ЖилаяПлощадь;
			ИначеЕсли Период > ТекущаяДата Тогда 
			    Строка = Площади.Добавить();
                Строка.Период = Период;
			    Строка.ОбщаяПлощадь = ТекущаяОбщаяПлощадь;
			    Строка.ЖилаяПлощадь = ТекущаяЖилаяПлощадь;
			КонецЕсли;
            Период = конецМесяца(Период)+1;
		КонецЦикла;
		
		
	//Создаем таблицу с результатом расчета
	ИтогРасчета = Новый ТаблицаЗначений;
	ИтогРасчета.Колонки.Добавить("Услуга");
	ИтогРасчета.Колонки.Добавить("Сумма");
	
	Для Каждого Строка Из НачисленныеУслуги Цикл
	    НайденнаяСтрока = Площади.Найти(Строка.Период);
		Если НайденнаяСтрока <> неопределено Тогда
			//определяем долю от крайних периодов
			ПосДНачалаПериода = День(КонецМесяца(объект.НачПериода));
		    ДоляВПервомПериоде = (ПосДНачалаПериода-День(Объект.НачПериода)+1)/ПосДНачалаПериода;
		    ПерДКонцаПериода = День(НачалоМесяца(объект.КонПериода));
		    ДоляВПоследнемПериоде = (день(объект.КонПериода) - ПерДКонцаПериода +1)/День(КонецМесяца(объект.КонПериода));		
		    Если месяц(Строка.Период)=месяц(объект.НачПериода)Тогда
		         ДоляПериода = ДоляВПервомПериоде; 
	        ИначеЕсли месяц(Строка.Период)=месяц(объект.КонПериода) Тогда
		         ДоляПериода = ДоляВПоследнемПериоде;
	        Иначе
		         ДоляПериода = 1;
		    КонецЕсли;
		    //РАссчитываем сумму для услуг от общей площади
			Если Строка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда
			    Если НайденнаяСтрока.ОбщаяПлощадь >0 Тогда			
			    ОтношениеПлощадей = Объект.ПлощадьОбщая/НайденнаяСтрока.ОбщаяПлощадь;
				СтрокаИтогРасчета = ИтогРасчета.Добавить();
			    СтрокаИтогРасчета.Услуга = Строка.УслугаЖКХ;
			    СтрокаИтогРасчета.Сумма = (Строка.СуммаОборот*ОтношениеПлощадей-Строка.СуммаОборот)*ДоляПериода;
			    КонецЕсли;
			//Рассчитываем сумму для услуг от жилой площади
			ИначеЕсли Строка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда
			    Если НайденнаяСтрока.ЖилаяПлощадь >0 Тогда			
			    ОтношениеПлощадей = Объект.ПлощадьЖилая/НайденнаяСтрока.ЖилаяПлощадь;
				СтрокаИтогРасчета = ИтогРасчета.Добавить();
			    СтрокаИтогРасчета.Услуга = Строка.УслугаЖКХ;
			    СтрокаИтогРасчета.Сумма = (Строка.СуммаОборот*ОтношениеПлощадей-Строка.СуммаОборот)*ДоляПериода;
			    КонецЕсли;
			КонецЕсли
			
		КонецЕсли;
	КонецЦикла;
	Перменная="";	
		ИтогРасчета.Свернуть("Услуга", "Сумма");
		Массив = ОбщегоНазначения.ТаблицаЗначенийВМассив(ИтогРасчета);
	
	Возврат Массив;
	//КонецРабот
	
