			</Type>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ
	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	бит_ЛицевыеСчета.Здание КАК Здание,
	бит_ЛицевыеСчета.Квартира КАК Квартира,
	бит_ЛицевыеСчета.Организация КАК Организация,
	бит_ЛицевыеСчета.УлицаЛицевогоСчета КАК Улица,
	бит_ЛицевыеСчета.Идентификатор КАК Идентификатор,
	бит_ЛицевыеСчета.Здание.Корпус КАК Корпус,
	ОтвЛица.ФизЛицо КАК ОтветственноеЛицо,
	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	ОтвЛица.ФизЛицо.EmailПроживающего КАК ФизЛицоEmailПроживающего
ИЗ
	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
		ИЗ
			РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&amp;Дата, ) КАК бит_ПроживающиеПоЛССрезПоследних
		ГДЕ
			(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации &gt; &amp;Дата
					ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
			И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)) КАК ОтвЛица
		ПО бит_ЛицевыеСчета.Ссылка = ОтвЛица.ЛицевойСчет
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&amp;Дата, ) КАК бит_СведенияОКвартиреСрезПоследних
		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира</QueryText>
				<MainTable>Catalog.бит_ЛицевыеСчета</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
