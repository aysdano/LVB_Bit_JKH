
#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СчетЦелевогоФинансированияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	#Если ТолстыйКлиентОбычноеПриложение Тогда
		
		СтандартнаяОбработка = Ложь;
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Родитель", ПланыСчетов.Хозрасчетный.ЦелевоеФинансирование);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Хозрасчетный.Ссылка
		|ИЗ
		|	ПланСчетов.Хозрасчетный КАК Хозрасчетный
		|ГДЕ
		|	Хозрасчетный.Родитель = &Родитель";
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Ссылка"));
		
		Форма = ПланыСчетов.Хозрасчетный.ПолучитьФормуВыбора(, Элемент);
		
		Форма.Отбор.Ссылка.ВидСравнения  = ВидСравнения.ВСписке;
		Форма.Отбор.Ссылка.Использование = Истина;
		Форма.Отбор.Ссылка.Значение      = Список;
		
		Форма.ЭлементыФормы.Список.НастройкаОтбора.Ссылка.Доступность = Ложь;
		
		Форма.Открыть();
		
	#КонецЕсли
	
КонецПроцедуры

#КонецОбласти
