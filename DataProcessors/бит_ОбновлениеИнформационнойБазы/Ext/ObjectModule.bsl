// Процедура заполняет настройки ГЦЖС по услугам.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьНасйтрокиГЦЖСПоУслугам()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_УслугиЖКХ.Ссылка КАК Услуга,
	|	бит_УслугиЖКХРежимыПотребленияУслуг.РежимПотребленияУслуг КАК РежимПотребления,
	|	бит_УслугиЖКХ.КодПоГУГЦЖС,
	|	бит_УслугиЖКХ.КодПоГУГЦЖСОбщеДом,
	|	бит_УслугиЖКХ.КодПоГУГЦЖС_КПУ,
	|	бит_УслугиЖКХ.КодПоГУГЦЖС_ДПУ,
	|	бит_УслугиЖКХ.нвл_ИспользоватьТариф КАК ИспользоватьТариф
	|ИЗ
	|	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_УслугиЖКХ.РежимыПотребленияУслуг КАК бит_УслугиЖКХРежимыПотребленияУслуг
	|		ПО бит_УслугиЖКХ.Ссылка = бит_УслугиЖКХРежимыПотребленияУслуг.Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	НаборЗаписей = РегистрыСведений.бит_НастройкиУслугВыгрузкиГЦЖС.СоздатьНаборЗаписей();
	НаборЗаписей.Прочитать();
	
	Если НаборЗаписей.Количество() > 0 Тогда
		Возврат;
	КонецЕсли;
	
	НаборЗаписей.Очистить();
	
	Пока Выборка.Следующий() Цикл
		
		Запись = НаборЗаписей.Добавить();
		ЗаполнитьЗначенияСвойств(Запись, Выборка);
		
	КонецЦикла; 
	
	НаборЗаписей.Записать(Истина);
	
КонецПроцедуры // ()

