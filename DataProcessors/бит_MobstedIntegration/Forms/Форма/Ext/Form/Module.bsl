			//НовСтрСтатус.ИД_События   = Стр.ИД_События;
		КонецЕсли;
	КонецЦикла;	
	
	Если ДокументВводПоказаний.ПоказанияПоСчетчикам.Количество()<>0 Тогда
		ДокументВводПоказаний.Записать(РежимЗаписиДокумента.Запись);
		ПОпытка
