Процедура ЗаполнитьПоШаблонуПДНаСервере()
	// Вставить содержимое обработчика.
	
	Если Объект.Услуги.количество() тогда
		ЗаполнитьУслугиНаСервере()
	КонецЕсли;
	
	
	Если Объект.ШаблонВыгрузкиГИСЖКХ.ШаблонПлатежныхДокументов и ЗначениеЗаполнено(Объект.шаблонИзвещений) тогда
		для каждого с из Объект.Услуги цикл
			с.метка = ложь;
		КонецЦикла;
		
		для каждого с из Объект.ШаблонИзвещений.Услуги цикл
			парам = новый структура;
			парам.Вставить("Услуга",с.Услуга);
			строкаУс = объект.Услуги.НайтиСтроки(парам);
			попытка 
				строкаУс[0].метка = истина;
			исключение
			КонецПопытки;
			
				
			
		КонецЦикла;

		
	КонецЕсли;
	
		
	
КонецПроцедуры

