					ОбластьСтрокаПредложениеУчастникиСобрания.Параметры.Председатель = ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), "");
					ЗначениеПараметра = ДанныеУчастников.ПредседательКвартира;
					ОбластьСтрокаПредложениеУчастникиСобрания.Параметры.Председатель_Кв = ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), "");
					ЗначениеПараметра = ДанныеУчастников.Секретарь;
					ОбластьСтрокаПредложениеУчастникиСобрания.Параметры.Секретарь = ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), "");
					ЗначениеПараметра = ДанныеУчастников.СекретарьКвартира;
					ОбластьСтрокаПредложениеУчастникиСобрания.Параметры.Секретарь_Кв = ?(ЗначениеЗаполнено(ЗначениеПараметра), Строка(ЗначениеПараметра), "");
					ЗаполнитьПараметрыСчетнойКомиссииWord(ОбластьСтрокаПредложениеУчастникиСобрания.Параметры, ДанныеУчастников, Прочерк_СчетнаяКомиссия_1, Прочерк_СчетнаяКомиссия_1_Кв, Прочерк_СчетнаяКомиссия_2, Прочерк_СчетнаяКомиссия_2_Кв, Прочерк_СчетнаяКомиссия_3, Прочерк_СчетнаяКомиссия_3_Кв, Прочерк_СчетнаяКомиссия_4, Прочерк_СчетнаяКомиссия_4_Кв, Прочерк_СчетнаяКомиссия_5, Прочерк_СчетнаяКомиссия_5_Кв);
					ОбластьСтрокаПредложениеУчастникиСобрания.Параметры.НомерПредложения = "1";
				КонецЕсли;
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьСтрокаПредложениеУчастникиСобрания);
		КонецЕсли;
	КонецЕсли;
	
	// Область ОбластьСтрокаПредложение (цикл по ПовесткаДня)
	НомерПредложения = ?(ДанныеУчастников.ЕстьУчастники, 1, 0);
	ИндексСтрокиПовестки = 0;
	Для Каждого СтрокаПовестки Из ПовесткаДня Цикл
		ТекстПредложения = ПолучитьТекстПоляПовесткиДляПечати(ИндексСтрокиПовестки, "ФормулировкаПредложенияРешенияВопроса", ШаблоныТекстаПовестки, СоответствиеПараметровПечати);
		ИндексСтрокиПовестки = ИндексСтрокиПовестки + 1;
		Если НЕ ЗначениеЗаполнено(ТекстПредложения) Тогда
			Продолжить;
		КонецЕсли;
		НомерПредложения = НомерПредложения + 1;
		ОбластьСтрокаПредложение = Макет.ПолучитьОбласть("ОбластьСтрокаПредложение");
		Если ОбластьСтрокаПредложение <> Неопределено Тогда
			Попытка
				ЗначениеПараметра = Формат(НомерПредложения, "ЧГ=");
				ОбластьСтрокаПредложение.Параметры.НомерПредложения = ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, Прочерк_НомерПредложения);
				ЗначениеПараметра = ТекстПредложения;
				ОбластьСтрокаПредложение.Параметры.Предложение = ?(ЗначениеЗаполнено(ЗначениеПараметра), ЗначениеПараметра, Прочерк_Предложение);
			Исключение
			КонецПопытки;
			ТабличныйДокумент.Вывести(ОбластьСтрокаПредложение);
		КонецЕсли;
	КонецЦикла;
	
	// Область ОбластьПодвал (только для протокола)
	Если ИмяШаблона = "ПФ_MXL_Протокол_word" Тогда
		ОбластьПодвал = Макет.ПолучитьОбласть("ОбластьПодвал");
		Если ОбластьПодвал <> Неопределено Тогда
			ТабличныйДокумент.Вывести(ОбластьПодвал);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры //HD-

