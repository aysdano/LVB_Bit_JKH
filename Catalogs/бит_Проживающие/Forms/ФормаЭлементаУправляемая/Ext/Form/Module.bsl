&НаСервере
Процедура бит_ЗаполнитьСвязанныхПредставителей(Проживающий, Представитель, УдалитьСтроку)
	
	ШаблонОшибкиЗаписать = НСтр("ru='Не удалось записать %Справочник%. %ОписаниеОшибки%'");
	ЗаписатьОбъект = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_Проживающиебит_Дети.Ссылка КАК Ссылка,
	|	бит_Проживающиебит_Дети.Проживающий КАК Проживающий
	|ИЗ
	|	Справочник.бит_Проживающие.бит_Дети КАК бит_Проживающиебит_Дети
	|ГДЕ
	|	бит_Проживающиебит_Дети.Ссылка = &Представитель
	|	И бит_Проживающиебит_Дети.Проживающий = &Проживающий";
	
	Запрос.УстановитьПараметр("Представитель", Представитель);
	Запрос.УстановитьПараметр("Проживающий", Проживающий);
	
	Если УдалитьСтроку Тогда
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		МассивДляУдаления = Новый Массив;
		
		Если Выборка.Следующий() Тогда
			
			ПредставительОбъект = Представитель.ПолучитьОбъект();
			
			Для каждого стрТЧ Из ПредставительОбъект.бит_Дети Цикл
				
				Если стрТЧ.Проживающий = Выборка.Проживающий Тогда
					МассивДляУдаления.Добавить(стрТЧ);
				КонецЕсли;
				
			КонецЦикла;
			
			Для каждого элМассива Из МассивДляУдаления Цикл
				ПредставительОбъект.бит_Дети.Удалить(элМассива);
			КонецЦикла;
			
		ЗаписатьОбъект = Истина;	
		КонецЕсли;
		
	Иначе
		
		Если Запрос.Выполнить().Пустой() Тогда
			
			ПредставительОбъект = Представитель.ПолучитьОбъект();
			
			НовСтрока = ПредставительОбъект.бит_Дети.Добавить();
			НовСтрока.Проживающий = Проживающий;
			
		КонецЕсли;	
		ЗаписатьОбъект = Истина;
	КонецЕсли;
	
	Если ЗаписатьОбъект Тогда
		
		Попытка
			ПредставительОбъект.Записать();
		Исключение
			ТекстОшибки = СтрЗаменить(ШаблонОшибкиЗаписать, "%Справочник%", Представитель);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ОписаниеОшибки%", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Представитель);
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры 

