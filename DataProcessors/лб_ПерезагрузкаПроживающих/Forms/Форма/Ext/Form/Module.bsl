&НаКлиенте
Процедура жж_ОбновитьДанныеВБазеИзРегистра(Команда)
	// Вставить содержимое обработчика.
	ж_ДополнитьЗданияВОтборЛСНаСервере();
	
	ЧислоЛС = Объект.ПерезагружаемыеЛС.Количество();
	Если ЧислоЛС>0 тогда
		СписокЛС = Новый массив(ЧислоЛС);		
		Для инд=0 по ЧислоЛС-1 цикл СписокЛС[инд] = Объект.ПерезагружаемыеЛС[инд].ЛС; КонецЦикла;
	иначе
		СписокЛС = новый массив
	КонецЕсли;	
		
	
	жж_УдалитьЗаписиРегистраПроживающиеНаЛС(СписокЛС);
	
	Если Объект.Дата<'2000-01-01' тогда
		Объект.Дата = '2018-07-01';
	КонецЕсли;	
	
	жж_ДобавитьЗаписиРегистраПроживающиеНаЛС(Объект.Дата,СписокЛС);
	
	лб_ОбновитьКолонкуОтветственныхНаСервере();
	
	сообщить("----Обновлены записи о проживающих в базе данных")
КонецПроцедуры

&НаСервереБезКонтекста
Процедура жж_УдалитьЗаписиРегистраПроживающиеНаЛС(СписокЛС);
	//Ищем где есть записи по жилым, нежилым и игнорируемым
	ПолнаяОчистка = (СписокЛС.Количество()=0);
	
	ТипыНежилых = новый массив;
	ТипыНежилых.Добавить(Справочники.бит_ТипыКвартиры.НежилоеПомещение);
	ТипыНежилых.Добавить(Справочники.бит_ТипыКвартиры.НайтиПоНаименованию("Аренда ОИ"));
	
    ЗапросНежилые = Новый запрос;
	ЗапросНежилые.УстановитьПараметр("Дата",ТекущаяДата());
	ЗапросНежилые.УстановитьПараметр("ТипыНежилых",ТипыНежилых);
	ЗапросНежилые.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияОКвартире.Квартира КАК Квартира
		|ПОМЕСТИТЬ НежилыеКвартиры
		|ИЗ
		|	РегистрСведений.бит_СведенияОКвартире КАК бит_СведенияОКвартире
		|ГДЕ
		|	бит_СведенияОКвартире.ТипКвартиры В(&ТипыНежилых)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ НежилыеКвартиры КАК НежилыеКвартиры
		|		ПО бит_ЛицевыеСчета.Квартира = НежилыеКвартиры.Квартира";
		
	НежилыеЛС = ЗапросНежилые.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");	
	
	
	Если ПолнаяОчистка = Истина тогда
		//быстро очищаем все доки "Операция бух", без учета ЛС, если полна очистка
		//и все документы "РегистрацияПроживающихПоЛС" для всех ЛС, кроме нежилых
		
		Запрос = новый запрос;
		Запрос.УстановитьПараметр("НежилыеЛС",НежилыеЛС);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_ПроживающиеПоЛС.Регистратор КАК Регистратор   
			|ИЗ
			|	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
			|ГДЕ
			|	бит_ПроживающиеПоЛС.Регистратор ССЫЛКА Документ.ОперацияБух
			|
			|СГРУППИРОВАТЬ ПО
			|	бит_ПроживающиеПоЛС.Регистратор
			|
			|ОБЪЕДИНИТЬ ВСЕ
			|
			|ВЫБРАТЬ
			|	бит_ПроживающиеПоЛС.Регистратор
			|ИЗ
			|	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
			|ГДЕ
			|	бит_ПроживающиеПоЛС.Регистратор ССЫЛКА Документ.бит_РегистрацияПроживающихПоЛС
			|	И НЕ бит_ПроживающиеПоЛС.ЛицевойСчет В (&НежилыеЛС)";
		Выборка = Запрос.Выполнить().Выбрать();
		Пока Выборка.Следующий() цикл
			ДокОбъект = Выборка.Регистратор.ПолучитьОбъект();
			Если ложь тогда ДокОбъект = Документы.бит_РегистрацияПроживающихПоЛС.СоздатьДокумент() КонецЕсли;			
			
			ДокОбъект.Движения.бит_ПроживающиеПоЛС.Очистить();
			ДокОбъект.Движения.бит_ПроживающиеПоЛС.Записать(истина);
			
			Если ТипЗнч(ДокОбъект) = Тип("ДокументОбъект.бит_РегистрацияПроживающихПоЛС") тогда
				ДокОбъект.УстановитьПометкуУдаления(истина);
				ДокОбъект.Удалить();
			КонецЕсли;	
		КонецЦикла;	            			
	КонецЕсли;		
		
	
	//убираем записи по ЛС из списка, кроме нежилых и игнорируемых в регистре
	
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("СписокЛС",СписокЛС);
	Запрос.УстановитьПараметр("НежилыеЛС",НежилыеЛС);
	Запрос.УстановитьПараметр("ПустойЛС",Справочники.бит_ЛицевыеСчета.ПустаяСсылка());
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	лб_Тест_Жильцы.ЛС КАК ЛС
		|ПОМЕСТИТЬ ИгнорируемыеЛС
		|ИЗ
		|	РегистрСведений.лб_Тест_Жильцы КАК лб_Тест_Жильцы
		|ГДЕ
		|	лб_Тест_Жильцы.Игнорировать
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Ссылка В(&НежилыеЛС)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЛС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ПроживающиеПоЛС.Регистратор КАК Регистратор,
		|	бит_ПроживающиеПоЛС.ЛицевойСчет КАК ЛицевойСчет
		|ПОМЕСТИТЬ РегистраторыПоЛС
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
		|ГДЕ
		|	бит_ПроживающиеПоЛС.ЛицевойСчет В(&СписокЛС)
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_ПроживающиеПоЛС.Регистратор,
		|	бит_ПроживающиеПоЛС.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	РегистраторыПоЛС.Регистратор КАК Регистратор,
		|	РегистраторыПоЛС.ЛицевойСчет КАК ЛицевойСчет
		|ИЗ
		|	РегистраторыПоЛС КАК РегистраторыПоЛС
		|		ЛЕВОЕ СОЕДИНЕНИЕ ИгнорируемыеЛС КАК ИгнорируемыеЛС
		|		ПО (РегистраторыПоЛС.ЛицевойСчет = ИгнорируемыеЛС.ЛС)
		|ГДЕ
		|	ЕСТЬNULL(ИгнорируемыеЛС.ЛС, &ПустойЛС) = &ПустойЛС
		|ИТОГИ ПО
		|	Регистратор";
	
	ВыборкаДоки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаДоки.Следующий() цикл
		Если ТипЗнч(ВыборкаДоки.Регистратор) = тип("ДокументСсылка.бит_РегистрацияПроживающихПоЛС") тогда
			ДокОбъект = ВыборкаДоки.Регистратор.ПолучитьОбъект();
			ДокОбъект.УстановитьПометкуУдаления(истина);
			ДокОбъект.Удалить();	
		иначе
			Набор = РегистрыСведений.бит_ПроживающиеПоЛС.СоздатьНаборЗаписей();
			Набор.Отбор.Регистратор.Значение = ВыборкаДоки.Регистратор;
			Набор.Прочитать();
			Табл = Набор.Выгрузить();
			
			ВыборкаЛС = ВыборкаДоки.Выбрать();						
			Пока ВыборкаЛС.Следующий() цикл
				Отбор = новый структура("ЛицевойСчет",ВыборкаЛС.ЛицевойСчет);
				СтрокиУдл = Табл.НайтиСтроки(Отбор);
				Для каждого СтрокаУ из СтрокиУдл цикл 
					Табл.Удалить(СтрокаУ);
				КонецЦикла;	
			КонецЦикла;	
			Набор.Загрузить(Табл);			
			Набор.Записать(истина);
		КонецЕсли;	
	КонецЦикла;		
КонецПроцедуры	

&НаСервереБезКонтекста
Процедура жж_ДобавитьЗаписиРегистраПроживающиеНаЛС(Дата,СписокЛС);
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("ОтборПоСпискуЛС",истина);
	Запрос.УстановитьПараметр("СписокЛС",СписокЛС);
	Запрос.УстановитьПараметр("Дата",Дата);
	ЗАпрос.УстановитьПараметр("временно",Перечисления.бит_СтатусПроживания.Временно);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	лб_Тест_Жильцы.ЛС КАК ЛС,
		|	лб_Тест_Жильцы.ЛС.Здание КАК ЛСЗдание,
		|	лб_Тест_Жильцы.СтатусФизлица КАК СтатусФизлица,
		|	лб_Тест_Жильцы.СтатусФизлица2 КАК СтатусФизлица2,
		|	лб_Тест_Жильцы.Организация КАК Организация,
		|	лб_Тест_Жильцы.СтепеньРодства КАК СтепеньРодства,
		|	лб_Тест_Жильцы.Жилец КАК Жилец,
		|	лб_Тест_Жильцы.ДатаПрописки КАК ДатаПрописки,
		|	лб_Тест_Жильцы.ДатаВыписки КАК ДатаВыписки,
		|	лб_Тест_Жильцы.ЭтоСобственник КАК ЭтоСобственник,
		|	лб_Тест_Жильцы.ЭтоОтветственный КАК ЭтоОтветственный,
		|	лб_Тест_Жильцы.RO КАК RO,
		|	лб_Тест_Жильцы.НужноДобавитьДопСтроку КАК НужноДобавитьДопСтроку,
		|	лб_Тест_Жильцы.СтатусПроживания КАК СтатусПроживания,
		|	лб_Тест_Жильцы.SOBST КАК SOBST,
		|	лб_Тест_Жильцы.D1 КАК D1,
		|	лб_Тест_Жильцы.D2 КАК D2,
		|	лб_Тест_Жильцы.RODOTN КАК RODOTN
		|ПОМЕСТИТЬ Т
		|ИЗ
		|	РегистрСведений.лб_Тест_Жильцы КАК лб_Тест_Жильцы
		|ГДЕ
		|	лб_Тест_Жильцы.Игнорировать = ЛОЖЬ
		|	И лб_Тест_Жильцы.ЛС В(&СписокЛС)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ПОДСТРОКА(бит_ПравоустанавливающиеДокументы.Наименование, 1, 10) КАК ИмяЛС10,
		|	МАКСИМУМ(бит_ПравоустанавливающиеДокументы.Код) КАК Код
		|ПОМЕСТИТЬ ИменаДоков
		|ИЗ
		|	Справочник.бит_ПравоустанавливающиеДокументы КАК бит_ПравоустанавливающиеДокументы
		|ГДЕ
		|	бит_ПравоустанавливающиеДокументы.Наименование ПОДОБНО ""___________""
		|
		|СГРУППИРОВАТЬ ПО
		|	ПОДСТРОКА(бит_ПравоустанавливающиеДокументы.Наименование, 1, 10)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
		|	бит_ПравоустанавливающиеДокументы.Ссылка КАК Документы
		|ПОМЕСТИТЬ ДокиПоЛС
		|ИЗ
		|	ИменаДоков КАК ИменаДоков
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ПО (ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 10) = ПОДСТРОКА(ИменаДоков.ИмяЛС10, 1, 10))
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ПравоустанавливающиеДокументы КАК бит_ПравоустанавливающиеДокументы
		|		ПО ИменаДоков.Код = бит_ПравоустанавливающиеДокументы.Код
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Т.ЛСЗдание КАК Здание,
		|	&Дата КАК Период,
		|	Т.ЛС КАК ЛицевойСчет,
		|	Т.Жилец КАК ФизЛицо,
		|	Т.СтатусФизлица КАК СтатусФизЛица,
		|	Т.СтепеньРодства КАК СтепеньРодства,
		|	Т.СтатусПроживания КАК СтатусПроживания,
		|	Т.ДатаПрописки КАК ДатаРегистрации,
		|	ВЫБОР
		|		КОГДА Т.СтатусПроживания = &Временно
		|			ТОГДА ДАТАВРЕМЯ(1, 1, 1)
		|		ИНАЧЕ Т.ДатаВыписки
		|	КОНЕЦ КАК ДатаСнятияСРегистрации,
		|	ВЫБОР
		|		КОГДА Т.СтатусПроживания = &Временно
		|			ТОГДА Т.ДатаВыписки
		|		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
		|	КОНЕЦ КАК ДатаЗаписи,
		|	ВЫБОР
		|		КОГДА Т.ЭтоСобственник
		|			ТОГДА ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
		|		ИНАЧЕ ЗНАЧЕНИЕ(Перечисление.ДаНет.Нет)
		|	КОНЕЦ КАК ВладелецКвартиры,
		|	ВЫБОР
		|		КОГДА Т.ЭтоСобственник
		|				И Т.D2 > 0
		|			ТОГДА Т.D1 / Т.D2
		|		ИНАЧЕ 0
		|	КОНЕЦ КАК ДоляПлощади,
		|	Т.СтатусФизлица2 КАК СтатусФизЛицаДляИзменения,
		|	Т.SOBST КАК лб_ДоляПлощадиСтрокой,
		|	Т.RODOTN КАК лб_СтрокаРодствДляФЛС,
		|	ЛОЖЬ КАК лб_ИгнорироватьПериодВКопииФЛС,
		|	Т.ДатаПрописки КАК лб_ДатаРегистрацииДляФЛС,
		|	Т.ДатаВыписки КАК лб_ДатаВыпискиДляФЛС,
		|	Т.НужноДобавитьДопСтроку КАК НужноДобавитьДопСтроку,
		|	ЕСТЬNULL(ДокиПоЛС.Документы, ЗНАЧЕНИЕ(Справочник.бит_ПравоустанавливающиеДокументы.ПустаяСсылка)) КАК ПравоустанавливающиеДокументы
		|ИЗ
		|	Т КАК Т
		|		ЛЕВОЕ СОЕДИНЕНИЕ ДокиПоЛС КАК ДокиПоЛС
		|		ПО Т.ЛС = ДокиПоЛС.ЛицевойСчет
		|
		|УПОРЯДОЧИТЬ ПО
		|	ФизЛицо,
		|	ДатаРегистрации
		|ИТОГИ ПО
		|	Здание";
		
	Если СписокЛС.Количество()=0 тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст,"лб_Тест_Жильцы.ЛС В(&СписокЛС)","истина");
	КонецЕсли;	
	
	
	ВыборкаДоки = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаДоки.Следующий() цикл
		Если НЕ ЗначениеЗаполнено(ВыборкаДоки.Здание) тогда
			продолжить
		КонецЕсли;	
		Регистратор = НайтиСоздатьДокОперацияБух(ВыборкаДоки.Здание,Дата);
		Набор = РегистрыСведений.бит_ПроживающиеПоЛС.СоздатьНаборЗаписей();
		Набор.Отбор.Регистратор.Значение = Регистратор;
		Набор.Прочитать();
		
	    ТекФЛ = неопределено;
		ЧислоЗаписейФЛ = 0;
		Выборка = ВыборкаДоки.Выбрать();		
		Пока Выборка.Следующий() цикл
			Если Выборка.ФизЛицо = ТекФЛ тогда
				ЧислоЗаписейФЛ = ЧислоЗаписейФЛ+1;
			иначе 
				ЧислоЗаписейФЛ = 0;
				ТекФЛ = Выборка.ФизЛицо;
			КонецЕсли;	
			Запись = Набор.Добавить();
			ЗаполнитьЗначенияСвойств(Запись,Выборка);		
			Запись.Период = Выборка.Период + ЧислоЗаписейФЛ;
			Если Выборка.НужноДобавитьДопСтроку тогда
				ЧислоЗаписейФЛ = ЧислоЗаписейФЛ+1;
				ДопЗапись = Набор.Добавить();
				ЗаполнитьЗначенияСвойств(ДопЗапись,Выборка);				
				ДопЗапись.Период = Выборка.Период +ЧислоЗаписейФЛ;
				ДопЗапись.СтатусФизЛица = Запись.СтатусФизЛицаДляИзменения;
				ДопЗапись.СтатусФизЛицаДляИзменения = Справочники.бит_СтатусФизЛица.ПустаяСсылка();
				ДопЗапись.ДатаРегистрации = Запись.ДатаСнятияСРегистрации + 24*3600;
				ДопЗапись.ДатаСнятияСРегистрации = '0001-01-01';
				ДопЗапись.лб_ИгнорироватьПериодВКопииФЛС=Истина;
			КонецЕсли;	
		КонецЦикла;	
		
		НачПериод = Дата;
		Табл = Набор.Выгрузить();
		Табл.Сортировать("ЛицевойСчет,ФизЛицо,ДатаРегистрации");
		ЧислоСтрок = Табл.Количество();
		Для Инд=0 по ЧислоСтрок-1 цикл Табл[инд].Период = НачПериод+Инд; КонецЦикла;	
		Набор.Загрузить(Табл);
		
		Набор.Записать(истина);		
	КонецЦикла;	
	
КонецПроцедуры


&НаСервереБезКонтекста
Функция НайтиСоздатьДокОперацияБух(Здание,Дата)
	Если НЕ ЗначениеЗаполнено(Здание) тогда
		возврат неопределено
	КонецЕсли;	
	
	Комментарий = "Данные по проживающим, дом "+Здание.Код;
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Комментарий",Комментарий);
	Запрос.УстановитьПараметр("Здание",Здание); 
	Запрос.УстановитьПараметр("Дата",Дата);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОперацияБух.Ссылка КАК Ссылка,
		|	ОперацияБух.ПометкаУдаления
		|		ИЛИ НАЧАЛОПЕРИОДА(ОперацияБух.Дата, ДЕНЬ) <> НАЧАЛОПЕРИОДА(&Дата, ДЕНЬ)
		|		ИЛИ ОперацияБух.Организация <> ВЫРАЗИТЬ(&Здание КАК Справочник.бит_СписокЗданий).Организация КАК НужноМенятьДок
		|ИЗ
		|	Документ.ОперацияБух КАК ОперацияБух
		|ГДЕ
		|	ОперацияБух.Комментарий ПОДОБНО &Комментарий";
	Выборка = Запрос.Выполнить().Выбрать();
		
	Если Выборка.Следующий() тогда
		Если НЕ Выборка.НужноМенятьДок тогда
			возврат выборка.Ссылка;			
		иначе
			ДокОбъект = Выборка.Ссылка.ПолучитьОбъект();
			Если ДокОбъект.ПометкаУдаления тогда
				ДокОбъект.УстановитьПометкуУдаления(ложь);
			КонецЕсли;
		КонецЕсли;					
	иначе
		ДокОбъект = Документы.ОперацияБух.СоздатьДокумент();		
	КонецЕсли;	
		
	ДокОбъект.Организация = Здание.Организация;
	ДокОбъект.Дата = НачалоДня(Дата);
	ДокОбъект.Комментарий = Комментарий;
	ДокОбъект.Содержание = Комментарий;
	ДокОбъект.Записать();
	
	возврат ДокОбъект.Ссылка;
	             
КонецФункции	

&НаСервере
Процедура лб_ОбновитьКолонкуОтветственныхНаСервере()
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Ответственный",Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
		|ПОМЕСТИТЬ ИмеющиесяЛС
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних КАК бит_ПроживающиеПоЛССрезПоследних
		|ГДЕ
		|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = &Ответственный
		|	И бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
		|
		|ИНДЕКСИРОВАТЬ ПО
		|	ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
		|	ЕСТЬNULL(ИмеющиесяЛС.ФизЛицо, ЗНАЧЕНИЕ(Справочник.бит_Проживающие.ПустаяСсылка)) КАК Ответственный
		|ИЗ
		|	ИмеющиесяЛС КАК ИмеющиесяЛС
		|		ПРАВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ПО ИмеющиесяЛС.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
		|
		|УПОРЯДОЧИТЬ ПО
		|	ЛицевойСчет,
		|	Ответственный";
	
	Табл = Запрос.Выполнить().Выгрузить();
	ТекЛС = неопределено;;
	ЧислоЛС = Табл.Количество();
	
	
	////Исходный цикл
	//Для СчетВниз=1 по ЧислоЛС цикл
	//	ТекИнд = ЧислоЛС-СчетВниз;
	//	Если ТекЛС=Табл[ТекИнд].ЛицевойСчет тогда
	//		табл.Удалить(ТекИнд)
	//	иначе
	//		ТекЛС = Табл[ТекИнд].ЛицевойСчет
	//	КонецЕсли;
	//КонецЕсли;	
	
	// Цикл одной строкой
	Для СчетВниз=1 по ЧислоЛС цикл ТекИнд = ЧислоЛС-СчетВниз; Если ТекЛС=Табл[ТекИнд].ЛицевойСчет тогда	табл.Удалить(ТекИнд)иначе ТекЛС = Табл[ТекИнд].ЛицевойСчет КонецЕсли; КонецЦикла;	

	Набор = РегистрыСведений.лб_ОтветственныеЗаЛицевыеСчета.СоздатьНаборЗаписей();
	Набор.Загрузить(Табл);
	Набор.Записать(истина);
КонецПроцедуры	
