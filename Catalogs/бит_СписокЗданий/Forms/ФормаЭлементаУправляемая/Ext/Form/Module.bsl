// Процедура заполняет данными закладку "Групповые счетчики".
//
&НаСервере
Процедура ЗаполнитьОписания()
	
	ПараметрыЖКХ = Новый Структура;
	
	ПараметрыЖКХ.Вставить("РасчетСУчетомДолейВладения", Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецМесяца(ТекущаяДата()), Объект.Организация, ПараметрыЖКХ);
	
	РасчетДолей = ПараметрыЖКХ.РасчетСУчетомДолейВладения;
	
	ТЗГрупповыеСчетчики = РеквизитФормыВЗначение("ГрупповыеСчетчики");
	
	ТЗГрупповыеСчетчики.Очистить();
	
	ТЗТаблицаРасшифровки = РеквизитФормыВЗначение("ТаблицаРасшифровки");
	
	ТЗТаблицаРасшифровки.Очистить();	
	
	ТЗРаспределения = РеквизитФормыВЗначение("Распределения");
	
	ТЗРаспределения.Очистить();	
	
	ТЗТаблицаРасшифровкиРаспределений = РеквизитФормыВЗначение("ТаблицаРасшифровкиРаспределений");
	
	ТЗТаблицаРасшифровкиРаспределений.Очистить();	
	
	СписокЛС = Новый СписокЗначений;
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Здание = &Здание
	|	И бит_ЛицевыеСчета.УлицаЛицевогоСчета = &УлицаЛицевогоСчета
	|	И бит_ЛицевыеСчета.Организация = &Организация";
	
	Запрос.УстановитьПараметр("УлицаЛицевогоСчета", Объект.Улица);
	Запрос.УстановитьПараметр("Здание"            , Объект.Ссылка);
	Запрос.УстановитьПараметр("Организация"       , Объект.Организация);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокЛС = Результат.ВыгрузитьКолонку("ЛицевойСчет");
	
	СписокЗданий = Новый Массив;
	
	СписокЗданий.Добавить(Объект.Ссылка);
	
	ТЗТаблицаРасшифровки              = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
	ТЗТаблицаРасшифровкиРаспределений = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуРаспредилений();
	
	бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(ТекущаяДата(), Объект.Организация, СписокЛС, СписокЗданий, , , , ТЗТаблицаРасшифровки, ТЗТаблицаРасшифровкиРаспределений, , Истина, , РасчетДолей);
	
	ТаблицаРасшифровки.Загрузить(ТЗТаблицаРасшифровки);
	ТаблицаРасшифровкиРаспределений.Загрузить(ТЗТаблицаРасшифровкиРаспределений);
	
	Запрос.Текст  = 
	"ВЫБРАТЬ
	|	ТаблицаСч.Счетчик,
	|	ТаблицаСч.Услуга,
	|	ТаблицаСч.СпособРасчета,
	|	ТаблицаСч.ОтПоказаний,
	|	ТаблицаСч.ДоПоказаний,
	|	ТаблицаСч.КоличествоЕдиниц,
	|	ТаблицаСч.ПлановаяСтавка,
