&НаСервере
Функция ПерерасчетИзЗаИзмененияПлощадиНаСервере()

		ЛицевыеСчета = объект.ЛицевойСчет;
	
	    Услуги = объект.СписокУслуг.Выгрузить(,"Услуга");
        Услуги.Свернуть("Услуга",);
	
	Ставки = ПолучитьСтавкиНаУслугиНаСервере(ЛицевыеСчета,Услуги);
	Начисления = ПолучитьНачисленияПоУслугамЖКХНаСервере(ЛицевыеСчета,Услуги);
	ДолиПериода = ПолучитьДолюПериодаНаСервере();
	
	ИтогРасчета = Новый ТаблицаЗначений;
	ИтогРасчета.Колонки.Добавить("Услуга");
	ИтогРасчета.Колонки.Добавить("Сумма");
	 	
	Для Каждого Строка из Услуги Цикл
		//МенямНачалоМесяца На КонецМесяца и меняется алгоритм для следующего периода
		Период = КонецМесяца(Объект.НачПериода);
		Сумма = 0;
		Пока Период <= КонецМесяца(объект.КонПериода) Цикл
			Отбор = Новый Структура;                 
			    Отбор.Вставить("Услуга",Строка.Услуга);  
			    отбор.Вставить("ПериодВТ",Период);
			    СтрокаСтавка = Ставки.НайтиСтроки(Отбор);
			Если СтрокаСтавка.Количество()= 0 Тогда 
				сообщить("Нет ставок по "+строка.Услуга+" за "+период);
				Период = КонецМесяца(Период+1);
			Иначе	
			    Отбор = Новый Структура;                                     
			        Отбор.Вставить("Услуга",Строка.Услуга);                     
			        Отбор.Вставить("Период",НачалоМесяца(Период));                  
			        СтрокаНачислено = Начисления.НайтиСтроки(Отбор);
			    Если СтрокаНачислено.Количество()= 0 Тогда
			        сообщить("Нет начислений по "+строка.Услуга+" за "+период);
					Период = КонецМесяца(Период+1);
				Иначе
					Отбор = Новый Структура;                           
			            Отбор.Вставить("Период",Период);                     
			            СтрокаДоляПериода = ДолиПериода.НайтиСтроки(Отбор);				                                  
					СпособРасчета = СтрокаСтавка[0].СпособРасчета;       
					Ставка = СтрокаСтавка[0].ОсновнаяСтавка;              
					Если СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда  
						Площадь = объект.ПлощадьЖилая;                                                  
					ИначеЕсли СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда 
						Площадь = Объект.ПлощадьОбщая;                                                       
					ИначеЕсли СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления Тогда  
						Площадь = Объект.ПлощадьДляКапремонта; 
					Иначе
						Сообщить("Способ расчета для "+Строка.Услуга+"не подходит для данного документа");
					КонецЕсли;
						Начислено = СтрокаНачислено[0].СуммаОборот;           
						ДоляПериода = СтрокаДоляПериода[0].ДоляПериода;          
						Сумма = (Площадь*ставка-начислено)*доляПериода;       
						СтрокаНТ = ИтогРасчета.Добавить();      
						СтрокаНТ.Услуга = строка.Услуга;       
						СтрокаНТ.Сумма = Сумма;                 
						Период = КонецМесяца(Период+1);
					
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
	КоНецЦикла;
	
	ИтогРасчета.Свернуть("Услуга","Сумма");
		
	Массив = ОбщегоНазначения.ТаблицаЗначенийВМассив(ИтогРасчета);
	
	Возврат Массив;
		
КонецФункции

&НаСервере
Функция ПерерасчетПоЕдиницамПотребленияНаСервере()

		ЛицевыеСчета = объект.ЛицевойСчет;
		Услуги = Объект.Услуга;

	Ставки = ПолучитьСтавкиНаУслугиНаСервере(ЛицевыеСчета,Услуги);
	Начисления = ПолучитьНачисленияПоУслугамЖКХНаСервере(ЛицевыеСчета,Услуги);
	ДолиПериода = ПолучитьДолюПериодаНаСервере();
		
	ИтогРасчета = Новый ТаблицаЗначений;
	ИтогРасчета.Колонки.Добавить("Сумма");
	
	Период = КонецМесяца(Объект.НачПериода);
	Пока Период <= КонецМесяца(объект.Конпериода) Цикл 		
		Отбор = Новый Структура;      
			отбор.Вставить("ПериодВТ",Период);            
			СтрокаСтавка = Ставки.НайтиСтроки(Отбор);
		Если СтрокаСтавка.Количество()<>1 Тогда
			Сообщить ("Нет ставок для "+объект.Услуга);
			Период = КонецМесяца(Период+1);
		Иначе
			Отбор = Новый Структура;
			    Отбор.Вставить("Период", НачалоМесяца(Период));
				СтрокаНачисления = Начисления.НайтиСтроки(отбор);
			Если СтрокаНачисления.Количество() <>1 Тогда
				Начислено = 0;
			Иначе
				Начислено = строкаНачисления[0].СуммаОборот;
			КонецЕсли;
			Отбор = Новый Структура;
				Отбор.Вставить("Период", Период);
				СтрокаДолиПериода = ДолиПериода.НайтиСтроки(отбор);
			Ставка = СтрокаСтавка[0].СверхНормативнаяСтавка;
			ДоляПериода = СтрокаДолиПериода[0].ДоляПериода;
			СтрокаНТ = ИтогРасчета.Добавить();
			СтрокаНТ.Сумма = (объект.КоличествоЕдиницПотребления*Ставка - Начислено)*ДоляПериода;
			Период = КонецМесяца(Период+1);
		КонецЕсли;
	КонецЦикла;
	
	ИтогРасчета.Свернуть(,"Сумма");
	
	Массив = ОбщегоНазначения.ТаблицаЗначенийВМассив(ИтогРасчета);

Возврат Массив;   
	                      
КонецФункции

&НаСервере
Функция ПерерасчетПоЕдиницамПотребленияГрупповоеНаСервере()

	ЛицевыеСчета = объект.СписокУслуг.Выгрузить(,"ЛицевойСчет"); 
	ЛицевыеСчета.Свернуть("ЛицевойСчет",);
	
	Услуги = объект.СписокУслуг.Выгрузить(,"Услуга");
    Услуги.Свернуть("Услуга",);
	
	ДолиПериода = ПолучитьДолюПериодаНаСервере();    
	Ставки = ПолучитьСтавкиНаУслугиНаСервере(ЛицевыеСчета,Услуги);
	Начисления = ПолучитьНачисленияПоУслугамЖКХНаСервере(ЛицевыеСчета,Услуги);
	
		
	ИтогРасчета = Новый ТаблицаЗначений;
	ИтогРасчета.Колонки.Добавить("ЛицевойСчет");
	ИтогРасчета.Колонки.Добавить("Услуга");
	ИтогРасчета.Колонки.Добавить("Сумма");
	
	Для Каждого ТекущаяСтрока из объект.СписокУслуг Цикл
		Период = КонецМесяца(объект.НачПериода);
		ЛицевойСчет = ТекущаяСтрока.ЛицевойСчет;  
		Услуга = ТекущаяСтрока.Услуга;
	    Пока Период <= КонецМесяца(Объект.КонПериода) Цикл
		    Отбор = Новый Структура;
		        Отбор.Вставить("ПериодВТ",Период);
    			Отбор.Вставить("ЛицевойСчет",ЛицевойСчет);
    			Отбор.Вставить("Услуга",Услуга);
    			СтрокаСтавок = Ставки.НайтиСтроки(Отбор);
    		Если СтрокаСтавок.Количество()<>1 Тогда
    			Сообщить("Нет ставки за "+Период+" по услуге "+Услуга+" для Лицевого счета "+ЛицевойСчет);
    			Период = КонецМесяца(Период+1);
    		Иначе
    			Отбор = Новый Структура;
    			    Отбор.Вставить("Период",НачалоМесяца(Период));      
    				Отбор.Вставить("ЛицевойСчет",ЛицевойСчет); 
    				Отбор.Вставить("Услуга",Услуга);
    				СтрокаНачислений = Начисления.НайтиСтроки(Отбор);
    		    Если СтрокаНачислений.Количество()<>1 Тогда
    			    Сообщить("Нет начисления за "+Период+" по услуге "+Услуга+" для Лицевого счета "+ЛицевойСчет);
					Период = КонецМесяца(Период+1);
    			Иначе
    				Отбор = Новый Структура;
    				    Отбор.Вставить("Период",Период);
    					СтрокаДолейПериода = ДолиПериода.НайтиСтроки(Отбор);
    				Начислено = СтрокаНачислений[0].СуммаОборот;
    				Ставка = СтрокаСтавок[0].СверхНормативнаяСтавка;
    				Доляпериода = СтрокаДолейПериода[0].ДоляПериода;
    				СтрокаНТ = ИтогРасчета.Добавить();
    				СтрокаНТ.ЛицевойСчет = ЛицевойСчет;
    				СтрокаНТ.Услуга = Услуга;
    				СтрокаНТ.Сумма = (объект.КоличествоЕдиницПотребления*Ставка - Начислено)*ДоляПериода;
    				Период = КонецМесяца(Период+1);
    			КонецЕсли;
    		КонецЕсли;
    	КонецЦикла;
	КонецЦикла;
	
	ИтогРасчета.Свернуть("ЛицевойСчет,Услуга","Сумма");
	Массив = общегоНазначения.ТаблицаЗначенийВМассив(ИтогРасчета);
	Возврат Массив;
КонецФункции

