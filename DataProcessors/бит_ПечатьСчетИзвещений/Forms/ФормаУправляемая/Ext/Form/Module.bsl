КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПлатежныеДокументыГИСЖКХ(Команда)
	
	Если ЗначениеЗаполнено(АдресХранилщаДанныхГИСЖКХ) Тогда
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПлатежныеДокументыГИСЖКХЗавершение", ЭтотОбъект)
		, "Будут созданы платежные документы ГИС ЖКХ за " + НРег(ПредставлениеПериодаРегистрации) + " года. Продолжить?"
		, РежимДиалогаВопрос.ДаНет); 
	
	Иначе
		ТекстСообщения = НСтр("ru = 'Отсутствуют данные для передачи в ГИС ЖКХ.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПлатежныеДокументыГИСЖКХЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОчиститьСообщения();
		ЗаполнитьПлатежныеДокументыГИСЖКХСервер(АдресХранилщаДанныхГИСЖКХ, Объект.Период, Объект.ШаблонИзвещений);
	КонецЕсли;

КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьПлатежныеДокументыГИСЖКХСервер(АдресХранилщаДанных, Период, ШаблонИзвещений)
	
	ПредставлениеПериодаРегистрации = Формат(Период, "ДФ='ММММ гггг'");
	СтруктураПД = ПолучитьИзВременногоХранилища(АдресХранилщаДанных);
	ТаблицаПлатежиГИСЖКХ12			= СтруктураПД.ТаблицаПлатежиГИСЖКХ12;
	ТаблицаПлатежиГИСЖКХ36			= СтруктураПД.ТаблицаПлатежиГИСЖКХ36;
	ТаблицаПлатежиГИСЖКХДПД			= СтруктураПД.ТаблицаПлатежиГИСЖКХДПД;
	ТаблицаПлатежиГИСЖКХНеустойки	= СтруктураПД.ТаблицаПлатежиГИСЖКХНеустойки;
	
	Если ТаблицаПлатежиГИСЖКХ12.Количество() = 0
		И ТаблицаПлатежиГИСЖКХ36.Количество() = 0
		И ТаблицаПлатежиГИСЖКХДПД.Количество() = 0 
		И ТаблицаПлатежиГИСЖКХНеустойки.Количество() = 0 Тогда
		
		ТекстСообщения = НСтр("ru = 'Отсутствуют данные для формирования документов,
									|полученные согласно макету квитанции платежного документа РК924 (ГИС ЖКХ)!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ТаблицаПлатежныхДокументов = ТаблицаПлатежиГИСЖКХ12.Скопировать(,"ЛицевойСчет, РасчетныйПериод, ТабличнйДокумент");
	ТаблицаПлатежныхДокументов.Свернуть("ЛицевойСчет, РасчетныйПериод, ТабличнйДокумент");
	
	ПараметрыПровеки = Новый Структура();
	ПараметрыПровеки.Вставить("Период"				 , Период);
	ПараметрыПровеки.Вставить("ЛицевыеСчета"		 , ТаблицаПлатежныхДокументов.ВыгрузитьКолонку("ЛицевойСчет"));
	ПараметрыПровеки.Вставить("ШаблонИзвещений"		 , ШаблонИзвещений);
	ПараметрыПровеки.Вставить("ПредставлениеПериода" , ПредставлениеПериодаРегистрации);
	
	Если Справочники.бит_ПлатежныеДокументыГИСЖКХ.ЕстьВыгрузка(ПараметрыПровеки) Тогда
		Возврат;	
	КонецЕсли;
	
	НачатьТранзакцию();
	
	// Создание пачки документов.
	ГруппаВыгрузки = Справочники.бит_ПлатежныеДокументыГИСЖКХ.ПолучитьГруппуДокументов(Период);
	
	Если НЕ ЗначениеЗаполнено(ГруппаВыгрузки.Ссылка) Тогда
		ГруппаВыгрузки.Наименование	= ПредставлениеПериодаРегистрации;
		ГруппаВыгрузки.РасчетныйПериод	= Период;
		Попытка
			ГруппаВыгрузки.Записать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = НСтр("ru = '%1'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки; 
	КонецЕсли;
	
	ТЗОбновления = Справочники.бит_ПлатежныеДокументыГИСЖКХ.ПолучитьДокументы(ПараметрыПровеки);
	
	// Создание "Платежных документов".
	Для Каждого Стр Из ТаблицаПлатежныхДокументов Цикл
		
		Кэштаб = Неопределено;
		ПлатДокГИСЖКХ = ТЗОбновления.Найти(Стр.ЛицевойСчет, "ЛицевойСчет");
		Если ПлатДокГИСЖКХ = Неопределено Тогда
			ПлатежныйДокумент = Справочники.бит_ПлатежныеДокументыГИСЖКХ.СоздатьЭлемент();
		Иначе	
			ПлатежныйДокумент = ПлатДокГИСЖКХ.Ссылка.ПолучитьОбъект();	
		КонецЕсли;
		
		ПлатежныйДокумент.Наименование	  = "Платежный документ ГИС ЖКХ по ЛС " + Строка(Стр.ЛицевойСчет) + " (" + ПредставлениеПериодаРегистрации + ")";
		ПлатежныйДокумент.Родитель		  = ГруппаВыгрузки.Ссылка;
		ПлатежныйДокумент.ЛицевойСчет	  = Стр.ЛицевойСчет;
		ПлатежныйДокумент.ШаблонИзвещений = ШаблонИзвещений;
		ПлатежныйДокумент.РасчетныйПериод = Стр.РасчетныйПериод;
		ПлатежныйДокумент.Ответственный	  = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
		
		// Технические тч.
		ПлатежныйДокумент.ТаблицаПлатежиГИСЖКХ12.Загрузить(ТаблицаПлатежиГИСЖКХ12.Скопировать(Новый Структура("ЛицевойСчет", Стр.ЛицевойСчет)));
		ПлатежныйДокумент.ТаблицаПлатежиГИСЖКХ36.Загрузить(ТаблицаПлатежиГИСЖКХ36.Скопировать(Новый Структура("ЛицевойСчет", Стр.ЛицевойСчет)));
		ПлатежныйДокумент.ТаблицаПлатежиГИСЖКХДПД.Загрузить(ТаблицаПлатежиГИСЖКХДПД.Скопировать(Новый Структура("ЛицевойСчет", Стр.ЛицевойСчет)));
		ПлатежныйДокумент.ТаблицаПлатежиГИСЖКХНеустойки.Загрузить(ТаблицаПлатежиГИСЖКХНеустойки.Скопировать(Новый Структура("ЛицевойСчет", Стр.ЛицевойСчет)));
		
		// Уникальный номер документа, для ГИС ЖКХ.
		УникальнаяНомерПД = Формат(Стр.РасчетныйПериод, "ДФ='ММгггг'") + бит_ОбщегоНазначения.ДополнитьСтроку(Строка(Стр.ЛицевойСчет),12)
							+ Строка(ПолучитьЗначениеРеквизитаОбъекта(ШаблонИзвещений, "Код"));
		ПлатежныйДокумент.НомерПД = УникальнаяНомерПД;
		
		Попытка
			ПлатежныйДокумент.Записать();
		Исключение
			ИнформацияОбОшибке = ИнформацияОбОшибке();
			ТекстСообщения = НСтр("ru = '%1'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			ОтменитьТранзакцию();
			Возврат;
		КонецПопытки;
		
		ПараметрыЗаписиПД = Новый Структура();
		ПараметрыЗаписиПД.Вставить("Период", Период);
		ПараметрыЗаписиПД.Вставить("Файл", Стр.ТабличнйДокумент);
		ФайлПД =  ПлатежныйДокумент.ПрисоденитьФайл(ПараметрыЗаписиПД);
		Если НЕ ЗначениеЗаполнено(ФайлПД) Тогда
			ОтменитьТранзакцию();	
		КонецЕсли;

	КонецЦикла;
	
	// БИТ ЖКх 17.02.2020
	Если ЗначениеЗаполнено(ФайлПД) Тогда
	 ЗафиксироватьТранзакцию();
	конецесли; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура СтрокаПериодПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.СтрокаПериод) Тогда
		Объект.СтрокаПериод = бит_РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(Объект.Период);
	КонецЕсли;
	
	ОбновитьНастройкиЖКХ();
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПериодНачалоВыбораИзСписка(Элемент, СтандартнаяОбработка)
	
	НачальнаяДатаДокумента = Объект.Период;
	
	бит_РаботаСДиалогами.НачалоВыбораИзСпискаПредставленияПериодаРегистрации(Элемент, СтандартнаяОбработка, Объект.Период, ЭтаФорма);
	Объект.СтрокаПериод  = бит_РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(Объект.Период);
	Объект.Период = КонецМесяца(Объект.Период);
	
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаНачало", НачалоМесяца(Объект.Период));
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаКонец" , КонецМесяца(Объект.Период));
	
	Элементы.ТаблицаПисем.Обновить();
	
	ИзменитьСостояниеТабличногоПоля("НЕАКТУАЛЬНОСТЬОТЧЕТА");
	
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПериодОчистка(Элемент, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура СтрокаПериодРегулирование(Элемент, Направление, СтандартнаяОбработка)
	
	НачальнаяДатаДокумента = Объект.Период;
	
	ТекущаяДата = ?(Направление > 0, Объект.Период, ДобавитьМесяц(Объект.Период, -1));
	бит_РаботаСДиалогами.РегулированиеПредставленияПериодаРегистрации(Направление, СтандартнаяОбработка, ТекущаяДата, Объект.СтрокаПериод);
	Объект.Период = КонецМесяца(ТекущаяДата);
	
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаНачало", НачалоМесяца(Объект.Период));
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаКонец" , КонецМесяца(Объект.Период));
	
	Элементы.ТаблицаПисем.Обновить();
	
	ИзменитьСостояниеТабличногоПоля("НЕАКТУАЛЬНОСТЬОТЧЕТА");
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправительПредставлениеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.УчетнаяЗапись <> ВыбранноеЗначение Тогда
		
		Объект.УчетнаяЗапись = ВыбранноеЗначение;
		ЭлементСписка = Элемент.СписокВыбора.НайтиПоЗначению(ВыбранноеЗначение);
		Если ЭлементСписка <> Неопределено Тогда
			СтандартнаяОбработка = Ложь;
			Объект.ОтправительПредставление = ЭлементСписка.Представление;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

