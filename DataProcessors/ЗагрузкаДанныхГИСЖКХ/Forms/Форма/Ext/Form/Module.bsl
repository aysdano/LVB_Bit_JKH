&НаСервере
Процедура ОчиститьВсеДанныеНаСервере()
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.ЕЛСГИСЖКХ <> """"
		|	ИЛИ бит_ЛицевыеСчета.ИдентификаторЖКУ <> """"
		|	ИЛИ бит_ЛицевыеСчета.КапРемЕЛСГИСЖКХ <> """"
		|	ИЛИ бит_ЛицевыеСчета.КапРемИдентификаторЖКУ <> """"
		|	ИЛИ бит_ЛицевыеСчета.Квартира.УникальныйНомерГИСЖКХ <> """"";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		ЛС = ВыборкаДетальныеЗаписи.Ссылка.ПолучитьОбъект();
		ЛС.КапРемЕЛСГИСЖКХ 			= "";
		ЛС.КапРемИдентификаторЖКУ 	= "";
		ЛС.ЕЛСГИСЖКХ 				= "";
		ЛС.ИдентификаторЖКУ 		= "";
		ЛСКвартираОбъект = ЛС.Квартира.ПолучитьОбъект();
		ЛСКвартираОбъект.УникальныйНомерГИСЖКХ = "";
		ЛСКвартираОбъект.Записать();
		ЛС.Записать();
	КонецЦикла;
КонецПроцедуры

