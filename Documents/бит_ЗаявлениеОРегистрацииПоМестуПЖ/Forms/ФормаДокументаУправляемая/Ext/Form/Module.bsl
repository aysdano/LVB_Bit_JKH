	                            |	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ.СнимаемыеСРегУчета КАК бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета
	                            |ГДЕ
	                            |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Проживающий = &РегЛицо";
		ЗапросДатаСнятияГрупповоеСнятие.УстановитьПараметр("РегЛицо", Объект.РегистрируемоеЛицо);
	
		ВыборкаДатаРегистрации = ЗапросДатаСнятияГрупповоеСнятие.Выполнить().Выбрать();
	
		Если ВыборкаДатаРегистрации.Следующий() Тогда
			ДанныеПечати.ДатаРегистрации = ВыборкаДатаРегистрации.ДатаРегистрации;
		КонецЕсли;
		
	КонецЕсли;
	
	ЗапросДатаСнятияГрупповоеСнятие = Новый Запрос;
	ЗапросДатаСнятияГрупповоеСнятие.Текст = "ВЫБРАТЬ
	                            |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Проживающий КАК Проживающий,
	                            |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.ДатаРегистрации КАК ДатаРегистрации
	                            |ИЗ
	                            |	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ.СнимаемыеСРегУчета КАК бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета
	                            |ГДЕ
	                            |	бит_ЗаявлениеОРегистрацииПоМестуПЖСнимаемыеСРегУчета.Проживающий = &РегЛицо";
	ЗапросДатаСнятияГрупповоеСнятие.УстановитьПараметр("РегЛицо", Объект.РегистрируемоеЛицо);
	
	ВыборкаДатаРегистрации = ЗапросДатаСнятияГрупповоеСнятие.Выполнить().Выбрать();
	
	Если ВыборкаДатаРегистрации.Следующий() Тогда
		ДатаРегистрации = ВыборкаДатаРегистрации.ДатаРегистрации;
	КонецЕсли;

	
	
	ВыданДокумент_1 = "";
	ВыданДокумент_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ДанныеПечати.ВыданДокумент, 42, ВыданДокумент_1 , ВыданДокумент_2 );
	ДанныеПечати.Вставить("ВыданДокумент_1", ВРЕГ(ВыданДокумент_1));
	ДанныеПечати.Вставить("ВыданДокумент_2", ВРЕГ(ВыданДокумент_2));
	
	СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(ДанныеПечати.МестоРождения);
	
	
