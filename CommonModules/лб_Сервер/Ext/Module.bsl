// Функция - Режимы потребления газ по нормативу
// 
// Возвращаемое значение:
//  массив - массив ,тип элементов  СправочникСсылка.бит_РежимыПотребленияУслуг,
//           массив, содержащий режимы потребления для расчетов по нормативу
//
Функция РежимыПотребленияГазПоНормативу(Дата = неопределено) экспорт
	ГазПоСчетчику = РежимПотрбленияГазПоСчетчикам(Дата);
	УслугаГаз = лб_ПолучитьНастройкуРС("УслугаГазоснабжения",Дата);
	Если ложь тогда УслугаГаз = Справочники.бит_УслугиЖКХ.ПустаяСсылка() КонецЕсли;
	Результат = новый массив;
	Если ЗначениеЗаполнено(УслугаГаз) тогда
		Для каждого СтрокаТЧ из УслугаГаз.РежимыПотребленияУслуг цикл
			Если СтрокаТЧ.РежимПотребленияУслуг <> Справочники.бит_РежимыПотребленияУслуг.НеНачислять и 
					СтрокаТЧ.РежимПотребленияУслуг <> Справочники.бит_РежимыПотребленияУслуг.Нет и 
					СтрокаТЧ.РежимПотребленияУслуг <> ГазПоСчетчику тогда
				Результат.Добавить(СтрокаТЧ.РежимПотребленияУслуг);	
			КонецЕсли;		
		КонецЦикла;			
	КонецЕсли;
	
	возврат результат;
КонецФункции	

// Функция - Услуги содержание ремонт ОДН
// 
// Возвращаемое значение:
//   массив - массив ,тип элементов  СправочникСсылка.бит_УслугиЖКХ,
//           содержащит услуги Содержание и ремонт, и услуги ОДН 
//
//
Функция УслугиСодержаниеРемонтОДН(Дата = неопределено) экспорт        
	МассУслуг = Новый Массив();
	МассУслуг.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001"));
	МассУслуг.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000004"));
	МассУслуг.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000003"));
	МассУслуг.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000005"));
	МассУслуг.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000002"));
	возврат МассУслуг;//лб_ПолучитьНастройкуМассивУслуг("УслугиСодержаниеРемонтСОИ",Дата);	
КонецФункции	

Функция УслугаСодержаниеРемонт(Дата = неопределено) экспорт
	возврат Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001");//лб_ПолучитьНастройкуРС("УслугаСодержанииеИРемонт",Дата);
КонецФункции	

Функция УслугиОДН(Дата = неопределено) экспорт
	Результат = УслугиСодержаниеРемонтОДН(Дата);
	Если ложь тогда Результат = новый массив КонецЕсли;
	УслугаСРЖ = УслугаСодержаниеРемонт(Дата);
	ЧислоУслуг = Результат.Количество();
	Для СчетВниз = 1 по ЧислоУслуг цикл
		Если Результат[ЧислоУслуг-СчетВниз]=УслугаСРЖ тогда
			Результат.Удалить(ЧислоУслуг-СчетВниз);
		КонецЕсли;	
	КонецЦикла;	
	возврат Результат;
КонецФункции	

