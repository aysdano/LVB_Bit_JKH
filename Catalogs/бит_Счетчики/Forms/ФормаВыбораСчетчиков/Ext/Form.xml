				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	бит_Счетчики.Ссылка,
	бит_Счетчики.ТипСчетчика,
	бит_Счетчики.ВидСчетчика,
	бит_Счетчики.Разрядность,
	бит_Счетчики.Наименование,
	бит_Счетчики.Код
ИЗ
	Справочник.бит_Счетчики КАК бит_Счетчики
ГДЕ
	бит_Счетчики.ТипСчетчика = &amp;ТипСчетчика
	И бит_Счетчики.Ссылка В
			(ВЫБРАТЬ РАЗЛИЧНЫЕ
				бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик КАК Счетчик
			ИЗ
				РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&amp;Период, ТипСчетчика = &amp;ТипСчетчика
					И Объект = &amp;Объект
					И ИСТИНА) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
			ГДЕ
				бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать)</QueryText>
				<MainTable>Catalog.бит_Счетчики</MainTable>
