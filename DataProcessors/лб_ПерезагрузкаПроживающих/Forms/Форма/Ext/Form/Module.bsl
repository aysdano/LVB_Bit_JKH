		ЗаменитьЕслиНовое(ОбъектКвартира.Наименование,ИмяКвартиры,ЕстьИзменения);		
		ЗаменитьЕслиНовое(ОбъектКвартира.НомерКвартиры,Стру.КвНомер,ЕстьИзменения);
