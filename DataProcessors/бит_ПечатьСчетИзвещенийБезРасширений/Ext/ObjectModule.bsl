		Массив = Новый Массив;
		СтепеньБлагоустройстваХГВС = лб_Сервер.СвойствоЗдания(ДатаПолученияДанных, мСтруктураДанных.ЛицевойСчет.Здание, "СтепеньБлагоустройстваХГВС");
		СтепеньБлагоустройстваЭЭ = лб_Сервер.СвойствоЗдания(ДатаПолученияДанных, мСтруктураДанных.ЛицевойСчет.Здание, "СтепеньБлагоустройстваЭЭ");
		
		Если СтепеньБлагоустройстваХГВС <> Неопределено Тогда
			Массив.Добавить(СтепеньБлагоустройстваХГВС)
		КонецЕсли;
		Если СтепеньБлагоустройстваЭЭ <> Неопределено Тогда
			Массив.Добавить(СтепеньБлагоустройстваЭЭ)
		КонецЕсли;
		
		ЗаполнитьЗначенияСвойств(ОбластьЧастьЦентрНижняяЧасть4.Параметры, лб_КоличествоОДН(мСтруктураДанных.лб_НастройиПечатиКвитанции, мСтруктураДанных.ЛицевойСчет.Здание, Массив));
		
	КонецЕсли;	
	
	ЦентрЧастьВерхняяЧасть2.Вывести(ОбластьЧастьЦентрНижняяЧасть4);
	
	//НижняяЧасть-
	
	//перерасчеты
	ТаблицаПерерасчетОДН = Новый ТаблицаЗначений;
	ТаблицаПерерасчетОДН.Колонки.Добавить("Основание", ОбщегоНазначения.ОписаниеТипаСтрока(999));
	ТаблицаПерерасчетОДН.Колонки.Добавить("Сумма"      , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет",НомерЛС3);
	Запрос.УстановитьПараметр("Период",Период);
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХ.Регистратор КАК Регистратор,
	|	бит_НачисленияПоУслугамЖКХ.УслугаЖКХ КАК Услуга,
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			ТОГДА -бит_НачисленияПоУслугамЖКХ.Сумма
	|		ИНАЧЕ бит_НачисленияПоУслугамЖКХ.Сумма
	|	КОНЕЦ КАК Сумма,
	|	бит_НачисленияПоУслугамЖКХ.Регистратор.ДокументНаПерерасчет КАК Основание,
	|	бит_НачисленияПоУслугамЖКХ.ВидДвижения КАК ВидДвижения
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ КАК бит_НачисленияПоУслугамЖКХ
	|ГДЕ
	|	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет = &ЛицевойСчет
	|	И бит_НачисленияПоУслугамЖКХ.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Период, МЕСЯЦ)
	|	И ТИПЗНАЧЕНИЯ(бит_НачисленияПоУслугамЖКХ.Регистратор) = ТИП(Документ.бит_РазовыеПоУслугамЖКХ)";
	Выборка = Запрос.Выполнить().Выбрать();
	ВыводитьОснование = Ложь;
	Пока Выборка.Следующий() Цикл
		//Для Каждого Строка из мТаблицаПерерасчетов Цикл
		Если Выборка.Услуга = УслугаГазоснабжение ИЛИ Выборка.Услуга = Справочники.бит_УслугиЖКХ.Пеня ИЛИ Выборка.Услуга = Справочники.бит_УслугиЖКХ.Пени ИЛИ Выборка.Услуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000022") ИЛИ Выборка.Услуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000008") Тогда
			Продолжить;
		КонецЕсли;
		
		Если (Выборка.Услуга = УслугаОДН_ВО ИЛИ Выборка.Услуга = УслугаОДН_ГВ ИЛИ Выборка.Услуга = УслугаОДН_ХВ ИЛИ Выборка.Услуга = УслугаОДН_ЭЭ) И НЕ ОДНРаздельно Тогда
			НоваяСтрока = ТаблицаПерерасчетОДН.Добавить();
			НоваяСтрока.Основание = Выборка.Основание;
			НоваяСтрока.Сумма = Выборка.Сумма;
		Иначе
			ОбластьЧастьЦентрНижняяЧасть4 = мМакет.ПолучитьОбласть("Область16|Область8");
			//ОбластьЧастьЦентрНижняяЧасть4.Параметры.Перерасчет = Строка.Основание + " (" + Строка(Строка.Услуга) + " " + Строка(Строка.Сумма) + " руб.)";
			ОбластьЧастьЦентрНижняяЧасть4.Параметры.Перерасчет = СТрока(Выборка.Основание) + ": " + Строка(Выборка.Сумма) + " р. " + " ("+ Строка(Выборка.Услуга) + ").";
			ЦентрЧастьВерхняяЧасть2.Вывести(ОбластьЧастьЦентрНижняяЧасть4);
			ВыводитьОснование = Истина;
		КонецЕсли;
	КонецЦикла;
	
	Если ТаблицаПерерасчетОДН.Количество() > 0 Тогда
		ВыводитьОснование = Истина;
		ТаблицаПерерасчетОДН.Свернуть("Основание", "Сумма");
		Для Каждого Строка из ТаблицаПерерасчетОДН Цикл
			ОбластьЧастьЦентрНижняяЧасть4 = мМакет.ПолучитьОбласть("Область16|Область8");
			ОбластьЧастьЦентрНижняяЧасть4.Параметры.Перерасчет = "Пересчет по ОДН" + ": " + Строка(Строка.Сумма) + " р. " + "(ОДН).";
			ЦентрЧастьВерхняяЧасть2.Вывести(ОбластьЧастьЦентрНижняяЧасть4);
		КонецЦикла;
	КонецЕсли;
	Если ВыводитьОснование тогда
		ОбластьчастьЛев14.Параметры.Пер = "Основание и сумма перерасчета:";
		ЛеваяЧасть.Вывести(ОбластьчастьЛев14);
	Иначе
		ДокНаПерерасчет = "";	
	КонецЕсли;	
	/////////////////////////////////////////////////////////////////Центр-
	МакетОтрез = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("лб_МакетОтрез");
	ОбластьОтрез = МакетОтрез.ПолучитьОбласть("Область3|Область2");
	ТабДокОтрез = Новый ТабличныйДокумент;
	
	Высота = Макс(ЦентрЧастьВерхняяЧасть2.ВысотаТаблицы, ЛеваяЧасть.ВысотаТаблицы, ПраваяЧасть.ВысотаТаблицы);
	
	Пока Высота > ТабДокОтрез.ВысотаТаблицы Цикл
		ТабДокОтрез.Вывести(ОбластьОтрез);
	КонецЦикла;
	
	КвитанцияФиниш = Новый ТабличныйДокумент;
	КвитанцияФиниш.Присоединить(ЛеваяЧасть);
	КвитанцияФиниш.Присоединить(ЦентрЧастьВерхняяЧасть2);
	КвитанцияФиниш.Присоединить(ТабДокОтрез);
	КвитанцияФиниш.Присоединить(ПраваяЧасть);
	КвитанцияФиниш.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	Возврат КвитанцияФиниш;
	
КонецФункции


Функция УзнатьЗадолженность(Дата,ЛицевойСчет)
	СальдоНаДесятое = 0;
	НачисленоЗаПредыдущийПериод = 0;
	НачалоПериода = НачалоМесяца(НачалоМесяца(Дата)-1);
	КонецПериода  = НачалоМесяца(Дата) + 813600;
	ГруппаУслуг   = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000001");
	ЗапросДолг = Новый Запрос;
	ЗапросДолг.Текст =
	"ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ Сальдо
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И УслугаЖКХ.ГруппаУслуги = &ГруппаУслуг) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаПриход КАК СуммаПриход
	|ПОМЕСТИТЬ Начисление
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И УслугаЖКХ.ГруппаУслуги = &ГруппаУслуг) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|ГДЕ
	|	ТИПЗНАЧЕНИЯ(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Регистратор) = ТИП(Документ.Бит_Начислениеполицевымсчетам)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ЕСТЬNULL(Сальдо.СуммаКонечныйОстаток, 0) КАК СуммаКонечныйОстаток,
	|	ЕСТЬNULL(Начисление.СуммаПриход, 0) КАК СуммаПриход
	|ИЗ
	|	Сальдо КАК Сальдо,
	|	Начисление КАК Начисление";
	ЗапросДолг.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	ЗапросДолг.УстановитьПараметр("ГруппаУслуг",ГруппаУслуг);
	ЗапросДолг.УстановитьПараметр("НачалоПериода",НачалоПериода);
	ЗапросДолг.УстановитьПараметр("КонецПериода",КонецПериода);
	РезультатЗапроса = ЗапросДолг.Выполнить().Выгрузить();
	Если РезультатЗапроса.Количество() > 0 Тогда
		Для Отсчет = 0 По РезультатЗапроса.Количество()-1 Цикл
			СтрокаЗапроса = РезультатЗапроса[Отсчет];
			СальдоНаДесятое = СальдоНаДесятое + СтрокаЗапроса.СуммаКонечныйОстаток;
			НачисленоЗаПредыдущийПериод = НачисленоЗаПредыдущийПериод + СтрокаЗапроса.СуммаПриход;
		КонецЦикла;
		Если СальдоНаДесятое > НачисленоЗаПредыдущийПериод Тогда 
			Возврат Истина;
		Иначе
			Возврат Ложь;
		КонецЕсли;
	Иначе
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции


Функция ВыводитьСтрокуДомофон(Квартира)
	
	ЗапросВыводаСтрокиДомофона = Новый Запрос;
	ЗапросВыводаСтрокиДомофона.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.лб_НеВыводитьСтрокуДомофон КАК лб_НеВыводитьСтрокуДомофон
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	ЗапросВыводаСтрокиДомофона.УстановитьПараметр("Квартира",Квартира);
	РезультатЗапросаВыводаСтрокиДомофона = ЗапросВыводаСтрокиДомофона.Выполнить().Выбрать();
	Если РезультатЗапросаВыводаСтрокиДомофона.Следующий() Тогда
		Возврат РезультатЗапросаВыводаСтрокиДомофона.лб_НеВыводитьСтрокуДомофон;
	КонецЕсли;
	
КонецФункции


Функция СальдоУслуга(ЛицевойСчет, Период, УслугаЖКХ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(
	|			&Период,
	|			ЛицевойСчет В (&ЛицевойСчет)
	|				И УслугаЖКХ В (&УслугаЖКХ)) КАК бит_НачисленияПоУслугамЖКХОстатки";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("УслугаЖКХ", УслугаЖКХ);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		ВыборкаДетальныеЗаписи.Следующий();
		Возврат ВыборкаДетальныеЗаписи.СуммаОстаток;
	Иначе	
		Возврат 0;
	КонецЕсли; 
	
КонецФункции


Функция ПолучитьДанныеПоУслуге(ТаблицаПечати,Услуга,Ограничение = Истина)
	
	ДопТекстЗапроса = "";
	
	Если Ограничение Тогда
		ДопТекстЗапроса = "
		|	И НЕ ТЗ.РежимПотребления В (ЗНАЧЕНИЕ(Справочник.бит_РежимыПотребленияУслуг.Нет), ЗНАЧЕНИЕ(Справочник.бит_РежимыПотребленияУслуг.НеНачислять))" 
	КонецЕсли;
	
	ЗапросПоУслуге = Новый Запрос;
	ЗапросПоУслуге.Текст = 
	"ВЫБРАТЬ
	|	ТЗ.Услуга КАК Услуга,
	|	ТЗ.РежимПотребления КАК РежимПотребления,
	|	ТЗ.Поставщик КАК Поставщик,
	|	ТЗ.Сальдо КАК Сальдо,
	|	ТЗ.Ставка КАК Ставка,
	|	ТЗ.Разовые КАК Разовые,
	|	ТЗ.КОплате КАК КОплате,
	|	ТЗ.Начислено КАК Начислено,
	|	ТЗ.Пени КАК Пени,
	|	ТЗ.ЕдИзм КАК ЕдИзм,
	|	ТЗ.Тариф КАК Тариф,
	|	ТЗ.Оплата КАК Оплата
	|ПОМЕСТИТЬ ВТ_Услуга
	|ИЗ
	|	&ТЗ КАК ТЗ
	|ГДЕ
	|	ТЗ.Услуга В (&Услуга)"+ ДопТекстЗапроса +"
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Услуга.Услуга КАК Услуга,
	|	ВТ_Услуга.РежимПотребления КАК РежимПотребления,
	|	ВТ_Услуга.Поставщик КАК Поставщик,
	|	ВТ_Услуга.Сальдо КАК Сальдо,
	|	ВТ_Услуга.Ставка КАК Ставка,
	|	ВТ_Услуга.Разовые КАК Разовые,
	|	ВТ_Услуга.КОплате КАК КОплате,
	|	ВТ_Услуга.Начислено КАК Начислено,
	|	ВТ_Услуга.Пени КАК Пени,
	|	ВТ_Услуга.ЕдИзм КАК ЕдИзм,
	|	ВТ_Услуга.Тариф КАК Тариф,
	|	ВТ_Услуга.Оплата КАК Оплата
	|ИЗ
	|	ВТ_Услуга КАК ВТ_Услуга";
	ЗапросПоУслуге.УстановитьПараметр("ТЗ",ТаблицаПечати);
	ЗапросПоУслуге.УстановитьПараметр("Услуга",Услуга);
	Возврат ЗапросПоУслуге.Выполнить();
	
КонецФункции


Функция лб_РежимПотребленияОДН(лб_НастройиПечатиКвитанции)
	
	Струткруа = Новый Структура;
	Струткруа.Вставить("ХВС", "");
	Струткруа.Вставить("ГВС", "");
	Струткруа.Вставить("ЭЭ", "");
	Струткруа.Вставить("Стоки", "");
	
	Струткруа.Вставить("ПериодОДН", "");
	
	Ме = "";
	Если мСтруктураДанных.ПериодМесяц = "03" тогда 
		Ме = "январе ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "04" тогда 
		Ме = "феврале ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "05" тогда 
		Ме = "марте ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "06" тогда 
		Ме = "апреле ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "07" тогда 
		Ме = "мае ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "08" тогда 
		Ме = "июне ";	
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "09" тогда 
		Ме = "июле ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "10" тогда 
		Ме = "августе ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "11" тогда 
		Ме = "сентябре ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "12" тогда 
		Ме = "октябре ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "01" тогда 
		Ме = "ноябре ";
	ИначеЕсли мСтруктураДанных.ПериодМесяц = "02" тогда 
		Ме = "декабре ";
	КонецЕсли;
	
