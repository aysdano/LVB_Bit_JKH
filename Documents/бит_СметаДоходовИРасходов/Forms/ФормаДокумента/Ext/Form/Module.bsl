
#Область ПеременныеМодуля

&НаКлиенте 
Перем мКэшРеквизитовФормы; // Хранит текущие значения реквизитов формы. Клиент.

#КонецОбласти

#Область РаботаСКэшемРеквизитовФормы

// Процедура заполняет кэш реквизитов формы данными объекта.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура ЗаполнитьТекущиеЗначенияРеквизитовФормы()
	
	Для Каждого КлючИЗначение Из мКэшРеквизитовФормы Цикл
		мКэшРеквизитовФормы[КлючИЗначение.Ключ] = Объект[КлючИЗначение.Ключ];
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
// Функция восстанавливает период по имени колонки
//
// Параметры:
//  ИмяКолонки  – Строка.
//
// Возвращаемое значение:
//   РезПериод   – Дата.
//
Функция ПолучитьПериодПоИмениКолонки(ИмяКолонки) 
	
	РезПериод = Дата('00010101');
	
	НомерПодчеркивания = Найти(ИмяКолонки,"_");
	Если НомерПодчеркивания >0 Тогда
		
		ПериодСтр = Сред(ИмяКолонки,НомерПодчеркивания+1);
		Попытка
			
			РезПериод = Дата(ПериодСтр);
			
		Исключение
			
		КонецПопытки;
		
	КонецЕсли; 
	
	Возврат РезПериод;
	
КонецФункции

&НаКлиенте
// Процедура выполняет заполнение ячейку таблицы ДанныеДерева по отборам таблицы БДДС
// и вызвает последующий перерасчет итогов.
//
// Параметры:
//  Отбор  – Структура.
//
Процедура ЗаполнитьЗначениеЯчейкиДерева(Отбор)
	
	Итог = ВычислитьИтогСОтбором("БДДС", Отбор, "Сумма");
	
	СтрокаДерева = Элементы.ДанныеДерева.ТекущиеДанные;
	
	ИмяКолонки = "РеквизитДерева_" + Формат(Отбор.Период,"ДФ=yyyyMMdd");
	
	СтрокаДерева[ИмяКолонки] = Итог;
	
	ВыполнитьПересчетВСтрокеДерева(СтрокаДерева);
	
	ВычислитьИтогПоВерхнимУровням(СтрокаДерева, ИмяКолонки);
	
КонецПроцедуры

&НаКлиенте
// Процедура выполняет расчет итоговых значений в строке дерева данных
//
// Параметры:
//  СтрокаДерева  – СтрокаДереваЗначений.
//
Процедура ВыполнитьПересчетВСтрокеДерева(СтрокаДерева)
	
	Если СтрокаДерева = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Итог = 0;
	
	Для каждого Колонка Из мКолонкиДерева Цикл
		
		Итог = Итог +  СтрокаДерева[Колонка.Ключ];
		
	КонецЦикла; 
	
	СтрокаДерева.Итого = Итог;
	
КонецПроцедуры

&НаКлиенте
// Вычисляет сумму по верхним (по отношению к стартовой) строкам деревам значения
//             для указанной колонки
// Параметры:
//  СтартоваяСтрока  – СтрокаДереваЗначений,
//  ИмяКолонки       – Строка.
//
Процедура ВычислитьИтогПоВерхнимУровням(СтартоваяСтрока,ИмяКолонки)
	
	Если СтартоваяСтрока = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	СтрокаРодитель = СтартоваяСтрока.ПолучитьРодителя();
	
	Если СтрокаРодитель <> Неопределено Тогда
		
		Итог     = 0;
		
		ЭлементыРодителя =  СтрокаРодитель.ПолучитьЭлементы ();
		
		Для каждого СтрокаДерева Из ЭлементыРодителя Цикл
			
			Итог = Итог + СтрокаДерева[ИмяКолонки];
			
		КонецЦикла; 
		
		Если СтрокаРодитель.ЭтоГруппа Тогда
			
			СтрокаРодитель[ИмяКолонки]     = Итог;
			
			ВыполнитьПересчетВСтрокеДерева(СтрокаРодитель);
			
		КонецЕсли; 
		
		ВычислитьИтогПоВерхнимУровням(СтрокаРодитель,ИмяКолонки);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
// Вычисляет итог  по строкам табличной части, удовлетворяющим отбору
//
// Параметры:
//  ТабЧасть  – ИмяТабличнойЧасти,
//  Отбор     - Структура,
//  ИмяРесурса- Строка. 
//
// Возвращаемое значение:
//   Итог   – Число.
//
Функция ВычислитьИтогСОтбором(ТабЧасть,Отбор,ИмяРесурса)
	
	Итог = 0; 
	МассивСтрок = Объект[ТабЧасть].НайтиСтроки(Отбор);
	
	Для каждого СтрокаТЧ Из МассивСтрок Цикл
		
		Итог = Итог+СтрокаТЧ[ИмяРесурса];
		
	КонецЦикла; 
	
	Возврат Итог;
	
КонецФункции

&НаКлиенте
// Разбивает сумму бюджета по зданиям
//
// Параметры:
//  ТабЧасть  – ИмяТабличнойЧасти,
//  Отбор     - Структура,
//  СуммаИтог - Число. 
//
Процедура РазбитьСуммуПоЗданиям(Отбор, СуммаИтог)
	
	МассивСтрок = Объект.БДДС.НайтиСтроки(Отбор);
	
	Количество = МассивСтрок.Количество();
	
	ПроцентИтог   = 0;
	СуммаКонтроль = 0;
	
	Для каждого СтрокаТЧ Из МассивСтрок Цикл
		
		Сумма   = 0;
		
		Сумма = Окр((СуммаИтог * СтрокаТЧ.Процент)/100, 2);
		СтрокаТЧ.Сумма   = Сумма;
		
		СуммаКонтроль   = СуммаКонтроль   + Сумма;
		
		ПроцентИтог = ПроцентИтог + СтрокаТЧ.Процент;
		
	КонецЦикла;
	
	Если Количество > 0 Тогда
		
		РазницаСумма   = СуммаИтог   - СуммаКонтроль;
		
		Если РазницаСумма <> 0 Тогда
			
			СтрокаТЧ.Сумма   =  СтрокаТЧ.Сумма + РазницаСумма;
			
		КонецЕсли;
		
		РазницаПпроцент = 100  - ПроцентИтог;
		
		Если РазницаПпроцент <> 0 Тогда
			
			СтрокаТЧ.Процент   =  СтрокаТЧ.Процент + РазницаПпроцент;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область УправлениеВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , Строка(""));
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	Элементы.Настройки.Видимость = НЕ Объект.СкрыватьНастройки;
	
	Элементы.Дата.ТолькоПросмотр						= Объект.Проведен;
	Элементы.Номер.ТолькоПросмотр						= Объект.Проведен;
	Элементы.БДДС.ТолькоПросмотр						= Объект.Проведен;   
	Элементы.СписокЗданий.ТолькоПросмотр				= Объект.Проведен;
	Элементы.ДанныеДерева.ТолькоПросмотр				= Объект.Проведен;
	Элементы.Ответственный.ТолькоПросмотр				= Объект.Проведен;
	Элементы.Комментарий.ТолькоПросмотр					= Объект.Проведен;
	Элементы.Организация.ТолькоПросмотр					= Объект.Проведен;
	Элементы.Сценарий.ТолькоПросмотр					= Объект.Проведен;
	Элементы.ДатаНачалаПланирования.ТолькоПросмотр		= Объект.Проведен;
	Элементы.ДатаОкончанияПланирования.ТолькоПросмотр	= Объект.Проведен;
	Элементы.НастройкаПериода.Доступность				=  НЕ Объект.Проведен;
	Элементы.ДанныеДереваЗаполнить.Доступность			=  НЕ Объект.Проведен;
	Элементы.СпособРаспределения.ТолькоПросмотр			= Объект.Проведен;
	Элементы.СпособРаспределенияБДДС.ТолькоПросмотр		= Объект.Проведен;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	// Установить видимость реквизитов и заголовков колонок.	
	УправлениеЭлементамиФормы();
	
	Если ЗначениеЗаполнено(Параметры.Ключ) Тогда
		
		ИнициализироватьКолонки();
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		Дерево = ДокументОбъект.ХранилищеДерева.Получить();
		
		Если НЕ Дерево = Неопределено Тогда
			
			ЗаполнитьДеревоОбходом(Дерево);
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(Объект.Ссылка, Отказ);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Дерево = РеквизитФормыВЗначение("ДанныеДерева");
	
	Если НЕ Дерево.Строки.Количество() = 0 Тогда
		
		ТекущийОбъект.ХранилищеДерева = Новый ХранилищеЗначения(Дерево);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	УправлениеЭлементамиФормы();
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Вывести в заголовке формы вид операции и статус документа (новый, не проведен, проведен).
	УстановитьЗаголовокФормыДокумента();
	
	// Зададим имена реквизитов, подлежащих кешированию.
	мКэшРеквизитовФормы = Новый Структура;
	
	// Запомним текущие значения реквизитов формы.
	ЗаполнитьТекущиеЗначенияРеквизитовФормы();
	
	ИнтерфейсТакси = ТекущийВариантИнтерфейсаКлиентскогоПриложения() = ВариантИнтерфейсаКлиентскогоПриложения.Такси;
	
	Если ИнтерфейсТакси Тогда
		
		Элементы.ДанныеДерева.Высота = 10;
		Элементы.ДанныеДерева.РастягиватьПоВертикали = Ложь; 
		
		Элементы.БДДС.Высота = 10;
		Элементы.БДДС.РастягиватьПоВертикали = Ложь;
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	// Вывести в заголовке формы вид операции и статус документа (новый, не проведен, проведен).
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФорм

// Процедура - обработчик события "Нажатие" кнопки "НастройкаПериода".
//
&НаКлиенте
Процедура НастройкаПериода(Команда)
	
	Период = Новый СтандартныйПериод;
	Период.ДатаНачала    = Объект.ДатаНачалаПланирования;
	Период.ДатаОкончания = Объект.ДатаОкончанияПланирования;
	
	ДиалогРедактированияПериода = Новый ДиалогРедактированияСтандартногоПериода;
	ДиалогРедактированияПериода.Период = Период;
	
	ДиалогРедактированияПериода.Показать(Новый ОписаниеОповещения("НастройкаПериодаЗавершение1", ЭтотОбъект, Новый Структура("ДиалогРедактированияПериода", ДиалогРедактированияПериода))); 
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПериодаЗавершение1(Период1, ДополнительныеПараметры) Экспорт
	
	ДиалогРедактированияПериода = ДополнительныеПараметры.ДиалогРедактированияПериода;
	
	Если ЗначениеЗаполнено(Период1) Тогда
		
		мДатаНачала    = ДиалогРедактированияПериода.Период.ДатаНачала;
		мДатаОкончания = ДиалогРедактированияПериода.Период.ДатаОкончания;
		
		Если ДанныеДерева.ПолучитьЭлементы().Количество() > 0 Тогда
			
			Ответ = Неопределено;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("НастройкаПериодаЗавершение", ЭтотОбъект, Новый Структура("мДатаНачала", мДатаНачала)), "Данные будут очищенны, продолжить?", РежимДиалогаВопрос.ДаНет,5,КодВозвратаДиалога.Нет);
			Возврат;
			
		КонецЕсли;
		
		НастройкаПериодаФрагмент(мДатаНачала, мДатаОкончания);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПериодаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	мДатаНачала = ДополнительныеПараметры.мДатаНачала;
	
	
	Ответ = РезультатВопроса; 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ОбновитьДерво();
	Иначе
		
		мДатаНачала    = Объект.ДатаНачалаПланирования;
		мДатаОкончания = Объект.ДатаОкончанияПланирования;
		
	КонецЕсли;
	
	НастройкаПериодаФрагмент(мДатаНачала, мДатаОкончания);
	
КонецПроцедуры

&НаКлиенте
Процедура НастройкаПериодаФрагмент(Знач мДатаНачала, Знач мДатаОкончания)
	
	Объект.ДатаНачалаПланирования    = мДатаНачала;
	Объект.ДатаОкончанияПланирования = мДатаОкончания;
	
КонецПроцедуры

// Процедура - обработчик события "Нажатие" кнопки "Заполнить".
//
&НаКлиенте
Процедура Заполнить(Команда)
	
	Обновить = Истина;
	
	Если ДанныеДерева.ПолучитьЭлементы().Количество() > 0 Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект), "Данные будут очищенны, продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ЗаполнитьФрагмент(Обновить);
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса; 
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Обновить = Ложь;
	Иначе
		Обновить = Истина;
	КонецЕсли;
	
	ЗаполнитьФрагмент(Обновить);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьФрагмент(Знач Обновить)
	
	Если Обновить Тогда
		
		ОбновитьДерво();
		
	КонецЕсли; 
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

// Процедура - обработчик события "Нажатие" кнопки "Скрыть".
//
&НаКлиенте
Процедура Скрыть(Команда)
	
	Объект.СкрыватьНастройки = НЕ Объект.СкрыватьНастройки;
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФорм

&НаКлиенте
Процедура СпособРаспределенияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ОткрытьФорму("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.Форма.ФормаВыбора", Новый Структура("ТолькоЧисло", Истина), Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СпособРаспределенияПриИзменении(Элемент)
	
	ЗаполнитьПроцентыСписокЗданий();
	
КонецПроцедуры

&НаКлиенте
Процедура СпособРаспределенияБДДСПриИзменении(Элемент)
	
	ТекущиеДанныеДрева   = Элементы.ДанныеДерева.ТекущиеДанные;
	ТекущаяЭлементДерева = Элементы.ДанныеДерева.ТекущийЭлемент;
	
	Если ТекущаяЭлементДерева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если ТекущиеДанныеДрева = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяКолонки = ТекущаяЭлементДерева.Имя;
	
	Если Найти(ИмяКолонки,"РеквизитДерева_") > 0 Тогда
		СуммаРаспределения = ТекущиеДанныеДрева[ИмяКолонки];
		ЗаполнитьПроцентБДДС(СуммаРаспределения);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
