&НаСервере
Функция СпособРасчетаПоСчетчикамНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Регистратор,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчета,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Период КАК Период
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&КонецПериода, ) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период";
	
	Запрос.УстановитьПараметр("КонецПериода"  , КонецМесяца(Объект.Период));
	
	Результат = Запрос.Выполнить();
	
	ТЗСпособРасчетаПоСчетчикам = Результат.Выгрузить();
	
	ТЗСпособРасчетаПоСчетчикам.Сортировать("Период Возр");
	
	
	ВыборкаПостроительЗапроса = Результат.Выбрать();	
	
	МассивРезультата = Новый Массив;
	
	Идентификатор =-1;
	
	Пока ВыборкаПостроительЗапроса.Следующий() Цикл
		
		Идентификатор = Идентификатор +1;
		
		//21.10.2019
		ИдентификаторСтрока = Формат(Идентификатор, "ЧГ=0");							
		
		если ИдентификаторСтрока = "" тогда 
		  ИдентификаторСтрока = 0;	
		конецесли;
		
		Структура = Новый Структура;				
		
		МассивРезультата.Вставить(Число(ИдентификаторСтрока), Структура);	
		
		Для каждого Колонка из Результат.Колонки Цикл
			
			МассивРезультата[Число(ИдентификаторСтрока)].Вставить(Колонка.Имя,ВыборкаПостроительЗапроса[Колонка.Имя]);
			
		КонецЦикла;
		
	КонецЦикла;	
	
	Возврат МассивРезультата;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьСведенияОЧленахСемьиВDBFНаКлиенте(СтруктураРезультатаСведенияОЧленахСемьи,СтруктураОтвЛиц)
	
	АдресФайлСведения = Объект.кр_Каталог +"\"+ Объект.кр_ИмяФайлаСведения +".dbf";
	
	Попытка
		
		ФайлСведения = Новый XBase();
		
		#Если НЕ ВебКлиент Тогда
			
			ФайлСведения.Кодировка = КодировкаXBase[Объект.кр_Кодировка];
			
		#КонецЕсли
		
		ФайлСведения.Поля.Добавить("NN"   , "N", 7);    // Ключевое поле.
		ФайлСведения.Поля.Добавить("ID"   , "S", 15);   // Лицевой счет.
		ФайлСведения.Поля.Добавить("FIO"  , "S", 60);   // ФИО.
		ФайлСведения.Поля.Добавить("DR"   , "S", 10);   // Дата рождения.
		ФайлСведения.Поля.Добавить("SX"   , "N", 1);    // Пол.
		ФайлСведения.Поля.Добавить("VR"   , "N", 2);    // Вид регистрации. 
		ФайлСведения.Поля.Добавить("UDT"  , "N", 1);    // Тип Удостоверения.
		ФайлСведения.Поля.Добавить("UDS"  , "S", 10);   // Серия. 
		ФайлСведения.Поля.Добавить("UDN"  , "N", 7);    // Номер.
		ФайлСведения.Поля.Добавить("UDD"  , "S", 10);   // Дата выдачи.
		ФайлСведения.Поля.Добавить("ORGAN", "S", 100);  // Кем выдан.
		ФайлСведения.Поля.Добавить("RO"   , "N", 2);    // Код родственного отношения.
		ФайлСведения.Поля.Добавить("DD"   , "N", 2);    // Доля.
		ФайлСведения.Поля.Добавить("DREG" , "C", 10);   // Дата регистрации.
		ФайлСведения.Поля.Добавить("DVYB" , "C", 10);   // Дата выбытия.
		ФайлСведения.Поля.Добавить("POTS" , "C", 250);   // Периоды отсутствия  «с»-«по», разделитель между периодами «;». 
		
		ФайлСведения.СоздатьФайл(АдресФайлСведения);
		
		ФайлСведения.ОчиститьФайл();
		
		НомерПоПорядку = 0;
		
		ЛицевойСчетПред = Неопределено;	
		
		Идентификатор =0;
		
		Для каждого Выборка из СтруктураРезультатаСведенияОЧленахСемьи Цикл
			
			НомерПоПорядку = НомерПоПорядку + 1;	
			
			ФайлСведения.Добавить();
			
			ФайлСведения.NN    = НомерПоПорядку;
			ФайлСведения.ID    = Выборка.Значение.Наименование;
			ФайлСведения.FIO   = Лев(Строка(Выборка.Значение.ФизЛицо), 60);
			ФайлСведения.DR    = Лев(Строка(Выборка.Значение.ДатаРождения), 10);
			ФайлСведения.SX    = ?(Выборка.Значение.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской"),1,2);
			ФайлСведения.VR    = Лев(Строка(Выборка.Значение.ВидРегистрации), 2);
			ФайлСведения.UDT   = Лев(Строка(Выборка.Значение.КодДокумента), 2);
			ФайлСведения.UDS   = Лев(Строка(Выборка.Значение.ДокументСерия), 10);
			ФайлСведения.UDN   = Лев(Строка(Выборка.Значение.ДокументНомер), 7);
			ФайлСведения.UDD   = Лев(Строка(Выборка.Значение.ДокументДатаВыдачи), 10);
			ФайлСведения.ORGAN = Лев(Строка(Выборка.Значение.ДокументКемВыдан), 100);
			
			Если (Выборка.Значение.КодПоГУГЦЖС = "91" или  Выборка.Значение.КодПоГУГЦЖС = "091") 
				и Выборка.Значение.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский") Тогда
				
				ФайлСведения.RO    = "92";
				
			ИначеЕсли (Выборка.Значение.КодПоГУГЦЖС = "92" или  Выборка.Значение.КодПоГУГЦЖС = "092") 
				и Выборка.Значение.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской") Тогда
				
				ФайлСведения.RO    = "91";
				
			Иначе
				
				ФайлСведения.RO    = Выборка.Значение.КодПоГУГЦЖС;
				
			КонецЕсли;
			
			ФайлСведения.DD    = Лев(Строка(Выборка.Значение.ДоляПлощади), 2);
			
			Если ЗначениеЗаполнено(Выборка.Значение.ДатаРегистрации) Тогда
				ФайлСведения.DREG  = Лев(Строка(Выборка.Значение.ДатаРегистрации), 10);
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.Значение.ДатаСнятияСРегистрации) Тогда
				ФайлСведения.DVYB  = Лев(Строка(Выборка.Значение.ДатаСнятияСРегистрации), 10);
			КонецЕсли; 
			
			ФайлСведения.POTS  = "";
			
			ФайлСведения.Записать();
			
			Если Выборка.Значение.СтепеньРодства = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо") Тогда
				
				Идентификатор = Идентификатор +1;
				
				//21.10.2019
	         	ИдентификаторСтрока = Формат(Идентификатор, "ЧГ=0");							
									
		        Структура = Новый Структура;				
				
				СтруктураОтвЛиц.Вставить("Структура"+ИдентификаторСтрока,Структура);	
				
				СтруктураОтвЛиц["Структура"+ИдентификаторСтрока].Вставить("ЛицевойСчет",Выборка.Значение.ЛицевойСчет);
				СтруктураОтвЛиц["Структура"+ИдентификаторСтрока].Вставить("ФизЛицо",Выборка.Значение.ФизЛицо);
				СтруктураОтвЛиц["Структура"+ИдентификаторСтрока].Вставить("Код",НомерПоПорядку);
				
			КонецЕсли; 
			
		КонецЦикла;
		
		Если ФайлСведения.Открыта() Тогда
			ФайлСведения.ЗакрытьФайл();
		КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла ""Сведения о членах семьи"".
		|" + ОписаниеОшибки());
		
	КонецПопытки;	
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыгрузитьДанныеКвартиросъемщикаВDBFНаКлиенте(СтруктураРезультатаКвартиросъемщика,СтруктураОтвЛиц)
	
	АдресФайлКвартиросъемщики = Объект.кр_Каталог +"\"+ Объект.кр_ИмяФайлаКвартиросъемщики +".dbf";
	
	Попытка
		
		ФайлКвартиросъемщики = Новый XBase();
		
		#Если НЕ ВебКлиент Тогда
			
			ФайлКвартиросъемщики.Кодировка = КодировкаXBase[Объект.кр_Кодировка];
			
		#КонецЕсли
		
		ФайлКвартиросъемщики.Поля.Добавить("ID"   , "S", 15);   // Лицевой счет.
		ФайлКвартиросъемщики.Поля.Добавить("PUNKT", "S", 30);   // Населенный пункт.
		ФайлКвартиросъемщики.Поля.Добавить("TIP"  , "S", 20);   // Тип улицы.
		ФайлКвартиросъемщики.Поля.Добавить("UL"   , "S", 30);   // Улица.
		ФайлКвартиросъемщики.Поля.Добавить("DOM"  , "N", 3);    // Дом.
		ФайлКвартиросъемщики.Поля.Добавить("KOR"  , "N", 2);    // Корпус.
		ФайлКвартиросъемщики.Поля.Добавить("BDOM" , "S", 1);    // Буква дома.
		ФайлКвартиросъемщики.Поля.Добавить("KV"   , "S", 10);   // Квартира.
		ФайлКвартиросъемщики.Поля.Добавить("BKV"  , "S", 1);    // Буква квартиры.
		ФайлКвартиросъемщики.Поля.Добавить("OTCH" , "S", 7);    // Отчетный месяц.
		ФайлКвартиросъемщики.Поля.Добавить("SEM"  , "N", 2);    // Количество челов семьи.
		ФайлКвартиросъемщики.Поля.Добавить("PL"   , "N", 6, 2); // Общая площадь.
		ФайлКвартиросъемщики.Поля.Добавить("DOLG" , "L");       // Наличие задолжности.
		ФайлКвартиросъемщики.Поля.Добавить("Z"    , "S", 60);   // ПричинаЗакртия жилищной субсидии.
		ФайлКвартиросъемщики.Поля.Добавить("KVSM" , "N", 7);    // Главный квартиросъемщик.
		ФайлКвартиросъемщики.Поля.Добавить("SDOLG" , "N", 9, 2); // Сумма долга.
		ФайлКвартиросъемщики.Поля.Добавить("PER_B", "S", 10);   // Начало периода задолженности.
		ФайлКвартиросъемщики.Поля.Добавить("PER_E", "S", 10);   // Конец периода задолженности.
		ФайлКвартиросъемщики.Поля.Добавить("SOG"  , "L");       // Наличие соглашения о реструктуризации задолженности.
		ФайлКвартиросъемщики.Поля.Добавить("IUSOG", "L");       // Исполнение условий соглашения.
		ФайлКвартиросъемщики.Поля.Добавить("PLODN"	, "N", 6, 2); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
		ФайлКвартиросъемщики.Поля.Добавить("PLODN_V", "N", 6, 2); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
		ФайлКвартиросъемщики.Поля.Добавить("FIAS_ID", "S", 36);   // Идентификатор  дома в ФИАС.
		
		ФайлКвартиросъемщики.СоздатьФайл(АдресФайлКвартиросъемщики);
		
		ФайлКвартиросъемщики.ОчиститьФайл();
		
		Для каждого Выборка из СтруктураРезультатаКвартиросъемщика Цикл
			
			СтрокаТаблицыКод = Неопределено;
			
			Для каждого ВыборкаОтвЛиц из СтруктураОтвЛиц Цикл
				
				Если ВыборкаОтвЛиц.Значение.ЛицевойСчет = Выборка.Значение.ЛицевойСчет Тогда
					
					СтрокаТаблицыКод = ВыборкаОтвЛиц.Значение.Код;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Код = ?(СтрокаТаблицыКод = Неопределено, 0, СтрокаТаблицыКод);
			
			ФайлКвартиросъемщики.Добавить();
			ФайлКвартиросъемщики.ID		= Выборка.Значение.Наименование;
			ФайлКвартиросъемщики.PUNKT	= Лев(Строка(Выборка.Значение.Район), 30);
			ФайлКвартиросъемщики.TIP	= Лев(Строка(Выборка.Значение.ТипУлицы), 30);;
			ФайлКвартиросъемщики.UL		= Лев(Строка(Выборка.Значение.Улица), 30);
			ФайлКвартиросъемщики.DOM	= Лев(Строка(Выборка.Значение.Здание), 3);
			ФайлКвартиросъемщики.KOR	= Лев(Строка(Выборка.Значение.Корпус), 2);  
			ФайлКвартиросъемщики.BDOM	= Лев(Строка(Выборка.Значение.ПрефиксДома), 1);
			ФайлКвартиросъемщики.KV		= Лев(?(Строка(Выборка.Значение.Квартира) = "-", "", Строка(Выборка.Значение.Квартира)), 10);
			ФайлКвартиросъемщики.BKV	= Лев(Строка(Выборка.Значение.ПрефиксКвартиры), 1);    // Буква квартиры
			ФайлКвартиросъемщики.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
			ФайлКвартиросъемщики.SEM	= Выборка.Значение.КоличествоЧленовСемьи;
			ФайлКвартиросъемщики.PL		= Формат(Выборка.Значение.ОбщаяПлощадь, "ЧЦ=6; ЧДЦ=2; ЧГ=0") ;
			ФайлКвартиросъемщики.DOLG	= ?(Выборка.Значение.Сальдо > 0 И Выборка.Значение.ДолгНачалоПериода > 0, Истина, Ложь);
			ФайлКвартиросъемщики.Z		= "";
			ФайлКвартиросъемщики.KVSM	= Код;
			
			Если Выборка.Значение.ДолгНачалоПериода>0 Тогда
				ДолгНачалоПериода =	Выборка.Значение.ДолгНачалоПериода;
			Иначе 
				ДолгНачалоПериода =	0;
			КонецЕсли;
			
			ФайлКвартиросъемщики.SDOLG		= ?(Выборка.Значение.Сальдо > 0,ДолгНачалоПериода,0);             // Сумма долга.
			// БИТ ЖКХ 26.02.2020
			если Выборка.Значение.ДолгНачалоПериода > 0 тогда
			 ФайлКвартиросъемщики.PER_B		= Формат(Выборка.Значение.НачалоЗадолженности,"ДФ=дд.MM.yyyy");	// Начало периода задолженности.
			 ФайлКвартиросъемщики.PER_E		= Формат(НачалоМесяца(Объект.Период),"ДФ=дд.MM.yyyy");			// Конец периода задолженности.
			конецесли;
			ФайлКвартиросъемщики.SOG		= Ложь;                                                  // Наличие соглашения о реструктуризации задолженности.
			ФайлКвартиросъемщики.IUSOG		= Ложь;                                                  // Исполнение условий соглашения.
			ФайлКвартиросъемщики.PLODN		= Формат(Выборка.Значение.ПлощадьОДНСОИЭлектроснаб, "ЧЦ=6; ЧДЦ=2; ЧГ=0") ;	// Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
			ФайлКвартиросъемщики.PLODN_V	= Формат(Выборка.Значение.ПлощадьОДНСОИВодоснаб	, "ЧЦ=6; ЧДЦ=2; ЧГ=0") ;	// Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
			ФайлКвартиросъемщики.FIAS_ID	= Лев(Строка(Выборка.Значение.КодФИАС), 36);					 				// Идентификатор  дома в ФИАС.
			ФайлКвартиросъемщики.Записать();
			
		КонецЦикла;
		
		Если ФайлКвартиросъемщики.Открыта() Тогда
			ФайлКвартиросъемщики.ЗакрытьФайл();
		КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла ""Квартиросъемщики"".
		|" + ОписаниеОшибки());
	КонецПопытки;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыгрузитьСуммыОплатыУслугВDBFНаКлиенте(МассивРезультатаСуммыОплатыУслуг)
	
	АдресФайлКвартиросъемщики = Объект.кр_Каталог +"\"+ Объект.кр_ИмяФайлаОплатыУслуг +".dbf";
	
	Попытка
		
		ФайлОплаты = Новый XBase();
		
		#Если НЕ ВебКлиент Тогда
			
			ФайлОплаты.Кодировка = КодировкаXBase[Объект.кр_Кодировка];
			
		#КонецЕсли
		
		ФайлОплаты.Поля.Добавить("NN"   , "N", 7);      // Ключевое поле.
		ФайлОплаты.Поля.Добавить("ID"   , "S", 15);     // Лицевой счет.
		ФайлОплаты.Поля.Добавить("USL"  , "N", 5);      // Код услуги.
		ФайлОплаты.Поля.Добавить("S1"   , "N", 9, 2);   // К оплате.
		ФайлОплаты.Поля.Добавить("S2"   , "N", 9, 2);   // Хз.
		ФайлОплаты.Поля.Добавить("S3"   , "N", 9, 2);   // Хз.
		ФайлОплаты.Поля.Добавить("S4"   , "N", 9, 2);   // Льгота.
		ФайлОплаты.Поля.Добавить("S5"   , "N", 9, 2);   // Начислено.
		ФайлОплаты.Поля.Добавить("PER"  , "N", 2);      // Количество месяцев.
		ФайлОплаты.Поля.Добавить("CHET" , "L");         // Наличие счетчика.
		ФайлОплаты.Поля.Добавить("OTCH" , "S", 7);      // Месяц начисления.
		ФайлОплаты.Поля.Добавить("ITOG" , "L");         // Признак перерасчета.
		
		ФайлОплаты.СоздатьФайл(АдресФайлКвартиросъемщики);
		
		ФайлОплаты.ОчиститьФайл();
		
		НомерСтр = 1;
		
		МассивСпособРасчетаПоСчетчикам = СпособРасчетаПоСчетчикамНаСервере();
		
		КодУслуги = Неопределено;	
		
		Для каждого СтрокаМассива из МассивРезультатаСуммыОплатыУслуг Цикл
			
			КодУслуги = Неопределено;	
			
			Если СтрокаМассива.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам") Тогда
				
				МассивСчетчиков = Новый Массив;
				Для каждого ВыборкаДетальныеЗаписи из МассивСпособРасчетаПоСчетчикам Цикл
					
					Если ВыборкаДетальныеЗаписи.Объект = СтрокаМассива.Здание и ВыборкаДетальныеЗаписи.Услуга = СтрокаМассива.УслугаЖКХ Тогда
						СпособРасчетаПоСчетчикам = ВыборкаДетальныеЗаписи.СпособРасчета;
						Если МассивСчетчиков.Найти(ВыборкаДетальныеЗаписи.СпособРасчета) = Неопределено Тогда
							МассивСчетчиков.Добавить(ВыборкаДетальныеЗаписи.СпособРасчета);
						КонецЕсли;
					КонецЕсли;
					
					Если ВыборкаДетальныеЗаписи.Объект = СтрокаМассива.ЛицевойСчет и ВыборкаДетальныеЗаписи.Услуга = СтрокаМассива.УслугаЖКХ Тогда
						СпособРасчетаПоСчетчикам = ВыборкаДетальныеЗаписи.СпособРасчета;
						Если МассивСчетчиков.Найти(ВыборкаДетальныеЗаписи.СпособРасчета) = Неопределено Тогда
							МассивСчетчиков.Добавить(ВыборкаДетальныеЗаписи.СпособРасчета);
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
				Если МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено
					И (МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено 
					ИЛИ МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено) 
					И СтрокаМассива.Общедом > 0 Тогда
					
					КодУслуги = СтрокаМассива.КодПоГУГЦЖС_КПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено
					И (МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено 
					ИЛИ МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено) 
					И СтрокаМассива.Общедом = 0 Тогда
					
					КодУслуги = СтрокаМассива.КодПоГУГЦЖС_ДПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено
					И МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено Тогда 
					
					КодУслуги = СтрокаМассива.КодПоГУГЦЖС_ДПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено Тогда
					
					КодУслуги = СтрокаМассива.КодПоГУГЦЖС_КПУ;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если СтрокаМассива.ЭтоРазовые Тогда
				
				ФайлОплаты.Добавить();
				
				ФайлОплаты.NN	= НомерСтр;
				ФайлОплаты.ID	= СтрокаМассива.Наименование;
				ФайлОплаты.USL	= СтрокаМассива.КодПоГУГЦЖС_Разовые;
				ФайлОплаты.S1	= СтрокаМассива.Разовые;
				ФайлОплаты.S2	= СтрокаМассива.Разовые;
				ФайлОплаты.S3	= "";
				ФайлОплаты.S4	= "";
				ФайлОплаты.S5	= СтрокаМассива.Разовые; 
				ФайлОплаты.PER	= 1;
				ФайлОплаты.CHET	= (СтрокаМассива.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам"));
				ФайлОплаты.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
				ФайлОплаты.ITOG	= Истина;
				
				ФайлОплаты.Записать();
				НомерСтр = НомерСтр + 1;

			ИначеЕсли Не СтрокаМассива.ОбщедомовыеНачисления Тогда
				
				ФайлОплаты.Добавить();
				
				ФайлОплаты.NN	= НомерСтр;
				ФайлОплаты.ID	= СтрокаМассива.Наименование;
				Если КодУслуги	= Неопределено Тогда
					ФайлОплаты.USL	= СтрокаМассива.КодПоГУГЦЖС;
				Иначе
					ФайлОплаты.USL	= КодУслуги;
				КонецЕсли;
				ФайлОплаты.S1	= СтрокаМассива.Начислено - СтрокаМассива.Общедом;  
				ФайлОплаты.S2	= "";
				ФайлОплаты.S3	= "";
				Если СтрокаМассива.КодПоГУГЦЖС = "012" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "022" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "043"
					ИЛИ СтрокаМассива.КодПоГУГЦЖС = "12" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "22" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "43" Тогда
					ФайлОплаты.S4	= СтрокаМассива.Оплата;
				Иначе
					ФайлОплаты.S4	= "";
				КонецЕсли;
				ФайлОплаты.S5	= СтрокаМассива.Начислено - СтрокаМассива.Общедом; 
				ФайлОплаты.PER	= 1;
				ФайлОплаты.CHET	= (СтрокаМассива.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам"));
				ФайлОплаты.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
				ФайлОплаты.ITOG	= ?(СтрокаМассива.ОбщеДом = 0,Ложь,Истина);
				
				ФайлОплаты.Записать();
				НомерСтр = НомерСтр + 1;
				
				Если СтрокаМассива.Общедом <> 0 Тогда
					
					ФайлОплаты.Добавить();
					
					ФайлОплаты.NN	= НомерСтр;
					ФайлОплаты.ID	= СтрокаМассива.Наименование;
					ФайлОплаты.USL	= СтрокаМассива.КодПоГУГЦЖС_ДПУ;
					ФайлОплаты.S1	= СтрокаМассива.Общедом;  
					ФайлОплаты.S2	= "";
					ФайлОплаты.S3	= "";
					Если СтрокаМассива.КодПоГУГЦЖС = "012" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "022" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "043"
						ИЛИ СтрокаМассива.КодПоГУГЦЖС = "12" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "22" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "43" Тогда
						ФайлОплаты.S4   = СтрокаМассива.Оплата;
					Иначе
						ФайлОплаты.S4   = "";
					КонецЕсли;
					ФайлОплаты.S5	= СтрокаМассива.Общедом; 
					ФайлОплаты.PER	= 1;
					ФайлОплаты.CHET	= (СтрокаМассива.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам"));
					ФайлОплаты.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
					ФайлОплаты.ITOG	= ?(СтрокаМассива.ОбщеДом = 0,Ложь,Истина);
					
					ФайлОплаты.Записать();
					НомерСтр = НомерСтр + 1;
					
				КонецЕсли;
				
			Иначе
				
				ФайлОплаты.Добавить();
				
				ФайлОплаты.NN	= НомерСтр;
				ФайлОплаты.ID	= СтрокаМассива.Наименование;
				ФайлОплаты.USL	= СтрокаМассива.КодПоГУГЦЖС_ДПУ;
				ФайлОплаты.S1	= СтрокаМассива.Начислено;  
				ФайлОплаты.S2	= "";
				ФайлОплаты.S3	= "";
				Если СтрокаМассива.КодПоГУГЦЖС = "012" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "022" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "043"
					ИЛИ СтрокаМассива.КодПоГУГЦЖС = "12" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "22" ИЛИ СтрокаМассива.КодПоГУГЦЖС = "43" Тогда
					ФайлОплаты.S4	= СтрокаМассива.Оплата;
				Иначе
					ФайлОплаты.S4	= "";
				КонецЕсли;
				ФайлОплаты.S5	= СтрокаМассива.Начислено; 
				ФайлОплаты.PER	= 1;
				ФайлОплаты.CHET	= (СтрокаМассива.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам"));
				ФайлОплаты.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
				ФайлОплаты.ITOG	= ?(СтрокаМассива.ОбщеДом = 0,Ложь,Истина);
				
				ФайлОплаты.Записать();
				НомерСтр = НомерСтр + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
		Если ФайлОплаты.Открыта() Тогда
			ФайлОплаты.ЗакрытьФайл();
		КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла ""Суммы оплаты услуг"".
		|" + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры	

&НаКлиенте
Процедура ВыбратьПериодЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если РезультатВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Объект.Период = РезультатВыбора.КонецПериода;
	
КонецПроцедуры

&НаСервере
Функция ТекстЗапросаСуммыОплатыУслуг()
	
	Текст =	
	"ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|					ИЛИ бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|					ИЛИ бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Начислено,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОбщеДом,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот * -1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Льгота,
	|	СУММА(ВЫБОР
	|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот * -1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Оплата,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета,
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет.Здание КАК Здание,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет.Наименование КАК Наименование,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ.Приоритет КАК Приоритет,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС КАК КодПоГУГЦЖС,
	|	СУММА(ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток, 0)) КАК ВхСальдо,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_КПУ КАК КодПоГУГЦЖС_КПУ,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_ДПУ КАК КодПоГУГЦЖС_ДПУ,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_Разовые КАК КодПоГУГЦЖС_Разовые,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ.ОбщедомовыеНачисления КАК ОбщедомовыеНачисления,
	|	МАКСИМУМ(ЕСТЬNULL(бит_РасчетПредельногоИндексаПоУслугамЖКХОбороты.СуммаНедополученныхДоходовОборот, 0)) КАК СуммаПИ,
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ЭтоРазовые
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&КонецПериода, ЛицевойСчет.Организация = &Организация) КАК бит_СведенияПоУслугамЛССрезПоследних
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НастройкиУслугВыгрузкиГЦЖС КАК бит_НастройкиУслугВыгрузкиГЦЖС
	|			ПО бит_СведенияПоУслугамЛССрезПоследних.Услуга = бит_НастройкиУслугВыгрузкиГЦЖС.Услуга
	|				И бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления = бит_НастройкиУслугВыгрузкиГЦЖС.РежимПотребления
	|		ПО бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет = бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет
	|			И бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ = бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&КонецПериода, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&НачалоПериода, ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОстатки
	|		ПО бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет = бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет
	|			И бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ = бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_РасчетПредельногоИндексаПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Авто, ЛицевойСчет.Организация = &Организация) КАК бит_РасчетПредельногоИндексаПоУслугамЖКХОбороты
	|		ПО бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет = бит_РасчетПредельногоИндексаПоУслугамЖКХОбороты.ЛицевойСчет
	|			И бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ = бит_РасчетПредельногоИндексаПоУслугамЖКХОбороты.УслугаЖКХ
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет.Здание,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет.Наименование,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ.Приоритет,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_КПУ,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_ДПУ,
	|	бит_НастройкиУслугВыгрузкиГЦЖС.КодПоГУГЦЖС_Разовые,
	|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ.ОбщедомовыеНачисления,
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование,
	|	Приоритет";
	
	Возврат Текст;
	
КонецФункции

&НаСервере
Функция ТекстЗапросаКвартиросъемщика()
	
	Текст =
