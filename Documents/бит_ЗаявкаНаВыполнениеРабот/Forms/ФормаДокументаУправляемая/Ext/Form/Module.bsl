&НаКлиенте
Процедура РаботыНормаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущаяСтрока = Элементы.Работы.ТекущиеДанные;
	Работа 		  = ТекущаяСтрока.Работа;
	
	Если ЗначениеЗаполнено(Работа) Тогда
		
		ЕдиницаИзмерения = ТекущаяСтрока.ЕдиницаИзмерения;
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("Владелец", Работа);
		
		Если ЗначениеЗаполнено(ЕдиницаИзмерения) Тогда
			
			Отбор.Вставить("ЕдиницаИзмерения", ЕдиницаИзмерения);			
			
			ОткрытьФорму("Справочник.бит_НормыТруда.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
			
		Иначе	
			
			ОткрытьФорму("Справочник.бит_НормыТруда.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор", Отбор), Элемент);
			
		КонецЕсли; 
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните поле Работа.";
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыОбъемПриИзменении(Элемент)
	
	ТекущаяСтрока	 = Элементы.Работы.ТекущиеДанные;
	
	Если ТекущаяСтрока.КоэффициентНормы <> 0 Тогда
		
		ТекущаяСтрока.Количество = ТекущаяСтрока.Объем /ТекущаяСтрока.КоэффициентНормы;
		
	Иначе
		
		ТекущаяСтрока.Количество = 0;
		
	КонецЕсли; 
	
	РассчитатьСтрокуТабЧастиРаботы(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыОбъемПланПриИзменении(Элемент)
	
	ТекущаяСтрока	 = Элементы.Работы.ТекущиеДанные;
	
	Если ТекущаяСтрока.КоэффициентНормы <> 0 Тогда
		
		ТекущаяСтрока.КоличествоПлан = ТекущаяСтрока.ОбъемПлан / ТекущаяСтрока.КоэффициентНормы; 
		
	Иначе
		
		ТекущаяСтрока.КоличествоПлан = 0;
		
	КонецЕсли; 
	
	РассчитатьСтрокуТабЧастиРаботы(ТекущаяСтрока);
	
КонецПроцедуры

&НаКлиенте
Процедура РаботыКоличествоПланПриИзменении(Элемент)
	
