	ЗадатьВопросНаОчисткуТабЧасти(Объект.ОбъектВыбора, ВыбранноеЗначение);
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Процедура подготовки списка ЛС для дальнейшего заполнения 
// табличной части документа ЛицевыеСчета.
&НаСервере
Процедура СформироватьСписокЛСдляТЧ(ПолныйСписок)
	
	Если ЗначениеЗаполнено(ПолныйСписок) Тогда
		
		// Удаление строк с ЛС, которые не имеют долгов.
		Счетчик = ПолныйСписок.Строки.Количество()-1;
		
		Пока Счетчик >= 0 Цикл
			
			Если ((НЕ ЗначениеЗаполнено(ПолныйСписок.Строки[Счетчик].СуммаБезПереплат) ИЛИ ПолныйСписок.Строки[Счетчик].СуммаБезПереплат <=0) 
				И (НЕ ЗначениеЗаполнено(ПолныйСписок.Строки[Счетчик].Сумма) ИЛИ ПолныйСписок.Строки[Счетчик].Сумма <=0) 
				И (НЕ ЗначениеЗаполнено(ПолныйСписок.Строки[Счетчик].СуммаПени) ИЛИ ПолныйСписок.Строки[Счетчик].СуммаПени <= 0 )) Тогда
				
				ПолныйСписок.Строки.Удалить(ПолныйСписок.Строки[Счетчик]);
				
			ИначеЕсли ПолныйСписок.Строки[Счетчик].Сумма < Объект.МинСуммаДолга Тогда
				
				ПолныйСписок.Строки.Удалить(ПолныйСписок.Строки[Счетчик]);
				
			КонецЕсли;
			
			Счетчик = Счетчик - 1;
			
		КонецЦикла;
		
		ПолныйСписок.Строки.Сортировать("ЛицевойСчет Возр");
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокТиповНаСервере();
	
	МассивТипов = Объект.Ссылка.Метаданные().Реквизиты["ОбъектВыбора"].Тип.Типы();	
	
	СписокТипов = Новый СписокЗначений;
	
	Для каждого ЭлементМассива Из МассивТипов Цикл
		
		ПустоеЗначение = Новый(ЭлементМассива);
		
		ОбъектОписанияМетаданных = ПустоеЗначение.Метаданные();
		
		СписокТипов.Добавить(ОбъектОписанияМетаданных.Имя, ОбъектОписанияМетаданных.Представление());
		
	КонецЦикла;
	
	Возврат СписокТипов;
	
КонецФункции

&НаСервере
Процедура РассчитатьНаСервере(Знач ЗаполненоОрганизация)
	
	Если ЗаполненоОрганизация Тогда
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		МоментРасчета = ДокументОбъект.ПолучитьДатуДолга(Объект.Организация, ?(ЗначениеЗаполнено(Объект.ДатаРасчета), Объект.ДатаРасчета, Объект.Дата));
		
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
		
		Элементы.ФормаНадписьМоментРасчета.Заголовок = "Дата расчета долгов: " + Формат(МоментРасчета, "ДФ='dd.MM.yyyy ""г.""'");
		
		Если ТипЗнч(Объект.ОбъектВыбора) = Тип("СправочникСсылка.бит_ЛицевыеСчета")
			И НЕ Объект.ОбъектВыбора = ПредопределенноеЗначение("Справочник.бит_ЛицевыеСчета.ПустаяСсылка") Тогда
			
			ЛС = Объект.ОбъектВыбора;
			
			ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
			
			СписокЛС = ДокументОбъект.ПолучитьСписокЛС( , , ЛС);
			
			ЗначениеВДанныеФормы(ДокументОбъект, Объект);
			
		ИначеЕсли ТипЗнч(Объект.ОбъектВыбора) = Тип("СправочникСсылка.бит_СписокЗданий") Тогда
			
			Здание = Объект.ОбъектВыбора;
			
			Если ЗначениеЗаполнено(Объект.Организация) Тогда
				
				ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
				
				СписокЛС = ДокументОбъект.ПолучитьСписокЛС(Здание, Истина);
				
				ЗначениеВДанныеФормы(ДокументОбъект, Объект);
				
			КонецЕсли;
			
		Иначе
			
			ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
			
			СписокЗданий = ДокументОбъект.ПолучитьСписокЗданий(Объект.Организация);
			СписокЛС     = ДокументОбъект.ПолучитьСписокЛС(СписокЗданий, Ложь);
			
			ЗначениеВДанныеФормы(ДокументОбъект, Объект);
			
		КонецЕсли;
		
		// Количество ЛС по настройкам.
		КолВоЛС = СписокЛС.Количество();         
		
		Если (СписокЛС <> Неопределено ИЛИ КолВоЛС <> 0) И ЗаполненоОрганизация  Тогда
			
			// Список ЛС со всеми данными.
			ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
			

			// БИТ ЖКХ 25.06.2020
			ПолныйСписок = ДокументОбъект.РасчитатьДолги(СписокЛС, МоментРасчета, Объект.ДатаРасчета);//МоментРасчета);
//			ПолныйСписок = ДокументОбъект.РасчитатьДолги(СписокЛС, МоментРасчета);
			

			ЗначениеВДанныеФормы(ДокументОбъект, Объект);
			
			СформироватьСписокЛСдляТЧ(ПолныйСписок);
			
			Для каждого Строка Из ПолныйСписок.Строки Цикл
				
				ТекущаяСтрока = Объект.ЛицевыеСчета.Добавить();
				
				ЗаполнитьЗначенияСвойств(ТекущаяСтрока, Строка);
				
			КонецЦикла; 
			
		КонецЕсли;
		
		Если Объект.ЛицевыеСчета.Количество() =  0 Тогда
			
			Если КолВоЛС = 0 Тогда
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "По данным настройкам лицевых счетов нет!";
				Сообщение.Сообщить();
				
			ИначеЕсли Объект.МинСуммаДолга > 0  Тогда
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Нет лицевых счетов, по которым есть долги более чем на " + Объект.МинСуммаДолга + " руб.!";
				Сообщение.Сообщить();
				
			Иначе
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "Нет лицевых счетов, по которым есть долги!";
				Сообщение.Сообщить();
				
			КонецЕсли;
			
		КонецЕсли; 
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Проверьте заполнение поля: Организация";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли; 
	
КонецПроцедуры

// Cлужебная процедура для заполнения колонки "Адрес" табличного поля "СписокЛС".
&НаСервере
Процедура ОбновитьДанныеКолонкиАдрес()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета,
	|	бит_ЛицевыеСчета.Здание,
	|	бит_ЛицевыеСчета.Здание.Корпус КАК Корпус,
	|	бит_ЛицевыеСчета.Квартира
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка В(&СписокЛицевыхСчетов)"
	);
	
	Запрос.УстановитьПараметр("СписокЛицевыхСчетов",Объект.ЛицевыеСчета.Выгрузить().ВыгрузитьКолонку("ЛицевойСчет"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Для Каждого Стр Из Объект.ЛицевыеСчета Цикл
		
		Если Выборка.НайтиСледующий(Стр.ЛицевойСчет,"ЛицевойСчет") Тогда
			
			Стр.Адрес = Строка(Выборка.УлицаЛицевогоСчета) + ", д. " + Строка(Выборка.Здание) + ?(ПустаяСтрока(Выборка.Корпус),"",", кор. " + Строка(Выборка.Корпус)) + ", кв. " + Строка(Выборка.Квартира);
			
		Иначе
			
			Стр.Адрес = "";
			
		КонецЕсли;
		
		Выборка.Сбросить();
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта"                   , Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	КэшированныеЗначения.Вставить("Организация"                            , Объект.Организация);
	КэшированныеЗначения.Вставить("Дата"                                   , Объект.Дата);
	КэшированныеЗначения.Вставить("мВыводитьСуммуБезУчетаПереплатПоУслугам", Неопределено);
	КэшированныеЗначения.Вставить("мВключатьВРасчетСуммыДолгаПени"         , Неопределено);
	
КонецПроцедуры

&НаСервере
Функция Сформировать(ИмяМакета)
	
	Если ИмяМакета = "ПечатьПредупреждения" Тогда
		
		ТабДокумент = ПечатьПредупрежденияФункция();
		
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой сличительной ведомости
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
&НаСервере
Функция ПечатьПредупрежденияФункция()
	
	ОбновитьНастройкиЖКХ();
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	Макет = ДокументОбъект.ПолучитьМакет("Предупреждение");
	
	ТабДокумент   = Новый ТабличныйДокумент();
	
	ТабДокумент.КлючПараметровПечати = "МакетПредупреждения";
	
	ШапкаОбласть  = Макет.ПолучитьОбласть("ОбластьШапка");
	
	Руководители = ОтветственныеЛицаБП.ОтветственныеЛица(Объект.Организация, Объект.Дата);
	
	СтруктураПечати = Новый Структура();
	
	СтруктураПечати.Вставить("Организация"          ,Объект.Организация.Наименование);
	СтруктураПечати.Вставить("ФИОРуководителя"      ,Руководители.Руководитель);
	СтруктураПечати.Вставить("ДолжностьРуководителя",Руководители.РуководительДолжность);
	СтруктураПечати.Вставить("СрокПогашения"        ,Формат(Объект.СрокПогашения, "ДФ='dd MMMM yyyy ""г.""'"));
	
	Если ЗначениеЗаполнено(Объект.ДатаРасчета) Тогда
		
		ДатаПросмотра = Объект.ДатаРасчета;
		
	Иначе
		
		ДатаПросмотра = Объект.Дата;
		
	КонецЕсли;
	
	СтруктураПечати.Вставить("ДатаПросмотра", Формат(ДатаПросмотра, "ДФ='dd MMMM yyyy ""г.""'"));
	
	ФормСтрока  = "Л = ru_RU; ДП = Истина";
	ПарПредмета = "рубль, рубля, рублей, м, копейка, копейки, копеек, ж, 2";
	
	Для каждого Строка ИЗ Объект.ЛицевыеСчета Цикл
		
		СтруктураПечати.Вставить("ФИО",   Строка.ОтветственноеЛицо);
		СтруктураПечати.Вставить("Адрес", Строка.ЛицевойСчет.Здание.ПочтовыйАдрес + ?(ЗначениеЗаполнено(Строка.ЛицевойСчет.Квартира),", кв. " + Строка(Строка.ЛицевойСчет.Квартира),""));
		
		Если НЕ мКэшЗначений.мВыводитьСуммуБезУчетаПереплатПоУслугам Тогда
			
			Сумма = Строка.Сумма;
			
		Иначе
			
			Сумма = Строка.СуммаБезПереплат;
			
		КонецЕсли;
		
		Если мКэшЗначений.мВключатьВРасчетСуммыДолгаПени Тогда
			
			Сумма = Сумма + Строка.СуммаПени;
			
		КонецЕсли;
		
		СуммаПрописью = ЧислоПрописью(Сумма,ФормСтрока, ПарПредмета);
		
		СтруктураПечати.Вставить("Сумма"        , Сумма);
		СтруктураПечати.Вставить("СуммаПрописью", СуммаПрописью);
		
		ШапкаОбласть  = Макет.ПолучитьОбласть("ОбластьШапка");
		
		ШапкаОбласть.Параметры.Заполнить(СтруктураПечати);
		
		Для Каждого ТекПараметр Из СтруктураПечати Цикл
			
			Пока НайтиИЗаменитьВДокументе(ШапкаОбласть, "[" + ТекПараметр.Ключ + "]", ТекПараметр.Значение) Цикл
				
			КонецЦикла;
			
		КонецЦикла;
		
		СтрокаПредупреждения = Новый Массив;
		
		СтрокаПредупреждения.Добавить(ШапкаОбласть);
		
		Если Не ОбщегоНазначения.ПроверитьВыводТабличногоДокумента(ТабДокумент, СтрокаПредупреждения) Тогда
			
			ТабДокумент.ВывестиГоризонтальныйРазделительСтраниц();
			
		КонецЕсли;
		
		ТабДокумент.Вывести(ШапкаОбласть);
		
	КонецЦикла;
	
	ТабДокумент.ОбластьПечати      = ТабДокумент.Область(1, 2, ТабДокумент.ВысотаТаблицы, ТабДокумент.ШиринаТаблицы);
	ТабДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДокумент.ПолеСверху         = 0;
	ТабДокумент.ПолеСлева          = 0;
	ТабДокумент.ПолеСнизу          = 0;
	ТабДокумент.ПолеСправа         = 0;
	
	Возврат ТабДокумент;
	
КонецФункции

// Производит замену строк в указанном табличном документе.
//
// Возвращаемое значение:
//  Булево – была ли произведена замена.
//
&НаСервере
Функция НайтиИЗаменитьВДокументе(ТабДок, СтрокаПоиска, СтрокаЗамены)
	
	ОбластьЗамены = ТабДок.НайтиТекст(СтрокаПоиска);
	
	Если ОбластьЗамены = Неопределено Тогда
		
		Возврат Ложь;
		
	КонецЕсли;
	
	ОбластьЗамены.Текст = СтрЗаменить(ОбластьЗамены.Текст, СтрокаПоиска, СтрокаЗамены);
	
	Возврат Истина;
	
КонецФункции

&НаСервере
Процедура ОбновитьНастройкиЖКХ()
		  
  ПараметрыЖКХ = Новый Структура;
		  
  ПараметрыЖКХ.Вставить("ВыводитьСуммуБезУчетаПереплатПоУслугам", Ложь);
  ПараметрыЖКХ.Вставить("ВключатьВРасчетСуммыДолгаПени"         , Ложь);
		  
  бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(Объект.Дата, Объект.Организация, ПараметрыЖКХ);
		  
  мКэшЗначений.мВыводитьСуммуБезУчетаПереплатПоУслугам = ПараметрыЖКХ.ВыводитьСуммуБезУчетаПереплатПоУслугам;
  мКэшЗначений.мВключатьВРасчетСуммыДолгаПени          = ПараметрыЖКХ.ВключатьВРасчетСуммыДолгаПени;
		  
КонецПроцедуры

