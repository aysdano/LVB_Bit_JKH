|	бит_СведенияПоУслугамЛС.Активность КАК Активность,
|	ВТ.Период КАК ПериодВТ
|ПОМЕСТИТЬ ВТ1
|ИЗ
|	ВТ КАК ВТ
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС КАК бит_СведенияПоУслугамЛС
|		ПО ВТ.Период >= бит_СведенияПоУслугамЛС.Период
|ГДЕ
|	бит_СведенияПоУслугамЛС.Активность = &Активность
|	И бит_СведенияПоУслугамЛС.ЛицевойСчет В(&ЛицевойСчет)
|	И бит_СведенияПоУслугамЛС.Услуга В(&Услуга)
|	И бит_СведенияПоУслугамЛС.Использовать = &Использовать
|
|СГРУППИРОВАТЬ ПО
|	бит_СведенияПоУслугамЛС.ЛицевойСчет,
|	бит_СведенияПоУслугамЛС.Услуга,
|	бит_СведенияПоУслугамЛС.Использовать,
|	бит_СведенияПоУслугамЛС.Активность,
|	ВТ.Период
|;
|
|////////////////////////////////////////////////////////////////////////////////
|ВЫБРАТЬ РАЗЛИЧНЫЕ
|	ВТ1.ПериодВТ КАК ПериодВТ,
|	бит_СведенияПоУслугамЛС.Период КАК Период,
|	бит_СведенияПоУслугамЛС.ЛицевойСчет КАК ЛицевойСчет,
|	бит_СведенияПоУслугамЛС.Услуга КАК Услуга,
|	бит_СведенияПоУслугамЛС.РежимПотребления КАК РежимПотребления,
|	бит_СведенияПоУслугамЛС.Поставщик КАК Поставщик,
|	бит_СведенияПоУслугамЛС.СпособРасчета КАК СпособРасчета,
|	бит_СведенияПоУслугамЛС.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления
|ИЗ
|	ВТ1 КАК ВТ1
|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС КАК бит_СведенияПоУслугамЛС
|		ПО (ВТ1.Период = бит_СведенияПоУслугамЛС.Период
|				И бит_СведенияПоУслугамЛС.ЛицевойСчет = ВТ1.ЛицевойСчет
|				И бит_СведенияПоУслугамЛС.Услуга = ВТ1.Услуга
|				И бит_СведенияПоУслугамЛС.Использовать = ВТ1.Использовать
|				И бит_СведенияПоУслугамЛС.Активность = ВТ1.Активность)
|ГДЕ
|	бит_СведенияПоУслугамЛС.Активность = &Активность
|	И бит_СведенияПоУслугамЛС.ЛицевойСчет В(&ЛицевойСчет)
|	И бит_СведенияПоУслугамЛС.Услуга В(&Услуга)
|	И бит_СведенияПоУслугамЛС.Использовать = &Использовать";

	Запрос.УстановитьПараметр("Активность", Истина);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевыеСчета);
	ЗАпрос.УстановитьПараметр("ТаблицаПериодов", ТаблицаПериодов);
    Запрос.УстановитьПараметр("Услуга", Услуги);
    Запрос.УстановитьПараметр("Использовать", перечисления.ДаНет.Да);
 
	РезультатЗапроса = Запрос.Выполнить();   	
	Выборка = РезультатЗапроса.Выгрузить();
                                                                            
	Возврат Выборка;
	
	
