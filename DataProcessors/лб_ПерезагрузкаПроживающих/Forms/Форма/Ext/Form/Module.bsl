&НаСервере
Процедура СопоставитьПерезагружаемыеЛС();
	Табл = Объект.ПерезагружаемыеЛС.Выгрузить();
	Табл.Свернуть("ЛС,Здание,ИмяЛС10","");
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Табл",Табл);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВЫРАЗИТЬ(Табл.ИмяЛС10 КАК СТРОКА(10)) КАК ИмяЛС10
		|ПОМЕСТИТЬ ИменаЛС
		|ИЗ
		|	&Табл КАК Табл
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛС,
		|	ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 10) КАК ИмяЛС10,
		|	бит_ЛицевыеСчета.Здание КАК Здание
		|ПОМЕСТИТЬ СписокЛС
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ИменаЛС.ИмяЛС10 КАК ИмяЛС10,
		|	СписокЛС.Здание КАК Здание,
		|	СписокЛС.ЛС КАК ЛС,
		|	ВЫБОР
		|		КОГДА СписокЛС.ЛС ЕСТЬ NULL
		|			ТОГДА ИСТИНА
		|		ИНАЧЕ ЛОЖЬ
		|	КОНЕЦ КАК ЕстьОшибка
		|ПОМЕСТИТЬ ВсеТабл
		|ИЗ
		|	ИменаЛС КАК ИменаЛС
		|		ЛЕВОЕ СОЕДИНЕНИЕ СписокЛС КАК СписокЛС
		|		ПО ИменаЛС.ИмяЛС10 = СписокЛС.ИмяЛС10
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеТабл.ИмяЛС10 КАК ИмяЛС10,
		|	ВсеТабл.Здание КАК Здание,
		|	ВсеТабл.ЛС КАК ЛС
		|ИЗ
		|	ВсеТабл КАК ВсеТабл
		|ГДЕ
		|	ВсеТабл.ЕстьОшибка = ЛОЖЬ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВсеТабл.ИмяЛС10 КАК ИмяЛС10
		|ИЗ
		|	ВсеТабл КАК ВсеТабл
		|ГДЕ
		|	ВсеТабл.ЕстьОшибка = ИСТИНА";
	
	Массив = ЗАпрос.ВыполнитьПакет();
	Табл = Массив[3].Выгрузить();
	Объект.ПерезагружаемыеЛС.Загрузить(Табл);
	
	
	ВыборкаОшибок = Массив[4].Выбрать();
	Если ложь тогда ВыборкаОшибок = Запрос.Выполнить().Выбрать() КонецЕсли;
	Если ВыборкаОшибок.Количество()>0 тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("В файлах IZM есть имена ЛС, отсутствующие в базе БИТ ЖКХ: ");
		Пока ВыборкаОшибок.Следующий() цикл
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ВыборкаОшибок.ИмяЛС10);
		КонецЦикла;			
	КонецЕсли;	
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("---- Список перезагружаемых ЛС обновлён----");               	
	
	
КонецПроцедуры

