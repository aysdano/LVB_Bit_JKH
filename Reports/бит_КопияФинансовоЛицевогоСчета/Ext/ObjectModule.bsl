
#Если Клиент Тогда
	
#Область ФормированиеЗаголовкаОтчета

// Формирует заголовок отчета.
//
// Параметры:
//	Нет.
//
Функция ЗаголовокОтчета() Экспорт

	ИмяОтчета = "Платежный баланс";
	
	Возврат ИмяОтчета ;
	
КонецФункции // ЗаголовокОтчета()

#КонецОбласти

#Область ПостроениеОтчета
	
// Процедура устанавливает ограничения по запросу.
Процедура УстановитьПараметрыЗапроса(Запрос, Знач АвтоматическиРассчитатьКонечнуюДатуОтчета = Ложь)
		
		Запрос.УстановитьПараметр("ЛицевойСчет"       ,ЛицевойСчет);
		
		Запрос.УстановитьПараметр("НачалоПериода"     ,НачалоМесяца(НачалоПериода));
		
		Если НачалоПериода = '00010101000000' Тогда
			Запрос.УстановитьПараметр("НачалоПериода" ,НачалоПериода+1);
		КонецЕсли;
		
		// БИТ_ЖКХ добавление кода Начало: 14.06.2012 
		Если ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Справка 
			ИЛИ ВидОтчета = Перечисления.бит_ВидыОтчетовФинансовоЛицевогоСчета.Выписка Тогда
			КонецПериода = КонецМесяца(НачалоПериода);
		КонецЕсли;
		// БИТ_ЖКХ добавление кода конец : 14.06.2012
		// БИТ_ЖКХ добавление кода Начало: 05.09.2012 
		Если НачалоПериода >  КонецПериода Тогда
			КонецПериода = КонецМесяца(НачалоПериода);
		КонецЕсли;	 
		// БИТ_ЖКХ добавление кода конец : 05.09.2012
		КонечнаяДатаОтчета = КонецМесяца(КонецПериода);			
		
		Запрос.УстановитьПараметр("КонецПериода"      , КонечнаяДатаОтчета);
		Запрос.УстановитьПараметр("Момент"            ,КонецМесяца( КонецПериода));
		
КонецПроцедуры
	
// Формирование текста запроса.
//
// Возвращаемое значение:
//   Строка   – текст сформированного запроса.
//
Процедура СформироватьТекстЗапросов(ЗапросУслуги, ЗапросОстатки)
	// БИТ_ЖКХ добавление кода Начало: 23.08.2012 
	Если ЗаполненоГЦЖС Тогда
		условие = " И бит_СведенияПоУслугамЛССрезПоследних.Услуга.ГрафаОтчетаГЦЖС <> ЗНАЧЕНИЕ(Перечисление.бит_ГрафыОтчетаПоГЦЖС.ПустаяСсылка)";
	Иначе
		Условие = "";
	КонецЕсли;
	// БИТ_ЖКХ добавление кода конец : 23.08.2012
	ЗапросУслуги.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЛС.ЛицевойСчет,
	|	ЛС.Услуга,
	|	ЛС.Квартира,
	|	ЛС.РежимПотребления,
	|	ЛС.Поставщик,
	|	ЛС.СпособРасчета,
	|	ЛС.КоличествоЕдиницПотребления,
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	ЛС.Услуга.Приоритет КАК УслугаПриоритет
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|		бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|		бит_ЛицевыеСчета.Квартира КАК Квартира,
	|		бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления,
	|		бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик,
	|		бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета,
	|		бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления
	|	ИЗ
	|		РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|				&Момент,
	|				ЛицевойСчет В
	|					(ВЫБРАТЬ
	|						ЛицевыеСчета.Ссылка
	|					ИЗ
	|						Справочник.бит_ЛицевыеСчета КАК ЛицевыеСчета
	|					ГДЕ
	|						ЛицевыеСчета.Ссылка = &ЛицевойСчет)) КАК бит_СведенияПоУслугамЛССрезПоследних
	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|			ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
	|	ГДЕ
	|		бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|		И бит_ЛицевыеСчета.Ссылка = &ЛицевойСчет" + условие + ") КАК ЛС
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО ЛС.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|
	|УПОРЯДОЧИТЬ ПО
	|	УслугаПриоритет";
	// БИТ_ЖКХ изменения кода. Начало:
	ЗапросОстатки.Текст =
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период, МЕСЯЦ) КАК МесяцГод,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток, 0) КАК СуммаНачальныйОстаток,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток, 0) КАК СуммаКонечныйОстаток,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ.Приоритет КАК Приоритет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Месяц, , ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.МесяцГод КАК МесяцГод,
	|	Остатки.УслугаЖКХ КАК Услуга,
	|	Остатки.СуммаНачальныйОстаток КАК ВхСальдо,
	|	Остатки.СуммаКонечныйОстаток КАК ИсхСальдо,
	|	Остатки.Приоритет КАК Приоритет
	|ИЗ
	|	Остатки КАК Остатки
	|ИТОГИ
	|	СУММА(ВхСальдо),
	|	СУММА(ИсхСальдо),
	|	МАКСИМУМ(Приоритет)
	|ПО
	|	Услуга,
	|	МесяцГод ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки";
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("МесяцГод" , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Таблица.Колонки.Добавить("Услуга"   , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	Таблица.Колонки.Добавить("ВхСальдо" , ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Таблица.Колонки.Добавить("ИсхСальдо", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Таблица.Колонки.Добавить("Приоритет", ОбщегоНазначения.ОписаниеТипаЧисло(15));
	
	Выборка = ЗапросОстатки.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		ВыборкаУС = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "МесяцГод", "ВСЕ");
		
		Пока ВыборкаУС.Следующий() Цикл
			
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаУС);
			
		КонецЦикла; 
		
	КонецЦикла;
	
	ЗапросОстатки.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ОбъемыПоУслугамЖКХОбороты.Услуга,
	|	СУММА(бит_ОбъемыПоУслугамЖКХОбороты.ОбъемОборот) КАК Объем,
	|	НАЧАЛОПЕРИОДА(бит_ОбъемыПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК МесяцГод
	|ПОМЕСТИТЬ Объемы
	|ИЗ
	|	РегистрНакопления.бит_ОбъемыПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_ОбъемыПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ОбъемыПоУслугамЖКХОбороты.Услуга,
	|	НАЧАЛОПЕРИОДА(бит_ОбъемыПоУслугамЖКХОбороты.Период, МЕСЯЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК МесяцГод,
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
	|	СУММА(ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)) КАК Сумма,
	|	ВЫБОР
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|				ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|				ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|			ТОГДА ""Начисления""
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|			ТОГДА ""Льгота""
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|			ТОГДА ""Разовые""
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ВводНачальныхОстатковПоКУ
	|			ТОГДА ""Ввод нач. остатков""
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|			ТОГДА ""Оплата""
	|	КОНЕЦ КАК ВидНачисления,
	|	СУММА(ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.ОбъемОборот, 0)) КАК Объем,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА НачисленияПоУслугамЖКХОбороты.СуммаОборот * -1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Оплата
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ЛицевойСчет = &ЛицевойСчет) КАК НачисленияПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ),
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
	|	ВЫБОР
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|				ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|				ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|			ТОГДА ""Начисления""
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|			ТОГДА ""Льгота""
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|			ТОГДА ""Разовые""
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ВводНачальныхОстатковПоКУ
	|			ТОГДА ""Ввод нач. остатков""
	|		КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|			ТОГДА ""Оплата""
	|	КОНЕЦ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОстатков.Услуга,
	|	ТаблицаОстатков.МесяцГод,
	|	ТаблицаОстатков.ВхСальдо,
	|	ТаблицаОстатков.ИсхСальдо,
	|	ТаблицаОстатков.Приоритет
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	&ТаблицаОстатков КАК ТаблицаОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(Остатки.ВхСальдо, 0) КАК ВхСальдо,
	|	ЕСТЬNULL(Остатки.ИсхСальдо, 0) КАК ИсхСальдо,
	|	Остатки.Услуга КАК Услуга,
	|	Остатки.МесяцГод КАК МесяцГод,
	|	ЕСТЬNULL(Обороты.Сумма, 0) КАК Сумма,
	|	Обороты.ВидНачисления КАК ВидНачисления,
	|	ЕСТЬNULL(Объемы.Объем, 0) КАК Объем,
	|	Остатки.Приоритет КАК Приоритет,
	|	ЕСТЬNULL(Обороты.Оплата, 0) КАК Оплата
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
	|		ПО Остатки.Услуга = Обороты.Услуга
	|			И Остатки.МесяцГод = Обороты.МесяцГод
	|		ЛЕВОЕ СОЕДИНЕНИЕ Объемы КАК Объемы
	|		ПО Остатки.МесяцГод = Объемы.МесяцГод
	|			И Остатки.Услуга = Объемы.Услуга
	|
	|УПОРЯДОЧИТЬ ПО
	|	МесяцГод,
	|	Приоритет
	|ИТОГИ
	|	МАКСИМУМ(ВхСальдо),
	|	СУММА(ИсхСальдо),
	|	СУММА(Сумма),
	|	СУММА(Объем),
	|	СУММА(Оплата)
	|ПО
	|	МесяцГод,
	|	ВидНачисления,
	|	Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Объемы";
	
	ЗапросОстатки.УстановитьПараметр("ТаблицаОстатков",Таблица);
	// БИТ_ЖКХ изменение кода. Конец. 20.01.2012}}
КонецПроцедуры
	
// Выполняет запрос и формирует табличный документ-результат отчета.
// В соответствии с настройками, заданными значениями реквизитов отчета.
//
// Параметры:
//  ДокументРезультат - табличный документ, формируемый отчетом.
//
Процедура СформироватьОтчет(ДокументРезультат,  ПоказыватьЗаголовок = Истина, ВысотаЗаголовка = 0) Экспорт
		
		ДокументРезультат.Очистить();
		ДокументРезультат.КлючПараметровПечати = "ПАРАМЕТРЫ_ПЕЧАТИ_КопияФинансовоЛицевогоСчета";
