	КонецЕсли; 	
	
КонецПроцедуры

// Функция формирует таблицу значений данных проживающих на ЛС.
Функция ФормироватьСписокОсновныхДанных() Экспорт 
	
	// БИТ_ЖКХ_09082013_изменение
	// Добавлена информация из регистра сведений "бит_ВоинскийУчет".
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	
	"ВЫБРАТЬ
	|	СписокФизЛиц.ФизЛицо
	|ПОМЕСТИТЬ СписокФизЛиц
	|ИЗ
	|	&СписокФизЛиц КАК СписокФизЛиц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СписокФизЛиц.ФизЛицо,
	|	СписокФизЛиц.ФизЛицо.МестоРождения КАК МестоРождения,
