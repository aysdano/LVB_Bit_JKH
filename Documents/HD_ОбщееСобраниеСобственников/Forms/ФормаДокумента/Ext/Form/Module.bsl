//HD+
// Получает индекс строки из объекта документа по номеру строки
//
&НаКлиенте
Функция ПолучитьИндексСтрокиПоНомеруСтроки(НомерСтроки)
	
	// Ищем строку в объекте по номеру строки
	Для Индекс = 0 По Объект.ПовесткаДня.Количество() - 1 Цикл
		Попытка
			Если Объект.ПовесткаДня[Индекс].НомерСтроки = НомерСтроки Тогда
				Возврат Индекс;
			КонецЕсли;
		Исключение
			// Пропускаем строку, если не удалось получить номер строки
		КонецПопытки;
	КонецЦикла;
	
	// Если строка не найдена, возвращаем -1
	Возврат -1;
	
КонецФункции //HD-

//HD+
// Сохраняет шаблоны текста для полей табличной части ПовесткаДня из справочника HD_ПовесткиСобранийСобственников
// Используется для восстановления исходных значений при редактировании с подчеркиваниями
//
&НаСервере
Процедура СохранитьШаблоныТекстаПовесткиДняНаСервере()
	
	// Инициализируем соответствие для хранения шаблонов текста
	// Ключ: "ИндексСтроки_ИмяПоля", Значение: шаблон текста из справочника
	ШаблоныТекста = Новый Соответствие;
	
	// Проверяем наличие шаблона повестки
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонПовестки) Тогда
		// Если шаблон повестки не заполнен, сохраняем шаблоны из текущих значений табличной части
		Если Объект.ПовесткаДня.Количество() > 0 Тогда
			ИндексСтроки = 0;
			Для Каждого СтрокаПовестки Из Объект.ПовесткаДня Цикл
				
				// Сохраняем текущее значение как шаблон для поля Вопрос
				Если ЗначениеЗаполнено(СтрокаПовестки.Вопрос) Тогда
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Вопрос";
					ШаблоныТекста.Вставить(Ключ, СтрокаПовестки.Вопрос);
				КонецЕсли;
				
				// Сохраняем текущее значение как шаблон для поля ФормулировкаПредложенияРешенияВопроса
				Если ЗначениеЗаполнено(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса) Тогда
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса";
					ШаблоныТекста.Вставить(Ключ, СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса);
				КонецЕсли;
				
				ТекстПриложения = ПолучитьТекстПриложенияСтрокиПовестки(СтрокаПовестки);
				Если ЗначениеЗаполнено(ТекстПриложения) Тогда
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Приложение";
					ШаблоныТекста.Вставить(Ключ, ТекстПриложения);
				КонецЕсли;
				
				ИндексСтроки = ИндексСтроки + 1;
				
			КонецЦикла;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	// Проверяем наличие табличной части в шаблоне
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонПовестки.СписокПевесток) 
		ИЛИ Объект.ШаблонПовестки.СписокПевесток.Количество() = 0 Тогда
		// Если табличная часть шаблона пуста, сохраняем шаблоны из текущих значений табличной части
		Если Объект.ПовесткаДня.Количество() > 0 Тогда
			ИндексСтроки = 0;
			Для Каждого СтрокаПовестки Из Объект.ПовесткаДня Цикл
				
				// Сохраняем текущее значение как шаблон для поля Вопрос
				Если ЗначениеЗаполнено(СтрокаПовестки.Вопрос) Тогда
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Вопрос";
					ШаблоныТекста.Вставить(Ключ, СтрокаПовестки.Вопрос);
				КонецЕсли;
				
				// Сохраняем текущее значение как шаблон для поля ФормулировкаПредложенияРешенияВопроса
				Если ЗначениеЗаполнено(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса) Тогда
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса";
					ШаблоныТекста.Вставить(Ключ, СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса);
				КонецЕсли;
				
				ТекстПриложения = ПолучитьТекстПриложенияСтрокиПовестки(СтрокаПовестки);
				Если ЗначениеЗаполнено(ТекстПриложения) Тогда
					Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Приложение";
					ШаблоныТекста.Вставить(Ключ, ТекстПриложения);
				КонецЕсли;
				
				ИндексСтроки = ИндексСтроки + 1;
				
			КонецЦикла;
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	//HD+ Всегда получаем исходные тексты из справочника HD_ПовесткиСобранийСобственников
	// Шаблоны должны быть исходными значениями из справочника, а не из текущих значений табличной части
	// Это необходимо для корректной работы функционала возврата к исходному значению
	ИндексСтроки = 0;
	Для Каждого СтрокаТЧ Из Объект.ШаблонПовестки.СписокПевесток Цикл
		
		// Пропускаем строки без ссылки на повестку
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Повестка) Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			ДанныеПунктаПовестки = ПолучитьДанныеПунктаПовесткиСправочника(СтрокаТЧ.Повестка);
			
			Если ЗначениеЗаполнено(ДанныеПунктаПовестки.Вопрос) Тогда
				Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Вопрос";
				ШаблоныТекста.Вставить(Ключ, ДанныеПунктаПовестки.Вопрос);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеПунктаПовестки.ФормулировкаПредложенияРешенияВопроса) Тогда
				Ключ = Формат(ИндексСтроки, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса";
				ШаблоныТекста.Вставить(Ключ, ДанныеПунктаПовестки.ФормулировкаПредложенияРешенияВопроса);
			КонецЕсли;
			
			Если ЗначениеЗаполнено(ДанныеПунктаПовестки.Приложение) Тогда
				Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Приложение";
				ШаблоныТекста.Вставить(Ключ, ДанныеПунктаПовестки.Приложение);
			КонецЕсли;
			
			ИндексСтроки = ИндексСтроки + 1;
			
		Исключение
			// Если не удалось получить объект справочника, пропускаем строку
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Заполняет табличную часть ПользовательскиеПараметры именами параметров, найденных в текстах справочника HD_ПовесткиСобранийСобственников.
// Параметры в тексте задаются в квадратных скобках: [ИмяПараметра].
//
&НаСервере
Процедура ЗаполнитьПользовательскиеПараметрыПоШаблонуПовесткиНаСервере()
	
	// Очищаем табличную часть всегда — при смене шаблона состав параметров может измениться
	Объект.ПользовательскиеПараметры.Очистить();
	
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонПовестки) Тогда
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.ШаблонПовестки.СписокПевесток)
		ИЛИ Объект.ШаблонПовестки.СписокПевесток.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	НайденныеПараметры = Новый Массив;
	УжеЕсть = Новый Соответствие; // ключ = имя параметра
	СоответствиеТиповПараметров = Новый Соответствие; // ключ = имя параметра, значение = строка типа
	СоответствиеОбъектДляСвязи = Новый Соответствие; // ключ = имя параметра, значение = путь к реквизиту документа (например "Объект.МКД")
	//HD+
	СоответствиеПадежей = Новый Соответствие; // ключ = имя параметра, значение = ПеречислениеСсылка.HD_Падежи
	//HD-
	
	Для Каждого СтрокаТЧ Из Объект.ШаблонПовестки.СписокПевесток Цикл
		
		Если НЕ ЗначениеЗаполнено(СтрокаТЧ.Повестка) Тогда
			Продолжить;
		КонецЕсли;
		
		ДанныеПунктаПовестки = ПолучитьДанныеПунктаПовесткиСправочника(СтрокаТЧ.Повестка);
		ИзвлечьПараметрыИзТекста(ДанныеПунктаПовестки.Вопрос, НайденныеПараметры, УжеЕсть);
		ИзвлечьПараметрыИзТекста(ДанныеПунктаПовестки.ФормулировкаПредложенияРешенияВопроса, НайденныеПараметры, УжеЕсть);
		ИзвлечьПараметрыИзТекста(ДанныеПунктаПовестки.Приложение, НайденныеПараметры, УжеЕсть);
		
		Попытка
			ОбъектПовестки = СтрокаТЧ.Повестка.ПолучитьОбъект();
		Исключение
			ОбъектПовестки = Неопределено;
		КонецПопытки;
		
		Если ОбъектПовестки = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		//HD+ Запоминаем типы параметров из табличной части НастройкаПользовательскихПараметров справочника повестки
		Если ЗначениеЗаполнено(ОбъектПовестки.НастройкаПользовательскихПараметров) Тогда
			Для Каждого СтрокаНастройки Из ОбъектПовестки.НастройкаПользовательскихПараметров Цикл
				ИмяПараметраНастройки = СокрЛП(Строка(СтрокаНастройки.Параметр));
				ТипПараметраНастройки = СокрЛП(Строка(СтрокаНастройки.ТипПараметра));
				Если ЗначениеЗаполнено(ИмяПараметраНастройки)
					И ЗначениеЗаполнено(ТипПараметраНастройки)
					И СоответствиеТиповПараметров.Получить(ИмяПараметраНастройки) = Неопределено Тогда
					СоответствиеТиповПараметров.Вставить(ИмяПараметраНастройки, ТипПараметраНастройки);
				КонецЕсли;
				
				//HD+ Подстановка значения из реквизита документа по пути ОбъектДляСвязи
				ОбъектДляСвязиНастройки = СокрЛП(Строка(СтрокаНастройки.ОбъектДляСвязи));
				Если ЗначениеЗаполнено(ИмяПараметраНастройки)
					И ЗначениеЗаполнено(ОбъектДляСвязиНастройки)
					И СоответствиеОбъектДляСвязи.Получить(ИмяПараметраНастройки) = Неопределено Тогда
					СоответствиеОбъектДляСвязи.Вставить(ИмяПараметраНастройки, ОбъектДляСвязиНастройки);
				КонецЕсли;
				
				//HD+ Падеж параметра из настройки справочника повестки
				Если ЗначениеЗаполнено(ИмяПараметраНастройки)
					И ЗначениеЗаполнено(СтрокаНастройки.Падеж)
					И СоответствиеПадежей.Получить(ИмяПараметраНастройки) = Неопределено Тогда
					СоответствиеПадежей.Вставить(ИмяПараметраНастройки, СтрокаНастройки.Падеж);
				КонецЕсли;
				//HD-
				
			КонецЦикла;
		КонецЕсли;
		//HD-
		
	КонецЦикла;
	
	Для Каждого СтрокаПовестки Из Объект.ПовесткаДня Цикл
		ИзвлечьПараметрыИзТекста(Строка(СтрокаПовестки.Вопрос), НайденныеПараметры, УжеЕсть);
		ИзвлечьПараметрыИзТекста(Строка(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса), НайденныеПараметры, УжеЕсть);
		ИзвлечьПараметрыИзТекста(ПолучитьТекстПриложенияСтрокиПовестки(СтрокаПовестки), НайденныеПараметры, УжеЕсть);
	КонецЦикла;
	
	Для Каждого ИмяПараметра Из НайденныеПараметры Цикл
		НоваяСтрока = Объект.ПользовательскиеПараметры.Добавить();
		НоваяСтрока.Параметр = ИмяПараметра;
		Если СоответствиеТиповПараметров.Получить(ИмяПараметра) <> Неопределено Тогда
			НоваяСтрока.ТипПараметра = СоответствиеТиповПараметров.Получить(ИмяПараметра);
		Иначе
			НоваяСтрока.ТипПараметра = "";
		КонецЕсли;
		
		//HD+ Автозаполнение Значение из реквизита документа по ОбъектДляСвязи
		Если СоответствиеОбъектДляСвязи.Получить(ИмяПараметра) <> Неопределено Тогда
			НоваяСтрока.ОбъектДляСвязи = СоответствиеОбъектДляСвязи.Получить(ИмяПараметра);
			НоваяСтрока.Значение = ПолучитьЗначениеРеквизитаДокументаПоПути(НоваяСтрока.ОбъектДляСвязи);
		КонецЕсли;
		
		//HD+ Составной параметр списка членов совета: автосвязь, если в настройке повестки путь не задан
		Если ЭтоИмяИлиПутьСпискаПредложенныхЧленовСовета(ИмяПараметра, НоваяСтрока.ОбъектДляСвязи) Тогда
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.ОбъектДляСвязи) Тогда
				НоваяСтрока.ОбъектДляСвязи = ПутьСвязиСпискаПредложенныхЧленовСовета();
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.ТипПараметра) Тогда
				НоваяСтрока.ТипПараметра = "Строка";
			КонецЕсли;
			НоваяСтрока.Значение = СформироватьСписокПредложенныхЧленовСовета();
		КонецЕсли;
		
		//HD+ Составной параметр предложенного председателя: автосвязь, если в настройке повестки путь не задан
		Если ЭтоИмяИлиПутьПредложенногоПредседателя(ИмяПараметра, НоваяСтрока.ОбъектДляСвязи) Тогда
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.ОбъектДляСвязи) Тогда
				НоваяСтрока.ОбъектДляСвязи = ПутьСвязиПредложенногоПредседателя();
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(НоваяСтрока.ТипПараметра) Тогда
				НоваяСтрока.ТипПараметра = "Строка";
			КонецЕсли;
			НоваяСтрока.Значение = СформироватьПредложенногоПредседателя();
		КонецЕсли;
		//HD-
		
		//HD+ Падеж параметра из справочника повестки; по умолчанию — КакЕсть (без склонения)
		Если СоответствиеПадежей.Получить(ИмяПараметра) <> Неопределено Тогда
			НоваяСтрока.Падеж = СоответствиеПадежей.Получить(ИмяПараметра);
		Иначе
			НоваяСтрока.Падеж = Перечисления.HD_Падежи.КакЕсть;
		КонецЕсли;
		//HD-
		
		Если ТипПараметраДопускаетСтрокуВместоСсылки(ИмяПараметра, НоваяСтрока.ТипПараметра)
			И НЕ ЗначениеЗаполнено(НоваяСтрока.Значение)
			И ТипЗнч(НоваяСтрока.Значение) <> Тип("Строка") Тогда
			НоваяСтрока.Значение = "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
