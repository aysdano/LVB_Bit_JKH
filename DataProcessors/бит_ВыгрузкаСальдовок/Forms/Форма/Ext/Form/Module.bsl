	Запрос.УстановитьПараметр("ДатаОкончанияБезВремени", КонецДня(КонецПериода));
	Запрос.УстановитьПараметр("ТекДата", Новый Граница(КонецДня(НачалоДня(ТекущаяДата())-1), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("Начисления", МассивНачислений);
	Запрос.УстановитьПараметр("Организация", Организация);
