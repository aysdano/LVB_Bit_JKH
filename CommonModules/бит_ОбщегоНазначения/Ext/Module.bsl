			//Начисление СуммыПени по СальдоПени.
			Если КоммунальныеУслуги.Колонки.Найти("СальдоНаНачало") <> Неопределено ИЛИ КоммунальныеУслуги.Колонки.Найти("СальдоПени") <> Неопределено Тогда
				РаспределитьСуммуПоПени(КоммунальныеУслуги, СуммаДокумента,СуммаДляРаспределения,НачислятьПениСУчетомПереплаты,ИтогОплата);
