&НаКлиенте
Процедура СписокПроживающихПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	НоваяСтрока = Объект.СписокПроживающих.Добавить();
	
	НоваяСтрока.СтатусФизЛица    = ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.ПостояннаяРегистрация");
	НоваяСтрока.СтепеньРодства   = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_НеУказано");
	НоваяСтрока.СтатусПроживания = ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Постоянно");
	НоваяСтрока.ФизЛицо          = ПредопределенноеЗначение("Справочник.бит_Проживающие.ПустаяСсылка");
	
КонецПроцедуры

&НаКлиенте
Процедура СписокПроживающихФизЛицоПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.СписокПроживающих.ТекущиеДанные;
	
	// БИТ_ЖКХ 23.12.2014{{
	// Структура   с данными адреса.
	// АдресУбытия   = бит_ОбщегоНазначения.ПолучитьАдресИзКонтактнойИнформацииФизЛица(ТекущиеДанные.ФизЛицо, "Убытия"  , Истина);.
	// АдресПрибытия = бит_ОбщегоНазначения.ПолучитьАдресИзКонтактнойИнформацииФизЛица(ТекущиеДанные.ФизЛицо, "Прибытия", Истина);.
	
	АдресПрибытия   = КонтактнаяИнформацияНаСервере(ТекущиеДанные.ФизЛицо, "Прибытия");
	
	АдресУбытия   = КонтактнаяИнформацияНаСервере(ТекущиеДанные.ФизЛицо, "Убытия");
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.ОткудаПрибылАдрес) и ЗначениеЗаполнено(АдресПрибытия.Адрес) Тогда
		
		ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.ОткудаПрибылАдрес = АдресПрибытия.Адрес;
		ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.ДатаПрибытия = АдресПрибытия.ДатаРегистрации;
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Откуда прибыл адрес взят из " + АдресПрибытия.СсылкаНаЗаявление);
		
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.КудаВыписанАдрес) и ЗначениеЗаполнено(АдресУбытия.Адрес) Тогда
		
		ЭтаФорма.ТекущийЭлемент.ТекущиеДанные.КудаВыписанАдрес 	= АдресУбытия.Адрес;
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Куда выписан адрес взят из " + АдресУбытия.СсылкаНаЗаявление);
		
	КонецЕсли; 
	// БИТ_ЖКХ 23.12.2014}}
	
КонецПроцедуры

// БИТ_ЖКХ 23.12.2014{{
&НаСервере
Функция КонтактнаяИнформацияНаСервере(ФизЛицо,ПрибытияУбытия)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация.Ссылка,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация.Тип,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация.Вид,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация.Представление,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ.КонтактнаяИнформация КАК бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация.Ссылка.РегистрируемоеЛицо = &ФизЛицо
	|	И бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация.Тип = &Тип
	|	И бит_ЗаявлениеОРегистрацииПоМестуПЖКонтактнаяИнформация.Вид = &Вид
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	
	Запрос.УстановитьПараметр("Тип"   , Перечисления.ТипыКонтактнойИнформации.Адрес);
	
	Если ПрибытияУбытия = "Прибытия" Тогда
		Запрос.УстановитьПараметр("Вид"   , ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ОткудаПрибылПредставление"));
	ИначеЕсли ПрибытияУбытия = "Убытия" Тогда
		Запрос.УстановитьПараметр("Вид"   , ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.КудаВыписанПредставление"));
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Адрес = ВыборкаДетальныеЗаписи.Представление;
		СсылкаНаЗаявление = ВыборкаДетальныеЗаписи.Ссылка;
		
	Иначе
		
		Если ПрибытияУбытия = "Прибытия" Тогда
			
			Адрес = бит_ОбщегоНазначения.ПолучитьАдресИзКонтактнойИнформацииФизЛица(ФизЛицо, "Прибытия", Истина);
			
			Если Строка(ТипЗнч(Адрес)) = "Структура" Тогда
				
				Если Адрес.Свойство("Представление") Тогда
					
					Адрес = Адрес.Представление;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		ИначеЕсли ПрибытияУбытия = "Убытия" Тогда
			Адрес   = бит_ОбщегоНазначения.ПолучитьАдресИзКонтактнойИнформацииФизЛица(ФизЛицо, "Убытия"  , Истина);
			
			Если Строка(ТипЗнч(Адрес)) = "Структура" Тогда
				
				Если Адрес.Свойство("Представление") Тогда
					
					Адрес = Адрес.Представление;
					
				КонецЕсли;	
				
			КонецЕсли;	
			
		КонецЕсли;
		
		СсылкаНаЗаявление = "";
		
	КонецЕсли;
	
	Структура = Новый Структура;
	Структура.Вставить("Адрес",Адрес);
	Если ЗначениеЗаполнено(СсылкаНаЗаявление) и ПрибытияУбытия = "Прибытия" Тогда
		Структура.Вставить("ДатаРегистрации",СсылкаНаЗаявление.ДатаРегистрации);
	КонецЕсли;
	Структура.Вставить("СсылкаНаЗаявление",СсылкаНаЗаявление);
	
	Возврат Структура;
	
КонецФункции
// БИТ_ЖКХ 23.12.2014}}

