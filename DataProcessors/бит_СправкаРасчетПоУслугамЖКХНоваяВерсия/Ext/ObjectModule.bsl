Процедура ЗаполнениеОБластиУслугиОДНПоТекПериоду(СоответствиеУжеРаспределеноНАОДН,СоответствиеУжеРаспределеноНАОДНТекПериод,СуммыПоБухСправке, ЭтоУслугаСодРем, СтрокаОплаты, СуммаГВ, ГВНач, ДолгГВ, ОбластьТаблицаПараметрыОплатаТекПериодГВ, ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ, СуммаОплатыТекПериод, СуммаОплатыПрошлыйПериод, ЭтоПерваяСтрока, ЭтоБухСправка, ПериодОбразованияЗадолженностиПо, ЛС = Неопределено, ДатаОстатка = Неопределено, ДанныеРазовые = Неопределено, Коэфф = 1, ГВТек = 0, ХВТек = 0, ВОТек = 0, ЭЛТек = 0, ДолженПоОДН = Ложь,
	ГВ=0, ХВ=0, ВО=0, ЭЭ=0, ОбластьТаблица = Неопределено);//, ГВНачислено = 0, ХВНачислено = 0, ВОНачислено = 0, ЭЛНачислено = 0)                                            
	
	УслугаСодРем        = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001");
	УслугаВО     	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000005");
	УслугаГВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000003");
	УслугаХВ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000004");
	УслугаЭЭ    	    = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000002");
	
	Если ЭтоБухСправка И  ((-Окр(ГВНач,2)  = СуммаГВ И (Окр(СуммаОплатыПрошлыйПериод,2) = 0 Или Окр(ДолгГВ,2) <= 0))  ИЛИ  СуммаГВ<0) Тогда
		Если  СуммаГВ < 0 Тогда
			ТП = Мин(СуммыПоБухСправке.СуммаПоБухСправке,-СуммаГВ);  
			ПП = ?( Окр(СуммаОплатыПрошлыйПериод,2) = 0,0,СуммаГВ + ТП + СуммыПоБухСправке.СуммаВПрошломПериодеНаВозврат);
			ОбластьТаблицаПараметрыОплатаТекПериодГВ	= ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ),"", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Формат(-ТП,"ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС ;
			ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ),"", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Формат(ПП,"ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
	        ГВНач = ГВНач + ТП;        
			ДолгГВ = ДолгГВ-ПП;
			СуммаОплатыПрошлыйПериод = СуммаОплатыПрошлыйПериод + ПП; 
			СуммаОплатыТекПериод = СуммаОплатыТекПериод - ТП;      
			СуммыПоБухСправке.СуммаВПрошломПериодеНаВозврат = 0;
		Иначе   
			ОбластьТаблицаПараметрыОплатаТекПериодГВ	= ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ),"", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Символы.ПС ;
			ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ),"", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Символы.ПС;
			Если (-Окр(ГВНач,2)  = СуммаГВ И Окр(ДолгГВ,2) <= 0)  Тогда
				СуммыПоБухСправке.СуммаВПрошломПериодеНаВозврат = СуммыПоБухСправке.СуммаВПрошломПериодеНаВозврат + ОКр(СуммаГВ,2);   
            КонецЕсли;	
		КонецЕсли;
	ИначеЕсли Окр(ГВНач,5) >0 Тогда
		ОбластьТаблицаПараметрыОплатаТекПериодГВ	= ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ),"", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Формат(СуммаГВ,"ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
		ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ),"", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Символы.ПС;
		СуммаОплатыТекПериод = СуммаОплатыТекПериод + СуммаГВ;    
		Если СуммыПоБухСправке <> 0 Тогда

			СуммыПоБухСправке.СуммаПоБухСправке = СуммыПоБухСправке.СуммаПоБухСправке + ОКр(СуммаГВ,2);     
		КонецЕсли;

	Иначе  
		//++Анисимова 07.11 1бит  Мешало выводу по Исп листу в текущий период минусовых сумм
		//Если Не ЭтоУслугаСодРем и ДолгГВ > 0 и СуммаГВ <= 0 Тогда
		//	ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ  = ?(ЭтоПерваяСтрока, "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Символы.ПС;
		//	ОбластьТаблицаПараметрыОплатаТекПериодГВ = ?(ЭтоПерваяСтрока, "", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Символы.ПС;
		//	Возврат;
		//КонецЕсли;
		//ДолгГВ = ДолгГВ - (-ГВНач);
		//Если 
		//--Анисимова 07.11 1бит   
		//Правки 13.11 для выпода с периодом оплаты за более ранний месяц в рамках отбора  

		//Если СуммаГВ <= ГВНач Тогда
			//++Анисимова 07.11 1бит
			Если СтрокаОплаты.ПериодОплаты >= ПериодОбразованияЗадолженностиПо И (ОКР(ГВНач,2)>=0 ИЛИ ОКР(ДолгГВ,2) <= 0) Тогда
				ОбластьТаблицаПараметрыОплатаТекПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ), "", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Формат(СуммаГВ, "ЧДЦ=2; ЧРД=,; ЧН=") + Символы.ПС;
				ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ  = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Символы.ПС;
				СуммаОплатыТекПериод = СуммаОплатыТекПериод + СуммаГВ;     
				Если СуммыПоБухСправке <> 0 Тогда
					СуммыПоБухСправке.СуммаПоБухСправке = СуммыПоБухСправке.СуммаПоБухСправке + ОКР(СуммаГВ,2) ;    
				 КонецЕсли;
			Иначе
				//--Анисимова 07.11 1бит   
				СуммаПП =?(ДолгГВ +ГВНач<=0,ДолгГВ, -ГВНач);; 
				СуммаТП = СуммаГВ -СуммаПП ;              
				ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ  = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ), "", ОбластьТаблицаПараметрыОплатаЗаПрошлыйПериодГВ) + Формат(СуммаПП, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;
				ОбластьТаблицаПараметрыОплатаТекПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблицаПараметрыОплатаТекПериодГВ), "", ОбластьТаблицаПараметрыОплатаТекПериодГВ) + Формат(СуммаТП, "ЧДЦ=2; ЧРД=,; ЧН=") + Символы.ПС;
				СуммаОплатыТекПериод = СуммаОплатыТекПериод + СуммаТП;
				СуммаОплатыПрошлыйПериод = СуммаОплатыПрошлыйПериод + СуммаПП;   
				Если СуммыПоБухСправке<>0  Тогда
					СуммыПоБухСправке.СуммаПоБухСправке = СуммыПоБухСправке.СуммаПоБухСправке +  ОКР(СуммаТП,2) ;   
				КонецЕсли;	
				
				ДолгГВ = ДолгГВ -СуммаПП;
				Если ГВНач < 0 Тогда  
					ГВНач = 0;
				КонецЕсли;
			КонецЕсли;
