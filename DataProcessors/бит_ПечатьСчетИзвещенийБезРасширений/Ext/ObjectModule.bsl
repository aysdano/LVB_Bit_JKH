	ОбластьКвитанции.Параметры.Текст                 = ПолучитьТекстДляКвитанции();
	ОбластьКвитанции.Параметры.Всего                 = Число(ОбластьКвитанции.Параметры.ПениКОплате) + ОбластьКвитанции.Параметры.ДопВзносКОплате + ОбластьКвитанции.Параметры.МинВзносКОплате;
	ОбластьКвитанции.Параметры.НомерЛС               = Лев(СокрЛП(мСтруктураДанных.ЛицевойСчетНомер),4)+"   "+Прав(СокрЛП(мСтруктураДанных.ЛицевойСчетНомер),7);;
	ОбластьКвитанции.Параметры.Организация           = ДанныеОПолучателеПлатежа[0].Наименование;
	ОбластьКвитанции.Параметры.КПП                   = ДанныеОПолучателеПлатежа[0].КПП;
	ОбластьКвитанции.Параметры.ИНН                   = ДанныеОПолучателеПлатежа[0].ИНН;
	ОбластьКвитанции.Параметры.Банк                  = "В " + ДанныеОПолучателеПлатежа[0].Банк;
	ОбластьКвитанции.Параметры.БИК                   = ДанныеОПолучателеПлатежа[0].БИК;
	ОбластьКвитанции.Параметры.КоррСчет              = ДанныеОПолучателеПлатежа[0].КоррСчет;
	ОбластьКвитанции.Параметры.РасчетныйСчет         = РасчетныйСчет;
	ОбластьКвитанции.Параметры.ЮрАдрес               = ПолучательАдрес;
	ОбластьКвитанции.Параметры.ЕЛСГИСЖКХ             = мСтруктураДанных.ЕЛСГИСЖКХ;
	ОбластьКвитанции.Параметры.Адрес                 = лб_сервер.лб_АдресЛС(мСтруктураДанных.ЛицевойСчет, мСтруктураДанных.Дата);
	ОбластьКвитанции.Параметры.МесяцГодСтрока        = мСтруктураДанных.Период;
	ОбластьКвитанции.Параметры.ПериодМесяцГод        = мСтруктураДанных.ПериодМесяц + "." + мСтруктураДанных.ПериодГод;
	ОбластьКвитанции.Параметры.ПериодДеньМесяцГод    = "01." + мСтруктураДанных.ПериодМесяц + "." + мСтруктураДанных.ПериодГод;
	ОбластьКвитанции.Параметры.ОтветственныйФИО      = Плательщик;
	
	//shevtsov 12.12.25 Начало
	//Было:
	//ОбластьКвитанции.Параметры.ДатаПечати     	     = мСтруктураДанных.ДатаПечатиКвитанций;
	//Стало:
	Если НЕ БИТ_НеВыводитьДатуПечати Тогда
																 
		ОбластьКвитанции.Параметры.БлокДатаПечатиКвитанций = СтрШаблон(НСтр("ru='Дата печати %1%2'"),
															   "",
															   Формат(?(ЗначениеЗаполнено(ДатаПечатиКвитанций), ДатаПечатиКвитанций, ТекущаяДата()), "ДФ=дд.ММ.гггг")); 
		
	КонецЕсли;
	//shevtsov 12.12.25 Окончание
	
	ОбластьКвитанции.Параметры.ИнфоАО       	     = мСтруктураДанных.АдресУчастка;
	ОбластьКвитанции.Параметры.ИнфоАОТ     	         = "Телефоны: " + мСтруктураДанных.ТелефоныУчастка;
	ОбластьКвитанции.Параметры.КодПочты1     	     = КодПочты1СРазделителем;
	ОбластьКвитанции.Параметры.КодПочты2     	     = КодПочты2СРазделителем;
	ОбластьКвитанции.Параметры.ПлощадьКвартиры       = Формат(Площадь,"ЧДЦ=2");
	ОбластьКвитанции.Параметры.ДопТекстКОплате       = ДопТекстКОплате;
	МакетКапРемонт.Вывести(ОбластьКвитанции);
	//Перерасчеты
	МассивУслугКапРем = Новый Массив;
	МассивУслугКапРем.Добавить(УслугаМинВзнос);
	МассивУслугКапРем.Добавить(УслугаДопВзнос);
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ЛицевойСчет",мСтруктураДанных.ЛицевойСчет);
	Запрос.УстановитьПараметр("Период",мСтруктураДанных.Дата);
	Запрос.УстановитьПараметр("МассивУслуг",МассивУслугКапРем);
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХ.Регистратор КАК Регистратор,
	|	бит_НачисленияПоУслугамЖКХ.УслугаЖКХ КАК Услуга,
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХ.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Расход)
	|			ТОГДА -бит_НачисленияПоУслугамЖКХ.Сумма
	|		ИНАЧЕ бит_НачисленияПоУслугамЖКХ.Сумма
	|	КОНЕЦ КАК Сумма,
	|	бит_НачисленияПоУслугамЖКХ.Регистратор.ДокументНаПерерасчет КАК Основание,
	|	бит_НачисленияПоУслугамЖКХ.ВидДвижения КАК ВидДвижения
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ КАК бит_НачисленияПоУслугамЖКХ
	|ГДЕ
	|	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет = &ЛицевойСчет
	|	И бит_НачисленияПоУслугамЖКХ.Период МЕЖДУ НАЧАЛОПЕРИОДА(&Период, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Период, МЕСЯЦ)
	|	И ТИПЗНАЧЕНИЯ(бит_НачисленияПоУслугамЖКХ.Регистратор) = ТИП(Документ.бит_РазовыеПоУслугамЖКХ)
	|	И бит_НачисленияПоУслугамЖКХ.УслугаЖКХ В(&МассивУслуг)";
	Выборка = Запрос.Выполнить().Выбрать();
	Первый = Истина;
	Пока Выборка.Следующий() Цикл
		ОбластьПерерасчет = МакетКвитанции.ПолучитьОбласть("ОбластьШирина|ОбластьПерерасчет");
		//ОбластьЧастьЦентрНижняяЧасть4 = мМакет.ПолучитьОбласть("Область16|Область8");
		//ОбластьЧастьЦентрНижняяЧасть4.Параметры.Перерасчет = Строка.Основание + " (" + Строка(Строка.Услуга) + " " + Строка(Строка.Сумма) + " руб.)";
		Если Первый Тогда
			ОбластьПерерасчет.Параметры.Причина = "Причина и сумма перерасчета";
			Первый = Ложь;
		КонецЕсли;
		ОбластьПерерасчет.Параметры.Перерасчет = СТрока(Выборка.Основание) + ": " + Строка(Выборка.Сумма) + " р. " + " ("+ Строка(Выборка.Услуга) + ").";
		МакетКапРемонт.Вывести(ОбластьПерерасчет);
	КонецЦикла;	
	Возврат МакетКапРемонт;
КонецФункции


Функция ДанныеОПолучателе(ПолучательПлатежа,ТипПолучателя,РасчетныйСчет)
	
	Если ТипПолучателя = Истина Тогда
		Спр = "Организации";
		Сокращенное = "Сокращенное";
	Иначе
		Спр = "Контрагенты";
		Сокращенное = "";
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ПолучательПлатежа.Наименование"+Сокращенное+" КАК Наименование,
	|	ПолучательПлатежа.ИНН КАК ИНН,
	|	ПолучательПлатежа.КПП КАК КПП,
	|	БанковскиеСчета.Банк.Наименование КАК Банк,
	|	БанковскиеСчета.Банк.Код КАК БИК,
	|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет
	|ИЗ
	|	Справочник."+Спр+" КАК ПолучательПлатежа,
	| 	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	ПолучательПлатежа.Ссылка = &ПолучательПлатежа
	|	И БанковскиеСчета.Ссылка = &РасчетныйСчет";
	Запрос.УстановитьПараметр("ПолучательПлатежа",ПолучательПлатежа);
	Запрос.УстановитьПараметр("РасчетныйСчет",РасчетныйСчет);
	Возврат Запрос.Выполнить();
	
КонецФункции


