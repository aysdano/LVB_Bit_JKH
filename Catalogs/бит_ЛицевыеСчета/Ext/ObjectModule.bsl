// Процедура генерирует числовой идентитфикатор.
//
Процедура ЗаполнитьИД() Экспорт
	
	Если НЕ ЗначениеЗаполнено(Идентификатор) Тогда
		
		ГСЧ = Новый ГенераторСлучайныхЧисел;
		Число = ГСЧ.СлучайноеЧисло(1,999999);
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ ПЕРВЫЕ 1
		|	бит_ЛицевыеСчета.Ссылка
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Идентификатор = &Идентификатор";
		Запрос.УстановитьПараметр("Идентификатор", Число);
		
		Результат =Запрос.Выполнить().Выгрузить();
		Если Результат.Количество() > 0 Тогда
			
			ЗаполнитьИД();
			
		Иначе
			Идентификатор = Число;
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Процедура - обработчик события "ПередЗаписью" объекта справочника. 
//
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 	
	
	Наименование = бит_ОбщегоНазначения.УбитьЛишнее(Строка(Наименование));
	Организация  = Здание.Организация;
	
	Если Не ЭтоНовый() И Не ПометкаУдаления=Ссылка.ПометкаУдаления Тогда
		// В случае установки или снятия пометки удаления не производить проверку.
		Возврат;
	КонецЕсли;	
	
	// Выполним проверку заполненности обязательных реквизитов для элемента справочника.
	Если НЕ ЗначениеЗаполнено(Наименование) Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не заполнен номер ЛС!");
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	ПроверитьПравильностьВводаЛС(Наименование,Отказ);
	
	Если НЕ ЗначениеЗаполнено(УлицаЛицевогоСчета) Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не заполнена улица!");
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Здание) Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не заполнен дом!");
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Квартира) Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не заполнена квартира!");
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;    
	
	Если Не Отказ тогда
		
		ПроверитьУникальностьЛицевогоСчета(Отказ);

	КонецЕсли;
	
	ЗаполнитьИД();
	
	// БИТ_ЖКХ 13.04.2017 17:25:53 Начало правки... 
	бит_ЗакрытыйСлужебныйСервер.ПровреритьВозможностьДобавления(ЭтотОбъект.ЭтоНовый(), Отказ);
	// БИТ_ЖКХ 13.04.2017 17:25:55 Конец правки. 
	
КонецПроцедуры

