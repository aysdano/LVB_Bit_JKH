&НаСервере
Функция ПолучитьМассивДокументов()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ПериодОплат.ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", КонецДня(ПериодОплат.ДатаОкончания));
	Запрос.УстановитьПараметр("ВидОплаты", ВидОплаты);
	Запрос.УстановитьПараметр("ОрганизацияКассы", КассаККМ.Организация);
	Запрос.Текст = "ВЫБРАТЬ
	               |	ПоступлениеНаРасчетныйСчет.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
	               |ГДЕ
	               |	ПоступлениеНаРасчетныйСчет.Дата МЕЖДУ &ДатаНачала И &ДатаОкончания
	               |	И ПоступлениеНаРасчетныйСчет.Проведен
	               |	И ЕСТЬNULL(ПоступлениеНаРасчетныйСчет.ДокументОснование.бит_ДокументОснование.лб_ВидОплаты, 
				   |					ЗНАЧЕНИЕ(Справочник.лб_ВидыОплат.ПустаяСсылка)) = &ВидОплаты
	               |	И ПоступлениеНаРасчетныйСчет.НомерЧекаККМ = 0
	               |	И ПоступлениеНаРасчетныйСчет.Организация = &ОрганизацияКассы";
	
	ТЗДокументов = Запрос.Выполнить().Выгрузить();
	МассивДокументов = ТЗДокументов.ВыгрузитьКолонку("Ссылка");
	
	Возврат МассивДокументов;
	
КонецФункции

