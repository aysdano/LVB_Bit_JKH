// Процедура заменяет заголовок у надписей субконто в зависимости от типа субконто.
//
&НаСервере
Процедура УстановитьВидимостьСубконто()
	
	Для Ном = 1 по 3 Цикл
		
		Если (Ном <= Запись.СчетДохода.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетДохода)) Тогда
			Элементы["Субконто"+Ном].Заголовок = Строка(Запись.СчетДохода.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["Субконто"+Ном].Видимость        = Истина;
		Иначе
			Элементы["Субконто"+Ном].Видимость        = Ложь;
			
		КонецЕсли;
		
		Если (Ном <= Запись.СчетПениСУ.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетПениСУ)) Тогда
			Элементы["СубконтоПениСУ"+Ном].Заголовок = Строка(Запись.СчетПениСУ.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["СубконтоПениСУ"+Ном].Видимость        = Истина;
		Иначе
			Элементы["СубконтоПениСУ"+Ном].Видимость        = Ложь;
			
		КонецЕсли;
		
		Если (Ном <= Запись.СчетПениКапРемонта.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетПениКапРемонта)) Тогда
			Элементы["СубконтоПениКапРем"+Ном].Заголовок = Строка(Запись.СчетПениКапРемонта.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["СубконтоПениКапРем"+Ном].Видимость        = Истина;
		Иначе
			Элементы["СубконтоПениКапРем"+Ном].Видимость        = Ложь;
		КонецЕсли;
		
		ЕстьСубконтоКонтрагент = Запись.СчетПениУСО.ВидыСубконто.Найти(ПланыВидовХарактеристик.ВидыСубконтоХозрасчетные.Контрагенты, "ВидСубконто");
		
		Если (Ном <= Запись.СчетПениУСО.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетПениУСО)) И ЕстьСубконтоКонтрагент = Неопределено Тогда
			Элементы["СубконтоПениУСО"+Ном].Заголовок = Строка(Запись.СчетПениУСО.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["СубконтоПениУСО"+Ном].Видимость        = Истина;
		Иначе
			Элементы["СубконтоПениУСО"+Ном].Видимость        = Ложь;
			
		КонецЕсли;
		
		Если (Ном <= Запись.СчетЛьготСторП.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетЛьготСторП)) Тогда
			Элементы["СубконтоЛьготУСО"+Ном].Заголовок = Строка(Запись.СчетЛьготСторП.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["СубконтоЛьготУСО"+Ном].Видимость        = Истина;
		Иначе
			Элементы["СубконтоЛьготУСО"+Ном].Видимость        = Ложь;
			
		КонецЕсли;
		
		Если (Ном <= Запись.СчетЛьготСУ.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетЛьготСУ)) Тогда
			Элементы["СубконтоЛьготСУ"+Ном].Заголовок = Строка(Запись.СчетЛьготСУ.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["СубконтоЛьготСУ"+Ном].Видимость        = Истина;
		Иначе
			Элементы["СубконтоЛьготСУ"+Ном].Видимость        = Ложь;
			
		КонецЕсли;
		
		Если (Ном <= Запись.СчетЛьготКапРемонта.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетЛьготКапРемонта)) Тогда
			Элементы["СубконтоЛьготКапРем"+Ном].Заголовок = Строка(Запись.СчетЛьготКапРемонта.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["СубконтоЛьготКапРем"+Ном].Видимость        = Истина;
		Иначе
			Элементы["СубконтоЛьготКапРем"+Ном].Видимость        = Ложь;
		КонецЕсли;
		
		Если (Ном <= Запись.СчетНачисленийРасчетаПредельногоИндексаСобственныхУслуг.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетНачисленийРасчетаПредельногоИндексаСобственныхУслуг)) Тогда
			
			Элементы["СубконтоНачисленийРасчетаПредельногоИндексаСобственныхУслуг"+Ном].Заголовок = Строка(Запись.СчетНачисленийРасчетаПредельногоИндексаСобственныхУслуг.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["СубконтоНачисленийРасчетаПредельногоИндексаСобственныхУслуг"+Ном].Видимость        = Истина;
			
		Иначе
			
			Элементы["СубконтоНачисленийРасчетаПредельногоИндексаСобственныхУслуг"+Ном].Видимость        = Ложь;
			
		КонецЕсли;
		
		Если (Ном <= Запись.СчетНачисленийРасчетаПредельногоИндексаСоСтороннимиОрганизациями.ВидыСубконто.Количество()) и (ЗначениеЗаполнено(Запись.СчетНачисленийРасчетаПредельногоИндексаСоСтороннимиОрганизациями)) Тогда
			
			Элементы["СубконтоНачисленийРасчетаПредельногоИндексаСоСтороннимиОрганизациями"+Ном].Заголовок = Строка(Запись.СчетНачисленийРасчетаПредельногоИндексаСобственныхУслуг.ВидыСубконто[Ном-1].ВидСубконто);
			Элементы["СубконтоНачисленийРасчетаПредельногоИндексаСоСтороннимиОрганизациями"+Ном].Видимость        = Истина;
			
		Иначе
			
			Элементы["СубконтоНачисленийРасчетаПредельногоИндексаСоСтороннимиОрганизациями"+Ном].Видимость        = Ложь;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

