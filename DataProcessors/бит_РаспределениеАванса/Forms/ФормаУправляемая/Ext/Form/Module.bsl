#Область ПроцедурыОбработчикиСобытийФормы

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	ЗагрузитьНастройкиОтбораПоУмолчанию();
	
	Элементы.ВидСравненияЗдание.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ВидСравненияЗдание.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	Элементы.ВидСравненияЗдание.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	Элементы.ВидСравненияЗдание.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	Элементы.ВидСравненияУчасток.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ВидСравненияУчасток.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	Элементы.ВидСравненияУчасток.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	Элементы.ВидСравненияУчасток.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	Элементы.ВидСравненияРайон.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ВидСравненияРайон.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	Элементы.ВидСравненияРайон.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	Элементы.ВидСравненияРайон.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	Элементы.ВидСравненияУлица.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ВидСравненияУлица.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	Элементы.ВидСравненияУлица.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	Элементы.ВидСравненияУлица.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	ВидСравненияРайон   = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияУчасток = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияЗдание  = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияУлица   = ВидСравненияКомпоновкиДанных.Равно;
	
	Объект.Организация = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ОбработкаОбъект = ДанныеФормыВЗначение(Объект,Тип("ОбработкаОбъект.бит_ЗакрытиеМесяцаЖКХ"));	
		
		бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ОбработкаОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
		
		Объект.Организация = ОбработкаОбъект.Организация;
		
	КонецЕсли;
	
	Объект.ДатаЗакрытия = КонецМесяца(бит_ОбщегоНазначения.ПолучитьРабочуюДату());
	
	ОбновитьПараметрыЖКХ();
	
	Объект.ПереоформитьПроживающих        = Истина;
	Объект.ВыполнитьНачисления            = Истина;
	Объект.ВводПоказанийПодкрутки         = Истина;
	Объект.ВыполнитьНачисленияПоНормам    = Истина;
	Объект.ВыполнитьНачисленияПоСчетчикам = Истина;
	Объект.ВыполнитьНачисленияПоЛьготам   = Истина;
	Объект.ВыполнитьОбщедомовыеНачисления = Истина;
	Объект.ВыполнитьРаспределениеАванса	  = Истина;
	
	// Установить видимость реквизитов и заголовков колонок.
	ПредставлениеПериодаРегистрации = Формат(ТекущаяДата(), "ДФ='ММММ гггг'");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ ЗначениеЗаполнено(СтрокаКонецПериода) Тогда
		СтрокаКонецПериода = бит_РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(Объект.ДатаЗакрытия);
	КонецЕсли;
	
	УправлениеЭлементамиФормы();
	
	Элементы.ДатаЗакрытия.Видимость = Ложь;
	
	Элементы.ДатаКонцаПериода.Видимость = Ложь;
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура СформироватьАвансы(Команда)
	
	Форма = ПолучитьФорму("Обработка.бит_ЗакрытиеМесяцаЖКХ.Форма.ФормаРаботыСДокументами",,ЭтаФорма, ЭтаФорма);
	
	Если Форма.Открыта() Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перед закрытием месяца закройте ""Форму работы с документами""!");
		
		Возврат;
		
	КонецЕсли; 

	бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Выполняется распределенние авансов.");
	
	ЗакрытьМесяцНаСервере();

	бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Распределение авансов выполнено.");
	
КонецПроцедуры

&НаКлиенте
Процедура ФормаРаботыСдокументами(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация" , Объект.Организация);
	ПараметрыФормы.Вставить("ДатаЗакрытия", Объект.ДатаЗакрытия);
	
	Форма = ПолучитьФорму("Обработка.бит_ЗакрытиеМесяцаЖКХ.Форма.ФормаРаботыСДокументами", ПараметрыФормы, ЭтаФорма, ЭтаФорма);
	
	Если Форма.Открыта() Тогда
		Форма.Активизировать();
	Иначе
		Форма.Открыть();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура УвеличитьПериод(Команда)
	
	Объект.ДатаЗакрытия = КонецМесяца(Объект.ДатаЗакрытия)+1;
	ПриИзмененииПериода();
	
КонецПроцедуры

&НаКлиенте
Процедура УменьшитьПериод(Команда)
	
	Объект.ДатаЗакрытия = НачалоМесяца(Объект.ДатаЗакрытия-1);
	
	ПриИзмененииПериода();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ЗданиеПриИзменении(Элемент)
	
	ПоместитьЗначениеВОтборКомпановщика(Здание, 3);
	
КонецПроцедуры

&НаКлиенте
Процедура УчастокПриИзменении(Элемент)
	
	ПоместитьЗначениеВОтборКомпановщика(Участок, 1);
	
КонецПроцедуры

&НаКлиенте
Процедура РайонПриИзменении(Элемент)
	
	ПоместитьЗначениеВОтборКомпановщика(Район, 0);
	
КонецПроцедуры

&НаКлиенте
Процедура УлицаПриИзменении(Элемент)
	
	ПоместитьЗначениеВОтборКомпановщика(Улица, 2);
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборРайонПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	КомпоновщикНастроек.Настройки.Отбор.Элементы[0].Использование  = ИспользоватьОтборРайон;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборУчастокПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	КомпоновщикНастроек.Настройки.Отбор.Элементы[1].Использование  = ИспользоватьОтборУчасток;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборЗданиеПриИзменении(Элемент)
	
	УправлениеЭлементамиФормы();
	КомпоновщикНастроек.Настройки.Отбор.Элементы[3].Использование  = ИспользоватьОтборЗдание;
	
КонецПроцедуры

&НаКлиенте
Процедура ИспользоватьОтборУлицаПриИзменении(Элемент)
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[2].Использование  = ИспользоватьОтборУлица;
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗданиеНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Отбор = Новый Структура;
	
	Если ИспользоватьОтборРайон И ЗначениеЗаполнено(Район) Тогда
		Отбор.Вставить("Район", Район);
	КонецЕсли;
	
	Если ИспользоватьОтборУчасток И ЗначениеЗаполнено(Участок) Тогда
		Отбор.Вставить("Участок", Участок);
	КонецЕсли;
	
	Если ИспользоватьОтборУлица И ЗначениеЗаполнено(Улица) Тогда
		Отбор.Вставить("Улица", Улица);
	КонецЕсли;
	
	МножественныйВыбор = (ВидСравненияЗдание = ВидСравненияКомпоновкиДанных.ВСписке ИЛИ ВидСравненияЗдание = ВидСравненияКомпоновкиДанных.НеВСписке);
	
	ОткрытьФорму("Справочник.бит_СписокЗданий.Форма.ФормаВыбораУправляемая",Новый Структура("Отбор, МножественныйВыбор", Отбор, МножественныйВыбор),Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура ЗданиеОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ТипЗнч(ВыбранноеЗначение) = Тип("Массив") Тогда
		
		Список = Новый СписокЗначений;
		Список.ЗагрузитьЗначения(ВыбранноеЗначение);
		
		ВыбранноеЗначение = Список;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСравненияЗданиеПриИзменении(Элемент)
	
	Если ВидСравненияЗдание = Неопределено Тогда
		
		ВидСравненияЗдание = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если (ВидСравненияЗдание = ВидСравненияКомпоновкиДанных.Равно ИЛИ ВидСравненияЗдание = ВидСравненияКомпоновкиДанных.НеРавно)
		И ТипЗнч(Здание) = Тип("СписокЗначений") Тогда
		
		Здание = Неопределено;
		ПоместитьЗначениеВОтборКомпановщика(Здание, 3);
		
	КонецЕсли; 
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[3].ВидСравнения   = ВидСравненияЗдание;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСравненияРайонПриИзменении(Элемент)
	
	Если ВидСравненияРайон = Неопределено Тогда
		
		ВидСравненияРайон = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если (ВидСравненияРайон = ВидСравненияКомпоновкиДанных.Равно ИЛИ ВидСравненияРайон = ВидСравненияКомпоновкиДанных.НеРавно)
		И ТипЗнч(Район) = Тип("СписокЗначений") Тогда
		
		Район = Неопределено;
		ПоместитьЗначениеВОтборКомпановщика(Район, 0);
		
	КонецЕсли; 
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[0].ВидСравнения   = ВидСравненияРайон;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСравненияУчастокПриИзменении(Элемент)
	
	Если ВидСравненияУчасток = Неопределено Тогда
		
		ВидСравненияУчасток = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если (ВидСравненияУчасток = ВидСравненияКомпоновкиДанных.Равно ИЛИ ВидСравненияУчасток = ВидСравненияКомпоновкиДанных.НеРавно)
		И ТипЗнч(Участок) = Тип("СписокЗначений") Тогда
		
		Участок = Неопределено;
		ПоместитьЗначениеВОтборКомпановщика(Участок, 1);
		
	КонецЕсли;
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[1].ВидСравнения   = ВидСравненияУчасток;
	
КонецПроцедуры

&НаКлиенте
Процедура ВидСравненияУлицаПриИзменении(Элемент)
	
	Если ВидСравненияУлица = Неопределено Тогда
		
		ВидСравненияУлица = ВидСравненияКомпоновкиДанных.Равно;
		
	КонецЕсли;
	
	Если (ВидСравненияУлица = ВидСравненияКомпоновкиДанных.Равно ИЛИ ВидСравненияУлица = ВидСравненияКомпоновкиДанных.НеРавно)
		И ТипЗнч(Улица) = Тип("СписокЗначений") Тогда
		
		Улица = Неопределено;
		ПоместитьЗначениеВОтборКомпановщика(Улица, 2);
		
	КонецЕсли;
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[2].ВидСравнения   = ВидСравненияУлица;
	
КонецПроцедуры

&НаКлиенте
Процедура РайонНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МножественныйВыбор = (ВидСравненияРайон = ВидСравненияКомпоновкиДанных.ВСписке ИЛИ ВидСравненияРайон = ВидСравненияКомпоновкиДанных.НеВСписке);
	
	ОткрытьФорму("Справочник.бит_АдминистративныеОкруга.Форма.ФормаВыбораУправляемая",Новый Структура("МножественныйВыбор", МножественныйВыбор),Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УчастокНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МножественныйВыбор = (ВидСравненияУчасток = ВидСравненияКомпоновкиДанных.ВСписке ИЛИ ВидСравненияУчасток = ВидСравненияКомпоновкиДанных.НеВСписке);
	
	ОткрытьФорму("Справочник.бит_ТехническиеУчастки.Форма.ФормаВыбораУправляемая",Новый Структура("МножественныйВыбор", МножественныйВыбор),Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура УлицаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	МножественныйВыбор = (ВидСравненияУлица = ВидСравненияКомпоновкиДанных.ВСписке ИЛИ ВидСравненияУлица = ВидСравненияКомпоновкиДанных.НеВСписке);
	
	ОткрытьФорму("Справочник.бит_СписокУлиц.Форма.ФормаВыбораУправляемая",Новый Структура("МножественныйВыбор", МножественныйВыбор),Элемент);
	
