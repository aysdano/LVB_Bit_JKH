//			    строкаНачислений.КоличествоЕдиницПоСчетчику = ПолучитьКоличествоЕдиницПоСчетчику(строкаСчетчика.Счетчик);
			    строкаНачислений.ЛицевойСчет = строкаСчетчика.ЛицевойСчет; 
			    строкаНачислений.Многотарифный = ложь;
			    строкаНачислений.ПредыдущиеПоказания = ПолучитьПредыдущиеПоказанияСчетчика(строкаСчетчика.ДатаОплаты, строкаСчетчика.Счетчик, строкаУслуги.Услуга);
			    строкаНачислений.Разрядность = 9999;
			    строкаНачислений.Счетчик = строкаСчетчика.Счетчик; 
			    строкаНачислений.ТекущиеПоказания = строкаСчетчика.ЗначениеСчетчика; 
			    строкаНачислений.Улица = строкаСчетчика.ЛицевойСчет.УлицаЛицевогоСчета;
			    строкаНачислений.Услуга = строкаУслуги.Услуга; 
				строкаНачислений.КоличествоЕдиницПоСчетчику = строкаНачислений.ТекущиеПоказания - строкаНачислений.ПредыдущиеПоказания;
					  
		      конеццикла;
		  
			конеццикла;	
			
			// Удаление счетчиков без показаний жильцов.
			ОтборБезПоказаний	= Новый Структура("ТекущиеПоказания",0);
			СтрокиБезПоказаний	= ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(ОтборБезПоказаний);

			Если СтрокиБезПоказаний.Количество() > 0 Тогда
