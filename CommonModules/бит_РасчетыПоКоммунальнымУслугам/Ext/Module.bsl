							КоличествоПроживающих = ?(КоличествоПроживающих = 0,1,КоличествоПроживающих); // БИТ_ЖКХ 15.12.2016 16:42:55 
							Начислено     = Выборка.Начислено/КоличествоПроживающих;
							НормаСемейная = Норма;
							
						ИначеЕсли Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет Тогда
							
							Норма = Факт;
							
