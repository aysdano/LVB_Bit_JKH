	  таблицаДПД = СоответствиеДанныхМакета.Получить(спр);
	  если таблицаДПД <> неопределено тогда
		  копияТаблицыДПД = таблицаДПД.Скопировать();
		  копияТаблицыДПД.Свернуть("ЛицевойСчет");
		  МассивЛицевыхСчетов = копияТаблицыДПД.ВыгрузитьКолонку("ЛицевойСчет");	 	  
		    
		  спр = Справочники.бит_ТаблицыШаблоновГИСЖКХ.НайтиПоНаименованию("Таблица платежных документов 1-2");
		  таблица12 = СоответствиеДанныхМакета.Получить(спр);  		
		  если таблица12 <> неопределено тогда

			  если МассивЛицевыхСчетов.Количество() > 0 и таблицаДПД.Количество() > 0 тогда
		
				Индекс = таблица12.Количество() - 1; 
				Пока Индекс >= 0 Цикл 
					
					если МассивЛицевыхСчетов.Найти (таблица12[Индекс].ЛицевойСчет) = неопределено тогда 
						таблица12.Удалить(Индекс); 					 
					КонецЕсли; 
					 
					Индекс = Индекс - 1; 
				КонецЦикла;		
						  
			  конецесли;
			  
			  для каждого стр из таблица12 цикл
				  
				 стр.Льготы = ""; 
