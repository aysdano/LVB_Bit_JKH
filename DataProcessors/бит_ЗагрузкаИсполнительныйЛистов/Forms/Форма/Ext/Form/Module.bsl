#Область Общее

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбораФайла.Заголовок     = "Выберите файл для загрузки данных";
	ДиалогВыбораФайла.Фильтр        = "Документ Microsoft Excel (*.xls)|*.xls;*.xlsx;*.xlsm";
	
	Если ЗначениеЗаполнено(ПутьКФайлу) Тогда
		Путь = ПутьКФайлу;
		Пока СтрДлина(Путь) > 0 И Прав(Путь, 1) <> "\" Цикл
			Путь = Лев(Путь, СтрДлина(Путь) - 1);
		КонецЦикла;
		ДиалогВыбораФайла.Каталог = Путь;
	КонецЕсли;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		ПутьКФайлу = ДиалогВыбораФайла.ПолноеИмяФайла;	
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ЧтениеФайла

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	
	Если НЕ ЗначениеЗаполнено(ПутьКФайлу) Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Не указан путь к файлу", , "ПутьКФайлу");
		Возврат;
	КонецЕсли;
	
	Файл = Новый Файл(ПутьКФайлу);
	Если НЕ Файл.Существует() Тогда
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Указанный файл не существует", , "ПутьКФайлу");
		Возврат;
	КонецЕсли;
	
	Режим = РежимДиалогаВопрос.ДаНет;
	
	// MS EXCEL
	Оповещение = Новый ОписаниеОповещения("НачатьВыполнениеЗагрузки", ЭтаФорма);
	ПоказатьВопрос(Оповещение, "Загрузить данные из файла?", Режим);
	
КонецПроцедуры

// MS EXCEL
&НаКлиенте
Процедура НачатьВыполнениеЗагрузки(Результат, Параметры) Экспорт
	
	Если НЕ Результат = КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ПерваяСтрокаФайла = 6;
	
	Состояние("Чтение файла...");
	РезультатЗагрузки = ВыполнитьЗагрузкуНаКлиенте(ПутьКФайлу, ПерваяСтрокаФайла);
	
	//Вычисление ФИО по ЛС
	//ПолучитьФИОпоЛС();
	
	Если ЕстьПустыеСтроки И НЕ ПроверкаДокумента Тогда
	//Если ЕстьПустыеСтроки Тогда
		Оповещение = Новый ОписаниеОповещения("ОбработкаОповещенияПустыеСтроки", ЭтаФорма);
		ПоказатьВопрос(Оповещение, "В файле обнаружены пустые строки. Все равно загрузить данные?", РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗагрузитьДанныеВДокумент();
	КонецЕсли;
	
КонецПроцедуры

// MS EXCEL
&НаКлиенте
Функция ВыполнитьЗагрузкуНаКлиенте(ПутьКФайлу, ПерваяСтрокаФайла)
	
	//Подключаемся к Эксель
	Попытка
		ОбъектExcel = Новый COMОбъект("Excel.Application");
	Исключение
		Возврат "Ошибка открытия MS Excel";	
	КонецПопытки;
	
	Попытка
		ОбъектExcel.WorkBooks.Open(ПутьКФайлу);
	Исключение
		ОбъектExcel.DisplayAlerts = 0; 
		ОбъектExcel.Quit();
		ОбъектExcel.DisplayAlerts = 1;
		
		Возврат "Ошибка открытия файла для чтения: " + ПутьКФайлу + " " + ОписаниеОшибки();	
	КонецПопытки;
	
	Попытка
		ОбъектExcel.Sheets(1).Select();
	Исключение
		ОбъектExcel.ActiveWorkbook.Close();
		ОбъектExcel = 0;
		
		Возврат "Ошибка при чтении файла: " + ПутьКФайлу;
	КонецПопытки;
	
	Version	= ОбъектExcel.Version;
	
	Версия = Лев(Version, Найти(Version,".") - 1 );
	
	Если Версия = "8" тогда
		ФайлСтрок	= ОбъектExcel.Cells.CurrentRegion.Rows.Count;
		ФайлКолонок = Макс(ОбъектExcel.Cells.CurrentRegion.Columns.Count, 13);
	Иначе
		ФайлСтрок	= ОбъектExcel.Cells(1,1).SpecialCells(11).Row;
		ФайлКолонок = ОбъектExcel.Cells(1,1).SpecialCells(11).Column;
	Конецесли;
	
	// Выделяем область на листе Эксель.
	Область = ОбъектExcel.Range(ОбъектExcel.Cells(ПерваяСтрокаФайла,1), ОбъектExcel.Cells(ФайлСтрок,ФайлКолонок));
	
	// Выгружаем область Эксель в двумерный массив.
	Данные = Область.Value.Выгрузить();
	
	Попытка
		ОбъектExcel.DisplayAlerts = 0; 
		ОбъектExcel.Quit();
		ОбъектExcel.DisplayAlerts = 1;
	Исключение
		Сообщить("Не удалось отключиться от Excel - " + ОписаниеОшибки());
	КонецПопытки;
	
	ОбработатьДанныеНаСервере(Данные);
	
КонецФункции

// MS EXCEL
&НаСервере
Процедура ОбработатьДанныеНаСервере(Данные)
	
	ТаблицаЗагрузки.Очистить();
	
	НомерСтроки = 0;
	
	ПерваяСтрока = Истина;
	
	Для Индекс = 1 По Данные[0].Количество() Цикл
		
		ЧетнаяСтрока = ?(НомерСтроки%2=0, Истина, Ложь);
		ПустаяСтрока = Ложь;
		
		Если НЕ Данные[0][НомерСтроки] = Неопределено
				И НЕ Данные[3][НомерСтроки] = Неопределено 
				И НЕ Данные[4][НомерСтроки] = Неопределено Тогда
			ПерваяСтрока = Истина;
		ИначеЕсли НЕ Данные[21][НомерСтроки] = Неопределено Тогда
			ПерваяСтрока = Ложь;
		Иначе
			ПустаяСтрока = Истина;
		КонецЕсли;
		
		// Проверка на пустую строку
		//Если ЧетнаяСтрока Тогда
		//Если ПерваяСтрока Тогда
		//	
		//	Если Данные[0][НомерСтроки] = Неопределено 
		//		И Данные[3][НомерСтроки] = Неопределено
		//		И НЕ СокрЛП(Данные[2][НомерСтроки]) = "ИТОГО:" Тогда
		//		
		//		НомерПустойСтроки = НомерСтроки + ПерваяСтрокаФайла;
		//		
		//		Сообщение = Новый СообщениеПользователю;
		//		Сообщение.Текст = "Пустая строка! Строка №: " + НомерПустойСтроки;
		//		Сообщение.Сообщить();
		//		
		//		НомерСтроки = НомерСтроки + 1;
		//		ПустаяСтрока = Истина;
		//		
		//		Если НЕ СокрЛП(Данные[2][НомерСтроки]) = "ИТОГО:" Тогда
		//			ЕстьПустыеСтроки = Истина;
		//		КонецЕсли;
		//		
		//		Продолжить;
		//	Иначе 
		//		ПустаяСтрока = Ложь;  
		//	КонецЕсли;
		//	
		//	//Подвал
		//	Если СокрЛП(Данные[2][НомерСтроки]) = "ИТОГО:" Тогда
		//		Прервать;
		//	КонецЕсли;

		//КонецЕсли;
		
		Если ПустаяСтрока Тогда
			Если СтрНайти(СокрЛП(Данные[2][НомерСтроки]),"ИТОГО:") = 0 Тогда
				
				НомерПустойСтроки = НомерСтроки + ПерваяСтрокаФайла;
				
				//Сообщение = Новый СообщениеПользователю;
				//Сообщение.Текст = "Пустая строка! Строка №: " + НомерПустойСтроки;
				//Сообщение.Сообщить();
				//
				//ЕстьПустыеСтроки = Истина;
				НомерСтроки = НомерСтроки + 1;
				Продолжить;
			Иначе
				//Подвал
				Прервать;
			КонецЕсли;
		КонецЕсли;
		
		//Если ЧетнаяСтрока Тогда
		Если ПерваяСтрока Тогда
			
			СтрокаТаб = ТаблицаЗагрузки.Добавить();
			
			СтрокаТаб.ТабНомер = СтроковыеФункцииКлиентСервер.СтрокаВЧисло(Данные[0][НомерСтроки]);
			
			//ЛС
			СтрокаТаб.НомерЛС = СтрЗаменить(СокрЛП(Данные[3][НомерСтроки]),Символы.НПП,"");
			Если СтрокаТаб.НомерЛС = "" Тогда
				Сообщение = Новый СообщениеПользователю;
				Сообщение.Текст = "Не заполнен номер лицевого счета! Таб.Номер: " + Данные[0];
				Сообщение.Сообщить();
			КонецЕсли;
			
			//ФИО
			СтрокаТаб.Ответчики = СокрЛП(Данные[2][НомерСтроки]);
			Если СтрНайти(Данные[2][НомерСтроки], Символы.ПС) = 0  Тогда
				ФИОэксель = СокрЛП(Данные[2][НомерСтроки]);
			Иначе
			    ФИОэксель = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Данные[2][НомерСтроки], Символы.ПС ,Ложь, Истина)[0];
			КонецЕсли;
			
			//НачалоПериода
			Если НЕ Данные[6][НомерСтроки] = Неопределено Тогда
				СтрокаТаб.НачалоПериода = ВычислитьДату(Данные[6][НомерСтроки], СтрокаТаб.ТабНомер, "Начало периода")
			КонецЕсли;
			
			Если НЕ Данные[9][НомерСтроки] = Неопределено Тогда
				СтрокаТаб.ДатаРешенияСуда = ВычислитьДату(Данные[9][НомерСтроки], СтрокаТаб.ТабНомер, "Дата решения суда")
			КонецЕсли;
			
			СтрокаТаб.СуммаЗадолженности =  СокрЛП(Данные[11][НомерСтроки]);
			СтрокаТаб.СуммаПР = СокрЛП(Данные[15][НомерСтроки]);
			СтрокаТаб.СуммаГП = СокрЛП(Данные[16][НомерСтроки]);
			
			// Номер ИЛ и Дата ИЛ
			Если НЕ Данные[19][НомерСтроки] = Неопределено И СтрНайти(Данные[19][НомерСтроки], "от") <> 0 Тогда
				мЯчейкаИЛ  = Новый Массив;
				мЯчейкаИЛ = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Данные[19][НомерСтроки], "от" ,Ложь, Истина);
				
				стрДатаИЛ = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(мЯчейкаИЛ[1], "г" ,Ложь, Истина);
				
				// Проверка строки
				//Если формат "№ИЛ от Дата" или "от Дата" или "№ИЛ от"
				Если мЯчейкаИЛ.Количество() = 2 Тогда
					
					СтрокаТаб.ИЛ = СокрЛП(мЯчейкаИЛ[0]);
					СтрокаТаб.ДатаИЛ = ВычислитьДату(стрДатаИЛ[0], СтрокаТаб.ТабНомер, "Дата ИЛ");
					
				//Если формат "№ИЛ от Дата + ... + от Дата"
				ИначеЕсли мЯчейкаИЛ.Количество() > 2  Тогда
					
					СтрокаТаб.ИЛ = СокрЛП(мЯчейкаИЛ[0]);
					СтрокаТаб.ДатаИЛ = ВычислитьДату(Лев(стрДатаИЛ[0], 10),СтрокаТаб.ТабНомер, "Дата ИЛ");
					
				КонецЕсли;
				
				Если НЕ ЗначениеЗаполнено(СтрокаТаб.ИЛ) Тогда
					Сообщение = Новый СообщениеПользователю;
					Сообщение.Текст = "Не удалось записать Номер ИЛ по Таб.Номеру: " + СтрокаТаб.ТабНомер + "!";
					Сообщение.Сообщить();
				КонецЕсли;
				
			Иначе
				СтрокаТаб.ИЛ = СокрЛП(Данные[19][НомерСтроки]);
			КонецЕсли; 
		
			Если НЕ Данные[20][НомерСтроки] = Неопределено Тогда
				
				СтрокаТаб.ДатаСПП = Данные[20][НомерСтроки];
				
			КонецЕсли; 
			
			Если НЕ Данные[21][НомерСтроки] = Неопределено Тогда
				СтрокаТаб.ДатаБанк = ВычислитьДату(Данные[21][НомерСтроки], СтрокаТаб.ТабНомер, "Дата банк")
			КонецЕсли; 
			
		//ИначеЕсли НЕ ЧетнаяСтрока И НЕ ПустаяСтрока Тогда
		ИначеЕсли НЕ ПерваяСтрока Тогда
			
			//КонецПериода
			Если НЕ Данные[6][НомерСтроки] = Неопределено Тогда
				СтрокаТаб.КонецПериода = ВычислитьДату(Данные[6][НомерСтроки], СтрокаТаб.ТабНомер, "Конец периода")
			КонецЕсли;
			
			Если НЕ Данные[9][НомерСтроки] = Неопределено Тогда
				СтрокаТаб.ДатаВступленияВСилу = ВычислитьДату(Данные[9][НомерСтроки], СтрокаТаб.ТабНомер, "Дата вступления в силу")
			КонецЕсли; 
			
			Если НЕ Данные[16][НомерСтроки] = Неопределено Тогда
				СтрокаТаб.ДатаСнятияСУчета = ВычислитьДату(Данные[16][НомерСтроки], СтрокаТаб.ТабНомер, "Дата снятия с учета")
			КонецЕсли; 
			
			Если НЕ Данные[19][НомерСтроки] = Неопределено Тогда
				СтрокаТаб.ДатаРейда =  ВычислитьДату(Данные[19][НомерСтроки], СтрокаТаб.ТабНомер, "Дата рейда")
			КонецЕсли; 
			
			СтрокаТаб.РезультатРейда =  СокрЛП(Данные[20][НомерСтроки]);
			
			// тип документа
			Если СтрНайти(Данные[21][НомерСтроки], "Суд") <> 0 Тогда
				СтрокаТаб.ТипДокумента = "СудебныйПриказ";
			ИначеЕсли СтрНайти(Данные[21][НомерСтроки], "Иск") <> 0  Тогда
				СтрокаТаб.ТипДокумента = "ИсковоеЗаявление";
			КонецЕсли;
			
			// услуга
			Если СтрНайти(Данные[21][НомерСтроки], "капитальный ремонт") <> 0 Тогда
				СтрокаТаб.Услуга = "КапРемонт";
			Иначе 				
				СтрокаТаб.Услуга = "СодержаниеЖилья";
			КонецЕсли;
			
			//берем ФИО из файла загрузки если услуга капремонт
			Если СтрокаТаб.Услуга = "КапРемонт" Тогда
				СтрокаТаб.ФИО = ФИОэксель;
			КонецЕсли;
			
		КонецЕсли;
		
		НомерСтроки = НомерСтроки + 1;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция ВычислитьДату(ДатаExcel, ТабНомер, ИмяДата)
	
	Если ТипЗнч(ДатаExcel) = Тип("Дата") Тогда
		Дата1С = ДатаExcel 	
		
	ИначеЕсли ТипЗнч(ДатаExcel) = Тип("Число") Тогда
		Дата1С = '190001010000'+(ДатаExcel*86400)- 2*86400;
		
	ИначеЕсли ТипЗнч(ДатаExcel) = Тип("Строка") Тогда
		
		Если Найти(ДатаExcel, ".") > 0 Тогда
			Дата1С = СтроковыеФункцииКлиентСервер.СтрокаВДату(Лев(ДатаExcel,10));
		ИначеЕсли Найти(ДатаExcel, ".") = 0 Тогда
			ТипЧисло  = Новый ОписаниеТипов("Число");
			Дата1С = '190001010000' + ТипЧисло.ПривестиЗначение(ДатаExcel)*86400 - 2*86400;
		КонецЕсли;
		
	КонецЕсли;
	
	Если Дата1С < Дата(3000,1,1) И ЗначениеЗаполнено(Дата1С) Тогда
		Возврат Дата1С
	Иначе
			
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Некорректная дата по Таб.Номеру: " + ТабНомер + " загрузочного файла! " + ИмяДата;
		Сообщение.Сообщить();
		
		Возврат Дата(1,1,1)
		
	КонецЕсли;
	
КонецФункции 

&НаКлиенте
Процедура ОбработкаОповещенияПустыеСтроки(Результат, ДополнительныеПараметры) Экспорт

	Если Результат = КодВозвратаДиалога.Да Тогда
		ЗагрузитьДанныеВДокумент();
	Иначе
		Возврат;
	КонецЕсли;

КонецПроцедуры 

//Не используется. Потом убрать
&НаСервере
Процедура ПолучитьФИОпоЛС()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаЗагрузки.ФИО КАК ФИО,
	|	ТаблицаЗагрузки.ТабНомер КАК ТабНомер,
	|	ВЫРАЗИТЬ(ТаблицаЗагрузки.НомерЛС КАК СТРОКА(15)) КАК НомерЛС,
	|	ТаблицаЗагрузки.СуммаЗадолженности КАК СуммаЗадолженности,
	|	ТаблицаЗагрузки.СуммаПР КАК СуммаПР,
	|	ТаблицаЗагрузки.СуммаГП КАК СуммаГП,
	|	ТаблицаЗагрузки.ИЛ КАК ИЛ,
	|	ТаблицаЗагрузки.ДатаСнятияСУчета КАК ДатаСнятияСУчета,
	|	ТаблицаЗагрузки.ДатаРейда КАК ДатаРейда,
	|	ТаблицаЗагрузки.ДатаСПП КАК ДатаСПП,
	|	ТаблицаЗагрузки.ДатаБанк КАК ДатаБанк,
	|	ТаблицаЗагрузки.РезультатРейда КАК РезультатРейда,
	|	ТаблицаЗагрузки.ТипДокумента КАК ТипДокумента,
	|	ТаблицаЗагрузки.Услуга КАК Услуга,
	|	ТаблицаЗагрузки.ДатаРешенияСуда КАК ДатаРешенияСуда,
	|	ТаблицаЗагрузки.ДатаВступленияВСилу КАК ДатаВступленияВСилу,
	|	ТаблицаЗагрузки.ДатаИЛ КАК ДатаИЛ
	|ПОМЕСТИТЬ ТаблицаЗагрузки
	|ИЗ
	|	&ТаблицаЗагрузки КАК ТаблицаЗагрузки
	|ГДЕ
	|	ТаблицаЗагрузки.ДатаСнятияСУчета = ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	|	И НЕ ТаблицаЗагрузки.НомерЛС ЕСТЬ NULL
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	НомерЛС
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаЗагрузки.ТабНомер КАК ТабНомер,
	|	ТаблицаЗагрузки.НомерЛС КАК НомерЛС,
	|	ВЫБОР
	|		КОГДА ТаблицаЗагрузки.ФИО ЕСТЬ NULL
	|			ТОГДА бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|		ИНАЧЕ ВЫРАЗИТЬ(ТаблицаЗагрузки.ФИО КАК СТРОКА(50))
	|	КОНЕЦ КАК ФИО,
	|	ТаблицаЗагрузки.СуммаЗадолженности КАК СуммаЗадолженности,
	|	ТаблицаЗагрузки.СуммаПР КАК СуммаПР,
	|	ТаблицаЗагрузки.СуммаГП КАК СуммаГП,
	|	ТаблицаЗагрузки.ИЛ КАК ИЛ,
	|	ТаблицаЗагрузки.ДатаСнятияСУчета КАК ДатаСнятияСУчета,
	|	ТаблицаЗагрузки.ДатаРейда КАК ДатаРейда,
	|	ТаблицаЗагрузки.ДатаСПП КАК ДатаСПП,
	|	ТаблицаЗагрузки.ДатаБанк КАК ДатаБанк,
	|	ТаблицаЗагрузки.РезультатРейда КАК РезультатРейда,
	|	ТаблицаЗагрузки.ТипДокумента КАК ТипДокумента,
	|	ТаблицаЗагрузки.Услуга КАК Услуга,
	|	ТаблицаЗагрузки.ДатаРешенияСуда КАК ДатаРешенияСуда,
	|	ТаблицаЗагрузки.ДатаВступленияВСилу КАК ДатаВступленияВСилу,
	|	ТаблицаЗагрузки.ДатаИЛ КАК ДатаИЛ
	|ИЗ
	|	ТаблицаЗагрузки КАК ТаблицаЗагрузки
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(, СтепеньРодства = &Ответственный) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО ТаблицаЗагрузки.НомерЛС = бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Наименование
	|
	|УПОРЯДОЧИТЬ ПО
	|	ТабНомер"; 
	
	ТЗ = ТаблицаЗагрузки.Выгрузить();
	Запрос.УстановитьПараметр("ТаблицаЗагрузки", ТЗ);     
	Запрос.УстановитьПараметр("Ответственный", Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо);
	перем_ТаблицаЗагрузки = Запрос.Выполнить().Выгрузить();
	ЗначениеВДанныеФормы(перем_ТаблицаЗагрузки,ТаблицаЗагрузки);
	
КонецПроцедуры 
#КонецОбласти


#Область ЗаполнениеДокумента

&НаКлиенте
Процедура ЗагрузитьДанныеВДокумент()
	
	Если ПроверкаДокумента Тогда
		ПоказатьПредупреждение(, "Проверка файла завершена");
	Иначе
		Состояние("Создание документов...");
		ЗагрузитьДанныеВДокументНаСервере();
		
		ПоказатьПредупреждение(, "Загрузка данных завершена");
	КонецЕсли;

КонецПроцедуры 

&НаСервере
Процедура ЗагрузитьДанныеВДокументНаСервере()
	
	//Счетчик для записей движений
	СчетчикСекунда = 1;
	
	Для каждого Строка Из ТаблицаЗагрузки Цикл
		
		//Проверка на снятие с учета
		//Загружаем только закрытые
		Если ЗагрузитьЗакрытыеИЛ Тогда
			Если Строка.ДатаСнятияСУчета = Дата(1,1,1) Тогда
				Продолжить;
			КонецЕсли;
		//НЕ Загружаем закрытые
		Иначе
			Если НЕ Строка.ДатаСнятияСУчета = Дата(1,1,1) Тогда
				Продолжить;
			КонецЕсли;
		КонецЕсли;
		
		НомерЛС = Строка.НомерЛС;
		НомерИЛ = Строка.ИЛ;
		
		Если ЗамещатьЗагруженныеИЛ Тогда  
			
			ДокументСсылка = НайтиИЛ(НомерЛС, НомерИЛ);
			
			Если ЗначениеЗаполнено(ДокументСсылка) Тогда   
				Документ = ДокументСсылка.ПолучитьОбъект();
			Иначе
				Документ = Документы.бит_ИсполнительныйЛист.СоздатьДокумент();
				Документ.Дата = ТекущаяДата();
			КонецЕсли;
		Иначе
			Документ = Документы.бит_ИсполнительныйЛист.СоздатьДокумент();
			Документ.Дата = ТекущаяДата();
		КонецЕсли;
		
		Документ.ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(НомерЛС);
		Документ.НомерИсполнительногоЛиста = НомерИЛ;
		Документ.СуммаДолгаПоУслугеПоРешениюСуда = Строка.СуммаЗадолженности;
		Документ.СуммаПредставительскихРасходовПоРешениюСуда = Строка.СуммаПР;
		Документ.СуммаГоспошлиныПоРешениюСуда = Строка.СуммаГП;
		
		Документ.ДатаИсполнительногоЛиста = Строка.ДатаИЛ;
		Документ.ДатаВынесенияРешенияСуда = Строка.ДатаРешенияСуда;
		Документ.ДатаВступленияВЗаконнуюСилу = Строка.ДатаВступленияВСилу;
		Документ.ПериодОбразованияЗадолженностиОт = Строка.НачалоПериода;
		Документ.ПериодОбразованияЗадолженностиПо = Строка.КонецПериода;
		
		Если Строка.ТипДокумента = "СудебныйПриказ" Тогда
			Документ.ВидДокумента = Перечисления.ТипыЮридическихДокументов.СудебныйПриказ;
		ИначеЕсли  Строка.ТипДокумента = "ИсковоеЗаявление" Тогда
			Документ.ВидДокумента = Перечисления.ТипыЮридическихДокументов.ИсковоеЗаявление
		КонецЕсли; 
		
		Если Строка.Услуга = "КапРемонт" Тогда
			Документ.Услуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");
			ЭтоКапРемонт = Истина;
		ИначеЕсли  Строка.Услуга = "СодержаниеЖилья" Тогда
			Документ.Услуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001");
			ЭтоКапРемонт = Ложь;
		КонецЕсли;
		
		//ФИО
		Документ.ФИОДолжника = ВычислитьПроживающиего(Строка.ФИО, Строка.НомерЛС, ЭтоКапРемонт, Строка.ТабНомер);
		мОтветчики = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка.Ответчики, Символы.ПС ,Ложь, Истина);
		
		Документ.Ответчики.Очистить();
		
		Для каждого стрМ Из мОтветчики Цикл
			НоваяСтрока = Документ.Ответчики.Добавить();
		    НоваяСтрока.ФизЛицо = ВычислитьПроживающиего(стрМ, НомерЛС, ЭтоКапРемонт, Строка.ТабНомер);
		КонецЦикла;
		
		//Разбивка и сортировка Даты СПП
		Если ЗначениеЗаполнено(Строка.ДатаСПП) Тогда
			мДатаСПП = Новый Массив;
			мДатаСПП = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка.ДатаСПП, "," ,Ложь, Истина);
			
			Для i = 0 По мДатаСПП.Количество() - 1 Цикл
				мДатаСПП[i] = ВычислитьДату(мДатаСПП[i], Строка.ТабНомер, "Дата СПП");
			КонецЦикла;
			
			Список = Новый СписокЗначений;
			Список.ТипЗначения = Новый ОписаниеТипов("Дата");
			Список.ЗагрузитьЗначения(мДатаСПП);
			
			Список.СортироватьПоЗначению(НаправлениеСортировки.Убыв);
			мДатаСПП = Список.ВыгрузитьЗначения();
			
		Иначе	
			мДатаСПП = Новый Массив;
			мДатаСПП.Добавить(Дата(1,1,1));
		КонецЕсли;
		
		//Заполнение статусов и дат статусов
		Если ЗагрузитьЗакрытыеИЛ И НЕ Строка.ДатаСнятияСУчета = Дата(1, 1, 1) Тогда
			 Документ.Статус = Перечисления.СтатусыПоИсполнительнымЛистам.ИсполненВПолномОбъеме;
		ИначеЕсли НЕ Строка.ДатаБанк = Дата(1, 1, 1)
			//И Строка.ДатаБанк > Строка.ДатаСПП Тогда
			И Строка.ДатаБанк > мДатаСПП[0] Тогда
			
			Документ.Статус = Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВБанк;
			
		//ИначеЕсли НЕ Строка.ДатаСПП =  Дата(1, 1, 1)
		//			И Строка.ДатаСПП > Строка.ДатаБанк Тогда
		ИначеЕсли НЕ мДатаСПП[0] = Дата(1, 1, 1)
			      И мДатаСПП[0] > Строка.ДатаБанк Тогда
			
			Документ.Статус = Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВОСП;
			
		//ИначеЕсли Строка.ДатаСПП =  Дата(1, 1, 1)
		ИначеЕсли мДатаСПП[0] = Дата(1, 1, 1)
			И Строка.ДатаБанк = Дата(1, 1, 1) Тогда
			
			Документ.Статус = Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВОСП;    
			
		КонецЕсли; 
		
		Если НЕ Строка.ДатаРейда = Дата(1, 1, 1) Тогда
			
			Документ.РаботаССППоИсполнительномуЛисту.Добавить();
			Документ.РаботаССППоИсполнительномуЛисту[0].ДатаРейда = Строка.ДатаРейда;
			Документ.РаботаССППоИсполнительномуЛисту[0].РезультатРейда = Строка.РезультатРейда;
			
		КонецЕсли; 
		
		// Проведение документа
		Попытка
			Удачно = Истина;  
			
			Документ.Записать(РежимЗаписиДокумента.Проведение);
			
		Исключение
			Удачно = Ложь
		КонецПопытки;
		
		// Движения по регистрам
		Если Удачно Тогда
			
			//РН СтатусыПоИсполнительнымЛистам
			//Если НЕ Строка.ДатаСПП = Дата(1, 1, 1)
			Если НЕ мДатаСПП[0] = Дата(1,1,1)
				ИЛИ НЕ Строка.ДатаБанк = Дата(1, 1, 1)
				ИЛИ НЕ Строка.ДатаСнятияСУчета = Дата(1, 1, 1) Тогда
				
				Набор = РегистрыСведений.СтатусыПоИсполнительнымЛистам.СоздатьНаборЗаписей();
				Набор.Отбор.ИсполнительныйЛист.Установить(Документ.Ссылка);
				Набор.Записать();
				
				Набор = РегистрыСведений.СтатусыПоИсполнительнымЛистам.СоздатьНаборЗаписей();
				//Набор.Отбор.Регистратор.Установить(Документ.Ссылка);
				Набор.Отбор.ИсполнительныйЛист.Установить(Документ.Ссылка);
				Набор.Прочитать();
				Набор.Записывать = Истина;
				
				//Если НЕ Строка.ДатаСПП = Дата(1, 1, 1) Тогда
				Если мДатаСПП.Количество() > 0 И НЕ мДатаСПП[0] = Дата(1,1,1) Тогда
					
					Для i = 0 По мДатаСПП.Количество() - 1 Цикл
						
						Движение = Набор.Добавить();
						//Движение.Регистратор = Документ.Ссылка;
						Движение.ИсполнительныйЛист = Документ.Ссылка;
						
						Движение.Период = мДатаСПП[i];
						Движение.СтатусДокумента = Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВОСП;
						
					КонецЦикла;
					
				КонецЕсли; 
				
				Если НЕ Строка.ДатаБанк = Дата(1, 1, 1) Тогда
					
					Движение = Набор.Добавить();
					//Движение.Регистратор = Документ.Ссылка;
					Движение.ИсполнительныйЛист = Документ.Ссылка;
					
					Движение.Период = Строка.ДатаБанк;
					Движение.СтатусДокумента = Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВБанк;
				КонецЕсли;
				
				Если НЕ Строка.ДатаСнятияСУчета = Дата(1, 1, 1) Тогда
					
					Движение = Набор.Добавить();
					//Движение.Регистратор = Документ.Ссылка;
					Движение.ИсполнительныйЛист = Документ.Ссылка;
					
					Движение.Период = Строка.ДатаСнятияСУчета;
					Движение.СтатусДокумента = Перечисления.СтатусыПоИсполнительнымЛистам.ИсполненВПолномОбъеме;
					
				КонецЕсли;
				
				Попытка
					Набор.Записать(Ложь);
				Исключение
					
					//Если запись неуникальная
					Попытка
						
						Для каждого Запись Из Набор Цикл
						
							Запись.Период = Запись.Период + СчетчикСекунда;
							СчетчикСекунда = СчетчикСекунда + 1;
						
						КонецЦикла;
						
						Набор.Записать(Ложь);	
						
					Исключение
						ТестОшибки = "Не удалось записать движения в РС ""Статусы по исполнительным листам"" по документу: " + Документ;
						ОбщегоНазначения.СообщитьПользователю(ТестОшибки, Документ);
						//Сообщение = Новый СообщениеПользователю;
						//Сообщение.Текст = "Не удалось записать движения в РС ""Статусы по исполнительным листам"" по документу с номером: " + Документ.Номер;
						//Сообщение.Сообщить();
					КонецПопытки;
					
				КонецПопытки;
				
				
			КонецЕсли; 
			
		КонецЕсли; 
		
		Если НЕ Удачно Тогда
			
			Попытка
				
				Документ.Записать(РежимЗаписиДокумента.Запись);
				ТестОшибки = "Не удалось провести документ по строке: " + Строка.ТабНомер + ". Создан документ :" + Документ;
				ОбщегоНазначения.СообщитьПользователю(ТестОшибки, Документ);

				//Сообщение = Новый СообщениеПользователю;
				//Сообщение.Текст = "Не удалось провести документ по строке: " + Строка.ТабНомер + ". Создан документ с номером: " + Документ.Номер;
				//Сообщение.Сообщить(); 
				
			Исключение
				
				ТестОшибки = "Не удалось создать документ по строке: " + Строка.ТабНомер;
				ОбщегоНазначения.СообщитьПользователю(ТестОшибки);

				//Сообщение = Новый СообщениеПользователю;
				//Сообщение.Текст = "Не удалось создать документ по строке: " + Строка.ТабНомер;
				//Сообщение.Сообщить(); 
				
			КонецПопытки; 
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Функция ВычислитьПроживающиего(ФИО, ЛС, ЭтоКапРемонт, ТабНомер)
	
	//Вычисляем ФИО из файла загрузки если ФИО заполнено; или по ответственному лицу ЛС если ФИО пустое
	Если ЗначениеЗаполнено(СокрЛП(ФИО)) Тогда
		
		мФИО = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивСлов(ФИО);
		Если мФИО.Количество() > 0 Тогда
			Фамилия = мФИО[0];
			
			Если мФИО.Количество() = 2 Тогда
				Имя = мФИО[1];
				Отчество = "";
			КонецЕсли;
			
			Если мФИО.Количество() = 3 Тогда
				Имя = мФИО[1];
				Отчество = мФИО[2];
			КонецЕсли;
		Иначе 
			Фамилия = ФИО;
			Имя = "";
			Отчество = "";
		КонецЕсли;
		пФИО = Фамилия + " " + Имя + "%" + " " + Отчество + "%";
	
	ИначеЕсли ЭтоКапРемонт Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Пустое ФИО по капитальному ремонту в строке №" + ТабНомер + " загрузочного файла! Будет записано ответственное лицо по ЛС.";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.Ссылка КАК ФизЛицоСсылка
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			,
	|			ФизЛицо.Наименование ПОДОБНО &пФИО
	|				И ЛицевойСчет.Наименование = &ЛС) КАК бит_ПроживающиеПоЛССрезПоследних";
	
	Запрос.УстановитьПараметр("ЛС", ЛС);
	
	Если ЗначениеЗаполнено(ФИО) Тогда
		Запрос.УстановитьПараметр("пФИО", пФИО);
	Иначе 
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "ФизЛицо.Наименование ПОДОБНО &пФИО", "СтепеньРодства = &Ответственный");
		Запрос.УстановитьПараметр("Ответственный", Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо);
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Выборка.Следующий();
	
	Если Выборка.Количество() = 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Не удалось записать ФИО по Таб.Номеру: " + ТабНомер + " загрузочного файла!";
		Сообщение.Сообщить();
		
	ИначеЕсли  Выборка.Количество() > 1 И ЭтоКапРемонт Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Неоднозначное ФИО по капитальному ремонту по Таб.Номеру: " + ТабНомер + " загрузочного файла! Записан: " + Выборка.ФизЛицоСсылка;
		Сообщение.Сообщить();
	КонецЕсли;
	
	Возврат Выборка.ФизЛицоСсылка;
	
КонецФункции 

&НаСервере
Функция НайтиИЛ(НомерЛС, НомерИЛ)

	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ИсполнительныйЛист.Ссылка КАК Ссылка,
		|	бит_ИсполнительныйЛист.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_ИсполнительныйЛист.НомерИсполнительногоЛиста КАК НомерИсполнительногоЛиста
		|ИЗ
		|	Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
		|ГДЕ
		|	бит_ИсполнительныйЛист.НомерИсполнительногоЛиста = &НомерИсполнительногоЛиста
		|	И бит_ИсполнительныйЛист.ЛицевойСчет = &ЛицевойСчет
		|	И НЕ бит_ИсполнительныйЛист.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(НомерЛС));
	Запрос.УстановитьПараметр("НомерИсполнительногоЛиста", НомерИЛ);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Найдено больше одного документа Исполнительный Лист по номеру ИЛ %1 и номеру ЛС %2. Будет выбран первый из списка: ", НомерИЛ, НомерЛС);
	Шаблон = Символы.ПС + "| %1 ;";
	
	Если Выборка.Количество() > 1 Тогда
	
		Пока Выборка.Следующий() Цикл
			ТекстОшибки = ТекстОшибки + СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(Шаблон, Выборка.Ссылка);
		КонецЦикла;
		
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки, Выборка.Ссылка);
		
		Выборка.Сбросить();
		
	КонецЕсли;
	
	Если НЕ Выборка.Количество() = 0 Тогда
		Выборка.Следующий();
		Возврат Выборка.Ссылка;
	Иначе
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку("Не найдено ни одного документа Исполнительный Лист по номеру ИЛ %1 и номеру ЛС %2. Будет создан новый документ ", НомерИЛ, НомерЛС);  
		ОбщегоНазначения.СообщитьПользователю(ТекстОшибки);
		Возврат Документы.бит_ИсполнительныйЛист.ПустаяСсылка();
	КонецЕсли;
	
КонецФункции 

#КонецОбласти 