// Обработчик события "ПриИзменении" поля "ЛицевойСчет" в табличном поле "СписокЛС".
&НаКлиенте
Процедура СписокЛСЛицевойСчетПриИзменении(Элемент)
	
	ТекДанные       = Элементы.СписокЛС.ТекущиеДанные;
	
	// БИТ_ЖКХ 03.04.2014
	Если  ТекДанные <> Неопределено Тогда
		ЛицевойСчет     = ТекДанные.ЛицевойСчет;
		СальдоНаЛС      = ПолучитьСальдоНаЛицевомСчете(ЛицевойСчет);
		// БИТ_ЖКХ 24.03.2014
		УлицаЛицевогоСчета = УлицаЛицевогоСчетаНаСервере(ТекДанные.ЛицевойСчет);
		Здание = ЗданиеНаСервере(ТекДанные.ЛицевойСчет);
		Корпус = КорпусНаСервере(ТекДанные.ЛицевойСчет);
		Квартира = КвартираНаСервере(ТекДанные.ЛицевойСчет);
		// БИТ_ЖКХ 24.03.2014
		ТекДанные.Адрес = Строка(УлицаЛицевогоСчета)+", д. "+Строка(Здание)+?(ПустаяСтрока(Корпус),"",", кор. "+Корпус+", кв. "+Квартира);
		ТекДанные.СальдоНаЛС = СальдоНаЛС;	
		ТекДанные.ШаблонИзвещений = ПолучитьШаблонИзвещений();
	КонецЕсли;
	// БИТ_ЖКХ 03.04.2014
	
КонецПроцедуры

