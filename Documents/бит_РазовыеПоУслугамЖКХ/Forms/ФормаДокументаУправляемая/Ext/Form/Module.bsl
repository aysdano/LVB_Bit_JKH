&НаКлиенте
Процедура СписокУслугУслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое") 
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое")
		// БИТ ЖКХ 10.03.2020
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ГрупповыеПерерасчетыОДН")Тогда
		
		ТекСтрока = Элементы.СписокУслуг.ТекущиеДанные;
		
		ЛС = ТекСтрока.ЛицевойСчет;
		
	Иначе
		
		ЛС = Объект.ЛицевойСчет;
		
	КонецЕсли;
	
	СписокУслугОтбора = ПолучитьСписокУслугОтбораНаСервере(Объект.Дата, ЛС);
	
	Если Объект.СписокУслуг.Количество() > 0 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("СписокУслугОтбора", СписокУслугОтбора);
		
		ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая", Новый Структура("ЗаполнитьИзДокументаРазовыеПоУслугамЖКХ", ПараметрыФормы), Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

