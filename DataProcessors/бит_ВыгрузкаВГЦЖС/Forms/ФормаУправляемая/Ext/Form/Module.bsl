			ВыборкаЛьгот = ВыборкаФизЛиц.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			ЗаписьТип1 = ""; // Запись, содержащая сведения о владельце льгот (Тип 1);.
			
			ТипЗаписи  = "1";
			
			Попытка
				
				СтраховойНомер = СокрЛП(СтрЗаменить(ВыборкаФизЛиц.СтраховойНомерПФР,"-",""));
				СтраховойНомер = ?(ПустаяСтрока(СтраховойНомер), "", ВыборкаФизЛиц.СтраховойНомерПФР); 
				
				КолЗаписейТипа2    = Прав(МногоНулей + ВыборкаЛьгот.Количество(),2);
				КодРайона          = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.КодРайона)),3);
				
				КодПлательщика     = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.ЛСвБДСоцзащиты)),10);
				НомерЛС            = Лев(СокрЛП(Строка(ВыборкаФизЛиц.ЛицевойСчет)) + МногоПробелов,20);
				СтраховойНомер     = Лев(Строка(СтраховойНомер) + МногоПробелов,14);
				Фамилия            = Лев(СокрЛП(Строка(ВыборкаФизЛиц.Фамилия)) + МногоПробелов,30);
				Имя                = Лев(СокрЛП(Строка(ВыборкаФизЛиц.Имя)) + МногоПробелов,30);
				Отчество           = Лев(СокрЛП(Строка(ВыборкаФизЛиц.Отчество)) + МногоПробелов,30);
				КодУлицы           = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.КодУлицы)),5);
				Дом                = Лев(СокрЛП(Строка(ВыборкаФизЛиц.Здание)) + МногоПробелов,8);
				Корпус             = Лев(СокрЛП(Строка(ВыборкаФизЛиц.Корпус)) + МногоПробелов,6);
				Строение           = Лев(МногоПробелов,5);
				Квартира           = Лев(СокрЛП(Строка(ВыборкаФизЛиц.Квартира)) + МногоПробелов,10);
				Телефон            = Прав(МногоНулей + СтрЗаменить(СокрЛП(Строка(ВыборкаФизЛиц.Телефон)),"-",""),10);
				ЖилищныйФонд       = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.КодЖилФонда)),1);
				ТипЗаселения       = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.КодТипаКвартиры)),1);
				ФормаСобственности = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.КодСтатусаКвартиры)),1);
				КолПостПроживающих = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.КолПостояноПроживающих)),2);
				КолФактПроживающих = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.КолФактичПроживающих)),2);
				
				ОбщаяПлощадь       = Прав(МногоНулей + СтрЗаменить(СокрЛП(Строка(Формат(ВыборкаФизЛиц.ОбщаяПлощадь, "ЧДЦ=2; ЧРД=,; ЧГ=0"))),",",""),6);
				ЖилаяПлощадь       = Прав(МногоНулей + СтрЗаменить(СокрЛП(Строка(Формат(ВыборкаФизЛиц.ЖилаяПлощадь, "ЧДЦ=2; ЧРД=,; ЧГ=0"))),",",""),6);
				
				ПолФизЛица         = ?(ВыборкаФизЛиц.Пол = Перечисления.ПолФизическогоЛица.Мужской, "М", "Ж");
				Пол                = Лев(СокрЛП(Строка(ПолФизЛица)) + МногоПробелов,1);
				
				ДатаРожденияФизЛиц = ""+Формат(ВыборкаФизЛиц.ДатаРождения, "ДФ=dd")+Формат(ВыборкаФизЛиц.ДатаРождения, "ДФ=MM")+Формат(ВыборкаФизЛиц.ДатаРождения, "ДФ=yyyy"); 
				ДатаРождения       = Прав(МногоНулей + СокрЛП(Строка(ДатаРожденияФизЛиц)),8);
				
				ВидДокумента       = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.КодДокументаУЛ)),1);
				СерияДокумента     = Лев(СокрЛП(Строка(ВыборкаФизЛиц.ДокументСерия)) + МногоПробелов,8);
				НомерДокумента     = Прав(МногоНулей + СокрЛП(Строка(ВыборкаФизЛиц.ДокументНомер)),8);
				
				ДатаВыдачиУЛ       = ""+Формат(ВыборкаФизЛиц.ДокументДатаВыдачи, "ДФ=dd")+Формат(ВыборкаФизЛиц.ДокументДатаВыдачи, "ДФ=MM")+Формат(ВыборкаФизЛиц.ДокументДатаВыдачи, "ДФ=yyyy"); 
				ДатаВыдачи         = Прав(МногоНулей + СокрЛП(Строка(ДатаВыдачиУЛ)),8);
				
				Организация        = Лев(СокрЛП(Строка(ВыборкаФизЛиц.ДокументКемВыдан)) + МногоПробелов,80);
				
			Исключение

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(""+ ОписаниеОшибки());
				
			КонецПопытки;
			
			ЗаписьТип1 = ЗаписьТип1 + ТипЗаписи + КолЗаписейТипа2 + КодРайона + КодПлательщика + НомерЛС + СтраховойНомер + Фамилия
			+ Имя + Отчество + КодУлицы + Дом + Корпус + Строение + Квартира + Телефон + ЖилищныйФонд + ТипЗаселения + ФормаСобственности
			+ КолПостПроживающих + КолФактПроживающих + ОбщаяПлощадь + ЖилаяПлощадь + Пол + ДатаРождения + ВидДокумента + СерияДокумента 
			+ НомерДокумента + ДатаВыдачи + Организация;
			
			Текст.ДобавитьСтроку(ЗаписьТип1);
			
			ОбщееКолЗаписейТипа1 = ОбщееКолЗаписейТипа1 + 1;
			
			Пока ВыборкаЛьгот.Следующий() Цикл
				
				ЗаписьТип2 = ""; // Запись, содержащая сведения о документах, подверждающих право на льготу (Тип 2).
				
				ВыборкаУслуг = ВыборкаЛьгот.Выбрать();
				
				ТипЗаписи = "2";
				
				Попытка
					
					КолЗаписейТипа3 = Прав(МногоНулей + ВыборкаУслуг.Количество(),2);
					КодЛьготы       = Прав(МногоНулей + СокрЛП(Строка(ВыборкаЛьгот.КодЛьготы)),3);
					
					// Документ на льготу 1.
					
					ВидДокумента1    = Прав(МногоНулей + СокрЛП(Строка(ВыборкаЛьгот.КодДокументаНаЛьготу)),2);
					СерияДокумента1  = Лев(СокрЛП(Строка(ВыборкаЛьгот.СерияДокумента)) + МногоПробелов,8);
					НомерДокумента1  = Лев(СокрЛП(Строка(ВыборкаЛьгот.НомерДокумента)) + МногоПробелов,10);
					
					ДатаВыдачиЛьготы    = ""+Формат(ВыборкаЛьгот.ДатаВыдачи, "ДФ=dd")+Формат(ВыборкаЛьгот.ДатаВыдачи, "ДФ=MM")+Формат(ВыборкаЛьгот.ДатаВыдачи, "ДФ=yyyy"); 
					ДатаВыдачи1          = Прав(МногоНулей + СокрЛП(Строка(ДатаВыдачиЛьготы)),8);
					
					ДатаОкончанияЛьготы = ""+Формат(ВыборкаЛьгот.СрокДействияЛьготы, "ДФ=dd")+Формат(ВыборкаЛьгот.СрокДействияЛьготы, "ДФ=MM")+Формат(ВыборкаЛьгот.СрокДействияЛьготы, "ДФ=yyyy"); 
					ДатаОкончания1       = Прав(МногоНулей + СокрЛП(Строка(ДатаОкончанияЛьготы)),8);
					
					Организация1         = Лев(СокрЛП(Строка(ВыборкаЛьгот.КемВыдан)) + МногоПробелов,50);
					
					// Документ на льготу 2.
					
					ВидДокумента2        = Прав(МногоНулей  ,2);
					СерияДокумента2      = Лев(МногоПробелов,8);
					НомерДокумента2      = Лев(МногоПробелов,10);
					ДатаВыдачи2          = Прав(МногоНулей  ,8);
					ДатаОкончания2       = Прав(МногоНулей  ,8);
					Организация2         = Лев(МногоПробелов,50);
					
					// Документ на льготу 3.
					
					ВидДокумента3        = Прав(МногоНулей  ,2);
					СерияДокумента3      = Лев(МногоПробелов,8);
					НомерДокумента3      = Лев(МногоПробелов,10);
					ДатаВыдачи3          = Прав(МногоНулей  ,8);
					ДатаОкончания3       = Прав(МногоНулей  ,8);
					Организация3         = Лев(МногоПробелов,50);
					
				Исключение

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("" + ОписаниеОшибки());
					
				КонецПопытки;
				
				ЗаписьТип2 = ЗаписьТип2 + ТипЗаписи + КолЗаписейТипа3 + КодЛьготы 
				+ ВидДокумента1 + СерияДокумента1 + НомерДокумента1 + ДатаВыдачи1 + ДатаОкончания1 + Организация1
				+ ВидДокумента2 + СерияДокумента2 + НомерДокумента2 + ДатаВыдачи2 + ДатаОкончания2 + Организация2
				+ ВидДокумента3 + СерияДокумента3 + НомерДокумента3 + ДатаВыдачи3 + ДатаОкончания3 + Организация3;
				
				Текст.ДобавитьСтроку(ЗаписьТип2);
				
				ОбщееКолЗаписейТипа2 = ОбщееКолЗаписейТипа2 + 1;
				
				Пока ВыборкаУслуг.Следующий() Цикл
					
					ЗаписьТипа3 = ""; // Запись, содержащая сведения о льготных скидках по услугам (Тип 3);.
					
					ТипЗаписи3 = "3";
					
					Попытка
						
						МесяцПредоставленияЛьгот         = ""+Формат(Объект.Период, "ДФ=MM")+Формат(Объект.Период, "ДФ=yyyy");
						МесяцЗаКоторыйПредоствленаЛьгота = Прав(МногоНулей + СокрЛП(Строка(МесяцПредоставленияЛьгот)),6);
						
						КодУслуги               = Прав(МногоНулей + СокрЛП(Строка(ВыборкаУслуг.КодУслуги)),4);
						
						Если ВыборкаУслуг.ИспользоватьТариф Тогда

							ЦенаСтавкаТарифНаУслугу = Прав(МногоНулей + СокрЛП(СтрЗаменить(Формат(Окр(ВыборкаУслуг.Тариф, 2), "ЧДЦ=2; ЧРД=,; ЧГ=0"),",","")),6);
							
						Иначе

							ЦенаСтавкаТарифНаУслугу = Прав(МногоНулей + СокрЛП(СтрЗаменить(Формат(Окр(ВыборкаУслуг.ОсновнаяСтавка, 2), "ЧДЦ=2; ЧРД=,; ЧГ=0"),",","")),6);
							
						КонецЕсли; 
						
						КолПользующихсяЛьготой = 1;
						Если ЗначениеЗаполнено(ВыборкаУслуг.СуммаСемейной) Тогда
							Если ЗначениеЗаполнено(ВыборкаУслуг.КоличечествоПолучателейСемейной)
								И ВыборкаУслуг.КоличечествоПолучателейСемейной > 0 Тогда
								КолПользующихсяЛьготой = ВыборкаУслуг.КоличечествоПолучателейСемейной + 1; // Добавляем владельца, он не отмечен в регистре сведений.	
							Иначе
								КолПользующихсяЛьготой = ВыборкаУслуг.КолИмеющихПравоНаЛьготу;	
							КонецЕсли;
						КонецЕсли;
						КолПользующихсяЛьготой  = ?(ЗначениеЗаполнено(ВыборкаУслуг.ФиксКолЧел), ВыборкаУслуг.ФиксКолЧел, КолПользующихсяЛьготой);
						КолПользующихсяЛьготой  = Прав(МногоНулей + СокрЛП(Строка(КолПользующихсяЛьготой)),2);
						
						Если ВыгружатьОбъем Тогда
							
							ОбъемНаКотПроизвРасчет  = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(ВыборкаУслуг.Объем, "ЧДЦ=6; ЧРД=,; ЧГ=0")),",","")),10);
							
						Иначе
							
							ОбъемНаКотПроизвРасчет  = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(ВыборкаУслуг.НормаЛьготы, "ЧДЦ=6; ЧРД=,; ЧГ=0")),",","")),10);
							
						КонецЕсли;
						
						ПлощадьЛьготы = Прав(МногоНулей,6);
						
						НормаЛьготы = ВыборкаУслуг.НормаЛьготы;
						Если ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда
							ПлощадьЛьготы = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(НормаЛьготы, "ЧДЦ=2; ЧРД=,; ЧГ=0")),",","")),6);
						ИначеЕсли ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда
							ПлощадьЛьготы = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(НормаЛьготы, "ЧДЦ=2; ЧРД=,; ЧГ=0")),",","")),6);
						ИначеЕсли ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади Тогда
							ПлощадьЛьготы = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(НормаЛьготы, "ЧДЦ=2; ЧРД=,; ЧГ=0")),",","")),6);
						КонецЕсли;
						
						РазмерЛьготнойСкидки = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(ВыборкаУслуг.Начислено, "ЧДЦ=2; ЧРД=,; ЧГ=0")),",","")),9);
						ФактичОбъемРасхода   = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(ВыборкаУслуг.КоличествоЕдиницПоЛС, "ЧДЦ=6; ЧРД=,; ЧГ=0")),",","")),10);
						
						ПорядокРасчетаУслуги = Прав(МногоНулей,1);
						
						ФактПлощадь = 0;
						Если ВыборкаУслуг.ОсновнойСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда
							ФактПлощадь = ВыборкаУслуг.ЖилаяПлощадь;
						ИначеЕсли ВыборкаУслуг.ОсновнойСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда
							ФактПлощадь = ВыборкаУслуг.ОбщаяПлощадь;
						ИначеЕсли ВыборкаУслуг.ОсновнойСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади Тогда
							ФактПлощадь = ВыборкаУслуг.ОтапливаемаяПлощадь;
						КонецЕсли;
						
						Если ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам Тогда
							
							Если ВыборкаУслуг.СпособРасчетаПоСчетчикам = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам Тогда
								
								КодУслуги = Прав(МногоНулей + СокрЛП(Строка(ВыборкаУслуг.КодУслуги_КПУ)),4);
								
								ПорядокРасчетаУслуги = Прав(МногоНулей + "2",1);
								
							ИначеЕсли ВыборкаУслуг.СпособРасчетаПоСчетчикам = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам
								ИЛИ ВыборкаУслуг.СпособРасчетаПоСчетчикам = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных Тогда
								
								КодУслуги               = Прав(МногоНулей + СокрЛП(Строка(ВыборкаУслуг.КодУслуги_ДПУ)),4);
								
								ПорядокРасчетаУслуги = Прав(МногоНулей + "1",1);
								
								ФактОбъем   = ВыборкаУслуг.КоличествоЕдиницПоЛС;
								ОбъемЛьготы = ВыборкаУслуг.НормаЛьготы;
								
								Если НЕ ФактОбъем = 0 Тогда
									
									Площадь = Окр((ФактПлощадь * ОбъемЛьготы) / ФактОбъем, 2);
									
									ПлощадьЛьготы = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(Площадь, "ЧДЦ=2; ЧРД=,; ЧГ=0")),",","")),6);
									
								КонецЕсли; 
								
							КонецЕсли;
							
						ИначеЕсли (ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади
							ИЛИ ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади
							ИЛИ ВыборкаУслуг.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади)
							И ВыборкаУслуг.ТипыНачислений = Перечисления.бит_ТипыНачисленийПоЖКХ.Коммунальная Тогда
							
							ОбъемЛьготы = Окр(НормаЛьготы * ВыборкаУслуг.Норматив, 6);
							ФактОбъем   = Окр(ФактПлощадь * ВыборкаУслуг.Норматив, 6);
							
							ОбъемНаКотПроизвРасчет = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(ОбъемЛьготы, "ЧДЦ=6; ЧРД=,; ЧГ=0")),",","")),10);
							ФактичОбъемРасхода     = Прав(МногоНулей + СокрЛП(СтрЗаменить(Строка(Формат(ФактОбъем  , "ЧДЦ=6; ЧРД=,; ЧГ=0")),",","")),10);
							
						КонецЕсли; 
						
					Исключение

						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(""+ ОписаниеОшибки());
						
					КонецПопытки;
					
					ЗаписьТипа3 = ЗаписьТипа3 + ТипЗаписи3 + МесяцЗаКоторыйПредоствленаЛьгота + КодУслуги + ЦенаСтавкаТарифНаУслугу + КолПользующихсяЛьготой
					+ ОбъемНаКотПроизвРасчет + ПлощадьЛьготы + РазмерЛьготнойСкидки + ФактичОбъемРасхода + ПорядокРасчетаУслуги;
					
					Текст.ДобавитьСтроку(ЗаписьТипа3);
					
					ОбщееКолЗаписейТипа3 = ОбщееКолЗаписейТипа3 + 1;
					
					ИтогСуммы = ИтогСуммы + Окр((ВыборкаУслуг.Начислено),2);
					
				КонецЦикла; 
				
			КонецЦикла; 
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	КонтрольнаяЦифра1 = Прав(МногоНулей + Формат(ОбщееКолЗаписейТипа1, "ЧГ=0"),8);
	КонтрольнаяЦифра2 = Прав(МногоНулей + Формат(ОбщееКолЗаписейТипа2, "ЧГ=0"),8);
	КонтрольнаяЦифра3 = Прав(МногоНулей + Формат(ОбщееКолЗаписейТипа3, "ЧГ=0"),8);
	КонтрольнаяЦифра4 = Прав(МногоНулей + СтрЗаменить(Формат(ИтогСуммы, "ЧДЦ=2; ЧРД=,; ЧГ=0"),",",""),12);
	
	ЗаписьТип4 = ЗаписьТип4 + ТипЗаписи4 + НомерДоговора + КонтрольнаяЦифра1 + КонтрольнаяЦифра2 + КонтрольнаяЦифра3+ КонтрольнаяЦифра4;
	
	Текст.ДобавитьСтроку(ЗаписьТип4);
	
	Возврат Текст;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьЛьготы()
	
	ВсеРеквизитыЗаполнены = ПроверитьЗаполнение();
	
	Если ВсеРеквизитыЗаполнены Тогда
		
		Если Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.Москва Тогда
			
			//21.11.2018
			если Объект.НовыйФорматВыгрузки = Истина тогда 		
				
			 если Объект.ТипОтчета = "Отчет" тогда	
			  числоТип = 0;
		     иначе
			  числоТип = 1;
		     конецесли; 
		  
			 ИмяФайла = строка(объект.Каталог) + строка("\bnf_") + строка (числоТип) + "_" + строка(ЗаполнитьНулями (объект.НомерДоговора, 7)) + "_" + Формат(объект.Период,"ДФ=""ггггММ""") + ".xml"; 
	         ИмяФайла_tmp = строка(объект.Каталог) + строка("\bnf_") + строка (числоТип) + "_" + строка(ЗаполнитьНулями (объект.НомерДоговора, 7)) + "_" + Формат(объект.Период,"ДФ=""ггггММ""") + "_tmp.xml"; 
			 
			 АдресХранилищаXDTO = СоздатьФайлВыгрузкиЛьготыXML();	
			 
			 если АдресХранилищаXDTO = неопределено тогда
			   Сообщить("Файл не сформирован: "+ ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
			   возврат;
			 конецесли;  
			   
			 объектОтчета = ПолучитьИзВременногоХранилища(АдресХранилищаXDTO);
			 объектОтчета.Записать(ИмяФайла_tmp); 
			 
			 //28.01.2019  60 приведение файла к требуемому виду выгрузки
			 ТекстовыйФайл = Новый ТекстовыйДокумент;			 
			 ТекстовыйФайл.УстановитьТекст("<?xml version=""1.0"" encoding=""UTF-8""?>");
			 			 
	         Текст = Новый ЧтениеТекста;
             Текст.Открыть(ИмяФайла_tmp); 
	
			 Стр = "";
			 Пока Стр <> Неопределено Цикл 				 
                Стр = Текст.ПрочитатьСтроку();
				
				если Стр <> Неопределено тогда
				 Стр = СтрЗаменить(Стр, "xmlns=""""", "");
                 ТекстовыйФайл.ДобавитьСтроку(Стр);
				конецесли; 
				 
             КонецЦикла;
 
             Текст.Закрыть();
			 УдалитьФайлы(ИмяФайла_tmp);
			 
			 //13.02.2019
			 Попытка
			   ТекстовыйФайл.Записать(ИмяФайла,  КодировкаТекста.UTF8,  Символы.ВК + Символы.ПС);
			   Сообщить("Файл сохранен.", СтатусСообщения.Информация);
			 Исключение
			   Сообщить("Файл не сформирован: "+ ОписаниеОшибки(), СтатусСообщения.ОченьВажное);
			 КонецПопытки;

			//---------------------
			иначе 
			    ТекстовыйДокумент = СоздатьФайлВыгрузкиЛьготы();
						
				Если объектОтчета = неопределено и ТекстовыйДокумент.КоличествоСтрок() <= 1 Тогда

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл не сформирован.");
					
				Иначе
				  Если объектОтчета = неопределено тогда	
					Попытка
						
						ТекстовыйДокумент.Записать(""+Объект.Каталог+"\"+Объект.ИмяФайла+".txt", "cp866");

						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл сохранен.");
						
					Исключение

						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(""+ ОписаниеОшибки());
						
					КонецПопытки;
				  КонецЕсли;	
			  КонецЕсли;
		     
			  конецесли; 

				ИначеЕсли Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.Иркутск Тогда
					
					ФайлИзменен = ЗаполнитьФайлВыгрузкиЛьготыИркутск();
					
					Если ФайлИзменен Тогда

						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл сохранен.");
						
					Иначе

						бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл не сформирован.");
						
					КонецЕсли; 
					
				ИначеЕсли Объект.РегионВыгрузки = мКэшЗначений.Перечисления.бит_РегионыВыгрузкиВГЦЖС.КрасноярскийКрай Тогда
					
					ИнформационнаяБазаФайловая = ОпределитьИБНаСервере();
					
					Если НЕ ИнформационнаяБазаФайловая Тогда
						
						ВыгрузкаЛьготыКрасноярскийКрайНаКлиенте();
						
					Иначе												
						
						ВыгрузкаЛьготыКрасноярскийКрай();
						
					КонецЕсли;
					
				КонецЕсли;
		 		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузкаЛьготыКрасноярскийКрай()
	
	ТаблицаОтвЛиц = Новый ТаблицаЗначений;
	ТаблицаОтвЛиц.Колонки.Добавить("ЛицевойСчет", Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаОтвЛиц.Колонки.Добавить("ФизЛицо"    , Новый ОписаниеТипов("СправочникСсылка.бит_Проживающие"));
	ТаблицаОтвЛиц.Колонки.Добавить("Код"        
	, ОбщегоНазначения.ОписаниеТипаЧисло(7,0));
	
	// Формирование Файла сведений о членах семьи;.
	СведенияОЧленахСемьи(ТаблицаОтвЛиц);
	
	// Формирование файла квартиросъемщика.
	ФормированиеФайлаКвартиросъемщика(ТаблицаОтвЛиц);
	
	// Формирование файла суммы оплаты услуг.
	ФормированиеФайлаСуммыОплатыУслуг(ТаблицаОтвЛиц);	
	
КонецПроцедуры

// Добавлена возможность выгрузки в Excel.
&НаСервере
Процедура ФормированиеФайлаКвартиросъемщика(ТаблицаОтвЛиц)
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Параметры.Вставить("Организация"   , Объект.Организация);
	ПостроительЗапроса.Параметры.Вставить("КонецПериода"  , КонецМесяца(Объект.Период));
	ПостроительЗапроса.Параметры.Вставить("НачалоПериода"  , НачалоМесяца(Объект.Период));
	
	Если НЕ Объект.ШаблонУслуг = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам 
		И НЕ Объект.ШаблонУслуг.Пустая() Тогда
		
		ЕстьШаблон = Истина;
		ПостроительЗапроса.Параметры.Вставить("УслугаЖКХ" 	, Объект.ШаблонУслуг.Услуги.ВыгрузитьКолонку("Услуга"));
		ПостроительЗапроса.Параметры.Вставить("ЕстьШаблон"	, Истина);
	Иначе
		ПостроительЗапроса.Параметры.Вставить("УслугаЖКХ"	, Справочники.бит_УслугиЖКХ.ПустаяСсылка());
		ПостроительЗапроса.Параметры.Вставить("ЕстьШаблон"	, Ложь);
	КонецЕсли;
	
	ПостроительЗапроса.Текст = ТекстЗапросаКвартиросъемщика();
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если ИспользоватьОтборСписокЗданий Тогда
		
		тмпСписокЗданий = СписокЗданий.Выгрузить();
		ЗначениеОтбора = Новый СписокЗначений;
		ЗначениеОтбора.ЗагрузитьЗначения(тмпСписокЗданий.ВыгрузитьКолонку("Здание"));
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("ЗданиеСсылка");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ЗначениеОтбора;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСписокЛС Тогда
		
		Если СписокЛС.Количество() > 0 Тогда
			
			Отбор = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
			Отбор.ВидСравнения  = ВидСравнения.ВСписке;
			Отбор.Использование = Истина;
			Отбор.Значение      = СписокЛС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСтатусКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("СтатусКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = СтатусКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли; 
	
	Если ИспользоватьОтборТипКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("ТипКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ТипКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если кр_НеВыгружатьЛицевыеСчетаБезПроживающих Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("КоличествоЧленовСемьи");
		ОтборЗданий.ВидСравнения  = ВидСравнения.Больше;
		ОтборЗданий.Значение      = 0;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	
	Если ТипВыгрузки = "Excel" Тогда
		ВыгрузитьДанныеКвартиросъемщикаВExcel(ПостроительЗапроса,ТаблицаОтвЛиц);
	ИначеЕсли ТипВыгрузки = "DBF" Тогда
		ВыгрузитьДанныеКвартиросъемщикаВDBF(ПостроительЗапроса,ТаблицаОтвЛиц);
	Иначе
		ВыгрузитьДанныеКвартиросъемщикаВDBF(ПостроительЗапроса,ТаблицаОтвЛиц);
	КонецЕсли;
	
КонецПроцедуры

