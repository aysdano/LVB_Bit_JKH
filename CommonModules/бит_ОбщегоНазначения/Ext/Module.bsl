// Функция по массиву типов создает список выбора для быстрого выбора составного типа.
//
// Параметры:
//  МассивТипов  - Массив.
//
// Возвращаемое значение:
//   СписокВыбора  - СписокЗначений.
//
Функция ПодготовитьСписокВыбораТипа(МассивТипов) Экспорт
	
	СписокВыбора = Новый СписокЗначений;
	Для каждого ТекТип Из МассивТипов Цикл
		
		ОбъектМетаданных = Метаданные.НайтиПоТипу(ТекТип);
		Если ОбъектМетаданных = Неопределено Тогда
			ТекПредставление = Строка(ТекТип);
		Иначе	
			ТекПредставление = ОбъектМетаданных.Синоним;
		КонецЕсли; 
		
		СписокВыбора.Добавить(ТекТип,ТекПредставление);
		
	КонецЦикла; 
	
	Возврат СписокВыбора;
	
КонецФункции // ПодготовитьСписокВыбораТипа()

// Функция возвращает таблицу значений, содержащую услуги и режимы потребления оказываемые по конкретному адресу.
//
// Параметры:
//	ДатаСреза - дата.
//	Улица - элемент справочника бит_СписокУлиц, либо Неопределено;.
//	Здание - элемент справочника бит_СписокЗданий, либо Неопределено;.
//
// Возвращаемое значение:
//	Таблица значений.
//
Функция ПолучитьШаблонУслугПоАдресу(ДатаСреза, Улица=Неопределено, Здание=Неопределено) Экспорт
	Если НЕ ЗначениеЗаполнено(Улица) 
		И ЗначениеЗаполнено(Здание) Тогда
		Улица = Здание.Улица;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период", ДатаСреза);
	Запрос.УстановитьПараметр("Улица", Улица);
	Запрос.УстановитьПараметр("Здание", Здание);
	
	ТекстЗапроса = "ВЫБРАТЬ
	|	бит_ШаблоныУслугСрезПоследних.Улица,
	|	бит_ШаблоныУслугСрезПоследних.Здание,
	|	бит_ШаблоныУслугСрезПоследних.Услуга,
	|	бит_ШаблоныУслугСрезПоследних.Поставщик
	|ИЗ
	|	РегистрСведений.бит_ШаблоныУслуг.СрезПоследних(
	|			&Период,
	|			Улица = &Улица
	|				И Здание = &Здание) КАК бит_ШаблоныУслугСрезПоследних
	|ГДЕ
	|	бит_ШаблоныУслугСрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Запрос.Текст = ТекстЗапроса;
	Результат = Запрос.Выполнить();
	Шаблон = Результат.Выгрузить();
	
	Возврат Шаблон;
