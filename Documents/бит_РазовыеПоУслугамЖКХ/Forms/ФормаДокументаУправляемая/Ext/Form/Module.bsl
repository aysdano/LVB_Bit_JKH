&НаСервереБезКонтекста
Функция ПолучитьДанныеДляРасчетаНаСервере(ЛицевыеСчета,Услуги,НачалоПериода,КонецПериода,ВключаяРазовые,Организация,ДолиПериода)
	
	МВТ = Новый МенеджерВременныхТаблиц;

#Область ПроверкаСпособаРасчетаУслуги	
	СпособыРасчета = Новый Массив;
	СпособыРасчета.Добавить(Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади);
	СпособыРасчета.Добавить(Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади);
	СпособыРасчета.Добавить(Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления);
	РежимПотребления = Справочники.бит_РежимыПотребленияУслуг.НеНачислять;
	
    Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = МВТ;
#Область ТекстЗапроса
	Запрос.Текст = 	"ВЫБРАТЬ
	                //Получаем список периодов для которых нужны данные
	               	|	НАЧАЛОПЕРИОДА(ТаблицаПериодов.Период, МЕСЯЦ) КАК Период
	               	|ПОМЕСТИТЬ СписокПериодов
	               	|ИЗ
	               	|	&ТаблицаПериодов КАК ТаблицаПериодов
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
					//Получаем комбинации Период+ЛС+Услуга зарегистрированные в календарном месяце
					|	бит_СведенияПоУслугамЛС.Период КАК Период,
	               	|	бит_СведенияПоУслугамЛС.ЛицевойСчет КАК ЛицевойСчет,
	               	|	НАЧАЛОПЕРИОДА(бит_СведенияПоУслугамЛС.Период, МЕСЯЦ) КАК НачалоМесяца,
	               	|	бит_СведенияПоУслугамЛС.Услуга КАК Услуга
	               	|ПОМЕСТИТЬ ВыборкаИзРегистра
	               	|ИЗ
	               	|	РегистрСведений.бит_СведенияПоУслугамЛС КАК бит_СведенияПоУслугамЛС
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_УстановкаИзменениеУслугПоЛС КАК бит_УстановкаИзменениеУслугПоЛС
	               	|		ПО бит_СведенияПоУслугамЛС.Регистратор = бит_УстановкаИзменениеУслугПоЛС.Ссылка
	               	|ГДЕ
	               	|	бит_СведенияПоУслугамЛС.Активность = &Активность
	               	|	И бит_СведенияПоУслугамЛС.ЛицевойСчет В(&ЛицевойСчет)
	               	|	И бит_СведенияПоУслугамЛС.Услуга В(&Услуга)
	               	|	И бит_СведенияПоУслугамЛС.Использовать = &Использовать
	               	|	И бит_СведенияПоУслугамЛС.РежимПотребления <> &РежимПотребления
	               	|	И ТИПЗНАЧЕНИЯ(бит_СведенияПоУслугамЛС.Регистратор.Ссылка) = ТИП(бит_УстановкаИзменениеУслугПоЛС)
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
					//Получаем комбинации Период+ЛС+Услуга последние зарегистрированные в календарном месяце
	               	|	ВыборкаИзРегистра.ЛицевойСчет КАК ЛицевойСчет,
	               	|	ВыборкаИзРегистра.НачалоМесяца КАК НачалоМесяца,
	               	|	ВыборкаИзРегистра.Услуга КАК Услуга,
	               	|	МАКСИМУМ(ВыборкаИзРегистра.Период) КАК Период
	               	|ПОМЕСТИТЬ АктуальныйПериод
	               	|ИЗ
	               	|	ВыборкаИзРегистра КАК ВыборкаИзРегистра
	               	|
	               	|СГРУППИРОВАТЬ ПО
	               	|	ВыборкаИзРегистра.ЛицевойСчет,
	               	|	ВыборкаИзРегистра.НачалоМесяца,
	               	|	ВыборкаИзРегистра.Услуга
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
					//Сопоставляем комбинации Период+ЛС+Услуга со списком периодов
					|	СписокПериодов.Период КАК Период,
	               	|	АктуальныйПериод.ЛицевойСчет КАК ЛицевойСчет,
	               	|	АктуальныйПериод.Услуга КАК Услуга,
	               	|	МАКСИМУМ(АктуальныйПериод.Период) КАК ПериодРегистра
	               	|ПОМЕСТИТЬ Маркеры
	               	|ИЗ
	               	|	СписокПериодов КАК СписокПериодов
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ АктуальныйПериод КАК АктуальныйПериод
	               	|		ПО СписокПериодов.Период >= АктуальныйПериод.НачалоМесяца
	               	|
	               	|СГРУППИРОВАТЬ ПО
	               	|	СписокПериодов.Период,
	               	|	АктуальныйПериод.ЛицевойСчет,
	               	|	АктуальныйПериод.Услуга
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
					//Выбираем из регистра данные для каждого календарного месяца
					|	бит_СведенияПоУслугамЛС.Период КАК Период,
	               	|	бит_СведенияПоУслугамЛС.ЛицевойСчет КАК ЛицевойСчет,
	               	|	НАЧАЛОПЕРИОДА(бит_СведенияПоУслугамЛС.Период, МЕСЯЦ) КАК НачалоМесяца,
	               	|	бит_СведенияПоУслугамЛС.Услуга КАК Услуга,
	               	|	бит_СведенияПоУслугамЛС.СпособРасчета КАК СпособРасчета,
	               	|	бит_СведенияПоУслугамЛС.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления
	               	|ПОМЕСТИТЬ ВыборкаИзРегистраПолная
	               	|ИЗ
	               	|	РегистрСведений.бит_СведенияПоУслугамЛС КАК бит_СведенияПоУслугамЛС
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_УстановкаИзменениеУслугПоЛС КАК бит_УстановкаИзменениеУслугПоЛС
	               	|		ПО бит_СведенияПоУслугамЛС.Регистратор = бит_УстановкаИзменениеУслугПоЛС.Ссылка
	               	|ГДЕ
	               	|	бит_СведенияПоУслугамЛС.Активность = &Активность
	               	|	И бит_СведенияПоУслугамЛС.ЛицевойСчет В(&ЛицевойСчет)
	               	|	И бит_СведенияПоУслугамЛС.Услуга В(&Услуга)
	               	|	И бит_СведенияПоУслугамЛС.Использовать = &Использовать
	               	|	И бит_СведенияПоУслугамЛС.РежимПотребления <> &РежимПотребления
	               	|	И ТИПЗНАЧЕНИЯ(бит_СведенияПоУслугамЛС.Регистратор.Ссылка) = ТИП(бит_УстановкаИзменениеУслугПоЛС)
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
					//Делаем проверку на способ расчета, если способ расчета не в списке, то коэффициент ставим 0 иначе 1
					//Нужно чтобы исключить из расчета услуги с другим способ расчета, в расчете будем результат расчета умножать на коэффициент
	               	|	Маркеры.Период КАК Период,
	               	|	Маркеры.ЛицевойСчет КАК ЛицевойСчет,
	               	|	Маркеры.Услуга КАК Услуга,
	               	|	ВыборкаИзРегистраПолная.СпособРасчета КАК СпособРасчета,
	               	|	ВыборкаИзРегистраПолная.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления,
	               	|	ВЫБОР
	               	|		КОГДА ВыборкаИзРегистраПолная.СпособРасчета В (&СпособыРасчета)
	               	|			ТОГДА 1
	               	|		ИНАЧЕ 0
	               	|	КОНЕЦ КАК Коэффициент
	               	|ПОМЕСТИТЬ Коэффициенты
	               	|ИЗ
	               	|	Маркеры КАК Маркеры
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ ВыборкаИзРегистраПолная КАК ВыборкаИзРегистраПолная
	               	|		ПО Маркеры.ЛицевойСчет = ВыборкаИзРегистраПолная.ЛицевойСчет
	               	|			И Маркеры.Услуга = ВыборкаИзРегистраПолная.Услуга
	               	|			И Маркеры.ПериодРегистра = ВыборкаИзРегистраПолная.Период
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
					//Получаем список месяцев для выборки жилой/общей площади
	               	|	ТаблицаПериодов.Период КАК Период
	               	|ПОМЕСТИТЬ ВТ
	               	|ИЗ
	               	|	&ТаблицаПериодов КАК ТаблицаПериодов
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
					//Получаем комбинации Период+ЛС последние зарегистрированные в календарном месяце и сопоставляем их с таблицей периодов
	               	|	МАКСИМУМ(бит_СведенияОКвартире.Период) КАК Период,
	               	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	               	|	ВТ.Период КАК ПериодВТ
	               	|ПОМЕСТИТЬ ВТ1
	               	|ИЗ
	               	|	ВТ КАК ВТ
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	               	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире КАК бит_СведенияОКвартире
	               	|			ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартире.Квартира
	               	|		ПО (ВТ.Период >= бит_СведенияОКвартире.Период)
	               	|ГДЕ
	               	|	бит_ЛицевыеСчета.Ссылка В(&ЛицевойСчет)
	               	|
	               	|СГРУППИРОВАТЬ ПО
	               	|	бит_ЛицевыеСчета.Ссылка,
	               	|	ВТ.Период
	               	|;
	               	|
	               	|////////////////////////////////////////////////////////////////////////////////
	               	|ВЫБРАТЬ
					//Получаем Площади
					|	ВТ1.ЛицевойСчет КАК ЛицевойСчет,
	               	|	бит_СведенияОКвартире.ОбщаяПлощадь КАК ОБщаяПлощадь,
	               	|	бит_СведенияОКвартире.ЖилаяПлощадь КАК ЖилаяПлощадь,
	               	|	ВТ1.ПериодВТ КАК ПериодВТ,
	               	|	ВТ1.Период КАК Период,
	               	|	НАЧАЛОПЕРИОДА(ВТ1.ПериодВТ, МЕСЯЦ) КАК Поле1
	               	|ПОМЕСТИТЬ Площади
	               	|ИЗ
	               	|	ВТ1 КАК ВТ1
	               	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	               	|			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире КАК бит_СведенияОКвартире
	               	|			ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартире.Квартира
	               	|		ПО (бит_СведенияОКвартире.Период = ВТ1.Период)
	               	|			И (бит_ЛицевыеСчета.Ссылка = ВТ1.ЛицевойСчет)
	               	|ГДЕ
