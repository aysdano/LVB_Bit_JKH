&НаКлиенте
Функция ОткрытьФайл()
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Заголовок = "Данные из файла";
	ДиалогВыбораФайла.Фильтр    = "dBase (*.dbf)|*.dbf|";
	Если ДиалогВыбораФайла.Выбрать() Тогда
		
		ФайлНаДиске = Новый Файл(ДиалогВыбораФайла.ПолноеИмяФайла);
		Если нРег(ФайлНаДиске.Расширение) = ".dbf" Тогда
			Возврат ДиалогВыбораФайла.ПолноеИмяФайла
		КонецЕсли;

	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура ВыбратьФайл(Команда)
	Файл = ОткрытьФайл()	
КонецПроцедуры

&НаСервере
Функция ПрочитатьDBF(ИмяФайла)
	
	ВыбФайл = Новый Файл(ИмяФайла);
	Если НЕ ВыбФайл.Существует() Тогда
		ТекстСообщения = НСтр("ru = 'Файл не существует!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецЕсли;
	
	XBase  = Новый XBase;
	XBase.Кодировка = КодировкаXBase.OEM;
	Попытка
		XBase.ОткрытьФайл(ИмяФайла);
	Исключение
		ТекстСообщения = НСтр("ru = 'Ошибка открытия файла!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Ложь;
	КонецПопытки;
	
    ОписаниеБулево = Новый ОписаниеТипов("Булево");
    ОписаниеДаты = Новый ОписаниеТипов("Дата",,, Новый КвалификаторыДаты(ЧастиДаты.Дата));

    ТаблицаЗначений = Новый ТаблицаЗначений;
    Для Каждого Поле из XBase.Поля Цикл
        Если Поле.Тип = "L" Тогда
            Тип = ОписаниеБулево;
        ИначеЕсли Поле.Тип = "D" Тогда
            Тип = ОписаниеДаты;
        ИначеЕсли (Поле.Тип = "N") ИЛИ (Поле.Тип = "F") Тогда
            Тип = Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(Поле.Длина, Поле.Точность));
        Иначе
            Тип = Новый ОписаниеТипов("Строка",, Новый КвалификаторыСтроки(Поле.Длина));
        КонецЕсли;
        ТаблицаЗначений.Колонки.Добавить(Поле.Имя, Тип);
    КонецЦикла;
	
	//Проверка файла
	РезультатПроверки = ПроверитьDBF(ТаблицаЗначений.Колонки);
	Если Не РезультатПроверки Тогда
		ТекстСообщения = НСтр("ru = 'Структура файла не соотвествует требованиям!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;	
	
    Если (ТаблицаЗначений.Колонки.Количество() <> 0) И (XBase.Первая()) Тогда
        Пока Истина Цикл
            СтрокаТаб = ТаблицаЗначений.Добавить();
            Для Каждого Поле из XBase.Поля Цикл
                СтрокаТаб[Поле.Имя] = СокрЛП(XBase[Поле.Имя]);
            КонецЦикла;
			Если Не XBase.Следующая() Тогда 
				Прервать; 
			КонецЕсли;
        КонецЦикла;
    КонецЕсли;
	
    XBase.ЗакрытьФайл();
	
	ВременноеХранилищеDBFФайл = ПоместитьВоВременноеХранилище(ТаблицаЗначений, Новый УникальныйИдентификатор());	
	
    Возврат Истина
		
КонецФункции

&НаСервере
Функция ПроверитьDBF(Колонки)
	
	Массив = Новый Массив;
	Массив.Добавить("LIC");
	Массив.Добавить("TARIF");
	Массив.Добавить("NORM");
	Массив.Добавить("SAL_K");
	Массив.Добавить("S_PENI");
	Массив.Добавить("PENI");
	Массив.Добавить("CH");
	Массив.Добавить("N_SCHET");
	Массив.Добавить("D_POV");
	Массив.Добавить("N_POK");
	
	Для Каждого Колонка из Массив Цикл
		
		Поиск = Колонки.Найти(Колонка);
		
		Если Поиск = Неопределено Тогда
			Возврат Ложь
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Истина;     
	
КонецФункции

&НаСервере
Процедура ЗаполнитьПолеДокументДанныеГорГаза(Коррекция = Ложь)
		
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	лб_ДанныеГорГаза.Ссылка КАК Ссылка
	               |ИЗ
	               |	Документ.лб_ДанныеГорГаза КАК лб_ДанныеГорГаза
	               |ГДЕ
	               |	лб_ДанныеГорГаза.Дата Между &ДатаН И &ДатаК
	               |	И НЕ лб_ДанныеГорГаза.ПометкаУдаления
	               |	И лб_ДанныеГорГаза.Организация = &Организация";
	
	Запрос.УстановитьПараметр("ДатаК", КонецМесяца(Объект.Период));
	Запрос.УстановитьПараметр("ДатаН", НачалоМесяца(Объект.Период));
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Если Не Коррекция Тогда
			Объект.ДокументДанныеГоргаза = СоздатьПустойДокументДанныеГорГаза()
		Иначе
			ТекстСообщения = НСтр("ru = 'Данные ГорГаза за выбранный период не были загружены!'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат
		КонецЕсли;
	Иначе
		Выборка = Результат.Выбрать();
		Выборка.Следующий();
		Объект.ДокументДанныеГоргаза = Выборка.Ссылка;
		ОбъектДокумент = Объект.ДокументДанныеГоргаза.Ссылка.ПолучитьОбъект();
		ОбъектДокумент.Дата = КонецМесяца(Объект.Период);
		ОбъектДокумент.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументДанныеГоргаза.ДокументКоррекцииСальдо) и Не Коррекция Тогда
		ОбъектДокумент = Объект.ДокументДанныеГоргаза.Ссылка.ПолучитьОбъект();
		ОбъектДокумент.ДокументКоррекцииСальдо = СоздатьПустойДокументКоррекцииСальдо();
		ОбъектДокумент.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ДокументДанныеГоргаза.УстановкаИзменениеУслугЛС) и Не Коррекция Тогда
		ОбъектДокумент = Объект.ДокументДанныеГоргаза.Ссылка.ПолучитьОбъект();
		ОбъектДокумент.УстановкаИзменениеУслугЛС = СоздатьПустойДокументУстановкаИзменениеУслугПоЛС();
		ОбъектДокумент.Записать(РежимЗаписиДокумента.Запись);
	КонецЕсли;
	
	Объект.УстановкаИзменениеУслугЛС = Объект.ДокументДанныеГоргаза.УстановкаИзменениеУслугЛС;
	Объект.ДокументКоррекцииСальдо = Объект.ДокументДанныеГоргаза.ДокументКоррекцииСальдо;
	
КонецПроцедуры

Функция СоздатьПустойДокументДанныеГорГаза()

	Документ = Документы.лб_ДанныеГорГаза.СоздатьДокумент();
	Документ.Дата = КонецМесяца(Объект.Период);
	Документ.Организация = Объект.Организация;
	Документ.Услуга = Объект.Услуга;
	Документ.Поставщик = Объект.Поставщик;
	Документ.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат Документ.Ссылка;

КонецФункции // СоздатьПустойДокументДанныеГорГаза()

Функция СоздатьПустойДокументКоррекцииСальдо()

	Документ = Документы.бит_РазовыеПоУслугамЖКХ.СоздатьДокумент();
	Документ.Дата = КонецМесяца(Объект.Период);
	Документ.Организация = Объект.Организация;
	Документ.ВидОперации = Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое;
	Документ.Комментарий = "Коррекция изменений по данным горгаза!";
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат Документ.Ссылка;

КонецФункции // СоздатьПустойДокументКоррекцииСальдо()

Функция СоздатьПустойДокументУстановкаИзменениеУслугПоЛС()

	Документ = Документы.бит_УстановкаИзменениеУслугПоЛС.СоздатьДокумент();
	Документ.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета;
	Документ.Дата = НачалоМесяца(Объект.Период);
	Документ.Услуга = Объект.Услуга;
	Документ.Комментарий = "Коррекция изменений по данным горгаза!";
	Документ.Записать(РежимЗаписиДокумента.Проведение);
	
	Возврат Документ.Ссылка;

КонецФункции // СоздатьПустойДокументУстановкаИзменениеУслугПоЛС()

Процедура ЗаполнитьДокументУстановкаИзменениеУслугПоЛС()
	
	Если Не ЗначениеЗаполнено(Объект.УстановкаИзменениеУслугЛС) ИЛИ Не ЗначениеЗаполнено(Объект.Услуга) ИЛИ
		Не ЗначениеЗаполнено(Объект.ДокументДанныеГоргаза) ИЛИ Объект.ДокументДанныеГоргаза.ТЧ = 0 ИЛИ
		Не ЗначениеЗаполнено(Объект.Поставщик) Тогда
		Возврат
	КонецЕсли;
	
	ТЗизТЧ = Объект.ДокументДанныеГоргаза.ТЧ.Выгрузить();
	ДокументОбъект = Объект.УстановкаИзменениеУслугЛС.ПолучитьОбъект();
	ДокументОбъект.ЛицевыеСчета.Очистить();

		
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("ТЧ", ТЗизТЧ);
	Запрос.УстановитьПараметр("Услуга", Объект.Услуга);
	Запрос.УстановитьПараметр("Поставщик", Объект.Поставщик);
	Запрос.УстановитьПараметр("СпособРасчета", Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.Период));
	Запрос.Текст = "ВЫБРАТЬ
	               |	ТЧ.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления,
	               |	ТЧ.ЛицевойСчет КАК ЛицевойСчет,
	               |	ТЧ.Режим КАК РежимПотребления
	               |ПОМЕСТИТЬ ДанныеГорГаз
	               |ИЗ
	               |	&ТЧ КАК ТЧ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеГорГаз.ЛицевойСчет КАК ЛицевойСчет_ГГ,
	               |	&Услуга КАК Услуга_ГГ,
	               |	&Поставщик КАК Поставщик_ГГ,
	               |	&СпособРасчета КАК СпособРасчета_ГГ,
	               |	ДанныеГорГаз.РежимПотребления КАК РежимПотребления_ГГ,
	               |	ДанныеГорГаз.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления_ГГ
	               |ПОМЕСТИТЬ ДанныеГорГаз2
	               |ИЗ
	               |	ДанныеГорГаз КАК ДанныеГорГаз
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет_БД,
	               |	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга_БД,
	               |	бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик_БД,
	               |	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета_БД,
	               |	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления_БД,
	               |	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления КАК КоличествоЕдиницПотребления_БД
	               |ПОМЕСТИТЬ ДанныеРегистр
	               |ИЗ
	               |	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&НачалоПериода, Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеГорГаз2.ЛицевойСчет_ГГ КАК ЛицевойСчет_ГГ,
	               |	ДанныеГорГаз2.Услуга_ГГ КАК Услуга_ГГ,
	               |	ДанныеГорГаз2.СпособРасчета_ГГ КАК СпособРасчета_ГГ,
	               |	ВЫБОР
	               |		КОГДА ДанныеГорГаз2.Поставщик_ГГ <> ДанныеРегистр.Поставщик_БД
	               |				ИЛИ ДанныеГорГаз2.КоличествоЕдиницПотребления_ГГ <> ДанныеРегистр.КоличествоЕдиницПотребления_БД
	               |				ИЛИ ДанныеГорГаз2.РежимПотребления_ГГ <> ДанныеРегистр.РежимПотребления_БД
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК Изменен,
	               |	ДанныеГорГаз2.Поставщик_ГГ КАК Поставщик_ГГ,
	               |	ДанныеГорГаз2.РежимПотребления_ГГ КАК РежимПотребления_ГГ,
	               |	ДанныеГорГаз2.КоличествоЕдиницПотребления_ГГ КАК КоличествоЕдиницПотребления_ГГ
	               |ПОМЕСТИТЬ Финиш
	               |ИЗ
	               |	ДанныеГорГаз2 КАК ДанныеГорГаз2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ДанныеРегистр КАК ДанныеРегистр
	               |		ПО ДанныеГорГаз2.ЛицевойСчет_ГГ = ДанныеРегистр.ЛицевойСчет_БД
	               |			И ДанныеГорГаз2.Услуга_ГГ = ДанныеРегистр.Услуга_БД
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	Финиш.ЛицевойСчет_ГГ КАК ЛицевойСчет,
	               |	Финиш.Услуга_ГГ КАК Услуга,
	               |	Финиш.СпособРасчета_ГГ КАК СпособРасчета,
	               |	Финиш.Поставщик_ГГ КАК Поставщик,
	               |	Финиш.РежимПотребления_ГГ КАК РежимПотребления,
	               |	Финиш.КоличествоЕдиницПотребления_ГГ КАК КоличествоЕдиницПотребления
	               |ИЗ
	               |	Финиш КАК Финиш
	               |ГДЕ
	               |	Финиш.Изменен";
	
	
	ДокументОбъект.ЛицевыеСчета.Загрузить(Запрос.Выполнить().Выгрузить());
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);	

КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьФайл(Команда)
	ЗагрузитьФайлНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗагрузитьФайлНаСервере()
	
	Массив = Новый Массив;
	Массив.Добавить("Период");
	Массив.Добавить("Услуга");
	Массив.Добавить("Поставщик");
	Массив.Добавить("Организация");
	Массив.Добавить("РежимДляСчетчиков");
	Массив.Добавить("РежимДляНормативаПоУмолчанию");
	Массив.Добавить("РежимДляНорматива2");
	Массив.Добавить("РазмерНорматива2");
	Массив.Добавить("РежимДляНорматива3");
	Массив.Добавить("РазмерНорматива3");
	Массив.Добавить("РежимНеНачислять");
	
	Для Каждого Реквизит ИЗ Массив Цикл
		Если Не ЗначениеЗаполнено(Объект[Реквизит]) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Реквизит);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			//Возврат
		КонецЕсли;
	КонецЦикла;
	
	РезультатРаботы = ПрочитатьDBF(Файл);
	
	ТаблицаЗначений = Неопределено;
	
	Если РезультатРаботы Тогда
		ТаблицаЗначений = ПолучитьИзВременногоХранилища(ВременноеХранилищеDBFФайл);
	КонецЕсли;
	
	Если ТипЗнч(ТаблицаЗначений) <> Тип("ТаблицаЗначений") Тогда
		Возврат
	КонецЕсли;
	
	Запрос = ДополнитьДанныеГорГаза(ТаблицаЗначений);
	
	ЗаполнитьПолеДокументДанныеГорГаза();
	
	ДокументДанныеГорГаз = Объект.ДокументДанныеГоргаза.ПолучитьОбъект();
	ДокументДанныеГорГаз.ТЧ.Загрузить(Запрос[9].Выгрузить());
	ДокументДанныеГорГаз.Записать(РежимЗаписиДокумента.Запись);
	
	ЗаполнитьДокументУстановкаИзменениеУслугПоЛС();
	
	ВывестиНеНайденныеЛС(Запрос[8].Выгрузить());
	
КонецПроцедуры

Процедура ВывестиНеНайденныеЛС(ТаблицаЗначений)
	
	Если ТаблицаЗначений.Количество() = 0 Тогда
		Возврат
	Иначе
		Для Каждого Строка Из ТаблицаЗначений Цикл
			ТекстСообщения = НСтр("ru = 'Не найден лицевой счет - %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Строка.LIC);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЦикла;
	КонецЕсли;

КонецПроцедуры

Функция ДополнитьДанныеГорГаза(ТаблицаЗначений)
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	               |	ВЫБОР
	               |		КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.НеПроживает)
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК СтатусПроживания,
	               |	ВЫБОР
	               |		КОГДА бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ВладелецКвартиры,
	               |	ВЫБОР
	               |		КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПроживаниеВДанныйМомент
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ПроживаниеВДанныйМомент
	               |ПОМЕСТИТЬ бит_ПроживающиеПоЛС_1
	               |ИЗ
	               |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&КонецПериода, ) КАК бит_ПроживающиеПоЛССрезПоследних
	               |		ПО бит_ЛицевыеСчета.Ссылка = бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	бит_ПроживающиеПоЛС_1.ЛицевойСчет КАК ЛицевойСчет,
	               |	СУММА(бит_ПроживающиеПоЛС_1.СтатусПроживания) КАК ЧислаПроживающих,
	               |	СУММА(бит_ПроживающиеПоЛС_1.ВладелецКвартиры) КАК Владелецы,
	               |	СУММА(бит_ПроживающиеПоЛС_1.ПроживаниеВДанныйМомент) КАК ПроживанющиеВДанныйМомент
	               |ПОМЕСТИТЬ бит_ПроживающиеПоЛС_2
	               |ИЗ
	               |	бит_ПроживающиеПоЛС_1 КАК бит_ПроживающиеПоЛС_1
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	бит_ПроживающиеПоЛС_1.ЛицевойСчет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	бит_ПроживающиеПоЛС_2.ЛицевойСчет КАК ЛицевойСчет,
	               |	ВЫБОР
	               |		КОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих > бит_ПроживающиеПоЛС_2.Владелецы
	               |			ТОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих
	               |		КОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих < бит_ПроживающиеПоЛС_2.Владелецы
	               |			ТОГДА бит_ПроживающиеПоЛС_2.Владелецы
	               |		КОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих = бит_ПроживающиеПоЛС_2.Владелецы
	               |			ТОГДА бит_ПроживающиеПоЛС_2.Владелецы
	               |		КОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих = 0
	               |				И бит_ПроживающиеПоЛС_2.Владелецы = 0
	               |			ТОГДА бит_ПроживающиеПоЛС_2.ПроживанющиеВДанныйМомент
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ЧислоЕдиницПотребления
	               |ПОМЕСТИТЬ ПроживающиеПоЛС
	               |ИЗ
	               |	бит_ПроживающиеПоЛС_2 КАК бит_ПроживающиеПоЛС_2
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеИзФайла.LIC КАК LIC,
	               |	ДанныеИзФайла.TARIF КАК TARIF,
	               |	ДанныеИзФайла.NORM КАК NORM,
	               |	ДанныеИзФайла.SAL_K КАК SAL_K,
	               |	ДанныеИзФайла.S_PENI КАК S_PENI,
	               |	ДанныеИзФайла.PENI КАК PENI,
	               |	ДанныеИзФайла.CH КАК CH,
	               |	ДанныеИзФайла.N_SCHET КАК N_SCHET,
	               |	ДанныеИзФайла.D_POV КАК D_POV,
	               |	ДанныеИзФайла.N_POK КАК N_POK
	               |ПОМЕСТИТЬ ДанныеИзФайла
	               |ИЗ
	               |	&ДанныеИзФайла КАК ДанныеИзФайла
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеИзФайла.LIC КАК LIC,
	               |	ДанныеИзФайла.TARIF КАК TARIF,
	               |	ДанныеИзФайла.NORM КАК NORM,
	               |	ДанныеИзФайла.SAL_K КАК SAL_K,
	               |	ДанныеИзФайла.CH КАК CH,
	               |	ДанныеИзФайла.N_SCHET КАК N_SCHET,
	               |	ДанныеИзФайла.D_POV КАК D_POV,
	               |	ДанныеИзФайла.N_POK КАК N_POK,
	               |	ВЫБОР
	               |		КОГДА ДанныеИзФайла.TARIF = 0
	               |			ТОГДА &РежимНеНачислять
	               |		КОГДА ДанныеИзФайла.CH = 1
	               |			ТОГДА &РежимПоСчетчикамГорГаз
	               |		КОГДА ДанныеИзФайла.CH = 0
	               |			ТОГДА ВЫБОР
	               |					КОГДА &ПроверятьРежим2
	               |							И ДанныеИзФайла.NORM = &РазмерРежим2
	               |						ТОГДА &РежимПоНормамГорГаз2
	               |					КОГДА &ПроверятьРежим3
	               |							И ДанныеИзФайла.NORM = &РазмерРежим3
	               |						ТОГДА &РежимПоНормамГорГаз3
	               |					ИНАЧЕ &РежимПоНормамГорГаз
	               |				КОНЕЦ
	               |	КОНЕЦ КАК РежимПотребления,
	               |	ВЫБОР
	               |		КОГДА ДанныеИзФайла.CH = 1
	               |			ТОГДА ИСТИНА
	               |		ИНАЧЕ ЛОЖЬ
	               |	КОНЕЦ КАК НаличиеСчетчика
	               |ПОМЕСТИТЬ ДанныеИзФайла2
	               |ИЗ
	               |	ДанныеИзФайла КАК ДанныеИзФайла
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	бит_ЛицевыеСчета.Ссылка КАК Ссылка,
	               |	бит_ЛицевыеСчета.Наименование КАК Наименование
	               |ПОМЕСТИТЬ ВсеЛС
	               |ИЗ
	               |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ВсеЛС.Ссылка.Здание КАК Здание,
	               |	ВсеЛС.Ссылка КАК ЛицевойСчет,
	               |	ДанныеИзФайла2.TARIF КАК Тариф,
	               |	ДанныеИзФайла2.NORM КАК Норматив,
	               |	ДанныеИзФайла2.SAL_K КАК Сальдо,
	               |	ДанныеИзФайла2.НаличиеСчетчика КАК НаличиеСчетчика,
	               |	ДанныеИзФайла2.N_SCHET КАК НомерСчетчика,
	               |	ДанныеИзФайла2.D_POV КАК ДатаПоверки,
	               |	ДанныеИзФайла2.N_POK КАК ТекПоказание,
	               |	ДанныеИзФайла2.РежимПотребления КАК Режим,
	               |	ДанныеИзФайла2.LIC КАК LIC
	               |ПОМЕСТИТЬ ДанныеИзФайла3
	               |ИЗ
	               |	ДанныеИзФайла2 КАК ДанныеИзФайла2
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВсеЛС КАК ВсеЛС
	               |		ПО ДанныеИзФайла2.LIC = ВсеЛС.Наименование
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ДанныеИзФайла3.Здание КАК Здание,
	               |	ДанныеИзФайла3.ЛицевойСчет КАК ЛицевойСчет,
	               |	ДанныеИзФайла3.Тариф КАК Тариф,
	               |	ДанныеИзФайла3.Норматив КАК Норматив,
	               |	ДанныеИзФайла3.Сальдо КАК Сальдо,
	               |	ДанныеИзФайла3.НаличиеСчетчика КАК НаличиеСчетчика,
	               |	ДанныеИзФайла3.НомерСчетчика КАК НомерСчетчика,
	               |	ДанныеИзФайла3.ДатаПоверки КАК ДатаПоверки,
	               |	ДанныеИзФайла3.ТекПоказание КАК ТекПоказание,
	               |	ДанныеИзФайла3.Режим КАК Режим,
	               |	ПроживающиеПоЛС.ЧислоЕдиницПотребления КАК ЧислоЕдиницПотребления,
	               |	ДанныеИзФайла3.LIC КАК LIC
	               |ПОМЕСТИТЬ ФинишДляФильтра
	               |ИЗ
	               |	ДанныеИзФайла3 КАК ДанныеИзФайла3
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ПроживающиеПоЛС КАК ПроживающиеПоЛС
	               |		ПО ДанныеИзФайла3.ЛицевойСчет = ПроживающиеПоЛС.ЛицевойСчет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ФинишДляФильтра.LIC КАК LIC
	               |ИЗ
	               |	ФинишДляФильтра КАК ФинишДляФильтра
	               |ГДЕ
	               |	ФинишДляФильтра.ЛицевойСчет = ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	ФинишДляФильтра.Здание КАК Здание,
	               |	ФинишДляФильтра.ЛицевойСчет КАК ЛицевойСчет,
	               |	ФинишДляФильтра.Тариф КАК Тариф,
	               |	ФинишДляФильтра.Норматив КАК Норматив,
	               |	ФинишДляФильтра.Сальдо КАК Сальдо,
	               |	ФинишДляФильтра.НаличиеСчетчика КАК НаличиеСчетчика,
	               |	ФинишДляФильтра.НомерСчетчика КАК НомерСчетчика,
	               |	ФинишДляФильтра.ДатаПоверки КАК ДатаПоверки,
	               |	ФинишДляФильтра.ТекПоказание КАК ТекПоказание,
	               |	ФинишДляФильтра.Режим КАК Режим,
	               |	ФинишДляФильтра.ЧислоЕдиницПотребления КАК КоличествоЕдиницПотребления
	               |ИЗ
	               |	ФинишДляФильтра КАК ФинишДляФильтра
	               |ГДЕ
	               |	ФинишДляФильтра.ЛицевойСчет <> ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)";
				   
	Запрос.УстановитьПараметр("ДанныеИзФайла", ТаблицаЗначений);
	Запрос.УстановитьПараметр("РежимНеНачислять", Объект.РежимНеНачислять);
	Запрос.УстановитьПараметр("РазмерРежим2", Объект.РазмерНорматива2);
	Запрос.УстановитьПараметр("РазмерРежим3", Объект.РазмерНорматива3);
	Запрос.УстановитьПараметр("РежимПоНормамГорГаз2", Объект.РежимДляНорматива2);
	Запрос.УстановитьПараметр("РежимПоНормамГорГаз3", Объект.РежимДляНорматива3);
	Запрос.УстановитьПараметр("РежимПоСчетчикамГорГаз", Объект.РежимДляСчетчиков);
	Запрос.УстановитьПараметр("РежимПоНормамГорГаз", Объект.РежимДляНормативаПоУмолчанию);
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.Период));
	
	Если ЗначениеЗаполнено(Объект.РежимДляНорматива2) И Объект.РазмерНорматива2 <> 0 Тогда
		Запрос.УстановитьПараметр("ПроверятьРежим2", Истина);
	Иначе
		Запрос.УстановитьПараметр("ПроверятьРежим2", Ложь);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.РежимДляНорматива3) И Объект.РазмерНорматива3 <> 0 Тогда
		Запрос.УстановитьПараметр("ПроверятьРежим3", Истина);
	Иначе
		Запрос.УстановитьПараметр("ПроверятьРежим3", Ложь);
	КонецЕсли;

	Возврат Запрос.ВыполнитьПакет(); 	

КонецФункции

&НаСервере
Процедура ОбновитьНаСервере()
	
	Массив = Новый Массив;
	Массив.Добавить("Период");
	Массив.Добавить("Услуга");
	Массив.Добавить("Поставщик");
	Массив.Добавить("Организация");
	Массив.Добавить("РежимДляСчетчиков");
	Массив.Добавить("РежимДляНормативаПоУмолчанию");
	Массив.Добавить("РежимДляНорматива2");
	Массив.Добавить("РазмерНорматива2");
	Массив.Добавить("РежимДляНорматива3");
	Массив.Добавить("РазмерНорматива3");
	Массив.Добавить("РежимНеНачислять");
	
	Для Каждого Реквизит ИЗ Массив Цикл
		Если Не ЗначениеЗаполнено(Объект[Реквизит]) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Реквизит);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			//Возврат
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьПолеДокументДанныеГорГаза();
	
	Если Не ЗначениеЗаполнено(Объект.УстановкаИзменениеУслугЛС) Тогда
		Возврат
	КонецЕсли;
	
	ДокументОбъект = Объект.УстановкаИзменениеУслугЛС.ПолучитьОбъект();
	ДокументОбъект.ЛицевыеСчета.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.МенеджерВременныхТаблиц = Новый МенеджерВременныхТаблиц;
	Запрос.УстановитьПараметр("РежимПотребления", Объект.РежимДляНормативаПоУмолчанию);
	Запрос.УстановитьПараметр("Услуга", Объект.Услуга);
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	               |	ВЫБОР
	               |		КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.НеПроживает)
	               |			ТОГДА 0
	               |		ИНАЧЕ 1
	               |	КОНЕЦ КАК СтатусПроживания,
	               |	ВЫБОР
	               |		КОГДА бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ВладелецКвартиры,
	               |	ВЫБОР
	               |		КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПроживаниеВДанныйМомент
	               |			ТОГДА 1
	               |		ИНАЧЕ 0
	               |	КОНЕЦ КАК ПроживаниеВДанныйМомент
	               |ПОМЕСТИТЬ бит_ПроживающиеПоЛС_1
	               |ИЗ
	               |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(, ) КАК бит_ПроживающиеПоЛССрезПоследних
	               |		ПО бит_ЛицевыеСчета.Ссылка = бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Ссылка
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	бит_ПроживающиеПоЛС_1.ЛицевойСчет КАК ЛицевойСчет,
	               |	СУММА(бит_ПроживающиеПоЛС_1.СтатусПроживания) КАК ЧислаПроживающих,
	               |	СУММА(бит_ПроживающиеПоЛС_1.ВладелецКвартиры) КАК Владелецы,
	               |	СУММА(бит_ПроживающиеПоЛС_1.ПроживаниеВДанныйМомент) КАК ПроживанющиеВДанныйМомент
	               |ПОМЕСТИТЬ бит_ПроживающиеПоЛС_2
	               |ИЗ
	               |	бит_ПроживающиеПоЛС_1 КАК бит_ПроживающиеПоЛС_1
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	бит_ПроживающиеПоЛС_1.ЛицевойСчет
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	бит_ПроживающиеПоЛС_2.ЛицевойСчет КАК ЛицевойСчет,
