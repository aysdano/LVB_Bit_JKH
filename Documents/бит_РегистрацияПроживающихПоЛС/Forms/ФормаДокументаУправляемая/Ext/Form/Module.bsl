&НаКлиенте
Процедура СписокПроживающихСтатусПроживанияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокПеречисления = Новый СписокЗначений;
	
	ТекущиеДанные = Элементы.СписокПроживающих.ТекущиеДанные;
	
	ПроживаниеВДанныйМомент = ПроживаниеВДанныйМоментНаСервере(ТекущиеДанные.СтатусФизЛица);
	
	Если ПроживаниеВДанныйМомент Тогда
		
		СписокПеречисления.Добавить(ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Временно"));
		СписокПеречисления.Добавить(ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Постоянно"));
		
		ВыбранныйЭлемент = Неопределено;
		
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("СписокПроживающихСтатусПроживанияНачалоВыбораЗавершение1", ЭтотОбъект, Новый Структура("ПроживаниеВДанныйМомент, СписокПеречисления, ТекущиеДанные", ПроживаниеВДанныйМомент, СписокПеречисления, ТекущиеДанные)), СписокПеречисления, Элементы.СписокПроживающихСтатусПроживания);
		Возврат;
		
	ИначеЕсли Не ПроживаниеВДанныйМомент Тогда
		
		СписокПеречисления.Добавить(ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Временно"));
		СписокПеречисления.Добавить(ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.Постоянно"));
		СписокПеречисления.Добавить(ПредопределенноеЗначение("Перечисление.бит_СтатусПроживания.НеПроживает"));
		
		ПоказатьВыборИзСписка(Новый ОписаниеОповещения("СписокПроживающихСтатусПроживанияНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("ТекущиеДанные", ТекущиеДанные)), СписокПеречисления, Элементы.СписокПроживающихСтатусПроживания);
		Возврат;
		
	КонецЕсли;	
	
	СписокПроживающихСтатусПроживанияНачалоВыбораФрагмент1(ВыбранныйЭлемент, ТекущиеДанные);
КонецПроцедуры

