&НаСервере
Процедура СформироватьАктРеализациюРазовые()
	
	тмпТаблицаУслуг = Новый ТаблицаЗначений;
	тмпТаблицаУслуг.Колонки.Добавить("Контрагент"              , Новый ОписаниеТипов("СправочникСсылка.Контрагенты"));
	тмпТаблицаУслуг.Колонки.Добавить("Номенклатура"            , Новый ОписаниеТипов("СправочникСсылка.Номенклатура"));
	тмпТаблицаУслуг.Колонки.Добавить("Количество"              , ОбщегоНазначения.ОписаниеТипаЧисло(15,3));
	тмпТаблицаУслуг.Колонки.Добавить("Цена"                    , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	тмпТаблицаУслуг.Колонки.Добавить("Сумма"                   , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	тмпТаблицаУслуг.Колонки.Добавить("СтавкаНДС"               , Новый ОписаниеТипов("ПеречислениеСсылка.СтавкиНДС"));
	тмпТаблицаУслуг.Колонки.Добавить("СуммаНДС"                , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	тмпТаблицаУслуг.Колонки.Добавить("НоменклатурнаяГруппа"    , Новый ОписаниеТипов("СправочникСсылка.НоменклатурныеГруппы"));
	тмпТаблицаУслуг.Колонки.Добавить("СчетУчетаНДСПоРеализации", Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	тмпТаблицаУслуг.Колонки.Добавить("ПлановаяСтоимость"       , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	тмпТаблицаУслуг.Колонки.Добавить("СуммаПлановая"           , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	тмпТаблицаУслуг.Колонки.Добавить("СчетДоходов"             , Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	тмпТаблицаУслуг.Колонки.Добавить("СчетРасходов"            , Новый ОписаниеТипов("ПланСчетовСсылка.Хозрасчетный"));
	тмпТаблицаУслуг.Колонки.Добавить("ДоговорКонтрагента"      , Новый ОписаниеТипов("СправочникСсылка.ДоговорыКонтрагентов"));
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Документ");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЛицевойСчет");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Услуга");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Контрагент");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СчетАбонента");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Субконто1");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Субконто2");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Субконто3");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СчетКУ");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СубконтоКУ1");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СубконтоКУ2");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СубконтоКУ3");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Начислено");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДоговорКонтрагента");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(Объект.ДатаЗакрытия));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "УчетСобственныхУслугРазовые";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	ВыборкаДокумент = СтруктураРезультата.РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Выборка = ВыборкаДокумент.Выбрать();
	
	Пока ВыборкаДокумент.Следующий() Цикл
		
		тмпТаблицаУслуг.Очистить();
		
		Основание = ВыборкаДокумент.Документ;
		
		ТаблицаУслугВЦикле(тмпТаблицаУслуг,ВыборкаДокумент);		
		Пока ВыборкаДокумент.Следующий() Цикл
			ТаблицаУслугВЦикле(тмпТаблицаУслуг,ВыборкаДокумент);
		КонецЦикла; 
		
		ТаблицаУслуг = тмпТаблицаУслуг.Скопировать();
		
		Если мКэшЗначений.ФормироватьАктИРеализациюПоКонтрагенту И НЕ мКэшЗначений.ФормироватьАктИРеализациюПоКонтрагентуОтветственныхЛиц Тогда
			ТаблицаУслуг.Свернуть("Номенклатура,
			|СтавкаНДС, 
			|НоменклатурнаяГруппа, 
			|СчетУчетаНДСПоРеализации,
			|СчетДоходов,
			|СчетРасходов",
			"Цена,
			|Сумма,
			|СуммаНДС,
			|ПлановаяСтоимость,
			|СуммаПлановая");
			
			Если ТаблицаУслуг.Количество() = 0 Тогда
				
				Продолжить;
				
			КонецЕсли; 
			
			Контрагент         = мКэшЗначений.Контрагент;
			ОсновнойДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
			МассивВидовДоговоров = Новый Массив;
			МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
			РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ОсновнойДоговорКонтрагента,Контрагент,Объект.Организация,МассивВидовДоговоров);
			Если ЗначениеЗаполнено(ВыборкаДокумент.ДоговорКонтрагента) Тогда
				ДоговорКонтрагента = ВыборкаДокумент.ДоговорКонтрагента;
			Иначе	
				ДоговорКонтрагента = ОсновнойДоговорКонтрагента;
			КонецЕсли;
			
			// БИТ_ЖКХ 23.10.2017 11:35:36 Конец правки. 
			//СоздатьДокументРеализации(Контрагент, ДоговорКонтрагента, Основание, ТаблицаУслуг);
			СоздатьДокументРеализации(Контрагент, ДоговорКонтрагента, Основание, ТаблицаУслуг,,);
			// БИТ_ЖКХ 23.10.2017 11:35:37 Конец правки. 
			
