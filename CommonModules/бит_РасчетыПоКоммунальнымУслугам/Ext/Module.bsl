	|	ТаблицаНорм.ТарифДо,
	|	ТаблицаНорм.ПредельныйИндекс,
	|	ТаблицаНорм.НачислятьПредельныйИндекс,
	|	ТаблицаНорм.ПериодСравнения,
	|	ТаблицаНорм.ГруппаУслуги,
	|	ТаблицаНорм.МойПоставщик,
	|	ТаблицаНорм.ЕдИзм,
	// БИТ_ЖКХ_23082013_окончание_изменений
	|	ЕСТЬNULL(ПоказанияСчетчиковИнд.ОтПоказаний, 0) КАК ОтПоказаний,
	|	ЕСТЬNULL(ПоказанияСчетчиковИнд.ДоПоказаний, 0) КАК ДоПоказаний,
	|	ЕСТЬNULL(ПоказанияСчетчиковИнд.КоличествоЕдиниц, 0) КАК КоличествоЕдиниц,
	|	ПоказанияСчетчиковИнд.Счетчик КАК Счетчик,
	|	ПоказанияСчетчиковИнд.ИсточникПоказаний,
	|	ЕСТЬNULL(ПоказанияСчетчиковИнд.КоличествоЕдиниц, 0) КАК Факт,
	|	ЕСТЬNULL(ПоказанияСчетчиковИнд.КоличествоЕдиниц, 0) КАК КоличествоЕдиницПоЛС,
	|	ПоказанияСчетчиковИнд.ЛицевойСчет КАК ВладелецСчетчика,
	|	ЕСТЬNULL(ТаблицаНорм.Норма, 0) КАК Норма,
	|	ПоказанияСчетчиковИнд.Многотарифный КАК Многотарифный,
	|	ЕСТЬNULL(ТаблицаНорм.Норма, 0) - ЕСТЬNULL(ПоказанияСчетчиковИнд.КоличествоЕдиниц, 0) КАК Разница,
	|	ЕСТЬNULL(ТаблицаНорм.Тариф,0) КАК Тариф
	|ИЗ
	|	ТаблицаНорм КАК ТаблицаНорм
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ПоказанияСчетчиковИнд КАК ПоказанияСчетчиковИнд
	|		ПО ТаблицаНорм.ЛицевойСчет = ПоказанияСчетчиковИнд.ЛицевойСчет
	|			И ТаблицаНорм.Услуга = ПоказанияСчетчиковИнд.Услуга
	|ГДЕ
	|	ТаблицаНорм.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)
	|	И НЕ ПоказанияСчетчиковИнд.Многотарифный
	|
	|УПОРЯДОЧИТЬ ПО
	|	КоличествоЕдиниц УБЫВ
	|ИТОГИ
	|	МАКСИМУМ(Ставка),
	|	МАКСИМУМ(СверхномСтавка),
	|	МАКСИМУМ(ПлановаяСтавка),
	// БИТ_ЖКХ_23082013_начало_изменений
	|	МАКСИМУМ(СтавкаДо),
	|	МАКСИМУМ(СверхномСтавкаДо),
	|	МАКСИМУМ(ПлановаяСтавкаДо),
	// БИТ_ЖКХ_23082013_окончание_изменений
	|	СУММА(КоличествоЕдиниц),
	|	МАКСИМУМ(Норма)
	|ПО
	|	ЛицевойСчет,
	|	Услуга";
	
	Результат = Запрос.ВыполнитьПакет(); 
	
	// Многотарифные счетчики.
	ВыборкаСЧ = Результат[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	тмпТаблица = ТаблицаСчетчиков.СкопироватьКолонки();
	
	Пока ВыборкаСЧ.Следующий() Цикл
		
		тмпТаблица.Очистить();
		
		Выборка = ВыборкаСЧ.Выбрать();
		
		КолУслуг       = ВыборкаСЧ.КолУслуг;
		ДобавитьКНорме = 0;
		КолУслугИсп    = 0;
		
		// Получаем Добавочную норму.
		Пока Выборка.Следующий() Цикл
			
			НоваяСтрока = тмпТаблица.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
			Если РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика Тогда
				
				Разница = (Выборка.Норма + ДобавитьКНорме) - Выборка.Факт;
				
				Если Разница > 0 Тогда
					
					тмпКолУслуг = (КолУслуг - 1 - КолУслугИсп);
					
					ДобавитьКНорме = ДобавитьКНорме + Разница / ?(тмпКолУслуг <= 0, 1, тмпКолУслуг);
					КолУслугИсп  = КолУслугИсп + 1;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		// Определяем остаток нормы и сумируем с добавочной.
		Если РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика Тогда
			
			Остаток = 0;
			
			тмпДобавитьКНорме = Число(ДобавитьКНорме);
			
			Выборка.Сбросить();
			
			Пока Выборка.Следующий() Цикл
				
				Если Выборка.Разница < 0 Тогда
					
					тмпОстаток = тмпДобавитьКНорме + Выборка.Разница;
					
					Если тмпОстаток > 0 Тогда
						КолУслуг = КолУслуг - 1;
						Остаток = Остаток + тмпОстаток;
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Если КолУслуг > 0 Тогда
				
				ДобавитьКНорме = ДобавитьКНорме + (Остаток/КолУслуг);
				
			КонецЕсли; 
			
		КонецЕсли;
		
		// Вычесляем начисления.
		Для каждого СтрокаТаблицы Из тмпТаблица Цикл
			
			НоваяСтрока = ТаблицаСчетчиков.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
			
			// БИТ_ЖКХ_04102013_начало_изменений
			// Норма        = Мин(СтрокаТаблицы.Норма + ДобавитьКНорме, СтрокаТаблицы.КоличествоЕдиниц);.
			Если РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика Тогда
				
				СуммаНорма = 0;
				СуммаФакт  = 0;
				СуммаНорма = тмпТаблица.Итог("Норма");
				СуммаФакт  = тмпТаблица.Итог("КоличествоЕдиниц");
				
				Если (СуммаФакт = 0) ИЛИ (СуммаФакт = Неопределено) Тогда
					
					Норма = 0;
					
				Иначе
					
					Норма = СтрокаТаблицы.КоличествоЕдиниц*СуммаНорма/СуммаФакт;
					
					// БИТ_ЖКХ_21102013_начало_изменений
					Если Норма > СтрокаТаблицы.КоличествоЕдиниц Тогда
						
						Норма = СтрокаТаблицы.КоличествоЕдиниц;
						
					КонецЕсли;
					// БИТ_ЖКХ_21102013_окончание_изменений
					
				КонецЕсли;
				
			Иначе
				
				Норма = Мин(СтрокаТаблицы.Норма + ДобавитьКНорме, СтрокаТаблицы.КоличествоЕдиниц);
				
			КонецЕсли;
			// БИТ_ЖКХ_04102013_окончание_изменений
			
			СверхНорма = ?(СтрокаТаблицы.КоличествоЕдиниц > Норма, СтрокаТаблицы.КоличествоЕдиниц - Норма, 0);
			Начислено  = Норма * СтрокаТаблицы.Ставка + СверхНорма * СтрокаТаблицы.СверхномСтавка;
			
			// БИТ_ЖКХ_23082013_начало_изменений
			НачисленоДо  = Норма * СтрокаТаблицы.СтавкаДо + СверхНорма * СтрокаТаблицы.СверхномСтавкаДо;
			// БИТ_ЖКХ_23082013_окончание_изменений
			
			НоваяСтрока.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам;
			НоваяСтрока.Норма         = Норма;
			НоваяСтрока.СверхНорма    = СверхНорма;
			НоваяСтрока.Начислено     = Начислено;
			НоваяСтрока.Многотарифный = Истина;
			
			// БИТ_ЖКХ_23082013_начало_изменений
			НоваяСтрока.НачисленоДо   = НачисленоДо;
			НоваяСтрока.ОбъемДо       = 0;
			// БИТ_ЖКХ_23082013_окончание_изменений
			
			Если НЕ СтрокаТаблицы.Тариф = 0 Тогда
				// БИТ_ЖКХ 02.03.2017 16:24:11 Начало правки...
				//НоваяСтрока.Объем = Окр(Начислено/СтрокаТаблицы.Тариф,4);
				Если РасчетОбъемовДоТретьегоЗнака Тогда
					НоваяСтрока.Объем = Окр(Начислено/СтрокаТаблицы.Тариф,3);
				Иначе
					НоваяСтрока.Объем = Окр(Начислено/СтрокаТаблицы.Тариф,4);
				КонецЕсли;
				// БИТ_ЖКХ 02.03.2017 16:24:11 Конец правки.
			КонецЕсли; 
			
			// БИТ_ЖКХ_28082013_начало_изменений
			Если НЕ СтрокаТаблицы.ТарифДо = 0 Тогда
				НоваяСтрока.ОбъемДо = Окр(НачисленоДо/СтрокаТаблицы.ТарифДо,4);
			КонецЕсли; 
			// БИТ_ЖКХ_28082013_окончание_изменений
			
		КонецЦикла;
		
	КонецЦикла;
	
	// Однотарифные счетчики.
	ВыборкаЛС = Результат[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		ВыборкаУС = ВыборкаЛС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
		
		Пока ВыборкаУС.Следующий() Цикл
			
			Выборка = ВыборкаУС.Выбрать();
			
			Норма          = ВыборкаУС.Норма;
			Ставка         = ВыборкаУС.Ставка;
			СверхномСтавка = ВыборкаУС.СверхномСтавка;
			
			// БИТ_ЖКХ_26082013_начало_изменений
			СтавкаДо         = ВыборкаУС.СтавкаДо;
			СверхномСтавкаДо = ВыборкаУС.СверхномСтавкаДо;
			// БИТ_ЖКХ_26082013_окончание_изменений
			
			Итого = 0;
			
			СуммаПроверки  =  ВыборкаУС.КоличествоЕдиниц * Ставка;
			
			Пока Выборка.Следующий() Цикл
				
				НоваяСтрока = ТаблицаСчетчиков.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				
				// БИТ_ЖКХ_26082013_начало_изменений
				Если Выборка.КоличествоЕдиниц <= Норма Тогда
					расчНорма  = Выборка.КоличествоЕдиниц;
					СверхНорма = 0;
				Иначе
					расчНорма  = Норма;
					СверхНорма = Выборка.КоличествоЕдиниц - Норма;
				КонецЕсли;
				Норма = Норма - расчНорма;
				// БИТ_ЖКХ_26082013_окончание_изменений
				Начислено  = расчНорма * Ставка + СверхНорма * СверхномСтавка;
				
				НоваяСтрока.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам;
				НоваяСтрока.Норма         = расчНорма;// Норма; Исправлена ошибка норма = 0 для однотарифного счетчика akozlov 04/07/2013.
				НоваяСтрока.СверхНорма    = СверхНорма;
				НоваяСтрока.Начислено     = Начислено;
				
				// БИТ_ЖКХ_26082013_начало_изменений
				НоваяСтрока.НачисленоДо   = расчНорма * СтавкаДо + СверхНорма * СверхномСтавкаДо;
				// БИТ_ЖКХ_26082013_окончание_изменений
				
				Если НЕ Выборка.Тариф = 0 Тогда
					// БИТ_ЖКХ 02.03.2017 14:51:04 Начало правки...
					//НоваяСтрока.Объем = Окр(Начислено/Выборка.Тариф,4); 
					Если РасчетОбъемовДоТретьегоЗнака Тогда
						НоваяСтрока.Объем = Окр(Начислено/Выборка.Тариф,3); 
					Иначе
						НоваяСтрока.Объем = Окр(Начислено/Выборка.Тариф,4); 
					КонецЕсли;
					// БИТ_ЖКХ 02.03.2017 14:51:04 Конец правки.
				КонецЕсли;
				
				Итого = Итого + Начислено;
				
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
КонецПроцедуры

// Процедура выполняет расчет начислений по счетчикам.
//
Процедура РасчитатьНачисленияПоГрупСчетчикам(СписокЛС, ТаблицаСчетчиков, Запрос, ЭтоЛС = Ложь, РасчетОбъемовДоТретьегоЗнака = Ложь)
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Объект КАК Здание,
	|	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	ЕСТЬNULL(бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток, 0) КАК ОтПоказаний,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток <> 0
	|				ТОГДА бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток
	|			ИНАЧЕ ВЫБОР
	|					КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток <> 0
	|						ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток
	|					ИНАЧЕ ВЫБОР
	|							КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток <> 0
	|								ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток
	|						КОНЕЦ
	|				КОНЕЦ
	|		КОНЕЦ, 0) КАК ДоПоказаний,
	|	ЕСТЬNULL(ВЫБОР
	|			КОГДА ВЫБОР
	|					КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток > 0
	|						ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|					КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток = 0
	|						ТОГДА 0
	|					ИНАЧЕ ВЫБОР
	|							КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток <> 0
	|								ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток + 1
	|							ИНАЧЕ 0
	|						КОНЕЦ
	|				КОНЕЦ > ВЫБОР
	|					КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток > 0
	|						ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|					ИНАЧЕ ВЫБОР
	|							КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток <> 0
	|								ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток + 1
	|							ИНАЧЕ 0
	|						КОНЕЦ
	|				КОНЕЦ
	|				ТОГДА ВЫБОР
	|						КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток > 0
	|							ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|						КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток = 0
	|							ТОГДА 0
	|						ИНАЧЕ ВЫБОР
	|								КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток <> 0
	|									ТОГДА бит_ПоказанияСчетчиковОстатки.Счетчик.Разрядность - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток + бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток + 1
	|								ИНАЧЕ 0
	|							КОНЕЦ
	|					КОНЕЦ
	|			ИНАЧЕ ВЫБОР
	|					КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток > 0
	|						ТОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток
	|					КОГДА бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток - бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток = 0
	|						ТОГДА 0
