Функция НайтиВидОплаты(Комиссия1,Комиссия2,Настройки)
	
	Запрос = Новый Запрос;
	Запрос.Текст =   "ВЫБРАТЬ
	|	ВидыОплатОрганизаций.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.ВидыОплатОрганизаций КАК ВидыОплатОрганизаций
	|ГДЕ
	|	ВидыОплатОрганизаций.ПометкаУдаления = ЛОЖЬ
	|	И ВидыОплатОрганизаций.Организация = &Организация
	|	И ВидыОплатОрганизаций.Контрагент = &Контрагент";
	Запрос.УстановитьПараметр("Организация",Настройки.Организация);
	Запрос.УстановитьПараметр("Контрагент",Настройки.ПлатежныйАгент);
	Если Запрос.Выполнить().Пустой() Тогда
		НовВид = Справочники.ВидыОплатОрганизаций.СоздатьЭлемент();
		НовВид.ПроцентБанковскойКомиссии = Число(Комиссия1)+Число(Комиссия2);
		НовВид.Наименование = Настройки.ПлатежныйАгент.Наименование;
		НовВид.Контрагент = Настройки.ПлатежныйАгент;
		НовВид.Организация = Настройки.Организация;
		НовВид.ТипОплаты   = Перечисления.ТипыОплат.ПлатежнаяКарта;
		новвид.СчетУчетаРасчетов = ПланыСчетов.Хозрасчетный.ПродажиПоПлатежнымКартам;
		НовВид.ДоговорКонтрагента = ПроверитьДоговор(Настройки.ПлатежныйАгент,Настройки.Организация);
		НовВид.Записать();
	Иначе
		РЗ = Запрос.Выполнить();
		Выб = РЗ.Выбрать();
		Если Выб.Следующий() Тогда
			Возврат Выб.Ссылка;
		КонецЕсли;	
	КонецЕсли;
	
