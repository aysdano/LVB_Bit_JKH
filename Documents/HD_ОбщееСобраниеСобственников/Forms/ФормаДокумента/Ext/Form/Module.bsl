//HD+
// Ограничивает выбор значения по ТипПараметра для строки ПользовательскиеПараметры.
// Для "Справочник.<ИмяСправочника>" открывает форму выбора справочника (кнопка «Показать все» / F4).
// Для бит_Проживающие применяет тот же отбор по МКД, что и при выборе собственника на вкладке УчастникиСобрания.
//
&НаКлиенте
Процедура ПользовательскиеПараметрыЗначениеНачалоВыбора(Элемент, ДанныеВыбора, ВыборДобавлением, СтандартнаяОбработка)
	
	ТипПараметраСтрокой = "";
	ПараметрСтроки = "";
	ТекущиеДанныеСтроки = Неопределено;
	
	Попытка
		ТекущиеДанныеСтроки = Элемент.ТекущиеДанные;
	Исключение
		ТекущиеДанныеСтроки = Неопределено;
	КонецПопытки;
	
	Если ТекущиеДанныеСтроки = Неопределено Тогда
		Попытка
			ТекущиеДанныеСтроки = Элементы.ПользовательскиеПараметры.ТекущиеДанные;
		Исключение
			ТекущиеДанныеСтроки = Неопределено;
		КонецПопытки;
	КонецЕсли;
	
	Если ТекущиеДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрСтроки = СокрЛП(Строка(ТекущиеДанныеСтроки.Параметр));
	ТипПараметраСтрокой = НормализоватьТипПараметра(Строка(ТекущиеДанныеСтроки.ТипПараметра));
	
	//HD+ Коммунальные ресурсы на СОИ: один параметр, несколько отметок
	Если ЭтоИмяПараметраКоммунальныхРесурсовСОИ(ПараметрСтроки) Тогда
		ПоказатьВыборКоммунальныхРесурсовСОИ(ПараметрСтроки, Строка(ТекущиеДанныеСтроки.Значение), СтандартнаяОбработка);
		Возврат;
	КонецЕсли;
	//HD-
	
	//HD+ Для простых типов используем ввод с ограничением ОписаниеТипов,
	// чтобы пользователь не выбирал произвольные ссылочные типы.
	Если ПоказатьВводЗначенияПользовательскогоПараметра(ПараметрСтроки, ТипПараметраСтрокой, СтандартнаяОбработка) Тогда
		Возврат;
	КонецЕсли;
	//HD-
	
	ИмяСправочника = ПолучитьИмяСправочникаИзТипаПараметра(ТипПараметраСтрокой);
	Если НЕ ЗначениеЗаполнено(ИмяСправочника) Тогда
		СтандартнаяОбработка = Ложь;
		ПоказатьПредупреждение(, "Для параметра """ + ПараметрСтроки + """ указан неподдерживаемый ТипПараметра: " + ТипПараметраСтрокой + ". Допустимые значения: Строка, Число, Дата или Справочник.<ИмяСправочника>.");
		Возврат;
	КонецЕсли;
	
	//HD+ Для арендатора не фиксируем ячейку типом ссылки: иначе нельзя ввести ФИО строкой, если проживающего нет в базе
	Если НЕ ТипПараметраДопускаетСтрокуВместоСсылки(ПараметрСтроки, ТипПараметраСтрокой) Тогда
		ПривестиТипЗначенияПользовательскогоПараметраКСправочникуНаСервере(ПараметрСтроки, ИмяСправочника);
	КонецЕсли;
	//HD-
	
	ИмяФормыВыбора = "Справочник." + ИмяСправочника + ".ФормаВыбора";
	
	СтандартнаяОбработка = Ложь;
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("РежимВыбора", Истина);
	ПараметрыФормы.Вставить("МножественныйВыбор", Ложь);
	
	ДопПараметры = Новый Структура;
	ДопПараметры.Вставить("Параметр", ПараметрСтроки);
	
	Если ИмяСправочника = "бит_Проживающие" Тогда
		Попытка
			МассивПроживающих = ПолучитьСписокПроживающихПоМКДНаСервере();
			Если МассивПроживающих <> Неопределено Тогда
				ПараметрыФормы.Вставить("СписокПроживающих", МассивПроживающих);
			КонецЕсли;
		Исключение
			// Если отбор по МКД получить не удалось, все равно открываем форму выбора по указанному типу.
		КонецПопытки;
	КонецЕсли;
	
	ОткрытьФорму(ИмяФормыВыбора, ПараметрыФормы, Элемент, , , , Новый ОписаниеОповещения("ПользовательскиеПараметрыЗначениеОбработкаВыбора", ЭтотОбъект, ДопПараметры));
	
КонецПроцедуры //HD-

//HD+
// Показывает диалог ввода значения с ограничением по типу для строки ПользовательскиеПараметры.
// Возвращает Истина, если показан диалог и выполнена обработка выбора.
//
&НаКлиенте
Функция ПоказатьВводЗначенияПользовательскогоПараметра(Знач ПараметрСтроки, Знач ТипПараметраСтрокой, СтандартнаяОбработка)
	
	ОписаниеТиповЗначения = ПолучитьОписаниеТиповДляВводаПользовательскогоПараметра(ТипПараметраСтрокой);
	Если ОписаниеТиповЗначения = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначениеПоУмолчанию = "";
	Попытка
		Если Элементы.ПользовательскиеПараметры.ТекущиеДанные <> Неопределено Тогда
			ЗначениеПоУмолчанию = Элементы.ПользовательскиеПараметры.ТекущиеДанные.Значение;
		КонецЕсли;
	Исключение
		ЗначениеПоУмолчанию = "";
	КонецПопытки;
	
	СтандартнаяОбработка = Ложь;
	ЗаголовокВвода = "Введите значение параметра";
	Если ЗначениеЗаполнено(ПараметрСтроки) Тогда
		ЗаголовокВвода = "Введите значение параметра """ + ПараметрСтроки + """";
	КонецЕсли;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Параметр", ПараметрСтроки);
	ДополнительныеПараметры.Вставить("СтароеЗначение", ЗначениеПоУмолчанию);
	
	ПоказатьВводЗначения(
		Новый ОписаниеОповещения("ПользовательскиеПараметрыЗначениеВводЗавершение", ЭтотОбъект, ДополнительныеПараметры),
		ЗначениеПоУмолчанию,
		ЗаголовокВвода,
		ОписаниеТиповЗначения
	);
	
	Возврат Истина;
	
КонецФункции //HD-

//HD+
// Завершение асинхронного ввода значения пользовательского параметра.
//
&НаКлиенте
Процедура ПользовательскиеПараметрыЗначениеВводЗавершение(Значение, ДополнительныеПараметры) Экспорт
	
	Если Значение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрСтроки = "";
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Параметр") Тогда
		ПараметрСтроки = ДополнительныеПараметры.Параметр;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрСтроки) Тогда
		УстановитьЗначениеПользовательскогоПараметраНаСервере(ПараметрСтроки, Значение);
	Иначе
		Попытка
			ТекущаяСтрока = Элементы.ПользовательскиеПараметры.ТекущаяСтрока;
			Если ТекущаяСтрока <> Неопределено И ТекущаяСтрока >= 0 И ТекущаяСтрока < Объект.ПользовательскиеПараметры.Количество() Тогда
				Объект.ПользовательскиеПараметры[ТекущаяСтрока].Значение = Значение;
			КонецЕсли;
		Исключение
			// Ничего не делаем, если текущую строку получить не удалось.
		КонецПопытки;
	КонецЕсли;
	
	ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
	
КонецПроцедуры //HD-

//HD+
// Имя параметра списка коммунальных ресурсов на СОИ (один плейсхолдер, несколько отметок).
//
&НаКлиентеНаСервереБезКонтекста
Функция ЭтоИмяПараметраКоммунальныхРесурсовСОИ(Знач ИмяПараметра)
	
	Возврат ВРег(СокрЛП(Строка(ИмяПараметра))) = ВРег("КоммунальныеРесурсыСОИ");
	
КонецФункции //HD-

//HD+
// Справочник формулировок ресурсов КР на СОИ: код, именительный (список выбора), дательный (текст «по …»).
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОписанияКоммунальныхРесурсовСОИ()
	
	Результат = Новый Массив;
	
	ДобавитьОписаниеКоммунальногоРесурсаСОИ(Результат, "ХВС", "холодное водоснабжение", "холодному водоснабжению");
	ДобавитьОписаниеКоммунальногоРесурсаСОИ(Результат, "ГВС", "горячее водоснабжение", "горячему водоснабжению");
	ДобавитьОписаниеКоммунальногоРесурсаСОИ(Результат, "ЭЭ", "электрическая энергия", "электрической энергии");
	ДобавитьОписаниеКоммунальногоРесурсаСОИ(Результат, "ВО", "отведение сточных вод", "отведению сточных вод");
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Добавляет элемент описания ресурса КР на СОИ в массив.
//
&НаКлиентеНаСервереБезКонтекста
Процедура ДобавитьОписаниеКоммунальногоРесурсаСОИ(МассивОписаний, Знач Код, Знач Именительный, Знач Дательный)
	
	ОписаниеРесурса = Новый Структура;
	ОписаниеРесурса.Вставить("Код", Код);
	ОписаниеРесурса.Вставить("Именительный", Именительный);
	ОписаниеРесурса.Вставить("Дательный", Дательный);
	МассивОписаний.Добавить(ОписаниеРесурса);
	
КонецПроцедуры //HD-

//HD+
// Собирает дательную формулировку выбранных ресурсов: «A», «A и B», «A, B и C».
//
&НаКлиентеНаСервереБезКонтекста
Функция СобратьФормулировкуКоммунальныхРесурсовСОИ(СписокВыбора)
	
	МассивДательный = Новый Массив;
	
	Если ТипЗнч(СписокВыбора) <> Тип("СписокЗначений") Тогда
		Возврат "";
	КонецЕсли;
	
	Для Каждого ОписаниеРесурса Из ПолучитьОписанияКоммунальныхРесурсовСОИ() Цикл
		ЭлементСписка = СписокВыбора.НайтиПоЗначению(ОписаниеРесурса.Код);
		Если ЭлементСписка <> Неопределено И ЭлементСписка.Пометка Тогда
			МассивДательный.Добавить(ОписаниеРесурса.Дательный);
		КонецЕсли;
	КонецЦикла;
	
	КоличествоВыбранных = МассивДательный.Количество();
	Если КоличествоВыбранных = 0 Тогда
		Возврат "";
	ИначеЕсли КоличествоВыбранных = 1 Тогда
		Возврат МассивДательный[0];
	ИначеЕсли КоличествоВыбранных = 2 Тогда
		Возврат МассивДательный[0] + " и " + МассивДательный[1];
	КонецЕсли;
	
	ЧастиБезПоследнего = Новый Массив;
	Для Индекс = 0 По КоличествоВыбранных - 2 Цикл
		ЧастиБезПоследнего.Добавить(МассивДательный[Индекс]);
	КонецЦикла;
	
	Возврат СтрСоединить(ЧастиБезПоследнего, ", ") + " и " + МассивДательный[КоличествоВыбранных - 1];
	
КонецФункции //HD-

//HD+
// Открывает отметку четырёх коммунальных ресурсов для параметра КоммунальныеРесурсыСОИ.
//
&НаКлиенте
Процедура ПоказатьВыборКоммунальныхРесурсовСОИ(Знач ПараметрСтроки, Знач ТекущееЗначение, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ТекущееЗначениеСтрокой = НРег(СокрЛП(Строка(ТекущееЗначение)));
	СписокВыбора = Новый СписокЗначений;
	
	Для Каждого ОписаниеРесурса Из ПолучитьОписанияКоммунальныхРесурсовСОИ() Цикл
		РесурсОтмечен = СтрНайти(ТекущееЗначениеСтрокой, НРег(ОписаниеРесурса.Дательный)) > 0
			ИЛИ СтрНайти(ТекущееЗначениеСтрокой, НРег(ОписаниеРесурса.Именительный)) > 0;
		Если ОписаниеРесурса.Код = "ХВС" Тогда
			РесурсОтмечен = РесурсОтмечен ИЛИ СтрНайти(ТекущееЗначениеСтрокой, "холодной воде") > 0;
		КонецЕсли;
		СписокВыбора.Добавить(ОписаниеРесурса.Код, ОписаниеРесурса.Именительный, РесурсОтмечен);
	КонецЦикла;
	
	ДополнительныеПараметры = Новый Структура;
	ДополнительныеПараметры.Вставить("Параметр", ПараметрСтроки);
	
	СписокВыбора.ПоказатьОтметкуЭлементов(
		Новый ОписаниеОповещения("ВыборКоммунальныхРесурсовСОИЗавершение", ЭтотОбъект, ДополнительныеПараметры),
		"Коммунальные ресурсы на СОИ");
	
КонецПроцедуры //HD-

//HD+
// Завершение отметки ресурсов КР на СОИ: в Значение пишется готовая дательная формулировка.
//
&НаКлиенте
Процедура ВыборКоммунальныхРесурсовСОИЗавершение(СписокВыбора, ДополнительныеПараметры) Экспорт
	
	Если СписокВыбора = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрСтроки = "";
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура")
		И ДополнительныеПараметры.Свойство("Параметр") Тогда
		ПараметрСтроки = ДополнительныеПараметры.Параметр;
	КонецЕсли;
	
	ФормулировкаРесурсов = СобратьФормулировкуКоммунальныхРесурсовСОИ(СписокВыбора);
	
	Если ЗначениеЗаполнено(ПараметрСтроки) Тогда
		УстановитьЗначениеПользовательскогоПараметраНаСервере(ПараметрСтроки, ФормулировкаРесурсов);
	КонецЕсли;
	
	ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
	
КонецПроцедуры //HD-

//HD+
// Возвращает ОписаниеТипов для ввода значения параметра.
// Пустой ТипПараметра ограничиваем простыми типами: Строка, Число, Дата.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьОписаниеТиповДляВводаПользовательскогоПараметра(Знач ТипПараметраСтрокой)
	
	ТипПараметраНорм = НормализоватьТипПараметра(ТипПараметраСтрокой);
	МассивТипов = Новый Массив;
	
	Если НЕ ЗначениеЗаполнено(ТипПараметраНорм) Тогда
		МассивТипов.Добавить(Тип("Строка"));
		МассивТипов.Добавить(Тип("Число"));
		МассивТипов.Добавить(Тип("Дата"));
		Возврат Новый ОписаниеТипов(МассивТипов);
	КонецЕсли;
	
	Если ТипПараметраНорм = "Строка" Тогда
		МассивТипов.Добавить(Тип("Строка"));
		Возврат Новый ОписаниеТипов(МассивТипов);
	КонецЕсли;
	
	Если ТипПараметраНорм = "Число" Тогда
		МассивТипов.Добавить(Тип("Число"));
		Возврат Новый ОписаниеТипов(МассивТипов);
	КонецЕсли;
	
	Если ТипПараметраНорм = "Дата" Тогда
		МассивТипов.Добавить(Тип("Дата"));
		Возврат Новый ОписаниеТипов(МассивТипов);
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции //HD-

//HD+
// Приводит строковое описание типа параметра к унифицированному виду.
// Убирает лишние пробелы/кавычки и приводит тип к формату Справочник.<ИмяСправочника>.
//
&НаКлиентеНаСервереБезКонтекста
Функция НормализоватьТипПараметра(Знач ИсходнаяСтрока)
	
	ТипПараметраСтрокой = СокрЛП(Строка(ИсходнаяСтрока));
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, Символ(9), "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, Символ(160), "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, Символ(13), "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, Символ(10), "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, """", "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, " ", "");
	
	Если НЕ ЗначениеЗаполнено(ТипПараметраСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Лев(ВРег(ТипПараметраСтрокой), СтрДлина("СПРАВОЧНИКССЫЛКА.")) = "СПРАВОЧНИКССЫЛКА." Тогда
		Возврат "Справочник." + Сред(ТипПараметраСтрокой, СтрДлина("СправочникСсылка.") + 1);
	КонецЕсли;
	
	Если Лев(ВРег(ТипПараметраСтрокой), СтрДлина("СПРАВОЧНИК.")) = "СПРАВОЧНИК." Тогда
		Возврат "Справочник." + Сред(ТипПараметраСтрокой, СтрДлина("Справочник.") + 1);
	КонецЕсли;
	
	Если ВРег(ТипПараметраСтрокой) = "СТРОКА" Тогда
		Возврат "Строка";
	КонецЕсли;
	
	Если ВРег(ТипПараметраСтрокой) = "ЧИСЛО" Тогда
		Возврат "Число";
	КонецЕсли;
	
	Если ВРег(ТипПараметраСтрокой) = "ДАТА" Тогда
		Возврат "Дата";
	КонецЕсли;
	
	Возврат ТипПараметраСтрокой;
	
КонецФункции //HD-

//HD+
// Части составного ТипПараметра: «Справочник.бит_Проживающие,Строка» → массив нормализованных типов.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьЧастиТипаПользовательскогоПараметра(Знач ТипПараметраСтрокой)
	
	МассивЧастей = Новый Массив;
	СыроеОписание = СокрЛП(Строка(ТипПараметраСтрокой));
	Если НЕ ЗначениеЗаполнено(СыроеОписание) Тогда
		Возврат МассивЧастей;
	КонецЕсли;
	
	Если СтрНайти(СыроеОписание, ",") = 0 Тогда
		НормализованнаяЧасть = НормализоватьТипПараметра(СыроеОписание);
		Если ЗначениеЗаполнено(НормализованнаяЧасть) Тогда
			МассивЧастей.Добавить(НормализованнаяЧасть);
		КонецЕсли;
		Возврат МассивЧастей;
	КонецЕсли;
	
	Для Каждого ЧастьОписания Из СтрРазделить(СыроеОписание, ",", Ложь) Цикл
		НормализованнаяЧасть = НормализоватьТипПараметра(ЧастьОписания);
		Если ЗначениеЗаполнено(НормализованнаяЧасть) Тогда
			МассивЧастей.Добавить(НормализованнаяЧасть);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЧастей;
	
КонецФункции //HD-

//HD+
// Имя справочника из ТипПараметра (первый «Справочник.<Имя>» в составном описании).
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьИмяСправочникаИзТипаПараметра(Знач ТипПараметраСтрокой)
	
	ПрефиксСправочника = "Справочник.";
	Для Каждого ЧастьТипа Из ПолучитьЧастиТипаПользовательскогоПараметра(ТипПараметраСтрокой) Цикл
		Если Лев(ЧастьТипа, СтрДлина(ПрефиксСправочника)) = ПрефиксСправочника Тогда
			Возврат Сред(ЧастьТипа, СтрДлина(ПрефиксСправочника) + 1);
		КонецЕсли;
	КонецЦикла;
	
	Возврат "";
	
КонецФункции //HD-

//HD+
// Арендатор и составной тип «Справочник.бит_Проживающие,Строка»: можно выбрать проживающего или ввести ФИО строкой.
//
&НаКлиентеНаСервереБезКонтекста
Функция ТипПараметраДопускаетСтрокуВместоСсылки(Знач ИмяПараметра, Знач ТипПараметраСтрокой)
	
	Если ВРег(ПолучитьБазовоеИмяПараметраПоПадежномуСуффиксу(ИмяПараметра)) = "АРЕНДАТОР" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для Каждого ЧастьТипа Из ПолучитьЧастиТипаПользовательскогоПараметра(ТипПараметраСтрокой) Цикл
		Если ЧастьТипа = "Строка" Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции //HD-

//HD+
// Пустую ссылку арендатора приводит к пустой строке, чтобы в ячейке можно было печатать ФИО.
//
&НаСервере
Процедура ПривестиПустыеЗначенияАрендатораКСтрокеНаСервере()
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		
		Если НЕ ТипПараметраДопускаетСтрокуВместоСсылки(СтрокаПараметра.Параметр, СтрокаПараметра.ТипПараметра) Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЗначениеЗаполнено(СтрокаПараметра.Значение)
			И ТипЗнч(СтрокаПараметра.Значение) <> Тип("Строка") Тогда
			СтрокаПараметра.Значение = "";
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// При активизации строки настраивает поле «Значение»: для арендатора можно и печатать ФИО, и выбирать проживающего.
//
&НаКлиенте
Процедура ПользовательскиеПараметрыПриАктивизацииСтроки(Элемент)
	
	НастроитьПолеЗначенияПользовательскогоПараметра();
	
КонецПроцедуры //HD-

//HD+
// Для арендатора: тип ячейки «строка + проживающий», редактирование текста, пустое значение — пустая строка.
// F4 / кнопка выбора по-прежнему открывают справочник.
//
&НаКлиенте
Процедура НастроитьПолеЗначенияПользовательскогоПараметра()
	
	ПолеЗначения = Элементы.Найти("ПользовательскиеПараметрыЗначение");
	Если ПолеЗначения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПолеЗначения.РедактированиеТекста = Истина;
	ПолеЗначения.РежимРедактирования = РежимРедактированияКолонки.Непосредственно;
	
	ТекущиеДанныеСтроки = Неопределено;
	Попытка
		ТекущиеДанныеСтроки = Элементы.ПользовательскиеПараметры.ТекущиеДанные;
	Исключение
		ТекущиеДанныеСтроки = Неопределено;
	КонецПопытки;
	
	Если ТекущиеДанныеСтроки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрСтроки = СокрЛП(Строка(ТекущиеДанныеСтроки.Параметр));
	ТипПараметраСтрокой = Строка(ТекущиеДанныеСтроки.ТипПараметра);
	
	Если ТипПараметраДопускаетСтрокуВместоСсылки(ПараметрСтроки, ТипПараметраСтрокой) Тогда
		
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Строка"));
		ИмяСправочника = ПолучитьИмяСправочникаИзТипаПараметра(ТипПараметраСтрокой);
		Если НЕ ЗначениеЗаполнено(ИмяСправочника) Тогда
			ИмяСправочника = "бит_Проживающие";
		КонецЕсли;
		Попытка
			МассивТипов.Добавить(Тип("СправочникСсылка." + ИмяСправочника));
		Исключение
		КонецПопытки;
		
		ПолеЗначения.ОграничениеТипа = Новый ОписаниеТипов(МассивТипов, , Новый КвалификаторыСтроки(0));
		ПолеЗначения.ВыбиратьТип = Ложь;
		
		Если НЕ ЗначениеЗаполнено(ТекущиеДанныеСтроки.Значение)
			И ТипЗнч(ТекущиеДанныеСтроки.Значение) <> Тип("Строка") Тогда
			ТекущиеДанныеСтроки.Значение = "";
		КонецЕсли;
		
	Иначе
		
		ПолеЗначения.ОграничениеТипа = Новый ОписаниеТипов;
		
	КонецЕсли;
	
КонецПроцедуры //HD-

// Завершение выбора значения для строки ПользовательскиеПараметры.
//
&НаКлиенте
Процедура ПользовательскиеПараметрыЗначениеОбработкаВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Неопределено;
	Если ТипЗнч(Результат) = Тип("Массив") Тогда
		Если Результат.Количество() > 0 Тогда
			ВыбранноеЗначение = Результат[0];
		КонецЕсли;
	Иначе
		ВыбранноеЗначение = Результат;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		Возврат;
	КонецЕсли;
	
	ПараметрСтроки = "";
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") Тогда
		Если ДополнительныеПараметры.Свойство("Параметр") Тогда
			ПараметрСтроки = ДополнительныеПараметры.Параметр;
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрСтроки) Тогда
		УстановитьЗначениеПользовательскогоПараметраНаСервере(ПараметрСтроки, ВыбранноеЗначение);
	Иначе
		// fallback - если не удалось передать контекст строки
		Попытка
			ТекущаяСтрока = Элементы.ПользовательскиеПараметры.ТекущаяСтрока;
			Если ТекущаяСтрока <> Неопределено И ТекущаяСтрока >= 0 И ТекущаяСтрока < Объект.ПользовательскиеПараметры.Количество() Тогда
				Объект.ПользовательскиеПараметры[ТекущаяСтрока].Значение = ВыбранноеЗначение;
			КонецЕсли;
		Исключение
			// Ничего не делаем, если текущую строку получить не удалось.
		КонецПопытки;
	КонецЕсли;
	
	ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
	
КонецПроцедуры //HD-

//HD+
// Устанавливает в ячейке «Значение» тип ссылки справочника из ТипПараметра (если тип ячейки не совпадает).
//
&НаСервере
Процедура ПривестиТипЗначенияПользовательскогоПараметраКСправочникуНаСервере(Знач ПараметрСтроки, Знач ИмяСправочника)
	
	Если НЕ ЗначениеЗаполнено(ПараметрСтроки) ИЛИ НЕ ЗначениеЗаполнено(ИмяСправочника) Тогда
		Возврат;
	КонецЕсли;
	
	ОжидаемыйТип = Неопределено;
	Попытка
		ОжидаемыйТип = Тип("СправочникСсылка." + ИмяСправочника);
	Исключение
		Возврат;
	КонецПопытки;
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		
		Если СокрЛП(Строка(СтрокаПараметра.Параметр)) <> СокрЛП(Строка(ПараметрСтроки)) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ТипЗнч(СтрокаПараметра.Значение) <> ОжидаемыйТип Тогда
			Попытка
				СтрокаПараметра.Значение = Справочники[ИмяСправочника].ПустаяСсылка();
			Исключение
			КонецПопытки;
		КонецЕсли;
		
		Прервать;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Устанавливает значение в строку табличной части ПользовательскиеПараметры по имени параметра.
// Значение также копируется в остальные параметры той же падежной группы (общее базовое имя).
//
&НаСервере
Процедура УстановитьЗначениеПользовательскогоПараметраНаСервере(ПараметрСтроки, ВыбранноеЗначение)
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		Если СокрЛП(Строка(СтрокаПараметра.Параметр)) = СокрЛП(Строка(ПараметрСтроки)) Тогда
			СтрокаПараметра.Значение = ВыбранноеЗначение;
			Прервать;
		КонецЕсли;
	КонецЦикла;
	
	СинхронизироватьЗначениеПадежнойГруппыПользовательскихПараметровНаСервере(ПараметрСтроки);
	
КонецПроцедуры //HD-

//HD+
// Копирует значение параметра во все строки ТЧ с тем же базовым именем
// (например Арендатор → Арендатор_Дательный, Арендатор_Творительный).
// Склонение при подстановке выполняется отдельно по полю Падеж каждой строки.
//
&НаСервере
Процедура СинхронизироватьЗначениеПадежнойГруппыПользовательскихПараметровНаСервере(Знач ИмяПараметраИсточника)
	
	ИмяПараметраИсточника = СокрЛП(Строка(ИмяПараметраИсточника));
	Если НЕ ЗначениеЗаполнено(ИмяПараметраИсточника) Тогда
		Возврат;
	КонецЕсли;
	
	БазовоеИмя = ПолучитьБазовоеИмяПараметраПоПадежномуСуффиксу(ИмяПараметраИсточника);
	Если НЕ ЗначениеЗаполнено(БазовоеИмя) Тогда
		Возврат;
	КонецЕсли;
	
	БазовоеИмяВерх = ВРег(БазовоеИмя);
	ЗначениеИсточника = Неопределено;
	ИсточникНайден = Ложь;
	КоличествоВГруппе = 0;
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		
		ИмяПараметраСтроки = СокрЛП(Строка(СтрокаПараметра.Параметр));
		Если ВРег(ПолучитьБазовоеИмяПараметраПоПадежномуСуффиксу(ИмяПараметраСтроки)) <> БазовоеИмяВерх Тогда
			Продолжить;
		КонецЕсли;
		
		КоличествоВГруппе = КоличествоВГруппе + 1;
		
		Если ВРег(ИмяПараметраСтроки) = ВРег(ИмяПараметраИсточника) Тогда
			ЗначениеИсточника = СтрокаПараметра.Значение;
			ИсточникНайден = Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Если НЕ ИсточникНайден ИЛИ КоличествоВГруппе < 2 Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		
		ИмяПараметраСтроки = СокрЛП(Строка(СтрокаПараметра.Параметр));
		Если ВРег(ПолучитьБазовоеИмяПараметраПоПадежномуСуффиксу(ИмяПараметраСтроки)) <> БазовоеИмяВерх Тогда
			Продолжить;
		КонецЕсли;
		
		Если ВРег(ИмяПараметраСтроки) = ВРег(ИмяПараметраИсточника) Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ЗначениеИсточника)
			И ЗначениеЗаполнено(СтрокаПараметра.ТипПараметра)
			И НЕ СоответствуетТипуПараметра(ЗначениеИсточника, СтрокаПараметра.ТипПараметра, ИмяПараметраСтроки) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПараметра.Значение = ЗначениеИсточника;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Базовое имя параметра без суффикса падежа: «Арендатор_Дательный» → «Арендатор».
// Если суффикса нет — возвращается исходное имя.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьБазовоеИмяПараметраПоПадежномуСуффиксу(Знач ИмяПараметра)
	
	ИмяПараметра = СокрЛП(Строка(ИмяПараметра));
	Если НЕ ЗначениеЗаполнено(ИмяПараметра) Тогда
		Возврат "";
	КонецЕсли;
	
	СуффиксПадежа = ПолучитьСуффиксПадежаИзИмениПараметра(ИмяПараметра);
	Если НЕ ЗначениеЗаполнено(СуффиксПадежа) Тогда
		Возврат ИмяПараметра;
	КонецЕсли;
	
	Возврат Лев(ИмяПараметра, СтрДлина(ИмяПараметра) - СтрДлина(СуффиксПадежа));
	
КонецФункции //HD-

//HD+
// Суффикс падежа из имени параметра («_Дательный» и т.п.) или пустая строка.
//
&НаКлиентеНаСервереБезКонтекста
Функция ПолучитьСуффиксПадежаИзИмениПараметра(Знач ИмяПараметра)
	
	ИмяПараметра = СокрЛП(Строка(ИмяПараметра));
	Если НЕ ЗначениеЗаполнено(ИмяПараметра) Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяПараметраВерх = ВРег(ИмяПараметра);
	
	СуффиксыПадежей = Новый Массив;
	СуффиксыПадежей.Добавить("_ИМЕНИТЕЛЬНЫЙ");
	СуффиксыПадежей.Добавить("_РОДИТЕЛЬНЫЙ");
	СуффиксыПадежей.Добавить("_ДАТЕЛЬНЫЙ");
	СуффиксыПадежей.Добавить("_ВИНИТЕЛЬНЫЙ");
	СуффиксыПадежей.Добавить("_ТВОРИТЕЛЬНЫЙ");
	СуффиксыПадежей.Добавить("_ПРЕДЛОЖНЫЙ");
	
	Для Каждого СуффиксВерх Из СуффиксыПадежей Цикл
		
		ДлинаСуффикса = СтрДлина(СуффиксВерх);
		Если СтрДлина(ИмяПараметраВерх) <= ДлинаСуффикса Тогда
			Продолжить;
		КонецЕсли;
		
		Если Прав(ИмяПараметраВерх, ДлинаСуффикса) = СуффиксВерх Тогда
			Возврат Прав(ИмяПараметра, ДлинаСуффикса);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат "";
	
КонецФункции //HD-

//HD+
// Проверяет соответствие типа введенного значения настройке параметра.
// Если тип не совпадает - очищает значение параметра и возвращает Ложь.
//
&НаСервере
Функция ПроверитьИПривестиТипЗначенияПользовательскогоПараметраНаСервере(ПараметрСтроки)
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		Если СокрЛП(Строка(СтрокаПараметра.Параметр)) = ПараметрСтроки Тогда
			
			ТипПараметраСтрокой = СокрЛП(Строка(СтрокаПараметра.ТипПараметра));
			Если СоответствуетТипуПараметра(СтрокаПараметра.Значение, ТипПараметраСтрокой, ПараметрСтроки) Тогда
				Возврат Истина;
			КонецЕсли;
			
			// Очищаем значение, если тип не совпал
			СтрокаПараметра.Значение = "";
			Возврат Ложь;
			
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции //HD-

//HD+
// Проверяет соответствие значения ожидаемому типу из реквизита ТипПараметра.
// Поддерживаемые значения ТипПараметра: "Строка", "Число", "Дата", "Справочник.<Имя>", составные через запятую.
// Для арендатора дополнительно допускается строка ФИО, даже если в типе указан только справочник.
//
&НаСервере
Функция СоответствуетТипуПараметра(ЗначениеПараметра, ТипПараметраСтрокой, Знач ИмяПараметра = "")
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипПараметраДопускаетСтрокуВместоСсылки(ИмяПараметра, ТипПараметраСтрокой)
		И ТипЗнч(ЗначениеПараметра) = Тип("Строка") Тогда
		Возврат Истина;
	КонецЕсли;
	
	ЧастиТипа = ПолучитьЧастиТипаПользовательскогоПараметра(ТипПараметраСтрокой);
	
	Если ЧастиТипа.Количество() = 0 Тогда
		Возврат ТипЗнч(ЗначениеПараметра) = Тип("Строка")
			ИЛИ ТипЗнч(ЗначениеПараметра) = Тип("Число")
			ИЛИ ТипЗнч(ЗначениеПараметра) = Тип("Дата");
	КонецЕсли;
	
	Для Каждого ЧастьТипа Из ЧастиТипа Цикл
		
		Если ЧастьТипа = "Строка" И ТипЗнч(ЗначениеПараметра) = Тип("Строка") Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если ЧастьТипа = "Число" И ТипЗнч(ЗначениеПараметра) = Тип("Число") Тогда
			Возврат Истина;
		КонецЕсли;
		
		Если ЧастьТипа = "Дата" И ТипЗнч(ЗначениеПараметра) = Тип("Дата") Тогда
			Возврат Истина;
		КонецЕсли;
		
		ПрефиксМетаданныхСправочника = "Справочник.";
		Если Лев(ЧастьТипа, СтрДлина(ПрефиксМетаданныхСправочника)) <> ПрефиксМетаданныхСправочника Тогда
			Продолжить;
		КонецЕсли;
		
		ИмяСправочника = Сред(ЧастьТипа, СтрДлина(ПрефиксМетаданныхСправочника) + 1);
		Если НЕ ЗначениеЗаполнено(ИмяСправочника) Тогда
			Продолжить;
		КонецЕсли;
		
		ОжидаемыйТип = Неопределено;
		Попытка
			ОжидаемыйТип = Тип("СправочникСсылка." + ИмяСправочника);
		Исключение
			ОжидаемыйТип = Неопределено;
		КонецПопытки;
		
		Если ОжидаемыйТип <> Неопределено И ТипЗнч(ЗначениеПараметра) = ОжидаемыйТип Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Ложь;
	
КонецФункции //HD-

//HD+
// Синхронизирует текущие детальные поля на форме (ТекущийВопрос, ТекущаяФормулировка) с активной строкой повестки дня.
//
&НаСервере
Процедура ОбновитьДетальныеПоляПовесткиДняНаСервере()
	
	Попытка
		ТекущаяСтрокаИД = Элементы.ПовесткаДня.ТекущаяСтрока;
		Если ТекущаяСтрокаИД <> Неопределено Тогда
			ТекущиеДанные = Объект.ПовесткаДня.НайтиПоИдентификатору(ТекущаяСтрокаИД);
			Если ТекущиеДанные <> Неопределено Тогда
				ТекущийВопрос = ТекущиеДанные.Вопрос;
				ТекущаяФормулировка = ТекущиеДанные.ФормулировкаПредложенияРешенияВопроса;
				ТекущееПриложение = ТекущиеДанные.Приложение;
			КонецЕсли;
		КонецЕсли;
	Исключение
		// Ничего не делаем в случае ошибки
	КонецПопытки;
	
	НастроитьВидимостьДеталейПовесткиДня(ЭтотОбъект);
	
КонецПроцедуры //HD-

//HD+
// Применяет пользовательские параметры к текстам табличной части ПовесткаДня.
// Источник шаблонов - соответствие ШаблоныТекста (исходные тексты из справочника), чтобы подстановка не "накапливалась".
//
&НаСервере
Процедура ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере()
	
	Если Объект.ПовесткаДня.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Обновим исходные шаблоны из справочника (если они еще не инициализированы или могли измениться)
	СохранитьШаблоныТекстаПовесткиДняНаСервере();
	
	СоответствиеПараметров = ПолучитьСоответствиеПользовательскихПараметров();
	Если СоответствиеПараметров.Количество() > 0 Тогда
		
		Для Индекс = 0 По Объект.ПовесткаДня.Количество() - 1 Цикл
			
			СтрокаПовестки = Объект.ПовесткаДня[Индекс];
			Если СтрокаПовестки = Неопределено Тогда
				Продолжить;
			КонецЕсли;
			
			КлючВопрос = Формат(Индекс, "ЧГ=") + "_Вопрос";
			ШаблонВопрос = ШаблоныТекста.Получить(КлючВопрос);
			Если ШаблонВопрос = Неопределено Тогда
				ШаблонВопрос = СтрокаПовестки.Вопрос;
			КонецЕсли;
			
			КлючФормулировка = Формат(Индекс, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса";
			ШаблонФормулировка = ШаблоныТекста.Получить(КлючФормулировка);
			Если ШаблонФормулировка = Неопределено Тогда
				ШаблонФормулировка = СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса;
			КонецЕсли;
			
			КлючПриложение = Формат(Индекс, "ЧГ=") + "_Приложение";
			ШаблонПриложение = Неопределено;
			Если ТипЗнч(ШаблоныТекста) = Тип("Соответствие") Тогда
				ШаблонПриложение = ШаблоныТекста.Получить(КлючПриложение);
			КонецЕсли;
			Если ШаблонПриложение = Неопределено Тогда
				ШаблонПриложение = ПолучитьТекстПриложенияСтрокиПовестки(СтрокаПовестки);
			КонецЕсли;
			
			Если СтрокаПовесткиЭтоПриложениеНаСервере(СтрокаПовестки) Тогда
				СтрокаПовестки.Приложение = ПодставитьПользовательскиеПараметрыВТекст(Строка(ШаблонПриложение), СоответствиеПараметров);
				СтрокаПовестки.Вопрос = СтрокаПовестки.Приложение;
			Иначе
				СтрокаПовестки.Вопрос = ПодставитьПользовательскиеПараметрыВТекст(Строка(ШаблонВопрос), СоответствиеПараметров);
				СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса = ПодставитьПользовательскиеПараметрыВТекст(Строка(ШаблонФормулировка), СоответствиеПараметров);
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЕсли;
	
	ОбновитьДетальныеПоляПовесткиДняНаСервере();
	
КонецПроцедуры //HD-

//HD+
// Применяет пользовательские параметры к одной строке табличной части ПовесткаДня.
// ВАЖНО: применяется к ТЕКУЩЕМУ тексту строки (после восстановления подчеркиваний), чтобы не перетирать ввод пользователя.
//
&НаСервере
Процедура ПрименитьПользовательскиеПараметрыКСтрокеПовесткиДняНаСервере(ИндексСтроки)
	
	Если ИндексСтроки < 0 Или ИндексСтроки >= Объект.ПовесткаДня.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	Если Объект.ПользовательскиеПараметры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	СоответствиеПараметров = ПолучитьСоответствиеПользовательскихПараметров();
	Если СоответствиеПараметров.Количество() > 0 Тогда
		
		СтрокаПовестки = Объект.ПовесткаДня[ИндексСтроки];
		Если СтрокаПовестки = Неопределено Тогда
			Возврат;
		КонецЕсли;
		
		// Подставляем в шаблон строки (если есть), чтобы не терять плейсхолдеры при повторных пересчетах.
		ШаблонВопрос = Строка(СтрокаПовестки.Вопрос);
		ШаблонФормулировка = Строка(СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса);
		ШаблонПриложение = ПолучитьТекстПриложенияСтрокиПовестки(СтрокаПовестки);
		Попытка
			Если ЗначениеЗаполнено(СтрокаПовестки.ШаблонВопрос) Тогда
				ШаблонВопрос = Строка(СтрокаПовестки.ШаблонВопрос);
			КонецЕсли;
			Если ЗначениеЗаполнено(СтрокаПовестки.ШаблонФормулировка) Тогда
				ШаблонФормулировка = Строка(СтрокаПовестки.ШаблонФормулировка);
			КонецЕсли;
		Исключение
			ШаблонВопрос = ШаблонВопрос + "";
		КонецПопытки;
		
		Если СтрокаПовесткиЭтоПриложениеНаСервере(СтрокаПовестки) Тогда
			СтрокаПовестки.Приложение = ПодставитьПользовательскиеПараметрыВТекст(ШаблонПриложение, СоответствиеПараметров);
			СтрокаПовестки.Вопрос = СтрокаПовестки.Приложение;
		Иначе
			СтрокаПовестки.Вопрос = ПодставитьПользовательскиеПараметрыВТекст(ШаблонВопрос, СоответствиеПараметров);
			СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса = ПодставитьПользовательскиеПараметрыВТекст(ШаблонФормулировка, СоответствиеПараметров);
		КонецЕсли;
		
	КонецЕсли;
	
	ОбновитьДетальныеПоляПовесткиДняНаСервере();
	
КонецПроцедуры //HD-

//HD+
// Возвращает части даты реквизита документа по пути вида «Объект.<ИмяРеквизита>» (ЧастиДаты.Дата, ЧастиДаты.ДатаВремя и т.д.).
// Если реквизит не найден или не имеет тип «Дата», возвращает Неопределено.
//
&НаСервере
Функция ПолучитьЧастиДатыРеквизитаДокументаПоПути(Знач ПутьРеквизита)
	
	ПутьСтрокой = СокрЛП(Строка(ПутьРеквизита));
	Если НЕ ЗначениеЗаполнено(ПутьСтрокой) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Префикс = "Объект.";
	Если Лев(ПутьСтрокой, СтрДлина(Префикс)) = Префикс Тогда
		ИмяРеквизита = Сред(ПутьСтрокой, СтрДлина(Префикс) + 1);
	Иначе
		ИмяРеквизита = ПутьСтрокой;
	КонецЕсли;
	
	ИмяРеквизита = СокрЛП(ИмяРеквизита);
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	МетаданныеРеквизита = Метаданные.Документы.HD_ОбщееСобраниеСобственников.Реквизиты.Найти(ИмяРеквизита);
	Если МетаданныеРеквизита = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	ОписаниеТипов = МетаданныеРеквизита.Тип;
	Если НЕ ОписаниеТипов.СодержитТип(Тип("Дата")) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ОписаниеТипов.КвалификаторыДаты.ЧастиДаты;
	
КонецФункции //HD-

//HD+
// Убирает слово «Улица»/«улица» из строки адреса для печати и подстановки в повестку.
// Пример: «Солнечная 2-я Улица» → «Солнечная 2-я».
//
&НаСервере
Функция УбратьСловоУлицаИзСтрокиАдресаДляПечати(Знач СтрокаАдреса)
	
	Результат = СокрЛП(Строка(СтрокаАдреса));
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат "";
	КонецЕсли;
	
	Результат = СтрЗаменить(Результат, " Улица ", " ");
	Результат = СтрЗаменить(Результат, " улица ", " ");
	Результат = СтрЗаменить(Результат, " Улица", "");
	Результат = СтрЗаменить(Результат, " улица", "");
	Результат = СтрЗаменить(Результат, "Улица ", "");
	Результат = СтрЗаменить(Результат, "улица ", "");
	
	Если ВРег(СокрЛП(Результат)) = "УЛИЦА" Тогда
		Результат = "";
	КонецЕсли;
	
	Пока СтрНайти(Результат, "  ") > 0 Цикл
		Результат = СтрЗаменить(Результат, "  ", " ");
	КонецЦикла;
	
	Возврат СокрЛП(Результат);
	
КонецФункции //HD-

//HD+
// Форматирует дату и время без лидирующего нуля у часа (например, 11.08.2026 9:00:00).
//
&НаСервере
Функция ФорматироватьДатуВремяБезЛидирующегоНуля(ДатаЗначение)
	
	Если НЕ ЗначениеЗаполнено(ДатаЗначение) Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат Формат(ДатаЗначение, "ДФ=dd.MM.yyyy Ч:mm:ss");
	
КонецФункции //HD-

//HD+
// Формирует строковое представление значения пользовательского параметра для подстановки в повестку и печать.
// Даты без времени выводятся как на форме (11.06.2026), даты со временем — с временем без лидирующего нуля у часа.
//
&НаСервере
Функция ПредставлениеЗначенияПользовательскогоПараметраДляПечати(СтрокаПараметра)
	
	ИмяПараметра = СокрЛП(Строка(СтрокаПараметра.Параметр));
	ПутьСвязиПараметра = СокрЛП(Строка(СтрокаПараметра.ОбъектДляСвязи));
	ТипПараметраСтрокой = НормализоватьТипПараметра(Строка(СтрокаПараметра.ТипПараметра));
	ЗначениеПараметра = СтрокаПараметра.Значение;
	
	Если ПутьСвязиПараметра = "Объект.ВладелецСчетаКР"
		ИЛИ ВРег(ИмяПараметра) = ВРег("ВладелецСчетаКР") Тогда
		Возврат ПредставлениеВладельцаСчетаКРДляПечати(ЗначениеПараметра);
	КонецЕсли;
	
	//HD+ Если это Организация, выводим её сокращенное наименование
	Если ПутьСвязиПараметра = "Объект.Организация"
		ИЛИ ВРег(ИмяПараметра) = ВРег("Организация") Тогда
		Возврат ПредставлениеОрганизацииДляПечати(ЗначениеПараметра);
	КонецЕсли; //HD-
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипПараметраСтрокой = "Число" И ТипЗнч(ЗначениеПараметра) = Тип("Число") Тогда
		Возврат Формат(ЗначениеПараметра, "ЧГ=");
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Дата") Тогда
		ЧастиДатыРеквизита = ПолучитьЧастиДатыРеквизитаДокументаПоПути(ПутьСвязиПараметра);
		Если ТипПараметраСтрокой = "Дата" ИЛИ ЧастиДатыРеквизита = ЧастиДаты.Дата Тогда
			Возврат Формат(ЗначениеПараметра, "ДЛФ=D");
		ИначеЕсли ЧастиДатыРеквизита = ЧастиДаты.ДатаВремя Тогда
			Возврат ФорматироватьДатуВремяБезЛидирующегоНуля(ЗначениеПараметра);
		Иначе
			Если Час(ЗначениеПараметра) = 0 И Минута(ЗначениеПараметра) = 0 И Секунда(ЗначениеПараметра) = 0 Тогда
				Возврат Формат(ЗначениеПараметра, "ДЛФ=D");
			Иначе
				Возврат ФорматироватьДатуВремяБезЛидирующегоНуля(ЗначениеПараметра);
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(ЗначениеПараметра)) Тогда
		Если ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Банки") Тогда
			Возврат СокрЛП(ЗначениеПараметра.Наименование);
		//HD+ Если это Организация, выводим её сокращенное наименование
		ИначеЕсли ТипЗнч(ЗначениеПараметра) = Тип("СправочникСсылка.Организации") Тогда
			Возврат СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеПараметра, "НаименованиеСокращенное")));
		//HD-
		КонецЕсли;
	КонецЕсли;
	
	Если ТипПараметраСтрокой = "Справочник.Банки" Тогда
		Попытка
			Возврат СокрЛП(ЗначениеПараметра.Наименование);
		Исключение
		КонецПопытки;
	//HD+ Если это Организация, выводим её сокращенное наименование
	ИначеЕсли ТипПараметраСтрокой = "Справочник.Организации" Тогда
		Попытка
			Возврат СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеПараметра, "НаименованиеСокращенное")));
		Исключение
		КонецПопытки;
	//HD-
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеПараметра));
	
КонецФункции //HD-

//HD+
// Определяет, нужно ли склонять значение для указанного падежа при печати и на форме.
// Перечисления.HD_Падежи.КакЕсть и Именительный — значение подставляется без изменения.
//
&НаСервере
Функция ПадежТребуетСклоненияДляПечати(Падеж)
	
	Если НЕ ЗначениеЗаполнено(Падеж) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Падеж = ПредопределенноеЗначение("Перечисление.HD_Падежи.КакЕсть") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Падеж = ПредопределенноеЗначение("Перечисление.HD_Падежи.Именительный") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции //HD-

//HD+
// Возвращает номер падежа для СклонениеПредставленийОбъектов.ПросклонятьФИО (1–6).
// КакЕсть и пустое значение — без склонения (1). Именительный — 1.
//
&НаСервере
Функция ПолучитьНомерПадежаДляСклонения(Падеж)
	
	Если НЕ ПадежТребуетСклоненияДляПечати(Падеж) Тогда
		Возврат 1;
	КонецЕсли;
	
	Если Падеж = ПредопределенноеЗначение("Перечисление.HD_Падежи.Родительный") Тогда
		Возврат 2;
	ИначеЕсли Падеж = ПредопределенноеЗначение("Перечисление.HD_Падежи.Дательный") Тогда
		Возврат 3;
	ИначеЕсли Падеж = ПредопределенноеЗначение("Перечисление.HD_Падежи.Винительный") Тогда
		Возврат 4;
	ИначеЕсли Падеж = ПредопределенноеЗначение("Перечисление.HD_Падежи.Творительный") Тогда
		Возврат 5;
	ИначеЕсли Падеж = ПредопределенноеЗначение("Перечисление.HD_Падежи.Предложный") Тогда
		Возврат 6;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции //HD-

//HD+
// Определяет, нужно ли склонять значение параметра на форме (только строковые / ФИО).
//
&НаСервере
Функция НужноСклонятьЗначениеПользовательскогоПараметра(СтрокаПараметра)
	
	ПутьСвязиПараметра = СокрЛП(Строка(СтрокаПараметра.ОбъектДляСвязи));
	ИмяПараметра = СокрЛП(Строка(СтрокаПараметра.Параметр));
	
	Если ПутьСвязиПараметра = "Объект.ВладелецСчетаКР"
		ИЛИ ВРег(ИмяПараметра) = ВРег("ВладелецСчетаКР") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	//HD+ Если это Организация, не склоняем
	Если ПутьСвязиПараметра = "Объект.Организация"
		ИЛИ ВРег(ИмяПараметра) = ВРег("Организация") Тогда
		Возврат Ложь;
	КонецЕсли; //HD-
	
	//HD+ Составной список членов совета / предложенный председатель не склоняем целиком
	Если ЭтоИмяИлиПутьСпискаПредложенныхЧленовСовета(ИмяПараметра, ПутьСвязиПараметра)
		ИЛИ ЭтоИмяИлиПутьПредложенногоПредседателя(ИмяПараметра, ПутьСвязиПараметра) Тогда
		Возврат Ложь;
	КонецЕсли;
	//HD-
	
	ТипПараметраСтрокой = НормализоватьТипПараметра(Строка(СтрокаПараметра.ТипПараметра));
	
	Если ВРег(ПолучитьБазовоеИмяПараметраПоПадежномуСуффиксу(ИмяПараметра)) = "АРЕНДАТОР" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ТипПараметраСтрокой = "Число" ИЛИ ТипПараметраСтрокой = "Дата" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для Каждого ЧастьТипа Из ПолучитьЧастиТипаПользовательскогоПараметра(СтрокаПараметра.ТипПараметра) Цикл
		
		Если ЧастьТипа = "Число" ИЛИ ЧастьТипа = "Дата" Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЧастьТипа = "Строка"
			ИЛИ ЧастьТипа = "Справочник.бит_Проживающие"
			ИЛИ ЧастьТипа = "Справочник.ФизическиеЛица" Тогда
			Возврат Истина;
		КонецЕсли;
		
	КонецЦикла;
	
	ПрефиксМетаданныхСправочника = "Справочник.";
	Если ЗначениеЗаполнено(ТипПараметраСтрокой)
		И Лев(ТипПараметраСтрокой, СтрДлина(ПрефиксМетаданныхСправочника)) = ПрефиксМетаданныхСправочника
		И СтрНайти(ТипПараметраСтрокой, ",") = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипПараметраСтрокой = "Строка" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Если ОбщегоНазначения.ЭтоСсылка(ТипЗнч(СтрокаПараметра.Значение)) Тогда
		ТипЗначения = ТипЗнч(СтрокаПараметра.Значение);
		Если ТипЗначения = Тип("СправочникСсылка.бит_Проживающие")
			ИЛИ ТипЗначения = Тип("СправочникСсылка.ФизическиеЛица") Тогда
			Возврат Истина;
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ТипПараметраСтрокой)
		И ТипЗнч(СтрокаПараметра.Значение) = Тип("Строка") Тогда
		Возврат Истина;
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции //HD-

//HD+
// Применяет падеж к строковому значению на форме через ПросклонятьФИО.
// При падеже КакЕсть (и Именительный) возвращает исходную строку без склонения.
//
&НаСервере
Функция ПрименитьПадежКСтроковомуЗначению(Знач ЗначениеСтрокой, Падеж)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ПадежТребуетСклоненияДляПечати(Падеж) Тогда
		Возврат СокрЛП(ЗначениеСтрокой);
	КонецЕсли;
	
	НомерПадежа = ПолучитьНомерПадежаДляСклонения(Падеж);
	
	Попытка
		РезультатСклонения = СклонениеПредставленийОбъектов.ПросклонятьФИО(ЗначениеСтрокой, НомерПадежа);
		Если ЗначениеЗаполнено(РезультатСклонения) Тогда
			Возврат СокрЛП(РезультатСклонения);
		КонецЕсли;
	Исключение
		// Оставляем исходное представление
	КонецПопытки;
	
	Возврат СокрЛП(ЗначениеСтрокой);
	
КонецФункции //HD-

//HD+
// Формирует соответствие: ключ = имя параметра (без скобок), значение = введенное значение.
// Если значение параметра пустое, возвращает плейсхолдер [ИмяПараметра], чтобы он восстановился в тексте.
//
&НаСервере
Функция ПолучитьСоответствиеПользовательскихПараметров()
	
	Результат = Новый Соответствие;
	
	Если Объект.ПользовательскиеПараметры.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		
		ИмяПараметра = СокрЛП(Строка(СтрокаПараметра.Параметр));
		ПутьСвязиПараметра = СокрЛП(Строка(СтрокаПараметра.ОбъектДляСвязи));
		
		//HD+ Составные параметры органов собрания — всегда пересобираем из ТЧ
		Если ЭтоИмяИлиПутьСпискаПредложенныхЧленовСовета(ИмяПараметра, ПутьСвязиПараметра) Тогда
			ЗначениеПараметра = СформироватьСписокПредложенныхЧленовСовета();
			СтрокаПараметра.Значение = ЗначениеПараметра;
		ИначеЕсли ЭтоИмяИлиПутьПредложенногоПредседателя(ИмяПараметра, ПутьСвязиПараметра) Тогда
			ЗначениеПараметра = СформироватьПредложенногоПредседателя();
			СтрокаПараметра.Значение = ЗначениеПараметра;
		Иначе
			ЗначениеПараметра = ПредставлениеЗначенияПользовательскогоПараметраДляПечати(СтрокаПараметра);
			
			// Применяем склонение к значению параметра для отображения на форме в повестке дня
			Если НужноСклонятьЗначениеПользовательскогоПараметра(СтрокаПараметра)
				И ПадежТребуетСклоненияДляПечати(СтрокаПараметра.Падеж) Тогда
				ЗначениеПараметра = ПрименитьПадежКСтроковомуЗначению(ЗначениеПараметра, СтрокаПараметра.Падеж);
			КонецЕсли;
			
			//HD+ В шаблонах повестки адрес часто содержит слово «Улица» (например, МКД_Улица из Объект.МКД_Улица)
			ЗначениеПараметра = УбратьСловоУлицаИзСтрокиАдресаДляПечати(ЗначениеПараметра);
		КонецЕсли;
		//HD-
		
		Если ЗначениеЗаполнено(ИмяПараметра) Тогда
			Если Результат.Получить(ИмяПараметра) = Неопределено Тогда
				Если ЗначениеЗаполнено(ЗначениеПараметра) Тогда
					Результат.Вставить(ИмяПараметра, ЗначениеПараметра);
				Иначе
					Результат.Вставить(ИмяПараметра, "[" + ИмяПараметра + "]");
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Признак заполненности параметра для опционального блока [?Имя]…[/?Имя].
// Пустое значение на форме представлено плейсхолдером [Имя].
//
&НаСервере
Функция ПараметрЗаполненДляОпциональногоБлока(Знач ИмяПараметра, СоответствиеПараметров)
	
	ИмяПараметра = СокрЛП(Строка(ИмяПараметра));
	Если НЕ ЗначениеЗаполнено(ИмяПараметра) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если СоответствиеПараметров = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ЗначениеПараметра = СоответствиеПараметров.Получить(ИмяПараметра);
	Если ЗначениеПараметра = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Строка(ЗначениеПараметра) = "[" + ИмяПараметра + "]" Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции //HD-

//HD+
// Обрабатывает опциональные фрагменты вида [?ИмяПараметра]…[/?ИмяПараметра]:
// при заполненном параметре оставляет содержимое блока, при пустом — удаляет блок целиком.
//
&НаСервере
Функция ОбработатьОпциональныеБлокиПараметровВТексте(Знач ИсходныйТекст, СоответствиеПараметров)
	
	Если НЕ ЗначениеЗаполнено(ИсходныйТекст) Тогда
		Возврат ИсходныйТекст;
	КонецЕсли;
	
	ТекстРезультат = Строка(ИсходныйТекст);
	ПрефиксОткрытия = "[?";
	СмещениеПоиска = 1;
	ЗащитаОтЗацикливания = 0;
	
	Пока ЗащитаОтЗацикливания < 1000 Цикл
		
		ЗащитаОтЗацикливания = ЗащитаОтЗацикливания + 1;
		
		ПозицияОткрытия = СтрНайти(ТекстРезультат, ПрефиксОткрытия, НаправлениеПоиска.СНачала, СмещениеПоиска);
		Если ПозицияОткрытия = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПозицияПослеПрефикса = ПозицияОткрытия + СтрДлина(ПрефиксОткрытия);
		ПозицияКонцаИмени = СтрНайти(ТекстРезультат, "]", НаправлениеПоиска.СНачала, ПозицияПослеПрефикса);
		Если ПозицияКонцаИмени = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ИмяПараметра = СокрЛП(Сред(ТекстРезультат, ПозицияПослеПрефикса, ПозицияКонцаИмени - ПозицияПослеПрефикса));
		Если НЕ ЗначениеЗаполнено(ИмяПараметра) ИЛИ Лев(ИмяПараметра, 1) = "/" Тогда
			СмещениеПоиска = ПозицияОткрытия + 1;
			Продолжить;
		КонецЕсли;
		
		МаркерОткрытия = "[?" + ИмяПараметра + "]";
		МаркерЗакрытия = "[/?" + ИмяПараметра + "]";
		
		Если Сред(ТекстРезультат, ПозицияОткрытия, СтрДлина(МаркерОткрытия)) <> МаркерОткрытия Тогда
			СмещениеПоиска = ПозицияОткрытия + 1;
			Продолжить;
		КонецЕсли;
		
		ПозицияЗакрытия = СтрНайти(ТекстРезультат, МаркерЗакрытия, НаправлениеПоиска.СНачала,
			ПозицияОткрытия + СтрДлина(МаркерОткрытия));
		Если ПозицияЗакрытия = 0 Тогда
			СмещениеПоиска = ПозицияОткрытия + 1;
			Продолжить;
		КонецЕсли;
		
		ПозицияНачалаСодержимого = ПозицияОткрытия + СтрДлина(МаркерОткрытия);
		СодержимоеБлока = Сред(ТекстРезультат, ПозицияНачалаСодержимого, ПозицияЗакрытия - ПозицияНачалаСодержимого);
		
		Если ПараметрЗаполненДляОпциональногоБлока(ИмяПараметра, СоответствиеПараметров) Тогда
			ТекстЗамены = СодержимоеБлока;
		Иначе
			ТекстЗамены = "";
		КонецЕсли;
		
		ТекстРезультат = Лев(ТекстРезультат, ПозицияОткрытия - 1)
			+ ТекстЗамены
			+ Сред(ТекстРезультат, ПозицияЗакрытия + СтрДлина(МаркерЗакрытия));
		
		СмещениеПоиска = ПозицияОткрытия;
		
	КонецЦикла;
	
	Возврат ТекстРезультат;
	
КонецФункции //HD-

//HD+
// Подставляет значения параметров в текст. Плейсхолдеры в тексте имеют вид: [ИмяПараметра].
// Сначала обрабатываются опциональные блоки [?Имя]…[/?Имя].
//
&НаСервере
Функция ПодставитьПользовательскиеПараметрыВТекст(Текст, СоответствиеПараметров)
	
	Результат = Текст;
	
	Если НЕ ЗначениеЗаполнено(Результат) Тогда
		Возврат Результат;
	КонецЕсли;
	
	Результат = ОбработатьОпциональныеБлокиПараметровВТексте(Результат, СоответствиеПараметров);
	
	Если СоответствиеПараметров = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Для Каждого Пара Из СоответствиеПараметров Цикл
		Плейсхолдер = "[" + Пара.Ключ + "]";
		Результат = СтрЗаменить(Результат, Плейсхолдер, Пара.Значение);
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //HD-

#КонецОбласти

