	|	СписокФизЛиц.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	ГражданствоФизЛицСрезПоследних.Страна КАК Гражданство,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан КАК ПаспортКемВыдан,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи КАК ПаспортДатаВыдачи,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия КАК ПаспортСерия,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер КАК ПаспортНомер,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира КАК Квартира,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид,
	|	бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы.ДатаДокумента КАК ПравоустанавливающиеДокументыДата,
	|	ВоинскийУчетФизЛицСрезПоследних.ОтношениеКВоинскойОбязанности,
	|	ВоинскийУчетФизЛицСрезПоследних.ОтметкаОПриемеНаВоинскийУчетИСнятииСВоинскогоУчета,
	|	ВоинскийУчетФизЛицСрезПоследних.КогдаПринятНаВоинскийУчетИлиСнятСВоинскогоУчета,
	|	ВоинскийУчетФизЛицСрезПоследних.КемПринятНаВоинскийУчетИлиСнятСВоинскогоУчета,
	|	ТрудоваяДеятельностьПроживающихФизЛицСрезПоследних.РодЗанятий,
	|	ТрудоваяДеятельностьПроживающихФизЛицСрезПоследних.МестоРаботы,
	|	ТрудоваяДеятельностьПроживающихФизЛицСрезПоследних.Должность,
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади
	|ИЗ
	|	СписокФизЛиц КАК СписокФизЛиц
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|				&Дата,
	|				ЛицевойСчет = &ЛицевойСчет
	|					И ФизЛицо В
	|						(ВЫБРАТЬ
	|							СписокФизЛиц.ФизЛицо КАК ФизЛицо
	|						ИЗ
	|							СписокФизЛиц КАК СписокФизЛиц)) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО СписокФизЛиц.ФизЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(
	|				&Дата,
	|				ФизЛицо В
	|					(ВЫБРАТЬ
	|						СписокФизЛиц.ФизЛицо КАК ФизЛицо
	|					ИЗ
	|						СписокФизЛиц КАК СписокФизЛиц)) КАК ГражданствоФизЛицСрезПоследних
	|		ПО СписокФизЛиц.ФизЛицо = ГражданствоФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(
	|				&Дата,
	|				ФизЛицо В
	|					(ВЫБРАТЬ
	|						СписокФизЛиц.ФизЛицо КАК ФизЛицо
	|					ИЗ
	|						СписокФизЛиц КАК СписокФизЛиц)) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО СписокФизЛиц.ФизЛицо = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ВоинскийУчет.СрезПоследних(
	|				&Дата,
	|				ФизЛицо В
	|					(ВЫБРАТЬ
	|						СписокФизЛиц.ФизЛицо КАК ФизЛицо
	|					ИЗ
	|						СписокФизЛиц КАК СписокФизЛиц)) КАК ВоинскийУчетФизЛицСрезПоследних
	|		ПО СписокФизЛиц.ФизЛицо = ВоинскийУчетФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ТрудоваяДеятельностьПроживающих.СрезПоследних(
	|				&Дата,
	|				ФизЛицо В
	|					(ВЫБРАТЬ
	|						СписокФизЛиц.ФизЛицо КАК ФизЛицо
	|					ИЗ
	|						СписокФизЛиц КАК СписокФизЛиц)) КАК ТрудоваяДеятельностьПроживающихФизЛицСрезПоследних
	|		ПО СписокФизЛиц.ФизЛицо = ТрудоваяДеятельностьПроживающихФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ДопСведенияОПроживающих.СрезПоследних(
	|				&Дата,
	|				Проживающий В
	|					(ВЫБРАТЬ
	|						СписокФизЛиц.ФизЛицо КАК ФизЛицо
	|					ИЗ
	|						СписокФизЛиц КАК СписокФизЛиц)) КАК бит_ДопСведенияОПроживающихСрезПоследних
	|		ПО СписокФизЛиц.ФизЛицо = бит_ДопСведенияОПроживающихСрезПоследних.Проживающий";	
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	// БИТ_ЖКХ добавление кода Начало: 26.06.2012 
	Если  мСписокФизЛиц =Неопределено Тогда
		мСписокФизЛиц = СписокПроживающих();
	КонецЕсли;
	// БИТ_ЖКХ добавление кода конец : 26.06.2012
	Запрос.УстановитьПараметр("СписокФизЛиц", мСписокФизЛиц);//.ВыгрузитьКолонку("ФизическоеЛицо"));
	
	ТаблицаПроживающих = Запрос.Выполнить().Выгрузить();
	Возврат ТаблицаПроживающих;
	
КонецФункции // ФормироватьСписокПроживающих()

// Функция формирует список физ лиц, когда-либо прописанных на ЛС (ВесьСписок = Ложь).
// Либо тех, кто прописан на момент даты документа (ВесьСписок = Истина).
Функция  СписокПроживающих() Экспорт 
	
	// БИТ_ЖКХ изменения кода . Начало: 06.06.2012
	Если ЗначениеЗаполнено(Проживающий) Тогда
		Условие = " ГДЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = &ФизЛицо";
	Иначе
		Условие = "";
	КонецЕсли; 
	
	Если НЕ ИсторияПроживающих Тогда
		Если ЗначениеЗаполнено(Проживающий)Тогда
			Условие = Условие + " И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
		Иначе
			Условие = "	ГДЕ (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
		КонецЕсли;
	КонецЕсли;
	
	
	ТекстЗапроса = 
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Фамилия, """") КАК Фамилия,
	|	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Имя, """") КАК Имя,
	|	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Отчество, """") КАК Отчество
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Дата, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо" + Условие + "";
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Если ЗначениеЗаполнено(Проживающий) Тогда
		Запрос.УстановитьПараметр("ФизЛицо", Проживающий);
	КонецЕсли; 
	
	мСписокФизЛиц = Запрос.Выполнить().Выгрузить();
	
	Возврат мСписокФизЛиц;   
	// БИТ_ЖКХ изменения кода . Конец  06.06.2012
	
КонецФункции // СписокПроживающих()

// Функция формирует список адресов прибытия и убытия.                  
Функция АдресаПрибытияУбытия(Дата, ЛицевойСчет)
	
	СтрокаОткудаПрибыл	 = "";
	СтрокаКудаУбыл		 = "";
	Если НЕ ИсторияПрописки Тогда
		
		условие = " УБЫВ";
		
	Иначе
		
		условие = "";
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;                            
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СписокФизЛиц.ФизЛицо
	|ПОМЕСТИТЬ СписокФизЛиц
	|ИЗ
	|	&СписокФизЛиц КАК СписокФизЛиц
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛС.Период КАК Период,
	|	СписокФизЛиц.ФизЛицо,
	|	бит_ПроживающиеПоЛС.ЛицевойСчет,
	|	бит_ПроживающиеПоЛС.СтатусФизЛица,
	|	бит_ПроживающиеПоЛС.ДатаПрибытия,
	|	бит_ПроживающиеПоЛС.ОткудаПрибыл,
	|	бит_ПроживающиеПоЛС.ПричинаПрописки,
	|	бит_ПроживающиеПоЛС.ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛС.ДатаЗаписи КАК ДатаОкончанияСтатуса,
	|	бит_ПроживающиеПоЛС.ПричинаВыписки,
	|	бит_ПроживающиеПоЛС.КудаВыписан,
	|	бит_ПроживающиеПоЛС.СтатусПроживания,
	|	бит_ПроживающиеПоЛС.ДатаРегистрации
	|ИЗ
	|	СписокФизЛиц КАК СписокФизЛиц
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
	|		ПО СписокФизЛиц.ФизЛицо = бит_ПроживающиеПоЛС.ФизЛицо
	|ГДЕ
	|	бит_ПроживающиеПоЛС.ЛицевойСчет = &ЛицевойСчет
	|	И бит_ПроживающиеПоЛС.Период <= &Дата
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период"+условие + "";
	
	Запрос.УстановитьПараметр("Дата", КонецДня(Дата));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("СписокФизЛиц", мСписокФизЛиц);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	
	ТаблицаДанных.Колонки.Добавить("ФизЛицо" ,,"ФизЛицо");
	ТаблицаДанных.Колонки.Добавить("КогдаИОткудаПрибыл" ,,"КогдаИОткудаПрибыл");
	ТаблицаДанных.Колонки.Добавить("СтатусПроживания" ,,"СтатусПроживания");
	ТаблицаДанных.Колонки.Добавить("ДатаРегистрации" ,,"ДатаРегистрации");
	ТаблицаДанных.Колонки.Добавить("КудаВыписан" ,,"КудаВыписан");
	ТаблицаДанных.Колонки.Добавить("ДатаПрибытия" ,,"ДатаПрибытия");
	ТаблицаДанных.Колонки.Добавить("ДатаСнятияСРегистрации" ,,"ДатаСнятияСРегистрации");
	
	Для каждого ФизЛицо Из мСписокФизЛиц Цикл
		Отбор = Новый Структура();
		Отбор.Вставить("ФизЛицо",ФизЛицо.ФизЛицо);
		РезультатФизЛ = Результат.НайтиСтроки(Отбор);
		
		КогдаИОткудаПрибыл 	= "";
		КудаВыписан			= "";
		СтатусПроживания 	= "";
		КолвоЗаписей 		= РезультатФизЛ.Количество();
		
		Если ИсторияПрописки Тогда
			
			Если КолвоЗаписей > 0 Тогда
				
				ДатаСравнения = РезультатФизЛ[0].ДатаРегистрации;
				НоваяСтрока = ТаблицаДанных.Добавить();
				
			КонецЕсли; 
			
			Для каждого Строка Из РезультатФизЛ Цикл
				КолвоЗаписей = КолвоЗаписей - 1;
				Если ДатаСравнения = Строка.ДатаРегистрации И КолвоЗаписей >= 0 Тогда
					
					// БИТ_ЖКХ 13.01.2015{{
					// Если НЕ ЗначениеЗаполнено(СтатусПроживания) Тогда.            
					СтатусПроживания = Строка.СтатусПроживания;
					// КонецЕсли;.
					// БИТ_ЖКХ 13.01.2015}}
					
					Если ЗначениеЗаполнено(Строка.ДатаСнятияСРегистрации) Тогда
						
						ДатаСнятияСРегистрации = Строка.ДатаСнятияСРегистрации;
						
					Иначе
						
						ДатаСнятияСРегистрации = Строка.ДатаОкончанияСтатуса;
						
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(КудаВыписан) Тогда
						
						КудаВыписан =  КудаВыписан
						+ ?(ЗначениеЗаполнено(ДатаСнятияСРегистрации),Формат(ДатаСнятияСРегистрации,"ДФ=dd.MM.yyyy")+ ", ","")
						+ ?(ЗначениеЗаполнено(Строка.ПричинаВыписки),Строка(Строка.ПричинаВыписки)+ " ","")
						+ ?(ЗначениеЗаполнено(Строка.КудаВыписан),Строка(Строка.КудаВыписан),"");
						Если ЗначениеЗаполнено(КудаВыписан) Тогда
							
							КудаВыписан = "Вып." + КудаВыписан;
							
						КонецЕсли; 
						
					Иначе
						НовыеДанные = ?(ЗначениеЗаполнено(ДатаСнятияСРегистрации),Формат(ДатаСнятияСРегистрации,"ДФ=dd.MM.yyyy")+ ", ","")
						+ ?(ЗначениеЗаполнено(Строка.ПричинаВыписки),Строка(Строка.ПричинаВыписки)+ " ","")
						+ ?(ЗначениеЗаполнено(Строка.КудаВыписан),Строка(Строка.КудаВыписан),"");
						Если ЗначениеЗаполнено(НовыеДанные) Тогда
							
							КудаВыписан =  КудаВыписан + Символы.ПС + "Вып."+ НовыеДанные;
							
						КонецЕсли; 
						
					КонецЕсли; 
					
					Если НЕ ЗначениеЗаполнено(КогдаИОткудаПрибыл) Тогда
						
						КогдаИОткудаПрибыл =  КогдаИОткудаПрибыл
						+ ?(ЗначениеЗаполнено(Строка.ДатаРегистрации),Формат(Строка.ДатаРегистрации,"ДФ=dd.MM.yyyy")+ ", ","")
						+ ?(ЗначениеЗаполнено(Строка.ОткудаПрибыл),Строка(Строка.ОткудаПрибыл)+ ",","")
						+ ?(ЗначениеЗаполнено(Строка.ПричинаПрописки),Строка(Строка.ПричинаПрописки),"");
						
					КонецЕсли; 
				КонецЕсли; 
				
				Если (ДатаСравнения <> Строка.ДатаРегистрации И КолвоЗаписей > 0) ИЛИ (ДатаСравнения = Строка.ДатаРегистрации И КолвоЗаписей = 0)Тогда 
					НоваяСтрока.ДатаРегистрации 	= ДатаСравнения;
					
					Если СтатусПроживания = Перечисления.бит_СтатусПроживания.Постоянно Тогда
						
						НоваяСтрока.СтатусПроживания 	= "Пост.";
						
						
					ИначеЕсли СтатусПроживания = Перечисления.бит_СтатусПроживания.Временно Тогда
						
						НоваяСтрока.СтатусПроживания 	= "Врем.";
						
					Иначе 	
						НоваяСтрока.СтатусПроживания 	= Строка(СтатусПроживания);
						
					КонецЕсли; 
					НоваяСтрока.КогдаИОткудаПрибыл	 	= КогдаИОткудаПрибыл;
					НоваяСтрока.КудаВыписан		 		= КудаВыписан;
					НоваяСтрока.ФизЛицо		 			= ФизЛицо.ФизЛицо;
					НоваяСтрока.ДатаПрибытия			= Строка.ДатаПрибытия;
					НоваяСтрока.ДатаСнятияСРегистрации	= ДатаСнятияСРегистрации;
					
					Если КолвоЗаписей <> 0 Тогда
						
						НоваяСтрока = ТаблицаДанных.Добавить();
						ДатаСравнения = Строка.ДатаРегистрации;
						
					КонецЕсли; 
					
				КонецЕсли; 
				
			КонецЦикла;
		Иначе
			
			Если КолвоЗаписей > 0 Тогда
				Отбор = Новый Структура;
				Отбор.Вставить("ФизЛицо",ФизЛицо.ФизЛицо);
				Отбор.Вставить("ДатаРегистрации",РезультатФизЛ[0].ДатаРегистрации);
				ТаблицаСтрок = Результат.НайтиСтроки(Отбор);
				Если ТаблицаСтрок.Количество()>0 Тогда
					
					НоваяСтрока = ТаблицаДанных.Добавить();
					ОткудаПрибыл 			= "";
					КогдаИОткудаПрибыл 		= "";
					КудаУбыл 				= "";
					КудаВыписан 			= "";
					ДатаРегистрации     	= ТаблицаСтрок[0].ДатаРегистрации;
					СтатусПроживания		= "";
					ДатаПрибытия        	= ТаблицаСтрок[0].ДатаПрибытия;
					ДатаСнятияСРегистрации 	= ТаблицаСтрок[0].ДатаСнятияСРегистрации;
					
					Для каждого Строка Из ТаблицаСтрок Цикл
						КудаУбыл = КудаУбыл 
						+ ?(ЗначениеЗаполнено(Строка.ПричинаВыписки),Строка(Строка.ПричинаВыписки)+ " ","")
						+ ?(ЗначениеЗаполнено(Строка.КудаВыписан),Строка(Строка.КудаВыписан),"");
						Если ЗначениеЗаполнено(КудаУбыл) Тогда
							Если НЕ ЗначениеЗаполнено(КудаВыписан) Тогда
								ДатаПрибытия = Строка.ДатаПрибытия;
								КудаВыписан = КудаВыписан 
								+ ?(ЗначениеЗаполнено(Строка.ДатаСнятияСРегистрации),Формат(Строка.ДатаСнятияСРегистрации,"ДФ=dd.MM.yyyy")+ ", ","")
								+ КудаУбыл;
								Прервать;
							иначе
								Прервать; 
							КонецЕсли; 
						КонецЕсли; 
					КонецЦикла; 
					
				КонецЕсли; 
				
				Индекс = ТаблицаСтрок.Количество() - 1 ;
				Пока Индекс >= 0 Цикл
					Строка = ТаблицаСтрок[Индекс];
					ОткудаПрибыл = ОткудаПрибыл
					+ ?(ЗначениеЗаполнено(Строка.ОткудаПрибыл),Строка(Строка.ОткудаПрибыл)+ ",","")
					+ ?(ЗначениеЗаполнено(Строка.ПричинаПрописки),Строка(Строка.ПричинаПрописки),"");
					
					СтатусПроживания = Строка(Строка.СтатусПроживания);
					Если  ЗначениеЗаполнено(ОткудаПрибыл) Тогда
						Если НЕ ЗначениеЗаполнено(КогдаИОткудаПрибыл) Тогда
							
							КогдаИОткудаПрибыл =  КогдаИОткудаПрибыл
							+ ?(ЗначениеЗаполнено(Строка.ДатаРегистрации),Формат(Строка.ДатаРегистрации,"ДФ=dd.MM.yyyy")+ ", ","")
							+ ОткудаПрибыл;
							Прервать;
						Иначе
							Прервать;
						КонецЕсли; 	
						
					КонецЕсли; 
					
					Индекс = Индекс - 1;
					
				КонецЦикла; 
				
				НоваяСтрока.КогдаИОткудаПрибыл 		= КогдаИОткудаПрибыл;
				НоваяСтрока.СтатусПроживания 		= СтатусПроживания;
				НоваяСтрока.ДатаРегистрации 		= ДатаРегистрации;
				НоваяСтрока.КудаВыписан 			= КудаВыписан;
				НоваяСтрока.ФизЛицо 				= ФизЛицо.ФизЛицо;
				НоваяСтрока.ДатаПрибытия			= ДатаПрибытия;
				НоваяСтрока.ДатаСнятияСРегистрации	= ДатаСнятияСРегистрации;
				
			КонецЕсли; 
			
		КонецЕсли; 
	КонецЦикла;
	Возврат ТаблицаДанных;
	
КонецФункции

// БИТ_ЖКХ добавление кода Начало: 14.06.2012 
// Список всех владельцев жилья.
Функция СписокВладельцев()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	ЕСТЬNULL(бит_ФИОПроживающихСрезПоследних.Фамилия + "" "" + бит_ФИОПроживающихСрезПоследних.Имя + "" "" + бит_ФИОПроживающихСрезПоследних.Отчество, бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади,
	|	бит_ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы.ДатаДокумента КАК ПравоустанавливающиеДокументыДата
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	// БИТ_ЖКХ 21.03.2017 11:55:42 Начало правки... 
	|ГДЕ
	|	НЕ бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица = ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.Выписан)";
	// БИТ_ЖКХ 21.03.2017 11:55:43 Конец правки. 
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Момент", Дата);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции
// БИТ_ЖКХ добавление кода конец : 14.06.2012

#КонецОбласти