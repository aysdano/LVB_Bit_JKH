// Процедура сохранения настроек отбора.
//
// Параметры:
//  Нет.
//
Процедура СохранитьНастройкиОтбора()
	
	КлючОбъекта = "Обработка.бит_ПечатьСчетИзвещений.Форма.ФормаУправляемая/ТекущиеДанные";
	
	Настройка = ХранилищеСистемныхНастроек.Загрузить(КлючОбъекта);
	
	Если Настройка = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("СписокЛС");
	ЭлементыФормы.Добавить("СписокРайонов");
	ЭлементыФормы.Добавить("СписокУчастков");
	ЭлементыФормы.Добавить("СписокЗданий");
	ЭлементыФормы.Добавить("СписокУлиц");
	
	Если НЕ Объект.ОчищатьОтборы Тогда
		
		Для каждого Элемент Из ЭлементыФормы Цикл
			Настройка.Вставить(Элемент, Объект[Элемент].Выгрузить());
		КонецЦикла;
		
	Иначе 
		
		Для каждого Элемент Из ЭлементыФормы Цикл
			Настройка.Удалить(Элемент);
		КонецЦикла;
		
	КонецЕсли;
	
	Настройка.Вставить("ТаблицаРеквизитовQRКода", Объект.ТаблицаРеквизитовQRКода.Выгрузить());
	Настройка.Вставить("Объект.БезПрефиксаНежилогоПомещения", Объект.БезПрефиксаНежилогоПомещения);
	
	ХранилищеСистемныхНастроек.Сохранить(КлючОбъекта,,Настройка);
	
КонецПроцедуры 

