&НаКлиенте
Процедура УстановкаОтбора(ОтборОбъект,ЭлементОтбора, ЗначениеОтбора)
	
	ОтборОбъект.Отбор.Элементы.очистить();
	
	Эл = ОтборОбъект.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
	
	Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных(ЭлементОтбора);
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.ПравоеЗначение   = ЗначениеОтбора;
	Эл.Использование    = ?(ЗначениеЗаполнено(ЗначениеОтбора),Истина,Ложь);
	
	Если Эл.Использование Тогда
		
		Эл.ПравоеЗначение      = ЗначениеОтбора;
		
	КонецЕсли; 
	
