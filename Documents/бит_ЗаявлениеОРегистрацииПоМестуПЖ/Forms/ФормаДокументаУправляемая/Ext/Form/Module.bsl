						ШапкаОбласть.Параметры.РайонВыб 		  = СтруктураКудаВыбыл.Район;
						ШапкаОбласть.Параметры.НаселенныйПунктВыб = СтруктураКудаВыбыл.НаселенныйПункт;
						ШапкаОбласть.Параметры.УлицаВыб           = СтруктураКудаВыбыл.Улица;	
						ШапкаОбласть.Параметры.ДомВыб             = СтруктураКудаВыбыл.Дом;
						ШапкаОбласть.Параметры.КорпусВыб          = СтруктураКудаВыбыл.Корпус;
						ШапкаОбласть.Параметры.КвартираВыб        = СтруктураКудаВыбыл.Квартира;
						
