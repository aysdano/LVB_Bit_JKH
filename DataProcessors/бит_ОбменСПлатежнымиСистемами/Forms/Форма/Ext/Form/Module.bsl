				НоваяСтрока = НоваяСтрока + ?(ПоследСтрока И НЕ сг_ЗаканчиватьСтрокуСимволом,"",СимволРазделения);
				
			КонецЦикла;
			
			Текст.ДобавитьСтроку(НоваяСтрока);
			
		КонецЦикла; 
	КонецЦикла;
		
КонецПроцедуры

&НаСервере
Функция ПолучитьСчетчики()
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Параметры.Вставить("КонецПериода"	, КонецМесяца(Объект.сг_КонецПериода));
	ПостроительЗапроса.Параметры.Вставить("Организация"		, Объект.Организация);
	
	ПостроительЗапроса.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ПОМЕСТИТЬ ВТ_ЛицевыеСчета
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И бит_ЛицевыеСчета.Организация = &Организация
	|{ГДЕ
	|	бит_ЛицевыеСчета.Ссылка.* КАК ОтборЛС}
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект КАК ЛицевойСчет,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга КАК Услуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик КАК Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный КАК Многотарифный
	|ПОМЕСТИТЬ ВТ_ДанныеУстановкиПУ
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&КонецПериода,
	|			Объект В
	|				(ВЫБРАТЬ
	|					ВТ_ЛицевыеСчета.ЛицевойСчет
	|				ИЗ
	|					ВТ_ЛицевыеСчета КАК ВТ_ЛицевыеСчета)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|	И бит_СчетчикиНаУслугахОбщийСрезПоследних.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
	|{ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга.* КАК ОтборУслуга}
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	Услуга,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ПоказанияСчетчиковОстатки.Объект КАК ЛицевойСчет,
	|	бит_ПоказанияСчетчиковОстатки.Услуга КАК Услуга,
	|	бит_ПоказанияСчетчиковОстатки.Счетчик КАК Счетчик,
	|	бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток КАК ПоследниеПоказания
	|ПОМЕСТИТЬ ВТ_Показания
	|ИЗ
	|	РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
	|			&КонецПериода,
	|			(Объект, Счетчик, Услуга) В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ВТ_ДанныеУстановкиПУ.ЛицевойСчет,
	|					ВТ_ДанныеУстановкиПУ.Счетчик,
	|					ВТ_ДанныеУстановкиПУ.Услуга
	|				ИЗ
	|					ВТ_ДанныеУстановкиПУ КАК ВТ_ДанныеУстановкиПУ)) КАК бит_ПоказанияСчетчиковОстатки
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	Услуга,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеУстановкиПУ.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ДанныеУстановкиПУ.Счетчик КАК Счетчик,
	|	СУММА(1) КАК КолВоТарифов
	|ПОМЕСТИТЬ ВТ_Многотарифные
	|ИЗ
	|	ВТ_ДанныеУстановкиПУ КАК ВТ_ДанныеУстановкиПУ
	|ГДЕ
	|	ВТ_ДанныеУстановкиПУ.Многотарифный
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ДанныеУстановкиПУ.ЛицевойСчет,
	|	ВТ_ДанныеУстановкиПУ.Счетчик
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ДанныеУстановкиПУ.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ДанныеУстановкиПУ.Счетчик КАК Счетчик,
	|	бит_УслугиЖКХ.Приоритет КАК Приоритет,
	|	ВТ_ДанныеУстановкиПУ.Услуга КАК Услуга,
	|	ВТ_ДанныеУстановкиПУ.Многотарифный КАК Многотарифный,
	|	ЕСТЬNULL(ВТ_Многотарифные.КолВоТарифов, 1) КАК КолВоТарифов,
	|	ЕСТЬNULL(ВТ_Показания.ПоследниеПоказания, 0) КАК ПоследниеПоказания
	|ПОМЕСТИТЬ ВТ_ВсеСчетчики
	|ИЗ
	|	ВТ_ДанныеУстановкиПУ КАК ВТ_ДанныеУстановкиПУ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	|		ПО ВТ_ДанныеУстановкиПУ.Услуга = бит_УслугиЖКХ.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Многотарифные КАК ВТ_Многотарифные
	|		ПО ВТ_ДанныеУстановкиПУ.ЛицевойСчет = ВТ_Многотарифные.ЛицевойСчет
	|			И ВТ_ДанныеУстановкиПУ.Счетчик = ВТ_Многотарифные.Счетчик
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Показания КАК ВТ_Показания
	|		ПО ВТ_ДанныеУстановкиПУ.ЛицевойСчет = ВТ_Показания.ЛицевойСчет
	|			И ВТ_ДанныеУстановкиПУ.Услуга = ВТ_Показания.Услуга
	|			И ВТ_ДанныеУстановкиПУ.Счетчик = ВТ_Показания.Счетчик
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	Счетчик,
	|	Приоритет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеСчетчики.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ВсеСчетчики.Счетчик КАК Счетчик,
	|	МИНИМУМ(ВТ_ВсеСчетчики.Приоритет) КАК Приоритет
	|ПОМЕСТИТЬ ВТ_ПриоритетОднотарифный
	|ИЗ
	|	ВТ_ВсеСчетчики КАК ВТ_ВсеСчетчики
	|ГДЕ
	|	НЕ ВТ_ВсеСчетчики.Многотарифный
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ВсеСчетчики.ЛицевойСчет,
	|	ВТ_ВсеСчетчики.Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПриоритетОднотарифный.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ПриоритетОднотарифный.Счетчик КАК Счетчик,
	|	ВТ_ПриоритетОднотарифный.Приоритет КАК Приоритет,
	|	ВТ_ВсеСчетчики.Услуга КАК Услуга,
	|	ВТ_ВсеСчетчики.КолВоТарифов КАК КолВоТарифов,
	|	ВТ_ВсеСчетчики.ПоследниеПоказания КАК ПоследниеПоказания
	|ПОМЕСТИТЬ ВТ_ИтогОднотарифные
	|ИЗ
	|	ВТ_ПриоритетОднотарифный КАК ВТ_ПриоритетОднотарифный
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ВсеСчетчики КАК ВТ_ВсеСчетчики
	|		ПО ВТ_ПриоритетОднотарифный.ЛицевойСчет = ВТ_ВсеСчетчики.ЛицевойСчет
	|			И ВТ_ПриоритетОднотарифный.Счетчик = ВТ_ВсеСчетчики.Счетчик
	|			И ВТ_ПриоритетОднотарифный.Приоритет = ВТ_ВсеСчетчики.Приоритет
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	Счетчик,
	|	Приоритет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеСчетчики.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ВсеСчетчики.Счетчик КАК Счетчик,
	|	ВТ_ВсеСчетчики.Приоритет КАК Приоритет,
	|	ВТ_ВсеСчетчики.Услуга КАК Услуга,
	|	ВТ_ВсеСчетчики.КолВоТарифов КАК КолВоТарифов,
	|	ВТ_ВсеСчетчики.ПоследниеПоказания КАК ПоследниеПоказания
	|ПОМЕСТИТЬ ВТ_ИтогМноготарифные
	|ИЗ
	|	ВТ_ВсеСчетчики КАК ВТ_ВсеСчетчики
	|ГДЕ
	|	ВТ_ВсеСчетчики.Многотарифный
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	Счетчик,
	|	Приоритет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИтогОднотарифные.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ИтогОднотарифные.Счетчик КАК Счетчик,
	|	ВТ_ИтогОднотарифные.Приоритет КАК Приоритет,
	|	ВТ_ИтогОднотарифные.Услуга КАК Услуга,
	|	ВТ_ИтогОднотарифные.КолВоТарифов КАК КолВоТарифов,
	|	ВТ_ИтогОднотарифные.ПоследниеПоказания КАК ПоследниеПоказания
	|ПОМЕСТИТЬ ВТ_ИтоговаяТаблица
	|ИЗ
	|	ВТ_ИтогОднотарифные КАК ВТ_ИтогОднотарифные
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ВТ_ИтогМноготарифные.ЛицевойСчет,
	|	ВТ_ИтогМноготарифные.Счетчик,
	|	ВТ_ИтогМноготарифные.Приоритет,
	|	ВТ_ИтогМноготарифные.Услуга,
	|	ВТ_ИтогМноготарифные.КолВоТарифов,
	|	ВТ_ИтогМноготарифные.ПоследниеПоказания
	|ИЗ
	|	ВТ_ИтогМноготарифные КАК ВТ_ИтогМноготарифные
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ИтоговаяТаблица.ЛицевойСчет КАК ЛицевойСчет,
	|	КОЛИЧЕСТВО(ВТ_ИтоговаяТаблица.Счетчик) КАК КолВоСчетчиков
	|ПОМЕСТИТЬ ВТ_КолвоСчетчиков
	|ИЗ
	|	ВТ_ИтоговаяТаблица КАК ВТ_ИтоговаяТаблица
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ИтоговаяТаблица.ЛицевойСчет
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КолвоСчетчиков.КолВоСчетчиков КАК КолВоСчетчиков,
	|	ВТ_ИтоговаяТаблица.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ИтоговаяТаблица.Счетчик КАК Счетчик,
	|	ВТ_ИтоговаяТаблица.Приоритет КАК Приоритет,
	|	ВТ_ИтоговаяТаблица.Услуга КАК Услуга,
	|	ВТ_ИтоговаяТаблица.КолВоТарифов КАК КолВоТарифов,
	|	бит_Счетчики.Наименование КАК НомерСчетчика,
	|	бит_Счетчики.ВидСчетчика КАК Тип,
	|	ВТ_ИтоговаяТаблица.ПоследниеПоказания КАК ПоследниеПоказания
	|ИЗ
	|	ВТ_ИтоговаяТаблица КАК ВТ_ИтоговаяТаблица
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Счетчики КАК бит_Счетчики
	|		ПО ВТ_ИтоговаяТаблица.Счетчик = бит_Счетчики.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КолвоСчетчиков КАК ВТ_КолвоСчетчиков
	|		ПО ВТ_ИтоговаяТаблица.ЛицевойСчет = ВТ_КолвоСчетчиков.ЛицевойСчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	КолВоСчетчиков УБЫВ,
	|	ЛицевойСчет,
	|	Счетчик,
	|	Приоритет";
	
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если Объект.ОтборЛицевыхСчетов.Количество() > 0 Тогда
		
		ТабЛС					= Объект.ОтборЛицевыхСчетов.Выгрузить();
		СписокЛС				= Новый СписокЗначений;
		СписокЛС.ЗагрузитьЗначения(ТабЛС.ВыгрузитьКолонку("ЛицевойСчет"));
		
		ОтборЛС					= ПостроительЗапроса.Отбор.Добавить("ОтборЛС");
		ОтборЛС.ВидСравнения	= УсловиеОтбора;
		ОтборЛС.Значение		= СписокЛС;
		ОтборЛС.Использование	= Истина;
	КонецЕсли;
	
	Если Объект.Услуги = "По выбору" 
		И Объект.ОтборУслуг.Количество() > 0 Тогда
		
		ТабУслуг				= Объект.ОтборУслуг.Выгрузить();
		СписокУслуг				= Новый СписокЗначений;
		СписокУслуг.ЗагрузитьЗначения(ТабУслуг.ВыгрузитьКолонку("Услуга"));
		
		ОтборУс					= ПостроительЗапроса.Отбор.Добавить("ОтборУслуга");
		ОтборУс.ВидСравнения	= УсловиеОтбораУслуг;
		ОтборУс.Значение		= СписокУслуг;
		ОтборУс.Использование	= Истина;
	КонецЕсли;
	
	ПостроительЗапроса.ВыбранныеПоля.Очистить();
	ПостроительЗапроса.ВыбранныеПоля.Добавить("КолВоСчетчиков");
	ПостроительЗапроса.ВыбранныеПоля.Добавить("ЛицевойСчет");
	ПостроительЗапроса.ВыбранныеПоля.Добавить("Услуга");
	ПостроительЗапроса.ВыбранныеПоля.Добавить("НомерСчетчика");
	ПостроительЗапроса.ВыбранныеПоля.Добавить("Тип");
	ПостроительЗапроса.ВыбранныеПоля.Добавить("ПоследниеПоказания");
	ПостроительЗапроса.Выполнить();
	
	Если ПостроительЗапроса.Результат.Пустой() Тогда
		Возврат Неопределено;
	КонецЕсли; 
	
	Возврат ПостроительЗапроса.Результат.Выгрузить();
	
КонецФункции

&НаСервере
Процедура ПрочитатьDBFФайлНаСервере(МассивОшибок, ПутьВоВременномХранилище, РазбивкаПоУслугам)
	
	ТекущийКаталог = КаталогВременныхФайлов();
	ПутьФайла = ТекущийКаталог + (Лев(Строка(Новый УникальныйИдентификатор()), 8)) + ".dbf";
	
	Попытка
		УдалитьФайлы(ПутьФайла);
	Исключение
	КонецПопытки;

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПутьВоВременномХранилище);
	Попытка
		ДвоичныеДанные.Записать(ПутьФайла);
	Исключение
		ТекстСообщения = НСтр("ru = 'Ошибка работы с файлом.'") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ".";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	XBase  = Новый XBase;
	XBase.Кодировка = КодировкаXBase[Кодировка];
	Попытка
		XBase.ОткрытьФайл(ПутьФайла);
	Исключение
		ТекстСообщенияОбОшибке = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПолныйТекстСообщенияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщенияОбОшибке);
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ПолныйТекстСообщенияОбОшибке);
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка открытия файла!");
		Попытка
			УдалитьФайлы(ПутьФайла);
		Исключение
		КонецПопытки;
		Возврат;
	КонецПопытки;

	КоличествоСтрок = XBase.КоличествоЗаписей();
	
	Если КоличествоСтрок = 0 Тогда
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл пуст!");
		Возврат;
	КонецЕсли; 

	СтруктураТипов = Новый Структура;
	СтруктураТипов.Вставить("Услуга"		   , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	СтруктураТипов.Вставить("ЛицевойСчет"	   , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	СтруктураТипов.Вставить("Сумма"			   , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	СтруктураТипов.Вставить("ДатаОплаты"	   , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	СтруктураТипов.Вставить("Комментарий"	   , ОбщегоНазначения.ОписаниеТипаСтрока(999));
	СтруктураТипов.Вставить("НазначениеПлатежа", ОбщегоНазначения.ОписаниеТипаСтрока(999));
	
	// БИТ ЖКХ 25.03.2021
	//если Объект.ШаблонЗагрузки = справочники.бит_ШаблоныЗагрузки.ШаблонДБФ тогда
	//  СтруктураТипов.Вставить("Счетчик"	   , ОбщегоНазначения.ОписаниеТипаСтрока(999));
	//  СтруктураТипов.Вставить("ЗначенияСчетчика", ОбщегоНазначения.ОписаниеТипаСтрока(999));	
	//конецесли;	
	
	ТаблицаОплаты = Новый ТаблицаЗначений;
	СоответствиеПозиций = Новый Соответствие;
	// Заполнение по шаблону.
	Если ЗначениеЗаполнено(Объект.ШаблонЗагрузки) Тогда
		ТаблицаШаблона = Объект.ШаблонЗагрузки.ПоляЗагрузки;
		Для Каждого Стр Из ТаблицаШаблона Цикл
			ТаблицаОплаты.Колонки.Добавить(Стр.ПолеОплатыКУ, СтруктураТипов[Стр.ПолеОплатыКУ]);
			СоответствиеПозиций.Вставить(Стр.НомерПозиции, Стр.ПолеОплатыКУ);
		КонецЦикла;
	// По умолчанию старая логика чтения.	
	Иначе
		ТаблицаОплаты.Колонки.Добавить("ЛицевойСчет"		 , СтруктураТипов.ЛицевойСчет);
		ТаблицаОплаты.Колонки.Добавить("Услуга"     		 , СтруктураТипов.Услуга);
		ТаблицаОплаты.Колонки.Добавить("Сумма"      		 , СтруктураТипов.Сумма);
		ТаблицаОплаты.Колонки.Добавить("ДатаОплаты"			 , СтруктураТипов.ДатаОплаты);
		
		СоответствиеПозиций.Вставить(3	, "ЛицевойСчет");
		СоответствиеПозиций.Вставить(4	, "Сумма");
		СоответствиеПозиций.Вставить(5	, "Услуга");
		СоответствиеПозиций.Вставить(10	, "ДатаОплаты");
	КонецЕсли;
	ТаблицаОплаты.Колонки.Добавить("СуммаСУчетомПроцента", СтруктураТипов.Сумма);
	
	ЕстьКолонкаКомменатрий = ?(ТаблицаОплаты.Колонки.Найти("Комментарий") = Неопределено, Ложь, Истина);
	ЕстьКолонкаНазначениеПлатежа = ?(ТаблицаОплаты.Колонки.Найти("НазначениеПлатежа") = Неопределено, Ложь, Истина);
	ЕстьКолонкаУслуга = ?(ТаблицаОплаты.Колонки.Найти("Услуга") = Неопределено, Ложь, Истина);
	
	Элементы.ДеревоОплатыКомментарий.Видимость = ЕстьКолонкаКомменатрий;
	Элементы.ДеревоОплатыНазначениеПлатежа.Видимость = ЕстьКолонкаНазначениеПлатежа;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Идентификатор = &Идентификатор";
	
	Номер = 0;
	СуммаКПеречислению = 0;
	НомерРеестра = 0;
	
	ТекущаяСтрока = 1;
	XBase.Первая();
	Пока Не XBase.ВКонце() Цикл
		
		НоваяСтрока = ТаблицаОплаты.Добавить();
		
		Для Каждого ПолеШаблона Из СоответствиеПозиций Цикл
			
			Если ЗначениеЗаполнено(ПолеШаблона.Ключ) Тогда
				ИндексПоля = ?(ПолеШаблона.Ключ-1 < 0, 0, ПолеШаблона.Ключ-1);
				ЗначениеПоля = XBase.ПолучитьЗначениеПоля(ИндексПоля);
				
				Если  ПолеШаблона.Значение = "ЛицевойСчет" Тогда // Поле содержащее ЛС.
					
					ЛицевойСчет = Неопределено;
					ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(СокрЛП(ЗначениеПоля), Истина);
					
					Если ЛицевойСчет.Пустая() Тогда
						
						Попытка
							Идентификатор =	 Число(ЗначениеПоля);
						Исключение
							Возврат;
						КонецПопытки;
						
						Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
						Выборка = Запрос.Выполнить().Выбрать();
						Если Выборка.Следующий() Тогда
							ЛицевойСчет = Выборка.ЛицевойСчет;
						КонецЕсли;
					КонецЕсли; 
					НоваяСтрока.ЛицевойСчет = ЛицевойСчет;
					
				ИначеЕсли  ПолеШаблона.Значение = "Сумма" Тогда // Поле содержащее сумму.
					
					Попытка
						НоваяСтрока.Сумма                = Окр(Число(ЗначениеПоля) * (1 - (Объект.Процент/100)),2);
						НоваяСтрока.СуммаСУчетомПроцента = Число(ЗначениеПоля);
					Исключение
					КонецПопытки; 
					
				ИначеЕсли ПолеШаблона.Значение = "Услуга" Тогда // Поле содержащее услугу.
					
					Услуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду(ЗначениеПоля);
					НоваяСтрока.Услуга = Услуга;
					
				ИначеЕсли  ПолеШаблона.Значение = "ДатаОплаты" Тогда // Поле содержащее дату оплаты.
					Попытка
						Дата = Дата("20"+Сред(ЗначениеПоля,9,2)+Сред(ЗначениеПоля,4,2)+Сред(ЗначениеПоля,0,2));
						НоваяСтрока.ДатаОплаты = Дата;
					Исключение
					КонецПопытки;
					
				Иначе
					
					НоваяСтрока[ПолеШаблона.Значение] = СокрЛП(ЗначениеПоля); // Комментарий и НазначениеПлатежа.
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		XBase.Следующая();
	КонецЦикла;
	
	Если XBase.Открыта() Тогда
		XBase.ЗакрытьФайл();
	КонецЕсли; 

	Попытка
		УдалитьФайлы(ПутьФайла);
	Исключение
	КонецПопытки;
	
	ТекстЗапрос = 
	"ВЫБРАТЬ
	|	Таблица.ДатаОплаты,
	|	Таблица.ЛицевойСчет,
	|	Таблица.Сумма,
	|	Таблица.СуммаСУчетомПроцента
	|ПОМЕСТИТЬ ТаблицаОплаты
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОплаты.ДатаОплаты КАК ДатаОплаты,
	|	ТаблицаОплаты.ЛицевойСчет КАК ЛицевойСчет,
	|	СУММА(ТаблицаОплаты.Сумма) КАК Сумма,
	|	СУММА(ТаблицаОплаты.СуммаСУчетомПроцента) КАК СуммаСУчетомПроцента
	|ИЗ
	|	ТаблицаОплаты КАК ТаблицаОплаты
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаОплаты.ЛицевойСчет,
	|	ТаблицаОплаты.ДатаОплаты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОплаты,
	|	ЛицевойСчет
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаСУчетомПроцента)
	|ПО
	|	ДатаОплаты,
	|	ЛицевойСчет";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапрос);
	ЗапросВыбораВТ 	 = СхемаЗапроса.ПакетЗапросов[0];
	ОператорВыбратьВТ = ЗапросВыбораВТ.Операторы[0];
	ЗапросВыбораТиблицыОплаты 	 = СхемаЗапроса.ПакетЗапросов[1];
	ОператорВыбратьТиблицыОплаты = ЗапросВыбораТиблицыОплаты.Операторы[0];
	
	// Опциональные колонки.
	НомерКолонки = 4; // Для индексного позиционирования в СхемаЗапроса.
	Если ЕстьКолонкаУслуга Тогда // Услуга.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.Услуга");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.Услуга");
		ЗапросВыбораТиблицыОплаты.Порядок.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		НомерКолонки = НомерКолонки + 1;
	КонецЕсли;

	Если ЕстьКолонкаКомменатрий  Тогда	// Комментарий.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.Комментарий");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.Комментарий");
		ЗапросВыбораТиблицыОплаты.ВыраженияИтогов.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		Для Каждого ВыражениеИтогов  Из ЗапросВыбораТиблицыОплаты.ВыраженияИтогов Цикл
			Если ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("СУММА(Комментарий)") Тогда
				ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("МАКСИМУМ(Комментарий)");
			КонецЕсли;
		КонецЦикла;
		НомерКолонки = НомерКолонки + 1;
	КонецЕсли;
	
	Если ЕстьКолонкаНазначениеПлатежа Тогда	// НазначениеПлатежа.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.НазначениеПлатежа");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.НазначениеПлатежа");
		ЗапросВыбораТиблицыОплаты.ВыраженияИтогов.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		Для Каждого ВыражениеИтогов  Из ЗапросВыбораТиблицыОплаты.ВыраженияИтогов Цикл
			Если ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("СУММА(НазначениеПлатежа)") Тогда
				ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("МАКСИМУМ(НазначениеПлатежа)");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());	
	Запрос.УстановитьПараметр("Таблица", ТаблицаОплаты);
	
	ВыборкаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	Корень.Очистить();
	
	НеУказаноДат = 0;
	
	Пока ВыборкаДата.Следующий() Цикл
		
		СтрокаДерева = Корень.Добавить();
		СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаДата.ДатаОплаты;
		СтрокаДерева.Сумма                         = ВыборкаДата.Сумма;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
			НеУказаноДат = НеУказаноДат + 1;
		КонецЕсли; 
		
		ВыборкаЛС = ВыборкаДата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВторойУровень = СтрокаДерева.ПолучитьЭлементы();
		
		Если НЕ РазбивкаПоУслугам Тогда
			СтрокаДерева.СуммаСУчетомПроцента      = ВыборкаДата.СуммаСУчетомПроцента;
			ИтогПоДокументу      = ВыборкаДата.СуммаСУчетомПроцента;
		Иначе	
			ИтогПоДокументу      = ВыборкаДата.Сумма;
		КонецЕсли;
		
		СуммаИтогПоДокументу = 0;
		МассивЛС = Новый Массив;
		НеНайденоЛС = 0;
		
		Пока ВыборкаЛС.Следующий() Цикл
			
			СтрокаВеткиДерева = ВторойУровень.Добавить();
			СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаЛС.ЛицевойСчет;
			СтрокаВеткиДерева.Сумма                         = ВыборкаЛС.Сумма;
			СтрокаВеткиДерева.СуммаСУчетомПроцента          = ВыборкаЛС.СуммаСУчетомПроцента;
			
			Если ЕстьКолонкаКомменатрий  Тогда
				СтрокаВеткиДерева.Комментарий = ВыборкаЛС.Комментарий;
			КонецЕсли;
			
			Если ЕстьКолонкаНазначениеПлатежа Тогда
				СтрокаВеткиДерева.НазначениеПлатежа = ВыборкаЛС.НазначениеПлатежа;
			КонецЕсли;
				
			Если РазбивкаПоУслугам Тогда
				СтрокаДерева.СуммаСУчетомПроцента			= ВыборкаДата.СуммаСУчетомПроцента;
			КонецЕсли;
			
			СтруктураОплаты = НайтиДокументОплаты(ВыборкаДата.ДатаОплаты,НомерРеестра,ВыборкаЛС.ЛицевойСчет,ВыборкаЛС.Сумма);
			Если СтруктураОплаты.Свойство("Ссылка") Тогда
				СтрокаДерева.ДокументОплаты = СтруктураОплаты.Ссылка;
			КонецЕсли;
			Если СтруктураОплаты.Свойство("ИсточникОплаты") Тогда
				СтрокаДерева.ИсточникОплаты = СтруктураОплаты.ИсточникОплаты;
			КонецЕсли;
			
			Если РазбивкаПоУслугам Тогда
				ИтокСуммаЛС = ВыборкаЛС.Сумма;
			Иначе
				ИтокСуммаЛС = ВыборкаЛС.СуммаСУчетомПроцента;
			КонецЕсли;	
			ИтогПоЛС    = 0;
			
			ТретийУровень =  СтрокаВеткиДерева.ПолучитьЭлементы();
			Выборка = ВыборкаЛС.Выбрать();
			УслугВДОкументе = 0;
			
			Пока ЕстьКолонкаУслуга И Выборка.Следующий() Цикл // Услуги.
				
				Если Выборка.Услуга.Пустая() И Выборка.Количество() = 1 Тогда
					Продолжить;
				КонецЕсли; 
				
				СтрокаВеткиДерева2 = ТретийУровень.Добавить();
				СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга = Выборка.Услуга;
				СтрокаВеткиДерева2.Сумма                         = Выборка.Сумма;
				СтрокаВеткиДерева2.СуммаСУчетомПроцента          = Выборка.СуммаСУчетомПроцента;
				
				Если ЗначениеЗаполнено(СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
					Если РазбивкаПоУслугам Тогда
						ИтогПоЛС = ИтогПоЛС + Выборка.Сумма;
					Иначе
						ИтогПоЛС = ИтогПоЛС + Выборка.СуммаСУчетомПроцента;
					КонецЕсли;
					ИтогПоЛС = ИтогПоЛС + Выборка.Сумма;
					УслугВДОкументе = УслугВДОкументе + 1;
				КонецЕсли; 
				
			КонецЦикла;
			
			Если УслугВДОкументе = 0 Тогда
				ИтогПоЛС = ИтогПоДокументу;
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
				Если РазбивкаПоУслугам Тогда
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + ИтогПоЛС;
				Иначе
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + ИтокСуммаЛС;
				КонецЕсли;
			Иначе
				НеНайденоЛС = НеНайденоЛС + 1;
			КонецЕсли; 
			
			Если ИтокСуммаЛС = ИтогПоЛС Тогда
				
				МассивЛС.Добавить(ВыборкаЛС.ЛицевойСчет.Наименование);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если НЕ СуммаИтогПоДокументу = ИтогПоДокументу Тогда
			
			Разница =  ИтогПоДокументу - СуммаИтогПоДокументу;
			
			Текст = "Оплаты от " + Формат(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга, "ДФ=dd.MM.yyyy") + " сумма документа("+СуммаИтогПоДокументу+") не сходится с суммой файла(" + ИтогПоДокументу + "), разница: " + Разница + ".";
			
			ТекстЛС = "Сумма не сходится по лицевым счетам: ";
			
			Если МассивЛС.Количество() > 0 Тогда
				
				Для каждого ЭлементМассива Из МассивЛС Цикл
					
					ТекстЛС = ТекстЛС + "" + ЭлементМассива + " ";
					
				КонецЦикла; 
				
				Текст = Текст + "
				|" + ТекстЛС;
				
			КонецЕсли;
			
			Если НеНайденоЛС > 0 Тогда
				
				Текст = Текст + "
				|Не найдено лицевых счетов: " + НеНайденоЛС;
				
			КонецЕсли; 
			
			МассивОшибок.Добавить(Текст);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если НеНайденоЛС > 0 Тогда
		
		МассивОшибок.Добавить("Не указанна дата у " + НеНайденоЛС + " позиций.");
		
	КонецЕсли; 
	
	Элементы.ДеревоОплаты.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	
	Если Корень.Количество() = 0 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Таблица платежей не заполнена.");
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	СуммаИтоИтогов = 0;
	
	Для каждого СтрокаКорня Из Корень Цикл
		
		Дата = СтрокаКорня.ДатаОплаты_ЛицевойСчет_Услуга;
		
		Если НЕ ЗначениеЗаполнено(Дата) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИтогПоДокументу      = СтрокаКорня.Сумма;
		СуммаИтогПоДокументу = 0;
		
		ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
		
		МассивЛС = Новый Массив;
		
		ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата);
		
		Для каждого СтрокаВторогоУровня Из ВторойУровень Цикл
			
			Если ЗначениеЗаполнено(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаВторогоУровня.Сумма = 0 Тогда
				
				ИтогПоЛС      = СтрокаВторогоУровня.Сумма;
				СуммаИтогПоЛС = 0;
				
				ТретийУровень = СтрокаВторогоУровня.ПолучитьЭлементы();
				
				Если ТретийУровень.Количество() = 0 Тогда
					
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + СтрокаВторогоУровня.Сумма;
					
				Иначе
					
					Для каждого СтрокаТретьегоУрованя Из ТретийУровень Цикл
						
						Если ЗначениеЗаполнено(СтрокаТретьегоУрованя.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаТретьегоУрованя.Сумма = 0 Тогда
							
							СуммаИтогПоЛС = СуммаИтогПоЛС + СтрокаТретьегоУрованя.Сумма;
							
						КонецЕсли;
						
					КонецЦикла; 
					
					Если НЕ СуммаИтогПоЛС = ИтогПоЛС Тогда
						
						МассивЛС.Добавить(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга);
						
					КонецЕсли; 
					
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + СуммаИтогПоЛС;
					
				КонецЕсли;
				
			КонецЕсли; 
		КонецЦикла; 
		СуммаИтоИтогов = СуммаИтоИтогов + СуммаИтогПоДокументу;
	КонецЦикла;
	
	Объект.ТекстИтогоДокумент = "Итого по дереву минус процент: "+Строка(СуммаИтоИтогов);
	
КонецПроцедуры

Процедура ЗагрузитьDBFФайлНаСервере(МассивОшибок, ПутьВоВременномХранилище, РазбивкаПоУслугам)
	
	ТекущийКаталог = КаталогВременныхФайлов();
	ПутьФайла = ТекущийКаталог + (Лев(Строка(Новый УникальныйИдентификатор()), 8)) + ".dbf";
	
	Попытка
		УдалитьФайлы(ПутьФайла);
	Исключение
	КонецПопытки;

	ДвоичныеДанные = ПолучитьИзВременногоХранилища(ПутьВоВременномХранилище);
	Попытка
		ДвоичныеДанные.Записать(ПутьФайла);
	Исключение
		ТекстСообщения = НСтр("ru = 'Ошибка работы с файлом.'") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ".";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	XBase  = Новый XBase;
	XBase.Кодировка = КодировкаXBase[Кодировка];
	Попытка
		XBase.ОткрытьФайл(ПутьФайла);
	Исключение
		ТекстСообщенияОбОшибке = КраткоеПредставлениеОшибки(ИнформацияОбОшибке());
		ПолныйТекстСообщенияОбОшибке = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщенияОбОшибке);
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ПолныйТекстСообщенияОбОшибке);
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка открытия файла!");
		Попытка
			УдалитьФайлы(ПутьФайла);
		Исключение
		КонецПопытки;
		Возврат;
	КонецПопытки;

	КоличествоСтрок = XBase.КоличествоЗаписей();
	
	Если КоличествоСтрок = 0 Тогда
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл пуст!");
		Возврат;
	КонецЕсли; 

	СтруктураТипов = Новый Структура;
	СтруктураТипов.Вставить("Услуга"		   , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	СтруктураТипов.Вставить("ЛицевойСчет"	   , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	СтруктураТипов.Вставить("Сумма"			   , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	СтруктураТипов.Вставить("ДатаОплаты"	   , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	СтруктураТипов.Вставить("Комментарий"	   , ОбщегоНазначения.ОписаниеТипаСтрока(999));
	СтруктураТипов.Вставить("НазначениеПлатежа", ОбщегоНазначения.ОписаниеТипаСтрока(999));
		
	
	ТаблицаОплаты = Новый ТаблицаЗначений;
	СоответствиеПозиций = Новый Соответствие;
	// Заполнение по шаблону.
	Если ЗначениеЗаполнено(Объект.ШаблонЗагрузки) Тогда
		ТаблицаШаблона = Объект.ШаблонЗагрузки.ПоляЗагрузки;
		Для Каждого Стр Из ТаблицаШаблона Цикл
			ТаблицаОплаты.Колонки.Добавить(Стр.ПолеОплатыКУ, СтруктураТипов[Стр.ПолеОплатыКУ]);
			СоответствиеПозиций.Вставить(Стр.НомерПозиции, Стр.ПолеОплатыКУ);
		КонецЦикла;
	// По умолчанию старая логика чтения.	
	Иначе
		ТаблицаОплаты.Колонки.Добавить("ЛицевойСчет"		 , СтруктураТипов.ЛицевойСчет);
		ТаблицаОплаты.Колонки.Добавить("Услуга"     		 , СтруктураТипов.Услуга);
		ТаблицаОплаты.Колонки.Добавить("Сумма"      		 , СтруктураТипов.Сумма);
		ТаблицаОплаты.Колонки.Добавить("ДатаОплаты"			 , СтруктураТипов.ДатаОплаты);
		
		СоответствиеПозиций.Вставить(3	, "ЛицевойСчет");
		СоответствиеПозиций.Вставить(4	, "Сумма");
		СоответствиеПозиций.Вставить(5	, "Услуга");
		СоответствиеПозиций.Вставить(10	, "ДатаОплаты");
	КонецЕсли;
	ТаблицаОплаты.Колонки.Добавить("СуммаСУчетомПроцента", СтруктураТипов.Сумма);
	
	ЕстьКолонкаКомменатрий = ?(ТаблицаОплаты.Колонки.Найти("Комментарий") = Неопределено, Ложь, Истина);
	ЕстьКолонкаНазначениеПлатежа = ?(ТаблицаОплаты.Колонки.Найти("НазначениеПлатежа") = Неопределено, Ложь, Истина);
	ЕстьКолонкаУслуга = ?(ТаблицаОплаты.Колонки.Найти("Услуга") = Неопределено, Ложь, Истина);
	
	Элементы.ДеревоОплатыКомментарий.Видимость = ЕстьКолонкаКомменатрий;
	Элементы.ДеревоОплатыНазначениеПлатежа.Видимость = ЕстьКолонкаНазначениеПлатежа;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Идентификатор = &Идентификатор";
	
	Номер = 0;
	СуммаКПеречислению = 0;
	НомерРеестра = 0;
	
	ТекущаяСтрока = 1;
	XBase.Первая();
	Пока Не XBase.ВКонце() Цикл
		
		НоваяСтрока = ТаблицаОплаты.Добавить();
		
		Для Каждого ПолеШаблона Из СоответствиеПозиций Цикл
			
			Если ЗначениеЗаполнено(ПолеШаблона.Ключ) Тогда
				ИндексПоля = ?(ПолеШаблона.Ключ-1 < 0, 0, ПолеШаблона.Ключ-1);
				ЗначениеПоля = XBase.ПолучитьЗначениеПоля(ИндексПоля);
				
				Если  ПолеШаблона.Значение = "ЛицевойСчет" Тогда // Поле содержащее ЛС.
					
					ЛицевойСчет = Неопределено;					
					ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(СокрЛП(СтрЗаменить(Строка(ЗначениеПоля ), Символы.НПП,"")), Истина);
					
					Если ЛицевойСчет.Пустая() Тогда						
					  ЛицевойСчет = ЗначениеПоля;
				    КонецЕсли; 
				  
					НоваяСтрока.ЛицевойСчет = ЛицевойСчет;
					
				ИначеЕсли  ПолеШаблона.Значение = "Сумма" Тогда // Поле содержащее сумму.
					
					Попытка
						НоваяСтрока.Сумма                = Окр(Число(ЗначениеПоля) * (1 - (Объект.Процент/100)),2);
						НоваяСтрока.СуммаСУчетомПроцента = Число(ЗначениеПоля);
					Исключение
					КонецПопытки; 
					
				ИначеЕсли ПолеШаблона.Значение = "Услуга" Тогда // Поле содержащее услугу.
					
					Услуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду(ЗначениеПоля);
					НоваяСтрока.Услуга = Услуга;
					
				ИначеЕсли  ПолеШаблона.Значение = "ДатаОплаты" Тогда // Поле содержащее дату оплаты.
					Попытка
						Дата = Дата("20"+Сред(ЗначениеПоля,9,2)+Сред(ЗначениеПоля,4,2)+Сред(ЗначениеПоля,0,2));
						НоваяСтрока.ДатаОплаты = Дата;
					Исключение
					КонецПопытки;
					
				Иначе
					
					НоваяСтрока[ПолеШаблона.Значение] = СокрЛП(ЗначениеПоля); // Комментарий и НазначениеПлатежа.
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла;
		
		XBase.Следующая();
	КонецЦикла;
	
	Если XBase.Открыта() Тогда
		XBase.ЗакрытьФайл();
	КонецЕсли; 

	Попытка
		УдалитьФайлы(ПутьФайла);
	Исключение
	КонецПопытки;
	
	ТекстЗапрос = 
	"ВЫБРАТЬ
	|	Таблица.ДатаОплаты,
	|	Таблица.ЛицевойСчет,
	|	Таблица.Сумма,
	|	Таблица.СуммаСУчетомПроцента
	|ПОМЕСТИТЬ ТаблицаОплаты
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаОплаты.ДатаОплаты КАК ДатаОплаты,
	|	ТаблицаОплаты.ЛицевойСчет КАК ЛицевойСчет,
	|	СУММА(ТаблицаОплаты.Сумма) КАК Сумма,
	|	СУММА(ТаблицаОплаты.СуммаСУчетомПроцента) КАК СуммаСУчетомПроцента
	|ИЗ
	|	ТаблицаОплаты КАК ТаблицаОплаты
	|
	|СГРУППИРОВАТЬ ПО
	|	ТаблицаОплаты.ЛицевойСчет,
	|	ТаблицаОплаты.ДатаОплаты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОплаты,
	|	ЛицевойСчет
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаСУчетомПроцента)
	|ПО
	|	ДатаОплаты,
	|	ЛицевойСчет";
	
	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапрос);
	ЗапросВыбораВТ 	 = СхемаЗапроса.ПакетЗапросов[0];
	ОператорВыбратьВТ = ЗапросВыбораВТ.Операторы[0];
	ЗапросВыбораТиблицыОплаты 	 = СхемаЗапроса.ПакетЗапросов[1];
	ОператорВыбратьТиблицыОплаты = ЗапросВыбораТиблицыОплаты.Операторы[0];
	
	// Опциональные колонки.
	НомерКолонки = 4; // Для индексного позиционирования в СхемаЗапроса.
	Если ЕстьКолонкаУслуга Тогда // Услуга.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.Услуга");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.Услуга");
		ЗапросВыбораТиблицыОплаты.Порядок.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		НомерКолонки = НомерКолонки + 1;
	КонецЕсли;

	Если ЕстьКолонкаКомменатрий  Тогда	// Комментарий.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.Комментарий");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.Комментарий");
		ЗапросВыбораТиблицыОплаты.ВыраженияИтогов.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		Для Каждого ВыражениеИтогов  Из ЗапросВыбораТиблицыОплаты.ВыраженияИтогов Цикл
			Если ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("СУММА(Комментарий)") Тогда
				ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("МАКСИМУМ(Комментарий)");
			КонецЕсли;
		КонецЦикла;
		НомерКолонки = НомерКолонки + 1;
	КонецЕсли;
	
	Если ЕстьКолонкаНазначениеПлатежа Тогда	// НазначениеПлатежа.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.НазначениеПлатежа");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.НазначениеПлатежа");
		ЗапросВыбораТиблицыОплаты.ВыраженияИтогов.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		Для Каждого ВыражениеИтогов  Из ЗапросВыбораТиблицыОплаты.ВыраженияИтогов Цикл
			Если ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("СУММА(НазначениеПлатежа)") Тогда
				ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("МАКСИМУМ(НазначениеПлатежа)");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());	
	Запрос.УстановитьПараметр("Таблица", ТаблицаОплаты);
	
	ВыборкаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	Корень.Очистить();
	
	НеУказаноДат = 0;
	
	Пока ВыборкаДата.Следующий() Цикл
		
		СтрокаДерева = Корень.Добавить();
		СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаДата.ДатаОплаты;
		СтрокаДерева.Сумма                         = ВыборкаДата.Сумма;
		
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
			НеУказаноДат = НеУказаноДат + 1;
		КонецЕсли; 
		
		ВыборкаЛС = ВыборкаДата.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ВторойУровень = СтрокаДерева.ПолучитьЭлементы();
		
		Если НЕ РазбивкаПоУслугам Тогда
			СтрокаДерева.СуммаСУчетомПроцента      = ВыборкаДата.СуммаСУчетомПроцента;
			ИтогПоДокументу      = ВыборкаДата.СуммаСУчетомПроцента;
		Иначе	
			ИтогПоДокументу      = ВыборкаДата.Сумма;
		КонецЕсли;
		
		СуммаИтогПоДокументу = 0;
		МассивЛС = Новый Массив;
		НеНайденоЛС = 0;
		
		Пока ВыборкаЛС.Следующий() Цикл
			
			СтрокаВеткиДерева = ВторойУровень.Добавить();
			СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаЛС.ЛицевойСчет;
			СтрокаВеткиДерева.Сумма                         = ВыборкаЛС.Сумма;
			СтрокаВеткиДерева.СуммаСУчетомПроцента          = ВыборкаЛС.СуммаСУчетомПроцента;
			
			Если ЕстьКолонкаКомменатрий  Тогда
				СтрокаВеткиДерева.Комментарий = ВыборкаЛС.Комментарий;
			КонецЕсли;
			
			Если ЕстьКолонкаНазначениеПлатежа Тогда
				СтрокаВеткиДерева.НазначениеПлатежа = ВыборкаЛС.НазначениеПлатежа;
			КонецЕсли;
				
			Если РазбивкаПоУслугам Тогда
				СтрокаДерева.СуммаСУчетомПроцента			= ВыборкаДата.СуммаСУчетомПроцента;
			КонецЕсли;
			
			СтруктураОплаты = НайтиДокументОплаты(ВыборкаДата.ДатаОплаты,НомерРеестра,ВыборкаЛС.ЛицевойСчет,ВыборкаЛС.Сумма);
			Если СтруктураОплаты.Свойство("Ссылка") Тогда
				СтрокаДерева.ДокументОплаты = СтруктураОплаты.Ссылка;
			КонецЕсли;
			Если СтруктураОплаты.Свойство("ИсточникОплаты") Тогда
				СтрокаДерева.ИсточникОплаты = СтруктураОплаты.ИсточникОплаты;
			КонецЕсли;
			
			Если РазбивкаПоУслугам Тогда
				ИтокСуммаЛС = ВыборкаЛС.Сумма;
			Иначе
				ИтокСуммаЛС = ВыборкаЛС.СуммаСУчетомПроцента;
			КонецЕсли;	
			ИтогПоЛС    = 0;
			
			ТретийУровень =  СтрокаВеткиДерева.ПолучитьЭлементы();
			Выборка = ВыборкаЛС.Выбрать();
			УслугВДОкументе = 0;
			
			Пока ЕстьКолонкаУслуга И Выборка.Следующий() Цикл // Услуги.
				
				Если Выборка.Услуга.Пустая() И Выборка.Количество() = 1 Тогда
					Продолжить;
				КонецЕсли; 
				
				СтрокаВеткиДерева2 = ТретийУровень.Добавить();
				СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга = Выборка.Услуга;
				СтрокаВеткиДерева2.Сумма                         = Выборка.Сумма;
				СтрокаВеткиДерева2.СуммаСУчетомПроцента          = Выборка.СуммаСУчетомПроцента;
				
				Если ЗначениеЗаполнено(СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
					Если РазбивкаПоУслугам Тогда
						ИтогПоЛС = ИтогПоЛС + Выборка.Сумма;
					Иначе
						ИтогПоЛС = ИтогПоЛС + Выборка.СуммаСУчетомПроцента;
					КонецЕсли;
					ИтогПоЛС = ИтогПоЛС + Выборка.Сумма;
					УслугВДОкументе = УслугВДОкументе + 1;
				КонецЕсли; 
				
			КонецЦикла;
			
			Если УслугВДОкументе = 0 Тогда
				ИтогПоЛС = ИтогПоДокументу;
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
				Если РазбивкаПоУслугам Тогда
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + ИтогПоЛС;
				Иначе
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + ИтокСуммаЛС;
				КонецЕсли;
			Иначе
				НеНайденоЛС = НеНайденоЛС + 1;
			КонецЕсли; 
			
			Если ИтокСуммаЛС = ИтогПоЛС Тогда
				
				МассивЛС.Добавить(ВыборкаЛС.ЛицевойСчет.Наименование);
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если НЕ СуммаИтогПоДокументу = ИтогПоДокументу Тогда
			
			Разница =  ИтогПоДокументу - СуммаИтогПоДокументу;
			
			Текст = "Оплаты от " + Формат(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга, "ДФ=dd.MM.yyyy") + " сумма документа("+СуммаИтогПоДокументу+") не сходится с суммой файла(" + ИтогПоДокументу + "), разница: " + Разница + ".";
			
			ТекстЛС = "Сумма не сходится по лицевым счетам: ";
			
			Если МассивЛС.Количество() > 0 Тогда
				
				Для каждого ЭлементМассива Из МассивЛС Цикл
					
					ТекстЛС = ТекстЛС + "" + ЭлементМассива + " ";
					
				КонецЦикла; 
				
				Текст = Текст + "
				|" + ТекстЛС;
				
			КонецЕсли;
			
			Если НеНайденоЛС > 0 Тогда
				
				Текст = Текст + "
				|Не найдено лицевых счетов: " + НеНайденоЛС;
				
			КонецЕсли; 
			
			МассивОшибок.Добавить(Текст);
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Если НеНайденоЛС > 0 Тогда
		
		МассивОшибок.Добавить("Не указанна дата у " + НеНайденоЛС + " позиций.");
		
	КонецЕсли; 
	
	Элементы.ДеревоОплаты.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	
	Если Корень.Количество() = 0 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Таблица платежей не заполнена.");
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	СуммаИтоИтогов = 0;
	
	Для каждого СтрокаКорня Из Корень Цикл
		
		Дата = СтрокаКорня.ДатаОплаты_ЛицевойСчет_Услуга;
		
		Если НЕ ЗначениеЗаполнено(Дата) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИтогПоДокументу      = СтрокаКорня.Сумма;
		СуммаИтогПоДокументу = 0;
		
		ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
		
		МассивЛС = Новый Массив;
		
		ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата);
		
		Для каждого СтрокаВторогоУровня Из ВторойУровень Цикл
			
			Если ЗначениеЗаполнено(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаВторогоУровня.Сумма = 0 Тогда
				
				ИтогПоЛС      = СтрокаВторогоУровня.Сумма;
				СуммаИтогПоЛС = 0;
				
				ТретийУровень = СтрокаВторогоУровня.ПолучитьЭлементы();
				
				Если ТретийУровень.Количество() = 0 Тогда
					
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + СтрокаВторогоУровня.Сумма;
					
				Иначе
					
					Для каждого СтрокаТретьегоУрованя Из ТретийУровень Цикл
						
						Если ЗначениеЗаполнено(СтрокаТретьегоУрованя.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаТретьегоУрованя.Сумма = 0 Тогда
							
							СуммаИтогПоЛС = СуммаИтогПоЛС + СтрокаТретьегоУрованя.Сумма;
							
						КонецЕсли;
						
					КонецЦикла; 
					
					Если НЕ СуммаИтогПоЛС = ИтогПоЛС Тогда
						
						МассивЛС.Добавить(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга);
						
					КонецЕсли; 
					
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + СуммаИтогПоЛС;
					
				КонецЕсли;
				
			КонецЕсли; 
		КонецЦикла; 
		СуммаИтоИтогов = СуммаИтоИтогов + СуммаИтогПоДокументу;
	КонецЦикла;
	
	Объект.ТекстИтогоДокумент = "Итого по дереву минус процент: "+Строка(СуммаИтоИтогов);
	
КонецПроцедуры


&НаСервере
Процедура ПрочитатьФайлНаСервере(МассивОшибок, ТекстФайл, РазбивкаПоУслугам)
	       	
	КоличествоСтрок = ТекстФайл.КоличествоСтрок();
	
	Если КоличествоСтрок = 0 Тогда
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Файл пуст!");
		Возврат;
	КонецЕсли; 

	СтруктураТипов = Новый Структура;
	СтруктураТипов.Вставить("Услуга"		   , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	СтруктураТипов.Вставить("ЛицевойСчет"	   , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	СтруктураТипов.Вставить("Сумма"			   , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	СтруктураТипов.Вставить("ДатаОплаты"	   , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	СтруктураТипов.Вставить("Комментарий"	   , ОбщегоНазначения.ОписаниеТипаСтрока(999));
	СтруктураТипов.Вставить("НазначениеПлатежа", ОбщегоНазначения.ОписаниеТипаСтрока(999));
	СтруктураТипов.Вставить("НомерСтроки"			   , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));
	//13.05.2019
	//14.05.2019
	СтруктураТипов.Вставить("Счетчик", Новый ОписаниеТипов("СправочникСсылка.бит_Счетчики"));
	СтруктураТипов.Вставить("ЗначениеСчетчика"			   , ОбщегоНазначения.ОписаниеТипаСтрока(999));
	
	ТаблицаОплаты = Новый ТаблицаЗначений;
	СоответствиеПозиций = Новый Соответствие;
	// Заполнение по шаблону.
	Если ЗначениеЗаполнено(Объект.ШаблонЗагрузки) Тогда
		ТаблицаШаблона = Объект.ШаблонЗагрузки.ПоляЗагрузки;
		Для Каждого Стр Из ТаблицаШаблона Цикл
			ТаблицаОплаты.Колонки.Добавить(Стр.ПолеОплатыКУ, СтруктураТипов[Стр.ПолеОплатыКУ]);
			СоответствиеПозиций.Вставить(Стр.НомерПозиции, Стр.ПолеОплатыКУ);
		КонецЦикла;
		//22.01.2019 59
		ТаблицаОплаты.Колонки.Добавить("НомерСтроки", СтруктураТипов.НомерСтроки);
		//13.05.2019
//		ТаблицаОплаты.Колонки.Добавить("Счетчик"			 ,ОбщегоНазначения.ОписаниеТипаСтрока(999));
//		ТаблицаОплаты.Колонки.Добавить("ПоказанияСчетчика" , ОбщегоНазначения.ОписаниеТипаСтрока(999));

	// По умолчанию старая логика чтения.	
	Иначе
		ТаблицаОплаты.Колонки.Добавить("ЛицевойСчет"		 , СтруктураТипов.ЛицевойСчет);
		ТаблицаОплаты.Колонки.Добавить("Услуга"     		 , СтруктураТипов.Услуга);
		ТаблицаОплаты.Колонки.Добавить("Сумма"      		 , СтруктураТипов.Сумма);
		ТаблицаОплаты.Колонки.Добавить("ДатаОплаты"			 , СтруктураТипов.ДатаОплаты);
		ТаблицаОплаты.Колонки.Добавить("НомерСтроки" , СтруктураТипов.НомерСтроки);
		//13.05.2019
//		ТаблицаОплаты.Колонки.Добавить("Счетчик"			 , СтруктураТипов.Счетчик);
//		ТаблицаОплаты.Колонки.Добавить("ПоказанияСчетчика" , СтруктураТипов.ПоказанияСчетчика);
		
		СоответствиеПозиций.Вставить(3	, "ЛицевойСчет");
		СоответствиеПозиций.Вставить(4	, "Сумма");
		СоответствиеПозиций.Вставить(5	, "Услуга");
		СоответствиеПозиций.Вставить(10	, "ДатаОплаты");
	КонецЕсли;
	ТаблицаОплаты.Колонки.Добавить("СуммаСУчетомПроцента", СтруктураТипов.Сумма);
	
	ЕстьКолонкаКомменатрий = ?(ТаблицаОплаты.Колонки.Найти("Комментарий") = Неопределено, Ложь, Истина);
	ЕстьКолонкаНазначениеПлатежа = ?(ТаблицаОплаты.Колонки.Найти("НазначениеПлатежа") = Неопределено, Ложь, Истина);
	ЕстьКолонкаУслуга = ?(ТаблицаОплаты.Колонки.Найти("Услуга") = Неопределено, Ложь, Истина);
	
	Элементы.ДеревоОплатыКомментарий.Видимость = ЕстьКолонкаКомменатрий;
	Элементы.ДеревоОплатыНазначениеПлатежа.Видимость = ЕстьКолонкаНазначениеПлатежа;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Идентификатор = &Идентификатор";
	
	Номер = 0;
	//22.01.2019 59
	НомерСтроки = 0;
	СуммаКПеречислению = 0;
	НомерРеестра = 0;
	
	Для Значение=1 По КоличествоСтрок Цикл
		
		Строка = ТекстФайл.ПолучитьСтроку(Значение);
		
		Если Найти(Строка,сг_ВспомогательныйСимвол) = 1 Тогда
			
			Номер = Номер + 1;
			
			Если Номер = 1 Тогда
				
				ДлинСтроки = СтрДлина(Строка);
				темпСтрока = СокрЛП(Сред(Строка,2,11));
				Попытка
					НомерРеестра = НомерРеестра + Число(темпСтрока);
				Исключение
				КонецПопытки;
				Объект.НомерРеестра = НомерРеестра;
				
			КонецЕсли;
			
			Если Объект.Процент = 0 Тогда
				
				Если Номер = 2 Тогда
					
					ДлинСтроки = СтрДлина(Строка);
					темпСтрока = СокрЛП(Сред(Строка,2,10));
					Попытка
						СуммаКПеречислению = СуммаКПеречислению + Число(темпСтрока);
					Исключение
					КонецПопытки;
					Объект.ТекстИтогоФайл = "Итого по файлу сумма реестра (справочно): "+Строка(СуммаКПеречислению);
					
				КонецЕсли;
				
			Иначе
				
				Если Номер = 5 Тогда
					
					ДлинСтроки = СтрДлина(Строка);
					темпСтрока = СокрЛП(Сред(Строка,2,10));
					Попытка
						СуммаКПеречислению = СуммаКПеречислению + Число(темпСтрока);
					Исключение
					КонецПопытки;
					Объект.ТекстИтогоФайл = "Итого по файлу сумма к перечислению (справочно): "+Строка(СуммаКПеречислению);
					
				КонецЕсли;
				
			КонецЕсли;
			
			Продолжить;
			
		КонецЕсли; 
		
		НоваяСтрока = ТаблицаОплаты.Добавить();
		
		//22.01.2019 59
		НомерСтроки = НомерСтроки + 1;
		НоваяСтрока.НомерСтроки = НомерСтроки;

		ДлиннаСтроки = СтрДлина(Строка);
		ПоследнийСимвол = 1;
		СчетчикПолей = 1;
		тмпСтрока = "" + Строка;
		
		//08.05.2019
		//13.05.2019
		//14.05.2019
		полеСчетчика = ЕстьПолеСчетчик (Объект.ШаблонЗагрузки.ПоляЗагрузки);
		если Объект.ВидЗагрузки <> "ОплатаКУ" и полеСчетчика <> неопределено тогда
		    массивПолей = СтроковыеФункцииКлиентСервер.РазложитьСтрокуВМассивПодстрок(Строка, ";");	
			ПозицияПоляСчетчика = полеСчетчика.НомерПозиции;
			
			для каждого стр из СоответствиеПозиций цикл
			 если (стр.Ключ-1) < ПозицияПоляСчетчика тогда 	
			  попытка 	
			   НоваяСтрока[стр.Значение] = НайтиЗначениеПоля(стр.Значение, массивПолей[стр.Ключ-1]);	
		      исключение 
			  конецпопытки; 
			 конецесли; 
		    конеццикла;
			
			если массивПолей.Количество() > ПозицияПоляСчетчика тогда 
				колвоСтрок = ((массивПолей.Количество() - (ПозицияПоляСчетчика-1)) / 2) - 1;
				ПозицияПоляСчетчика = ПозицияПоляСчетчика - 1;
				НоваяСтрока.Счетчик = НайтиЗначениеПоля("Счетчик", массивПолей[ПозицияПоляСчетчика]);
				НоваяСтрока.ЗначениеСчетчика = массивПолей[ПозицияПоляСчетчика + 1]; 
	//			НоваяСтрока.НомерСтроки = НоваяСтрока.НомерСтроки + 1;
				
				счетчикСтрок = 0;
	//			пока ПозицияПоляСчетчика < массивПолей.Количество() цикл
				пока счетчикСтрок < колвоСтрок цикл    				
									
					НоваяСтрокаСчетчика = ТаблицаОплаты.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрокаСчетчика, НоваяСтрока);
					ПозицияПоляСчетчика = ПозицияПоляСчетчика + 2;
					
					НоваяСтрокаСчетчика.Счетчик = НайтиЗначениеПоля("Счетчик", массивПолей[ПозицияПоляСчетчика]);
					НоваяСтрокаСчетчика.НомерСтроки = НоваяСтрокаСчетчика.НомерСтроки + 1;
				    НоваяСтрокаСчетчика.ЗначениеСчетчика = массивПолей[ПозицияПоляСчетчика + 1]; 
					
					счетчикСтрок = счетчикСтрок + 1;
				конеццикла;
			конецесли;
			
			номерСтроки = 0;
			для каждого стр из ТаблицаОплаты цикл
				стр.НомерСтроки = номерСтроки + 1;
				номерСтроки = номерСтроки + 1;
			конеццикла;	
			
			//14.05.2019
            ЗначениеВРеквизитФормы(ТаблицаОплаты, "ТаблицаСчетчиков");

	    иначе
		 
			Пока ДлиннаСтроки > 0 Цикл
				
				тмпСтрока = Прав(тмпСтрока, ДлиннаСтроки);
				ПоследнийСимвол = Найти(тмпСтрока,сг_СимволРазделения);
				Если ПоследнийСимвол = 0 Тогда
					ПоследнийСимвол = СтрДлина(тмпСтрока) + 1;			
				КонецЕсли;
				ЗначениеПоля = Сред(тмпСтрока, 1, ПоследнийСимвол - 1);
				ИмяПоля = СоответствиеПозиций.Получить(СчетчикПолей);
				
				Если НЕ ИмяПоля = Неопределено Тогда
					
					Если ИмяПоля = "ЛицевойСчет" Тогда // Поле содержащее ЛС.
						
						ЛицевойСчет = Неопределено;
						ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(СокрЛП(ЗначениеПоля), Истина);
						
						Если ЛицевойСчет.Пустая() Тогда
							
							Попытка
								Идентификатор =	 Число(ЗначениеПоля);
							Исключение
								Возврат;
							КонецПопытки;
							
							Запрос.УстановитьПараметр("Идентификатор", Идентификатор);
							Выборка = Запрос.Выполнить().Выбрать();
							Если Выборка.Следующий() Тогда
								ЛицевойСчет = Выборка.ЛицевойСчет;
							КонецЕсли;
						КонецЕсли; 
						НоваяСтрока.ЛицевойСчет = ЛицевойСчет;
						
					ИначеЕсли ИмяПоля = "Сумма" Тогда // Поле содержащее сумму.
						
						Попытка
							НоваяСтрока.Сумма                = Окр(Число(ЗначениеПоля) * (1 - (Объект.Процент/100)),2);
							НоваяСтрока.СуммаСУчетомПроцента = Число(ЗначениеПоля);
						Исключение
						КонецПопытки; 
						
					ИначеЕсли ИмяПоля = "Услуга" Тогда // Поле содержащее услугу.
						
						Услуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду(ЗначениеПоля);
						НоваяСтрока.Услуга = Услуга;
						
					ИначеЕсли ИмяПоля = "ДатаОплаты" Тогда // Поле содержащее дату оплаты.
						
						Попытка
							Дата = Дата("20"+Сред(ЗначениеПоля,9,2)+Сред(ЗначениеПоля,4,2)+Сред(ЗначениеПоля,0,2));
							НоваяСтрока.ДатаОплаты = Дата;
						Исключение
						КонецПопытки;
						
					Иначе
						
						НоваяСтрока[ИмяПоля] = СокрЛП(ЗначениеПоля); // Комментарий и НазначениеПлатежа.
						
					КонецЕсли;
				КонецЕсли;
				
				ДлиннаСтроки = ДлиннаСтроки - (ПоследнийСимвол); 
				СчетчикПолей = СчетчикПолей + 1;				
		
			КонецЦикла; 
	   конецесли;	
	КонецЦикла; 
		
	ТекстЗапрос = 
	"ВЫБРАТЬ
	|	Таблица.ДатаОплаты,
	|	Таблица.НомерСтроки,
	|	Таблица.ЛицевойСчет,
	|	Таблица.Сумма,
	|	Таблица.СуммаСУчетомПроцента
	|ПОМЕСТИТЬ ТаблицаОплаты
	|ИЗ
	|	&Таблица КАК Таблица
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|   1,
	|	ТаблицаОплаты.ДатаОплаты КАК ДатаОплаты,
	|	ТаблицаОплаты.ЛицевойСчет КАК ЛицевойСчет,
	|	ТаблицаОплаты.НомерСтроки КАК НомерСтроки,
//	|	ТаблицаОплаты.Сумма КАК Сумма,
//  21.11.2018	
	|	СУММА(ТаблицаОплаты.Сумма) КАК Сумма,
	|	СУММА(ТаблицаОплаты.СуммаСУчетомПроцента) КАК СуммаСУчетомПроцента
	|ИЗ
	|	ТаблицаОплаты КАК ТаблицаОплаты
	|
	|СГРУППИРОВАТЬ ПО
	//  21.11.2018	
	//|	ТаблицаОплаты.Сумма,
	|	ТаблицаОплаты.ЛицевойСчет,
	|	ТаблицаОплаты.НомерСтроки,
	|	ТаблицаОплаты.ДатаОплаты
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаОплаты,
	|	ЛицевойСчет
	|ИТОГИ
	|	СУММА(Сумма),
	|	СУММА(СуммаСУчетомПроцента)
	|ПО
	|	ДатаОплаты//;//, //13.12.2018
	|	ЛицевойСчет";

	СхемаЗапроса = Новый СхемаЗапроса;
	СхемаЗапроса.УстановитьТекстЗапроса(ТекстЗапрос);
	ЗапросВыбораВТ 	 = СхемаЗапроса.ПакетЗапросов[0];
	ОператорВыбратьВТ = ЗапросВыбораВТ.Операторы[0];
	ЗапросВыбораТиблицыОплаты 	 = СхемаЗапроса.ПакетЗапросов[1];
	ОператорВыбратьТиблицыОплаты = ЗапросВыбораТиблицыОплаты.Операторы[0];
	
	// Опциональные колонки.
	НомерКолонки = 4; // Для индексного позиционирования в СхемаЗапроса.
	Если ЕстьКолонкаУслуга Тогда // Услуга.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.Услуга");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.Услуга");
		ЗапросВыбораТиблицыОплаты.Порядок.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		НомерКолонки = НомерКолонки + 1;
	КонецЕсли;

	Если ЕстьКолонкаКомменатрий  Тогда	// Комментарий.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.Комментарий");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.Комментарий");
		ЗапросВыбораТиблицыОплаты.ВыраженияИтогов.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		Для Каждого ВыражениеИтогов  Из ЗапросВыбораТиблицыОплаты.ВыраженияИтогов Цикл
			Если ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("СУММА(Комментарий)") Тогда
				ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("МАКСИМУМ(Комментарий)");
			КонецЕсли;
		КонецЦикла;
		НомерКолонки = НомерКолонки + 1;
	КонецЕсли;
	
	Если ЕстьКолонкаНазначениеПлатежа Тогда	// НазначениеПлатежа.
		ОператорВыбратьВТ.ВыбираемыеПоля.Добавить("Таблица.НазначениеПлатежа");
		ОператорВыбратьТиблицыОплаты.ВыбираемыеПоля.Добавить("ТаблицаОплаты.НазначениеПлатежа");
		ЗапросВыбораТиблицыОплаты.ВыраженияИтогов.Добавить(ЗапросВыбораТиблицыОплаты.Колонки[НомерКолонки]);
		Для Каждого ВыражениеИтогов  Из ЗапросВыбораТиблицыОплаты.ВыраженияИтогов Цикл
			Если ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("СУММА(НазначениеПлатежа)") Тогда
				ВыражениеИтогов.Выражение = Новый ВыражениеСхемыЗапроса("МАКСИМУМ(НазначениеПлатежа)");
			КонецЕсли;
		КонецЦикла;
	КонецЕсли;
	
	Запрос = Новый Запрос(СхемаЗапроса.ПолучитьТекстЗапроса());	
	Запрос.УстановитьПараметр("Таблица", ТаблицаОплаты);
	
//13.12.2018
	ВыборкаДата = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
//	ВыборкаДата = Запрос.Выполнить().Выбрать();//.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	Корень.Очистить();
	
	НеУказаноДат = 0;
	
	СчетчикСчетчиков = 0;
	Пока ВыборкаДата.Следующий() Цикл
		
		СтрокаДерева = Корень.Добавить();
		СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаДата.ДатаОплаты;
		
		если Объект.ВидЗагрузки = "ОплатаКУ" тогда 	
		  СтрокаДерева.Сумма                         = ВыборкаДата.Сумма;
		конецесли;  
		
		Если НЕ ЗначениеЗаполнено(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
			НеУказаноДат = НеУказаноДат + 1;
		КонецЕсли; 
		
		//13.12.2018
		ВыборкаЛС = ВыборкаДата.Выбрать();//ОбходРезультатаЗапроса.ПоГруппировкам);
		ВторойУровень = СтрокаДерева.ПолучитьЭлементы();
		
		Если НЕ РазбивкаПоУслугам Тогда
			СтрокаДерева.СуммаСУчетомПроцента      = ВыборкаДата.СуммаСУчетомПроцента;
			ИтогПоДокументу      = ВыборкаДата.СуммаСУчетомПроцента;
		Иначе	
			ИтогПоДокументу      = ВыборкаДата.Сумма;
		КонецЕсли;
		
		СуммаИтогПоДокументу = 0;
		МассивЛС = Новый Массив;
		НеНайденоЛС = 0;
		
		Пока ВыборкаЛС.Следующий() Цикл
			
			СтрокаВеткиДерева = ВторойУровень.Добавить();
			СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга = ВыборкаЛС.ЛицевойСчет;
			
			если Объект.ВидЗагрузки = "ОплатаКУ" тогда 			
			 СтрокаВеткиДерева.Сумма                         = ВыборкаЛС.Сумма;
			конецесли; 
			 
			СтрокаВеткиДерева.СуммаСУчетомПроцента          = ВыборкаЛС.СуммаСУчетомПроцента;
			
			если Объект.ВидЗагрузки <> "ОплатаКУ" и ЕстьПолеСчетчик (Объект.ШаблонЗагрузки.ПоляЗагрузки) <> неопределено тогда
			 //13.05.2019
			 СтрокаВеткиДерева.Счетчик = ТаблицаОплаты[СчетчикСчетчиков].Счетчик;
			 СтрокаВеткиДерева.ЗначениеСчетчика = ТаблицаОплаты[СчетчикСчетчиков].ЗначениеСчетчика;
			 
			конецесли; 
			 
			Если ЕстьКолонкаКомменатрий  Тогда
				СтрокаВеткиДерева.Комментарий = ВыборкаЛС.Комментарий;
			КонецЕсли;
			
			Если ЕстьКолонкаНазначениеПлатежа Тогда
				СтрокаВеткиДерева.НазначениеПлатежа = ВыборкаЛС.НазначениеПлатежа;
			КонецЕсли;
				
			Если РазбивкаПоУслугам Тогда
				СтрокаДерева.СуммаСУчетомПроцента			= ВыборкаДата.СуммаСУчетомПроцента;
			КонецЕсли;
			
			СтруктураОплаты = НайтиДокументОплаты(ВыборкаДата.ДатаОплаты,НомерРеестра,ВыборкаЛС.ЛицевойСчет,ВыборкаЛС.Сумма);
			Если Объект.ВидЗагрузки = "ОплатаКУ" и СтруктураОплаты.Свойство("Ссылка") Тогда
				СтрокаДерева.ДокументОплаты = СтруктураОплаты.Ссылка;
			КонецЕсли;
			Если Объект.ВидЗагрузки = "ОплатаКУ" и СтруктураОплаты.Свойство("ИсточникОплаты") Тогда
				СтрокаДерева.ИсточникОплаты = СтруктураОплаты.ИсточникОплаты;
			КонецЕсли;
			
			Если РазбивкаПоУслугам Тогда
				ИтокСуммаЛС = ВыборкаЛС.Сумма;
			Иначе
				ИтокСуммаЛС = ВыборкаЛС.СуммаСУчетомПроцента;
			КонецЕсли;	
			ИтогПоЛС    = 0;
			
			ТретийУровень =  СтрокаВеткиДерева.ПолучитьЭлементы();
			Выборка = ВыборкаЛС.Выбрать();
			УслугВДОкументе = 0;
			
			Пока ЕстьКолонкаУслуга И Выборка.Следующий() Цикл // Услуги.
				
				Если Выборка.Услуга.Пустая() И Выборка.Количество() = 1 Тогда
					Продолжить;
				КонецЕсли; 
				
				СтрокаВеткиДерева2 = ТретийУровень.Добавить();
				СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга = Выборка.Услуга;
				СтрокаВеткиДерева2.Сумма                         = Выборка.Сумма;
				СтрокаВеткиДерева2.СуммаСУчетомПроцента          = Выборка.СуммаСУчетомПроцента;
				
				Если ЗначениеЗаполнено(СтрокаВеткиДерева2.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
					Если РазбивкаПоУслугам Тогда
						ИтогПоЛС = ИтогПоЛС + Выборка.Сумма;
					Иначе
						ИтогПоЛС = ИтогПоЛС + Выборка.СуммаСУчетомПроцента;
					КонецЕсли;
					ИтогПоЛС = ИтогПоЛС + Выборка.Сумма;
					УслугВДОкументе = УслугВДОкументе + 1;
				КонецЕсли; 
				
			КонецЦикла;
			
			Если УслугВДОкументе = 0 Тогда
				ИтогПоЛС = ИтогПоДокументу;
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(СтрокаВеткиДерева.ДатаОплаты_ЛицевойСчет_Услуга) Тогда
				Если РазбивкаПоУслугам Тогда
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + ИтогПоЛС;
				Иначе
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + ИтокСуммаЛС;
				КонецЕсли;
			Иначе
				НеНайденоЛС = НеНайденоЛС + 1;
			КонецЕсли; 
			
			Если ИтокСуммаЛС = ИтогПоЛС Тогда
				
				МассивЛС.Добавить(ВыборкаЛС.ЛицевойСчет.Наименование);
				
			КонецЕсли; 
			
			СчетчикСчетчиков = СчетчикСчетчиков + 1;

		КонецЦикла; 
		
		//13.12.2018
		Если НЕ ИтогПоЛС = ИтогПоДокументу Тогда
//		Если НЕ СуммаИтогПоДокументу = ИтогПоДокументу Тогда

			
			Разница =  ИтогПоДокументу - СуммаИтогПоДокументу;
			
			Текст = "Оплаты от " + Формат(СтрокаДерева.ДатаОплаты_ЛицевойСчет_Услуга, "ДФ=dd.MM.yyyy") + " сумма документа("+СуммаИтогПоДокументу+") не сходится с суммой файла(" + ИтогПоДокументу + "), разница: " + Разница + ".";
			
			ТекстЛС = "Сумма не сходится по лицевым счетам: ";
			
			Если МассивЛС.Количество() > 0 Тогда
				
				Для каждого ЭлементМассива Из МассивЛС Цикл
					
					ТекстЛС = ТекстЛС + "" + ЭлементМассива + " ";
					
				КонецЦикла; 
				
				Текст = Текст + "
				|" + ТекстЛС;
				
			КонецЕсли;
			
			Если НеНайденоЛС > 0 Тогда
				
				Текст = Текст + "
				|Не найдено лицевых счетов: " + НеНайденоЛС;
				
			КонецЕсли; 
			
			МассивОшибок.Добавить(Текст);
			
		КонецЕсли; 		
				
	КонецЦикла; 
	
	Если НеНайденоЛС > 0 Тогда
		
		МассивОшибок.Добавить("Не указанна дата у " + НеНайденоЛС + " позиций.");
		
	КонецЕсли; 
	
	Элементы.ДеревоОплаты.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	
	Если Корень.Количество() = 0 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Таблица платежей не заполнена.");
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	СуммаИтоИтогов = 0;
	
	Для каждого СтрокаКорня Из Корень Цикл
		
		Дата = СтрокаКорня.ДатаОплаты_ЛицевойСчет_Услуга;
		
		Если НЕ ЗначениеЗаполнено(Дата) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИтогПоДокументу      = СтрокаКорня.Сумма;
		СуммаИтогПоДокументу = 0;
		
		ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
		
		МассивЛС = Новый Массив;
		
		ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата);
		
		Для каждого СтрокаВторогоУровня Из ВторойУровень Цикл
			
			Если ЗначениеЗаполнено(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаВторогоУровня.Сумма = 0 Тогда
				
				ИтогПоЛС      = СтрокаВторогоУровня.Сумма;
				СуммаИтогПоЛС = 0;
				
				ТретийУровень = СтрокаВторогоУровня.ПолучитьЭлементы();
				
				Если ТретийУровень.Количество() = 0 Тогда
					
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + СтрокаВторогоУровня.Сумма;
					
				Иначе
					
					Для каждого СтрокаТретьегоУрованя Из ТретийУровень Цикл
						
						Если ЗначениеЗаполнено(СтрокаТретьегоУрованя.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаТретьегоУрованя.Сумма = 0 Тогда
							
							СуммаИтогПоЛС = СуммаИтогПоЛС + СтрокаТретьегоУрованя.Сумма;
							
						КонецЕсли;
						
					КонецЦикла; 
					
					Если НЕ СуммаИтогПоЛС = ИтогПоЛС Тогда
						
						МассивЛС.Добавить(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга);
						
					КонецЕсли; 
					
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + СуммаИтогПоЛС;
					
				КонецЕсли;
				
			КонецЕсли; 
		КонецЦикла; 
		СуммаИтоИтогов = СуммаИтоИтогов + СуммаИтогПоДокументу;
	КонецЦикла;
	
	Объект.ТекстИтогоДокумент = "Итого по дереву минус процент: "+Строка(СуммаИтоИтогов);
	
КонецПроцедуры

функция НайтиЗначениеПоля (ИмяПоля, ЗначениеПоля)
	
  Если ИмяПоля = "ЛицевойСчет" Тогда // Поле содержащее ЛС.
						
		ЛицевойСчет = Неопределено;
		ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(СокрЛП(ЗначениеПоля), Истина);
		
		возврат ЛицевойСчет;
  конецесли; 	
  
  
  Если ИмяПоля = "Счетчик" Тогда // Поле содержащее ЛС.
						
		Счетчик = Неопределено;
		Счетчик = Справочники.бит_Счетчики.НайтиПоНаименованию(СокрЛП(ЗначениеПоля), Истина);
		
		возврат Счетчик;
  конецесли; 	
	
  Если ИмяПоля = "ДатаОплаты" Тогда // Поле содержащее дату оплаты.
						
		Попытка
			Дата = Дата("20"+Сред(ЗначениеПоля,9,2)+Сред(ЗначениеПоля,4,2)+Сред(ЗначениеПоля,0,2));
			ДатаОплаты = Дата;
		Исключение
		КонецПопытки;
		возврат ДатаОплаты;
  конецесли; 	
	
  возврат ЗначениеПоля;	
конецфункции	

функция ЕстьПолеСчетчик (таблицаПолей)
	
	для каждого стр из таблицаПолей цикл
		
		если стр.ПолеОплатыКУ = "Счетчик" тогда
		 возврат стр;	
		конецесли; 
		 
	конеццикла;	
	
	возврат неопределено;
конецфункции	

&НаСервере
Функция НайтиДокументОплаты(ДатаОплаты,НомерРеестра,ЛицевойСчет,Сумма)
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	бит_ОплатаКУ.ИсточникОплаты,
	|	бит_ОплатаКУ.Ссылка
	|ИЗ
	|	Документ.бит_ОплатаКУ КАК бит_ОплатаКУ
	|ГДЕ
	|	бит_ОплатаКУ.Дата МЕЖДУ НАЧАЛОПЕРИОДА(&ДатаОплаты, ДЕНЬ) И КОНЕЦПЕРИОДА(&ДатаОплаты, ДЕНЬ)
	|	И бит_ОплатаКУ.НомерРеестра = &НомерРеестра");
	Запрос.УстановитьПараметр("ДатаОплаты",ДатаОплаты);
	Запрос.УстановитьПараметр("НомерРеестра",НомерРеестра);
	Выборка = Запрос.Выполнить().Выбрать();
	Структура = Новый Структура();
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.Ссылка.СписокЛС.Количество() > 0 и ЗначениеЗаполнено(ЛицевойСчет) Тогда
			Если Выборка.Ссылка.СписокЛС[0].ЛицевойСчет = ЛицевойСчет и Выборка.Ссылка.СписокЛС[0].Сумма = Сумма Тогда
				Структура.Вставить("ИсточникОплаты", Выборка.ИсточникОплаты);
				Структура.Вставить("Ссылка", Выборка.Ссылка);
				Продолжить;
			Иначе
				Продолжить;
			КонецЕсли;
		Иначе
			Продолжить;
		КонецЕсли;
		
	КонецЦикла;
	Возврат Структура;
КонецФункции

