
#Область ПеременныеМодуля

&НаКлиенте 
Перем мКэшРеквизитовФормы;       // Хранит текущие значения реквизитов формы. Клиент.

#КонецОбласти

#Область РаботаСКэшемРеквизитовФормы

// Процедура заполняет кэш реквизитов формы данными объекта.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура ЗаполнитьТекущиеЗначенияРеквизитовФормы()
	
	Для Каждого КлючИЗначение Из мКэшРеквизитовФормы Цикл
		
		мКэшРеквизитовФормы[КлючИЗначение.Ключ] = Объект[КлючИЗначение.Ключ];
		
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииДляУправленияВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , Строка(""));
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	Если Объект.ВводВРучную Тогда
		
		Элементы.СписокУслугСуммаПени.Видимость      = Истина;
		Элементы.СписокУслугУслуга.ТолькоПросмотр    = Ложь;
		Элементы.СписокУслугСумма.ТолькоПросмотр     = Ложь;
		Элементы.СписокУслугСуммаПени.ТолькоПросмотр = Ложь;
		Элементы.СписокУслугДобавить.Доступность     = Истина;
		Элементы.СписокУслугУдалить.Доступность      = Истина;
		Элементы.Группа5.Видимость                   = Истина;
		
	Иначе
		
		Элементы.СписокУслугСуммаПени.Видимость      = Ложь;
		Элементы.СписокУслугУслуга.ТолькоПросмотр    = Истина;
		Элементы.СписокУслугСумма.ТолькоПросмотр     = Истина;
		Элементы.СписокУслугСуммаПени.ТолькоПросмотр = Истина;
		Элементы.СписокУслугДобавить.Доступность     = Ложь;
		Элементы.СписокУслугУдалить.Доступность      = Ложь;
		Элементы.Группа5.Видимость                   = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура устанавливает видимость колонок табличной части.
//
&НаКлиенте
Процедура УправлениеВидимостьюКолонок(ТекСтрока)
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("ЛицевойСчет"    , ?(ТекСтрока <> Неопределено, ТекСтрока.ЛицевойСчет    , Неопределено));
	Отбор.Вставить("ШаблонИзвещений", ?(ТекСтрока <> Неопределено, ТекСтрока.ШаблонИзвещений, Неопределено));
	
	МассивСтрок = Объект.СписокУслуг.НайтиСтроки(Отбор);
	
	Итог = 0;
	
	Для каждого Строка Из МассивСтрок Цикл
		
		Итог = Итог + Строка.СуммаПени;
		
	КонецЦикла;
	
	Элементы.СписокУслугСуммаПени.Видимость = ?(Итог <> 0 ИЛИ Объект.ВводВРучную, Истина, Ложь);
	
КонецПроцедуры

&НаСервере
Процедура УстановитьДоступностьФормыДляРедактированияНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	бит_РаботаСДиалогамиСервер.УстановитьДоступностьФормыДляРедактирования(ДокументОбъект, ЭтаФорма);
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
КонецПроцедуры

#КонецОбласти

#Область РаботаСоШтрихкодом

&НаКлиенте
Процедура СканерШтрихкодаПриИзменении(Элемент)
	
	
	Состояние("Подключается сканер штрихкода...");	
	
	ОповещенияПриПодключении = Новый ОписаниеОповещения("ПодключитьСканерШКЗавершение", ЭтотОбъект, Новый Структура("Форма", ЭтаФорма));
	МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(ОповещенияПриПодключении, УникальныйИдентификатор, "СканерШтрихкода");
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьСканерШКЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	СканерШтрихкода = РезультатВыполнения.Результат;
	Если СканерШтрихкода Тогда
		Элементы.СканерШтрихкода.ТолькоПросмотр = Истина;
		Состояние("Сканер штрихкода подключен");
	Иначе
		Состояние("Сканер штрихкода не подключен");
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Функция бит_ОбработатьСобытиеСШК(Клиент, ШК)
	
	Результат = Неопределено;
	
	Если ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_ОплатаКУ") ИЛИ 
		ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_ЧекККМ") ИЛИ 
		ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_РазовыеПоУслугамЖКХ") Тогда
	Иначе
		возврат Результат;
	КонецЕсли;
	
	ДлинаШК = СтрДлина(ШК);
	
	ЧекККМ = ПредопределенноеЗначение("Документ.бит_ЧекККМ.ПустаяСсылка");
	
	Если ДлинаШК > 37 Тогда
		
		СтрокаСумма = Лев(ШК,40);
		
		Если ДлинаШК > 43 Тогда
			СтрокаСумма = Сред(ШК,6,40);
		КонецЕсли; 
		
		КонтрольнаяСумма = 0;
		Для Значение = 1 по СтрДлина(СтрокаСумма)-1 Цикл
			КонтрольнаяСумма = КонтрольнаяСумма +  Число(Лев(СтрокаСумма,Значение))*33;
		КонецЦикла;
		КонтрольнаяСумма = КонтрольнаяСумма%1000;
		
		СуммаДляПроверки = Число(Прав(ШК, ДлинаШК- 40));
		Если ДлинаШК > 43 Тогда
			СуммаДляПроверки = Число(Прав(ШК, ДлинаШК- 45));
		КонецЕсли; 
		
		Если СуммаДляПроверки <> КонтрольнаяСумма тогда
			Возврат "Не правильно считан штрихкод!!!";
		КонецЕсли;
		
		РезШК = бит_РазберемШтрихКодИД(ШК);
		НаименованиеЛС	= РезШК.НаименованиеЛС;
		КодШаблона		= РезШК.КодШаблона;
		СуммаЦелых		= РезШК.СуммаЦелых;
		
	ИначеЕсли ДлинаШК = 13 Тогда
		
		ЧекККМ = ЧекККМНаСервере(ШК);
		
	ИначеЕсли ДлинаШК = 37 Тогда
		
		СтрокаСумма = Лев(ШК,34);
		КонтрольнаяСумма = 0;
		Для Значение = 1 по СтрДлина(СтрокаСумма)-1 Цикл
			КонтрольнаяСумма = КонтрольнаяСумма +  Число(Лев(СтрокаСумма,Значение))*33;
		КонецЦикла;
		КонтрольнаяСумма = КонтрольнаяСумма%1000;
		СуммаДляПроверки = Число(Прав(ШК, СтрДлина(ШК)-34));
		Если СуммаДляПроверки <> КонтрольнаяСумма тогда
			Возврат "Не правильно считан штрихкод!!!";
		КонецЕсли;
		
		РезШК = бит_РазберемШтрихКод(ШК);
		НаименованиеЛС	= РезШК.НаименованиеЛС;
		КодШаблона		= РезШК.КодШаблона;
		СуммаЦелых		= РезШК.СуммаЦелых;
		
	Иначе
		
		Возврат "Считанный штрих код не распознан!!!";
		
	КонецЕсли; 
	
	Если ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_ОплатаКУ") Тогда
		
		МассивСтрок = Клиент.СписокЛС.НайтиСтроки(новый Структура("ЛицевойСчет",НаименованиеЛС));
		
		Если МассивСтрок.Количество() = 0 тогда	 
			
			мСтруктураСчетовЖКХ  = бит_ОбщегоНазначения.ПолучитьСчетаРасчетовЖКХ(Клиент.Организация,КонецМесяца(Клиент.Дата));
			НоваяСтрока = Объект.СписокЛС.добавить();
			НоваяСтрока.ЛицевойСчет = НаименованиеЛС;
			НоваяСтрока.ШаблонИзвещений = КодШаблона;
			НоваяСтрока.Сумма = СуммаЦелых;
			НоваяСтрока.СчетАбонента = мСтруктураСчетовЖКХ.СчетАбонента;
			СтрокаСубконта = НоваяСтрока.СчетАбонента.ВидыСубконто.Найти(ПредопределенноеЗначение("ПланВидовХарактеристик.ВидыСубконтоХозрасчетные.ЛицевыеСчета"), "ВидСубконто");
			Если Не СтрокаСубконта = Неопределено тогда
				НоваяСтрока["Субконто"+СтрокаСубконта.НомерСтроки] = НоваяСтрока.ЛицевойСчет;
			КонецЕсли;	
			НоваяСтрока.СчетКУ = мСтруктураСчетовЖКХ.ТранзитныйСчетОплаты;
			
		КонецЕсли;	 
		
		Возврат Результат;
		
	ИначеЕсли ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_ЧекККМ") Тогда
		
		Клиент.ЛицевойСчет     = НаименованиеЛС;
		Клиент.ШаблонИзвещений = КодШаблона;
		Клиент.СуммаОплаты     = СуммаЦелых;
		Клиент.ШтрихКОд        = ШК;
		
		Возврат Результат;
		
	ИначеЕсли ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_РазовыеПоУслугамЖКХ") Тогда
		
		Клиент.ЧекККМ = ЧекККМ;
		
		Возврат Результат;
		
	КонецЕсли; 
	
КонецФункции

&НаСервере
Функция ЧекККМНаСервере(ШК)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЧекККМ.Ссылка
	|ИЗ
	|	Документ.бит_ЧекККМ КАК бит_ЧекККМ
	|ГДЕ
	|	бит_ЧекККМ.ШтрихКодФР = &ШтрихКодФР";
	Запрос.УстановитьПараметр("ШтрихКодФР", ШК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЧекККМ = Выборка.Ссылка;
		
	КонецЕсли;	
	
	Возврат ЧекККМ;	
	
КонецФункции

// Функция разбора штрих кода.
//
&НаСервере
Функция бит_РазберемШтрихКодИД(ШК)
	
	Рез = Новый Структура("НаименованиеЛС, КодШаблона, СуммаЦелых");
	СтрокаСумма = Лев(ШК,40);
	
	Если СтрДлина(ШК) > 43 Тогда
		
		СтрокаСумма = Сред(ШК,6,40);
		
	КонецЕсли; 
	
	// Код шаблона извещения (9 символов).
	КодШаблона = "";
	// Для к = 11 по 19 Цикл.
	Для Значение = 13 по 21 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		КодШаблона = КодШаблона + СимволСтроки;
	КонецЦикла;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ШаблоныИзвещений.Ссылка
	|ИЗ
	|	Справочник.бит_ШаблоныИзвещений КАК бит_ШаблоныИзвещений
	|ГДЕ
	|	(бит_ШаблоныИзвещений.Код = &Код
	|			ИЛИ бит_ШаблоныИзвещений.Идентификатор = &Код)";
	Запрос.УстановитьПараметр("Код",КодШаблона);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Рез.КодШаблона = Выборка.Ссылка;	
	Иначе 
		Рез.КодШаблона = Справочники.бит_ШаблоныИзвещений.ПустаяСсылка();	
	КонецЕсли;
	
	ИД = "";
	ПерваяУжеБылаНеНоль = Ложь;
	
	Для Значение = 22 По 27 Цикл
		
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		Если СимволСтроки = "0" тогда	
			Если ПерваяУжеБылаНеНоль тогда
				ИД = ИД + СимволСтроки;
				ПерваяУжеБылаНеНоль =  Истина;
			КонецЕсли;	
		иначе	 
			ИД = ИД + СимволСтроки;
			ПерваяУжеБылаНеНоль =  Истина;
		КонецЕсли;
		
	КонецЦикла; 
	
	ИД = Число(ИД);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Идентификатор = &Идентификатор";
	Запрос.УстановитьПараметр("Идентификатор",ИД);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		Рез.НаименованиеЛС = Выборка.Ссылка;	
	Иначе 
		Рез.НаименованиеЛС = Справочники.бит_ЛицевыеСчета.ПустаяСсылка();	
	КонецЕсли;
	
	СуммаЦелых = "";
	
	// Целая часть суммы (было 13, сделали 11 символов).
	// Для к = 20 по 32 Цикл.
	Для Значение = 28 по 38 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		СуммаЦелых = СуммаЦелых + СимволСтроки;
	КонецЦикла;
	СуммаЦелых = СуммаЦелых + ",";
	
	// Дробная часть суммы (два знака после запятой).
	Для Значение = 39 по 40 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		СуммаЦелых = СуммаЦелых + СимволСтроки;
	КонецЦикла;
	
	Рез.СуммаЦелых = Число(СуммаЦелых);
	
	возврат Рез;
	
КонецФункции

// Разберем штрих код.
&НаКлиенте
Функция бит_РазберемШтрихКод(ШК)
	
	Рез = Новый Структура("НаименованиеЛС, КодШаблона, СуммаЦелых");
	СтрокаСумма = Лев(ШК,34);
	
	НаименованиеЛС = "";
	ПерваяУжеБылаНеНоль = Ложь; 
	
	СтрокаРазбора = СокрЛП(Лев(СтрокаСумма,12));
	ДлинаСтроки = СтрДлина(СтрокаРазбора);
	
	СписокЛС = Новый СписокЗначений;
	
	Для Значение = 1  По 12 Цикл
		
		// ЛицевойСчет = Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(СтрокаРазбора, Истина);.
		ЛицевойСчет = НайтиЛС(СтрокаРазбора);
		
		Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
			
			СписокЛС.Добавить(ЛицевойСчет);
			
		КонецЕсли; 
		
		Если Лев(СтрокаРазбора, 1)="0" Тогда
			ДлинаСтроки =  ДлинаСтроки - 1;
			СтрокаРазбора = СокрЛП(Прав(СтрокаРазбора,ДлинаСтроки));
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 
	
	Если СписокЛС.Количество() > 1 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма);
		СписокЛС.ПоказатьВыборЭлемента(Оповещение, "Пожалуйста выберете лицевой счет.");
		
		Рез.НаименованиеЛС = мКэшЗначений.ВыбЗначение;
		
	ИначеЕсли СписокЛС.Количество() > 0 Тогда 
		
		Рез.НаименованиеЛС = СписокЛС[0].Значение;
		
	КонецЕсли; 
	
	// Код шаблона извещения (9 символов).
	КодШаблона = "";
	// Для к = 11 по 19 Цикл.
	Для Значение = 13 по 21 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		КодШаблона = КодШаблона + СимволСтроки;
	КонецЦикла;
	
	Рез.КодШаблона = КодШаблонаНаСервере(КодШаблона);
		
	СуммаЦелых = "";
	
	// Целая часть суммы (было 13, сделали 11 символов).
	// Для к = 20 по 32 Цикл.
	Для Значение = 22 по 32 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		СуммаЦелых = СуммаЦелых + СимволСтроки;
	КонецЦикла;
	СуммаЦелых = СуммаЦелых + ",";
	
	// Дробная часть суммы (два знака после запятой).
	Для Значение = 33 по 34 Цикл
		СимволСтроки = Прав(Лев(СтрокаСумма,Значение),1);
		СуммаЦелых = СуммаЦелых + СимволСтроки;
	КонецЦикла;
	
	Рез.СуммаЦелых = Число(СуммаЦелых);
	
	возврат Рез;
	
КонецФункции

&НаСервере
Функция КодШаблонаНаСервере(КодШаблона)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ШаблоныИзвещений.Ссылка
	|ИЗ
	|	Справочник.бит_ШаблоныИзвещений КАК бит_ШаблоныИзвещений
	|ГДЕ
	|	(бит_ШаблоныИзвещений.Код = &Код
	|			ИЛИ бит_ШаблоныИзвещений.Идентификатор = &Код)";
	Запрос.УстановитьПараметр("Код",КодШаблона);
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда 
		КодШаблона = Выборка.Ссылка;	
	Иначе 
		КодШаблона = Справочники.бит_ШаблоныИзвещений.ПустаяСсылка();	
	КонецЕсли;
	
	Возврат КодШаблона;
	
КонецФункции

