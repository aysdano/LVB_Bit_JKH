									// БИТ_ЖКХ 01.07.2016 17:31:14 Начало правки... 
									//НоваяСтрокаСемЛьготы.НормаЛьготы       = ВыборкаФизЛицо.Норма;
									НоваяСтрокаСемЛьготы.НормаЛьготы       = Норматив;
									// БИТ_ЖКХ 01.07.2016 17:31:15 Конец правки. 
									НоваяСтрокаСемЛьготы.СуммаЛичной       = 0;
									
									// БИТ_ЖКХ_02122013_начало_изменений
									Если  ВыборкаФизЛицо.НормативПотребленияПоКу <> 0 Тогда
										
										// БИТ_ЖКХ 01.07.2016 17:31:34 Начало правки... 
										//// БИТ_ЖКХ_01122013_начало_изменений
										//НоваяСтрокаСемЛьготы.Объем             = ВыборкаФизЛицо.Норма * ВыборкаФизЛицо.НормативПотребленияПоКу;
										//// БИТ_ЖКХ_01122013_окончание_изменений
										НоваяСтрокаСемЛьготы.Объем             = Норматив * ВыборкаФизЛицо.НормативПотребленияПоКу;
										// БИТ_ЖКХ 01.07.2016 17:31:35 Конец правки. 
										
									Иначе
										НоваяСтрокаСемЛьготы.Объем = НоваяСтрокаСемЛьготы.НормаЛьготы;
										
									КонецЕсли;
									// БИТ_ЖКХ_02122013_окончание_изменений
									
								КонецЕсли; 
								
							КонецЕсли;
							
						КонецЦикла; 
						
					КонецЕсли;
					
					ДоляПлощади = 0;
					Норматив    = 0;
					
					Продолжить;
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Отбор.Очистить();
			Отбор.Вставить("ЛицевойСчет", ВыборкаУС.ЛицевойСчет);
			Отбор.Вставить("Услуга"     , ВыборкаУС.Услуга);
			
			Для каждого Строка Из ТаблицаСемейныхЛьгот Цикл
				
				НоваяСтрока = ТаблицаЛьгот.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
			КонецЦикла;
			
			ТаблицаСемейныхЛьгот.Очистить();
			
			МассивСтрок = ТаблицаЛьгот.НайтиСтроки(Отбор);
			
			Для каждого Строка Из МассивСтрок Цикл
				
				Строка.Начислено   = Сумма;
				
			КонецЦикла;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	ОбъектСравнения = Новый СравнениеЗначений;
	ТаблицаЛьгот.Сортировать("ЛицевойСчет Возр, ПриоритетУслуги Возр", ОбъектСравнения);
	
КонецПроцедуры

// Процедура выполняет расчет начислений с учетом дней проживания.
//
Процедура РасчитатьНачисленияСУчетомДнейПроживания(Запрос, Дата, ТаблицаПроживающих)
	
	ТаблицаРасчета = Новый ТаблицаЗначений;
	ТаблицаРасчета.Колонки.Добавить("ЛицевойСчет"               , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаРасчета.Колонки.Добавить("ФизЛицо"                   , Новый ОписаниеТипов("СправочникСсылка.бит_Проживающие"));
	ТаблицаРасчета.Колонки.Добавить("КоличествоДней"            , ОбщегоНазначения.ОписаниеТипаЧисло(15,0));
	ТаблицаРасчета.Колонки.Добавить("ПроживаниеВданныйМомент"   , Новый ОписаниеТипов("Булево"));
	
	Запрос.Текст = 
		
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛС.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛС.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛС.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ПроживающиеПоЛС.ДатаСнятияСРегистрации,
	|	ЕСТЬNULL(ТаблицаФизЛиц.ПроживаниеВДанныйМомент, ЛОЖЬ) КАК ПроживаниеВданныйМомент
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаФизЛиц КАК ТаблицаФизЛиц
	|		ПО бит_ПроживающиеПоЛС.ЛицевойСчет = ТаблицаФизЛиц.ЛицевойСчет
	|			И бит_ПроживающиеПоЛС.ФизЛицо = ТаблицаФизЛиц.ФизЛицо
	|ГДЕ
	|	бит_ПроживающиеПоЛС.ЛицевойСчет В(&СписокЛС)
	|	И бит_ПроживающиеПоЛС.ДатаСнятияСРегистрации МЕЖДУ НАЧАЛОПЕРИОДА(&Момент, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Момент, МЕСЯЦ)
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	ТаблицаФизЛиц.ЛицевойСчет,
	|	ТаблицаФизЛиц.ФизЛицо,
	|	ТаблицаФизЛиц.ДатаРегистрации,
	|	ТаблицаФизЛиц.ДатаСнятияСРегистрации,
	|	ТаблицаФизЛиц.ПроживаниеВДанныйМомент
	|ИЗ
	|	ТаблицаФизЛиц КАК ТаблицаФизЛиц
	|ГДЕ
	|	ТаблицаФизЛиц.ДатаРегистрации МЕЖДУ НАЧАЛОПЕРИОДА(&Момент, МЕСЯЦ) И КОНЕЦПЕРИОДА(&Момент, МЕСЯЦ)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ЛицевойСчет,
	|	ДатаРегистрации
	|ИТОГИ
	|	МАКСИМУМ(ПроживаниеВданныйМомент)
	|ПО
	|	ЛицевойСчет,
	|	ФизЛицо";
	
	Выполнялка = Запрос.Выполнить();
	ВыборкаЛС  = Выполнялка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	КолДнейВМесяце = День(КонецМесяца(Дата));
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		ВыборкаФизЛиц = ВыборкаЛС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаФизЛиц.Следующий() Цикл
			
			Выборка = ВыборкаФизЛиц.Выбрать();
						
			КолДнейРасчет = 0;
			Пока Выборка.Следующий() Цикл
				
				НачалоПериода = ?(ЗначениеЗаполнено(Выборка.ДатаРегистрации) И Выборка.ДатаРегистрации > НачалоМесяца(Дата),Выборка.ДатаРегистрации,НачалоМесяца(Дата));
				КонецПериода  = ?(ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации),Выборка.ДатаСнятияСРегистрации,КонецМесяца(Дата));
				
				// БИТ_ЖКХ 03.10.2014
				Если Месяц(Дата) <> Месяц(КонецПериода) или Год(Дата) <> Год(КонецПериода) Тогда
					КолДнейРасчет = КолДнейРасчет + (День(КонецМесяца(Дата)) - День(НачалоПериода) + 1);
				Иначе
					КолДнейРасчет = КолДнейРасчет + (День(КонецПериода) - День(НачалоПериода) + 1);
				КонецЕсли;	
				// БИТ_ЖКХ 03.10.2014
				
				// БИТ_ЖКХ 30.09.2014
				// Если КолДнейРасчет >= КолДнейВМесяце Тогда.
				Если КолДнейРасчет > КолДнейВМесяце Тогда
					// БИТ_ЖКХ 30.09.2014
					
					КолДнейРасчет = 0;
					Прервать;
					
				КонецЕсли; 
				
			КонецЦикла; 
			
			Если  КолДнейРасчет > 0 Тогда
				
				НоваяСтрока = ТаблицаРасчета.Добавить();
				НоваяСтрока.ЛицевойСчет             = ВыборкаЛС.ЛицевойСчет;
				НоваяСтрока.ФизЛицо                 = ВыборкаФизЛиц.ФизЛицо;
				НоваяСтрока.КоличествоДней          = КолДнейРасчет;
				НоваяСтрока.ПроживаниеВданныйМомент = ВыборкаФизЛиц.ПроживаниеВданныйМомент;
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	// БИТ_ЖКХ 05.09.2014
	Запрос2 = Новый Запрос;
	Запрос2.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛС.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛС.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛС.СтатусФизЛица КАК СтатусФизЛица,
	|	бит_ПроживающиеПоЛС.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ПроживающиеПоЛС.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛС.СтатусФизЛица.ПроживаниеВДанныйМомент
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС КАК бит_ПроживающиеПоЛС
	|ГДЕ
	|	бит_ПроживающиеПоЛС.ЛицевойСчет В(&ЛицевойСчет)
	|	И бит_ПроживающиеПоЛС.ФизЛицо В(&ФизЛицо)
	|	И бит_ПроживающиеПоЛС.Период >= ДАТАВРЕМЯ(1, 1, 1, 0, 0, 0)
	// БИТ_ЖКХ 29.09.2014
	|	И бит_ПроживающиеПоЛС.Период <= &Дата
	// БИТ_ЖКХ 29.09.2014
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПроживающиеПоЛС.ЛицевойСчет,
	|	бит_ПроживающиеПоЛС.ФизЛицо,
	|	бит_ПроживающиеПоЛС.СтатусФизЛица,
	|	бит_ПроживающиеПоЛС.ДатаРегистрации,
	|	бит_ПроживающиеПоЛС.ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛС.СтатусФизЛица.ПроживаниеВДанныйМомент";
	
	// БИТ_ЖКХ 29.09.2014{{
	Запрос2.УстановитьПараметр("Дата", Дата);
	// БИТ_ЖКХ 29.09.2014}}
	
	Запрос2.УстановитьПараметр("ЛицевойСчет", Запрос.Параметры.СписокЛС);
	Запрос2.УстановитьПараметр("Удален", ПредопределенноеЗначение("Справочник.бит_СтатусФизЛица.Выписан"));
	СписокФизЛиц = Новый СписокЗначений;
	ФизЛица = ТаблицаРасчета.ВыгрузитьКолонку("ФизЛицо");
	СписокФизЛиц.ЗагрузитьЗначения(ФизЛица);
	
	Запрос2.УстановитьПараметр("ФизЛицо", СписокФизЛиц);
	
	ТЗ = Запрос2.Выполнить().выгрузить();
	ТЗ.Сортировать("ДатаСнятияСРегистрации Убыв");
	ТЗ.Индексы.Добавить("Физлицо");
	
	ТаблицаРасчета.Колонки.Добавить("ПроживалНаМоментНачисления");
	ТаблицаРасчета.Индексы.Добавить("Физлицо");
	ТаблицаРасчета.Индексы.Добавить("ЛицевойСчет");
	
	Для каждого Строка из ТЗ Цикл
		
		// БИТ_ЖКХ 30.10.2014{{
		// Если Строка.СтатусФизЛицаПроживаниеВДанныйМоМент  = Ложь Тогда.
		
		Отбор = Новый Структура();
		Отбор.Вставить("Физлицо",Строка.Физлицо);
		Строки = ТЗ.НайтиСтроки(Отбор);
		
		СтрокиПроживалНаМоментНачисления = ТаблицаРасчета.НайтиСтроки(Отбор);
		
		Для Каждого СтрокаМассива из СтрокиПроживалНаМоментНачисления Цикл
			
			Если СтрокаМассива.ПроживаниеВДанныйМомент  = Ложь Тогда
				
				Шаг = 0;
				
				Для каждого СтрокаОтбора из Строки Цикл
					
					Шаг = Шаг + 1;	
					
					Если Шаг > 2 Тогда
						
						Прервать;
						
					КонецЕсли;	
					ПроживалНаМоментНачисления = Ложь;
					
					Если СтрокаОтбора.СтатусФизЛицаПроживаниеВДанныйМоМент Тогда
						
						ПроживалНаМоментНачисления = Истина;
						
						// БИТ_ЖКХ 23.09.2014{{	
						// СтрокиПроживалНаМоментНачисления = ТаблицаРасчета.НайтиСтроки(Отбор);.
						
						Для каждого СтрокаПроживалНаМоментНачисления из СтрокиПроживалНаМоментНачисления Цикл
							
							СтрокаПроживалНаМоментНачисления.ПроживалНаМоментНачисления = Истина;
							
						КонецЦикла;	
						// БИТ_ЖКХ 23.09.2014}}
						
						Прервать;
						
					КонецЕсли;	
					
				КонецЦикла;	
				
			КонецЕсли;	
			// БИТ_ЖКХ 30.10.2014}}
			
		КонецЦикла;	
		
	КонецЦикла;	
	// БИТ_ЖКХ 05.09.2014}}
	
	// БИТ_ЖКХ изменение кода. Конец. 13.01.2012}}
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТаблицаНорм.ЛицевойСчет,
	|	ТаблицаНорм.Услуга,
	|	ТаблицаНорм.Ставка,
	|	ТаблицаНорм.СпособРасчета
	|ИЗ
	|	ТаблицаНорм КАК ТаблицаНорм
	|ГДЕ
	|	ТаблицаНорм.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоПроживающим)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Отбор = Новый Структура;
		отбор.Вставить("ЛицевойСчет", Выборка.ЛицевойСчет);
		
		КолДнейМесяц = День(КонецМесяца(Дата));
		СтрокиПоиска = ТаблицаРасчета.НайтиСтроки(Отбор);
		
		Для каждого Строка Из СтрокиПоиска Цикл
			
			// БИТ_ЖКХ 19.03.2013
			// Добавлено условие проживания по ЛС.
			Если Строка.ПроживаниеВданныйМомент Тогда
				
				НоваяСтрока = ТаблицаПроживающих.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
				НоваяСтрока.Начислено = Окр((Строка.КоличествоДней*Выборка.Ставка)/КолДнейМесяц, 4);
				
				// БИТ_ЖКХ 29.09.2014{{
				// КонецЕсли;.
			ИначеЕсли Строка.ПроживалНаМоментНачисления = Истина Тогда
				
				НоваяСтрока = ТаблицаПроживающих.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Строка);
				
				НоваяСтрока.Начислено = Окр((Строка.КоличествоДней*Выборка.Ставка)/КолДнейМесяц, 4);
				
			КонецЕсли;
			// БИТ_ЖКХ 23.09.2014}}
			
		КонецЦикла; 
		
	КонецЦикла; 
	
КонецПроцедуры // ()

// Процедура выполняет расчет начислений с учетом дней проживания.
//
Процедура РасчитатьНачисленияСУчетомДнейСобственности(Запрос, Дата, ТаблицаПроживающих)
	
	ТаблицаРасчета = Новый ТаблицаЗначений;
	ТаблицаРасчета.Колонки.Добавить("ЛицевойСчет"               , Новый ОписаниеТипов("СправочникСсылка.бит_ЛицевыеСчета"));
	ТаблицаРасчета.Колонки.Добавить("ФизЛицо"                   , Новый ОписаниеТипов("СправочникСсылка.бит_Проживающие"));
	ТаблицаРасчета.Колонки.Добавить("КоличествоДней"            , ОбщегоНазначения.ОписаниеТипаЧисло(15,0));
	ТаблицаРасчета.Колонки.Добавить("ПроживаниеВданныйМомент"   , Новый ОписаниеТипов("Булево"));
	
	// БИТ ЖКх 13.04.2020
	ЗапросВладельцев = новый Запрос;
	ЗапросВладельцев.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаПраваСобственности КАК ДатаПраваСобственности
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет В(&СписокЛС)
	|	И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = &СтепеньРодства
	|	И бит_ПроживающиеПоЛССрезПоследних.ДатаПраваСобственности МЕЖДУ &НачалоПериода И &КонецПериода
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаПраваСобственности УБЫВ";
	
