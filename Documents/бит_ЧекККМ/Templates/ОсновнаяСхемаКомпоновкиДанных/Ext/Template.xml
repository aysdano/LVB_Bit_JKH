			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НачальныйОстаток</dataPath>
			<field>НачальныйОстаток</field>
			<role>
				<dcscom:balance>true</dcscom:balance>
				<dcscom:balanceGroupName>Группа</dcscom:balanceGroupName>
				<dcscom:balanceType>OpeningBalance</dcscom:balanceType>
			</role>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Приход</dataPath>
			<field>Приход</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Расход</dataPath>
			<field>Расход</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>УслугаЖКХ</dataPath>
			<field>УслугаЖКХ</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Период</dataPath>
			<field>Период</field>
			<role>
				<dcscom:periodNumber>1</dcscom:periodNumber>
				<dcscom:periodType>Main</dcscom:periodType>
			</role>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="xs:string">ДФ='MMMM гггг'</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ
	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период,
	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток) КАК НачальныйОстаток,
	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаПриход) КАК Приход,
	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаРасход) КАК Расход,
	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток) КАК КонечныйОстаток
ИЗ
	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(, , Месяц, , ЛицевойСчет = &amp;ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты

СГРУППИРОВАТЬ ПО
	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период</query>
	</dataSet>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>Счетчик</dataPath>
			<field>Счетчик</field>
			<role>
				<dcscom:dimension>true</dcscom:dimension>
