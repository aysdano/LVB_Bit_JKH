КонецПроцедуры

Функция ТекстЗапросаСравнитьЖильцов(НуженОтборПоЛС=ложь)
	ТекстЗапроса= 
	    "ВЫБРАТЬ
	    |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	    |	СУММА(ВЫБОР
	    |			КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = &НеПроживает
	    |				ТОГДА 0
	    |			ИНАЧЕ 1
	    |		КОНЕЦ) КАК Прожив,
	    |	СУММА(ВЫБОР
	    |			КОГДА бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.Данет.Да)
	    |				ТОГДА 1
	    |			ИНАЧЕ 0
	    |		КОНЕЦ) КАК Собств
	    |ПОМЕСТИТЬ ОстаткиБИТ
	    |ИЗ
	    |	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(КОНЕЦПЕРИОДА(&Дата, МЕСЯЦ), &ОтборЛицевыеСчета) КАК бит_ПроживающиеПоЛССрезПоследних
	    |ГДЕ
	    |	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации < ДАТАВРЕМЯ(2019, 2, 1)
	    |	И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации >= ДАТАВРЕМЯ(2019, 2, 1)
	    |			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	    |
	    |СГРУППИРОВАТЬ ПО
	    |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	    |
	    |ИНДЕКСИРОВАТЬ ПО
	    |	ЛицевойСчет
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ
	    |	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	    |	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	    |ПОМЕСТИТЬ ОтветственныеБИТ
	    |ИЗ
	    |	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, &ОтборЛицевыеСчета) КАК бит_ПроживающиеПоЛССрезПоследних
	    |ГДЕ
	    |	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = &Ответственный
	    |	И (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
	    |			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации >= &Дата)
	    |
	    |ИНДЕКСИРОВАТЬ ПО
	    |	ЛицевойСчет
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ
	    |	лб_Тест_ЛС.ЛС КАК ЛС,
	    |	лб_Тест_ЛС.K_JIL КАК K_JIL,
	    |	лб_Тест_ЛС.K_SOB КАК K_SOB,
	    |	лб_Тест_ЛС.Ответственный КАК Ответственный,
	    |	лб_Тест_ЛС.TAR КАК TAR
	    |ПОМЕСТИТЬ Эталон
	    |ИЗ
	    |	РегистрСведений.лб_Тест_ЛС КАК лб_Тест_ЛС
	    |ГДЕ
	    |	&ОтборЛС
	    |
	    |ИНДЕКСИРОВАТЬ ПО
	    |	ЛС
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ
	    |	Эталон.ЛС.Здание КАК Здание,
	    |	Эталон.ЛС КАК ЛС,
	    |	Эталон.K_JIL КАК ЖильцыЭ,
	    |	ЕСТЬNULL(ОстаткиБИТ.Прожив, 0) КАК ЖильцыФ,
	    |	Эталон.K_SOB КАК СобствЭ,
	    |	ЕСТЬNULL(ОстаткиБИТ.Собств, 0) КАК СобствФ,
	    |	Эталон.Ответственный КАК ОтветственныйЭ,
	    |	ЕСТЬNULL(ОтветственныеБИТ.ФизЛицо, ЗНАЧЕНИЕ(Справочник.бит_Проживающие.Пустаяссылка)) КАК ОтветственныйФ,
	    |	Эталон.TAR КАК TAR
	    |ПОМЕСТИТЬ СравнениеВсех
	    |ИЗ
	    |	Эталон КАК Эталон
	    |		ЛЕВОЕ СОЕДИНЕНИЕ ОстаткиБИТ КАК ОстаткиБИТ
	    |		ПО (ОстаткиБИТ.ЛицевойСчет = Эталон.ЛС)
	    |		ЛЕВОЕ СОЕДИНЕНИЕ ОтветственныеБИТ КАК ОтветственныеБИТ
	    |		ПО Эталон.ЛС = ОтветственныеБИТ.ЛицевойСчет
	    |ГДЕ
	    |	(Эталон.K_JIL <> ЕСТЬNULL(ОстаткиБИТ.Прожив, 0)
	    |			ИЛИ Эталон.K_SOB <> ЕСТЬNULL(ОстаткиБИТ.Собств, 0)
	    |			ИЛИ ЕСТЬNULL(ОтветственныеБИТ.ФизЛицо, ЗНАЧЕНИЕ(Справочник.бит_Проживающие.Пустаяссылка)) <> Эталон.Ответственный)
	    |;
	    |
	    |////////////////////////////////////////////////////////////////////////////////
	    |ВЫБРАТЬ
	    |	СравнениеВсех.ЛС КАК ЛС,
	    |	СравнениеВсех.ЖильцыЭ КАК ЖильцыЭ,
	    |	СравнениеВсех.ЖильцыФ КАК ЖильцыФ,
	    |	СравнениеВсех.СобствЭ КАК СобствЭ,
	    |	СравнениеВсех.СобствФ КАК СобствФ,
	    |	СравнениеВсех.ОтветственныйЭ КАК ОтветственныйЭ,
	    |	СравнениеВсех.ОтветственныйФ КАК ОтветственныйФ,
	    |	СравнениеВсех.TAR КАК TAR,
	    |	СравнениеВсех.Здание КАК Здание
	    |ИЗ
	    |	СравнениеВсех КАК СравнениеВсех
	    |ИТОГИ ПО
	    |	Здание";
	Если НуженОтборПоЛС тогда
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ОтборЛицевыеСчета","ЛицевойСчет в (&СписокЛС)");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ОтборЛС","ЛС в (&СписокЛС)");
	иначе
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ОтборЛицевыеСчета","истина");
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"&ОтборЛС","истина");  
	КонецЕсли;
	
	Возврат ТекстЗапроса
КонецФункции	



