&НаКлиенте
Процедура СформироватьФайлCSVНаКлиенте()
	
	ПредставлениеСпособаДетализации = ПолучитьПредставлениеСпособаДетализации();
	ПолноеИмяФайла = Каталог + "\" + Формат(ТекущаяДата(),"ДФ='dd-MM-yyyy HH.mm.ss'") + " " + ПредставлениеСпособаДетализации + ".csv";
	ИмяВременногоФайла = КаталогВременныхФайлов() + Новый УникальныйИдентификатор + ".csv";  
	
	Если ЗначениеЗаполнено(ИмяФайла) Тогда
		ПолноеИмяФайла = Каталог + "\" + ИмяФайла + ".csv";	
	КонецЕсли; 
	
	Попытка
		
		Кодировка = КодировкаТекста.Системная;
		ТекстовыйФайлЗапись = Новый ЗаписьТекста(ИмяВременногоФайла, Кодировка);
		
		//+bit_semenov.v_14.04.2021
		//СтрокаШапки = "Период;Услуга;АналитикаУчета;+;-;Знаковое;НачисленоСИзменениями;Изменение;НачисленоЗаПериод;ОплаченоЗаПериод;+;-;Знаковое";
		Если  СпособДетализации = "2" Тогда //По адресам
			СтрокаШапки = "Период;Услуга;АналитикаУчета;КодФИАС;СтепеньБлагоустройстваЗданий;+;-;Знаковое;НачисленоСИзменениями;Изменение;НачисленоЗаПериод;ОплаченоЗаПериод;+;-;Знаковое";
		ИначеЕсли СпособДетализации = "3" Тогда  //По ЛС
			СтрокаШапки = "Период;Услуга;АналитикаУчета;Адрес;Квартира;Площадь;Ответственный;+;-;Знаковое;НачисленоСИзменениями;Изменение;НачисленоЗаПериод;ОплаченоЗаПериод;+;-;Знаковое";
		Иначе
			СтрокаШапки = "Период;Услуга;АналитикаУчета;+;-;Знаковое;НачисленоСИзменениями;Изменение;НачисленоЗаПериод;ОплаченоЗаПериод;+;-;Знаковое";
		КонецЕсли;
		//-bit_semenov.v_14.04.2021
		
		ТекстовыйФайлЗапись.ЗаписатьСтроку(СтрокаШапки);
		
		Для каждого Строка Из ТаблицаИтог Цикл
			ТекстовыйДокумент = "";
			
			//+bit_semenov.v_24.06.2022
			Если СпособДетализации = "2" Тогда
				
				ТекстовыйДокумент = ТекстовыйДокумент + 
								Формат(Строка.Период, "ДЛФ=D") + Разделитель + 
								Строка.Начисление + Разделитель + 
								Строка.АналитикаУчета + Разделитель +
								Строка.КодФИАС + Разделитель +
								Строка.СтепеньБлагоустройстваЗданий + Разделитель +
								
								//Формат(Строка.НачалоНачислено, "ЧГ=0") + Разделитель +          // +
								//Формат(Строка.НачалоОплачено, "ЧГ=0") + Разделитель +           // -
								//Формат(Строка.ИтогоНачало, "ЧГ=0") + Разделитель +              // знаковое
								
								Формат(Строка.НачалоНачислено + Строка.НачалоОплачено, "ЧГ=0") + Разделитель +          // +
								Формат(Строка.НачалоОплачено, "ЧГ=0") + Разделитель +           // -
								Формат(Строка.НачалоНачислено, "ЧГ=0") + Разделитель +              // знаковое
								
								Формат(Строка.НачисленоСИзменениями, "ЧГ=0") + Разделитель +
								Формат(Строка.Изменение, "ЧГ=0") + Разделитель +
								Формат(Строка.НачисленоОборот, "ЧГ=0") + Разделитель +
								Формат(Строка.Оплачено, "ЧГ=0") + Разделитель +
								
