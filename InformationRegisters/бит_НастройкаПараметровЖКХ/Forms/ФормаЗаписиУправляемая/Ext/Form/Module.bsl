	ЗаписьМенеджерЗаписи = ДанныеФормыВЗначение(Запись, Тип("РегистрСведенийМенеджерЗаписи.бит_НастройкаПараметровЖКХ"));
	
	Если Переключатель = 2 Тогда	
		Запись.ОбщедомовыеРасходыВГрафеНачисления = Ложь;
		
		
		ЗаписьМенеджерЗаписи.ОбщедомовыеРасходыВГрафеНачисления = Ложь;
