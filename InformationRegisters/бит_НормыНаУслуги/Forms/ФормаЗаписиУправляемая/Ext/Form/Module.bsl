 
#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура выводит существующие записи регистра с отбором.
// По услуге, способу расчета, типу и статусу квартиры.
// Или выводит существующие режимы потребеления для услуги, если записей нет.
//
&НаСервере
Процедура ВывестиАктуальные (Услуга, СпособРасчета, ТипКвартиры, СтатусКвартиры)
	
	Запрос = Новый Запрос;
	
	СписокПоставщиков = Новый СписокЗначений;
	Для Каждого ТекСтрока Из Услуга.РежимыПотребленияУслуг Цикл
		СписокПоставщиков.Добавить(ТекСтрока.РежимПотребленияУслуг);
	КонецЦикла;

	Запрос.УстановитьПараметр("Дата"           ,ЭтаФорма.Запись.Период);
	Запрос.УстановитьПараметр("Услуга"         ,ЭтаФорма.Запись.Услуга);
	Запрос.УстановитьПараметр("СписокСсылок"   ,СписокПоставщиков);
	Запрос.УстановитьПараметр("СпособРасчета"  ,СпособРасчета);
	Запрос.УстановитьПараметр("ТипКвартиры"    ,ТипКвартиры);
	Запрос.УстановитьПараметр("СтатусКвартиры" ,СтатусКвартиры);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_РежимыПотребленияУслуг.Ссылка КАК РежимПотребления,
	|	бит_НормыНаУслугиСрезПоследних.НаОдного,
	|	бит_НормыНаУслугиСрезПоследних.НаДвоих,
	|	бит_НормыНаУслугиСрезПоследних.НаСемью,
	|	бит_НормыНаУслугиСрезПоследних.ДопНормаНаСемью,
	|	бит_НормыНаУслугиСрезПоследних.ДопНормаНаКаждого,
	|	бит_НормыНаУслугиСрезПоследних.ИспользоватьДопНормуНаОдного,
	|	бит_НормыНаУслугиСрезПоследних.ИспользоватьДопНормуНаЛьготника,
	|	бит_НормыНаУслугиСрезПоследних.НаЛицевойСчет,
	|	бит_НормыНаУслугиСрезПоследних.НормативПотребленияПоКу,
	|	бит_НормыНаУслугиСрезПоследних.НаСемью4,
	|	бит_НормыНаУслугиСрезПоследних.НаСемью5,
	|	бит_НормыНаУслугиСрезПоследних.НаСемью6,
	// БИТ_ЖКХ 10.05.2016 15:11:34 Начало правки... 
	|	бит_НормыНаУслугиСрезПоследних.НормативОДН
	// БИТ_ЖКХ 10.05.2016 15:11:36 Конец правки. 
	|ИЗ
	|	Справочник.бит_РежимыПотребленияУслуг КАК бит_РежимыПотребленияУслуг
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НормыНаУслуги.СрезПоследних(
	|				&Дата,
	|				Услуга = &Услуга
	|					И СпособРасчетаПоУслуге = &СпособРасчета
	|					И ТипКвартиры = &ТипКвартиры
	|					И СтатусКвартиры = &СтатусКвартиры) КАК бит_НормыНаУслугиСрезПоследних
	|		ПО (бит_НормыНаУслугиСрезПоследних.РежимПотребления = бит_РежимыПотребленияУслуг.Ссылка)
	|ГДЕ
	|	бит_РежимыПотребленияУслуг.Ссылка В(&СписокСсылок)";
	ТаблицаЗаписей = Запрос.Выполнить().Выгрузить();
	
	Если ТаблицаЗаписей.Количество() > 0 Тогда 

		 ЭтаФорма.ТаблицаРесурсов.Загрузить(ТаблицаЗаписей);
	КонецЕсли;
	
	ТаблицаРесурсов.Сортировать("РежимПотребления");
	Модифицированность = Ложь;
	
КонецПроцедуры // ВывестиАктуальные()

// Процедура  добавляет записи в регистр.
//
&НаСервере
Процедура ДобавитьЗапись(Период,Услуга,СпособРасчета,ТипКвартиры,СтатусКвартиры, Данные)
	
	НовЗапись                                 = РегистрыСведений.бит_НормыНаУслуги.СоздатьМенеджерЗаписи();
	НовЗапись.Период                          = Период;
	НовЗапись.Услуга                          = Услуга;
	НовЗапись.СпособРасчетаПоУслуге           = СпособРасчета;
	НовЗапись.ТипКвартиры                     = ТипКвартиры;
	НовЗапись.СтатусКвартиры                  = СтатусКвартиры;
	НовЗапись.РежимПотребления                = Данные.РежимПотребления;
	// БИТ_ЖКХ добавление кода Начало: 12.07.2011 
	НовЗапись.НормативПотребленияПоКу  		  = Данные.НормативПотребленияПоКу;
	// БИТ_ЖКХ добавление кода конец : 12.07.2011
	НовЗапись.НаОдного                        = Данные.НаОдного;
	НовЗапись.НаДвоих                         = Данные.НаДвоих;
	НовЗапись.НаСемью                         = Данные.НаСемью;
	НовЗапись.НаСемью4                        = Данные.НаСемью4;
	НовЗапись.НаСемью5                        = Данные.НаСемью5;
	НовЗапись.НаСемью6                        = Данные.НаСемью6;
	НовЗапись.НаЛицевойСчет                   = Данные.НаЛицевойСчет;
	НовЗапись.ИспользоватьДопНормуНаЛьготника = Данные.ИспользоватьДопНормуНаЛьготника;
	НовЗапись.ИспользоватьДопНормуНаОдного    = Данные.ИспользоватьДопНормуНаОдного;
	НовЗапись.ДопНормаНаКаждого               = Данные.ДопНормаНаКаждого;
	НовЗапись.ДопНормаНаСемью                 = Данные.ДопНормаНаСемью;
	// БИТ_ЖКХ 10.05.2016 15:12:07 Начало правки...
	НовЗапись.НормативОДН					  = Данные.НормативОДН;
	// БИТ_ЖКХ 10.05.2016 15:12:07 Конец правки.
	НовЗапись.Записать();
	
КонецПроцедуры // ДобавитьЗапись()

// Процедура управляет видимостью элементов формы.
//
&НаКлиенте
Процедура УстановитьВидимость()
	
	ПравоИзменения  = ПолучитьМетаданные();

	Если НЕ ПравоИзменения Тогда
		
		Элементы.ФормаЗаписатьИЗакрыть.Доступность        = Ложь;
		Элементы.ФормаЗаписать.Доступность                = Ложь;

	Иначе
		
		Элементы.ФормаЗаписатьИЗакрыть.Доступность        = Истина;
		Элементы.ФормаЗаписать.Доступность                = Истина;
		
	КонецЕсли;
	
КонецПроцедуры	

// Функция получает данные на сервере и возвращает структуру на форму.
//
&НаСервере
Функция РегистрСведенийМенеджерЗаписи()
	
		Данные        = ЭтаФорма.Запись;
		
		Период        = ТекущаяДата();
		Услуга        = Данные.Услуга;
		СпособРасчетаПоУслуге = ?(Данные.СпособРасчетаПоУслуге = Перечисления.бит_СпособыРасчетаПоУслугам.ПустаяСсылка()
									,Услуга.ОсновнойСпособРасчета,Данные.СпособРасчетаПоУслуге);
		ТипКвартиры = ?(Данные.ТипКвартиры = Справочники.бит_ТипыКвартиры.ПустаяСсылка()
									,Справочники.бит_ТипыКвартиры.Отдельная, Данные.ТипКвартиры);
		СтатусКвартиры = ?(Данные.СтатусКвартиры = Справочники.бит_СтатусыКвартиры.ПустаяСсылка()
									,Справочники.бит_СтатусыКвартиры.Приватизированная, Данные.СтатусКвартиры);						
		
		ВывестиАктуальные(Услуга, СпособРасчетаПоУслуге,ТипКвартиры,СтатусКвартиры);
		
		Структура =       Новый Структура;
		Структура.Вставить("СпособРасчетаПоУслуге",СпособРасчетаПоУслуге);
		Структура.Вставить("ТипКвартиры",ТипКвартиры);
		Структура.Вставить("СтатусКвартиры",СтатусКвартиры);
		Возврат Структура;
		
КонецФункции

// Функция возвращает с сервера возможность изменения.
//
&НаСервере
Функция ПолучитьМетаданные()
Регистр = Метаданные.РегистрыСведений.бит_НормыНаУслуги;	
	
	ПравоИзменения = ПравоДоступа("Изменение", Регистр);
Возврат ПравоИзменения;	
КонецФункции	

// Процедура выбирает строки с пустыми значениями и затем их удаляет.
//
&НаСервере 
Процедура ВыбратьПустые(СтруктураОтбора) 
	 
	ВыборкаПустых =  РегистрыСведений.бит_НормыНаУслуги.Выбрать(,,СтруктураОтбора); 
	 
	Пока ВыборкаПустых.Следующий() Цикл
		ВыборкаПустых.ПолучитьМенеджерЗаписи().Удалить();
	КонецЦикла;
	
КонецПроцедуры

// Функция возвращает с сервера "СписокСпособовРасчета".
//
&НаСервере	
Функция СписокСпособовРасчетаНаСервере(УслугаСсылка)
	
	СписокСпособовРасчета = Новый СписокЗначений;
	Для Каждого ТекСтрока Из УслугаСсылка.СпособыРасчета Цикл
		СписокСпособовРасчета.Добавить(ТекСтрока.СпособРасчета);
	КонецЦикла;
	Возврат СписокСпособовРасчета;
КонецФункции

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

// Обработчик события "ПриСозданииНаСервере".
// Выводит данные на форму.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗаполнитьИзСправочникаУслугиЖКХ") Тогда
		
		Запись.Услуга   = Параметры.ЗаполнитьИзСправочникаУслугиЖКХ.Услуга;
		
	КонецЕсли;
		
КонецПроцедуры

// Обработчик события "ПриОткрытии".
// Выводит данные на форму.
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если Не Запись.Услуга = ПредопределенноеЗначение("Справочник.бит_УслугиЖКХ.ПустаяСсылка") тогда
		
		Структура =		 РегистрСведенийМенеджерЗаписи();
		Запись.СпособРасчетаПоУслуге = Структура.СпособРасчетаПоУслуге;
		Запись.СтатусКвартиры = Структура.СтатусКвартиры;
		Запись.ТипКвартиры = Структура.ТипКвартиры;
		
	КонецЕсли;
	
	// БИТ_ЖКХ добавление кода. Начало: 	
	УстановитьВидимость()
	// БИТ_ЖКХ добавление кода конец

КонецПроцедуры

// Обработчик события "ПередЗаписью".
// Проверяет заполнение обязательных реквизитов.
//
&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	ТекстСообщения = "Элемент не может быть записан!";
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Запись.Услуга) Тогда
		ТекстСообщения = ТекстСообщения + " Не заполнена услуга.";
		Отказ = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Запись.СпособРасчетаПоУслуге) Тогда
		ТекстСообщения = ТекстСообщения + " Не заполнен способ расчета по услуге.";
		Отказ = Истина;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Запись.СтатусКвартиры) Тогда
		ТекстСообщения  = ТекстСообщения + " Не заполнен статус квартиры.";
		Отказ = Истина;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(ЭтаФорма.Запись.ТипКвартиры) Тогда
		ТекстСообщения  = ТекстСообщения + " Не заполнен тип квартиры.";
		Отказ = Истина;
	КонецЕсли;

	Если Отказ Тогда
		бит_ОбщегоНазначения.СообщитьОбОшибке(ТекстСообщения,Отказ);
	КонецЕсли;	
	
КонецПроцедуры

 // Обработчик события "ПриЗаписи".
 // Записывает данные из формы в регистр.
 //
&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
		Для Каждого Строка из ТаблицаРесурсов Цикл
		ДобавитьЗапись(Запись.Период,Запись.Услуга,Запись.СпособРасчетаПоУслуге,Запись.ТипКвартиры,Запись.СтатусКвартиры,Строка);
	КонецЦикла;

КонецПроцедуры

// Обработчик события "ПослеЗаписи".
// Удаляются строки, с незаполненным режимом потребления.
// Возникают при стандартной записи.
//
&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
		СтруктураОтбора = Новый Структура("РежимПотребления",ПредопределенноеЗначение("Справочник.бит_РежимыПотребленияУслуг.ПустаяСсылка"));
	
		ВыбратьПустые(СтруктураОтбора);

 КонецПроцедуры
 
 // Обработчик события "Нажатие" кнопки "ОК". 
//
&НаКлиенте
Процедура OK(Команда)
	
	ПриЗаписиНаСервере(Ложь,,);
	
	Закрыть();

КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

// Обработчик события "ПриИзменении" элемента "Период".
//
&НаКлиенте
Процедура ПериодПриИзменении(Элемент)
	
	ВывестиАктуальные(Запись.Услуга, Запись.СпособРасчетаПоУслуге, Запись.ТипКвартиры, Запись.СтатусКвартиры);
	
КонецПроцедуры

// Обработчик события "ПриИзменении" измерения "Услуга".
//
&НаКлиенте
Процедура УслугаПриИзменении(Элемент)

	ВывестиАктуальные(Запись.Услуга, Запись.СпособРасчетаПоУслуге, Запись.ТипКвартиры, Запись.СтатусКвартиры);
	
КонецПроцедуры

// Обработчик события "ПриИзменении" измерения "ТипКвартиры".
//
&НаКлиенте
Процедура ТипКвартирыПриИзменении(Элемент)
	
