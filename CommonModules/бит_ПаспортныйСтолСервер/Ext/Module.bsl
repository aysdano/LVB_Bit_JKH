	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции // ПолучитьСписокСчетчиковНаЛС()

// Функция получает таблицу значений льготников по лицевому счету, проживающих на данный момент.
Функция ПолучитьСписокЛьготниковПоЛС(ЛицевойСчет, Момент) Экспорт
	
	Если Момент = Неопределено  Тогда
		
		Момент = ТекущаяДата();
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Льготы.ФизЛицо,
	|	Льготы.Льгота,
	|	Льготы.СрокДействияЛьготы,
	|	ФизЛица.СтатусФизЛица.НачислятьПоНорме КАК НачислятьПоНорме,
	|	ФизЛица.СтатусФизЛица.ПроживаниеВДанныйМомент КАК ПроживаниеВДанныйМомент,
	|	Льготы.Период,
	|	Льготы.ДокументНаЛьготуНаименование,
	|	Льготы.НомерДокумента,
	|	Льготы.ДатаВыдачи,
	|	Льготы.ДокументНаЛьготуНаименование + "" №"" + Льготы.НомерДокумента КАК ДокументНаЛьготу
	|ИЗ
	|	(ВЫБРАТЬ
	|		ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|		ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
	|		ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|		ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
	|		ПроживающиеПоЛССрезПоследних.ДатаЗаписи КАК ДатаЗаписи,
	|		ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
	|		ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации
	|	ИЗ
	|		РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиеПоЛССрезПоследних
	|	ГДЕ
	|		(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|				ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))) КАК ФизЛица
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_ЛьготыПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|			бит_ЛьготыПоЛССрезПоследних.Льготы КАК Льгота,
	|			бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы КАК СрокДействияЛьготы,
	|			бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу КАК ДокументНаЛьготу,
	|			бит_ЛьготыПоЛССрезПоследних.Период КАК Период,
	|			бит_ЛьготыПоЛССрезПоследних.НомерДокумента КАК НомерДокумента,
	|			бит_ЛьготыПоЛССрезПоследних.ДатаВыдачи КАК ДатаВыдачи,
	|			бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу.Наименование КАК ДокументНаЛьготуНаименование
	|		ИЗ
	|			РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_ЛьготыПоЛССрезПоследних
	|		ГДЕ
	|			(бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы > &Момент
	|					ИЛИ бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы = ДАТАВРЕМЯ(1, 1, 1))) КАК Льготы
	|		ПО ФизЛица.ФизЛицо = Льготы.ФизЛицо
	|ГДЕ
	|	ФизЛица.СтатусФизЛица.ПравоНаЛьготы = ИСТИНА";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Момент", Момент);
	
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	
	Возврат Результат;
	
КонецФункции // ПолучитьСписокЛьготниковПоЛС()

// Функция получает таблицу значений сумм начислений по услугам на лицевом счете.
Функция ПолучитьРасчетыПоУслугам(ЛицевойСчет, Момент) Экспорт
	
	Если Момент = Неопределено  Тогда
		
		Момент = ТекущаяДата();
		
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ОбъемыПоУслугамЖКХОбороты.Услуга,
	|	СУММА(бит_ОбъемыПоУслугамЖКХОбороты.ОбъемОборот) КАК Объем,
	|	НАЧАЛОПЕРИОДА(бит_ОбъемыПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК МесяцГод
	|ПОМЕСТИТЬ Объемы
	|ИЗ
	|	РегистрНакопления.бит_ОбъемыПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_ОбъемыПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ОбъемыПоУслугамЖКХОбороты.Услуга,
	|	НАЧАЛОПЕРИОДА(бит_ОбъемыПоУслугамЖКХОбороты.Период, МЕСЯЦ)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК МесяцГод,
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК Услуга,
	|	СУММА(ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)) КАК Сумма,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Оплата,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	|					ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|					ИЛИ НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Начисления,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Разовые,
	|	СУММА(ВЫБОР
	|			КОГДА НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|				ТОГДА ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.СуммаОборот, 0)
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК Льгота,
	|	СУММА(ЕСТЬNULL(НачисленияПоУслугамЖКХОбороты.ОбъемОборот, 0)) КАК Объем
	|ПОМЕСТИТЬ Обороты
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Регистратор, , ЛицевойСчет = &ЛицевойСчет) КАК НачисленияПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	НАЧАЛОПЕРИОДА(НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ),
	|	НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ТаблицаОстатков.Услуга,
	|	ТаблицаОстатков.МесяцГод,
	|	ТаблицаОстатков.ВхСальдо,
	|	ТаблицаОстатков.ИсхСальдо
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	&ТаблицаОстатков КАК ТаблицаОстатков
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ЕСТЬNULL(Остатки.ВхСальдо, 0) КАК ВхСальдо,
	|	ЕСТЬNULL(Остатки.ИсхСальдо, 0) КАК ИсхСальдо,
	|	ЕСТЬNULL(Обороты.Начисления, 0) - ВЫБОР
	|		КОГДА ЕСТЬNULL(Обороты.Льгота, 0) < 0
	|			ТОГДА ЕСТЬNULL(Обороты.Льгота, 0) * -1
	|		ИНАЧЕ ЕСТЬNULL(Обороты.Льгота, 0)
	|	КОНЕЦ + ЕСТЬNULL(Обороты.Разовые, 0) КАК Сумма,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Обороты.Оплата, 0) < 0
	|			ТОГДА ЕСТЬNULL(Обороты.Оплата, 0) * -1
	|		ИНАЧЕ ЕСТЬNULL(Обороты.Оплата, 0)
	|	КОНЕЦ КАК Оплата,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Остатки.ВхСальдо, 0) + ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ВЫБОР
	|				КОГДА ЕСТЬNULL(Обороты.Оплата, 0) < 0
	|					ТОГДА ЕСТЬNULL(Обороты.Оплата, 0) * -1
	|				ИНАЧЕ ЕСТЬNULL(Обороты.Оплата, 0)
	|			КОНЕЦ - ВЫБОР
	|				КОГДА ЕСТЬNULL(Обороты.Льгота, 0) < 0
	|					ТОГДА ЕСТЬNULL(Обороты.Льгота, 0) * -1
	|				ИНАЧЕ ЕСТЬNULL(Обороты.Льгота, 0)
	|			КОНЕЦ > 0
	|			ТОГДА ЕСТЬNULL(Остатки.ВхСальдо, 0) + ЕСТЬNULL(Обороты.Начисления, 0) + ЕСТЬNULL(Обороты.Разовые, 0) - ВЫБОР
	|					КОГДА ЕСТЬNULL(Обороты.Оплата, 0) < 0
	|						ТОГДА ЕСТЬNULL(Обороты.Оплата, 0) * -1
	|					ИНАЧЕ ЕСТЬNULL(Обороты.Оплата, 0)
	|				КОНЕЦ - ВЫБОР
	|					КОГДА ЕСТЬNULL(Обороты.Льгота, 0) < 0
	|						ТОГДА ЕСТЬNULL(Обороты.Льгота, 0) * -1
	|					ИНАЧЕ ЕСТЬNULL(Обороты.Льгота, 0)
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КОплате,
	|	Остатки.Услуга КАК Услуга,
	|	Остатки.МесяцГод КАК МесяцГод,
	|	ЕСТЬNULL(Объемы.Объем, 0) КАК Объем
	|ИЗ
	|	Остатки КАК Остатки
	|		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
	|		ПО Остатки.Услуга = Обороты.Услуга
	|			И Остатки.МесяцГод = Обороты.МесяцГод
	|		ЛЕВОЕ СОЕДИНЕНИЕ Объемы КАК Объемы
	|		ПО Остатки.МесяцГод = Объемы.МесяцГод
	|			И Остатки.Услуга = Объемы.Услуга
	|ИТОГИ
	|	СУММА(ВхСальдо),
	|	СУММА(ИсхСальдо),
	|	СУММА(Сумма),
	|	СУММА(Оплата),
	|	СУММА(КОплате),
	|	СУММА(Объем)
	|ПО
	|	МесяцГод,
	|	Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Обороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Объемы" ;
	Запрос.УстановитьПараметр("ТаблицаОстатков", ПолучитьТаблицуОстатков(ЛицевойСчет, Момент));
	Запрос.УстановитьПараметр("Момент", Момент);
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции // ПолучитьРасчетыПоУслугам()
// ДОРАБОТАТЬ!!!.
Функция ПолучитьТаблицуОстатков(ЛицевойСчет, Момент)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Момент", Момент);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период, МЕСЯЦ) КАК МесяцГод,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток, 0) КАК СуммаНачальныйОстаток,
	|	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток, 0) КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, Месяц, , ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Остатки.МесяцГод КАК МесяцГод,
	|	Остатки.УслугаЖКХ КАК Услуга,
	|	Остатки.СуммаНачальныйОстаток КАК ВхСальдо,
	|	Остатки.СуммаКонечныйОстаток КАК ИсхСальдо
	|ИЗ
	|	Остатки КАК Остатки
	|ИТОГИ
	|	СУММА(ВхСальдо),
	|	СУММА(ИсхСальдо)
	|ПО
	|	Услуга,
	|	МесяцГод ПЕРИОДАМИ(МЕСЯЦ, &НачалоПериода, &КонецПериода)
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Остатки";
	
	Таблица = Новый ТаблицаЗначений;
	Таблица.Колонки.Добавить("МесяцГод" , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата));
	Таблица.Колонки.Добавить("Услуга"   , Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	Таблица.Колонки.Добавить("ВхСальдо" , ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	Таблица.Колонки.Добавить("ИсхСальдо", ОбщегоНазначения.ОписаниеТипаЧисло(15, 2));
	
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока Выборка.Следующий() Цикл
		
		ВыборкаУС = Выборка.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам, "МесяцГод", "ВСЕ");
		
		Пока ВыборкаУС.Следующий() Цикл
			
			НоваяСтрока = Таблица.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаУС);
			
		КонецЦикла; 
		
	КонецЦикла;
	
	Возврат Таблица;
	
КонецФункции // ()

// Функция получает таблицу значений данных начального сальдо по услугам на лицевом счете.
Функция ПолучитьОстаткиПоУслугам(ЛицевойСчет, Момент) Экспорт
	
	Если Момент = Неопределено  Тогда
		
		Момент = ТекущаяДата();
		
	КонецЕсли; 
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток,
	|	бит_НачисленияПоУслугамЖКХОстатки.ОбъемОстаток
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", 	ЛицевойСчет);
	Запрос.УстановитьПараметр("Момент", 		Момент);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции // ПолучитьОстаткиПоУслугам()

// Функция получает таблицу значений данных льгот, начисленных физ лицу за период времени.
Функция ПолучитьРазмерЛьготыПоФизЛицу(ФизЛицо, Льгота, Момент)Экспорт
	
	НачалоПериода = Дата(0001,01,01,00,00,00);
	КонецПериода = КонецМесяца(Момент);
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачислениеПоЛьготамОбороты.Льгота КАК Льгота,
	|	бит_НачислениеПоЛьготамОбороты.ФизЛицо КАК ФизЛицо,
	|	СУММА(бит_НачислениеПоЛьготамОбороты.НачисленоОборот) КАК СуммаЛьготы,
	|	бит_НачислениеПоЛьготамОбороты.Период КАК Период
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПоЛьготам.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Месяц,
	|			ФизЛицо = &ФизЛицо
	|				И Льгота = &Льгота) КАК бит_НачислениеПоЛьготамОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеПоЛьготамОбороты.Льгота,
	|	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	|	бит_НачислениеПоЛьготамОбороты.Период
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("ФизЛицо", 		ФизЛицо);
	Запрос.УстановитьПараметр("Льгота", 		Льгота);
	Запрос.УстановитьПараметр("НачалоПериода", 	НачалоПериода);
	Запрос.УстановитьПараметр("КонецПериода", 	КонецПериода);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Функция получает таблицу значений комнат, ответственных и количества проживающих на данный момент.
// По коммунальным квартирам на дату по зданию и номеру квартиры.
Функция ПолучитьДанныеКоммунальныхКвартир(Здание, НомерКвартиры, Момент) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент", 		Момент);
	Запрос.УстановитьПараметр("Здание", 		Здание);
	Запрос.УстановитьПараметр("НомерКвартиры", 	НомерКвартиры);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.Квартира,
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь) КАК ОбщаяПлощадь,
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь) КАК ЖилаяПлощадь,
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.МОП) КАК МОП,
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь) КАК ОтапливаемаяПлощадь,
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь) КАК СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ТипПлиты,
	|	бит_СведенияОКвартиреСрезПоследних.ТипЗапирающегоУстройства
	|ПОМЕСТИТЬ Квартиры
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(
	|			&Момент,
	|			Квартира.Владелец.Ссылка = &Здание
	|				И Квартира.НомерКвартиры = &НомерКвартиры
	|				И ТипКвартиры = ЗНАЧЕНИЕ(Справочник.бит_ТипыКвартиры.Коммунальная)) КАК бит_СведенияОКвартиреСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ТипЗапирающегоУстройства,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира,
	|	бит_СведенияОКвартиреСрезПоследних.ТипПлиты
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(бит_СведенияОКомнатеСрезПоследних.Высота) КАК Высота,
	|	МАКСИМУМ(бит_СведенияОКомнатеСрезПоследних.Площадь) КАК ЖилаяПлощадь,
	|	Квартиры.Квартира,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК КолвоПроживающих,
	|	бит_СведенияОКомнатеСрезПоследних.Комната,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет,
	|	МАКСИМУМ(Квартиры.МОП) КАК МОП,
	|	МАКСИМУМ(Квартиры.ОбщаяПлощадь) КАК ОбщаяПлощадь,
	|	МАКСИМУМ(Квартиры.ОтапливаемаяПлощадь) КАК ОтапливаемаяПлощадь,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо КАК Ответственный,
	|	МАКСИМУМ(Квартиры.СовокупнаяПлощадь) КАК СовокупнаяПлощадь,
	|	Квартиры.СтатусКвартиры,
	|	Квартиры.ТипКвартиры,
	|	Квартиры.ТипПлиты,
	|	Квартиры.ТипЗапирающегоУстройства
	|ИЗ
	|	Квартиры КАК Квартиры
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКомнате.СрезПоследних(
	|				&Момент,
	|				Комната.Владелец В
	|					(ВЫБРАТЬ
	|						Квартиры.Квартира КАК Квартира
	|					ИЗ
	|						Квартиры)) КАК бит_СведенияОКомнатеСрезПоследних
	|		ПО Квартиры.Квартира = бит_СведенияОКомнатеСрезПоследних.Комната.Владелец
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО Квартиры.Квартира = бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Момент, ) КАК бит_ОтветственныеЛицаПоКУСрезПоследних
	|		ПО Квартиры.Квартира = бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет.Квартира
	|ГДЕ
	|	((бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|				ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|				И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПроживаниеВДанныйМомент = ИСТИНА
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо ЕСТЬ NULL )
	|	И (бит_СведенияОКомнатеСрезПоследних.Комната.ЧастьПомещения.ТипКомнаты = ЗНАЧЕНИЕ(Справочник.бит_ТипыКомнат.Жилая)
	|			ИЛИ бит_СведенияОКомнатеСрезПоследних.Комната ЕСТЬ NULL )
	|
	|СГРУППИРОВАТЬ ПО
	|	Квартиры.ТипЗапирающегоУстройства,
	|	бит_СведенияОКомнатеСрезПоследних.Комната,
	|	Квартиры.Квартира,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо,
	|	Квартиры.ТипПлиты,
	|	Квартиры.СтатусКвартиры,
	|	Квартиры.ТипКвартиры,
	|	бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ Квартиры";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Функция получает строку с данными ответственного.
// Параметры:
// Организация - справочник Организации;.
// ДолжностноеЛицо - справочник Физические лица;.
// Дата - дата среза.
// НаличиеДолжности - вводить ли в строку должность.
функция ПолучитьОтветственногоОрганизации(Организация = Неопределено, ДолжностноеЛицо = Неопределено, Дата, НаличиеДолжности = Истина) Экспорт
	ДолжностноеЛицоОрганизации = Неопределено;
	Если ЗначениеЗаполнено(ДолжностноеЛицо) Тогда
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо,
		|	ОтветственныеЛицаОрганизацийСрезПоследних.Должность
		|ИЗ
		|	РегистрСведений.ОтветственныеЛицаОрганизаций.СрезПоследних(&Период, СтруктурнаяЕдиница = &Организация) КАК ОтветственныеЛицаОрганизацийСрезПоследних
		|ГДЕ
		|	ОтветственныеЛицаОрганизацийСрезПоследних.ФизическоеЛицо = &ФизическоеЛицо";
		
		Запрос.УстановитьПараметр("Организация", 		Организация);
		Запрос.УстановитьПараметр("ФизическоеЛицо",		ДолжностноеЛицо);
		Если ЗначениеЗаполнено(Дата) Тогда
			Запрос.УстановитьПараметр("Период",		 		Дата);
		Иначе
			Запрос.УстановитьПараметр("Период",		 		ТекущаяДата());
		КонецЕсли;
		
		Результат = Запрос.Выполнить().Выбрать();
		
		Если Результат.Количество() > 0 Тогда
			Результат.Следующий();
			ДолжностноеЛицоФИО = бит_ПаспортныйСтолСервер.ПолучитьСокращенноеФИО(Результат.ФизическоеЛицо, Дата, Истина);
			Если НаличиеДолжности Тогда
				ДолжностноеЛицоОрганизации = Строка(ДолжностноеЛицоФИО)+ " (" +Строка(Результат.Должность) + ")"; 
				
			Иначе
				ДолжностноеЛицоОрганизации = новый Структура;
				ДолжностноеЛицоОрганизации.Вставить("ДолжностноеЛицо",ДолжностноеЛицоФИО);
				ДолжностноеЛицоОрганизации.Вставить("Должность",Результат.Должность);
				
			КонецЕсли;
			
		КонецЕсли;
	КонецЕсли;	
	Возврат  ДолжностноеЛицоОрганизации;
	
КонецФункции //ПолучитьОтветственногоОрганизации()

#КонецОбласти