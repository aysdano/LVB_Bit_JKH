&НаСервере
Процедура ПереоформлениеПроживающих()
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЛицевойСчет");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ФизЛицо");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СтатусФизЛица");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СтепеньРодства");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СтатусПроживания");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаРегистрации");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаСнятияСРегистрации");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаЗаписи");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ВладелецКвартиры");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ПричинаВыписки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("КудаВыписан");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Контрагент");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДоляПлощади");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СтатусФизЛицаДляИзменения");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ПравоустанавливающиеДокументы");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(Объект.ДатаЗакрытия));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "ПереоформлениеПроживающих";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	ВыборкаЛС = СтруктураРезультата.РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		ДокументРПЛ = Неопределено;
		
		Выборка = ВыборкаЛС.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ДокументРПЛ = Неопределено Тогда
				
				ДокументРПЛ = Документы.бит_РегистрацияПроживающихПоЛС.СоздатьДокумент();
				
				ДокументРПЛ.Дата          = КонецДня(Объект.ДатаЗакрытия) - 2;
				ДокументРПЛ.ЛицевойСчет   = ВыборкаЛС.ЛицевойСчет;
				ДокументРПЛ.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
				ДокументРПЛ.Ответственный = мОтветственный;
				
			КонецЕсли;
			
			НоваяСтрока = ДокументРПЛ.СписокПроживающих.Добавить();
			
			НоваяСтрока.ФизЛицо                       = Выборка.ФизЛицо;
			НоваяСтрока.ДатаРегистрации               = Выборка.ДатаРегистрации;
			НоваяСтрока.ДатаСнятияСРегистрации        = Выборка.ДатаСнятияСРегистрации;
			НоваяСтрока.СтатусПроживания              = Выборка.СтатусПроживания;
			НоваяСтрока.СтепеньРодства                = Выборка.СтепеньРодства;
			НоваяСтрока.ПравоустанавливающиеДокументы = Выборка.ПравоустанавливающиеДокументы; 
			НоваяСтрока.ВладелецКвартиры              = Выборка.ВладелецКвартиры;
			НоваяСтрока.ДоляПлощади                   = Выборка.ДоляПлощади;
			
			Если ЗначениеЗаполнено(Выборка.ДатаЗаписи) Тогда
				
				НоваяСтрока.СтатусФизЛица = ?(НЕ ЗначениеЗаполнено(Выборка.СтатусФизЛицаДляИзменения),
				Справочники.бит_СтатусФизЛица.ПостояннаяРегистрация,
				Выборка.СтатусФизЛицаДляИзменения);
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
				
				НоваяСтрока.СтатусФизЛица  = Справочники.бит_СтатусФизЛица.Выписан;
				НоваяСтрока.ПричинаВыписки = Справочники.бит_ПричиныВыписки.ОкончаниеВремениРегистрации;
				
			КонецЕсли;  
			
			Если НоваяСтрока.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
				
				НоваяСтрока.Контрагент = Выборка.Контрагент;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		Если НЕ ДокументРПЛ = Неопределено И ДокументРПЛ.СписокПроживающих.Количество() > 0 Тогда 
			
			Попытка
				
				ДокументРПЛ.Записать(РежимЗаписиДокумента.Проведение);
				
			Исключение
			КонецПопытки;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Процедура ВводПоказанийПодкрутки()
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЛицевойСчет");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Счетчик");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Здание");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Улица");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Удалить");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(Объект.ДатаЗакрытия));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "ВводПоказанийПоПоказаниям";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	ВыборкаЗдание = СтруктураРезультата.РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЗдание.Следующий() Цикл
		
		ДокументВводПоказаний = Документы.бит_ВводПоказанийПоСчетчикам.СоздатьДокумент();
		
		ДокументВводПоказаний.Дата          = КонецДня(КонецМесяца(Объект.ДатаЗакрытия)) - 2;
		ДокументВводПоказаний.Организация   = Объект.Организация;
		ДокументВводПоказаний.ВидОперации   = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ПоказанияПодкрутки;
		ДокументВводПоказаний.ТипСчетчика   = Перечисления.бит_ТипСчетчика.Индивидуальный;
		ДокументВводПоказаний.Улица         = ВыборкаЗдание.Здание.Улица;
		ДокументВводПоказаний.Дом           = ВыборкаЗдание.Здание;
		ДокументВводПоказаний.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
		ДокументВводПоказаний.Ответственный = мОтветственный;
		ДокументВводПоказаний.ЗаполнитьТаблицуПоказаний();
		
		Отбор = Новый Структура;
		
		Выборка = ВыборкаЗдание.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Отбор.Очистить();
			Отбор.Вставить("ЛицевойСчет",Выборка.ЛицевойСчет); 
			Отбор.Вставить("Счетчик"    ,Выборка.Счетчик);
			
			МассивСтрок =  ДокументВводПоказаний.ПоказанияПоСчетчикам.НайтиСтроки(Отбор);
			
			Для каждого Строка Из МассивСтрок Цикл
				Если Выборка.Удалить Тогда
					
					ДокументВводПоказаний.ПоказанияПоСчетчикам.Удалить(Строка);
					
				КонецЕсли; 
			КонецЦикла; 
			
		КонецЦикла; 
		
		Если ДокументВводПоказаний.ПоказанияПоСчетчикам.Количество() > 0 Тогда
			
			Попытка
				
				ДокументВводПоказаний.Записать(РежимЗаписиДокумента.Проведение);
				
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ВыполнитьОсновныеНачисления()
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Здание");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Улица");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДокументНачисления");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДокументПоСч");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДокументПоЛьготам");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(Объект.ДатаЗакрытия));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "ОсновныеНачисления";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	Запрос = Новый Запрос;
	ТекстЛС = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Здание = &Здание";
	
	Выборка = СтруктураРезультата.РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ЗначениеЗаполнено(Выборка.ДокументНачисления) И Объект.ВыполнитьНачисленияПоНормам Тогда
			
			ДокументНачисленийПоЛС = Выборка.ДокументНачисления.ПолучитьОбъект();
			
			Если ДокументНачисленийПоЛС.ПометкаУдаления Тогда
				
				ДокументНачисленийПоЛС.УстановитьПометкуУдаления(Ложь);
				
			КонецЕсли; 
			
			ДокументНачисленийПоЛС.ЛицевыеСчета.Очистить();
			ДокументНачисленийПоЛС.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДокументПоСч) И Объект.ВыполнитьНачисленияПоСчетчикам Тогда
			
			ДокументНачисленийПоСЧ = Выборка.ДокументПоСч.ПолучитьОбъект();
			
			Если ДокументНачисленийПоСЧ.ПометкаУдаления Тогда
				
				ДокументНачисленийПоСЧ.УстановитьПометкуУдаления(Ложь);
				
			КонецЕсли;
			
			ДокументНачисленийПоСЧ.Начисления.Очистить();
			ДокументНачисленийПоСЧ.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			
		КонецЕсли;
		
		Если ЗначениеЗаполнено(Выборка.ДокументПоЛьготам) И Объект.ВыполнитьНачисленияПоЛьготам Тогда
			
			ДокументНачисленийПоЛьготам = Выборка.ДокументПоЛьготам.ПолучитьОбъект();
			
			Если ДокументНачисленийПоЛьготам.ПометкаУдаления Тогда
				
				ДокументНачисленийПоЛьготам.УстановитьПометкуУдаления(Ложь);
				
			КонецЕсли;
			
			ДокументНачисленийПоЛьготам.ЛицевыеСчета.Очистить();
			ДокументНачисленийПоЛьготам.СписокЛьгот.Очистить();
			ДокументНачисленийПоЛьготам.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	Выборка.Сбросить();
	
	ДокументыНаПроведение = Новый Массив;
	
	Пока Выборка.Следующий() Цикл
		
		Запрос.Текст = ТекстЛС;
		
		Запрос.УстановитьПараметр("Здание", Выборка.Здание);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		СписокЗданий = Новый Массив;
		СписокЛС     = Новый Массив;
		
		СписокЗданий.Добавить(Выборка.Здание);
		
		СписокЛС = Результат.ВыгрузитьКолонку("ЛицевойСчет");
		
		ТаблицаНачислений = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуНачислений();
		ТаблицаСчетчиков  = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
		ТаблицаРаспред    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуРаспредилений();
		ТаблицаПрожив     = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуПроживающих();
		
		бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(КонецМесяца(Объект.ДатаЗакрытия), 
		Объект.Организация, 
		СписокЛС, 
		СписокЗданий, 
		, 
		, 
		ТаблицаНачислений, 
		ТаблицаСчетчиков, 
		ТаблицаРаспред, 
		,
		,
		,
		мКэшЗначений.РасчетСУчетомДолейВладения,
		мКэшЗначений.УменьшениеНормыЛьготыВПределахФакта, 
		мКэшЗначений.НачислениеСУчетомДнейПроживания, 
		ТаблицаПрожив, 
		,
		мКэшЗначений.РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
		мКэшЗначений.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика);
		
		
		// БИТ ЖКХ 08.04.2020
	    ТабЛицевыеСчета    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуНачислений();
		ТаблицаПоДнямСобственности = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуПоДнямСобственности();	

		// БИТ ЖКХ 17.04.2020
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Дата"       , КонецДня(Объект.ДатаЗакрытия));
	//	Запрос.УстановитьПараметр("Организация", Объект.ЛицевойСчет.Организация);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_НастройкаПараметровЖКХСрезПоследних.НачислениеСоДняПраваСобственности КАК НачислениеСоДняПраваСобственности
		|ИЗ
		|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата,) КАК бит_НастройкаПараметровЖКХСрезПоследних";
		
		ВыборкаНастроекЖКХ = Запрос.Выполнить().Выбрать();
		
		Если ВыборкаНастроекЖКХ.Следующий() Тогда
			НачислениеСоДняПраваСобственности = ВыборкаНастроекЖКХ.НачислениеСоДняПраваСобственности;
		Иначе	
			НачислениеСоДняПраваСобственности = Ложь;
		КонецЕсли;

		// БИТ ЖКХ 16.04.2020
  	    //бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисленияПоДнямСобственности(КонецМесяца(Объект.ДатаЗакрытия), Объект.Организация, СписокЛС, СписокЗданий, , , ТабЛицевыеСчета,,,,,,мКэшЗначений.РасчетСУчетомДолейВладения,,мКэшЗначений.НачислениеСУчетомДнейПроживания, ТаблицаПоДнямСобственности);
		если НачислениеСоДняПраваСобственности = Истина тогда 
         бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисленияПоДнямСобственности(КонецМесяца(Объект.ДатаЗакрытия), Объект.Организация, СписокЛС, СписокЗданий, , , ТаблицаНачислений,,,,,,мКэшЗначений.РасчетСУчетомДолейВладения,,мКэшЗначений.НачислениеСУчетомДнейПроживания, ТаблицаПоДнямСобственности);
		конецесли; 

		Если Объект.ВыполнитьНачисления И Объект.ВыполнитьНачисленияПоНормам Тогда
			
			Если  ЗначениеЗаполнено(Выборка.ДокументНачисления) Тогда
				
				ДокументНачисленийПоЛС = Выборка.ДокументНачисления.ПолучитьОбъект();

			Иначе
				
				ДокументНачисленийПоЛС = Документы.бит_НачислениеПоЛицевымСчетам.СоздатьДокумент();
				
				ДокументНачисленийПоЛС.Дата        = КонецМесяца(Объект.ДатаЗакрытия) - 1;
				ДокументНачисленийПоЛС.Организация = Объект.Организация;
				ДокументНачисленийПоЛС.Улица       = Выборка.Улица;
				ДокументНачисленийПоЛС.Здание      = Выборка.Здание;
				
				ДокументНачисленийПоЛС.Ответственный = мОтветственный;
				ДокументНачисленийПоЛС.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
				
			КонецЕсли;
			
			// Начисление по лицевым счетам.
			Если ТаблицаНачислений.Количество() > 0 Тогда
				
				бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаНачислений);
				ДокументНачисленийПоЛС.ЗаполнениеСчетовКУ(ТаблицаНачислений);
				
				ДокументНачисленийПоЛС.ЛицевыеСчета.Очистить();
				ДокументНачисленийПоЛС.ЛицевыеСчета.Загрузить(ТаблицаНачислений);
				
				ДокументНачисленийПоЛС.НачисленияПоПроживающим.Очистить();
				ДокументНачисленийПоЛС.НачисленияПоПроживающим.Загрузить(ТаблицаПрожив);
				
				// БИТ ЖКХ 14.04.2020
				ДокументНачисленийПоЛС.НачисленияПоДнямПраваСобственности.Очистить();
				ДокументНачисленийПоЛС.НачисленияПоДнямПраваСобственности.Загрузить(ТаблицаПоДнямСобственности);
				
				ДокументНачисленийПоЛС.мРасчетСУчетомДолейВладения          = мКэшЗначений.РасчетСУчетомДолейВладения;
				ДокументНачисленийПоЛС.мУменьшениеНормыЛьготыВПределахФакта = мКэшЗначений.УменьшениеНормыЛьготыВПределахФакта;
				
				Попытка
					
					Если ДокументНачисленийПоЛС.ЛицевыеСчета.Количество() > 0 Тогда
						
						ДокументНачисленийПоЛС.Записать(РежимЗаписиДокумента.Запись);
						ДокументыНаПроведение.Добавить(ДокументНачисленийПоЛС.Ссылка);
						
					КонецЕсли; 
					
				Исключение

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
					
				КонецПопытки; 
				
			КонецЕсли;
		КонецЕсли;
		
		Если Объект.ВыполнитьНачисления И Объект.ВыполнитьНачисленияПоСчетчикам Тогда
			
			Если ЗначениеЗаполнено(Выборка.ДокументПоСч) Тогда
				
				ДокументНачисленийПоСЧ = Выборка.ДокументПоСч.ПолучитьОбъект();

			Иначе
				ДокументНачисленийПоСЧ = Документы.бит_НачисленияПоСчетчикам.СоздатьДокумент();
				
				ДокументНачисленийПоСЧ.Дата        = КонецМесяца(Объект.ДатаЗакрытия) - 1;
				ДокументНачисленийПоСЧ.Организация = Объект.Организация;
				ДокументНачисленийПоСЧ.Улица       = Выборка.Улица;
				ДокументНачисленийПоСЧ.Здание      = Выборка.Здание;
				
				ДокументНачисленийПоСЧ.Ответственный = мОтветственный;
				ДокументНачисленийПоСЧ.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
				
			КонецЕсли;
			
			// Начисление по счетчикам.
			Если ТаблицаСчетчиков.Количество() > 0 ИЛИ ТаблицаРаспред.Количество() > 0 Тогда
				
				бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаСчетчиков);
				ДокументНачисленийПоСЧ.ЗаполнениеСчетовКУ(ТаблицаСчетчиков);
				ДокументНачисленийПоСЧ.Начисления.Очистить();
				ДокументНачисленийПоСЧ.Начисления.Загрузить(ТаблицаСчетчиков);
				
				бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаРаспред);
				ДокументНачисленийПоСЧ.ЗаполнениеСчетовКУ(ТаблицаРаспред);
				ДокументНачисленийПоСЧ.Распределения.Очистить();
				ДокументНачисленийПоСЧ.Распределения.Загрузить(ТаблицаРаспред);
				
				ДокументНачисленийПоСЧ.мУчетДнейПроживания = мКэшЗначений.НачислениеСУчетомДнейПроживания;
				
				Попытка
					
					Если ДокументНачисленийПоСЧ.Начисления.Количество() > 0 ИЛИ ДокументНачисленийПоСЧ.Распределения.Количество() > 0 Тогда
						
						ДокументНачисленийПоСЧ.Записать(РежимЗаписиДокумента.Запись);
						ДокументыНаПроведение.Добавить(ДокументНачисленийПоСЧ.Ссылка);
						
					КонецЕсли; 
					
				Исключение

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
					
				КонецПопытки; 
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ПровестиДокументы(ДокументыНаПроведение);
	
	Если мКэшЗначений.ОбщедомовыеРасходыВГрафеНачисления
		И Объект.ВыполнитьОбщедомовыеНачисления Тогда
		
		ВыполнитьОбщедомовыеНачисления();
		
	КонецЕсли;
	
	// Расчет Льгот после выполнения всех начислений.
	ДокументыНаПроведение.Очистить();
	Выборка.Сбросить();
	
	Пока Выборка.Следующий() Цикл
		
		Запрос.Текст = ТекстЛС;
		
		Запрос.УстановитьПараметр("Здание", Выборка.Здание);
		
		Результат = Запрос.Выполнить().Выгрузить();
		
		СписокЗданий = Новый Массив;
		СписокЛС     = Новый Массив;
		
		СписокЗданий.Добавить(Выборка.Здание);
		
		СписокЛС = Результат.ВыгрузитьКолонку("ЛицевойСчет");
		
		ТаблицаЛьгот      = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуЛьгот();
		
		бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(КонецМесяца(Объект.ДатаЗакрытия), 
		Объект.Организация, 
		СписокЛС, 
		СписокЗданий, 
		, 
		, 
		, 
		, 
		, 
		ТаблицаЛьгот,
		,
		,
		мКэшЗначений.РасчетСУчетомДолейВладения,
		мКэшЗначений.УменьшениеНормыЛьготыВПределахФакта, 
		мКэшЗначений.НачислениеСУчетомДнейПроживания, 
		, 
		,
		мКэшЗначений.РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика,
		мКэшЗначений.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика);
		
		Если Объект.ВыполнитьНачисления И Объект.ВыполнитьНачисленияПоЛьготам Тогда
			
			Если ЗначениеЗаполнено(Выборка.ДокументПоЛьготам) Тогда
				
				ДокументНачисленийПоЛьготам = Выборка.ДокументПоЛьготам.ПолучитьОбъект();
				
			Иначе
				
				ДокументНачисленийПоЛьготам = Документы.бит_НачислениеЛьготПоЛицевымСчетам.СоздатьДокумент();
				
				ДокументНачисленийПоЛьготам.Дата        = КонецМесяца(Объект.ДатаЗакрытия) - 1;
				ДокументНачисленийПоЛьготам.Организация = Объект.Организация;
				ДокументНачисленийПоЛьготам.Улица       = Выборка.Улица;
				ДокументНачисленийПоЛьготам.Здание      = Выборка.Здание;
				
				ДокументНачисленийПоЛьготам.Ответственный = мОтветственный;
				ДокументНачисленийПоЛьготам.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
				
			КонецЕсли;
			
			Если ТаблицаЛьгот.Количество() > 0 Тогда
				
				Для Каждого Строка Из ТаблицаЛьгот Цикл
					
					Строка.СуммаСумм = Окр((Строка.СуммаЛичной + Строка.НачисленоСемейной),2);
					
				КонецЦикла;
				
				ДокументНачисленийПоЛьготам.СписокЛьгот.Очистить();
				
				ДокументНачисленийПоЛьготам.СписокЛьгот.Загрузить(ТаблицаЛьгот);
				
				ТаблицаЛьгот.Свернуть("ЛицевойСчет,Услуга,Начислено");
				
				бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаЛьгот);
				ДокументНачисленийПоЛьготам.ЗаполнениеСчетовКУ(ТаблицаЛьгот);
				
				Для каждого СтрокаЛС из ТаблицаЛьгот Цикл
					
					Отбор = Новый Структура;
					
					Отбор.Очистить();
					Отбор.Вставить("ЛицевойСчет", СтрокаЛС.ЛицевойСчет);
					Отбор.Вставить("Услуга"     , СтрокаЛС.Услуга);
					
					МассивСтрокЛьгот = ДокументНачисленийПоЛьготам.СписокЛьгот.НайтиСтроки(Отбор);
					
					Если МассивСтрокЛьгот.Количество()>1 Тогда
						
						СуммаСумм = 0;
						
						Для Каждого Строка Из МассивСтрокЛьгот Цикл
							
							СуммаСумм = СуммаСумм + Строка.СуммаСумм;
							
							Строка.Начислено = Строка.СуммаСумм; 
							
						КонецЦикла;
						
						СтрокаЛС.Начислено =  СуммаСумм;
						
					КонецЕсли;
					
				КонецЦикла;	
				
				ДокументНачисленийПоЛьготам.ЛицевыеСчета.Очистить();
				ДокументНачисленийПоЛьготам.ЛицевыеСчета.Загрузить(ТаблицаЛьгот);
				
				ДокументНачисленийПоЛьготам.мЛьготаПерсонифицированная           = мКэшЗначений.ЛьготаПерсонифицированная;
				ДокументНачисленийПоЛьготам.мРасчетСУчетомДолейВладения          = мКэшЗначений.РасчетСУчетомДолейВладения;
				ДокументНачисленийПоЛьготам.мУменьшениеНормыЛьготыВПределахФакта = мКэшЗначений.УменьшениеНормыЛьготыВПределахФакта;
				
				Попытка
					
					Если ДокументНачисленийПоЛьготам.ЛицевыеСчета.Количество() > 0 Тогда
						
						ДокументНачисленийПоЛьготам.Записать(РежимЗаписиДокумента.Запись);
						ДокументыНаПроведение.Добавить(ДокументНачисленийПоЛьготам.Ссылка);
						
					КонецЕсли; 
					
				Исключение

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
					
				КонецПопытки; 
				
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	ПровестиДокументы(ДокументыНаПроведение);
	
КонецПроцедуры

&НаСервере
Процедура ПровестиДокументы(ДокументыНаПроведение)
	
	Для каждого СсылкаНаДокумент Из ДокументыНаПроведение Цикл
		
		Попытка
			Документ = СсылкаНаДокумент.ПолучитьОбъект();
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры 

&НаСервере
Процедура ВыполнитьОбщедомовыеНачисления()
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("Здание");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Улица");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Документ");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(Объект.ДатаЗакрытия));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "ОбщедомовыеНачисления";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	ДокументОбщедомовыеРасходы = Неопределено;
	
	Отбор = Новый Структура;
	
	Выборка = СтруктураРезультата.РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ Выборка.Документ.Пустая() Тогда
			
			ДокументОбщедомовыеРасходы = Выборка.Документ.ПолучитьОбъект();
			
			Если ДокументОбщедомовыеРасходы.ПометкаУдаления Тогда
				
				ДокументОбщедомовыеРасходы.УстановитьПометкуУдаления(Ложь);
				
			КонецЕсли; 
			
			ДокументОбщедомовыеРасходы.Начисления.Очистить();
			ДокументОбщедомовыеРасходы.Записать(РежимЗаписиДокумента.ОтменаПроведения);
			
		КонецЕсли;
		
	КонецЦикла;
	
	ТаблицаОбщедомовыеНачисления = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуОбщедомовыхРасходов();
	
	бит_РасчетыПоКоммунальнымУслугам.РасчитатьНачисленияПоОбщедомовымРасходам(КонецМесяца(Объект.ДатаЗакрытия)
	,Объект.ДатаЗакрытия
	,Объект.ДатаЗакрытия
	,Объект.Организация
	,ТаблицаОбщедомовыеНачисления
	,мКэшЗначений.УчитыватьНачисленияПоГрупповымСчетчикам
	,мКэшЗначений.УчитыватьПерерасчет);
	
	бит_РасчетыПоКоммунальнымУслугам.ДобавитьКолонкиБухУчета(ТаблицаОбщедомовыеНачисления);
	
	СписокЛС = ТаблицаОбщедомовыеНачисления.ВыгрузитьКолонку("ЛицевойСчет");
	Колонки  = ТаблицаОбщедомовыеНачисления.Колонки;
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ТаблицаОбщедомовыеНачисления, Колонки, СписокЛС, Объект.Организация, Объект.ДатаЗакрытия);
	
	ТаблицаОбщедомовыеНачисления.Сортировать("Приоритет ВОЗР, НаименованиеЛС ВОЗР");
	
	ДокументыНаПроведение = Новый Массив;
	
	Выборка.Сбросить();
	
	Пока Выборка.Следующий() Цикл
		
		Если НЕ Выборка.Документ.Пустая() Тогда
			
			ДокументОбщедомовыеРасходы = Выборка.Документ.ПолучитьОбъект();
			
		Иначе
			
			ДокументОбщедомовыеРасходы = Документы.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными.СоздатьДокумент();
			
			ДокументОбщедомовыеРасходы.Дата          = КонецМесяца(Объект.ДатаЗакрытия) - 1;
			ДокументОбщедомовыеРасходы.Улица         = Выборка.Улица;
			ДокументОбщедомовыеРасходы.Здание        = Выборка.Здание;
			ДокументОбщедомовыеРасходы.Организация   = Объект.Организация;
			ДокументОбщедомовыеРасходы.Ответственный = мОтветственный;
			ДокументОбщедомовыеРасходы.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
			
		КонецЕсли;
		
		Отбор.Очистить();
		Отбор.Вставить("Здание", Выборка.Здание);
		
		СтрокиПоЗданию = ТаблицаОбщедомовыеНачисления.НайтиСтроки(Отбор);
		
		Если НЕ ДокументОбщедомовыеРасходы = Неопределено Тогда
			
			ДокументОбщедомовыеРасходы.Начисления.Очистить();
			
			Если СтрокиПоЗданию.Количество() > 0 Тогда
				
				Для каждого СтрокаТаблицы Из СтрокиПоЗданию Цикл
					
					НоваяСтрока = ДокументОбщедомовыеРасходы.Начисления.Добавить();
					ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаТаблицы);
					
				КонецЦикла; 
				
				Попытка
					
					ДокументОбщедомовыеРасходы.Записать(РежимЗаписиДокумента.Запись);
					ДокументыНаПроведение.Добавить(ДокументОбщедомовыеРасходы.Ссылка);
					
				Исключение

					бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
					
				КонецПопытки; 
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Для каждого СсылкаНаДокумент Из ДокументыНаПроведение Цикл
		
		Попытка
			Документ = СсылкаНаДокумент.ПолучитьОбъект();
			Документ.Записать(РежимЗаписиДокумента.Проведение);
		Исключение

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка: " + ОписаниеОшибки());
			
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры

