Процедура ЗаполнитьДатыРождения()
	
	Набор = РегистрыСведений.лб_Тест_Жильцы.СоздатьНаборЗаписей();
	Набор.Прочитать();
	Для каждого Запись из Набор Цикл
		Если ЗначениеЗаполнено(Запись.ДатаРождения) тогда 
			продолжить 
		КонецЕсли;
		Если Запись.D_R = "  .  .    " тогда 
			ДатаРождения = '0001-01-01'
		Иначе
			Год = сред(Запись.D_R,7,4);
			День = лев(Запись.D_R,2);
			Если Прав(день,1)>"0" и лев(день,1)=" " тогда
				День = "0"+прав(день,1);
			КонецЕсли;	
			Месяц = сред(Запись.D_R,4,2);
			Если Год<"1900" или Год > "2030" или 
				 День<"01" или День>"31" или
				 Месяц<"01" или Месяц>"12" 
			тогда
			     ДатаРождения = '0001-01-01'
			иначе
				 ДатаРождения = Дата(""+Год+Месяц+День)
			КонецЕсли;			
		КонецЕсли;	
		Если ДатаРождения<>Запись.ДатаРождения тогда
			Запись.ДатаРождения =ДатаРождения
		КонецЕсли;
		
	КонецЦикла;	
	
	Если Набор.Модифицированность() тогда
		Набор.Записать(истина);
	КонецЕсли;	
	
КонецПроцедуры	

Процедура ПодобратьЖильцовПоФИО();
	 Запрос = новый запрос;
	 Запрос.Текст = 
	 	"ВЫБРАТЬ
	 	|	бит_Проживающие.Ссылка КАК Ссылка,
	 	|	бит_Проживающие.ДатаРождения КАК ДатаРождения,
	 	|	бит_Проживающие.Наименование КАК Наименование
	 	|ИЗ
	 	|	Справочник.бит_Проживающие КАК бит_Проживающие
	 	|
	 	|УПОРЯДОЧИТЬ ПО
	 	|	Наименование,
	 	|	ДатаРождения УБЫВ";
	 Табл = Запрос.Выполнить().Выгрузить();
	 Табл.Индексы.Добавить("Наименование");
	 Табл.Индексы.Добавить("ДатаРождения");
	 
	 Набор = РегистрыСведений.лб_Тест_Жильцы.СоздатьНаборЗаписей();
	 Набор.Прочитать();
	 МаксИндекс = Набор.Количество()-1;
	 Для Инд = 0 по МаксИндекс цикл
		 Запись = набор[инд];
		 ФИО = СокрЛП(Запись.FIO)+ " "+ СокрЛП(Запись.NAME)+ " "+ СокрЛП(Запись.OTCH);
		 ФИО = СокрЛП(ФИО);
		 ПервыйСимв = врег(Лев(ФИО,1));
		 Буквы = "АБВГДЕЁЖЗИЙКЛМНОПРСТУФХЦЧШЩЪЫЬЭЮЯ"+"ABCDEFGHIJKLNMPQRSTUVWXYZ";
		 ЦифрыИВопрос = "0123456789?";
	     ЭтоРеальныйЧеловек = СтрНайти(Буквы,ПервыйСимв)>0; 		
		 ЭтоОбезличенный    = СтрНайти(ЦифрыИВопрос,ПервыйСимв)>0;
		 Если НЕ ЭтоРеальныйЧеловек и не ЭтоОбезличенный тогда
			 Сообщить("Найдено транное ФИО : "+ФИО);
		 КонецЕсли;	 
		 
		 Если ЭтоОбезличенный тогда 			 
			 продолжить
		 КонецЕсли;	 
		 
		 Проживающий = Справочники.бит_Проживающие.ПустаяСсылка();
		 Отбор = новый структура("Наименование",ФИО);
		 СтрокиФИО = Табл.НайтиСтроки(Отбор);
		 Для каждого СтрокаФИО из СтрокиФИО цикл
			 Если Запись.ДатаРождения = '0001-01-01' 
				  или СтрокаФИО.ДатаРождения = Запись.ДатаРождения 
				  или СтрокаФИО.ДатаРождения = '0001-01-01' 
			 тогда	
			      Проживающий = СтрокаФИО.Ссылка;
			 КонецЕсли;
		 КонецЦикла;	 
		 
		 Если Запись.Жилец<>Проживающий тогда
		 	Запись.Жилец = Проживающий;
		 КонецЕсли;	
	 КонецЦикла;	 
	 
	 Если Набор.Модифицированность() тогда
		 Набор.Записать(истина);
	 КонецЕсли;	 
	 
	
 КонецПроцедуры

