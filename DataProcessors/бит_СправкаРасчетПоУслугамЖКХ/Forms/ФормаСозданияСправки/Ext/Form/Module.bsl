&НаСервере
Процедура СформироватьСправкуНаСервере()
	
	ОбработкаОбъект = РеквизитФормыВЗначение("Объект");
	
	Объект.ФормаРезультата.Очистить();
	
	Объект.ФормаРезультата.Вывести(ОбработкаОбъект.СформироватьПечатнуюФорму());
	
	ЭтаФорма.ТекущийЭлемент = Элементы.ФормаРезультата;
	
КонецПроцедуры


&НаКлиенте
Процедура СформироватьСправку(Команда)
	СформироватьСправкуНаСервере();
КонецПроцедуры


