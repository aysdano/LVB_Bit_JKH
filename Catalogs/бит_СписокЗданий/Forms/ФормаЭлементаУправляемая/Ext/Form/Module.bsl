//HD+
// Устанавливает режим только просмотра для роли HD_ОтделПоРаботеСНаселением_Пользователь.
//
&НаКлиенте
Процедура HD_УстановитьТолькоПросмотрДляОтделаПоРаботеСНаселением()
	
	Если НЕ HD_ТребуетсяОграничениеДоступаОтделаПоРаботеСНаселением() Тогда
		Возврат;
	КонецЕсли;
	
	ТолькоПросмотр = Истина;
	
	Для Каждого ЭлементФормы Из Элементы Цикл
		HD_ЗаблокироватьЭлементФормыДляПросмотра(ЭлементФормы);
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Блокирует редактирование элемента формы, оставляя доступной только команду закрытия.
//
&НаКлиенте
Процедура HD_ЗаблокироватьЭлементФормыДляПросмотра(ЭлементФормы)
	
	ТипЭлемента = ТипЗнч(ЭлементФормы);
	
	Если ТипЭлемента = Тип("ПолеФормы") Тогда
		
		Если ЭлементФормы.Вид <> ВидПоляФормы.ПолеНадписи Тогда
			ЭлементФормы.ТолькоПросмотр = Истина;
		КонецЕсли;
		
	ИначеЕсли ТипЭлемента = Тип("ТаблицаФормы") Тогда
		
		ЭлементФормы.ТолькоПросмотр = Истина;
		
	ИначеЕсли ТипЭлемента = Тип("КнопкаФормы") Тогда
		
		Если HD_ЭтоРазрешеннаяКомандаТолькоПросмотра(ЭлементФормы.Имя) Тогда
			Возврат;
		КонецЕсли;
		
		ЭлементФормы.Доступность = Ложь;
		
	ИначеЕсли ТипЭлемента = Тип("ГруппаФормы")
		И СтрЗаканчиваетсяНа(ЭлементФормы.Имя, "КоманднаяПанель") Тогда
		
		ЭлементФормы.Доступность = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры //HD-

