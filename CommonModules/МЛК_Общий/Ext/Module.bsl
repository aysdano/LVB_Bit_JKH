		ПериодНачислений = ПолучитьПериодНачисленийПоЛицевомуСчету(ЛС);
		
		Обработка.Период      = ПериодНачислений;
		Обработка.ОбновитьНастройкиЖКХ();
		Обработка.ОбновитьКэшОрганизации();
		// БИТ_В.Калинин 24.01.2017 13:35:35 Начало правки...
		Обработка.ОбновитьКэшПолучателяПлатежа();
		// БИТ_В.Калинин 24.01.2017 13:35:35 Конец правки.
		Обработка.ПолучитьНастройкуМакета();
		//
		ТаблицаДанных = ОбработкаОбъект.СформироватьДанныеПечати();
		//
		Если ТаблицаДанных.количество() <> 0 Тогда
			Для Каждого СтрТабл Из ТаблицаДанных Цикл
				Если СтрТабл.Значение.СтруктураДанных.КОплатеЗаМесяц = 0 Тогда Продолжить; КонецЕсли;
				Нов = ТаблицаДанныхНачислений.Добавить();
				Нов.Период   = СтрТабл.Значение.СтруктураДанных.Дата; 
				Нов.Начислено= СтрТабл.Значение.СтруктураДанных.КОплатеЗаМесяц;
			КонецЦикла;
		КонецЕсли;
		ПериодДанных = КонецМесяца(КонецМесяца(ПериодДанных)+(60*60*24));
	КонецЦикла;
	Возврат ТаблицаДанныхНачислений;
