&НаКлиенте
Процедура ПроживающиеРегионГаз(Команда)
	ФайлПроживающиеРегионГаз = ОткрытьФайл();
	ПроживающиеРегионГазНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПроживающиеРегионГазНаСервере()
		
	Массив = Новый Массив;
	Массив.Добавить("Период");
	Массив.Добавить("Поставщик");
	
	Для Каждого Реквизит ИЗ Массив Цикл
		Если Не ЗначениеЗаполнено(Объект[Реквизит]) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Реквизит);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат
		КонецЕсли;
	КонецЦикла;
		
	НовыйДБФ = СоздатьПустойДБФПроживающиеРегионГаз();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПроживающиеРегионГаз();
	Запрос.УстановитьПараметр("ПериодК", Новый Граница(КонецМесяца(Объект.Период), ВидГраницы.Включая));	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		НовыйДБФ.Добавить();
		
		ЛС = Строка.Ссылка.Наименование;
		Здание = Строка.Ссылка.Здание;
		Адрес = АдресПоЛСМассивПодробно(Строка.Ссылка, Здание);
		ФИО = ФИО(Строка.ФизЛицо);
		
		НовыйДБФ.LS = Строка.Ссылка.Наименование;
		НовыйДБФ.ULICA = Адрес[0];
		НовыйДБФ.DOM = Адрес[1];
		НовыйДБФ.KORP = Адрес[2];
		НовыйДБФ.KVART = Адрес[3];
		НовыйДБФ.CHLEN = Строка.CHLEN;
		НовыйДБФ.PLOSH = Строка.PLOSH;
		НовыйДБФ.FAM = ФИО.Фамилия;
		НовыйДБФ.IM = ФИО.Имя;
		НовыйДБФ.OTCH = ФИО.Отчество;
		НовыйДБФ.DAT_R = Строка.DAT_R;
		НовыйДБФ.DAT_REG = Строка.DAT_REG;
		НовыйДБФ.DAT_UNREG = Строка.DAT_UNREG;
		НовыйДБФ.VID_REG = Строка.VID_REG;
		
		РодОтношение = "";
		Если НЕ Строка.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_НеУказано и НЕ Строка.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
			РодОтношение = Строка(Строка.СтепеньРодства);
		КонецЕсли;
		
		Если Строка.K_SOB = 1 и Строка.ВладелецКвартиры = 1 Тогда
			Доля = "Собств., ";
			НовыйДБФ.ROD_OT = Доля + РодОтношение;
		Иначе
			Доля = "";
			Если Строка.ВладелецКвартиры = 1 И Строка.ДоляПлощади <> 0 Тогда
				Доля = "Собств. " + Дробь(Строка.ДоляПлощади) + ", ";
			КонецЕсли;
			НовыйДБФ.ROD_OT = Доля + РодОтношение; 
		КонецЕсли;
		
		НовыйДБФ.Записать();
	КонецЦикла;
	
	НовыйДБФ.ЗакрытьФайл();
	
	ПереместитьФайл(ФайлПроживающиеРегионГазВр, ФайлПроживающиеРегионГаз);	

КонецПроцедуры

Функция СоздатьПустойДБФПроживающиеРегионГаз()
	
	//ошибка при превышении длины имени файла
	ФайлПроживающиеРегионГазВр = КаталогВременныхФайлов() + "new.dbf";
	
	ДБФ = Новый XBase;
	ДБФ.Кодировка = КодировкаXBase.OEM;
	ДБФ.Поля.Добавить("PRIZ", "S", 1);
	ДБФ.Поля.Добавить("LS", "F", 11, 0);
	ДБФ.Поля.Добавить("ULICA", "S", 30);
	ДБФ.Поля.Добавить("DOM", "S", 5);
	ДБФ.Поля.Добавить("KORP", "S", 4);	
	ДБФ.Поля.Добавить("KVART", "S", 30);
	ДБФ.Поля.Добавить("CHLEN", "N", 2);
	ДБФ.Поля.Добавить("PLOSH", "F", 5, 2);
	ДБФ.Поля.Добавить("LGOT", "N", 2);
	ДБФ.Поля.Добавить("FAM", "S", 30);
	ДБФ.Поля.Добавить("IM", "S", 15);
	ДБФ.Поля.Добавить("OTCH", "S", 15);
	ДБФ.Поля.Добавить("DAT_R", "D", 8);
	ДБФ.Поля.Добавить("DAT_REG", "D", 8);
	ДБФ.Поля.Добавить("DAT_UNREG", "D", 8);
	ДБФ.Поля.Добавить("VID_REG", "S", 15);
