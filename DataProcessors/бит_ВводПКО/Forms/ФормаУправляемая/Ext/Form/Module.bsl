&НаСервере
Процедура ПолучитьИЗаписатьПриходныйКассовыйОрдерНаСервере(Знач ПриходныйКассовыйОредер,ПрименениеУСН, СуммаПринимаемых);
	
	ОбъектДокумента = ПриходныйКассовыйОредер.ПолучитьОбъект();
	
	Если ОбъектДокумента = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ОбъектДокумента.Проведен И НЕ ОбъектДокумента.ПометкаУдаления Тогда
		
		Попытка
			НачатьТранзакцию();
			ОбъектДокумента.Записать(РежимЗаписиДокумента.Проведение);
			
			// РучнаяКорректировка. 
			Если ПрименениеУСН Тогда
				
				//05.07.2019
				Если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(ОбъектДокумента, "РучнаяКорректировка") = истина И
					НЕ ОбъектДокумента.РучнаяКорректировка Тогда
					ОбъектДокумента.РучнаяКорректировка = Истина;
					ОбъектДокумента.Записать(РежимЗаписиДокумента.Запись);
				КонецЕсли;				
				//05.07.2019

				//05.07.2019
				если ТипЗнч(ОбъектДокумента.Ссылка) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") = ложь тогда
				 НаборЗаписей = РегистрыНакопления.КнигаУчетаДоходовИРасходов.СоздатьНаборЗаписей();
				 НаборЗаписей.Отбор.Регистратор.Установить(ПриходныйКассовыйОредер);
				 НаборЗаписей.УстановитьАктивность(НЕ ПриходныйКассовыйОредер.ПометкаУдаления);
				 НаборЗаписей.Прочитать();
				 Если НаборЗаписей.Количество() = 1 Тогда
					НаборЗаписей[0].Графа5 = ПриходныйКассовыйОредер.Графа5_УСН;
					//СтрокаРасшифровки.Графа5 = ПриходныйКассовыйОредер.Графа5_УСН;??
				 КонецЕсли;
				 НаборЗаписей.Записать(Истина);
				конецесли; 

			КонецЕсли;
		
			ЗафиксироватьТранзакцию();
		Исключение
			ОтменитьТранзакцию();
			ЗаписьЖурналаРегистрации(
				НСтр("ru = 'Корректировка движений'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()), 
				УровеньЖурналаРегистрации.Ошибка,, 
				ПриходныйКассовыйОредер, 
				ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
			ВызватьИсключение ОписаниеОшибки();
		КонецПопытки;
		
	КонецЕсли;
	
КонецПроцедуры

