	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если Выборка.ВидСвойства.Предопределенный Тогда
			
			ИмяПВХ = ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ПолучитьИмяПредопределенного(Выборка.ВидСвойства);
			//
			Если Элементы.Найти(ИмяПВХ) <> Неопределено Тогда  
				
				ЭтаФорма[ИмяПВХ] = Выборка.Значение;
			КонецЕсли;
		Иначе
			
			НоваяСтрока = СвойстваЗдания.Добавить();
			
			ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
&НаСервере
Процедура ОбновитьСтруктуруПолейТСЖ()
	
	ЗначениеПолейТСЖ = Новый Структура;
	
	ЗначениеПолейТСЖ.Вставить("ТСЖ"                , Неопределено);
	ЗначениеПолейТСЖ.Вставить("ДатаСоздания"       , Дата("00010101"));
	ЗначениеПолейТСЖ.Вставить("Председатель"       , Справочники.бит_Проживающие.ПустаяСсылка());
	ЗначениеПолейТСЖ.Вставить("КонтролирующийОрган", Справочники.бит_ОрганыФМС.ПустаяСсылка());
	
	ЗначениеПолейТСЖ.Вставить("Период", Дата("00010101"));
	
КонецПроцедуры // ()

// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
&НаСервере
Процедура ЗаполнитьТСЖ()
	
	ОбновитьСтруктуруПолейТСЖ();
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Период", КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Здание", Объект.Ссылка);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_ИнформацияТСЖСрезПоследних.ТСЖ,
	|	бит_ИнформацияТСЖСрезПоследних.ДатаСоздания КАК ДатаСоздания,
	|	бит_ИнформацияТСЖСрезПоследних.Председатель,
	|	бит_ИнформацияТСЖСрезПоследних.КонтролирующийОрган,
	|	бит_ИнформацияТСЖСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.бит_ИнформацияТСЖ.СрезПоследних(&период, Здание = &Здание) КАК бит_ИнформацияТСЖСрезПоследних
	|ГДЕ
	|	(бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия = ДАТАВРЕМЯ(1, 1, 1)
	|			ИЛИ бит_ИнформацияТСЖСрезПоследних.ДатаЗакрытия > &Период)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ДатаСоздания УБЫВ";
	
	Результат  = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	Выборка = Результат.Выбрать();
	
	Выборка.Следующий();
	
	ЗначениеПолейТСЖ.ТСЖ                 = Выборка.ТСЖ;
	ЗначениеПолейТСЖ.ДатаСоздания        = Выборка.ДатаСоздания;
	ЗначениеПолейТСЖ.Председатель        = Выборка.Председатель;
	ЗначениеПолейТСЖ.КонтролирующийОрган = Выборка.КонтролирующийОрган;
	ЗначениеПолейТСЖ.Период              = Выборка.Период;
	
	ДатаСозданияПриОткрытии        = Выборка.ДатаСоздания; 
	ТСЖПриОткрытии                 = Выборка.ТСЖ; 
	ПредседательПриОткрытии        = Выборка.Председатель; 
	КонтролирующийОрганПриОткрытии = Выборка.КонтролирующийОрган; 
	ПериодПриОткрытии              = Выборка.Период; 
	
	ОбновитьТСЖ();
	
КонецПроцедуры // ()

// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
&НаСервере
Процедура ОбновитьТСЖ()
	
	ТСЖ                 = Неопределено;
	Председатель        = Неопределено;
	ДатаСоздания        = Неопределено;
	КонтролирующийОрган = Неопределено;
	Период              = Неопределено;
	
	АдресТСЖ   = "";
	ТелефонТСЖ = "";
	АдресКО    = "";
	ТелефонКО  = "";
	СайтКО     = "";
	
	ТСЖ                 = ЗначениеПолейТСЖ.ТСЖ;
	Председатель        = ЗначениеПолейТСЖ.Председатель;
	ДатаСоздания        = ЗначениеПолейТСЖ.ДатаСоздания;
	КонтролирующийОрган = ЗначениеПолейТСЖ.КонтролирующийОрган;
	Период              = ЗначениеПолейТСЖ.Период;
	
	Если ЗначениеЗаполнено(ТСЖ) Тогда
		
		АдресТСЖ   = бит_УправлениеКонтактнойИнформацией.ПолучитьАдресИзКонтактнойИнформации(ТСЖ, "Фактический");
