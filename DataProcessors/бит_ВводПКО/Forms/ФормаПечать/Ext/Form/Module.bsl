&НаКлиенте
Процедура АдресЭлектроннойПочтыПриИзменении(Элемент)
	
	ТекущиеДанные = Объект.Документы.НайтиСтроки(Новый Структура("Документ",Элементы.Документы.ТекущиеДанные.Документ))[0];
	
	Устройство = Элементы.Документы.ТекущиеДанные.ПараметрыДокумента.ИдентификаторУстройства;	
	
	Если ЗначениеЗаполнено(АдресЭлектроннойПочты) Тогда
		ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail = АдресЭлектроннойПочты;
		ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].Отправляет1СEmail = ПолучитьНастройкиОтправкиОтчетов(Устройство).Отправляет1СEmail;
	Иначе
		ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail = "";
		ТекущиеДанные.ПараметрыДокумента.МассивЧеков[0].Отправляет1СEmail = Ложь;
	КонецЕсли;
	
	ОтправлятьEmail = ЗначениеЗаполнено(АдресЭлектроннойПочты);
	
	ОбработкаПроверкиЗаполненияНаСервере(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура НомерТелефонаПриИзменении(Элемент)
	
	ТекущиеДанные = Объект.Документы.НайтиСтроки(Новый Структура("Документ",Элементы.Документы.ТекущиеДанные.Документ))[0];
	
	Устройство = Элементы.Документы.ТекущиеДанные.ПараметрыДокумента.ИдентификаторУстройства;	
	
