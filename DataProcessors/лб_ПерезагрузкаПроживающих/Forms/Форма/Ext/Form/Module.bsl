Процедура ОтключитьВсеУслугиПоСпискуЛСНаСервере()
	// Вставить содержимое обработчика.
	
	МассивСтру = ЗагрузитьДБФВМассивСтруктур();
	ТаблЛС = новый ТаблицаЗначений;
	ТаблЛС.Колонки.Добавить("ИмяЛС10",новый ОписаниеТипов("Строка",,,,новый КвалификаторыСтроки(10,ДопустимаяДлина.Переменная)));
	МассивИменЛС = новый массив(МассивСтру.Количество());
	ЧислоСтру = МассивСтру.Количество();
	Для инд = 0 по ЧислоСтру -1 цикл
		НовСтрока = ТаблЛС.Добавить();
		НовСтрока.ИмяЛС10 = МассивСтру[инд].LS;		
	КонецЦикла;	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("ТаблИ",ТаблЛС);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТаблИ.ИмяЛС10 КАК ИмяЛС10
		|ПОМЕСТИТЬ ТаблИменЛС
		|ИЗ
		|	&ТаблИ КАК ТаблИ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛС
		|ИЗ
		|	ТаблИменЛС КАК ТаблИменЛС
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ПО (ПОДСТРОКА(ТаблИменЛС.ИмяЛС10, 1, 10) = ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 1, 10))";
	
	МассивЛС = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("ЛС");
	
	РежимНеНачислять = Справочники.бит_РежимыПотребленияУслуг.НеНачислять;
	
	Запрос = новый Запрос;
	Запрос.УстановитьПараметр("СписокЛС", МассивЛС);
	Запрос.УстановитьПараметр("НеНачислять",Справочники.бит_РежимыПотребленияУслуг.НеНачислять);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
		|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик,
		|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета,
		|	&НеНачислять КАК РежимПотребления
		|ИЗ
		|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(ДАТАВРЕМЯ(2019, 1, 1), ЛицевойСчет В (&СписокЛС)) КАК бит_СведенияПоУслугамЛССрезПоследних
		|ГДЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления <> &НеНачислять
		|ИТОГИ ПО
		|	Услуга";
	Выборка = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока выборка.Следующий() цикл
		
		
		Док = Документы.бит_УстановкаИзменениеУслугПоЛС.СоздатьДокумент();
		Док.ВидОперации = Перечисления.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета;
		Док.Дата = Дата(2018,12,27);
		
		
		Док.Комментарий = "Отключение услуг ЛС из файла "+ ЭтаФорма.ИмяФайлаКл;
		Док.Услуга = Выборка.Услуга;
		
		ВыборкаЛС = Выборка.Выбрать();
		Пока ВыборкаЛС.Следующий() цикл
			НовСтрока = Док.ЛицевыеСчета.Добавить();
			ЗаполнитьЗначенияСвойств(НовСтрока,ВыборкаЛС);
		КонецЦикла;	
		
		Док.Записать(РежимЗаписиДокумента.Запись);
		Док.Записать(РежимЗаписиДокумента.Проведение);
		
	КонецЦикла;	
		
	
	
	
	
	
	
КонецПроцедуры

