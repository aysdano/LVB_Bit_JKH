	               |	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	               |	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета,
	               |	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь КАК ЖилаяПлощадь
	               |ИЗ
	               |	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
	               |			&НачалоПериода,
	               |			&КонецПериода,
	               |			Регистратор,
	               |			ЛицевойСчет В (&ЛицевойСчет)
	               |				И УслугаЖКХ В (&Услуги)) КАК бит_ОбъемыПоУслугамЖКХОбороты
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&КонецПериода, ) КАК бит_СведенияОКвартиреСрезПоследних
	               |		ПО бит_ОбъемыПоУслугамЖКХОбороты.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	               |				&КонецПериода,
	               |				ЛицевойСчет В (&ЛицевойСчет)
	               |					И Услуга В (&Услуги)) КАК бит_СведенияПоУслугамЛССрезПоследних
	               |		ПО бит_ОбъемыПоУслугамЖКХОбороты.ЛицевойСчет = бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет
	               |			И бит_ОбъемыПоУслугамЖКХОбороты.УслугаЖКХ = бит_СведенияПоУслугамЛССрезПоследних.Услуга
	               |ГДЕ
	               |	бит_ОбъемыПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	               |
	               |СГРУППИРОВАТЬ ПО
	               |	бит_ОбъемыПоУслугамЖКХОбороты.ЛицевойСчет,
	               |	бит_ОбъемыПоУслугамЖКХОбороты.УслугаЖКХ,
	               |	бит_ОбъемыПоУслугамЖКХОбороты.Период,
	               |	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	               |	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	               |	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь";
	
	
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.КонПериода));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевыеСчета);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Объект.НачПериода));
	Запрос.УстановитьПараметр("Услуги", Объект.Услуга);
	
	РезультатЗапроса = Запрос.Выполнить(); 	
	Выборка = РезультатЗапроса.Выгрузить();
	ДолиПериода = ПолучитьДолюПериодаНаСервере();
	
	//Создаем массив в который записываем результат расчета
	//Массив из 1 столбца, данные лежат в порядке Номер ЛС, Объем, Сумма
	
	 Массив = Новый Массив;
 
	 Для Каждого Строка Из Выборка Цикл
		Период = КонецМесяца(Строка.Период);
		Отбор = Новый Структура;
		    Отбор.Вставить("Период", Период);
			СтрокаДолиПериода = ДолиПериода.НайтиСтроки(отбор);
		ДоляПериода = СтрокаДолиПериода[0].ДоляПериода;
	    Массив.Добавить(строка.ЛицевойСчет);
		//НовыйОбъем = строка.Объем * доляПериода;
		Массив.Добавить(Объект.Сумма);        
		//++АнисимоваМВ 12.11.2024 исправление ошибки заполнения без объема
		Площадь = ?(Строка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади,Строка.ОбщаяПлощадь, Строка.ЖилаяПлощадь);
		ИтоговаяСумма = Объект.Сумма * Площадь * ДоляПериода;
		//--АнисимоваМВ 12.11.2024
		//НоваяСумма = строка.СуммаОборот * ДоляПериода;
		//ИтоговаяСумма = Объект.Сумма * НовыйОбъем - НоваяСумма;
		//ИтоговаяСумма = Объект.Сумма * НовыйОбъем;
		Массив.Добавить(ИтоговаяСумма);
	КонецЦикла;
	
    Возврат Массив;
	//Конец работ
		  
КонецФункции

&НаСервере
Функция ПолучитьПлощадиНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
		|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь КАК ЖилаяПлощадь,
		|	бит_ЛицевыеСчета.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
		|		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
		//Михайлов 05.02.01 Начало работ
		|ГДЕ бит_ЛицевыеСчета.Ссылка =&Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ЛицевойСчет); 
	
	
		
	РезультатЗапроса = Запрос.Выполнить();  	
	Выборка = РезультатЗапроса.Выгрузить();
		
	Массив = ОбщегоНазначения.ТаблицаЗначенийВМассив(Выборка);
	
    Возврат Массив;
	//Конец работ		
КонецФункции
