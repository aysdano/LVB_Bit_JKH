
#Область ОбщиеПеременные

// Функция получает массив непроведенных документов.
//
// Параметры:
//  МассивДокументов - Массив.
//
// Возвращаемое значение:
//  МассивНепроведенных - Массив.
// 
Функция ПолучитьМассивНепроведенныхДокументов(МассивДокументов) Экспорт 
	
	МассивНепроведенных = Новый Массив;
	ИмяДокумента 		= МассивДокументов[0].Метаданные().Имя;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МассивДокументов", МассивДокументов);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Документ.Ссылка КАК Ссылка
	|ИЗ
	|	Документ." + ИмяДокумента + " КАК Документ
	|ГДЕ
	|	Документ.Ссылка В (&МассивДокументов)
	|	И Не Документ.Проведен";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если Не РезультатЗапроса.Пустой() Тогда
		
		ВыборкаИзЗапроса = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаИзЗапроса.Следующий() Цикл
			МассивНепроведенных.Добавить(ВыборкаИзЗапроса.Ссылка);
		КонецЦикла;
		
	КонецЕсли;
	
	Возврат МассивНепроведенных;
	
КонецФункции // ПолучитьМассивНепроведенныхДокументов()

// Функция получает проводит непроведенные документы.
//
// Параметры:
//  МассивДокументов - Массив.
//
// Возвращаемое значение:
//  МассивНепроведенных - Массив.
// 
Функция ПровестиНепроведенныеДокументы(МассивДокументов) Экспорт 
	
	МассивНепроведенных = Новый Массив;
	
	Заголовок = "Проведение документов при печати";
	
	Для Каждого ТекДокумент Из МассивДокументов Цикл
		
		ДокументОбъект   = ТекДокумент.ПолучитьОбъект();
		ДокументПроведен = бит_ОбщегоНазначения.ЗаписатьПровестиДокумент(ДокументОбъект
																		,РежимЗаписиДокумента.Проведение
																		,Заголовок
																		,"Ошибки");
		Если Не ДокументПроведен Тогда	
			МассивНепроведенных.Добавить(ТекДокумент);
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат МассивНепроведенных;
	
КонецФункции // ПровестиНепроведенныеДокументы()

#КонецОбласти

