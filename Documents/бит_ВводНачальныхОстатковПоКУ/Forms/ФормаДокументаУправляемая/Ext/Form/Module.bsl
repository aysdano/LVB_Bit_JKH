&НаКлиенте
Процедура Рассчитать(Команда)
	
	Если ЗначениеЗаполнено(Объект.Период)
		И ЗначениеЗаполнено(Объект.Организация) Тогда
		РассчитатьНаСервере();
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура РассчитатьНаСервере()
	
	Запрос = Новый Запрос;
	
	МассивЛС = Объект.СписокЛС.Выгрузить(,"ЛицевойСчет").ВыгрузитьКолонку("ЛицевойСчет");
	Запрос.УстановитьПараметр("ЛицевыеСчета", МассивЛС);
	Запрос.УстановитьПараметр("Организация"	, Объект.Организация);
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Объект.Период));
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств КАК ПолучательДенежныхСредств,
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры
	|ПОМЕСТИТЬ ПоставщикиИУслуги
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&КонецПериода {(&КонецПериода)},
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					ЛицевыеСчета.Ссылка
	|				ИЗ
	|					Справочник.бит_ЛицевыеСчета КАК ЛицевыеСчета
	|				ГДЕ
	|					ЛицевыеСчета.Организация = &Организация
	|					" + ?(МассивЛС.Количество() > 0, "И ЛицевыеСчета.Ссылка В (&ЛицевыеСчета)", "") + ")) КАК бит_СведенияПоУслугамЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПолучателиДенежныхСредств.СрезПоследних(&КонецПериода {(&КонецПериода)}, ) КАК бит_ПолучателиДенежныхСредствСрезПоследних
	|		ПО бит_СведенияПоУслугамЛССрезПоследних.Услуга = бит_ПолучателиДенежныхСредствСрезПоследних.Услуга
	|			И бит_СведенияПоУслугамЛССрезПоследних.Поставщик = бит_ПолучателиДенежныхСредствСрезПоследних.Поставщик
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&КонецПериода {(&КонецПериода)}, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
	|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик,
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	|	бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств,
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ КАК УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
	|ПОМЕСТИТЬ ВТ_Остатки
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|			,
	|			&КонецПериода,
	|			,
	|			,
	|			(ЛицевойСчет, УслугаЖКХ) В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ПоставщикиИУслуги.ЛицевойСчет,
	|					ПоставщикиИУслуги.Услуга
	|				ИЗ
	|					ПоставщикиИУслуги)) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	УслугаЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПоставщикиИУслуги.ЛицевойСчет КАК ЛицевойСчет,
	|	ПоставщикиИУслуги.Услуга КАК Услуга,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0) < 0
	|			ТОГДА -ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаКонечныйОстатокКт,
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0) >= 0
	|			ТОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаКонечныйОстатокДт,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета,
	|	бит_ЛицевыеСчета.Здание,
	|	бит_ЛицевыеСчета.Квартира,
	|	бит_СписокЗданий.Корпус
	|ИЗ
	|	ПоставщикиИУслуги КАК ПоставщикиИУслуги
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Остатки КАК Остатки
	|		ПО ПоставщикиИУслуги.ЛицевойСчет = Остатки.ЛицевойСчет
	|			И ПоставщикиИУслуги.Услуга = Остатки.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|			ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
	|		ПО ПоставщикиИУслуги.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
	|ГДЕ
	|	 ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0) <> 0
	|
	|УПОРЯДОЧИТЬ ПО
	|	ПоставщикиИУслуги.ЛицевойСчет,
	|	ПоставщикиИУслуги.Услуга.Приоритет";
	
	 Объект.СписокЛС.Очистить();
	 
	 Выборка = Запрос.Выполнить().Выбрать();
	 Пока Выборка.Следующий() Цикл
		 НоваяСтрока                 = Объект.СписокЛС.Добавить();
		 НоваяСтрока.ЛицевойСчет     = Выборка.ЛицевойСчет;
		 НоваяСтрока.Услуга			 = Выборка.Услуга;
		 НоваяСтрока.ШаблонИзвещений = ПолучитьШаблонИзвещений();
		 НоваяСтрока.Адрес           = Строка(Выборка.УлицаЛицевогоСчета)+", д. "+Строка(Выборка.Здание)+?(ПустаяСтрока(Выборка.Корпус),"",", кор. "+Выборка.Корпус)+", кв. "+Строка(Выборка.Квартира);
		 Если Выборка.СуммаКонечныйОстатокДт > 0 Тогда
			 НоваяСтрока.Сумма = Выборка.СуммаКонечныйОстатокДт;
		 ИначеЕсли Выборка.СуммаКонечныйОстатокКт > 0 Тогда
			 НоваяСтрока.Сумма = -Выборка.СуммаКонечныйОстатокКт;
		 Иначе
			Продолжить;	 
		 КонецЕсли;
	 КонецЦикла; 
	
КонецПроцедуры
