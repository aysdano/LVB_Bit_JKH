//HD+
// Возвращает строку прочерка для указанного ключа настроек.
//
Функция ПолучитьПрочеркПоКлючу(Знач НастройкиДлиныПрочерков, Знач КлючПараметра)
	
	ДлинаПрочерка = 6;
	
	Если НастройкиДлиныПрочерков <> Неопределено Тогда
		Если НастройкиДлиныПрочерков.Получить(КлючПараметра) <> Неопределено Тогда
			ДлинаПрочерка = НастройкиДлиныПрочерков.Получить(КлючПараметра);
		ИначеЕсли НастройкиДлиныПрочерков.Получить("Общий") <> Неопределено Тогда
			ДлинаПрочерка = НастройкиДлиныПрочерков.Получить("Общий");
		КонецЕсли;
	КонецЕсли;
	
	Если ТипЗнч(ДлинаПрочерка) <> Тип("Число") Или ДлинаПрочерка <= 0 Тогда
		ДлинаПрочерка = 6;
	КонецЕсли;
	
	Прочерк = "";
	Для Индекс = 1 По ДлинаПрочерка Цикл
		Прочерк = Прочерк + "_";
	КонецЦикла;
	
	Возврат Прочерк;
	
КонецФункции //HD-

//HD+
// Возвращает квартиру собственника в рамках выбранного МКД.
// Источник квартиры: реквизит Справочник.бит_ЛицевыеСчета.Квартира.
// Если связь не найдена, возвращает пустую ссылку СправочникСсылка.бит_Квартиры.
//
Функция ПолучитьКвартируСобственникаПоМКД(Знач МКД, Знач Собственник) Экспорт
	
	Если НЕ ЗначениеЗаполнено(МКД)
		ИЛИ НЕ ЗначениеЗаполнено(Собственник) Тогда
		Возврат Справочники.бит_Квартиры.ПустаяСсылка();
	КонецЕсли;
	
	Если ТипЗнч(Собственник) <> Тип("СправочникСсылка.бит_Проживающие") Тогда
		Возврат Справочники.бит_Квартиры.ПустаяСсылка();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ЛицевыеСчета.Квартира КАК Квартира
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК ПроживающиесяПоЛССрезПоследних
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ПО ПроживающиесяПоЛССрезПоследних.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
	|ГДЕ
	|	ПроживающиесяПоЛССрезПоследних.ФизЛицо = &Собственник
	|	И бит_ЛицевыеСчета.Здание = &МКД
	|	И НЕ бит_ЛицевыеСчета.Архивный
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления";
	
	Запрос.УстановитьПараметр("Момент", ТекущаяДатаСеанса());
	Запрос.УстановитьПараметр("Собственник", Собственник);
	Запрос.УстановитьПараметр("МКД", МКД);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() И ЗначениеЗаполнено(Выборка.Квартира) Тогда
		Возврат Выборка.Квартира;
	КонецЕсли;
	
	Возврат Справочники.бит_Квартиры.ПустаяСсылка();
	
КонецФункции //HD-

//HD+
// Возвращает номер квартиры для заполнения документа.
// Приоритет: ресурс РегистрСведений.бит_СведенияОКвартире.лб_ПредставлениеКвартиры (расширение Левобережье1).
// Если представление не заполнено — наименование справочника бит_Квартиры.
//
Функция ПолучитьНомерКвартирыПоПредставлению(Знач ПредставлениеКвартиры, Знач Квартира)
	
	Если ЗначениеЗаполнено(ПредставлениеКвартиры) Тогда
		Возврат СокрЛП(Строка(ПредставлениеКвартиры));
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Квартира) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Квартира) <> Тип("СправочникСсылка.бит_Квартиры") Тогда
		Возврат СокрЛП(Строка(Квартира));
	КонецЕсли;
	
	Возврат СокрЛП(Строка(Квартира.Наименование));
	
КонецФункции //HD-

//HD+
// Получает представление квартиры из регистра сведений бит_СведенияОКвартире.
// Параметры:
//  Квартира - СправочникСсылка.бит_Квартиры
//  Момент - Дата - дата среза сведений; если не указана, используется текущая дата
//
Функция ПолучитьПредставлениеКвартирыИзРегистра(Знач Квартира, Знач Момент = Неопределено)
	
	Если НЕ ЗначениеЗаполнено(Квартира) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(Квартира) <> Тип("СправочникСсылка.бит_Квартиры") Тогда
		Возврат ПолучитьНомерКвартирыПоПредставлению("", Квартира);
	КонецЕсли;
	
	Если Момент = Неопределено Тогда
		Момент = ТекущаяДатаСеанса();
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК лб_ПредставлениеКвартиры
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("Квартира", Квартира);
	
	Выборка = Запрос.Выполнить().Выбрать();
	ПредставлениеКвартиры = "";
	Если Выборка.Следующий() Тогда
		ПредставлениеКвартиры = Выборка.лб_ПредставлениеКвартиры;
	КонецЕсли;
	
	Возврат ПолучитьНомерКвартирыПоПредставлению(ПредставлениеКвартиры, Квартира);
	
КонецФункции //HD-

//HD+
// Рассчитывает площадь с учетом доли собственности
// Параметры:
//  ПлощадьКвартиры - общая площадь квартиры
//  ДоляСобственности - доля в формате "1/24" или "1/24А"
// Возвращает:
//  Площадь с учетом доли
//
Функция РассчитатьПлощадьСДолей(ПлощадьКвартиры, ДоляСобственности)
	
	Если НЕ ЗначениеЗаполнено(ПлощадьКвартиры) ИЛИ ПлощадьКвартиры <= 0 Тогда
		Возврат 0;
	КонецЕсли;
	
	ПлощадьСДолей = ПлощадьКвартиры;
	
	// Если есть доля, учитываем её
	Если ЗначениеЗаполнено(ДоляСобственности) 
		И НЕ ПустаяСтрока(ДоляСобственности) Тогда
		
		// Очищаем долю от буквенного сопровождения
		ДоляСобственностиОчищенная = ОчиститьДолюОтБукв(ДоляСобственности);
		
		Попытка
			
			// Валидация формата доли (должна содержать "/")
			ПозицияСлеша = СтрНайти(ДоляСобственностиОчищенная, "/");
			
			Если ПозицияСлеша > 0 Тогда
				
				Числитель = Число(Лев(ДоляСобственностиОчищенная, ПозицияСлеша - 1));
				Знаменатель = Число(Сред(ДоляСобственностиОчищенная, ПозицияСлеша + 1));
				
				// Проверка на положительные значения
				Если Числитель > 0 И Знаменатель > 0 Тогда
					
					ПлощадьСДолей = ПлощадьКвартиры * Числитель / Знаменатель;
					
				Иначе
					// Если числитель или знаменатель неположительные, используем полную площадь
					// Логирование ошибки можно добавить при необходимости
				КонецЕсли;
				
			КонецЕсли;
			
		Исключение
			// Если не удалось преобразовать долю в число, используем полную площадь
			// (например, если доля содержит недопустимые символы)
			// Логирование ошибки можно добавить при необходимости
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат ПлощадьСДолей;
	
КонецФункции //HD-

//HD+
// Формирует адрес проживания по данным лицевого счета (аналогично логике формы лицевого счета).
//
Функция ПолучитьАдресПроживанияПоЛицевомуСчету(Знач ЛицевойСчет)
	
	Если НЕ ЗначениеЗаполнено(ЛицевойСчет) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ЛицевойСчет) <> Тип("СправочникСсылка.бит_ЛицевыеСчета") Тогда
		Возврат "";
	КонецЕсли;
	
	Попытка
		ОбъектЛицевогоСчета = ЛицевойСчет.ПолучитьОбъект();
	Исключение
		Возврат "";
	КонецПопытки;
	
	Если ОбъектЛицевогоСчета = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Адрес = "ул. " + СокрЛП(Строка(ОбъектЛицевогоСчета.УлицаЛицевогоСчета))
		+ ", д. " + СокрЛП(Строка(ОбъектЛицевогоСчета.Здание))
		+ ?(ЗначениеЗаполнено(ОбъектЛицевогоСчета.Здание.Корпус), ", корп. " + СокрЛП(Строка(ОбъектЛицевогоСчета.Здание.Корпус)), "")
		+ ", " + СокрЛП(Строка(ОбъектЛицевогоСчета.Квартира));
	
	Если ОбъектЛицевогоСчета.Здание.КонтактнаяИнформация.Количество() > 0 Тогда
		Возврат ?(ЗначениеЗаполнено(ОбъектЛицевогоСчета.Здание.ПочтовыйАдрес),
			Строка(ОбъектЛицевогоСчета.Здание.ПочтовыйАдрес)
				+ ?(ЗначениеЗаполнено(ОбъектЛицевогоСчета.Квартира), ", кв." + Строка(ОбъектЛицевогоСчета.Квартира), ""),
			Адрес);
	КонецЕсли;
	
	Возврат Адрес;
	
КонецФункции //HD-

//HD+
// Заполняет данные инициатора из справочника бит_Проживающие
//
Процедура ЗаполнитьДанныеИнициатора() Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИнициаторФИО) Тогда
		// Очищаем поля, если инициатор не заполнен
		ИнициаторНомерКвартиры = "";
		ИнициаторДоляСобственности = "";
		ИнициаторПлощадьПомещения = 0;
		ПравоустанавливающийДокумент = "";
		Возврат;
	КонецЕсли;
	
	Момент = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_Проживающие.Ссылка КАК Ссылка,
	|	бит_Проживающие.Ссылка КАК ФизЛицо,
	|	ЕСТЬNULL(бит_Проживающие.СтраховойНомерПФР, ФизЛица.СтраховойНомерПФР) КАК СНИЛС,
	|	бит_Проживающие.ДатаРождения КАК ДатаРождения,
	|	бит_Проживающие.МестоРождения КАК МестоРождения,
	|	ЕСТЬNULL(ТелефонКИ.Представление, &ПустаяСтрока) КАК Телефон
	|ИЗ
	|	Справочник.бит_Проживающие КАК бит_Проживающие
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛица
	|		ПО бит_Проживающие.Ссылка = ФизЛица.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК ТелефонКИ
	|		ПО бит_Проживающие.Ссылка = ТелефонКИ.Ссылка
	|			И ТелефонКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|			И ТелефонКИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПроживающего)
	|ГДЕ
	|	бит_Проживающие.Ссылка = &ИнициаторФИО";
	
	Запрос.УстановитьПараметр("ИнициаторФИО", ИнициаторФИО);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			// Форматируем СНИЛС при заполнении реквизита
			Если ЗначениеЗаполнено(Выборка.СНИЛС) Тогда
				ИнициаторСНИЛС = ФорматироватьСНИЛС(Выборка.СНИЛС);
			Иначе
				ИнициаторСНИЛС = Выборка.СНИЛС;
			КонецЕсли;
			ИнициаторДатаРождения = Выборка.ДатаРождения;
			ИнициаторМестоРождения = Выборка.МестоРождения;
			ИнициаторТелефон = Выборка.Телефон;
			
			// Получаем адрес регистрации отдельным запросом
			ЗапросАдрес = Новый Запрос;
			ЗапросАдрес.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	ЕСТЬNULL(ФактАдрес.Представление, ЕСТЬNULL(ЮрАдрес.Представление, &ПустаяСтрока)) КАК АдресРегистрации
			|ИЗ
			|	Справочник.бит_Проживающие КАК бит_Проживающие
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК ФактАдрес
			|		ПО бит_Проживающие.Ссылка = ФактАдрес.Ссылка
			|			И ФактАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
			|			И ФактАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресПроживающего)
			|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК ЮрАдрес
			|		ПО бит_Проживающие.Ссылка = ЮрАдрес.Ссылка
			|			И ЮрАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
			|			И ЮрАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресПроживающего)
			|ГДЕ
			|	бит_Проживающие.Ссылка = &ИнициаторФИО";
			
			ЗапросАдрес.УстановитьПараметр("ИнициаторФИО", ИнициаторФИО);
			ЗапросАдрес.УстановитьПараметр("ПустаяСтрока", "");
			
			РезультатАдрес = ЗапросАдрес.Выполнить();
			
			Если НЕ РезультатАдрес.Пустой() Тогда
				
				ВыборкаАдрес = РезультатАдрес.Выбрать();
				
				Если ВыборкаАдрес.Следующий() Тогда
					
					ИнициаторАдресРегистрации = ВыборкаАдрес.АдресРегистрации;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Если адрес не найден с указанными видами, пытаемся получить любой адрес
			Если НЕ ЗначениеЗаполнено(ИнициаторАдресРегистрации) Тогда
				
				ЗапросАдресОбщий = Новый Запрос;
				ЗапросАдресОбщий.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	АдресКИ.Представление КАК АдресРегистрации
				|ИЗ
				|	Справочник.бит_Проживающие КАК бит_Проживающие
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК АдресКИ
				|		ПО бит_Проживающие.Ссылка = АдресКИ.Ссылка
				|			И АдресКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
				|ГДЕ
				|	бит_Проживающие.Ссылка = &ИнициаторФИО";
				
				ЗапросАдресОбщий.УстановитьПараметр("ИнициаторФИО", ИнициаторФИО);
				
				РезультатАдресОбщий = ЗапросАдресОбщий.Выполнить();
				
				Если НЕ РезультатАдресОбщий.Пустой() Тогда
					
					ВыборкаАдресОбщий = РезультатАдресОбщий.Выбрать();
					
					Если ВыборкаАдресОбщий.Следующий() Тогда
						
						ИнициаторАдресРегистрации = ВыборкаАдресОбщий.АдресРегистрации;
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Получаем данные из лицевых счетов — запрос аналогичен ЗаполнитьУчастниковСобранияИзМКД (участники собрания)
			ЗапросЛС = Новый Запрос;
			
			Если ЗначениеЗаполнено(МКД) Тогда
				// Если МКД заполнен — та же структура и условия, что в запросе участников, отбор по ФизЛицо инициатора
				ЗапросЛС.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
				|	бит_ЛицевыеСчета.Квартира КАК Квартира,
				|	ПроживающиесяПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
				|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь, 0) КАК ПлощадьКвартиры,
				|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры, """") КАК лб_ПредставлениеКвартиры,
				|	ПроживающиесяПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК ДоляСобственности
				|ИЗ
				|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК ПроживающиесяПоЛССрезПоследних
				|		ПО бит_ЛицевыеСчета.Ссылка = ПроживающиесяПоЛССрезПоследних.ЛицевойСчет
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
				|		ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
				|		ПО бит_Квартиры.Ссылка = бит_СведенияОКвартиреСрезПоследних.Квартира
				|ГДЕ
				|	бит_ЛицевыеСчета.Здание = &МКД
				|	И НЕ бит_ЛицевыеСчета.Архивный
				|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
				|	И НЕ ПроживающиесяПоЛССрезПоследних.ФизЛицо.ПометкаУдаления
	|	И ПроживающиесяПоЛССрезПоследних.ФизЛицо = &ФизЛицо
	|	И ПроживающиесяПоЛССрезПоследних.лб_ДоляПлощадиСтрокой <> &ПустаяСтрока";
				
				ЗапросЛС.УстановитьПараметр("МКД", МКД);
				ЗапросЛС.УстановитьПараметр("Момент", Момент);
				ЗапросЛС.УстановитьПараметр("ПустаяСтрока", "");
			Иначе
				// Если МКД не заполнен — та же структура, без отбора по зданию
				ЗапросЛС.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
				|	бит_ЛицевыеСчета.Квартира КАК Квартира,
				|	ПроживающиесяПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
				|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь, 0) КАК ПлощадьКвартиры,
				|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры, """") КАК лб_ПредставлениеКвартиры,
				|	ПроживающиесяПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК ДоляСобственности
				|ИЗ
				|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК ПроживающиесяПоЛССрезПоследних
				|		ПО бит_ЛицевыеСчета.Ссылка = ПроживающиесяПоЛССрезПоследних.ЛицевойСчет
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
				|		ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
				|		ПО бит_Квартиры.Ссылка = бит_СведенияОКвартиреСрезПоследних.Квартира
				|ГДЕ
				|	НЕ бит_ЛицевыеСчета.Архивный
				|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
				|	И НЕ ПроживающиесяПоЛССрезПоследних.ФизЛицо.ПометкаУдаления
	|	И ПроживающиесяПоЛССрезПоследних.ФизЛицо = &ФизЛицо
	|	И ПроживающиесяПоЛССрезПоследних.лб_ДоляПлощадиСтрокой <> &ПустаяСтрока";
				
				ЗапросЛС.УстановитьПараметр("Момент", Момент);
				ЗапросЛС.УстановитьПараметр("ПустаяСтрока", "");
			КонецЕсли;
			
			ЗапросЛС.УстановитьПараметр("ФизЛицо", Выборка.ФизЛицо);
			
			РезультатЛС = ЗапросЛС.Выполнить();
			
			// Очищаем поля перед заполнением
			ИнициаторНомерКвартиры = "";
			ИнициаторДоляСобственности = "";
			ИнициаторПлощадьПомещения = 0;
			ЛицевойСчетИнициатора = Справочники.бит_ЛицевыеСчета.ПустаяСсылка();
			
			Если НЕ РезультатЛС.Пустой() Тогда
				
				ВыборкаЛС = РезультатЛС.Выбрать();
				
				Если ВыборкаЛС.Следующий() Тогда
					
					ЛицевойСчетИнициатора = ВыборкаЛС.ЛицевойСчет;
					
					ИнициаторНомерКвартиры = ПолучитьНомерКвартирыПоПредставлению(ВыборкаЛС.лб_ПредставлениеКвартиры, ВыборкаЛС.Квартира);
					
				// Получаем долю собственности (очищаем от буквенного сопровождения)
				Если ЗначениеЗаполнено(ВыборкаЛС.ДоляСобственности) Тогда
					ИнициаторДоляСобственности = ОчиститьДолюОтБукв(ВыборкаЛС.ДоляСобственности);
				КонецЕсли;
					
					// Рассчитываем площадь с учетом доли
					Если ЗначениеЗаполнено(ВыборкаЛС.ПлощадьКвартиры) Тогда
						
						ИнициаторПлощадьПомещения = РассчитатьПлощадьСДолей(ВыборкаЛС.ПлощадьКвартиры, ВыборкаЛС.ДоляСобственности);
						
					КонецЕсли;
					
					Если НЕ ЗначениеЗаполнено(ИнициаторАдресРегистрации)
						И ВыборкаЛС.СтатусПроживания = Перечисления.бит_СтатусПроживания.Постоянно Тогда
						ИнициаторАдресРегистрации = ПолучитьАдресПроживанияПоЛицевомуСчету(ВыборкаЛС.ЛицевойСчет);
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Получаем паспортные данные из регистра сведений
			// Сначала пытаемся получить паспорт РФ
			ЗапросПаспорт = Новый Запрос;
			ЗапросПаспорт.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК ДокументСерия,
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК ДокументНомер
			|ИЗ
			|	РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ФизЛицо = &ФизЛицо) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
			|ГДЕ
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид ЕСТЬ НЕ NULL
			|	И бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид.Наименование = &ВидДокументаПаспорт
			|
			|УПОРЯДОЧИТЬ ПО
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.Период УБЫВ";
			
			ЗапросПаспорт.УстановитьПараметр("Момент", Момент);
			ЗапросПаспорт.УстановитьПараметр("ФизЛицо", Выборка.ФизЛицо);
			ЗапросПаспорт.УстановитьПараметр("ВидДокументаПаспорт", "Паспорт гражданина РФ");
			
			РезультатПаспорт = ЗапросПаспорт.Выполнить();
			
			// Если паспорт РФ не найден, пытаемся получить любой документ удостоверяющий личность
			Если РезультатПаспорт.Пустой() Тогда
				
				ЗапросПаспорт.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК ДокументСерия,
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК ДокументНомер
				|ИЗ
				|	РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ФизЛицо = &ФизЛицо) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
				|ГДЕ
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид ЕСТЬ НЕ NULL
				|
				|УПОРЯДОЧИТЬ ПО
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.Период УБЫВ";
				
				ЗапросПаспорт.УстановитьПараметр("Момент", Момент);
				ЗапросПаспорт.УстановитьПараметр("ФизЛицо", Выборка.ФизЛицо);
				
				РезультатПаспорт = ЗапросПаспорт.Выполнить();
				
			КонецЕсли;
			
			Если НЕ РезультатПаспорт.Пустой() Тогда
				
				ВыборкаПаспорт = РезультатПаспорт.Выбрать();
				
				Если ВыборкаПаспорт.Следующий() Тогда
					
					ИнициаторПаспортСерия = НормализоватьСериюНомерПаспорта(ВыборкаПаспорт.ДокументСерия);
					ИнициаторПаспортНомер = НормализоватьСериюНомерПаспорта(ВыборкаПаспорт.ДокументНомер);
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Получаем правоустанавливающий документ из справочника бит_ПравоустанавливающиеДокументы
			ПравоустанавливающийДокумент = "";
			Если ТипЗнч(Выборка.Ссылка) = Тип("СправочникСсылка.бит_Проживающие") Тогда
				
				ПравоустанавливающийДокумент = ПолучитьПравоустанавливающиеДокументыСтрокой(Выборка.Ссылка, ЛицевойСчетИнициатора);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Заполняет общую площадь МКД из справочника бит_СписокЗданий
//
Процедура ЗаполнитьОбщуюПлощадьМКД()
	
	Если НЕ ЗначениеЗаполнено(МКД) Тогда
		ОбщаяПлощадьМКД = 0;
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_Квартиры.Ссылка КАК КвартираСсылка
	|ПОМЕСТИТЬ ВТ_КвартирыМКД
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	|		ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
	|ГДЕ
	|	бит_ЛицевыеСчета.Здание = &МКД
	|	И НЕ бит_ЛицевыеСчета.Архивный
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И НЕ бит_Квартиры.ПометкаУдаления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	КвартираСсылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_КвартирыМКД.КвартираСсылка КАК Квартира,
	|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь, 0) КАК ОбщаяПлощадь,
	|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.МОП, 0) КАК МОП
	|ПОМЕСТИТЬ ВТ_КвартирыСПлощадью
	|ИЗ
	|	ВТ_КвартирыМКД КАК ВТ_КвартирыМКД
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО ВТ_КвартирыМКД.КвартираСсылка = бит_СведенияОКвартиреСрезПоследних.Квартира
	|ГДЕ
	|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.МОП, 0) = 0
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Квартира
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(ВТ_КвартирыСПлощадью.ОбщаяПлощадь) КАК ОбщаяПлощадь
	|ИЗ
	|	ВТ_КвартирыСПлощадью КАК ВТ_КвартирыСПлощадью";
	
	Момент = ТекущаяДата();
	
	Запрос.УстановитьПараметр("МКД", МКД);
	Запрос.УстановитьПараметр("Момент", Момент);
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			ОбщаяПлощадьМКД = Выборка.ОбщаяПлощадь;
			
		Иначе
			
			ОбщаяПлощадьМКД = 0;
			
		КонецЕсли;
		
	Иначе
		
		ОбщаяПлощадьМКД = 0;
		
	КонецЕсли;
	
	ПересчитатьПлощадьИПроцентУчастников();
	
КонецПроцедуры //HD-

//HD+
// Пересчитывает площадь участников и процент участников
//
Процедура ПересчитатьПлощадьИПроцентУчастников()
	
	ПлощадьУчастников = 0;
	УчастниковСобрания = 0;
	Момент = ТекущаяДата();
	
	// Собираем список квартир, для которых нужно получить площадь
	МассивКвартир = Новый Массив;
	СтруктураКвартир = Новый Соответствие;
	
	Для Каждого СтрокаУчастника Из УчастникиСобрания Цикл
		
		Если ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
			
			УчастниковСобрания = УчастниковСобрания + 1;
			
			// Если площадь не заполнена, добавляем квартиру в список для запроса
			Если (НЕ ЗначениеЗаполнено(СтрокаУчастника.Площадь) 
				ИЛИ СтрокаУчастника.Площадь = 0) 
				И ЗначениеЗаполнено(СтрокаУчастника.Квартира) Тогда
				
				Если СтруктураКвартир.Получить(СтрокаУчастника.Квартира) = Неопределено Тогда
					МассивКвартир.Добавить(СтрокаУчастника.Квартира);
					СтруктураКвартир.Вставить(СтрокаУчастника.Квартира, Новый Массив);
				КонецЕсли;
				
				МассивСтрок = СтруктураКвартир.Получить(СтрокаУчастника.Квартира);
				МассивСтрок.Добавить(СтрокаУчастника);
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Получаем площади для всех квартир одним запросом
	Если МассивКвартир.Количество() > 0 Тогда
		
		ЗапросПлощадь = Новый Запрос;
		ЗапросПлощадь.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияОКвартиреСрезПоследних.Квартира КАК Квартира,
		|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь, 0) КАК ОбщаяПлощадь
		|ИЗ
		|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент) КАК бит_СведенияОКвартиреСрезПоследних
		|ГДЕ
		|	бит_СведенияОКвартиреСрезПоследних.Квартира В (&МассивКвартир)
		|	И ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.МОП, 0) = 0
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_СведенияОКвартиреСрезПоследних.Период УБЫВ";
		
		ЗапросПлощадь.УстановитьПараметр("Момент", Момент);
		ЗапросПлощадь.УстановитьПараметр("МассивКвартир", МассивКвартир);
		
		РезультатПлощадь = ЗапросПлощадь.Выполнить();
		
		Если НЕ РезультатПлощадь.Пустой() Тогда
			
			ВыборкаПлощадь = РезультатПлощадь.Выбрать();
			СтруктураПлощадей = Новый Соответствие;
			
			Пока ВыборкаПлощадь.Следующий() Цикл
				
				Если СтруктураПлощадей.Получить(ВыборкаПлощадь.Квартира) = Неопределено Тогда
					СтруктураПлощадей.Вставить(ВыборкаПлощадь.Квартира, ВыборкаПлощадь.ОбщаяПлощадь);
				КонецЕсли;
				
			КонецЦикла;
			
			// Обновляем площади в табличной части
			Для Каждого Квартира Из СтруктураКвартир.Ключи Цикл
				
				ПлощадьКвартиры = СтруктураПлощадей.Получить(Квартира);
				
				Если ПлощадьКвартиры <> Неопределено Тогда
					
					МассивСтрок = СтруктураКвартир.Получить(Квартира);
					
					Для Каждого СтрокаУчастника Из МассивСтрок Цикл
						СтрокаУчастника.Площадь = ПлощадьКвартиры;
					КонецЦикла;
					
				КонецЕсли;
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Подсчитываем общую площадь участников
	Для Каждого СтрокаУчастника Из УчастникиСобрания Цикл
		
		Если ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
			
			ПлощадьУчастника = ?(ЗначениеЗаполнено(СтрокаУчастника.Площадь), СтрокаУчастника.Площадь, 0);
			ПлощадьУчастников = ПлощадьУчастников + ПлощадьУчастника;
			
		КонецЕсли;
		
	КонецЦикла;
	
	//HD+ Процент участников временно не вычисляется
	// Рассчитываем процент участников
	//Если ЗначениеЗаполнено(ОбщаяПлощадьМКД) И ОбщаяПлощадьМКД > 0 Тогда
	//	
	//	ПроцентУчастников = Окр(ПлощадьУчастников / ОбщаяПлощадьМКД * 100, 2);
	//	
	//Иначе
	//	
	//	ПроцентУчастников = 0;
	//	
	//КонецЕсли;
	
	//HD+ ВсегоСобственников заполняется количеством участников собрания
	ВсегоСобственников = УчастниковСобрания;
	
КонецПроцедуры //HD-

//HD+
// Заполняет данные участника собрания из справочника бит_Проживающие и лицевых счетов
//
Процедура ЗаполнитьДанныеУчастника(СтрокаУчастника)
	
	Если НЕ ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
		Возврат;
	КонецЕсли;
	
	Момент = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_Проживающие.Ссылка КАК Ссылка,
	|	бит_Проживающие.Ссылка КАК ФизЛицо,
	|	ЕСТЬNULL(бит_Проживающие.СтраховойНомерПФР, ФизЛица.СтраховойНомерПФР) КАК СНИЛС,
	|	ЕСТЬNULL(ТелефонКИ.Представление, &ПустаяСтрока) КАК Телефон
	|ИЗ
	|	Справочник.бит_Проживающие КАК бит_Проживающие
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛица
	|		ПО бит_Проживающие.Ссылка = ФизЛица.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК ТелефонКИ
	|		ПО бит_Проживающие.Ссылка = ТелефонКИ.Ссылка
	|			И ТелефонКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|			И ТелефонКИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПроживающего)
	|ГДЕ
	|	бит_Проживающие.Ссылка = &Собственник";
	
	Запрос.УстановитьПараметр("Собственник", СтрокаУчастника.Собственник);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	
	Результат = Запрос.Выполнить();
	
	Если НЕ Результат.Пустой() Тогда
		
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			
			// Форматируем СНИЛС при заполнении реквизита
			Если ЗначениеЗаполнено(Выборка.СНИЛС) Тогда
				СтрокаУчастника.СНИЛС = ФорматироватьСНИЛС(Выборка.СНИЛС);
			Иначе
				СтрокаУчастника.СНИЛС = Выборка.СНИЛС;
			КонецЕсли;
			
			// Устанавливаем телефон из первого запроса, если он еще не заполнен
			Если ЗначениеЗаполнено(Выборка.Телефон) И НЕ ЗначениеЗаполнено(СтрокаУчастника.Телефон) Тогда
				СтрокаУчастника.Телефон = Выборка.Телефон;
			КонецЕсли;
			
			// Получаем данные из лицевых счетов для выбранного МКД
			Если ЗначениеЗаполнено(МКД) И ЗначениеЗаполнено(СтрокаУчастника.Квартира) Тогда
				
				ЗапросЛС = Новый Запрос;
				ЗапросЛС.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	бит_ЛицевыеСчета.Квартира КАК Квартира,
				|	ПроживающиесяПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК ДоляСобственности,
				|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь, 0) КАК ПлощадьКвартиры,
				|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры, """") КАК лб_ПредставлениеКвартиры,
				|	ЕСТЬNULL(ТелефонКИ.Представление, &ПустаяСтрока) КАК Телефон,
				|	ЕСТЬNULL(ФактАдрес.Представление, ЕСТЬNULL(ЮрАдрес.Представление, &ПустаяСтрока)) КАК АдресРегистрации
				|ИЗ
				|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент) КАК ПроживающиесяПоЛССрезПоследних
				|		ПО бит_ЛицевыеСчета.Ссылка = ПроживающиесяПоЛССрезПоследних.ЛицевойСчет
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
				|		ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент) КАК бит_СведенияОКвартиреСрезПоследних
				|		ПО бит_Квартиры.Ссылка = бит_СведенияОКвартиреСрезПоследних.Квартира
				|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие КАК бит_Проживающие
				|		ПО ПроживающиесяПоЛССрезПоследних.ФизЛицо = бит_Проживающие.Ссылка
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК ФактАдрес
				|		ПО бит_Проживающие.Ссылка = ФактАдрес.Ссылка
				|			И ФактАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
				|			И ФактАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ФактАдресПроживающего)
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК ЮрАдрес
				|		ПО бит_Проживающие.Ссылка = ЮрАдрес.Ссылка
				|			И ЮрАдрес.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Адрес)
				|			И ЮрАдрес.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ЮрАдресПроживающего)
				|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК ТелефонКИ
				|		ПО бит_Проживающие.Ссылка = ТелефонКИ.Ссылка
				|			И ТелефонКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
				|			И ТелефонКИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПроживающего)
				|ГДЕ
				|	бит_ЛицевыеСчета.Здание = &МКД
				|	И бит_ЛицевыеСчета.Квартира = &Квартира
				|	И ПроживающиесяПоЛССрезПоследних.ФизЛицо = &ФизЛицо
				|	И ПроживающиесяПоЛССрезПоследних.ВладелецКвартиры = ИСТИНА
				|
				|УПОРЯДОЧИТЬ ПО
				|	ПроживающиесяПоЛССрезПоследних.Период УБЫВ";
				
				ЗапросЛС.УстановитьПараметр("МКД", МКД);
				ЗапросЛС.УстановитьПараметр("Квартира", СтрокаУчастника.Квартира);
				ЗапросЛС.УстановитьПараметр("ФизЛицо", Выборка.ФизЛицо);
				ЗапросЛС.УстановитьПараметр("Момент", Момент);
				ЗапросЛС.УстановитьПараметр("ПустаяСтрока", "");
				
				РезультатЛС = ЗапросЛС.Выполнить();
				
				Если НЕ РезультатЛС.Пустой() Тогда
					
					ВыборкаЛС = РезультатЛС.Выбрать();
					
					Если ВыборкаЛС.Следующий() Тогда
						
					// Обновляем данные из лицевых счетов (очищаем долю от буквенного сопровождения)
					Если ЗначениеЗаполнено(ВыборкаЛС.ДоляСобственности) Тогда
						СтрокаУчастника.ДоляСобственности = ОчиститьДолюОтБукв(ВыборкаЛС.ДоляСобственности);
					КонецЕсли;
						
						Если ЗначениеЗаполнено(ВыборкаЛС.ПлощадьКвартиры) Тогда
							
							СтрокаУчастника.Площадь = РассчитатьПлощадьСДолей(ВыборкаЛС.ПлощадьКвартиры, ВыборкаЛС.ДоляСобственности);
							
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ВыборкаЛС.Телефон) Тогда
							СтрокаУчастника.Телефон = ВыборкаЛС.Телефон;
						КонецЕсли;
						
						Если ЗначениеЗаполнено(ВыборкаЛС.АдресРегистрации) Тогда
							СтрокаУчастника.Адрес = ВыборкаЛС.АдресРегистрации;
						КонецЕсли;
						
						СтрокаУчастника.НомерКвартиры = ПолучитьНомерКвартирыПоПредставлению(ВыборкаЛС.лб_ПредставлениеКвартиры, ВыборкаЛС.Квартира);
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Получаем паспортные данные
			// Сначала пытаемся получить паспорт РФ
			ЗапросПаспорт = Новый Запрос;
			ЗапросПаспорт.Текст = 
			"ВЫБРАТЬ ПЕРВЫЕ 1
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК ДокументСерия,
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК ДокументНомер,
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
			|	ВЫРАЗИТЬ(бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК СТРОКА(500)) КАК ДокументКемВыдан
			|ИЗ
			|	РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ФизЛицо = &ФизЛицо) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
			|ГДЕ
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид ЕСТЬ НЕ NULL
			|	И бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид.Наименование = &ВидДокументаПаспорт
			|
			|УПОРЯДОЧИТЬ ПО
			|	бит_ПаспортныеДанныеПроживающихСрезПоследних.Период УБЫВ";
			
			ЗапросПаспорт.УстановитьПараметр("Момент", Момент);
			ЗапросПаспорт.УстановитьПараметр("ФизЛицо", Выборка.ФизЛицо);
			ЗапросПаспорт.УстановитьПараметр("ВидДокументаПаспорт", "Паспорт гражданина РФ");
			
			РезультатПаспорт = ЗапросПаспорт.Выполнить();
			
			// Если паспорт РФ не найден, пытаемся получить любой документ удостоверяющий личность
			Если РезультатПаспорт.Пустой() Тогда
				
				ЗапросПаспорт.Текст = 
				"ВЫБРАТЬ ПЕРВЫЕ 1
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК ДокументСерия,
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК ДокументНомер,
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
				|	ВЫРАЗИТЬ(бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК СТРОКА(500)) КАК ДокументКемВыдан
				|ИЗ
				|	РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ФизЛицо = &ФизЛицо) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
				|ГДЕ
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид ЕСТЬ НЕ NULL
				|
				|УПОРЯДОЧИТЬ ПО
				|	бит_ПаспортныеДанныеПроживающихСрезПоследних.Период УБЫВ";
				
				ЗапросПаспорт.УстановитьПараметр("Момент", Момент);
				ЗапросПаспорт.УстановитьПараметр("ФизЛицо", Выборка.ФизЛицо);
				
				РезультатПаспорт = ЗапросПаспорт.Выполнить();
				
			КонецЕсли;
			
			Если НЕ РезультатПаспорт.Пустой() Тогда
				
				ВыборкаПаспорт = РезультатПаспорт.Выбрать();
				
				Если ВыборкаПаспорт.Следующий() Тогда
					
					СтрокаУчастника.ПаспортСерия = НормализоватьСериюНомерПаспорта(ВыборкаПаспорт.ДокументСерия);
					СтрокаУчастника.ПаспортНомер = НормализоватьСериюНомерПаспорта(ВыборкаПаспорт.ДокументНомер);
					СтрокаУчастника.ПаспортДатаВыдачи = ВыборкаПаспорт.ДокументДатаВыдачи;
					СтрокаУчастника.ПаспортВыдан = ВыборкаПаспорт.ДокументКемВыдан;
					
				КонецЕсли;
				
			КонецЕсли;
			
			// Получаем правоустанавливающий документ из справочника бит_ПравоустанавливающиеДокументы
			// Аналогично заполнению реквизита ПравоустанавливающийДокумент для инициатора
			Если ТипЗнч(СтрокаУчастника.Собственник) = Тип("СправочникСсылка.бит_Проживающие") Тогда
				
				СтрокаУчастника.ДокументПрава = ПолучитьПравоустанавливающиеДокументыСтрокой(СтрокаУчастника.Собственник, СтрокаУчастника.ЛицевойСчет);
				
			Иначе
				
				// Очищаем поле, если тип не соответствует
				СтрокаУчастника.ДокументПрава = "";
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПересчитатьПлощадьИПроцентУчастников();
	
КонецПроцедуры //HD-

//HD+
// Заполняет табличную часть "УчастникиСобрания" из лицевых счетов МКД.
// Одна строка — собственник по конкретной квартире (по доле, без отбора по выписке).
//
Процедура ЗаполнитьУчастниковСобранияИзМКД()
	
	Если НЕ ЗначениеЗаполнено(МКД) Тогда
		УчастникиСобрания.Очистить();
		Возврат;
	КонецЕсли;
	
	Момент = ТекущаяДата();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ПроживающиесяПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Квартира КАК Квартира,
	|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь, 0) КАК ПлощадьКвартиры,
	|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры, """") КАК лб_ПредставлениеКвартиры,
	|	ПроживающиесяПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК ДоляСобственности,
	|	ЕСТЬNULL(бит_СведенияОКвартиреСрезПоследних.МОП, 0) КАК МОП,
	|	ЕСТЬNULL(бит_Проживающие.СтраховойНомерПФР, ФизЛица.СтраховойНомерПФР) КАК СНИЛС,
	|	ЕСТЬNULL(ТелефонКИ.Представление, &ПустаяСтрока) КАК Телефон
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК ПроживающиесяПоЛССрезПоследних
	|		ПО бит_ЛицевыеСчета.Ссылка = ПроживающиесяПоЛССрезПоследних.ЛицевойСчет
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	|		ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО (бит_Квартиры.Ссылка = бит_СведенияОКвартиреСрезПоследних.Квартира)
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие КАК бит_Проживающие
	|		ПО ПроживающиесяПоЛССрезПоследних.ФизЛицо = бит_Проживающие.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.ФизическиеЛица КАК ФизЛица
	|		ПО бит_Проживающие.Ссылка = ФизЛица.Ссылка
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Проживающие.КонтактнаяИнформация КАК ТелефонКИ
	|		ПО бит_Проживающие.Ссылка = ТелефонКИ.Ссылка
	|			И ТелефонКИ.Тип = ЗНАЧЕНИЕ(Перечисление.ТипыКонтактнойИнформации.Телефон)
	|			И ТелефонКИ.Вид = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ТелефонПроживающего)
	|ГДЕ
	|	бит_ЛицевыеСчета.Здание = &МКД
	|	И НЕ бит_ЛицевыеСчета.Архивный
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И НЕ ПроживающиесяПоЛССрезПоследних.ФизЛицо.ПометкаУдаления
	|	И ПроживающиесяПоЛССрезПоследних.лб_ДоляПлощадиСтрокой <> &ПустаяСтрока";
	
	Запрос.УстановитьПараметр("МКД", МКД);
	Запрос.УстановитьПараметр("Момент", Момент);
	Запрос.УстановитьПараметр("ПустаяСтрока", "");
	
	Результат = Запрос.Выполнить();
	
	Если Результат.Пустой() Тогда
		Возврат;
	КонецЕсли;
	
	// Собираем список ФизЛиц для проверки умерших
	МассивФизЛиц = Новый Массив;
	ВыборкаВременная = Результат.Выбрать();
	
	Пока ВыборкаВременная.Следующий() Цикл
		
		Если ЗначениеЗаполнено(ВыборкаВременная.ФизЛицо) Тогда
			МассивФизЛиц.Добавить(ВыборкаВременная.ФизЛицо);
		КонецЕсли;
		
	КонецЦикла;
	
	// Проверяем умерших собственников (только для ФизЛиц из текущего МКД)
	МножествоУмерших = Новый Соответствие;
	
	Если МассивФизЛиц.Количество() > 0 Тогда
		
		ЗапросУмерших = Новый Запрос;
		ЗапросУмерших.Текст = 
		"ВЫБРАТЬ
		|	бит_СвидетельстваОСмерти.ФизЛицо КАК ФизЛицо
		|ИЗ
		|	РегистрСведений.бит_СвидетельстваОСмерти КАК бит_СвидетельстваОСмерти
		|ГДЕ
		|	бит_СвидетельстваОСмерти.ФизЛицо В (&МассивФизЛиц)";
		
		ЗапросУмерших.УстановитьПараметр("МассивФизЛиц", МассивФизЛиц);
		
		РезультатУмерших = ЗапросУмерших.Выполнить();
		
		Если НЕ РезультатУмерших.Пустой() Тогда
			
			ВыборкаУмерших = РезультатУмерших.Выбрать();
			
			Пока ВыборкаУмерших.Следующий() Цикл
				
				МножествоУмерших.Вставить(ВыборкаУмерших.ФизЛицо, Истина);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Собираем уникальные ФизЛица для получения ссылок на бит_Проживающие
	МассивФизЛицДляЗапроса = Новый Массив;
	СтруктураФизЛиц = Новый Соответствие;
	
	ВыборкаВременная2 = Результат.Выбрать();
	
	Пока ВыборкаВременная2.Следующий() Цикл
		
		// Пропускаем умерших
		Если МножествоУмерших.Получить(ВыборкаВременная2.ФизЛицо) = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		// Пропускаем квартиры с МОП > 0
		Если ВыборкаВременная2.МОП > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		Если ЗначениеЗаполнено(ВыборкаВременная2.ФизЛицо) 
			И СтруктураФизЛиц.Получить(ВыборкаВременная2.ФизЛицо) = Неопределено Тогда
			
			МассивФизЛицДляЗапроса.Добавить(ВыборкаВременная2.ФизЛицо);
			СтруктураФизЛиц.Вставить(ВыборкаВременная2.ФизЛицо, Справочники.бит_Проживающие.ПустаяСсылка());
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Получаем ссылки на бит_Проживающие одним запросом
	Если МассивФизЛицДляЗапроса.Количество() > 0 Тогда
		
		ЗапросСобственник = Новый Запрос;
		ЗапросСобственник.Текст = 
		"ВЫБРАТЬ
		|	бит_Проживающие.Ссылка КАК Собственник,
		|	бит_Проживающие.Ссылка КАК ФизЛицо
		|ИЗ
		|	Справочник.бит_Проживающие КАК бит_Проживающие
		|ГДЕ
		|	бит_Проживающие.Ссылка В (&МассивФизЛиц)";
		
		ЗапросСобственник.УстановитьПараметр("МассивФизЛиц", МассивФизЛицДляЗапроса);
		
		РезультатСобственник = ЗапросСобственник.Выполнить();
		
		Если НЕ РезультатСобственник.Пустой() Тогда
			
			ВыборкаСобственник = РезультатСобственник.Выбрать();
			
			Пока ВыборкаСобственник.Следующий() Цикл
				
				СтруктураФизЛиц.Вставить(ВыборкаСобственник.ФизЛицо, ВыборкаСобственник.Собственник);
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	// Очищаем табличную часть перед заполнением
	УчастникиСобрания.Очистить();
	
	// Используем структуру для быстрой проверки дубликатов
	СтруктураСобственников = Новый Соответствие;
	
	Выборка = Результат.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// Пропускаем умерших
		Если МножествоУмерших.Получить(Выборка.ФизЛицо) = Истина Тогда
			Продолжить;
		КонецЕсли;
		
		// Пропускаем квартиры с МОП > 0
		Если Выборка.МОП > 0 Тогда
			Продолжить;
		КонецЕсли;
		
		// Получаем ссылку на бит_Проживающие по ФизЛицо
		Собственник = СтруктураФизЛиц.Получить(Выборка.ФизЛицо);
		
		Если НЕ ЗначениеЗаполнено(Собственник) Тогда
			Собственник = Справочники.бит_Проживающие.ПустаяСсылка();
		КонецЕсли;
		
		// Один собственник может владеть несколькими квартирами — дубль только по связке человек+квартира
		КлючУчастника = Строка(Собственник) + Символы.ПС + Строка(Выборка.Квартира);
		
		Если СтруктураСобственников.Получить(КлючУчастника) = Неопределено Тогда
			
			СтруктураСобственников.Вставить(КлючУчастника, Истина);
			
			НоваяСтрока = УчастникиСобрания.Добавить();
			НоваяСтрока.Собственник = Собственник;
			НоваяСтрока.Квартира = Выборка.Квартира;
			
			// Устанавливаем лицевой счет
			Если ЗначениеЗаполнено(Выборка.ЛицевойСчет) Тогда
				НоваяСтрока.ЛицевойСчет = Выборка.ЛицевойСчет;
			КонецЕсли;
			
			НоваяСтрока.НомерКвартиры = ПолучитьНомерКвартирыПоПредставлению(Выборка.лб_ПредставлениеКвартиры, Выборка.Квартира);
			
			// Рассчитываем площадь с учетом доли
			Если ЗначениеЗаполнено(Выборка.ПлощадьКвартиры) Тогда
				
				НоваяСтрока.Площадь = РассчитатьПлощадьСДолей(Выборка.ПлощадьКвартиры, Выборка.ДоляСобственности);
				
			КонецЕсли;
			
			// Устанавливаем долю собственности (очищаем от буквенного сопровождения)
			Если ЗначениеЗаполнено(Выборка.ДоляСобственности) Тогда
				НоваяСтрока.ДоляСобственности = ОчиститьДолюОтБукв(Выборка.ДоляСобственности);
			КонецЕсли;
			
			// Устанавливаем СНИЛС из выборки (форматируем при заполнении)
			Если ЗначениеЗаполнено(Выборка.СНИЛС) Тогда
				НоваяСтрока.СНИЛС = ФорматироватьСНИЛС(Выборка.СНИЛС);
			КонецЕсли;
			
			// Устанавливаем телефон из выборки
			Если ЗначениеЗаполнено(Выборка.Телефон) Тогда
				НоваяСтрока.Телефон = Выборка.Телефон;
			КонецЕсли;
			
			// Заполняем остальные данные участника
			ЗаполнитьДанныеУчастника(НоваяСтрока);
			
		КонецЕсли;
		
	КонецЦикла;
	
	// Сортируем табличную часть по номеру квартиры по возрастанию (числовая сортировка)
	// ВАЖНО: сортировка выполняется ПОСЛЕ того, как все данные заполнены (включая вызов ЗаполнитьДанныеУчастника)
	СортироватьУчастниковСобранияПоНомеруКвартиры();
	
	ПересчитатьПлощадьИПроцентУчастников();
	
КонецПроцедуры //HD-

//HD+
// Сортирует табличную часть УчастникиСобрания по номеру квартиры (числовая сортировка)
//
Процедура СортироватьУчастниковСобранияПоНомеруКвартиры()
	
	Если УчастникиСобрания.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	// Создаем временную таблицу значений для сортировки
	ТаблицаДляСортировки = Новый ТаблицаЗначений;
	ТаблицаДляСортировки.Колонки.Добавить("НомерКвартирыЧисло", Новый ОписаниеТипов("Число"));
	ТаблицаДляСортировки.Колонки.Добавить("Индекс", Новый ОписаниеТипов("Число"));
	
	// Создаем массив для хранения данных строк табличной части
	МассивДанныхСтрок = Новый Массив;
	
	// Заполняем временную таблицу с преобразованием номера квартиры в число
	// Одновременно сохраняем данные всех строк в массив структур
	ИндексСтроки = 0;
	Для Каждого СтрокаУчастника Из УчастникиСобрания Цикл
		
		// Сохраняем данные строки в структуру (копируем все поля вручную для надежности)
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Собственник", СтрокаУчастника.Собственник);
		СтруктураДанных.Вставить("Квартира", СтрокаУчастника.Квартира);
		СтруктураДанных.Вставить("НомерКвартиры", СтрокаУчастника.НомерКвартиры);
		СтруктураДанных.Вставить("ДоляСобственности", СтрокаУчастника.ДоляСобственности);
		СтруктураДанных.Вставить("Площадь", СтрокаУчастника.Площадь);
		СтруктураДанных.Вставить("СНИЛС", СтрокаУчастника.СНИЛС);
		СтруктураДанных.Вставить("Телефон", СтрокаУчастника.Телефон);
		СтруктураДанных.Вставить("ПаспортСерия", СтрокаУчастника.ПаспортСерия);
		СтруктураДанных.Вставить("ПаспортНомер", СтрокаУчастника.ПаспортНомер);
		СтруктураДанных.Вставить("ПаспортДатаВыдачи", СтрокаУчастника.ПаспортДатаВыдачи);
		СтруктураДанных.Вставить("ПаспортВыдан", СтрокаУчастника.ПаспортВыдан);
		СтруктураДанных.Вставить("ДокументПрава", СтрокаУчастника.ДокументПрава);
		СтруктураДанных.Вставить("Роль", СтрокаУчастника.Роль);
		СтруктураДанных.Вставить("ЛицевойСчет", СтрокаУчастника.ЛицевойСчет);
		МассивДанныхСтрок.Добавить(СтруктураДанных);
		
		// Добавляем строку в таблицу для сортировки
		НоваяСтрока = ТаблицаДляСортировки.Добавить();
		НоваяСтрока.Индекс = ИндексСтроки;
		ИндексСтроки = ИндексСтроки + 1;
		
		// Преобразуем номер квартиры в число для правильной сортировки
		НомерКвартирыЧисло = 0;
		Если ЗначениеЗаполнено(СтрокаУчастника.НомерКвартиры) Тогда
			
			Попытка
				// Извлекаем число из строки (убираем все нецифровые символы)
				НомерКвартирыСтрока = СтрЗаменить(СтрокаУчастника.НомерКвартиры, " ", "");
				НомерКвартирыСтрока = СтрЗаменить(НомерКвартирыСтрока, Символы.ПС, "");
				НомерКвартирыСтрока = СтрЗаменить(НомерКвартирыСтрока, Символы.ВК, "");
				
				// Извлекаем первое число из строки
				Для Индекс = 1 По СтрДлина(НомерКвартирыСтрока) Цикл
					
					Символ = Сред(НомерКвартирыСтрока, Индекс, 1);
					Если СтрНайти("0123456789", Символ) > 0 Тогда
						
						// Нашли начало числа, извлекаем его
						ЧислоСтрока = "";
						Для Индекс2 = Индекс По СтрДлина(НомерКвартирыСтрока) Цикл
							
							Символ2 = Сред(НомерКвартирыСтрока, Индекс2, 1);
							Если СтрНайти("0123456789", Символ2) > 0 Тогда
								ЧислоСтрока = ЧислоСтрока + Символ2;
							Иначе
								Прервать;
							КонецЕсли;
							
						КонецЦикла;
						
						Если НЕ ПустаяСтрока(ЧислоСтрока) Тогда
							НомерКвартирыЧисло = Число(ЧислоСтрока);
						КонецЕсли;
						
						Прервать;
						
					КонецЕсли;
					
				КонецЦикла;
				
			Исключение
				НомерКвартирыЧисло = 0;
			КонецПопытки;
			
		КонецЕсли;
		
		НоваяСтрока.НомерКвартирыЧисло = НомерКвартирыЧисло;
		
	КонецЦикла;
	
	// Сортируем по числовому значению номера квартиры
	ТаблицаДляСортировки.Сортировать("НомерКвартирыЧисло");
	
	// Очищаем табличную часть и перезагружаем отсортированные данные
	УчастникиСобрания.Очистить();
	
	Для Каждого СтрокаСортировки Из ТаблицаДляСортировки Цикл
		
		НоваяСтрокаУчастника = УчастникиСобрания.Добавить();
		
		// Копируем данные из структуры в строку табличной части
		СтруктураДанных = МассивДанныхСтрок[СтрокаСортировки.Индекс];
		
		// Копируем все поля из структуры в строку табличной части
		// Используем прямое присваивание, так как мы сами вставляли эти свойства в структуру
		НоваяСтрокаУчастника.Собственник = СтруктураДанных.Собственник;
		НоваяСтрокаУчастника.Квартира = СтруктураДанных.Квартира;
		НоваяСтрокаУчастника.НомерКвартиры = СтруктураДанных.НомерКвартиры;
		НоваяСтрокаУчастника.ДоляСобственности = СтруктураДанных.ДоляСобственности;
		НоваяСтрокаУчастника.Площадь = СтруктураДанных.Площадь;
		НоваяСтрокаУчастника.СНИЛС = СтруктураДанных.СНИЛС;
		НоваяСтрокаУчастника.Телефон = СтруктураДанных.Телефон;
		НоваяСтрокаУчастника.ПаспортСерия = СтруктураДанных.ПаспортСерия;
		НоваяСтрокаУчастника.ПаспортНомер = СтруктураДанных.ПаспортНомер;
		НоваяСтрокаУчастника.ПаспортДатаВыдачи = СтруктураДанных.ПаспортДатаВыдачи;
		НоваяСтрокаУчастника.ПаспортВыдан = СтруктураДанных.ПаспортВыдан;
		НоваяСтрокаУчастника.ДокументПрава = СтруктураДанных.ДокументПрава;
		НоваяСтрокаУчастника.Роль = СтруктураДанных.Роль;
		НоваяСтрокаУчастника.ЛицевойСчет = СтруктураДанных.ЛицевойСчет;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Формирует печатную форму по имени шаблона
// Параметры:
//  ИмяШаблона - имя шаблона печатной формы
//  АдресШаблоновОбластей - Строка - адрес шаблонов общих областей во временном хранилище (необязательно)
// Возвращает:
//  ТабличныйДокумент - заполненный документ
//
Функция СформироватьПечатнуюФорму(ИмяШаблона, АдресШаблоновОбластей = "", БезДоверенности = Ложь) Экспорт
	
	Попытка
		
		Макет = ПолучитьМакет(ИмяШаблона);
		
		Если Макет = Неопределено Тогда
			ВызватьИсключение "Макет """ + ИмяШаблона + """ не найден";
		КонецЕсли;
		
		// Сохраняем адрес шаблонов и имя шаблона в переменные модуля для использования в процедурах заполнения
		АдресШаблоновОбщихОбластейВоХранилище = АдресШаблоновОбластей;
		ИмяТекущегоШаблона = ИмяШаблона;
		
		// Сбрасываем счетчики областей при начале формирования новой печатной формы
		СчетчикиОбластей = Новый Соответствие;
		
		ТабличныйДокумент = Новый ТабличныйДокумент;
		
		// Вызываем соответствующую процедуру заполнения
		Если ИмяШаблона = "ПФ_MXL_ИтогиГолосования_word" Тогда
			ЗаполнитьПечатнуюФормуИтогиГолосованияWord(ТабличныйДокумент, ИмяШаблона);
		ИначеЕсли ИмяШаблона = "ПФ_MXL_Протокол_word" Тогда
			ЗаполнитьПечатнуюФормуПротоколWord(ТабличныйДокумент, ИмяШаблона);
		ИначеЕсли ИмяШаблона = "ПФ_MXL_БланкРешения" Тогда
			ЗаполнитьПечатнуюФормуБланкРешенияMXL(ТабличныйДокумент, ИмяШаблона, БезДоверенности);
		Иначе
			ВызватьИсключение "Неизвестный шаблон: " + ИмяШаблона;
		КонецЕсли;
		
		Возврат ТабличныйДокумент;
		
	Исключение
		
		ЗаписьЖурналаРегистрации("HD_ОбщееСобраниеСобственников", УровеньЖурналаРегистрации.Ошибка, , , 
			"Ошибка при формировании печатной формы """ + ИмяШаблона + """: " + ОписаниеОшибки());
		ВызватьИсключение;
		
	КонецПопытки;
	
КонецФункции //HD-

