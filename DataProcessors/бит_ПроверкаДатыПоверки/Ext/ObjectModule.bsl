
#Область ЭкспортныеПроцедурыИФункции

// Процедура заполнения табличной части.
//
Процедура ВыполнитьПроверку() Экспорт

	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	ПоверкаСЧ.Счетчик,
	|	ПоверкаСЧ.ДатаПоверки,
	|	ТабСч.ВладелецСчетчика,
	|	ТабСч.Улица,
	|	ТабСч.Здание,
	|	ТабСч.Квартира
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_ПоверкаСчетчиковСрезПоследних.Счетчик КАК Счетчик,
	|		бит_ПоверкаСчетчиковСрезПоследних.ДатаПоверки КАК ДатаПоверки
	|	ИЗ
	|		РегистрСведений.бит_ПоверкаСчетчиков.СрезПоследних(&Дата, ) КАК бит_ПоверкаСчетчиковСрезПоследних
	|	ГДЕ
	|		(НЕ бит_ПоверкаСчетчиковСрезПоследних.СнятНаПоверку)) КАК ПоверкаСЧ
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик КАК Счетчик,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект КАК ВладелецСчетчика,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.УлицаЛицевогоСчета КАК Улица,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Здание КАК Здание,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Квартира КАК Квартира
	|		ИЗ
	|			РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Дата, ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|		ГДЕ
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|		
	|		СГРУППИРОВАТЬ ПО
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.УлицаЛицевогоСчета,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Здание,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Квартира
	|		
	|		ОБЪЕДИНИТЬ ВСЕ
	|		
	|		ВЫБРАТЬ
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Улица,
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект.Ссылка,
	|			ЗНАЧЕНИЕ(Справочник.бит_Квартиры.ПустаяСсылка)
	|		ИЗ
	|			РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Дата, ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|		ГДЕ
	|			бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать) КАК ТабСч
	|		ПО ПоверкаСЧ.Счетчик = ТабСч.Счетчик
	|ГДЕ
	|	ПоверкаСЧ.ДатаПоверки < &Дата";
	
	Запрос.УстановитьПараметр("Дата", КонецДня(ТекущаяДата()));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Счетчики.Загрузить(Результат);

КонецПроцедуры

