	//	Возврат;
	//КонецЕсли;
	// БИТ_ЖКХ 08.02.2016 16:09:12 Конец правки. 
	
	НетПени = Ложь;
	СуммаДляРаспределения = СуммаДокумента;
	ИтогСальдо = 0;
	ИтогНачисления = КоммунальныеУслуги.Итог("Начислено");
	
	Если НачислятьПениСУчетомПереплаты Тогда
		
