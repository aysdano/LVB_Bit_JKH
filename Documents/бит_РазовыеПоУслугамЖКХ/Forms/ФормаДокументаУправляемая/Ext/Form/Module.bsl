&НаКлиенте
Процедура СписокУслугПеняУслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СписокУслугОтбора = ПолучитьСписокУслугОтбораНаСервере(Объект.Дата, Объект.ЛицевойСчет);
	
	Если Объект.СписокУслуг.Количество() > 0 Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("СписокУслугОтбора", СписокУслугОтбора);
		
		ОткрытьФорму("Справочник.бит_УслугиЖКХ.Форма.ФормаВыбораУправляемая", Новый Структура("ЗаполнитьИзДокументаРазовыеПоУслугамЖКХ", ПараметрыФормы), Элемент);
		
	КонецЕсли;

