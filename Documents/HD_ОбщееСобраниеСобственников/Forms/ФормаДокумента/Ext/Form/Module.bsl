//HD+
// Собирает строку «ФИО кв.N» по заполненной роли ПредложенныйПредседатель из ТЧ органов собрания.
//
&НаСервере
Функция СформироватьПредложенногоПредседателя()
	
	РольУчастника = ПолучитьРольУчастникаПоИмени(ИмяПараметраПредложенногоПредседателя());
	Если НЕ ЗначениеЗаполнено(РольУчастника) Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаУчастника = НайтиСтрокуОргановСобранияПоРоли(РольУчастника);
	Если СтрокаУчастника = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
		Возврат "";
	КонецЕсли;
	
	ФИО = СокрЛП(Строка(СтрокаУчастника.Собственник));
	Если НЕ ЗначениеЗаполнено(ФИО) Тогда
		Возврат "";
	КонецЕсли;
	
	Квартира = СокрЛП(Строка(СтрокаУчастника.НомерКвартиры));
	Если ЗначениеЗаполнено(Квартира) Тогда
		Возврат ФИО + " кв." + Квартира;
	КонецЕсли;
	
	Возврат ФИО;
	
КонецФункции //HD-

//HD+
// Собирает многострочный список: у всех строк кроме последней — запятая, у последней — точка.
//
&НаСервере
Функция СобратьМногострочныйСписокЧленовСоветаСРазделителями(ЧастиСписка)
	
	Если ЧастиСписка = Неопределено ИЛИ ЧастиСписка.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокиСРазделителями = Новый Массив;
	КоличествоЧастей = ЧастиСписка.Количество();
	
	Для Индекс = 0 По КоличествоЧастей - 1 Цикл
		Если Индекс < КоличествоЧастей - 1 Тогда
			СтрокиСРазделителями.Добавить(ЧастиСписка[Индекс] + ",");
		Иначе
			СтрокиСРазделителями.Добавить(ЧастиСписка[Индекс] + ".");
		КонецЕсли;
	КонецЦикла;
	
	Возврат СтрСоединить(СтрокиСРазделителями, Символы.ПС);
	
КонецФункции //HD-

//HD+
// Проверяет уникальность роли ПредложенныйЧленСовета_N / ПредложенныйПредседатель в ТЧ органов собрания.
// При дубле очищает роль в текущей строке и возвращает Ложь.
//
&НаСервере
Функция ПроверитьУникальностьРолиПредложенногоЧленаСоветаНаСервере(ИндексСтроки)
	
	Если ИндексСтроки < 0 ИЛИ ИндексСтроки >= Объект.ПредседательСекретарьСчетнаяКомиссия.Количество() Тогда
		Возврат Истина;
	КонецЕсли;
	
	СтрокаУчастника = Объект.ПредседательСекретарьСчетнаяКомиссия[ИндексСтроки];
	Если НЕ ЭтоРольПредложенногоЧленаСовета(СтрокаУчастника.Роль) Тогда
		Возврат Истина;
	КонецЕсли;
	
	Для ИндексДругой = 0 По Объект.ПредседательСекретарьСчетнаяКомиссия.Количество() - 1 Цикл
		Если ИндексДругой = ИндексСтроки Тогда
			Продолжить;
		КонецЕсли;
		ДругаяСтрока = Объект.ПредседательСекретарьСчетнаяКомиссия[ИндексДругой];
		Если ДругаяСтрока.Роль = СтрокаУчастника.Роль Тогда
			ПредставлениеРоли = СокрЛП(Строка(СтрокаУчастника.Роль));
			ОписаниеТипаРоли = Новый ОписаниеТипов("ПеречислениеСсылка.HD_РолиУчастников");
			СтрокаУчастника.Роль = ОписаниеТипаРоли.ПривестиЗначение(Неопределено);
			Сообщить("Роль """ + ПредставлениеРоли + """ уже назначена другому участнику органов собрания. Выберите другую роль.");
			Возврат Ложь;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Истина;
	
КонецФункции //HD-

//HD+
// Обновляет все пользовательские параметры, связанные с органами собрания по роли.
//
&НаСервере
Процедура ОбновитьПользовательскиеПараметрыПоРолямОргановСобранияНаСервере()
	
	Если Объект.ПользовательскиеПараметры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	БылиИзменения = Ложь;
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		
		ИмяПараметра = СокрЛП(Строка(СтрокаПараметра.Параметр));
		ПутьСвязи = СокрЛП(Строка(СтрокаПараметра.ОбъектДляСвязи));
		
		//HD+ Составной список предложенных членов совета
		Если ЭтоИмяИлиПутьСпискаПредложенныхЧленовСовета(ИмяПараметра, ПутьСвязи) Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаПараметра.ОбъектДляСвязи) Тогда
				СтрокаПараметра.ОбъектДляСвязи = ПутьСвязиСпискаПредложенныхЧленовСовета();
			КонецЕсли;
			СтрокаПараметра.Значение = СформироватьСписокПредложенныхЧленовСовета();
			БылиИзменения = Истина;
			Продолжить;
		КонецЕсли;
		
		//HD+ Составной предложенный председатель
		Если ЭтоИмяИлиПутьПредложенногоПредседателя(ИмяПараметра, ПутьСвязи) Тогда
			Если НЕ ЗначениеЗаполнено(СтрокаПараметра.ОбъектДляСвязи) Тогда
				СтрокаПараметра.ОбъектДляСвязи = ПутьСвязиПредложенногоПредседателя();
			КонецЕсли;
			СтрокаПараметра.Значение = СформироватьПредложенногоПредседателя();
			БылиИзменения = Истина;
			Продолжить;
		КонецЕсли;
		//HD-
		
		Если НЕ ЗначениеЗаполнено(ПутьСвязи) Тогда
			Продолжить;
		КонецЕсли;
		
		ПутьБезПрефикса = ПутьСвязи;
		Префикс = "Объект.";
		Если Лев(ПутьБезПрефикса, СтрДлина(Префикс)) = Префикс Тогда
			ПутьБезПрефикса = Сред(ПутьБезПрефикса, СтрДлина(Префикс) + 1);
		КонецЕсли;
		
		ЧастиПути = СтрРазделить(ПутьБезПрефикса, ".", Ложь);
		Если ЧастиПути.Количество() <> 3 Тогда
			Продолжить;
		КонецЕсли;
		
		Если НЕ ЭтоПутьКРолиОргановСобрания(ЧастиПути[0], ЧастиПути[1]) Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаПараметра.Значение = ПолучитьЗначениеРеквизитаДокументаПоПути(ПутьСвязи);
		БылиИзменения = Истина;
		
	КонецЦикла;
	
	Если БылиИзменения Тогда
		ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Обновляет значения строк ПользовательскиеПараметры, связанные с указанным реквизитом документа через ОбъектДляСвязи.
// После обновления выполняет подстановку параметров в текст повестки.
//
&НаСервере
Процедура ОбновитьПользовательскиеПараметрыПоСвязиНаСервере(Знач ПутьРеквизита)
	
	Если Объект.ПользовательскиеПараметры.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;
	
	ПутьСвязи = СокрЛП(Строка(ПутьРеквизита));
	Если НЕ ЗначениеЗаполнено(ПутьСвязи) Тогда
		Возврат;
	КонецЕсли;
	
	БылиИзменения = Ложь;
	ИзмененныеПараметры = Новый Массив;
	
	Для Каждого СтрокаПараметра Из Объект.ПользовательскиеПараметры Цикл
		Если СокрЛП(Строка(СтрокаПараметра.ОбъектДляСвязи)) = ПутьСвязи Тогда
			СтрокаПараметра.Значение = ПолучитьЗначениеРеквизитаДокументаПоПути(ПутьСвязи);
			БылиИзменения = Истина;
			ИзмененныеПараметры.Добавить(СокрЛП(Строка(СтрокаПараметра.Параметр)));
		КонецЕсли;
	КонецЦикла;
	
	//HD+ Падежные варианты одного базового имени получают то же значение
	Для Каждого ИмяИзмененногоПараметра Из ИзмененныеПараметры Цикл
		СинхронизироватьЗначениеПадежнойГруппыПользовательскихПараметровНаСервере(ИмяИзмененногоПараметра);
	КонецЦикла;
	//HD-
	
	Если БылиИзменения Тогда
		ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Извлекает параметры вида [ИмяПараметра] из текста и добавляет в массив в порядке первого появления (без дублей).
//
&НаСервере
Процедура ИзвлечьПараметрыИзТекста(Текст, НайденныеПараметры, УжеЕсть)
	
	Если НЕ ЗначениеЗаполнено(Текст) Тогда
		Возврат;
	КонецЕсли;
	
	ПозицияПоиска = 1;
	Пока ПозицияПоиска > 0 Цикл
		
		ПозицияОткрывающей = СтрНайти(Текст, "[", НаправлениеПоиска.СНачала, ПозицияПоиска);
		Если ПозицияОткрывающей = 0 Тогда
			Прервать;
		КонецЕсли;
		
		ПозицияЗакрывающей = СтрНайти(Текст, "]", НаправлениеПоиска.СНачала, ПозицияОткрывающей + 1);
		Если ПозицияЗакрывающей = 0 Тогда
			Прервать;
		КонецЕсли;
		
		Имя = Сред(Текст, ПозицияОткрывающей + 1, ПозицияЗакрывающей - ПозицияОткрывающей - 1);
		Имя = СокрЛП(Имя);
		
		//HD+ Пропуск маркеров опционального блока [?Имя] / [/?Имя]
		ЭтоМаркерОпциональногоБлока = Ложь;
		Если ЗначениеЗаполнено(Имя) Тогда
			Если Лев(Имя, 1) = "?" Тогда
				ЭтоМаркерОпциональногоБлока = Истина;
			ИначеЕсли Лев(Имя, 2) = "/?" Тогда
				ЭтоМаркерОпциональногоБлока = Истина;
			КонецЕсли;
		КонецЕсли;
		//HD-
		
		Если ЗначениеЗаполнено(Имя) И НЕ ЭтоМаркерОпциональногоБлока Тогда
			Если УжеЕсть.Получить(Имя) = Неопределено Тогда
				УжеЕсть.Вставить(Имя, Истина);
				НайденныеПараметры.Добавить(Имя);
			КонецЕсли;
		КонецЕсли;
		
		ПозицияПоиска = ПозицияЗакрывающей + 1;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Обрабатывает изменение поля Вопрос в табличной части ПовесткаДня с применением логики редактирования с подчеркиваниями
//
&НаСервере
Процедура ПовесткаДняВопросПриИзмененииНаСервере(ИндексСтроки)
	
	// Проверяем корректность индекса
	Если ИндексСтроки < 0 Или ИндексСтроки >= Объект.ПовесткаДня.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем строку по индексу
	СтрокаПовестки = Объект.ПовесткаДня[ИндексСтроки];
	Если СтрокаПовестки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//HD+ Всегда сохраняем шаблоны из справочника перед обработкой изменения текста
	// Это необходимо для корректной работы функционала возврата к исходному значению
	// после перезаполнения табличной части
	СохранитьШаблоныТекстаПовесткиДняНаСервере();
	
	НовыйТекст = СтрокаПовестки.Вопрос;
	
	// Получаем шаблон текста для этого поля из справочника
	Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Вопрос";
	ШаблонТекста = ШаблоныТекста.Получить(Ключ);
	
	// Если шаблон не найден, не применяем логику восстановления
	// Шаблон должен быть загружен из справочника при заполнении табличной части
	Если ШаблонТекста = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Применяем логику восстановления текста из шаблона
	ВосстановленныйТекст = ВосстановитьТекстИзШаблона(ШаблонТекста, НовыйТекст);
	
	// Если текст изменился, обновляем значение
	// Изменения применяются напрямую к объекту, форма обновится автоматически
	Если ВосстановленныйТекст <> НовыйТекст Тогда
		СтрокаПовестки.Вопрос = ВосстановленныйТекст;
	КонецЕсли;
	
	//HD+ После восстановления текста из шаблона повторно применяем пользовательские параметры,
	// иначе плейсхолдеры вида [Параметр] могут "откатиться" к исходному тексту.
	ПрименитьПользовательскиеПараметрыКСтрокеПовесткиДняНаСервере(ИндексСтроки);
	//HD-
	
КонецПроцедуры //HD-

//HD+
// Обрабатывает изменение поля ФормулировкаПредложенияРешенияВопроса в табличной части ПовесткаДня с применением логики редактирования с подчеркиваниями
//
&НаСервере
Процедура ПовесткаДняФормулировкаПредложенияРешенияВопросаПриИзмененииНаСервере(ИндексСтроки)
	
	// Проверяем корректность индекса
	Если ИндексСтроки < 0 Или ИндексСтроки >= Объект.ПовесткаДня.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	// Получаем строку по индексу
	СтрокаПовестки = Объект.ПовесткаДня[ИндексСтроки];
	Если СтрокаПовестки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	//HD+ Всегда сохраняем шаблоны из справочника перед обработкой изменения текста
	// Это необходимо для корректной работы функционала возврата к исходному значению
	// после перезаполнения табличной части
	СохранитьШаблоныТекстаПовесткиДняНаСервере();
	
	НовыйТекст = СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса;
	
	// Получаем шаблон текста для этого поля из справочника
	Ключ = Формат(ИндексСтроки, "ЧГ=") + "_ФормулировкаПредложенияРешенияВопроса";
	ШаблонТекста = ШаблоныТекста.Получить(Ключ);
	
	// Если шаблон не найден, не применяем логику восстановления
	// Шаблон должен быть загружен из справочника при заполнении табличной части
	Если ШаблонТекста = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	// Применяем логику восстановления текста из шаблона
	ВосстановленныйТекст = ВосстановитьТекстИзШаблона(ШаблонТекста, НовыйТекст);
	
	// Если текст изменился, обновляем значение
	// Изменения применяются напрямую к объекту, форма обновится автоматически
	Если ВосстановленныйТекст <> НовыйТекст Тогда
		СтрокаПовестки.ФормулировкаПредложенияРешенияВопроса = ВосстановленныйТекст;
	КонецЕсли;
	
	//HD+ После восстановления текста из шаблона повторно применяем пользовательские параметры.
	ПрименитьПользовательскиеПараметрыКСтрокеПовесткиДняНаСервере(ИндексСтроки);
	//HD-
	
КонецПроцедуры //HD-

//HD+
// Обрабатывает изменение поля Приложение в ТЧ ПовесткаДня (подчёркивания и пользовательские параметры).
//
&НаСервере
Процедура ПовесткаДняПриложениеПриИзмененииНаСервере(ИндексСтроки)
	
	Если ИндексСтроки < 0 Или ИндексСтроки >= Объект.ПовесткаДня.Количество() Тогда
		Возврат;
	КонецЕсли;
	
	СтрокаПовестки = Объект.ПовесткаДня[ИндексСтроки];
	Если СтрокаПовестки = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	СохранитьШаблоныТекстаПовесткиДняНаСервере();
	
	НовыйТекст = СтрокаПовестки.Приложение;
	Ключ = Формат(ИндексСтроки, "ЧГ=") + "_Приложение";
	ШаблонТекста = ШаблоныТекста.Получить(Ключ);
	Если ШаблонТекста = Неопределено Тогда
		СтрокаПовестки.Вопрос = СтрокаПовестки.Приложение;
		Возврат;
	КонецЕсли;
	
	ВосстановленныйТекст = ВосстановитьТекстИзШаблона(ШаблонТекста, НовыйТекст);
	Если ВосстановленныйТекст <> НовыйТекст Тогда
		СтрокаПовестки.Приложение = ВосстановленныйТекст;
	КонецЕсли;
	СтрокаПовестки.Вопрос = СтрокаПовестки.Приложение;
	
	ПрименитьПользовательскиеПараметрыКСтрокеПовесткиДняНаСервере(ИндексСтроки);
	
КонецПроцедуры //HD-

//HD+
// Восстанавливает текст из шаблона, сохраняя только измененные части с подчеркиваниями
// Логика аналогична функции из бит_ФормаПечатиУправляемая
//
&НаСервере
Функция ВосстановитьТекстИзШаблона(ШаблонТекста, НовыйТекст)
	
	// Извлекаем части текста с подчеркиваниями из шаблона (с порядковыми номерами)
	ЧастиШаблона = ИзвлечьЧастиТекста(ШаблонТекста);
	
	// Если в шаблоне нет частей (пустой текст), возвращаем новый текст
	Если ЧастиШаблона.Количество() = 0 Тогда
		Возврат НовыйТекст;
	КонецЕсли;
	
	//HD+ Добавляем колонку "СопоставленныеСимволы" в массив частей шаблона
	Для Каждого ЧастьШаблона Из ЧастиШаблона Цикл
		ЧастьШаблона.Вставить("СопоставленныеСимволы", "");
	КонецЦикла;
	
	// Извлекаем части из нового текста БЕЗ номеров (просто разбиваем на слова и пробелы)
	ЧастиНовогоТекста = ИзвлечьЧастиТекстаБезНомеров(НовыйТекст);
	
	//HD+ Сопоставляем части шаблона с новым текстом
	НесопоставленныеСимволы = СопоставитьЧастиШаблонаСНовымТекстом(ЧастиШаблона, ЧастиНовогоТекста);
	
	//HD+ Заполняем пустые ячейки "СопоставленныеСимволы" символами из "НесопоставленныеСимволы" по порядку
	// Но только для подчеркиваний (дробные номера)
	ИндексНесопоставленных = 0;
	Для Каждого ЧастьШаблона Из ЧастиШаблона Цикл
		ПорядковыйНомер = ЧастьШаблона.ПорядковыйНомер;
		ЦелаяЧастьНомера = Цел(ПорядковыйНомер);
		ЯвляетсяЦелым = (ПорядковыйНомер = ЦелаяЧастьНомера);
		
		//HD+ Заполняем только подчеркивания (дробные номера) из "НесопоставленныеСимволы"
		Если НЕ ЯвляетсяЦелым И ПустаяСтрока(ЧастьШаблона.СопоставленныеСимволы) Тогда
			// Собираем текст для подчеркивания из несопоставленных символов
			// Берем символы пропорционально длине подчеркивания в шаблоне
			ДлинаПодчеркивания = СтрДлина(ЧастьШаблона.Текст);
			ТекстПодчеркивания = "";
			Для ИндексСимвола = 0 По ДлинаПодчеркивания - 1 Цикл
				Если ИндексНесопоставленных < НесопоставленныеСимволы.Количество() Тогда
					ТекстПодчеркивания = ТекстПодчеркивания + НесопоставленныеСимволы[ИндексНесопоставленных].Текст;
					ИндексНесопоставленных = ИндексНесопоставленных + 1;
				Иначе
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			Если НЕ ПустаяСтрока(ТекстПодчеркивания) Тогда
				ЧастьШаблона.СопоставленныеСимволы = ТекстПодчеркивания;
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	//HD+ Выстраиваем текст заново из шаблона
	// Для неизменяемых частей (целые номера) - используем "СопоставленныеСимволы", если заполнено, иначе из шаблона
	// Для подчеркиваний (дробные номера) - используем "СопоставленныеСимволы", если заполнено, иначе из шаблона
	Результат = "";
	
	Для Каждого ЧастьШаблона Из ЧастиШаблона Цикл
		
		Если НЕ ПустаяСтрока(ЧастьШаблона.СопоставленныеСимволы) Тогда
			// Используем сопоставленные символы из нового текста
			Результат = Результат + ЧастьШаблона.СопоставленныеСимволы;
		Иначе
			// Используем текст из шаблона
			Результат = Результат + ЧастьШаблона.Текст;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Извлекает части текста из нового текста БЕЗ присвоения номеров (разбивает по символам)
//
&НаСервере
Функция ИзвлечьЧастиТекстаБезНомеров(Текст)
	
	Части = Новый Массив;
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат Части;
	КонецЕсли;
	
	ДлинаТекста = СтрДлина(Текст);
	
	//HD+ Разбиваем текст по символам (каждый символ - отдельная часть)
	Для Позиция = 1 По ДлинаТекста Цикл
		ТекущийСимвол = Сред(Текст, Позиция, 1);
		Часть = Новый Структура;
		Часть.Вставить("Текст", ТекущийСимвол);
		Часть.Вставить("Подчеркивание", Ложь);
		Части.Добавить(Часть);
	КонецЦикла;
	
	Возврат Части;
	
