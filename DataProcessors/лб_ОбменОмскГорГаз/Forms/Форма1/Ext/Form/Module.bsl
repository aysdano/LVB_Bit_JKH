Функция АдресПоЛС(ЛС, Здание)
	
	Адрес = "";
	
	Если ЗначениеЗаполнено(Здание.Улица.ТипУлицы) Тогда
		Адрес = Адрес + Строка(Здание.Улица.ТипУлицы)
	КонецЕсли;

	Если ЗначениеЗаполнено(Здание.Улица) Тогда
		Адрес = Адрес + Строка(Здание.Улица) + ", "
	КонецЕсли;
	
	Адрес = Адрес + "д." + Строка(Здание.НомерДома);
	
	Если ЗначениеЗаполнено(Здание.ПрефиксДома) Тогда
		Адрес = Адрес + Здание.ПрефиксДома 	
	КонецЕсли;

	Если ЗначениеЗаполнено(Здание.Корпус) Тогда
		Адрес = Адрес + "кор. " + Здание.Корпус 	
	КонецЕсли;
	
	Адрес = Адрес + ", ";
	
	НомерКвартиры = ЛС.Квартира.Наименование;
	
	НомерПозиции = СтрНайти(НомерКвартиры, "=");
	
	Если НомерПозиции <> 0 Тогда
		НомерКвартиры = Лев(НомерКвартиры, НомерПозиции - 1)
	КонецЕсли;
	
	Адрес = Адрес + НомерКвартиры;
	
	Возврат Адрес;

КонецФункции // АдресПоЛС()

