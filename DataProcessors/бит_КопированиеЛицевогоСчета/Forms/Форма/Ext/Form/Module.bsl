#Область ПеременныеМодуля

&НаКлиенте
Перем мСписокКодовЧисел; // Переменная хранит список кодов чисел. На Клиенте.

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура УправлениеДоступностьюЭлементовФормы()
	
	Элементы.Улица.Доступность    = ИзменитьАдрес;
	Элементы.Здание.Доступность   = ИзменитьАдрес;
	Элементы.Квартира.Доступность = ИзменитьАдрес;
	
	Элементы.ТипКвартиры.Доступность              = ИзменитьСведенияОКвартире;
	Элементы.СтатусКвартиры.Доступность           = ИзменитьСведенияОКвартире;
	Элементы.ТипПлиты.Доступность                 = ИзменитьСведенияОКвартире;
	Элементы.ТипЗапирающегоУстройства.Доступность = ИзменитьСведенияОКвартире;
	
	Элементы.ОбщаяПлощадь.Доступность        = ИзменитьСведенияОКвартире;
	Элементы.ОтапливаемаяПлощадь.Доступность = ИзменитьСведенияОКвартире;
	Элементы.СовокупнаяПлощадь.Доступность   = ИзменитьСведенияОКвартире;
	Элементы.ЖилаяПлощадь.Доступность        = ИзменитьСведенияОКвартире;
	Элементы.МОП.Доступность                 = ИзменитьСведенияОКвартире;
	
	Элементы.СообщениеАдрес.Видимость = НЕ ПустаяСтрока(СообщениеАдрес);
	
КонецПроцедуры // () 

&НаКлиенте
Функция ФормированиеАдресаДляФормы(Стр)
	
	ПредставлениеАдреса = ","
	+ СокрЛП(Стр.Поле1) + ","
	+ СокрЛП(Стр.Поле2) + ","
	+ СокрЛП(Стр.Поле3) + ","
	+ СокрЛП(Стр.Поле4) + ","
	+ СокрЛП(Стр.Поле5) + ","
	+ СокрЛП(Стр.Поле6) + ","                 
	+ СокрЛП(Стр.Поле7) + ","
	+ СокрЛП(Стр.Поле8) + ","
	+ СокрЛП(Стр.Поле9) + ","
	+ Строка(Стр.ТипДома)+ ","
	+ Строка(Стр.ТипКорпуса)+ ","
	+ Строка(Стр.ТипКвартиры)+",";
	
	Возврат ПредставлениеАдреса;
	
КонецФункции // ()

&НаКлиенте
// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ДополнитьМассивИсключений(МассивИсключений)
	
	Если ИзменитьСведенияОКвартире Тогда
		
		МассивИсключений.Добавить("ТипЗапирающегоУстройства");
		МассивИсключений.Добавить("ТипКвартиры");
		МассивИсключений.Добавить("ТипПлиты");
		МассивИсключений.Добавить("СтатусКвартиры");
		МассивИсключений.Добавить("ЖилаяПлощадь");
		МассивИсключений.Добавить("ОбщаяПлощадь");
		МассивИсключений.Добавить("ОтапливаемаяПлощадь");
		МассивИсключений.Добавить("СовокупнаяПлощадь");
		МассивИсключений.Добавить("МОП");
		
	КонецЕсли;
	
КонецПроцедуры // ()

&НаКлиенте
// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОчиститьРеквизитыФормы(МассивИсключений = Неопределено)
	
	МассивНаОчистку = Новый Массив;
	МассивНаОчистку.Добавить("Улица");
	МассивНаОчистку.Добавить("Здание");
	МассивНаОчистку.Добавить("Квартира");
	МассивНаОчистку.Добавить("ТипЗапирающегоУстройства");
	МассивНаОчистку.Добавить("ТипКвартиры");
	МассивНаОчистку.Добавить("ТипПлиты");
	МассивНаОчистку.Добавить("СтатусКвартиры");
	МассивНаОчистку.Добавить("ЖилаяПлощадь");
	МассивНаОчистку.Добавить("ОбщаяПлощадь");
	МассивНаОчистку.Добавить("ОтапливаемаяПлощадь");
	МассивНаОчистку.Добавить("СовокупнаяПлощадь");
	МассивНаОчистку.Добавить("МОП");
	
	Для каждого Реквизит Из МассивНаОчистку Цикл
		
		Если НЕ МассивИсключений = Неопределено И НЕ МассивИсключений.Найти(Реквизит) = Неопределено Тогда
			Продолжить;
		КонецЕсли; 
		
		Объект[Реквизит] = Неопределено;
		
		Если Реквизит = "Здание" Тогда
			Корпус = "";
		КонецЕсли;  
		
	КонецЦикла;
	
	СообщениеАдрес = "";
	
КонецПроцедуры // ()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.ДатаЗаведения = ТекущаяДата();
	
	Если НЕ Параметры.ЛицевойСчет.Пустая() Тогда
		
		Объект.ЛицевойСчет = Параметры.ЛицевойСчет;
		Обработки.бит_КопированиеЛицевогоСчета.ЗаполнитьОбъект(Объект, Параметры.ЛицевойСчет, Истина, Истина);
		
		СообщениеАдрес = ПроверитьНаличиеЛСПоАдресу(Объект.ЛицевойСчет, Объект.Квартира);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	ОчиститьРеквизитыФормы();
	Объект.Проживающие.Очистить();
	Объект.Услуги.Очистить();
	
	ЛицевойСчетПриИзмененииНаСервере();
	
	УправлениеДоступностьюЭлементовФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеДоступностьюЭлементовФормы();
	
	мСписокКодовЧисел = Новый СписокЗначений;
	
	Для Значение = 48 По 57 Цикл
		мСписокКодовЧисел.Добавить(Значение); 
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура НовыйЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
КонецПроцедуры

&НаКлиенте
Процедура ИзменитьАдресПриИзменении(Элемент)
	
	УправлениеДоступностьюЭлементовФормы();
	
	Если НЕ ИзменитьАдрес Тогда
		
		// БИТ_ЖКХ 15.04.2014		
		// Обработки.бит_КопированиеЛицевогоСчета.ЗаполнитьОбъект(Объект, Объект.ЛицевойСчет, НЕ ИзменитьСведенияОКвартире);.
		ЗаполнитьОбъектНаСервере(Объект, Объект.ЛицевойСчет, НЕ ИзменитьСведенияОКвартире);
		// БИТ_ЖКХ 15.04.2014
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОбъектНаСервере(Объект, ЛицевойСчет, ИзменитьСведенияОКвартире)
	
	Обработки.бит_КопированиеЛицевогоСчета.ЗаполнитьОбъект(Объект, Объект.ЛицевойСчет, НЕ ИзменитьСведенияОКвартире);
	
КонецПроцедуры
&НаКлиенте
Процедура ИзменитьСведенияОКвартиреПриИзменении(Элемент)
	
	УправлениеДоступностьюЭлементовФормы();
	
	Если НЕ ИзменитьСведенияОКвартире Тогда
		
		// БИТ_ЖКХ 15.04.2014
		// Обработки.бит_КопированиеЛицевогоСчета.ЗаполнитьСведенияОКвартире(Объект, Объект.Квартира);.
		ЗаполнитьСведенияОКвартиреНаСервере(Объект, Объект.Квартира);
		// БИТ_ЖКХ 15.04.2014
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСведенияОКвартиреНаСервере(Объект, Квартира)
	
	Обработки.бит_КопированиеЛицевогоСчета.ЗаполнитьСведенияОКвартире(Объект, Объект.Квартира);
	
КонецПроцедуры

