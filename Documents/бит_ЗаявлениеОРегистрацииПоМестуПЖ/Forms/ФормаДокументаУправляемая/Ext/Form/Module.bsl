&НаСервере
Процедура ОбновитьПравоустанавливающиеДокументы()
	
	мОтветственные = Новый Массив;	
	
	Для Каждого Ответственный Из Объект.ОтветственныеЗаРегистрацию Цикл		
		мОтветственные.Добавить(Ответственный.Ответственный);	
	КонецЦикла;
	
	ЗапросДокиНаЛицевом = Новый Запрос;
	ЗАпросДокиНаЛицевом.Текст = "ВЫБРАТЬ
	|	бит_ПравоустанавливающиеДокументы.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.бит_ПравоустанавливающиеДокументы КАК бит_ПравоустанавливающиеДокументы
	|ГДЕ
	|	бит_ПравоустанавливающиеДокументы.бит_Проживающий В(&Ответственные)
	|	И бит_ПравоустанавливающиеДокументы.бит_ЛицевойСчет = &ЛицевойСчет";
	ЗапросДокиНаЛицевом.УстановитьПараметр("Ответственные", мОтветственные);
	ЗапросДокиНаЛицевом.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	
	ВыборкаДокументыНаЛицевом = ЗапросДокиНаЛицевом.Выполнить().Выбрать();
	
	ПДокиПоЛицСчету = Новый Массив;
	
	Пока ВыборкаДокументыНаЛицевом.Следующий() Цикл
		
		ПДокиПоЛицСчету.Добавить(ВыборкаДокументыНаЛицевом.Ссылка);
		
	КонецЦикла;
	
	
	ДокументыВТЧ = Новый Массив;
	
	СтруктураДокументыВТЧ = Новый Структура;
	СтруктураДокументыВТЧ.Вставить("Документ");
	СтруктураДокументыВТЧ.Вставить("НомерСтроки");
	
	Для Каждого Строка Из Объект.ПравоустанавливающиеДокументы Цикл
		СтруктураДокументыВТЧ.Документ = Строка.Документ;
		СтруктураДокументыВТЧ.НомерСтроки = Строка.НомерСтроки;
		ДокументыВТЧ.Добавить(СтруктураДокументыВТЧ);	
	КонецЦикла;
	
	Индекс = 0;
	
	ТЗДокументы = Новый ТаблицаЗначений;
	ТЗДокументы.Колонки.Добавить("Документ");
	ТЗДокументы.Колонки.Добавить("Проживающий");
	
	Для Каждого Документ Из  ПДокиПоЛицСчету Цикл
		
		СтрокаТЗ =  ТЗДокументы.Вставить(Индекс);
		СтрокаТЗ.Документ = Документ;
		СтрокаТЗ.Проживающий = Документ.бит_Проживающий;
		
		Индекс = Индекс + 1;	
		
	КонецЦикла;
	
	Объект.ПравоустанавливающиеДокументы.Загрузить(ТЗДокументы);
	
	
КонецПроцедуры

&НаСервере
Процедура ОбновитьСнимаемыхСРегистрации()
	
	мСнимаемыеСРег = Новый Массив;
	мСнимаемыеСРег = ПолучитьВсехПроживающихПоЛС(Объект.ЛицевойСчет);
	
	ТЗСнимаемыеСРег = Новый ТаблицаЗначений;
	ТЗСнимаемыеСРег.Колонки.Добавить("Проживающий");
	ТЗСнимаемыеСРег.Колонки.Добавить("ДатаРегистрации");
	
	Индекс = 0;
	
	Если мСнимаемыеСРег.Количество() > 0 Тогда
		
		Для Каждого Элемент Из  мСнимаемыеСРег Цикл
			
			СтрокаТЗ =  ТЗСнимаемыеСРег.Вставить(Индекс);
			
			СтрокаТЗ.Проживающий = Элемент.Проживающий;
			СтрокаТЗ.ДатаРегистрации = Элемент.ДатаРегистрации;
			
			Индекс = Индекс + 1;	
			
		КонецЦикла;
		
		Объект.СнимаемыеСРегУчета.Загрузить(ТЗСнимаемыеСРег);
		Объект.РегистрируемоеЛицо = ТЗСнимаемыеСРег[0].Проживающий;
		УстановитьДатуСнятия(Объект.ЛицевойСчет, Объект.РегистрируемоеЛицо);
		
	Иначе
		Объект.СнимаемыеСРегУчета.Очистить();
		Объект.РегистрируемоеЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
	КонецЕсли;
КонецПроцедуры


