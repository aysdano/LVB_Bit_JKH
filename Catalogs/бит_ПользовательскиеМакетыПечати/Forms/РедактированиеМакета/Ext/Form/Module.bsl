&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("АвтоТест") Тогда // Возврат при получении формы для анализа.
		Возврат;
	КонецЕсли;
	
	ИдентификаторФормы = Параметры.ИдентификаторФормы;
	
	АдресФайлаМакетаВоВременномХранилище = Параметры.АдресФайлаМакетаВоВременномХранилище;
	ИмяМакета = Параметры.ИмяМакета;
	
	ТипМакета = Параметры.ТипМакета;
	
	//ПредставлениеМакета = ПредставлениеМакета();
	//ИмяФайлаМакета = ОбщегоНазначенияКлиентСервер.ЗаменитьНедопустимыеСимволыВИмениФайла(ПредставлениеМакета) + "." + НРег(ТипМакета);
	
	ИмяФайлаМакета = Параметры.ИмяФайлаМакета;
	
	Если Параметры.ТолькоОткрытие Тогда
		Заголовок = НСтр("ru = 'Открытие макета печатной формы'");
	Иначе
		АдресТаблицыОбластейВоВременномХранилище   = Параметры.АдресТаблицыОбластейВоВременномХранилище;
		АдресТаблицыПараметровВоВременномХранилище = Параметры.АдресТаблицыПараметровВоВременномХранилище;
		РаспаковатьТаблицы();
	КонецЕсли;
	
	ТипКлиента = ?(Параметры.ЭтоВебКлиент, "", "Не") + "ВебКлиент";
	КлючСохраненияПоложенияОкна = ТипКлиента + ВРег(ТипМакета);
	
	Для каждого ЭлементНазначения Из Параметры.СписокНазначений Цикл
		
		НоваяСтрока = Назначения.Добавить();
		НоваяСтрока.ПолноеИмяОбъектаМетаданных = ЭлементНазначения.Значение;
		НоваяСтрока.Представление              = ЭлементНазначения.Представление;
		
	КонецЦикла;
	
	Для каждого ЭлементПП Из Параметры.СписокПроизвольныхПараметров Цикл
		
		НоваяСтрока = ПроизовольныеПараметры.Добавить();
		НоваяСтрока.ИмяПараметра = ЭлементПП.Значение;
		
	КонецЦикла;
	//Если Не Параметры.ЭтоВебКлиент И ТипМакета = "MXL" Тогда
	//	Элементы.НадписьЗавершениеИзмененияНеВебКлиент.Заголовок = НСтр(
	//		"ru = 'После внесения необходимых изменений в макет нажмите на кнопку ""Завершить изменение""'");
	//КонецЕсли;
	
	
	
	УстановитьНазваниеПрограммыДляОткрытияМакета();
	
	Элементы.Диалог.ТекущаяСтраница = Элементы["СтраницаЗагрузкаНаКомпьютер" + ТипКлиента];
	Элементы.КоманднаяПанель.ТекущаяСтраница = Элементы.ПанельЗагрузка;
	Элементы.КнопкаИзменить.КнопкаПоУмолчанию = Истина;
	
	ДеревоОбъектовМетаданныхЗаполнить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	#Если Не ВебКлиент Тогда
		Если Параметры.ТолькоОткрытие Тогда
			Отказ = Истина;
		КонецЕсли;
		Если Параметры.ТолькоОткрытие Или ТипМакета = "MXL" Тогда
			ОткрытьМакет();
		КонецЕсли;
	#КонецЕсли
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// БИТ_ЖКХ 09.09.2016 11:55:28 Начало правки...
	Если ЗавершениеРаботы Тогда
		Возврат;
	КонецЕсли;
	// БИТ_ЖКХ 09.09.2016 11:55:28 Конец правки.
	
	Если Не ПустаяСтрока(ВременнаяПапка) Тогда
		УдалитьФайлы(ВременнаяПапка);
	КонецЕсли;
	
	ИмяСобытия = "ОтказОтИзмененияМакета";
	Если МакетЗагружен Тогда
		ИмяСобытия = "Запись_ПользовательскиеМакетыПечати";
	КонецЕсли;
	
	Результат = Новый Структура();
	Результат.Вставить("АдресФайлаМакетаВоВременномХранилище"      , АдресФайлаМакетаВоВременномХранилище);
