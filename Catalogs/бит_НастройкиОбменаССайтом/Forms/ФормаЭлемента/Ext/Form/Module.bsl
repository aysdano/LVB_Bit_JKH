&НаКлиенте
Процедура ПроверкаFTP(Команда)
	
		
	НастройкиТранспорта = ПолучитьFTPНастройкиСоединения();
	ЗаполнитьЗначенияСвойств(НастройкиТранспорта, Объект);
	
	РезультатПроверки = ПроверкаFTPСервер(НастройкиТранспорта);
	Если РезультатПроверки.Результат = Ложь Тогда
		ВызватьИсключение СтрШаблон(НСтр("ru = '%1'"), РезультатПроверки.Причина);
	Иначе
		ПоказатьПредупреждение(, НСтр("ru = 'Проверка пройдена успешно.'"));
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Функция ПолучитьFTPНастройкиСоединения() Экспорт
	
	FTPНастройкиСоединения = Новый Структура();
	FTPНастройкиСоединения.Вставить("АдресFTP",				"");
	FTPНастройкиСоединения.Вставить("КаталогFTP",			"");
	FTPНастройкиСоединения.Вставить("ПортFTP",				21);
	FTPНастройкиСоединения.Вставить("ЛогинFTP",				"");
	FTPНастройкиСоединения.Вставить("ПарольFTP",			"");
	FTPНастройкиСоединения.Вставить("ПассивноеСоединение",	Истина);
	FTPНастройкиСоединения.Вставить("ЗащищенноеСоединение",	Неопределено);
	
	Возврат FTPНастройкиСоединения;

КонецФункции

&НаСервереБезКонтекста
Функция ПроверкаFTPСервер(НастройкиТранспорта)
	
	РезультатПроверки = Новый Структура("Результат, Причина", Истина, "");
	
	НастройкиFTP = ОбменДаннымиСервер.FTPНастройкиСоединения(10);
	НастройкиFTP.Сервер               = НастройкиТранспорта.АдресFTP;
	НастройкиFTP.Порт                 = НастройкиТранспорта.ПортFTP;
	НастройкиFTP.ИмяПользователя      = НастройкиТранспорта.ЛогинFTP;
	НастройкиFTP.ПарольПользователя   = НастройкиТранспорта.ПарольFTP;
	Если НастройкиТранспорта.ЗащищенноеСоединение Тогда
		НастройкиFTP.ЗащищенноеСоединение= Новый ЗащищенноеСоединениеOpenSSL;
	Иначе
		НастройкиFTP.ЗащищенноеСоединение = Неопределено;
	КонецЕсли;
	
	Попытка
		
		FTPСоединение = ОбменДаннымиСервер.FTPСоединение(НастройкиFTP);
		
		Если СтрДлина(НастройкиТранспорта.КаталогFTP) > 1 Тогда
			ИмяКаталога = ПолучитьИмяКаталога(НастройкиТранспорта.КаталогFTP);
			Если НЕ ОбменДаннымиСервер.FTPКаталогСуществует(НастройкиТранспорта.КаталогFTP, ИмяКаталога, FTPСоединение) Тогда
				РезультатПроверки.Результат = Ложь;
				РезультатПроверки.Причина	= НСтр("ru = 'Соединение с свервером установлено, но каталог не найден!'");
			КонецЕсли;
		КонецЕсли;
		
	Исключение
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		РезультатПроверки.Результат = Ложь;
		РезультатПроверки.Причина	= КраткоеПредставлениеОшибки(ИнформацияОбОшибке);
	КонецПопытки;
	
	Возврат РезультатПроверки;
	
КонецФункции

