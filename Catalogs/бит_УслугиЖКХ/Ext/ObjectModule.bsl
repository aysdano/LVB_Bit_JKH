Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли; 	
	
	// Актуализация услуг шаблонов учета капитального ремонта.
	Если ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт Тогда
		
		СсылкаШаблон = Справочники.бит_ШаблоныИзвещений.КапитальныйРемонт; 
		Шаблон = СсылкаШаблон.ПолучитьОбъект();
		Шаблон.Услуги.Свернуть("Услуга,ПроцедураПечати,ФормаПечати");
		Если Шаблон.Услуги.Найти(Ссылка,"Услуга") = Неопределено Тогда
			
			Попытка
				Стр		   = Шаблон.Услуги.Добавить();
				Стр.Услуга = Ссылка;
				Шаблон.Записать();
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
		СсылкаШаблон = Справочники.бит_ШаблоныИзвещений.БезКапитальногоРемонта;
		Шаблон = СсылкаШаблон.ПолучитьОбъект();
		Шаблон.Услуги.Свернуть("Услуга,ПроцедураПечати,ФормаПечати");
		НайденнаяСтрока = Шаблон.Услуги.Найти(Ссылка,"Услуга");
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			
			Попытка
				Шаблон.Услуги.Удалить(НайденнаяСтрока);
				Шаблон.Записать();
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
		
	Иначе
		
		СсылкаШаблон = Справочники.бит_ШаблоныИзвещений.КапитальныйРемонт; 
		Шаблон = СсылкаШаблон.ПолучитьОбъект();
		Шаблон.Услуги.Свернуть("Услуга,ПроцедураПечати,ФормаПечати");
		НайденнаяСтрока = Шаблон.Услуги.Найти(Ссылка,"Услуга");
		Если НЕ НайденнаяСтрока = Неопределено Тогда
			
			Попытка
				Шаблон.Услуги.Удалить(НайденнаяСтрока);
				Шаблон.Записать();
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
		СсылкаШаблон = Справочники.бит_ШаблоныИзвещений.БезКапитальногоРемонта;
		Шаблон = СсылкаШаблон.ПолучитьОбъект();
		Шаблон.Услуги.Свернуть("Услуга,ПроцедураПечати,ФормаПечати");
		Если Шаблон.Услуги.Найти(Ссылка,"Услуга") = Неопределено Тогда
			
			Попытка
				Стр		   = Шаблон.Услуги.Добавить();
				Стр.Услуга = Ссылка;
				Шаблон.Записать();
			Исключение
			КонецПопытки;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры
