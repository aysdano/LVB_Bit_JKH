Функция ПолучитьИмяЗначенияПеречисления(ТекПеречисление,ЗначениеПеречисления) Экспорт
	
	ТекИндекс   = ТекПеречисление.Индекс(ЗначениеПеречисления);
	ИмяЗначения = ЗначениеПеречисления.Метаданные().ЗначенияПеречисления[ТекИндекс].Имя;
	
	Возврат ИмяЗначения;
КонецФункции // бит_ПолучитьИмяПоЗначениюПеречисления()

// Функция кэширует в структуру значения указанного перечисления. 
// Ключ имя значения перечисления, значение - ссылка.
// Используется для кэширования значений перечислений с целью передачи на клиент.
//
// Параметры:
//  ТекПеречисление  - ПеречислениеСсылка.
//
// Возвращаемое значение:
//   КэшЗначений     - Структура.
//
Функция КэшироватьЗначенияПеречисления(ТекПеречисление)  Экспорт
	
	КэшЗначений = Новый Структура;
	
	Для каждого ЗначениеПеречисления Из ТекПеречисление Цикл
		
		ИмяЗначения = ПолучитьИмяЗначенияПеречисления(ТекПеречисление,ЗначениеПеречисления);
		КэшЗначений.Вставить(ИмяЗначения,ЗначениеПеречисления);
		
	КонецЦикла; 
	
	Возврат КэшЗначений;
	
КонецФункции // КэшироватьЗначенияПеречисления()

Процедура ЗаполнитьЭлементОтбора(ЭлементОтбораИсточник,ЭлементОтбораПриемник) Экспорт
	
	ЭлементОтбораПриемник.ВидСравнения = ЭлементОтбораИсточник.ВидСравнения;
	ЭлементОтбораПриемник.Значение     = ЭлементОтбораИсточник.Значение;
	ЭлементОтбораПриемник.ЗначениеС    = ЭлементОтбораИсточник.ЗначениеС;
	ЭлементОтбораПриемник.ЗначениеПо   = ЭлементОтбораИсточник.ЗначениеПо;
	ЭлементОтбораПриемник.Использование = ЭлементОтбораИсточник.Использование;
	ЭлементОтбораПриемник.Представление = ЭлементОтбораИсточник.Представление;
	
КонецПроцедуры // бит_ЗаполнитьЭлементОтбора()

// Возвращает разницу в днях между двумя датами.
//
Функция РазностьДатВДнях(Дата1, Дата2)  Экспорт
	
	мДлинаСуток = 86400; // В секундах.
	
	Возврат Окр((НачалоДня(Дата1) - НачалоДня(Дата2)) / мДлинаСуток);
	
КонецФункции

// Процедура проверяет уникальность элемента справочника по переданному набору реквизитов.
//
// Параметры:
//	Объект - объект записываемого справочника;
//	СтруктураРеквизитов - Структура, содержащая имена реквизитов, уникальность по которым надо проверить:
//						ключ - имя реквизита;
//						значение - представление реквизита;
//	Отказ - флаг отказа от записи.
Процедура ПроверитьУникальностьЭлементаПоЗначениюРеквизитов(Объект, СтруктураРеквизитов, Отказ) Экспорт
	
	ИмяОбъекта = Объект.Метаданные().Имя;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	ТекстУсловия = "";
	СтрокаИменРеквизитов = "";
	Для Каждого ТекЭлемент Из СтруктураРеквизитов Цикл
		ТекстУсловия = ТекстУсловия + " И " + ИмяОбъекта + "." + ТекЭлемент.Ключ + " = &" + ТекЭлемент.Ключ;
		Запрос.УстановитьПараметр(ТекЭлемент.Ключ, Объект[ТекЭлемент.Ключ]);
		СтрокаИменРеквизитов = СтрокаИменРеквизитов +" "+ ?(ЗначениеЗаполнено(ТекЭлемент.Значение), ТекЭлемент.Значение, ТекЭлемент.Ключ)+";";
	КонецЦикла;
	// Вместо справочника прописывать тип объекта метаданных.
	ТекстЗапроса = "ВЫБРАТЬ
	|	"+ИмяОбъекта+".Ссылка
	|ИЗ   
	|	Справочник."+ИмяОбъекта+" КАК "+ИмяОбъекта+"
	|ГДЕ
	|	"+ИмяОбъекта+".Ссылка <> &Ссылка"+"
	|"+ТекстУсловия;
	
	Запрос.Текст = ТекстЗапроса;
	
	Результат = Запрос.Выполнить();
	Выборка = Результат.Выбрать();
	
	Если Выборка.Количество() > 0 Тогда

		ТекстСообщения = НСтр("ru = 'Данный элемент не является уникальным по значениям реквизитов: %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, СтрокаИменРеквизитов);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Отказ = Истина;
	КонецЕсли;
	
КонецПроцедуры

// Процедура проверяет уникальность строки таб.части по переданному набору реквизитов.
//
// Параметры:
//	Объект - объект записываемого справочника;
//	ИмяТабличнойЧасти - строка, имя табличной части, строки которой проверяются.
//	СтруктураРеквизитов - Структура, содержащая имена реквизитов, уникальность по которым надо проверить:.
//						ключ - имя реквизита;.
//						значение - представление реквизита;.
//	Отказ - флаг отказа от записи.
//  Заголовок                   - строка, заголовок сообщения об ошибке проведения,
//                                по умолчанию пустая строка.
//
//  ПредставлениеТабличнойЧасти - строка, название табличной части для вывода пользователю,
//								  по умолчанию пустая строка.
Процедура ПроверитьДублированиеСтрокВТабЧастиПоНаборуРеквизитов(Объект, ИмяТабличнойЧасти, СтруктураРеквизитов, Отказ, 
	ПредставлениеТабличнойЧасти="",Заголовок="") Экспорт
	
	ПредставлениеТабЧасти = ?(ПредставлениеТабличнойЧасти = "",
	Объект.Метаданные().ТабличныеЧасти[ИмяТабличнойЧасти].Представление(),
	ПредставлениеТабличнойЧасти);
	
	ТабличнаяЧасть      = Объект[ИмяТабличнойЧасти];
	МетаданныеРеквизиты = Объект.Метаданные().ТабличныеЧасти[ИмяТабличнойЧасти].Реквизиты;
	
	СтрокаРеквизитов = "";
	Для Каждого ТекРеквизит Из СтруктураРеквизитов Цикл
		СтрокаРеквизитов = СтрокаРеквизитов +" "+ ?(ЗначениеЗаполнено(ТекРеквизит.Значение),ТекРеквизит.Значение,МетаданныеРеквизиты[ТекРеквизит.Ключ].Синоним)+",";
	КонецЦикла;
	СтрокаРеквизитов = Лев(СтрокаРеквизитов, СтрДлина(СтрокаРеквизитов)-1);
	
	ЗаголовокВывели = Ложь;
	Ошибки = Неопределено;
	Для Каждого ТекСтрока Из ТабличнаяЧасть Цикл
		СтруктураОтбора = Новый Структура;
		Для Каждого ТекРеквизит Из СтруктураРеквизитов Цикл
			СтруктураОтбора.Вставить(ТекРеквизит.Ключ, ТекСтрока[ТекРеквизит.Ключ]);
		КонецЦикла;
		СтрокиДублей = ТабличнаяЧасть.НайтиСтроки(СтруктураОтбора);
		
		// Дублей нет, т.е. в таб части присутствует только одна строка с таким набором значений реквизитов.
		Если СтрокиДублей.Количество() = 1 Тогда
			Продолжить;
		КонецЕсли;
		
		СтрокаНомеровСтрок = "";
		Для Каждого ТекДубль Из СтрокиДублей Цикл
			СтрокаНомеровСтрок = СтрокаНомеровСтрок + " " + ТекДубль.НомерСтроки + ";";
			Отказ = Истина;
		КонецЦикла;
		
		Если НЕ ЗаголовокВывели Тогда
			ОшибкаПриПроведении("В табличной части """ + ПредставлениеТабЧасти + """, присутствуют дубли строк по значениям в колонках: """ + СтрокаРеквизитов + """ - в строках:", Отказ, Заголовок);
			ЗаголовокВывели = Истина;
		КонецЕсли;

		ТекстОшибки = НСтр("ru = 'Строка №%1: значения реквизитов из строки повторяются в строках №№%2.'");
		ТекстОшибки = СтрШаблон(ТекстОшибки, ТекСтрока.НомерСтроки, СтрокаНомеровСтрок);
 		ОбщегоНазначенияКлиентСервер.ДобавитьОшибкуПользователю(Ошибки, "", ТекстОшибки, "");
		
	КонецЦикла;
	ОбщегоНазначенияКлиентСервер.СообщитьОшибкиПользователю(Ошибки);

КонецПроцедуры

