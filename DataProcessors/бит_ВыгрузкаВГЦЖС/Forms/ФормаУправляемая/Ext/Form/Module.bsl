Процедура КаталогОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	КаталогНаДиске = Новый Файл(ВыбранноеЗначение);
    Если КаталогНаДиске.Существует() Тогда
        Возврат;
    Иначе
        Ответ = Вопрос("Каталог не существует. Создать?", 
                        РежимДиалогаВопрос.ОКОтмена);
        Если Ответ = КодВозвратаДиалога.ОК Тогда
            СоздатьКаталог(ВыбранноеЗначение);
            Возврат;
        Иначе
            Возврат;
        КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

