//HD+
// Для строки-приложения в деталях видно только поле Приложение; иначе — вопрос и формулировка.
//
&НаКлиентеНаСервереБезКонтекста
Процедура НастроитьВидимостьДеталейПовесткиДня(Форма)
	
	ЭтоПриложение = Ложь;
	Попытка
		ИдентификаторСтроки = Форма.Элементы.ПовесткаДня.ТекущаяСтрока;
		Если ИдентификаторСтроки <> Неопределено Тогда
			СтрокаПовестки = Форма.Объект.ПовесткаДня.НайтиПоИдентификатору(ИдентификаторСтроки);
			Если СтрокаПовестки <> Неопределено И ТипЗнч(СтрокаПовестки.ЭтоПриложение) = Тип("Булево") Тогда
				ЭтоПриложение = СтрокаПовестки.ЭтоПриложение;
			КонецЕсли;
		КонецЕсли;
	Исключение
		ЭтоПриложение = Ложь;
	КонецПопытки;
	
	Форма.Элементы.ПовесткаДняВопросДетали.Видимость = НЕ ЭтоПриложение;
	Форма.Элементы.ПовесткаДняРешениеДетали.Видимость = НЕ ЭтоПриложение;
	Форма.Элементы.ПовесткаДняПриложениеДетали.Видимость = ЭтоПриложение;
	
КонецПроцедуры //HD-

//HD+
&НаКлиенте
Процедура ТекущийВопросПриИзменении(Элемент)
	
	ТекущиеДанные = Элементы.ПовесткаДня.ТекущиеДанные;
	Если ТекущиеДанные = Неопределено Тогда
		Возврат;
