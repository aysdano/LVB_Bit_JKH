// Процедура создает новый документ Корректировка показаний счетчиков с видом операции Корректирвка ошибочных показаний.
&НаКлиенте
Процедура КорректировкаПоказаний(Команда)
	
	ТекСтрока = Элементы.ТаблицаСчетчиков.ТекущиеДанные;
	
	Если ТекСтрока = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	ПоГрупповымСчетчикам = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам");
	ПоГрупповымСчетчикамСНалИнд = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных");
	
	Если ТекСтрока.СпособРасчета = ПоГрупповымСчетчикам ИЛИ ТекСтрока.СпособРасчета = ПоГрупповымСчетчикамСНалИнд Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Корректировка показаний счетчиков доступна только для индивидуальных счетчиков");
		
		Возврат;
		
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ВидОперации"      , ПредопределенноеЗначение("Перечисление.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаОшибочныхПоказаний"));
	ПараметрыФормы.Вставить("Дата"             , ТекущаяДата());
	ПараметрыФормы.Вставить("Организация"      , Объект.Организация);
	ПараметрыФормы.Вставить("Здание"           , Объект.Здание);
	ПараметрыФормы.Вставить("Улица"            , Объект.УлицаЛицевогоСчета);
	
	// БИТ_ЖКХ 07.02.2014
	// ПараметрыФормы.Вставить("Ответственный"    , глЗначениеПеременной("глТекущийПользователь"));.
	ПараметрыФормы.Вставить("Ответственный"    , бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	// БИТ_ЖКХ 07.02.2014
	
	ПараметрыФормы.Вставить("ЛицевойСчет"      , Объект.Ссылка);
	ПараметрыФормы.Вставить("Счетчик"          , ТекСтрока.Счетчик);
	ПараметрыФормы.Вставить("Многотарифный"    , ТекСтрока.Многотарифный);
	ПараметрыФормы.Вставить("ИсточникПоказаний", ПредопределенноеЗначение("Перечисление.бит_ИсточникПоказаний.Население"));
	ПараметрыФормы.Вставить("Услуга"           , ТекСтрока.Услуга);
	
	ОткрытьФорму("Документ.бит_КорректировкаПоказанийСчетчиков.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзСправочникаЛицевыеСчета", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

