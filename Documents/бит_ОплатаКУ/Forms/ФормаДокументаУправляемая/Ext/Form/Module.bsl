//16.04.2019
&НаСервере
Процедура РассчитатьСУчетомНачисленийМесяцаНаСервере()
	
	Если Объект.ОплатаПоПериоду
		И (ПериодОплаты.ДатаНачала > ПериодОплаты.ДатаОкончания	ИЛИ НЕ ЗначениеЗаполнено(ПериодОплаты.ДатаОкончания)) Тогда
		
		ТекстСообщения = НСтр("ru = 'Перед расчетом необходимо заполнить Период оплаты'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ОплатаПоПериоду Тогда
		
		ТекстСообщения = "";
		Для каждого Стр Из Объект.СписокЛС Цикл
			Если Стр.ШаблонИзвещений.Сальдо = ПредопределенноеЗначение("Перечисление.ДаНет.Да") 
				ИЛИ Стр.ШаблонИзвещений.Кредит = ПредопределенноеЗначение("Перечисление.ДаНет.Да") Тогда
				ТекстСообщения = ТекстСообщения + СтрШаблон(
													НСтр("ru = 'Необходимо изменить ""Шаблон извещения"" для лицевого счета: ""%1""'"),
													Стр.ЛицевойСчет);
				ТекстСообщения = ТекстСообщения + Символы.ПС;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ ПустаяСтрока(ТекстСообщения) Тогда
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	ДокументОбъект.ВыполнитьРасчетСУчетомНачисленийМесяца();
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
	ДокументРассчитан = Истина;

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьКонтрагентамиОтветственныхЛиц(Команда)
	ЗаполнитьКонтрагентамиОтветственныхЛицНаСервере();
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьКонтрагентамиОтветственныхЛицНаСервере()
	
	для каждого стр из Объект.СписокЛС цикл
		
		контрагент = НайтиКонтрагентаПоЛС(стр.ЛицевойСчет, Объект.Дата);

		если контрагент <> неопределено тогда
		 стр.СубконтоКУ1 = контрагент.Контрагент;
		 стр.СубконтоКУ2 = контрагент.ДоговорКонтрагента;
		конецесли; 
		
	конеццикла;	
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
КонецПроцедуры

функция НайтиКонтрагентаПоЛС(ЛицевойСчет, Дата)

  запрос = новый Запрос;
  запрос.Текст = "ВЫБРАТЬ РАЗРЕШЕННЫЕ
  |		бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
  |		бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
  |	ПОМЕСТИТЬ Проживающие
  |	ИЗ
  | 	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = (&ЛицевойСчет)) КАК бит_ПроживающиеПоЛССрезПоследних
  |	ГДЕ
  |		(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата
  |				ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
  |		И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
  |		И НЕ бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица = ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.Выписан)
  |	;
  |	////////////////////////////////////////////////////////////////////////////////
  |	ВЫБРАТЬ РАЗРЕШЕННЫЕ
  |		бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет,
  |	// БИТ_ЖКХ_01102013_начало_изменений
  |		бит_ОтветственныеЛицаПоКУСрезПоследних.ДоговорКонтрагента,
  |	// БИТ_ЖКХ_01102013_окончание_изменений
  |		бит_ОтветственныеЛицаПоКУСрезПоследних.Контрагент
  |	ИЗ
  |		Проживающие КАК Проживающие
  |			ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ОтветственныеЛицаПоКУ.СрезПоследних(&Дата, ЛицевойСчет  = (&ЛицевойСчет)) КАК бит_ОтветственныеЛицаПоКУСрезПоследних
  |			ПО Проживающие.ЛицевойСчет = бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет
  |				И Проживающие.ФизЛицо = бит_ОтветственныеЛицаПоКУСрезПоследних.ФизЛицо
  |	
  |	СГРУППИРОВАТЬ ПО
  |		бит_ОтветственныеЛицаПоКУСрезПоследних.ЛицевойСчет,
  |	// БИТ_ЖКХ_01102013_начало_изменений
  |		бит_ОтветственныеЛицаПоКУСрезПоследних.ДоговорКонтрагента,
  |	// БИТ_ЖКХ_01102013_окончание_изменений
  |	бит_ОтветственныеЛицаПоКУСрезПоследних.Контрагент ;";
  
  запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
  запрос.УстановитьПараметр("Дата", Дата);

  таб = запрос.Выполнить().Выгрузить();
  
  если таб.Количество() > 0 тогда
   структураВозврата = новый Структура();
   структураВозврата.Вставить("Контрагент", таб[0].Контрагент);
   структураВозврата.Вставить("ДоговорКонтрагента", таб[0].ДоговорКонтрагента);
   
   возврат структураВозврата;   
  иначе 
   возврат неопределено;
  конецесли;	  

КонецФункции	

