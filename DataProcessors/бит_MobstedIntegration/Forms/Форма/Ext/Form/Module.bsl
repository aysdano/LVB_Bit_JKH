Процедура РучнаяПрогрузкаНачисленийНаСервере()
	
	ДатаОтчета = ТекущаяДата();
	
	Квитанция = Новый ТабличныйДокумент;
	
	Результат = Неопределено;
	
	ОбработкаОбъект = Обработки.бит_ПечатьСчетИзвещений.Создать();
	
	ОбработкаОбъект.МакетКв               = объект.ШаблонКвитанции;  // ВОТ ТУТ ШАБЛОН КВИТАНЦИИ ЭТО НЕ МАКЕТ А ЭЛЕМЕНТ СПРАВОЧНИКА
	//ОбработкаОбъект.Период                = ДобавитьМесяц(КонецМесяца(ТекущаяДата()), -1);
	ОбработкаОбъект.ШаблонИзвещений       = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
	ОбработкаОбъект.Организация           = Объект.Организация;
	ОбработкаОбъект.РС                    = Объект.Организация.ОсновнойБанковскийСчет;
	ОбработкаОбъект.ТекущийПакет          = 1;
	ОбработкаОбъект.РазмерПакетаПечати    = 500;
	ОбработкаОбъект.РазмерПакетаПросмотра = 50;
	Для Каждого Стр Из ТаблицаЛицевыхСчетов Цикл
		Если Не Стр.ЕстьВМобстед Тогда ПРодолжить КонецЕсли;
		НоваяСтрока = ОбработкаОбъект.СписокЛС.Добавить();
		НоваяСтрока.ЛицевойСчет = Стр.ЛицевойСчет;
	КонецЦикла;	
	
	Обработка = ОбработкаОбъект;
	ПериодНачислений    = КонецМесяца(ДатаОтчета);
	Обработка.Период      = КонецМесяца(ДатаОтчета);
	
	Обработка.ОбновитьНастройкиЖКХ();
	Обработка.ОбновитьКэшОрганизации();
	// БИТ_ЖКХ 24.01.2017 13:35:35 Начало правки...
	Обработка.ОбновитьКэшПолучателяПлатежа();
	// БИТ_ЖКХ 24.01.2017 13:35:35 Конец правки.
	
	Обработка.ПолучитьНастройкуМакета();
	
	ТаблицаДанных = ОбработкаОбъект.СформироватьДанныеПечати();
	
	Если ТаблицаДанных.количество() <> 0 Тогда
		
		Для Каждого СтрТабл Из ТаблицаДанных Цикл
			
			Если СтрТабл.Значение.СтруктураДанных.КОплатеЗаМесяц = 0 Тогда Продолжить; КонецЕсли; //Нет начислений 
			
			Период = СтрТабл.Значение.СтруктураДанных.Дата;
			УИН = Лев(КонецМесяца(Период),10);
			
			Если ПроверитьНачисленияВМобстед(УИН,СтрТабл.ЛицевойСчет.Наименование) Тогда Продолжить; КонецЕсли;
			
			ЕстьОтвет = Истина;
			
			АдресСервисаСтр = СокрЛП(Объект.АдресСервиса);
			АдресРесурса1 = "/api/v4/events/";
			Запрос1 = КодироватьСтроку(Строка(СокрЛП(Объект.НомерПриложения)),СпособКодированияСтроки.КодировкаURL);
			
			Запрос4 = 
			"["
			+"{"
			+"""field"""                +":"+ """НомерЛицевогоСчета"""+","
			+"""operation"""            +":"+ """="""+","
			+"""value"""                +":"+""""+Строка(СтрТабл.ЛицевойСчет.Наименование)+""""+","
			+"""andor"""                +":"+"""and"""
			+"}"
			+"]";
			
			
			Запрос4 = КодироватьСтроку(Запрос4,СпособКодированияСтроки.КодировкаURL);
			Запрос5 = "{"+"""Сумма"""+":"+""""+СтрЗаменить(СтрТабл.Значение.СтруктураДанных.КОплатеЗаМесяц,Символы.НПП,"")+""""+"}";  //{"Сумма":"100500"}
			Запрос2 = КодироватьСтроку("Начисление",СпособКодированияСтроки.КодировкаURL);
			Запрос3 = КодироватьСтроку(Строка(Объект.СтатусВРаботе),СпособКодированияСтроки.КодировкаURL);
			Запрос5 = КодироватьСтроку(Запрос5,СпособКодированияСтроки.КодировкаURL);
			Дата = Сред(УИН,7,4)+"-"+Сред(УИН,4,2)+"-"+Сред(УИН,1,2);
			УИН = КодироватьСтроку(УИН,СпособКодированияСтроки.КодировкаURL);       // Y-m-d
			Запрос6 = КодироватьСтроку(Дата,СпособКодированияСтроки.КодировкаURL);       // Y-m-d
			СтрокаПараметров = "ApplicationId="+Запрос1+"&ActionName="+Запрос2+"&PaymentDocNumber="+УИН+"&StatusId="+Запрос3+"&Object="+Запрос4+"&Value="+Запрос5+"&CreateDate="+Запрос6;
			
			HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса1);
			HTTPЗапрос.УстановитьТелоИзСтроки(СтрокаПараметров, КодировкаТекста.UTF8);
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");   // тут поменялось
			HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
			HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
			Попытка
				Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
			Исключение
				ЕстьОтвет = Ложь;
				Сообщить("Ошибка при отправке запроса: " + ОписаниеОшибки());
			КонецПопытки;
			
			Если ЕстьОтвет Тогда
				Если Ответ.КодСостояния = 200 Тогда
					СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
					
					Если Не ПустаяСтрока(СтрокаОтвет) Тогда
						РезультатПроверки = СтрокаОтвет;
						Результат = РезультатПроверки;
						Сообщить(Результат);
					КонецЕсли;
				ИначеЕсли Ответ.КодСостояния = 500 Тогда
					Сообщить("Ручная прогрузка начислений. "+"Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
				ИначеЕсли Ответ.КодСостояния = 404 Тогда
					Сообщить("Ручная прогрузка начислений. "+"Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
				ИначеЕсли Ответ.КодСостояния = 301 Тогда
					Сообщить("Ручная прогрузка начислений. "+"Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
				Иначе
					Сообщить("Ручная прогрузка начислений. "+"Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЕсли;
	
	//Создали события с начислениями со статусом в работе
	//Теперь их обработаем
	ЕстьОтвет = Истина;	
	
	АдресСервисаСтр = СокрЛП(Объект.АдресСервиса);
	АдресРесурса = "/api/v4/events?ApplicationId="+Объект.НомерПриложения+"&query=";
	
	СтрокаПараметров = 
	"["
	+"{"
	+"""field"""                +":"+ """StatusId"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+""""+Строка(Объект.СтатусВРаботе)+""""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+","
	+"{"
	+"""field"""                +":"+ """ActionName"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+"""Начисление"""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+"]";
	//Сообщить(СтрокаПараметров);
	
	
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		ЕстьОтвет = Ложь;
		Сообщить("Ошибка при отправке запроса: " + ОписаниеОшибки());
	КонецПопытки;
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				Если СокрЛП(РезультатПроверки)="false" Тогда
					Сообщить("Соединение не установлено");
				Иначе
					
					
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
					ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
					ЧтениеJSON.Закрыть();
					
					Если ЗагруженныеДанные.Количество()<>0 Тогда
						
						ТЗ = РаспарситьВТаблицуЗапросКвитанции(ЗагруженныеДанные);
						
						ОтправитьДетализацию(ТЗ);
						
						ОтправитьКвитанцииПоЛицевымСчетам(ТЗ,ПериодНачислений);
						
						ОтправитьСМС(ТЗ);
						
					КонецЕсли;
					//Сообщить(РезультатПроверки);
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			Сообщить("Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Сообщить("Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Сообщить("Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
		Иначе
			Сообщить("Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры	

