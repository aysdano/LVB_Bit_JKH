//HD+
// Получает паспорт инициатора (серия + номер)
// Возвращает:
//  Строка - паспорт инициатора
//
Функция ПолучитьИнициаторПаспорт()
	
	СтрокаПаспорта = "";
	
	СерияПаспорта = НормализоватьСериюНомерПаспорта(ИнициаторПаспортСерия);
	НомерПаспорта = НормализоватьСериюНомерПаспорта(ИнициаторПаспортНомер);
	
	Если ЗначениеЗаполнено(СерияПаспорта) Тогда
		СтрокаПаспорта = СерияПаспорта;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(НомерПаспорта) Тогда
		Если СтрокаПаспорта <> "" Тогда
			СтрокаПаспорта = СтрокаПаспорта + " ";
		КонецЕсли;
		СтрокаПаспорта = СтрокаПаспорта + НомерПаспорта;
	КонецЕсли;
	
	Возврат СтрокаПаспорта;
	
