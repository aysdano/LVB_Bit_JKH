	
Процедура ВыгрузитьЗдания(ПараметрыОбмена) Экспорт	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОбмена.Организация);
	Запрос.УстановитьПараметр("СписокУлиц"	, ПараметрыОбмена.СписокУлиц);
	Запрос.УстановитьПараметр("СписокЗданий", ПараметрыОбмена.СписокЗданий);
	Запрос.УстановитьПараметр("СписокЛС"	, ПараметрыОбмена.СписокЛС);
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.Организация) Тогда
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокУлиц)
		И ПараметрыОбмена.СписокУлиц.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Истина);
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЗданий) 
		И ПараметрыОбмена.СписокЗданий.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЛС) 
		И ПараметрыОбмена.СписокЛС.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЛС", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЛС", Истина);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_ЛицевыеСчета.Здание КАК Здание
	|ПОМЕСТИТЬ ВТ_ЛицевыеСчета
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И (&НеПроверятьЛС
	|			ИЛИ бит_ЛицевыеСчета.Ссылка В (&СписокЛС))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Здание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЛицевыеСчета.Здание КАК Здание,
	|	бит_СписокЗданий.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_СписокЗданий.Состояние КАК Состояние,
	|	бит_СписокЗданий.ДатаВводаВЭксплуатацию КАК ДатаВводаВЭксплуатацию,
	|	бит_СписокЗданий.ФондКапРемонта КАК ФондКапРемонта,
	|	бит_СписокЗданий.КолВоПодземныхЭтажей КАК КолВоПодземныхЭтажей,
	|	бит_СписокЗданий.КолВоЭтажейНаименьшее КАК КолВоЭтажейНаименьшее,
	|	бит_СписокЗданий.ОбъектаКультурногоНаследия КАК ОбъектаКультурногоНаследия,
	|	бит_СписокЗданий.ЧасоваяЗонаПоOlson КАК ЧасоваяЗонаПоOlson,
	|	бит_СписокЗданий.КадастровыйНомер КАК КадастровыйНомер,
	|	бит_СписокЗданий.Серия КАК Серия,
	|	бит_СписокЗданий.НомерДома КАК НомерДома,
	|	бит_СписокЗданий.Корпус КАК Корпус,
	|	бит_СписокЗданий.ПрефиксДома КАК ПрефиксДома,
	|	бит_СписокЗданий.Прочее КАК Прочее
	|ПОМЕСТИТЬ ВТ_Здания
	|ИЗ
	|	ВТ_ЛицевыеСчета КАК ВТ_ЛицевыеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|		ПО ВТ_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
	|ГДЕ
	|	НЕ бит_СписокЗданий.ПометкаУдаления
	|	И (&НеПроверятьОрганизации
	|			ИЛИ бит_СписокЗданий.Организация В (&Организация))
	|	И (&НеПроверятьУлицы
	|			ИЛИ бит_СписокЗданий.Улица В (&СписокУлиц))
	|	И (&НеПроверятьЗдания
	|			ИЛИ бит_СписокЗданий.Ссылка В (&СписокЗданий))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВТ_ЛицевыеСчета.Здание
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета КАК ОбъектУчета,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилыхПомещений)
	|				ТОГДА бит_ЗначениеСвойствОбъектовУчета.Значение
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОбщаяПлощадьЖилыхПомещений,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилогоЗдания)
	|				ТОГДА бит_ЗначениеСвойствОбъектовУчета.Значение
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК ОбщаяПлощадьЖилогоЗдания,
	|	МАКСИМУМ(ВЫБОР
	|			КОГДА бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.КоличествоЭтажей)
	|				ТОГДА бит_ЗначениеСвойствОбъектовУчета.Значение
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоЭтажей
	|ПОМЕСТИТЬ ВТ_ДопСвойства
	|ИЗ
	|	РегистрСведений.бит_ЗначениеСвойствОбъектовУчета КАК бит_ЗначениеСвойствОбъектовУчета
	|ГДЕ
	|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета В
	|			(ВЫБРАТЬ
	|				ВТ_Здания.Здание
	|			ИЗ
	|				ВТ_Здания КАК ВТ_Здания)
	|	И (бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилыхПомещений)
	|			ИЛИ бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилогоЗдания)
	|			ИЛИ бит_ЗначениеСвойствОбъектовУчета.ВидСвойства = ЗНАЧЕНИЕ(ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.КоличествоЭтажей))
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ОбъектУчета
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_Квартиры.Ссылка) КАК КолВоКвартир,
	|	бит_Квартиры.Владелец КАК Здание
	|ПОМЕСТИТЬ ВТ_КолВоКвартир
	|ИЗ
	|	Справочник.бит_Квартиры КАК бит_Квартиры
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Здания КАК ВТ_Здания
	|		ПО бит_Квартиры.Владелец = ВТ_Здания.Здание
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_Квартиры.Владелец
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_Здания.Здание КАК Здание,
	|	ВТ_Здания.ПочтовыйАдрес КАК АдресЗдания,
	|	ПРЕДСТАВЛЕНИЕ(ВТ_Здания.Состояние) КАК Состояние,
	|	ВЫБОР
	|		КОГДА ВТ_Здания.ДатаВводаВЭксплуатацию = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА """"
	|		ИНАЧЕ ГОД(ВТ_Здания.ДатаВводаВЭксплуатацию)
	|	КОНЕЦ КАК ГодПостройки,
	|	ВЫБОР
	|		КОГДА ВТ_Здания.ФондКапРемонта = ЗНАЧЕНИЕ(Перечисление.бит_СпособФормированияФондаКапРемонта.ПустаяСсылка)
	|			ТОГДА ""Значение не выбрано""
	|		ИНАЧЕ ПРЕДСТАВЛЕНИЕ(ВТ_Здания.ФондКапРемонта)
	|	КОНЕЦ КАК ФондКапРемонта,
	|	ВТ_Здания.КолВоПодземныхЭтажей КАК КоличествоПодземныхЭтажей,
	|	ВТ_Здания.КолВоЭтажейНаименьшее КАК КоличествоЭтажейНаименьшее,
	|	ВТ_Здания.КадастровыйНомер КАК КадастровыйНомерЗдания,
	|	ЕСТЬNULL(ВТ_ДопСвойства.ОбщаяПлощадьЖилыхПомещений, 0) КАК ОбщаяПлощадьЖилыхПомещений,
	|	ЕСТЬNULL(ВТ_ДопСвойства.ОбщаяПлощадьЖилогоЗдания, 0) КАК ОбщаяПлощадьЗдания,
	|	ЕСТЬNULL(ВТ_ДопСвойства.КоличествоЭтажей, 0) КАК КоличествоЭтажей,
	|	ВТ_Здания.Серия КАК Серия,
	|	ВТ_Здания.НомерДома КАК НомерДома,
	|	ВТ_Здания.Корпус КАК Корпус,
	|	ВТ_Здания.ПрефиксДома КАК ПрефиксДома,
	|	ВТ_Здания.Прочее КАК Прочее,
	|	ЕСТЬNULL(ВТ_КолВоКвартир.КолВоКвартир, 0) КАК КолВоКвартир
	|ИЗ
	|	ВТ_Здания КАК ВТ_Здания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ДопСвойства КАК ВТ_ДопСвойства
	|		ПО ВТ_Здания.Здание = ВТ_ДопСвойства.ОбъектУчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КолВоКвартир КАК ВТ_КолВоКвартир
	|		ПО ВТ_Здания.Здание = ВТ_КолВоКвартир.Здание";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	// Создание ОбъектаXDTO с типом СписокЗданий.
	ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "СписокЗданий");
	СписокЗданийXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
	
	
	Пока Выборка.Следующий() Цикл
		
		// Создание ОбъектаXDTO с типом Здание.
		ТипXDTO = ФабрикаXDTO.Тип("http://bit-jkh.ru/functional/" , "Здание");
		ЗданиеXDTO = ФабрикаXDTO.Создать(ТипXDTO); 
		
		ЗданиеXDTO.Идентификатор		= Строка(Выборка.Здание.УникальныйИдентификатор());
		Если ЗначениеЗаполнено(Выборка.НомерДома) Тогда
			ЗданиеXDTO.Номер = Строка(Выборка.НомерДома) + ?(ЗначениеЗаполнено(Выборка.Корпус), Выборка.Корпус, "") 
			+ ?(ЗначениеЗаполнено(Выборка.ПрефиксДома), Выборка.ПрефиксДома, "");
		КонецЕсли;
		
		ЗданиеXDTO.ГодПостройки			= Выборка.ГодПостройки;
		ЗданиеXDTO.Серия				= Выборка.Серия;
		ЗданиеXDTO.Этажность			= Выборка.КоличествоЭтажей;
		ЗданиеXDTO.КолВоКвартир			= Выборка.КолВоКвартир;
		ЗданиеXDTO.ОбщаяПлощадь			= Выборка.ОбщаяПлощадьЗдания;
		ЗданиеXDTO.ПлощадьЖилыхПомещений= Выборка.ОбщаяПлощадьЖилыхПомещений;
		ЗданиеXDTO.Адрес				= Выборка.АдресЗдания;
		ЗданиеXDTO.Прочее				= Выборка.Прочее;
		
		СписокЗданийXDTO.Здание.Добавить(ЗданиеXDTO);
		
	КонецЦикла;
	
	ЗаписатьФайлВыгрузки(СписокЗданийXDTO, ПараметрыОбмена, "building.xml");
	
КонецПроцедуры

Процедура ВыгрузитьКвартиры(ПараметрыОбмена) Экспорт	
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация"	, ПараметрыОбмена.Организация);
	Запрос.УстановитьПараметр("СписокУлиц"	, ПараметрыОбмена.СписокУлиц);
	Запрос.УстановитьПараметр("СписокЗданий", ПараметрыОбмена.СписокЗданий);
	Запрос.УстановитьПараметр("СписокЛС"	, ПараметрыОбмена.СписокЛС);
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.Организация) Тогда
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьОрганизации", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокУлиц)
		И ПараметрыОбмена.СписокУлиц.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьУлицы", Истина);
	КонецЕсли;

	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЗданий) 
		И ПараметрыОбмена.СписокЗданий.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЗдания", Истина);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПараметрыОбмена.СписокЛС) 
		И ПараметрыОбмена.СписокЛС.Количество() > 0 Тогда
		Запрос.УстановитьПараметр("НеПроверятьЛС", Ложь);
	Иначе
		Запрос.УстановитьПараметр("НеПроверятьЛС", Истина);
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_ЛицевыеСчета.Квартира КАК Квартира
	|ПОМЕСТИТЬ ВТ_ЛицевыеСчета
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|	И (&НеПроверятьЛС
	|			ИЛИ бит_ЛицевыеСчета.Ссылка В (&СписокЛС))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Квартира
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ЛицевыеСчета.Квартира КАК Квартира,
	|	бит_Квартиры.Наименование КАК Наименование,
	|	бит_СписокЗданий.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	бит_Квартиры.НомерКвартиры КАК НомерКвартиры,
	|	бит_Квартиры.УникальныйНомерГИСЖКХ КАК УникальныйНомерГИСЖКХ,
	|	бит_Квартиры.Подъезд КАК Подъезд,
	|	бит_Квартиры.КадастровыйНомер КАК КадастровыйНомер,
	|	бит_СписокЗданий.Улица КАК Улица,
	|	бит_СписокЗданий.Организация КАК Организация,
	|	бит_СписокЗданий.Ссылка КАК Здание,
	|	бит_Квартиры.ПодтвержденоПоставщиком КАК ПодтвержденоПоставщиком
	|ПОМЕСТИТЬ ВТ_Квартиры
	|ИЗ
	|	ВТ_ЛицевыеСчета КАК ВТ_ЛицевыеСчета
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	|		ПО ВТ_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|		ПО (бит_Квартиры.Владелец = бит_СписокЗданий.Ссылка)
	|ГДЕ
	|	НЕ бит_Квартиры.ПометкаУдаления
	|	И НЕ бит_СписокЗданий.ПометкаУдаления
	|	И (&НеПроверятьОрганизации
	|			ИЛИ бит_СписокЗданий.Организация В (&Организация))
	|	И (&НеПроверятьУлицы
	|			ИЛИ бит_СписокЗданий.Улица В (&СписокУлиц))
	|	И (&НеПроверятьЗдания
	|			ИЛИ бит_СписокЗданий.Ссылка В (&СписокЗданий))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ВТ_ЛицевыеСчета.Квартира,
	|	бит_Квартиры.Подъезд
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.Квартира КАК Квартира,
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь КАК ЖилаяПлощадь,
