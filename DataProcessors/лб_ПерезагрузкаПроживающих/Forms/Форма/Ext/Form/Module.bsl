	Д1 = ТекущаяДата();
	ЗаполнитьДатыРождения();	
	Д2 = ТекущаяДата();
	Сообщить("Заполнение дат - "+ (Д2-Д1)+" сек.");
	
	Д1 = ТекущаяДата();
	ПодобратьЖильцовПоФИО();
	Д2 = ТекущаяДата();
