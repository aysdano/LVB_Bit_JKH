//HD+
// Приводит переносы строк к Символ(13) для корректного отображения в Word при вставке через COM.
// Символ(10) (LF) и CRLF в Word отображаются как квадрат; Word ожидает Символ(13) как абзац.
//
Функция НормализоватьПереносыСтрокДляWord(СтрокаТекст)
	Если НЕ ЗначениеЗаполнено(СтрокаТекст) Тогда
		Возврат СтрокаТекст;
	КонецЕсли;
	СтрокаТекст = СтрЗаменить(СтрокаТекст, Символ(13) + Символ(10), Символ(13));
	СтрокаТекст = СтрЗаменить(СтрокаТекст, Символ(10), Символ(13));
	Возврат СтрокаТекст;
КонецФункции //HD-

//HD+
// Определяет, нужно ли склонять значение для указанного падежа при печати.
// Перечисления.HD_Падежи.КакЕсть и Именительный — значение подставляется без изменения.
//
Функция ПадежТребуетСклоненияДляПечати(Падеж)
	
	Если НЕ ЗначениеЗаполнено(Падеж) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Падеж = Перечисления.HD_Падежи.КакЕсть Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если Падеж = Перечисления.HD_Падежи.Именительный Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат Истина;
	
КонецФункции //HD-

//HD+
// Возвращает номер падежа для СклонениеПредставленийОбъектов.ПросклонятьФИО (1–6).
// КакЕсть и пустое значение — без склонения (1). Именительный — 1.
//
Функция ПолучитьНомерПадежаДляСклонения(Падеж)
	
	Если НЕ ПадежТребуетСклоненияДляПечати(Падеж) Тогда
		Возврат 1;
	КонецЕсли;
	
	Если Падеж = Перечисления.HD_Падежи.Родительный Тогда
		Возврат 2;
	ИначеЕсли Падеж = Перечисления.HD_Падежи.Дательный Тогда
		Возврат 3;
	ИначеЕсли Падеж = Перечисления.HD_Падежи.Винительный Тогда
		Возврат 4;
	ИначеЕсли Падеж = Перечисления.HD_Падежи.Творительный Тогда
		Возврат 5;
	ИначеЕсли Падеж = Перечисления.HD_Падежи.Предложный Тогда
		Возврат 6;
	КонецЕсли;
	
	Возврат 1;
	
КонецФункции //HD-

//HD+
// Приводит строковое описание типа параметра к унифицированному виду.
//
Функция НормализоватьТипПараметраПользовательскогоПараметра(Знач ИсходнаяСтрока)
	
	ТипПараметраСтрокой = СокрЛП(Строка(ИсходнаяСтрока));
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, Символ(9), "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, Символ(160), "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, Символ(13), "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, Символ(10), "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, """", "");
	ТипПараметраСтрокой = СтрЗаменить(ТипПараметраСтрокой, " ", "");
	
	Если НЕ ЗначениеЗаполнено(ТипПараметраСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	Если Лев(ВРег(ТипПараметраСтрокой), СтрДлина("СПРАВОЧНИКССЫЛКА.")) = "СПРАВОЧНИКССЫЛКА." Тогда
		Возврат "Справочник." + Сред(ТипПараметраСтрокой, СтрДлина("СправочникСсылка.") + 1);
	КонецЕсли;
	
	Если Лев(ВРег(ТипПараметраСтрокой), СтрДлина("СПРАВОЧНИК.")) = "СПРАВОЧНИК." Тогда
		Возврат "Справочник." + Сред(ТипПараметраСтрокой, СтрДлина("Справочник.") + 1);
	КонецЕсли;
	
	Если ВРег(ТипПараметраСтрокой) = "СТРОКА" Тогда
		Возврат "Строка";
	КонецЕсли;
	
	Если ВРег(ТипПараметраСтрокой) = "ЧИСЛО" Тогда
		Возврат "Число";
	КонецЕсли;
	
	Если ВРег(ТипПараметраСтрокой) = "ДАТА" Тогда
		Возврат "Дата";
	КонецЕсли;
	
	Возврат ТипПараметраСтрокой;
	
КонецФункции //HD-

//HD+
// Части составного ТипПараметра: «Справочник.бит_Проживающие,Строка» → массив нормализованных типов.
//
Функция ПолучитьЧастиТипаПользовательскогоПараметраДляПечати(Знач ТипПараметраСтрокой)
	
	МассивЧастей = Новый Массив;
	СыроеОписание = СокрЛП(Строка(ТипПараметраСтрокой));
	Если НЕ ЗначениеЗаполнено(СыроеОписание) Тогда
		Возврат МассивЧастей;
	КонецЕсли;
	
	Если СтрНайти(СыроеОписание, ",") = 0 Тогда
		НормализованнаяЧасть = НормализоватьТипПараметраПользовательскогоПараметра(СыроеОписание);
		Если ЗначениеЗаполнено(НормализованнаяЧасть) Тогда
			МассивЧастей.Добавить(НормализованнаяЧасть);
		КонецЕсли;
		Возврат МассивЧастей;
	КонецЕсли;
	
	Для Каждого ЧастьОписания Из СтрРазделить(СыроеОписание, ",", Ложь) Цикл
		НормализованнаяЧасть = НормализоватьТипПараметраПользовательскогоПараметра(ЧастьОписания);
		Если ЗначениеЗаполнено(НормализованнаяЧасть) Тогда
			МассивЧастей.Добавить(НормализованнаяЧасть);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЧастей;
	
КонецФункции //HD-

//HD+
// Строка для подстановки в печать по реквизиту ВладелецСчетаКР.
//
Функция ПредставлениеВладельцаСчетаКРДляПечати(Знач ЗначениеВладельца)
	
	Если НЕ ЗначениеЗаполнено(ЗначениеВладельца) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеВладельца) = Тип("СправочникСсылка.Организации") Тогда
		Возврат СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеВладельца, "НаименованиеСокращенное")));
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеВладельца) = Тип("СправочникСсылка.Контрагенты") Тогда
		Возврат СокрЛП(Строка(ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ЗначениеВладельца, "Наименование")));
	КонецЕсли;
	
	Возврат СокрЛП(Строка(ЗначениеВладельца));
	
КонецФункции //HD-

