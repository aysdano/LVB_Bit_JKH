функция ПолучитьСписокИзНачислений (табСписокСемейнойЛьготы)
	
  счетчик = 0;
  табВозврата = табСписокСемейнойЛьготы.Скопировать();	
  
  Пока (счетчик < табВозврата.Количество ()) Цикл
     стр = табВозврата.Получить (счетчик);    
      
  	 если ЕстьНачисленияПоЛьготе(стр.Льгота) = истина Тогда
    	 	 
		 счетчик = счетчик + 1;   
	 Иначе                       
	     табВозврата.Удалить(счетчик);
     КонецЕсли;
  КонецЦикла;
	
  возврат табВозврата;
  
