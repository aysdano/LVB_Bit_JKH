Функция ЭтоШаблонПлатежногоДокумента(Шаблон)  
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Шаблон, "ШаблонПлатежныхДокументов") = Истина Тогда
		Возврат Истина	
	КонецЕсли;
	
	Возврат Ложь;
	
КонецФункции

&НаКлиенте 
Функция НайтиПоследнююКолонку(Таблица)
	
	МаксимальноеЗначение = 0;
	
	Для Индекс = 0 По Таблица.Количество() - 1 Цикл
		Значение = Таблица[Индекс].СтраницаКолонка;
		
		Если МаксимальноеЗначение < Значение Тогда
			МаксимальноеЗначение = Значение;
		КонецЕсли;
	КонецЦикла;
	
	Возврат МаксимальноеЗначение;
	
КонецФункции

&НаКлиенте
Процедура ВсеДомаПриИзменении(Элемент)
	
	Если Объект.ВсеДома Тогда
		Объект.Нежилые = Ложь;
		Объект.Жилые = Ложь;
	Иначе
		Если НЕ Объект.Жилые И НЕ Объект.Нежилые Тогда
			Объект.ВсеДома = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура НежилыеПриИзменении(Элемент)
	
	Если Объект.Нежилые Тогда
		Объект.ВсеДома = Ложь;
		Объект.Жилые = Ложь;
	Иначе
		Если НЕ Объект.Жилые И НЕ Объект.ВсеДома Тогда
			Объект.Нежилые = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЖилыеПриИзменении(Элемент)
	
	Если Объект.Жилые Тогда
		Объект.Нежилые = Ложь;
		Объект.ВсеДома = Ложь;
	Иначе
		Если НЕ Объект.ВсеДома И НЕ Объект.Нежилые Тогда
			Объект.Жилые = Истина;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

