
#Область ПеременныеМодуля

&НаКлиенте 
Перем мКэшРеквизитовФормы;       // Хранит текущие значения реквизитов формы. Клиент.

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции // ПолучитьТипОбъекта()

#КонецОбласти

#Область ПроцедурыИФункцииДляУправленияВнешнимВидомФорм

// Процедура устнавливает заголовок формы документа.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УстановитьЗаголовокФормыДокумента()
	
	СтруктураЗаголовка = Новый Структура;
	СтруктураЗаголовка.Вставить("ПредставлениеОбъекта", мКэшЗначений.ПредставлениеОбъекта);
	СтруктураЗаголовка.Вставить("СтрокаВидаОперации"  , Строка(""));
	СтруктураЗаголовка.Вставить("ЭтоНовый"			  , Параметры.Ключ.Пустая());
	СтруктураЗаголовка.Вставить("ДокументПроведен"	  , Объект.Проведен);
	
	бит_РаботаСДиалогамиКлиент.УстановитьЗаголовокФормыДокумента(ЭтаФорма
	,СтруктураЗаголовка);
	
КонецПроцедуры

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаСервере 
Процедура УправлениеЭлементамиФормы()
	
	Если Объект.ВидОперации = Перечисления.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаОшибочныхПоказаний Тогда
		
		Элементы.Группа3.Видимость                                  = Ложь;
		Элементы.КорректировкаПоказанийЗаполнить.Доступность        = Истина;
		Элементы.КорректировкаПоказанийЗаполнить.Заголовок        	= "Рассчитать";
		Элементы.КорректировкаПоказанийЛицевойСчет.Доступность      = Истина;
		Элементы.КорректировкаПоказанийСчетчик.Доступность          = Истина;
		Элементы.КорректировкаПоказанийПериод.Доступность           = Истина;		
		Элементы.КорректировкаПоказанийНачисленияЗаПериод.Видимость = Истина;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаПодкрутки Тогда
		
		Элементы.Группа3.Видимость                                  = Истина;
		Элементы.КорректировкаПоказанийЗаполнить.Доступность        = Истина;		
		Элементы.КорректировкаПоказанийЗаполнить.Заголовок        	= "Заполнить";
		Элементы.КорректировкаПоказанийЛицевойСчет.Доступность      = Ложь;
		Элементы.КорректировкаПоказанийСчетчик.Доступность          = Ложь;
		Элементы.КорректировкаПоказанийПериод.Доступность           = Ложь;		
		Элементы.КорректировкаПоказанийНачисленияЗаПериод.Видимость = Истина;
		
	ИначеЕсли Объект.ВидОперации = Перечисления.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаНачальныхПоказаний Тогда
		
		Элементы.Группа3.Видимость                                  = Ложь;
		Элементы.КорректировкаПоказанийЗаполнить.Доступность        = Ложь;		
		Элементы.КорректировкаПоказанийЗаполнить.Заголовок        	= "Заполнить";
		Элементы.КорректировкаПоказанийЛицевойСчет.Доступность      = Истина;
		Элементы.КорректировкаПоказанийСчетчик.Доступность          = Истина;
		Элементы.КорректировкаПоказанийПериод.Доступность           = Истина;		
		Элементы.КорректировкаПоказанийНачисленияЗаПериод.Видимость = Ложь;
		
	КонецЕсли; 
	
	ЕстьРазовые = ?(Элементы.ВводРазовых.Заголовок = "Ввести разовые начисления.", Ложь, Истина);
	
	Элементы.КорректировкаПоказаний.ТолькоПросмотр = ЕстьРазовые;
	Элементы.Организация.ТолькоПросмотр            = ЕстьРазовые;
	Элементы.Дата.ТолькоПросмотр                   = ЕстьРазовые;
	Элементы.Номер.ТолькоПросмотр                  = ЕстьРазовые;
	Элементы.Улица.ТолькоПросмотр                  = ЕстьРазовые;
	Элементы.Здание.ТолькоПросмотр                 = ЕстьРазовые;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	Если Параметры.Свойство("ЗаполнитьИзСправочникаЛицевыеСчета") Тогда
		
		Объект.ВидОперации   = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ВидОперации;
		Объект.Дата          = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Дата;
		Объект.Организация   = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Организация;		
		Объект.Здание        = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Здание;
		Объект.Улица         = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Улица;		
		Объект.Ответственный = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Ответственный;
		
		Элементы.Организация.ТолькоПросмотр   = Истина;
		Элементы.Ответственный.ТолькоПросмотр = Истина;
		
		НоваяСтрока = Объект.КорректировкаПоказаний.Добавить();
		
		НоваяСтрока.ЛицевойСчет       = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ЛицевойСчет;
		НоваяСтрока.Счетчик           = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Счетчик;
		НоваяСтрока.Многотарифный     = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Многотарифный;
		НоваяСтрока.ИсточникПоказаний = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ИсточникПоказаний;
		
		Если НоваяСтрока.Многотарифный Тогда
			
			НоваяСтрока.Услуга = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Услуга;
			
			СтрокаУслуг = Объект.ТаблицаУслуг.Добавить();
			
			СтрокаУслуг.ЛицевойСчет = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ЛицевойСчет;
			СтрокаУслуг.Услуга      = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Услуга;
			
		Иначе
			
			ЗаполнитьТаблицуУслуг(НоваяСтрока.ЛицевойСчет, НоваяСтрока.Счетчик, КонецДня(Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.Дата));
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПолучитьРзовые();
	
	// Установить видимость реквизитов и заголовков колонок.	
	УправлениеЭлементамиФормы();
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(ДокументОбъект, Отказ);
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаПодкрутки") Тогда
		
		ЕстьПустыеСтроки = ПроверитьПустыеСтроки();
		
		Если ЕстьПустыеСтроки Тогда
			
			Отказ = Истина;
			
			Ответ = Неопределено;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("ПередЗаписьюЗавершение", ЭтотОбъект), "Удалить не измененные строки с корректировкой показаний равной нулю?", РежимДиалогаВопрос.ДаНетОтмена); 
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписьюЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Ответ = РезультатВопроса;
    
    Если Ответ = КодВозвратаДиалога.Да Тогда
        
        УдалитьПустыеСтроки();
		
		ЗаписатьНаСервере();
		
    ИначеЕсли Ответ = КодВозвратаДиалога.Нет Тогда 
        
		ЗаписатьНаСервере();
        
    КонецЕсли;

КонецПроцедуры

&НаСервере
Процедура ЗаписатьНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект,Тип("ДокументОбъект.бит_КорректировкаПоказанийСчетчиков"));
	
	Попытка
		ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	Исключение
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Не удалось записать" + ОписаниеОшибки();
		Сообщение.Сообщить();
		
	КонецПопытки;
	
	ЗначениеВДанныеФормы(ДокументОбъект,Объект);
	
КонецПроцедуры


&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	Если Объект.ВидОперации = Перечисления.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаОшибочныхПоказаний
		И НуженПерерасчет Тогда
		ЗаполнитьОшибочныеПоказанияНаСервере();
	КонецЕсли;
	
КонецПроцедуры


&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФорм

&НаКлиенте
Процедура Заполнить(Команда)
	
	ЭтаФорма.мМассивСтрок.Очистить();
	Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаОшибочныхПоказаний") Тогда
		Объект.ТаблицаУслуг.Очистить();
		Объект.КорректировкаПоказаний.Очистить();
		ЗаполнитьНаСервере();
		НуженПерерасчет = Истина;
	Иначе
		ЗаполнитьОшибочныеПоказанияНаСервере();
		НуженПерерасчет = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере 
Процедура ЗаполнитьОшибочныеПоказанияНаСервере()
	
	Объект.ТаблицаУслуг.Очистить();
	ТЗКорректировкаПоказаний = Объект.КорректировкаПоказаний.Выгрузить();
	ТЗНеМноготарифные = ТЗКорректировкаПоказаний.Скопировать(Новый Структура("Многотарифный", Ложь),"ЛицевойСчет, Счетчик");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"				, КонецДня(Объект.Дата));
	Запрос.УстановитьПараметр("Ссылка"				, Объект.Ссылка);
	Запрос.УстановитьПараметр("ТЗНеМноготарифные"	, ТЗНеМноготарифные);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ТЗНеМноготарифные.ЛицевойСчет КАК ЛицевойСчет,
	|	ТЗНеМноготарифные.Счетчик КАК Счетчик
	|ПОМЕСТИТЬ ВТ_ВсеСчетчики
	|ИЗ
	|	&ТЗНеМноготарифные КАК ТЗНеМноготарифные
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект КАК ЛицевойСчет,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга
	|ПОМЕСТИТЬ ВТ_ВсеУслуги
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			(ВЫРАЗИТЬ(Объект КАК Справочник.бит_ЛицевыеСчета), Счетчик) В
	|				(ВЫБРАТЬ
	|					ВТ_ВсеСчетчики.ЛицевойСчет,
	|					ВТ_ВсеСчетчики.Счетчик
	|				ИЗ
	|					ВТ_ВсеСчетчики)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ПоказанияСчетчиков.Период КАК Период,
	|	бит_ПоказанияСчетчиков.Объект КАК ЛицевойСчет,
	|	бит_ПоказанияСчетчиков.Счетчик КАК Счетчик,
	|	бит_ПоказанияСчетчиков.Услуга КАК Услуга,
	|	бит_ПоказанияСчетчиков.ПоследниеПоказания КАК ПоследниеПоказания
	|ПОМЕСТИТЬ ВТ_Показания
	|ИЗ
	|	РегистрНакопления.бит_ПоказанияСчетчиков КАК бит_ПоказанияСчетчиков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_ВсеУслуги КАК ВТ_ВсеУслуги
	|		ПО ((ВЫРАЗИТЬ(бит_ПоказанияСчетчиков.Объект КАК Справочник.бит_ЛицевыеСчета)) = ВТ_ВсеУслуги.ЛицевойСчет)
	|			И бит_ПоказанияСчетчиков.Счетчик = ВТ_ВсеУслуги.Счетчик
	|			И бит_ПоказанияСчетчиков.Услуга = ВТ_ВсеУслуги.Услуга
	|			И (бит_ПоказанияСчетчиков.Регистратор <> &Ссылка)
	|			И (бит_ПоказанияСчетчиков.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам)
	|			И (бит_ПоказанияСчетчиков.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход))
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Период,
	|	ЛицевойСчет,
	|	Счетчик,
	|	Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	МАКСИМУМ(ВТ_Показания.Период) КАК Период,
	|	ВТ_Показания.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_Показания.Счетчик КАК Счетчик,
	|	ВТ_Показания.Услуга КАК Услуга
	|ПОМЕСТИТЬ ВТ_ПоследниеПоказания
	|ИЗ
	|	ВТ_Показания КАК ВТ_Показания
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_Показания.ЛицевойСчет,
	|	ВТ_Показания.Счетчик,
	|	ВТ_Показания.Услуга
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Период,
	|	ЛицевойСчет,
	|	Счетчик,
	|	Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ВТ_ПоследниеПоказания.Период КАК Период,
	|	ВТ_ПоследниеПоказания.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ПоследниеПоказания.Счетчик КАК Счетчик,
	|	ВТ_ПоследниеПоказания.Услуга КАК Услуга,
	|	ВТ_Показания.ПоследниеПоказания КАК ПоследниеПоказания
	|ИЗ
	|	ВТ_ПоследниеПоказания КАК ВТ_ПоследниеПоказания
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Показания КАК ВТ_Показания
	|		ПО ВТ_ПоследниеПоказания.Период = ВТ_Показания.Период
	|			И ВТ_ПоследниеПоказания.ЛицевойСчет = ВТ_Показания.ЛицевойСчет
	|			И ВТ_ПоследниеПоказания.Услуга = ВТ_Показания.Услуга
	|			И ВТ_ПоследниеПоказания.Счетчик = ВТ_Показания.Счетчик";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		НоваяСтрока = Объект.ТаблицаУслуг.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
	КонецЦикла;
	
	Если НЕ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаНачальныхПоказаний") Тогда
		Для Каждого Стр Из Объект.КорректировкаПоказаний Цикл
			КолМесяцев = ?(Стр.ТипДокумента = Строка(Тип("ДокументСсылка.бит_УстановкаСчетчика")),0,1);
			Стр.НачисленияЗаПериод = ПолучитьНачисления(Стр.ЛицевойСчет, Стр.Счетчик, ДобавитьМесяц(Стр.ДатаОтПоказаний, КолМесяцев), Объект.Дата, Стр.Услуга, Стр.Многотарифный);
		КонецЦикла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВводРазовых(Команда)
	
	Если Элементы.ВводРазовых.Заголовок = "Ввести разовые начисления." Тогда   // Вводим разовые начисления.
		
		Если Объект.Ссылка.Пустая() ИЛИ НЕ Объект.Проведен Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Проведите документ!");
			
			Возврат;
			
		ИначеЕсли Объект.Проведен И ЭтаФорма.Модифицированность Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ был изменен, перепроведите документ!");
			
			Возврат;
			
		КонецЕсли;  
		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидОперацииКорректировкиПоказанийСчетчиков.КорректировкаОшибочныхПоказаний") Тогда
			ПоказатьВопрос(Новый ОписаниеОповещения("ВвестиРазовыеНачисленияЗавершение", ЭтотОбъект), "Выполнить перерасчет документа перед операцией?", РежимДиалогаВопрос.ДаНет); 
		Иначе
			ПараметрыФормы = Новый Структура;
			
			МассивНачислений = ПолучитьНачисленияНаСервере();
			
			СписокЛСАдресХран         = ПолучитьСписокКолонокТабличнойЧастиКорректировкаПоказаний();
			
			ПараметрыФормы.Вставить("МассивНачислений", МассивНачислений);
			ПараметрыФормы.Вставить("ВидОперации"     , ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков"));
			ПараметрыФормы.Вставить("Дата"            , Объект.Дата);
			
			ПараметрыФормы.Вставить("Ответственный"   , бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
			
			ПараметрыФормы.Вставить("Документ"        , Объект.Ссылка);
			
			ПараметрыФормы.Вставить("СписокЛСАдресХран"        , СписокЛСАдресХран);
			
			ОткрытьФорму("Документ.бит_РазовыеПоУслугамЖКХ.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков", ПараметрыФормы), ЭтаФорма);
			
			УправлениеЭлементамиФормы();
		КонецЕсли; 
		
	Иначе // Открываем разовые начисления.
		
		СтрокаНомера    = Сред(Элементы.ВводРазовых.Заголовок,11,11);
		ДокументРазовые = НайтиПоНомеруДокументРазовыеПоУслугамЖКХНаСервере(СтрокаНомера);
		
		ПоказатьЗначение(Новый ОписаниеОповещения("ВводРазовыхЗавершение", ЭтотОбъект), ДокументРазовые);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиРазовыеНачисленияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		ЗаполнитьОшибочныеПоказанияНаСервере();
		НуженПерерасчет = Ложь;
		ЗаписатьНаСервере();
    КонецЕсли;	
	
	МассивНачислений	= ПолучитьНачисленияНаСервере();
	СписокЛСАдресХран	= ПолучитьСписокКолонокТабличнойЧастиКорректировкаПоказаний();
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("МассивНачислений"	, МассивНачислений);
	ПараметрыФормы.Вставить("ВидОперации"		, ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.КорректировкаПоказанийСчетчиков"));
	ПараметрыФормы.Вставить("Дата"				, Объект.Дата);
	ПараметрыФормы.Вставить("Ответственный"		, бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	ПараметрыФормы.Вставить("Документ"			, Объект.Ссылка);
	ПараметрыФормы.Вставить("СписокЛСАдресХран"	, СписокЛСАдресХран);
	ОткрытьФорму("Документ.бит_РазовыеПоУслугамЖКХ.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаКорректировкаПоказанийСчетчиков", ПараметрыФормы), ЭтаФорма);
	
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

&НаКлиенте
Процедура ВводРазовыхЗавершение(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура Обновить(Команда)
	
	ПолучитьРзовые();
	УправлениеЭлементамиФормы();
	
КонецПроцедуры

#КонецОбласти

