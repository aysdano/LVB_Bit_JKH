			ШапкаОбласть.Параметры.СерияДокумента =    ВыборкаСН.СерияДокумента;
			ШапкаОбласть.Параметры.НомерДокумента = 	ВыборкаСН.НомерДокумента;
			
			ШапкаОбласть.Параметры.ДеньВыдачиДокумента  = Формат(ВыборкаСН.ДатаВыдачиДокумента,"ДФ='дд'");
			ДатаМесяц 							 = Формат(ВыборкаСН.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцВыдачиДокумента = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодВыдачиДокумента   = Формат(ВыборкаСН.ДатаВыдачиДокумента,"ДФ='yyyy'");
			
			
			ВыданДокумент_1 = "";
			ВыданДокумент_2 = "";
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ВыборкаСН.ВыданДокумент, 50, ВыданДокумент_1 , ВыданДокумент_2 );
			
			ШапкаОбласть.Параметры.ВыданДокумент_1 =  ВыданДокумент_1;
			ШапкаОбласть.Параметры.ВыданДокумент_2 =  ВыданДокумент_2;
			
			ШапкаОбласть.Параметры.ДокументКодПодразделения =   ВыборкаСН.ДокументКодПодразделения;
			
			
			ТабДокумент.Вывести(ШапкаОбласть);
		КонецЦикла;	
	КонецЕсли;
	
	Возврат ТабДокумент;
	
КонецФункции

