Процедура СпособРасчетаОкончаниеВводаТекста(Элемент, Текст, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	мКэшЗначений.мСпособРасчета = СпособРасчета;
	
	бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ввод по строке не доступен. Воспользуйтесь кнопкой выбора элемента.");
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоля

&НаКлиенте
Процедура ЛицевыеСчетаПриАктивизацииСтроки(Элемент)
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		Если ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления")
			Или ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")
			Или ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет") Тогда
			
			Элементы.ЛицевыеСчетаКоличествоЕдиницПотребления.ТолькоПросмотр = Ложь;
			
		Иначе
			
			Элементы.ЛицевыеСчетаКоличествоЕдиницПотребления.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
		Если ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")
			Или ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоРаспределению") Тогда
			
			Элементы.ЛицевыеСчетаСпособРасчета.ТолькоПросмотр = Истина;
			
		Иначе
			
			Элементы.ЛицевыеСчетаСпособРасчета.ТолькоПросмотр = Ложь;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаПриАктивизацииЯчейки(Элемент)
	
	ТекДанные = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если Элемент.ТекущийЭлемент.Имя = "ЛицевыеСчетаКоличествоЕдиницПотребления" Тогда
		
		Если ТекДанные.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления") 
			Или ТекДанные.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")
			Или ТекДанные.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет") Тогда
			
			Элемент.ТекущийЭлемент.ТолькоПросмотр = Ложь;
			
		Иначе
			
			Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если НоваяСтрока 
		И Не Копирование Тогда
		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета") Тогда
			
			РеквизитУслуга = Объект.Услуга;
			
		Иначе
			
			РеквизитУслуга = ТекущаяСтрока.Услуга;
			
		КонецЕсли;
		
		ТекущаяСтрока.РежимПотребления 	= ПолучитьОсновнойРежимПотребленияУслугиНаСервере(РеквизитУслуга);
		ТекущаяСтрока.СпособРасчета 	= ПолучитьОсновнойСпособРасчетаУслугиНаСервере(РеквизитУслуга);
		
		Если ТекущаяСтрока.НомерСтроки > 1 Тогда
			
			ТекущаяСтрока.Поставщик = ПолучитьПоставщикаЛицевогоСчетаНаСервере(ТекущаяСтрока.НомерСтроки);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаУслугаПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	СведенияПоУслуге = ЗаполнитьСведенияПоУслуге(Объект.Дата,
	?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет"),
	Объект.ЛицевойСчет,
	ТекущаяСтрока.ЛицевойСчет),
	?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета"),
	Объект.Услуга,
	ТекущаяСтрока.Услуга));
	
	ТекущаяСтрока.РежимПотребления            = СведенияПоУслуге.РежимПотребления;
	ТекущаяСтрока.Поставщик                   = СведенияПоУслуге.Поставщик;
	ТекущаяСтрока.СпособРасчета               = СведенияПоУслуге.СпособРасчета;
	ТекущаяСтрока.КоличествоЕдиницПотребления = СведенияПоУслуге.КоличествоЕдиницПотребления;
	
	Элементы.ЛицевыеСчета.ЗакончитьРедактированиеСтроки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаУслугаНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ОткрытьФормуВыбораУслуги(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаУслугаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("Услуга", ВыбранноеЗначение); 
	
	НайденнаяСтрока = Объект.ЛицевыеСчета.НайтиСтроки(Отбор);
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если НайденнаяСтрока.Количество() > 0 
		И НайденнаяСтрока[0] <> ТекущаяСтрока Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Выбранное значение уже подобрано!");
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаЛицевойСчетПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	СведенияПоУслуге = ЗаполнитьСведенияПоУслуге(Объект.Дата,
	?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугНаЛицевойСчет"),
	Объект.ЛицевойСчет,
	ТекущаяСтрока.ЛицевойСчет),
	?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета"),
	Объект.Услуга,
	ТекущаяСтрока.Услуга));
	
	ТекущаяСтрока.РежимПотребления            = СведенияПоУслуге.РежимПотребления;
	ТекущаяСтрока.Поставщик                   = СведенияПоУслуге.Поставщик;
	ТекущаяСтрока.СпособРасчета               = СведенияПоУслуге.СпособРасчета;
	ТекущаяСтрока.КоличествоЕдиницПотребления = СведенияПоУслуге.КоличествоЕдиницПотребления;
	
	Элементы.ЛицевыеСчета.ЗакончитьРедактированиеСтроки(Ложь);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	Если НЕ ЗначениеЗаполнено(Объект.Услуга) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Укажите услугу.");
				
		СтандартнаяОбработка = Ложь;
		
		Возврат;
		
	КонецЕсли; 
	
	ОткрытьФормуВыбораЛицевогоСчета(Элемент, СтандартнаяОбработка);
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("ЛицевойСчет", ВыбранноеЗначение); 
	
	НайденнаяСтрока = Объект.ЛицевыеСчета.НайтиСтроки(Отбор);
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если НайденнаяСтрока.Количество() > 0 
		И НайденнаяСтрока[0] <> ТекущаяСтрока Тогда
		
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
	Если ПроверитьУслугуНаЗдании(КонецДня(Объект.Дата), ПолучитьЗданиеЛицевогоСчетаНаСервере(ВыбранноеЗначение), Объект.Услуга) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Услуга :" + Объект.Услуга + " не подключена по адресу лицевого счета: " + ВыбранноеЗначение + " ул. " + ПолучитьУлицаЛицевогоСчетаЛицевогоСчетаНаСервере(ВыбранноеЗначение) + ", д." + ПолучитьЗданиеЛицевогоСчетаНаСервере(ВыбранноеЗначение));
		СтандартнаяОбработка = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаПоставщикПриИзменении(Элемент)
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если НЕ ЗначениеЗаполнено(ТекущаяСтрока.Поставщик) Тогда
		
		ТекущаяСтрока.Поставщик = мКэшЗначений.мПоставщик;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевыеСчетаПоставщикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.ЛицевыеСчета.ТекущиеДанные;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийУстановкаИзменениеУслугПоЛС.НазначениеУслугиНаЛицевыеСчета") Тогда
		
		РеквизитУслуга = Объект.Услуга;
		
	Иначе
		
		РеквизитУслуга = ТекущаяСтрока.Услуга;
		
	КонецЕсли;
	
	ОткрытьФормуВыбораПоставщика(Элемент, РеквизитУслуга, СтандартнаяОбработка, ТекущаяСтрока.Поставщик);
	
КонецПроцедуры

