&НаСервере
Процедура IDНасервере()
	
	СправочникОбъект = ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.бит_ШаблоныИзвещений"));
	
	бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Идентификатор: " + СправочникОбъект.Идентификатор);
	
КонецПроцедуры	

&НаСервере
Функция ПолучитьСписокТиповНаСервере()
	
	СправочникОбъект = ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.бит_ШаблоныИзвещений"));
	
	МассивТипов = СправочникОбъект.Метаданные().ТабличныеЧасти.Услуги.Реквизиты.Услуга.Тип.Типы();	
	
	СписокТипов = Новый СписокЗначений;
	Для каждого ЭлементМассива Из МассивТипов Цикл
		
		ПустоеЗначение = Новый(ЭлементМассива);
		ОбъектОписанияМетаданных = ПустоеЗначение.Метаданные();
		СписокТипов.Добавить(ОбъектОписанияМетаданных.Имя, ОбъектОписанияМетаданных.Представление());
		
	КонецЦикла; 
	
	Возврат  СписокТипов;
	
КонецФункции	

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Настройка фильтра автоподбора и быстрого выбора
	Если Объект.Ссылка = Справочники.бит_ШаблоныИзвещений.КапитальныйРемонт Тогда
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ГрафаОтчетаГЦЖС", Перечисления.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт);
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НовыйПараметр);
		НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		Элементы.УслугиУслуга.ПараметрыВыбора = НовыеПараметры;
		
	ИначеЕсли Объект.Ссылка = Справочники.бит_ШаблоныИзвещений.БезКапитальногоРемонта Тогда	
		НовыйПараметр = Новый ПараметрВыбора("Отбор.ГрафаОтчетаГЦЖС", ПолучитьСписокГЦЖС());
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НовыйПараметр);
		НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		Элементы.УслугиУслуга.ПараметрыВыбора = НовыеПараметры;
	КонецЕсли;
	
КонецПроцедуры
