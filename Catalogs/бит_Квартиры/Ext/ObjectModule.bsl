#Область ЭкспортныеПроцедурыИФункции

// БИТ_ЖКХ Процедура формирует наименование элемента
//
Процедура СформироватьНаименование() Экспорт
	
	Если ЗначениеЗаполнено(НомерКвартиры) тогда
		Наименование = Строка(НомерКвартиры) + Строка(ПрефиксКвартиры);
	Иначе
		Наименование = Строка(ПрефиксКвартиры);
	КонецЕсли;	
	бит_НомерКвартирыДляСортировки = ПолучитьНомерИзСтроки(НомерКвартиры);
КонецПроцедуры // СформироватьНаименование() 

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

Функция ПолучитьНомерИзСтроки(Строка)
	СтрокаЧисла = "";
	КоличествоСимволов = СтрДлина(СокрЛП(Строка));
	Для Порядок = 1 По КоличествоСимволов Цикл
		Символ = Сред(Строка, Порядок, 1);
		Если НЕ СтрНайти("0123456789", Символ) = 0 Тогда
			СтрокаЧисла = СтрокаЧисла + Символ;
		Иначе
			Прервать;
		КонецЕсли;
	КонецЦикла;      
	
	Возврат Число(СтрокаЧисла);
	
КонецФункции

// Проверяет уникальность квартиры
Процедура ПроверитьУникальностьКвартиры(Отказ) Экспорт 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_Квартиры.Ссылка
	|ИЗ
	|	Справочник.бит_Квартиры КАК бит_Квартиры
	|ГДЕ
	|	бит_Квартиры.Наименование = &Наименование
	|	И бит_Квартиры.Владелец = &Владелец
	|	И бит_Квартиры.Ссылка <> &Ссылка";
	
	Запрос.УстановитьПараметр("Наименование",Наименование);
	Запрос.УстановитьПараметр("Владелец",Владелец);
	Запрос.УстановитьПараметр("Ссылка",Ссылка);
	
	//Если Не Запрос.Выполнить().Пустой() тогда
	//	бит_ОбщегоНазначения.СообщитьОбОшибке("Введенный номер квартиры уже существует!",Отказ,,СтатусСообщения.Важное);
	//КонецЕсли;
	
КонецПроцедуры	

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Проверяем на заполнение обязательные реквизиты
//
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	СформироватьНаименование();
	
	Если Не ЭтоНовый() И Не ПометкаУдаления=Ссылка.ПометкаУдаления Тогда
		// В случае установки или снятия пометки удаления не производить проверку
		Возврат;
	КонецЕсли;
	
	// Укажем, что надо проверить:
	СтруктураРеквизитов = Новый Структура();
	// СтруктураРеквизитов.Вставить("Наименование");
	Если НЕ ПрефиксКвартиры = "-" тогда
		СтруктураРеквизитов.Вставить("НомерКвартиры");	
	КонецЕсли;	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураРеквизитов, Отказ, "Проверка заполнения обязательных реквизитов элемента справочника ""Квартиры"".");
	Если Не ЗначениеЗаполнено(НомерКвартиры) И НЕ ПрефиксКвартиры = "-"  тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Если в доме нет квартиры, то в префиксе нужно проставить прочерк.");
		
	КонецЕсли;	
	Если Не Отказ тогда
		ПроверитьУникальностьКвартиры(Отказ);
	КонецЕсли;
	
	//// БИТ_ЖКХ 05.07.2016 14:47:12 Начало правки... Не востребовано.
	//ПроверкаКоличестваКомнат();
	//// БИТ_ЖКХ 05.07.2016 14:47:12 Конец правки.
	
КонецПроцедуры

