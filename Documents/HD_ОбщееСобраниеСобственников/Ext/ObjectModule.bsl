// Получает строковое представление формы проведения собрания
// Возвращает:
//  Строка - "Очное", "Заочное" или "Очно-заочное"
//
Функция ПолучитьФормаПроведенияСобрания()
	
	Если НЕ ЗначениеЗаполнено(ФормаПроведения) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ТипЗнч(ФормаПроведения) = Тип("ПеречислениеСсылка.бит_ФормыСобраний") Тогда
		
		Если ФормаПроведения = Перечисления.бит_ФормыСобраний.Очная Тогда
			Возврат "Очное";
		ИначеЕсли ФормаПроведения = Перечисления.бит_ФормыСобраний.Заочная Тогда
			Возврат "Заочное";
		Иначе
			// Проверяем, есть ли значение ОчноЗаочная (может быть добавлено в расширении)
			Попытка
				Если ФормаПроведения = Перечисления.бит_ФормыСобраний.ОчноЗаочная Тогда
					Возврат "Очно-заочное";
				КонецЕсли;
			Исключение
				// Если значения нет, возвращаем пустую строку
			КонецПопытки;
		КонецЕсли;
		
	КонецЕсли;
	
	Возврат "";

