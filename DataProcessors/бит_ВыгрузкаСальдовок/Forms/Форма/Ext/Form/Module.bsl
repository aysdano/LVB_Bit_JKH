Функция ПолучитьБлагоустройствоЗдания(Ссылка, Период)
	
	БлагоустройствоЗдания = "";
	
	Запрос = новый запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	РС.Значение КАК Значение,
		|	бит_СвойстваОбъектовУчета.Ссылка КАК ВидСвойства
		|ИЗ
		|	ПланВидовХарактеристик.бит_СвойстваОбъектовУчета КАК бит_СвойстваОбъектовУчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЗначенияСвойствОбъектовУчетаПериодические.СрезПоследних(
		|				&Период,
		|				ОбъектУчета = &Ссылка
		|					И ВидСвойства = &ВидСвойства) КАК РС
		|		ПО (РС.ВидСвойства = бит_СвойстваОбъектовУчета.Ссылка)
		|ГДЕ
		|	бит_СвойстваОбъектовУчета.Ссылка = &ВидСвойства";
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	Запрос.УстановитьПараметр("ВидСвойства", ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.НайтиПоНаименованию("Степень благоустройства"));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() > 0 Тогда
	   Выборка.Следующий();
	   БлагоустройствоЗдания = Выборка.Значение;
	КонецЕсли;
	
	Возврат БлагоустройствоЗдания
	
