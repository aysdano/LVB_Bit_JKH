&НаКлиенте
Процедура КомнатыКвартирыПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	Основание = Новый Структура;
	
	Основание.Вставить("Владелец", Объект.Ссылка);
	
	Если Копирование Тогда
		
		ТекДанные = Элементы.КомнатыКвартиры.ТекущиеДанные;
		
		Если НЕ ТекДанные = Неопределено Тогда
			
			НомерКомнаты    = ПолучитьКвартираНомерКомнатыНаСервере(ТекДанные.Ссылка);
			ЧастьПомещения  = ПолучитьКвартираЧастьПомещенияНаСервере(ТекДанные.Ссылка);
			НаименованиеКом = ПолучитьКвартираНаименованиеНаСервере(ТекДанные.Ссылка);
			
			Основание.Вставить("НомерКомнаты"  , НомерКомнаты);
			Основание.Вставить("ЧастьПомещения", ЧастьПомещения);
			Основание.Вставить("Наименование"  , НаименованиеКом);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура("Основание, НаДату", Основание, НаДату);
	
	ОткрытьФорму("Справочник.бит_Комнаты.Форма.ФормаЭлементаУправляемая", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура КомнатыКвартирыПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.КомнатыКвартиры.ТекущиеДанные;
	
	Если ТекущиеДанные.НомерКартинки = 1 Тогда
		
		Ответ = Неопределено;
		
		
		ПоказатьВопрос(Новый ОписаниеОповещения("КомнатыКвартирыПередУдалениемЗавершение1", ЭтотОбъект, Новый Структура("ТекущиеДанные", ТекущиеДанные)), "Пометить элемент на удаление?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ПоказатьВопрос(Новый ОписаниеОповещения("КомнатыКвартирыПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("Ответ, ТекущиеДанные", Ответ, ТекущиеДанные)), "Снять с элемента пометку на удаление?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура КомнатыКвартирыПередУдалениемЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Результат = ПометитьКомнатуНаУдалениеНаСервере(ТекущиеДанные.Ссылка);
		
		Если Результат Тогда
			
			ТекущиеДанные.НомерКартинки = 2;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

