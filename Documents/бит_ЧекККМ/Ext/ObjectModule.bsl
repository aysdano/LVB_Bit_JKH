#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

Процедура ПриЗаписи(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Заголовок = "Запись документа: " + СокрЛП(Ссылка);
	
	ПроверитьЗаполнениеШапки(Отказ, Заголовок);
	
КонецПроцедуры

Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Заголовок = "Проведение документа: " + СокрЛП(Ссылка);
	
	ПроверитьЗаполнениеШапки(Отказ, Заголовок);
	
	ПроверкаРеквизитовПлатежа(Отказ, Заголовок);
	
	Если НЕ Отказ Тогда
		
		ДвижениеДокументаПоРегистрам();
		
	КонецЕсли; 
	
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	Заголовок = "Запись документа: " + СокрЛП(Ссылка);
	
	Если ЭтоНовый() Тогда
		
		ДатаБезВремени = НачалоДня(ТекущаяДата());
		
		Если ДатаБезВремени = Дата Тогда
			
			Дата = ТекущаяДата();
			
		КонецЕсли;		
		
	КонецЕсли;
	
	ПроверкаРеквизитовПлатежа(Отказ, Заголовок);
	
	//АПК пункт 4 https://its.1c.ru/db/v8std/content/737/hdoc
	Если ЭтотОбъект.ЧекПробитНаККМ 
		И ЭтотОбъект.ПометкаУдаления
		И НЕ РольДоступна("бит_ПраваНаУдалениеЧеков") Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = НСтр("ru='Чек пробит на кассе. Установка пометки на удаление невозможна.'");
		Сообщение.УстановитьДанные(ЭтотОбъект);
		Сообщение.Сообщить();
		
		Отказ = Истина;
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	ЧекПробитНаККМ = Ложь;
	ВидОперации    = Перечисления.бит_ВидыОперацийЧекККМ.Продажа;		
	КодПачки       = "" + Касса.КодКассы + "" + Формат(День(Дата), "ЧЦ=2; ЧВН=") + "" + Формат(Месяц(Дата), "ЧЦ=2; ЧВН=");
	КодКассы       = Касса.КодКассы;
	Организация    = Касса.Владелец;
	
КонецПроцедуры

//27.12.2018

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
  ПараметрыЖКХ = Новый Структура;
  ПараметрыЖКХ.Вставить("РасчетСУчетомДолейВладения"								, Ложь);
  ПараметрыЖКХ.Вставить("УменьшениеНормыЛьготыВПределахФакта"						, Ложь);
  ПараметрыЖКХ.Вставить("ЛьготаПерсонифицированная"								, Ложь);
  ПараметрыЖКХ.Вставить("НачислениеСУчетомДнейПроживания"							, Ложь);
  ПараметрыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика"	, Ложь);
  ПараметрыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
  ПараметрыЖКХ.Вставить("НачислятьПениСУчетомПереплаты"							, Ложь);
  ПараметрыЖКХ.Вставить("ВариантРасчетаНДС"										, Ложь);
	
  бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(ЭтотОбъект.Дата),  ЭтотОбъект.Организация, ПараметрыЖКХ);	
  
  если ПараметрыЖКХ.ВариантРасчетаНДС = Перечисления.ВариантыРасчетаНДС.ДокументБезНДС тогда
	  
    МассивНепроверяемыхРеквизитов = Новый Массив();
    МассивНепроверяемыхРеквизитов.Добавить("Услуги.СтавкаНДС"); 
    УдалитьНепроверяемыеРеквизитыИзМассива(ПроверяемыеРеквизиты, МассивНепроверяемыхРеквизитов);
	
  конецесли;	
КонецПроцедуры


Процедура УдалитьНепроверяемыеРеквизитыИзМассива(МассивРеквизитов, МассивНепроверяемыхРеквизитов) Экспорт

  Для Каждого ЭлементМассива Из МассивНепроверяемыхРеквизитов Цикл
 
    // перед удалением реквизита из массива необходимо проверить, что он там есть
    // (не был удален ранее платформой или в коде).
    ПорядковыйНомер = МассивРеквизитов.Найти(ЭлементМассива);
    Если ПорядковыйНомер <> Неопределено Тогда
      МассивРеквизитов.Удалить(ПорядковыйНомер);
    КонецЕсли;
 
  КонецЦикла;
 
КонецПроцедуры


#КонецОбласти

#КонецЕсли