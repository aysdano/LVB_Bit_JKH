&НаСервере
Процедура ВсеНаСервере()
	запрос = новый запрос;
	запрос.Текст = "ВЫБРАТЬ
	               |	бит_УслугиЖКХ.Ссылка КАК Услуга,
	               |	бит_УслугиЖКХ.ПометкаУдаления КАК ПометкаУдаления
	               |ИЗ
	               |	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	               |ГДЕ
	               |	бит_УслугиЖКХ.ПометкаУдаления = ложь";
	
	списокУслуг = запрос.Выполнить().Выгрузить();
	
	списокСтавокУслуг = Объект.ТаблицаУслуг.Выгрузить();
	Объект.ТаблицаУслуг.Очистить();
	для каждого стр из списокУслуг цикл
		НоваяСтрока = Объект.ТаблицаУслуг.Добавить();
				
		НоваяСтрока.Услуга = стр.Услуга;
		НоваяСтрока.Начислять = НачислятьСтавку(списокСтавокУслуг, стр.Услуга);
		
		если НоваяСтрока.Начислять = истина тогда
		 ставкаПроцент = ПолучитьСтавкуРефинансирования(Объект.Дата, Объект.ПериодНачисления);  	
		 НоваяСтрока.Процент = ставкаПроцент.Процент;
		 НоваяСтрока.Ставка = ставкаПроцент.Ставка;
	    конецесли;
	 
	конеццикла;	
КонецПроцедуры

&НаСервере
функция НачислятьСтавку(списокСтавокУслуг, Услуга)
	
 Отбор = Новый Структура();
 Отбор.Вставить("Услуга", Услуга);
 строкиУслуг = списокСтавокУслуг.НайтиСтроки(Отбор);  	
 
 если строкиУслуг.Количество() > 0 тогда
  возврат строкиУслуг[0].Начислять;
 конецесли;

 возврат ложь;	
КонецФункции	

