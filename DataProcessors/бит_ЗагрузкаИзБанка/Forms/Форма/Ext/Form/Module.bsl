&НаКлиенте
Процедура ВыполнитьНастройкуКлиентБанкаЗавершение(РезультатЗакрытия, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(РезультатЗакрытия) = Тип("Структура") Тогда
		
		ГруппаДляНовыхКонтрагентов                     = РезультатЗакрытия.ГруппаДляНовыхКонтрагентов;
		СтатьяДДССписаниеСРасчетногоСчета              = РезультатЗакрытия.СтатьяДДССписаниеСРасчетногоСчета;
		СтатьяДДСПоступлениеНаРасчетныйСчет            = РезультатЗакрытия.СтатьяДДСПоступлениеНаРасчетныйСчет;
		ПроводитьПриЗагрузкеСписаниеСРасчетногоСчета   = РезультатЗакрытия.ПроводитьПриЗагрузкеСписаниеСРасчетногоСчета;
		ПроводитьПриЗагрузкеПоступлениеНаРасчетныйСчет = РезультатЗакрытия.ПроводитьПриЗагрузкеПоступлениеНаРасчетныйСчет;
		
		НайденнаяСтрока = НастройкаЗаполнения.НайтиСтроки(Новый Структура("Документ", "Поступление на расчетный счет"));
		НайденнаяСтрока[0].Проводить = ПроводитьПриЗагрузкеПоступлениеНаРасчетныйСчет;
		НайденнаяСтрока[0].СтатьяДДС = СтатьяДДСПоступлениеНаРасчетныйСчет;
		
		НайденнаяСтрока = НастройкаЗаполнения.НайтиСтроки(Новый Структура("Документ", "Списание с расчетного счета"));
		НайденнаяСтрока[0].Проводить = ПроводитьПриЗагрузкеСписаниеСРасчетногоСчета;
		НайденнаяСтрока[0].СтатьяДДС = СтатьяДДССписаниеСРасчетногоСчета;
		
		ЗаполнитьЗначенияСвойств(Объект, РезультатЗакрытия);
		
		ТребуетсяПовторноеЧтениеФайла = РезультатЗакрытия.КритическоеИзменение;
		НастройкаВыполнена            = Истина;
		
		ОбновитьСпискиДокументов(Истина, ТребуетсяПовторноеЧтениеФайла);
		УправлениеФормой();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВопросВыполнитьНастройкуЗавершение(Ответ, ВызваноИзПриОткрытии) Экспорт
	
	Если Ответ <> КодВозвратаДиалога.Да Тогда
		Возврат;
	КонецЕсли;
	
	ВыполнитьНастройкуКлиентБанка();
	
	Если ВызваноИзПриОткрытии
		И ВозможностьВыбораФайлов
		И Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаЗагрузка
		И НастройкаВыполнена
		И НЕ ПустаяСтрока(Объект.ФайлЗагрузки) Тогда
		
		ПрочитатьДанныеИзФайла(Ложь);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПомещениеФайлаЗавершение(Результат, АдресФайлаПомещенный, ВыбранноеИмяФайла, ДополнительныеПараметры) Экспорт
	
	АдресФайла = АдресФайлаПомещенный;
	
	Если АдресФайла = Неопределено Тогда
		Если НЕ ВозможностьВыбораФайлов И ЗначениеЗаполнено(ДополнительныеПараметры.АдресФайлаСтарый) Тогда
			АдресФайла = ДополнительныеПараметры.АдресФайлаСтарый;
		КонецЕсли;
		
		Возврат;
	КонецЕсли;
	
	// Передаем на сервер.
	ПрочитатьФайл(ДополнительныеПараметры.ВыводитьСообщения, ДополнительныеПараметры.ТребуетсяПовторноеЧтениеФайла);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыКИмпортуИсточникОплатыПриИзменении(Элемент)
	
	СтрокаДокумента = Элементы.ДокументыКИмпорту.ТекущиеДанные;
	
	Если ЗначениеЗаполнено(СтрокаДокумента.ИсточникОплаты) Тогда
		
		СтрокаДокумента.ОписаниеОшибокИО = "";
		
	Иначе
		СтрокаДокумента.ОписаниеОшибокИО = "Не заполнен источник оплаты";
		
	КонецЕсли;	
	
	Если НЕ БылВопрос И НЕ Элемент.ТекстРедактирования = "" И ПроверитьПустыеИО() Тогда
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ДокументыКИмпортуИсточникОплатыПриИзмененииЗавершение", ЭтотОбъект), "Установить текущий ИО: """+ Элемент.ТекстРедактирования +""" для всех не назначеных?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли; 
	
	ПодключитьОбработчикОжидания("Подключаемый_ВывестиСтатусЗагрузки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыКИмпортуИсточникОплатыПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		БылВопрос = Истина;
		
		Возврат;
	Иначе
		
		Для каждого Строка Из ДокументыКИмпорту Цикл
			
			Если НЕ ЗначениеЗаполнено(Строка.ИсточникОплаты) Тогда
				
				Строка.ИсточникОплаты = Элементы.ДокументыКИмпорту.ТекущиеДанные.ИсточникОплаты;	
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Строка.ИсточникОплаты) Тогда
				
				Строка.ОписаниеОшибокИО = "";
				
			КонецЕсли;	
			
		КонецЦикла; 
		
		ДанныеСтроки = Элементы.ДокументыКИмпорту.ТекущиеДанные;
		Если ДанныеСтроки <> Неопределено Тогда
			Если ЗначениеЗаполнено(ДанныеСтроки.ОписаниеОшибокЛС) ИЛИ ЗначениеЗаполнено(ДанныеСтроки.ОписаниеОшибокСумма)
				ИЛИ  ЗначениеЗаполнено(ДанныеСтроки.ОписаниеОшибокШИ) ИЛИ ЗначениеЗаполнено(ДанныеСтроки.ОписаниеОшибокИО)   Тогда
				Элементы.СтатуснаяСтрокаПриЗагрузке.Заголовок = "Ошибка: "+ДанныеСтроки.ОписаниеОшибокЛС+" "+ДанныеСтроки.ОписаниеОшибокСумма+" "+ДанныеСтроки.ОписаниеОшибокШИ+" "+ДанныеСтроки.ОписаниеОшибокИО;
			ИначеЕсли ЗначениеЗаполнено(ДанныеСтроки.Документ) Тогда
				
				Элементы.СтатуснаяСтрокаПриЗагрузке.Заголовок = "Найденый документ готов к перезаписи!";
				
			Иначе
				Элементы.СтатуснаяСтрокаПриЗагрузке.Заголовок = "Документ готов к загрузке!";
				
			КонецЕсли;
		Иначе
			Возврат;
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыКИмпортуШаблонИзвещенийПриИзменении(Элемент)
	
	Если НЕ БылВопросШаблоны И НЕ Элемент.ТекстРедактирования = "" Тогда
		ТекстВопроса = СтрШаблон(
							НСтр("ru = 'Установить текущий шаблон извещений: ""%1"" для всех?'"),
							Элемент.ТекстРедактирования);
		ПоказатьВопрос(Новый ОписаниеОповещения("ДокументыКИмпортуШаблонИзвещенийПриИзмененииЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли; 
	ПодключитьОбработчикОжидания("Подключаемый_ВывестиСтатусЗагрузки", 0.1, Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура ДокументыКИмпортуШаблонИзвещенийПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		БылВопросШаблоны = Истина;
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из ДокументыКИмпорту Цикл
		Строка.ШаблонИзвещений = Элементы.ДокументыКИмпорту.ТекущиеДанные.ШаблонИзвещений;	
	КонецЦикла; 
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

// Функции выполняет проверку на незаполнение значений колонки табличной части.
//
Функция ПроверитьПустыеИО()
	
	ЕстьПустые = Ложь;
	
	Для Каждого Строка ИЗ ДокументыКИмпорту Цикл
		
		Если НЕ ЗначениеЗаполнено(Строка.ИсточникОплаты) Тогда
			
			ЕстьПустые = Истина;
			Прервать;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	Возврат ЕстьПустые;
	
КонецФункции 

&НаСервере
Функция ДокументыКИмпортуПриИзмененииНаСервере(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ОтвЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|
	|УПОРЯДОЧИТЬ ПО
	|	бит_ПроживающиеПоЛССрезПоследних.Период УБЫВ";
	
	Запрос.УстановитьПараметр("Дата"       , КонецМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	
	Если НЕ Запрос.Выполнить().Пустой() Тогда
		
		Выборка = Запрос.Выполнить().Выбрать();
		Выборка.Следующий();

	КонецЕсли;
	
	Адрес = "ул. " + Строка(ЛицевойСчет.УлицаЛицевогоСчета) + " д. " 
	+ Строка(ЛицевойСчет.Здание) + " кв. " 
	+Строка(ЛицевойСчет.Квартира);
	
	Структура = Новый Структура;
	//26.08.2019
	попытка
	 Структура.Вставить("ОтветственноеЛицо",Выборка.ОтвЛицо);
    исключение
	 Структура.Вставить("ОтветственноеЛицо", Справочники.бит_Проживающие.ПустаяСсылка());

	 ОбщегоНазначенияКлиентСервер.СообщитьПользователю(
			Нстр("ru = 'У лицевого счета не заполнено поле Ответственное лицо'")
			,, "ЭлектроннаяВыпискаБанка");			
	конецпопытки; 
	Структура.Вставить("Адрес",Адрес);
	Возврат Структура;
	
КонецФункции

&НаКлиенте
Процедура Растянуть(Команда)
	
	Элементы.ДокументыКИмпорту.Высота = 0;
	Элементы.ДокументыКИмпорту.РастягиватьПоВертикали = Истина;
	
КонецПроцедуры

#КонецОбласти

