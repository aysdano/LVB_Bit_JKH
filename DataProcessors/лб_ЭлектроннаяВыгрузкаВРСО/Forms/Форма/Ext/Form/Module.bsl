&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Период.ДатаНачала = НачалоМесяца(ТекущаяДата());
	Период.ДатаОкончания = КонецМесяца(ТекущаяДата());
	
	ЗаполнитьУчастки();
	
КонецПроцедуры

&НаКлиенте
Процедура Участки_УстановитьФлажки(Команда)
	
	Для каждого УчасткиСтрока Из Участки Цикл
		УчасткиСтрока.ВыполняетсяОтбор = Истина;	
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура Участки_СнятьФлажки(Команда)
	
	Для каждого УчасткиСтрока Из Участки Цикл
		УчасткиСтрока.ВыполняетсяОтбор = Ложь;	
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьУчастки()
	
	Участки.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_АдминистративныеОкруга.Ссылка КАК Участок
	|ИЗ
	|	Справочник.бит_АдминистративныеОкруга КАК бит_АдминистративныеОкруга
	|ГДЕ
	|	НЕ бит_АдминистративныеОкруга.ПометкаУдаления
	|
	|УПОРЯДОЧИТЬ ПО
	|	бит_АдминистративныеОкруга.Наименование";
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		НоваяСтрокаУчастки = Участки.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаУчастки, ВыборкаДетальныеЗаписи);
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоАдресуПриИзменении(Элемент)	
	
	Если ПоАдресу Тогда
		Элементы.ГруппаУточнениеАдреса.Доступность = Истина;	
	Иначе
		Элементы.ГруппаУточнениеАдреса.Доступность = Ложь;	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ДиалогВыбораКаталогаИмпорта = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	ДиалогВыбораКаталогаИмпорта.Заголовок = "Выберите каталог для выгрузки ";
	ДиалогВыбораКаталогаИмпорта.ПроверятьСуществованиеФайла = Истина;
	ДиалогВыбораКаталогаИмпорта.Каталог = Каталог;
	
	Оповещение = Новый ОписаниеОповещения("ВыборКаталогаЗавершение", ЭтотОбъект);
	ДиалогВыбораКаталогаИмпорта.Показать(Оповещение);
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборКаталогаЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если НЕ Результат = Неопределено Тогда
		Каталог = Результат[0];
	Иначе
		ПоказатьПредупреждение(,"Каталог не выбран!");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СформироватьФайл(Команда)
	
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		Сообщить("Не заполнен каталог!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ФорматФайла) Тогда
		Сообщить("Не заполнен формат файла!");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(Период) Тогда
		Сообщить("Не заполнен период!");
		Возврат;
	КонецЕсли;
	
	ПолучитьДанныеНаСервере();
	Если Не ТаблицаИтог.Количество() = 0 Тогда
		СформироватьФайлНаКлиенте();	
	Иначе	
		Сообщить("Не найдены данные для сохранения в файл!");	
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеНаСервере()
	
	ТаблицаИтог.Очистить();
	
	МассивУчастков = ПолучитьМассивУчастков();
	МассивАдресов = ПолучитьМассивАдресов();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент", Период.ДатаОкончания);
	//Запрос.УстановитьПараметр("ЛицевойСчет", Справочники.бит_ЛицевыеСчета.ПолучитьСсылку(Новый УникальныйИдентификатор("ceaf245c-1d93-11e9-ba8d-ac1f6b0f1d47")));//76141061835 (Справочник.бит_ЛицевыеСчета)
	Запрос.УстановитьПараметр("ДокументВид", Справочники.бит_ДокументыУдостоверяющиеЛичность.ПолучитьСсылку(Новый УникальныйИдентификатор("d0e846ea-daa6-11e9-ba98-ac1f6b0f1d47")));//Паспорт РФ  (Справочник.бит_ДокументыУдостоверяющиеЛичность)
	
	Если ЗначениеЗаполнено(ПоставщикГазоснабжения) Тогда
		
		ЗапросПоставщикГазоснабжения = "
		|	И ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание.ПоставщикГазоснабжения = &ПоставщикГазоснабжения";
		
		Запрос.УстановитьПараметр("ПоставщикГазоснабжения", ПоставщикГазоснабжения);
		
	Иначе
		ЗапросПоставщикГазоснабжения = "";
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ПоставщикТеплоснабжения) Тогда
		
		ЗапросПоставщикТеплоснабжения = "
		|	И ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание.ПоставщикТеплоснабжения = &ПоставщикТеплоснабжения";
		
		Запрос.УстановитьПараметр("ПоставщикТеплоснабжения", ПоставщикТеплоснабжения);
	Иначе
		ЗапросПоставщикТеплоснабжения = "";
	КонецЕсли;
	
	Если ГрузитьТолькоИзменения Тогда
		
		ЗапросГрузитьТолькоИзменения =  "
		|	И ПроживающиеПоЛССрезПоследних.Регистратор.Дата МЕЖДУ &НачПериода И &КонПериода
		|	И ТИПЗНАЧЕНИЯ(ПроживающиеПоЛССрезПоследних.Регистратор) = ТИП(Документ.бит_РегистрацияПроживающихПоЛС)";
		
		Запрос.УстановитьПараметр("НачПериода", Период.ДатаНачала);
		Запрос.УстановитьПараметр("КонПериода", Период.ДатаОкончания);
	Иначе
		ЗапросГрузитьТолькоИзменения = "";
	КонецЕсли;
	
	Если МассивУчастков.Количество() > 0 Тогда
		ЗапросУчастки = "  
		|	И ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание.Район В(&СписокУчастков)";
		
		Запрос.УстановитьПараметр("СписокУчастков", МассивУчастков);
	Иначе
		ЗапросУчастки = "";
	КонецЕсли; 
	
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.Период КАК Период,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо КАК ФизЛицо,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид КАК ДокументВид,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументСерия КАК ДокументСерия,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументНомер КАК ДокументНомер,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументДатаВыдачи КАК ДокументДатаВыдачи,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКемВыдан КАК ДокументКемВыдан,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументКодПодразделения КАК ДокументКодПодразделения,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДатаРегистрацииПоМестуЖительства КАК ДатаРегистрацииПоМестуЖительства,
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументПричинаЗамены КАК ДокументПричинаЗамены
	               |ПОМЕСТИТЬ вт_ПаспортныеДанные
	               |ИЗ
	               |	РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	               |ГДЕ
	               |	бит_ПаспортныеДанныеПроживающихСрезПоследних.ДокументВид = &ДокументВид
