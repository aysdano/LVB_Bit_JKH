// БИТ_ЖКХ 16.04.2014
&НаКлиенте
Процедура ИзменитьЗначениеПараметраКвартиры()
	
	Квартира = КвартираНаСервере(Отчет.ЛицевойСчет);
	
	ПарамКвартира = Отчет.КомпоновщикНастроек.Настройки.ПараметрыДанных.НайтиЗначениеПараметра(Новый ПараметрКомпоновкиДанных("Квартира"));
	
	Если ПарамКвартира <> Неопределено Тогда 
		ПарамКвартира.Значение = Квартира; 
		ПарамКвартира.Использование = Истина; 
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция КвартираНаСервере(ЛицевойСчет)
	
	Возврат ЛицевойСчет.Квартира;
	
