Процедура ДатаОчногоГолосованияПриИзменении(Элемент)
	
	Объект.ДатаОчноЗаочногоГолосования_Начало = Объект.ДатаОчногоГолосования;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаЗаочногоГолосования_ОкончаниеПриИзменении(Элемент)
	
	Объект.ДатаОчноЗаочногоГолосования_Окончание = Объект.ДатаЗаочногоГолосования_Окончание;
	
КонецПроцедуры

//HD+
// Вызывает обработчик изменения инициатора в модуле объекта
//
&НаСервере
Процедура ИнициаторФИОПриИзмененииНаСервере()
	
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	Если ЗначениеЗаполнено(ОбъектДокумента.ИнициаторФИО)
		И НЕ ПроживающийДопустимДляМКДНаСервере(ОбъектДокумента.ИнициаторФИО) Тогда
		ОбъектДокумента.ИнициаторФИО = Справочники.бит_Проживающие.ПустаяСсылка();
		Сообщить("Инициатор не относится к выбранному МКД. Значение очищено.");
	КонецЕсли;
	
	ОбъектДокумента.ИнициаторФИОПриИзменении();
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	
КонецПроцедуры //HD-

//HD+
// Вызывает обработчик изменения МКД в модуле объекта
//
&НаСервере
Процедура МКДПриИзмененииНаСервере()
	
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	ОбъектДокумента.МКДПриИзменении();
	
	//HD+ Автозаполнение реквизитов МКД_Улица и МКД_НомерДома из выбранного МКД
	Если ЗначениеЗаполнено(ОбъектДокумента.МКД) Тогда
		Попытка
			ОбъектМКД = ОбъектДокумента.МКД.ПолучитьОбъект();
		Исключение
			ОбъектМКД = Неопределено;
		КонецПопытки;
		
		Если ОбъектМКД <> Неопределено Тогда
			ОбъектДокумента.МКД_Улица = ОбъектМКД.Улица;
			ОбъектДокумента.МКД_НомерДома = СформироватьСтрокуНомераДомаМКД(ОбъектМКД);
		Иначе
			ОбъектДокумента.МКД_Улица = Неопределено;
			ОбъектДокумента.МКД_НомерДома = "";
		КонецЕсли;
	Иначе
		ОбъектДокумента.МКД_Улица = Неопределено;
		ОбъектДокумента.МКД_НомерДома = "";
	КонецЕсли;
	//HD-
	
	//HD+ Автозаполнение реквизитов по данным регистра сведений РегистрСведений.лб_Тест_Дома
	ЗаполнитьРеквизитыКРПоМКДИзРегистра(ОбъектДокумента);
	//HD-
	
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	
	//HD+ Обновляем пользовательские параметры, связанные с реквизитами КР, после их автозаполнения
	ОбновитьПользовательскиеПараметрыПоСвязиНаСервере("Объект.ВладелецСчетаКР");
	ОбновитьПользовательскиеПараметрыПоСвязиНаСервере("Объект.ЛицевойСчетКР");
	ОбновитьПользовательскиеПараметрыПоСвязиНаСервере("Объект.Банк");
	//HD-
	
КонецПроцедуры //HD-

//HD+
// Формирует строку номера дома из реквизитов МКД: НомерДома, ПрефиксДома, Корпус.
// Реквизиты приводятся к строке; пустые части пропускаются.
//
&НаСервере
Функция СформироватьСтрокуНомераДомаМКД(ОбъектМКД)
	
	Если ОбъектМКД = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	ЧастиНомера = Новый Массив;
	
	Часть = СокрЛП(Строка(ОбъектМКД.НомерДома));
	Если ЗначениеЗаполнено(Часть) Тогда
		ЧастиНомера.Добавить(Часть);
	КонецЕсли;
	
	Часть = СокрЛП(Строка(ОбъектМКД.ПрефиксДома));
	Если ЗначениеЗаполнено(Часть) Тогда
		ЧастиНомера.Добавить(Часть);
	КонецЕсли;
	
	Часть = СокрЛП(Строка(ОбъектМКД.Корпус));
	Если ЗначениеЗаполнено(Часть) Тогда
		ЧастиНомера.Добавить(Часть);
	КонецЕсли;
	
	Если ЧастиНомера.Количество() = 0 Тогда
		Возврат "";
	КонецЕсли;
	
	Возврат СтрСоединить(ЧастиНомера, " ");
	
КонецФункции //HD-

//HD+
// Заполняет реквизиты ВладелецСчетаКР, ЛицевойСчетКР, Банк из регистра сведений РегистрСведений.лб_Тест_Дома
// по связи: лб_Тест_Дома.Здание = Объект.МКД.
//
&НаСервере
Процедура ЗаполнитьРеквизитыКРПоМКДИзРегистра(ОбъектДокумента)
	
	// Сброс значений по умолчанию
	ОбъектДокумента.ВладелецСчетаКР = "";
	ОбъектДокумента.ЛицевойСчетКР = "";
	ОбъектДокумента.Банк = Справочники.Банки.ПустаяСсылка();
	
	Если НЕ ЗначениеЗаполнено(ОбъектДокумента.МКД) Тогда
		Возврат;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ ПЕРВЫЕ 1
	|	лб_Тест_Дома.ВладелецСчетаКР КАК ВладелецСчетаКР,
	|	лб_Тест_Дома.ЛицевойСчетКР.НомерСчета КАК НомерСчета,
	|	лб_Тест_Дома.ЛицевойСчетКР.Банк КАК Банк
	|ИЗ
	|	РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
	|ГДЕ
	|	лб_Тест_Дома.Здание = &МКД";
	
	Запрос.УстановитьПараметр("МКД", ОбъектДокумента.МКД);
	РезультатЗапроса = Запрос.Выполнить();
	Выборка = РезультатЗапроса.Выбрать();
	
	Если НЕ Выборка.Следующий() Тогда
		Возврат;
	КонецЕсли;
	
	ОбъектДокумента.ВладелецСчетаКР = Выборка.ВладелецСчетаКР;
	
	Если ЗначениеЗаполнено(Выборка.НомерСчета) Тогда
		ОбъектДокумента.ЛицевойСчетКР = СокрЛП(Строка(Выборка.НомерСчета));
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.Банк) Тогда
		ОбъектДокумента.Банк = Выборка.Банк;
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Вызывает обработчик изменения участника собрания в модуле объекта
//
&НаСервере
Процедура УчастникиСобранияПриИзмененииНаСервере(ИндексСтроки)
	
	ОбъектДокумента = РеквизитФормыВЗначение("Объект");
	
	Если ИндексСтроки >= 0 И ИндексСтроки < ОбъектДокумента.УчастникиСобрания.Количество() Тогда
		
		СтрокаУчастника = ОбъектДокумента.УчастникиСобрания[ИндексСтроки];
		
		Если ЗначениеЗаполнено(СтрокаУчастника) И ЗначениеЗаполнено(СтрокаУчастника.Собственник) Тогда
			
			Если НЕ ПроживающийДопустимДляМКДНаСервере(СтрокаУчастника.Собственник) Тогда
				СтрокаУчастника.Собственник = Справочники.бит_Проживающие.ПустаяСсылка();
				Попытка
					СтрокаУчастника.НомерКвартиры = "";
				Исключение
				КонецПопытки;
				Сообщить("Собственник в строке участников не относится к выбранному МКД. Значение очищено.");
			Иначе
				ОбъектДокумента.УчастникиСобранияПриИзменении(СтрокаУчастника);
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ЗначениеВРеквизитФормы(ОбъектДокумента, "Объект");
	
КонецПроцедуры //HD-

