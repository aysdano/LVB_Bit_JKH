				Возврат Ложь;
			КонецПопытки;
			
			Если Ответ.КодСостояния = 200 Тогда
				СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				Если Не ПустаяСтрока(СтрокаОтвет) Тогда
					РезультатПроверки = СтрокаОтвет;
					Результат = РезультатПроверки;
					
				КонецЕсли;
			Иначе
				ЖурналСтрокаОписанияОшибки = Строка(ОписаниеОшибки()); 
				// Журнал
				ИмяСобытияВЖурнал = "Отправка всех лицевых счетов в МЛК - 1";
				КодСостояния = Ответ.КодСостояния;
				СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				СтрокаОтвета = СтрокаОтвет;	
				МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЖурналЗапросБезКодировки,СтрокаОтвета,ЖурналСтрокаОписанияОшибки,ЖурналВремяНачало);	
				Возврат Ложь;
			КонецЕсли;
			Счетчик = 0;
			Запрос1 = "";
			Запрос2 = "";
			ЖурналЗапросБезКодировки = "";
			СтрокаПараметров = "";
			
			Продолжить;
		КонецЕсли;	
		
		Структура = ПолучитьСтруктуруДанныхЛицевогоСчета(Выборка.Ссылка,Настройки);
