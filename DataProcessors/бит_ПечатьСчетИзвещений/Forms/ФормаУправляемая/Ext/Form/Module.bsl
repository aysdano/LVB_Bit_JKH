&НаСервереБезКонтекста
Функция ПолучательПлатежаПриИзмененииНаСервере(ПолучательПлатежа);
	
	РсчСч = Справочники.БанковскиеСчета.ПустаяСсылка();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПолучательПлатежа", ПолучательПлатежа);
	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Контрагенты") Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.ОсновнойБанковскийСчет
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &ПолучательПлатежа";
	Иначе	
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Организации.ОсновнойБанковскийСчет
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &ПолучательПлатежа";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		РсчСч = Выборка.ОсновнойБанковскийСчет;
	КонецЕсли;
	
	Если РсчСч.Пустая() Тогда
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	БанковскиеСчета.Ссылка
		|ИЗ
		|	Справочник.БанковскиеСчета КАК БанковскиеСчета
		|ГДЕ
		|	БанковскиеСчета.Владелец = &ПолучательПлатежа";
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Если Выборка.Следующий() Тогда
			РсчСч = Выборка.Ссылка;
		КонецЕсли;
	КонецЕсли;
	
	Возврат РсчСч;
	
КонецФункции

&НаКлиенте
Процедура СписокЛСПередОкончаниемРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования, Отказ)
	
	Если Объект.СписокЛС.Количество() > 1 Тогда
		
		Отбор = Новый Структура;
		
		Для каждого Строка из Объект.СписокЛС Цикл
			
			Отбор.Вставить("ЛицевойСчет", Строка.ЛицевойСчет);
			
			СтрокиПоиска = Объект.СписокЛС.НайтиСтроки(Отбор);
			
			Если СтрокиПоиска.Количество() > 1 Тогда

				ТекстСообщения = НСтр("ru = 'Такой лицевой счет уже есть в списке!'");
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Отказ = Истина;
				СтрокаДляУдаления = СтрокиПоиска[1].НомерСтроки - 1;
				Объект.СписокЛС.удалить(СтрокаДляУдаления);
				Возврат;
				
			КонецЕсли; 
			
		КонецЦикла;	
		
	КонецЕсли; 
	
КонецПроцедуры

