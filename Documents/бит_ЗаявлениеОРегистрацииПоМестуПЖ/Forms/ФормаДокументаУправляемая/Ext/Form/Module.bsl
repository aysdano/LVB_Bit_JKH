&НаСервереБезКонтекста 
Функция ПолучитьАдресОткудаПрибыл(Проживающий)
	
	ЗапросАдрес = Новый Запрос;
	
	ЗапросАдрес.Текст = "ВЫБРАТЬ
	|	бит_ПроживающиеКонтактнаяИнформация.Значение КАК Значение,
	|	бит_ПроживающиеКонтактнаяИнформация.Представление КАК Представление
	|ИЗ
	|	Справочник.бит_Проживающие.КонтактнаяИнформация КАК бит_ПроживающиеКонтактнаяИнформация
	|ГДЕ
	|	бит_ПроживающиеКонтактнаяИнформация.Ссылка.Ссылка = &Ссылка
	|	И бит_ПроживающиеКонтактнаяИнформация.Вид = &Вид";
	
	ЗапросАдрес.УстановитьПараметр("Ссылка", Проживающий);
	ЗапросАдрес.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресПрибытия);
	Результат = ЗапросАдрес.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьАдресКудаВыписан(Проживающий)
	
	ЗапросАдрес = Новый Запрос;
	
	ЗапросАдрес.Текст = "ВЫБРАТЬ
	|	бит_ПроживающиеКонтактнаяИнформация.Представление КАК Представление,
	|	бит_ПроживающиеКонтактнаяИнформация.Значение КАК Значение
	|ИЗ
	|	Справочник.бит_Проживающие.КонтактнаяИнформация КАК бит_ПроживающиеКонтактнаяИнформация
	|ГДЕ
	|	бит_ПроживающиеКонтактнаяИнформация.Ссылка.Ссылка = &Ссылка
	|	И бит_ПроживающиеКонтактнаяИнформация.Вид = &Вид";
	
	ЗапросАдрес.УстановитьПараметр("Ссылка", Проживающий);
	ЗапросАдрес.УстановитьПараметр("Вид", Справочники.ВидыКонтактнойИнформации.АдресУбытия);
	
	Результат = ЗапросАдрес.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат Результат;	
	КонецЕсли;
	
	Возврат Неопределено;
КонецФункции

