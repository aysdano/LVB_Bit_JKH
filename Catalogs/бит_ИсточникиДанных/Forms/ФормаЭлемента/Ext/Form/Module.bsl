		|	ХозрасчетныйОбороты.ПодразделениеКор,
		|	ТаблицаСоответствий.СтатьяОборотов"
		
	КонецЕсли;
	
	Возврат ТекстЗапроса;
	
КонецФункции

&НаСервере
Функция СоздатьСКД(ТекстЗапроса)
	
	СКД = Новый СхемаКомпоновкиДанных;
	
	// создадим набор данных
	ИД  = СКД.ИсточникиДанных.Добавить();
	ИД.Имя                = "ОборотыПоСчету";
	ИД.ТипИсточникаДанных = "Local";
	
	НаборДанных = СКД.НаборыДанных.Добавить(Тип("НаборДанныхЗапросСхемыКомпоновкиДанных"));
	НаборДанных.Имя = "Обороты";
	НаборДанных.ИсточникДанных = ИД.Имя;
	НаборДанных.Запрос = ТекстЗапроса;
	НаборДанных.АвтоЗаполнениеДоступныхПолей = Истина;
	
	НаборДанных.Поля.Очистить();
	СКД.ПоляИтога.Очистить();
	
	Для каждого Поле Из мКэшЗначений.ПоляОтчета Цикл
		
		ИмяПоля = Поле.Ключ;
		
		ОграничениеИспользования = НЕ мКэшЗначений.ПоляОграниченияУсловия.Найти(ИмяПоля) = Неопределено;
		
		ПолеКомпановки = НаборДанных.Поля.Добавить(Тип("ПолеНабораДанныхСхемыКомпоновкиДанных"));
		ПолеКомпановки.ПутьКДанным = ИмяПоля;
		ПолеКомпановки.Поле        = ИмяПоля;
		ПолеКомпановки.ОграничениеИспользования.Условие           = ОграничениеИспользования;
		ПолеКомпановки.ОграничениеИспользованияРеквизитов.Условие = ОграничениеИспользования;
		
	КонецЦикла;
	
	ВидыСубконтоСчета = ПолучитьВидыСубконто(Объект.Счет);
	
	Для каждого Субконто Из ВидыСубконтоСчета Цикл
		
		ИмяПоля = "Субконто" + Субконто.НомерСтроки;
		
		ПолеКомпановки = НаборДанных.Поля.Найти(ИмяПоля);
		
		Если НЕ ПолеКомпановки = Неопределено Тогда
			
			ПолеКомпановки.Заголовок   = Субконто.Наименование;
			ПолеКомпановки.ТипЗначения = Субконто.ТипЗначения;
			
		КонецЕсли; 
		
	КонецЦикла; 
	
	Для каждого Поле Из мКэшЗначений.РесурсыОтчета Цикл
		
		ИмяРесурса = Поле.Ключ;
		
		ПолеРесурса = СКД.ПоляИтога.Добавить();
		ПолеРесурса.Выражение   = "Сумма("+ИмяРесурса+")";
		ПолеРесурса.ПутьКДанным = ИмяРесурса;
		
	КонецЦикла; 
	
	Параметр = СКД.Параметры.Добавить();
	Параметр.Имя                      = "ГраницаНачало";
	Параметр.Заголовок                = "ГраницаНачало";
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр = СКД.Параметры.Добавить();
	Параметр.Имя                      = "ГраницаКонец";
	Параметр.Заголовок                = "ГраницаКонец";
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр = СКД.Параметры.Добавить();
	Параметр.Имя                      = "Счет";
	Параметр.Заголовок                = "Счет";
	Параметр.ОграничениеИспользования = Истина;
	
	Параметр = СКД.Параметры.Добавить();
	Параметр.Имя                      = "Организация";
	Параметр.Заголовок                = "Организация";
	Параметр.ОграничениеИспользования = Истина;
	
	Если Объект.ОбязательныйПараметрСО Тогда
		
		Параметр = СКД.Параметры.Добавить();
		Параметр.Имя           = "СтатьяОборотов";
		Параметр.Заголовок     = "СтатьяОборотов";
		Параметр.ТипЗначения   = Новый ОписаниеТипов("СправочникСсылка.бит_СтатьиОборотов");
		Параметр.Использование = ИспользованиеПараметраКомпоновкиДанных.Всегда;
		Параметр.Значение      = Справочники.бит_СтатьиОборотов.ПустаяСсылка();
		
		Параметр.ВключатьВДоступныеПоля = Истина;
		
	КонецЕсли; 
	
	Возврат СКД;
	
КонецФункции // ()

&НаСервере
Процедура ИнициализироватьНастройкиКомпановщика(ВостановитьНастройки = Ложь)
	
	СхемаКомпоновкиДанных = СоздатьСКД(Объект.Запрос);
	
	КомпоновщикНастроек.Инициализировать(
	Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ЭтаФорма.УникальныйИдентификатор)));
	
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
	КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
	
	// Выбранные поля компоновщика настроек.
	
	ГруппаПолей = КомпоновщикНастроек.Настройки.Выбор.Элементы.Добавить(Тип("ГруппаВыбранныхПолейКомпоновкиДанных"));
	ГруппаПолей.Заголовок = "Обязательные поля";
	
	Для Каждого ОбязательноеПоле Из мКэшЗначений.ОбязательныеПоля Цикл
		
		ПолеСКД = НайтиПолеСКДПоПолномуИмени(КомпоновщикНастроек.Настройки.Выбор.ДоступныеПоляВыбора.Элементы, ОбязательноеПоле);
		
		Если ПолеСКД <> Неопределено Тогда
			ВыбранноеПоле = ГруппаПолей.Элементы.Добавить(Тип("ВыбранноеПолеКомпоновкиДанных"));
			ВыбранноеПоле.Поле = ПолеСКД.Поле;
		КонецЕсли;
		
	КонецЦикла;
	
	Если ВостановитьНастройки Тогда
		
		ТекОбъект = ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.бит_ИсточникиДанных"));
		
		СохраненыеНастройки = ТекОбъект.ПолучитьНастройки();
		
		Если НЕ СохраненыеНастройки.КомпоновщикНастроек = Неопределено Тогда
			
			КомпоновщикНастроек.Настройки.Отбор.Элементы.Очистить();
			бит_ОбщегоНазначенияКлиентСервер.СкопироватьЭлементы(КомпоновщикНастроек.Настройки.Отбор, СохраненыеНастройки.КомпоновщикНастроек.Отбор);
			КомпоновщикНастроек.Настройки.Выбор.Элементы.Очистить();
			бит_ОбщегоНазначенияКлиентСервер.СкопироватьЭлементы(КомпоновщикНастроек.Настройки.Выбор, СохраненыеНастройки.КомпоновщикНастроек.Выбор);
			
			Для каждого Элемент Из СохраненыеНастройки.КомпоновщикНастроек.ПараметрыДанных.Элементы Цикл
				
				КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра(Элемент.Параметр, Элемент.Значение); 
				
			КонецЦикла;
			
			Если СохраненыеНастройки.КомпоновщикНастроек.ПараметрыДанных.Элементы.Количество() = 0 И Объект.ОбязательныйПараметрСО Тогда
				
				КомпоновщикНастроек.Настройки.ПараметрыДанных.УстановитьЗначениеПараметра("СтатьяОборотов", Справочники.бит_СтатьиОборотов.ПустаяСсылка());
				
			КонецЕсли; 
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСчетаНаСервере()
	
	Объект.Запрос = СформироватьТекстЗапроса();
	ИнициализироватьНастройкиКомпановщика();
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьВидыСубконто(Счет)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Счет", Счет);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ХозрасчетныйВидыСубконто.Ссылка,
	|	ХозрасчетныйВидыСубконто.ВидСубконто,
	|	ВидыСубконтоХозрасчетные.Наименование,
	|	ВидыСубконтоХозрасчетные.ТипЗначения,
	|	ХозрасчетныйВидыСубконто.НомерСтроки КАК НомерСтроки
	|ИЗ
	|	ПланСчетов.Хозрасчетный.ВидыСубконто КАК ХозрасчетныйВидыСубконто
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПланВидовХарактеристик.ВидыСубконтоХозрасчетные КАК ВидыСубконтоХозрасчетные
	|		ПО ХозрасчетныйВидыСубконто.ВидСубконто = ВидыСубконтоХозрасчетные.Ссылка
	|ГДЕ
	|	ХозрасчетныйВидыСубконто.Ссылка = &Счет
	|
	|УПОРЯДОЧИТЬ ПО
	|	НомерСтроки";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

// Среди элементов полей СКД найти поле по имени.
//
&НаСервере
Функция НайтиПолеСКДПоИмени(Элементы, Имя)
	
	Для Каждого Элемент Из Элементы Цикл
		Если ВРЕГ(Строка(Элемент.Поле)) = ВРЕГ(Имя) Тогда
			Возврат Элемент;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции // НайтиПолеСКДПоИмени()

// Найти поле СКД по полному имени.
//
&НаСервере
Функция НайтиПолеСКДПоПолномуИмени(Элементы, ПолноеИмя)
	
	масЧастейИмен = ИзПолногоИмениПоляПолучитьЧасти(ПолноеИмя);
	колЧастей = масЧастейИмен.Количество();
	
	текИмя = масЧастейИмен[0];
	Поле = НайтиПолеСКДПоИмени(Элементы, текИмя);
	Если Поле = Неопределено Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Сч = 2 По колЧастей Цикл
		текИмя = текИмя +"." + масЧастейИмен[Сч-1];
		Поле = НайтиПолеСКДПоИмени(Поле.Элементы, текИмя);
		Если Поле = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Поле;
	
КонецФункции // НайтиПолеСКДПоПолномуИмени()

// Полное имя поля разделить по частям
//
&НаСервере
Функция ИзПолногоИмениПоляПолучитьЧасти(ПолноеИмя)
	
	масЧастей = Новый Массив;
	СтрИмя = ПолноеИмя;
	
	Пока Не ПустаяСтрока(СтрИмя) Цикл
		Если Лев(СтрИмя, 1) = "[" Тогда
			
			Поз = Найти(СтрИмя, "]");
			Если Поз = 0 Тогда
				масЧастей.Добавить(Сред(СтрИмя, 2));
				СтрИмя = "";
			Иначе
				масЧастей.Добавить(Сред(СтрИмя, 1, Поз));
				СтрИмя = Сред(СтрИмя, Поз + 2);
			КонецЕсли;
			
		Иначе
			
			Поз = Найти(СтрИмя, ".");
			Если Поз = 0 Тогда
				масЧастей.Добавить(СтрИмя);
				СтрИмя = "";
			Иначе
				масЧастей.Добавить(Лев(СтрИмя, Поз - 1));
				СтрИмя = Сред(СтрИмя, Поз + 1);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
	Возврат масЧастей;
	
КонецФункции // ИзПолногоИмениПоляПолучитьЧасти()

#КонецОбласти