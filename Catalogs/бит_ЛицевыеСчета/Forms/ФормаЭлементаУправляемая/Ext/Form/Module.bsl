	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка В(&СписокЛицевыхСчетов)"
	);
	
	Запрос.УстановитьПараметр("СписокЛицевыхСчетов",СписокЛС);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Для Каждого Стр Из ТаблицаЗависимыеЛС Цикл
		
		Если Выборка.НайтиСледующий(Стр.ЛицевойСчетЗависимый,"ЛицевойСчет") Тогда
			
			Стр.Адрес = Строка(Выборка.УлицаЛицевогоСчета) + ", д. " + Строка(Выборка.Здание) + ?(ПустаяСтрока(Выборка.Корпус),"",", кор. " + Строка(Выборка.Корпус)) + ", кв. " + Строка(Выборка.Квартира);
			
		Иначе
			
			Стр.Адрес = "";
			
		КонецЕсли;
		
		Выборка.Сбросить();
		
	КонецЦикла;
	
КонецПроцедуры

