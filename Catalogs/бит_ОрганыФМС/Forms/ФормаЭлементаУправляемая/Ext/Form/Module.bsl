
#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	РазместитьКонтактнуюИнформацию();
	
	ПолеКИ1           = ПолучитьДанныеИзКонтактнойИнформации("Телефон"                , "ТелефонОрганаФМС");
	
	Отбор = Новый Структура();
	Отбор.Вставить("Вид",ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонОрганаФМС"));
	
	Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
	
	Если Строки.количество() = 0 и ЗначениеЗаполнено(Объект.ТелефонОрганаФМС) Тогда
		
		КонтактнаяИнформацияПолеТелефонОрганаФМС = Объект.ТелефонОрганаФМС;
		
	ИначеЕсли Строки.количество() = 0 Тогда	
		
		КонтактнаяИнформацияПолеТелефонОрганаФМС = ПолеКИ1;
		
	Иначе
		
		КонтактнаяИнформацияПолеТелефонОрганаФМС = Строки[0].Представление;
		
	КонецЕсли;		
	
	Если ПолеКИ1 = "" и НЕ Строки.количество() = 0 Тогда
		
		КонтактнаяИнформацияПолеТелефонОрганаФМС = Строки[0].Представление;
		
	КонецЕсли;	
	
	
	ПолеКИ2           = ПолучитьДанныеИзКонтактнойИнформации("ВебСтраница"                , "ВебСтраницаОрганаФМС");
	
	Отбор = Новый Структура();
	Отбор.Вставить("Вид",ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ВебСтраницаОрганаФМС"));
	
	Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
	
	Если Строки.количество() = 0 и ЗначениеЗаполнено(Объект.ВебСтраницаОрганаФМС) Тогда
		
		КонтактнаяИнформацияПолеВебСтраницаОрганаФМС = Объект.ВебСтраницаОрганаФМС;
		
	ИначеЕсли Строки.количество() = 0 Тогда	
		
		КонтактнаяИнформацияПолеВебСтраницаОрганаФМС = ПолеКИ2;
		
	Иначе
		
		КонтактнаяИнформацияПолеВебСтраницаОрганаФМС = Строки[0].Представление;
		
	КонецЕсли;		
	
	Если ПолеКИ2 = "" и НЕ Строки.количество() = 0 Тогда
		
		КонтактнаяИнформацияПолеВебСтраницаОрганаФМС = Строки[0].Представление;
		
	КонецЕсли;	

КонецПроцедуры

