		Квитанция.Присоединить(ТаблицаНаПечать);
		
		Квитанция.Вывести(Середина);
		
	КонецЕсли;
	// Блок отрывной печати конец.
	
	Середина2.Параметры.Заполнить(мСтруктураДанных);
	Квитанция.Вывести(Середина2);
