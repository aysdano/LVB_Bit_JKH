
#Область ПеременныеМодуля

Перем мЭтоБухгалтерияПредприятия; // Хранит признак - это бухгалтерия предприятия.

Перем мПротокол Экспорт; // Хранит протокол проведения обновления.

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункции

// Процедура выполняет первое заполнение информационной базы. 
//
// Параметры:
//  Нет.
//
Процедура ПервоеЗаполнение()Экспорт
	
	Если ЗначениеЗаполнено(ПланыОбмена.ГлавныйУзел()) Тогда
		
		// БИТ_ЖКХ_16082013_начало_изменений
		УстановитьПредопределенныеМакеты();
		// БИТ_ЖКХ_16082013_окончание_изменений
		
		// Установка номера версии информационной базы.
		Константы.бит_НомерВерсииКонфигурацииБИТ.Установить(бит_ОбщегоНазначения.ПолучитьНомерРелиза_бит());
		
		Сведения = бит_ОбщегоНазначения.ПолучитьСведенияОПрограмме();
		НомерРелизаБИТ = Сведения.НомерРелиза_БИТ;
		ТекстЗаголовка = Сведения.Синоним_1С+" "+Сведения.НомерРелиза_1С+" + "+Сведения.Синоним_БИТ +" "+НомерРелизаБиТ; 
		Константы.ЗаголовокСистемы.Установить(ТекстЗаголовка);
		
	Иначе
		МакетОписаниеОбновлений = ПолучитьМакет("ОписаниеОбновлений");
		ДокументОписаниеОбновлений = Новый ТабличныйДокумент;
		ДокументОписаниеОбновлений.Очистить();
		
		// Перед обновлением требуется снять дату запрета изменения данных.
		ПараметрыСеанса.бит_ГраницыЗапретаИзмененияДанных = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(0));
		
		бит_ПолныеПрава.УстановитьПараметрГраницыЗапретаИзмененияДанных();
		
		Версия = бит_ОбщегоНазначения.ПолучитьНомерРелиза_бит();	
		ТекущаяВерсияИБ = Константы.бит_НомерВерсииКонфигурацииБИТ.Получить();
		
		НоваяВерсияИБ = Версия;
		
		ТекстСообщения = НСтр("ru = 'Обновление информационной базы (Подсистема БИТ: Жилищно-коммунальное хозяйство) до версии %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, НоваяВерсияИБ);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		// Установка номера версии информационной базы.
		Константы.бит_НомерВерсииКонфигурацииБИТ.Установить(НоваяВерсияИБ); 
		
		ТекстСообщения = НСтр("ru = 'Выполнено обновление информационной базы (Подсистема БИТ: Жилищно-коммунальное хозяйство) до версии %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, НоваяВерсияИБ);
		ЗаписьЖурналаРегистрации("ИнформационнаяБаза.ОбновлениеИБ", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);               
		
		ЗагрузитьСправочнуюИнформациюИзМакета("СправочнаяИнформация"); // Заполнение справочной информацией.
		
		ЗаполнениеОбъектовБИТ();                   // Заполнение объектов конфигурации.
		
		ЗаполнитьСправочникКонтактнойИнформации(); // Заполняет справочник бит_ВидыКонтактнойИнформации.
		
		ЗаполнитьПредопределенныеУслуги();         // Заполнение услуги пеня.
		
		ЗаполнениеПрефиксаАдреса();                // Заполнение префикса адреса.
		
		Добавить_Справочник_ПринятыеРешения();     // Заполнение реквизита ПринятоеРешение у предопределенных справочника бит_ПринятыеРешения.
		
		ОбновитьНазначениеЧастейПомещения();
		
		УстановитьПредопределенныеМакеты();
		
		УстановитьСтандартныеНастройкиПечатиМакетовСчетИзвещений();
		
		Сведения = бит_ОбщегоНазначения.ПолучитьСведенияОПрограмме();
		НомерРелизаБИТ = Сведения.НомерРелиза_БИТ;
		ТекстЗаголовка = Сведения.Синоним_1С+" "+Сведения.НомерРелиза_1С+" + "+Сведения.Синоним_БИТ +" "+НомерРелизаБиТ; 
		Константы.ЗаголовокСистемы.Установить(ТекстЗаголовка);
		
		Если Константы.бит_НомерВерсииКонфигурацииБИТ.Получить() = НоваяВерсияИБ Тогда
			// Если удалось зафиксировать транзакцию, то сообщение об успешном обновлении информационной базы.
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура выполняет обновление информационной базы. 
//
// Параметры:
//  Нет.
//
Процедура ВыполнитьОбновление()Экспорт
	
	НачатьТранзакцию();
	
	МакетОписаниеОбновлений = ПолучитьМакет("ОписаниеОбновлений");
	ДокументОписаниеОбновлений = Новый ТабличныйДокумент;                       
	ДокументОписаниеОбновлений.Очистить();
	
	// Перед обновлением требуется снять дату запрета изменения данных.
	ПараметрыСеанса.бит_ГраницыЗапретаИзмененияДанных = Новый ХранилищеЗначения(Неопределено, Новый СжатиеДанных(0));
	
	бит_ПолныеПрава.УстановитьПараметрГраницыЗапретаИзмененияДанных();
	
	ТекущаяВерсияИБ = Константы.бит_НомерВерсииКонфигурацииБИТ.Получить();
	НоваяВерсияИБ   = бит_ОбщегоНазначения.ПолучитьНомерРелиза_бит();
	
	Если ((бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ) = "1.2.7" ИЛИ бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ) = "1.2.8"
		
		ИЛИ бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ) = "1.2.9"	
		
		// БИТ_ЖКХ 14.12.2016 11:25:30 Начало правки...
		ИЛИ бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ) = "1.2.10"	
		// БИТ_ЖКХ 14.12.2016 11:25:30 Конец правки.
		
		ИЛИ бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ) = "1.3.0"	
		
		// БИТ_ЖКХ 06.02.2015{{
		ИЛИ бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ) = "1.3.1"	
		// БИТ_ЖКХ 06.02.2015}}
		
		// БИТ_ЖКХ 17.07.2017 10:14:48 Начало правки...
		ИЛИ бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ) = "1.3.2"
		// БИТ_ЖКХ 17.07.2017 10:14:48 Конец правки.
		
		// БИТ_ЖКХ 20.03.2020 ..
		ИЛИ бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ) = "1.3.3")
		// БИТ_ЖКХ 20.03.2020 10:14:48 Конец правки.

		
		И ТекущаяВерсияИБ <> ""
		И ТекущаяВерсияИБ <> НоваяВерсияИБ) 
		Тогда
		
		ЗаполнитьСправочникКонтактнойИнформации();
		
		// БИТ_ЖКХ 14.12.2016 11:27:04 Начало правки... 
		//Если Строка(Лев(бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ),3)) = Строка(Лев("1.2.9",3)) и
		Если Строка(Лев(бит_ОбщегоНазначения.ПолучитьНомерРелиза(ТекущаяВерсияИБ),3)) = Строка(Лев("1.2.10",3)) и
		// БИТ_ЖКХ 14.12.2016 11:27:07 Конец правки. 	
			
			(Строка(Лев(бит_ОбщегоНазначения.ПолучитьНомерРелиза(НоваяВерсияИБ),3)) = Строка(Лев("1.3.1",3))
			ИЛИ Строка(Лев(бит_ОбщегоНазначения.ПолучитьНомерРелиза(НоваяВерсияИБ),3)) = Строка(Лев("1.3.2",3))) Тогда
			
			ПереносКИПриОбновленииС20();
			
			КонвертироватьВидыДокументовВРегистреПаспортныеДанныеПроживающих();
			
			ПеренестиНастройкиПользователей();
			
		КонецЕсли;
		
		КонвертироватьПолПроживающих();
		
		// БИТ_ЖКХ 17.03.2015{{
		УдалитьДублиСтрокКонтактнойИнформации();		
		// БИТ_ЖКХ 17.03.2015}}
		
		МенеджерОборудованияВызовСервераПереопределяемый.ОбновитьПоставляемыеДрайвера();
		
		//МенеджерОборудованияВызовСервераПереопределяемый.ОбновитьДрайверыВСправочникеПодключаемогоОборудования();
		
		ЗаполнитьНасйтрокиГЦЖСПоУслугам();
		бит_ВариантыОтчета.ОбновитьПредопределенныеВарианты();
		ЗаполнитьОсновнойДоговорПолучателямДенежныхСтредств();  
		
		// БИТ_ЖКХ 31.12.2015 11:53:42 Начало правки...
		ЗаполнитьПериодыНачисленияПени();
		// БИТ_ЖКХ 31.12.2015 11:53:42 Конец правки.
		
		// БИТ_ЖКХ 01.04.2016 15:01:40 Начало правки...
		УстановитьНастройкиШаблонаИзвещенияПоВсемЗаМесяц();
		// БИТ_ЖКХ 01.04.2016 15:01:40 Конец правки.
		
		// БИТ_ЖКХ 07.06.2016 15:21:29 Начало правки...
		УстановитьНастройкиШаблонаИзвещенияПоВсемУслугамБезСтрахования();
		// БИТ_ЖКХ 07.06.2016 15:21:29 Конец правки.
		
		// БИТ_ЖКХ 08.06.2016 10:46:54 Начало правки...
		ЗаполнитьШаблоныИзвещенийКапРемонта();
		// БИТ_ЖКХ 08.06.2016 10:46:54 Конец правки.
		
		// БИТ_ЖКХ 31.07.2018 15:58:57 Начало правки...
		ЗаполнитьШаблоныИзвещенийПоВсемУслугамДолговой();
		// БИТ_ЖКХ 31.07.2018 15:58:57 Конец правки.
		
		// БИТ_ЖКХ 14.09.2016 16:37:04 Начало правки...
		УстановитьНастройкиБУШаблонаИзвещенияПоВсемУслугам();
		// БИТ_ЖКХ 14.09.2016 16:37:04 Конец правки.
		
		// БИТ_ЖКХ 16.06.2016 11:25:48 Начало правки...
		ЗаполнитьЧасовыеЗоныПоOlson();
		// БИТ_ЖКХ 16.06.2016 11:25:48 Конец правки.
		
		// БИТ_ЖКХ 12.08.2016 10:00:10 Начало правки... 
		УстановитьРазмерПакетаДляГИСЖКХ();
		
		ЗаполнитьНачальныеШаблоныГИСЖКХ(); // БИТ_ЖКХ 12.08.2016 10:00:19
		
		// БИТ_ЖКХ 19.03.2021
		// 22.03.2021
		ЗаполнитьЭлПочтуУПроживающих();
		
		ЗаполнитьПодъезды(); // БИТ_ЖКХ 29.12.2016 12:41:57 
		
		// БИТ_ЖКХ 06.07.2016 17:03:41 Начало правки...
		ЗаполнитьТипЛСГИСЖКХ();
		// БИТ_ЖКХ 06.07.2016 17:03:41 Конец правки.
		
		ЗаполнитьНомерПДГИСЖКХ(); // БИТ_ЖКХ 27.11.2017 18:19:05 
		
		// БИТ_ЖКХ_23082013_начало_изменений
		УстановитьСтандартныеНастройкиПечатиМакетовСчетИзвещений();
		// БИТ_ЖКХ_23082013_окончание_изменений
		
		ТекстСообщения = НСтр("ru = 'Выполняется обновление информационной базы (Подсистема БИТ: Жилищно-коммунальное хозяйство) до версии : %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, НоваяВерсияИБ);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		// Установка номера версии информационной базы.
		Константы.бит_НомерВерсииКонфигурацииБИТ.Установить(НоваяВерсияИБ);
		
		ТекстСообщения = НСтр("ru = 'Выполнено обновление информационной базы (Подсистема БИТ: Жилищно-коммунальное хозяйство) до версии : %1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, НоваяВерсияИБ);
		ЗаписьЖурналаРегистрации("ИнформационнаяБаза.ОбновлениеИБ", УровеньЖурналаРегистрации.Информация, , , ТекстСообщения);
		
		Сведения = бит_ОбщегоНазначения.ПолучитьСведенияОПрограмме();
		НомерРелизаБИТ = Сведения.НомерРелиза_БИТ;
		ТекстЗаголовка = Сведения.Синоним_1С+" "+Сведения.НомерРелиза_1С+" + "+Сведения.Синоним_БИТ +" "+НомерРелизаБиТ; 
		Константы.ЗаголовокСистемы.Установить(ТекстЗаголовка);
		
	КонецЕсли;
	
	Если ДокументОписаниеОбновлений.ВысотаТаблицы > 0 Тогда
		
		ДокументОписаниеОбновлений.ТолькоПросмотр = Истина;
		
		ДокументОписаниеОбновлений.ОтображатьЗаголовки = Ложь;
		ДокументОписаниеОбновлений.ОтображатьСетку = Ложь;
		
	КонецЕсли;
		
	// БИТ_ЖКХ 18.03.2014
	УстановитьПредопределенныеМакеты();
	// БИТ_ЖКХ 18.03.2014
	
	// БИТ_ЖКХ 13.06.2018 17:48:06 Начало правки...  Обновление макетов
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ВариантыСчетовИзвещений.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.бит_ВариантыСчетовИзвещений КАК бит_ВариантыСчетовИзвещений
	|ГДЕ
	|	бит_ВариантыСчетовИзвещений.Предопределенный = ЛОЖЬ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Об = Выборка.Ссылка.ПолучитьОбъект();
		
		// Исправление пользовательской функции.
		Об.КодФункции = СтрЗаменитьСУчетомРегистра(Об.КодФункции, "объекм", "Объем");
		Об.КодФункции = СтрЗаменитьСУчетомРегистра(Об.КодФункции, "соркнаиме", "СокрНаиме");
		
		// Исправление имени параметров макета.
		ТабДок	= Об.ШаблонПечатнойФормы.Получить();
		Если ТабДок = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		ЗаменаИмениПараметраТабличногоДокумента(ТабДок, "объекм", "Объем");
		ЗаменаИмениПараметраТабличногоДокумента(ТабДок, "соркнаиме", "СокрНаиме");
		
		Об.ШаблонПечатнойФормы	= Новый ХранилищеЗначения(ТабДок);
		
		Попытка
			Об.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка записи пользовательского макета квитанции при исправлении опечаток. (Объекм-Объем; СоркНаимвенование-СокрНаименование)'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
				УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.бит_ВариантыСчетовИзвещений, Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
		
	КонецЦикла; 
	// БИТ_ЖКХ 13.06.2018 17:48:08 Конец правки. 
	
	// БИТ_ЖКХ 24.08.2018 9:52:55 Начало правки...
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ФайлыГИСЖКХ.Ссылка КАК Ссылка,
	|	бит_ФайлыГИСЖКХ.ШаблонВыгрузкиГИСЖКХ КАК ШаблонВыгрузкиГИСЖКХ,
	|	бит_ФайлыГИСЖКХ.ШаблонИзвещений КАК ШаблонИзвещений
	|ПОМЕСТИТЬ ВТ_ВсеФайлыГИСЖКХ
	|ИЗ
	|	Документ.бит_ФайлыГИСЖКХ КАК бит_ФайлыГИСЖКХ
	|ГДЕ
	|	бит_ФайлыГИСЖКХ.ДолговойПД = ЗНАЧЕНИЕ(Перечисление.ДаНет.ПустаяСсылка)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ШаблонВыгрузкиГИСЖКХ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ВсеФайлыГИСЖКХ.Ссылка КАК Ссылка,
	|	ВТ_ВсеФайлыГИСЖКХ.ШаблонВыгрузкиГИСЖКХ КАК ШаблонВыгрузкиГИСЖКХ,
	|	бит_ШаблоныВыгрузкиГИСЖКХ.ШаблонПлатежныхДокументов КАК ШаблонПлатежныхДокументов,
	|	ВТ_ВсеФайлыГИСЖКХ.ШаблонИзвещений КАК ШаблонИзвещений
	|ИЗ
	|	ВТ_ВсеФайлыГИСЖКХ КАК ВТ_ВсеФайлыГИСЖКХ
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ Справочник.бит_ШаблоныВыгрузкиГИСЖКХ КАК бит_ШаблоныВыгрузкиГИСЖКХ
	|		ПО ВТ_ВсеФайлыГИСЖКХ.ШаблонВыгрузкиГИСЖКХ = бит_ШаблоныВыгрузкиГИСЖКХ.Ссылка
	|			И (бит_ШаблоныВыгрузкиГИСЖКХ.ШаблонПлатежныхДокументов = ИСТИНА)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Пока Выборка.Следующий() Цикл
		Об = Выборка.Ссылка.ПолучитьОбъект();
		Если Выборка.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемУслугамДолговой") Тогда
			Об.ДолговойПД = ПредопределенноеЗначение("Перечисление.ДаНет.Да");
		Иначе
			Об.ДолговойПД = ПредопределенноеЗначение("Перечисление.ДаНет.Нет");
		КонецЕсли;
		
		Попытка
			Об.Записать();
		Исключение
			ЗаписьЖурналаРегистрации(НСтр("ru = 'Ошибка записи документа ""Файлы ГИС ЖКХ.""'", ОбщегоНазначенияКлиентСервер.КодОсновногоЯзыка()),
			УровеньЖурналаРегистрации.Ошибка, Метаданные.Справочники.бит_ВариантыСчетовИзвещений, Выборка.Ссылка, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
		КонецПопытки;
			
	КонецЦикла;
	// БИТ_ЖКХ 24.08.2018 9:52:55 Конец правки.
	
	ОбновитьКонтактнуюИнформацию();
	
	//05.04.2019
	СнятьУдалениеПредпределенныхЭлементовНабораДопСведений();
	
	//13.08.2019 
	бит_ОбщегоНазначения.ЗаполнитьСписокУлицПоСпискуЗданий();
	
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

Процедура ОбновитьКонтактнуюИнформацию()
	
	ОбновитьВидыКонтактнойИнформации();
	ОбновитьТабличныеЧастиКонтактнойИнформации();
	
КонецПроцедуры

Процедура ОбновитьВидыКонтактнойИнформации()
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ВидыКонтактнойИнформацииЖКХ.Ссылка КАК СсылкаКИЖХХ,
	|	бит_ВидыКонтактнойИнформацииЖКХ.ПометкаУдаления КАК ПометкаУдаления,
	|	бит_ВидыКонтактнойИнформацииЖКХ.Родитель КАК Родитель,
	|	бит_ВидыКонтактнойИнформацииЖКХ.ЭтоГруппа КАК ЭтоГруппа,
	|	бит_ВидыКонтактнойИнформацииЖКХ.Наименование КАК Наименование,
	|	бит_ВидыКонтактнойИнформацииЖКХ.Тип КАК Тип,
	|	бит_ВидыКонтактнойИнформацииЖКХ.РеквизитДопУпорядочивания КАК РеквизитДопУпорядочивания,
	|	бит_ВидыКонтактнойИнформацииЖКХ.РедактированиеТолькоВДиалоге КАК РедактированиеТолькоВДиалоге,
	|	бит_ВидыКонтактнойИнформацииЖКХ.МожноИзменятьСпособРедактирования КАК МожноИзменятьСпособРедактирования,
	|	бит_ВидыКонтактнойИнформацииЖКХ.АдресТолькоРоссийский КАК АдресТолькоРоссийский,
	|	бит_ВидыКонтактнойИнформацииЖКХ.ВключатьСтрануВПредставление КАК ВключатьСтрануВПредставление,
	|	бит_ВидыКонтактнойИнформацииЖКХ.ОбязательноеЗаполнение КАК ОбязательноеЗаполнение,
	|	бит_ВидыКонтактнойИнформацииЖКХ.ПроверятьКорректность КАК ПроверятьКорректность,
	|	бит_ВидыКонтактнойИнформацииЖКХ.ЗапрещатьВводНекорректного КАК ЗапрещатьВводНекорректного,
	|	бит_ВидыКонтактнойИнформацииЖКХ.СкрыватьНеактуальныеАдреса КАК СкрыватьНеактуальныеАдреса,
	|	бит_ВидыКонтактнойИнформацииЖКХ.Подсказка КАК Подсказка,
	|	бит_ВидыКонтактнойИнформацииЖКХ.РазрешитьВводНесколькихЗначений КАК РазрешитьВводНесколькихЗначений,
	|	бит_ВидыКонтактнойИнформацииЖКХ.ВидКонтактнойИнформации КАК ВидКонтактнойИнформации,
	|	бит_ВидыКонтактнойИнформацииЖКХ.Предопределенный КАК Предопределенный
	|ИЗ
	|	Справочник.бит_ВидыКонтактнойИнформацииЖКХ КАК бит_ВидыКонтактнойИнформацииЖКХ
	|ГДЕ
	|	бит_ВидыКонтактнойИнформацииЖКХ.ВидКонтактнойИнформации = ЗНАЧЕНИЕ(Справочник.ВидыКонтактнойИнформации.ПустаяСсылка)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	СоответствиеПредопределенныхВидовКИ = ПолучитьСоответствиеПредопределенныхВидовКИ(); 
	НачатьТранзакцию();
	Пока Выборка.Следующий() Цикл
		
		СсылкаКИ = СоответствиеПредопределенныхВидовКИ.Получить(Выборка.СсылкаКИЖХХ);
		Если ЗначениеЗаполнено(СсылкаКИ) Тогда
			ОбКИ = СсылкаКИ.ПолучитьОбъект()
		Иначе
			ОбКИ = Справочники.ВидыКонтактнойИнформации.СоздатьЭлемент();
		КонецЕсли;
		
		Если Выборка.Предопределенный Тогда
			ОбКИ.Используется =	Истина;
			ОбКИ.ПометкаУдаления = Выборка.ПометкаУдаления;
			Если Выборка.ЭтоГруппа = Ложь Тогда
				
				ОбКИ.ПроверятьПоФИАС			= Ложь;
				ОбКИ.ТелефонCДобавочнымНомером	= Истина;
				ОбКИ.УказыватьОКТМО				= Ложь;
				ОбКИ.ХранитьИсториюИзменений	= Ложь;
				ОбКИ.МеждународныйФорматАдреса	= Ложь;
				
				// БИТ ЖКХ 05.02.2020
				//СписокСвойств = "Наименование, ВключатьСтрануВПредставление,
				//| МожноИзменятьСпособРедактирования, ОбязательноеЗаполнение, ПроверятьКорректность,
				//| РазрешитьВводНесколькихЗначений, РедактированиеТолькоВДиалоге, РеквизитДопУпорядочивания,
				//| СкрыватьНеактуальныеАдреса, Тип";
				СписокСвойств = "Наименование, ВключатьСтрануВПредставление,
				| МожноИзменятьСпособРедактирования, ОбязательноеЗаполнение, ПроверятьКорректность,
				| РазрешитьВводНесколькихЗначений, РеквизитДопУпорядочивания,
				| СкрыватьНеактуальныеАдреса, Тип";

				ЗаполнитьЗначенияСвойств(ОбКИ, Выборка, СписокСвойств, "Родитель");
			КонецЕсли;
			
		Иначе
			ОбКИ.Родитель					= СоответствиеПредопределенныхВидовКИ.Получить(Выборка.Родитель);
			ОбКИ.Используется				= Истина;
			ОбКИ.ПометкаУдаления			= Выборка.ПометкаУдаления;
			ОбКИ.ПроверятьПоФИАС			= Ложь;
			ОбКИ.ТелефонCДобавочнымНомером	= Истина;
			ОбКИ.УказыватьОКТМО				= Ложь;
			ОбКИ.ХранитьИсториюИзменений	= Ложь;
			ОбКИ.МеждународныйФорматАдреса	= Ложь;
			
			// БИТ ЖКХ 05.02.2020
			//СписокСвойств = "Наименование, ВключатьСтрануВПредставление,
			//| МожноИзменятьСпособРедактирования, ОбязательноеЗаполнение, ПроверятьКорректность,
			//| РазрешитьВводНесколькихЗначений, РедактированиеТолькоВДиалоге, РеквизитДопУпорядочивания,
			//| СкрыватьНеактуальныеАдреса, Тип";
			СписокСвойств = "Наименование, ВключатьСтрануВПредставление,
			| МожноИзменятьСпособРедактирования, ОбязательноеЗаполнение, ПроверятьКорректность,
			| РазрешитьВводНесколькихЗначений,  РеквизитДопУпорядочивания,
			| СкрыватьНеактуальныеАдреса, Тип";

			ЗаполнитьЗначенияСвойств(ОбКИ, Выборка, СписокСвойств, "Родитель");
			
		КонецЕсли;
		ОбКИ.ОбменДанными.Загрузка = Истина;
		
		ОбКИЖКХ = Выборка.СсылкаКИЖХХ.ПолучитьОбъект();
		ОбКИЖКХ.ОбменДанными.Загрузка = Истина;
		
		Попытка
			ОбКИ.Записать();
			ОбКИЖКХ.ВидКонтактнойИнформации = ОбКИ.Ссылка;
			ОбКИЖКХ.Записать();
		Исключение
			ОтменитьТранзакцию();
			Продолжить;
		КонецПопытки; 
	КонецЦикла;
	ЗафиксироватьТранзакцию();
	
КонецПроцедуры

Функция ПолучитьСоответствиеПредопределенныхВидовКИ()
	
	СоответствиеВидовКИ = Новый Соответствие();
	
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ПустаяСсылка(), Справочники.ВидыКонтактнойИнформации.ПустаяСсылка());
	
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.Документбит_ЗаявлениеОРегистрацииПоМестуПЖ, Справочники.ВидыКонтактнойИнформации.Документбит_ЗаявлениеОРегистрацииПоМестуПЖ);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.КудаВыписанПредставление, Справочники.ВидыКонтактнойИнформации.КудаВыписанПредставление);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ОткудаПрибылПредставление, Справочники.ВидыКонтактнойИнформации.ОткудаПрибылПредставление);
	
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.Справочникбит_ОрганыФМС, Справочники.ВидыКонтактнойИнформации.Справочникбит_ОрганыФМС);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ВебСтраницаОрганаФМС, Справочники.ВидыКонтактнойИнформации.ВебСтраницаОрганаФМС);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ТелефонОрганаФМС, Справочники.ВидыКонтактнойИнформации.ТелефонОрганаФМС);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ФактАдресОрганаФМС, Справочники.ВидыКонтактнойИнформации.ФактАдресОрганаФМС);

	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.Справочникбит_ПодразделенияОрганизаций, Справочники.ВидыКонтактнойИнформации.Справочникбит_ПодразделенияОрганизаций);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.АдресПодразделенияОрганизации, Справочники.ВидыКонтактнойИнформации.АдресПодразделенияОрганизации);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ТелефонПодразделенияОрганизации, Справочники.ВидыКонтактнойИнформации.ТелефонПодразделенияОрганизации);
	
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.Справочникбит_Проживающие, Справочники.ВидыКонтактнойИнформации.Справочникбит_Проживающие);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.EmailПроживающего, Справочники.ВидыКонтактнойИнформации.EmailПроживающего);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ИнформАдресПроживающего, Справочники.ВидыКонтактнойИнформации.ИнформАдресПроживающего);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ЮрАдресПроживающего, Справочники.ВидыКонтактнойИнформации.ЮрАдресПроживающего);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ФактАдресПроживающего, Справочники.ВидыКонтактнойИнформации.ФактАдресПроживающего);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ИнострАдресПроживающего, Справочники.ВидыКонтактнойИнформации.ИнострАдресПроживающего);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.АдресУбытия, Справочники.ВидыКонтактнойИнформации.АдресУбытия);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.АдресПрибытия, Справочники.ВидыКонтактнойИнформации.АдресПрибытия);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.АдресПрибытияДрРегион, Справочники.ВидыКонтактнойИнформации.АдресПрибытияДрРегион);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ДругаяИнформацияПроживающего, Справочники.ВидыКонтактнойИнформации.ДругаяИнформацияПроживающего);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ТелефонПроживающего, Справочники.ВидыКонтактнойИнформации.ТелефонПроживающего);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ТелефонСлужебныйПроживающего, Справочники.ВидыКонтактнойИнформации.ТелефонСлужебныйПроживающего);
	
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.Справочникбит_СписокЗданий, Справочники.ВидыКонтактнойИнформации.Справочникбит_СписокЗданий);
	СоответствиеВидовКИ.Вставить(Справочники.бит_ВидыКонтактнойИнформацииЖКХ.ПочтовыйАдресЗдания, Справочники.ВидыКонтактнойИнформации.ПочтовыйАдресЗдания);
	
	Возврат СоответствиеВидовКИ;
	
КонецФункции

Процедура ОбновитьТабличныеЧастиКонтактнойИнформации()
	
	Перем ТекущаяСсылка;
	Перем Об;
	СоответствиеВидовКИ = ПолучитьСоответствиеВидовКИ(); 
	
	// Органы ФМС, ЗАГС, милиции.
	ТекущаяСсылка = Неопределено;
	Об = Неопределено;
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_ОрганыФМС.Ссылка КАК Ссылка
	|ПОМЕСТИТЬ ВТ_ОрганыФМСКИ
	|ИЗ
	|	Справочник.бит_ОрганыФМС.КонтактнаяИнформация КАК бит_ОрганыФМС
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Ссылка
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ОрганыФМСУдалитьКонтактнаяИнформация.Ссылка КАК Ссылка,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.Тип КАК Тип,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.Вид КАК Вид,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.Представление КАК Представление,
	|	ВЫРАЗИТЬ(ОрганыФМСУдалитьКонтактнаяИнформация.ЗначенияПолей КАК СТРОКА(1024)) КАК ЗначенияПолей,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.Страна КАК Страна,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.Регион КАК Регион,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.Город КАК Город,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.АдресЭП КАК АдресЭП,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.ДоменноеИмяСервера КАК ДоменноеИмяСервера,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.НомерТелефона КАК НомерТелефона,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.НомерТелефонаБезКодов КАК НомерТелефонаБезКодов,
	|	ОрганыФМСУдалитьКонтактнаяИнформация.ВидДляСписка КАК ВидДляСписка
	|ИЗ
	|	Справочник.бит_ОрганыФМС.УдалитьКонтактнаяИнформация КАК ОрганыФМСУдалитьКонтактнаяИнформация
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ОрганыФМСКИ КАК ВТ_ОрганыФМСКИ
	|		ПО ОрганыФМСУдалитьКонтактнаяИнформация.Ссылка = ВТ_ОрганыФМСКИ.Ссылка
	|ГДЕ
	|	ВТ_ОрганыФМСКИ.Ссылка ЕСТЬ NULL
	|
	|УПОРЯДОЧИТЬ ПО
	|	Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		Если ТекущаяСсылка <> Неопределено И ТекущаяСсылка <> Выборка.Ссылка Тогда
			Попытка
				Об.ОбменДанными.Загрузка = Истина;
				Об.Записать();
			Исключение
				Продолжить;
			КонецПопытки;	
