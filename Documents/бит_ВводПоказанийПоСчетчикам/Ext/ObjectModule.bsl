#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем мПодкруткаНаЛС       Экспорт; // Хранит флаг настройки ЖКХ.
Перем мСчетчикиПодкрутка   Экспорт; // Хранит флаг настройки ЖКХ.
Перем мВариантПодкрутки Экспорт; // Хранит флаг настройки ЖКХ.
Перем мКоличествоМесяцевПодкрутки Экспорт; // Хранит флаг настройки ЖКХ.

Перем колвоМесяцевПодкрутки;

#КонецОбласти

#Область ОбеспечениеПроведенияДокумента

Процедура ОбновитьПараметрыЖКХ() Экспорт
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("СчетчикиПодкрутка"         , Ложь);
	ПараметрыЖКХ.Вставить("ПодкруткаНаЛС"             , Ложь);
	ПараметрыЖКХ.Вставить("ВариантПодкрутки"         , Перечисления.бит_ВариантыПодкрутки.ПустаяСсылка());
	ПараметрыЖКХ.Вставить("КоличествоМесяцевПодкрутки", 0);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Дата), Организация, ПараметрыЖКХ);
	
	мПодкруткаНаЛС              = ПараметрыЖКХ.ПодкруткаНаЛС;
	мСчетчикиПодкрутка          = ПараметрыЖКХ.СчетчикиПодкрутка;
	мВариантПодкрутки           = ПараметрыЖКХ.ВариантПодкрутки;
	мКоличествоМесяцевПодкрутки = ПараметрыЖКХ.КоличествоМесяцевПодкрутки;
	
КонецПроцедуры

//  Процедура выполняет заполнение таблицы показаний.
//
Процедура ЗаполнитьТаблицуПоказаний(СортироватьПоНомеруКвартиры = ложь) Экспорт
	
	колвоМесяцевПодкрутки = 0;
	
	ОбновитьПараметрыЖКХ();
	
	ПоказанияПоСчетчикам.Очистить();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Дата));
	Запрос.УстановитьПараметр("ТипСчетчика", ТипСчетчика);
	
	Если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаТриМесяцаСПереходомВНорматив Тогда
		мКоличествоМесяцевПодкрутки = 3;
	КонецЕсли;
	
    //4.11.2018
	Если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив Тогда
		//22.02.2019
		мКоличествоМесяцевПодкрутки = 6;
	КонецЕсли;

	Если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоНорме Тогда
		//9.04.2019
		мКоличествоМесяцевПодкрутки = 0;
	КонецЕсли;

	
	Запрос.УстановитьПараметр("КолМесяцевПодкрутка", мКоличествоМесяцевПодкрутки);
	
	Если мКоличествоМесяцевПодкрутки = 0 Тогда
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(Дата));
		Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Дата));
		
	Иначе
		
		Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДобавитьМесяц(Дата, -мКоличествоМесяцевПодкрутки)));
		Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ДобавитьМесяц(Дата, -1)));
		
	КонецЕсли; 
	
	ТекстУсловия = "ТипСчетчика = &ТипСчетчика";
	
	Если ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
		
		Если Не Дом = Справочники.бит_СписокЗданий.ПустаяСсылка() Тогда    // по дому.
			Запрос.УстановитьПараметр("Объект",Дом);
			ТекстУсловия = ТекстУсловия + " И Объект = &Объект";
		ИначеЕсли НЕ Улица = Справочники.бит_СписокУлиц.ПустаяСсылка() Тогда    // по улице.
			Запрос.УстановитьПараметр("Улица",Улица);
			ТекстУсловия = ТекстУсловия + " И Объект.Улица = &Улица"
		// БИТ ЖКХ 19.10.2020	
		ИначеЕсли СортироватьПоНомеруКвартиры = истина И НЕ Квартира = Справочники.бит_Квартиры.ПустаяСсылка() Тогда    // по квартире.
			Запрос.УстановитьПараметр("Квартира", Квартира);
			ТекстУсловия = ТекстУсловия + " И Объект.Квартира = &Квартира"
		КонецЕсли;
		
	Иначе
		
		Если НЕ ЛицевойСчет = Справочники.бит_ЛицевыеСчета.ПустаяСсылка() Тогда // по лицевому счету.
			Запрос.УстановитьПараметр("Объект",ЛицевойСчет);
			ТекстУсловия = ТекстУсловия + " И Объект = &Объект";
		ИначеЕсли Не Дом = Справочники.бит_СписокЗданий.ПустаяСсылка() Тогда    // по дому.
			Запрос.УстановитьПараметр("Здание",Дом);
			ТекстУсловия = ТекстУсловия + " И Объект.Здание = &Здание";
		ИначеЕсли НЕ Улица = Справочники.бит_СписокУлиц.ПустаяСсылка() Тогда    // по улице.
			Запрос.УстановитьПараметр("Улица",Улица);
			ТекстУсловия = ТекстУсловия + " И Объект.УлицаЛицевогоСчета = &Улица"
		КонецЕсли;	
		// БИТ ЖКХ 26.10.2020	
		Если СортироватьПоНомеруКвартиры = истина тогда
			Если НЕ Улица = Справочники.бит_СписокУлиц.ПустаяСсылка() И 
				  Не Дом = Справочники.бит_СписокЗданий.ПустаяСсылка() И
				   НЕ Квартира = Справочники.бит_Квартиры.ПустаяСсылка() Тогда    // по квартире.
				Запрос.УстановитьПараметр("Квартира", Квартира);
				ТекстУсловия = ТекстУсловия + " И Объект.Квартира = &Квартира"
			КонецЕсли;
		конецесли;
		
	КонецЕсли;
	
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Объект КАК Объект,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга КАК Услуга,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик КАК Счетчик,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик.Разрядность КАК Разрядность,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга.Приоритет КАК Приоритет,
	|	бит_СчетчикиНаУслугахСрезПоследних.Многотарифный КАК Многотарифный,
	|	бит_СчетчикиНаУслугахСрезПоследних.Период КАК Период,
	|	бит_СчетчикиНаУслугахСрезПоследних.СчетчикСЗависимымиУслугами КАК СчетчикСЗависимымиУслугами,
	|	бит_СчетчикиНаУслугахСрезПоследних.ОсновнаяУслуга КАК ОсновнаяУслуга
	|ПОМЕСТИТЬ Счетчики
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Дата, "+ ТекстУсловия +") КАК бит_СчетчикиНаУслугахСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.Использовать
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	Счетчики.Объект КАК Объект,
	|	Счетчики.Услуга КАК Услуга,
	|	Счетчики.Счетчик КАК Счетчик,
	|	Счетчики.Разрядность КАК Разрядность,
	|	Счетчики.Приоритет КАК Приоритет,
	|	Счетчики.Многотарифный КАК Многотарифный,
	|	Счетчики.Период КАК Период,
	|	Счетчики.СчетчикСЗависимымиУслугами КАК СчетчикСЗависимымиУслугами,
	|	Счетчики.ОсновнаяУслуга КАК ОсновнаяУслуга
	|ПОМЕСТИТЬ Счетчики_Полн
	|ИЗ
	|	Счетчики КАК Счетчики
	|
	|ОБЪЕДИНИТЬ
	|
	|ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.Разрядность,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга.Приоритет,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Период,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СчетчикСЗависимымиУслугами,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ОсновнаяУслуга
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)
	|				И Счетчик В
	|					(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|						Таб.Счетчик
	|					ИЗ
	|						Счетчики КАК Таб)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Объект,
	|	Услуга,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	Счетчики_Полн.Счетчик КАК Счетчик
	|ПОМЕСТИТЬ ВТ_Счетчики
	|ИЗ
	|	Счетчики_Полн КАК Счетчики_Полн
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПоказанияСчетчиков.Объект КАК ЛицевойСчет,
	|	бит_ПоказанияСчетчиков.Услуга КАК УслугаЖКХ,
	|	бит_ПоказанияСчетчиков.Счетчик КАК Счетчик,
	|	бит_ПоказанияСчетчиков.ПоказанияПодкрутка КАК ПоказанияПодкрутка
	|ПОМЕСТИТЬ ВТ_ПоказанияПодкрутки
	|ИЗ
	|	РегистрНакопления.бит_ПоказанияСчетчиков КАК бит_ПоказанияСчетчиков
	|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Счетчики КАК ВТ_Счетчики
	|		ПО бит_ПоказанияСчетчиков.Счетчик = ВТ_Счетчики.Счетчик
	|ГДЕ
	|	бит_ПоказанияСчетчиков.Период МЕЖДУ &НачалоПериода И &КонецПериода
	|	И бит_ПоказанияСчетчиков.ВидДвижения = ЗНАЧЕНИЕ(ВидДвиженияНакопления.Приход)
	|	И бит_ПоказанияСчетчиков.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	бит_ПоказанияСчетчиков.Объект,
	|	бит_ПоказанияСчетчиков.Услуга,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоказанияПодкрутки.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_ПоказанияПодкрутки.УслугаЖКХ КАК УслугаЖКХ,
	|	ВТ_ПоказанияПодкрутки.Счетчик КАК Счетчик,
	|	СУММА(1) КАК КоличествоМесяцев,
	|	СУММА(ВЫБОР
	|			КОГДА ВТ_ПоказанияПодкрутки.ПоказанияПодкрутка = 0
	|				ТОГДА 0
	|			ИНАЧЕ 1
	|		КОНЕЦ) КАК КоличествоМесяцевПодкрутки
	|ПОМЕСТИТЬ ВТ_ПоказанияПодкруткиИтого
	|ИЗ
	|	ВТ_ПоказанияПодкрутки КАК ВТ_ПоказанияПодкрутки
	|
	|СГРУППИРОВАТЬ ПО
	|	ВТ_ПоказанияПодкрутки.ЛицевойСчет,
	|	ВТ_ПоказанияПодкрутки.УслугаЖКХ,
	|	ВТ_ПоказанияПодкрутки.Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_КолЕдиницПоСчетчикамОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_КолЕдиницПоСчетчикамОбороты.УслугаЖКХ КАК УслугаЖКХ,
	|	бит_КолЕдиницПоСчетчикамОбороты.Счетчик КАК Счетчик,
	|	СУММА(бит_КолЕдиницПоСчетчикамОбороты.КоличествоЕдиницПоЛСОборот + бит_КолЕдиницПоСчетчикамОбороты.КоличествоЕдПодкруткаОборот) КАК КоличествоЕдиниц
	|ПОМЕСТИТЬ ВТ_КолЕдиницПоСчетчикам
	|ИЗ
	|	РегистрНакопления.бит_КолЕдиницПоСчетчикам.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			Счетчик В
	|				(ВЫБРАТЬ
	|					ВТ_Счетчики.Счетчик
	|				ИЗ
	|					ВТ_Счетчики КАК ВТ_Счетчики)) КАК бит_КолЕдиницПоСчетчикамОбороты
	|ГДЕ
	|	НЕ бит_КолЕдиницПоСчетчикамОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_КолЕдиницПоСчетчикамОбороты.ЛицевойСчет,
	|	бит_КолЕдиницПоСчетчикамОбороты.УслугаЖКХ,
	|	бит_КолЕдиницПоСчетчикамОбороты.Счетчик
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет,
	|	УслугаЖКХ,
	|	Счетчик
	|;
