#Область ПроцедурыИФункцииПечати

// Заполняет список команд печати.

//

// Параметры:

//   КомандыПечати – ТаблицаЗначений – состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.

//

Процедура ДобавитьКомандыПечати(КомандыПечати) Экспорт
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ПФ_DOCX_Макет";
	КомандаПечати.Представление = НСтр("ru = 'Заявление по исполнительным листам (Word)'");
	КомандаПечати.СписокФорм = "ФормаДокумента, ФормаСписка";;
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.Порядок = 1;    
	
	КомандаПечати = КомандыПечати.Добавить();
	КомандаПечати.Идентификатор = "ПФ_DOCX_Сопроводительное";
	КомандаПечати.Представление = НСтр("ru = 'Сопроводительное у заявлениям по исполнительным листам (Word)'");
	КомандаПечати.СписокФорм = "ФормаДокумента, ФормаСписка";;
	КомандаПечати.ПроверкаПроведенияПередПечатью = Ложь;
	КомандаПечати.Порядок = 2;    

КонецПроцедуры



Процедура Печать(МассивОбъектов, ПараметрыПечати, КоллекцияПечатныхФорм, ОбъектыПечати, ПараметрыВывода) Экспорт
	
	Если УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_DOCX_Макет") Тогда
		
		ПечатнаяФорма = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм,"ПФ_DOCX_Макет");
		Если ПечатнаяФорма <> Неопределено Тогда		
			ОфисныеДокументы = НапечататьЗаявление(МассивОбъектов);
			ПечатнаяФорма.СинонимМакета = НСтр("ru = 'Печать заявления (Word)'");
			ПечатнаяФорма.ОфисныеДокументы = ОфисныеДокументы;
			ПечатнаяФорма.ТабличныйДокумент = Новый ТабличныйДокумент();
		КонецЕсли;
	ИначеЕсли УправлениеПечатью.НужноПечататьМакет(КоллекцияПечатныхФорм, "ПФ_DOCX_Сопроводительное") Тогда
		ПечатнаяФорма2 = УправлениеПечатью.СведенияОПечатнойФорме(КоллекцияПечатныхФорм,"ПФ_DOCX_Сопроводительное" );
		Если ПечатнаяФорма2 <> Неопределено Тогда
			//Для Каждого Объект Из МассивОбъектов Цикл
				//Формируются массивы ссылок для печати сопроводительных
				//МассивДляПечати = СформироватьМассивСсылокДляСопроводительного(Объект);
				
				ОфисныеДокументы = НапечататьСопроводительноеПисьмо(МассивОбъектов);
				ПечатнаяФорма2.СинонимМакета = НСтр("ru = 'Печать сопроводительного к заявлениям (Word)'");
				ПечатнаяФорма2.ОфисныеДокументы = ОфисныеДокументы;
				ПечатнаяФорма2.ТабличныйДокумент = Новый ТабличныйДокумент();
			//КонецЦикла;
		КонецЕсли;
	КонецЕсли;
КонецПроцедуры     

Функция ПолучитьСсылкиНаДокументыПоОднойСсылке(МассивСоответствий, МассивОбъектов, СписокСтатусов)        
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ИсполнительныйЛист.Ссылка КАК Ссылка,
	|	бит_ИсполнительныйЛист.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ИсполнительныйЛист.Статус КАК Статус
	|ИЗ
	|	Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.СтатусыПоИсполнительнымЛистам.СрезПоследних КАК СтатусыПоИсполнительнымЛистамСрезПоследних
	|		ПО (СтатусыПоИсполнительнымЛистамСрезПоследних.ИсполнительныйЛист = бит_ИсполнительныйЛист.Ссылка)
	|ГДЕ
	|	(бит_ИсполнительныйЛист.ЛицевойСчет.Здание = &Адрес
	|			ИЛИ &СодРем)
	|	И СтатусыПоИсполнительнымЛистамСрезПоследних.СтатусДокумента В(&СтатусДокумента)
	|	И НАЧАЛОПЕРИОДА(бит_ИсполнительныйЛист.Дата, ДЕНЬ) = &Дата
	|	И бит_ИсполнительныйЛист.Услуга = &Услуга
	|ИТОГИ ПО
	|	Статус";  
	
	СодРемУслуга = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001");
	Запрос.УстановитьПараметр("Дата", НачалоДня(МассивОбъектов[0].Дата));
	Запрос.УстановитьПараметр("Адрес", МассивОбъектов[0].ЛицевойСчет.Здание);
	Запрос.УстановитьПараметр("СодРем", МассивОбъектов[0].Услуга = СодРемУслуга);                      
	Запрос.УстановитьПараметр("Услуга",  МассивОбъектов[0].Услуга);                      
	
	Запрос.УстановитьПараметр("СтатусДокумента", СписокСтатусов);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаCтатус = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам); 
	Пока ВыборкаCтатус.Следующий() Цикл    
		Выб = ВыборкаCтатус.Выбрать();
		МассивСсылок = Новый Массив();
		Пока Выб.Следующий() Цикл  
			МассивСсылок.Добавить(Выб.Ссылка);
		КонецЦикла;
		МассивСоответствий.Вставить(МассивОбъектов[0].Адрес + ВыборкаCтатус.Статус, МассивСсылок);
    КонецЦикла;
КонецФункции	    

Функция ПолучитьСсылкиНаДокументыПоСписку(МассивСоответствий, МассивОбъектов)        
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ИсполнительныйЛист.Ссылка КАК Ссылка,
	|	бит_ИсполнительныйЛист.Услуга КАК Услуга,
	|	бит_ИсполнительныйЛист.ЛицевойСчет.Здание КАК ЛицевойСчетЗдание,
	|	ВЫБОР
	|		КОГДА бит_ИсполнительныйЛист.Услуга = &Содержание
	|			ТОГДА ""Содержание и ремонт""
	|		ИНАЧЕ бит_ИсполнительныйЛист.ЛицевойСчет.Здание
	|	КОНЕЦ КАК ПолеГруппировки,
	|	бит_ИсполнительныйЛист.Статус КАК Статус
	|ИЗ
	|	Документ.бит_ИсполнительныйЛист КАК бит_ИсполнительныйЛист
	|ГДЕ
	|	бит_ИсполнительныйЛист.Ссылка В(&МассивСсылок)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ИсполнительныйЛист.Услуга,
	|	бит_ИсполнительныйЛист.Ссылка,
	|	бит_ИсполнительныйЛист.ЛицевойСчет.Здание
	|ИТОГИ ПО  
	|   Статус,
	|	Услуга,
	|	ПолеГруппировки";
	
	Запрос.УстановитьПараметр("МассивСсылок", МассивОбъектов);
	Запрос.УстановитьПараметр("Содержание", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000001"));
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаCтатус = РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаCтатус.Следующий() Цикл
		
		ВыборкаУслуга = ВыборкаCтатус.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаУслуга.Следующий() Цикл
			
			ВыборкаПолеГруппировки = ВыборкаУслуга.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаПолеГруппировки.Следующий() Цикл
				МассивСсылок = Новый массив();
				ВыборкаДетальныеЗаписи = ВыборкаПолеГруппировки.Выбрать();
				
				Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
					МассивСсылок.Добавить(ВыборкаДетальныеЗаписи.Ссылка);	
				КонецЦикла;    
				МассивСоответствий.Вставить(Строка(ВыборкаПолеГруппировки.ПолеГруппировки) + СТрока(ВыборкаПолеГруппировки.Статус) ,МассивСсылок);
			КонецЦикла;
			
		КонецЦикла;
	КонецЦикла;
	
КонецФункции
	
//Печать заявления
Функция НапечататьЗаявление(МассивОбъектов)
	МассивСоответствий = Новый Соответствие;
	Статусы = Новый Массив();
	Статусы.Добавить(Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВОСП); 
	Статусы.Добавить(Перечисления.СтатусыПоИсполнительнымЛистам.ПовторноНаправленВОСП); 
    МассивЗаявл = Новый Массив();
	МассивЗаявл.Добавить(МассивОбъектов[0]);
	ОфисныеДокументы = Новый Соответствие;
	Если  Статусы.Найти(МассивОбъектов[0].Статус) = Неопределено Тогда
		возврат ОфисныеДокументы;
	Иначе 
		МассивСоответствий.Вставить(МассивОбъектов[0].Адрес , МассивЗаявл);
	КонецЕсли;
	
	МакетДокумента = ПолучитьМакет("ПФ_DOCX_Макет");
	Шаблон = НСтр("ru = 'Заявление исп.лист №[Номер] от [Дата]'");
	
	Для Каждого ИсполнительныйЛист из МассивСоответствий Цикл
		Если ИсполнительныйЛист.Значение.Количество() = 0 Тогда  
			Продолжить;
		КонецЕсли;
		Макет = УправлениеПечатью.ИнициализироватьМакетОфисногоДокумента(МакетДокумента, Неопределено);
		Если Макет = Неопределено Тогда
			Возврат "";
		КонецЕсли;
		
		ОписаниеОбластей = Новый Структура;
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Шапка",         		   "Общая");
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "СтрокаТаблицы",           "СтрокаТаблицы");
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "СчетКапРемонт",           "Общая");
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Счет",           		   "Общая");
		УправлениеПечатью.ДобавитьОписаниеОбласти(ОписаниеОбластей, "Подвал",         		   "Общая");
		
		ДанныеДляПечати = ПолучитьДанныеДляПечати(ИсполнительныйЛист.Значение,"ПФ_DOCX_Макет");
		ТЧДолжники = ДанныеДляПечати.ТЧДолжники;     
		Статус = ДанныеДляПечати.Статус;
		Услуга = ДанныеДляПечати.Услуга;
		ДатаДокумента = ДанныеДляПечати.ДатаДокумента;
		БанковскиеРеквизиты = ДанныеДляПечати.БанковскиеРеквизиты;
		
		ДанныеПоШапке = Новый Структура("КапРемонт,ШапкаКапРемонт,ТекущийГод","","");
		УслугаКапРемонт = КапитальныйРемонт(Услуга.Наименование);
		Если УслугаКапРемонт Тогда
			ДанныеПоШапке.Вставить("КапРемонт", "КАПИТАЛЬНЫЙ РЕМОНТ");
			ДанныеПоШапке.Вставить("ШапкаКапРемонт"," по взысканию задолженности по капитальному ремонту, вынесенный на основании решения мирового судьи в городе Омске Омской области");
		Иначе
			ДанныеПоШапке.Вставить("КапРемонт", "«СОДЕРЖАНИЕ И РЕМОНТ ОБЩЕГО ИМУЩЕСТВА»");
		КонецЕсли;                               
		ДанныеПоШапке.Вставить("ТекущийГод", Формат(ТекущаяДата(),"ДФ=yyyy"));
		ПечатнаяФорма = УправлениеПечатью.ИнициализироватьПечатнуюФорму(Неопределено, Неопределено, Макет);
		Если ПечатнаяФорма = Неопределено Тогда
			УправлениеПечатью.ОчиститьСсылки(Макет);
			Возврат ОфисныеДокументы;
		КонецЕсли;
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["Шапка"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма,Область,ДанныеПоШапке);
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["СтрокаТаблицы"]);
		УправлениеПечатью.ПрисоединитьИЗаполнитьКоллекцию(ПечатнаяФорма, Область, ТЧДолжники);
		
		Если УслугаКапРемонт Тогда
			Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["СчетКапРемонт"]);
			УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма,Область,БанковскиеРеквизиты);
		Иначе
			Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["Счет"]);
			УправлениеПечатью.ПрисоединитьОбласть(ПечатнаяФорма, Область);
		КонецЕсли;
		
		Область = УправлениеПечатью.ОбластьМакета(Макет, ОписаниеОбластей["Подвал"]);
		УправлениеПечатью.ПрисоединитьОбластьИЗаполнитьПараметры(ПечатнаяФорма,Область,Подписант(ИсполнительныйЛист));
		
		АдресХранилищаПечатнойФормы = УправлениеПечатью.СформироватьДокумент(ПечатнаяФорма);
		УправлениеПечатью.ОчиститьСсылки(ПечатнаяФорма);
		
		ИмяДокумента = "Заявление по исполнительному листу  " 
		+ Строка(ИсполнительныйЛист.Ключ) 
		+ " от " + Строка(Формат(ТекущаяДата(),"ДФ = дд.мм.гг")) 
		+  ".doc";
		ОфисныеДокументы.Вставить(АдресХранилищаПечатнойФормы,ИмяДокумента);
		
		УправлениеПечатью.ОчиститьСсылки(Макет);
	КонецЦикла;
	
	Возврат ОфисныеДокументы;
	
КонецФункции 

//Возвращает статус, соответствующий переданному
Функция ПолучитьСтатусСоответствия(Статус)
	СоответствиеСтатусов = Новый Соответствие;
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВБанк, Перечисления.СтатусыПоИсполнительнымЛистам.ПовторноНаправленВБанк);
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыПоИсполнительнымЛистам.ПовторноНаправленВБанк, Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВБанк);
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВОСП, Перечисления.СтатусыПоИсполнительнымЛистам.ПовторноНаправленВОСП);
	СоответствиеСтатусов.Вставить(Перечисления.СтатусыПоИсполнительнымЛистам.ПовторноНаправленВОСП, Перечисления.СтатусыПоИсполнительнымЛистам.НаправленВОСП);
	Возврат СоответствиеСтатусов.Получить(Статус);
КонецФункции

