&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Вывести в заголовке формы вид операции и статус документа (новый, не проведен, проведен).
	УстановитьЗаголовокФормыДокумента();
	
	// Зададим имена реквизитов, подлежащих кешированию.
	мКэшРеквизитовФормы = Новый Структура;
	
	// Запомним текущие значения реквизитов формы.
	ЗаполнитьТекущиеЗначенияРеквизитовФормы();
	
	// Установить доступность формы с учетом даты запрета редактирования.
	УстановитьДоступностьФормыДляРедактированияНаСервере();
	
	Если мТаблицаНачисленийПени = Неопределено И Объект.СписокЛС.Количество() > 0 Тогда
		
		ПолучитьНачисленияПениНаСервере();
		
	КонецЕсли; 
	
	// Установить доступность формы с учетом даты запрета редактирования.
	УстановитьДоступностьФормыДляРедактированияНаСервере();
	
	мСтруктураСчетовЖКХ = бит_ОбщегоНазначения.ПолучитьСчетаРасчетовЖКХ(Объект.Организация,КонецМесяца(Объект.Дата));
	
	мКэшЗначений.Вставить("мСтруктураСчетовЖКХ", мСтруктураСчетовЖКХ);
	
	УправлениеЭлементамиФормы();
	
	ОбновитьДанныеКолонкиАдрес();
	
	ОбновитьДанныеКолонкиОтветственный();
	
	ИнтерфейсТакси = ТекущийВариантИнтерфейсаКлиентскогоПриложения() = ВариантИнтерфейсаКлиентскогоПриложения.Такси;
	
	Если НЕ ИнтерфейсТакси Тогда
		
		Элементы.Группа4.Высота = 0;
		Элементы.Группа4.РастягиватьПоВертикали = Истина; 
		
		Элементы.ГруппаСписокЛС.Высота = 0;
		Элементы.ГруппаСписокЛС.РастягиватьПоВертикали = Истина; 
		
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если Объект.Проведен Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Перед изменением таблицы лицевых счетов - распроведите документ";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли; 
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая" Тогда
		
		ТаблицаЛСНаСервере(ВыбранноеЗначение.АдресЛСВХранилище);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если НЕ Объект.Проведен
		И ПараметрыЗаписи.РежимЗаписи = РежимЗаписиДокумента.Проведение
		И ДокументРассчитан = Ложь
		И мКэшЗначений.мНеРаспределятьОплатуПослеВводаСуммы Тогда
		
		ВыполнитьРасчетНаСервере();
		УдалитьПустыеСтрокиНаСервере();
		ОбновитьДанныеКолонкиАдрес();
		ОбновитьДанныеКолонкиОтветственный();
		Элементы.СписокУслугСуммаПени.Видимость = ?(Объект.СписокУслуг.Итог("СуммаПени") <> 0 ИЛИ Объект.ВводВРучную, Истина, Ложь);
		
	КонецЕсли;
	
	Объект.СуммаДокумента = Объект.СписокЛС.Итог("Сумма");
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Событие = "Штрихкод" Тогда
		
		Попытка
			
			Массив=МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам(,,МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента());
			
			Для Каждого Стр из Массив Цикл
				Если Стр.ТипОборудования=ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.СканерШтрихкода") Тогда
					
					Результат = бит_ОбработатьСобытиеСШК(Объект, Данные);
					
				КонецЕсли;
			КонецЦикла;
			
		Исключение
			
		КонецПопытки;
		
		Если НЕ мКэшЗначений.мНеРаспределятьОплатуПослеВводаСуммы Тогда
			ВыполнитьРасчетНаСервере();
		Иначе	
			ДокументРассчитан = Ложь;
		КонецЕсли; 
		
		ЗаполнитьСчетаНаСервере();
		
	КонецЕсли;
	
	ОбновитьДанныеКолонкиАдрес();
	
	ОбновитьДанныеКолонкиОтветственный();
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаПоПериодуПриИзменении(Элемент)
	
	Элементы.ПериодОплаты.Видимость = Объект.ОплатаПоПериоду;
	ПериодОплаты.ДатаНачала	   = Дата('00010101');
	ПериодОплаты.ДатаОкончания = Дата('00010101');
	Объект.НачалоПериодаОплаты = Дата('00010101');
	Объект.КонецПериодаОплаты  = Дата('00010101');
	
	Если Объект.ОплатаПоПериоду И Объект.СписокУслугПоПериоду.Количество() > 0 Тогда
		ТекстВопроса = НСтр("ru = 'Выполнить установку шаблона ""По всем за месяц (Период)"" для всех ЛС?'");
		ПоказатьВопрос(Новый ОписаниеОповещения("ОплатаПоПериодуЗавершение", ЭтотОбъект), ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	КонецЕсли;
	Объект.СписокУслуг.Очистить();
	//Объект.СписокУслугПоПериоду.Очистить();
	
	
	// Настрока параметров выбора.
	Если Объект.ОплатаПоПериоду Тогда
		НовыйПараметрСальдо = Новый ПараметрВыбора("Отбор.Сальдо", ПредопределенноеЗначение("Перечисление.ДаНет.Нет"));
		НовыйПараметрКредит = Новый ПараметрВыбора("Отбор.Кредит", ПредопределенноеЗначение("Перечисление.ДаНет.Нет"));
		НовыйМассив = Новый Массив();
		НовыйМассив.Добавить(НовыйПараметрСальдо);
		НовыйМассив.Добавить(НовыйПараметрКредит);
		НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		Элементы.СписокЛСШаблонИзвещений.ПараметрыВыбора = НовыеПараметры;
	Иначе
		НовыйМассив = Новый Массив();
		НовыеПараметры = Новый ФиксированныйМассив(НовыйМассив);
		Элементы.СписокЛСШаблонИзвещений.ПараметрыВыбора = НовыеПараметры;
	КонецЕсли;
	
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаПоПериодуЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	КонецЕсли;
	
	Для каждого Строка Из Объект.СписокЛС Цикл
		Строка.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемЗаМесяц");	
	КонецЦикла; 
	
	Элементы.ПериодОплаты.Видимость = Объект.ОплатаПоПериоду;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	Если СканерШтрихкода Тогда
		ТипыПО = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("СканерШтрихкода");
		ОповещенияПриПодключении = Новый ОписаниеОповещения("ОтключитьСканерШКЗавершение", ЭтотОбъект, Новый Структура("Форма", ЭтаФорма));
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПоТипу(ОповещенияПриПодключении, УникальныйИдентификатор, ТипыПО);
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОтключитьСканерШКЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если Не РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'При отключении оборудования произошла ошибка: ""%1"".'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		СканерШтрихкода = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если СканерШтрихкода И ЗавершениеРаботы Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

