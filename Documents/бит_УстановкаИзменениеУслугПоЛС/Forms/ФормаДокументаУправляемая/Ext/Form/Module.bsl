// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
&НаСервереБезКонтекста
Функция ЗаполнитьСведенияПоУслуге(Знач Дата, Знач ЛицевойСчет, Знач Услуга)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Дата"       , Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("Услуга"     , Услуга);
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&Дата,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Сведения  = Новый Структура;	
	
	Если Выборка.Следующий() Тогда
		
		Сведения.Вставить("РежимПотребления",            Выборка.РежимПотребления);
		Сведения.Вставить("Поставщик",                   Выборка.Поставщик);
		Сведения.Вставить("СпособРасчета",               Выборка.СпособРасчета);
		Сведения.Вставить("КоличествоЕдиницПотребления", Выборка.КоличествоЕдиницПотребления);
		
	Иначе
		
		Сведения.Вставить("РежимПотребления",            Неопределено);
		Сведения.Вставить("Поставщик",                   Неопределено);
		Сведения.Вставить("СпособРасчета",               Неопределено);
		Сведения.Вставить("КоличествоЕдиницПотребления", Неопределено);
		
	КонецЕсли;
	
	Возврат Сведения;
	
КонецФункции // () 

&НаСервере
Процедура ЗагрузитьЛицевыеСчетаНаСервере()
	
	ТЗ = Объект.ЛицевыеСчета.Выгрузить();
	
	Если ЗначениеЗаполнено(РежимПотребления) Тогда
		
		ТЗ.ЗаполнитьЗначения(РежимПотребления, "РежимПотребления");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Поставщик) Тогда
		
		ТЗ.ЗаполнитьЗначения(Поставщик, "Поставщик");
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СпособРасчета) Тогда
		
		Для Каждого СтрокаТЗ Из ТЗ Цикл
			
			Если Не СтрокаТЗ.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам Тогда
				
				СтрокаТЗ.СпособРасчета = СпособРасчета;
				
			КонецЕсли;
			
		КонецЦикла;				
		
		Если СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления 
			Или СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет Тогда
			
			ТЗ.ЗаполнитьЗначения(КоличествоЕдиницПотребления, "КоличествоЕдиницПотребления");
			
		КонецЕсли;
		
	КонецЕсли;
	
	Объект.ЛицевыеСчета.Загрузить(ТЗ);
	
КонецПроцедуры

Процедура ОбработкаВыбораНаСервере(ВыбранноеЗначение)
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресЛСВХранилище);
	
	Если ТаблицаЛС = Неопределено Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка получения данных из временного хранилища. Выполните подбор заново.");
	Иначе	
		
		Для Каждого СтрокаТаблицы Из ТаблицаЛС Цикл
			
			ЛС =  СтрокаТаблицы.ЛицевойСчет;
			
			Если ПроверитьУслугуНаЗдании(КонецМесяца(Объект.Дата), ЛС.Здание, Объект.Услуга) Тогда
				
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Услуга :" + Объект.Услуга + " не подключена по адресу лицевого счета:"+ ЛС +", ул. "+ ЛС.УлицаЛицевогоСчета +", д."+ ЛС.Здание);
				Продолжить;
				
			КонецЕсли;
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("ЛицевойСчет", ЛС);
			
			СтрокаПоиска = объект.ЛицевыеСчета.НайтиСтроки(Отбор);
			
			Если СтрокаПоиска.Количество() = 0 Тогда
				
				НоваяСтрока = Объект.ЛицевыеСчета.Добавить();
				
				НоваяСтрока.ЛицевойСчет = ЛС;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Функция ПолучитьСписокУслуг()
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	
	ПостроительЗапроса.Текст = 
	"ВЫБРАТЬ
	|	бит_ШаблоныУслугСрезПоследних.Улица,
	|	бит_ШаблоныУслугСрезПоследних.Здание,
	|	бит_ШаблоныУслугСрезПоследних.Услуга,
	|	бит_ШаблоныУслугСрезПоследних.Поставщик
	|ИЗ
	|	РегистрСведений.бит_ШаблоныУслуг.СрезПоследних(&Период, ) КАК бит_ШаблоныУслугСрезПоследних
	|ГДЕ
	|	бит_ШаблоныУслугСрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	ПостроительЗапроса.Параметры.Вставить("Период", КонецДня(Объект.Дата));
	
	Если НЕ ЗначениеЗаполнено(Объект.Улица) И НЕ ЗначениеЗаполнено(Объект.Здание) Тогда
		
		Возврат Неопределено;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Объект.Улица) Тогда
		
		ПостроительЗапроса.Отбор.Добавить("Улица");
		
		ПостроительЗапроса.Отбор.Улица.Установить(Объект.Улица, Истина);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.Здание) Тогда
		
		ПостроительЗапроса.Отбор.Добавить("Здание");
		
		ПостроительЗапроса.Отбор.Здание.Установить(Объект.Здание, Истина);
		
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	Результат = ПостроительЗапроса.Результат.Выгрузить();
	
	Результат.Свернуть("Услуга");
	
	СписокУслуг = Новый СписокЗначений;
	
	СписокУслуг.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Услуга"));
	
	Возврат СписокУслуг;
	
КонецФункции // ()

// БИТ_ЖКХ 13.10.2011 Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции // ПолучитьТипОбъекта()

&НаСервереБезКонтекста 
Функция ПолучитьСписокПоставщиковНаСервере2(ТекущаяУслуга)
	
	СписокПоставщиков = Новый СписокЗначений;
	
