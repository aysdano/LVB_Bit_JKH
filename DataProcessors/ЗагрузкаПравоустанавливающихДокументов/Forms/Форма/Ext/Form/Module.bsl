&НаСервере
Функция НайтиДанныеПоКв(Здание, НомерКвартиры)
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	Попытка 
		//НомерКвартиры = Число(НомерКвартиры);
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_Квартиры.Ссылка КАК Квартира,
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
		|	лб_ОтветственныеЗаЛицевыеСчета.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.лб_ОтветственныеЗаЛицевыеСчета КАК лб_ОтветственныеЗаЛицевыеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
		|			ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
		|		ПО лб_ОтветственныеЗаЛицевыеСчета.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
		|ГДЕ
		|	бит_Квартиры.НомерКвартиры = &НомерКвартиры
		|	И бит_Квартиры.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Владелец", Здание);
		Запрос.УстановитьПараметр("НомерКвартиры", Число(НомерКвартиры));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	Исключение
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_Квартиры.Ссылка КАК Квартира,
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
		|	лб_ОтветственныеЗаЛицевыеСчета.Ответственный КАК Ответственный
		|ИЗ
		|	РегистрСведений.лб_ОтветственныеЗаЛицевыеСчета КАК лб_ОтветственныеЗаЛицевыеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
		|			ПО бит_ЛицевыеСчета.Квартира = бит_Квартиры.Ссылка
		|		ПО лб_ОтветственныеЗаЛицевыеСчета.ЛицевойСчет = бит_ЛицевыеСчета.Ссылка
		|ГДЕ
		|	бит_Квартиры.Наименование = &НомерКвартиры
		|	И бит_Квартиры.Владелец = &Владелец";
		
		Запрос.УстановитьПараметр("Владелец", Здание);
		Запрос.УстановитьПараметр("НомерКвартиры", НомерКвартиры);
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	КонецПопытки;
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Квартира", ВыборкаДетальныеЗаписи.Квартира);
		СтруктураДанных.Вставить("ЛицевойСчет", ВыборкаДетальныеЗаписи.ЛицевойСчет);
		СтруктураДанных.Вставить("Ответственный", ВыборкаДетальныеЗаписи.Ответственный);
		Возврат СтруктураДанных;
	Иначе
		Сообщить("Квартира " + НомерКвартиры + " не найдена");
		СтруктураДанных = Новый Структура;
		СтруктураДанных.Вставить("Квартира", Справочники.бит_Квартиры.ПустаяСсылка());
		СтруктураДанных.Вставить("ЛицевойСчет", Справочники.бит_ЛицевыеСчета.ПустаяСсылка());
		СтруктураДанных.Вставить("Ответственный", Справочники.бит_Проживающие.ПустаяСсылка());
		Возврат СтруктураДанных;
	КонецЕсли;;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	
КонецФункции

