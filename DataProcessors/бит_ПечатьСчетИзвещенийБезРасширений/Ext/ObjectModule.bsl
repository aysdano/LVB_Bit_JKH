				Если НЕ СтрокаТаблицаНастройкиСОИ = Неопределено Тогда			
					НоваяСтрока.СОИ = Истина;
				КонецЕсли;
				//
				
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЦикла;
	
	МВТ.Закрыть();
	
