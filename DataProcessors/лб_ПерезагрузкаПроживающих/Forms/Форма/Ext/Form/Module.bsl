					 НовСтрока.СтатусПроживания = Перечисления.бит_СтатусПроживания.НеПроживает;
					 НовСтрока.ДатаВыписки = '0001-01-01';					 
				КонецЕсли;	
				
				 
				Индекс=0;
				ЧислоСтрок = ТаблИсхЛС.Количество();
				Пока  Индекс <= ЧислоСтрок-1 цикл
					СтрокаИсх = ТаблИсхЛС[Индекс];	
