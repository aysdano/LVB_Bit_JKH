Процедура СформироватьДвиженияПоИсполнительным(СписокЛС,Реквизиты, Движения,Отказ) Экспорт
	
	Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ОплатаКУСписокЛС.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_ОплатаКУСписокЛС.ИсполнительныйЛист КАК ИсполнительныйЛист,
		|	СУММА(ВЫБОР
		|			КОГДА бит_ОплатаКУСписокУслуг.Услуга = &УслугаГоспошлина
		|				ТОГДА бит_ОплатаКУСписокУслуг.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ОплатаГоспошлина,
		|	СУММА(ВЫБОР
		|			КОГДА бит_ОплатаКУСписокУслуг.Услуга = &УслугаПредставительские
		|				ТОГДА бит_ОплатаКУСписокУслуг.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК ОплатаПредставительские,
		|	СУММА(ВЫБОР
		|			КОГДА бит_ОплатаКУСписокУслуг.Услуга = &УслугаГоспошлина
		|					ИЛИ бит_ОплатаКУСписокУслуг.Услуга = &УслугаПредставительские
		|				ТОГДА 0
		|			ИНАЧЕ бит_ОплатаКУСписокУслуг.Сумма
		|		КОНЕЦ) КАК ОплатаУслуга,
		|	бит_ОплатаКУСписокЛС.Ссылка.Дата КАК ДатаОплаты
		|ПОМЕСТИТЬ втОплаты
		|ИЗ
		|	Документ.бит_ОплатаКУ.СписокЛС КАК бит_ОплатаКУСписокЛС
		|		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОплатаКУ.СписокУслуг КАК бит_ОплатаКУСписокУслуг
		|		ПО бит_ОплатаКУСписокЛС.Ссылка = бит_ОплатаКУСписокУслуг.Ссылка
		|			И бит_ОплатаКУСписокЛС.ЛицевойСчет = бит_ОплатаКУСписокУслуг.ЛицевойСчет
		|			И бит_ОплатаКУСписокЛС.лб_КлючСтроки = бит_ОплатаКУСписокУслуг.лб_КлючСтроки
		|ГДЕ
		|	бит_ОплатаКУСписокЛС.Ссылка = &Ссылка
		|	И бит_ОплатаКУСписокЛС.ИсполнительныйЛист <> ЗНАЧЕНИЕ(документ.бит_ИсполнительныйЛист.ПустаяСсылка)
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_ОплатаКУСписокЛС.ЛицевойСчет,
		|	бит_ОплатаКУСписокЛС.ИсполнительныйЛист,
		|	бит_ОплатаКУСписокЛС.Ссылка.Дата
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.Регистратор КАК Регистратор,
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.ЛицевойСчет КАК ЛицевойСчет,
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.ФИОДолжника КАК ФИОДолжника,
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.Услуга КАК Услуга,
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.ИсполнительныйЛист КАК ИсполнительныйЛист,
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.СуммаПриход КАК СуммаПриход,
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.СуммаГоспошлиныПриход КАК СуммаГоспошлиныПриход,
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.СуммаПредставительскихРасходовПриход КАК СуммаПредставительскихРасходовПриход
		|ПОМЕСТИТЬ ВТНачисления
		|ИЗ
		|	РегистрНакопления.ВзаиморасчетыПоИсполнительномуПроизводству.Обороты(
		|			,
		|			,
		|			Регистратор,
		|			ИсполнительныйЛист В
		|				(ВЫБРАТЬ
		|					ВТОплаты.ИсполнительныйЛист
		|				ИЗ
		|					ВТОплаты КАК ВТОплаты)) КАК ВзаиморасчетыПоИсполнительномуПроизводствуОбороты
		|ГДЕ
		|	ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.Регистратор В
		|			(ВЫБРАТЬ
		|				ВТОплаты.ИсполнительныйЛист
		|			ИЗ
		|				ВТОплаты КАК ВТОплаты)
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ВТНачисления.Регистратор КАК Регистратор,
		|	ВТНачисления.ЛицевойСчет КАК ЛицевойСчет,
		|	ВТНачисления.ФИОДолжника КАК ФИОДолжника,
		|	ВТНачисления.Услуга КАК Услуга,
		|	ВТНачисления.ИсполнительныйЛист КАК ИсполнительныйЛист,
		|	втОплаты.ОплатаУслуга КАК Сумма,
		|	втОплаты.ОплатаГоспошлина КАК СуммаГоспошлины,
		|	втОплаты.ОплатаПредставительские КАК СуммаПредставительскихРасходов,
		|	втОплаты.ДатаОплаты КАК ДатаОплаты,
		|	втОплаты.ДатаОплаты КАК Период
		|ИЗ
		|	ВТНачисления КАК ВТНачисления
		|		ЛЕВОЕ СОЕДИНЕНИЕ втОплаты КАК втОплаты
		|		ПО ВТНачисления.ИсполнительныйЛист = втОплаты.ИсполнительныйЛист";
		
		Запрос.УстановитьПараметр("Ссылка", Реквизиты.Ссылка);
		Запрос.УстановитьПараметр("УслугаГоспошлина", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000012"));
		Запрос.УстановитьПараметр("УслугаПредставительские", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000013"));
		
		РезультатЗапроса = Запрос.Выполнить();
		Если не РезультатЗапроса.Пустой() тогда                 
			ДвиженияИполнительные = Движения.ВзаиморасчетыПоИсполнительномуПроизводству;
			ДвиженияИполнительные.Записывать = истина;
			ДвиженияИполнительные.Записать();
			
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			Пока ВыборкаДетальныеЗаписи.Следующий() Цикл   
				Движение =ДвиженияИполнительные.ДобавитьРасход(); 
				ЗаполнитьЗначенияСвойств(Движение,ВыборкаДетальныеЗаписи);
			КонецЦикла;
		КонецЕсли;
		
		//МассивДокументов = Новый Массив;
		
		Для Каждого Стр Из СписокЛС Цикл
			Если Стр.ИзменитьСтатусИЛ Тогда
				Исполнительный = Стр.ИсполнительныйЛист.ПолучитьОбъект();
				Исполнительный.Статус = Перечисления.СтатусыПоИсполнительнымЛистам.ИсполненВПолномОбъеме;
				Исполнительный.Записать(РежимЗаписиДокумента.Проведение);
				//МассивДокументов.Добавить(Стр.ИсполнительныйЛист);
			КонецЕсли;
		КонецЦикла;	
КонецПроцедуры
