КонецФункции

// Процедура для изменения в настройках(отдельно или ко всем).
&НаКлиенте
Процедура ЛицевыеСчетаПриИзменении(Элемент)
	
	Если ЭтаФорма.УказыватьОтдельно = 1 Тогда
		
		ЭтаФорма.УказыватьОтдельно = 0;
		
	КонецЕсли;	
		 
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьОмскНаСервере()
	Счет = 0;
	Здание = Объект.Здание;
	Дата = Объект.Дата;
	Запрос = Новый Запрос;
	Запрос.Текст = ПолучитьТекстЗапроса();
	Запрос.УстановитьПараметр("Здание",Здание);
	Запрос.УстановитьПараметр("Дата",Дата);
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Пока РезультатЗапроса.Количество() > Счет Цикл
		ЗапросСчет = РезультатЗапроса[Счет];
		НовСтрока = Объект.ЛицевыеСчета.Добавить();
	    НовСтрока.ЛицевойСчет    		      = ЗапросСчет.ЛицевойСчет;
	    НовСтрока.Услуга          			  = Объект.Услуга;
		НовСтрока.Поставщик       			  = Поставщик;
		НовСтрока.СпособРасчета   			  = СпособРасчета;
		НовСтрока.РежимПотребления 			  = РежимПотребления;
		НовСтрока.КоличествоЕдиницПотребления = ЗапросСчет.КоличествоЕдиницПотребления;
		Счет = Счет + 1;
	КонецЦикла;
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьОмск(Команда)
	ЗаполнитьОмскНаСервере();
КонецПроцедуры

&НаСервере
Функция ПолучитьТекстЗапроса()
	Здание = Объект.Здание;
	Дата = Объект.Дата;
	Если СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда
		ТекстЗапросаЛС = "ВЫБРАТЬ
		                 |	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
		                 |	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК КоличествоЕдиницПотребления
		                 |ИЗ
		                 |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		                 |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
		                 |		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
		                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, ) КАК бит_СведенияОКвартиреСрезПоследних
		                 |		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
		                 |ГДЕ
		                 |	бит_СписокЗданий.Ссылка = &Здание   
						 //++АнисимоваМВ 1бит 11.11.2024 восстановление после сбоя
						 |	И НЕ бит_ЛицевыеСчета.Архивный";
	Иначе 
		ТекстЗапросаЛС = "ВЫБРАТЬ
		                 |	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
		                 |	0 КАК КоличествоЕдиницПотребления
		                 |ИЗ
		                 |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		                 |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
		                 |		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
		                 |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, ) КАК бит_СведенияОКвартиреСрезПоследних
		                 |		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
		                 |ГДЕ
		                 |	бит_СписокЗданий.Ссылка = &Здание            
						 //++АнисимоваМВ 1бит 11.11.2024 восстановление после сбоя
						 |	И НЕ бит_ЛицевыеСчета.Архивный";
	КонецЕсли;
	Возврат ТекстЗапросаЛС;
	
КонецФункции

