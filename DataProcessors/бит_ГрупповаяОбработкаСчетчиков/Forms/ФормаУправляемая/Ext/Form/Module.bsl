// Процедура - действие команды "Вернуться".
//
&НаКлиенте
Процедура СоздатьНовыеСчетчики(Команда)
	
	Элементы.Страницы.ТекущаяСтраница = Элементы.ГруппаЛицевыеСчета;
	
	Элементы.ДеревоСчетчиковГруппаСозданиеСЧ.Видимость  = Истина;
	Элементы.ДеревоСчетчиковГруппаУстановкаСЧ.Видимость = Ложь;
	
	Объект.Услуги.Очистить();
	ДеревоСчетчиков.ПолучитьЭлементы().Очистить();
	
	Объект.ВидСчетчика            = Неопределено;
	Объект.УлицаЛицевогоСчета     = Неопределено;
	Объект.Здание                 = Неопределено;
	Объект.Разрядность            = 0;
	Объект.ДатаУстановкиСчетчиков = ТекущаяДата();
	Корпус                        = 0;
	Объект.Нумерация              = "ПоПорядку";
	Объект.Префикс                = "";
	Объект.Постфикс               = "";
	Объект.НачальныйНомер         = "";
	
	ИспользоватьОтборСтатусКвартиры = Ложь;
	ИспользоватьОтборТипКвартиры    = Ложь;
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[0].Использование  = ИспользоватьОтборТипКвартиры;
	КомпоновщикНастроек.Настройки.Отбор.Элементы[1].Использование  = ИспользоватьОтборСтатусКвартиры;
	
	ВидСравненияСтатусКвартиры = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияТипКвартиры    = ВидСравненияКомпоновкиДанных.Равно;
	
	КомпоновщикНастроек.Настройки.Отбор.Элементы[0].ВидСравнения   = ВидСравненияТипКвартиры;
	КомпоновщикНастроек.Настройки.Отбор.Элементы[1].ВидСравнения   = ВидСравненияСтатусКвартиры;
	
	ТипКвартиры    = Неопределено;
	СтатусКвартиры = Неопределено;
	
	ПоместитьЗначениеВОтборКомпановщика(ТипКвартиры   , 0);
	ПоместитьЗначениеВОтборКомпановщика(СтатусКвартиры, 1);
	
КонецПроцедуры

