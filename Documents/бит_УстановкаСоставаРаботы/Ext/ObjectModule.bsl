// Возвращает доступные варианты печати документа.
//
// Возвращаемое значение:
//  Структура, каждая строка которой соответствует одному из вариантов печати.
//  
Функция ПолучитьСтруктуруПечатныхФорм() Экспорт
	
	Возврат Новый Структура();
	
КонецФункции // ПолучитьСтруктуруПечатныхФорм()

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура выполняет проверку заполнения шапки и таб. частей.
//
// Параметры:
// Отказ - булево.
// Заголовок  – Строка.
Процедура ПроверкаРеквизитов(Отказ,Заголовок)
	
	// Проверим заполнение шапки.
	СтруктураОбязательныхПолей = Новый Структура;
	СтруктураОбязательныхПолей.Вставить("Подразделение");
	СтруктураОбязательныхПолей.Вставить("ВидОбъекта");
	СтруктураОбязательныхПолей.Вставить("Работа");
	СтруктураОбязательныхПолей.Вставить("ЕдиницаИзмерения");
	
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект,  СтруктураОбязательныхПолей,   Отказ, Заголовок);
	
КонецПроцедуры //ПроверкаРеквизитов()

// Проверяет правильность заполнения строк табличной части "Номенклатура".
//
// Параметры: 
//  ТаблицаСтавок - результат запроса, содержащий данные для проведения и проверки ТЧ СтавкиНаУслуги.
//  СтруктураШапкиДокумента   - структура, содержащая рексвизиты шапки документа и результаты запроса по шапке.
//  Отказ                     - флаг отказа в проведении.
//  Заголовок                 - строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеТабличнойЧастиНоменклатура(ТаблицаНоменклатуры, СтруктураШапкиДокумента, Отказ, Заголовок)
	
	ИмяТабличнойЧасти = "Номенклатура";
	
	// Укажем, что надо проверить:
	СтруктураОбязательныхПолей = Новый Структура("Номенклатура,Коэффициент,Количество");
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "Номенклатура", СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры // ПроверитьЗаполнениеТабличнойЧастиНоменклатура()

// Выгружает результат запроса в табличную часть, добавляет ей необходимые колонки для проведения.
//
// Параметры: 
//  РезультатЗапросаПоТоварам - результат запроса по табличной части "СтавкиНаУслуги",
//  СтруктураШапкиДокумента   - структура, содержащая рексвизиты шапки документа и результаты запроса по шапке.
//
// Возвращаемое значение:
//  Сформированная таблиица значений.
//
Функция ПодготовитьТаблицуНоменклатуры(РезультатЗапросаПоНоменклатуре, СтруктураШапкиДокумента)
	
	ТаблицаНоменклатуры = РезультатЗапросаПоНоменклатуре.Выгрузить();
	
	Возврат ТаблицаНоменклатуры;
	
КонецФункции // ПодготовитьТаблицуНоменклатуры()

// Процедура выполняет заполнение таблицы номенклатура.
//
Процедура ПодготовитьТаблицыДокумента(СтруктураШапкиДокумента, ТаблицаНоменклатуры) Экспорт
	
	// Получим необходимые данные для проведения и проверки заполенения данные по табличной части "Номеклатура".
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("Номенклатура"	     , "Номенклатура");
	СтруктураПолей.Вставить("Коэффициент"  		 , "Коэффициент");
	СтруктураПолей.Вставить("Количество"         , "Количество");
	
	РезультатЗапросаПоНоменклатуре = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Номенклатура", СтруктураПолей);
	
	// Подготовим таблицы товаров для проведения.
	ТаблицаНоменклатуры      = ПодготовитьТаблицуНоменклатуры(РезультатЗапросаПоНоменклатуре, СтруктураШапкиДокумента);
	
КонецПроцедуры	

// Процедура выполняет движения по регистрам.
//                
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента,ТаблицаНоменклатуры,Отказ,Заголовок)
	
	// Движения по регистру бит_СоставРабот.
	
	НаборЗаписей = Движения.бит_СоставРабот; 
	
	Для Каждого ТекСтрока Из ТаблицаНоменклатуры Цикл
		СтрокаДвижений = НаборЗаписей.Добавить();
		СтрокаДвижений.Период 			      = СтруктураШапкиДокумента.Дата;
		СтрокаДвижений.Подразделение	      = СтруктураШапкиДокумента.Подразделение;
		СтрокаДвижений.ВидОбъекта		      = СтруктураШапкиДокумента.ВидОбъекта;
		СтрокаДвижений.Работа 			      = СтруктураШапкиДокумента.Работа;
		СтрокаДвижений.ЕдиницаИзмерения	      = СтруктураШапкиДокумента.ЕдиницаИзмерения;
		СтрокаДвижений.Номенклатура		      = ТекСтрока.Номенклатура;
		СтрокаДвижений.Коэффициент			  = ТекСтрока.Коэффициент;
		СтрокаДвижений.Количество	 	      = ТекСтрока.Количество;
	КонецЦикла;
	
КонецПроцедуры //ДвиженияПоРегистрам()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Процедура - обработчик события "ОбработкаПроведения".
//
Процедура ОбработкаПроведения(Отказ, РежимПроведения)
	
	Перем ТаблицаНоменклатуры; // Хранит таблицу номенклатуры.
	
	// Заголовок для сообщений об ошибках проведения.
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	ПроверкаРеквизитов(Отказ,Заголовок);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	ПодготовитьТаблицыДокумента(СтруктураШапкиДокумента, ТаблицаНоменклатуры);
	
	ПроверитьЗаполнениеТабличнойЧастиНоменклатура(ТаблицаНоменклатуры, СтруктураШапкиДокумента, Отказ, Заголовок);
	
	// Выполним движения.
	Если НЕ Отказ Тогда
		ДвиженияПоРегистрам(СтруктураШапкиДокумента,ТаблицаНоменклатуры,Отказ,Заголовок);
	КонецЕсли; 
	
КонецПроцедуры

// Процедура - обработчик события "ПередЗаписью".
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	бит_ОбщегоНазначения.ПередЗаписьюДокументаДляУдаленияДвиженийПередЗаписью(ЭтотОбъект, Отказ, РежимЗаписи, РежимПроведения);
	
КонецПроцедуры

