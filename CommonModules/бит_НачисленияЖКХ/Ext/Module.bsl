			Проводка			 = Движения.Хозрасчетный.Добавить();
			мСумма				 = СтрокаТЧ.Сумма;
			Проводка.Период      = Реквизиты.Дата;
			Проводка.Содержание  = "Ввод начальных остатков пени по КУ";
			Проводка.Организация = Реквизиты.Организация;
			
			НаправлениеДвиженияАбонента = "Дт";
			НаправлениеДвиженияКУ       = "Кт";
			
			Если мСумма < 0 
				И НЕ (СтрокаТЧ.СчетКУ = ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД
				ИЛИ СтрокаТЧ.СчетКУ = ПланыСчетов.Хозрасчетный.ВыручкаЕНВД
				ИЛИ СтрокаТЧ.СчетКУ = ПланыСчетов.Хозрасчетный.ПрочиеДоходы
				ИЛИ СтрокаТЧ.СчетКУ = ПланыСчетов.Хозрасчетный.ПрочиеРасходы) Тогда //Необходимость исключений, как в разовых.
				
				мСумма = мСумма * -1;
				НаправлениеДвиженияАбонента = "Кт";
				НаправлениеДвиженияКУ       = "Дт";
			КонецЕсли; 
			
			Проводка["Счет" + НаправлениеДвиженияАбонента] = СтрокаТЧ.СчетАбонента;
			БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияАбонента], Проводка["Субконто" + НаправлениеДвиженияАбонента], 1, СтрокаТЧ.Субконто1);
			БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияАбонента], Проводка["Субконто" + НаправлениеДвиженияАбонента], 2, СтрокаТЧ.Субконто2);
			БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияАбонента], Проводка["Субконто" + НаправлениеДвиженияАбонента], 3, СтрокаТЧ.Субконто3);
			Проводка["Счет" + НаправлениеДвиженияКУ] = СтрокаТЧ.СчетКУ;
			БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияКУ], Проводка["Субконто" + НаправлениеДвиженияКУ], 1, СтрокаТЧ.СубконтоКУ1);
			БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияКУ], Проводка["Субконто" + НаправлениеДвиженияКУ], 2, СтрокаТЧ.СубконтоКУ2);
			БухгалтерскийУчет.УстановитьСубконто(Проводка["Счет" + НаправлениеДвиженияКУ], Проводка["Субконто" + НаправлениеДвиженияКУ], 3, СтрокаТЧ.СубконтоКУ3);	
			Проводка.Сумма = мСумма;
			
			Если СтрокаТЧ.СчетКУ = ПланыСчетов.Хозрасчетный.ВыручкаНеЕНВД  Тогда
				Если ЗначениеЗаполнено(Проводка.СубконтоКт.СтавкиНДС) Тогда
					НДС_Ставка= УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Проводка.СубконтоКт.СтавкиНДС);
					Проводка.СуммаНУКт = бит_РасчетыПоКоммунальнымУслугам.CкорректированнаяCуммаНДС(ТаблицаРасчетаНДС, СтрокаТЧ.СубконтоКУ3, мСумма, НДС_Ставка);
				КонецЕсли;
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Движения.Хозрасчетный.Записывать = Истина;
	
КонецПроцедуры
