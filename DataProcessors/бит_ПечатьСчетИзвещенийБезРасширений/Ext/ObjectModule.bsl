Функция КвитанцияКапРемонтНежилая()     
	
	//УслугаМинВзнос = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");
	УслугаМинВзнос = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010");
	//УслугаДопВзнос = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000014");
	УслугаДопВзнос = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000014");
	//УслугаРФКР     = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000009");
	УслугаРФКР     = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000009");
	МакетКапРемонт = Новый ТабличныйДокумент;
	МакетКвитанции = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("лб_МакетКапРемонт");
	МакетКапРемонт.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	ОбластьКвитанции = МакетКвитанции.ПолучитьОбласть("ОбластьШирина|ОбластьВысота");
	//Формирование кодов почты. 10 знак - первый и второй символы кода капитального ремонта.
	ЗапросКода = Новый Запрос;
	ЗапросКода.УстановитьПараметр("Здание",МструктураДанных.КвартираСсылка.Владелец);
	ЗапросКода.Текст = 
	"ВЫБРАТЬ
	|	лб_Тест_Дома.ВладелецСчетаКР КАК Организация,
	|	лб_Тест_Дома.KR_KOD КАК КодКапРемонта,
	|	лб_Тест_Дома.KR_RS КАК РасчетныйСчет,
	|	лб_Тест_Дома.ЛицевойСчетКР КАК РасчетныйСчетСсылка
	|ИЗ
	|	РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
	|ГДЕ
	|	лб_Тест_Дома.Здание = &Здание";
	РезультатЗапроса = ЗапросКода.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаЗапроса = РезультатЗапроса.Выгрузить();
		
		Если ЗначениеЗаполнено(ВыборкаЗапроса[0].РасчетныйСчетСсылка) Тогда
			РасчетныйСчетСсылка = ВыборкаЗапроса[0].РасчетныйСчетСсылка;
		Иначе
			Возврат МакетКапРемонт; 
		КонецЕсли;
		ПолучательПлатежа   = ВыборкаЗапроса[0].Организация;
		РасчетныйСчет       = ВыборкаЗапроса[0].РасчетныйСчет;
		Если (СокрЛП(ВыборкаЗапроса[0].КодКапРемонта) <> "") И (ВыборкаЗапроса[0].КодКапРемонта <> Неопределено) Тогда
			Код1 = Лев(СокрЛП(ВыборкаЗапроса[0].КодКапРемонта),1);
			Код2 = Сред(СокрЛП(ВыборкаЗапроса[0].КодКапРемонта),2,1);
		Иначе
			Код1 = 0;
			Код2 = 0;
		КонецЕсли;
		
	Иначе 
		Возврат МакетКапРемонт;
		//ПолучательПлатежа = мСтруктураДанных.ПолучательПредставление;
		//РасчетныйСчет     = мСтруктураДанных.ПолучательРС;
		//Код1 = 0;
		//Код2 = 0;
	КонецЕсли;

	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") И НЕ ЗначениеЗаполнено(РасчетныйСчетСсылка) Тогда
		РасчетныйСчетСсылка = ПолучательПлатежа.ОсновнойБанковскийСчет;		
	КонецЕсли;	
		
	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") Тогда
		ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Истина,РасчетныйСчетСсылка).Выгрузить();
	Иначе
		ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Ложь,РасчетныйСчетСсылка).Выгрузить();
	КонецЕсли;
	
	КонтрольныйРазрядКод1 = (3*(1 + (Код1*3)))%10;
	КонтрольныйРазрядКод2 = (3*(1 + (Код2*3)))%10;
	КодПочты1 = "01000000" + Код1 + "0" + КонтрольныйРазрядКод1; 
	КодПочты1СРазделителем = "01'000'000'" + Код1 + "0" + КонтрольныйРазрядКод1; 
	КодПочты2 = "00001000" + Код2 + "0" + КонтрольныйРазрядКод2; 
	КодПочты2СРазделителем = "00'001'000'" + Код2 + "0" + КонтрольныйРазрядКод2; 
	// Штрихкод - Лицевой счет 11 знаков, дата формата ММГГ, Коды почты без контрольного разряда 10\10 и девять нулей.
	Штрихкод = мСтруктураДанных.ЛицевойСчетНомер + мСтруктураДанных.ПериодМесяц + Прав(мСтруктураДанных.ПериодГод, 2) +	Лев(КодПочты1, 10) + Лев(КодПочты2, 10) +	"000000000";
	Сумма = 0;
	Для Счетчик = 1 По (СтрДлина(Штрихкод)/2) Цикл
		ДвухзначноеЧисло = Сред(Штрихкод,Счетчик*2-1,2);		
		Сумма = Сумма + ДвухзначноеЧисло * Счетчик;
	КонецЦикла;
	РезультатРасчета = Сумма + 105;
	КонтрольныйРазрядШтрихкода = РезультатРасчета%103;
	//Контрольный разряд для штрихкода.
	//44 цифры разбиваются попарно. Первая пара умножается на 1, вторая на 2 и т.д. Результат суммируется.
	//К полученному результату придавляем 105 и находим остаток от деления на 103.
	ЗначениеШтрихкода = Штрихкод + Строка(КонтрольныйРазрядШтрихкода);
	//Формирование Штрихкода
	Эталон = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("Эталон");
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;	
	Попытка
		Рисунок = ОбластьКвитанции.Рисунки.D1;
	Исключение
	КонецПопытки;	
	Попытка		
		ПараметрыШтрихкода = Новый Структура;
		ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе)+250);
		ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
		ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
		ПараметрыШтрихкода.Вставить("ТипКода",         4);
		ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
		ПараметрыШтрихкода.Вставить("РазмерШрифта",    10);
		
		КартинкаШК = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода); 
		Рисунок.Картинка	= КартинкаШК;
		Рисунок.Высота		= 22.57;
		Рисунок.Лево		= Рисунок.Лево - 8.5;
		//Рисунок.Ширина		= 130;
		Рисунок.Ширина		= 0;
	Исключение
	КонецПопытки;	
	Попытка 
		НапечататьQRКодИзмененный(РасчетныйСчетСсылка,РасчетныйСчет,ПолучательПлатежа,ОбластьКвитанции);   //Печать QR-кода
	Исключение	
	КонецПопытки;
	
	МинВзносПолучитьДанные = ПолучитьДанныеКапРемонт(мСтруктураДанных.Дата,мСтруктураДанных.ЛицевойСчет,УслугаМинВзнос,мСтруктураДанных.КвартираСсылка,мСтруктураДанных.СтатусКвартиры,мСтруктураДанных.ТипКвартиры);
	Если НЕ (МинВзносПолучитьДанные = Ложь) И НЕ (МинВзносПолучитьДанные = Истина) Тогда
		МинВзносДанные = МинВзносПолучитьДанные.Выгрузить();
		ОбластьКвитанции.Параметры.МинВзносПереплата  = Формат(МинВзносДанные[0].СуммаНачальныйОстаток,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.МинВзносСтавка     = Формат(МинВзносДанные[0].ОсновнаяСтавка,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.МинВзносНачислено  = Формат(МинВзносДанные[0].СуммаПриход - МинВзносДанные[0].Разовые,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.МинВзносПерерасчет = Формат(МинВзносДанные[0].Разовые,"ЧДЦ=2; ЧН=0,00");
		Если МинВзносДанные[0].СуммаНачальныйОстаток < 0 Тогда
			Если (МинВзносДанные[0].СуммаКонечныйОстаток) < 0 Тогда
				ОбластьКвитанции.Параметры.МинВзносКОплате = 0;
			Иначе
				ОбластьКвитанции.Параметры.МинВзносКОплате = (МинВзносДанные[0].СуммаКонечныйОстаток);
			КонецЕсли;
			ДопТекстКоплате = "с учетом переплат";
		ИначеЕсли (МинВзносДанные[0].СуммаНачальныйОстаток - (МинВзносДанные[0].СуммаПриход - МинВзносДанные[0].Разовые)) > 0  Тогда 
			ОбластьКвитанции.Параметры.МинВзносКОплате    = (МинВзносДанные[0].СуммаКонечныйОстаток);
			ДопТекстКоплате = "с учетом долга";
		Иначе
			ОбластьКвитанции.Параметры.МинВзносКОплате    = (МинВзносДанные[0].СуммаКонечныйОстаток);
			ДопТекстКоплате = "";
		КонецЕсли;
	ИначеЕсли МинВзносПолучитьДанные = Истина Тогда
		ОбластьКвитанции.Параметры.МинВзносПереплата  = 0;
		ОбластьКвитанции.Параметры.МинВзносСтавка     = 0;
		ОбластьКвитанции.Параметры.МинВзносНачислено  = 0;
		ОбластьКвитанции.Параметры.МинВзносПерерасчет = 0;
		ОбластьКвитанции.Параметры.МинВзносКОплате    = 0;
		
	Иначе
		ОбластьКвитанции.Параметры.МинВзносПереплата  = "";
		ОбластьКвитанции.Параметры.МинВзносСтавка     = "";
		ОбластьКвитанции.Параметры.МинВзносНачислено  = "";
		ОбластьКвитанции.Параметры.МинВзносПерерасчет = "";
		ОбластьКвитанции.Параметры.МинВзносКОплате    = 0;
	КонецЕсли;
	Если ОбластьКвитанции.Параметры.МинВзносКОплате < 0 Тогда
		ОбластьКвитанции.Параметры.МинВзносКОплате = 0;
	КонецЕсли;
	
	ДопВзносПолучитьДанные = ПолучитьДанныеКапРемонт(мСтруктураДанных.Дата,мСтруктураДанных.ЛицевойСчет,УслугаДопВзнос,мСтруктураДанных.КвартираСсылка,мСтруктураДанных.СтатусКвартиры,мСтруктураДанных.ТипКвартиры);
	Если НЕ (ДопВзносПолучитьДанные = Ложь) И НЕ (ДопВзносПолучитьДанные = Истина) Тогда
		ДопВзносДанные = ДопВзносПолучитьДанные.Выгрузить();
		ОбластьКвитанции.Параметры.ДопВзносПереплата  = Формат(ДопВзносДанные[0].СуммаНачальныйОстаток,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ДопВзносСтавка     = Формат(ДопВзносДанные[0].ОсновнаяСтавка,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ДопВзносНачислено  = Формат(ДопВзносДанные[0].СуммаПриход - ДопВзносДанные[0].Разовые,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ДопВзносПерерасчет = Формат(ДопВзносДанные[0].Разовые,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ДопВзносКОплате    = ДопВзносДанные[0].СуммаПриход + ДопВзносДанные[0].СуммаНачальныйОстаток;
	ИначеЕсли МинВзносПолучитьДанные = Истина Тогда
		ОбластьКвитанции.Параметры.ДопВзносПереплата  = 0;
		ОбластьКвитанции.Параметры.ДопВзносСтавка     = 0;
		ОбластьКвитанции.Параметры.ДопВзносНачислено  = 0;
		ОбластьКвитанции.Параметры.ДопВзносПерерасчет = 0;
		ОбластьКвитанции.Параметры.ДопВзносКОплате    = 0;
	Иначе
		ОбластьКвитанции.Параметры.ДопВзносПереплата  = "";
		ОбластьКвитанции.Параметры.ДопВзносСтавка     = "";
		ОбластьКвитанции.Параметры.ДопВзносНачислено  = "";
		ОбластьКвитанции.Параметры.ДопВзносПерерасчет = "";
		ОбластьКвитанции.Параметры.ДопВзносКОплате    = 0;
	КонецЕсли;
	Если ОбластьКвитанции.Параметры.ДопВзносКОплате < 0 Тогда
		ОбластьКвитанции.Параметры.ДопВзносКОплате = 0;
	КонецЕсли;
	
	Если ДолгРФКР(УслугаРФКР,мСтруктураДанных.ЛицевойСчет,мСтруктураДанных.Дата) <= 0 Тогда
	Иначе
		ОбластьКвитанции.Параметры.ДолгРФКР              = "Справочно: долг за период оплаты в Региональный фонд капитального ремонта " + Формат(ДолгРФКР(УслугаРФКР,мСтруктураДанных.ЛицевойСчет,мСтруктураДанных.Дата),"ЧДЦ=2; ЧН=0,00") + " руб.";	
		ОбластьКвитанции.Параметры.ОплатаОрганизация     = "Оплата производится по отдельной квитанции " + мСтруктураДанных.ПолучательПредставление;
	КонецЕсли;
	
	Если ПолучитьДанныеПениКапРемонт(мСтруктураДанных.ЛицевойСчет,УслугаМинВзнос,мСтруктураДанных.Дата) = Ложь Тогда 
		ОбластьКвитанции.Параметры.ПениНачислено         = Формат(0,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ПениПереплата         = Формат(0,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ПениПерерасчет        = Формат(0,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ПениКОплате           = Формат(0,"ЧДЦ=2; ЧН=0,00");
	Иначе 
		ДанныеПени = ПолучитьДанныеПениКапРемонт(мСтруктураДанных.ЛицевойСчет,УслугаМинВзнос,мСтруктураДанных.Дата).Выгрузить();
		ОбластьКвитанции.Параметры.ПениНачислено         = Формат(ДанныеПени[0].ПениПриход - ДанныеПени[0].Разовые,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ПениПереплата         = Формат(ДанныеПени[0].ПениОстаток,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ПениПерерасчет        = Формат(ДанныеПени[0].Разовые,"ЧДЦ=2; ЧН=0,00");
		ОбластьКвитанции.Параметры.ПениКОплате           = ДанныеПени[0].ПениОстаток + ДанныеПени[0].ПениПриход;
		Если ОбластьКвитанции.Параметры.ПениКОплате < 0 Тогда
			ОбластьКвитанции.Параметры.ПениКОплате = 0;
		КонецЕсли;
	КонецЕсли;
	Если ЗначениеЗаполнено(мСтруктураДанных.ЛицевойСчетФИО) тогда
		ЛицевойСчетФио = мСтруктураДанных.ЛицевойСчетФИО;
	Иначе	
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("ЛицСчет", мСтруктураДанных.ЛицевойСчет);
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	лб_ОтветственныеЗаЛицевыеСчета.Ответственный КАК Ответственный
		|ИЗ
