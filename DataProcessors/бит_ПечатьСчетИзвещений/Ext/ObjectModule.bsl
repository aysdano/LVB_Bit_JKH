	КоличествоСтрокУс =  мТаблицаПечати.Количество();
	
	ОдинокийЛьготник = (мСтруктураДанных.КолЛьготников = 1 И мСтруктураДанных.КоличествоПроживающих = 1);
	
	СчетчикСтрокУс = 1;
	
	Если НеПечататьУслугиБезНачислений Тогда
		Индекс = тмпТаблица.Количество() - 1;
		
		Пока Индекс >=0 Цикл
			
			СтрокаТаблицы=тмпТаблица.Получить(Индекс);
			
			Если СтрокаТаблицы.Начислено = 0
				И СтрокаТаблицы.Разовые = 0
				И СтрокаТаблицы.Льгота = 0
				И (СтрокаТаблицы.Оплата = 0 ИЛИ НЕ ПечататьУслугиСОплатой) Тогда 
				
				тмпТаблица.удалить(СтрокаТаблицы);	
				
			КонецЕсли;
			Индекс = Индекс - 1;
			
		КонецЦикла;	
		
	КонецЕсли;
	
	Если НЕ ТаблицаГрУслугСтрока = Неопределено
		И (ГруппироватьУслуги ИЛИ мСтруктураДанных.ГруппироватьУслуги) Тогда
		
		Запрос = ПолучитьзапросГруппировки(тмпТаблица);
		ВыборкаГруп = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаГруп.Следующий() Цикл
			
			ТаблицаГрУслугСтрока.Параметры.Заполнить(ВыборкаГруп);
			ТаблицаГрУслугСтрока.Параметры.УслугаПредставление = ВРег(ВыборкаГруп.ГруппаУслугиПредставление);
			ЗаполнитьПараметр(ТаблицаГрУслугСтрока, "Объем", "" + ВыборкаГруп.Объем + "" + ВыборкаГруп.ЕдИзм);
			ЗаполнитьПараметр(ТаблицаГрУслугСтрока, "Объем_точность3", "" + ВыборкаГруп.Объем_точность3 + "" + ВыборкаГруп.ЕдИзм);
			ЗаполнитьПараметр(ТаблицаГрУслугСтрока, "Объем_точность2", "" + ВыборкаГруп.Объем_точность2 + "" + ВыборкаГруп.ЕдИзм);
			
			Выборка = ВыборкаГруп.Выбрать();
			
			Если Выборка.Количество() = 1 Тогда // Едсинственная услуга в группировки.
				
				Выборка.Следующий();
				ТаблицаГрУслугСтрока.Параметры.Заполнить(Выборка);
				ТаблицаГрУслугСтрока.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
				ЗаполнитьПараметр(ТаблицаГрУслугСтрока, "Объем", "" + Выборка.Объем + "" + Выборка.ЕдИзм);
				ЗаполнитьПараметр(ТаблицаГрУслугСтрока, "Объем_точность3", "" + Выборка.Объем_точность3 + "" + Выборка.ЕдИзм);
				ЗаполнитьПараметр(ТаблицаГрУслугСтрока, "Объем_точность2", "" + Выборка.Объем_точность2 + "" + Выборка.ЕдИзм);
				
				Квитанция.Вывести(ТаблицаГрУслугСтрока);
				Если СчетчикСтрокУс < 13 Тогда
					СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
					Квитанция.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
				Иначе
					Квитанция.Присоединить(ИнфОПлатежеПустаяСтрока);
				КонецЕсли;
				СчетчикСтрокУс = СчетчикСтрокУс + 1;
				
			ИначеЕсли Выборка.Количество() > 1 Тогда 
				
				Квитанция.Вывести(ТаблицаГрУслугСтрока);
				
				Пока Выборка.Следующий() И РасскрытьСоставГрупп Цикл
					
					ТаблицаУслугСтрока.Параметры.Заполнить(Выборка);
					ЗаполнитьПараметр(ТаблицаУслугСтрока, "Объем", "" + Выборка.Объем + "" + Выборка.ЕдИзм);
					ЗаполнитьПараметр(ТаблицаУслугСтрока, "Объем_точность3", "" + Выборка.Объем_точность3 + "" + Выборка.ЕдИзм);
					ЗаполнитьПараметр(ТаблицаУслугСтрока, "Объем_точность2", "" + Выборка.Объем_точность2 + "" + Выборка.ЕдИзм);
					
					Квитанция.Вывести(ТаблицаУслугСтрока);
					Если СчетчикСтрокУс < 13 Тогда
						СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
						Квитанция.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
					Иначе
						Квитанция.Присоединить(ИнфОПлатежеПустаяСтрока);
					КонецЕсли;
					СчетчикСтрокУс = СчетчикСтрокУс + 1;
				КонецЦикла; 
				
			ИначеЕсли ВыборкаГруп.Услуга.Пустая() Тогда 
				
				Пока Выборка.Следующий() Цикл
					
					ТаблицаГрУслугСтрока.Параметры.Заполнить(Выборка);
					ТаблицаГрУслугСтрока.Параметры.УслугаПредставление = ВРег(Выборка.УслугаПредставление);
					
					Квитанция.Вывести(ТаблицаГрУслугСтрока);
					
					Если СчетчикСтрокУс < 13 Тогда
						СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
						Квитанция.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
					Иначе
						Квитанция.Присоединить(ИнфОПлатежеПустаяСтрока);
					КонецЕсли;
					СчетчикСтрокУс = СчетчикСтрокУс + 1;
				КонецЦикла; 
				
			КонецЕсли; 
			
		КонецЦикла;
		
	Иначе
		Для каждого СтрокаТаблицы Из тмпТаблица Цикл
			
			ТаблицаУслугСтрока.Параметры.Заполнить(СтрокаТаблицы);
			
			ЗаполнитьПараметр(ТаблицаУслугСтрока, "Объем", "" + СтрокаТаблицы.Объем + "" + СтрокаТаблицы.ЕдИзм);
			
			ЗаполнитьПараметр(ТаблицаУслугСтрока, "Объем_точность3", "" + СтрокаТаблицы.Объем_точность3 + "" + СтрокаТаблицы.ЕдИзм);
			ЗаполнитьПараметр(ТаблицаУслугСтрока, "Объем_точность2", "" + СтрокаТаблицы.Объем_точность2 + "" + СтрокаТаблицы.ЕдИзм);
			
			Квитанция.Вывести(ТаблицаУслугСтрока);
			
			Если СчетчикСтрокУс < 13 Тогда
				
				СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс].Параметры.Заполнить(мСтруктураДанных);
				Квитанция.Присоединить(СтруктураСтрокаИнф["ИнфСтр" + СчетчикСтрокУс]);
				
