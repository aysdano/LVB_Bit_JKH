// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Перечисления.
	
	КэшированныеЗначения.Вставить("РасчетСУчетомДолейВладения"                           , Ложь);
	КэшированныеЗначения.Вставить("УменьшениеНормыЛьготыВПределахФакта"                  , Ложь);
	КэшированныеЗначения.Вставить("НачислениеСУчетомДнейПроживания"                      , Ложь);
	КэшированныеЗначения.Вставить("ОбщедомовыеРасходыВГрафеНачисления"                   , Ложь);
	КэшированныеЗначения.Вставить("СчетчикиПодкрутка"                                    , Ложь);
	КэшированныеЗначения.Вставить("ЛьготаПерсонифицированная"                            , Ложь);
	КэшированныеЗначения.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	КэшированныеЗначения.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика", Ложь);
	КэшированныеЗначения.Вставить("УчитыватьНачисленияПоГрупповымСчетчикам"              , Ложь);
	КэшированныеЗначения.Вставить("УчитыватьПерерасчет"                                  , Ложь);
	КэшированныеЗначения.Вставить("СчетАбонента"                                         , Неопределено);
	КэшированныеЗначения.Вставить("Контрагент"                                            , Неопределено);
	КэшированныеЗначения.Вставить("ФормироватьАктИРеализациюПоКонтрагенту"                , Ложь);
	КэшированныеЗначения.Вставить("ФормироватьАктИРеализациюПоКонтрагентуОтветственныхЛиц", Ложь);
	
	КэшированныеЗначения.Вставить("ДокументУчетаСобственныхУслуг", Неопределено);
	
	КэшированныеЗначения.Вставить("ПорядокРаспределенияРасходовНаОказаниеУслуг", Неопределено);
	
	КэшированныеЗначения.Вставить("ПоПлановымЦенамИВыручке", Перечисления.бит_ПорядокРаспределенияРасходовНаОказаниеУслуг.ПоПлановымЦенамИВыручке);
	
	КэшированныеЗначения.Вставить("ЗначениеДаты"                                         , Неопределено);
	
КонецПроцедуры

// Процедура выполняет загрузку настроек отбора из настроек по умолчанию.
//
&НаСервере
Процедура ЗагрузитьНастройкиОтбораПоУмолчанию()
	
	СхемаКомпоновкиДанных = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьМакет("ОсновныеНачисления");
	КомпоновщикНастроек.Инициализировать(
	Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ЭтаФорма.УникальныйИдентификатор))
	);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
КонецПроцедуры

// Процедура выполняет заполнение табличной части "Товары".
//
&НаСервере
Процедура ЗакрытьМесяцНаСервере()
	
	мДатаТекст = Формат(Объект.ДатаЗакрытия, "ДФ='ММММ гггг'");
	
	мОтветственный = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");
	
	//++ Мельник Павел 20191012
	Если Объект.ВыполнитьОбщедомовыеНачисленияОмск Тогда
		НачислитьОДН();	
	КонецЕсли;
	//-- Мельник Павел 20191012
	
	Если Объект.ПереоформитьПроживающих Тогда
		
		ПереоформлениеПроживающих();
		
	КонецЕсли;
	
	Если Объект.ВводПоказанийПодкрутки И мКэшЗначений.СчетчикиПодкрутка Тогда
		
		ВводПоказанийПодкрутки();
		
	КонецЕсли; 
	
	ВыполнитьОсновныеНачисления();
	
	Если Объект.УчетСобственныхУслугПоНалоговомуИБухгалтерскомуУчету Тогда
		
		Если РеализацииОтНачисления Тогда	
			
			СформироватьАктРеализацию();
		иначе
			// БИТ ЖКХ 19.06.2020
		    Если Объект.ВидОперацииУслуги = истина Тогда
			  СформироватьАктРеализацию();				
		    КонецЕсли;
		КонецЕсли; 
		
		// БИТ_ЖКХ 23.10.2017 11:19:03 Начало правки... 
        //Если Разовые Тогда	
        //	
        //	СформироватьАктРеализациюРазовые();
        //	
        //КонецЕсли; 
		// БИТ_ЖКХ 23.10.2017 11:19:09 Конец правки. 
	иначе	
	    // БИТ ЖКХ 19.06.2020
	    Если Объект.ВидОперацииУслуги = истина Тогда
		  СформироватьАктРеализацию();				
	    КонецЕсли;	
		
	КонецЕсли; 

	
	ВыполнитьРаспределениеАванса();
	
КонецПроцедуры

&НаСервере
Процедура ПереоформлениеПроживающих()
	
	СтруктураНастроек = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьПустуюСтруктуруНастроек();
	
	СтруктураНастроек.ОбязательныеПоля.Добавить("ЛицевойСчет");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ФизЛицо");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СтатусФизЛица");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СтепеньРодства");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СтатусПроживания");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаРегистрации");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаСнятияСРегистрации");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДатаЗаписи");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ВладелецКвартиры");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ПричинаВыписки");
	СтруктураНастроек.ОбязательныеПоля.Добавить("КудаВыписан");
	СтруктураНастроек.ОбязательныеПоля.Добавить("Контрагент");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ДоляПлощади");
	СтруктураНастроек.ОбязательныеПоля.Добавить("СтатусФизЛицаДляИзменения");
	СтруктураНастроек.ОбязательныеПоля.Добавить("ПравоустанавливающиеДокументы");
	
	СтруктураНастроек.ПараметрыДанных.Вставить("Дата"       , КонецМесяца(Объект.ДатаЗакрытия));
	СтруктураНастроек.ПараметрыДанных.Вставить("Организация", Объект.Организация);
	
	СтруктураНастроек.КомпоновщикНастроек = КомпоновщикНастроек;
	СтруктураНастроек.ИмяМакетаСхемыКомпоновкиДанных = "ПереоформлениеПроживающих";
	
	СтруктураРезультата = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПодготовитьСтруктуруДанных(СтруктураНастроек);
	
	ВыборкаЛС = СтруктураРезультата.РезультатЗапроса.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		ДокументРПЛ = Неопределено;
		
		Выборка = ВыборкаЛС.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если ДокументРПЛ = Неопределено Тогда
				
				ДокументРПЛ = Документы.бит_РегистрацияПроживающихПоЛС.СоздатьДокумент();
				
				ДокументРПЛ.Дата          = КонецДня(Объект.ДатаЗакрытия) - 2;
				ДокументРПЛ.ЛицевойСчет   = ВыборкаЛС.ЛицевойСчет;
				ДокументРПЛ.Комментарий   = "Документ создан автоматически при закрытии месяца " + мДатаТекст;
				ДокументРПЛ.Ответственный = мОтветственный;
				
			КонецЕсли;
			
			НоваяСтрока = ДокументРПЛ.СписокПроживающих.Добавить();
			
			НоваяСтрока.ФизЛицо                       = Выборка.ФизЛицо;
			НоваяСтрока.ДатаРегистрации               = Выборка.ДатаРегистрации;
			НоваяСтрока.ДатаСнятияСРегистрации        = Выборка.ДатаСнятияСРегистрации;
			НоваяСтрока.СтатусПроживания              = Выборка.СтатусПроживания;
			НоваяСтрока.СтепеньРодства                = Выборка.СтепеньРодства;
			НоваяСтрока.ПравоустанавливающиеДокументы = Выборка.ПравоустанавливающиеДокументы; 
			НоваяСтрока.ВладелецКвартиры              = Выборка.ВладелецКвартиры;
			НоваяСтрока.ДоляПлощади                   = Выборка.ДоляПлощади;
			
			Если ЗначениеЗаполнено(Выборка.ДатаЗаписи) Тогда
				
				НоваяСтрока.СтатусФизЛица = ?(НЕ ЗначениеЗаполнено(Выборка.СтатусФизЛицаДляИзменения),
				Справочники.бит_СтатусФизЛица.ПостояннаяРегистрация,
				Выборка.СтатусФизЛицаДляИзменения);
				
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
				
				НоваяСтрока.СтатусФизЛица  = Справочники.бит_СтатусФизЛица.Выписан;
				НоваяСтрока.ПричинаВыписки = Справочники.бит_ПричиныВыписки.ОкончаниеВремениРегистрации;
				
			КонецЕсли;  
			
