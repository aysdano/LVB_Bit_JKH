#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	СправочникОбъект = ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.бит_УслугиЖКХ"));
	// Вызов механизма разделения прав доступа
	бит_ПраваДоступа.ПередОткрытиемФормы(Отказ,СтандартнаяОбработка,СправочникОбъект,ЭтаФорма);	
	
	//АПК пункт 4 https://its.1c.ru/db/v8std/content/737/hdoc
	Элементы.Файлы.Доступность = РольДоступна("ПолныеПрава");
	
	Если Объект.Ссылка = ПредопределенноеЗначение("Справочник.бит_УслугиЖКХ.Пеня") Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Услуга ""Пеня"" не редактируется.";
		Сообщение.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли; 
	ЗначениеВДанныеФормы(СправочникОбъект,Объект);
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьОтборы();
	
	// Выделяем основной способ расчета
	Для каждого Строка Из Объект.СпособыРасчета Цикл
		
		Если Объект.ОсновнойСпособРасчета <> Неопределено Тогда
			
			Если Объект.ОсновнойСпособРасчета = Строка.СпособРасчета Тогда
				
				Строка.Основной          = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
	// Выделяем основной Режим потребления
	Для каждого Строка Из Объект.РежимыПотребленияУслуг Цикл
		
		Если Объект.ОсновнойРежимПотребления <> Неопределено Тогда
			
			Если Объект.ОсновнойРежимПотребления = Строка.РежимПотребленияУслуг Тогда
				
				Строка.Основной          = Истина;
				
			КонецЕсли;
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	мКэшЗначений.ЭтоНовый = Ложь;
	
	УстановитьОтборы();
	
КонецПроцедуры

// Процедура - обработчик события "Нажатие" кнопки "Файлы" коммандной панели формы. 
////
&НаКлиенте
Процедура Файлы(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ФайлыЗавершение", ЭтотОбъект), "Сначала запишите документ.");
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Объект", Объект.Ссылка);
	
	ОткрытьФорму("Справочник.бит_рз_ХранилищеДополнительнойИнформации.Форма.ФормаСпискаУправляемая", Новый Структура("ЗаполнитьИзСправочникаУслугиЖКХ", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыЗавершение(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

// Процедура - обработчик события "ПриИзменении" поля ввода Наименование.
//
&НаКлиенте
Процедура НаименованиеПриИзменении(Элемент)
	Если Не ЗначениеЗаполнено(Объект.НаименованиеПолное) тогда
		Объект.НаименованиеПолное      = Объект.Наименование;
		Объект.НаименованиеСокращенное = Лев(Объект.Наименование, 12);
	КонецЕсли;  
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийКомандныхПанелейФормы

// Процедура - обработчик события "Нажатие" кнопки "Основной" командной панели СпособыРасчета.
//
&НаКлиенте
Процедура Основной(Команда)
	
	ТекущаяСтрока = Элементы.СпособыРасчета.ТекущиеДанные;
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		Если  ТекущаяСтрока.СпособРасчета =  ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоРаспределению") Тогда
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ОсновнойЗавершение1", ЭтотОбъект), "Способ расчета ""По Распределению"" не может быть основным");	
			
		ИначеЕсли  ТекущаяСтрока.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")  Тогда
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("ОсновнойЗавершение", ЭтотОбъект), "Способ расчета ""По счетчикам"" не может быть основным");	
			
		Иначе
			Для каждого Строка Из Объект.СпособыРасчета Цикл
				
				Строка.Основной = Ложь;
				
			КонецЦикла; 
			
			Объект.ОсновнойСпособРасчета = ТекущаяСтрока.СпособРасчета;
			
			ТекущаяСтрока.Основной          = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновнойЗавершение1(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОсновнойЗавершение(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

// Процедура - обработчик события "Нажатие" кнопки "Основной" командной панели РежимыПотребленияУслуг.
//
&НаКлиенте
Процедура ОсновнойРежим(Команда)
	
	ТекущаяСтрока = Элементы.РежимыПотребленияУслуг.ТекущиеДанные;
	
	Для каждого Строка Из Объект.РежимыПотребленияУслуг Цикл
		
		Строка.Основной = Ложь;
		
	КонецЦикла; 
	
	Если ТекущаяСтрока <> Неопределено Тогда
		
		Объект.ОсновнойРежимПотребления = ТекущаяСтрока.РежимПотребленияУслуг;
		ТекущаяСтрока.Основной          = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "Нажатие" кнопки "Добавить" командной панели НормыНаУслуги.
//
&НаКлиенте
Процедура Добавить(Команда)
	
	Если мКэшЗначений.ЭтоНовый Тогда
		
		Отказ = Истина;
		
		ПоказатьПредупреждение(Новый ОписаниеОповещения("НормыУслугПередНачаломДобавленияЗавершение", ЭтотОбъект), "Сначала сохраните справочник");	
		
	Иначе 
		
		УстановитьОтборы();	
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Услуга",Объект.Ссылка);
		ПараметрыФормы.Вставить("Период",ТекущаяДата());
		ФормаОткрытия = ОткрытьФорму("РегистрСведений.бит_НормыНаУслуги.Форма.ФормаЗаписиУправляемая",Новый Структура("ЗаполнитьИзСправочникаУслугиЖКХ", ПараметрыФормы),ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура - обработчик события "Нажатие" кнопки "Обновить" командной панели НормыНаУслуги.
//
&НаКлиенте
Процедура Обновить(Команда)
	УстановитьОтборы();
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоляСпособыРасчета

// Процедура - обработчик события "ПередУдалением" табличного поля Способы расчета.
//
&НаКлиенте
Процедура СпособыРасчетаПередУдалением(Элемент, Отказ)
	
	ТекущаяСтрока = Элементы.СпособыРасчета.ТекущиеДанные;
	СпособРасчета  = ТекущаяСтрока.СпособРасчета;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	УдалениеРазрешено = Истина;
	
	Отбор = Новый Структура("СпособРасчета", ТекущаяСтрока.СпособРасчета);
	
	Строки = Объект.СпособыРасчета.НайтиСтроки(Отбор);
	
	Если Строки.Количество() <= 1 Тогда
		
		УдалениеРазрешено = ОпределитьВозможностьУдаленияСпособаРасчета(ТекущаяСтрока.СпособРасчета);	
		
	КонецЕсли; 
	
	Если НЕ УдалениеРазрешено Тогда
		Отказ = Истина;

