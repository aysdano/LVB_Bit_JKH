					ДокументВводПоказаний.ПоказанияПоСчетчикам.Удалить(Элт);
				КонецЦикла;
			КонецЕсли;
			
			
			Попытка
	//			Если ПревышениеРазрядности Тогда
	//				ДокументВводПоказаний.Записать(РежимЗаписиДокумента.Запись);
	//			Иначе
				ДокументВводПоказаний.Записать(РежимЗаписиДокумента.Проведение);
				
				Отбор = Новый Структура;
	            Отбор.Вставить("ДатаОплаты_ЛицевойСчет_Услуга", стрОплат);

	            ТаблицаДат = тДеревоОплаты.Строки.НайтиСтроки(Отбор);
                ТаблицаДат[0].ДокументОплаты = ДокументВводПоказаний.Ссылка;
	//			КонецЕсли;
				ТекстСообщения = НСтр("ru = 'Создан документ ввода показаний: %1'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, ДокументВводПоказаний.Ссылка);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения, ДокументВводПоказаний.Ссылка);
			Исключение
				Ошибка = Истина;
				ТекстСообщения = НСтр("ru = 'Ошибка при записи документов ввода показаний счетчиков: %1'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке()));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				ОтменитьТранзакцию();
			КонецПопытки;
			
	  КонецЦикла;	
    КонецЦикла;
  
    ЗначениеВРеквизитФормы(тДеревоОплаты, "ДеревоОплаты");

КонецПроцедуры

Функция НайтиДатуДокумента(датаДока)
	
 докПоказаний = Документы.бит_ВводПоказанийПоСчетчикам.ПустаяСсылка();
 датаДокаЛок = НачалоДня(датаДока) + 43200;
 пока докПоказаний = Документы.бит_ВводПоказанийПоСчетчикам.ПустаяСсылка() цикл	
  Выборка = Документы.бит_ВводПоказанийПоСчетчикам.Выбрать(датаДокаЛок, датаДокаЛок);
  если Выборка.Следующий() тогда
   датаДокаЛок = датаДокаЛок + 60;
  иначе
   прервать;
  конецесли; 
 конеццикла;	

 возврат датаДокаЛок;
КонецФункции // НайтиДатуДокумента()

Функция ПолучитьТаблицуУслуг(Счетчик, Период)

  запрос = новый Запрос;
  запрос.Текст = "ВЫБРАТЬ
                 |	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга КАК Услуга
                 |ИЗ
                 |	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&Период, ) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
                 |ГДЕ
                 |	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = &Счетчик
                 |	И бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик.ПометкаУдаления = ложь";
  
  запрос.УстановитьПараметр("Счетчик", Счетчик);
  запрос.УстановитьПараметр("Период", Период);
  
  таб = новый ТаблицаЗначений;
  таб = запрос.Выполнить().Выгрузить();  
  
  возврат таб;
  
КонецФункции // ПолучитьТаблицуУслуг()


Функция ПолучитьКоличествоЕдиницПоСчетчику(Счетчик)

  запрос = новый Запрос;
  запрос.Текст = 
  "ВЫБРАТЬ РАЗРЕШЕННЫЕ
   | СУММА(бит_КолЕдиницПоСчетчикамОбороты.КоличествоЕдиницПоЛСОборот + бит_КолЕдиницПоСчетчикамОбороты.КоличествоЕдПодкруткаОборот) КАК КоличествоЕдиниц
   | ИЗ
   |	РегистрНакопления.бит_КолЕдиницПоСчетчикам.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ) КАК бит_КолЕдиницПоСчетчикамОбороты
   | ГДЕ
   |	НЕ бит_КолЕдиницПоСчетчикамОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
   |	И бит_КолЕдиницПоСчетчикамОбороты.Счетчик = &Счетчик";

   запрос.УстановитьПараметр("Счетчик", Счетчик);
   запрос.УстановитьПараметр("НачалоПериода", '00010101000000');
   запрос.УстановитьПараметр("КонецПериода", '00010101000000');
   
   таб = запрос.Выполнить().Выгрузить();
   
   если таб.Количество() > 0 тогда
	 возврат таб[0].КоличествоЕдиниц;   
   иначе	   
	 возврат неопределено;  
   конецесли;	

КонецФункции // ПолучитьКоличествоЕдиницПоСчетчику()


функция ПолучитьПредыдущиеПоказанияСчетчика(Дата, Счетчик, Услуга)
	
  запрос = новый Запрос;
  запрос.Текст = 
  "ВЫБРАТЬ
  |	бит_ПоказанияСчетчиковОстатки.Объект КАК Объект,
  |	бит_ПоказанияСчетчиковОстатки.Услуга КАК Услуга,
  |	бит_ПоказанияСчетчиковОстатки.Счетчик КАК Счетчик,
  |	бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток КАК ПредыдущиеПоказания
  |ИЗ
  |	РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(&Дата, ) КАК бит_ПоказанияСчетчиковОстатки
  |ГДЕ
  |	бит_ПоказанияСчетчиковОстатки.Счетчик = &Счетчик
  |	И бит_ПоказанияСчетчиковОстатки.Услуга = &Услуга";
  
   запрос.УстановитьПараметр("Счетчик", Счетчик);
   запрос.УстановитьПараметр("Дата", Дата);
   запрос.УстановитьПараметр("Услуга", Услуга);
   
   таб = запрос.Выполнить().Выгрузить();
   
   если таб.Количество() > 0 тогда
	 возврат таб[0].ПредыдущиеПоказания;   
   иначе	   
	 возврат неопределено;  
   конецесли;	   
конецфункции	


//16.05.2019
&НаКлиенте
Процедура ВидЗагрузкиПриИзменении(Элемент)
	если Объект.ВидЗагрузки = "ПоказанияСчетчиков" тогда
	  Элементы.ДеревоОплатыСоздатьВводПоказанийПоСчетчикам.Видимость = истина;
	  Элементы.СоздатьОплаты.Видимость = ложь;
	  
      Элементы.ДеревоОплатыСчетчик.Видимость = истина;
	  Элементы.ДеревоОплатыЗначениеСчетчика.Видимость = истина; 
	  
	  Элементы.ДеревоОплатыИсточникОплаты.Видимость = ложь;
	  Элементы.ДеревоОплатыКомментарий.Видимость = ложь;
	  Элементы.ДеревоОплатыНазначениеПлатежа.Видимость = ложь;
	  Элементы.ДеревоОплатыСумма.Видимость = ложь;
	  Элементы.ДеревоОплатыСуммаСУчетомПроцента.Видимость = ложь;
	  Элементы.ДеревоОплатыШаблонИзвещений.Видимость = ложь;
	  
	  Элементы.ДеревоОплатыДокументОплаты.Заголовок = "Документ ввода показаний";
	  
    иначе
	  Элементы.ДеревоОплатыСоздатьВводПоказанийПоСчетчикам.Видимость = ложь;
	  Элементы.СоздатьОплаты.Видимость = истина;
	  
	  Элементы.ДеревоОплатыИсточникОплаты.Видимость = истина;
	  Элементы.ДеревоОплатыКомментарий.Видимость = истина;
