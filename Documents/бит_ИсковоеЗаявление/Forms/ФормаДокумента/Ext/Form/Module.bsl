&НаСервере
Процедура ПодстановкаСуммыЗадолженностиСервер();
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет КАК ЛицевойСчет,
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ.ГруппаУслуги <> ЗНАЧЕНИЕ(Справочник.бит_ГруппыУслуг.ПустаяСсылка)
	|			ТОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ.ГруппаУслуги
	|		ИНАЧЕ бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ
	|	КОНЕЦ КАК УслугаЖКХ,
	|	СУММА(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток) КАК СуммаОстаток
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&ДатаОстатков, ) КАК бит_НачисленияПоУслугамЖКХОстатки
	|ГДЕ
	|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет В(&ЛицевойСчет)
	|	И бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ В(&УслугаЖКХ)
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет,
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ.ГруппаУслуги <> ЗНАЧЕНИЕ(Справочник.бит_ГруппыУслуг.ПустаяСсылка)
	|			ТОГДА бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ.ГруппаУслуги
	|		ИНАЧЕ бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("ЛицевойСчет",Объект.ЛицевойСчет);
	Запрос.УстановитьПараметр("УслугаЖКХ",ГруппаУслуг(Объект.Услуга));
	Запрос.УстановитьПараметр("ДатаОстатков",НачалоМесяца(ТекущаяДата()));
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда                        
		Объект.СуммаЗадолженности = Выборка.СуммаОстаток;
	Иначе
		Объект.СуммаЗадолженности = 0;
	КонецЕсли; 
	
КонецПроцедуры


функция ГруппаУслуг(Услуга)
	
	ЗапросУслуги = Новый Запрос;
	ЗапросУслуги.Текст = 
	"ВЫБРАТЬ
	|  бит_УслугиЖКХ.Ссылка КАК Услуга
	|ИЗ
	|  Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	|ГДЕ
	|  бит_УслугиЖКХ.ГруппаУслуги В(&ОбязательныеГруппыУслуг)";
	
	ОбязательныеУслуги = Новый Массив();
	ОбязательныеУслуги.Добавить(Услуга.ГруппаУслуги);
	
	ЗапросУслуги.УстановитьПараметр("ОбязательныеГруппыУслуг", ОбязательныеУслуги);
	РезультатЗапроса = ЗапросУслуги.Выполнить();
	
	Если  НЕ РезультатЗапроса.Пустой() Тогда
		ОтборУслуги = РезультатЗапроса.Выгрузить();
		ОтборУслуги = ОтборУслуги.ВыгрузитьКолонку("Услуга");
	Иначе
		ОтборУслуги = Услуга;
	КонецЕсли;
	
	Возврат ОтборУслуги;
	
КонецФункции
&НаСервере
Процедура СуммаЗадолженностиПриИзмененииНаСервере()
	
	СуммаЗадолженности = Объект.СуммаЗадолженности;
	РГП = РасчетГоспошлины();
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период",ТекущаяДата());
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ПредставительскиеРасходыСрезПоследних.Стоимость КАК Стоимость
	|ИЗ
	|	РегистрСведений.бит_ПредставительскиеРасходы.СрезПоследних(&Период, ) КАК бит_ПредставительскиеРасходыСрезПоследних";
	
	Результат = Запрос.Выполнить();
	
	Выборка = Результат.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Объект.ПредставительскиеРасходы = Выборка.Стоимость;
		
	КонецЕсли;
	
	

	Если РГП.Количество() > 0 Тогда
		Если Объект.ТипДокумента = ПредопределенноеЗначение("Перечисление.ТипыЮридическихДокументов.СудебныйПриказ") Тогда
			
			Объект.Госпошлина = ?(СуммаЗадолженности <= РГП[0].КонечнаяСуммаДолга, Макс((СуммаЗадолженности * РГП[0].Процент)/2, РГП[0].МинимальныйРазмерПошлины), 
			? (СуммаЗадолженности <= РГП[1].КонечнаяСуммаДолга, (800 + (СуммаЗадолженности - РГП[0].КонечнаяСуммаДолга) * РГП[1].Процент)/2,
			? (СуммаЗадолженности <= РГП[2].КонечнаяСуммаДолга, (3200 + (СуммаЗадолженности - РГП[1].КонечнаяСуммаДолга) * РГП[2].Процент)/2,
			? (СуммаЗадолженности <= РГП[3].КонечнаяСуммаДолга, (5200 + (СуммаЗадолженности - РГП[2].КонечнаяСуммаДолга) * РГП[3].Процент)/2,
			Мин((6600 + (СуммаЗадолженности - РГП[4].КонечнаяСуммаДолга) * РГП[4].Процент)/2, 60000)
			))));
			
			//Объект.Госпошлина = ?(СуммаЗадолженности <= 20000, Макс(СуммаЗадолженности * 0.04, 200), 
			//? (СуммаЗадолженности <= 100000, 400 + (СуммаЗадолженности - 20000) * 0.03,
			//? (СуммаЗадолженности <= 200000, 1600 + (СуммаЗадолженности - 100000) * 0,02,
			//? (СуммаЗадолженности <= 1000000, 2600 + (СуммаЗадолженности - 200000) * 0.01,
			//Мин(6600 + (СуммаЗадолженности - 1000000) * 0.005 ,60000)
			//))));
			
		Иначе
			Объект.Госпошлина = ?(СуммаЗадолженности <= РГП[0].КонечнаяСуммаДолга, Макс(СуммаЗадолженности * РГП[0].Процент, РГП[0].МинимальныйРазмерПошлины), 
			? (СуммаЗадолженности <= РГП[1].КонечнаяСуммаДолга, РГП[1].ФиксированнаяЧастьПошлины + (СуммаЗадолженности - РГП[0].КонечнаяСуммаДолга) * РГП[1].Процент,
			? (СуммаЗадолженности <= РГП[2].КонечнаяСуммаДолга, РГП[2].ФиксированнаяЧастьПошлины + (СуммаЗадолженности - РГП[1].КонечнаяСуммаДолга) * РГП[2].Процент,
			? (СуммаЗадолженности <= РГП[3].КонечнаяСуммаДолга, РГП[3].ФиксированнаяЧастьПошлины + (СуммаЗадолженности - РГП[2].КонечнаяСуммаДолга) * РГП[3].Процент,
			Мин(РГП[4].ФиксированнаяЧастьПошлины + (СуммаЗадолженности - РГП[3].КонечнаяСуммаДолга) * РГП[4].Процент, 60000)
			))));
			
			
			//Объект.Госпошлина = ?(СуммаЗадолженности <= 20000, Макс(СуммаЗадолженности * 0.04, 400), 
			//? (СуммаЗадолженности <= 100000, 800 + (СуммаЗадолженности - 20000) * 0.03,
			//? (СуммаЗадолженности <= 200000, 3200 + (СуммаЗадолженности - 100000) * 0.02,
			//? (СуммаЗадолженности <= 1000000, 5200 + (СуммаЗадолженности - 200000) * 0.01,
			//Мин(13200 + (СуммаЗадолженности - 1000000) * 0.005 ,60000)
			//))));
			
		КонецЕсли;
	КонецЕсли;
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

