	ТекущиеДанные = Элементы.бит_Дети.ТекущиеДанные;
	ТекущаяСтрокаИдентификатор = ТекущиеДанные.ПолучитьИдентификатор();
	бит_ДетиОбработатьНаСервере(ТекущаяСтрокаИдентификатор, Истина);

КонецПроцедуры

&НаСервере
Процедура бит_ДетиОбработатьНаСервере(ТекущаяСтрокаИдентификатор, УдалитьСтроку = Ложь)

	ТекущаяСтрока = Объект.бит_Дети.НайтиПоИдентификатору(ТекущаяСтрокаИдентификатор);
	
	бит_ЗаполнитьСвязанныхДетей(Объект.Ссылка, ТекущаяСтрока.Проживающий, УдалитьСтроку);

КонецПроцедуры 

&НаСервере
Процедура бит_ЗаполнитьСвязанныхДетей(Проживающий, Ребенок, УдалитьСтроку)

	ШаблонОшибкиЗаписать = НСтр("ru='Не удалось записать %Справочник%. %ОписаниеОшибки%'");
	ЗаписатьОбъект = Ложь;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_Проживающиебит_ЗаконныеПредставители.Ссылка КАК Ссылка,
	|	бит_Проживающиебит_ЗаконныеПредставители.Проживающий КАК Проживающий
	|ИЗ
	|	Справочник.бит_Проживающие.бит_ЗаконныеПредставители КАК бит_Проживающиебит_ЗаконныеПредставители
	|ГДЕ
	|	бит_Проживающиебит_ЗаконныеПредставители.Ссылка = &Ребенок
	|	И бит_Проживающиебит_ЗаконныеПредставители.Проживающий = &Проживающий";
	
	Запрос.УстановитьПараметр("Ребенок", Ребенок);
	Запрос.УстановитьПараметр("Проживающий", Проживающий);
	
	Если УдалитьСтроку Тогда
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		МассивДляУдаления = Новый Массив;
		
		Если Выборка.Следующий() Тогда
			
			РебенокОбъект = Ребенок.ПолучитьОбъект();
			
			Для каждого стрТЧ Из РебенокОбъект.бит_ЗаконныеПредставители Цикл
				
				Если стрТЧ.Проживающий = Выборка.Проживающий Тогда
					МассивДляУдаления.Добавить(стрТЧ);
				КонецЕсли;
				
			КонецЦикла;
			
			Для каждого элМассива Из МассивДляУдаления Цикл
				РебенокОбъект.бит_ЗаконныеПредставители.Удалить(элМассива);
			КонецЦикла;
			
		ЗаписатьОбъект = Истина;	
		КонецЕсли;
		
	Иначе
		
		Если Запрос.Выполнить().Пустой() Тогда
			
			РебенокОбъект = Ребенок.ПолучитьОбъект();
			
			НовСтрока = РебенокОбъект.бит_ЗаконныеПредставители.Добавить();
			НовСтрока.Проживающий = Проживающий;
			
			ЗаписатьОбъект = Истина;
		КонецЕсли;	
		
	КонецЕсли;
	
	Если ЗаписатьОбъект Тогда
		
		Попытка
			РебенокОбъект.Записать();
		Исключение
			ТекстОшибки = СтрЗаменить(ШаблонОшибкиЗаписать, "%Справочник%", Ребенок);
			ТекстОшибки = СтрЗаменить(ТекстОшибки, "%ОписаниеОшибки%", КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки, Ребенок);
		КонецПопытки;
		
	КонецЕсли;


КонецПроцедуры 

