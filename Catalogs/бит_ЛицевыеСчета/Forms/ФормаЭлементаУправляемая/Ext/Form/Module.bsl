
#Область ПеременныеМодуля

Перем мДеревоМакетов;            // Хранит дерево макетов печатных форм.

Перем мПодменюПечати;            // Хранит элемент управления подменю печати.

Перем мПечатьПоУмолчанию;        // Хранит элемент управления кнопку печать по умолчанию.

Перем мКоличествоПроживающих;  // Хранит кол-во проживающих. 

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура устанавливает видимость.
//
&НаСервере
Процедура УстановитьВидимость()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НастройкаПараметровЖКХСрезПоследних.НачислятьПени КАК НачислятьПени
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(
	|			&Дата,
	|			Организация = &Организация
	|				И НачислятьПени = ИСТИНА) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	Запрос.УстановитьПараметр("Дата"       ,КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("Организация",Объект.Организация);
	
	Элементы.Пени.Доступность = ?(Запрос.Выполнить().Пустой() ,Ложь, Истина);
	
	
	Если Объект.ОтображатьПоГруппам Тогда
		Элементы.ДеревоНачислений.Видимость = Истина;
		Элементы.ТаблицаНачислений.Видимость = Ложь;
		Элементы.ДеревоУслуг.Видимость = Истина;	
		Элементы.Услуги.Видимость = Ложь;
		
		// БИТ_ЖКХ 11.09.2014
		Элементы.РазвернутьДерево.Видимость = Истина;
		Элементы.СвернутьДерево.Видимость = Истина;
		Элементы.РазвернутьДеревоУслуг.Видимость = Истина;
		Элементы.СвернутьДеревоУслуг.Видимость = Истина;
		Элементы.ВывестиСписокДеревоНачислений.Видимость = Истина;
		Элементы.ВывестиСписокТаблицаНачислений.Видимость = Ложь;
		// БИТ_ЖКХ 11.09.2014
		
	Иначе
		Элементы.ДеревоНачислений.Видимость = Ложь;
		Элементы.ТаблицаНачислений.Видимость = Истина;
		Элементы.ДеревоУслуг.Видимость = Ложь;	
		Элементы.Услуги.Видимость = Истина;	
		
		// БИТ_ЖКХ 11.09.2014
		Элементы.РазвернутьДерево.Видимость = Ложь;
		Элементы.СвернутьДерево.Видимость = Ложь;
		Элементы.РазвернутьДеревоУслуг.Видимость = Ложь;
		Элементы.СвернутьДеревоУслуг.Видимость = Ложь;
		Элементы.ВывестиСписокДеревоНачислений.Видимость = Ложь;
		Элементы.ВывестиСписокТаблицаНачислений.Видимость = Истина;
		// БИТ_ЖКХ 11.09.2014
		
	КонецЕсли;
	
КонецПроцедуры

// Процедура заполняет реквизиты нового элемента справочника.
//
&НаСервере
Процедура ЗаполнитьНовыйПоСпискуОтборов()
	
	Если ТипЗнч(СписокОтборов) <> Тип("Отбор") Тогда
		Возврат;
	КонецЕсли;
	
	РеквизитыСправочника = Объект.Ссылка.Метаданные().Реквизиты;
	
	Для каждого ЭлементОтбора Из СписокОтборов Цикл
		
		Если НЕ ЭлементОтбора.Использование Тогда
			Продолжить;
		КонецЕсли;
		
		Если РеквизитыСправочника.Найти(ЭлементОтбора.Имя) = Неопределено 
			И ЭлементОтбора.Имя <> "Владелец" 
			И ЭлементОтбора.Имя <> "Родитель" Тогда
			Продолжить;
		КонецЕсли;
		
		СправочникОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		Если ЭлементОтбора.ВидСравнения = ВидСравнения.Равно Тогда
			
			СправочникОбъект[ЭлементОтбора.Имя] = ЭлементОтбора.Значение;
			
		ИначеЕсли ЭлементОтбора.ВидСравнения = ВидСравнения.ВСписке Тогда
			
			СправочникОбъект[ЭлементОтбора.Имя] = ЭлементОтбора.Значение[0].Значение;
			
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

// Процедура заполняет реквизиты нового элемента справочника.
//
&НаКлиенте
Процедура ЗаполнитьНовыйЭлемент()
	
	ЗаполнитьНовыйПоСпискуОтборов();
	
КонецПроцедуры // ЗаполнитьНовыйЭлемент()

// Процедура заполняет доступные только для чтения реквизиты формы. 
// 
&НаСервере
Процедура ЗаполнитьОписания() 
	
	ОбновитьНастройкиЖКХ();
	
	мТаблицаНачислений = ДанныеФормыВЗначение(ТаблицаНачислений, Тип("ТаблицаЗначений"));
	мТаблицаНачислений.Очистить();
	
	мТаблицаСчетчиков = ДанныеФормыВЗначение(ТаблицаСчетчиков, Тип("ТаблицаЗначений"));
	мТаблицаСчетчиков.Очистить();
	
	мТаблицаРаспределений = ДанныеФормыВЗначение(ТаблицаРаспределений, Тип("ТаблицаЗначений"));
	мТаблицаРаспределений.Очистить();
	
	мТаблицаПроживающих = ДанныеФормыВЗначение(ТаблицаПроживающих, Тип("ТаблицаЗначений"));
	мТаблицаПроживающих.Очистить();
	
	мУслуги = ДанныеФормыВЗначение(Услуги, Тип("ТаблицаЗначений"));
	мУслуги.Очистить();
	
	мЛьготы = ДанныеФормыВЗначение(Льготы, Тип("ТаблицаЗначений"));
	мЛьготы.Очистить();
	
	// Заполенение параметров квартиры.
	Этаж             	= Объект.Квартира.Этаж;
	КоличествоКомнат 	= Объект.Квартира.КоличествоКомнат;
	Корпус   			= Объект.Здание.Корпус;
	
	СписокЛС = Новый Массив;
	СписокЛС.Добавить(Объект.Ссылка);
	
	СписокЗданий = Новый Массив;
	СписокЗданий.Добавить(Объект.Здание);
	
	ТаблицаНач = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуНачислений();
	ТаблицаСч  = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
	ТаблицаЛт  = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуЛьгот();
	ТаблицаРп  = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуРаспредилений();
	ТаблицаПр  = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуПроживающих();
	
	бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(ТекущаяДата(), 
	Объект.Организация, 
	СписокЛС, 
	СписокЗданий, 
	мКэшЗначений.мЛьготаПерсонифицированная, 
	Истина, 
	ТаблицаНач, 
	ТаблицаСч, 
	ТаблицаРп,
	ТаблицаЛт,
	,
	,
	мКэшЗначений.мРасчетСУчетомДолейВладения,
	мКэшЗначений.мУменьшениеНормыЛьготыВПределахФакта,
	мКэшЗначений.мНачислениеСУчетомДнейПроживания,
	ТаблицаПр,
	,
	// БИТ_ЖКХ_04102013_начало_изменений
	// мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика);.
	мКэшЗначений.мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика,
	мКэшЗначений.мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика, ,мКэшЗначений.мОптимизацияЛС);
	// БИТ_ЖКХ_04102013_окончание_изменений
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ТипПлиты,
	// БИТ_ЖКХ_17012014_начало_изменений
	|	бит_СведенияОКвартиреСрезПоследних.ЖилоеПомещениеСпециализированногоЖилищногоФонда,
	// БИТ_ЖКХ_17012014_окончание_изменений
	|	бит_СведенияОКвартиреСрезПоследних.ТипЗапирающегоУстройства
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Момент, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	
	Запрос.УстановитьПараметр("Момент"   ,КонецМесяца(ТекущаяДата()));
	Запрос.УстановитьПараметр("Квартира" ,Объект.Квартира);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		ТипКвартиры              = Выборка.ТипКвартиры;
		СтатусКвартиры           = Выборка.СтатусКвартиры;
		ОбщаяПлощадь             = Выборка.ОбщаяПлощадь;
		ЖилаяПлощадь             = Выборка.ЖилаяПлощадь;
		МОП                      = Выборка.МОП;  
		ОтапливаемаяПлощадь      = Выборка.ОтапливаемаяПлощадь;
		СовокупнаяПлощадь        = Выборка.СовокупнаяПлощадь;
		ТипПлиты                 = Выборка.ТипПлиты;
		ТипЗапирающегоУстройства = Выборка.ТипЗапирающегоУстройства;
		// БИТ_ЖКХ_17012014_начало_изменений
		ЖилоеПомещениеСпециализированногоЖилищногоФонда = Выборка.ЖилоеПомещениеСпециализированногоЖилищногоФонда;
		// БИТ_ЖКХ_17012014_окончание_изменений
	КонецЦикла;
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	ПроживающиеПоЛССрезПоследних.ДатаЗаписи,
	|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры,
	|	ПроживающиеПоЛССрезПоследних.ДоляПлощади,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛицаДляИзменения
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
	
	Запрос.УстановитьПараметр("Момент"		, КонецДня(ТекущаяДата()));
	Запрос.УстановитьПараметр("ЛицевойСчет"	, Объект.Ссылка);
	
	мКоличествоПроживающих	= 0;
	мКоличествоПоНорме			= 0;
	Постоянно					= 0;
	Времменно					= 0;
	
	мКоличествоПроживающихЛьгота = 0;
	мКоличествоПоНормеЛьгота       = 0;
	
	// БИТ_ЖКХ 24.05.2017 12:04:53 Начало правки...
	НовыйДокумент				= Неопределено; 
	// БИТ_ЖКХ 24.05.2017 12:04:53 Конец правки.
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл 
		
		Если Выборка.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
			ОтветсвенноеЛицо = Выборка.ФизЛицо;
		КонецЕсли; 
		
		НоваяСтрока = мТаблицаПроживающих.Добавить();
		НоваяСтрока.ФизЛица          = Выборка.ФизЛицо;
		НоваяСтрока.ВладелецКвартиры = Выборка.ВладелецКвартиры;
		НоваяСтрока.СтатусФизЛица    = Выборка.СтатусФизЛица; 
		
		Если ЗначениеЗаполнено(Выборка.ДатаЗаписи) 
			И НачалоДня(Выборка.ДатаЗаписи) <= НачалоДня(ТекущаяДата()) тогда
			
			Попытка
				
				Если НовыйДокумент = Неопределено Тогда
					НовыйДокумент				= Документы.бит_РегистрацияПроживающихПоЛС.СоздатьДокумент();
					НовыйДокумент.Дата			= ТекущаяДата();
					НовыйДокумент.ЛицевойСчет	= Объект.Ссылка;
					НовыйДокумент.Комментарий	= "Создан автоматически из лицевого счета.";
					НовыйДокумент.Ответственный	= бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь")//глЗначениеПеременной("глТекущийПользователь"), 
				КонецЕсли;
				
				НоваяСтрокаДОкумента = НовыйДокумент.СписокПроживающих.Добавить();
				НоваяСтрокаДОкумента.ФизЛицо                = Выборка.ФизЛицо;
				НоваяСтрокаДОкумента.ДатаРегистрации        = Выборка.ДатаРегистрации;
				НоваяСтрокаДОкумента.ДатаСнятияСРегистрации = Выборка.ДатаСнятияСРегистрации;
				НоваяСтрокаДОкумента.СтатусПроживания       = Выборка.СтатусПроживания;
				НоваяСтрокаДОкумента.СтепеньРодства         = Выборка.СтепеньРодства;
				НоваяСтрокаДОкумента.ДоляПлощади            = Выборка.ДоляПлощади;
				НоваяСтрокаДОкумента.СтатусФизЛица          = Выборка.СтатусФизЛицаДляИзменения;
				
				Если НоваяСтрокаДОкумента.СтатусФизЛица.Пустая() Тогда
					НоваяСтрокаДОкумента.СтатусФизЛица = Справочники.бит_СтатусФизЛица.ПостояннаяРегистрация;
				КонецЕсли; 
				
				НоваяСтрока.СтатусФизЛица = НоваяСтрокаДОкумента.СтатусФизЛица;
				
			Исключение
				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нет прав для работы с документом ""Регистрация проживающих по ЛС""");
			КонецПопытки; 
			
		КонецЕсли;
		
		НоваяСтрока.СтепеньРодства   = Выборка.СтепеньРодства;
		НоваяСтрока.СтатусПроживания = Выборка.СтатусПроживания;
		
		Если НоваяСтрока.СтатусФизЛица.ПроживаниеВДанныйМомент тогда
			
			мКоличествоПроживающих = мКоличествоПроживающих + 1; 
			Если Выборка.СтатусПроживания = Перечисления.бит_СтатусПроживания.Постоянно тогда
				Постоянно = Постоянно + 1;
			иначе
				Времменно = Времменно + 1;
			КонецЕсли;
			
		КонецЕсли; 
		
		НоваяСтрока.ДоляПлощади = Выборка.ДоляПлощади;
		
	КонецЦикла; // Пока Выборка.Следующий() Цикл.
	
	Попытка
		
		Если НовыйДокумент.СписокПроживающих.Количество() > 0 тогда
			Попытка
				НовыйДокумент.Записать(РежимЗаписиДокумента.Проведение);

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Изменены статусы физ. лиц.");
				
			Исключение

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ ""Регистрация проживающих по ЛС"": " +ОписаниеОшибки());

			КонецПопытки;
		КонецЕсли;
		
	Исключение
		
	КонецПопытки;
	
	ЗначениеВДанныеФормы(мТаблицаПроживающих,ТаблицаПроживающих);
	
	ВсегоПроживающих = мКоличествоПроживающих;
	
	ТаблицаПроживающихСкоп = мТаблицаПроживающих.Скопировать(Новый Структура("СтепеньРодства",Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо));
	
	Если ТаблицаПроживающихСкоп.Количество() > 1 Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("На лицевом счете должен быть один ответственный.");
		
	ИначеЕсли ТаблицаПроживающихСкоп.Количество() = 1 тогда	          
		ВладелецЛицевогоСчета = ТаблицаПроживающихСкоп[0].ФизЛица;
		
		Телефон               = бит_ОбщегоНазначения.ПолучитьТелефонИзКонтактнойИнформацииФизЛица(ВладелецЛицевогоСчета);
	ИначеЕсли ТаблицаПроживающихСкоп.Количество() = 0 тогда	

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("На лицевом счете должен быть ответственный. ");
		
	КонецЕсли;
	
