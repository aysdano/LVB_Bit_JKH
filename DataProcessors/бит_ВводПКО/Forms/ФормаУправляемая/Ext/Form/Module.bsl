&НаСервере
Процедура СоздатьПоступлениеНаСервереНовый()
	
  массивОплатПоКарте = ПолучитьДокументыДляПечати();
  ДеревоПКОМ = РеквизитФормыВЗначение("ДеревоПКО");	
  ПолучитьПодстроки(ДеревоПКОМ);  	
  
  РазбитьПоЛС = истина;
  
  Для каждого оплатаПоКарте Из массивОплатПоКарте Цикл
	  ПлатежныйДокумент = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
	  ПлатежныйДокумент.Дата = Объект.ДатаПоступления;	
	  ПлатежныйДокумент.ДокументОснование = оплатаПоКарте;
	  ПлатежныйДокумент.Заполнить(оплатаПоКарте);	  	
	  
	  если ТипЗнч(оплатаПоКарте.ДокументОснование) = Тип("ДокументСсылка.бит_ОплатаКУ") тогда
	   ДокОснование = оплатаПоКарте.ДокументОснование;  
      конецесли;
   
      если ТипЗнч(оплатаПоКарте.ДокументОснование) = Тип("ДокументСсылка.СчетНаОплатуПокупателю") тогда
	   ДокОснование = оплатаПоКарте.ДокументОснование.бит_ДокументОснование;  
	  конецесли;	  
	  
	  //БИТ ЖКХ 22.01.2021
	  ПлатежныйДокумент.СтатьяДвиженияДенежныхСредств = Объект.СтатьяДвиженияДенежныхСредств;
	  ПлатежныйДокумент.РасшифровкаПлатежа[0].СтатьяДвиженияДенежныхСредств = Объект.СтатьяДвиженияДенежныхСредств;
	  
	  ПрименениеУСН = УчетнаяПолитика.ПрименяетсяУСН(ДокОснование.Организация, ДокОснование.Дата);	  
	  ТаблицаУСН = ?(ПрименениеУСН, ПолучитьТаблицуУСН(ДокОснование), Неопределено);
	  
	  ПараметрыОтбора = Новый Структура;
	  ПараметрыОтбора.Вставить("ДокументОплаты", ДокОснование);
		
	  НайденныеСтроки = Объект.ОплатыКУ.НайтиСтроки(ПараметрыОтбора);
	  Для Каждого СтрокаТЧНайденныеСтроки Из НайденныеСтроки Цикл
			РазбитьПоЛС = СтрокаТЧНайденныеСтроки.РазбиватьПоЛицевымСчетам;
	  КонецЦикла;
		
	  если РазбитьПоЛС = ложь тогда
	   СуммаПринимаемых = ПолучитьСуммуПолучаемых(ТаблицаУСН);
	  иначе 
	   СуммаПринимаемых = ПолучитьСуммуПолучаемых(ТаблицаУСН, оплатаПоКарте.бит_ЛицевойСчет);
	  конецесли; 
				
	  
	  Если ПрименениеУСН Тогда
		ПлатежныйДокумент.Графа4_УСН	= ПлатежныйДокумент.СуммаДокумента;
		ПлатежныйДокумент.Графа5_УСН	= СуммаПринимаемых;
		ПлатежныйДокумент.Содержание_УСН= Строка(ПлатежныйДокумент.ВидОперации) + ". " + Строка(Объект.СтатьяДвиженияДенежныхСредств) + "."
	  КонецЕсли;
	  ПлатежныйДокумент.Записать();//РежимЗаписиДокумента.Проведение);
	  
	  ПолучитьИЗаписатьПриходныйКассовыйОрдерНаСервере(ПлатежныйДокумент.Ссылка, ПрименениеУСН, СуммаПринимаемых);				
	  
      ПервыйУровень = ДеревоПКОМ.Строки.Найти(оплатаПоКарте.ДокументОснование,"ПриходныйКассовыйОредер");
	  если ПервыйУровень = неопределено тогда
		ПервыйУровень = ДеревоПКОМ.Строки.Найти(оплатаПоКарте.ДокументОснование.бит_ДокументОснование,"ПриходныйКассовыйОредер");  
		ПервыйУровень = ПервыйУровень.Строки.Найти(оплатаПоКарте.ДокументОснование,"ПриходныйКассовыйОредер");
	  конецесли;	  
	  ВторойУровень = ПервыйУровень.Строки.Найти(оплатаПоКарте,"ПриходныйКассовыйОредер");
	  
	  ТретийУровень = ВторойУровень.Строки.Добавить();			

	  ТретийУровень.Выбор                    = Истина;
 	  ТретийУровень.ПриходныйКассовыйОредер  = ПлатежныйДокумент.Ссылка;
	  ТретийУровень.Сумма                    = ПлатежныйДокумент.СуммаДокумента;
	  //ВторойУровень.Этоновый                 = ПлатежныйДокумент.ЭтоНовый();
	  //ВторойУровень.СчетУчета                = Объект.СчетКасса;
	  //ВторойУровень.СтатьяДвиженийДенСредств = Объект.СтатьяДвиженияДенежныхСредств;	

  конеццикла;
  
  ЗначениеВРеквизитФормы(ДеревоПКОМ, "ДеревоПКО");

конецПроцедуры

