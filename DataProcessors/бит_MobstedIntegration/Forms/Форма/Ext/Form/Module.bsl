Функция ПолучитьПоказанияСчетчиков(СДаты, ПоДату)
	
	ЕстьОтвет = Истина;
	
	АдресСервисаСтр = СокрЛП(Объект.АдресСервиса);
	АдресРесурса = "/api/v4/events?ApplicationId="+Объект.НомерПриложения+"&query=";
	
	СтрокаПараметров = 
	"["
	+"{"
	+"""field"""                +":"+ """StatusId"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+""""+Строка(Объект.СтатусВРаботе)+""""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+","
	+"{"
	+"""field"""                +":"+ """ActionName"""+","
	+"""operation"""            +":"+ """="""+","
	+"""value"""                +":"+"""Показания приборов учета"""+","
	+"""andor"""                +":"+"""and"""
	+"}"
	+"]";
	
	СтрокаПараметров = КодироватьСтроку(СтрокаПараметров,СпособКодированияСтроки.КодировкаURL);
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		ЕстьОтвет = Ложь;
		Сообщить("Получение показаний счетчиков. Ошибка при отправке запроса: " + ОписаниеОшибки());
	КонецПопытки;
	
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				Если СокрЛП(РезультатПроверки)="false" Тогда
					Сообщить("Соединение не установлено");
				Иначе
					
					
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
					ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
					ЧтениеJSON.Закрыть();
					
					ТЗ = РаспарситьВТаблицуПоказания(ЗагруженныеДанные);
					
					ЗагрузитьТаблицуВДокумент(ТЗ);
					
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			Сообщить("Получение показаний. "+"Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Сообщить("Получение показаний. "+"Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Сообщить("Получение показаний. "+"Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
		Иначе
			Сообщить("Получение показаний. "+"Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
		КонецЕсли;
	КонецЕсли;
КонецФункции

Функция РаспарситьВТаблицуПоказания(Данные)	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("ЛС");
	ТЗ.Колонки.Добавить("Показатель");
	ТЗ.Колонки.Добавить("ПриборУчета");
	ТЗ.Колонки.Добавить("Дата");
	ТЗ.Колонки.Добавить("Статус");
	ТЗ.Колонки.Добавить("ИД_События");
	ТЗ.Колонки.Добавить("ИмяСчетчика");
	ТЗ.Колонки.Добавить("УслугаСчетчика");
	Для Каждого стр из Данные Цикл
		
		Нов = ТЗ.Добавить();
		
		Нов.ЛС            = Стр["object_Код1С"];
		Нов.Показатель    = Стр["value_Показатель"];
		Нов.ПриборУчета   = Стр["value_ПриборУчета"];
		Нов.ИмяСчетчика   = Стр["value_Наименование_прибора"]; // value_Сч":"СчЭЭНочь1"
		Нов.ИмяСчетчика   = СтрЗаменить(СокрЛП(Нов.ИмяСчетчика),"Счетчик электроэнергии ","");
		Нов.ИмяСчетчика   = СтрЗаменить(СокрЛП(Нов.ИмяСчетчика),"Счетчик горячего водоснабжения ","");
		Нов.ИмяСчетчика   = СтрЗаменить(СокрЛП(Нов.ИмяСчетчика),"Счетчик холодного водоснабжения ","");
		Нов.ИмяСчетчика   = СтрЗаменить(СокрЛП(Нов.ИмяСчетчика),"Счетчик отопления ","");
		
		Нов.УслугаСчетчика          = Стр["value_Имя"];
		
		
		Нов.Дата          = Стр["UpdateDate"];
		Нов.Статус        = Стр["StatusId"]; //17 - Обработан;  15 - В Работе
		Нов.ИД_События    = Стр["id"];       //ИД события по которому будем менять статус
		Нов.ИД_События    = СтрЗаменить(СокрЛП(Нов.ИД_События),Символы.НПП,"");       //ИД события по которому будем менять статус
	КонецЦикла;	
	
	Возврат ТЗ;
	
	
КонецФункции	                     

