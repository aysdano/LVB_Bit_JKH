// Функция выполняет расчет нормы по услугам.
//
// Параметры:
//  Выборка  - ВыборкаИзРезультатаЗапроса.  - Входящие данные.
//
// Возвращаемое значение:
//   Число   - количество нормы на лс по услуге.
//
Функция ПолучитьНорму(Выборка)
	
	Норма = 0;
	
	// БИТ_ЖКХ 16.05.2017 14:31:38 Начало правки...
	//мКоличествоПроживающихДляРасчета = Выборка.мКоличествоПоНорме;
	Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающимСНормативом Тогда
		мКоличествоПроживающихДляРасчета = Выборка.КоличествоПроживающихПоНорме;	
	Иначе
		мКоличествоПроживающихДляРасчета = Выборка.мКоличествоПоНорме;
	КонецЕсли;
	// БИТ_ЖКХ 16.05.2017 14:31:38 Конец правки.
	
	Если мКоличествоПроживающихДляРасчета = 1 тогда
		Норма  = Выборка.НаОдного + ?(Выборка.ИспользоватьДопНормуНаОдного,Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого,0);
	ИначеЕсли мКоличествоПроживающихДляРасчета = 2 тогда
		Норма  = Выборка.НаДвоих * 2 + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * 2;
		// БИТ_ЖКХ изменение кода. Начало. 21.05.2012{{
		// ИначеЕсли мКоличествоПроживающихДляРасчета > 2 тогда.
	ИначеЕсли мКоличествоПроживающихДляРасчета = 3 тогда
		Норма  = Выборка.НаСемью * мКоличествоПроживающихДляРасчета + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПроживающихДляРасчета;  
	ИначеЕсли мКоличествоПроживающихДляРасчета = 4 тогда
		Норма  = Выборка.НаСемью4 * мКоличествоПроживающихДляРасчета + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПроживающихДляРасчета;  
	ИначеЕсли мКоличествоПроживающихДляРасчета = 5 тогда
		Норма  = Выборка.НаСемью5 * мКоличествоПроживающихДляРасчета + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПроживающихДляРасчета;  
	ИначеЕсли мКоличествоПроживающихДляРасчета > 5 тогда
		Норма  = Выборка.НаСемью6 * мКоличествоПроживающихДляРасчета + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПроживающихДляРасчета;  
		// БИТ_ЖКХ изменение кода. Конец. 21.05.2012}}
	КонецЕсли;
	
	Возврат Окр(Норма, 4);
	
КонецФункции // ПполучитьНорму()

// Функция выполняет расчет нормы льготы по услуге.
//
// Параметры:
//  Выборка  - ВыборкаИзРезультатаЗапроса.  - Входящие данные.
//
// Возвращаемое значение:
//   Число   - количество нормы льготы на лс по услуге.
//
Функция ПолучитьНормуЛьготы(Выборка)
	
	НормаЛьготы = 0;
	
	мКоличествоПоНормеЛьгота = Выборка.мКоличествоПоНормеЛьгота;
	
	Если Выборка.мКоличествоПоНормеЛьгота = 1 Тогда 
		
		Если Выборка.ИспользоватьДопНормуНаЛьготника тогда
			НормаЛьготы = Выборка.НаОдного + ?(Выборка.ИспользоватьДопНормуНаОдного,Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого,0);
		иначе
			НормаЛьготы = Выборка.НаОдного; 	
		КонецЕсли;
		
	ИначеЕсли Выборка.мКоличествоПоНормеЛьгота = 2 Тогда 
		Если Выборка.ИспользоватьДопНормуНаЛьготника тогда
			НормаЛьготы  = Выборка.НаДвоих * 2 + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * 2;	
		иначе
			НормаЛьготы  = Выборка.НаДвоих * 2; 	
		КонецЕсли;
		// БИТ_ЖКХ изменение кода. Начало. 21.05.2012{{
		// ИначеЕсли Выборка.мКоличествоПоНормеЛьгота > 2 тогда.
	ИначеЕсли Выборка.мКоличествоПоНормеЛьгота = 3 тогда
		Если Выборка.ИспользоватьДопНормуНаЛьготника тогда
			НормаЛьготы = Выборка.НаСемью * мКоличествоПоНормеЛьгота + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПоНормеЛьгота;	
		иначе
			НормаЛьготы = Выборка.НаСемью * мКоличествоПоНормеЛьгота; 	
		КонецЕсли;
	ИначеЕсли Выборка.мКоличествоПоНормеЛьгота = 4 тогда
		Если Выборка.ИспользоватьДопНормуНаЛьготника тогда
			НормаЛьготы = Выборка.НаСемью4 * мКоличествоПоНормеЛьгота + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПоНормеЛьгота;	
		иначе
			НормаЛьготы = Выборка.НаСемью4 * мКоличествоПоНормеЛьгота; 	
		КонецЕсли;
	ИначеЕсли Выборка.мКоличествоПоНормеЛьгота = 5 тогда
		Если Выборка.ИспользоватьДопНормуНаЛьготника тогда
			НормаЛьготы = Выборка.НаСемью5 * мКоличествоПоНормеЛьгота + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПоНормеЛьгота;	
		иначе
			НормаЛьготы = Выборка.НаСемью5 * мКоличествоПоНормеЛьгота; 	
		КонецЕсли;
	ИначеЕсли Выборка.мКоличествоПоНормеЛьгота > 5 тогда
		Если Выборка.ИспользоватьДопНормуНаЛьготника тогда
			НормаЛьготы = Выборка.НаСемью6 * мКоличествоПоНормеЛьгота + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПоНормеЛьгота;	
		иначе
			НормаЛьготы = Выборка.НаСемью6 * мКоличествоПоНормеЛьгота; 	
		КонецЕсли;
		// БИТ_ЖКХ изменение кода. Конец. 21.05.2012}}
	КонецЕсли;
	
	Возврат Окр(НормаЛьготы, 4);
	
КонецФункции // ПолучитьНормуЛьготы()

// Процедура добавляет колонки для бух учета.
