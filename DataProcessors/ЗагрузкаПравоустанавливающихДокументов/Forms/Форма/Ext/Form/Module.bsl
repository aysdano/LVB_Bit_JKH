&НаКлиенте
Процедура ПрочитатьФайл(Файл,МассивДанных)
	
	ФайлDBF = Новый XBase; // создаем новый объект
	ФайлDBF.Кодировка = КодировкаXBase.OEM;
	ФайлDBF.ОткрытьФайл(Файл); // открытие файла
	ФайлDBF.Первая(); // устанавливает курсор на первую запись
	
	// цикл обрабатывается до тех пор, пока не дошел до последней записи
	Пока НЕ ФайлDBF.ВКонце() Цикл

		Если НЕ (СокрЛП(ФайлDBF.UL) = "" И СокрЛП(ФайлDBF.NOM) = "" И  СокрЛП(ФайлDBF.N_KV) = "") Тогда
			Строка = Файлы.Добавить();
			МассивФайла = Новый Массив;
			Строка.ЛС = СокрЛП(ФайлDBF.LS);
			Строка.УЛ = СокрЛП(ФайлDBF.UL);
			Строка.НОМ = СокрЛП(ФайлDBF.NOM);
			Строка.НКВ = СокрЛП(ФайлDBF.N_KV);
			Строка.ДОКС = СокрЛП(ФайлDBF.DOCS);
			
			МассивФайла.Добавить(ФайлDBF.LS);
			МассивФайла.Добавить(ФайлDBF.UL);
			МассивФайла.Добавить(ФайлDBF.NOM);
			МассивФайла.Добавить(ФайлDBF.N_KV);
			МассивФайла.Добавить(ФайлDBF.DOCS);
			МассивДанных.Добавить(МассивФайла);
		Иначе
			Строка.ДОКС = Строка.ДОКС + " " + СокрЛП(ФайлDBF.LS);
		КонецЕсли;
		ФайлDBF.Следующая(); //передвигаем курсор далее
		
	КонецЦикла;
	
	//ФайлDBF.ЗакрытьФайл();
	//Тз = Файлы.Выгрузить();
	//Тз.Очистить();
	//Для Каждого СТр Из Файлы Цикл
	//	МассивПодстрок = РазложитьСтрокуВМассивПодстрок(Стр.Докс, ",");	
	//	Для Каждого Эл Из МассивПодстрок Цикл
	//		нстр = Тз.Добавить();
	//		нстр.ЛС = СТр.лс;
	//		нстр.УЛ = СТр.УЛ;
	//		нстр.НОМ = СТр.НОМ;
	//		нстр.НКВ = СТр.НКВ;
	//		нстр.ДОКС = Эл;
	//	КонецЦикла;
	//	
	//КонецЦикла;
	//Файлы.Очистить();
	//Файлы.Загрузить(ТЗ);
КонецПроцедуры

&НаСервере
Функция ОбработатьДанные()
	Тз = Документы.Выгрузить();
	Тз.Очистить();
	Для Каждого СТр Из Файлы Цикл
		МассивПодстрок = РазложитьСтрокуВМассивПодстрок(Стр.Докс, ",");	
		Для Каждого Эл Из МассивПодстрок Цикл
			Если НЕ СокрЛП(Эл) = "1" Тогда
				нстр = Тз.Добавить();
				ДанныеПоКв = НайтиДанныеПоКв(Дом, Стр.НКВ);
				нстр.ЛицевойСчет = ДанныеПоКв.ЛицевойСчет;
				нстр.Проживающий = ДанныеПоКв.Ответственный;
				нстр.Квартира = ДанныеПоКв.Квартира;
				нстр.Наименование = Эл;
				Нстр.Дата = ПроверитьДату(эл);
				Нстр.АрхивОмск = Стр.Докс;
				Если СокрЛП(ЭЛ) = "" Тогда
					Сообщить("Строка с ошибочным наименованием " + ДанныеПоКв.ЛицевойСчет +" "+ ДанныеПоКв.Ответственный +" "+ ДанныеПоКв.Квартира);
				КонецЕсли;
			КонецЕсли;
		КонецЦикла;
		
	КонецЦикла;
	Файлы.Очистить();
	Документы.Очистить();
	Документы.Загрузить(ТЗ);
	
КонецФункции	

