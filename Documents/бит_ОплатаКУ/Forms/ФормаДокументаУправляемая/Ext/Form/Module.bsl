Процедура СписокЛСПриОкончанииРедактированияЗавершение(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСПослеУдаления(Элемент)
	
	Если НЕ мКэшЗначений.мНеРаспределятьОплатуПослеВводаСуммы И Не Объект.ВводВРучную Тогда
		ВыполнитьРасчетНаСервере();
	Иначе
		ДокументРассчитан = Ложь;
	КонецЕсли;
	
	ОбновитьДанныеКолонкиАдрес();
	ОбновитьДанныеКолонкиОтветственный();
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСЛицевойСчетПриИзменении(Элемент)
	
	Если Объект.Проведен Тогда
		
		Возврат;
		
	КонецЕсли;
	
	ТекСтрока = Элементы.СписокЛС.ТекущиеДанные;
	
	ТекСтрока.СальдоНаЛС = ПолучитьСальдоНаЛСНаСервере(Объект.Дата, ТекСтрока.ЛицевойСчет);
	
	ТекСтрока.СальдоПениВХ = ПолучитьСальдоДоПениВХНаСервере(Объект.Дата, ТекСтрока.ЛицевойСчет);
	
	Если Не мКэшЗначений.мНеРаспределятьОплатуПослеВводаСуммы Тогда
		УстановитьОтборСписокУслуг(ТекСтрока);
	Иначе	
		ДокументРассчитан = Ложь;
	КонецЕсли;
	
	УстановитьОтборСписокУслуг(ТекСтрока);
	
	ЗаполнитьСчетаНаСервере();
	
	ОбновитьДанныеКолонкиАдрес();
	ОбновитьДанныеКолонкиОтветственный();		  	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСЛицевойСчетНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если Не Объект.Проведен Тогда
		
		ТекДанные = Элементы.СписокЛС.ТекущиеДанные;
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("Организация", Объект.Организация);
		
		ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаВыбораУправляемая", Новый Структура("Отбор, ТекЭлемент", Отбор, ТекДанные.ЛицевойСчет), Элемент);
		
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Перед изменением таблицы лицевых счетов - распроведите документ";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если Объект.ВводВРучную Тогда
		
		ПроверитьДублиЛСПриВводеВручную(ВыбранноеЗначение, СтандартнаяОбработка, "ЛицевойСчет");
		
	КонецЕсли;
	
	Если ВыбранноеЗначение = "" или ВыбранноеЗначение = ПредопределенноеЗначение("Справочник.бит_ЛицевыеСчета.ПустаяСсылка")Тогда
		МожноИспользоватьЭтотЛС = МожноИспользоватьЭтотЛСНаСервере(Элемент.ТекстРедактирования);
	Иначе
		МожноИспользоватьЭтотЛС = МожноИспользоватьЭтотЛСНаСервере(Строка(ВыбранноеЗначение));
	КонецЕсли;
	
	Если МожноИспользоватьЭтотЛС = Неопределено Тогда
		СтандартнаяОбработка = Ложь;
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Лицевой счет не принадлежит организации документа";
		Сообщение.Сообщить();
		
		Возврат;
		
	КонецЕсли;
	
КонецПроцедуры

