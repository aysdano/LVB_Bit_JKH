// Функция возвращает менеджер записи регистра бит_СведенияОКомнате для изменения данных в этом месяце.
// Или создает новую запись, если данные в регистре не за текущий месяц.
//
// Параметры:
//  Комната - Элемент справочника бит_Комната.
//
// Возвращаемое значение:
// Запись - менеджер записи, либо набор записей регитра сведений бит_СведенияОКомнате.
//
Функция ПолучитьСведенияОКомнате(Комната, Дата) Экспорт
	
	ВыборкаРегистра = РегистрыСведений.бит_СведенияОКомнате.Выбрать(,Дата,Новый Структура ("Комната",Комната));
	Пока ВыборкаРегистра.Следующий() Цикл
		
		Если Год(ВыборкаРегистра.Период) <> Год(Дата) ИЛИ Месяц(ВыборкаРегистра.Период) <> Месяц(Дата)Тогда
			Запись = РегистрыСведений.бит_СведенияОКомнате.СоздатьНаборЗаписей();
			ЗаписьСтрока = Запись.Добавить();
			
			ЗаписьСтрока.Период         = Дата;
			ЗаписьСтрока.Комната       	= Комната;
			ЗаписьСтрока.Высота    		= ВыборкаРегистра.Высота;
			ЗаписьСтрока.Площадь 		= ВыборкаРегистра.Площадь;
		Иначе
			Запись = ВыборкаРегистра.ПолучитьМенеджерЗаписи();
		КонецЕсли;
	КонецЦикла;
	
	Если Запись = Неопределено Тогда
		
		Запись = РегистрыСведений.бит_СведенияОКомнате.СоздатьМенеджерЗаписи();
		Запись.Период   = Дата;
		Запись.Комната = Комната;
		
		Запись.Прочитать();
		
		Запись.Комната = Комната;
		Запись.Период   = Дата;
		
	КонецЕсли; 
	
	Возврат Запись;
	
КонецФункции // битПолучитьСведенияОКомнате()

