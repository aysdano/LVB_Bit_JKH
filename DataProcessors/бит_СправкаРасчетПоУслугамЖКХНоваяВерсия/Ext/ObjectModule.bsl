							+ ?(ЗначениеЗаполнено(СтрокаОплаты.ПериодОплатыОмск),Формат(СтрокаОплаты.ПериодОплатыОмск, "ДФ=MM.yy")," ") + Символы.ПС;
						КонецЕсли;
						//--bit_AnisimovaMV_23.10.2023
						ЭтоПерваяСтрока = Ложь;
						
					иначе
						СуммаУслуга =  ПолучитьСуммуОплатыПоуслуге(СтрокаОплаты, Услуга) *Коэфф.Числитель / Коэфф.Знаменатель;
						//++bit_AnisimovaMV_13.11.2023 Меняем начислления по периоду оплаты Омск     
						Если СтрокаОплаты.ПериодОплаты = Ключ Тогда 
							УслугаНач = УслугаНач - СуммаУслуга;
						Иначе 
							СтрокаПоПериоду = ДанныеСправки.Получить(СтрокаОплаты.ПериодОплаты);  
							Если СтрокаПоПериоду.Количество()>0 Тогда
								ДанныеРазовыеТек = СтрокаПоПериоду[3];     
								УслугаНачТекПериод = НачисленияПрошлыхПериодов[СтрокаОплаты.ПериодОплаты].УслугаНач - СуммаУслуга;
							Иначе
								ДанныеРазовыеТек = 0;     
								УслугаНачТекПериод =0;
							КонецЕсли;	
						КонецЕсли;
						//--bit_AnisimovaMV_13.11.2023  	
						
						ЗаполнениеОБластиУслугиОДНПоТекПериоду(СоответствиеУжеРаспределеноНАОДН,СоответствиеУжеРаспределеноНАОДНТекПериод,0, Ложь, СтрокаОплаты,СуммаУслуга, ?(СтрокаОплаты.ПериодОплаты = Ключ, УслугаНач, УслугаНачТекПериод), ДолгУслуга, ОбластьТаблица.Параметры.ОплатаТекПериод, ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериод, СуммаОплатыТекПериод, 	СуммаОплатыПрошлыйПериод, ЭтоПерваяСтрока, ЭтоБухСправка, ПериодОбразованияЗадолженностиПо);
						ОбластьТаблица.Параметры.ДатаОплаты	= ?(ЭтоПерваяСтрока, "", ОбластьТаблица.Параметры.ДатаОплаты) + Формат(СтрокаОплаты.ДатаОплаты, "ДФ=dd.MM.yyyy") + Символы.ПС;
						//++bit_AnisimovaMV_23.10.2023      
						Если СтрокаОплаты.ЭтоИсполнительныйЛист Тогда    
							ОбластьТаблица.Параметры.ПериодОплатыОмск	=?(ЭтоПерваяСтрока, "", ОбластьТаблица.Параметры.ПериодОплатыОмск) + "по ИЛ" + Символы.ПС; 
						ИначеЕсли ЭтоБухСправка Тогда
							ОбластьТаблица.Параметры.ПериодОплатыОмск	=?(ЭтоПерваяСтрока, "", ОбластьТаблица.Параметры.ПериодОплатыОмск) + Символы.ПС; 
						Иначе  
							ОбластьТаблица.Параметры.ПериодОплатыОмск	=  ?(ЭтоПерваяСтрока, "", ОбластьТаблица.Параметры.ПериодОплатыОмск)
							+ ?(ЗначениеЗаполнено(СтрокаОплаты.ПериодОплатыОмск),Формат(СтрокаОплаты.ПериодОплатыОмск, "ДФ=MM.yy")," ") 
							+ Символы.ПС;
						КонецЕсли;
						//--bit_AnisimovaMV_23.10.2023
						ЭтоПерваяСтрока = Ложь;
					КонецЕсли;
				КонецЕсли;
				#КонецОбласти
			КонецЕсли;  
			ДополнитьРаспределениямиОДНИзСодРем(СоответствиеУжеРаспределеноНАОДН, СоответствиеУжеРаспределеноНАОДНТекПериод,
						ОбластьТаблица, ЭтоБухСправка, СтрокаБухСправки, СтрокаОплаты, Ключ, ЭтоПерваяСтрока,
						ГВНач, ХВНач, ВОНач, ЭЛНач,ГВНачТек, ХВНачТек, ВОНачТек, ЭЛНачТек,
						ДолгГв,ДолгХВ,ДолгВО,ДолгЭЛ);
					
			СтруктураНачислений = Новый Структура();                           
			СтруктураНачислений.Вставить("СодРемНач",?(СодРемНач = Неопределено или содремнач<0,0,СодРемНач) );            
			СтруктураНачислений.Вставить("ГВНач", ?(ГВНач = Неопределено или гвнач<0,0,ГВНач));         
			СтруктураНачислений.Вставить("ХВНач", ?(ХВНач = Неопределено или хвнач<0,0,ХВНач));         
			СтруктураНачислений.Вставить("ВОНач", ?(ВОНач = Неопределено или вонач<0,0,ВОНач));
			СтруктураНачислений.Вставить("ЭЛНач", ?(ЭЛНач = Неопределено или элнач<0,0,ЭЛНач));       
			СтруктураНачислений.Вставить("УслугаНач", ?(УслугаНач = Неопределено или услуганач<0,0,УслугаНач));
			НачисленияПрошлыхПериодов.Вставить(Ключ,СтруктураНачислений);	
			Если СтрокаОплаты.ПериодОплаты <> Ключ Тогда 
				СтруктураНачислений1 = Новый Структура();                           
				СтруктураНачислений1.Вставить("СодРемНач",?(СодРемНачТек = Неопределено или СодРемНачТек<0,0,СодРемНачТек) );            
				СтруктураНачислений1.Вставить("ГВНач", ?(ГВНачТек = Неопределено или ГВНачТек<0,0,ГВНачТек));         
				СтруктураНачислений1.Вставить("ХВНач", ?(ХВНачТек = Неопределено или ХВНачТек<0,0,ХВНачТек));         
				СтруктураНачислений1.Вставить("ВОНач", ?(ВОНачТек = Неопределено или ВОНачТек<0,0,ВОНачТек));
				СтруктураНачислений1.Вставить("ЭЛНач", ?(ЭЛНачТек = Неопределено или ЭЛНачТек<0,0,ЭЛНачТек));       
				СтруктураНачислений1.Вставить("УслугаНач", ?(УслугаНачТекПериод = Неопределено или УслугаНачТекПериод<0,0,УслугаНачТекПериод));
				НачисленияПрошлыхПериодов.Вставить(СтрокаОплаты.ПериодОплаты,СтруктураНачислений1);	
			КонецЕсли;
			
			//Счетчик = Счетчик + 1;
		КонецЦикла;
		//итоги за месяц
		Если ЭтоОДН Тогда
			ОбластьТаблица.Параметры.СуммаНачислено				= Формат(СуммаНачислено, "ЧДЦ=2; ЧН=");
			ОбластьТаблица.Параметры.СуммаОплатыПрошлыйПериод	= Формат(СуммаОплатыПрошлыйПериод, "ЧДЦ=2; ЧН=");
			ОбластьТаблица.Параметры.СуммаПерерасчеты			= Формат(СуммаПерерасчеты, "ЧДЦ=2; ЧН=");
			ОбластьТаблица.Параметры.СуммаОплатыТекПериод		= Формат(СуммаОплатыТекПериод, "ЧДЦ=2; ЧН=");
		КонецЕсли;
		Если СуммаОплатыТекПериод = 0 Тогда
			//ОбластьТаблица.Параметры.ОплатаТекПериодЭЛ = "";
			//ОбластьТаблица.Параметры.ОплатаТекПериодГВ = "";
			//ОбластьТаблица.Параметры.ОплатаТекПериодХВ = "";
			//ОбластьТаблица.Параметры.ОплатаТекПериодВО = "";
			//ОбластьТаблица.Параметры.ОплатаТекПериодСодРем = "";
		КонецЕсли;
		ИтогоНачислено = ИтогоНачислено + СуммаНачислено;
		ИтогоПерерасчеты = ИтогоПерерасчеты + СуммаПерерасчеты;
		ИтогоОплатаТекПериод = ИтогоОплатаТекПериод + СуммаОплатыТекПериод;
		ИтогоОплатаПрошлыйПериод = ИтогоОплатаПрошлыйПериод + СуммаОплатыПрошлыйПериод;
		ТабДок.Вывести(ОбластьТаблица);
	КонецЦикла;
	#КонецОбласти				
	////////////////////////////////////////////////////////////////////////////////       
	//++bit_AnisimovaMV_23.10.2023 
	//Если ЭтоОдн Тогда 
	// 	ПереплатаНаНачалоПериода = ?(ДолгЗаПрошлыйПериод<0, ДолгЗаПрошлыйПериод, 0);  
	//Иначе        
	// 	ПереплатаНаНачалоПериода = ?(ДолгУслугаЗаПрошлыйПериод<0, ДолгУслугаЗаПрошлыйПериод, 0);  
	//КонецЕсли;
	//--bit_AnisimovaMV_23.10.2023	
	
	ОбластьИтогиТаблица= Макет.ПолучитьОбласть("ИтогиТаблица|Основная");
	ОбластьИтогиТаблица.Параметры.СуммаНачислено			= Формат(ИтогоНачислено, "ЧДЦ=2; ЧН=");
	ОбластьИтогиТаблица.Параметры.СуммаПерерасчеты			= Формат(ИтогоПерерасчеты, "ЧДЦ=2; ЧН=");
	ОбластьИтогиТаблица.Параметры.СуммаОплатыПрошлыйПериод	= Формат(ИтогоОплатаПрошлыйПериод, "ЧДЦ=2; ЧН=");
	ОбластьИтогиТаблица.Параметры.СуммаОплатыТекПериод		= Формат(ИтогоОплатаТекПериод, "ЧДЦ=2; ЧН=");
	ТабДок.Вывести(ОбластьИтогиТаблица);
	//++Анисимова 10.11.2023 1бит_ Добавлено условие для вывода итога, если переплата за прошлый период возникла в периоде отбора
	//Если ДолгЗаПрошлыйПериод <> 0 Или ДолгУслугаЗаПрошлыйПериод > 0 Тогда 
	Если ДолгЗаПрошлыйПериод <> 0 Или ДолгУслугаЗаПрошлыйПериод > 0 Или ИтогоОплатаПрошлыйПериод <> 0 Или 
		(ПереплатаНаНачалоПериодаОДН < 0 И ЭтоОДН ИЛИ ПереплатаНаНачалоПериодаУслуги < 0 И НЕ ЭтоОДН) Тогда 
		//--Анисимова 10.11.2023 1бит_ Добавлено условие для вывода итога, если переплата за прошлый период возникла в периоде отбора
		ОбластьИтогиПрошПериод = Макет.ПолучитьОбласть("ИтогиПрошПериод|Основная");
		ОбластьИтогиПрошПериод.Параметры.ЗадолженностьНаНачалоСправки	= Формат(?(ЭтоОдн, ДолгЗаПрошлыйПериод, ДолгУслугаЗаПрошлыйПериод), "ЧДЦ=2; ЧН=");
		ОбластьИтогиПрошПериод.Параметры.СуммаОплатыПрошлыйПериод		= Формат(ИтогоОплатаПрошлыйПериод, "ЧДЦ=2; ЧН=");
		ОбластьИтогиПрошПериод.Параметры.ДолгЗаПрошлыйПериод			= Формат(?(ЭтоОдн, ДолгЗаПрошлыйПериод, ДолгУслугаЗаПрошлыйПериод) - ИтогоОплатаПрошлыйПериод, "ЧДЦ=2; ЧН=");
		ТабДок.Вывести(ОбластьИтогиПрошПериод);
	КонецЕсли;
	
	ОбластьИтогиТекПериод = Макет.ПолучитьОбласть("ИтогиТекПериод|Основная");
	ОбластьИтогиТекПериод.Параметры.СуммаНачислено			= Формат(ИтогоНачислено + ИтогоПерерасчеты, "ЧДЦ=2; ЧН=");
	ОбластьИтогиТекПериод.Параметры.СуммаОплатыТекПериод	= Формат(ИтогоОплатаТекПериод, "ЧДЦ=2; ЧН=");     
	//++bit_AnisimovaMV_23.10.2023   
	Если ПереплатаНаНачалоПериодаОДН < 0 И ЭтоОДН ИЛИ ПереплатаНаНачалоПериодаУслуги < 0 И НЕ ЭтоОДН Тогда          
		ОбластьИтогиТекПериод.Параметры.ТекстПереплаты = "с уч. переплаты на начало периода";
	КОнецЕсли;
	
	ПереплатаНаНачало = ?(ЭтоОДН,ПереплатаНаНачалоПериодаОДН,ПереплатаНаНачалоПериодаУслуги);
	ОбластьИтогиТекПериод.Параметры.ДолгТекПериод			= Формат(ИтогоНачислено + ИтогоПерерасчеты - ИтогоОплатаТекПериод + ПереплатаНаНачало, "ЧДЦ=2; ЧН=");
	//ОбластьИтогиТекПериод.Параметры.ДолгТекПериод			= Формат(ИтогоНачислено + ИтогоПерерасчеты - ИтогоОплатаТекПериод, "ЧДЦ=2; ЧН=");
	//--bit_AnisimovaMV_23.10.2023
	ТабДок.Вывести(ОбластьИтогиТекПериод);
	
	ТабДок.ВывестиГоризонтальныйРазделительСтраниц();
КонецПроцедуры

Процедура ДополнитьРаспределениямиОДНИзСодРем(СоответствиеУжеРаспределеноНАОДН, СоответствиеУжеРаспределеноНАОДНТекПериод,
						ОбластьТаблица, ЭтоБухСправка, СтрокаБухСправки, СтрокаОплаты, Ключ, ЭтоПерваяСтрока,
						ГВНач, ХВНач, ВОНач, ЭЛНач,ГВНачТек, ХВНачТек, ВОНачТек, ЭЛНачТек,
						ДолгГв,ДолгХВ,ДолгВО,ДолгЭЛ)
	//++Анисимова Вывод распределенного с СодРем
	Если СоответствиеУжеРаспределеноНАОДН.ВО <> 0 ИЛИ СоответствиеУжеРаспределеноНАОДН.ГВ <>0 
		ИЛИ СоответствиеУжеРаспределеноНАОДН.ХВ <> 0 ИЛИ СоответствиеУжеРаспределеноНАОДН.ЭЭ <>0
		ИЛИ СоответствиеУжеРаспределеноНАОДНТекПериод.ВО <> 0 ИЛИ СоответствиеУжеРаспределеноНАОДНТекПериод.ГВ <>0 
		ИЛИ СоответствиеУжеРаспределеноНАОДНТекПериод.ХВ <> 0 ИЛИ СоответствиеУжеРаспределеноНАОДНТекПериод.ЭЭ <>0 Тогда    
		
		
		ВсегоРаспределено = СоответствиеУжеРаспределеноНАОДН.ВО + СоответствиеУжеРаспределеноНАОДН.ГВ 
		+ СоответствиеУжеРаспределеноНАОДН.ХВ +  СоответствиеУжеРаспределеноНАОДН.ЭЭ;
		ВсегоРаспределеноТекПериод = СоответствиеУжеРаспределеноНАОДНТекПериод.ВО + СоответствиеУжеРаспределеноНАОДНТекПериод.ГВ 
		+ СоответствиеУжеРаспределеноНАОДНТекПериод.ХВ +  СоответствиеУжеРаспределеноНАОДНТекПериод.ЭЭ;
		
		ОбластьТаблица.Параметры.ОплатаТекПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаТекПериодГВ), "", ОбластьТаблица.Параметры.ОплатаТекПериодГВ)+  Формат( СоответствиеУжеРаспределеноНАОДНТекПериод.ГВ, "ЧДЦ=2; ЧРД=,; ЧН=") + Символы.ПС;				
		ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодГВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодГВ), "", ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодГВ) +  Формат( СоответствиеУжеРаспределеноНАОДН.ГВ, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
		
		ОбластьТаблица.Параметры.ОплатаТекПериодХВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаТекПериодХВ), "", ОбластьТаблица.Параметры.ОплатаТекПериодХВ)+  Формат( СоответствиеУжеРаспределеноНАОДНТекПериод.ХВ, "ЧДЦ=2; ЧРД=,; ЧН=") + Символы.ПС;				
		ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодХВ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодХВ), "", ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодХВ) +  Формат(СоответствиеУжеРаспределеноНАОДН.ХВ, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
		
		ОбластьТаблица.Параметры.ОплатаТекПериодВО = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаТекПериодВО), "", ОбластьТаблица.Параметры.ОплатаТекПериодВО)+  Формат( СоответствиеУжеРаспределеноНАОДНТекПериод.ВО, "ЧДЦ=2; ЧРД=,; ЧН=") + Символы.ПС;				
		ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодВО = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодВО), "", ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодВО) + Формат(СоответствиеУжеРаспределеноНАОДН.ВО, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
		
		ОбластьТаблица.Параметры.ОплатаТекПериодЭЛ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаТекПериодЭЛ), "", ОбластьТаблица.Параметры.ОплатаТекПериодЭЛ)+  Формат( СоответствиеУжеРаспределеноНАОДНТекПериод.ЭЭ, "ЧДЦ=2; ЧРД=,; ЧН=") +  Символы.ПС;				
		ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодЭЛ = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодЭЛ), "", ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодЭЛ) + Формат(СоответствиеУжеРаспределеноНАОДН.ЭЭ, "ЧДЦ=2; ЧРД=,; ЧН=")+ Символы.ПС;				
		
		ОбластьТаблица.Параметры.ОплатаТекПериодСодРем = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаТекПериодСодРем), "", ОбластьТаблица.Параметры.ОплатаТекПериодСодРем) +  Формат(-ВсегоРаспределеноТекПериод, "ЧДЦ=2; ЧРД=,; ЧН=")+  Символы.ПС;				
		ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодСодРем = ?(ЭтоПерваяСтрока или не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодСодРем), "", ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериодСодРем)+ Формат(-ВсегоРаспределено, "ЧДЦ=2; ЧРД=,; ЧН=") + Символы.ПС;				
		
		Если Не ЭтоПерваяСтрока И Не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ДатаОплаты) Тогда
			ОбластьТаблица.Параметры.ДатаОплаты = "";
		КонецЕсли;
		ОбластьТаблица.Параметры.ДатаОплаты	= ?(ЭтоПерваяСтрока, "", ОбластьТаблица.Параметры.ДатаОплаты) + Формат(СтрокаОплаты.ДатаОплаты, "ДФ=dd.MM.yyyy") + Символы.ПС;
		//++bit_AnisimovaMV_23.10.2023       
		Если Не ЭтоПерваяСтрока И Не ЗначениеЗаполнено(ОбластьТаблица.Параметры.ПериодОплатыОмск) Тогда
			ОбластьТаблица.Параметры.ПериодОплатыОмск = "";
		КонецЕсли;
		
		Если СтрокаОплаты.ЭтоИсполнительныйЛист Тогда    
			ОбластьТаблица.Параметры.ПериодОплатыОмск	=?(ЭтоПерваяСтрока, "", ОбластьТаблица.Параметры.ПериодОплатыОмск) + "по ИЛ" + Символы.ПС; 
		ИначеЕсли ЭтоБухСправка Тогда
			ОбластьТаблица.Параметры.ПериодОплатыОмск	=?(ЭтоПерваяСтрока, "", ОбластьТаблица.Параметры.ПериодОплатыОмск) + Символы.ПС; 
		Иначе
			
			ОбластьТаблица.Параметры.ПериодОплатыОмск	=  ?(ЭтоПерваяСтрока, "", ОбластьТаблица.Параметры.ПериодОплатыОмск) 
			+ ?(ЗначениеЗаполнено(СтрокаОплаты.ПериодОплатыОмск),Формат(СтрокаОплаты.ПериодОплатыОмск, "ДФ=MM.yy")," ") + Символы.ПС;
		КонецЕсли;			
		
		ЭтоПерваяСтрока = Ложь;
		
		ГВРаспределно = ОКР(СоответствиеУжеРаспределеноНАОДНТекПериод.ГВ + СоответствиеУжеРаспределеноНАОДН.ГВ,2); 
		ХВРаспределно =ОКР( СоответствиеУжеРаспределеноНАОДНТекПериод.ХВ + СоответствиеУжеРаспределеноНАОДН.ХВ,2); 
		ВОРаспределно = ОКР(СоответствиеУжеРаспределеноНАОДНТекПериод.ВО + СоответствиеУжеРаспределеноНАОДН.ВО,2); 
		ЭЭРаспределно = ОКР(СоответствиеУжеРаспределеноНАОДНТекПериод.ЭЭ + СоответствиеУжеРаспределеноНАОДН.ЭЭ,2); 
		СодРемРаспределно = ОКР(ВсегоРаспределено + ВсегоРаспределеноТекПериод,2);
		
		
		Если СтрокаОплаты.ПериодОплаты = Ключ  Тогда
			ГВНач = ГВНач - СоответствиеУжеРаспределеноНАОДНТекПериод.ГВ;
			ХВНач = ХВНач - СоответствиеУжеРаспределеноНАОДНТекПериод.ХВ;
			ВОНач = ВОНач - СоответствиеУжеРаспределеноНАОДНТекПериод.ВО;
			ЭЛНач = ЭЛНач - СоответствиеУжеРаспределеноНАОДНТекПериод.ЭЭ; 
		Иначе       
			ГВНачТек = ?(ГВНачТек =Неопределено,0,ГВНачТек);
			ХВНачТек =?(ХВНачТек =Неопределено,0,ХВНачТек);
			ВОНачТек = ?(ВОНачТек =Неопределено,0,ВОНачТек);
			ЭЛНачТек = ?(ЭЛНачТек =Неопределено,0,ЭЛНачТек);    

			ГВНачТек = ГВНачТек - СоответствиеУжеРаспределеноНАОДНТекПериод.ГВ;
			ХВНачТек = ХВНачТек - СоответствиеУжеРаспределеноНАОДНТекПериод.ХВ;
			ВОНачТек = ВОНачТек - СоответствиеУжеРаспределеноНАОДНТекПериод.ВО;
			ЭЛНачТек = ЭЛНачТек - СоответствиеУжеРаспределеноНАОДНТекПериод.ЭЭ;    
		КонецЕсли;
		ДолгГв = ДолгГв - СоответствиеУжеРаспределеноНАОДН.ГВ;
		ДолгХВ = ДолгХВ - СоответствиеУжеРаспределеноНАОДН.ХВ;
		ДолгВО = ДолгВО - СоответствиеУжеРаспределеноНАОДН.ВО;
		ДолгЭЛ = ДолгЭЛ - СоответствиеУжеРаспределеноНАОДН.ЭЭ;    
		
		Если СтрокаБухСправки.Количество() > 0 Тогда
			ТекСтрокаБухСправки = СтрокаБухСправки[0];
			ТекСтрокаБухСправки.ГВОпл =ПересчитатьСуммуБухСправки(ТекСтрокаБухСправки.ГВОпл,ГВРаспределно, СодРемРаспределно);
			ТекСтрокаБухСправки.ХВОпл= ПересчитатьСуммуБухСправки(ТекСтрокаБухСправки.ХВОпл,ХВРаспределно, СодРемРаспределно);;
			ТекСтрокаБухСправки.ВООпл =ПересчитатьСуммуБухСправки(ТекСтрокаБухСправки.ВООпл,ВОРаспределно, СодРемРаспределно);;
			ТекСтрокаБухСправки.ЭЛОпл = ПересчитатьСуммуБухСправки(ТекСтрокаБухСправки.ЭЛОпл,ЭЭРаспределно, СодРемРаспределно);;
			
			
			ТекСтрокаБухСправки.СодРемОпл = ПересчитатьСуммуБухСправки(ТекСтрокаБухСправки.СодРемОпл,СодРемРаспределно, СодРемРаспределно);
		КонецЕсли;
	КонецЕсли;
	
	
КонецПроцедуры

Функция ПересчитатьСуммуБухСправки(ТесСуммаБухСправки, СуммаУжеРаспределено, ВсегоРаспределено)  
	Если ТесСуммаБухСправки<0 Тогда   
		Возврат ?(ТесСуммаБухСправки+ СуммаУжеРаспределено> 0,0,ТесСуммаБухСправки+ СуммаУжеРаспределено) ;
	Иначе  
		Если ТесСуммаБухСправки-СуммаУжеРаспределено<0 Тогда  
			ВсегоРаспределено = ВсегоРаспределено + (ТесСуммаБухСправки-СуммаУжеРаспределено);  
			Возврат 0;
		Иначе
			Возврат  ТесСуммаБухСправки-СуммаУжеРаспределено
		КонецЕсли ;
		
	КОнецЕсли;

КонецФункции

Процедура ЗаполнитьОблатьТаблица(ОбластьТаблица, СтрокаПерерасчеты, СтрокаСуммаОплатыПрошлыйПериод, СтрокаСуммаОплатыТекПериод, СтрокаДатаОплаты, СтрокаПериодОплаты )
	ОбластьТаблица.Параметры.Перерасчеты = Строка(ОбластьТаблица.Параметры.Перерасчеты) + СтрокаПерерасчеты + Символы.ПС;
	
	ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериод = Строка(ОбластьТаблица.Параметры.ОплатаЗаПрошлыйПериод) +  ?(ЗначениеЗаполнено(СокрЛП(СтрокаСуммаОплатыПрошлыйПериод)), СтрокаСуммаОплатыПрошлыйПериод, "0,00") + Символы.ПС;
	ОбластьТаблица.Параметры.ОплатаТекПериод = Строка(ОбластьТаблица.Параметры.ОплатаТекПериод) + ?(ЗначениеЗаполнено(СокрЛП(СтрокаСуммаОплатыТекПериод)), СтрокаСуммаОплатыТекПериод, "0,00") + Символы.ПС;
	ОбластьТаблица.Параметры.ДатаОплаты = Строка(ОбластьТаблица.Параметры.ДатаОплаты) + СтрокаДатаОплаты + Символы.ПС; 
	//++bit_AnisimovaMV_23.10.2023      
	ОбластьТаблица.Параметры.ПериодОплатыОмск	=  Строка(ОбластьТаблица.Параметры.ПериодОплатыОмск) + СтрокаПериодОплаты + Символы.ПС;
	//--bit_AnisimovaMV_23.10.2023
КонецПроцедуры

Функция ПолучитьДанныеРазовых(НачалоПериодаРасчета, КонецПериодаРасчета, ЛицевойСчет, УслугаЖКХ)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ.ГруппаУслуги = &ГруппаКапРем
	|			ТОГДА &УслугаКапРем
	|		ИНАЧЕ бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
	|	КОНЕЦ КАК УслугаЖКХ,
	|	СУММА(бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот) КАК СуммаОборот
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Регистратор,
	|			ЛицевойСчет = &ЛицевойСчет
	|				И УслугаЖКХ В (&УслугаЖКХ)) КАК бит_НачисленияПоУслугамЖКХОбороты
	|ГДЕ
	|	бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|
	|СГРУППИРОВАТЬ ПО
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ.ГруппаУслуги = &ГруппаКапРем
	|			ТОГДА &УслугаКапРем
	|		ИНАЧЕ бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
	|	КОНЕЦ";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецПериодаРасчета);
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоПериодаРасчета);
	Запрос.УстановитьПараметр("УслугаЖКХ", ГруппаУслуг(УслугаЖКХ));
	Запрос.УстановитьПараметр("УслугаКапРем", Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000010")); // мин взнос на кап ремонт
	Запрос.УстановитьПараметр("ГруппаКапРем", Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000009"));// капитальный ремонт
	
	РезультатЗапроса = Запрос.Выполнить().Выгрузить();
	Возврат РезультатЗапроса;
КонецФункции

Функция ПолучитьМассивСортировки(ДанныеСправки)
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("Ключ");
	ТаблицаЗначений.Колонки.Добавить("Дата");
	Для каждого СтрокаДанных Из ДанныеСправки Цикл
		Стр = ТаблицаЗначений.Добавить();
		Стр.Ключ = СтрокаДанных.Ключ;
		Стр.Дата = СтрокаДанных.Ключ;
	КонецЦикла;
	
	ТаблицаЗначений.Сортировать("Дата");
	ТаблицаЗначений.Свернуть("Ключ");
	
	Массив = ТаблицаЗначений.ВыгрузитьКолонку("Ключ");
	
	Возврат Массив;
КонецФункции

Функция ПолучитьДанныеДляСправки(ПериодОбразованияЗадолженностиОт, ПериодОбразованияЗадолженностиПо, КонецПериодаРасчета, ЛицевойСчет, Услуга)
	
	ДатаНачалоРасчетаСправки = НачалоДня(ПериодОбразованияЗадолженностиПо);
	НачалоПериодаОбразованияЗадолженности = НачалоДня(ПериодОбразованияЗадолженностиОт);
	
	НежилоеПомещение = Справочники.бит_ТипыКвартиры.НайтиПоКоду("000000000003");
	МакетКв = Справочники.бит_ВариантыСчетовИзвещений.бит_Основная2023;
	ВидОплаты = Справочники.лб_ВидыОплат.НайтиПоКоду("000000004");//бухгалтерская справка
	
	ПериодРасчета = ДатаНачалоРасчетаСправки;
	ДанныеСправки = Новый Соответствие;
	Пока ПериодРасчета <= КонецМесяца(КонецПериодаРасчета) Цикл 
		
		ДатаНачала = НачалоМесяца(ПериодРасчета);
		ДатаОкончания = КонецМесяца(ПериодРасчета);//?(КонецМесяца(ПериодРасчета) > ТекущаяДата(), ТекущаяДата(), КонецМесяца(ПериодРасчета));
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("НежилоеПомещение", НежилоеПомещение);
		Запрос.УстановитьПараметр("Период", ДатаОкончания);//Дата("20230301"));//ПериодРасчета);
		Запрос.УстановитьПараметр("ШаблонКвитанции", МакетКв);
		Запрос.УстановитьПараметр("Организация", Организация);
		Запрос.УстановитьПараметр("СписокЛС", ЛицевойСчет);
		Запрос.УстановитьПараметр("СписокЗданий", ЛицевойСчет.Здание);
		Если ПериодРасчета >= Дата("20230201") и Услуга.ГруппаУслуги = Справочники.бит_ГруппыУслуг.НайтиПоКоду("00-000001")  Тогда
			
			Запрос.Текст = ТекстЗапросаДанныеПоЛСПосле("", "", "");
		Иначе
			Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
			Запрос.УстановитьПараметр("Здание", ЛицевойСчет.Здание);
			Запрос.УстановитьПараметр("Квартира", ЛицевойСчет.Квартира);
			Запрос.УстановитьПараметр("Услуга", ГруппаУслуг(Услуга));
			Запрос.УстановитьПараметр("Период", ДатаОкончания);     
			Запрос.УстановитьПараметр("РежимПотребленияНеНачислять", Справочники.бит_РежимыПотребленияУслуг.НеНачислять);     
			
			УстановитьПараметрыУслуг(Запрос);
			Запрос.Текст = ТекстЗапросаДанныеПоЛСДо();
		КонецЕсли;
		ДанныеЛС = Запрос.Выполнить().Выгрузить();
		Если ДанныеЛС.Количество() = 0 Тогда
			//ПериодРасчета = КонецМесяца(КонецПериодаРасчета) + 1;
			ДанныеЛС = ПолучитьПустуюТаблицуДанныхПоЛС(ЛицевойСчет);
			
		КонецЕсли;
		//
		Ключ = ДатаНачала;
		
		ЗапросНачисленоОплачено = Новый Запрос;
		ЗапросНачисленоОплачено.Текст = ТекстЗапросаНачисленияПоЛС();
		ЗапросНачисленоОплачено.УстановитьПараметр("Услуга",  ГруппаУслуг(Услуга));
		ЗапросНачисленоОплачено.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
		ЗапросНачисленоОплачено.УстановитьПараметр("ДатаНачала", ДатаНачала);
		ЗапросНачисленоОплачено.УстановитьПараметр("ДатаОкончания", ДатаОкончания);  
		ЗапросНачисленоОплачено.УстановитьПараметр("ВидОплаты", ВидОплаты);
		ЗапросНачисленоОплачено.УстановитьПараметр("ДатаПроизв", Дата("19000101"));
		ЗапросНачисленоОплачено.УстановитьПараметр("ИсполнительныйЛист", Справочники.лб_ВидыОплат.НайтиПоНаименованию("Исполнительные листы"));
		УстановитьПараметрыУслуг(ЗапросНачисленоОплачено);
		ДанныеНачисленоОплачено	= ЗапросНачисленоОплачено.Выполнить().Выгрузить();
		//СуммаОплачено СуммаНачислено УслугаЖКХ ЛицевойСчет ПериодОплаты/Начисления
		ЗапросНачисленоОсновная = Новый Запрос;
		ЗапросНачисленоОсновная.УстановитьПараметр("Период", ДатаНачала);
		ЗапросНачисленоОсновная.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
		ЗапросНачисленоОсновная.УстановитьПараметр("Здание", ЛицевойСчет.Здание);
		ЗапросНачисленоОсновная.УстановитьПараметр("РежимПотребления", ДанныеЛС[0].РежимПотребления);
		ЗапросНачисленоОсновная.УстановитьПараметр("СтатусКвартиры", ДанныеЛС[0].СтатусКвартиры);
		ЗапросНачисленоОсновная.УстановитьПараметр("ТипКвартиры", ДанныеЛС[0].ТипКвартиры);
		//ТарифХВ = ВыборкаЛС.СтоимостьКубаХВ;	
		ЗапросНачисленоОсновная.Текст = ТекстЗапросаНачисленияОсновная();
		
		ТаблицаНачисления = ЗапросНачисленоОсновная.Выполнить().Выгрузить();
		
		ТаблицаРазовые = ПолучитьДанныеРазовых(ДатаНачала, ДатаОкончания, ЛицевойСчет, Услуга);
		
		МассивДанных = Новый Массив;
		Если НЕ ДанныеНачисленоОплачено.Количество() = 0 Тогда
			МассивДанных.Вставить(0, ДанныеЛС[0]); 
			МассивДанных.Вставить(1, ДанныеНачисленоОплачено);
			МассивДанных.Вставить(2, ТаблицаНачисления);
			МассивДанных.Вставить(3, ТаблицаРазовые);
			ДанныеСправки.Вставить(Ключ, МассивДанных);
		КонецЕсли;
		ПериодРасчета = ДобавитьМесяц(ПериодРасчета, 1);
	КонецЦикла;
	
	Возврат ДанныеСправки;
	
КонецФункции

Процедура ДобавитьДанныеВСтрокуТЧ(Таб, ВыборкаПериод, ПериодКлюч , ПериодОбразованияЗадолженностиПо)
	
	Строка = Таб.Добавить();
	
	Строка.Период = Формат(ПериодКлюч, "ДФ=ММММ.гггг");
	Строка.СуммаНачислено = ВыборкаПериод.СуммаНачислено;
	Строка.ДатаОплаты = НачалоДня(ВыборкаПериод.ДатаОплатыНачисления);
	Строка.ПериодКлюч = НачалоДня(ПериодКлюч);
	
	Если ВыборкаПериод.ПериодВзаиморасчетов  < ПериодОбразованияЗадолженностиПо Тогда
		Строка.СуммаОплатыПрошлыйПериод = ВыборкаПериод.СуммаОплачено; 
		Строка.СуммаОплатыТекПериод = 0;
	Иначе 
		Строка.СуммаОплатыПрошлыйПериод = 0; 
		Строка.СуммаОплатыТекПериод = ВыборкаПериод.СуммаОплачено;
	КонецЕсли;
	
	Если Строка.СуммаОплатыПрошлыйПериод > 0 Тогда
		Строка.ПериодВзаиморасчетов = НачалоДня(КонецМесяца(Строка.ДатаОплаты));
	Иначе
		Строка.ПериодВзаиморасчетов = НачалоДня(ВыборкаПериод.ПериодВзаиморасчетов);
	КонецЕсли;
	
	
	
КонецПроцедуры

Функция ПолучитьЗадолженностьНаНачалоСправки(ПериодОбразованияЗадолженностиПо, ЛицевойСчет, Услуга)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток КАК СуммаОстаток,
	|	бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ КАК УслугаЖКХ
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(
	|			&ДатаЗадолженности,
	|			ЛицевойСчет = &лс
	|				И УслугаЖКХ В (&УслугаЖКХ)) КАК бит_НачисленияПоУслугамЖКХОстатки";
	
	Запрос.УстановитьПараметр("ДатаЗадолженности", ПериодОбразованияЗадолженностиПо);
	Запрос.УстановитьПараметр("лс", ЛицевойСчет);
	Запрос.УстановитьПараметр("УслугаЖКХ", ГруппаУслуг(Услуга));
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Возврат Результат;
	
КонецФункции

Функция ПолучитьМассивЛС() 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "";
	
	Если ОтборЛС и СписокЛС.Количество() > 0 Тогда 
		
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Ссылка В(&ЛицевыеСчета)";
		
		МассивЛС = СписокЛС.ВыгрузитьКолонку("ЛицевойСчет");
		Если ЗначениеЗаполнено(ЛицевойСчет) Тогда
			МассивЛС.Добавить(ЛицевойСчет)
		КонецЕсли;
		Запрос.УстановитьПараметр("ЛицевыеСчета", МассивЛС);
		
	КонецЕсли;
	
	Если ОтборУчасток И СписокУчастков.Количество() > 0 Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Здание.Участок В(&СписокУчастков)";
		
		УчасткиТмп = СписокУчастков.ВыгрузитьКолонку("Участок");
		УчасткиОтбор = Новый Массив;
		Для Каждого Участок Из УчасткиТмп Цикл
			Если СтрДлина(СокрЛП(Участок.Код))> 2 Тогда
				УчасткиОтбор.Добавить(Участок)
			КонецЕсли;
		КонецЦикла;
		
		Запрос.УстановитьПараметр("СписокУчастков", УчасткиОтбор);
		
	КонецЕсли;
	
	Если ОтборЗдание И СписокЗданий.Количество() > 0 Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Здание В(&ЗданиеОтбор)";
		ЗданиеОтбор = СписокЗданий.ВыгрузитьКолонку("Здание");
		
		Запрос.УстановитьПараметр("ЗданиеОтбор", ЗданиеОтбор);
		
	КонецЕсли;
	
	Если Запрос.Текст = "" Тогда
		МассивЛС = Новый Массив;
		МассивЛС.Добавить(ЛицевойСчет);
		Возврат МассивЛС;
	КонецЕсли;
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выгрузить();
	
	Возврат ВыборкаДетальныеЗаписи.ВыгрузитьКолонку("ЛицевойСчет");	
	
КонецФункции

Функция ПолучитьЛСПоПолюДокумент(Данные)
	
	МассивЛс = Новый Массив;
	
	Для каждого СтрокаТЧ из Данные Цикл
		Если Не ЗначениеЗаполнено(СтрокаТЧ.Документ) Тогда
			МассивЛс.Добавить(СтрокаТЧ.ЛицевойСчет);
		КонецЕсли;
	КонецЦикла;
	
	Возврат МассивЛС;
	
КонецФункции

Функция ПредставлениеЧисла(Число)
	Число = Окр(Число, 2, РежимОкругления.Окр15как10);
	Возврат Строка(?(Число = 0 , "0,00", ?(Число-Цел(Число)= 0 , Строка(Число) + ",00", Строка(Цел(Число)) + "," + ?(Число-Цел(Число)< 0.1, "0" + Строка(МодульЧисла((Число-Цел(Число))*100)), Строка(МодульЧисла((Число-Цел(Число))*100)) ) )));
КонецФункции

Функция ГруппаУслуг(Услуга)
	
	ЗапросУслуги = Новый Запрос;
	ЗапросУслуги.Текст = 
	"ВЫБРАТЬ
	|	бит_УслугиЖКХ.Ссылка КАК Услуга
	|ИЗ
	|	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	|ГДЕ
	|	бит_УслугиЖКХ.ГруппаУслуги В(&ОбязательныеГруппыУслуг)";
	
	ОбязательныеУслуги = Новый Массив();
	ОбязательныеУслуги.Добавить(Услуга.ГруппаУслуги);
	
	ЗапросУслуги.УстановитьПараметр("ОбязательныеГруппыУслуг", ОбязательныеУслуги);
	РезультатЗапроса = ЗапросУслуги.Выполнить();
	
	Если  НЕ РезультатЗапроса.Пустой() Тогда
		ОтборУслуги = РезультатЗапроса.Выгрузить();
		ОтборУслуги = ОтборУслуги.ВыгрузитьКолонку("Услуга");
		Если Услуга.ГруппаУслуги = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000008") Тогда
			//ОтборУслуги.Добавить(Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000009"));
		КонецЕсли;
	Иначе
		ОтборУслуги = Услуга;
	КонецЕсли;
	
	Возврат ОтборУслуги;
	
КонецФункции

Функция МодульЧисла(Число)
	Возврат ?(Число<0, -Число, Число);
КонецФункции

Функция ОбработкаРезультатов(РезультатЗапроса, ПериодОбразованияЗадолженностиПо)
	
	Таблица = РезультатЗапроса.Выгрузить();
	ВидОплаты = Справочники.лб_ВидыОплат.НайтиПоКоду("000000004");//бухгалтерская справка
	
	КоличествоСтрок = Таблица.Количество();
	Индекс = 0;
	Пока Индекс < КоличествоСтрок Цикл
		Строка =  Таблица.Получить(Индекс);
		Если НЕ ЗначениеЗаполнено(Строка.ЛицевойСчет) Тогда
			ИндексПериода = Индекс;
			Индекс = Индекс + 1;
			Продолжить;
		КонецЕсли;
		Если (Строка.СуммаОплачено = 0 и Строка.СуммаНачислено = 0) Тогда
			Таблица.Удалить(Индекс);
			КоличествоСтрок = Таблица.Количество();
			Продолжить;
		КонецЕсли;
		
		
		Если (Строка.ВидОплаты = ВидОплаты ИЛИ Строка.СуммаОплачено < 0)Тогда //бухгалтерская справка
			НомерСтрокиУдалить = Индекс;
			СуммаКорректировки = Строка.СуммаОплачено;
			//Индекс = ДанныеСтрокОплаты.Количество();
			Пока НЕ (СуммаКорректировки = 0 ) Цикл
				Если Не (Индекс - 1) = ИндексПериода Тогда
					ПредыдущаяСтрока = Таблица.Получить(Индекс - 1);
					Если НЕ (ЗначениеЗаполнено(ПредыдущаяСтрока.ВидОплаты)) ТОГДА
						Индекс = Индекс -1;
						Продолжить;
					КонецЕсли;
					ПредыдущаяСтрока.СуммаОплачено = ПредыдущаяСтрока.СуммаОплачено + СуммаКорректировки;
					Если ПредыдущаяСтрока.СуммаОплачено < 0   Тогда
						СуммаКорректировки = ПредыдущаяСтрока.СуммаОплачено;
						ПредыдущаяСтрока.СуммаОплачено = 0;
					Иначе
						СуммаКорректировки = 0;
					КонецЕсли;
					Индекс = Индекс -1;
				Иначе
					СуммаКорректировки = 0;
				КонецЕсли;
			КонецЦикла ;
			Таблица.Удалить(НомерСтрокиУдалить);
		КонецЕсли ;
		Индекс = Индекс +1;
		КоличествоСтрок = Таблица.Количество();
	КонецЦикла;
	
	
	Возврат Таблица;	
	
КонецФункции

Функция ПрошелПорогПоДолгу(ЛС, КоличествоМесяцевЗадолженности, ДатаНачалаСправки, Услуга)
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаПриход) КАК СуммаНачислено,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет
	|ПОМЕСТИТЬ ВТ
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			Запись,
	|			,
	|			ЛицевойСчет = &ЛС
	|				И УслугаЖКХ В (&Услуга)) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет КАК ЛицевойСчет,
	|	СУММА(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток) КАК СуммаОстаток,
	|	ВТ.СуммаНачислено КАК СуммаНачислено
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(
	|			,
	|			ЛицевойСчет = &Лс
	|				И УслугаЖКХ В (&Услуга)) КАК бит_НачисленияПоУслугамЖКХОстатки
	|		ПРАВОЕ СОЕДИНЕНИЕ ВТ КАК ВТ
	|		ПО бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет = ВТ.ЛицевойСчет
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет,
	|	ВТ.СуммаНачислено";
	
	Запрос.УстановитьПараметр("ЛС", ЛС);
	Запрос.УстановитьПараметр("НачалоПериода", НачалоМесяца(ДобавитьМесяц(ДатаНачалаСправки, -3)));
	Запрос.УстановитьПараметр("КонецПериода", НачалоМесяца(ДатаНачалаСправки));
	Запрос.УстановитьПараметр("Услуга", Услуга);
	
	РезультатЗапроса = Запрос.Выполнить();
	Если РезультатЗапроса.Пустой() Тогда
		//Возврат Ложь;
	КонецЕсли;
	
	//КоличествоМесяцев = Цел((ТекущаяДата() - ДатаНачалаСправки) / 3600/24/30);
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Выборка.Следующий();
	
	СреднееНачислениеМесяц = ?(ЗначениеЗаполнено(Выборка.СуммаНачислено), Выборка.СуммаНачислено, 0) / 3;//?(КоличествоМесяцев = 0 , 1, КоличествоМесяцев);
	Остаток = ?(ЗначениеЗаполнено(Выборка.СуммаОстаток), Выборка.СуммаОстаток, 0);	
	Если СреднееНачислениеМесяц * КоличествоМесяцевЗадолженности < Остаток Тогда
		Возврат Истина;
	Иначе Возврат ЛОЖЬ;
	КонецЕсли;
	
	
КонецФункции

Функция ПолучитьДатуНачалаЗадолженности(Лс, Услуга)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период КАК Период,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	|			,
	|			,
	|			Месяц,
	|			,
	|			ЛицевойСчет = &лс
	|				И УслугаЖКХ В (&Услуга)) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	|ГДЕ
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток = 0
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.Период,
	|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Запрос.УстановитьПараметр("лс", лс);
	Запрос.УстановитьПараметр("Услуга", Услуга);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Пока Выборка.Следующий() Цикл
		Возврат НачалоМесяца(Выборка.Период);
	КонецЦикла;
	
	Возврат Дата(1,1,1);
КонецФункции

