Процедура Рассчитать(Команда)
	
	РассчитатьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура НачислениеПениПоЛицевымСчетам(Команда)
	
	Документ = НайтиДокументНачислениеПениПоЛицевымСчетамНаСервере();

	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("НачислятьПени"                , Ложь);
	СтруктураПараметров.Вставить("НачислятьПениСУчетомПереплаты", Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(Объект.Дата, Объект.Организация, СтруктураПараметров);
	
	Если Документ <> Неопределено  Тогда
		Если Объект.Проведен = Истина Тогда
			Если СтруктураПараметров.НачислятьПени Тогда
				
				Если Документ = ПредопределенноеЗначение("Документ.бит_НачислениеПениПоЛицевымСчетам.ПустаяСсылка") Тогда
					
					ПараметрыФормы = Новый Структура;
					
					ПараметрыФормы.Вставить("Организация",     Объект.Организация);
					ПараметрыФормы.Вставить("Дата",            Объект.Дата);
					ПараметрыФормы.Вставить("ДокОснование",    Объект.Ссылка);
					ПараметрыФормы.Вставить("ЗакрытиеПериода", Ложь);
					
					ОткрытьФорму("Документ.бит_НачислениеПениПоЛицевымСчетам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаНачислениеПениПоЛицевымСчетам, Ключ", ПараметрыФормы, Неопределено), ЭтаФорма);
					
				Иначе
					
					ПараметрыФормы = Новый Структура;
					
					ПараметрыФормы.Вставить("Основание", Объект.Ссылка);
					
					ОткрытьФорму("Документ.бит_НачислениеПениПоЛицевымСчетам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаНачислениеПениПоЛицевымСчетам, Ключ", ПараметрыФормы, Документ), ЭтаФорма);
					
				КонецЕсли;
			Иначе
				
				Сообщение = Новый СообщениеПользователю();
				Сообщение.Текст = "В настройках начисление пени для данного периода этой организации отключено!!!";
				Сообщение.Сообщить();
				
			КонецЕсли;
		Иначе
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Проведите документ для создания документа НачислениеПениПоЛицевымСчетам";
			Сообщение.Сообщить();
			
		КонецЕсли;
	Иначе
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Проведите документ для создания документа НачислениеПениПоЛицевымСчетам";
		Сообщение.Сообщить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПоступлениеНаРасчетныйСчет(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДокументОплаты",          Объект.Ссылка);
	ПараметрыФормы.Вставить("ИсточникОплаты",          Объект.ИсточникОплаты);
	ПараметрыФормы.Вставить("Организация",             Объект.Организация);
	ПараметрыФормы.Вставить("БанковскийСчет",          ЗначениеРеквизитаНаСервере(Объект.Организация, "ОсновнойБанковскийСчет"));
	ПараметрыФормы.Вставить("СуммаДокумента",          Объект.СуммаДокумента);
	ПараметрыФормы.Вставить("РазбиватьПоЛицевымСчетам", Ложь);
	
	ОткрытьФорму("Обработка.бит_ВводПКО.Форма.ФормаУправляемая", Новый Структура("ЗаполнитьИзДокументаПоступлениеНаРасчетныйСчет", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриходныйКассовыйОрдер(Команда)
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДокументОплаты",          Объект.Ссылка);
	ПараметрыФормы.Вставить("ИсточникОплаты",          Объект.ИсточникОплаты);
	ПараметрыФормы.Вставить("Организация",             Объект.Организация);
	ПараметрыФормы.Вставить("БанковскийСчет",          ЗначениеРеквизитаНаСервере(Объект.Организация, "ОсновнойБанковскийСчет"));
	ПараметрыФормы.Вставить("СуммаДокумента",          Объект.СуммаДокумента);
	ПараметрыФормы.Вставить("РазбиватьПоЛицевымСчетам", Ложь);
	
	ОткрытьФорму("Обработка.бит_ВводПКО.Форма.ФормаУправляемая", Новый Структура("ЗаполнитьИзДокументаПриходныйКассовыйОрдер", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура РаспределениеОплатыПоПоставщикам(Команда)
	
	Документ = НайтиДокументРаспределениеОплатыПоПоставщикамНаСервере();
	
	Если Документ = ПредопределенноеЗначение("Документ.бит_РаспределениеОплатыПоПоставщикам.ПустаяСсылка") Тогда
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Организация"      , Объект.Организация);
		ПараметрыФормы.Вставить("Дата"             , Объект.Дата);
		ПараметрыФормы.Вставить("ДокументОснование", Объект.Ссылка);
		ПараметрыФормы.Вставить("ЗакрытиеПериода"  , Ложь);
		
		ОткрытьФорму("Документ.бит_РаспределениеОплатыПоПоставщикам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаОплатаКУ", ПараметрыФормы), ЭтаФорма);
		
	Иначе
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("ДокументОснование", Объект.Ссылка);
		ПараметрыФормы.Вставить("Организация"      , Объект.Организация);
		ПараметрыФормы.Вставить("Дата"             , Объект.Дата);
		
		ОткрытьФорму("Документ.бит_РаспределениеОплатыПоПоставщикам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзДокументаОплатаКУ, Ключ", ПараметрыФормы, Документ), ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПроставитьШаблонИзвещений(Команда)
	
	Если Объект.Проведен Тогда
		ТекстСообщения = НСтр("ru = 'Перед выбором шаблона - распроведите документ.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	Оповещение = Новый ОписаниеОповещения("ШаблонИзвещенийВыборЗавершение", ЭтотОбъект);
	ОткрытьФорму("Справочник.бит_ШаблоныИзвещений.Форма.ФормаВыбораУправляемая",,ЭтотОбъект,,,,Оповещение);
		
КонецПроцедуры

&НаКлиенте
Процедура ШаблонИзвещенийВыборЗавершение(РезультатВыбора, ДополнительныеПараметры) Экспорт
	
	Если ЗначениеЗаполнено(РезультатВыбора) Тогда
		ТекстВопроса = СтрШаблон(
							НСтр("ru = 'Установить текущий шаблон извещений: ""%1"" для всех?'"),
							РезультатВыбора);
		Оповещение = Новый ОписаниеОповещения("ШаблонИзвещенийПроставитьЗавершение", ЭтотОбъект, Новый Структура("РезультатВыбора",РезультатВыбора));					
		ПоказатьВопрос(Оповещение, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ТекстСообщения = НСтр("ru = 'Не задан Шаблон извещений.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонИзвещенийПроставитьЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		Возврат;
	Иначе
		Для каждого Строка Из Объект.СписокЛС Цикл
			Строка.ШаблонИзвещений = ДополнительныеПараметры.РезультатВыбора;	
		КонецЦикла; 
	КонецЕсли;
	
	РассчитатьНаКлиенте();
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаПлатежнойКартой(Команда)

	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("ДокументОплаты",          Объект.Ссылка);
	ПараметрыФормы.Вставить("ИсточникОплаты",          Объект.ИсточникОплаты);
	ПараметрыФормы.Вставить("Организация",             Объект.Организация);
	ПараметрыФормы.Вставить("БанковскийСчет",          ЗначениеРеквизитаНаСервере(Объект.Организация, "ОсновнойБанковскийСчет"));
	ПараметрыФормы.Вставить("СуммаДокумента",          Объект.СуммаДокумента);
	ПараметрыФормы.Вставить("РазбиватьПоЛицевымСчетам", Ложь);
	
	ОткрытьФорму("Обработка.бит_ВводПКО.Форма.ФормаУправляемая", Новый Структура("ЗаполнитьИзДокументаОплатаПлатежнойКартой", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	мКэшЗначений.мТекущаяДатаДокумента = Объект.Дата; // Запомним текущую дату документа для контроля номера документа.
	
КонецПроцедуры

&НаКлиенте
Процедура ВводВРучнуюПриИзменении(Элемент)
	
	Если Объект.Проведен Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Перед вводом оплаты в ручную - распроведите документ.";
		Сообщение.Сообщить();
		
		Объект.ВводВРучную = мКэшЗначений.мВводВручную;
		
		Модифицированность = Ложь;
		
		Возврат;
		
	КонецЕсли; 
	
	ЗаполнениеТаблицыУслуг();
	УправлениеЭлементамиФормы();
	
	Объект.СписокУслуг.Сортировать("Приоритет Возр");
	
	ОбновитьНадписьНаФорме();
	ОбновитьДанныеКолонкиАдрес();
	ОбновитьДанныеКолонкиОтветственный();
	мКэшЗначений.мВводВручную = Объект.ВводВРучную;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Объект.СписокЛС.Количество() > 0 Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОрганизацияПриИзмененииЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;
		
	КонецЕсли;
	
	ОрганизацияПриИзмененииФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Организация = мКэшЗначений.мОрганизация;
		
		Возврат;
		
	КонецЕсли;
	
	Объект.СписокЛС.Очистить();
	Объект.СписокУслуг.Очистить();
	//Объект.СписокУслугПоПериоду.Очистить();
	ОрганизацияПриИзмененииФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзмененииФрагмент()
	
	мКэшЗначений.мСтруктураСчетовЖКХ = бит_ОбщегоНазначения.ПолучитьСчетаРасчетовЖКХ(Объект.Организация, КонецМесяца(Объект.Дата));
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	мКэшЗначений.мОрганизация = Объект.Организация;
	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникОплатыПриИзменении(Элемент)
	
	ЗаполнитьСчетаНаСервере();
	ОбновитьДанныеКолонкиАдрес();
	ОбновитьДанныеКолонкиОтветственный();
КонецПроцедуры

&НаКлиенте
Процедура ИсточникОплатыНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	СписокТипов = ПолучитьСписокТиповНаСервере(Элемент.Имя);
	
	ВыбранныйЭлемент = Неопределено;
	
	ЭтаФорма.ПоказатьВыборИзСписка(Новый ОписаниеОповещения("ИсточникОплатыНачалоВыбораЗавершение", ЭтотОбъект, Новый Структура("Элемент", Элемент)), СписокТипов, Элемент);	
КонецПроцедуры

&НаКлиенте
Процедура ИсточникОплатыНачалоВыбораЗавершение(ВыбранныйЭлемент1, ДополнительныеПараметры) Экспорт
	
	Элемент = ДополнительныеПараметры.Элемент;
	
	ВыбранныйЭлемент = ВыбранныйЭлемент1;
	
	ОчиститьСообщения();
	
	Если ВыбранныйЭлемент = Неопределено Тогда // Отказ от выбора.
		
		Возврат;
		
	КонецЕсли;
	
	ВыбранныйТип = ВыбранныйЭлемент.Значение;
	Если ВыбранныйТип  = "бит_КассыККМ" Тогда
		
		ТипСправочника    = ПолучитьТипСправочникаНаСервере(ВыбранныйТип);
		ОстатокТипа       = СокрЛП(Сред(ТипСправочника,20));
		СтрокаСправочника = "Справочник."+ОстатокТипа+".Форма.ФормаВыбораУправляемая";
		Структура = Новый Структура;
		Структура.Вставить("Организация",Объект.Организация);
		ОткрытьФорму(СтрокаСправочника,Новый Структура("ЗаполнитьИзОплатыКУ",Структура) ,Элемент);
		
	Иначе	
		ТипСправочника    = ПолучитьТипСправочникаНаСервере(ВыбранныйТип);
		ОстатокТипа       = СокрЛП(Сред(ТипСправочника,20));
		СтрокаСправочника = "Справочник."+ОстатокТипа+".Форма.ФормаВыбора";
		
		ОткрытьФорму(СтрокаСправочника, ,Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийТабличногоПоля

&НаКлиенте
Процедура СписокЛСПриАктивизацииСтроки(Элемент)
	
	ТекСтрока = Элемент.ТекущиеДанные;
	
	Если ТекСтрока <> Неопределено Тогда
		
		УстановитьОтборСписокУслуг(ТекСтрока);
		
	КонецЕсли;
	
	УправлениеВидимостьюКолонок(ТекСтрока);
	//+=Анисимова МВ восстановление базы 08.11.2024
	
	Если ТекСтрока <> Неопределено Тогда
		
		мКэшЗначений.мЛицевойСчет     = ТекСтрока.ЛицевойСчет;
		мКэшЗначений.мШаблонИзвещений = ТекСтрока.ШаблонИзвещений;
		мКэшЗначений.мСумма           = ТекСтрока.Сумма;
		//мКэшЗначений.лб_КлючСтроки     = ТекСтрока.лб_КлючСтроки;
	КонецЕсли;
	//--Анисимова МВ восстановление базы 08.11.2024
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Объект.Проведен Тогда
		
		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Перед изменением таблицы лицевых счетов - распроведите документ";
		Сообщение.Сообщить();
		
		Отказ = Истина;
		
	КонецЕсли; 
	
	Если Объект.ВводВРучную Тогда
		
		Отказ = Копирование;
		
	КонецЕсли; 
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСПередНачаломИзменения(Элемент, Отказ)
	
	ТекДанные = Элемент.ТекущиеДанные;
	
	Если ТекДанные <> Неопределено Тогда
		
		мКэшЗначений.мЛицевойСчет     = ТекДанные.ЛицевойСчет;
		мКэшЗначений.мШаблонИзвещений = ТекДанные.ШаблонИзвещений;
		мКэшЗначений.мСумма           = ТекДанные.Сумма;
		мКэшЗначений.лб_КлючСтроки     = ТекДанные.лб_КлючСтроки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСПередУдалением(Элемент, Отказ)
	
	Если Объект.Проведен Тогда
		
		Отказ = Истина;
		
		Возврат;
		
	КонецЕсли;
	
	ТекСтрока = Элементы.СписокЛС.ТекущиеДанные;
	
	Если НЕ ТекСтрока = Неопределено Тогда
		
		Отбор = Новый Структура;
		
		Отбор.Вставить("ЛицевойСчет"    , ТекСтрока.ЛицевойСчет);
		Отбор.Вставить("ШаблонИзвещений", ТекСтрока.ШаблонИзвещений);
		
		МассивСтрок = Объект.СписокУслуг.НайтиСтроки(Отбор);
		
		Для каждого Строка Из МассивСтрок Цикл
			
			Объект.СписокУслуг.Удалить(Строка);
			
		КонецЦикла; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСПриНачалеРедактирования(Элемент, НоваяСтрока, Копирование)
	
	ТекСтрока = Элемент.ТекущиеДанные;
	
	мКэшЗначений.мТекущийЛицевойСчет = ТекСтрока.ЛицевойСчет;
	
	Если НоваяСтрока 
		И НЕ Копирование 
		И НЕ Объект.ОплатаПоПериоду Тогда
		ТекСтрока.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемУслугам");
	ИначеЕсли НоваяСтрока
		И НЕ Копирование 
		И Объект.ОплатаПоПериоду Тогда
		ТекСтрока.ШаблонИзвещений = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемЗаМесяц");
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СписокЛСПриОкончанииРедактирования(Элемент, НоваяСтрока, ОтменаРедактирования)
	
	Если Элемент.ТекущиеДанные <> Неопределено Тогда
		ТекСтрока = Элемент.ТекущиеДанные;
		
		ПриИзмененииВСтроке(Объект.СписокЛС.Индекс(ТекСтрока));
	Иначе
		
		ПоказатьПредупреждение(Новый ОписаниеОповещения("СписокЛСПриОкончанииРедактированияЗавершение", ЭтотОбъект), "Разверните окно формы");
		
	КонецЕсли;
	
	Если Объект.ВводВРучную Тогда
		
		Если НЕ ТекСтрока = Неопределено Тогда
			
			ЗаполнитьСписокУслугПоШаблону(ТекСтрока);
			УстановитьОтборСписокУслуг(ТекСтрока);
			ПолучитьНачисленияПени(Объект.Дата, ТекСтрока.ЛицевойСчет);
			
		КонецЕсли; 
		
		Объект.СписокУслуг.Сортировать("Приоритет Возр");
		
	Иначе 
		
		Если НЕ Объект.Проведен Тогда
			
			Если Не мКэшЗначений.мНеРаспределятьОплатуПослеВводаСуммы Тогда
				ВыполнитьРасчетНаСервере();
			Иначе	
				ДокументРассчитан = Ложь;
			КонецЕсли; 
			
			СуммаДокумента = Объект.СписокЛС.Итог("Сумма");
			
			Элементы.СписокУслугСуммаПени.Видимость = ?(Объект.СписокУслуг.Итог("СуммаПени") <> 0 ИЛИ Объект.ВводВРучную, Истина, Ложь);
			
			Если Не Элемент.ТекущиеДанные = Неопределено Тогда  
				
				УстановитьОтборСписокУслуг(Элемент.ТекущиеДанные);
				
			КонецЕсли;
			
			УправлениеВидимостьюКолонок(ТекСтрока);
			УдалитьПустыеСтрокиНаСервере();
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ТекСтрока <> Неопределено И Объект.Проведен Тогда
		
		Если ТекСтрока.ЛицевойСчет <> мКэшЗначений.мЛицевойСчет Тогда
			
			ТекСтрока.ЛицевойСчет = мКэшЗначений.мЛицевойСчет;
			
			ОтменаРедактирования = Истина;
			
		КонецЕсли; 
		
		Если ТекСтрока.ШаблонИзвещений <> мКэшЗначений.мШаблонИзвещений Тогда
			
			ТекСтрока.ШаблонИзвещений = мКэшЗначений.мШаблонИзвещений;
			
			ОтменаРедактирования = Истина;
			
		КонецЕсли; 
		
		Если ТекСтрока.Сумма <> мКэшЗначений.мСумма Тогда
			
			ТекСтрока.Сумма = мКэшЗначений.мСумма;
			
			ОтменаРедактирования = Истина;
			
		КонецЕсли; 
		
		Если ОтменаРедактирования Тогда
			
			Сообщение = Новый СообщениеПользователю();
			Сообщение.Текст = "Перед изменением таблицы лицевых счетов - распроведите документ";
			Сообщение.Сообщить();
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	ОбновитьДанныеКолонкиАдрес();
	ОбновитьДанныеКолонкиОтветственный();
КонецПроцедуры

