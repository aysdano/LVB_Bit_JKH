// Функция формирует табличный документ с печатной формой СчетИзвещения.
// Возвращаемое значение:
// Табличный документ - печатная форма. 
Функция ПечатьСчетИзмещенияВариант2(ИмяМакета)
	
	Попытка
		КомпонентШК = Новый COMОбъект("V8.Barcod.1");
		мЗагруженШтрихкод = Истина;
	Исключение
		мЗагруженШтрихкод = Ложь;
	КонецПопытки;
	
	Макет = ПолучитьМакет(ИмяМакета);
	
	ТабДок = Новый ТабличныйДокумент();
	ТабДок.КлючПараметровПечати = "Счет-Извещение";
	
	ОбластьШапка1       = Макет.ПолучитьОбласть("Шапка1");
	ОбластьШапка2       = Макет.ПолучитьОбласть("Шапка2");
	ОбластьПодвал       = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал1      = Макет.ПолучитьОбласть("Подвал1");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = Макет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = Макет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = Макет.ПолучитьОбласть("Итого");
	ОбластьИтогоПени    = Макет.ПолучитьОбласть("ИтогоПени");
	ШапкаПриборыУчета   = Макет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаПриборовУчета = Макет.ПолучитьОбласть("СтрокаПриборовУчета");
	СтрокаВывода        = Макет.ПолучитьОбласть("СтрокаВывода");
	ОбластьШтрихКод     = Макет.ПолучитьОбласть("ОбластьШтрихКод");
	
	ОбластьШапка1.Параметры.Заполнить(мСтруктураДанных);
	ТабДок.Вывести(ОбластьШапка1); 
	Если мЗагруженШтрихкод тогда

		СтрокаСумма = бит_ОбщегоНазначения.СформируемШтрихКод(мСтруктураДанных.ИтогоКОплатеСУчетомПени, Ссылка.Наименование, Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам.Идентификатор, Ссылка.Идентификатор, мНомерПолучателяПоБанку, мИспользоватьНомерПолучателяВШК);
		
		ОбластьШтрихКод.Рисунки.ШтрихКод.Объект.Сообщение = СтрокаСумма;
		
		ТабДок.Вывести(ОбластьШтрихКод);
	КонецЕсли;
	ОбластьШапка2.Параметры.Заполнить(мСтруктураДанных);
	ТабДок.Вывести(ОбластьШапка2);
	
	
	СчВывода = 5;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабСЧ.Счетчик,
	|	ТабСЧ.Услуга,
	|	ТабСЧ.ДоПоказаний,
	|	ТабСЧ.Приоритет
	|ПОМЕСТИТЬ ТабСЧ
	|ИЗ
	|	&ТабСЧ КАК ТабСЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабСЧ.Счетчик КАК Счетчик,
	|	ТабСЧ.Услуга КАК Услуга,
	|	ТабСЧ.ДоПоказаний КАК ДоПоказаний,
	|	ТабСЧ.Приоритет КАК Приоритет
	|ИЗ
	|	ТабСЧ КАК ТабСЧ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ
	|	МАКСИМУМ(ДоПоказаний)
	|ПО
	|	Счетчик";
	
	Запрос.УстановитьПараметр("ТабСЧ",мТаблицаПечатиСчетчиков);
	
	ВыборкаСЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаСЧ = мТаблицаПечатиСчетчиков.СкопироватьКолонки();
	ТаблицаСЧ.Очистить();
	
	Если ВыборкаСЧ.Количество() > 0 тогда
		
		СчВывода = СчВывода - 1;
		ТабДок.Вывести(ШапкаПриборыУчета);
		Пока ВыборкаСЧ.Следующий() Цикл
			
			НоваяСтрока = ТаблицаСЧ.Добавить();
			СтрокаПриборовУчета.Параметры.Заполнить(ВыборкаСЧ);
			Выборка = ВыборкаСЧ.Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				СтрокаПриборовУчета.Параметры.Услуга = Лев(Выборка.Услуга, 12);
				
			КонецЕсли;
			
			СчВывода = СчВывода - 1;
			ТабДок.Вывести(СтрокаПриборовУчета);
			
			Если СЧВывода <= 0 Тогда
				
				Прервать;
				СчВывода =0;
				
			КонецЕсли; 
			
		КонецЦикла;	
		
		Пока СчВывода <> 0 цикл
			ТабДок.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
		КонецЦикла;
		
	иначе
		
		Пока СчВывода <> 0 цикл
			ТабДок.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
		КонецЦикла;	
	КонецЕсли;	
	
	ТабДок.Вывести(ОбластьПодвал);
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	ТабДок.Вывести(ОбластьШапка);
	
	Если ТаблицаСЧ.Количество() > 0 Тогда
		ТабДок.Вывести(ШапкаПриборыУчета);
		Для каждого ТекСтрока Из ТаблицаСЧ Цикл
			
			СтрокаПриборовУчета.Параметры.Заполнить(ТекСтрока);
			// БИТ_ЖКХ изменения кода . Начало: 23.03.2011
			СтрокаПриборовУчета.Параметры.Услуга = Лев(СтрокаПриборовУчета.Параметры.Услуга,12);
			// БИТ_ЖКХ изменения кода . Конец  23.03.2011 
			ТабДок.Вывести(СтрокаПриборовУчета);
			
		КонецЦикла; 
	иначе
		
	КонецЕсли;	
	
	ТабДок.Вывести(ОбластьПодвал1);
	ШапкаЗаголовки.Параметры.Заполнить(мСтруктураДанных);
	ТабДок.Вывести(ШапкаЗаголовки);
	
	Для Каждого ТекСтрока  Из мТаблицаПечати  Цикл 
		// БИТ_ЖКХ изменения кода . Начало: 21.05.2012
		Если ТекСтрока.СальдоНаНачало = 0 И ТекСтрока.Начислено = 0 Тогда
			Продолжить;
		Иначе
			СтрокаРасшифровки.Параметры.Заполнить(ТекСтрока);
			ТабДок.Вывести(СтрокаРасшифровки);
		КонецЕсли;
		// БИТ_ЖКХ изменения кода . Конец  21.05.2012
	КонецЦикла;
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	ТабДок.Вывести(ОбластьИтого);
	
	Если мСтруктураДанных.ИтогПени > 0 Тогда
		
		ОбластьИтогоПени.Параметры.Заполнить(мСтруктураДанных);
		ТабДок.Вывести(ОбластьИтогоПени);
		
	КонецЕсли; 
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ПолеСверху = 0;
	ТабДок.ПолеСнизу = 0;
	
	Возврат ТабДок;
	
КонецФункции // ()

// Функция формирует табличный документ с печатной формой СчетИзвещения.
