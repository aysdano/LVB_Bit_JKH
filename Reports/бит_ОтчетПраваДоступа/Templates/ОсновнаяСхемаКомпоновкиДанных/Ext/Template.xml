		<query>ВЫБРАТЬ
	бит_ПраваДоступа.СубъектДоступа,
	бит_ПраваДоступа.ОбъектДоступа,
	бит_ПраваДоступа.Редактирование,
	бит_ПраваДоступа.Создание,
	бит_ПраваДоступа.Копирование,
	бит_ПраваДоступа.ПометкаНаУдаление,
	бит_ПраваДоступа.ПереносВГруппу,
	бит_ПраваДоступа.Печать,
	бит_ПраваДоступа.ВидОбъекта,
	ВЫБОР
		КОГДА бит_ПраваДоступа.СубъектДоступа ССЫЛКА Справочник.Пользователи
			ТОГДА "Пользователи"
		ИНАЧЕ "Шаблоны"
	КОНЕЦ КАК ВидСубъекта,
	NULL КАК Проведение,
	NULL КАК ОтменаПроведения,
	ВЫБОР
		КОГДА бит_ПраваДоступа.Редактирование
				И бит_ПраваДоступа.Создание
				И бит_ПраваДоступа.ПометкаНаУдаление
				И бит_ПраваДоступа.ПереносВГруппу
				И бит_ПраваДоступа.Печать
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ КАК ВсеПрава,
	бит_ПраваДоступа.ОбластьДоступа КАК ОбластьДоступа
ИЗ
	РегистрСведений.бит_ПраваДоступа КАК бит_ПраваДоступа
ГДЕ
	бит_ПраваДоступа.ВидОбъекта = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОбъектов.Справочник)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	бит_ПраваДоступа.СубъектДоступа,
	бит_ПраваДоступа.ОбъектДоступа,
	бит_ПраваДоступа.Редактирование,
	бит_ПраваДоступа.Создание,
	бит_ПраваДоступа.Копирование,
	бит_ПраваДоступа.ПометкаНаУдаление,
	NULL,
	бит_ПраваДоступа.Печать,
	бит_ПраваДоступа.ВидОбъекта,
	ВЫБОР
		КОГДА бит_ПраваДоступа.СубъектДоступа ССЫЛКА Справочник.Пользователи
			ТОГДА "Пользователи"
		ИНАЧЕ "Шаблоны"
	КОНЕЦ,
	бит_ПраваДоступа.Проведение,
	бит_ПраваДоступа.ОтменаПроведения,
	ВЫБОР
		КОГДА бит_ПраваДоступа.Редактирование
				И бит_ПраваДоступа.Создание
				И бит_ПраваДоступа.Копирование
				И бит_ПраваДоступа.ПометкаНаУдаление
				И бит_ПраваДоступа.Печать
				И бит_ПраваДоступа.Проведение
				И бит_ПраваДоступа.ОтменаПроведения
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ,
	бит_ПраваДоступа.ОбластьДоступа
ИЗ
	РегистрСведений.бит_ПраваДоступа КАК бит_ПраваДоступа
ГДЕ
	бит_ПраваДоступа.ВидОбъекта = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОбъектов.Документ)

ОБЪЕДИНИТЬ ВСЕ

ВЫБРАТЬ
	бит_ПраваДоступа.СубъектДоступа,
	бит_ПраваДоступа.ОбъектДоступа,
	бит_ПраваДоступа.Редактирование,
	NULL,
	NULL,
	NULL,
	NULL,
	NULL,
	бит_ПраваДоступа.ВидОбъекта,
	ВЫБОР
		КОГДА бит_ПраваДоступа.СубъектДоступа ССЫЛКА Справочник.Пользователи
			ТОГДА "Пользователи"
		ИНАЧЕ "Шаблоны"
	КОНЕЦ,
	NULL,
	NULL,
	ВЫБОР
		КОГДА бит_ПраваДоступа.Редактирование
			ТОГДА ИСТИНА
		ИНАЧЕ ЛОЖЬ
	КОНЕЦ,
	бит_ПраваДоступа.ОбластьДоступа
ИЗ
	РегистрСведений.бит_ПраваДоступа КАК бит_ПраваДоступа
ГДЕ
	(бит_ПраваДоступа.ВидОбъекта = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОбъектов.Отчет)
			ИЛИ бит_ПраваДоступа.ВидОбъекта = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОбъектов.Обработка)
			ИЛИ бит_ПраваДоступа.ВидОбъекта = ЗНАЧЕНИЕ(Перечисление.бит_ВидыОбъектов.РегистрСведений))</query>
