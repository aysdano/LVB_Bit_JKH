	Пока ВыборкаВопрос.Следующий() Цикл
		
		НоваяСтрокаВопрос = УровеньВопрос.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаВопрос, ВыборкаВопрос);
