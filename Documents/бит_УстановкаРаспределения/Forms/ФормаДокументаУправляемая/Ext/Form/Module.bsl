&НаСервереБезКонтекста
Функция ПолучитьСписокУслугНаСервере2()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_УслугиЖКХ.Ссылка КАК Услуга
	|ИЗ
	|	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	|ГДЕ
	|	бит_УслугиЖКХ.СпособыРасчета.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоРаспределению)";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокУслуг = Новый СписокЗначений;
	
	СписокУслуг.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Услуга"));
	
	Возврат СписокУслуг;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьЛицевыеСчетаНаСервере2(АдресЛСВХранилище);
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(АдресЛСВХранилище);
	
	Отбор = Новый Структура;
	
	Для каждого Строка Из ТаблицаЛС Цикл

		Отбор.Вставить("Услуга"     , Строка.Услуга);
		Отбор.Вставить("ЛицевойСчет", Строка.ЛицевойСчет);
		
		СтрокиПоиска = Объект.ЛицевыеСчета.НайтиСтроки(Отбор);
		
		Если СтрокиПоиска.Количество() > 0 Тогда
			
			Отбор.Удалить("ЛицевойСчет");
			Отбор.Удалить("Услуга");
			
			Продолжить;
			
		КонецЕсли;
		
		Данные         = РеквизитФормыВЗначение("Объект");
		ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		НоваяСтрока = Данные.ЛицевыеСчета.Добавить();
		
		НоваяСтрока.ЛицевойСчет = Строка.ЛицевойСчет;
		НоваяСтрока.Услуга      = Строка.Услуга;
		
		НоваяСтрока.ОтветственноеЛицо      = ОтветственныйНаЛС(Строка.ЛицевойСчет);
		НоваяСтрока.Адрес = Строка(Строка.ЛицевойСчет.УлицаЛицевогоСчета) + ", " + Строка(Строка.ЛицевойСчет.Здание);;
		
		ДокументОбъект.ПроверитьИЗаполнитьСтрокуЛС(Объект.Дата, Строка.ЛицевойСчет, Строка.Услуга, Объект.Объект, НоваяСтрока);
		
		Если НЕ ЗначениеЗаполнено(НоваяСтрока.ЛицевойСчет) Тогда
			
			Данные.ЛицевыеСчета.Удалить(НоваяСтрока);
			
		КонецЕсли;
		
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
		
        ЗначениеВРеквизитФормы(Данные,"Объект");

		Отбор.Удалить("ЛицевойСчет");
		Отбор.Удалить("Услуга");
		
	КонецЦикла;
	
КонецПроцедуры

// Функция Получение ответственного на выбранном ЛС.
// Параметры:
//  <ЛицевойСчет> – <Справочник.бит_ЛицевыеСчета> – для получения ответственного по ЛС.
//
// Возвращаемое значение:
//   <ТаблицаЗначений.Строка> – <строка с ответственным по ЛС>.
//
&НаСервере
Функция ОтветственныйНаЛС(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					ЛицевыеСчета.Ссылка
	|				ИЗ
	|					Справочник.бит_ЛицевыеСчета КАК ЛицевыеСчета
	|				ГДЕ
	|					ЛицевыеСчета.Ссылка = &ЛицевойСчет)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизЛицо";
	
	Запрос.УстановитьПараметр("Момент", 	 ТекущаяДата());
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()> 0 Тогда
		
		РезультатФизЛицо = Результат[0].ФизЛицо
	Иначе
		РезультатФизЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФизЛицо;
	
КонецФункции // 

#КонецОбласти