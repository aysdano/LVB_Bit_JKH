&НаКлиенте
Процедура ПечататьВсеЧеки(Команда)
	Элементы.Прогресс.МаксимальноеЗначение = Объект.Документы.Количество();
	Прогресс = Элементы.Прогресс.МинимальноеЗначение;
	Для Каждого Стр ИЗ Объект.Документы Цикл
		Прогресс = Прогресс + 1;
		Если НЕ Стр.Пробит Тогда
		
			Если НЕ ЗначениеЗаполнено(Стр.ПараметрыДокумента) Тогда
				ПолучитьДанныеДляПечати(Стр)	
			КонецЕсли;
			
			//25.09.2019
			если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(Стр.ПараметрыДокумента, "МассивЧеков") = ложь тогда				
			  продолжить;
			конецесли;	
			
			Если НЕ ОтправлятьЧекПочтой Тогда
				Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail = Неопределено;
				
			Иначе
				Стр.ПараметрыДокумента.МассивЧеков[0].Отправляет1СEmail = ПолучитьНастройкиОтправкиОтчетов(Стр.ПараметрыДокумента.ИдентификаторУстройства).Отправляет1СEmail;
				//БИТ ЖКХ 13.05.2020
				если ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков) тогда 
				 если ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail) = ложь тогда 	
					Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail = ЭтотОбъект.АдресЭлектроннойПочты;
				 конецесли;	
				конецесли;	
			КонецЕсли;
			
			Если НЕ ОтправлятьЧекSMS Тогда
				Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательНомер = "";
				
			Иначе
				Стр.ПараметрыДокумента.МассивЧеков[0].Отправляет1СSMS = ПолучитьНастройкиОтправкиОтчетов(Стр.ПараметрыДокумента.ИдентификаторУстройства).Отправляет1СSMS;
			КонецЕсли;
		
			Если (ОтправлятьЧекSMS И ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательНомер)) ИЛИ (ОтправлятьЧекПочтой И ЗначениеЗаполнено(Стр.ПараметрыДокумента.МассивЧеков[0].ПокупательEmail)) Тогда
				Если НЕПечататьЧек Тогда			
					Стр.ПараметрыДокумента.МассивЧеков[0].Электронно = Истина;
					
				КонецЕсли;	
				
			КонецЕсли;
			
			// БИТ ЖКХ 19.02.2020
			Если НЕПечататьЧек = истина Тогда
				Стр.ПараметрыДокумента.МассивЧеков[0].Электронно = Истина;
			конецесли;	
			
			//ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",Стр.Документ));
			//25.09.2019
			//если ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") тогда
			// БИТ ЖКХ 31.12.2020 PTC
			если ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") или ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда
			 // БИТ ЖКХ 27.04.2020
			 попытка
		      ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокументаОбщая",Новый Структура("Ключ",Стр.Документ));
		     исключение
			  ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",Стр.Документ)); 
	         конецпопытки;  			  
		    иначе
		     ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокумента",Новый Структура("Ключ",Стр.Документ));
			  // БИТ ЖКХ 01.09.2020
			 если ТипЗнч(Стр.Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") тогда
			  ФормаДок = ПолучитьФорму("Документ."+Стр.ИмяДок+".Форма.ФормаДокументаОбщая",Новый Структура("Ключ",Стр.Документ));
			 конецесли; 
		    конецесли;
			
			Если Стр.ПараметрыДокумента.МассивЧеков.Количество() > 0 Тогда
			  НапечататьОдинЧек(ФормаДок, Стр.ПараметрыДокумента.МассивЧеков, Стр.ПараметрыДокумента.ИдентификаторУстройства, Стр.ПараметрыДокумента.ВерсияФормата, Стр.Адрес, Стр.Контрагент, Стр.ЛицевойСчет);
			КонецЕсли;
			
			Если Не Отладка_НеМенятьНомерЧекаККМ Тогда
				// БИТ ЖКХ 23.05.2020
				// БИТ ЖКХ 19.06.2020
				//ФормаДок.Объект.РучнаяКорректировка = ложь;
				ФормаДок.Записать();
			КонецЕсли;
			Если ФормаДок.Объект.НомерЧекаККМ <> 0 Тогда
			Стр.Пробит = Истина;
		Иначе
			Стр.Пробит = Ложь;
			КонецЕсли;
		КонецЕсли; 
	КонецЦикла;	
	
	//25.09.2019
	ПараметрыОтбора = Новый Структура;
    ПараметрыОтбора.Вставить("Пробит", ложь);
	НайденныеСтроки = Объект.Документы.НайтиСтроки(ПараметрыОтбора);
	
	если НайденныеСтроки.Количество() > 0 тогда
	 Сообщить("Чеки не пробиты!");
    иначе
	 Сообщить("Чеки пробиты!");
	конецесли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПараметры(Форма)
	
	ДокОбъект = Форма.Объект;
	
	ОчиститьСообщения();
	
	ОписаниеОшибки = "";
	
	//+МРЦ
	//Если ДокОбъект.НомерЧекаККМ <> 0 Тогда
	//	ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном устройстве!'");
	//	ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	//	
	//	Возврат;
	//КонецЕсли;
	//-МРЦ
	
	// БИТ ЖКХ 26.02.2021
	если ДокОбъект.Проведен = ложь тогда
	  ТекстСообщения = НСтр("ru = 'Операция возможна только после проведения документа'");
	  Сообщить(ТекстСообщения);         
	  // ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);		  
	  возврат;
	конецесли;	
	
	Если ПроверитьВозможностьПечатиЧека(Форма) Тогда
		
		Если МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда
			Контекст = Новый Структура();
			Контекст.Вставить("Форма", Форма);
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборФискальногоУстройстваЗавершение", ЭтотОбъект, Контекст);
			ПоддерживаемыеТипыВО = Новый Массив();
			ПоддерживаемыеТипыВО.Добавить("ФискальныйРегистратор");
			ПоддерживаемыеТипыВО.Добавить("ПринтерЧеков");
			ПоддерживаемыеТипыВО.Добавить("ККТ");
			ПредложитьВыбратьУстройство(ОписаниеОповещения, ПоддерживаемыеТипыВО,
				НСтр("ru = 'Выберите фискальное устройство'"), НСтр("ru = 'Фискальное устройство не подключено.'"));
		Иначе
			ТекстСообщения = НСтр("ru = 'Предварительно необходимо выбрать рабочее место внешнего оборудования текущего сеанса.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПредложитьВыбратьУстройство(ОповещениеВыбора, ТипОборудования, ТекстЗаголовкаВыбора, 
	
	СообщениеНеПодключен = "", СообщениеНеВыбран = "", БезСообщений = Ложь, ТекстСообщения = "") 
	
	Если Не МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда
		ТекстСообщения = НСтр("ru='Предварительно необходимо выбрать рабочее место подключаемого оборудования текущего сеанса.'");
		Если Не БезСообщений Тогда
		      ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		Возврат;
	КонецЕсли;
	
	СписокДоступныхУстройств = МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам(ТипОборудования);
	
	Если СписокДоступныхУстройств.Количество() = 0 Тогда
		Если Не ПустаяСтрока(СообщениеНеПодключен) Тогда
			Если БезСообщений Тогда
				ТекстСообщения = СообщениеНеПодключен;
			Иначе
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(СообщениеНеПодключен);
			КонецЕсли;
		КонецЕсли;
		ВыполнитьОбработкуОповещения(ОповещениеВыбора, Неопределено);
	Иначе
		СписокУстройств = Новый СписокЗначений();
		Для Каждого Устройства Из СписокДоступныхУстройств Цикл
			СписокУстройств.Добавить(Устройства.Ссылка, Устройства.Наименование);
		КонецЦикла;
		Если СписокУстройств.Количество() = 1 Тогда
			Идентификатор = СписокУстройств[0].Значение;
			ВыполнитьОбработкуОповещения(ОповещениеВыбора, Идентификатор); 
		Иначе
			Контекст = Новый Структура;
			Контекст.Вставить("СледующееОповещение", ОповещениеВыбора);
			Контекст.Вставить("СообщениеНеВыбран"  , ?(ПустаяСтрока(СообщениеНеВыбран), СообщениеНеПодключен, СообщениеНеВыбран));
			Контекст.Вставить("БезСообщений"       , БезСообщений);
			//25.09.2019
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборФискальногоУстройстваЗавершение", ЭтотОбъект, Контекст);
//			ОписаниеОповещения = Новый ОписаниеОповещения("ПредложитьВыбратьУстройствоЗавершение", ЭтотОбъект, Контекст);

			СписокУстройств.ПоказатьВыборЭлемента(ОписаниеОповещения, ТекстЗаголовкаВыбора);
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыборФискальногоУстройстваЗавершение(ИдентификаторУстройства, Параметры)Экспорт
	
	Если НЕ ЗначениеЗаполнено(ИдентификаторУстройства) Тогда
		Возврат;
	КонецЕсли;
	
	Параметры.Вставить("ИдентификаторУстройства", ИдентификаторУстройства);
	
	ДанныеУстройства = МенеджерОборудованияКлиентПовтИсп.ПолучитьДанныеУстройства(ИдентификаторУстройства);
	ТипУстройства = ?(ДанныеУстройства.Свойство("ТипОборудованияИмя"), ДанныеУстройства.ТипОборудованияИмя, "ККТ");
	
	Параметры.Вставить("ТипУстройства", ТипУстройства);
	
	Если ТипУстройства = "ККТ" Тогда
		Форма = Параметры.Форма;
	
		ОповещениеПриЗавершении = Новый ОписаниеОповещения("ПолучитьПараметрыЗавершение", ЭтотОбъект, Параметры);
		МенеджерОборудованияКлиент.НачатьПолучениеПараметровФискальногоУстройства(ОповещениеПриЗавершении, Форма.УникальныйИдентификатор , ИдентификаторУстройства, Ложь);
	Иначе
		ПолучитьПараметрыЗавершение(Неопределено, Параметры);
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПараметрыЗавершение(ПараметрыФискальногоУстройства, Параметры) Экспорт
	
	Перем АдресУстановкиККТ, ОписаниеОшибки;	
	Если ПараметрыФискальногоУстройства =  Неопределено Тогда
		// Принтер чеков эмулирует все атрибуды ФФД 1.1
		пВерсияФормата = ?(Параметры.ТипУстройства = "ПринтерЧеков", "1.1.0.0", "1.0.0.0");
	ИначеЕсли НЕ ПараметрыФискальногоУстройства.Результат Тогда 
		ОписаниеОшибки = ПараметрыФискальногоУстройства.ОписаниеОшибки;
	Иначе
		пВерсияФормата = ПечатьФискальныхДокументовКлиент.ПолучитьВерсиюФФД(ПараметрыФискальногоУстройства.ВыходныеПараметры.ВерсияФФДФН, ПараметрыФискальногоУстройства.ВыходныеПараметры.ВерсияФФДККТ);
		ПараметрыФискальногоУстройства.ВыходныеПараметры.Свойство("АдресУстановкиККТ", АдресУстановкиККТ);
	КонецЕсли; 
	
	// Если не удалось подключить ККТ, то формировать чеки смысла нет
	Если НЕ ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ПараметрыУстройства = МенеджерОборудованияКлиентПовтИсп.ПолучитьПараметрыУстройства(Параметры.ИдентификаторУстройства);
		НомерСекции         = ?(ПараметрыУстройства.Свойство("НомерСекции"), ПараметрыУстройства.НомерСекции, 0);
		
		// БИТ ЖКХ 11.02.2021
		если УчитыватьАванс= истина тогда
		 МассивЧеков = СобратьДанныеСАвансом(Параметры.Форма.Объект.Ссылка,пВерсияФормата,Параметры.ИдентификаторУстройства);	
		иначе	
		 МассивЧеков = СобратьДанные(Параметры.Форма.Объект.Ссылка,пВерсияФормата,Параметры.ИдентификаторУстройства);
		конецесли; 
		
		//07.8.2019
		ОбъектТекущегоДокумента = Параметры.Форма.Объект.Ссылка;
		
		// БИТ ЖКХ 31.12.2020 РТС
		Если Объект.Документы.Количество() > 0 и ТипЗнч(Объект.Документы[0].Документ) = Тип("ДокументСсылка.РеализацияТоваровУслуг") Тогда
		Иначе
		
			для каждого стр из МассивЧеков[0].ПозицииЧека цикл
				//+МРЦ
				//стр.ПризнакСпособаРасчета = Объект.Документы[0].ПризнакиСпособаРасчета;
				//-МРЦ
				//20.09.2019
				если ТипЗнч(ОбъектТекущегоДокумента) = Тип("ДокументСсылка.ПоступлениеНаРасчетныйСчет") и стр.СтавкаНДС = 0 или 
					  ТипЗнч(ОбъектТекущегоДокумента) = Тип("ДокументСсылка.ОплатаПлатежнойКартой") и стр.СтавкаНДС = 0 или
					   ТипЗнч(ОбъектТекущегоДокумента) = Тип("ДокументСсылка.ПриходныйКассовыйОрдер") и стр.СтавкаНДС = 0 тогда
					НДСИзПоступления = ПолучитьНДСИзДокумента(ОбъектТекущегоДокумента);
					стр.СтавкаНДС = НДСИзПоступления.СтавкаНДС;
					стр.СуммаНДС = НДСИзПоступления.СуммаНДС;
				конецесли;				
							
			конеццикла;				
						
		КонецЕсли;
		
		ПараметрСтроки = Новый Структура("МассивЧеков,ИдентификаторУстройства,ВерсияФормата",МассивЧеков, Параметры.ИдентификаторУстройства, пВерсияФормата);
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ОписаниеОшибки) Тогда
		ТекстСообщения = НСтр("ru = 'При подключении устройства произошла ошибка.
			|Чек не напечатан на фискальном устройстве.
			|Дополнительное описание:
			|%ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения, "%ДополнительноеОписание%", ОписаниеОшибки);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	

КонецПроцедуры
//20.09.2019
функция ПолучитьНДСИзДокумента(Док)	
	
  ндс = новый Структура();	
  ндс.Вставить("СтавкаНДС", 0);//
  
  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/120") > 0  тогда
	ндс.СтавкаНДС = 120;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;
  конецесли;

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "20") > 0 и
      Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/120") = 0 тогда	
	ндс.СтавкаНДС = 20;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;     
  конецесли; 

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/110") > 0  тогда
	ндс.СтавкаНДС = 110;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;
  конецесли;

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "10") > 0 и
      Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/110") = 0 тогда	
	ндс.СтавкаНДС = 10;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;     
  конецесли; 

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/118") > 0  тогда
	ндс.СтавкаНДС = 118;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;
  конецесли;

  если Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "18") > 0 и
      Найти(Строка(Док.РасшифровкаПлатежа[0].СтавкаНДС), "/118") = 0 тогда	
	ндс.СтавкаНДС = 18;
	ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
    возврат ндс;     
  конецесли; 

  ндс.Вставить("СуммаНДС", Док.РасшифровкаПлатежа[0].СуммаНДС);  
  возврат ндс;    
  
конецфункции	

&НаКлиенте
Процедура НапечататьОдинЧек(Форма, МассивЧеков, ИдентификаторУстройства, ВерсияФормата, Адрес = "", Контрагент = "", ЛицевойСчет = "")
	ДокОбъект = Форма.Объект;
	
	ОбщиеПараметры    = МассивЧеков[0];
	
	Контекст = Новый Структура();
	Контекст.Вставить("МассивЧеков", МассивЧеков);
	Контекст.Вставить("ИдентификаторУстройства", ИдентификаторУстройства);
	Контекст.Вставить("ВерсияФормата", ВерсияФормата);
	Контекст.Вставить("Форма", Форма);
	
	Оповещение = Новый ОписаниеОповещения("НапечататьОдинЧекЗавершение", ЭтотОбъект, Контекст);
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ПараметрыПечатиЧека",     МассивЧеков[0]);
	ПараметрыФормы.Вставить("Организация",             ДокОбъект.Организация);
	ПараметрыФормы.Вставить("ИдентификаторУстройства", ИдентификаторУстройства);
	ПараметрыФормы.Вставить("ВерсияФормата",           ВерсияФормата);
	
	Если ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 118 Тогда
		ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 18; 
	ИначеЕсли ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 110 Тогда
		ПараметрыФормы.ПараметрыПечатиЧека.ПозицииЧека[0].СтавкаНДС = 10;
	КонецЕсли;	

	// 23.10.2020
	//ПараметрыФормы.ПараметрыПечатиЧека.ПолучательИНН = "";
	
	// БИТ ЖКХ 23.10.2020		 
	если Контрагент <> "" тогда
	     
	     ПараметрыФормы.ПараметрыПечатиЧека.Получатель = Контрагент;
	    
	конецесли;	
	 
	если Адрес <> "" тогда
	   если ПараметрыФормы.ПараметрыПечатиЧека.Получатель <> "" тогда  
	     ПараметрыФормы.ПараметрыПечатиЧека.Получатель = ПараметрыФормы.ПараметрыПечатиЧека.Получатель + "; " + Адрес;
	   иначе	 
		 ПараметрыФормы.ПараметрыПечатиЧека.Получатель = Адрес;  
	   конецесли;	   
	конецесли;	

	если ЛицевойСчет <> "" тогда
	   если ПараметрыФормы.ПараметрыПечатиЧека.Получатель <> "" тогда  
	     ПараметрыФормы.ПараметрыПечатиЧека.Получатель = ПараметрыФормы.ПараметрыПечатиЧека.Получатель + "; " + ЛицевойСчет;
	   иначе	 
		 ПараметрыФормы.ПараметрыПечатиЧека.Получатель = ЛицевойСчет;  
	   конецесли;	 
	     
	конецесли;

	
	 
	
	// БИТ ЖКХ 14.07.2020
	ФорматноЛогическийКонтрольКлиентСервер.ПровестиФорматноЛогическийКонтроль(ПараметрыФормы.ПараметрыПечатиЧека, ПараметрыФормы.ИдентификаторУстройства);
	
	МенеджерОборудованияКлиент.НачатьФискализациюЧекаНаФискальномУстройстве(Оповещение, 
		Форма.УникальныйИдентификатор, 
		ПараметрыФормы.ПараметрыПечатиЧека, 
		ПараметрыФормы.ИдентификаторУстройства,
		,
		,
		);

КонецПроцедуры

&НаКлиенте
Процедура НапечататьОдинЧекЗавершение(РезультатВыполнения, Параметры) Экспорт
	
	Если РезультатВыполнения = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Форма = Параметры.Форма;
	ДокОбъект = Форма.Объект;
	
	Если РезультатВыполнения.Результат Тогда
		
		Параметры.МассивЧеков.Удалить(0);
		ДокОбъект.НомерЧекаККМ = РезультатВыполнения.ВыходныеПараметры[1];
		
		Если Параметры.МассивЧеков.Количество() > 0 Тогда
			НапечататьОдинЧек(Форма, Параметры.МассивЧеков, Параметры.ИдентификаторУстройства, Параметры.ВерсияФормата);
		Иначе
			Модифицированность = Истина;
			Если Не Отладка_НеМенятьНомерЧекаККМ Тогда
				Форма.Записать(Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение));
			КонецЕсли;
			
		КонецЕсли;
	Иначе
		
		ТекстСообщения = НСтр("ru = 'При печати чека произошла ошибка.
			|Чек не напечатан на фискальном устройстве.
			|Дополнительное описание:
			|%ДополнительноеОписание%'");
		ТекстСообщения = СтрЗаменить(ТекстСообщения,
			"%ДополнительноеОписание%",
			РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Функция ПроверитьВозможностьПечатиЧека(Форма)
	ПечататьЧек = Истина;
	
	// Если объект не проведен или модифицирован - сообщим пользователю, что печать не возможна.
	Если СтрНачинаетсяС(Форма.ИмяФормы, "Документ.")
		И (НЕ Форма.Объект.Проведен
		ИЛИ Форма.Модифицированность) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю( НСтр("ru = 'Операция возможна только после проведения документа'"), Форма.Объект.ДокументОснование);
		ПечататьЧек = Ложь;
		
	КонецЕсли;
	
	Возврат ПечататьЧек;
