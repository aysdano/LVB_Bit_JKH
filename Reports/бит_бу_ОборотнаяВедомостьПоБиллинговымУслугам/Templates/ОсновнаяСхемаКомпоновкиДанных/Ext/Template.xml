		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Услуга КАК Услуга,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Поставщик КАК Поставщик,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет.УлицаЛицевогоСчета КАК Улица,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет.Здание КАК Здание,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет.Здание.Район КАК Район,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет.Здание.Участок КАК Участок,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.РежимПотребления,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Организация
ПОМЕСТИТЬ ПоставщикиИУслуги
ИЗ
	РегистрСведений.бит_бу_СведенияОБиллинговыхУслугах.СрезПоследних(&amp;КонецПериода {(&amp;КонецПериода)}, Организация = &amp;Организация) КАК бит_бу_СведенияОБиллинговыхУслугахСрезПоследних

СГРУППИРОВАТЬ ПО
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Услуга,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Поставщик,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет.УлицаЛицевогоСчета,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет.Здание,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет.Здание.Район,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.ЛицевойСчет.Здание.Участок,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.РежимПотребления,
	бит_бу_СведенияОБиллинговыхУслугахСрезПоследних.Организация
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_бу_НачисленияБиллинговыхУслугОбороты.ЛицевойСчет КАК ЛицевойСчет,
	бит_бу_НачисленияБиллинговыхУслугОбороты.Услуга,
	СУММА(ВЫБОР
			КОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.Регистратор ССЫЛКА Документ.бит_бу_НачисленияПоБиллинговымУслугам
				ТОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.СуммаОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Начислено,
	СУММА(ВЫБОР
			КОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.Регистратор ССЫЛКА Документ.бит_бу_РазовыеПоБиллинговымУслугам
				ТОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.СуммаОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Разовые,
	СУММА(ВЫБОР
			КОГДА бит_бу_НачисленияБиллинговыхУслугОбороты.Регистратор ССЫЛКА Документ.бит_бу_ОплатаБиллинговыхУслуг
				ТОГДА -бит_бу_НачисленияБиллинговыхУслугОбороты.СуммаОборот
			ИНАЧЕ 0
		КОНЕЦ) КАК Оплата
ПОМЕСТИТЬ Обороты
ИЗ
	РегистрНакопления.бит_бу_НачисленияБиллинговыхУслуг.Обороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, Регистратор, Организация = &amp;Организация) КАК бит_бу_НачисленияБиллинговыхУслугОбороты

СГРУППИРОВАТЬ ПО
	бит_бу_НачисленияБиллинговыхУслугОбороты.ЛицевойСчет,
	бит_бу_НачисленияБиллинговыхУслугОбороты.Услуга
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_бу_НачисленияБиллинговыхУслугОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет,
	бит_бу_НачисленияБиллинговыхУслугОстаткиИОбороты.Услуга,
	бит_бу_НачисленияБиллинговыхУслугОстаткиИОбороты.СуммаНачальныйОстаток КАК СуммаНачальныйОстаток,
	бит_бу_НачисленияБиллинговыхУслугОстаткиИОбороты.СуммаКонечныйОстаток КАК СуммаКонечныйОстаток
ПОМЕСТИТЬ Остатки
ИЗ
	РегистрНакопления.бит_бу_НачисленияБиллинговыхУслуг.ОстаткиИОбороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, , , Организация = &amp;Организация) КАК бит_бу_НачисленияБиллинговыхУслугОстаткиИОбороты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	ФИОФизЛицСрезПоследних.Фамилия КАК Фамилия,
	ФИОФизЛицСрезПоследних.Имя КАК Имя,
	ФИОФизЛицСрезПоследних.Отчество КАК Отчество
ПОМЕСТИТЬ ОтветсвенныеЛица
ИЗ
	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
			&amp;КонецПериода {(&amp;КонецПериода)},
			ЛицевойСчет В
				(ВЫБРАТЬ РАЗЛИЧНЫЕ
					ПоставщикиИУслуги.ЛицевойСчет
				ИЗ
					ПоставщикиИУслуги)) КАК бит_ПроживающиеПоЛССрезПоследних
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&amp;КонецПериода {(&amp;КонецПериода)}, ) КАК ФИОФизЛицСрезПоследних
		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
ГДЕ
	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица &lt;&gt; ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.ВЫПИСАН)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПоставщикиИУслуги.Поставщик КАК Поставщик,
	ПоставщикиИУслуги.Услуга КАК Услуга,
	СУММА(ВЫБОР
			КОГДА ЕСТЬNULL(Остатки.СуммаНачальныйОстаток, 0) &lt; 0
				ТОГДА -ЕСТЬNULL(Остатки.СуммаНачальныйОстаток, 0)
			ИНАЧЕ 0
		КОНЕЦ) КАК СуммаНачальныйОстатокКт,
	СУММА(ВЫБОР
			КОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0) &lt; 0
				ТОГДА -ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)
			ИНАЧЕ 0
		КОНЕЦ) КАК СуммаКонечныйОстатокКт,
	ПоставщикиИУслуги.ЛицевойСчет КАК ЛицевойСчет,
	СУММА(ВЫБОР
			КОГДА ЕСТЬNULL(Остатки.СуммаНачальныйОстаток, 0) &gt;= 0
				ТОГДА ЕСТЬNULL(Остатки.СуммаНачальныйОстаток, 0)
			ИНАЧЕ 0
		КОНЕЦ) КАК СуммаНачальныйОстатокДт,
	СУММА(ВЫБОР
			КОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0) &gt;= 0
				ТОГДА ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)
			ИНАЧЕ 0
		КОНЕЦ) КАК СуммаКонечныйОстатокДт,
	ПоставщикиИУслуги.Улица,
	ПоставщикиИУслуги.Здание,
	ПоставщикиИУслуги.Район,
	ПоставщикиИУслуги.Участок,
	СУММА(ЕСТЬNULL(Остатки.СуммаНачальныйОстаток, 0)) КАК СуммаНачальныйОстаток,
	СУММА(ЕСТЬNULL(Остатки.СуммаКонечныйОстаток, 0)) КАК СуммаКонечныйОстаток,
	ПоставщикиИУслуги.РежимПотребления,
	ПоставщикиИУслуги.ЛицевойСчет.Квартира КАК Квартира,
	Обороты.Начислено,
	Обороты.Разовые,
	Обороты.Оплата,
	ОтветсвенныеЛица.Фамилия,
	ОтветсвенныеЛица.Имя,
	ОтветсвенныеЛица.Отчество,
	ОтветсвенныеЛица.ФизЛицо,
	ЕСТЬNULL(Обороты.Начислено, 0) + ЕСТЬNULL(Обороты.Разовые, 0) КАК ТекущиеНачисления
ИЗ
	ПоставщикиИУслуги КАК ПоставщикиИУслуги
		ЛЕВОЕ СОЕДИНЕНИЕ Обороты КАК Обороты
		ПО ПоставщикиИУслуги.ЛицевойСчет = Обороты.ЛицевойСчет
			И ПоставщикиИУслуги.Услуга = Обороты.Услуга
		ЛЕВОЕ СОЕДИНЕНИЕ Остатки КАК Остатки
		ПО ПоставщикиИУслуги.ЛицевойСчет = Остатки.ЛицевойСчет
			И ПоставщикиИУслуги.Услуга = Остатки.Услуга
		ЛЕВОЕ СОЕДИНЕНИЕ ОтветсвенныеЛица КАК ОтветсвенныеЛица
		ПО ПоставщикиИУслуги.ЛицевойСчет = ОтветсвенныеЛица.ЛицевойСчет

СГРУППИРОВАТЬ ПО
	ПоставщикиИУслуги.Поставщик,
	ПоставщикиИУслуги.Услуга,
	ПоставщикиИУслуги.ЛицевойСчет,
	ПоставщикиИУслуги.Улица,
	ПоставщикиИУслуги.Здание,
	ПоставщикиИУслуги.Район,
	ПоставщикиИУслуги.Участок,
	ПоставщикиИУслуги.РежимПотребления,
	ПоставщикиИУслуги.ЛицевойСчет.Квартира,
	Обороты.Начислено,
	Обороты.Разовые,
	Обороты.Оплата,
	ОтветсвенныеЛица.Фамилия,
	ОтветсвенныеЛица.Имя,
	ОтветсвенныеЛица.Отчество,
	ОтветсвенныеЛица.ФизЛицо

УПОРЯДОЧИТЬ ПО
	ПоставщикиИУслуги.Услуга.Приоритет
;

