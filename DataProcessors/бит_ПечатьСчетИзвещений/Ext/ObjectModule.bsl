		|	Организации.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Организации КАК Организации
		|ГДЕ
		|	Организации.Ссылка = &ПолучательПлатежа";
	Иначе
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	Контрагенты.НаименованиеПолное КАК НаименованиеПолное,
		|	Контрагенты.Наименование КАК НаименованиеСокращенное,
		|	"""" КАК ВариантНаименованияДляПечатныхФорм,
		|	Контрагенты.ОсновнойБанковскийСчет.НомерСчета КАК ПолучательРС,
		|	Контрагенты.ИНН КАК ПолучательИНН,
		|	Контрагенты.КПП КАК ПолучательКПП,
		|	Контрагенты.ОсновнойБанковскийСчет.Банк.Наименование КАК ПолучательБанк,
		|	Контрагенты.ОсновнойБанковскийСчет.Банк.КоррСчет КАК КоррСчет,
		|	Контрагенты.ОсновнойБанковскийСчет.Банк.Код КАК БИК,
		|	Контрагенты.Ссылка КАК Ссылка
		|ИЗ
		|	Справочник.Контрагенты КАК Контрагенты
		|ГДЕ
		|	Контрагенты.Ссылка = &ПолучательПлатежа";
	КонецЕсли;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		//мКэшПолучателяПлатежа.НаименованиеПолное				= Выборка.НаименованиеПолное;
		//мКэшПолучателяПлатежа.НаименованиеСокращенное			= Выборка.НаименованиеСокращенное;
		Если ТипЗнч(Выборка.Ссылка) =Тип("СправочникСсылка.Организации") Тогда
			НаименованияПолучателяПлатежа = Справочники.Организации.НаименованияНаДату(Выборка.Ссылка, ЭтотОбъект.Период);
		Иначе
			НаименованияПолучателяПлатежа = Справочники.Контрагенты.НаименованияНаДату(Выборка.Ссылка, ЭтотОбъект.Период);
		КонецЕсли;

		мКэшПолучателяПлатежа.НаименованиеПолное				= НаименованияПолучателяПлатежа.ПолноеНаименование;
		мКэшПолучателяПлатежа.НаименованиеСокращенное			= НаименованияПолучателяПлатежа.СокращенноеНаименование;
		мКэшПолучателяПлатежа.ВариантНаименованияДляПечатныхФорм= Выборка.ВариантНаименованияДляПечатныхФорм;
		мКэшПолучателяПлатежа.ПолучательРС						= Выборка.ПолучательРС;
		мКэшПолучателяПлатежа.ПолучательИНН						= Выборка.ПолучательИНН;
		мКэшПолучателяПлатежа.ПолучательКПП						= Выборка.ПолучательКПП;
		мКэшПолучателяПлатежа.ПолучательБанк					= Выборка.ПолучательБанк;
		мКэшПолучателяПлатежа.ПолучательКоррСчет				= Строка(Выборка.КоррСчет);
		мКэшПолучателяПлатежа.ПолучательБИК						= Строка(Выборка.БИК);
		мКэшПолучателяПлатежа.ПолучательКоррСчетБИК				= Строка(Выборка.КоррСчет)+" \ "+Строка(Выборка.БИК);
		
	КонецЕсли;
	
	// Перезаполнение выбранным Расчетным счетом.
	Запрос.УстановитьПараметр("РС", РС);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	БанковскиеСчета.НомерСчета КАК ПолучательРС,
	|	БанковскиеСчета.Банк.Наименование КАК ПолучательБанк,
	|	БанковскиеСчета.Банк.КоррСчет КАК КоррСчет,
	|	БанковскиеСчета.Банк.Код КАК БИК
	|ИЗ
	|	Справочник.БанковскиеСчета КАК БанковскиеСчета
	|ГДЕ
	|	БанковскиеСчета.Владелец = &ПолучательПлатежа
	|	И БанковскиеСчета.Ссылка = &РС";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		мКэшПолучателяПлатежа.ПолучательРС			= Выборка.ПолучательРС;
		мКэшПолучателяПлатежа.ПолучательБанк		= Выборка.ПолучательБанк;
		мКэшПолучателяПлатежа.ПолучательКоррСчет	= Строка(Выборка.КоррСчет);
		мКэшПолучателяПлатежа.ПолучательБИК			= Строка(Выборка.БИК);
		мКэшПолучателяПлатежа.ПолучательКоррСчетБИК	= Строка(Выборка.КоррСчет)+" \ "+Строка(Выборка.БИК);
		
	КонецЕсли;
	
	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") Тогда
		мКэшПолучателяПлатежа.ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации)
	Иначе
		мКэшПолучателяПлатежа.ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента)
	КонецЕсли;
	
КонецПроцедуры	

// Процедура получает настройку макета.
//
// Параметры:
//  Нет.
//
Процедура ПолучитьНастройкуМакета() Экспорт
	
	мНастройкиМакета = Неопределено;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("МакетКвитанции", МакетКв);
	
	Запрос.УстановитьПараметр("Пользователь"  , бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НастройкиПечатиМакетовСчетИзвещений.МакетКвитанции,
	|	бит_НастройкиПечатиМакетовСчетИзвещений.Ссылка КАК Настройка
	|ПОМЕСТИТЬ ПредопределенныеНастройки
	|ИЗ
	|	Справочник.бит_НастройкиПечатиМакетовСчетИзвещений КАК бит_НастройкиПечатиМакетовСчетИзвещений
	|ГДЕ
	|	бит_НастройкиПечатиМакетовСчетИзвещений.Предопределенный
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ТекущиеНастройкиМакетовСчетИзвещений.МакетКвитанции КАК МакетКвитанции,
	|	бит_ТекущиеНастройкиМакетовСчетИзвещений.НастройкаМакета
	|ПОМЕСТИТЬ НастройкиПользователя
	|ИЗ
	|	РегистрСведений.бит_ТекущиеНастройкиМакетовСчетИзвещений КАК бит_ТекущиеНастройкиМакетовСчетИзвещений
	|ГДЕ
	|	бит_ТекущиеНастройкиМакетовСчетИзвещений.Пользователь = &Пользователь
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ВариантыСчетовИзвещений.Ссылка КАК МакетКвитанции,
	|	ВЫБОР
	|		КОГДА НастройкиПользователя.НастройкаМакета ЕСТЬ NULL 
	|			ТОГДА ПредопределенныеНастройки.Настройка
	|		ИНАЧЕ НастройкиПользователя.НастройкаМакета
	|	КОНЕЦ КАК НастройкаМакета,
	|	бит_ВариантыСчетовИзвещений.Наименование КАК Наименование
	|ИЗ
	|	Справочник.бит_ВариантыСчетовИзвещений КАК бит_ВариантыСчетовИзвещений
	|		ЛЕВОЕ СОЕДИНЕНИЕ ПредопределенныеНастройки КАК ПредопределенныеНастройки
	|		ПО (ПредопределенныеНастройки.МакетКвитанции = бит_ВариантыСчетовИзвещений.Ссылка)
	|		ЛЕВОЕ СОЕДИНЕНИЕ НастройкиПользователя КАК НастройкиПользователя
	|		ПО бит_ВариантыСчетовИзвещений.Ссылка = НастройкиПользователя.МакетКвитанции
	|ГДЕ
	|	бит_ВариантыСчетовИзвещений.Ссылка = &МакетКвитанции
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ПредопределенныеНастройки
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ НастройкиПользователя";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		мНастройкиМакета = Выборка.НастройкаМакета;
	КонецЕсли; 
	
	// Стандартные настройки для макетов.
	Если НЕ ЗначениеЗаполнено(мНастройкиМакета) Тогда
		
		мНастройкиМакета = ПолучитьСтандартныеНастройкуМакета(мОсновнойВариантМакета);
		
	КонецЕсли; 
	
КонецПроцедуры

// Процедура получает стандартную настройку макета.
//
Функция ПолучитьСтандартныеНастройкуМакета(ВариантСЧ = Неопределено) Экспорт
	
	НастройкиМакета = Новый Структура;
	
	НастройкиМакета.Вставить("СальдоЗаМесяц"          , Истина);
	НастройкиМакета.Вставить("НачисленияЗаМесяц"      , Истина);
	НастройкиМакета.Вставить("ЛьготаЗаМесяц"          , Истина);
	НастройкиМакета.Вставить("РазовыеЗаМесяц"         , Истина);
	НастройкиМакета.Вставить("ОплатаЗаМесяц"          , Истина);
	
	НастройкиМакета.Вставить("СальдоКОплате"          , Истина);
	
	НастройкиМакета.Вставить("СальдоКОплатеБезУчетаДолга", Ложь);
	
	НастройкиМакета.Вставить("НачисленияКОплате"      , Истина);
	НастройкиМакета.Вставить("ЛьготаКОплате"          , Истина);
	НастройкиМакета.Вставить("РазовыеКОплате"         , Истина);
	НастройкиМакета.Вставить("ОплатаКОплате"          , Истина);
	
	НастройкиМакета.Вставить("ПолеСуммыШК"            ,"ИтогоКОплатеСУчетомПени");
	
	НастройкиМакета.Вставить("ИспользоватьСокращенноеНаименованиеОрганизации", Ложь);
	НастройкиМакета.Вставить("ИспользоватьСокращенноеНаименованиеУслуги"     , Истина);
	
	НастройкиМакета.Вставить("ФормироватьШтрихКод", Истина);
	НастройкиМакета.Вставить("БезОтрывнойЧасти"   , Ложь);
	
	НастройкиМакета.Вставить("СУчетомПереплатыЗаМесяц", Ложь);
	НастройкиМакета.Вставить("СУчетомПереплатыКОплате", Ложь);
	
	НастройкиМакета.Вставить("СальдоВключаетОплату", Ложь);
	
	НастройкиМакета.Вставить("НастройкаСтавки", Перечисления.бит_НастройкиПоляСтавки.ТолькоСтавка);
	
	НастройкиМакета.Вставить("СубсидияПИЗаМесяц"          , Истина);
	НастройкиМакета.Вставить("СубсидияПИКОплате"          , Истина);
	
	// Счет извещения.
	Если ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.СчетИзвещение5 Тогда
		
		НастройкиМакета.СальдоВключаетОплату    = Истина;
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;
		НастройкиМакета.СУчетомПереплатыКОплате = Истина;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.СчетИзвещение3 Тогда
		
		НастройкиМакета.СальдоЗаМесяц           = Ложь;
		НастройкиМакета.ОплатаЗаМесяц           = Ложь;
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.СчетИзвещение4 Тогда
		
		НастройкиМакета.СальдоЗаМесяц           = Ложь;
		НастройкиМакета.ОплатаЗаМесяц           = Ложь;
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;
		
	ИначеЕсли МакетКв = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.СчетИзвещение6 Тогда
		
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.СчетИзвещение7 Тогда
		
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;
		НастройкиМакета.СУчетомПереплатыКОплате = Истина;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.СчетИзвещениеРСК Тогда
		
		НастройкиМакета.СальдоВключаетОплату = Истина;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.СчетИзвещение8 Тогда
		
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;   
		НастройкиМакета.СУчетомПереплатыКОплате = Истина;
		НастройкиМакета.СальдоЗаМесяц           = Ложь;
		НастройкиМакета.ОплатаЗаМесяц           = Ложь;
		
		НастройкиМакета.НастройкаСтавки = Перечисления.бит_НастройкиПоляСтавки.ТарифСтавка;
		
		// Квитанции.
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.КвитанцияСПБ Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
		
		НастройкиМакета.СальдоВключаетОплату    = Истина;
		НастройкиМакета.СальдоЗаМесяц           = Ложь;
		НастройкиМакета.ОплатаЗаМесяц           = Ложь;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.Квитанция Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
		
		НастройкиМакета.СальдоЗаМесяц           = Ложь;
		НастройкиМакета.ОплатаЗаМесяц           = Ложь;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.Квитанция2 Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
		НастройкиМакета.СальдоЗаМесяц     = Ложь;
		НастройкиМакета.ОплатаЗаМесяц     = Ложь;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.Квитанция3 Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
		
		НастройкиМакета.СальдоЗаМесяц           = Ложь;
		НастройкиМакета.ОплатаЗаМесяц           = Ложь;
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.Квитанция4 Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
		НастройкиМакета.СУчетомПереплатыКОплате = Истина;
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;
		НастройкиМакета.СальдоЗаМесяц           = Ложь;
		НастройкиМакета.ОплатаЗаМесяц           = Ложь;
		НастройкиМакета.ПолеСуммыШК             = "ИтогоКОплатеСУчетомПредоплаты";
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.Квитанция5 Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
		НастройкиМакета.СУчетомПереплатыКОплате = Истина;
		НастройкиМакета.СУчетомПереплатыЗаМесяц = Истина;
		НастройкиМакета.СальдоЗаМесяц           = Ложь;
		НастройкиМакета.ОплатаЗаМесяц           = Ложь;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.Квитанция6 Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
		НастройкиМакета.СУчетомПереплатыКОплате  = Истина;
		НастройкиМакета.СУчетомПереплатыЗаМесяц  = Истина;
		НастройкиМакета.СальдоЗаМесяц            = Ложь;
		НастройкиМакета.ОплатаЗаМесяц            = Ложь;
		
		НастройкиМакета.НастройкаСтавки = Перечисления.бит_НастройкиПоляСтавки.ТарифСтавка;
		
		// Платежные документы.
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.ПлатежныйДокумент Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
		НастройкиМакета.СУчетомПереплатыЗаМесяц                        = Истина;
		
		НастройкиМакета.СальдоЗаМесяц     = Ложь;
		НастройкиМакета.ОплатаЗаМесяц     = Ложь;
		
		НастройкиМакета.НастройкаСтавки = Перечисления.бит_НастройкиПоляСтавки.ТарифСтавка;
		
	ИначеЕсли ВариантСЧ = Справочники.бит_НастройкиПечатиМакетовСчетИзвещений.ПлатежныйДокумент1 Тогда
		
		НастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации = Истина;
