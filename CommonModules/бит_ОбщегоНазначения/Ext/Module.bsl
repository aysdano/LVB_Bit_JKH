// Функция получает версию файла посредством использования WMI.
//
// Параметры:
//  ИмяФайла  – Строка.
//  ВыводитьСообщения - Булево.
//
// Возвращаемое значение:
//   ВерсияФайла   – Строка.
//
Функция ПолучитьВерсиюФайла(ИмяФайла,ВыводитьСообщения=Истина) Экспорт
	
	ВерсияФайла = "";
	
	Locator = Неопределено;
	Попытка
		
		Locator = Новый COMОбъект("WbemScripting.SWbemLocator");
		
	Исключение
		
		Если ВыводитьСообщения Тогда
			
			ТекстСообщения = "Не удалось получить версию файла "+ИмяФайла+". Не удалось подключить локатор WMI.";
			СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Важное);
			
		КонецЕсли; 
		
	КонецПопытки; 
	
	Если Locator <> Неопределено Тогда
		
		Попытка
			
			ServicesSet = Locator.ConnectServer(".","root\cimv2");
			
			ТекстЗапроса = "SELECT * FROM CIM_DataFile WHERE NAME = '"+ИмяФайла+"'";
			ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"\","\\");
			
			Items = ServicesSet.ExecQuery(ТекстЗапроса);
			
			// Получение по индексу не определено, поэтому делаем один шаг цикла.
			Для каждого Item Из Items Цикл
				
				ВерсияФайла = Item.Version;
				Прервать;
				
			КонецЦикла; 
			
		Исключение
			
			Если ВыводитьСообщения Тогда
				
				ТекстСообщения = "Не удалось получить версию файла "+ИмяФайла+". Не удалось выполнить запрос WMI.";
				СообщитьОбОшибке(ТекстСообщения,,,СтатусСообщения.Важное);
				
			КонецЕсли; 
			
		КонецПопытки;
		
	КонецЕсли; 
	
	Возврат ВерсияФайла;
	
КонецФункции // ПолучитьВерсиюФайла()

// Функция определяет старше версия обновления или нет. 
// Версия представляет собой строку чисел с разделителем ".".
// Например "1.1.0.256". Сравнение выполняется по-разрядно начиная со старших разрядов. Если количество разрядов не. 
// Совпадает старшей считается версия с большим количеством разрядов.
//
// Параметры:
//  ТекущаяВерсия    – Строка.
//  ВерсияОбновление - Строка.
//
// Возвращаемое значение:
//   флРезультат   – Булево.
//
Функция ВерсияОбновленияСтарше(ТекущаяВерсия,ВерсияОбновления)  Экспорт
	
	флРезультат = Ложь;
	
	МассивТекущаяВерсия      = РазобратьСтрокуСРазделителями(ТекущаяВерсия,".");
	МассивВерсияОбновления   = РазобратьСтрокуСРазделителями(ВерсияОбновления,"."); 
	
	КоличествоТекущаяВерсия    = МассивТекущаяВерсия.Количество();
	КоличествоВерсияОбновления = МассивВерсияОбновления.Количество();
	
	Если КоличествоТекущаяВерсия = КоличествоВерсияОбновления Тогда
		
		ПреобразоватьМассивСтрокВЧисла(МассивТекущаяВерсия);
		ПреобразоватьМассивСтрокВЧисла(МассивВерсияОбновления);
		
		Для Значение = 1 По КоличествоТекущаяВерсия Цикл
			
			Если МассивВерсияОбновления[Значение-1] > МассивТекущаяВерсия[Значение-1] Тогда
				
				флРезультат = Истина;
				Прервать;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	Иначе	
		
		Если КоличествоВерсияОбновления > КоличествоТекущаяВерсия Тогда
			
			флРезультат = Истина;
			
		КонецЕсли; 
		
	КонецЕсли; 
	
	Возврат флРезультат;
	
КонецФункции // ВерсияОбновленияСтарше()

// Функция получает имена папок специального назначения по идентификатору.
// Например, Application Data.
// Ид папок приведены в MSDN.
//
// Параметры:
//  ИдПапки  – Число,Строка.
//  ВыводитьСообщения  – Булево.
//
// Возвращаемое значение:
//   ИмяПапки   – Строка.
//
Функция ПолучитьИмяСпецПапки(ИдПапки,ВыводитьСообщения=Ложь)  Экспорт
	
	ИмяПапки = "";
	
	Попытка
		
		objShell = Новый COMОбъект("Shell.Application");
		objFolder = objShell.Namespace(ИдПапки);
		objFolderItem = objFolder.Self;
		ИмяПапки = objFolderItem.Path;
		
	Исключение
		
		Если ВыводитьСообщения Тогда
			
			СообщитьОбОшибке("Не удалось определить имя папки по ИД """+ИдПапки+"""!",,,СтатусСообщения.Важное);
			
		КонецЕсли; 
		
	КонецПопытки;
	
	Возврат ИмяПапки;
	
КонецФункции // ПолучитьИмяСпецПапки()

// Функция выполняет создание каталога.
//
// Параметры:
//  ИмяКаталога        – Строка.
//  РежимСообщений     – Строка.
//
// Возвращаемое значение:
//   ДействиеВыполнено   – Булево.
//
Функция ВыполнитьСозданиеКаталога(ИмяКаталога,РежимСообщений = "Все")  Экспорт
	
	ДействиеВыполнено = Ложь;
	
	ВыводитьОшибки     = ?(РежимСообщений="Все" ИЛИ РежимСообщений="Ошибки",Истина,Ложь);
	ВыводитьИнформацию = ?(РежимСообщений="Все",Истина,Ложь);
	
	Попытка
		
		СоздатьКаталог(ИмяКаталога);
		ДействиеВыполнено = Истина;
		
		Если ВыводитьИнформацию Тогда
			
			СообщитьОбОшибке("Создан каталог """+ИмяКаталога+"""",,,СтатусСообщения.Информация);
			
		КонецЕсли; 
		
	Исключение
		
		Если ВыводитьОшибки Тогда
			
			СообщитьОбОшибке("Не удалось создать каталог """+ИмяКаталога+"""!",,,СтатусСообщения.Важное);
			
		КонецЕсли; 
		
	КонецПопытки;	
	
	Возврат ДействиеВыполнено;
	
КонецФункции // СоздатьПапку()

// Функция разбирает строку с разделителями и упаковывает значения в массив.
//
// Параметры:
//  ИсходнаяСтрока  – Строка.
//  Разделитель     - Строка.
//
Функция РазобратьСтрокуСРазделителями(ИсходнаяСтрока,Разделитель) Экспорт
	
	РезМассив = Новый Массив;
	
	Стр = ИсходнаяСтрока;
	КоличествоРазделителей = СтрЧислоВхождений(Стр,Разделитель);
	Для Значение = 1 По КоличествоРазделителей+1 Цикл
		
		ПозицияРазделителя = Найти(Стр,Разделитель);
		Если ПозицияРазделителя >0 Тогда
			ТекущееИмя = Лев(Стр,ПозицияРазделителя-1);
			Стр = Сред(Стр,ПозицияРазделителя+1);
		Иначе
			ТекущееИмя = СокрЛП(Стр);
		КонецЕсли; 
		РезМассив.Добавить(ТекущееИмя);
		
	КонецЦикла;
	
	Возврат РезМассив;
	
КонецФункции //РазобратьСтрокуСРазделителями()

// Процедура преобразовывает массив строк в массив чисел. 
// В случае невозможности преобразования элемента, элементу присваивается -1.
//
// Параметры:
//  МассивСтрок  – Массив.
//
Процедура ПреобразоватьМассивСтрокВЧисла(МассивСтрок)
	
	Для Значение = 1 По МассивСтрок.Количество() Цикл
		
		Попытка
			
			МассивСтрок[Значение-1] = Число(МассивСтрок[Значение-1]);
			
		Исключение
			
			МассивСтрок[Значение-1] = -1;
			
		КонецПопытки;
		
	КонецЦикла; 
	
КонецПроцедуры //ПреобразоватьМассивСтрокВЧисла()

// Функция добавляет новую строку к строке. 
// Если исходная строка не пуста, вставляется разделитель.
//
// Параметры:
//  ИсходнаяСтрока    - Строка.
//  СтрокаДополнение  - Строка.
//  Разделитель       - Строка.
//
// ВозвращаемоеЗначение:
//  РезСтрока - Строка.
//
Функция ДобавитьСтрокуСРазделителем(ИсходнаяСтрока,СтрокаДополнение,Разделитель="") Экспорт
	
	РезСтрока = ИсходнаяСтрока+?(ПустаяСтрока(ИсходнаяСтрока),"",Разделитель)+СтрокаДополнение;
	
	Возврат РезСтрока;
	
КонецФункции // ДобавитьСтрокуСРазделителем()

