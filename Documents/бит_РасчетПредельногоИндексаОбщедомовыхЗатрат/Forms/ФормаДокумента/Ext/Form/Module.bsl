
#Область ПроцедурыИФункцииОбщегоНазначения

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции // ПолучитьТипОбъекта()

&НаСервере
Процедура ВызватьРасчет()
	
	ОтказОтРасчета = Ложь;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	бит_СведенияОРазмереПредельногоИндексаПоГруппеУслугСрезПоследних.ПериодСравнения
	|ИЗ
	|	РегистрСведений.бит_СведенияОРазмереПредельногоИндексаПоГруппеУслуг.СрезПоследних(
	|			&Момент,
	|			Организация = &Организация
	|				И Начислять = ИСТИНА) КАК бит_СведенияОРазмереПредельногоИндексаПоГруппеУслугСрезПоследних");
	
	Запрос.УстановитьПараметр("Момент",      Объект.Дата);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Количество() = 0 Тогда
		
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Перед проведением расчета заполните, пожалуйста, регистр сведений ""Сведения о размере предельного индекса по группе услуг""" + Символы.ПС +
		                  "для " + Строка(Объект.Организация) + " на дату равную или ранее " +Строка(Объект.Дата);
		Сообщение.Сообщить();
		
		ОтказОтРасчета = Истина;
		
	КонецЕсли;
	
	Если Не ОтказОтРасчета Тогда
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
		
		ДокументОбъект.ВыполнитьРасчет();
		
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

