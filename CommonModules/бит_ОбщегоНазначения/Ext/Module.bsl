				РаспределитьСуммуПоПени(КоммунальныеУслуги, СуммаДокумента,СуммаДляРаспределения,НачислятьПениСУчетомПереплаты,ИтогОплата);
			Иначе 
				НетПени = Истина
			КонецЕсли;
			
			
			//Доначисление Суммы по Сальдо (остатки для закрытия Сальдо).
			ИтогСумма = КоммунальныеУслуги.Итог("Сумма");
			ИтогоОстаток = ИтогСальдо - ИтогСумма;
			Если СуммаДляРаспределения > 0 И ИтогоОстаток > 0 Тогда
				
				БазоваяСумма = СуммаДляРаспределения;
				Для Каждого ТекСтрока Из КоммунальныеУслуги Цикл
					
					Остаток = ?(ТекСтрока.Сальдо - ТекСтрока.Сумма > 0
					,Мин((ТекСтрока.Сальдо - ТекСтрока.Сумма)*БазоваяСумма/ИтогоОстаток, ТекСтрока.Сальдо - ТекСтрока.Сумма)
					,0);
					
					ТекСтрока.Сумма = ТекСтрока.Сумма + Остаток;
					СуммаДляРаспределения = СуммаДляРаспределения - Остаток;
