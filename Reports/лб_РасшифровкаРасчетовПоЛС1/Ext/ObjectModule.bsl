Функция СуммыДляОтчета(ЛС,ЗависимыеЛС,Дата1,Дата2)
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("СписокЛС",ЗависимыеЛС);
	Запрос.УстановитьПараметр("ЛС",ЛС);
	Запрос.УстановитьПараметр("Дата1",Дата1);
	Запрос.УстановитьПараметр("Дата2",КонецДня(Дата2));
	Запрос.УстановитьПараметр("ВозвратОплаты",Перечисления.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратОплаты);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	ВложенныйЗапрос.Месяц КАК Месяц,
		|	ВложенныйЗапрос.УслугаЖКХ КАК УслугаЖКХ,
		|	СУММА(ВложенныйЗапрос.СуммаНМООО) КАК СуммаНМООО,
		|	СУММА(ВложенныйЗапрос.СуммаНМ) КАК СуммаНМ,
		|	СУММА(ВложенныйЗапрос.СуммаКМ) КАК СуммаКМ,
		|	СУММА(ВложенныйЗапрос.СуммаНач) КАК СуммаНач,
		|	СУММА(ВложенныйЗапрос.СуммаИзм) КАК СуммаИзм,
		|	СУММА(ВложенныйЗапрос.СуммаОпл) КАК СуммаОпл
		|ИЗ
		|	(ВЫБРАТЬ
		|		НАЧАЛОПЕРИОДА(СуммыОстООО.Период, МЕСЯЦ) КАК Месяц,
		|		СуммыОстООО.УслугаЖКХ КАК УслугаЖКХ,
		|		СуммыОстООО.СуммаНачальныйОстаток КАК СуммаНМООО,
		|		0 КАК СуммаНМ,
		|		0 КАК СуммаКМ,
		|		0 КАК СуммаНач,
		|		0 КАК СуммаИзм,
		|		0 КАК СуммаОпл
		|	ИЗ
		|		РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&Дата1, &Дата2, Месяц, , ЛицевойСчет В (&СписокЛС)) КАК СуммыОстООО
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		НАЧАЛОПЕРИОДА(СуммыОст.Период, МЕСЯЦ),
		|		СуммыОст.УслугаЖКХ,
		|		0,
		|		СуммыОст.СуммаНачальныйОстаток,
		|		СуммыОст.СуммаКонечныйОстаток,
		|		0,
		|		0,
		|		0
		|	ИЗ
		|		РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&Дата1, &Дата2, Месяц, , ЛицевойСчет В (&ЛС)) КАК СуммыОст
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		СуммыНач.Месяц,
		|		СуммыНач.УслугаЖКХ,
		|		0,
		|		0,
		|		0,
		|		СуммыНач.Нач,
		|		0,
		|		0
		|	ИЗ
		|		(ВЫБРАТЬ
		|			НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК Месяц,
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ,
		|			бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот КАК Нач
		|		ИЗ
		|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&Дата1, &Дата2, Регистратор, ЛицевойСчет В (&ЛС)) КАК бит_НачисленияПоУслугамЖКХОбороты
		|		ГДЕ
		|			бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ),
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
		|			бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|		ИЗ
		|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&Дата1, &Дата2, Регистратор, ЛицевойСчет В (&ЛС)) КАК бит_НачисленияПоУслугамЖКХОбороты
		|		ГДЕ
		|			бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
		|		
		|		ОБЪЕДИНИТЬ ВСЕ
		|		
		|		ВЫБРАТЬ
		|			НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ),
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
		|			бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|		ИЗ
		|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&Дата1, &Дата2, Регистратор, ЛицевойСчет В (&ЛС)) КАК бит_НачисленияПоУслугамЖКХОбороты
		|		ГДЕ
		|			бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными) КАК СуммыНач
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		СуммыИзм.Месяц,
		|		СуммыИзм.УслугаЖКХ,
		|		0,
		|		0,
		|		0,
		|		0,
		|		ВЫБОР
		|			КОГДА СуммыИзм.ЭтоОплата
		|				ТОГДА 0
		|			ИНАЧЕ СуммыИзм.Сумма
		|		КОНЕЦ,
		|		ВЫБОР
		|			КОГДА СуммыИзм.ЭтоОплата
		|				ТОГДА -СуммыИзм.Сумма
		|			ИНАЧЕ 0
		|		КОНЕЦ
		|	ИЗ
		|		(ВЫБРАТЬ
		|			НАЧАЛОПЕРИОДА(бит_НачисленияПоУслугамЖКХОбороты.Период, МЕСЯЦ) КАК Месяц,
		|			бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ,
		|			бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот КАК Сумма,
		|			ВЫБОР
		|				КОГДА ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХОбороты.Регистратор КАК Документ.бит_РазовыеПоУслугамЖКХ).ВидОперации = &ВозвратОплаты
		|					ТОГДА ИСТИНА
		|				ИНАЧЕ ЛОЖЬ
		|			КОНЕЦ КАК ЭтоОплата
		|		ИЗ
		|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&Дата1, &Дата2, Регистратор, ЛицевойСчет В (&ЛС)) КАК бит_НачисленияПоУслугамЖКХОбороты
		|		ГДЕ
		|			бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ) КАК СуммыИзм
		|	
		|	ОБЪЕДИНИТЬ ВСЕ
		|	
		|	ВЫБРАТЬ
		|		НАЧАЛОПЕРИОДА(СуммыОпл.Период, МЕСЯЦ),
		|		СуммыОпл.УслугаЖКХ,
		|		0,
		|		0,
		|		0,
		|		0,
		|		0,
		|		-СуммыОпл.СуммаОборот
		|	ИЗ
		|		РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&Дата1, &Дата2, Регистратор, ЛицевойСчет В (&ЛС)) КАК СуммыОпл
		|	ГДЕ
		|		СуммыОпл.Регистратор ССЫЛКА Документ.бит_ОплатаКУ) КАК ВложенныйЗапрос
		|
		|СГРУППИРОВАТЬ ПО
		|	ВложенныйЗапрос.УслугаЖКХ,
		|	ВложенныйЗапрос.Месяц";
	
	Табл = Запрос.Выполнить().Выгрузить();
	Табл.Индексы.Добавить("Месяц,УслугаЖКХ");
	
	
