&НаСервере
Процедура тест2_ДополнитьЗагруженныеДанныеЖильцовНаСервере()
	// Вставить содержимое обработчика.
	ТестЖильцыПодобратьЛСНаСервере();
	ТестЖильцыПодобратьЖильцовНаСервере();
	//ТестЖильцыУбратьДругиеЛСНаСервере();
	
	НаборЛС = РегистрыСведений.лб_Тест_ЛС.СоздатьНаборЗаписей();
	НаборЛС.Прочитать();
	ТаблЛС = НаборЛС.Выгрузить(,"ЛС,Ответственный");
	ТаблЛС.Индексы.Добавить("ЛС");
	
	Набор = РегистрыСведений.лб_Тест_Жильцы.СоздатьНаборЗаписей();
	Набор.Отбор.Месяц.Значение = НачалоМесяца(Объект.Дата);
	Набор.Отбор.Месяц.Видсравнения = ВидСравнения.Равно;
	Набор.Отбор.Месяц.ИСпользование = истина;
	Набор.Прочитать();
	Для каждого Запись из Набор цикл
		Запись.ДатаПрописки = ДатаИзСтроки(Запись.D_PR);
		Запись.ДатаВыписки = ДатаИзСтроки(Запись.D_V);
		Запись.СтепеньРодства  = РодственныеОтношения(Запись.RODOTN);				
		Запись.ОписаниеРодства = сокрЛП(Запись.RO);
		СтрокаЛС = ТаблЛС.Найти(Запись.ЛС);
		Если СтрокаЛС<>Неопределено и Запись.Жилец=СтрокаЛС.Ответственный тогда
			Запись.ЭтоОтветственный = истина;			
		КонецЕсли;		
	КонецЦикла;	
	Набор.Записать(истина);
	
	

КонецПроцедуры


