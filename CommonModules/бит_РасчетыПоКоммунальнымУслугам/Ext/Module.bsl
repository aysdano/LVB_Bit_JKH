	|					ТОГДА ЕСТЬNULL(ТаблицаНорм.ЖилаяПлощадь, 0)
	|				ИНАЧЕ ВЫБОР
	|						КОГДА ПоказанийСчетчиков.СпособРасчетаУменьшения = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади)
	|							ТОГДА ЕСТЬNULL(ТаблицаНорм.ОтапливаемаяПлощадь, 0)
	|						ИНАЧЕ ВЫБОР
	|								КОГДА ПоказанийСчетчиков.СпособРасчетаУменьшения = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоПроживающим)
	|									ТОГДА ЕСТЬNULL(ТаблицаНорм.КолПроживающих, 0)
	|								ИНАЧЕ ВЫБОР
	|										КОГДА ПоказанийСчетчиков.СпособРасчетаУменьшения = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления)
	|											ТОГДА ЕСТЬNULL(ТаблицаНорм.КоличествоЕдиницПотребления, 0)
	|										ИНАЧЕ ВЫБОР
	|												КОГДА ПоказанийСчетчиков.СпособРасчетаУменьшения = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет)
	|													ТОГДА ЕСТЬNULL(ТаблицаНорм.НаЛицевойСчет, 0)
	|												ИНАЧЕ 0
	|											КОНЕЦ
	|									КОНЕЦ
	|							КОНЕЦ
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК ФактОтУменьшения,
	|	ВЫБОР
	|		КОГДА ТаблицаНорм.СпособРасчета = ПоказанийСчетчиков.СпособРасчетаУменьшения
	|			ТОГДА ЕСТЬNULL(НачисленияНорм.НачисленоНорма, 0) + ЕСТЬNULL(НачисленияСчетчиков.НачисленоСчетчик, 0) + ВЫБОР
	|					КОГДА &УчитыватьНачисленияПоГрупповымСчетчикам
	|						ТОГДА ЕСТЬNULL(НачисленияСчетчиков.НачисленоГрупСчетчик, 0)
	|					ИНАЧЕ 0
	|				КОНЕЦ
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК НачисленияПоСпособуУменьшения,
	|	ЕСТЬNULL(НачисленияНорм.Разовые, 0) КАК Разовые
	|ИЗ
	|	ПоказанийСчетчиков КАК ПоказанийСчетчиков
	|		ЛЕВОЕ СОЕДИНЕНИЕ НачисленияСчетчиков КАК НачисленияСчетчиков
	|		ПО ПоказанийСчетчиков.ЛицевойСчет = НачисленияСчетчиков.ЛицевойСчет
	|			И ПоказанийСчетчиков.Услуга = НачисленияСчетчиков.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ НачисленияНорм КАК НачисленияНорм
	|		ПО ПоказанийСчетчиков.ЛицевойСчет = НачисленияНорм.ЛицевойСчет
	|			И ПоказанийСчетчиков.Услуга = НачисленияНорм.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаНорм КАК ТаблицаНорм
	|		ПО ПоказанийСчетчиков.Услуга = ТаблицаНорм.Услуга
	|			И ПоказанийСчетчиков.ЛицевойСчет = ТаблицаНорм.ЛицевойСчет
	// БИТ_ЖКХ 03.08.2017 17:19:11 Начало правки...
	|		ЛЕВОЕ СОЕДИНЕНИЕ СведенияПоУслугам КАК СведенияПоУслугам
	|		ПО ПоказанийСчетчиков.ЛицевойСчет = СведенияПоУслугам.ЛицевойСчет
	|			И ПоказанийСчетчиков.Услуга = СведенияПоУслугам.Услуга
	// БИТ_ЖКХ 03.08.2017 17:19:12 Конец правки. 
	|ГДЕ
	|	ПоказанийСчетчиков.СчетчикСЗависимымиУслугами
	|
	|УПОРЯДОЧИТЬ ПО
	|	ОсновнаяУслуга,
	|	НаименованиеЛС
	|ИТОГИ
	|	МАКСИМУМ(ОтПоказаний),
	|	МАКСИМУМ(ДоПоказаний),
	|	МАКСИМУМ(КоличествоЕдиниц),
	|	СУММА(НачисленоНорма),
	|	СУММА(НачисленоСчетчик),
	|	МАКСИМУМ(СуммаПоСчетчику),
	|	СУММА(Факт),
	|	СУММА(ФактСУчетомСтавки),
	// БИТ_ЖКХ 11.05.2016 11:14:33 Начало правки... 
	|	СУММА(ФактСУчетомСтавкиОДН),
	// БИТ_ЖКХ 11.05.2016 11:14:34 Конец правки. 
	|	СУММА(СуммаНачислений),
	|	СУММА(ОбщиеНачисления),
	|	СУММА(НачисленоГрупСчетчик),
	|	МАКСИМУМ(ОсновнаяУслуга),
	|	МАКСИМУМ(ИспользоватьПравилоУменьшения),
	|	СУММА(ФактОтУменьшения),
	|	СУММА(НачисленияПоСпособуУменьшения),
	|	СУММА(Разовые)
	|ПО
	|	Счетчик,
	|	Услуга";
	
	Результат = Запрос.Выполнить();
	
	ВыборкаСЧ = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаСч.Следующий() Цикл
		
		СуммаНачислени = ВыборкаСч.НачисленоНорма + ВыборкаСч.НачисленоСчетчик;
		
		ВыборкаУС = ВыборкаСЧ.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаУС.Следующий() Цикл
			
			Если НЕ ВыборкаУС.ОсновнаяУслуга ИЛИ ВыборкаУС.СуммаПоСчетчику = 0 Тогда
				Продолжить;
			КонецЕсли;
			
			СуммаИтог = 0;
			ОбъемИтог = 0;
			СуммаНО   = 0;
			
			// Индекс строки содержащей максимальную сумму используется для определения погрешнисти.
			Индкес      = Неопределено;
			
			// БИТ_ЖКХ 06.10.2014
			СЧНачисленоСчетчик     = ВыборкаУС.НачисленоСчетчик;
			// БИТ_ЖКХ 06.10.2014
			
			ОбщийФакт              = ВыборкаУС.Факт;
			ОбщиеНачисления        = ВыборкаУС.СуммаНачислений;
			ОбщийФактОтУменьшения  = ВыборкаУС.ФактОтУменьшения;
			// БИТ_ЖКХ_01082013_начало_изменения
			ОбщийФактСУчетомСтавки = ВыборкаУС.ФактСУчетомСтавки;
			// БИТ_ЖКХ_01082013_окончание_изменения
			
			ИспользоватьПравилоУменьшения = ВыборкаСч.ИспользоватьПравилоУменьшения; 
			
			СЧНачисленоУменьшения  = ВыборкаУС.НачисленияПоСпособуУменьшения; 
			СуммаПоНормативуРасч   = ВыборкаУС.НачисленоНорма;
			СуммаПоИндСчетчкамРасч = ВыборкаУС.НачисленоСчетчик;
			
			Остаток = ВыборкаУС.СуммаПоСчетчику - СуммаНачислени;
			
			Выборка = ВыборкаУС.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				// Набор показателей по лс.
				СуммаНорматив     = Выборка.НачисленоНорма;
				СуммаСчетчик      = Выборка.НачисленоСчетчик;
				СуммаНачислений   = Выборка.СуммаНачислений;
				СуммаУменьшения   = Выборка.НачисленияПоСпособуУменьшения;
				Факт              = Выборка.Факт;
				ФактОтУменьшения  = Выборка.ФактОтУменьшения;
				// БИТ_ЖКХ_01082013_начало_изменения
				ФактСУчетомСтавки = Выборка.ФактСУчетомСтавки;
				// БИТ_ЖКХ_01082013_окончание_изменения
				
				Показатель      = 0;
				ОбщийПоказатель = 0;
				
				СпособРаспределения =  Выборка.СпособРаспределения;
				
				Если ИспользоватьПравилоУменьшения И Остаток < 0 Тогда
					
					Если ЗначениеЗаполнено(Выборка.СпособРаспределенияУменьшения) Тогда
						СпособРаспределения = Выборка.СпособРаспределенияУменьшения;
					Иначе
						СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаНачисления;
					КонецЕсли; 
					
				КонецЕсли;
				
				Если СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаНачисления Тогда
					
					// Начисления отрицательного отстатка по правилу уменьшения.
					// Репределние ведется на начисления по установленному способу расчета уменьшения.
					Показатель      = СуммаУменьшения;
					ОбщийПоказатель = СЧНачисленоУменьшения;
					
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаФакт Тогда
					
					// Начисления отрицательного отстатка по правилу уменьшения.
					// Репределние ведется на факт по установленному способу расчета уменьшения.
					Показатель      = ФактОтУменьшения;
					ОбщийПоказатель = ОбщийФактОтУменьшения;
					
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоНормативам Тогда
					
					// БИТ_ЖКХ 24.06.2015{{
					//Показатель      = СуммаНорматив;
					Если СуммаНорматив < 0 Тогда
						Показатель      = 0;
					Иначе
						Показатель      = СуммаНорматив;
					КонецЕсли;
					// БИТ_ЖКХ 24.06.2015}}
					
					ОбщийПоказатель = СЧНачисленоНорма;
					
				ИначеЕсли  СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоСчетчикам Тогда
					
					Показатель      = СуммаСчетчик;
					ОбщийПоказатель = СЧНачисленоСчетчик;
					
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоОсновномуСпособуРасчета Тогда
					
					Показатель      = Факт;
					ОбщийПоказатель = ОбщийФакт;
					
					// БИТ_ЖКХ_01082013_начало_изменения
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоОсновномуСпособуРасчетаС_УчетомСтавки Тогда
					
					Показатель      = ФактСУчетомСтавки;
					ОбщийПоказатель = ОбщийФактСУчетомСтавки;
					// БИТ_ЖКХ_01082013_окончание_изменения
					
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоНачислениям Тогда
					
					Показатель      = СуммаНачислений;
					ОбщийПоказатель = ОбщиеНачисления;
					
				КонецЕсли;
				
				Отбор = Новый Структура;
				Отбор.Вставить("ЛицевойСчет", Выборка.ЛицевойСчет);
				Отбор.Вставить("Услуга"     , Выборка.Услуга);
				
				ПоискСтроки = ТаблицаРасчетов.НайтиСтроки(Отбор);
				
				СтрокаРасчета = Неопределено;
				
				Если ПоискСтроки.Количество() = 0 Тогда
					СтрокаРасчета = ТаблицаРасчетов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчета, Выборка);
				Иначе
					СтрокаРасчета = ПоискСтроки[0];
				КонецЕсли;
				
				НоваяСтрока = ВыполнитьРасчетПоСтроке(ТаблицаОбщедомовыеНачисления, Выборка, Остаток, Показатель, ОбщийПоказатель, СтрокаРасчета);
				
				Если НЕ НоваяСтрока = Неопределено Тогда
					
					Сумма     = НоваяСтрока.Начислено;
					СуммаИтог = СуммаИтог + НоваяСтрока.Начислено;
					СуммаНО   = СуммаНО   + НоваяСтрока.НераспределенныйОстаток;
					
					Если Индкес = Неопределено Тогда
						Индкес = ТаблицаОбщедомовыеНачисления.Индекс(НоваяСтрока);
					Иначе
						
						СтрокаПоИндексу = ТаблицаОбщедомовыеНачисления.Получить(Индкес);
						
						Если Остаток > 0 Тогда
							Индкес      = ?(СтрокаПоИндексу.Начислено < Сумма И НЕ Сумма = 0, ТаблицаОбщедомовыеНачисления.Индекс(НоваяСтрока), Индкес);
						Иначе
							Индкес      = ?(СтрокаПоИндексу.Начислено > Сумма И НЕ Сумма = 0, ТаблицаОбщедомовыеНачисления.Индекс(НоваяСтрока), Индкес);
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЦикла;
			
			Погрешность = Остаток - СуммаИтог - СуммаНО;
			
			Если Погрешность <> 0 И
				НЕ СтрокаПоИндексу = Неопределено И 
				НЕ Индкес = Неопределено Тогда
				
				СтрокаПоИндексу = ТаблицаОбщедомовыеНачисления.Получить(Индкес);
				
				Если Остаток < 0 И НЕ СуммаНО = 0 Тогда
					СтрокаПоИндексу.НераспределенныйОстаток = СтрокаПоИндексу.НераспределенныйОстаток + Погрешность;
					
					Отбор = Новый Структура;
					Отбор.Вставить("ЛицевойСчет", СтрокаПоИндексу.ЛицевойСчет);
					Отбор.Вставить("Услуга"     , СтрокаПоИндексу.Услуга);
					
					ПоискСтроки = ТаблицаРасчетов.НайтиСтроки(Отбор);
					
					Если ПоискСтроки.Количество() > 0 Тогда
						СтрокаРасчета = ПоискСтроки[0];
						СтрокаРасчета.НераспределенныйОстаток = СтрокаРасчета.НераспределенныйОстаток + Погрешность;
					КонецЕсли;
					
				Иначе
					
					СтрокаПоИндексу.Начислено            = СтрокаПоИндексу.Начислено + Погрешность;
					СтрокаПоИндексу.КоличествоЕдиницПоЛС = ОКР(?(СтрокаПоИндексу.Тариф = 0, 0 ,СтрокаПоИндексу.Начислено/СтрокаПоИндексу.Тариф),4);
					
					Отбор = Новый Структура;
					Отбор.Вставить("ЛицевойСчет", СтрокаПоИндексу.ЛицевойСчет);
					Отбор.Вставить("Услуга"     , СтрокаПоИндексу.Услуга);
					
					ПоискСтроки = ТаблицаРасчетов.НайтиСтроки(Отбор);
					
					Если ПоискСтроки.Количество() > 0 Тогда
						СтрокаРасчета = ПоискСтроки[0];
						СтрокаРасчета.СуммаНачислений = СтрокаРасчета.СуммаНачислений + Погрешность;
					КонецЕсли; 
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла; 
	
	МВТ.Закрыть();
	
	// БИТ_ЖКХ 11.05.2016 16:20:16 Начало правки... Окончательный расчет Нераспределенного остатка с учетом ОДН
	Для Каждого Стр Из ТаблицаОбщедомовыеНачисления Цикл
		Если Стр.Начислено > 0 
			И Стр.НачислениеПоНормативуОДН > 0
			И Стр.Начислено > Стр.НачислениеПоНормативуОДН Тогда
			Стр.НераспределенныйОстаток = Стр.Начислено - Стр.НачислениеПоНормативуОДН;
			Стр.Начислено = Стр.НачислениеПоНормативуОДН;
		КонецЕсли;
	КонецЦикла; 
	// БИТ_ЖКХ 11.05.2016 16:20:16 Конец правки.
	
КонецПроцедуры

#КонецОбласти

#Область ФункцииФормированияТаблицЗначений

