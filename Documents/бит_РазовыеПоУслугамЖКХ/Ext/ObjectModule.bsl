Процедура РассчитатьОбъем(ТаблицаСбора)
	
	ТабЛицевыеСчета    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуНачислений();
	
	ТаблицаПроживающих = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуПроживающих();
	ТабНачисления    = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуСчетчиков();
	ТабРаспределения = бит_РасчетыПоКоммунальнымУслугам.СформироватьТаблицуРаспредилений();
	
	ОбновитьПараметрыЖКХ();
	
	СписокЛ     = Новый Массив;
	
	Если ЛицевойСчет = ПредопределенноеЗначение("Справочник.бит_ЛицевыеСчета.ПустаяСсылка") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое")		
		// БИТ ЖКХ 09.03.2020
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды")
		Тогда
		
		Для каждого СтрокаЛС из ТаблицаСбора Цикл
			
			СписокЛ.Добавить(СтрокаЛС.ЛицевойСчет);
			
		КонецЦикла;
	Иначе
		
		СписокЛ.Добавить(ЛицевойСчет);
		
	КонецЕсли;
	
	СписокЗданий = Новый Массив;
	
	Для каждого СтрокаЗ из СписокЛ Цикл
		
		СписокЗданий.Добавить(СтрокаЗ.Здание);
		
	КонецЦикла;
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчика") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчику") Тогда
		
		бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(КонПериода, 
		Организация, 
		СписокЛ, 
		СписокЗданий, 
		, 
		, 
		, 
		ТабНачисления,
		ТабРаспределения,
		,
		,
		,
		мУчетДнейПроживания,
		,
		,
		,
		,
		мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика,
		мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика);
		
	Иначе
		
		бит_РасчетыПоКоммунальнымУслугам.ВыполнитьНачисления(КонПериода, Организация, СписокЛ, , , , ТабЛицевыеСчета,,,,,,,,,,,,,Истина);
		
	КонецЕсли;
	
	Массив = Новый Массив;
	
	ТаблицаСбора.Сортировать("Услуга Убыв");
	ТабНачисления.Сортировать("Услуга Убыв");
	ТабЛицевыеСчета.Сортировать("Услуга Убыв");
	
	Если ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчика") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчику") Тогда
		
		Для каждого СтрокаСбора из СписокУслуг Цикл
			
			Для каждого Строка из ТабНачисления Цикл
				
				Если СтрокаСбора.Услуга = Строка.Услуга Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						Для каждого СтрокаУслуг из СписокУслуг Цикл
							
							Если СтрокаУслуг.Услуга = Строка.Услуга Тогда
								
								Если НЕ СтрокаУслуг.Сумма = 0 Тогда
									СтрокаСбора.Объем = СтрокаУслуг.Сумма/Строка.Тариф;
								КонецЕсли; 
								
							КонецЕсли; 
							
						КонецЦикла;
						
					КонецЕсли; 
					
				КонецЕсли; 
			КонецЦикла;
			
			Попытка 	
				Массив.Добавить(СтрокаСбора.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаСчетчиковГрупповое") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоСчетчикамГрупповое") Тогда
		
		Для каждого СтрокаСбора из СписокУслуг Цикл
			
			Для каждого Строка из ТабНачисления Цикл
				
				Если СтрокаСбора.Услуга = Строка.Услуга Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						Для каждого СтрокаУслуг из СписокУслуг Цикл
							
							Если СтрокаУслуг.Услуга = Строка.Услуга Тогда
								
								Если НЕ СтрокаУслуг.Сумма = 0 Тогда
									СтрокаСбора.Объем = СтрокаУслуг.Сумма/Строка.Тариф;
								КонецЕсли;
								
							КонецЕсли; 
							
						КонецЦикла;
						
					КонецЕсли; 
					
				КонецЕсли; 
			КонецЦикла;
			
			Попытка 	
				Массив.Добавить(СтрокаСбора.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслугиГрупповое") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповое") 
		// БИТ ЖКХ 10.03.2020
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеГрупповоеЗаПрошлыеПериоды")		
		Тогда
		
		// Корректирован код для увеличения быстродейтвия.
		Для каждого СтрокаУслуга из СписокУслуг Цикл
			
			Для каждого Строка из ТабЛицевыеСчета Цикл
				
				Если СтрокаУслуга.Услуга = Строка.Услуга и СтрокаУслуга.ЛицевойСчет = Строка.ЛицевойСчет Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						Если НЕ СтрокаУслуга.Сумма = 0 Тогда
							
							СтрокаУслуга.Объем = СтрокаУслуга.Сумма/Строка.Тариф;
							
						КонецЕсли;
						
					КонецЕсли; 
					
				КонецЕсли; 
			КонецЦикла;
			
			Попытка 	
				// БИТ ЖКХ 11.03.2020
				// Массив.Добавить(СтрокаСбора.Объем);
				Массив.Добавить(СтрокаУслуга.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		
	ИначеЕсли ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.НедопоставкаУслуги") 
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслуге")
		// БИТ ЖКХ 10.03.2020
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначисленияПоУслугеЗаПрошлыеПериоды")		
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ВозвратПоОтсутствующим")
		ИЛИ ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ДоначислениеПоВременноПроживающим")
		Тогда
		
		Для каждого СтрокаУслуга из СписокУслуг Цикл
			
			Для каждого Строка из ТабЛицевыеСчета Цикл
				
				Если СтрокаУслуга.Услуга = Строка.Услуга и ЛицевойСчет = Строка.ЛицевойСчет Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						Если НЕ СтрокаУслуга.Сумма = 0 Тогда
							
							СтрокаУслуга.Объем = СтрокаУслуга.Сумма/Строка.Тариф;
							
						КонецЕсли;
						
					КонецЕсли; 
					
				КонецЕсли; 
			КонецЦикла;
			
			Попытка
				// БИТ ЖКХ 11.03.2020
				//Массив.Добавить(СтрокаСбора.Объем);
				Массив.Добавить(СтрокаУслуга.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;

		СписокУслуг.ЗагрузитьКолонку(Массив,"Объем");
	Иначе
		
		// Корректирован код для увеличения быстродейтвия.
		Для каждого СтрокаУслуга из СписокУслуг Цикл
			
			Для каждого Строка из ТабЛицевыеСчета Цикл
				
				Если СтрокаУслуга.Услуга = Строка.Услуга и СтрокаУслуга.ЛицевойСчет = Строка.ЛицевойСчет Тогда  
					
					Если НЕ Строка.Тариф = 0 Тогда
						
						Если НЕ СтрокаУслуга.Сумма = 0 Тогда
							
							СтрокаУслуга.Объем = СтрокаУслуга.Сумма/Строка.Тариф;
							
						КонецЕсли;
						
					КонецЕсли; 
					
				КонецЕсли; 
			КонецЦикла;
			
			Попытка 	
				Массив.Добавить(СтрокаСбора.Объем);
			Исключение
				
			КонецПопытки;
			
		КонецЦикла;
		СписокУслуг.ЗагрузитьКолонку(Массив,"Объем");
	КонецЕсли;
	
КонецПроцедуры	

Процедура ОбновитьПараметрыЖКХ() Экспорт
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("РасчетСУчетомДолейВладения"         , Ложь);
	ПараметрыЖКХ.Вставить("УменьшениеНормыЛьготыВПределахФакта", Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Дата), Организация, ПараметрыЖКХ);
	
	мРасчетСУчетомДолейВладения          = ПараметрыЖКХ.РасчетСУчетомДолейВладения;
	мУменьшениеНормыЛьготыВПределахФакта = ПараметрыЖКХ.УменьшениеНормыЛьготыВПределахФакта;
	
	ПараметрыЖКХ.Вставить("НачислениеСУчетомДнейПроживания"         , Ложь);
	ПараметрыЖКХ.Вставить("РасчетПоСоциальнымНормамСУчетомМноготарифногоСчетчика"         , Ложь);
	
	ПараметрыЖКХ.Вставить("РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика"         , Ложь);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Дата), Организация, ПараметрыЖКХ);
	

	мУчетДнейПроживания   = ПараметрыЖКХ.НачислениеСУчетомДнейПроживания;
	
	мРасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика = ПараметрыЖКХ.РасчетПоСоциальнымНормамСучетомМноготарифногоСчетчика;
	
	мРаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика = ПараметрыЖКХ.РаспределениеПропорциональноФактуРасчетаПоСоциальнымНормамСУчетомМноготарифногоСчетчика;
	
КонецПроцедуры

Процедура ОчиститьСтрокиСПустойСуммой () Экспорт
	
	НоваяТаблицаУслуг = новый ТаблицаЗначений;
	
	ТаблицаУслуг= СписокУслуг.Выгрузить(); 	
	
	//27.11.2019
	если ЗначениеЗаполнено(ТаблицаУслуг) = истина тогда

		НоваяТаблицаУслуг = ТаблицаУслуг.СкопироватьКолонки();

		Для Каждого СтараяСтрока Из ТаблицаУслуг Цикл
		//27.11.2019	
		 если СтараяСтрока.Сумма <> 0 или СтараяСтрока.Объем <> 0 тогда 	
	      НоваяСтрока = НоваяТаблицаУслуг.Добавить();
	      ЗаполнитьЗначенияСвойств(НоваяСтрока, СтараяСтрока);
		 конецесли;	  
		КонецЦикла;   
		
		СписокУслуг.Загрузить(НоваяТаблицаУслуг); 	
				
	конецесли;
	
КонецПроцедуры	

