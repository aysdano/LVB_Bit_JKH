	Если (ДолгРФКР(УслугаРФКР,мСтруктураДанных.ЛицевойСчет,мСтруктураДанных.Дата)) <= 0 Тогда
		МакетКапРемонт.ВывестиГоризонтальныйРазделительСтраниц();
		Возврат МакетКапРемонт;
	Иначе
		МакетКапРемонт.Вывести(ОбластьКвитанции);
		МакетКапРемонт.ВывестиГоризонтальныйРазделительСтраниц();
		Возврат МакетКапРемонт;
	КонецЕсли;
	
КонецФункции


Функция КвитанцияКапРемонтДолговаяНежилая()
	
	УслугаРФКР     = Справочники.бит_УслугиЖКХ.НайтиПоКоду("00-000009");
	МакетКапРемонт = Новый ТабличныйДокумент;
	МакетКапРемонт.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	МакетКвитанции = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("лб_МакетКапРемонтДолговая");
	ОбластьКвитанции = МакетКвитанции.ПолучитьОбласть("ОбластьШирина|ОбластьВысота");
	ЗапросКода = Новый Запрос;
	ЗапросКода.УстановитьПараметр("Здание",МструктураДанных.КвартираСсылка.Владелец);
	ЗапросКода.Текст = 
	"ВЫБРАТЬ
	|	лб_Тест_Дома.ВладелецСчетаКР КАК Организация,
	|	лб_Тест_Дома.KR_KOD КАК КодКапРемонта,
	|	лб_Тест_Дома.KR_RS КАК РасчетныйСчет,
	|	лб_Тест_Дома.ЛицевойСчетКР КАК РасчетныйСчетСсылка
	|ИЗ
	|	РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
	|ГДЕ
	|	лб_Тест_Дома.Здание = &Здание";
	РезультатЗапроса = ЗапросКода.Выполнить();
	Если НЕ РезультатЗапроса.Пустой() Тогда
		ВыборкаЗапроса = РезультатЗапроса.Выгрузить();
		
		Если ЗначениеЗаполнено(ВыборкаЗапроса[0].РасчетныйСчетСсылка) Тогда
			РасчетныйСчетСсылка = ВыборкаЗапроса[0].РасчетныйСчетСсылка;
		Иначе
			Возврат МакетКапРемонт; 
		КонецЕсли;
		ПолучательПлатежа   = ВыборкаЗапроса[0].Организация;
		РасчетныйСчет       = ВыборкаЗапроса[0].РасчетныйСчет;
		Если (СокрЛП(ВыборкаЗапроса[0].КодКапРемонта) <> "") И (ВыборкаЗапроса[0].КодКапРемонта <> Неопределено) Тогда
			Код1 = Лев(СокрЛП(ВыборкаЗапроса[0].КодКапРемонта),1);
			Код2 = Сред(СокрЛП(ВыборкаЗапроса[0].КодКапРемонта),2,1);
		Иначе
			Код1 = 0;
			Код2 = 0;
		КонецЕсли;
		
	Иначе 
		Возврат МакетКапРемонт;
		//ПолучательПлатежа = мСтруктураДанных.ПолучательПредставление;
		//РасчетныйСчет     = мСтруктураДанных.ПолучательРС;
		//Код1 = 0;
		//Код2 = 0;
	КонецЕсли;

	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") И НЕ ЗначениеЗаполнено(РасчетныйСчетСсылка) Тогда
		РасчетныйСчетСсылка = ПолучательПлатежа.ОсновнойБанковскийСчет;		
	КонецЕсли;	
		
	Если ТипЗнч(ПолучательПлатежа) = Тип("СправочникСсылка.Организации") Тогда
		ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресОрганизации);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Истина,РасчетныйСчетСсылка).Выгрузить();
	Иначе
		ПолучательАдрес = УправлениеКонтактнойИнформацией.ПредставлениеКонтактнойИнформацииОбъекта(ПолучательПлатежа, Справочники.ВидыКонтактнойИнформации.ЮрАдресКонтрагента);
		ДанныеОПолучателеПлатежа = ДанныеОПолучателе(ПолучательПлатежа,Ложь,РасчетныйСчетСсылка).Выгрузить();
	КонецЕсли;
	КонтрольныйРазрядКод1 = (3*(2 + (Код1*3)))%10;
	КонтрольныйРазрядКод2 = 3*(Код2*3)%10;
	КодПочты1 = "02000000" + Код1 + "0" + КонтрольныйРазрядКод1; 
	КодПочты1СРазделителем = "02'000'000'" + Код1 + "0" + КонтрольныйРазрядКод1; 
	КодПочты2 = "00000000" + Код2 + "0" + КонтрольныйРазрядКод2; 
	КодПочты2СРазделителем = "00'000'000'" + Код2 + "0" + КонтрольныйРазрядКод2;
	Штрихкод = мСтруктураДанных.ЛицевойСчетНомер + мСтруктураДанных.ПериодМесяц + Прав(мСтруктураДанных.ПериодГод, 2) +	Лев(КодПочты1, 10) + Лев(КодПочты2, 10) +	"000000000";
	Сумма = 0;
	Для Счетчик = 1 По (СтрДлина(Штрихкод)/2) Цикл
		ДвухзначноеЧисло = Сред(Штрихкод,Счетчик*2-1,2);		
		Сумма = Сумма + ДвухзначноеЧисло * Счетчик;
	КонецЦикла;
	РезультатРасчета = Сумма + 105;
	КонтрольныйРазрядШтрихкода = РезультатРасчета%103;
	//Контрольный разряд для штрихкода.
	//44 цифры разбиваются попарно. Первая пара умножается на 1, вторая на 2 и т.д. Результат суммируется.
	//К полученному результату придавляем 105 и находим остаток от деления на 103.
	ЗначениеШтрихкода = Штрихкод + Строка(КонтрольныйРазрядШтрихкода);
	//Формирование Штрихкода
	Эталон = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("Эталон");
	КоличествоМиллиметровВПикселе = Эталон.Рисунки.Квадрат100Пикселей.Высота / 100;	
	Попытка
		Рисунок = ОбластьКвитанции.Рисунки.D1;
	Исключение
	КонецПопытки;	
	Попытка		
		ПараметрыШтрихкода = Новый Структура;
		ПараметрыШтрихкода.Вставить("Ширина",          Окр(Рисунок.Ширина / КоличествоМиллиметровВПикселе)+250);
		ПараметрыШтрихкода.Вставить("Высота",          Окр(Рисунок.Высота / КоличествоМиллиметровВПикселе));
		ПараметрыШтрихкода.Вставить("Штрихкод",        ЗначениеШтрихкода);
		ПараметрыШтрихкода.Вставить("ТипКода",         4);
		ПараметрыШтрихкода.Вставить("ОтображатьТекст", Истина);
		ПараметрыШтрихкода.Вставить("РазмерШрифта",    10);
		Рисунок.Ширина		= 0;
		КартинкаШК = ПолучитьКартинкуШтрихкода(мВнешняяКомпонента, ПараметрыШтрихкода); 
		Рисунок.Картинка	= КартинкаШК;
	Исключение
	КонецПопытки;	
	НапечататьQRКодИзмененный(РасчетныйСчетСсылка,РасчетныйСчет,ПолучательПлатежа,ОбластьКвитанции);   //Печать QR-кода
	ДолгРФКР = Формат(ДолгРФКР(УслугаРФКР,мСтруктураДанных.ЛицевойСчет,мСтруктураДанных.Дата),"ЧДЦ=2; ЧН=0,00");
	Если ЗначениеЗаполнено(мСтруктураДанных.ЛицевойСчетФИО) тогда
		ЛицевойСчетФио = мСтруктураДанных.ЛицевойСчетФИО;
