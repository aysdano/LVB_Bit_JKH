#Область ПечатьСчетИзвещений

// Функция формирует табличный документ с печатной формой СчетИзвещения.
// Возвращаемое значение:
// Табличный документ - печатная форма. 
Функция ПечатьСчетИзвещения(ВидМакета)
	
	Попытка
		КомпонентШК = Новый COMОбъект("V8.Barcod.1");
		мЗагруженШтрихкод = Истина;
	Исключение
		мЗагруженШтрихкод = Ложь;
	КонецПопытки;
	
	// БИТ_ЖКХ изменения кода . Начало: 25.10.2011
	Если ВидМакета Тогда
		
		Макет = ПолучитьМакет("СчетИзвещение");
		
	Иначе
		
		Макет = ПолучитьМакет("СчетИзвещение1");
		
	КонецЕсли; 
	// БИТ_ЖКХ изменения кода . Конец  25.10.2011
	
	ТабДок = Новый ТабличныйДокумент();
	ТабДок.КлючПараметровПечати = "Счет-Извещение";
	
	ОбластьШапка1       = Макет.ПолучитьОбласть("Шапка1");
	ОбластьШапка2       = Макет.ПолучитьОбласть("Шапка2");
	ОбластьПодвал       = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал1      = Макет.ПолучитьОбласть("Подвал1");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = Макет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = Макет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = Макет.ПолучитьОбласть("Итого"); 
	// БИТ_ЖКХ изменения кода . Начало: 25.10.2011
	Если ВидМакета Тогда
		ШапкаПриборыУчета   = Макет.ПолучитьОбласть("ШапкаПриборыУчета");
		СтрокаПриборовУчета = Макет.ПолучитьОбласть("СтрокаПриборовУчета");
	Иначе
		ШапкаПриборыУчета1   = Макет.ПолучитьОбласть("ШапкаПриборыУчета1");
		СтрокаПриборовУчета1 = Макет.ПолучитьОбласть("СтрокаПриборовУчета1");
		ШапкаПриборыУчета2   = Макет.ПолучитьОбласть("ШапкаПриборыУчета2");
		СтрокаПриборовУчета2 = Макет.ПолучитьОбласть("СтрокаПриборовУчета2");
	КонецЕсли;
		// БИТ_ЖКХ изменения кода . Конец  25.10.2011
		СтрокаВывода        = Макет.ПолучитьОбласть("СтрокаВывода");
		ОбластьШтрихКод     = Макет.ПолучитьОбласть("ОбластьШтрихКод");
		
		ОбластьШапка1.Параметры.Заполнить(мСтруктураДанных);
		ТабДок.Вывести(ОбластьШапка1); 
		Если мЗагруженШтрихкод тогда
			
			СтрокаСумма = бит_ОбщегоНазначения.СформируемШтрихКод(мСтруктураДанных.ИтогоКОплатеСУчетомПени, Ссылка.Наименование, Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам.Идентификатор, Ссылка.Идентификатор, мНомерПолучателяПоБанку, мИспользоватьНомерПолучателяВШК);
			
			ОбластьШтрихКод.Рисунки.ШтрихКод.Объект.Сообщение = СтрокаСумма;
			
			ТабДок.Вывести(ОбластьШтрихКод);
		КонецЕсли;
		ОбластьШапка2.Параметры.Заполнить(мСтруктураДанных);
		ТабДок.Вывести(ОбластьШапка2);
		
		СчВывода = 5;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	ТабСЧ.Счетчик,
		|	ТабСЧ.Услуга,
		|	ТабСЧ.ДоПоказаний,
		|	ТабСЧ.Приоритет
		|ПОМЕСТИТЬ ТабСЧ
		|ИЗ
		|	&ТабСЧ КАК ТабСЧ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	ТабСЧ.Счетчик КАК Счетчик,
		|	ТабСЧ.Услуга КАК Услуга,
		|	ТабСЧ.ДоПоказаний КАК ДоПоказаний,
		|	ТабСЧ.Приоритет КАК Приоритет
		|ИЗ
		|	ТабСЧ КАК ТабСЧ
		|
		|УПОРЯДОЧИТЬ ПО
		|	Приоритет
		|ИТОГИ
		|	МАКСИМУМ(ДоПоказаний)
		|ПО
		|	Счетчик";
		
		Запрос.УстановитьПараметр("ТабСЧ",мТаблицаПечатиСчетчиков);
		
		ВыборкаСЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		ТаблицаСЧ = мТаблицаПечатиСчетчиков.СкопироватьКолонки();
		ТаблицаСЧ.Очистить();
		// БИТ_ЖКХ изменения кода . Начало: 25.10.2011
		// Для учета вида макета и количества счетчиков.
		НаличиеКолонки = Ложь;
		
		// Если количество счетчиков не попадет в один ряд, а макет "Счет - извещение с 8-мью счетчиками".
		Если ВыборкаСЧ.Количество() > 4 И НЕ ВидМакета Тогда
			
			НаличиеКолонки = Истина;
			
		КонецЕсли;
		// БИТ_ЖКХ изменения кода . Конец  25.10.2011
		
		Если ВыборкаСЧ.Количество() > 0 тогда
			// БИТ_ЖКХ добавление кода Начало: 25.10.2011 
			Если ВидМакета Тогда
				
				ТабДок.Вывести(ШапкаПриборыУчета);
				
			Иначе
				
				ТабДок.Вывести(ШапкаПриборыУчета1);
				
				Если НаличиеКолонки Тогда
					
					ТабДок.Присоединить(ШапкаПриборыУчета2)
					
				КонецЕсли;
			КонецЕсли; 
			ПереборКолонок = Истина;
			СчВывода = СчВывода - 1;
			Пока ВыборкаСЧ.Следующий() Цикл
				
				НоваяСтрока = ТаблицаСЧ.Добавить();
				// БИТ_ЖКХ добавление кода Начало: 25.10.2011 
				Если НЕ ВидМакета Тогда
					
					Если ПереборКолонок Тогда
						// Для вывода последовательно в первую и вторую колонки.
						ПереборКолонок = Ложь;
						
					Иначе
						
						ПереборКолонок = Истина;
						
					КонецЕсли;
					Если НаличиеКолонки И ПереборКолонок Тогда
						СтрокаПриборовУчета2.Параметры.Заполнить(ВыборкаСЧ);
					Иначе
						СтрокаПриборовУчета1.Параметры.Заполнить(ВыборкаСЧ);
					КонецЕсли;
				Иначе
					
					СтрокаПриборовУчета.Параметры.Заполнить(ВыборкаСЧ);
				КонецЕсли;
				Выборка = ВыборкаСЧ.Выбрать();
				
				Если Выборка.Следующий() Тогда
					
					ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
					// БИТ_ЖКХ добавление кода Начало: 25.10.2011 
					Если Не ВидМакета Тогда
						
						Если НаличиеКолонки И ПереборКолонок Тогда
							СтрокаПриборовУчета2.Параметры.Услуга = Лев(Выборка.Услуга, 12);
							ТабДок.Присоединить(СтрокаПриборовУчета2);
							
						Иначе
							СтрокаПриборовУчета1.Параметры.Услуга = Лев(Выборка.Услуга, 12);
							ТабДок.Вывести(СтрокаПриборовУчета1);
							
							СчВывода = СчВывода - 1;
						КонецЕсли;
						
					Иначе
						
						СтрокаПриборовУчета.Параметры.Услуга = Лев(Выборка.Услуга, 12);
						ТабДок.Вывести(СтрокаПриборовУчета);
						СчВывода = СчВывода - 1;
						
					КонецЕсли;	
					
				КонецЕсли;
				
				Если СЧВывода <= 0 Тогда
					
					Прервать;
					СчВывода =0;
					
				КонецЕсли; 
				
			КонецЦикла;	
			
			Пока СчВывода <> 0 цикл
				ТабДок.Вывести(СтрокаВывода);
				СчВывода = СчВывода - 1;
			КонецЦикла;
			
		иначе
			
			Пока СчВывода <> 0 цикл
				ТабДок.Вывести(СтрокаВывода);
				СчВывода = СчВывода - 1;
			КонецЦикла;	
		КонецЕсли;	
		// БИТ_ЖКХ изменения кода. Конец
		
		ТабДок.Вывести(ОбластьПодвал);
		
		ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
		ТабДок.Вывести(ОбластьШапка);
		
		Если ТаблицаСЧ.Количество() > 0 Тогда
			// БИТ_ЖКХ добавление кода Начало: 25.10.2011 
			Если ВидМакета Тогда
				
				ТабДок.Вывести(ШапкаПриборыУчета);
				
			Иначе
				
				ТабДок.Вывести(ШапкаПриборыУчета1);
				
				Если НаличиеКолонки Тогда
					
					ТабДок.Присоединить(ШапкаПриборыУчета2)
					
				КонецЕсли;
				
			КонецЕсли; 
			// ТабДок.Вывести(ШапкаПриборыУчета);.
			ПереборКолонок = Истина;
			Для каждого ТекСтрока Из ТаблицаСЧ Цикл
				Если НЕ ВидМакета Тогда
					
					Если ПереборКолонок Тогда
						// Для вывода последовательно в первую и вторую колонки.
						ПереборКолонок = Ложь;
						
					Иначе
						
						ПереборКолонок = Истина;
						
					КонецЕсли;
				КонецЕсли;
				
				Если Не ВидМакета Тогда
					
					Если НаличиеКолонки И ПереборКолонок Тогда
						СтрокаПриборовУчета2.Параметры.Заполнить(ТекСтрока);
						СтрокаПриборовУчета2.Параметры.Услуга = Лев(СтрокаПриборовУчета2.Параметры.Услуга, 12);
						ТабДок.Присоединить(СтрокаПриборовУчета2);
						
					Иначе
						СтрокаПриборовУчета1.Параметры.Заполнить(ТекСтрока);
						СтрокаПриборовУчета1.Параметры.Услуга = Лев(СтрокаПриборовУчета1.Параметры.Услуга, 12);
						ТабДок.Вывести(СтрокаПриборовУчета1);
						
					КонецЕсли;
					
				Иначе
					
					СтрокаПриборовУчета.Параметры.Заполнить(ТекСтрока);
					// БИТ_ЖКХ изменения кода . Начало: 23.03.2011
					СтрокаПриборовУчета.Параметры.Услуга = Лев(СтрокаПриборовУчета.Параметры.Услуга,12);
					// БИТ_ЖКХ изменения кода . Конец  23.03.2011 
					ТабДок.Вывести(СтрокаПриборовУчета);
				КонецЕсли;
				
			КонецЦикла; 
		иначе
			
		КонецЕсли;	
		// БИТ_ЖКХ изменения кода. Конец
		
		ТабДок.Вывести(ОбластьПодвал1);
		ТабДок.Вывести(ШапкаЗаголовки);
		
		Для Каждого ТекСтрока  Из мТаблицаПечати  Цикл 
			
			Если ТекСтрока.СальдоНаНачало = 0 И ТекСтрока.Начислено = 0 Тогда
				Продолжить;
			Иначе
				СтрокаРасшифровки.Параметры.Заполнить(ТекСтрока);
				Если  мЛьготаПерсонифицированная И НЕ мВыводитьЛьготыНаСчетИзвещение Тогда
					СтрокаРасшифровки.Параметры.Льгота = 0;
				КонецЕсли;	
				ТабДок.Вывести(СтрокаРасшифровки);
			КонецЕсли;
			
		КонецЦикла;
		
		
		ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
		// БИТ_ЖКХ добавление кода Начало: 20.06.2011 
		Если  мЛьготаПерсонифицированная И НЕ мВыводитьЛьготыНаСчетИзвещение Тогда
			ОбластьИтого.Параметры.Льгота = 0;
		КонецЕсли;	
	// БИТ_ЖКХ добавление кода конец : 20.06.2011
	
	ТабДок.Вывести(ОбластьИтого);
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ПолеСверху = 0;
	ТабДок.ПолеСнизу = 0;
	
	Возврат ТабДок;
	
КонецФункции //  
	
// Функция формирует табличный документ с печатной формой СчетИзвещения.
// Возвращаемое значение:
// Табличный документ - печатная форма. 
Функция ПечатьСчетИзвещенияВариант4(ИмяМакета)  
	
	Попытка
		
		КомпонентШК = Новый COMОбъект("V8.Barcod.1");
		мЗагруженШтрихкод = Истина;
	Исключение
		мЗагруженШтрихкод = Ложь;
	КонецПопытки;
	
	УчитыватьЛьготу = НЕ мЛьготаПерсонифицированная;
	
	Макет = ПолучитьМакет("СчетИзвещение4");
	
	ТабДок = Новый ТабличныйДокумент();
	ТабДок.КлючПараметровПечати = "Счет-Извещение";
	
	ОбластьШапка1       = Макет.ПолучитьОбласть("Шапка1");
	ОбластьШапка2       = Макет.ПолучитьОбласть("Шапка2");
	ОбластьПодвал       = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал1      = Макет.ПолучитьОбласть("Подвал1");
	ОбластьШапка        = Макет.ПолучитьОбласть("Шапка");
	ШапкаЗаголовки      = Макет.ПолучитьОбласть("ШапкаЗаголовки");
	СтрокаРасшифровки   = Макет.ПолучитьОбласть("СтрокаРасшифровки");
	ОбластьИтого        = Макет.ПолучитьОбласть("Итого"); 
	ШапкаПриборыУчета   = Макет.ПолучитьОбласть("ШапкаПриборыУчета");
	СтрокаПриборовУчета = Макет.ПолучитьОбласть("СтрокаПриборовУчета");
	СтрокаВывода        = Макет.ПолучитьОбласть("СтрокаВывода");
	ОбластьШтрихКод     = Макет.ПолучитьОбласть("ОбластьШтрихКод");
	
	ОбластьШапка1.Параметры.Заполнить(мСтруктураДанных);
	ТабДок.Вывести(ОбластьШапка1); 
	Если мЗагруженШтрихкод тогда
		СтрокаСумма = бит_ОбщегоНазначения.СформируемШтрихКод(мСтруктураДанных.ИтогоКОплатеСУчетомПени, Ссылка.Наименование, Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам.Идентификатор, Ссылка.Идентификатор, мНомерПолучателяПоБанку, мИспользоватьНомерПолучателяВШК);
		
		ОбластьШтрихКод.Рисунки.ШтрихКод.Объект.Сообщение = СтрокаСумма;
		
		ТабДок.Вывести(ОбластьШтрихКод);
	КонецЕсли;
	
	мТаблицаПечати4 = мТаблицаПечати.Скопировать();
	
	Для Каждого ТекСтрока  Из мТаблицаПечати4  Цикл 
		КОплате = ТекСтрока.СальдоНаНачало + ТекСтрока.Начислено - ТекСтрока.Оплата + ТекСтрока.Разовые - ТекСтрока.Субсидия 
		- ?(УчитыватьЛьготу, ТекСтрока.Льгота, 0);
		Если КОплате < 0 Тогда
			ТекСтрока.КОплате = КОплате;
		КонецЕсли; 
		Если ИмяМакета = "СчетИзвещение5" Тогда
			
			ТекСтрока.СальдоНаНачало = ТекСтрока.СальдоНаНачало;
			
		Иначе
			
			ТекСтрока.СальдоНаНачало = ТекСтрока.СальдоНаНачало - ТекСтрока.Оплата;
			
		КонецЕсли; 
	КонецЦикла;
	
	ОбластьШапка2.Параметры.Заполнить(мСтруктураДанных);
	Если мСтруктураДанных.КОплате <> мТаблицаПечати4.Итог("КОплате") Тогда
		ОбластьШапка2.Параметры.ИтогоКОплатеСУчетомПени = мТаблицаПечати4.Итог("КОплате") + мСтруктураДанных.ИтогПени;
	КонецЕсли; 
	ТабДок.Вывести(ОбластьШапка2);
	
	СчВывода = 5;
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ТабСЧ.Счетчик,
	|	ТабСЧ.Услуга,
	|	ТабСЧ.ДоПоказаний,
	|	ТабСЧ.Приоритет
	|ПОМЕСТИТЬ ТабСЧ
	|ИЗ
	|	&ТабСЧ КАК ТабСЧ
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТабСЧ.Счетчик КАК Счетчик,
	|	ТабСЧ.Услуга КАК Услуга,
	|	ТабСЧ.ДоПоказаний КАК ДоПоказаний,
	|	ТабСЧ.Приоритет КАК Приоритет
	|ИЗ
	|	ТабСЧ КАК ТабСЧ
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ
	|	МАКСИМУМ(ДоПоказаний)
	|ПО
	|	Счетчик";
	
	Запрос.УстановитьПараметр("ТабСЧ",мТаблицаПечатиСчетчиков);
	
	ВыборкаСЧ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаСЧ = мТаблицаПечатиСчетчиков.СкопироватьКолонки();
	ТаблицаСЧ.Очистить();
	
	Если ВыборкаСЧ.Количество() > 0 тогда
		СчВывода = СчВывода - 1;
		ТабДок.Вывести(ШапкаПриборыУчета);
		Пока ВыборкаСЧ.Следующий() Цикл
			
			НоваяСтрока = ТаблицаСЧ.Добавить();
			СтрокаПриборовУчета.Параметры.Заполнить(ВыборкаСЧ);
			Выборка = ВыборкаСЧ.Выбрать();
			
			Если Выборка.Следующий() Тогда
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
				СтрокаПриборовУчета.Параметры.Услуга = Лев(Выборка.Услуга, 12);
				
			КонецЕсли;
			
			СчВывода = СчВывода - 1;
			ТабДок.Вывести(СтрокаПриборовУчета);
			
			Если СЧВывода <= 0 Тогда
				
				Прервать;
				СчВывода =0;
				
			КонецЕсли; 
			
		КонецЦикла;	
		
		Пока СчВывода <> 0 цикл
			ТабДок.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
		КонецЦикла;
		
	иначе
		
		Пока СчВывода <> 0 цикл
			ТабДок.Вывести(СтрокаВывода);
			СчВывода = СчВывода - 1;
		КонецЦикла;	
	КонецЕсли;	
	
	ТабДок.Вывести(ОбластьПодвал);
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	
	Если мСтруктураДанных.КОплате <> мТаблицаПечати4.Итог("КОплате") Тогда
		ОбластьШапка.Параметры.ИтогоКОплатеСУчетомПени 	  = мТаблицаПечати4.Итог("КОплате") + мСтруктураДанных.ИтогПени;
		ОбластьШапка.Параметры.ИтогоКОплатеСУчетомПредоплаты = мТаблицаПечати4.Итог("КОплате");
	КонецЕсли; 
	// БИТ_ЖКХ изменения кода . Начало: 07.04.2011  
	ОбластьШапка.Параметры.СальдоНаНачалоМесяца 	  = мТаблицаПечати4.Итог("СальдоНаНачало");
	// БИТ_ЖКХ изменения кода . Конец  07.04.2011 
	ТабДок.Вывести(ОбластьШапка);
	
	Если ТаблицаСЧ.Количество() > 0 Тогда
		ТабДок.Вывести(ШапкаПриборыУчета);
		Для каждого ТекСтрока Из ТаблицаСЧ Цикл
			
			СтрокаПриборовУчета.Параметры.Заполнить(ТекСтрока);
			// БИТ_ЖКХ изменения кода . Начало: 23.03.2011
			СтрокаПриборовУчета.Параметры.Услуга = Лев(СтрокаПриборовУчета.Параметры.Услуга,12);
			// БИТ_ЖКХ изменения кода . Конец  23.03.2011 
			ТабДок.Вывести(СтрокаПриборовУчета);
			
		КонецЦикла; 
	КонецЕсли;	
	
	ТабДок.Вывести(ОбластьПодвал1);
	ТабДок.Вывести(ШапкаЗаголовки);
	
	Итог = 0;
	Для Каждого ТекСтрока  Из мТаблицаПечати4  Цикл
		// БИТ_ЖКХ изменения кода . Начало: 21.05.2012
		Если ТекСтрока.СальдоНаНачало = 0 И ТекСтрока.Начислено = 0 Тогда
			Продолжить;
		Иначе
			СтрокаРасшифровки.Параметры.Заполнить(ТекСтрока);
			ТабДок.Вывести(СтрокаРасшифровки);
		КонецЕсли;
		// БИТ_ЖКХ изменения кода . Конец  21.05.2012
	КонецЦикла;
	
	ОбластьИтого.Параметры.Заполнить(мСтруктураДанных);
	Если мСтруктураДанных.КОплате <> мТаблицаПечати4.Итог("КОплате") Тогда
		ОбластьИтого.Параметры.КОплате = мТаблицаПечати4.Итог("КОплате");
	КонецЕсли; 
	// БИТ_ЖКХ изменения кода . Начало: 07.04.2011 
	ОбластьИтого.Параметры.Сальдо = мТаблицаПечати4.Итог("СальдоНаНачало");
	// БИТ_ЖКХ изменения кода . Конец  07.04.2011 
	ТабДок.Вывести(ОбластьИтого);
	
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	ТабДок.ПолеСверху = 0;
	ТабДок.ПолеСнизу = 0;
	
	Возврат ТабДок;
	
КонецФункции //  

// Функция формирует табличный документ с печатной формой СчетИзвещения.
// Возвращаемое значение:
// Табличный документ - печатная форма. 
Функция ПечатьСчетКвитанция6(ИмяМакета)
	
	Попытка
		КомпонентШК = Новый COMОбъект("V8.Barcod.1");
		мЗагруженШтрихкод = Истина;
	Исключение
		мЗагруженШтрихкод = Ложь;
	КонецПопытки;
	// БИТ_ЖКХ изменения кода . Начало: 29.09.2011
	// Макет = ПолучитьМакет("Квитанция6");.
	Макет = ПолучитьМакет(ИмяМакета);
	// БИТ_ЖКХ изменения кода . Конец  29.09.2011
	ТабДок = Новый ТабличныйДокумент();
	ТабДок.КлючПараметровПечати = "Счет-Извещение";
	
	ОбластьШапка       = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока      = Макет.ПолучитьОбласть("Строка");
	ОбластьВсего       = Макет.ПолучитьОбласть("Всего");
	ОбластьПодвал      = Макет.ПолучитьОбласть("Подвал");
	ОбластьПодвал2     = Макет.ПолучитьОбласть("Подвал2");
	ПустаяСтрока       = Макет.ПолучитьОбласть("ПустаяСтрока");
	СтрокаПРиборы      = Макет.ПолучитьОбласть("СтрокаПриборовУчета");
	
	Если мЗагруженШтрихкод тогда
		
		СтрокаСумма = бит_ОбщегоНазначения.СформируемШтрихКод(мСтруктураДанных.ИтогоКОплатеСУчетомПени, Ссылка.Наименование, Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам.Идентификатор, Ссылка.Идентификатор, мНомерПолучателяПоБанку, мИспользоватьНомерПолучателяВШК);
		
		ОбластьШапка.Рисунки.ШтрихКод.Объект.Сообщение = СтрокаСумма;
		
	КонецЕсли;
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	ОбластьШапка.Параметры.НазваниеОрганизации = Организация;
	СведенияОбОрганизации = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Организация);
	ОбластьШапка.Параметры.АдресОрганизации    = СведенияОбОрганизации.ЮридическийАдрес;
	ОбластьШапка.Параметры.ИННОрганизации      = Организация.ИНН;
	ТабДок.Вывести(ОбластьШапка);
	
	Отбор = Новый Структура;
	Для каждого Строка Из мТаблицаПечати Цикл
		// БИТ_ЖКХ изменения кода . Начало: 21.05.2012
		Если Строка.СальдоНаНачало = 0 И Строка.Начислено = 0 Тогда
			Продолжить;
		Иначе
			Отбор.Очистить();
			Отбор.Вставить("Услуга",Строка.Услуга);
			СтрокиСЧ = мТаблицаПечатиСчетчиков.НайтиСтроки(Отбор);
			
			Если СтрокиСЧ.Количество() = 1 Тогда
				ОбластьСтрока.Параметры.Заполнить(СтрокиСЧ[0]);
			КонецЕсли;
			
			ОбластьСтрока.Параметры.Заполнить(Строка);
			ТабДок.Вывести(ОбластьСтрока);
			
			Если СтрокиСЧ.Количество() > 1 Тогда
				Для каждого СЧ Из СтрокиСЧ Цикл
					
					СтрокаПРиборы.Параметры.Заполнить(СЧ);
					ТабДок.Вывести(СтрокаПРиборы);
					
				КонецЦикла;
			КонецЕсли;
			
			Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
				
				ОбластьСтрока.Параметры.Установить(Значение, "");
				
			КонецЦикла;
		КонецЕсли;
		// БИТ_ЖКХ изменения кода . Конец  21.05.2012
	КонецЦикла;
	
	ОбластьВсего.Параметры.Заполнить(мСтруктураДанных);
	
	ТабДок.Вывести(ОбластьВсего);
	
	КолПустСтрок = 12;
	
	Если КолПустСтрок > мТаблицаПечати.Количество() + мТаблицаПечатиСчетчиков.Количество() Тогда
		
		КолПустСтрок = КолПустСтрок - мТаблицаПечати.Количество();
		Пока КолПустСтрок <> 0 Цикл
			
			ТабДок.Вывести(ПустаяСтрока);
			КолПустСтрок = КолПустСтрок - 1;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	ОбластьПодвал.Параметры.Заполнить(мСтруктураДанных);
	ТабДок.Вывести(ОбластьПодвал);
	ТабДок.Вывести(ОбластьПодвал2);
	
	Возврат ТабДок;
	
КонецФункции // ()

// Функция формирует табличный документ с печатной формой СчетИзвещения.
// Возвращаемое значение:
// Табличный документ - печатная форма. 
Функция ПечатьСчетКвитанция5()
	
	Попытка
		КомпонентШК = Новый COMОбъект("V8.Barcod.1");
		мЗагруженШтрихкод = Истина;
	Исключение
		мЗагруженШтрихкод = Ложь;
	КонецПопытки;
	
	Макет = ПолучитьМакет("Квитанция5");
	
	ТабДок = Новый ТабличныйДокумент();
	ТабДок.КлючПараметровПечати = "Счет-Извещение";
	
	ОбластьШапка       = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока      = Макет.ПолучитьОбласть("Строка|Часть1");
	ДопСтрока          = Макет.ПолучитьОбласть("Строка|Часть2");
	ОбластьВсего       = Макет.ПолучитьОбласть("Всего");
	ОбластьПодвал      = Макет.ПолучитьОбласть("Подвал");
	ПустаяСтрока       = Макет.ПолучитьОбласть("ПустаяСтрока");
	
	Если мЗагруженШтрихкод тогда

		СтрокаСумма = бит_ОбщегоНазначения.СформируемШтрихКод(мСтруктураДанных.ИтогоКОплатеСУчетомПени, Ссылка.Наименование, Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам.Идентификатор, Ссылка.Идентификатор, мНомерПолучателяПоБанку, мИспользоватьНомерПолучателяВШК);
		
		ОбластьШапка.Рисунки.ШтрихКод.Объект.Сообщение = СтрокаСумма;
		
	КонецЕсли;
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	
	СведенияОбОрганизации = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Организация);
	
	ОбластьШапка.Параметры.НазваниеОрганизации = Организация;
	ОбластьШапка.Параметры.АдресОрганизации    = СведенияОбОрганизации.ЮридическийАдрес;
	ОбластьШапка.Параметры.ИННОрганизации      = Организация.ИНН;
	ОбластьШапка.Параметры.Месяц               = Формат(Месяц(ТекущаяДата()), "ЧЦ=2; ЧВН=");
	ОбластьШапка.Параметры.Год                 = Формат(Год(ТекущаяДата())  , "ЧЦ=4; ЧГ=");
	ОбластьШапка.Параметры.ДатаПоследнейОплаты = ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПоследнейОплаты),Формат(мСтруктураДанных.ДатаПоследнейОплаты,"ДФ=dd.MM.yyyy"),"");
	
	ТабДок.Вывести(ОбластьШапка);
	
	ИндексСтроки = 0;
	КолПустыхСтрок = 12;
	Вывести = Истина;
	
	мТаблицаПечати1 = мТаблицаПечати.Скопировать();
	мТаблицаПечати2 = мТаблицаПечати.Скопировать();
	
	Для каждого Колонка Из мТаблицаПечати1.Колонки Цикл
		
		Колонка.Имя = Колонка.Имя + 1;
		
	КонецЦикла;
	
	Для каждого Колонка Из мТаблицаПечати2.Колонки Цикл
		
		Колонка.Имя = Колонка.Имя + 1;
		
	КонецЦикла; 
	
	Для каждого Строка Из мТаблицаПечати Цикл
		// БИТ_ЖКХ изменения кода . Начало: 21.05.2012
		Если Строка.СальдоНаНачало = 0 И Строка.Начислено = 0 Тогда
			Продолжить;
		Иначе
			ИндексСтроки = ИндексСтроки + 1;
			
			Если ИндексСтроки <> 23 Тогда
				
				Если Вывести Тогда
					
					ОбластьСтрока.Параметры.Заполнить(Строка);
					
					// БИТ_ЖКХ добавление кода Начало: 23.08.2011 
					Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг") Тогда
						ОбластьСтрока.Параметры.Количество = Null;
					КонецЕсли;
					// БИТ_ЖКХ добавление кода конец : 23.08.2011
					
					ТабДок.Вывести(ОбластьСтрока);
					
				Иначе 
					
					ДопСтрока.Параметры.Заполнить(Строка);
					
					// БИТ_ЖКХ добавление кода Начало: 24.08.2011 
					Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг") Тогда
						ДопСтрока.Параметры.Количество = Null;
					КонецЕсли;
					// БИТ_ЖКХ добавление кода конец : 24.08.2011
					
					ТабДок.Присоединить(ДопСтрока);
					
				КонецЕсли    ;
				
				Вывести = ?(Вывести, ложь,Истина);
				
			КонецЕсли;
		КонецЕсли;
		// БИТ_ЖКХ изменения кода . Конец  21.05.2012
	КонецЦикла;   
	
	Если Вывести Тогда
		
		ИндексСтроки = ИндексСтроки + 2;
		
		Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
			
			ОбластьСтрока.Параметры.Установить(Значение, "");
			
		КонецЦикла;  
		
		ТабДок.Вывести(ОбластьСтрока);
		
		// БИТ_ЖКХ изменения кода . Начало: 23.03.2011 
		Для Значение=0 по ДопСтрока.Параметры.Количество() - 1 Цикл
			
			ДопСтрока.Параметры.Установить(Значение, "");
			
		КонецЦикла;  
		// БИТ_ЖКХ изменения кода . Конец  23.03.2011 
		
		ДопСтрока.Параметры.Услуга         = "ИТОГО";
		ДопСтрока.Параметры.Начислено      = мТаблицаПечати.итог("Начислено");
		ДопСтрока.Параметры.КОплатеЗаМесяц = мТаблицаПечати.итог("КОплатеЗаМесяц");
		
		ТабДок.Присоединить(ДопСтрока);
		
	Иначе
		
		ИндексСтроки = ИндексСтроки + 1;
		// БИТ_ЖКХ изменения кода . Начало: 23.03.2011 
		Для Значение=0 по ДопСтрока.Параметры.Количество() - 1 Цикл
			
			ДопСтрока.Параметры.Установить(Значение, "");
			
		КонецЦикла;  
		// БИТ_ЖКХ изменения кода . Конец  23.03.2011 
		ДопСтрока.Параметры.Услуга         = "ИТОГО";
		ДопСтрока.Параметры.Начислено      = мТаблицаПечати.итог("Начислено");
		ДопСтрока.Параметры.КОплатеЗаМесяц = мТаблицаПечати.итог("КОплатеЗаМесяц");
		
		ТабДок.Присоединить(ДопСтрока);
		
	КонецЕсли; 
	
	КолПустыхСтрок = КолПустыхСтрок - (ИндексСтроки/2);
	
	Пока КолПустыхСтрок <> 0 Цикл
		КолПустыхСтрок = КолПустыхСтрок - 1;
		ТабДок.Присоединить(ПустаяСтрока);
	КонецЦикла;
	
	НомерСчетчика = 0;
	
	мТаблицаПечатиСчетчиков1 = мТаблицаПечатиСчетчиков.Скопировать();
	мТаблицаПечатиСчетчиков1.Свернуть("Счетчик,ЕдИзм,ДоПоказаний");
	Для каждого Строка Из мТаблицаПечатиСчетчиков1 Цикл
		
		НомерСчетчика =  НомерСчетчика + 1;
		Если НомерСчетчика <= 6 Тогда
			
			НазваниеСчетчика = "НазваниеСчетчика" +НомерСчетчика;
			ЕдИзмСч = "ЕдИзмСч" + НомерСчетчика;
			
			ДоПоказаний = "ДоПоказаний" + НомерСчетчика;
			ОбластьВсего.Параметры[ДоПоказаний] = Строка.ДоПоказаний;
			ОбластьВсего.Параметры[НазваниеСчетчика] = Строка.Счетчик;
			ОбластьВсего.Параметры[ЕдИзмСч]          = Строка.ЕдИзм;
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 
	
	ОбластьВсего.Параметры.ИтогоКОплатеСУчетомПени = "ИТОГО: " + мСтруктураДанных.ИтогоКОплатеСУчетомПени +" "+
	?(мСтруктураДанных.ИтогПени<> 0,"в т. ч. Пени: " + мСтруктураДанных.ИтогПени,"");
	ТабДок.Вывести(ОбластьВсего);
	
	ОбластьПодвал.Параметры.СтрЗадолженность = "Задолженность на "+ Формат(НачалоМесяца(ТекущаяДата()),"ДФ=dd.MM.yyyy")+ " : " + мСтруктураДанных.Долг;
	ОбластьПодвал.Параметры.СтрОплата        = "Оплачено после "+ Формат(НачалоМесяца(ТекущаяДата()),"ДФ=dd.MM.yyyy")+ " : " + мСтруктураДанных.Оплата;
	
	Текст = "Вид собственности: " + мСтруктураДанных.СтатусКвартиры+ " К-во комнат: " + мСтруктураДанных.КоличествоКомнат
	+ " Площадь общ.: " + мСтруктураДанных.ОписаниеОбщейПлощади + " жилая: " 
	+ мСтруктураДанных.ОписаниеЖилойПлощади + " К-во проживающих:" + мСтруктураДанных.КоличествоПроживающих + "; льготников: " 
	+ мСтруктураДанных.КолЛьготников + " "+ ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПоследнейОплаты), "Дата последней оплаты: "+мСтруктураДанных.ДатаПоследнейОплаты, "") 
	+"  Дата создания: "+ Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	
	ОбластьПодвал.Параметры.СтрИнфо = Текст;
	
	ТабДок.Вывести(ОбластьПодвал);
	
	Возврат ТабДок;
	
КонецФункции // ()

// БИТ_ЖКХ добавление кода Начало: 23.09.2011 
// Функция формирует табличный документ с печатной формой Квитанция7.
// Возвращаемое значение:
// Табличный документ - печатная форма. 
Функция ПечатьСчетКвитанция7()
	
	Попытка
		КомпонентШК = Новый COMОбъект("V8.Barcod.1");
		мЗагруженШтрихкод = Истина;
	Исключение
		мЗагруженШтрихкод = Ложь;
	КонецПопытки;
	
	Макет = ПолучитьМакет("Квитанция7");
	
	ТабДок = Новый ТабличныйДокумент();
	ТабДок.КлючПараметровПечати = "Счет-Извещение";
	
	ОбластьШапка       = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока      = Макет.ПолучитьОбласть("Строка|Часть1");
	ДопСтрока          = Макет.ПолучитьОбласть("Строка|Часть2");
	ОбластьВсего       = Макет.ПолучитьОбласть("Всего");
	ОбластьПодвал      = Макет.ПолучитьОбласть("Подвал");
	ПустаяСтрока       = Макет.ПолучитьОбласть("ПустаяСтрока");
	
	УчитыватьЛьготу = НЕ мЛьготаПерсонифицированная;
	
	мТаблицаПечати4 = мТаблицаПечати.Скопировать();
	
	Для Каждого ТекСтрока  Из мТаблицаПечати4  Цикл 
		КОплате = ТекСтрока.СальдоНаНачало + ТекСтрока.Начислено - ТекСтрока.Оплата + ТекСтрока.Разовые - ТекСтрока.Субсидия 
		- ?(УчитыватьЛьготу, ТекСтрока.Льгота, 0);
		Если КОплате < 0 Тогда
			ТекСтрока.КОплате = КОплате;
		КонецЕсли; 
	КонецЦикла;
	// БИТ_ЖКХ добавление кода конец : 23.09.2011
	
	Если мЗагруженШтрихкод тогда

		СтрокаСумма = бит_ОбщегоНазначения.СформируемШтрихКод(мСтруктураДанных.ИтогоКОплатеСУчетомПени, Ссылка.Наименование, Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам.Идентификатор, Ссылка.Идентификатор, мНомерПолучателяПоБанку, мИспользоватьНомерПолучателяВШК);
		
		ОбластьШапка.Рисунки.ШтрихКод.Объект.Сообщение = СтрокаСумма;
		
	КонецЕсли;
	
	ОбластьШапка.Параметры.Заполнить(мСтруктураДанных);
	
	СведенияОбОрганизации = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Организация);
	
	ОбластьШапка.Параметры.НазваниеОрганизации = Организация;
	ОбластьШапка.Параметры.АдресОрганизации    = СведенияОбОрганизации.ЮридическийАдрес;
	ОбластьШапка.Параметры.ИННОрганизации      = Организация.ИНН;
	ОбластьШапка.Параметры.Месяц               = Формат(Месяц(ТекущаяДата()), "ЧЦ=2; ЧВН=");
	ОбластьШапка.Параметры.Год                 = Формат(Год(ТекущаяДата())  , "ЧЦ=4; ЧГ=");
	ОбластьШапка.Параметры.ДатаПоследнейОплаты = ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПоследнейОплаты),Формат(мСтруктураДанных.ДатаПоследнейОплаты,"ДФ=dd.MM.yyyy"),"");
	// БИТ_ЖКХ добавление кода Начало: 23.09.2011 
	Если мСтруктураДанных.КОплате <> мТаблицаПечати4.Итог("КОплате") Тогда
		ОбластьШапка.Параметры.КОплате = мТаблицаПечати4.Итог("КОплате") + мСтруктураДанных.ИтогПени;
	КонецЕсли;
	// БИТ_ЖКХ добавление кода конец : 23.09.2011
	ТабДок.Вывести(ОбластьШапка);
	
	ИндексСтроки = 0;
	КолПустыхСтрок = 12;
	Вывести = Истина;
	
	мТаблицаПечати1 = мТаблицаПечати.Скопировать();
	мТаблицаПечати2 = мТаблицаПечати.Скопировать();
	
	Для каждого Колонка Из мТаблицаПечати1.Колонки Цикл
		
		Колонка.Имя = Колонка.Имя + 1;
		
	КонецЦикла;
	
	Для каждого Колонка Из мТаблицаПечати2.Колонки Цикл
		
		Колонка.Имя = Колонка.Имя + 1;
		
	КонецЦикла; 
	
	Для каждого Строка Из мТаблицаПечати Цикл
		// БИТ_ЖКХ изменения кода . Начало: 21.05.2012
		Если Строка.СальдоНаНачало = 0 И Строка.Начислено = 0 Тогда
			Продолжить;
		Иначе
			
			ИндексСтроки = ИндексСтроки + 1;
			
			Если ИндексСтроки <> 23 Тогда
				
				Если Вывести Тогда
					
					ОбластьСтрока.Параметры.Заполнить(Строка);
					
					// БИТ_ЖКХ добавление кода Начало: 23.08.2011 
					Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг") Тогда
						ОбластьСтрока.Параметры.Количество = Null;
					КонецЕсли;
					// БИТ_ЖКХ добавление кода конец : 23.08.2011
					
					ТабДок.Вывести(ОбластьСтрока);
					
				Иначе 
					
					ДопСтрока.Параметры.Заполнить(Строка);
					
					// БИТ_ЖКХ добавление кода Начало: 24.08.2011 
					Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг") Тогда
						ДопСтрока.Параметры.Количество = Null;
					КонецЕсли;
					// БИТ_ЖКХ добавление кода конец : 24.08.2011
					
					ТабДок.Присоединить(ДопСтрока);
					
				КонецЕсли    ;
				
				Вывести = ?(Вывести, ложь,Истина);
				
			КонецЕсли;
		КонецЕсли;
		// БИТ_ЖКХ изменения кода . Конец  21.05.2012
	КонецЦикла;   
	
	Если Вывести Тогда
		
		ИндексСтроки = ИндексСтроки + 2;
		
		Для Значение=0 по ОбластьСтрока.Параметры.Количество() - 1 Цикл
			
			ОбластьСтрока.Параметры.Установить(Значение, "");
			
		КонецЦикла;  
		
		ТабДок.Вывести(ОбластьСтрока);
		
		// БИТ_ЖКХ изменения кода . Начало: 23.03.2011 
		Для Значение=0 по ДопСтрока.Параметры.Количество() - 1 Цикл
			
			ДопСтрока.Параметры.Установить(Значение, "");
			
		КонецЦикла;  
		// БИТ_ЖКХ изменения кода . Конец  23.03.2011 
		
		ДопСтрока.Параметры.Услуга         = "ИТОГО";
		ДопСтрока.Параметры.Начислено      = мТаблицаПечати.итог("Начислено");
		ДопСтрока.Параметры.КОплатеЗаМесяц = мТаблицаПечати.итог("КОплатеЗаМесяц");
		// БИТ_ЖКХ добавление кода Начало: 05.04.2012 
		ДопСтрока.Параметры.Разовые 	= мТаблицаПечати.итог("Разовые");
		ДопСтрока.Параметры.Льгота      = мТаблицаПечати.итог("Льгота");
		// БИТ_ЖКХ добавление кода конец : 05.04.2012
		ТабДок.Присоединить(ДопСтрока);
		
	Иначе
		
		ИндексСтроки = ИндексСтроки + 1;
		// БИТ_ЖКХ изменения кода . Начало: 23.03.2011 
		Для Значение=0 по ДопСтрока.Параметры.Количество() - 1 Цикл
			
			ДопСтрока.Параметры.Установить(Значение, "");
			
		КонецЦикла;  
		// БИТ_ЖКХ изменения кода . Конец  23.03.2011 
		ДопСтрока.Параметры.Услуга         = "ИТОГО";
		ДопСтрока.Параметры.Начислено      = мТаблицаПечати.итог("Начислено");
		ДопСтрока.Параметры.КОплатеЗаМесяц = мТаблицаПечати.итог("КОплатеЗаМесяц");
		// БИТ_ЖКХ добавление кода Начало: 05.04.2012 
		ДопСтрока.Параметры.Разовые 	= мТаблицаПечати.итог("Разовые");
		ДопСтрока.Параметры.Льгота      = мТаблицаПечати.итог("Льгота");
		// БИТ_ЖКХ добавление кода конец : 05.04.2012
		ТабДок.Присоединить(ДопСтрока);
		
	КонецЕсли; 
	
	КолПустыхСтрок = КолПустыхСтрок - (ИндексСтроки/2);
	
	Пока КолПустыхСтрок <> 0 Цикл
		КолПустыхСтрок = КолПустыхСтрок - 1;
		ТабДок.Присоединить(ПустаяСтрока);
	КонецЦикла;
	
	НомерСчетчика = 0;
	
	мТаблицаПечатиСчетчиков1 = мТаблицаПечатиСчетчиков.Скопировать();
	мТаблицаПечатиСчетчиков1.Свернуть("Счетчик,ЕдИзм,ДоПоказаний");
	Для каждого Строка Из мТаблицаПечатиСчетчиков1 Цикл
		
		НомерСчетчика =  НомерСчетчика + 1;
		Если НомерСчетчика <= 6 Тогда
			
			НазваниеСчетчика = "НазваниеСчетчика" +НомерСчетчика;
			ЕдИзмСч = "ЕдИзмСч" + НомерСчетчика;
			
			ДоПоказаний = "ДоПоказаний" + НомерСчетчика;
			ОбластьВсего.Параметры[ДоПоказаний] = Строка.ДоПоказаний;
			
			ОбластьВсего.Параметры[НазваниеСчетчика] = Строка.Счетчик;
			ОбластьВсего.Параметры[ЕдИзмСч]          = Строка.ЕдИзм;
			
		Иначе
			Прервать;
		КонецЕсли;
		
	КонецЦикла; 
	
	// БИТ_ЖКХ добавление кода Начало: 23.09.2011 
	Если мСтруктураДанных.КОплате <> мТаблицаПечати4.Итог("КОплате") Тогда
		ОбластьВсего.Параметры.КОплате = мТаблицаПечати4.Итог("КОплате") + мСтруктураДанных.ИтогПени;
	КонецЕсли; 
	
	// БИТ_ЖКХ добавление кода конец : 23.09.2011
	ТабДок.Вывести(ОбластьВсего);
	
	ОбластьПодвал.Параметры.СтрЗадолженность = "Задолженность на "+ Формат(НачалоМесяца(ТекущаяДата()),"ДФ=dd.MM.yyyy")+ " : " + мСтруктураДанных.Сальдо;
	
	ОбластьПодвал.Параметры.СтрОплата        = "Оплачено за период: с "+ Формат(НачалоМесяца(ТекущаяДата()),"ДФ=dd.MM.yyyy")+ " по " + Формат(КонецМесяца(ТекущаяДата()),"ДФ=dd.MM.yyyy") + " : " + мСтруктураДанных.Оплата;
	
	Текст = "Вид собственности: " + мСтруктураДанных.СтатусКвартиры+ " К-во комнат: " + мСтруктураДанных.КоличествоКомнат
	+ " Площадь общ.: " + мСтруктураДанных.ОписаниеОбщейПлощади + " жилая: " 
	+ мСтруктураДанных.ОписаниеЖилойПлощади + " К-во проживающих:" + мСтруктураДанных.КоличествоПроживающих + "; льготников: " 
	+ мСтруктураДанных.КолЛьготников + " "+ ?(ЗначениеЗаполнено(мСтруктураДанных.ДатаПоследнейОплаты), "Дата последней оплаты: "+мСтруктураДанных.ДатаПоследнейОплаты, "") 
	+"  Дата создания: "+ Формат(ТекущаяДата(),"ДФ=dd.MM.yyyy");
	
	ОбластьПодвал.Параметры.СтрИнфо = Текст;
	
	ТабДок.Вывести(ОбластьПодвал);
	
	Возврат ТабДок;
	
КонецФункции // ()
