//Движения регистра "бит_НачисленияПоУслугамЖКХ"
&НаСервере
Процедура НачисленияПоУслугамЖКХ(пГоспошлина, пПредставительские, пОрганизация)
	Движения.бит_НачисленияПоУслугамЖКХ.Записывать = Истина;
	Движения.бит_НачисленияПоУслугамЖКХПоПериоду.Записывать = Истина;
	
	// Госпошлина Приход                         
	Если СуммаГоспошлиныПоРешениюСуда<>0 тогда
		Движение = Движения.бит_НачисленияПоУслугамЖКХ.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.УслугаЖКХ = пГоспошлина;
		Движение.ЛицевойСчет = ЛицевойСчет;
		Движение.Сумма = СуммаГоспошлиныПоРешениюСуда;
		Движение.Организация = пОрганизация;
	КонецЕсли;
	
	// Представительские Приход    
	Если СуммаПредставительскихРасходовПоРешениюСуда<>0 тогда
		Движение = Движения.бит_НачисленияПоУслугамЖКХ.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.УслугаЖКХ = пПредставительские;
		Движение.ЛицевойСчет = ЛицевойСчет;
		Движение.Сумма = СуммаПредставительскихРасходовПоРешениюСуда;
		Движение.Организация = пОрганизация;                     
	КонецЕсли;


	//бит_НачисленияПоУслугамЖКХПоПериоду
	
	Если ЗначениеЗаполнено(ДатаВынесенияРешенияСуда) тогда 
		МесяцВзаиморасчетов = ДатаВынесенияРешенияСуда;
	ИначеЕсли ЗначениеЗаполнено(ДатаИсполнительногоЛиста) тогда
		МесяцВзаиморасчетов = ДатаИсполнительногоЛиста;
	иначе
		МесяцВзаиморасчетов = Дата;
	КонецЕсли;
	
	Если МесяцВзаиморасчетов < бит_НачисленияЖКХ.МинимальныйПериодОплаты() тогда 
		 МесяцВзаиморасчетов = бит_НачисленияЖКХ.МинимальныйПериодОплаты();
	ИначеЕсли МесяцВзаиморасчетов > бит_НачисленияЖКХ.МаксимальныйПериодОплаты() тогда
		 МесяцВзаиморасчетов = Дата;
	КонецЕсли;
	
	// Госпошлина Приход
	Если СуммаГоспошлиныПоРешениюСуда<>0 тогда
		Движение = Движения.бит_НачисленияПоУслугамЖКХПоПериоду.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.УслугаЖКХ = пГоспошлина;
		Движение.ЛицевойСчет = ЛицевойСчет;
		Движение.Сумма = СуммаГоспошлиныПоРешениюСуда;
		Движение.Организация = пОрганизация; 
		Движение.ПериодВзаиморасчетов = КонецМесяца(МесяцВзаиморасчетов);
	КонецЕсли;
	
	// Представительские Приход
	Если СуммаПредставительскихРасходовПоРешениюСуда<>0 тогда
		Движение = Движения.бит_НачисленияПоУслугамЖКХПоПериоду.Добавить();
		Движение.ВидДвижения = ВидДвиженияНакопления.Приход;
		Движение.Период = Дата;
		Движение.УслугаЖКХ = пПредставительские;
		Движение.ЛицевойСчет = ЛицевойСчет;
		Движение.Сумма = СуммаПредставительскихРасходовПоРешениюСуда;
		Движение.Организация = пОрганизация;
		Движение.ПериодВзаиморасчетов = КонецМесяца(МесяцВзаиморасчетов);
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	Если ТипЗнч(ДанныеЗаполнения) = Тип("ДокументСсылка.бит_РешениеСуда") Тогда
		// Заполнение шапки
		Адрес = ДанныеЗаполнения.Адрес;
		СуммаГоспошлиныПоРешениюСуда = ДанныеЗаполнения.Госпошлина;
		ДатаВступленияВЗаконнуюСилу = ДанныеЗаполнения.ДатаВступленияВЗаконнуюСилу;
		ДатаВынесенияРешенияСуда = ДанныеЗаполнения.ДатаВынесенияРешенияСуда;
		ЛицевойСчет = ДанныеЗаполнения.ЛицевойСчет;
		ПериодОбразованияЗадолженностиОт = ДанныеЗаполнения.ПериодОбразованияЗадолженностиОт;
		ПериодОбразованияЗадолженностиПо = ДанныеЗаполнения.ПериодОбразованияЗадолженностиПо;
		СуммаПредставительскихРасходовПоРешениюСуда = ДанныеЗаполнения.ПредставительскиеРасходы;
		СуммаДолгаПоУслугеПоРешениюСуда = ДанныеЗаполнения.СуммаЗадолженности;
		ВидДокумента = ДанныеЗаполнения.ТипДокумента;
		Услуга = ДанныеЗаполнения.Услуга;
		Заявление = ДанныеЗаполнения.Заявление;
		Для Каждого ТекСтрокаОтветчики Из ДанныеЗаполнения.Ответчики Цикл
			НоваяСтрока = Ответчики.Добавить();
			НоваяСтрока.ФизЛицо = ТекСтрокаОтветчики.ФизЛицо;
		КонецЦикла;
	КонецЕсли;
КонецПроцедуры

Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	Если Ссылка.Пустая() ИЛИ НЕ ЗначениеЗаполнено(Автор) Тогда
		Автор = ПользователиКлиентСервер.ТекущийПользователь(); 
	КонецЕсли; 
		
	Если ОбменДанными.Загрузка = ложь и РежимЗаписи = РежимЗаписиДокумента.Проведение тогда
		//Проверка заполнения   
		Если не ЗначениеЗаполнено(Услуга) тогда
			Отказ = Истина;	
			Сообщить("Не заполнена услуга");
		КонецЕсли;
		
		Если не ЗначениеЗаполнено(ЛицевойСчет) тогда
			Отказ = Истина;	
			Сообщить("Не заполнен лицевой счет");
		КонецЕсли;  
		//Суммы = СуммаДолгаПоУслугеПоРешениюСуда+СуммаГоспошлиныПоРешениюСуда+СуммаПредставительскихРасходовПоРешениюСуда;
		//Если Суммы=0 тогда
		//	Отказ = Истина;	
		//	Сообщить("Сумма по исполнительному листу не должна быть равна 0!");
		//КонецЕсли;  

	КонецЕсли;

КонецПроцедуры

