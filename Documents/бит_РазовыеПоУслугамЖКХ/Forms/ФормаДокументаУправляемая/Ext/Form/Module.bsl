&НаКлиенте
Функция бит_ОбработатьСобытиеСШК(Клиент, ШК)
	
	Результат = Неопределено;
	
	Если ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_РазовыеПоУслугамЖКХ") Тогда
	Иначе
		возврат Результат;
	КонецЕсли;
	
	ДлинаШК = СтрДлина(ШК);
	
	ЧекККМ = ПредопределенноеЗначение("Документ.бит_ЧекККМ.ПустаяСсылка");
			
	Если ДлинаШК = 13 Тогда
		
		ЧекККМ = ЧекККМНаСервере(ШК);
		
	Иначе
		
		Возврат "Считанный штрих код не распознан!!!";
		
	КонецЕсли; 
	
	Если ТипЗнч(Клиент.Ссылка) = Тип("ДокументСсылка.бит_РазовыеПоУслугамЖКХ") Тогда
		
		Клиент.ЧекККМ = ЧекККМ;
		
		Возврат Результат;
		
	КонецЕсли; 
	
КонецФункции

&НаСервере
Функция ЧекККМНаСервере(ШК)

	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЧекККМ.Ссылка
	|ИЗ
	|	Документ.бит_ЧекККМ КАК бит_ЧекККМ
	|ГДЕ
	|	бит_ЧекККМ.ШтрихКодФР = &ШтрихКодФР";
	Запрос.УстановитьПараметр("ШтрихКодФР", ШК);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		ЧекККМ = Выборка.Ссылка;
		
	КонецЕсли;	
	
	Возврат ЧекККМ;	
	
КонецФункции

