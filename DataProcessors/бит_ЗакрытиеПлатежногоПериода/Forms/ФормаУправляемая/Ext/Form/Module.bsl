
#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура выполняет загрузку настроек отбора из настроек по умолчанию.
//
&НаСервере
Процедура ЗагрузитьНастройкиОтбораПоУмолчанию()
	
	СхемаКомпоновкиДанных = Обработки.бит_ЗакрытиеМесяцаЖКХ.ПолучитьМакет("ОсновныеНачисления");
	КомпоновщикНастроек.Инициализировать(
	Новый ИсточникДоступныхНастроекКомпоновкиДанных(ПоместитьВоВременноеХранилище(СхемаКомпоновкиДанных, ЭтаФорма.УникальныйИдентификатор))
	);
	КомпоновщикНастроек.ЗагрузитьНастройки(СхемаКомпоновкиДанных.НастройкиПоУмолчанию);
	КомпоновщикНастроек.Восстановить(СпособВосстановленияНастроекКомпоновкиДанных.ПроверятьДоступность);
	
КонецПроцедуры // ЗагрузитьНастройкиОтбораПоУмолчанию()

#КонецОбласти

#Область ПроцедурыИФункцииУправленияВнешнимВидомФорм

// Процедура осуществляет управление доступностью/видимостью элементов формы.
//
// Параметры:
//  Нет.
//
&НаКлиенте 
Процедура УправлениеЭлементамиФормы()
	
	Элементы.ВидСравненияЗдание.Доступность  = ИспользоватьОтборЗдание;
	Элементы.ВидСравненияУчасток.Доступность = ИспользоватьОтборУчасток;
	Элементы.ВидСравненияРайон.Доступность   = ИспользоватьОтборРайон;
	Элементы.ВидСравненияУлица.Доступность   = ИспользоватьОтборУлица;
	
	Элементы.Здание.Доступность  = ИспользоватьОтборЗдание;
	Элементы.Участок.Доступность = ИспользоватьОтборУчасток;
	Элементы.Район.Доступность   = ИспользоватьОтборРайон;
	Элементы.Улица.Доступность   = ИспользоватьОтборУлица;
	
	Элементы.Выполнить.Доступность   = Объект.ВыполнитьНачисления;
	
КонецПроцедуры // УправлениеЭлементамиФормы()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	ЗагрузитьНастройкиОтбораПоУмолчанию();
	
	Элементы.ВидСравненияЗдание.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ВидСравненияЗдание.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	Элементы.ВидСравненияЗдание.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	Элементы.ВидСравненияЗдание.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	Элементы.ВидСравненияУчасток.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ВидСравненияУчасток.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	Элементы.ВидСравненияУчасток.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	Элементы.ВидСравненияУчасток.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	Элементы.ВидСравненияРайон.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ВидСравненияРайон.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	Элементы.ВидСравненияРайон.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	Элементы.ВидСравненияРайон.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	Элементы.ВидСравненияУлица.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.Равно);
	Элементы.ВидСравненияУлица.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеРавно);
	Элементы.ВидСравненияУлица.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.ВСписке);
	Элементы.ВидСравненияУлица.СписокВыбора.Добавить(ВидСравненияКомпоновкиДанных.НеВСписке);
	
	ВидСравненияРайон   = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияУчасток = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияЗдание  = ВидСравненияКомпоновкиДанных.Равно;
	ВидСравненияУлица   = ВидСравненияКомпоновкиДанных.Равно;
	
	Объект.Организация = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяОрганизация",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	// БИТ_ЖКХ 17.04.2014
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		
		ОбработкаОбъект = ДанныеФормыВЗначение(Объект,Тип("ОбработкаОбъект.бит_ЗакрытиеПлатежногоПериода"));	
		
		бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ОбработкаОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
		
		Объект.Организация = ОбработкаОбъект.Организация;
		
	КонецЕсли;
	// БИТ_ЖКХ 17.04.2014
	
	Объект.ВыполнитьНачисления            = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УправлениеЭлементамиФормы();
	
	Объект.ДатаЗакрытия = КонецДня(бит_ОбщегоНазначения.ПолучитьРабочуюДату());
	
	Если Объект.ДатаЗакрытия < бит_ОбщегоНазначения.ПолучитьДатуЗакрытия(Объект.ДатаЗакрытия, Объект.Организация) Тогда
		
		Элементы.Выполнить.Доступность = Ложь;
		
		Текст = "Текущая ""Дата закрытия: "+ Формат(Объект.ДатаЗакрытия,"ДФ=dd.MM.yyyy") +""" не может быть меньше последнего дня оплаты платежей. Дата последнего дня оплаты на текущий месяц: "+ Формат(бит_ОбщегоНазначения.ПолучитьДатуЗакрытия(Объект.ДатаЗакрытия, Объект.Организация),"ДФ=dd.MM.yyyy") +".";
		бит_ОбщегоНазначения.СообщитьОбОшибке(Текст,,,СтатусСообщения.ОченьВажное);
		
	Иначе
		Элементы.Выполнить.Доступность = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийЭлементовФормы

