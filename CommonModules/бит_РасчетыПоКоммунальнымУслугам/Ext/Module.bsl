	// БИТ_ЖКХ 16.05.2017 14:07:13 Начало правки... 
	|	ТаблицаНорм.РасчетнаяНорма,
	// БИТ_ЖКХ 16.05.2017 14:07:16 Конец правки. 
	|	ТаблицаНорм.СверхНорма,
	|	ТаблицаНорм.Норматив,
	|	ТаблицаНорм.НормаЛьготы,
	|	ТаблицаНорм.Поставщик,
	|	ТаблицаНорм.Факт,
	|	ТаблицаНорм.ПолучательДенежныхСредств,
	|	ТаблицаНорм.Сальдо,
	|	ТаблицаНорм.СальдоНаНачало,
	|	ТаблицаНорм.СальдоПени,
	|	ТаблицаНорм.Оплата,
	|	ТаблицаНорм.Разовые,
	// БИТ_ЖКХ_23082013_начало_изменений
	|	ТаблицаНорм.СтавкаДо,
	|	ТаблицаНорм.СверхномСтавкаДо,
	|	ТаблицаНорм.ПлановаяСтавкаДо,
	|	ТаблицаНорм.ТарифДо,
	|	ТаблицаНорм.ПредельныйИндекс,
	|	ТаблицаНорм.НачислятьПредельныйИндекс,
	|	ТаблицаНорм.ПериодСравнения,
	|	ТаблицаНорм.ГруппаУслуги,
	|	ТаблицаНорм.МойПоставщик,
	|	ТаблицаНорм.ЕдИзм,
	// БИТ_ЖКХ_23082013_окончание_изменений
	|	ТаблицаНорм.Тариф
	|ИЗ
	|	ТаблицаНорм КАК ТаблицаНорм
	|ГДЕ
	
	// БИТ_ЖКХ 07.07.2015{{
	//|	ТаблицаНорм.СпособРасчета <> ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам) 
	//|	И ТаблицаНорм.СпособРасчета <> ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоРаспределению)
	//|	И ТаблицаНорм.ЛицевойСчет В (&ИсхСписокЛС)";
	
	|	ТаблицаНорм.ЛицевойСчет В (&ИсхСписокЛС)" +Текст;
	// БИТ_ЖКХ 07.07.2015}}
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если ТаблицаПроживающих <> Неопределено Тогда
		ТаблицаПроживающих.Индексы.Добавить("ЛицевойСчет,Услуга");	
	КонецЕсли;
	//Результат = Запрос.Выполнить();
	Пока Выборка.Следующий() Цикл
		
		НоваяСтрока = ТаблицаНачислений.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, Выборка);
		
		Норма					= Выборка.Норма;
		НачисленияПроживающих	= 0;
		
		Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим и ТаблицаПроживающих <> Неопределено Тогда
			
			Отбор = Новый Структура;
			Отбор.Вставить("ЛицевойСчет",Выборка.ЛицевойСчет);
			Отбор.Вставить("Услуга"     , Выборка.Услуга);
			СтрокиПоиска = ТаблицаПроживающих.НайтиСтроки(Отбор);
			
			Для каждого Строка Из СтрокиПоиска Цикл
				
				Если Строка.ПроживаниеВданныйМомент Тогда
					
					Норма = Норма - 1;
					
				КонецЕсли; 
				
				НачисленияПроживающих = НачисленияПроживающих + Строка.Начислено;
				
			КонецЦикла; 
			
		КонецЕсли; 
		
		// БИТ_ЖКХ 16.05.2017 14:09:25 Начало правки...
		//НоваяСтрока.Начислено  = Норма * Выборка.Ставка + НачисленияПроживающих + Выборка.СверхНорма * Выборка.СверхномСтавка;
		//
		//// БИТ_ЖКХ_23082013_начало_изменений
		//НоваяСтрока.НачисленоДо  = Норма * Выборка.СтавкаДо + НачисленияПроживающих + Выборка.СверхНорма * Выборка.СверхномСтавкаДо;
		//// БИТ_ЖКХ_23082013_окончание_изменений
		Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающимСНормативом Тогда
			НоваяСтрока.Начислено	= Выборка.Ставка * Выборка.РасчетнаяНорма + НачисленияПроживающих + Выборка.СверхНорма * Выборка.СверхномСтавка;
			НоваяСтрока.НачисленоДо	= Выборка.СтавкаДо * Выборка.РасчетнаяНорма + НачисленияПроживающих + Выборка.СверхНорма * Выборка.СверхномСтавкаДо;
		Иначе
			//УТОЧНИТЬ
			НоваяСтрока.Начислено	= (Норма * Выборка.Ставка + НачисленияПроживающих + Выборка.СверхНорма * Выборка.СверхномСтавка);
			НоваяСтрока.НачисленоДо	= (Норма * Выборка.СтавкаДо + НачисленияПроживающих + Выборка.СверхНорма * Выборка.СверхномСтавкаДо);
		КонецЕсли; 
		// БИТ_ЖКХ 16.05.2017 14:09:25 Конец правки.
		НоваяСтрока.ОбъемДо      = 0;
		
		
		Если НЕ Выборка.Тариф = 0 Тогда
			
			НоваяСтрока.Объем = НоваяСтрока.Начислено/Выборка.Тариф;
			
		КонецЕсли; 
		
		// БИТ_ЖКХ_28082013_начало_изменений
		Если НЕ Выборка.ТарифДо = 0 Тогда
			
			НоваяСтрока.ОбъемДо = НоваяСтрока.НачисленоДо/Выборка.ТарифДо;
			
		КонецЕсли; 
		// БИТ_ЖКХ_28082013_окончание_изменений
		
		НоваяСтрока.Норматив = ?(НоваяСтрока.Начислено <= НоваяСтрока.Норматив, НоваяСтрока.Начислено, НоваяСтрока.Норматив);
		
		НоваяСтрока.КОплате = НоваяСтрока.СальдоНаначало + НоваяСтрока.Начислено + НоваяСтрока.Разовые - НоваяСтрока.Оплата;
		НоваяСтрока.КОплате = ?(НоваяСтрока.КОплате < 0,0,НоваяСтрока.КОплате);
		
		НоваяСтрока.Долг               = ?(Выборка.СальдоНаначало > 0 ,Выборка.СальдоНаначало,0);
		НоваяСтрока.ПереплатаНаначало  = ?(Выборка.СальдоНаначало < 0 ,Выборка.СальдоНаначало,0) * -1;
		НоваяСтрока.КОплатеЗаМесяц     = НоваяСтрока.Начислено + НоваяСтрока.Разовые;
		НоваяСтрока.Переплата          = НоваяСтрока.ПереплатаНаначало  + НоваяСтрока.Начислено + НоваяСтрока.Разовые - НоваяСтрока.Оплата;
		
	КонецЦикла; 
	
	ОбъектСравнения = Новый СравнениеЗначений;
	ТаблицаНачислений.Сортировать("ЛицевойСчет Возр, Приоритет Убыв", ОбъектСравнения);
	
