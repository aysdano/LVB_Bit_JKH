&НаСервере
Процедура ЗаполнитьТаблицуОсновнойЛС()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗависимыеЛС.ЛицевойСчет,
	|	бит_ЗависимыеЛС.ЛицевойСчетЗависимый
	|ИЗ
	|	РегистрСведений.бит_ЗависимыеЛС КАК бит_ЗависимыеЛС
	|ГДЕ
	|	бит_ЗависимыеЛС.ЛицевойСчетЗависимый = &ЛицевойСчет";
	
	Запрос.УстановитьПараметр("ЛицевойСчет",Объект.Ссылка);	
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		ТаблицаОсновнойЛС.Очистить();
		НоваяСтрока = ТаблицаОсновнойЛС.Добавить();
		НоваяСтрока.ЛицевойСчет = ВыборкаДетальныеЗаписи.ЛицевойСчет;
		
	КонецЦикла;
	
КонецПроцедуры

// Служебная процедура для заполнения колонки "Адрес" табличного поля "ТаблицаЗависимыеЛС".
&НаСервере
Процедура ОбновитьДанныеКолонкиАдрес()
	
	СписокЛС = Новый СписокЗначений;	
	
	Для Каждого Эл из ТаблицаЗависимыеЛС Цикл
		
		СписокЛС.Добавить(Эл.ЛицевойСчетЗависимый);	
		
	КонецЦикла;
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета,
	|	бит_ЛицевыеСчета.Здание,
	|	бит_ЛицевыеСчета.Здание.Корпус КАК Корпус,
