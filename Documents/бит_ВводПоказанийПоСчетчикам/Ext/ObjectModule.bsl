	|	Счетчики_Полн.Счетчик.Разрядность КАК Разрядность,
	|	ЕСТЬNULL(ВТ_ПоказанияСчетчиков.ПредыдущиеПоказания, 0) КАК ПредыдущиеПоказания,
	|	ЕСТЬNULL(ВТ_Нормы.НаОдного, 0) КАК НаОдного,
	|	ЕСТЬNULL(ВТ_Нормы.НаДвоих, 0) КАК НаДвоих,
	|	ЕСТЬNULL(ВТ_Нормы.НаСемью, 0) КАК НаСемью,
	|	ЕСТЬNULL(ВТ_Нормы.НаСемью4, 0) КАК НаСемью4,
	|	ЕСТЬNULL(ВТ_Нормы.НаСемью5, 0) КАК НаСемью5,
	|	ЕСТЬNULL(ВТ_Нормы.НаСемью6, 0) КАК НаСемью6,
	|	ЕСТЬNULL(ВТ_Нормы.НаЛицевойСчет, 0) КАК НаЛицевойСчет,
	|	ЕСТЬNULL(ВТ_Нормы.КолПроживающих, 0) КАК КолПроживающих,
	|	ЕСТЬNULL(ВТ_Нормы.ДопНормаНаСемью, 0) КАК ДопНормаНаСемью,
	|	ЕСТЬNULL(ВТ_Нормы.ДопНормаНаКаждого, 0) КАК ДопНормаНаКаждого,
	|	ЕСТЬNULL(ВТ_Нормы.ИспользоватьДопНормуНаОдного, ЛОЖЬ) КАК ИспользоватьДопНормуНаОдного,
	|	Счетчики_Полн.Услуга.Приоритет КАК Приоритет,
	|	Счетчики_Полн.Многотарифный КАК Многотарифный,
	|	ЕСТЬNULL(КолЕд.КоличествоЕдиниц, 0) КАК КоличествоЕдиниц,
	|	ВЫБОР
	|		КОГДА РАЗНОСТЬДАТ(Счетчики_Полн.Период, &КонецПериода, МЕСЯЦ) + 1 > &КолМесяцевПодкрутка
	|			ТОГДА &КолМесяцевПодкрутка
	|		ИНАЧЕ РАЗНОСТЬДАТ(Счетчики_Полн.Период, &КонецПериода, МЕСЯЦ) + 1
	|	КОНЕЦ КАК КоличествоМесяцев,
	|	ЕСТЬNULL(КолЕд.КоличествоМесяцевПодкрутки, 0) КАК КоличествоМесяцевПодкрутки,
	|	ЕСТЬNULL(ВТ_Нормы.УслугаОтключена, ЛОЖЬ) КАК УслугаОтключена,
	|	Счетчики_Полн.СчетчикСЗависимымиУслугами КАК СчетчикСЗависимымиУслугами,
	|	Счетчики_Полн.ОсновнаяУслуга КАК ОсновнаяУслуга
	|ИЗ
	|	Счетчики_Полн КАК Счетчики_Полн
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ПоказанияСчетчиков КАК ВТ_ПоказанияСчетчиков
	|		ПО Счетчики_Полн.Объект = ВТ_ПоказанияСчетчиков.Объект
	|			И Счетчики_Полн.Услуга = ВТ_ПоказанияСчетчиков.Услуга
	|			И Счетчики_Полн.Счетчик = ВТ_ПоказанияСчетчиков.Счетчик
	|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_Нормы КАК ВТ_Нормы
	|		ПО ((ВЫРАЗИТЬ(Счетчики_Полн.Объект КАК Справочник.бит_ЛицевыеСчета)) = ВТ_Нормы.ЛицевойСчет)
	|			И Счетчики_Полн.Услуга = ВТ_Нормы.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ КолЕд КАК КолЕд
	|		ПО Счетчики_Полн.Услуга = КолЕд.УслугаЖКХ
	|			И ((ВЫРАЗИТЬ(Счетчики_Полн.Объект КАК Справочник.бит_ЛицевыеСчета)) = КолЕд.ЛицевойСчет)
	|			И Счетчики_Полн.Счетчик = КолЕд.Счетчик
	|
	|УПОРЯДОЧИТЬ ПО
	|	Приоритет
	|ИТОГИ
	|	МАКСИМУМ(КоличествоМесяцевПодкрутки),
	|	МИНИМУМ(УслугаОтключена),
	|	МАКСИМУМ(СчетчикСЗависимымиУслугами)
	|ПО
	|	Счетчик";
	
	тмпТаблицаПоказаний = ПоказанияПоСчетчикам.ВыгрузитьКолонки();
	тмпТаблицаПоказаний.Колонки.Добавить("Приоритет", ОбщегоНазначения.ОписаниеТипаЧисло(10, 0));
	тмпТаблицаПоказаний.Колонки.Добавить("КоличествоМесяцевПодкруткиПодряд", ОбщегоНазначения.ОписаниеТипаЧисло(4, 0));
	
	ВыборкаСч = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаСч.Следующий() Цикл
		
		ТекПоказания = 0;
		Показания    = 0;
		Выборка      = ВыборкаСч.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.СчетчикСЗависимымиУслугами И НЕ Выборка.ОсновнаяУслуга Тогда
				Продолжить;
			КонецЕсли; 
			
			НовСтрока = тмпТаблицаПоказаний.Добавить();
			
			Если Улица = Справочники.бит_СписокУлиц.ПустаяСсылка() Тогда
				Если ТипЗнч(Выборка.Объект) = Тип("СправочникСсылка.бит_СписокЗданий") Тогда
					НовСтрока.Улица = Выборка.Объект.Улица;
				Иначе
					НовСтрока.Улица = Выборка.Объект.УлицаЛицевогоСчета;
				КонецЕсли;
			Иначе
				НовСтрока.Улица = Улица;
			КонецЕсли;
			
			Если ТипЗнч(Выборка.Объект) = Тип("СправочникСсылка.бит_СписокЗданий") Тогда
				НовСтрока.Дом = Выборка.Объект;
			Иначе
				НовСтрока.ЛицевойСчет = Выборка.Объект;
				НовСтрока.Дом = Выборка.Объект.Здание;
			КонецЕсли;
			
			НовСтрока.Счетчик = Выборка.Счетчик;
			НовСтрока.Услуга = Выборка.Услуга;
			НовСтрока.Разрядность         = Выборка.Разрядность;
			НовСтрока.ПредыдущиеПоказания = Выборка.ПредыдущиеПоказания;
			НовСтрока.Многотарифный       = Выборка.Многотарифный;
			НовСтрока.Приоритет           = Выборка.Приоритет;
			НовСтрока.УслугаОтключена     = Выборка.УслугаОтключена;			
									
			Если ВидОперации = Перечисления.бит_ВидыОперацииВводПоказанийПоСчетчикам.ПоказанияПодкрутки И НЕ ВыборкаСч.УслугаОтключена Тогда
				
				// 25.02.2019
				// 25.04.2019
				если мКоличествоМесяцевПодкрутки <> 0 тогда  
				 НовСтрока.КоличествоМесяцевПодкруткиПодряд = ПолучитьКолвоПодкрутокПодряд(Запрос.Параметры.КонецПериода, НовСтрока.Счетчик, Выборка.Объект, НовСтрока.Услуга, мКоличествоМесяцевПодкрутки);
				конецесли;  
				
				Если НЕ мСчетчикиПодкрутка Тогда
					
					Сообщение = Новый СообщениеПользователю();
					Сообщение.Текст = "Подкрутка счетчиков не ведется по этой организации!";
					Сообщение.Сообщить();
					
					ПоказанияПоСчетчикам.Очистить();
					Возврат;
					
				КонецЕсли; 
				
				Если ТекПоказания <> 0 И НЕ Выборка.Многотарифный Тогда
					
					Если НовСтрока.ПредыдущиеПоказания > 0 Тогда
						
						НовСтрока.ТекущиеПоказания           = ТекПоказания;
						НовСтрока.КоличествоЕдиницПоСчетчику = Показания;
					Иначе
						НовСтрока.ТекущиеПоказания           = 0;
						НовСтрока.КоличествоЕдиницПоСчетчику = 0;
					КонецЕсли;
					
				Иначе
					
					Показания = 0;
					
					// Норма только один раз по услуге.
					МассивПодкруток = Новый Массив;
					Если ТипЗнч(Выборка.Объект) = Тип("СправочникСсылка.бит_СписокЗданий") Тогда
						МассивПодкруток = тмпТаблицаПоказаний.НайтиСтроки(Новый Структура("Дом, Услуга", Выборка.Объект, Выборка.Услуга));
					Иначе	
						МассивПодкруток = тмпТаблицаПоказаний.НайтиСтроки(Новый Структура("ЛицевойСчет, Услуга", Выборка.Объект, Выборка.Услуга));
					КонецЕсли;
					Если МассивПодкруток.Количество() = 1 Тогда
						
						Если (мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднему
							И ВыборкаСч.КоличествоМесяцевПодкрутки < мКоличествоМесяцевПодкрутки)
					// 4.12.2018
							 ИЛИ (( мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаТриМесяцаСПереходомВНорматив ИЛИ
							         мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив )

							// И ВыборкаСч.КоличествоМесяцевПодкрутки < 3)  Тогда
                            // 25.02.2019
							И НовСтрока.КоличествоМесяцевПодкруткиПодряд < 3)  Тогда

							
							 Если Выборка.КоличествоМесяцев > 0 Тогда
								
							 // 05.04.2019 
							  если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаТриМесяцаСПереходомВНорматив или
								    мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив	тогда
								 
							    если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаТриМесяцаСПереходомВНорматив тогда
								 Показания = Окр(Выборка.КоличествоЕдиниц / 3, 4);
							    конецесли;	
							
							    если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив тогда
								 Показания = Окр(Выборка.КоличествоЕдиниц / 6, 4);
							    конецесли;

							  иначе	
							   Если Выборка.КоличествоМесяцев > 0 Тогда
							     Показания = Окр(Выборка.КоличествоЕдиниц / Выборка.КоличествоМесяцев,4);
							   КонецЕсли; 
							  конецесли; 

								
							 КонецЕсли; 
							
						Иначе
							
							Норма     = 0;
							
							Если мПодкруткаНаЛС Тогда
								
								Показания = Окр(Выборка.НаЛицевойСчет, 4);
								
							Иначе
								
								КолПроживающих = ?(Выборка.КолПроживающих = 0, 1, Выборка.КолПроживающих);
								
								Если КолПроживающих = 1 тогда
									Норма  = Выборка.НаОдного + ?(Выборка.ИспользоватьДопНормуНаОдного,Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого,0);
								ИначеЕсли КолПроживающих = 2 тогда
									Норма  = Выборка.НаДвоих * 2 + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * 2; 
								ИначеЕсли КолПроживающих = 3 тогда
									Норма  = Выборка.НаСемью * КолПроживающих + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * КолПроживающих;  
								ИначеЕсли КолПроживающих = 4 тогда
									Норма  = Выборка.НаСемью4 * КолПроживающих + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * КолПроживающих;  
								ИначеЕсли КолПроживающих = 5 тогда
									Норма  = Выборка.НаСемью5 * КолПроживающих + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * КолПроживающих;  
								ИначеЕсли КолПроживающих > 5 тогда
									Норма  = Выборка.НаСемью6 * КолПроживающих + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * КолПроживающих;
								КонецЕсли;
								
								Показания = Окр(Норма, 4);
								
							КонецЕсли; 
							
						КонецЕсли;
					ИначеЕсли МассивПодкруток.Количество() > 1 
						И ((мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднему
							И ВыборкаСч.КоличествоМесяцевПодкрутки < мКоличествоМесяцевПодкрутки)
						    // 4.12.2018	
						     ИЛИ ((мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаТриМесяцаСПереходомВНорматив ИЛИ
						        мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив )

							// И ВыборкаСч.КоличествоМесяцевПодкрутки < 3)  Тогда
                            // 25.02.2019
							И НовСтрока.КоличествоМесяцевПодкруткиПодряд < 3))  Тогда

							// 05.04.2019 
							 если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаТриМесяцаСПереходомВНорматив или
								    мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив	тогда

							   если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаТриМесяцаСПереходомВНорматив тогда
								Показания = Окр(Выборка.КоличествоЕдиниц / 3, 4);
							   конецесли;	
							
							   если мВариантПодкрутки = Перечисления.бит_ВариантыПодкрутки.ПоСреднемуЗаШестьМесяцевСПереходомВНорматив тогда
								Показания = Окр(Выборка.КоличествоЕдиниц / 6, 4);
							   конецесли;
                             иначе
							   Если Выборка.КоличествоМесяцев > 0 Тогда
							     Показания = Окр(Выборка.КоличествоЕдиниц / Выборка.КоличествоМесяцев,4);
							   КонецЕсли; 
							 конецесли;

					КонецЕсли; 
					
					Если НовСтрока.ПредыдущиеПоказания > 0 Тогда
						
						ТекПоказания = НовСтрока.ПредыдущиеПоказания + Показания;
					Иначе
						ТекПоказания = 0;
						Показания = 0;
					КонецЕсли;
					
					Если ТекПоказания > НовСтрока.Разрядность Тогда
						ТекПоказания = ТекПоказания - НовСтрока.Разрядность + 1;
						Показания    = Показания    + 1 ;
					КонецЕсли;
					
					НовСтрока.ТекущиеПоказания           = ТекПоказания;
					НовСтрока.КоличествоЕдиницПоСчетчику = Показания;
					
				КонецЕсли; 
				
			КонецЕсли; 
			
		КонецЦикла; 
		
	КонецЦикла;
	
	тмпТаблицаПоказаний.Сортировать("Дом Возр, ЛицевойСчет Возр, Счетчик Возр, Приоритет Возр");
	ПоказанияПоСчетчикам.Загрузить(тмпТаблицаПоказаний);
	
КонецПроцедуры

#КонецОбласти


#КонецЕсли