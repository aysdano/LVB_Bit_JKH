#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ОбработчикиСобытий

перем мТаблица1_2;
перем мТаблица3_6;


Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	ДатаИзменения = ТекущаяДата();
	Редактор = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");

КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонВыгрузкиГИСЖКХ,"ШаблонПлатежныхДокументов") Тогда
		ПроверяемыеРеквизиты.Добавить("ШаблонИзвещений");
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Функция выполняет сбора данных из базы по выбранному шаблону.
// Возвращаемое значение: Cоответствие, содержащие таблицы значений полученными запросами на основании СКД.
Функция СформироватьДанныеФайла() Экспорт
	МассивТипов = Новый Массив;
	Если ВсеДома ИЛИ Нежилые Тогда
		МассивТипов.Добавить(Справочники.бит_ТипыКвартиры.НежилоеПомещение);
	КонецЕсли;
	
	Если ВсеДома ИЛИ Жилые Тогда
		МассивТипов.Добавить(Справочники.бит_ТипыКвартиры.Коммунальная);
		МассивТипов.Добавить(Справочники.бит_ТипыКвартиры.ОбщежитиеКоридорнаяСистема);
		МассивТипов.Добавить(Справочники.бит_ТипыКвартиры.ОбщежитиеПоквартирноеИлиПокомнатноеЗаселение);
		МассивТипов.Добавить(Справочники.бит_ТипыКвартиры.БлокВДомеБлокированнойЗастройки);
		МассивТипов.Добавить(Справочники.бит_ТипыКвартиры.Отдельная);
		МассивТипов.Добавить(Справочники.бит_ТипыКвартиры.ПустаяСсылка());
	КонецЕсли;
	
	// Сворачивание задвоек в отборах.
	СписокЗданий.Свернуть("Здание");
	СписокУлиц.Свернуть("Улица");
	СписокЛС.Свернуть("ЛицевойСчет");
	
	// Настройки дерева шаблона.
	МассивТиповПоля = Новый Массив;
	МассивТиповПоля.Добавить(Тип("Строка"));
	МассивТиповПоля.Добавить(Тип("СправочникСсылка.бит_ТаблицыШаблоновГИСЖКХ"));
	
	Дерево = Новый ДеревоЗначений;
	Дерево.Колонки.Добавить("Поле" 				   , Новый ОписаниеТипов(МассивТиповПоля,,,,Новый КвалификаторыСтроки(60)));
	Дерево.Колонки.Добавить("СтраницаКолонка"	   , ОбщегоНазначения.ОписаниеТипаЧисло(2,,ДопустимыйЗнак.Неотрицательный));
	Дерево.Колонки.Добавить("НомерНачальнойСтроки" , ОбщегоНазначения.ОписаниеТипаЧисло(2,,ДопустимыйЗнак.Неотрицательный));
		
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.ИмяТаблицы,
	|	бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.Поле,
	|	бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.СтраницаКолонка,
	|	бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.НомерНачальнойСтроки
	|ПОМЕСТИТЬ ВТ_ПоляШаблона
	|ИЗ
	|	Справочник.бит_ШаблоныВыгрузкиГИСЖКХ.ПоляШаблона КАК бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона
	|ГДЕ
	|	бит_ШаблоныВыгрузкиГИСЖКХПоляШаблона.Ссылка = &Шаблон
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_ПоляШаблона.ИмяТаблицы КАК ИмяТаблицы,
	|	ВТ_ПоляШаблона.Поле,
	|	ВТ_ПоляШаблона.СтраницаКолонка,
	|	ВТ_ПоляШаблона.НомерНачальнойСтроки
	|ИЗ
	|	ВТ_ПоляШаблона КАК ВТ_ПоляШаблона
	|ИТОГИ ПО
	|	ИмяТаблицы";
	
	Запрос.УстановитьПараметр("Шаблон", ШаблонВыгрузкиГИСЖКХ);
	
	ВыборкаТаблиц = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	НомерНачальнойСтрокиПоумолчанию = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонВыгрузкиГИСЖКХ, "НомерНачальнойСтроки");
	
	МассивТаблиц = Новый Массив;
	
	// Обход по названию таблицы.
	Пока ВыборкаТаблиц.Следующий() Цикл
		КоллекцияСтрокРодитлей = Дерево.Строки;
		НСтрокаРодитель = КоллекцияСтрокРодитлей.Добавить();
		НСтрокаРодитель.Поле			= ВыборкаТаблиц.ИмяТаблицы;
		
		МассивТаблиц.Добавить(ВыборкаТаблиц.ИмяТаблицы);
		
		ВыборкаПолей = ВыборкаТаблиц.Выбрать();
		Пока ВыборкаПолей.Следующий() Цикл
			// Дозаполняем данные родителя.
			Если ВыборкаПолей.ИмяТаблицы = ВыборкаПолей.Поле Тогда
				НСтрокаРодитель.СтраницаКолонка		 = ВыборкаПолей.СтраницаКолонка;
				НСтрокаРодитель.НомерНачальнойСтроки = ?(ВыборкаПолей.НомерНачальнойСтроки = 0, НомерНачальнойСтрокиПоумолчанию, ВыборкаПолей.НомерНачальнойСтроки);
				Продолжить;
			КонецЕсли;
			
			КоллекцияСтрокРодитлейПолей = НСтрокаРодитель.Строки;
			НСтрокаПоля = КоллекцияСтрокРодитлейПолей.Добавить();
			НСтрокаПоля.Поле			= ВыборкаПолей.Поле;
			НСтрокаПоля.СтраницаКолонка = ВыборкаПолей.СтраницаКолонка;
		КонецЦикла; 
		
	КонецЦикла; 

	Если МассивТаблиц.Количество() = 0 Тогда
		Возврат Неопределено;	
	КонецЕсли;
	
	// Подготовка отборов.
	ЕстьОтборУлиц = СписокУлиц.Количество() > 0;
	ОтборУлицы = Новый СписокЗначений;
	ОтборУлицы.ЗагрузитьЗначения(СписокУлиц.ВыгрузитьКолонку("Улица"));
	
	ЕстьОтборЗданий =  СписокЗданий.Количество() > 0 ;
	ОтборЗдания = Новый СписокЗначений;
	ОтборЗдания.ЗагрузитьЗначения(СписокЗданий.ВыгрузитьКолонку("Здание"));
	
	ЕстьОтборЛС = СписокЛС.Количество() > 0;
	ОтборЛС = Новый СписокЗначений;
	ОтборЛС.ЗагрузитьЗначения(СписокЛС.ВыгрузитьКолонку("ЛицевойСчет"));
	
	ОтборУслуг = новый СписокЗначений;
	для каждого с из Услуги цикл
		Если с.Метка = истина тогда
			ОтборУслуг.Добавить(с.Услуга);
		КонецЕсли;
	КонецЦикла;
	ЕстьОтборУслуг = ОтборУслуг.Количество() > 0;
	
	
	ОтборВидовОплат = новый СписокЗначений;
	для каждого с из ВидыОплат цикл
		Если с.Метка = истина тогда
			ОтборВидовОплат.Добавить(с.ВидОплаты);
		КонецЕсли;
	КонецЦикла;
	ЕстьОтборВидовОплат = ОтборВидовОплат.Количество() > 0;

	
	ЕстьОтборОрганизация = ЗначениеЗаполнено(Организация);
	
	ОтборТипыДомов		= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонВыгрузкиГИСЖКХ, "ТипыДомовГИСЖКХ");
	УслугаСодержания	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонВыгрузкиГИСЖКХ, "УслугаСодержания");
	ЕстьОтборТипыДомов	= ЗначениеЗаполнено(ОтборТипыДомов);
	
	Период = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонВыгрузкиГИСЖКХ,"Период");
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("Период"				, Дата);
	
	// Для устаревший пользовательских макетов СКД.
	СтруктураПараметров.Вставить("ЕстьОтборУлиц"		, ЕстьОтборУлиц); 
	СтруктураПараметров.Вставить("ОтборУлицы"			, ОтборУлицы); 
	СтруктураПараметров.Вставить("ЕстьОтборЗданий"		, ЕстьОтборЗданий); 
	СтруктураПараметров.Вставить("ОтборЗдания"			, ОтборЗдания); 
	СтруктураПараметров.Вставить("ЕстьОтборЛС"			, ЕстьОтборЛС); 
	СтруктураПараметров.Вставить("ОтборЛС"				, ОтборЛС); 
	СтруктураПараметров.Вставить("ЕстьОтборОрганизация"	, ЕстьОтборОрганизация); 
	СтруктураПараметров.Вставить("Организация"			, Организация); 
	СтруктураПараметров.Вставить("ЕстьОтборТипыДомов"	, ЕстьОтборТипыДомов); 
	СтруктураПараметров.Вставить("ОтборТипыДомов"		, ОтборТипыДомов); 
	СтруктураПараметров.Вставить("УслугаСодержания"		, УслугаСодержания);
	СтруктураПараметров.Вставить("ТипКвартиры"			, МассивТипов);
	СтруктураПараметров.Вставить("ЕстьОтборУслуг"		, ЕстьОтборУслуг);
	СтруктураПараметров.Вставить("ОтборУслуг"			, ОтборУслуг);
	СтруктураПараметров.Вставить("ЕстьОтборВидовОплат"	, ЕстьОтборВидовОплат);
	СтруктураПараметров.Вставить("ОтборВидовОплат"		, ОтборВидовОплат);
	
	// Для новых отборов макетов СКД.
	//
	//Если ЕстьОтборУслуг Тогда
	//	СтруктураПараметров.Вставить("ОтборУслуг", ОтборУслуг); 
	//КонецЕсли;
	Если ЕстьОтборУслуг Тогда
		СтруктураПараметров.Вставить("СписокУслуг", ОтборУслуг); 
	КонецЕсли;     
	
	Если ЕстьОтборВидовОплат Тогда
		СтруктураПараметров.Вставить("СписокВидовоплат", ОтборВидовОплат); 
	КонецЕсли;     

	
	Если ЕстьОтборУлиц Тогда
		СтруктураПараметров.Вставить("СписокУлиц", ОтборУлицы); 
	КонецЕсли;
	
	Если ЕстьОтборЗданий Тогда
		СтруктураПараметров.Вставить("СписокЗданий", ОтборЗдания); 
	КонецЕсли;
	
	Если ЕстьОтборЛС Тогда
		СтруктураПараметров.Вставить("СписокЛС", ОтборЛС); 
	КонецЕсли;
	
	Если ЕстьОтборОрганизация Тогда
		СтруктураПараметров.Вставить("ОтборОрганизация", Организация); 
	КонецЕсли;
	
	Если ЕстьОтборТипыДомов Тогда
		СтруктураПараметров.Вставить("ТипДомаГИСЖКХ", ОтборТипыДомов); 
	КонецЕсли;
		
	Если ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонВыгрузкиГИСЖКХ, "ШаблонПлатежныхДокументов") = Истина Тогда
		СтруктураПараметров.Вставить("ШаблонИзвещений"	, ШаблонИзвещений);
		СтруктураПараметров.Вставить("ДолговойПД"		, ДолговойПД);
		СтруктураПараметров.Вставить("ЗаполнятьДопУслуги"	, ВыводитьКоличествоДопУслуг);
	КонецЕсли;
	
	СоответствиеДанныхМакета = ПолучитьДанныеПоСКД(МассивТаблиц, Период, СтруктураПараметров);	
	
	Если НЕ СоответствиеДанныхМакета.Количество() = 0 Тогда
		СоответствиеДанныхМакета.Вставить("Дерево", Дерево);
	КонецЕсли;
	
	Возврат СоответствиеДанныхМакета	
	
КонецФункции
	

Функция ПолучитьДанныеПоСКД(МассивТаблиц, Период, СтруктураПараметров)
	
	СоответствиеДанныхМакета = Новый Соответствие;
	
	Запрос = Новый Запрос;
	Запрос.Текст =
		"ВЫБРАТЬ
		|	бит_СКДТаблицГИСЖКХСрезПоследних.ТаблицаШаблонаГИСЖКХ КАК ТаблицаШаблонаГИСЖКХ,
		|	бит_СКДТаблицГИСЖКХСрезПоследних.СхемаКомпоновкиДанных КАК СхемаКомпоновкиДанных
		|ИЗ
		|	РегистрСведений.бит_СКДТаблицГИСЖКХ.СрезПоследних(&Период, ТаблицаШаблонаГИСЖКХ В (&МассивТаблиц)) КАК бит_СКДТаблицГИСЖКХСрезПоследних
		|АВТОУПОРЯДОЧИВАНИЕ";
	
	Запрос.УстановитьПараметр("Период", Период);
	Запрос.УстановитьПараметр("МассивТаблиц", МассивТаблиц);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		СКД          = Выборка.СхемаКомпоновкиДанных.Получить();
		Настройки    = СКД.ВариантыНастроек.Основной.Настройки;
		//Настройки    = СКД.НастройкиПоУмолчанию;
		Для Каждого ЭлементСтруктурыПараметров Из СтруктураПараметров Цикл
			ПараметрСКД = Настройки.ПараметрыДанных.Элементы.Найти(ЭлементСтруктурыПараметров.Ключ);
			Если ПараметрСКД <> Неопределено Тогда
				ПараметрСКД.Значение      = ЭлементСтруктурыПараметров.Значение;
				Если значениезаполнено(ЭлементСтруктурыПараметров.Значение) тогда
					ПараметрСКД.Использование = Истина;
				иначе
					ПараметрСКД.Использование = Ложь;
				КонецЕсли;
				
			КонецЕсли;
		КонецЦикла;
		
 		Если Выборка.ТаблицаШаблонаГИСЖКХ = Справочники.бит_ТаблицыШаблоновГИСЖКХ.ТаблицаПоставщиковУслугМО Тогда
			ТЗПоставщиков = ТаблицаСКД(СКД, Настройки, СтруктураПараметров);			
						
			ТаблицаПоставщиковУслугМО = ПодготовитьТаблицуПоставщиковМО(ТЗПоставщиков); // Группировка по поставщикам, не более 4 услуг по приоритету.
			СоответствиеДанныхМакета.Вставить(Выборка.ТаблицаШаблонаГИСЖКХ, ТаблицаПоставщиковУслугМО); 
		Иначе		
			
			//25.12.2019
			если Выборка.ТаблицаШаблонаГИСЖКХ.Наименование = "Таблица платежных документов 1-2 2020" или 
				Выборка.ТаблицаШаблонаГИСЖКХ.Наименование = "Таблица платежных документов 1-2 (кап. рем.)2020"
				или Выборка.ТаблицаШаблонаГИСЖКХ.Наименование = "Таблица платежных документов 1-2 2024" тогда
				ТЗПоставщиков = ТаблицаСКД(СКД, Настройки, СтруктураПараметров);
				СоответствиеДанныхМакета.Вставить(Выборка.ТаблицаШаблонаГИСЖКХ, ТЗПоставщиков); 
			иначе
				если Выборка.ТаблицаШаблонаГИСЖКХ.Наименование = "Таблица платежных документов 3-6 2020" или 
					// БИТ ЖКХ 23.03.2020
					Выборка.ТаблицаШаблонаГИСЖКХ.Наименование = "Таблица платежных документов 3-6 (кап. рем.)2020"тогда
					ТЗПоставщиков = ТаблицаСКД(СКД, Настройки, СтруктураПараметров);
					СоответствиеДанныхМакета.Вставить(Выборка.ТаблицаШаблонаГИСЖКХ, ТЗПоставщиков); 
				иначе
					если Выборка.ТаблицаШаблонаГИСЖКХ.Наименование = "Таблица платежных документов платежные реквизиты"
						ИЛИ Выборка.ТаблицаШаблонаГИСЖКХ.Наименование = "Таблица платежных документов платежные реквизиты 1" тогда
						ТЗПоставщиков = ТаблицаСКД(СКД, Настройки, СтруктураПараметров);
						СоответствиеДанныхМакета.Вставить(Выборка.ТаблицаШаблонаГИСЖКХ, ТЗПоставщиков);	  
					иначе
						
						// БИТ ЖКХ 23.04.2020   
						если Выборка.ТаблицаШаблонаГИСЖКХ.Наименование = "Таблица помещений" тогда 
							
							таблицаПомещений = ТаблицаСКД(СКД, Настройки, СтруктураПараметров);		
							если ЭтотОбъект.ВыводитьКомнаты = ложь тогда
								таблицаПомещений.Свернуть("АдресПомещения, КодФИАС_ИдентификаторГИСЖКХ, НомерЗаписи, НомерЛС, НомерПомещения, ТипПомещенияБлок, УникальныйНомерГИСЖКХ");
								таблицаПомещений.Колонки.Добавить("НомерКомнаты");
							конецесли;	
							СоответствиеДанныхМакета.Вставить(Выборка.ТаблицаШаблонаГИСЖКХ, таблицаПомещений); 
							
						иначе	
