&НаКлиенте
Процедура УстановитьКодВсе(Команда)
	
	Для каждого СтрокаТаблицы Из СписокКодовПлательщиков Цикл
		
		// БИТ_ЖКХ 16.12.2014{{
		Если СтрДлина(СтрокаТаблицы.ЛицевойСчет) <= 10 Тогда
			
			СтрокаТаблицы.НовыйКодГЦЖС = Строка(СтрокаТаблицы.ЛицевойСчет);
			// БИТ_ЖКХ 16.12.2014}}	
			
		Иначе

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Длина наименования лицевого счета: "+СтрокаТаблицы.ЛицевойСчет+" превышает 10 символов(Длина кода ГКУ ИС).");
			
		КонецЕсли;
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПоТекущейСтроке(Команда)
	
	ТекущиеДанные = Элементы.СписокКодовПлательщиков.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные = Неопределено Тогда
		
		// БИТ_ЖКХ 16.12.2014{{
		Если СтрДлина(ТекущиеДанные.ЛицевойСчет) <= 10 Тогда
			ТекущиеДанные.НовыйКодГЦЖС =  Строка(ТекущиеДанные.ЛицевойСчет);
			// БИТ_ЖКХ 16.12.2014}}	
			
		Иначе

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Длина наименования лицевого счета: "+ТекущиеДанные.ЛицевойСчет+" превышает 10 символов(Длина кода ГКУ ИС).");
			
		КонецЕсли;
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоТаблице(Команда)
	
	Для каждого СтрокаТаблицы Из СписокКодовПлательщиков Цикл
		СтрокаТаблицы.НовыйКодГЦЖС = "";
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьПоСтроке(Команда)
	ТекущиеДанные = Элементы.СписокКодовПлательщиков.ТекущиеДанные;
	
	Если НЕ ТекущиеДанные = Неопределено Тогда
		ТекущиеДанные.НовыйКодГЦЖС = "";
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура ПолучитьТаблицуЛицевыхСчетов()
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	
	ПостроительЗапроса.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.КодПоГУГЦЖС КАК НовыйКодГЦЖС,
	|	бит_ЛицевыеСчета.КодПоГУГЦЖС КАК СтарыйКодГЦЖС,
	|	бит_ЛицевыеСчета.Наименование КАК Наименование,
	|	бит_ЛицевыеСчета.Здание,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета,
	|	бит_ЛицевыеСчета.Квартира
	|{ВЫБРАТЬ
	|	Здание.*,
	|	УлицаЛицевогоСчета.*,
	|	Квартира.*}
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|{ГДЕ
	|	бит_ЛицевыеСчета.Здание.*,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета.*,
	|	бит_ЛицевыеСчета.Квартира.*}
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование";
	
	ПостроительЗапроса.Выполнить();
	
	СписокКодовПлательщиков.Очистить();
	
	Если ЗначениеЗаполнено(Улица) Тогда
		
		ПостроительЗапроса.Отбор.Добавить("УлицаЛицевогоСчета");
		ПостроительЗапроса.Отбор["УлицаЛицевогоСчета"].Использование = Истина;
		ПостроительЗапроса.Отбор["УлицаЛицевогоСчета"].ВидСравнения  = ВидСравнения.Равно;
		ПостроительЗапроса.Отбор["УлицаЛицевогоСчета"].Значение      = Улица;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Здание) Тогда
		
		ПостроительЗапроса.Отбор.Добавить("Здание");
		ПостроительЗапроса.Отбор["Здание"].Использование = Истина;
		ПостроительЗапроса.Отбор["Здание"].ВидСравнения  = ВидСравнения.Равно;
		ПостроительЗапроса.Отбор["Здание"].Значение      = Здание;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(Квартира) Тогда
		
		ПостроительЗапроса.Отбор.Добавить("Квартира");
		ПостроительЗапроса.Отбор["Квартира"].Использование = Истина;
		ПостроительЗапроса.Отбор["Квартира"].ВидСравнения  = ВидСравнения.Равно;
		ПостроительЗапроса.Отбор["Квартира"].Значение      = Квартира;
		
	КонецЕсли; 
	
	СписокКодовПлательщиков.Загрузить(ПостроительЗапроса.Результат.Выгрузить());
	
КонецПроцедуры

#КонецОбласти