Функция ПолучитьОстатокПоКР(пЗдание, пНачисление = Истина)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА &Начисление
	|			ТОГДА лб_ОстаткиПоКРОстатки.НачисленоОстаток
	|		ИНАЧЕ лб_ОстаткиПоКРОстатки.ОплаченоОстаток
	|	КОНЕЦ КАК Остаток
	|ИЗ
	|	РегистрНакопления.лб_ОстаткиПоКР.Остатки(, Здание = &Здание) КАК лб_ОстаткиПоКРОстатки";
	
	Запрос.УстановитьПараметр("Здание", пЗдание);
	Запрос.УстановитьПараметр("Начисление", пНачисление);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Выборка = РезультатЗапроса.Выбрать();
	
	Если Выборка.Следующий() Тогда
		Возврат Выборка.Остаток;
	Иначе 
		Возврат 0;
	КонецЕсли;
	КонецФункции

Функция ПолучитьСальдо(Дата = Неопределено,РасчетныйСчет,Организация)
		
Проверка = СтрНайти(Организация,"ЛЕВОБЕРЕЖЬЕ");	
Запрос = Новый Запрос; 
Если Проверка <> 0 Тогда
Запрос.УстановитьПараметр("Период",Дата)
Иначе
Запрос.УстановитьПараметр("Период",ДобавитьМесяц(Дата,-1));
КонецЕсли;
Запрос.УстановитьПараметр("РасчетныйСчет",РасчетныйСчет);
Запрос.Текст = "ВЫБРАТЬ
               |	бит_СальдоПоРасчетномуСчетуСрезПоследних.Сальдо КАК Сальдо
               |ИЗ
               |	РегистрСведений.бит_СальдоПоРасчетномуСчету.СрезПоследних(&Период, ) КАК бит_СальдоПоРасчетномуСчетуСрезПоследних
               |ГДЕ
               |	бит_СальдоПоРасчетномуСчетуСрезПоследних.РасчетныйСчет = &РасчетныйСчет";
			   
Результат = Запрос.Выполнить();
Выборка = Результат.Выбрать();

  Если Выборка.Следующий() Тогда 	
    Возврат Выборка.Сальдо 
  Иначе 
    Возврат 0; 
    КонецЕсли;	

КонецФункции	

Функция ПолучитьТекстДляКвитанции()
	
	Запрос = Новый Запрос;  
	Запрос.УстановитьПараметр("Дата", ТекущаяДата());		
	
Запрос.Текст = "ВЫБРАТЬ
|	бит_НадписьКвитанцииСрезПоследних.ОсновнаяНадпись КАК ОсновнаяНадпись
|ИЗ
|	РегистрСведений.бит_НадписьКвитанции.СрезПоследних(&Дата, ) КАК бит_НадписьКвитанцииСрезПоследних
|ГДЕ
|	бит_НадписьКвитанцииСрезПоследних.ШаблонКвитанции.Наименование = ""Квитанция за капитальный ремонт""";
	
Результат = Запрос.Выполнить();
Выборка = Результат.Выбрать();

 Если Выборка.Следующий() Тогда  
	
Возврат  Выборка.ОсновнаяНадпись
 Иначе
 Возврат " ";
 
КонецЕсли;  

