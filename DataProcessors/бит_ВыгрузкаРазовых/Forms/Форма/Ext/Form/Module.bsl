&НаКлиенте
Процедура СформироватьФайлCSV(Команда)
	
	ОчиститьСообщения();
	
	Если Не ЗначениеЗаполнено(Каталог) Тогда
		Сообщить("Не заполнен каталог!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(НачалоПериода) Тогда
		Сообщить("Не заполнено начало периода!");
		Возврат;
	КонецЕсли; 
	
	Если Не ЗначениеЗаполнено(КонецПериода) Тогда
		Сообщить("Не заполнен конец периода!");
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Организация) Тогда
		Сообщить("Не заполнена организация!");
		Возврат;
	КонецЕсли;
	
	ПолучитьДанныеНаСервере();
	//Если Не ТаблицаИтог.Количество() = 0 Тогда
		СформироватьФайлXLSНаКлиенте();	
	//Иначе	
	//	Сообщить("Не найдены данные для сохранения в файл csv!");	
	//КонецЕсли;
	
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьДанныеНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	
	Макет = РеквизитФормыВЗначение("Объект").ПолучитьМакет("Макет");
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет КАК Справочник.бит_ЛицевыеСчета) КАК LS,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ КАК Услуга,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор КАК Ссылка,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.НомерСтроки КАК НомерСтроки,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодСекунда КАК Период,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодМесяц КАК PER,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаПриход КАК Сумма,
		|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание.Район КАК Справочник.бит_АдминистративныеОкруга) КАК F,
		|	ВЫБОР
		|		КОГДА бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры ЕСТЬ NULL
		|				ИЛИ бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры = """"
		|			ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира
		|		ИНАЧЕ бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры
		|	КОНЕЦ КАК NKV,
		|	ЕСТЬNULL(лб_ПредставлниеЗданий.Представление, бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание) КАК DOM,
		|	ВЫБОР
		|		КОГДА бит_СведенияОКвартиреСрезПоследних.Квартира.Подъезд ЕСТЬ NULL
		|				ИЛИ бит_СведенияОКвартиреСрезПоследних.Квартира.Подъезд = """"
		|			ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира.Подъезд
		|		ИНАЧЕ бит_СведенияОКвартиреСрезПоследних.Квартира.Подъезд
		|	КОНЕЦ КАК POD
		|ПОМЕСТИТЬ ВТ_Данные
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Авто,
		|			Организация = &Организация
		|				И УслугаЖКХ В (&Начисления)
		|				И 1 = 1
		|				И ЛицевойСчет.Здание.Район В (&Участки)) КАК бит_НачисленияПоУслугамЖКХПоПериодуОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&ДатаОкончания, ТипКвартиры В (&ТипыКвартир)) КАК бит_СведенияОКвартиреСрезПоследних
		|		ПО бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_ПредставлниеЗданий КАК лб_ПредставлниеЗданий
		|		ПО бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание = лб_ПредставлниеЗданий.Здание
		|ГДЕ
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет КАК Справочник.бит_ЛицевыеСчета),
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.НомерСтроки,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодСекунда,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодМесяц,
		|	-бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаРасход,
		|	ВЫРАЗИТЬ(бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание.Район КАК Справочник.бит_АдминистративныеОкруга),
		|	ВЫБОР
		|		КОГДА бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры ЕСТЬ NULL
		|				ИЛИ бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры = """"
		|			ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира
		|		ИНАЧЕ бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры
		|	КОНЕЦ,
		|	ЕСТЬNULL(лб_ПредставлниеЗданий.Представление, бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание),
		|	ВЫБОР
		|		КОГДА бит_СведенияОКвартиреСрезПоследних.Квартира.Подъезд ЕСТЬ NULL
		|				ИЛИ бит_СведенияОКвартиреСрезПоследних.Квартира.Подъезд = """"
		|			ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира.Подъезд
		|		ИНАЧЕ бит_СведенияОКвартиреСрезПоследних.Квартира.Подъезд
		|	КОНЕЦ
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
		|			&ДатаНачала,
		|			&ДатаОкончания,
		|			Авто,
		|			Организация = &Организация
		|				И УслугаЖКХ В (&Начисления)
		|				И 1 = 1
		|				И ЛицевойСчет.Здание.Район В (&Участки)) КАК бит_НачисленияПоУслугамЖКХПоПериодуОбороты
		|		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&ДатаОкончания, ТипКвартиры В (&ТипыКвартир)) КАК бит_СведенияОКвартиреСрезПоследних
		|		ПО бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_ПредставлниеЗданий КАК лб_ПредставлниеЗданий
		|		ПО бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет.Здание = лб_ПредставлниеЗданий.Здание
		|ГДЕ
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗЛИЧНЫЕ
		|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	МАКСИМУМ(бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК ФизЛицо
		|ПОМЕСТИТЬ ВТ_ФИО
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
		|			,
		|			СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
		|				И ЛицевойСчет В
		|					(ВЫБРАТЬ
		|						ВТ_Данные.LS КАК LS
		|					ИЗ
