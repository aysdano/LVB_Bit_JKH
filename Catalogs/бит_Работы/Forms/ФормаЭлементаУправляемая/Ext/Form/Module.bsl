&НаСервере
Процедура ПрочитатьДанныеНабораЗаписейНаСервере()
	
	бит_КоэффициентыНормОбъект = ДанныеФормыВЗначение(КоэффициентыНорм, Тип("РегистрСведенийНаборЗаписей.бит_КоэффициентыНорм"));
	бит_КоэффициентыНормОбъект.Прочитать();
	
	ЗначениеВДанныеФормы(бит_КоэффициентыНормОбъект,КоэффициентыНорм);
	
КонецПроцедуры

&НаКлиенте
Процедура СтраницыПриСменеСтраницы(Элемент, ТекущаяСтраница)
	
	Если ТекущаяСтраница.Заголовок = "Нормы труда" Тогда
		
		ЭтаФорма.НормыТруда.Отбор.Элементы.Очистить();
		
		Эл = ЭтаФорма.НормыТруда.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Владелец");
		Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
		Эл.ПравоеЗначение   = Объект.Ссылка;
		Эл.Использование    = Истина;
		Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
	ИначеЕсли ТекущаяСтраница.Заголовок = "Коэффициенты норм" Тогда
		
		ПрочитатьДанныеНабораЗаписейНаСервере();
		
	ИначеЕсли ТекущаяСтраница.Заголовок = "Состав работ" Тогда
		
		УстановитьОтборы();
		
	КонецЕсли;
	 
КонецПроцедуры

&НаКлиенте
Процедура СоставРаботВыбор(Элемент, ВыбраннаяСтрока, Поле, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Если ВыбраннаяСтрока <> Неопределено тогда
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Ключ",ВыбраннаяСтрока);
		
		НоваяФорма = ОткрытьФорму("Документ.бит_УстановкаСоставаРаботы.Форма.ФормаДокументаУправляемая",ПараметрыФормы,ЭтаФорма);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоставРаботПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если Параметры.Ключ.Пустая() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Сначала сохраните справочник");
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	Если Не Копирование Тогда
		
		Отказ = Истина;

		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Работа",           Объект.Ссылка);
		ПараметрыФормы.Вставить("ЕдиницаИзмерения", Объект.ОсновнаяЕдиницаИзмерения);
		
		ОткрытьФорму("Документ.бит_УстановкаСоставаРаботы.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзСправочникаРаботы", ПараметрыФормы), Элемент);

	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДобавитьКоэффициентНорм(Команда)
	
	Если ЭтаФорма.Модифицированность = Истина ИЛИ Параметры.Ключ.Пустая() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Перед добавлением коэффициентов элемент необходимо записать.");
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Работа",Объект.Ссылка);
	ПараметрыФормы.Вставить("Период",ТекущаяДата());
	ПараметрыФормы.Вставить("ЕдиницаИзмерения",Объект.ОсновнаяЕдиницаИзмерения);
	
	ПараметрыФормы.Вставить("Работа",Объект.Ссылка);
	
	
	ФормаОткрытия = ОткрытьФорму("РегистрСведений.бит_КоэффициентыНорм.Форма.ФормаЗаписиУправляемая",Новый Структура("ЗаполнитьИзСправочникаРаботы",ПараметрыФормы),ЭтаФорма);

КонецПроцедуры

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьКоэффициенты" Тогда
		
		ПрочитатьДанныеНабораЗаписейНаСервере();
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЦеныРаботПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа, Параметр)
	
	Если ЭтаФорма.Модифицированность = Истина ИЛИ Параметры.Ключ.Пустая() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Сначала сохраните справочник");
		
		Отказ = Истина;
		Возврат;
		
	КонецЕсли;
	
	Если Не Копирование Тогда
		
		Отказ = Истина;
		
		
		ПараметрыФормы = Новый Структура;
		
		Если Объект.Подразделения.Количество() <> 0  Тогда
			Подразделение = Объект.Подразделения[0].Подразделение;
		КонецЕсли; 
		
		ПараметрыФормы.Вставить("Подразделение",Подразделение);
		ПараметрыФормы.Вставить("Работа",Объект.Ссылка);
		ПараметрыФормы.Вставить("Норма",Объект.ОсновнаяНормаТруда);
		
		ЕдиницаИзмерения = ЕдиницаИзмеренияНаСервере(Объект.ОсновнаяНормаТруда);
		ПараметрыФормы.Вставить("ЕдиницаИзмерения",ЕдиницаИзмерения);
		
		НоваяФорма = ОткрытьФорму("Документ.бит_УстановкаЦенРабот.Форма.ФормаДокументаУправляемая",Новый Структура("СоздатьИзСправочникаРаботы",ПараметрыФормы),ЭтаФорма);	
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Функция ЕдиницаИзмеренияНаСервере(ОсновнаяНормаТруда)

	Возврат ОсновнаяНормаТруда.ЕдиницаИзмерения;

КонецФункции

#КонецОбласти
