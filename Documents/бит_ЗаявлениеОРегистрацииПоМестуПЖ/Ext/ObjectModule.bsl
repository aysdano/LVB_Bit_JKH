				ШапкаОбласть1.Параметры.ОрганУчета 			= ?(ЗначениеЗаполнено(Выборка.ОрганФМСПрибытия), Строка(Выборка.ОрганФМСПрибытия), "");
				
				ШапкаОбласть1.Параметры.ОрганУчетаПрописки 	= Выборка.ДомРег.ПаспортнаяСлужба;

				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ПочтовыйАдрес, 40, АдресРегистрации_1 , АдресРегистрации_2 );
				ШапкаОбласть1.Параметры.АдресРегистрации_1 =  АдресРегистрации_1;
				ШапкаОбласть1.Параметры.АдресРегистрации_2 =  АдресРегистрации_2;
				
				ШапкаОбласть1.Параметры.ЗаконныйПредставитель_1 =  ЗаконныйПредставитель_1;
				ШапкаОбласть1.Параметры.ЗаконныйПредставитель_2 =  ЗаконныйПредставитель_2;
				
				Если ЗначениеЗаполнено(ВыборкаАдрПриб.Представление) Тогда
					АдресРегистрации_1_1 = "";
					АдресРегистрации_1_2 = "";
					бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ВыборкаАдрПриб.Представление, 25, АдресРегистрации_1_1 , АдресРегистрации_1_2 );
					ШапкаОбласть1.Параметры.АдресПрибытия_2_1 = АдресРегистрации_1_1;
					ШапкаОбласть1.Параметры.АдресПрибытия_2_2 = АдресРегистрации_1_2;
				КонецЕсли; 
				
			Иначе
				ШапкаОбласть1.Параметры.ОрганУчета 			= Выборка.ДомРег.ПаспортнаяСлужба;
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ПочтовыйАдрес, 50, АдресРегистрации_1 , АдресРегистрации_2 );
				ШапкаОбласть1.Параметры.АдресПрибытия_2_1 	= АдресРегистрации_1;
				ШапкаОбласть1.Параметры.АдресПрибытия_2_2 	= АдресРегистрации_2;
				ШапкаОбласть1.Параметры.ОрганУчетаПрописки 	= ?(ЗначениеЗаполнено(Выборка.ОрганФМСПрибытия), Строка(Выборка.ОрганФМСПрибытия), "");
				
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(СтрокаАдрУбыт, 40, АдресРегистрации_1 , АдресРегистрации_2 );
				ШапкаОбласть1.Параметры.АдресРегистрации_1 =  АдресРегистрации_1;
				ШапкаОбласть1.Параметры.АдресРегистрации_2 =  АдресРегистрации_2;
				
			КонецЕсли; 

			ШапкаОбласть1.Параметры.ВыданДокумент_1 	= Строка(Выборка.ВыданДокумент);
			
			ШапкаОбласть1.Параметры.ФизЛицо 			= ФизЛицо;
			
			ШапкаОбласть1.Параметры.ЧислоТек    = Формат(Дата,"ДФ=dd");
			ДатаМесяц 							= Формат(Дата,"ДФ='дд.ММММ  yyyy '");
			ШапкаОбласть1.Параметры.МесяцГодТек = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			
			Если ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента) Тогда
				ШапкаОбласть1.Параметры.ДатаВыдачиДокумента  	= День(Выборка.ДатаВыдачиДокумента);
				ДатаМесяц 										= Формат(Выборка.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
				ШапкаОбласть1.Параметры.МесяцВыдачиДокумента 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
				ШапкаОбласть1.Параметры.ГодВыдачиДокумента   	= Формат(Выборка.ДатаВыдачиДокумента,"ДФ=yyyy");
				ШапкаОбласть1.Параметры.ВидДокумента_1 			= ВидДокумента_1; 
			КонецЕсли;	
			
			ШапкаОбласть1.Параметры.ЗаконныйПредставитель_1 = ЗаконныйПредставитель_1;
			ШапкаОбласть1.Параметры.ЗаконныйПредставитель_2 = ЗаконныйПредставитель_2;
			
		КонецЕсли;
		
		Если ВидОперации <> Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.СнятиеСРегистрационногоУчета или ПечатьДвухЧастей Тогда
			ДокОснование 	= Выборка.ДокументОснование;
			ДокументОснование_1 = "";
			ДокументОснование_2 = "";
			Если ДокОснование <> Неопределено Тогда
				ДокОснованиеСтр = Строка(ДокОснование) + ?(ЗначениеЗаполнено(ДокОснование.НомерДокумента)," №"+ Строка(ДокОснование.НомерДокумента),"");
				ДокОснованиеСтр = ДокОснованиеСтр + ?(ЗначениеЗаполнено(ДокОснование.ДатаДокумента)," от "+ Формат(ДокОснование.ДатаДокумента,"ДФ='dd.MM.yyyy ""г.""'"),"") ; 
				ДокОснованиеСтр = ДокОснованиеСтр + ?(ЗначениеЗаполнено(ДокОснование.ОрганизацияВыдавшаяДокумент)," , выдан "+ Строка(ДокОснование.ОрганизацияВыдавшаяДокумент.НаименованиеПолное), "");
				бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ДокОснованиеСтр, 95, ДокументОснование_1,ДокументОснование_2);
			КонецЕсли; 
			ПринятоеРешение_1 = "";
			ПринятоеРешение_2 = "";
			
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ПринятоеРешение, 85, ПринятоеРешение_1 , ПринятоеРешение_2 );
			
			ШапкаОбласть.Параметры.Заполнить(Выборка);
			
			ОрганУчета_1 = "";
			ОрганУчета_2 = "";
			бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ДомРег.ПаспортнаяСлужба, 65, ОрганУчета_1 , ОрганУчета_2);
			ШапкаОбласть.Параметры.ОрганУчета_1			= ОрганУчета_1;
			ШапкаОбласть.Параметры.ОрганУчета_2			= ОрганУчета_2;
			ШапкаОбласть.Параметры.ВыданДокумент_1 		= Строка(Выборка.ВыданДокумент);
			ШапкаОбласть.Параметры.ДокументОснование1 	= ДокументОснование_1;
			ШапкаОбласть.Параметры.ДокументОснование2 	= ДокументОснование_2;
			ШапкаОбласть.Параметры.ЗаконныйПредставитель_1 = ЗаконныйПредставитель_1;
			ШапкаОбласть.Параметры.ЗаконныйПредставитель_2 = ЗаконныйПредставитель_2;
			ШапкаОбласть.Параметры.Ответственный 		= Ответственный  + 
			?(ЗначениеЗаполнено(СтепеньРодства),", " + НРег(Строка(СтепеньРодства)), "");
			
			ШапкаОбласть.Параметры.ФизЛицо 				  = ФизЛицо;    
			
			ШапкаОбласть.Параметры.АдресПрибытия     	  = бит_УправлениеКонтактнойИнформацией.ПолучитьПредставлениеАдреса(ВыборкаАдрПриб);
			
			ШапкаОбласть.Параметры.ЧислоТек    	= Формат(Дата,"ДФ=dd");
			ДатаМесяц 							= Формат(Дата,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцТек    	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодТек      	= Формат(Дата,"ДФ=yy");
			
			ШапкаОбласть.Параметры.ЧислоРеш    	= Формат(ДатаРегистрации,"ДФ=dd");
			ДатаМесяцРеш 						= Формат(ДатаРегистрации,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРеш    	= Сред(ДатаМесяцРеш, 4, СтрДлина(ДатаМесяцРеш));
			ШапкаОбласть.Параметры.ГодРеш4     	= Формат(ДатаРегистрации,"ДФ=yyyy");
			ШапкаОбласть.Параметры.ДолжностноеЛицоОрганизации  = ДолжностноеЛицоОрганизации;
			ШапкаОбласть.Параметры.ПринятоеРешение_1     = ПринятоеРешение_1;
			ШапкаОбласть.Параметры.ПринятоеРешение_2     = ПринятоеРешение_2;
			
			Если ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента) Тогда
				ШапкаОбласть.Параметры.ДатаВыдачиДокумента  = День(Выборка.ДатаВыдачиДокумента);
				ДатаМесяц 									= Формат(Выборка.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
				ШапкаОбласть.Параметры.МесяцВыдачиДокумента = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
				ШапкаОбласть.Параметры.ГодВыдачиДокумента   = Формат(Выборка.ДатаВыдачиДокумента,"ДФ=yyyy");
			КонецЕсли;
			
			ШапкаОбласть.Параметры.ВидДокумента_1 		= ВидДокумента_1; 
			Если ЗначениеЗаполнено(ВыборкаАдр.Представление) Тогда
				
				Если ЗначениеЗаполнено(ВыборкаАдр.Поле5) Тогда
					ШапкаОбласть.Параметры.НаселенныйПунктРег = ВыборкаАдр.Поле5;
				ИначеЕсли ЗначениеЗаполнено(ВыборкаАдр.Поле4) Тогда
					ШапкаОбласть.Параметры.НаселенныйПунктРег = ВыборкаАдр.Поле4;
				ИначеЕсли ЗначениеЗаполнено(ВыборкаАдр.Поле3) Тогда
					ШапкаОбласть.Параметры.НаселенныйПунктРег = ВыборкаАдр.Поле3;
				ИначеЕсли ЗначениеЗаполнено(ВыборкаАдр.Поле2) Тогда
					ШапкаОбласть.Параметры.НаселенныйПунктРег = ВыборкаАдр.Поле2;
				КонецЕсли; 
				
				ШапкаОбласть.Параметры.УлицаРег    			= ВыборкаАдр.Поле6;
				ШапкаОбласть.Параметры.ДомРег  				= ВыборкаАдр.Поле7;
				ШапкаОбласть.Параметры.КорпусРег   			= ВыборкаАдр.Поле8;
				ШапкаОбласть.Параметры.КвартираРег 			= ВыборкаАдр.Поле9;
				
			Иначе
				
				Если СтруктураПочтАдрес <> Неопределено И НЕ СтруктураПочтАдрес.Свойство("ЗаПределамиРФ") Тогда
					Если ЗначениеЗаполнено(СтруктураПочтАдрес.НаселенныйПункт) Тогда
						ШапкаОбласть.Параметры.НаселенныйПунктРег = СтруктураПочтАдрес.НаселенныйПункт;
					ИначеЕсли ЗначениеЗаполнено(СтруктураПочтАдрес.Город) Тогда
						ШапкаОбласть.Параметры.НаселенныйПунктРег = СтруктураПочтАдрес.Город;
					ИначеЕсли ЗначениеЗаполнено(СтруктураПочтАдрес.Регион) Тогда
						ШапкаОбласть.Параметры.НаселенныйПунктРег = СтруктураПочтАдрес.Регион;
					КонецЕсли;
					ШапкаОбласть.Параметры.УлицаРег    			= СтруктураПочтАдрес.Улица;
					ШапкаОбласть.Параметры.ДомРег  				= СтруктураПочтАдрес.Дом;
					ШапкаОбласть.Параметры.КорпусРег   			= СтруктураПочтАдрес.Корпус;
					ШапкаОбласть.Параметры.КвартираРег 			= Выборка.КвартираРег;
				Иначе
					ШапкаОбласть.Параметры.УлицаРег    			= Выборка.УлицаРег;
					ШапкаОбласть.Параметры.ДомРег  				= Выборка.ДомРег;
					ШапкаОбласть.Параметры.КорпусРег   			= Выборка.КорпусРег;
					ШапкаОбласть.Параметры.КвартираРег 			= Выборка.КвартираРег;
					
				КонецЕсли;
			КонецЕсли; 
		КонецЕсли;
		ТабДокумент.Вывести(ШапкаОбласть);
		ТабДокумент.Вывести(ШапкаОбласть1);
		
	Иначе

		Сообщение = Новый СообщениеПользователю();
		Сообщение.Текст = "Заполните обязательные поля - Лицевой счет и Регистрируемое лицо";
		Сообщение.Сообщить();
		
	КонецЕсли; 
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой адресный листок прибытия.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьАЛП(ВидМакета) Экспорт  
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Комментарий,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДатаРегистрации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ДокументОснование,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ПринятоеРешение,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОткудаПрибыл,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ВидОперации,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.УлицаЛицевогоСчета КАК УлицаРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание КАК ДомРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Квартира КАК КвартираРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.Корпус КАК КорпусРег,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПочтовыйАдрес КАК ПочтовыйАдрес,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументВид КАК ВидДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументСерия КАК СерияДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументНомер КАК НомерДокумента,
	|	ЕСТЬNULL(ПаспортныеДанныеФизЛицСрезПоследних.ДокументДатаВыдачи, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаВыдачиДокумента,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКемВыдан КАК ВыданДокумент,
	|	ПаспортныеДанныеФизЛицСрезПоследних.ДокументКодПодразделения,
	|	ЕСТЬNULL(ПаспортныеДанныеФизЛицСрезПоследних.ДатаРегистрацииПоМестуЖительства, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРегистрацииПоМестуЖительства,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументВид КАК ВидДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументСерия КАК СерияДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументНомер КАК НомерДокументаПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументДатаВыдачи КАК ДатаВыдачиПред,
	|	ПаспортныеДанныеФизЛицСрезПоследних1.ДокументКемВыдан КАК ВыданДокументПред,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.МестоРождения КАК МестоРождения,
	|	ЕСТЬNULL(бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо.ДатаРождения, ДАТАВРЕМЯ(1, 1, 1)) КАК ДатаРождения,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ЛицевойСчет.Здание.ПаспортнаяСлужба КАК ПаспортнаяСлужба,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРег,
	|	бит_ГражданствоПроживающихСрезПоследних.Страна,
	|	бит_ФИОПроживающихСрезПоследних.Фамилия,
	|	бит_ФИОПроживающихСрезПоследних.Имя,
	|	бит_ФИОПроживающихСрезПоследних.Отчество
	|ИЗ
	|	Документ.бит_ЗаявлениеОРегистрацииПоМестуПЖ КАК бит_ЗаявлениеОРегистрацииПоМестуПЖ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних1
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию = ПаспортныеДанныеФизЛицСрезПоследних1.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГражданствоПроживающих.СрезПоследних(&Момент, ) КАК бит_ГражданствоПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ГражданствоПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО бит_ЗаявлениеОРегистрацииПоМестуПЖ.РегистрируемоеЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Ссылка = &Ссылка";
	
	ВыборкаТЗ = Запрос.Выполнить().Выгрузить();
	
	ТабДокумент   = Новый ТабличныйДокумент();
	ТабДокумент.КлючПараметровПечати = "ЗаявлениеОРегистрацииПоМестуПЖ";
	
	Если ВидМакета Тогда
		Макет         = ПолучитьМакет("АЛП_New");
	Иначе 	
		Макет         = ПолучитьМакет("АЛП");
	КонецЕсли;
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	Если ВыборкаТЗ.Количество()= 0 Тогда
		
		Возврат ТабДокумент;
		
	КонецЕсли;
	ВыборкаИсходник = ВыборкаТЗ[0];
	ВыборкаПриемник = Новый ТаблицаЗначений;
	Для Каждого Колонка Из ВыборкаТЗ.Колонки Цикл
		ВыборкаПриемник.Колонки.Добавить(Колонка.Имя);
	КонецЦикла;
	Выборка = ВыборкаПриемник.Добавить();
	ЗаполнитьЗначенияСвойств(Выборка, ВыборкаИсходник);
	
	// При переводе к верхнему регистру типы данных приведены к строке.
	Выборка.ДокументОснование  = ВРег(Строка(ВыборкаИсходник.ДокументОснование));
	Выборка.ПринятоеРешение    = ВРег(Строка(ВыборкаИсходник.ПринятоеРешение));
	Выборка.ОткудаПрибыл       = ВРег(Строка(ВыборкаИсходник.ОткудаПрибыл));
	Выборка.УлицаРег           = ВРег(Строка(ВыборкаИсходник.УлицаРег));
	Выборка.ДомРег             = ВРег(Строка(ВыборкаИсходник.ДомРег));
	Выборка.КвартираРег        = ВРег(Строка(ВыборкаИсходник.КвартираРег));
	Выборка.КорпусРег          = ВРег(Строка(ВыборкаИсходник.КорпусРег));
	Выборка.ПочтовыйАдрес      = ВРег(ВыборкаИсходник.ПочтовыйАдрес);
	Выборка.ВидДокумента       = ВРег(Строка(ВыборкаИсходник.ВидДокумента));
	Выборка.СерияДокумента     = ВРег(ВыборкаИсходник.СерияДокумента);
	Выборка.НомерДокумента     = ВРег(ВыборкаИсходник.НомерДокумента);
	Выборка.ВыданДокумент      = ВРег(ВыборкаИсходник.ВыданДокумент);
	Выборка.ДокументКодПодразделения  = ВРег(ВыборкаИсходник.ДокументКодПодразделения);
	Выборка.ВидДокументаПред   = ВРег(Строка(ВыборкаИсходник.ВидДокументаПред));
	Выборка.СерияДокументаПред = ВРег(ВыборкаИсходник.СерияДокументаПред);
	Выборка.НомерДокументаПред = ВРег(ВыборкаИсходник.НомерДокументаПред);
	Выборка.ВыданДокументПред  = ВРег(ВыборкаИсходник.ВыданДокументПред);
	Выборка.ПаспортнаяСлужба   = ВРег(ВыборкаИсходник.ПаспортнаяСлужба);
	Выборка.Страна             = ВРег(Строка(ВыборкаИсходник.Страна));
	Выборка.Фамилия            = ВРег(ВыборкаИсходник.Фамилия);
	Выборка.Имя                = ВРег(ВыборкаИсходник.Имя);
	Выборка.Отчество           = ВРег(ВыборкаИсходник.Отчество);
	
	ВыданДокумент_1 = "";
	ВыданДокумент_2 = "";
	бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ВыданДокумент, 60, ВыданДокумент_1 , ВыданДокумент_2 );
	ШапкаОбласть.Параметры.ВыданДокумент_1 = ВыданДокумент_1;
	ШапкаОбласть.Параметры.ВыданДокумент_2 = ВыданДокумент_2;
	
	СтруктураМестоРождения = бит_ПаспортныйСтолКлиетСервер.РазложитьМестоРождения(Выборка.МестоРождения);
	ШапкаОбласть.Параметры.РегионРожд          = СтруктураМестоРождения.Область; 
	ШапкаОбласть.Параметры.ГородРожд           = СтруктураМестоРождения.НаселенныйПункт;
	ШапкаОбласть.Параметры.РайонРожд           = СтруктураМестоРождения.Район;
	
	Если ВидМакета Тогда
		
		ШапкаОбласть.Параметры.СтранаРожд = СтруктураМестоРождения.Страна;
	КонецЕсли;
	Если ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо) И ЗначениеЗаполнено(Выборка.РегистрируемоеЛицо.Пол) Тогда
		ПолФизЛица = Выборка.РегистрируемоеЛицо.Пол;
		Если ПолФизЛица = Перечисления.ПолФизическогоЛица.Мужской Тогда
			ШапкаОбласть.Область("ПолМуж").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
		ИначеЕсли  ПолФизЛица = Перечисления.ПолФизическогоЛица.Женский Тогда
			ШапкаОбласть.Область("ПолЖен").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
		КонецЕсли; 
	КонецЕсли;
	
	ШапкаОбласть.Параметры.Гражданство = Выборка.Страна;
	
	ШапкаОбласть.Параметры.Заполнить(Выборка);
	
	Если ВидМакета Тогда
		ПаспортнаяСлужба_1 = "";
		ПаспортнаяСлужба_2 = "";
		бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(Выборка.ПаспортнаяСлужба, 35, ПаспортнаяСлужба_1 , ПаспортнаяСлужба_2 );
		
		ШапкаОбласть.Параметры.ПаспортнаяСлужба_1 	= ВРег(ПаспортнаяСлужба_1);
		ШапкаОбласть.Параметры.ПаспортнаяСлужба_2 	= ВРег(ПаспортнаяСлужба_2);
		Если ТипЗнч(Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба) = Тип("СправочникСсылка.Контрагенты") Тогда
			ШапкаОбласть.Параметры.КодПаспортнойСлужбы  = Выборка.ЛицевойСчет.Здание.ПаспортнаяСлужба.КодПоОКПО;
		КонецЕсли; 
	Иначе
		ШапкаОбласть.Параметры.ПаспортнаяСлужба		= ВРег(Выборка.ПаспортнаяСлужба);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Выборка.ДатаРождения) Тогда
		
		Если ВидМакета Тогда
			
			ШапкаОбласть.Параметры.ДеньРождения   	= День(Выборка.ДатаРождения);
			ДатаМесяц							  	= Формат(Выборка.ДатаРождения,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРождения  	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодРождения    	= Формат(Выборка.ДатаРождения,"ДФ='yyyy'");	
		Иначе
			ШапкаОбласть.Параметры.ДатаРождения		= Формат(Выборка.ДатаРождения,"ДЛФ=DD");
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ЗначениеЗаполнено(ДатаРегистрации) Тогда
		Если ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуЖительства Тогда
			
			ЗачеркнутыйШрифт = Новый Шрифт(Макет.Область("ТекстПребывания").Шрифт,,,,,,Истина);
			ШапкаОбласть.Область("ТекстПребывания").Шрифт = ЗачеркнутыйШрифт;
			
		ИначеЕсли ВидОперации = Перечисления.бит_ВидыОперацийЗаявлениеОРегистрацииПоМестуПЖ.РегистрацияПоМестуПребывания    Тогда
			
			ЗачеркнутыйШрифт = Новый Шрифт(Макет.Область("ТекстЖительство").Шрифт,,,,,,Истина);
			ШапкаОбласть.Область("ТекстЖительство").Шрифт = ЗачеркнутыйШрифт;
			
		КонецЕсли; 
		
		НаборЗаписей = НЕОПРЕДЕЛЕНО;
		бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.ЛицевойСчет.Здание);
		ИскомаяСтрока = Неопределено;
		
		Для каждого СтрокаНабор Из НаборЗаписей  Цикл
			Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
				И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания
				Тогда 
				ИскомаяСтрока = СтрокаНабор;
			КонецЕсли;	
		КонецЦикла;
		
		ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
		Если ЗначениеЗаполнено(ЗаписьАдрес)  Тогда
			
			СтруктураАдресРегистрации = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
			Если НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
				
				ШапкаОбласть.Параметры.РегионРег 			= ВРег(СтруктураАдресРегистрации.Регион);
				ШапкаОбласть.Параметры.РайонРег 			= ВРег(СтруктураАдресРегистрации.Район);
				ШапкаОбласть.Параметры.ГородРег 			= ВРег(СтруктураАдресРегистрации.Город);
				ШапкаОбласть.Параметры.НаселенныйПунктРег 	= ВРег(СтруктураАдресРегистрации.НаселенныйПункт);
				ШапкаОбласть.Параметры.УлицаРег 			= ВРег(СтруктураАдресРегистрации.Улица);
				ШапкаОбласть.Параметры.КорпусРег 			= ВРег(СтруктураАдресРегистрации.Корпус);
				ШапкаОбласть.Параметры.ДомРег	 			= ВРег(СтруктураАдресРегистрации.Дом);
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ВидМакета Тогда
			
			ШапкаОбласть.Параметры.ДеньРегистрации        = День(ДатаРегистрации);
			ДатаМесяц							  		  = Формат(ДатаРегистрации,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцРегистрации       = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодРегистрации         = Формат(ДатаРегистрации,"ДФ='yyyy '");
			
		КонецЕсли;
	КонецЕсли;

	Если ЗначениеЗаполнено(Выборка.ДатаВыдачиДокумента) Тогда
		
		Если ВидМакета Тогда
			
			ШапкаОбласть.Параметры.ДеньВыдачиДокумента    = День(Выборка.ДатаВыдачиДокумента);
			ДатаМесяц							  		  = Формат(Выборка.ДатаВыдачиДокумента,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.МесяцВыдачиДокумента   = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГодВыдачиДокумента     = Формат(Выборка.ДатаВыдачиДокумента,"ДФ='yyyy'");
			
		Иначе
			ШапкаОбласть.Параметры.ДатаВыдачиДокумента    = Формат(Выборка.ДатаВыдачиДокумента,"ДЛФ=DD");
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ВидМакета Тогда
		
	Иначе
		ШапкаОбласть.Параметры.ДатаСоставления        = Формат(Дата,"ДЛФ=DD");
		
	КонецЕсли;
	
	ШапкаОбласть.Параметры.ДатаСнятияСРегистрации = ДатаСнятияСРегистрации;  
	
	НаборЗаписей = НЕОПРЕДЕЛЕНО;
	бит_УправлениеКонтактнойИнформацией.ПрочитатьКонтактнуюИнформацию(НаборЗаписей,Выборка.РегистрируемоеЛицо);
	ИскомаяСтрока = Неопределено;
	Для каждого СтрокаНабор Из НаборЗаписей  Цикл
		Если СтрокаНабор.Тип 	= Перечисления.бит_ТипыКонтактнойИнформации.Адрес
			И СтрокаНабор.Вид 	= Справочники.бит_ВидыКонтактнойИнформации.АдресПрибытия
			Тогда 
			ИскомаяСтрока = СтрокаНабор;
			Прервать;
		КонецЕсли;	
		
	КонецЦикла;
	
	ЗаписьАдрес = бит_УправлениеКонтактнойИнформацией.ПолучитьПолныйАдрес(ИскомаяСтрока);
	
	СтруктураАдресРегистрации = бит_УправлениеКонтактнойИнформацией.ПолучитьСтруктуруАдресаИзСтроки(ЗаписьАдрес);
	
	Если ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СДругогоГорода
		ИЛИ ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.ВТомЖеГородеСДругогоАдреса Тогда
		Если ВидМакета Тогда
			
			ШапкаОбласть.Параметры.СтранаПрибДГ 		   	 = Выборка.Страна;
			
		КонецЕсли;
		Если ЗначениеЗаполнено(ЗаписьАдрес) И НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
			ШапкаОбласть.Параметры.РегионПрибДГ          = ВРег(СтруктураАдресРегистрации.Регион);
			ШапкаОбласть.Параметры.РайонПрибДГ           = ВРег(СтруктураАдресРегистрации.Район) ;
			ШапкаОбласть.Параметры.ГородПрибДГ           = ВРег(СтруктураАдресРегистрации.Город) ;
			ШапкаОбласть.Параметры.НаселенныйПунктПрибДГ = ВРег(СтруктураАдресРегистрации.НаселенныйПункт) ;
			ШапкаОбласть.Параметры.УлицаПрибДГ           = ВРег(СтруктураАдресРегистрации.Улица) ;
			ШапкаОбласть.Параметры.ДомПрибДГ             = ВРег(СтруктураАдресРегистрации.Дом) ;
			ШапкаОбласть.Параметры.КорпусПрибДГ          = ВРег(СтруктураАдресРегистрации.Корпус) ;
			ШапкаОбласть.Параметры.КвартираПрибДГ        = ВРег(СтруктураАдресРегистрации.Квартира) ;
		КонецЕсли;			
		
		Если ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.ВТомЖеГородеСДругогоАдреса Тогда
			
			Если ЗначениеЗаполнено(ЗаписьАдрес) И НЕ СтруктураАдресРегистрации.Свойство("ЗаПределамиРФ") Тогда
				ШапкаОбласть.Параметры.УлицаПрибТГ           = ВРег(СтруктураАдресРегистрации.Улица) ;
				ШапкаОбласть.Параметры.ДомПрибТГ             = ВРег(СтруктураАдресРегистрации.Дом) ;
				ШапкаОбласть.Параметры.КорпусПрибТГ          = ВРег(СтруктураАдресРегистрации.Корпус) ;
				ШапкаОбласть.Параметры.КвартираПрибТГ        = ВРег(СтруктураАдресРегистрации.Квартира) ;
			КонецЕсли;			
		КонецЕсли;	
		
	ИначеЕсли ОткудаПрибыл = Перечисления.бит_ВариантыИзмененияМестаПребывания.СменаФамилии Тогда
		// Поиск предыдущих ФИО при смене ФИО.
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ФИОПроживающих.Фамилия,
		|	бит_ФИОПроживающих.Имя,
		|	бит_ФИОПроживающих.Отчество
		|ИЗ
		|	РегистрСведений.бит_ФИОПроживающих КАК бит_ФИОПроживающих
		|ГДЕ
		|	бит_ФИОПроживающих.Период < &Момент
		|	И бит_ФИОПроживающих.ФизЛицо = &ФизЛицо
		|
		|УПОРЯДОЧИТЬ ПО
		|	бит_ФИОПроживающих.Период УБЫВ";
		
		Запрос.УстановитьПараметр("Момент", КонецДня(Дата));
		Запрос.УстановитьПараметр("ФизЛицо", Выборка.РегистрируемоеЛицо);
		
		ТаблицаФИО = Запрос.Выполнить().Выгрузить();
		
		Для каждого СтрокаФИО Из ТаблицаФИО Цикл
			Если СтрокаФИО.Фамилия <> Выборка.Фамилия ИЛИ СтрокаФИО.Имя <> Выборка.Имя
				ИЛИ СтрокаФИО.Отчество <> Выборка.Отчество Тогда
				
				ШапкаОбласть.Параметры.ФамилияСмена  				= ВРег(СтрокаФИО.Фамилия);
				ШапкаОбласть.Параметры.ИмяСмена      				= ВРег(СтрокаФИО.Имя);
				ШапкаОбласть.Параметры.ОтчествоСмена 				= ВРег(СтрокаФИО.Отчество);
				Прервать; 	
			КонецЕсли; 
		КонецЦикла;  			
		
		Если ВидМакета Тогда

			Если ЗначениеЗаполнено(Выборка.ДатаРождения) Тогда
				
				ШапкаОбласть.Параметры.ДеньРожденияСмена	  = День(Выборка.ДатаРождения);
				ДатаМесяц							  		  = Формат(Выборка.ДатаРождения,"ДФ='дд.MMMM'");
				ШапкаОбласть.Параметры.МесяцРожденияСмена  	  = Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
				ШапкаОбласть.Параметры.ГодРожденияСмена       = Формат(Выборка.ДатаРождения,"ДФ='yyyy'");	
				
			КонецЕсли;

			Если ЗначениеЗаполнено(ПолФизЛица) Тогда
				Если ПолФизЛица = Перечисления.ПолФизическогоЛица.Мужской Тогда
					ШапкаОбласть.Область("ПолМуж1").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
				ИначеЕсли  ПолФизЛица = Перечисления.ПолФизическогоЛица.Женский Тогда
					ШапкаОбласть.Область("ПолЖен1").ГраницаСнизу = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная,1);
				КонецЕсли; 
			КонецЕсли; 
			
		Иначе
			Если ЗначениеЗаполнено(Выборка.ДатаРождения) Тогда
				
				ШапкаОбласть.Параметры.ГодРожденияСмена       = Формат(Выборка.ДатаРождения,"ДФ='yyyy'");	
				
			КонецЕсли; 
			
		КонецЕсли; 
	Иначе
		
		ШапкаОбласть.Параметры.ПрочиеПричины = Комментарий;
		
	КонецЕсли; 
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Возврат ТабДокумент;
	
КонецФункции

// Функция формирует табличный документ с печатной формой приказа о проведении.
// Инвентаризации.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма приказа.
//
Функция ПечатьЛСУВ() Экспорт
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("Ссылка" ,Ссылка);
	Запрос.УстановитьПараметр("Момент" ,КонецДня(Дата));
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.Организация,
	|	бит_ЗаявлениеОРегистрацииПоМестуПЖ.ОтветственныйЗаРегистрацию КАК Ответственный,
