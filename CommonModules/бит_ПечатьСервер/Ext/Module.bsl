// Процедура выводит горизонтальный разделитель страниц.
//
// Параметры:
//  ТабличныйДокумент - ТабличныйДокумент.
//  ПервыйОбъект	  - Булево. По умолчанию ложь. Возвращаемый.
// 
Процедура ВывестиГоризонтальныйРазделительСтраниц(ТабличныйДокумент, ПервыйОбъект = Ложь) Экспорт
	
	Если Не ПервыйОбъект Тогда
		ТабличныйДокумент.ВывестиГоризонтальныйРазделительСтраниц();
	КонецЕсли;
	
	ПервыйОбъект = Ложь;
	
КонецПроцедуры // ВывестиГоризонтальныйРазделительСтраниц()

// Процедура формирует печатный документ для печати из внешней печатной формы.
//
// Параметры:
//  СтруктураОбработки - Структура.
//  ПечатныйДокумент   - ТабличныйДокумент. Возвращаемый.
//
// Возвращаемое значение:
//  ТабличныйДокумент
//
Процедура НапечататьВнешнююФорму(СтруктураОбработки, ПечатныйДокумент) Экспорт

	ДвоичныеДанные = СтруктураОбработки.СсылкаНаВнешнююОбработку.Принадлежность[СтруктураОбработки.НомерСтроки - 1].ХранилищеВнешнейОбработки.Получить();
	
	// Получим массив ссылок внешней обработки.
	МассивСсылок = ?(СтруктураОбработки.Свойство("МассивСсылок")
				    ,СтруктураОбработки.МассивСсылок
					,Новый Массив);
	
	Если МассивСсылок.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;	
	
	// Получить дополнительные параметры внешней обработки.
	ДополнительныеПараметры = ?(СтруктураОбработки.Свойство("ДополнительныеПараметрыОбработки")
							   ,СтруктураОбработки.ДополнительныеПараметрыОбработки
							   ,Неопределено);
	
	Если ДвоичныеДанные = Неопределено Тогда
		ДвоичныеДанные = СтруктураОбработки.СсылкаНаВнешнююОбработку.ХранилищеВнешнейОбработки.Получить();
	КонецЕсли;
	
	Если ДвоичныеДанные = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайла = ПолучитьИмяВременногоФайла("epf");
	
	Попытка
		
		ДвоичныеДанные.Записать(ИмяФайла);
		
		Обработка = ВнешниеОбработки.Создать(ИмяФайла);
		
		Если МассивСсылок.Количество() = 1 Тогда
			Обработка.СсылкаНаОбъект = МассивСсылок[0];
		Иначе
			Обработка.СсылкаНаОбъект = МассивСсылок;
		КонецЕсли;
		
		// Передадим внешней обработке дополнительные параметры.
		Если Не ДополнительныеПараметры = Неопределено Тогда
			
			// Если у внешней обработки есть реквизит для дополнительных параметров, присвоить ему значение.
			Если Не Обработка.Метаданные().Реквизиты.Найти("ДополнительныеПараметры") = Неопределено Тогда
				Обработка.ДополнительныеПараметры = ДополнительныеПараметры;
			КонецЕсли;
			
		КонецЕсли;
		
		ПечатныйДокумент = Обработка.Печать();
		
		УдалитьФайлы(ИмяФайла);
		
	Исключение
		
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать внешнюю печатную форму!'");
		ТекстСообщения = ТекстСообщения + " " + ОписаниеОшибки();
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		
	КонецПопытки;
	
КонецПроцедуры // НапечататьВнешнююФорму()

#КонецОбласти

