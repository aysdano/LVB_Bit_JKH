Функция ПолучитьИДЛицевогоСчета(ЛицевойСчет)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	МЛК_АдресаЛичныхКабинетов.ИДОбъекта КАК ИДОбъекта
	|ИЗ
	|	РегистрСведений.МЛК_АдресаЛичныхКабинетов КАК МЛК_АдресаЛичныхКабинетов
	|ГДЕ
	|	МЛК_АдресаЛичныхКабинетов.ЛицевойСчет = &ЛицевойСчет";
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛицевойСчет);
	РЗ = Запрос.Выполнить();
	Выб = РЗ.Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Выб.ИДОбъекта;
	Иначе
		Возврат "";
	КонецЕсли;	
КонецФункции	
Функция ПолучитьДанныеПоОплатам(ЛС,Дата1,Дата2)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХ.Период КАК Период,
	|	бит_НачисленияПоУслугамЖКХ.Регистратор КАК Регистратор,
	|	бит_НачисленияПоУслугамЖКХ.ВидДвижения КАК ВидДвижения,
	|	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет КАК ЛицевойСчет,
	|	СУММА(бит_НачисленияПоУслугамЖКХ.Сумма) КАК Сумма
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ КАК бит_НачисленияПоУслугамЖКХ
	|ГДЕ
	|	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет В(&ЛицевойСчет)
	|	И бит_НачисленияПоУслугамЖКХ.ВидДвижения = &ВидДвижения
	|	И бит_НачисленияПоУслугамЖКХ.Период >= &Дата1
	|	И бит_НачисленияПоУслугамЖКХ.Период <= &Дата2
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХ.Регистратор,
	|	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХ.ВидДвижения,
	|	бит_НачисленияПоУслугамЖКХ.Период";
	Запрос.УстановитьПараметр("Дата1",НачалоДня(Дата1));
	Запрос.УстановитьПараметр("Дата2",КонецДня(Дата2));
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛС);
	Запрос.УстановитьПараметр("ВидДвижения",ВидДвиженияНакопления.Расход);
	Возврат Запрос.Выполнить().Выгрузить();
КонецФункции
