#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура СформироватьНаСервере(ВыборМакета)
	
	ОтчетОбъект = ДанныеФормыВЗначение(Отчет, Тип("ОтчетОбъект.бит_ВыпискаИзДомовойКниги"));
	ОтчетОбъект.СформироватьОтчет(ТаблицаРезультат,ВыборМакета);
	ЗначениеВДанныеФормы(ОтчетОбъект,Отчет);
	
КонецПроцедуры

// БИТ_ЖКХ 21.03.2017 9:58:57 Начало правки... 
&НаКлиенте
Процедура ФормироватьНаОдногоПриИзменении(Элемент)
	
	Если НЕ Отчет.ФормироватьНаОдного Тогда
		Элементы.Проживающий.Доступность = Ложь;
		Элементы.Проживающий.Видимость 	 = Ложь;
		Отчет.Проживающий = ПредопределенноеЗначение("Справочник.бит_Проживающие.ПустаяСсылка");
	Иначе
		Элементы.Проживающий.Доступность = Истина;
		Элементы.Проживающий.Видимость	 = Истина;
		ОбновитьСписокПроживающих();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьСписокПроживающих()
	
	СписокФизЛиц = СписокПроживающих(Отчет.Дата, Отчет.ЛицевойСчет, Отчет.ИсторияПроживающих);
	Элементы.Проживающий.СписокВыбора.ЗагрузитьЗначения(СписокФизЛиц);
	
КонецПроцедуры

