// Дробит указанный текст на две части, длина первой из которых не превышает указанной длины.
//
// Параметры:
//  Строка       – Строка – исходный текст.
//  Длина        – Число – максимальная длина первой части.
//  Стр1         – Строка – первая часть текста.
//  Стр2         – Строка – вторая часть текста.
//
Процедура РазделитьТекстНаДвеСтроки(Строка, Длина, Стр1, Стр2) Экспорт
	
	Если СтрДлина(Строка) <= Длина Тогда
		Стр1 = Строка;
		Стр2 = "";
		Возврат;
	КонецЕсли;
	
	КонецСлова = Длина + 1;
	Пока Сред(Строка, КонецСлова, 1) <> " " И КонецСлова > 0  Цикл
		КонецСлова = КонецСлова - 1;
	КонецЦикла;
	Если КонецСлова <= Длина / 2 Тогда
		КонецСлова = 0;
	КонецЕсли;
	
	Перенос = Ложь;
	Если КонецСлова = 0 Тогда
		Перенос = Истина;
		КонецСлова = Длина;
	КонецЕсли;
	
	Стр1 = Лев(Строка, КонецСлова) + ?(Перенос, "-", "");
	Стр2 = Прав(Строка, СтрДлина(Строка) - КонецСлова);
	
КонецПроцедуры // РазделитьТекстНаДвеСтроки()

