	 Если СтрокаТЧ.РазбиватьПоЛицевымСчетам Тогда
			
			ТЗСписокЛС = СписокЛС.Выгрузить(,"НомерДок, ЛицевойСчет, ПлательщикБИК, ПлательщикИНН, ПлательщикКПП, ПлательщикСчет" 
						+ ", Субконто1, Субконто2, Субконто3, СубконтоКУ1, СубконтоКУ2, СубконтоКУ3, Сумма"
						+ ", СчетАбонента, СчетКУ, Услуга");

			// БИТ ЖКХ 28.01.2020			
            ТЗСписокЛС = СвернутьПоЛицевымСчетам(ТЗСписокЛС);
						
						
			ТЗСписокЛС.Свернуть("НомерДок, ЛицевойСчет, ПлательщикБИК, ПлательщикИНН, ПлательщикКПП, ПлательщикСчет" 
						+ ", Субконто1, Субконто2, Субконто3, СубконтоКУ1, СубконтоКУ2, СубконтоКУ3"
						+ ", СчетАбонента, СчетКУ, Услуга"
						, "Сумма");
    
			Для каждого СтрокаЛС Из ТЗСписокЛС Цикл
						
				//ПроверитьПовторныйВводДокумента(Отказ, Оплата);
				//
				//Если Отказ Тогда
				//	Продолжить;
				//КонецЕсли;
				
				СуммаПринимаемых = ПолучитьСуммуПолучаемых(ТаблицаУСН, СтрокаЛС.ЛицевойСчет);
				
				ДокументЗаписан = Ложь;
							

				ПлатежныйДокумент = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
				////31.07.2019
				если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "НомерДок") = истина тогда
				 ПлатежныйДокумент.НомерВходящегоДокумента = СтрокаТЧ.НомерДок;
				 ПлатежныйДокумент.ДатаВходящегоДокумента = Объект.ДатаПоступления; 
			    конецесли; 
			    ЭтоПоступлениеНаРасчетныйСчет = 1; 
				ЗаполнитьПКОПоступлениеПлатежа(ПлатежныйДокумент, СтрокаЛС, Оплата, ДокументЗаписан, РазбиватьПоЛицевымСчетам, ТранзитныйСчетОплаты, ПрименениеУСН, СуммаПринимаемых
				,СтрокаТЧ.БанковскийСчет, СтрокаТЧ.ИсточникОплаты);
			КонецЦикла;
    иначе
	       ПлатежныйДокумент = Документы.ПоступлениеНаРасчетныйСчет.СоздатьДокумент();
		    ////31.07.2019
		   если ОбщегоНазначенияКлиентСервер.ЕстьРеквизитИлиСвойствоОбъекта(СтрокаТЧ, "НомерДок") = истина тогда
