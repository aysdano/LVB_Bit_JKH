&НаКлиенте
Процедура КвартирыРегистрСведенийбит_СведенияОКвартиреОткрытьПоЗначениюКвартира(Команда)
	
	// БИТ_ЖКХ 05.06.2014
	ТекущиеДанныеНежилыеПомещения = Элементы.НежилыеПомещения.ТекущиеДанные;
	ТекущиеДанныеКвартиры         = Элементы.Квартиры.ТекущиеДанные;
	
	Отбор = Новый Структура;
	Если Элементы.Группа19.ТекущаяСтраница.Заголовок = "Паркинг/нежилые помещения" Тогда
		Попытка
			Отбор.Вставить("Квартира", ТекущиеДанныеНежилыеПомещения.Ссылка);
		Исключение
			Возврат
		КонецПопытки;
		
	КонецЕсли;
	Если Элементы.Группа19.ТекущаяСтраница.Заголовок = "Квартиры" Тогда
		Попытка
			Отбор.Вставить("Квартира", ТекущиеДанныеКвартиры.Ссылка);
		Исключение
			Возврат
		КонецПопытки;
		
	КонецЕсли;
	// БИТ_ЖКХ 05.06.2014
	
	ОткрытьФорму("РегистрСведений.бит_СведенияОКвартире.Форма.ФормаСпискаУправляемая", Новый Структура("Отбор", Отбор), ЭтаФорма);
	
