Процедура ОтправитьКвитанцииПоЛицевымСчетам(ТЗ,ПериодНачислений)
	ТаблицаДляИзмененияСтатуса = Новый ТаблицаЗначений;
	ТаблицаДляИзмененияСтатуса.Колонки.Добавить("ИД_События");
	ИзменитьСтатусы = Ложь;
	
	Для Каждого СТр Из ТЗ Цикл
		
		ЕстьОтвет = Истина;
		//	Квитанция = ПечатьЕдиныйПлатежныйДокумент(Стр.ЛС);
		//ЛС = Справочники.бит_ЛицевыеСчета.НайтиПоКоду();
		
		ЛС  = Справочники.бит_ЛицевыеСчета.НайтиПоКоду(СокрЛП(Стр.ЛС));// Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию("100000");    //!Переделать
		//Квитанция = ПечатьПлатежныйДокументРК924(ЛС);
		Квитанция = ПечатьПлатежныйДокументРК924(ЛС,ПериодНачислений);
		
		ИмяФ = Стр.ИД_События; 
		Квитанция.Записать(Строка(КаталогВременныхФайлов())+Строка(ИмяФ)+".pdf", ТипФайлаТабличногоДокумента.PDF) ;
		
		СодержимоеФайла = Base64Строка(Новый ДвоичныеДанные(СТрока(КаталогВременныхФайлов())+Строка(ИмяФ)+".pdf")); 
		АдресСервисаСтр = СокрЛП(Объект.АдресСервиса);
		ИДСобытия = ""; РасширениеФайла = ""; ИмяФайла = ""; Содержимое = "";
		
		ИДСобытия = Строка(Стр.ИД_События);
		ИДСобытия = СтрЗаменить(ИДСобытия,Символы.НПП,"");
		ИДСобытия = КодироватьСтроку(ИДСобытия,СпособКодированияСтроки.КодировкаURL);
		РасширениеФайла = "pdf";
		РасширениеФайла = КодироватьСтроку(РасширениеФайла,СпособКодированияСтроки.КодировкаURL);
		ИмяФайла  = Строка(ИмяФ);
		ИмяФайла = КодироватьСтроку(ИмяФайла,СпособКодированияСтроки.КодировкаURL);
		Содержимое = СодержимоеФайла;
		Содержимое = КодироватьСтроку(Содержимое,СпособКодированияСтроки.КодировкаURL);
		
		АдресРесурса = "/api/v4/events/eventfile";
		ТелоPOSTЗапроса = "eventId="+ИДСобытия+"&fileExt="+РасширениеФайла+"&fileName="+ИмяФайла+"&fileBody="+Содержимое;
		СтрокаПараметров = ""; 
		HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , ,Новый ЗащищенноеСоединениеOpenSSL);
		
		Попытка
			HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
			HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
			HTTPЗапрос.Заголовки.Вставить("Content-Type", "application/x-www-form-urlencoded; charset=UTF-8");   // тут поменялось
			HTTPЗапрос.УстановитьТелоИзСтроки(ТелоPOSTЗапроса);
			//Ответ = HTTPСоединение.ВызватьHTTPМетод("POST",HTTPЗапрос);	
			Ответ = HTTPСоединение.ОтправитьДляОбработки(HTTPЗапрос);
		Исключение  
			ЕстьОтвет = Ложь;                  
			Сообщить("Экспорт квитанции по лицевому счету: "+Строка(Стр.ЛС)+". Ошибка при отправке запроса: " + ОписаниеОшибки());
		КонецПопытки;
		Если ЕстьОтвет Тогда
			Если Ответ.КодСостояния = 200 Тогда
				СтрокаОтвет1 = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				
				СтрокаОтвет1 = Перевод(СтрокаОтвет1);
				
				СтрокаОтвет1 = "Добавление квитанции. ЛС: "+Строка(СТр.ЛС)+". "+ СтрокаОтвет1;
				
				
				Сообщить(СтрокаОтвет1);
				Если Не ПустаяСтрока(СтрокаОтвет1) Тогда
					РезультатПроверки1 = СтрокаОтвет1;
					
					НовСТр = ТаблицаДляИзмененияСтатуса.Добавить();
					НовСтр.ИД_События = Стр.ИД_События;
					
					Если СокрЛП(РезультатПроверки1)="false" Тогда
						Сообщить("Соединение не установлено");
					Иначе
						
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Ответ.КодСостояния = 500 Тогда
				Сообщить("Отправка квитанции. "+"Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
			ИначеЕсли Ответ.КодСостояния = 404 Тогда
				Сообщить("Отправка квитанции. "+"Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
			ИначеЕсли Ответ.КодСостояния = 301 Тогда
				Сообщить("Отправка квитанции. "+"Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
			Иначе 
				Попытка
					СтрокаОтвет1 = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
					Сообщить(Строка(СтрокаОтвет1));
				Исключение
				КонецПопытки;	
			КонецЕсли;
		КонецЕсли;
		Попытка
			УдалитьФайлы(Строка(КаталогВременныхФайлов())+Строка(ИмяФ)+".pdf");
		Исключение
			Сообщить(ОписаниеОшибки());
		КонецПопытки;
	КонецЦикла;
	
	Если ТаблицаДляИзмененияСтатуса.Количество()<>0 Тогда 
		ИзменитьСтатусыВСобытиях(ТаблицаДляИзмененияСтатуса,Строка(Объект.СтатусЗакрыто));
	КонецЕсли;
	
КонецПроцедуры	

