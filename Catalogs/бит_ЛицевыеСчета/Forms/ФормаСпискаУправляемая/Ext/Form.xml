	<Attributes>
		<Attribute name="Список" id="1">
			<Type>
				<v8:Type>cfg:DynamicList</v8:Type>
			</Type>
			<MainAttribute>true</MainAttribute>
			<Settings xsi:type="DynamicList">
				<ManualQuery>true</ManualQuery>
				<DynamicDataRead>true</DynamicDataRead>
				<QueryText>ВЫБРАТЬ РАЗЛИЧНЫЕ
	Справочникбит_ЛицевыеСчета.Ссылка,
	Справочникбит_ЛицевыеСчета.ВерсияДанных,
	Справочникбит_ЛицевыеСчета.ПометкаУдаления,
	Справочникбит_ЛицевыеСчета.Предопределенный,
	Справочникбит_ЛицевыеСчета.Код,
	Справочникбит_ЛицевыеСчета.Наименование,
	Справочникбит_ЛицевыеСчета.Здание,
	Справочникбит_ЛицевыеСчета.Квартира,
	Справочникбит_ЛицевыеСчета.Организация,
	Справочникбит_ЛицевыеСчета.УлицаЛицевогоСчета,
	Справочникбит_ЛицевыеСчета.ОтображатьПоГруппам,
	Справочникбит_ЛицевыеСчета.Идентификатор,
	Справочникбит_ЛицевыеСчета.НеВестиРасчетПени,
	Справочникбит_ЛицевыеСчета.КодПоГУГЦЖС,
	ОтвЛица.ФизЛицо КАК ОтветственноеЛицо,
	Справочникбит_ЛицевыеСчета.Архивный
ИЗ
	Справочник.бит_ЛицевыеСчета КАК Справочникбит_ЛицевыеСчета
		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
			бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
			бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
		ИЗ
			РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&amp;Дата, ) КАК бит_ПроживающиеПоЛССрезПоследних
		ГДЕ
			(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации &gt; &amp;Дата
					ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
			И бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
		
		СГРУППИРОВАТЬ ПО
			бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
			бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК ОтвЛица
		ПО Справочникбит_ЛицевыеСчета.Ссылка = ОтвЛица.ЛицевойСчет</QueryText>
				<MainTable>Catalog.бит_ЛицевыеСчета</MainTable>
				<ListSettings>
					<dcsset:filter>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>dfcece9d-5077-440b-b6b3-45a5cb4538eb</dcsset:userSettingID>
					</dcsset:filter>
					<dcsset:order>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>88619765-ccb3-46c6-ac52-38e9c992ebd4</dcsset:userSettingID>
					</dcsset:order>
					<dcsset:conditionalAppearance>
						<dcsset:viewMode>Normal</dcsset:viewMode>
						<dcsset:userSettingID>b75fecce-942b-4aed-abc9-e6a02e460fb3</dcsset:userSettingID>
					</dcsset:conditionalAppearance>
					<dcsset:itemsViewMode>Normal</dcsset:itemsViewMode>
					<dcsset:itemsUserSettingID>911b6018-f537-43e8-a417-da56b22f9aec</dcsset:itemsUserSettingID>
				</ListSettings>
			</Settings>
		</Attribute>
