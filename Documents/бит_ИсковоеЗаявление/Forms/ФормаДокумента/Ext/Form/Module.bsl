&НаСервере
Процедура ЛицевойСчетПриИзмененииНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Квартира.Наименование КАК Квартира,
	|	бит_СписокЗданий.Наименование КАК НомерДома,
	|	бит_ЛицевыеСчета.УлицаЛицевогоСчета КАК Улица,
	|	бит_ЛицевыеСчета.Здание КАК Здание,
	|	бит_ЛицевыеСчета.Квартира КАК Квартира1,
	|	бит_СписокЗданий.СудебныйУчасток КАК СудебныйУчасток,
	|	бит_ЛицевыеСчета.Здание.ПочтовыйАдрес КАК ЗданиеПочтовыйАдрес
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	|		ПО бит_ЛицевыеСчета.Здание = бит_СписокЗданий.Ссылка
	|ГДЕ
	|	бит_ЛицевыеСчета.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ЛицевойСчет.Ссылка);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	Если РезультатЗапроса.Пустой() Тогда
		
		Объект.Адрес = "";
		Объект.СудебныйУчасток = Справочники.бит_СудебныеУчастки.ПустаяСсылка();
		
	Иначе
		Выборка = РезультатЗапроса.Выбрать();
		
		Выборка.Следующий();
		Строка = Выборка.ЗданиеПочтовыйАдрес;
		НачалоСтроки = "г";
		КоличествоУдаляемыхСимволов = СтрНайти(Строка, НачалоСтроки)-1;
		ДлинаСтроки = СтрДлина(Строка) - КоличествоУдаляемыхСимволов;
		НоваяСтрока = Прав(Строка,ДлинаСтроки);
		
		Объект.Адрес = "" + НоваяСтрока + " кв. " + Выборка.Квартира;
		Объект.Здание = Выборка.Здание;
		Объект.Квартира = Выборка.Квартира1;
		Объект.СудебныйУчасток = Выборка.СудебныйУчасток;
		
	КонецЕсли;                                                               
	
	ЭтаФорма.Модифицированность = Истина;
	
КонецПроцедуры

