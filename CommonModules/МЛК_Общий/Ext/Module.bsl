Процедура МЛК_ПервичнаяСинхронизация() Экспорт
	
	Если Не Константы.МЛК_ИспользоватьИнтеграциюСМобильнымиЛичнымиКабинетами.Получить() Тогда
		Возврат;
	КонецЕсли;	
	
	Если ЭтоКопияБазы() Тогда
		Возврат;
	КонецЕсли;
	
	УстановитьПривилегированныйРежим(Истина);
	
	Настройки = Справочники.МЛК_Настройки.Выбрать();
	Пока Настройки.Следующий() Цикл
		Если Настройки.ПометкаУдаления Тогда Продолжить; КонецЕсли;
		Если  Не Настройки.ПервичнаяСинхронизацияВыполнена Тогда
			//ОбъектНастр = Настройки.ПолучитьОбъект();
			//ОбъектНастр.Прочитать();
			//
			//ОбъектНастр.ПервичнаяСинхронизацияВыполнена           = Ложь;
			//ОбъектНастр.ДатаПервичнойСинхронизации                = "";
			//ОбъектНастр.ДатаПоследнейВыгрузкиПоНачислениям        = "";
			//ОбъектНастр.ДатаПоследнейВыгрузкиПоОплатам            = "";
			//ОбъектНастр.ДатаПоследнейСинхронизацииПоЛицевымСчетам = "";
			//ОбъектНастр.ДатаПоследнейСинхронизацииПоСчетчикам     = "";
			//Попытка
			//	ОбъектНастр.Записать();
			//Исключение
			//КонецПопытки;
			//
			//Если ЗначениеЗаполнено(Настройки.ДатаПоследнейВыгрузкиПоНачислениям) И ЗначениеЗаполнено(Настройки.ДатаПоследнейВыгрузкиПоОплатам)
			//	И ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоЛицевымСчетам) И ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоСчетчикам)
			//	И Не Настройки.ПервичнаяСинхронизацияВыполнена Тогда
			//	ПоставитьГалочкуСинхронизацияВыполнена(Настройки);
			//КонецЕсли;
			//
			
			
			СозданиеСправочников   = СоздатьСправочникиДляРаботыСМЛК(Настройки);
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Синхронизация. Справочники "+Строка(СозданиеСправочников),"",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
			
			СинхронизацияЛС        = ОтправитьВсеЛицевыеСчетаНаСервере(Истина);
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Синхронизация. Лицевые счета "+Строка(СинхронизацияЛС),"",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
			
			СинхронизацияСчетчиков = ОтправитьВсеСчетчикиНаСервереПервый(Истина);
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Синхронизация. Счетчики "+Строка(СинхронизацияСчетчиков),"",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
			
			КороткиеСсылки         = СоздатьКороткиеСсылки(Истина,Настройки);
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Синхронизация. Короткие ссылки "+Строка(КороткиеСсылки),"",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
			
			ИсторияОплат           = ОтправитьИсториюОплат();
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Синхронизация. История оплат "+Строка(ИсторияОплат),"",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
			
			ИсторияНачислений      = ОтправитьИсториюНачислений();
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Синхронизация. История начислений "+Строка(ИсторияНачислений),"",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
			
			
			Если ЗначениеЗаполнено(Настройки.ДатаПоследнейВыгрузкиПоНачислениям) И ЗначениеЗаполнено(Настройки.ДатаПоследнейВыгрузкиПоОплатам)
				И ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоЛицевымСчетам) И ЗначениеЗаполнено(Настройки.ДатаПоследнейСинхронизацииПоСчетчикам) Тогда
				ПоставитьГалочкуСинхронизацияВыполнена(Настройки);
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;	
КонецПроцедуры

Процедура ПоставитьГалочкуСинхронизацияВыполнена(Настройки)
	МЛК_Общий.ЗаписатьДанныеВЖурнал("Синхронизация. Запись справочника ","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
	ОбъектНастройки = Настройки.ПолучитьОбъект();
	ОбъектНастройки.Прочитать();
	
	ОбъектНастройки.ПервичнаяСинхронизацияВыполнена             = Истина;
	ОбъектНастройки.ДатаПервичнойСинхронизации                  = ТекущаяДатаСеанса();
	Попытка
		ОбъектНастройки.Записать();
	Исключение
	КонецПопытки;
КонецПроцедуры

