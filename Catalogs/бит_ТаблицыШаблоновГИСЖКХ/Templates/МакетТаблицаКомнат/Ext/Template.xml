<?xml version="1.0" encoding="UTF-8"?>
<DataCompositionSchema xmlns="http://v8.1c.ru/8.1/data-composition-system/schema" xmlns:dcscom="http://v8.1c.ru/8.1/data-composition-system/common" xmlns:dcscor="http://v8.1c.ru/8.1/data-composition-system/core" xmlns:dcsset="http://v8.1c.ru/8.1/data-composition-system/settings" xmlns:v8="http://v8.1c.ru/8.1/data/core" xmlns:v8ui="http://v8.1c.ru/8.1/data/ui" xmlns:xs="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
	<dataSource>
		<name>ИсточникДанных1</name>
		<dataSourceType>Local</dataSourceType>
	</dataSource>
	<dataSet xsi:type="DataSetQuery">
		<name>НаборДанных1</name>
		<field xsi:type="DataSetFieldField">
			<dataPath>КадастровыйНомерКомнаты</dataPath>
			<field>КадастровыйНомерКомнаты</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Кадастровый номер комнаты</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ЧастьПомещения</dataPath>
			<field>ЧастьПомещения</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерКомнаты</dataPath>
			<field>НомерКомнаты</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер комнаты</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерКомнатыЧисло</dataPath>
			<field>НомерКомнатыЧисло</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер комнаты число</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Площадь</dataPath>
			<field>Площадь</field>
			<valueType>
				<v8:Type>xs:decimal</v8:Type>
				<v8:NumberQualifiers>
					<v8:Digits>25</v8:Digits>
					<v8:FractionDigits>4</v8:FractionDigits>
					<v8:AllowedSign>Nonnegative</v8:AllowedSign>
				</v8:NumberQualifiers>
			</valueType>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Владелец</dataPath>
			<field>Владелец</field>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Комната</dataPath>
			<field>Комната</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Комната</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>НомерПомещения</dataPath>
			<field>НомерПомещения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Номер помещения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>АдресКомнаты</dataPath>
			<field>АдресКомнаты</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Адрес комнаты</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>КодПомещения</dataPath>
			<field>КодПомещения</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Код помещения</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ПодтвержденоПоставщиком</dataPath>
			<field>ПодтвержденоПоставщиком</field>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	бит_ЛицевыеСчета.Квартира КАК Квартира
ПОМЕСТИТЬ ВТ_ЛицевыеСчета
ИЗ
	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
ГДЕ
	бит_ЛицевыеСчета.Архивный = ЛОЖЬ
	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
{ГДЕ
	(бит_ЛицевыеСчета.Ссылка В (&amp;СписокЛС))}
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_Комнаты.Ссылка КАК Комната,
	бит_Комнаты.Владелец КАК Владелец,
	бит_Комнаты.Наименование КАК Наименование,
	бит_Комнаты.НомерКомнаты КАК НомерКомнаты,
	бит_Комнаты.ЧастьПомещения КАК ЧастьПомещения,
	бит_Комнаты.КадастровыйНомер КАК КадастровыйНомер,
	бит_Квартиры.Владелец КАК Здание,
	бит_Квартиры.Наименование КАК НомерПомещения,
	бит_Квартиры.УникальныйНомерГИСЖКХ КАК КодПомещения,
	бит_Комнаты.ПодтвержденоПоставщиком КАК ПодтвержденоПоставщиком
ПОМЕСТИТЬ ВТ_Комнаты
ИЗ
	Справочник.бит_Комнаты КАК бит_Комнаты
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
		ПО бит_Комнаты.Владелец = бит_Квартиры.Ссылка
ГДЕ
	бит_Квартиры.Ссылка В
			(ВЫБРАТЬ
				ВТ_ЛицевыеСчета.Квартира
			ИЗ
				ВТ_ЛицевыеСчета КАК ВТ_ЛицевыеСчета)
	И НЕ бит_Квартиры.ПометкаУдаления
	И НЕ бит_Комнаты.ПометкаУдаления

ИНДЕКСИРОВАТЬ ПО
	бит_Комнаты.Ссылка
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	бит_СведенияОКомнатеСрезПоследних.Площадь КАК Площадь,
	бит_СведенияОКомнатеСрезПоследних.Комната КАК Комната
ПОМЕСТИТЬ ВТ_СведенияКомнат
ИЗ
	РегистрСведений.бит_СведенияОКомнате.СрезПоследних(
			&amp;Период,
			Комната В
				(ВЫБРАТЬ
					ВТ_Комнаты.Комната
				ИЗ
					ВТ_Комнаты КАК ВТ_Комнаты)) КАК бит_СведенияОКомнатеСрезПоследних

ИНДЕКСИРОВАТЬ ПО
	Комната
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Комнаты.Комната КАК Комната,
	ВТ_Комнаты.Владелец КАК Владелец,
	ВТ_Комнаты.Наименование КАК НомерКомнаты,
	ВТ_Комнаты.НомерПомещения КАК НомерПомещения,
	ВТ_Комнаты.КодПомещения КАК КодПомещения,
	ВТ_Комнаты.НомерКомнаты КАК НомерКомнатыЧисло,
	ВТ_Комнаты.ЧастьПомещения КАК ЧастьПомещения,
	ВТ_Комнаты.КадастровыйНомер КАК КадастровыйНомерКомнаты,
	ВТ_СведенияКомнат.Площадь КАК Площадь,
	бит_СписокЗданий.ПочтовыйАдрес КАК АдресКомнаты,
	ВЫБОР
		КОГДА ВТ_Комнаты.ПодтвержденоПоставщиком
			ТОГДА "Да"
		ИНАЧЕ "Нет"
	КОНЕЦ КАК ПодтвержденоПоставщиком
ИЗ
	ВТ_Комнаты КАК ВТ_Комнаты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_СведенияКомнат КАК ВТ_СведенияКомнат
		ПО ВТ_Комнаты.Комната = ВТ_СведенияКомнат.Комната
		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_СписокЗданий КАК бит_СписокЗданий
		ПО ВТ_Комнаты.Здание = бит_СписокЗданий.Ссылка
{ГДЕ
	(бит_СписокЗданий.Организация = &amp;ОтборОрганизация),
	(бит_СписокЗданий.Улица В (&amp;СписокУлиц)),
	(бит_СписокЗданий.Ссылка В (&amp;СписокЗданий)),
	(ВЫБОР
			КОГДА &amp;ТипДомаГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.МКД)
				ТОГДА бит_СписокЗданий.ТипыДомовГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.МКД)
						ИЛИ бит_СписокЗданий.ТипыДомовГИСЖКХ = ЗНАЧЕНИЕ(Перечисление.бит_ТипыДомовГИСЖКХ.ПустаяСсылка)
			ИНАЧЕ бит_СписокЗданий.ТипыДомовГИСЖКХ В (&amp;ТипДомаГИСЖКХ)
		КОНЕЦ)}</query>
	</dataSet>
	<calculatedField>
		<dataPath>КадастровыйНомерКомнаты</dataPath>
		<expression>ВЫБОР
КОГДА КадастровыйНомерКомнаты = ""
ТОГДА "Нет"
ИНАЧЕ КадастровыйНомерКомнаты
КОНЕЦ</expression>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Кадастровый номер комнаты</v8:content>
			</v8:item>
		</title>
	</calculatedField>
	<parameter>
		<name>Период</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Период</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type>xs:dateTime</v8:Type>
			<v8:DateQualifiers>
				<v8:DateFractions>DateTime</v8:DateFractions>
			</v8:DateQualifiers>
		</valueType>
		<value xsi:type="xs:dateTime">0001-01-01T00:00:00</value>
		<useRestriction>true</useRestriction>
		<use>Always</use>
	</parameter>
	<parameter>
		<name>ОтборОрганизация</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Отбор организация</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.Организации</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
	</parameter>
	<parameter>
		<name>СписокЛС</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Список ЛС</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.бит_ЛицевыеСчета</v8:Type>
		</valueType>
		<useRestriction>true</useRestriction>
		<valueListAllowed>true</valueListAllowed>
	</parameter>
	<parameter>
		<name>СписокЗданий</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Список зданий</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.бит_СписокЗданий</v8:Type>
		</valueType>
		<useRestriction>true</useRestriction>
		<valueListAllowed>true</valueListAllowed>
	</parameter>
	<parameter>
		<name>СписокУлиц</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Список улиц</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:CatalogRef.бит_СписокУлиц</v8:Type>
		</valueType>
		<useRestriction>true</useRestriction>
		<valueListAllowed>true</valueListAllowed>
	</parameter>
	<parameter>
		<name>ТипДомаГИСЖКХ</name>
		<title xsi:type="v8:LocalStringType">
			<v8:item>
				<v8:lang>ru</v8:lang>
				<v8:content>Тип дома ГИСЖКХ</v8:content>
			</v8:item>
		</title>
		<valueType>
			<v8:Type xmlns:d4p1="http://v8.1c.ru/8.1/data/enterprise/current-config">d4p1:EnumRef.бит_ТипыДомовГИСЖКХ</v8:Type>
		</valueType>
		<value xsi:nil="true"/>
		<useRestriction>true</useRestriction>
	</parameter>
	<settingsVariant>
		<dcsset:name>Основной</dcsset:name>
		<dcsset:presentation xsi:type="xs:string">Основной</dcsset:presentation>
		<dcsset:settings xmlns:style="http://v8.1c.ru/8.1/data/ui/style" xmlns:sys="http://v8.1c.ru/8.1/data/ui/fonts/system" xmlns:web="http://v8.1c.ru/8.1/data/ui/colors/web" xmlns:win="http://v8.1c.ru/8.1/data/ui/colors/windows">
			<dcsset:selection>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>АдресКомнаты</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КодПомещения</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>НомерПомещения</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>НомерКомнаты</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>Площадь</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>КадастровыйНомерКомнаты</dcsset:field>
				</dcsset:item>
				<dcsset:item xsi:type="dcsset:SelectedItemField">
					<dcsset:field>ПодтвержденоПоставщиком</dcsset:field>
				</dcsset:item>
			</dcsset:selection>
			<dcsset:dataParameters>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>СписокЛС</dcscor:parameter>
					<dcscor:value xsi:nil="true"/>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>СписокЗданий</dcscor:parameter>
					<dcscor:value xsi:nil="true"/>
				</dcscor:item>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:use>false</dcscor:use>
					<dcscor:parameter>СписокУлиц</dcscor:parameter>
					<dcscor:value xsi:nil="true"/>
				</dcscor:item>
			</dcsset:dataParameters>
			<dcsset:item xsi:type="dcsset:StructureItemGroup">
				<dcsset:order>
					<dcsset:item xsi:type="dcsset:OrderItemAuto"/>
				</dcsset:order>
				<dcsset:selection>
					<dcsset:item xsi:type="dcsset:SelectedItemAuto"/>
				</dcsset:selection>
			</dcsset:item>
		</dcsset:settings>
	</settingsVariant>
</DataCompositionSchema>