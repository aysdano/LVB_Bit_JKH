&НаСервере                                         
Процедура создатьОбновитьПроживающего(Стру)
	Если ложь тогда мКэшПроживающих=новый ТаблицаЗначений КонецЕсли;
	
    Фамилия 		= СокрЛП(стру.FIO);
	Имя 	 		= СокрЛП(стру.NAME);
	Отчество   		= СокрЛП(стру.OTCH);
	ДатаРождения	= ДатаИзСтроки(стру.D_R);
	СНИЛС			= сокрЛП(стру.SNILS);
	ДатаРегистрации = ДатаИзСтроки(стру.D_PR);
	ДатаВыписки     = ДатаИзСтроки(стру.D_V);
	ФизЛицо 			= неопределено;
	Представление   = сокрЛП(Фамилия+" "+Имя + " " +Отчество);
	
	
	Если Объект.ТолькоПоИмеющимсяЛС=Истина тогда
		Если мКэшКвартирЛС = Неопределено тогда
			ЗаполнитьКэшКвартирЛицевыхСчетов();
		КонецЕсли;
		ИмяЛС = СокрЛП(Стру.LS);
		Если СтрДлина(ИмяЛС)<10 тогда
			возврат; //не соотв. стандарту ЛС
		иначе 
			ИмяЛС = лев(ИмяЛС,10)+лб_Сервер.КонтрольныйРазряд(ИмяЛС,10);
		КонецЕсли;	
		
		Если ДанныеЛС(ИмяЛС)= Неопределено тогда
			//Попытка найти ЛС без учета последнего разряда
			ИмяЛС2 = "" + Справочники.бит_ЛицевыеСчета.НайтиПоНаименованию(лев(ИмяЛС,10));			
			
			Сообщить("Не найден ЛС: " + ИмяЛС + "Зато найден:" + ИмяЛС2);
			возврат   //лс отсутствует в базе
			
		КонецЕсли;
		
	
	КонецЕсли;	
	
	
	
	//Удаленные ФИО 
	Если Фамилия = "???" тогда
		Фамилия = СокрЛП(Стру.LS);
		
		//Отбор = новый структура("Фамилия",Фамилия);
		//Мас = мКэшПроживающих.НайтиСтроки(Отбор);
		//Имя = Формат(Мас.Количество()+1,"ЧЦ=3; ЧВН=");
		
		//Представление = Фамилия+" "+Имя;
		Представление = Фамилия;
	КонецЕсли;	
		
	
	ЗаписиКэша = новый массив;
	
	
	
	Если НЕ ПустаяСтрока(СНИЛС) тогда
		Если мНеверныеСНИЛС.Найти(СНИЛС)<>Неопределено тогда
			СНИЛС = "";
		иначе	
			Строка = мКэшПроживающих.Найти(СНИЛС,"СНИЛС");
			Если Строка<>Неопределено и 
				 		(Строка.Имя<>Имя или 
				 		 Строка.Отчество <> Отчество или
						 Строка.ДатаРождения <> ДатаРождения
						 ) тогда //проверим соотведствие ДР 
						
				 мНеверныеСНИЛС.Добавить(СНИЛС);	
				 УдалитьНеверныйСНИЛС(СНИЛС);
				 СНИЛС = "";
			 иначе  //Снилс не найден
				 
			КонецЕсли;	
		КонецЕсли;	
	КонецЕсли;	
	
	//Убираем СНИЛСы
	СНИЛС = "";
	
	
	Если ПустаяСтрока(СНИЛС) тогда
		Отбор = новый Структура("Фамилия,Имя,Отчество,ДатаРождения",
		                         Фамилия,Имя,Отчество,ДатаРождения);		
	Иначе                                                           
		Отбор = новый Структура("СНИЛС",СНИЛС);			
	КонецЕсли;	
	ЗаписиКэша = мКэшПроживающих.НайтиСтроки(Отбор);
	Если ЗаписиКэша.Количество() = 0 тогда
		Физлицо = неопределено
	иначе
		ФизЛицо = ЗаписиКэша[0].Физлицо;
	КонецЕсли;	
	
	
	
	Если ЗаписиКэша.Количество()>0 тогда 
		СтрокаКэша = ЗаписиКэша[0];
	КонецЕсли;	
	
	//Меняем ссылку на наиболее познюю запись кэша
	Для Инд=1 по ЗаписиКэша.Количество()-1 цикл
		ТекД = ?(ЗначениеЗаполнено(СтрокаКэша.ДатаВыписки),'3000-01-01',СтрокаКэша.ДатаВыписки);
		НовД = ?(ЗначениеЗаполнено(ЗаписиКэша[Инд].ДатаВыписки),'3000-01-01',ЗаписиКэша[Инд].ДатаВыписки);		;
		
		Если СтрокаКэша.ДатаРегистрации>ЗаписиКэша[Инд].ДатаРегистрации тогда
			продолжить;			
		ИначеЕсли СтрокаКэша.ДатаРегистрации<ЗаписиКэша[Инд].ДатаРегистрации тогда	
			СтрокаКэша = ЗаписиКэша[Инд];
			продолжить;
		ИначеЕсли  НовД>текД тогда	//здесь даты прописки обе отсутствуют или равны
			СтрокаКэша = ЗаписиКэша[Инд];
			продолжить;			
		КонецЕсли;	
	КонецЦикла;	
	
	//Мы предполагаем, что в в строках может отличаться только Фамилия .
	//для одного ФизЛица Имя, Отчество и ДатаРождения неизменнны
	Если ЗначениеЗаполнено(СтрокаКэша) тогда
		ЭтоПолныйДубль =  (Фамилия = СтрокаКэша.Фамилия);  
		Если ЭтоПолныйДубль тогда
			ОбновитьКонтактуюИнформацию(СтрокаКэша.Физлицо,Стру);
			возврат
		КонецЕсли;	
		                  
	КонецЕсли;	
	
	
	
	Если НЕ ЗначениеЗаполнено(СтрокаКэша) тогда
		ОбъектФЛ = Справочники.бит_Проживающие.СоздатьЭлемент();	
		ОбъектФЛ.Наименование = Представление;
		ОбъектФЛ.СтраховойНомерПФР = СНИЛС;
		ОбъектФЛ.ДатаРождения = ДатаРождения; 		
		ОбъектФЛ.Записать();
		
		ФизЛицо = ОбъектФЛ.Ссылка;
		ЗаписьФИО = РегистрыСведений.бит_ФИОПроживающих.СоздатьМенеджерЗаписи();
		ЗаписьФИО.Период = ?(ЗначениеЗаполнено(ДатаРегистрации),ДатаРегистрации,'1900-01-01');		
		ЗаписьФИО.Активность = Истина;
		ЗаписьФИО.ФизЛицо= ОбъектФЛ.Ссылка;
		ЗаписьФИО.Фамилия = Фамилия;		
		ЗаписьФИО.Имя = Имя;
		ЗаписьФИО.Отчество = Отчество;
		ЗаписьФИО.Записать(истина);
		
		СтрокаКэша = мКэшПроживающих.Добавить();
		СтрокаКэша.ФизЛицо  = ФизЛицо;
		СтрокаКэша.Фамилия = Фамилия;
		СтрокаКэша.Имя     = Имя;
		СтрокаКэша.Отчество = Отчество;  
		СтрокаКэша.ДатаРождения = ДатаРождения;
		СтрокаКэша.ДатаРегистрации = ДатаРегистрации;
		СтрокаКэша.ДатаВыписки = ДатаВыписки;
		СтрокаКэша.Представление = ""+ФизЛицо;		
		возврат;	
	КонецЕсли;
	
	Если ЗначениеЗаполнено(СтрокаКэша) тогда
		
	КонецЕсли;	
	
    //Найдена строка кэша. Проверяем соответствие
	Если ЭтаФорма.Тест100 тогда
		возврат;
	КонецЕсли;	  	

		
	ФИОСовпадает = СтрокаКэша.Фамилия = Фамилия 
					и СтрокаКэша.Имя = Имя
					и СтрокаКэша.Отчество = Отчество;
	СНИЛССовпадает = СТрокаКэша.СНИЛС = СНИЛС;
	ДатаРСовпадает = СтрокаКэша.ДатаРождения = ДатаРождения;
	
		
КонецПроцедуры	

&НаСервере
Процедура ОбновитьКонтактуюИнформацию(ФЛ,Стру);
	Если ложь тогда ФЛ = Справочники.бит_Проживающие.Выбрать().Ссылка КонецЕсли;
	Если не ЗначениеЗаполнено(ФЛ) тогда
		возврат
	КонецЕсли;	
		
	КИзменению = новый Структура;
	АдресФЛ = СокрЛП(Стру.FAKT_ADR);
	Если НЕ ПустаяСтрока(АдресФЛ) и ПустаяСтрока(ФЛ.ИнформАдресПроживающего) тогда
		КИзменению.Вставить("ИнформАдресПроживающего",АдресФЛ);
	КонецЕсли;
	
	
	
	Если КИзменению.Количество()>0 тогда
		СпрОбъект = ФЛ.ПолучитьОбъект();
		ЗаполнитьЗначенияСвойств(СпрОбъект,КИзменению);
		СпрОбъект.Записать();
	КонецЕсли;	
	
КонецПроцедуры

&НаСервере
Процедура УдалитьНеверныйСНИЛС(СНИЛС)
	Отбор = новый структура("СНИЛС", СНИЛС);
	МассивУдл = мКэшПроживающих.НайтиСтроки(Отбор);
	Для каждого СтрокаКэша из МассивУдл цикл
		Если ЗначениеЗаполнено(СтрокаКэша.ФизЛицо) тогда
			СпрОбъект = СтрокаКэша.Физлицо.ПолучитьОбъект();
			Если ложь тогда СпрОбъект = Справочники.бит_Проживающие.СоздатьЭлемент() КонецЕсли;
			СпрОбъект.СтраховойНомерПФР = "";
			СпрОбъект.Записать();
		КонецЕсли;
		СтрокаКэша.СНИЛС = "";
	КонецЦикла;	 			
КонецПроцедуры	


&НаСервере
Функция ДатаИзСтроки(знач Стр)
	Стр = СокрЛП(Стр);
	Если СтрДлина(Стр) = 10 тогда
		ГодС = Сред(Стр,7,4);
	    МесяцС = Сред(Стр,4,2);
		ДеньС = лев(Стр,2);
		Если (ГодС>"2019") или 
				 (МесяцС="00") Или (МесяцС>"12") или
		    	 (ДеньС="00") Или (ДеньС>"31") 
		тогда
			ДатаСтр =  '00010101';
		иначе
			ДатаСтр = Дата(ГодС+МесяцС+ДеньС);
		КонецЕсли;
	иначеЕсли Стр = ".  ." или пустаяСтрока(Стр) тогда 
		ДатаСтр = '00010101';
	иначе	
		ДатаСтр = '00010101';
		Сообщить("Формат даты не разобран: " +  Стр);
	КонецЕсли;
	возврат Дата(ДатаСтр)
КонецФункции	

