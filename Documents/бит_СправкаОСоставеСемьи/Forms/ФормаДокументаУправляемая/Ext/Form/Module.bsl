&НаКлиенте
// Процедура открытия формы выбора справочника - всего списка или активной строки.
//
Процедура ПолучитьИзСправочникаПроживающие(Элемент = Неопределено)
	
	ПараметрыФормы = Новый Структура("ЗакрыватьПриВыборе", Ложь);
	ПараметрыФормы.Вставить("ЛицевойСчет",Объект.ЛицевойСчет);
	Если Элемент = Неопределено Тогда
		ОткрытьФорму("Справочник.бит_Проживающие.ФормаВыбора", ПараметрыФормы, ЭтаФорма);	
	Иначе
		ОткрытьФорму("Справочник.бит_Проживающие.ФормаВыбора", ПараметрыФормы, Элемент);	
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСправкуОбОтсутствииПрописанных(Команда)
	
	Результат = Сформировать("СправкаОбОтсутствииПрописанных");
	
	АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
	
	бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
	,"бит_СправкаОСоставеСемьи"
	,"СправкаОбОтсутствииПрописанных"
	,"Справка об отсутствии прописанных"
	
	,АдресТабличногоДокументаВоВременномХранилище
	
	,Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСправкуОСоставеСемьи(Команда)
	
	Если Объект.Ссылка = ПредопределенноеЗначение("Документ.бит_СправкаОСоставеСемьи.ПустаяСсылка") Или Модифицированность Тогда
		
		Проведен    = Объект.Проведен;
		СтрПроведен = ?(Проведен, " и провести","");
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьСправкуОСоставеСемьиЗавершение1Бит", ЭтотОбъект), "Документ изменен. Для печати его необходимо записать "+ СтрПроведен +".
		|Записать" + СтрПроведен + "?",
		РежимДиалогаВопрос.ОКОтмена, , 
		КодВозвратаДиалога.Отмена,
		"Документ изменен");
		
	Иначе
		
		Результат = Сформировать("СправкаОСоставеСемьи");
		
		АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
		
		бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
		,"бит_СправкаОСоставеСемьи"
		,"СправкаОСоставеСемьи"
		,"Справка с места жительства"
		
		,АдресТабличногоДокументаВоВременномХранилище
		
		,Объект.Ссылка);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьСправкуОСоставеСемьиЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		
		Результат = ЗаписатьДокументНаСервере();
		
		Если Результат Тогда
			
			Результат = Сформировать("СправкаОСоставеСемьи");
			
			АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
			
			бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
			,"бит_СправкаОСоставеСемьи"
			,"СправкаОСоставеСемьи"
			,"Справка с места жительства"
			
			,АдресТабличногоДокументаВоВременномХранилище
			
			,Объект.Ссылка);
			
		Иначе
			
			ПоказатьПредупреждение(Новый ОписаниеОповещения("СоздатьСправкуОСоставеСемьиЗавершениеБИТ", ЭтотОбъект), "Операция не выполнена!");
			
		КонецЕсли;   
		
	КонецЕсли;
	
КонецПроцедуры

