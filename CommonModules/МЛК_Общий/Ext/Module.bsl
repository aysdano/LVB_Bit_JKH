			Дом = СпрЛС.Ссылка.Здание;
			Квартира = СпрЛС.Ссылка.Квартира;
			
			Если Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
				Запрос.УстановитьПараметр("Объект", Дом);
				Запрос.Текст = ТекстГрупповыеСчетчики;
