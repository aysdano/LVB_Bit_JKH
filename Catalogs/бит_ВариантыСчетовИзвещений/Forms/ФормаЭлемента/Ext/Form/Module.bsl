&НаКлиенте
Процедура ЗагрузитьВнешнийМакет(Команда)
	
	ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	
	ДиалогВыбораФайла.Фильтр                  = "Табличный документ(*.mxl)|*.mxl";
	ДиалогВыбораФайла.Расширение              = "mxl";
	ДиалогВыбораФайла.Заголовок               = "Выберите файл";
	ДиалогВыбораФайла.ПредварительныйПросмотр = Ложь;
	ДиалогВыбораФайла.ИндексФильтра           = 0;
	
	Если ДиалогВыбораФайла.Выбрать() Тогда
		
		ИмяФайла = ДиалогВыбораФайла.ПолноеИмяФайла;
		
		// БИТ_ЖКХ 28.01.2015{{
		// ПолеТабличногоДокумента.Прочитать(ИмяФайла);.
		ПрочитатьНаСервере(ИмяФайла);
		// БИТ_ЖКХ 28.01.2015}}
		
	КонецЕсли;
	
КонецПроцедуры

// БИТ_ЖКХ 28.01.2015{{
&НаСервере
Процедура ПрочитатьНаСервере(ИмяФайла)
	
	ПолеТабличногоДокумента.Прочитать(ИмяФайла);
	
КонецПроцедуры
