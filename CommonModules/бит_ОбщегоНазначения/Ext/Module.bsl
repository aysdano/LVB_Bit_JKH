					КонецЦикла;
					
				Иначе
					
					ИтогНачисления = КоммунальныеУслуги.Итог("Начислено");
					Для каждого ТекСтрока Из КоммунальныеУслуги Цикл
						ТекСтрока.Сумма = ТекСтрока.Сумма + ?(ИтогНачисления = 0,0,ТекСтрока.Начислено/ИтогНачисления) * СуммаДляРаспределения;
					КонецЦикла; 
					
				КонецЕсли;
				
			КонецЕсли;
			
			
		ИначеЕсли (ШаблонИзвещения.Сальдо = Перечисления.ДаНет.Да  И ШаблонИзвещения.Кредит = Перечисления.ДаНет.Нет) Тогда	// Для НачислятьПениСУчетомПереплаты
			
