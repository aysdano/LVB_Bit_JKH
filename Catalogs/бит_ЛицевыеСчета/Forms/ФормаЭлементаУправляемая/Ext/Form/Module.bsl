	ПараметрыФормы.Вставить("Объект"     , Объект.Ссылка);
	ПараметрыФормы.Вставить("Дата"       , ТекущаяДата());
	
	ОткрытьФорму("Документ.бит_УстановкаСчетчика.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзСправочника", ПараметрыФормы), ЭтаФорма);
	
