
#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
Процедура УстановитьПометкуНаУдалениеДокумента()
	
	ТекущаяСтрока = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
		// БИТ_ЖКХ 17.04.2014
		ПометкаУдаления = ПометкаУдаленияНаСервере(ТекущаяСтрока.Документ);
		
		Если НЕ ПометкаУдаления Тогда
			Ответ = Неопределено;
			
			ПоказатьВопрос(Новый ОписаниеОповещения("УстановитьПометкуНаУдалениеДокументаЗавершение1", ЭтотОбъект, Новый Структура("ТекущаяСтрока", ТекущаяСтрока)), "Пометить элемент на удаление?", РежимДиалогаВопрос.ДаНет); 
			
		Иначе
			
			ПоказатьВопрос(Новый ОписаниеОповещения("УстановитьПометкуНаУдалениеДокументаЗавершение", ЭтотОбъект, Новый Структура("Ответ, ТекущаяСтрока", Ответ, ТекущаяСтрока)), "Снять с элемента пометку на удаление?", РежимДиалогаВопрос.ДаНет); 
			
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуНаУдалениеДокументаЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущаяСтрока = ДополнительныеПараметры.ТекущаяСтрока;
	
	Ответ = РезультатВопроса; 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда

		ЗаписатьНаСервере(ТекущаяСтрока.Документ,Истина);
		
		ТекущаяСтрока.Картинка = БиблиотекаКартинок.ДокументПомеченНаУдалениеКоннекторВерх;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьПометкуНаУдалениеДокументаЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = ДополнительныеПараметры.Ответ;
	ТекущаяСтрока = ДополнительныеПараметры.ТекущаяСтрока;
	
	
	Ответ = РезультатВопроса; 
	
	Если Ответ = КодВозвратаДиалога.Да Тогда

		ЗаписатьНаСервере(ТекущаяСтрока.Документ,Ложь);
		
		ТекущаяСтрока.Картинка = БиблиотекаКартинок.ДокументЗаписанКоннекторВерх;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПометкаУдаленияНаСервере(Документ)
	
	Возврат Документ.ПометкаУдаления;
	
КонецФункции	

&НаСервере
Процедура ЗаписатьНаСервере(Документ,ПометкаУдаления)
	
	ДокументОбъект = Документ.ПолучитьОбъект();
	ДокументОбъект.УстановитьПометкуУдаления(ПометкаУдаления);
	ДокументОбъект.Записать();
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

// Процедура - обработчик события "ПриСозданииНаСервере" формы.
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	Организация  = Параметры.Организация;
	ДатаЗакрытия = Параметры.ДатаЗакрытия;
	
	ТаблицаДокументовРеализации.Параметры.УстановитьЗначениеПараметра("ДатаНачала" , НачалоМесяца(ДатаЗакрытия));
	ТаблицаДокументовРеализации.Параметры.УстановитьЗначениеПараметра("ДатаКонец"  , КонецМесяца(ДатаЗакрытия));
	ТаблицаДокументовРеализации.Параметры.УстановитьЗначениеПараметра("Организация", Организация);
	
	ОбновитьДерево();
	
КонецПроцедуры // ПриСозданииНаСервере()

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура ОбновитьДеревоФормы(Команда)
	
	ОбновитьДерево();
	
КонецПроцедуры

&НаКлиенте
Процедура ПоказатьДвижения(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
		
		ПараметрыФормы = Новый Структура("ДокументСсылка", ТекущаяСтрока.Документ);
		
		ОткрытьФорму("Обработка.бит_КорректировкаДвижений.Форма", 
		ПараметрыФормы, 
		ЭтаФорма, 
		ТекущаяСтрока.Документ);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Провести(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
		
		ПровестиНаСервере(ТекущаяСтрока.Документ);
		
		ТекущаяСтрока.Картинка = БиблиотекаКартинок.ДокументПроведенКоннекторВерх;
		
	КонецЕсли;
	
КонецПроцедуры

// БИТ_ЖКХ 17.04.2014
&НаСервере
Процедура ПровестиНаСервере(Документ)
	
	ДокументОбъект = Документ.ПолучитьОбъект();
	ДокументОбъект.Записать(РежимЗаписиДокумента.Проведение);
	
КонецПроцедуры
// БИТ_ЖКХ 17.04.2014

&НаКлиенте
Процедура Разпровести(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоДокументов.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если НЕ ТекущаяСтрока.ПолучитьРодителя() = Неопределено Тогда
		
		// БИТ_ЖКХ 17.04.2014
		РазпровестиНаСервере(ТекущаяСтрока.Документ);
		
		Если Не ПометкаУдаленияНаСервере(ТекущаяСтрока.Документ) Тогда
			ТекущаяСтрока.Картинка = БиблиотекаКартинок.ДокументЗаписанКоннекторВерх;
		КонецЕсли;
		// БИТ_ЖКХ 17.04.2014
		
	КонецЕсли;
	
КонецПроцедуры

// БИТ_ЖКХ 17.04.2014
&НаСервере
Процедура РазпровестиНаСервере(Документ)
	
	ДокументОбъект = Документ.ПолучитьОбъект();
	
	Если Не ДокументОбъект.ПометкаУдаления Тогда
		ДокументОбъект.Записать(РежимЗаписиДокумента.ОтменаПроведения);
	КонецЕсли;
	
КонецПроцедуры
