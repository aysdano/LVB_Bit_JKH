&НаКлиенте
Процедура ТестСоединения(Команда)
	ТестСоединенияНаСервере();
КонецПроцедуры

&НаСервере
Процедура ТестСоединенияНаСервере()
	
	// 1. Сначала проверим, есть ли интернет соединение
	
	ЗапросБезКодировки = "";
	СтрокаОписанияОшибки = "";
	
	ЕстьОтвет = Истина;
	
	АдресСервисаСтр = СокрЛП(Объект.АдресКабинетов);
	АдресРесурса = "/api/v4/applications/"+Строка(СокрЛП(Объект.НомерПриложения));
	
	ЗапросБезКодировки = ЗапросБезКодировки + Строка(АдресСервисаСтр) + Строка(АдресРесурса);
	
	СтрокаПараметров = "";
	
	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса + СтрокаПараметров);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		ЕстьОтвет = Ложь;
		Сообщить("Тест соединения. Ошибка при отправке запроса: " + ОписаниеОшибки());
	КонецПопытки;
	
	Если ЕстьОтвет Тогда
		СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		Если Ответ.КодСостояния = 200 Тогда
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				Если СокрЛП(РезультатПроверки)="false" Тогда
					Сообщить("Соединение не установлено");
				Иначе
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
					ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Ложь, , ФорматДатыJSON.ISO);
					ЧтениеJSON.Закрыть();
					Сообщить("Соединение установлено с "+Строка(ЗагруженныеДанные.ShortDescription));
				КонецЕсли;
			КонецЕсли;
			
			
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			Сообщить("Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
			СтрокаОписанияОшибки = Строка(ОписаниеОшибки()); 
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Сообщить("Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
			СтрокаОписанияОшибки = Строка(ОписаниеОшибки()); 
		ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Сообщить("Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
			СтрокаОписанияОшибки = Строка(ОписаниеОшибки()); 
		Иначе
			Сообщить("Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
			СтрокаОписанияОшибки = Строка(ОписаниеОшибки()); 
		КонецЕсли;
		
		// Запишем в журнал результат
		ИмяСобытияВЖурнал = "Проверка соединения с МЛК и создание статусов";
		КодСостояния = Ответ.КодСостояния;
		СтрокаОтвета = СтрокаОтвет;	
		МЛК_Общий.ЗаписатьДанныеВЖурнал(ИмяСобытияВЖурнал,КодСостояния,ЗапросБезКодировки,СтрокаОтвета,СтрокаОписанияОшибки,ТекущаяДатаСеанса());	
	Иначе	
		
	КонецЕсли;
	
	// Теперь заполним данные о статусах обращений
	ПодгрузитьСтатусы();
	
КонецПроцедуры

&НаСервере
Процедура ПодгрузитьСтатусы()
	// вместо objects или events пиши statuses. например api/v2/statuses
	
	ЕстьОтвет = Истина;
	
	АдресСервисаСтр = СокрЛП(Объект.АдресКабинетов);
	АдресРесурса = "/api/v4/statuses?ApplicationId="+Объект.НомерПриложения;

	HTTPЗапрос = Новый HTTPЗапрос(АдресРесурса);
	HTTPЗапрос.Заголовки.Вставить("Authorization", "Basic "+Строка(Объект.Токен));
	HTTPСоединение = Новый HTTPСоединение(АдресСервисаСтр, , , , , 30, Новый ЗащищенноеСоединениеOpenSSL);
	Попытка
		Ответ = HTTPСоединение.Получить(HTTPЗапрос);
	Исключение
		Сообщить("Ошибка при отправке запроса: " + ОписаниеОшибки());
		ЕстьОтвет = Ложь;
	КонецПопытки;
	
	Если ЕстьОтвет Тогда
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаОтвет = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			
			Если Не ПустаяСтрока(СтрокаОтвет) Тогда
				РезультатПроверки = СтрокаОтвет;
				Если СокрЛП(РезультатПроверки)="false" Тогда
					Сообщить("Соединение не установлено");
				Иначе
					
					
					ЧтениеJSON = Новый ЧтениеJSON;
					ЧтениеJSON.УстановитьСтроку(РезультатПроверки);
					ЗагруженныеДанные = ПрочитатьJSON(ЧтениеJSON, Истина, , ФорматДатыJSON.ISO);
					ЧтениеJSON.Закрыть();
					
					ТЗ = РаспарситьСтатусы1(ЗагруженныеДанные);
					
					Для Каждого СтрСтатус Из ТЗ Цикл
						Если Найти(нрег(СтрСтатус.Статус),"закрыт")<>0 или  Найти(нрег(СтрСтатус.Статус),"выполнено")<>0 Тогда
							Объект.СтатусЗакрыто = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"отклонен")<>0 Тогда
							Объект.СтатусОтклонено = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"обработан")<>0 Тогда
							Объект.СтатусОбработано = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"работе")<>0 Тогда
							Объект.СтатусВРаботе = СтрСтатус.Ид_Статуса;
						ИначеЕсли Найти(нрег(СтрСтатус.Статус),"отправлено в ук")<>0 Тогда
							Объект.СтатусОтправленоВУК = СтрСтатус.Ид_Статуса;
							
						КонецЕсли;	
						
					КонецЦикла;	
				КонецЕсли;
			КонецЕсли;
		ИначеЕсли Ответ.КодСостояния = 500 Тогда
			Сообщить("Обновление статусов. "+"Ошибка на сервере. Код ошибки: 500"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 404 Тогда
			Сообщить("Обновление статусов. "+"Неверная ссылка. Код ошибки: 404"+". "+Строка(ОписаниеОшибки()));
		ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Сообщить("Обновление статусов. "+"Ошибка на сервере. Код ошибки: 301"+". "+Строка(ОписаниеОшибки()));
		Иначе
			Сообщить("Обновление статусов. "+"Неизвестная ошибка"+". "+Строка(ОписаниеОшибки()));
		КонецЕсли;
	КонецЕсли;	
КонецПроцедуры	

&НаСервере
Функция РаспарситьСтатусы1(Данные)	
	
	ТЗ = Новый ТаблицаЗначений;
	ТЗ.Колонки.Добавить("Статус");
	ТЗ.Колонки.Добавить("ИД_Статуса");
	
	Для Каждого стр из Данные Цикл
		
		Нов = ТЗ.Добавить();
		
		Нов.Статус            = Стр["Name"];
		Нов.ИД_Статуса    = Стр["id"];       // ИД события по которому будем менять статус
		Нов.ИД_Статуса    = СтрЗаменить(СокрЛП(Нов.ИД_Статуса),Символы.НПП,"");
	КонецЦикла;	
	
	Возврат ТЗ;
	
	
КонецФункции

&НаСервере
Функция ЗапуститьРаботуССистемойНаСервере()
	
	Если Не ЗначениеЗаполнено(Объект.Комиссия) Тогда
		Сообщить("Заполните способ комиссии");
		Возврат Ложь;
	КонецЕсли;
	Если Не ЗначениеЗаполнено(Объект.БанковскийСчет) Тогда
		Сообщить("Заполните расчетный счет");
		Возврат Ложь;
	КонецЕсли;
	
	// Состояние("Запущен процесс создания приложения, немного подождите ....");
	// Сначала нужно создать все справочники
	
	
	ПриложениеСоздано = ОтправитьЗапросЗаСозданиеПриложения(Объект.Организация);
	
	Если ПриложениеСоздано Тогда
		
		ФоновыеЗадания.Выполнить("МЛК_Общий.МЛК_ПервичнаяСинхронизация");
		Сообщить("Запущена первичная синхронизация, перезапустите 1с.");
		Элементы.ЗапуститьРаботуССистемой.Доступность=Ложь;
		
		Возврат Истина;
	Иначе
		Сообщить("При создании приложения возникли ошибки. Повторите попытку создания позже");
		Возврат Ложь;
	КонецЕсли;	
КонецФункции

&НаКлиенте
Процедура ЗапуститьРаботуССистемой(Команда)
	
	ОткрытьФорму("Справочник.МЛК_Настройки.Форма.ПользовательскоеСоглашение",,,,,,Новый ОписаниеОповещения("ОбработкаКомандыЗавершение", ЭтотОбъект));
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаКомандыЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат =  "Нет" Или Результат = Неопределено Тогда
		Возврат
	КонецЕсли;
	
	Состояние("Запущен процесс создания приложения, подождите пару минут",);
	Создано = ЗапуститьРаботуССистемойНаСервере();
	Если Создано Тогда
		
		Обработчик = Новый ОписаниеОповещения("ПерезапуститьПрограмму", ЭтотОбъект);
		Кнопки = Новый СписокЗначений;
		Кнопки.Добавить("Перезапустить", НСтр("ru = 'Перезапустить'"));
		Кнопки.Добавить("НеПерезапускать", НСтр("ru = 'Не перезапускать'"));
		ТекстВопроса = НСтр("ru = 'Для применения изменений требуется перезапустить программу.'");
		ПоказатьВопрос(Обработчик, ТекстВопроса, Кнопки);
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ПерезапуститьПрограмму(Ответ, ПараметрыВыполнения) Экспорт
	Если Ответ = "Перезапустить" Тогда
		ЗавершитьРаботуСистемы(Ложь, Истина);
	КонецЕсли;
КонецПроцедуры

&НаСервере
Процедура ПриОткрытииНаСервере()
	Если ЗначениеЗаполнено(Объект.АдресКабинетов) Тогда
		Элементы.ЗапуститьРаботуССистемой.Доступность=Ложь;
	КонецЕсли;	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	ПриОткрытииНаСервере();
КонецПроцедуры

