	ТекущаяСтрока = Элементы.Льготы.ТекущиеДанные;
	
	ВладелецЛьготы = ?(ТекущаяСтрока = Неопределено, Неопределено, ТекущаяСтрока.ФизЛицо);
	Льгота         = ?(ТекущаяСтрока = Неопределено, Неопределено, ТекущаяСтрока.Льгота);
	
	Эл = ТаблицаСоставаСемьи.Отбор.ЛицевойСчет;
	
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.Значение   = Объект.Ссылка;
	Эл.Использование    = Истина;
	
	Эл = ТаблицаСоставаСемьи.Отбор.ВладелецЛьготы;
	
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.Значение   = ВладелецЛьготы;
	Эл.Использование    = Истина;
	
	Эл = ТаблицаСоставаСемьи.Отбор.Льгота;
	Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
	Эл.Значение   = Льгота;
	Эл.Использование    = Истина;
	
	ПрочитатьДанныеПолучательЛьготыНаСервере();
	
