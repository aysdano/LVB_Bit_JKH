	СтруктураРезультат.Вставить("Пункт", "");
	СтруктураРезультат.Вставить("ДомНомер", "");
	СтруктураРезультат.Вставить("КорпусНомер", "");
	СтруктураРезультат.Вставить("КвартираНомер", "");
	
	Страна = СтрНайти(АдресXML, "country"":");	
