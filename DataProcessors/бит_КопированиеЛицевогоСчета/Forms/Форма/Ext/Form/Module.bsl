// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ПолучитьСписокПоТаблицеУслуги(Услуга, Приемник)
	
	ИмяПоля    = "";
	ИмяТаблицы = "";
	Если ТипЗнч(Приемник) = Тип("СправочникСсылка.бит_РежимыПотребленияУслуг") Тогда
		
		ИмяПоля    = "РежимПотребленияУслуг";
		ИмяТаблицы = "РежимыПотребленияУслуг";
		
	ИначеЕсли ТипЗнч(Приемник) = Тип("СправочникСсылка.бит_ПоставщикиУслуг") Тогда 
		
		ИмяПоля    = "Поставщик";
		ИмяТаблицы = "Поставщики";
		
	ИначеЕсли ТипЗнч(Приемник) = Тип("ПеречислениеСсылка.бит_СпособыРасчетаПоУслугам") Тогда 
		
		ИмяПоля    = "СпособРасчета";
		ИмяТаблицы = "СпособыРасчета";
		
	КонецЕсли;
	
	Если ИмяПоля = "" ИЛИ ИмяТаблицы = "" Тогда
		Возврат Новый Массив;
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Услуга", Услуга);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	Таблица."+ИмяПоля+" КАК Ссылка
	|ИЗ
	|	Справочник.бит_УслугиЖКХ."+ИмяТаблицы+" КАК Таблица
	|ГДЕ
	|	Таблица.Ссылка = &Услуга";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Список = Результат.ВыгрузитьКолонку("Ссылка");
	
	Поиск = Список.Найти(Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам);
	Если НЕ Поиск = Неопределено Тогда
		Список.Удалить(Поиск);
	КонецЕсли; 
	
	Возврат Список;
	
КонецФункции // ()

