Функция ПолучитьТаблицуДолга(СсылкаОС, Момент, ДокПени, Организация)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.Текст =
	
	"ВЫБРАТЬ
	|	бит_НастройкаПараметровЖКХСрезПоследних.ПоследнийДеньПриемаПлатежей КАК ПоследнийДеньПриемаПлатежей
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних КАК бит_НастройкаПараметровЖКХСрезПоследних
	|ГДЕ
	|	бит_НастройкаПараметровЖКХСрезПоследних.Организация = &Организация";
	
	СрокОплаты = Запрос.Выполнить().Выгрузить();
	СрокОплаты = -СрокОплаты[0].ПоследнийДеньПриемаПлатежей;
	
	Массив = Новый Массив;
	Для каждого Строка Из ДокПени  Цикл
		Массив.Добавить(Строка.ЛС);
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата",		 Период.ДатаОкончания);
	Запрос.Текст =
	
	
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	ЕСТЬNULL(бит_ПениПоУслугамЖКХСрезПоследних.ПериодНачисления.КоличествоМесяцев, 0) КАК КоличествоМесяцев
	|ИЗ
	|	РегистрСведений.бит_ПениПоУслугамЖКХ.СрезПоследних(
	|			&Дата,
	|			Организация = &Организация
	|				И Начислять = ИСТИНА
	|				И Процент >= 0) КАК бит_ПениПоУслугамЖКХСрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	КоличествоМесяцев УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	КоличествоИнтервалов = Выборка.Количество(); 
	Если КоличествоИнтервалов = 0 Тогда
		ТекстСообщения = НСтр("ru = 'Необходимо настроить периоды начисления пени в регистре сведений Пени по услугам ЖКХ.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат Неопределено;
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"       , Момент);
	Запрос.УстановитьПараметр("ДатаНачала" , Момент);
	Запрос.УстановитьПараметр("ДатаКонца"  , ?(СсылкаОС<> Неопределено,Новый МоментВремени(Период.ДатаОкончания, СсылкаОС),КонецДня(Период.ДатаОкончания)));
	
	//Лицевойсчет2 = Справочники.бит_ЛицевыеСчета.найтипоНаименованию("76093009990");
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Массив);
	Запрос.УстановитьПараметр("Ссылка"     , СсылкаОС);
	//Запрос.УстановитьПараметр("ТекущаяДата", Дата("20200830"));
	Запрос.УстановитьПараметр("ТекущаяДата", (Период.ДатаОкончания));
	Запрос.УстановитьПараметр("СрокОплаты", СрокОплаты);
	ТекстОстатки = "";
	ТекстОбороты = "";
	ПервыйЭлемент = Истина;
	ПредыдущийЭлемент = 0;
	ПоследнийМесяц = 1;
	
	Пока Выборка.Следующий() Цикл
		
		КоличествоИнтервалов = КоличествоИнтервалов - 1;
		
		//Остатки.
		Если НЕ ПервыйЭлемент Тогда
			ТекстОстатки = ТекстОстатки + " ОБЪЕДИНИТЬ ВСЕ ";
		КонецЕсли; 
		
		ТекстОстатки = ТекстОстатки + "
		|ВЫБРАТЬ
		|	" + ?(ПервыйЭлемент, 999, ПредыдущийЭлемент) + " КАК КоличествоМесяцев,
		|	НачисленияПоУслугамЖКХПоПериодуОстатки.ЛицевойСчет КАК ЛицевойСчет,
		|	НачисленияПоУслугамЖКХПоПериодуОстатки.УслугаЖКХ КАК УслугаЖКХ,
		|	СУММА(НачисленияПоУслугамЖКХПоПериодуОстатки.СуммаОстаток) КАК СуммаОстаток";
		
		Если ПервыйЭлемент Тогда
			ТекстОстатки = ТекстОстатки + "
			|ПОМЕСТИТЬ ВТ_Остатки ";
		КонецЕсли; 
		
		ТекстОстатки = ТекстОстатки + "
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХПоПериоду.Остатки(ДОБАВИТЬКДАТЕ(ДОБАВИТЬКДАТЕ(&ДатаНачала, ДЕНЬ, &СрокОплаты), МЕСЯЦ, -" + Выборка.КоличествоМесяцев + "), ЛицевойСчет В (&ЛицевойСчет)) КАК НачисленияПоУслугамЖКХПоПериодуОстатки
		|
		|СГРУППИРОВАТЬ ПО
		|	НачисленияПоУслугамЖКХПоПериодуОстатки.ЛицевойСчет,
		|	НачисленияПоУслугамЖКХПоПериодуОстатки.УслугаЖКХ";
		
		
		//Обороты.
		Если ПервыйЭлемент Тогда
			ТекстОбороты = ТекстОбороты + 
			";
			|
			|////////////////////////////////////////////////////////////////////////////////";
		Иначе
			ТекстОбороты = ТекстОбороты + " ОБЪЕДИНИТЬ ВСЕ ";
		КонецЕсли; 
		
		ТекстОбороты = ТекстОбороты + "
		|ВЫБРАТЬ
		|	" + ?(ПервыйЭлемент, 999, ПредыдущийЭлемент) + " КАК КоличествоМесяцев,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
		|					И бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор <> &Ссылка
		|				ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаОборот * -1
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Оплата,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ КАК УслугаЖКХ,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
		|					И бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Регистратор <> &Ссылка
		|				ТОГДА бит_НачисленияПоУслугамЖКХПоПериодуОбороты.СуммаРасход
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК Разовые,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Период КАК Период,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов";
		
		Если ПервыйЭлемент Тогда
			ТекстОбороты = ТекстОбороты + "
			|ПОМЕСТИТЬ ТаблицаОплаты ";
		КонецЕсли; 
		
		ТекстОбороты = ТекстОбороты + "
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХПоПериоду.Обороты(ДОБАВИТЬКДАТЕ(&ДатаНачала, МЕСЯЦ, -" + Выборка.КоличествоМесяцев + "), &ДатаКонца, Регистратор, ЛицевойСчет в (&ЛицевойСчет)) КАК бит_НачисленияПоУслугамЖКХПоПериодуОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.УслугаЖКХ,
		|   бит_НачисленияПоУслугамЖКХПоПериодуОбороты.Период,
		|	бит_НачисленияПоУслугамЖКХПоПериодуОбороты.ПериодВзаиморасчетов";
		
		
		ПервыйЭлемент = Ложь;
		ПредыдущийЭлемент = Выборка.КоличествоМесяцев;
		
	КонецЦикла; 
	
	// Итоговый текст запроса. Смещаем всю сумму переплат в самый поздний период,
	// где наибольшей процент пени, чтобы уменьшить долг.
	
	
	Запрос.Текст = ТекстОстатки + ТекстОбороты +
	";
	|ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.УслугаЖКХ КАК УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.ПериодВзаиморасчетов КАК ПериодВзаиморасчетов,
	|	бит_НачисленияПоУслугамЖКХПоПериодуОстатки.СуммаОстаток КАК СуммаОстаток
	|ПОМЕСТИТЬ ВТ_ОстаткиМесяц
	|ИЗ
