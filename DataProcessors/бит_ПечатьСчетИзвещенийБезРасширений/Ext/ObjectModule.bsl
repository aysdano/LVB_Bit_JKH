Процедура бит_СформироватьИСохранитьКвитанции(Каталог) Экспорт
	
	РасштрениеСохранения = ".pdf";
	ТипСохраняемогоДокумента = ТипФайлаТабличногоДокумента.PDF;
	Если ФорматСохранения = "2" Тогда
		РасштрениеСохранения = ".xlsx";
		ТипСохраняемогоДокумента = ТипФайлаТабличногоДокумента.XLSX;
	КонецЕсли; 
	
	//melnik для долговой квитанции
	Если МакетКв = Справочники.бит_ВариантыСчетовИзвещений.бит_Долговая Тогда
		ДляДолговой = Истина;
	Иначе
		ДляДолговой = Ложь;
	КонецЕсли;
	
	Если МакетКв = Справочники.бит_ВариантыСчетовИзвещений.бит_Основная2023 Тогда
		Единая2023 = Истина;
	Иначе
		Единая2023 = Ложь;
	КонецЕсли;
	
	//shevtsov 02/07/26 Начало
	Единая2026 = МакетКв = Справочники.бит_ВариантыСчетовИзвещений.бит_Основная2026;
	//shevtsov 02/07/26 Окончание
	
	Если ФорматПечатиКвитанций = 1 Тогда 
		    ОтборУчасток = Ложь;
			Запрос = Новый Запрос;
