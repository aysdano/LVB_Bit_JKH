КонецПроцедуры

&НаСервере
Процедура ПослеЗаписиНаСервере(ТекущийОбъект, ПараметрыЗаписи)
	
	ОпределениеПола();
	ЗаписатьДанныеФИО();
	
	бит_ЗащитаПерсональнойИнформации.ЗаписатьДанныеФИОВРегистр(Объект.Ссылка, Фамилия, Имя, Отчество);
	
	СправочникОбъект = ДанныеФормыВЗначение(Объект, Тип("СправочникОбъект.бит_Проживающие"));
	
	СправочникОбъект.СинхронизироватьНаименованияСотрудников(Объект.Ссылка);
	
	ЗначениеВДанныеФормы(СправочникОбъект, Объект);
	
	// Проведение заполненнных данных со страницы Дополнительные сведения. 
	// В периодический регистр бит_ДопСведенияОПроживающих.
	Запрос = Новый Запрос;
	
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ДопСведенияОПроживающихСрезПоследних.ВидСведений КАК ВидСведений,
	|	ЕСТЬNULL(бит_ДопСведенияОПроживающихСрезПоследних.Значение, НЕОПРЕДЕЛЕНО) КАК Значение
	|ИЗ
	|	РегистрСведений.бит_ДопСведенияОПроживающих.СрезПоследних(&Период, Проживающий.Ссылка = &Ссылка) КАК бит_ДопСведенияОПроживающихСрезПоследних";
	
	Запрос.УстановитьПараметр("Период", ПериодДопДанных);
	Запрос.УстановитьПараметр("Ссылка", Объект.Ссылка);
	
	Результат = Запрос.Выполнить().Выгрузить();                                
	
	ТЗ = Новый ТаблицаЗначений;
	
	ТЗ.Колонки.Добавить("ВидСведений");
	ТЗ.Колонки.Добавить("Значение");
	
	Для каждого ТекСтрока Из ДопДанныеПроживающих Цикл
		
		НайденнаяСтрока = Результат.Найти(ТекСтрока.ВидСведений, "ВидСведений");
		
		Если НайденнаяСтрока = Неопределено Тогда 
			
			Если ЗначениеЗаполнено(ТекСтрока.Значение) Тогда
				
				НоваяСтрока = ТЗ.Добавить();
				
				НоваяСтрока.ВидСведений = ТекСтрока.ВидСведений;
				НоваяСтрока.Значение    = ТекСтрока.Значение;
				
			КонецЕсли;
			
		Иначе
			
			НоваяСтрока = ТЗ.Добавить();
			
			НоваяСтрока.ВидСведений = ТекСтрока.ВидСведений;
			НоваяСтрока.Значение    = ТекСтрока.Значение;
			
		КонецЕсли;
		
	КонецЦикла;
	
	Если ТЗ.Количество()<> 0 Тогда
		
		Для каждого Строка Из ТЗ Цикл
			
			Запись = РегистрыСведений.бит_ДопСведенияОПроживающих.СоздатьМенеджерЗаписи();
			
			Запись.Проживающий = Объект.Ссылка;
			Запись.Период      = ПериодДопДанных;
			Запись.ВидСведений = Строка.ВидСведений;
			Запись.Значение    = Строка.Значение;
			
			Запись.Записать(Истина);
			
		КонецЦикла; 
		
	КонецЕсли;
	
    // СтандартныеПодсистемы.КонтактнаяИнформация
    УправлениеКонтактнойИнформацией.ПослеЗаписиНаСервере(ЭтотОбъект, ТекущийОбъект);
    // Конец СтандартныеПодсистемы.КонтактнаяИнформация
	
	//+bit_semenov.v_19.11.2021
	бит_ЗаполнитьТЧПРедставителиДети();
	//-bit_semenov.v_19.11.2021
	
	
КонецПроцедуры

