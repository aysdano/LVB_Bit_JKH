#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда
	
#Область ФормированиеОтчета
	
// Выполняет запрос и формирует табличный документ-результат отчета.
// В соответствии с настройками, заданными значениями реквизитов отчета.
//
// Параметры:
//	ДокументРезультат - табличный документ, формируемый отчетом.
//	ПоказыватьЗаголовок - признак видимости строк с заголовком отчета.
//	ВысотаЗаголовка - параметр, через который возвращается высота заголовка в строках. 
//  ДокументОбъект - если указан, то печать отчета по документу.
//
Процедура СформироватьОтчет(Знач ПараметрыОтчета, АдресХранилища) Экспорт
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ДокументРезультат.ОриентацияСтраницы	= ОриентацияСтраницы.Ландшафт;
	ДокументРезультат.АвтоМасштаб			= Истина;
	
	Макет = Отчеты.бит_СправкаПоПовестке.ПолучитьМакет("Справка");
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	НомерСтроки = 0;
	
	ОбластьШапка.Параметры.Проживающй   = ПараметрыОтчета.Проживающий;
	ОбластьШапка.Параметры.ДатаРождения = Формат(ПараметрыОтчета.ДатаРождения, "ДФ=dd.MM.yyyy");
	ОбластьШапка.Параметры.Адрес        = ПараметрыОтчета.Адрес;
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ВывестиПроживающихСовметсно(ДокументРезультат, ПараметрыОтчета, Макет, НомерСтроки);
	
	ВывестиПроживающихОтдельно(ДокументРезультат, ПараметрыОтчета, Макет, НомерСтроки);
	
	ВывестиУмерших(ДокументРезультат, ПараметрыОтчета, Макет, НомерСтроки);
	
	ДокументРезультат.Вывести(ОбластьПодвал);
	
	ПоместитьВоВременноеХранилище(ДокументРезультат, АдресХранилища);
	
КонецПроцедуры

#КонецОбласти

#Область ВыводКатегорийГраждан

// Процедура выводит совместно проживающих.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ВывестиПроживающихСовметсно(ДокументРезультат, ПараметрыОтчета, Макет, НомерСтроки)
	
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"      , КонецДня(ПараметрыОтчета.Период));
	Запрос.УстановитьПараметр("ЛицевойСчет" , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо"     , ПараметрыОтчета.Проживающий);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.МестоРождения КАК МестоРождения,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.Наименование КАК ФИО,
	|	бит_ТрудоваяДеятельностьПроживающихСрезПоследних.Должность
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ТрудоваяДеятельностьПроживающих.СрезПоследних(&Период, ) КАК бит_ТрудоваяДеятельностьПроживающихСрезПоследних
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ТрудоваяДеятельностьПроживающихСрезПоследних.ФизЛицо
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Постоянно)
	|	И бит_ПроживающиеПоЛССрезПоследних.ФизЛицо <> &ФизЛицо";
	
	Результат      = Запрос.Выполнить(); 
	Выборка = Результат.Выбрать();

	Если Результат.Пустой() Тогда
	
		ДокументРезультат.Вывести(ОбластьСтрока);
		Возврат;
	
	КонецЕсли; 
	
	Пока Выборка.Следующий() Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ОбластьСтрока.Параметры.НомерСтроки      = НомерСтроки;
		ОбластьСтрока.Параметры.ФИО              = Выборка.ФИО;
		ОбластьСтрока.Параметры.ДатаРождения     = Формат(Выборка.ДатаРождения, "ДФ=dd.MM.yyyy");
		ОбластьСтрока.Параметры.СтепеньРодства   = Выборка.СтепеньРодства;
		ОбластьСтрока.Параметры.МестоРождения    = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(Выборка.МестоРождения);
		ОбластьСтрока.Параметры.Трудоспособность = "";
		
		ОбластьСтрока.Параметры.РодЗанятий = Выборка.Должность;
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла; 
	
КонецПроцедуры // ()

// Процедура выводит отдельно проживающих.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ВывестиПроживающихОтдельно(ДокументРезультат, ПараметрыОтчета, Макет, НомерСтроки)
	
	ОбластьОтступ        = Макет.ПолучитьОбласть("Отступ");
	ОбластьШапкаОтдельно = Макет.ПолучитьОбласть("ШапкаОтдельно");
	ОбластьСтрока        = Макет.ПолучитьОбласть("Строка");
	
	ДокументРезультат.Вывести(ОбластьОтступ);
	ДокументРезультат.Вывести(ОбластьШапкаОтдельно);
	
	ВидыСведений = Новый Массив;
	ВидыСведений.Добавить(ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.РодЗанятий);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"      , КонецДня(ПараметрыОтчета.Период));
	Запрос.УстановитьПараметр("ЛицевойСчет" , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо"     , ПараметрыОтчета.Проживающий);
	Запрос.УстановитьПараметр("ВидыСведений", ВидыСведений);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.МестоРождения КАК МестоРождения,
	|	бит_ДопСведенияОПроживающихСрезПоследних.ВидСведений,
	|	бит_ДопСведенияОПроживающихСрезПоследних.Значение,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.Наименование КАК ФИО
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ДопСведенияОПроживающих.СрезПоследних(&Период, ВидСведений В (&ВидыСведений)) КАК бит_ДопСведенияОПроживающихСрезПоследних
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ДопСведенияОПроживающихСрезПоследних.Проживающий
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Период
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.Временно)
	|	И бит_ПроживающиеПоЛССрезПоследних.ФизЛицо <> &ФизЛицо
	|ИТОГИ
	|	МАКСИМУМ(СтепеньРодства),
	|	МАКСИМУМ(ДатаРождения),
	|	МАКСИМУМ(МестоРождения),
	|	МАКСИМУМ(ФИО)
	|ПО
	|	ФизЛицо";
	
	Результат      = Запрос.Выполнить(); 
	ВыборкаФизЛицо = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если Результат.Пустой() Тогда
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		Возврат;
		
	КонецЕсли; 
	
	Пока ВыборкаФизЛицо.Следующий() Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ОбластьСтрока.Параметры.НомерСтроки      = НомерСтроки;
		ОбластьСтрока.Параметры.ФИО              = ВыборкаФизЛицо.ФИО;
		ОбластьСтрока.Параметры.ДатаРождения     = Формат(ВыборкаФизЛицо.ДатаРождения, "ДФ=dd.MM.yyyy");
		ОбластьСтрока.Параметры.СтепеньРодства   = ВыборкаФизЛицо.СтепеньРодства;
		ОбластьСтрока.Параметры.МестоРождения    = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(ВыборкаФизЛицо.МестоРождения);
		ОбластьСтрока.Параметры.РодЗанятий       = "";
		ОбластьСтрока.Параметры.Трудоспособность = "";
		
		Выборка = ВыборкаФизЛицо.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ВидСведений = ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.РодЗанятий Тогда
				
				ОбластьСтрока.РодЗанятий = Выборка.Значение;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла; 
	
КонецПроцедуры // ()

// Процедура выводит умерших.
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ВывестиУмерших(ДокументРезультат, ПараметрыОтчета, Макет, НомерСтроки)
	
	ОбластьОтступ   = Макет.ПолучитьОбласть("Отступ");
	ОбластьШапкаУМР = Макет.ПолучитьОбласть("ШапкаУМР");
	ОбластьСтрока   = Макет.ПолучитьОбласть("Строка");
	
	ДокументРезультат.Вывести(ОбластьОтступ);
	ДокументРезультат.Вывести(ОбластьШапкаУМР);
	
	ВидыСведений = Новый Массив;
	ВидыСведений.Добавить(ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.РодЗанятий);
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Период"      , КонецДня(ПараметрыОтчета.Период));
	Запрос.УстановитьПараметр("ЛицевойСчет" , ПараметрыОтчета.ЛицевойСчет);
	Запрос.УстановитьПараметр("ФизЛицо"     , ПараметрыОтчета.Проживающий);
	Запрос.УстановитьПараметр("ВидыСведений", ВидыСведений);
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.МестоРождения КАК МестоРождения,
	|	бит_ДопСведенияОПроживающихСрезПоследних.ВидСведений,
	|	бит_ДопСведенияОПроживающихСрезПоследних.Значение,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.Наименование КАК ФИО
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Период, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ДопСведенияОПроживающих.СрезПоследних(&Период, ВидСведений В (&ВидыСведений)) КАК бит_ДопСведенияОПроживающихСрезПоследних
	|		ПО бит_ПроживающиеПоЛССрезПоследних.ФизЛицо = бит_ДопСведенияОПроживающихСрезПоследних.Проживающий
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации <= &Период
	|	И бит_ПроживающиеПоЛССрезПоследних.ПричинаВыписки = ЗНАЧЕНИЕ(Справочник.бит_ПричиныВыписки.ПоСмертно)
	|	И бит_ПроживающиеПоЛССрезПоследних.ФизЛицо <> &ФизЛицо
	|ИТОГИ
	|	МАКСИМУМ(СтепеньРодства),
	|	МАКСИМУМ(ДатаРождения),
	|	МАКСИМУМ(МестоРождения),
	|	МАКСИМУМ(ФИО)
	|ПО
	|	ФизЛицо";
	
	Результат      = Запрос.Выполнить(); 
	ВыборкаФизЛицо = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Если Результат.Пустой() Тогда
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		Возврат;
		
	КонецЕсли; 
	
	Пока ВыборкаФизЛицо.Следующий() Цикл
		
		НомерСтроки = НомерСтроки + 1;
		ОбластьСтрока.Параметры.НомерСтроки      = НомерСтроки;
		ОбластьСтрока.Параметры.ФИО              = ВыборкаФизЛицо.ФИО;
		ОбластьСтрока.Параметры.ДатаРождения     = Формат(ВыборкаФизЛицо.ДатаРождения, "ДФ=dd.MM.yyyy");
		ОбластьСтрока.Параметры.СтепеньРодства   = ВыборкаФизЛицо.СтепеньРодства;
		ОбластьСтрока.Параметры.МестоРождения    = бит_ПаспортныйСтолКлиетСервер.ПредставлениеМестаРождения(ВыборкаФизЛицо.МестоРождения);
		ОбластьСтрока.Параметры.РодЗанятий       = "";
		ОбластьСтрока.Параметры.Трудоспособность = "";
		
		Выборка = ВыборкаФизЛицо.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.ВидСведений = ПланыВидовХарактеристик.бит_ДополнительныеДанныеОПроживающих.РодЗанятий Тогда
				
				ОбластьСтрока.РодЗанятий = Выборка.Значение;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		ДокументРезультат.Вывести(ОбластьСтрока);
		
	КонецЦикла; 
	
КонецПроцедуры // ()

#КонецОбласти

#КонецЕсли