&НаКлиенте
Процедура ПодборПроживающих(Команда)
	
	СписокПроживающих = ПолучитьСписокПроживающих(Объект.ЛицевойСчет, Объект.Дата);
	
	Если СписокПроживающих.Количество() > 0 Тогда
		
		Оповещение = Новый ОписаниеОповещения("ПослеВыбораЭлемента", ЭтаФорма);
		СписокПроживающих.ПоказатьВыборЭлемента(Оповещение, "Проживающие по : " + ПолучитьНименованиеЛицевогоСчета(Объект.ЛицевойСчет));
		
	Иначе
		ОткрытьФорму("Справочник.бит_Проживающие.Форма.ФормаВыбораУправляемая",,Элементы.РегистрируемоеЛицо);
	КонецЕсли; 
	
