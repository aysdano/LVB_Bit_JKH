#Область ПроцедурыИФункцииОбщегоНазначения

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	Документ       = Метаданные.Справочники.бит_ПодразделенияОрганизаций;
	ПравоИзменения = ПравоДоступа("Изменение", Документ);
	
	КэшированныеЗначения = Новый Структура;
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	КэшированныеЗначения.Вставить("ПравоИзменения"      , ПравоИзменения);
	КэшированныеЗначения.Вставить("АдресПодразделенияОрганизации", Неопределено);
	КэшированныеЗначения.Вставить("ТелефонПодразделенияОрганизации", Неопределено);
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

// Процедура обновление заголовка.
//
&НаКлиенте
Процедура ОбновитьЗаголовок()
	
	ЭтаФорма.Заголовок = "Подразделение организации: "+ Объект.Владелец;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	РазместитьКонтактнуюИнформацию();
	
	ПолеКИ1           = ПолучитьДанныеИзКонтактнойИнформации("Телефон"                , "АдресПодразделенияОрганизации");
	
	Отбор = Новый Структура();
	Отбор.Вставить("Вид",ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.АдресПодразделенияОрганизации"));
	
	Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
	
	Если Строки.количество() = 0 и ЗначениеЗаполнено(Объект.Адрес) Тогда
		
		КонтактнаяИнформацияПолеАдресПодразделенияОрганизации = Объект.Адрес;
		
	ИначеЕсли Строки.количество() = 0 Тогда	
		
		КонтактнаяИнформацияПолеАдресПодразделенияОрганизации = ПолеКИ1;
		
	Иначе
		
		КонтактнаяИнформацияПолеАдресПодразделенияОрганизации = Строки[0].Представление;
		
	КонецЕсли;		
	
	Если ПолеКИ1 = "" и НЕ Строки.количество() = 0 Тогда
		
		КонтактнаяИнформацияПолеАдресПодразделенияОрганизации = Строки[0].Представление;
		
	КонецЕсли;	
	
	
	ПолеКИ2           = ПолучитьДанныеИзКонтактнойИнформации("ВебСтраница"                , "ТелефонПодразделенияОрганизации");
	
	Отбор = Новый Структура();
	Отбор.Вставить("Вид",ПредопределенноеЗначение("Справочник.ВидыКонтактнойИнформации.ТелефонПодразделенияОрганизации"));
	
	Строки = Объект.КонтактнаяИнформация.НайтиСтроки(Отбор);
	
	Если Строки.количество() = 0 и ЗначениеЗаполнено(Объект.Телефон) Тогда
		
		КонтактнаяИнформацияПолеТелефонПодразделенияОрганизации = Объект.Телефон;
		
	ИначеЕсли Строки.количество() = 0 Тогда	
		
		КонтактнаяИнформацияПолеТелефонПодразделенияОрганизации = ПолеКИ2;
		
	Иначе
		
		КонтактнаяИнформацияПолеТелефонПодразделенияОрганизации = Строки[0].Представление;
		
	КонецЕсли;		
	
	Если ПолеКИ2 = "" и НЕ Строки.количество() = 0 Тогда
		
		КонтактнаяИнформацияПолеТелефонПодразделенияОрганизации = Строки[0].Представление;
		
	КонецЕсли;		
	
КонецПроцедуры

