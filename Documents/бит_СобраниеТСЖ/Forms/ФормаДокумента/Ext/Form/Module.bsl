
#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
Процедура УдалитьПоСтроке(ИД)
	
	Отбор = Новый Структура("ИдентификаторВопроса", ИД);
	МассивСтрок = Объект.ВариантыВыбораГолосования.НайтиСтроки(Отбор);
	
	Для каждого СтрокаТабличнойЧасти Из МассивСтрок Цикл
		
		Объект.ВариантыВыбораГолосования.Удалить(СтрокаТабличнойЧасти);
		
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура РазвернутьВсеУровни(ИмяДерева)
	
	Таблица = Этаформа[ИмяДерева].ПолучитьЭлементы();
	
	Для каждого СтрокаТаблицы Из Таблица Цикл
		РазвернутьУровень(ИмяДерева, СтрокаТаблицы.ПолучитьИдентификатор());
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура РазвернутьУровень(ИмяДерева, Идентификатор)
	
	СтрокаДерева = ЭтаФорма[ИмяДерева].НайтиПоИдентификатору(Идентификатор);
	
	Если СтрокаДерева = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Элементы[ИмяДерева].Развернуть(Идентификатор);
	
	Таблица = СтрокаДерева.ПолучитьЭлементы();
	
	Для каждого СтрокаТаблицы Из Таблица Цикл
		РазвернутьУровень(ИмяДерева, СтрокаТаблицы.ПолучитьИдентификатор());
	КонецЦикла;  
	
КонецПроцедуры // () 

&НаКлиенте
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокВопросов()
	
	СписокВопросов = Новый СписокЗначений;
	
	Для каждого СтрокаТаблицы Из Объект.СписокВопросов Цикл
		СписокВопросов.Добавить(СтрокаТаблицы.Идентификатор, СтрокаТаблицы.Вопрос);
	КонецЦикла;
	
	Возврат СписокВопросов;
	
КонецФункции // ()

&НаКлиенте
// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция ПолучитьСписокРешенийПоВопросу(ИдентификаторВопроса)
	
	СписокРешений = Новый СписокЗначений;
	
	Отбор = Новый Структура;
	Отбор.Вставить("ИдентификаторВопроса", ИдентификаторВопроса);
	
	ПоискРешений = Объект.ВариантыВыбораГолосования.НайтиСтроки(Отбор);
	
	Для каждого СтрокаТаблицы Из ПоискРешений Цикл
		СписокРешений.Добавить(СтрокаТаблицы.Идентификатор, СтрокаТаблицы.ВариантРешения);
	КонецЦикла;
	
	Возврат СписокРешений;
	
КонецФункции // ()

&НаКлиенте
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура УстановитьФлажкиДерева(Установить = Ложь, Идентификатор = Неопределено)
	
	Если НЕ Идентификатор = Неопределено Тогда
		
		СтрокаДерева = ДеревоУчастниковГолосования.НайтиПоИдентификатору(Идентификатор);
		
		Если СтрокаДерева = Неопределено Тогда
			Возврат;
		КонецЕсли; 
		
		Таблица = СтрокаДерева.ПолучитьЭлементы();
		
	Иначе
		Таблица = ДеревоУчастниковГолосования.ПолучитьЭлементы();
	КонецЕсли; 
	
	Для каждого СтрокаТаблицы Из Таблица Цикл
		
		СтрокаТаблицы.Использовать = ?(СтрокаТаблицы.УровеньУчастник, Установить, Ложь);
		
		УстановитьФлажкиДерева(Установить, СтрокаТаблицы.ПолучитьИдентификатор());
		
	КонецЦикла; 
	
КонецПроцедуры // () 

&НаКлиенте
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура УстановитьТекстСообщений()
	
	ТекстОшибки        = "";
	ШаблонТекстаОшибки = "Изменения: %1.";
	
	Если ИзменилсяСписокЗданий Тогда
		ТекстОшибки = ТекстОшибки + НСтр("ru = ', список зданий'");
	КонецЕсли;
	
	Если ИзменилосьПредставлениеВопроса Тогда
		ТекстОшибки = ТекстОшибки + НСтр("ru = ', список вопросов'");
	КонецЕсли;
	
	Если ИзменилосьПредставлениеРешения Тогда
		ТекстОшибки = ТекстОшибки + НСтр("ru = ', список вариантов решений'");
	КонецЕсли;
	
	Если НесовпадаетКолГолосов Тогда
		ТекстОшибки = ТекстОшибки + НСтр("ru = ', несовпадает кол-во голосов'");
	КонецЕсли;
	
	ТекстОшибки = Сред(ТекстОшибки,3);
	
	Если НЕ ПустаяСтрока(ТекстОшибки) Тогда
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, ТекстОшибки);
	КонецЕсли; 
	
	ЦветОшибки    = WebЦвета.Красный;
	ЦветПусто     = WebЦвета.НебесноГолубой;
	ЦветЗаполнено = WebЦвета.ЛимонноЗеленый;
	
	КолУг = ДеревоУчастниковГолосования.ПолучитьЭлементы().Количество();
	КолРч = ДеревоРзельтатовГолосования.ПолучитьЭлементы().Количество();
	
	ТаблицаУчастниковНеАктуальна  = ?(ТаблицаУчастниковНеАктуальна, КолУг > 0, ТаблицаУчастниковНеАктуальна);
	ТаблицаРезультатовНеАктуальна = ?(ТаблицаРезультатовНеАктуальна, КолРч > 0, ТаблицаРезультатовНеАктуальна);
	
	Если ТаблицаУчастниковНеАктуальна Тогда
		
		ШаблонТекстаЗаголовока = НСтр("ru = 'Список участников голосования не актуален. Выполните команду ""Обновить"". %1'");
		Элементы.ТекстУчастники.Заголовок  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаЗаголовока, ТекстОшибки);
		Элементы.ТекстУчастники.ЦветТекста = ЦветОшибки;
		
	Иначе
		
		Если КолУг = 0 Тогда
			Элементы.ТекстУчастники.Заголовок  = НСтр("ru = 'Список участников голосования пуст. Выполните команду ""Обновить"".'");
			Элементы.ТекстУчастники.ЦветТекста = ЦветПусто;
		Иначе
			Элементы.ТекстУчастники.Заголовок  = НСтр("ru = 'Список участников голосования обновлен.'");
			Элементы.ТекстУчастники.ЦветТекста = ЦветЗаполнено;
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ТаблицаРезультатовНеАктуальна Тогда
		ШаблонТекстаЗаголовока = НСтр("ru = 'Список результатов голосования не актуален. Выполните команду ""Обновить"". %1'");
		Элементы.ТекстРезультаты.Заголовок  = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаЗаголовока, ТекстОшибки);
		Элементы.ТекстРезультаты.ЦветТекста = ЦветОшибки;
	Иначе
		
		Если КолРч = 0 Тогда
			Элементы.ТекстРезультаты.Заголовок  = НСтр("ru = 'Список результатов голосования пуст. Выполните команду ""Обновить"".'");
			Элементы.ТекстРезультаты.ЦветТекста = ЦветПусто;
		Иначе
			Элементы.ТекстРезультаты.Заголовок  = НСтр("ru = 'Список результатов голосования обновлен.'");
			Элементы.ТекстРезультаты.ЦветТекста = ЦветЗаполнено;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если (НЕ ТаблицаУчастниковНеАктуальна И НЕ ТаблицаРезультатовНеАктуальна) Тогда
		
		ИзменилсяСписокЗданий          = Ложь;
		ИзменилосьПредставлениеВопроса = Ложь;
		ИзменилосьПредставлениеРешения = Ложь;
		НесовпадаетКолГолосов          = Ложь;
		
	КонецЕсли; 
	
КонецПроцедуры // УстановитьТекстСообщений()

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если НЕ Параметры.Ключ.Пустая() Тогда
		ЗапонлитьДеревоПоОбъекту();
	КонецЕсли;
	
	бит_УправлениеПечатьюСервер.ПриСозданииНаСервере(ЭтаФорма);
	
КонецПроцедуры

&НаСервере
Процедура ПередЗаписьюНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи)
	
	ТекущийОбъект.УчастникиГолосования.Очистить();
	
	УровеньВопрос = ДеревоУчастниковГолосования.ПолучитьЭлементы();
	
	Для каждого СтрокаВопрос Из УровеньВопрос Цикл
		УровеньЗдание = СтрокаВопрос.ПолучитьЭлементы();
		Для каждого СтрокаЗдание Из УровеньЗдание Цикл
			УровеньУчастник = СтрокаЗдание.ПолучитьЭлементы();
			Для каждого СтрокаУчастник Из УровеньУчастник Цикл
				
				НоваяСтрока = ТекущийОбъект.УчастникиГолосования.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаУчастник); 
				НоваяСтрока.Здание   = СтрокаЗдание.ЗданиеУчастник;
				НоваяСтрока.Участник = СтрокаУчастник.ЗданиеУчастник;
				
			КонецЦикла; 
		КонецЦикла; 
	КонецЦикла;
	
	ТекущийОбъект.РезультатыГолосования.Очистить();
	
	УровеньВопрос = ДеревоРзельтатовГолосования.ПолучитьЭлементы();
	
	Для каждого СтрокаВопрос Из УровеньВопрос Цикл
		УровеньРешение = СтрокаВопрос.ПолучитьЭлементы();
		Для каждого СтрокаРешение Из УровеньРешение Цикл
			
			НоваяСтрока = ТекущийОбъект.РезультатыГолосования.Добавить();
			ЗаполнитьЗначенияСвойств(НоваяСтрока, СтрокаРешение); 
			
		КонецЦикла; 
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	УстановитьТекстСообщений();
	РазвернутьВсеУровни("ДеревоРзельтатовГолосования");
	РазвернутьВсеУровни("ДеревоУчастниковГолосования");
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	Если ТаблицаУчастниковНеАктуальна ИЛИ ТаблицаРезультатовНеАктуальна Тогда
		
		Отказ = Истина;
		ШаблонТекстаОшибки = НСтр("ru = 'На форме обнаружены ошибки: %1.'");
		ТекстОшибки = "";
		
		Если ТаблицаУчастниковНеАктуальна Тогда
			ТекстОшибки = НСтр("ru = ', не актуален список участников голосований'"); 
		КонецЕсли;
		
		Если ТаблицаРезультатовНеАктуальна Тогда
			ТекстОшибки = НСтр("ru = ', не актуален список результата голосований'"); 
		КонецЕсли;
		
		ТекстОшибки = Сред(ТекстОшибки,3);
		
		ТекстОшибки = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ШаблонТекстаОшибки, ТекстОшибки);
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстОшибки);
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура ОбновитьВсе(Команда)
	
	ОбновитьСписокГолосований();
	РазвернутьВсеУровни("ДеревоУчастниковГолосования");
	
	ТаблицаУчастниковНеАктуальна  = Ложь;
	ТаблицаРезультатовНеАктуальна = Истина;
	
	УстановитьТекстСообщений();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьРешения(Команда)
	
	ОбновитьДеревоРешенийНаСервере();
	РазвернутьВсеУровни("ДеревоРзельтатовГолосования");
	
	ТаблицаРезультатовНеАктуальна  = Ложь;
	
	УстановитьТекстСообщений();
	Модифицированность = Истина;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьФлажки(Команда)
	
	УстановитьФлажкиДерева(Истина);
	
КонецПроцедуры

&НаКлиенте
Процедура СнятьФлажки(Команда)
	
	УстановитьФлажкиДерева();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчиститьРешенияПоВопросуТекущейСтроки(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоУчастниковГолосования.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ИдентификаторВопроса = ТекущаяСтрока.ИдентификаторВопроса;
	
	ВариантРешения = Новый Структура("ИдентификаторРешения, Решение");
	
	ЗаполнитьЗначениеПоДереву(ИдентификаторВопроса, ВариантРешения);
	
	РазвернутьВсеУровни("ДеревоУчастниковГолосования");
	
	НесовпадаетКолГолосов     = Истина;
	ТаблицаРезультатовНеАктуальна = Истина;
	
	УстановитьТекстСообщений();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРешенияПоВпоросуТекущейСтроки(Команда)
	
	ТекущаяСтрока = Элементы.ДеревоУчастниковГолосования.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	ИдентификаторВопроса = ТекущаяСтрока.ИдентификаторВопроса;
	
	СписокРешений = ПолучитьСписокРешенийПоВопросу(ИдентификаторВопроса);
	
	ВыбранноеРешение = СписокРешений.ВыбратьЭлемент("Выберите выриант решения");
	
	Если ВыбранноеРешение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВариантРешения = Новый Структура("ИдентификаторРешения, Решение");
	ВариантРешения.ИдентификаторРешения = ВыбранноеРешение.Значение;
	ВариантРешения.Решение              = ВыбранноеРешение.Представление;
	
	ЗаполнитьЗначениеПоДереву(ИдентификаторВопроса, ВариантРешения);
	
	РазвернутьВсеУровни("ДеревоУчастниковГолосования");
	
	НесовпадаетКолГолосов     = Истина;
	ТаблицаРезультатовНеАктуальна = Истина;
	
	УстановитьТекстСообщений();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьРешение(Команда)
	
	СписокВопросов = ПолучитьСписокВопросов();
	
	ВыбранныйВопрос = СписокВопросов.ВыбратьЭлемент("Выберите вопрос");
	
	Если ВыбранныйВопрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторВопроса = ВыбранныйВопрос.Значение; 
	
	СписокРешений = ПолучитьСписокРешенийПоВопросу(ИдентификаторВопроса);
	
	ВыбранноеРешение = СписокРешений.ВыбратьЭлемент("Выберите выриант решения");
	
	Если ВыбранноеРешение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВариантРешения = Новый Структура("ИдентификаторРешения, Решение");
	ВариантРешения.ИдентификаторРешения = ВыбранноеРешение.Значение;
	ВариантРешения.Решение              = ВыбранноеРешение.Представление;
	
	ЗаполнитьЗначениеПоДереву(ИдентификаторВопроса, ВариантРешения);
	
	РазвернутьВсеУровни("ДеревоУчастниковГолосования");
	
	НесовпадаетКолГолосов     = Истина;
	ТаблицаРезультатовНеАктуальна = Истина;
	
	УстановитьТекстСообщений();
	
КонецПроцедуры

&НаКлиенте
Процедура ОчисититьПринятиеРешения(Команда)
	
	СписокВопросов = ПолучитьСписокВопросов();
	
	ВыбранныйВопрос = СписокВопросов.ВыбратьЭлемент("Выберите вопрос");
	
	Если ВыбранныйВопрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВариантРешения = Новый Структура("ИдентификаторРешения, Решение");
	
	ЗаполнитьЗначениеПоДереву(ВыбранныйВопрос.Значение, ВариантРешения);
	
	РазвернутьВсеУровни("ДеревоУчастниковГолосования");
	
	НесовпадаетКолГолосов     = Истина;
	ТаблицаРезультатовНеАктуальна = Истина;
	
	УстановитьТекстСообщений();
	
КонецПроцедуры

&НаКлиенте
Процедура УстновитьЗначениеГолосов(Команда)
	
	СписокВопросов = ПолучитьСписокВопросов();
	
	ВыбранныйВопрос = СписокВопросов.ВыбратьЭлемент("Выберите вопрос");
	
	Если ВыбранныйВопрос = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ИдентификаторВопроса = ВыбранныйВопрос.Значение;
	
	ВыбЗнач = 0;
	Массив = Новый Массив;
	Массив.Добавить(Тип("Число"));
	КЧ = Новый КвалификаторыЧисла(10,0);
	ОписаниеТипов = Новый ОписаниеТипов(Массив, КЧ);
	
	ПоказатьВводЗначения(Новый ОписаниеОповещения("УстновитьЗначениеГолосовЗавершение", ЭтотОбъект, Новый Структура("ИдентификаторВопроса, ВыбЗнач", ИдентификаторВопроса, ВыбЗнач)), ВыбЗнач, "Введите значение", ОписаниеТипов);
	
