		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	НАЧАЛОПЕРИОДА(бит_СчетчикиНаУслугахОбщийСрезПоследних.Период, МЕСЯЦ) КАК Период,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.ТипСчетчика,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчета,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРаспределения,
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный
ПОМЕСТИТЬ ГрупСчетчики
ИЗ
	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
			&amp;КонецПериода {(&amp;КонецПериода)},
			ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)
				И СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
ГДЕ
	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать = ИСТИНА
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	НАЧАЛОПЕРИОДА(бит_ГрупповыеСчетчикиСрезПоследних.Период, МЕСЯЦ) КАК Период,
	ГрупСчетчики.Объект КАК Здание,
	ГрупСчетчики.Счетчик,
	ГрупСчетчики.Услуга КАК Услуга,
	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет
ПОМЕСТИТЬ Счетчики_ЛС
ИЗ
	ГрупСчетчики КАК ГрупСчетчики
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГрупповыеСчетчики.СрезПоследних(&amp;КонецПериода {(&amp;КонецПериода)}, ) КАК бит_ГрупповыеСчетчикиСрезПоследних
		ПО ГрупСчетчики.Услуга = бит_ГрупповыеСчетчикиСрезПоследних.Услуга
			И ГрупСчетчики.Счетчик = бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	НАЧАЛОПЕРИОДА(бит_НачисленияПоСчетчикамОбороты.Период, МЕСЯЦ) КАК Период,
	бит_НачисленияПоСчетчикамОбороты.Счетчик КАК Счетчик,
	бит_НачисленияПоСчетчикамОбороты.УслугаЖКХ КАК УслугаЖКХ,
	бит_НачисленияПоСчетчикамОбороты.ЛицевойСчет.Здание КАК Здание,
	бит_НачисленияПоСчетчикамОбороты.ЛицевойСчет КАК ЛицевойСчет,
	ЕСТЬNULL(бит_НачисленияПоСчетчикамОбороты.СуммаОборот, 0) КАК СуммаОборот,
	ЕСТЬNULL(бит_КолЕдиницПоСчетчикамОбороты.КоличествоЕдиницПоЛСОборот, 0) КАК КоличествоЕдиницПоЛСОборот,
	бит_КолЕдиницПоСчетчикамОбороты.Регистратор
ПОМЕСТИТЬ НачисленияПоЛС
ИЗ
	РегистрНакопления.бит_КолЕдиницПоСчетчикам.Обороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, Регистратор, Счетчик.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)) КАК бит_КолЕдиницПоСчетчикамОбороты
		ПОЛНОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_НачисленияПоСчетчикам.Обороты(&amp;НачалоПериода {(&amp;НачалоПериода)}, &amp;КонецПериода {(&amp;КонецПериода)}, Регистратор, ) КАК бит_НачисленияПоСчетчикамОбороты
		ПО бит_КолЕдиницПоСчетчикамОбороты.ЛицевойСчет = бит_НачисленияПоСчетчикамОбороты.ЛицевойСчет
			И бит_КолЕдиницПоСчетчикамОбороты.УслугаЖКХ = бит_НачисленияПоСчетчикамОбороты.УслугаЖКХ
			И бит_КолЕдиницПоСчетчикамОбороты.Счетчик = бит_НачисленияПоСчетчикамОбороты.Счетчик
			И бит_КолЕдиницПоСчетчикамОбороты.Регистратор = бит_НачисленияПоСчетчикамОбороты.Регистратор
ГДЕ
	бит_КолЕдиницПоСчетчикамОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
	И бит_НачисленияПоСчетчикамОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	бит_ПоказанияСчетчиковОбороты.Объект КАК Объект,
	бит_ПоказанияСчетчиковОбороты.Услуга КАК Услуга,
	бит_ПоказанияСчетчиковОбороты.Счетчик КАК Счетчик,
	ЕСТЬNULL(бит_ПоказанияСчетчиковОбороты.ПоследниеПоказанияОборот, 0) КАК КолЕдПоСчетчику,
	ЕСТЬNULL(бит_ПоказанияСчетчиковОбороты.ПоследниеПоказанияПриход, 0) КАК КонечныеПоказания,
	ЕСТЬNULL(бит_ПоказанияСчетчиковОбороты.ПоследниеПоказанияРасход, 0) КАК НачальныеПоказания,
	НачисленяПоЛС.Период КАК Период,
	НачисленяПоЛС.Регистратор,
	НачисленяПоЛС.ЛицевойСчет КАК ЛицевойСчет,
	НачисленяПоЛС.СуммаОборот КАК СуммаПоЛС,
	НачисленяПоЛС.КоличествоЕдиницПоЛСОборот КАК КоличествоЕдиницПоЛС,
	бит_ПоказанияСчетчиковОбороты.Счетчик.Разрядность КАК Разрядность
ПОМЕСТИТЬ Начисления
ИЗ
	РегистрНакопления.бит_ПоказанияСчетчиков.Обороты(
			&amp;НачалоПериода {(&amp;НачалоПериода)},
			&amp;КонецПериода {(&amp;КонецПериода)},
			Регистратор,
			Объект В
					(ВЫБРАТЬ
						НачисленияПоЛС.Здание КАК Здание
					ИЗ
						НачисленияПоЛС КАК НачисленияПоЛС)
				И Счетчик В
					(ВЫБРАТЬ
						НачисленияПоЛС.Счетчик КАК Счетчик
					ИЗ
						НачисленияПоЛС КАК НачисленияПоЛС)
				И Услуга В
					(ВЫБРАТЬ
						НачисленияПоЛС.УслугаЖКХ КАК УслугаЖКХ
					ИЗ
						НачисленияПоЛС КАК НачисленияПоЛС)) КАК бит_ПоказанияСчетчиковОбороты
		ЛЕВОЕ СОЕДИНЕНИЕ НачисленияПоЛС КАК НачисленяПоЛС
		ПО бит_ПоказанияСчетчиковОбороты.Счетчик = НачисленяПоЛС.Счетчик
			И бит_ПоказанияСчетчиковОбороты.Услуга = НачисленяПоЛС.УслугаЖКХ
			И бит_ПоказанияСчетчиковОбороты.Объект = НачисленяПоЛС.Здание
			И бит_ПоказанияСчетчиковОбороты.Регистратор = НачисленяПоЛС.Регистратор
ГДЕ
	НачисленяПоЛС.Период = НАЧАЛОПЕРИОДА(бит_ПоказанияСчетчиковОбороты.Период, МЕСЯЦ)
	И бит_ПоказанияСчетчиковОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикам
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ РАЗРЕШЕННЫЕ
	ВЫБОР
		КОГДА Начисления.КолЕдПоСчетчику &gt;= 0
			ТОГДА Начисления.КолЕдПоСчетчику
		ИНАЧЕ ЕСТЬNULL(Начисления.Разрядность, 0) + 1 - Начисления.НачальныеПоказания + Начисления.КонечныеПоказания
	КОНЕЦ КАК КолЕдПоСчетчику,
	Начисления.КонечныеПоказания,
	Начисления.НачальныеПоказания,
	Начисления.Период,
	Начисления.Регистратор,
	Начисления.СуммаПоЛС,
	Начисления.КоличествоЕдиницПоЛС,
	Счетчики_ЛС.Здание КАК Объект,
	Счетчики_ЛС.Услуга КАК Услуга,
	Счетчики_ЛС.Счетчик КАК Счетчик,
	Счетчики_ЛС.ЛицевойСчет КАК ЛицевойСчет
ИЗ
	Счетчики_ЛС КАК Счетчики_ЛС
		ЛЕВОЕ СОЕДИНЕНИЕ Начисления КАК Начисления
		ПО Счетчики_ЛС.Счетчик = Начисления.Счетчик
			И Счетчики_ЛС.Услуга = Начисления.Услуга
			И Счетчики_ЛС.ЛицевойСчет = Начисления.ЛицевойСчет</query>
	</dataSet>
