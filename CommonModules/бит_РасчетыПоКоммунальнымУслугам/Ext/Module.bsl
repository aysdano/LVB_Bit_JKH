			НоваяСтрока.НормаЛьготы    = Выборка.мКоличествоПроживающихЛьготы;
			
		// БИТ_ЖКХ 16.05.2017 11:06:02 Начало правки...
		ИначеЕсли СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающимСНормативом Тогда
			
			НоваяСтрока.Норматив		= Выборка.мКоличествоПроживающихЛьготы * Выборка.Ставка;
			НоваяСтрока.Норма			= Выборка.КоличествоПроживающихПоНорме;
			НоваяСтрока.РасчетнаяНорма	= Норма;
			НоваяСтрока.СверхНорма		= 0;
			НоваяСтрока.Факт			= Выборка.мКоличествоПроживающих;
			НоваяСтрока.НормаЛьготы		= Выборка.мКоличествоПроживающихЛьготы;
		// БИТ_ЖКХ 16.05.2017 11:06:02 Конец правки.	
		ИначеЕсли СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления Тогда
			
			НоваяСтрока.Норматив =  НормаЛьготы * Выборка.Ставка;
			
			Если Норма > Выборка.КоличествоЕдиницПотребления тогда
				Норма      = Выборка.КоличествоЕдиницПотребления;
				СверхНорма = 0; 
			иначе
				СверхНорма = Выборка.КоличествоЕдиницПотребления - Норма; 
			КонецЕсли;
			
			НоваяСтрока.Факт          = Выборка.КоличествоЕдиницПотребления;
			НоваяСтрока.НормаЛьготы   = НормаЛьготы;
