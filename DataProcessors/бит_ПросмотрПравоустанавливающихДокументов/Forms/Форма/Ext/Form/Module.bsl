&НаСервере
Процедура УстановитьАрихвНаСервере(МассивДокументов)
	
	Для Каждого Элем Из МассивДокументов Цикл
		
	   	Док = Элем.ПолучитьОбъект();
		Док.бит_Архивный = Не Элем.бит_Архивный;
		Док.Записать();
		
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьАрихв(Команда)
	Если Элементы.Группа1.ТекущаяСтраница.Имя = "АктуальныеДокументы" Тогда
		МассивДокументов = Элементы.Список.ВыделенныеСтроки;
	ИначеЕсли Элементы.Группа1.ТекущаяСтраница.Имя = "АрхивныеДокументы" Тогда
		МассивДокументов = Элементы.СписокАрхивный.ВыделенныеСтроки;
	КонецЕсли;
	УстановитьАрихвНаСервере(МассивДокументов);
	Элементы.Список.Обновить();
	Элементы.СписокАрхивный.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ПроживающийНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	СтандартнаяОбработка = Ложь;
	ОписаниеВыбора = Новый ОписаниеОповещения("ОбработатьВыборПроживающего", ЭтаФорма);
	ПараметрыОтбора = Новый Структура;
	ПараметрыОтбора.Вставить("ЛицевойСчет", ЛицевойСчет);
	ОткрытьФорму("Справочник.бит_Проживающие.ФормаВыбора", ПараметрыОтбора, , , , , ОписаниеВыбора, );
		
КонецПроцедуры


&НаКлиенте
Процедура ОбработатьВыборПроживающего(РезультатЗакрытия, ДополнительныеПараметры) Экспорт

	Если НЕ ЗначениеЗаполнено(РезультатЗакрытия) Тогда 
		Возврат;	
	КонецЕсли;
	
	Проживающий = РезультатЗакрытия;
	
КонецПроцедуры // ОбработатьВыборПроживающего()





