		НоваяФорма = ОткрытьФорму("Документ.бит_УстановкаСтавокПоУслугам.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзСправочникаУслугиЖКХ",ПараметрыФормы), Элемент);
		НоваяФорма.УслугаВладелец = Объект.Ссылка;	
		
	КонецЕсли; 
	
