							//КонецЕсли; 
							КоличествоПоНормеЛьгота = ?(КоличествоПоНормеЛьгота = 0,1,КоличествоПоНормеЛьгота);
							Норма         = Факт/КоличествоПоНормеЛьгота;
							Начислено     = Выборка.Начислено/КоличествоПоНормеЛьгота;
							НормаСемейная = Выборка.Факт/ КоличествоПоНормеЛьгота;
							
						КонецЕсли;
						
					Иначе
						
						Если КоличествоПоНормеЛьгота = 0 Тогда
							Продолжить;
						КонецЕсли; 
						
						//Факт    = ?(ДоляПлощади <> 0 И РасчетДолей, ДоляПлощади, Выборка.Факт);
						//ПоНорме = ?(ДоляПлощади <> 0 И РасчетДолей, Истина, Ложь);
						
						Факт    = Выборка.Факт;
						//ПоНорме = ?(Выборка.ДоляПлощади <> 0 И РасчетДолей, Истина, Ложь);
						
						Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет 
							ИЛИ ((Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам
							ИЛИ  Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоРаспределению) И Выборка.ОсновнойСпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет)
							Тогда
							
							Норма = Выборка.НаЛицевойСчет;
							
						Иначе
							
							Если КоличествоПоНормеЛьгота = 1 Тогда
								Норма = Выборка.НаОдного;
							ИначеЕсли КоличествоПоНормеЛьгота = 2 Тогда
