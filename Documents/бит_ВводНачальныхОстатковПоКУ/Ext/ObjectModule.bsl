#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ЭкспортныеПроцедурыИФункции

// Процедура выполняет заполнение счетов и субконто табличной части.
//
Процедура ЗапролнитьСчета(ИмяТабличногоПоля) Экспорт
	
	тмпСписокЛС = ЭтотОбъект[ИмяТабличногоПоля].ВыгрузитьКолонку("ЛицевойСчет");
	Колонки     = ЭтотОбъект[ИмяТабличногоПоля].ВыгрузитьКолонки().Колонки;;
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ЭтотОбъект[ИмяТабличногоПоля], Колонки, тмпСписокЛС, Организация , Дата, , Истина,,Истина);
	
КонецПроцедуры

#КонецОбласти

#Область ОбеспечениеПроведенияДокумента

// Проверяет правильность заполнения шапки документа.
// Если какой-то из реквизитов шапки, влияющий на проведение не заполнен или
// заполнен не корректно, то выставляется флаг отказа в проведении.
// Проверяется также правильность заполнения реквизитов ссылочных полей документа.
// Проверка выполняется по объекту и по выборке из результата запроса по шапке.
//
// Параметры: 
//  СтруктураШапкиДокумента - Структура, выборка из результата запроса по шапке документа,
//  Отказ                   - Булево, флаг отказа в проведении.
//  Заголовок               - Строка, заголовок сообщения об ошибке проведения.
//
Процедура ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок)
	
	// Укажем, что надо проверить:
	ОбязательныеРеквизитыШапки = "Организация";
	
	СтруктураОбязательныхПолей = Новый Структура(ОбязательныеРеквизитыШапки);
	
	// Теперь вызовем общую процедуру проверки.
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеШапкиДокумента(ЭтотОбъект, СтруктураОбязательныхПолей, Отказ, Заголовок);
	
КонецПроцедуры // ПроверитьЗаполнениеШапки()

// Процедура проверяет правильность заполнения реквизитов документа
//
Процедура ПроверкаРеквизитовТЧ(ТаблицаОС,СтруктураШапкиДокумента,Отказ, Заголовок) Экспорт
	
	Если СтруктураШапкиДокумента.ВидОперации =  Перечисления.бит_ВидыОперацийВводНачальныхОстатковПоКУ.ВводИнтегральногоНачальногоСальдо Тогда
		РеквизитыТабСписокУслуг = "ЛицевойСчет,Сумма"; //через запятую.
	Иначе 
		РеквизитыТабСписокУслуг = "ЛицевойСчет,Услуга,Сумма"; //через запятую.
	КонецЕсли; 
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "СписокЛС", Новый Структура(РеквизитыТабСписокУслуг), Отказ, Заголовок);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытий

// Обработчик события "ОбработкаПроведения" документа.
//
Процедура ОбработкаПроведения(Отказ)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
		
	// Проверим правильность заполнения шапки документа.
	ПроверитьЗаполнениеШапки(СтруктураШапкиДокумента, Отказ, Заголовок);
	
	ПараметрыПроведения = Документы.бит_ВводНачальныхОстатковПоКУ.ПодготовитьПараметрыПроведения(Ссылка, Отказ);
	
	ТаблицаДвижений = ПараметрыПроведения.СписокЛС;
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийВводНачальныхОстатковПоКУ.ВводИнтегральногоНачальногоСальдо Тогда
		
		ТаблицаДвижений = ПараметрыПроведения.СписокУслуг;
		
	КонецЕсли; 
	
	Если НЕ Отказ Тогда
		
		бит_НачисленияЖКХ.СформироватьДвиженияВводНачальныхОстатковПоКУНачисленияПоУслугамЖКХПоПериоду(ПараметрыПроведения.Реквизиты.Организация,ТаблицаДвижений, Движения, Отказ);
		
		Если НЕ ВидОперации = Перечисления.бит_ВидыОперацийВводНачальныхОстатковПоКУ.ВводНачальныхОстатковПоПериоду Тогда
			бит_НачисленияЖКХ.СформироватьДвиженияВводНачальныхОстатковПоКУНачисленияПоУслугамЖКХ(ПараметрыПроведения.Реквизиты.Организация,ТаблицаДвижений, Движения, Отказ);
			бит_НачисленияЖКХ.СформироватьДвиженияВводНачальныхОстатковПоКУХозрасчетный(ТаблицаДвижений, ПараметрыПроведения.Реквизиты, Движения, Отказ);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроведения()

// Обработчик события "ПередЗаписью" документа.
//
Процедура ПередЗаписью(Отказ, РежимЗаписи, РежимПроведения)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(ЭтотОбъект, Отказ);
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	Если РежимЗаписи = РежимЗаписиДокумента.Проведение тогда                 
		
		ТаблицаЛС = СписокЛС.Выгрузить();
		КоммунальныеУслуги = СписокУслуг.ВыгрузитьКолонки();
		бит_ОбщегоНазначения.РаспределениеСуммПоВводНачОстатков(Дата, Организация, ТаблицаЛС, КоммунальныеУслуги);
		
		Если КоммунальныеУслуги.Количество() > 0 Тогда
			
			СписокУслуг.Загрузить(КоммунальныеУслуги);
			
		КонецЕсли; 
		
	КонецЕсли;
	
	Если ВидОперации = Перечисления.бит_ВидыОперацийВводНачальныхОстатковПоКУ.ВводИнтегральногоНачальногоСальдо Тогда
		ЗапролнитьСчета("СписокУслуг");
	Иначе
		ЗапролнитьСчета("СписокЛС");
	КонецЕсли; 
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
КонецПроцедуры

#КонецОбласти

#КонецЕсли