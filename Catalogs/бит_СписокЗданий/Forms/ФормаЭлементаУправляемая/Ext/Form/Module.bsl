КонецФункции //HD-

&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ИзменениеДляКвартиры" Или 
		ИмяСобытия = "ИзменениеКвартирыДляЛС" Тогда
		
		ЗаполнитьТаблицуКвартир();
		ЗаполнитьТаблицуНежилыхПомещений();
		
	КонецЕсли;
	
	Если ИмяСобытия = "ОбновитьИнформациюТСЖ" Тогда
		
		ЗначениеПолейТСЖ = Параметр;
		
		ОбновитьТСЖ();
		
		Модифицированность = Истина;
		
	КонецЕсли;
	
	// БИТ_ЖКХ 24.11.2014{{
	Если ИмяСобытия = "ОбновитьКонтактыКонтролирующийОрган" Тогда
		
		Если ЗначениеЗаполнено(КонтролирующийОрган) Тогда
			
			АдресКО   = бит_ПаспортныйСтолСервер.ПолучитьАдресИзКонтактнойИнформации(КонтролирующийОрган, "Фактический");
			ТелефонКО = бит_ПаспортныйСтолСервер.ПолучитьТелефонИзКонтактнойИнформации(КонтролирующийОрган);
			СайтКО    = бит_ПаспортныйСтолСервер.ПолучитьВебСтраницуИзКонтактнойИнформации(КонтролирующийОрган);
			
		КонецЕсли; 
		
	КонецЕсли;	
	// БИТ_ЖКХ 24.11.2014}}
	
КонецПроцедуры

&НаКлиенте
Процедура ПередЗаписью(Отказ, ПараметрыЗаписи)
	
	//HD+
	Если HD_ТребуетсяОграничениеДоступаОтделаПоРаботеСНаселением() Тогда
		Отказ = Истина;
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Недостаточно прав для изменения здания.");
		Возврат;
	КонецЕсли;
	//HD-
	
	мКэшЗначений.ПочтовыйАдресЗдания = Элементы.КонтактнаяИнформацияПолеПочтовыйАдресЗдания.ТекстРедактирования;
	
	Если НЕ мКэшЗначений.ЭтоНовый И мКэшЗначений.мЛСИзменен Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Изменены ключевые реквизиты! Будут внесены изменения на лицевые счета 
		|закрепленые за зданием.");
			
		мКэшЗначений.Ответ = Истина;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	мКэшЗначений.ЭтоНовый = Ложь;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗаписиНаСервере(Отказ, ТекущийОбъект, ПараметрыЗаписи) 
	
	Если мКэшЗначений.Ответ Тогда
		
		Запрос = Новый Запрос;
		
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_ЛицевыеСчета.Ссылка КАК ЛС
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|ГДЕ
		|	бит_ЛицевыеСчета.Здание = &Здание";
		
		Запрос.УстановитьПараметр("Здание", Объект.Ссылка);
		
		Выборка = Запрос.Выполнить().Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			
			НачатьТранзакцию();
			Попытка
				
				// Блокируем объект от изменения другими сеансами.
				Блокировка = Новый БлокировкаДанных;
				ЭлементБлокировки = Блокировка.Добавить("Справочник.бит_ЛицевыеСчета");
				ЭлементБлокировки.УстановитьЗначение("Ссылка", Выборка.ЛС);
				Блокировка.Заблокировать();
				
				ЛицевойСчетОбъект = Выборка.ЛС.ПолучитьОбъект();
				
				// Если объект ранее был удален или обработан другими сеансами, пропускаем его.
				Если ЛицевойСчетОбъект = Неопределено Тогда
					ОтменитьТранзакцию();
					Продолжить;
				КонецЕсли;
				
				ЛицевойСчетОбъект.Организация			= Объект.Организация;
				ЛицевойСчетОбъект.УлицаЛицевогоСчета	= Объект.Улица;
				
				ЛицевойСчетОбъект.Записать();
				
				ЗафиксироватьТранзакцию();
				
			Исключение
				ТекстОшибки = ПодробноеПредставлениеОшибки(ИнформацияОбОшибке());
				ОтменитьТранзакцию();
				
				ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(
				НСтр("ru = 'Не удалось обновить информацию на лицевом счете: %1 по причине:
				|%2'
				|Перезапишите элемент вручную."),
				Строка(Выборка.ЛС), ТекстОшибки);
				
				ЗаписьЖурналаРегистрации(ОбновлениеИнформационнойБазы.СобытиеЖурналаРегистрации(), УровеньЖурналаРегистрации.Предупреждение,
				Метаданные.Справочники.бит_ЛицевыеСчета, ТекстСообщения);
				
			КонецПопытки;
			
		КонецЦикла; 
		
	КонецЕсли; 
	
	НаборЗаписей = РегистрыСведений.бит_ЗначениеСвойствОбъектовУчета.СоздатьНаборЗаписей();
	
	НаборЗаписей.Отбор.ОбъектУчета.Установить(Объект.Ссылка, Истина);
	
	НаборЗаписей.Прочитать();
	НаборЗаписей.Очистить();
	
	Для каждого ТекущаяСтрока Из СвойстваЗдания Цикл
		
		НоваяЗапись = НаборЗаписей.Добавить();
		
		НоваяЗапись.ОбъектУчета = Объект.Ссылка;
		НоваяЗапись.ВидСвойства = ТекущаяСтрока.ВидСвойства;
		НоваяЗапись.Значение    = ТекущаяСтрока.Значение;
		
	КонецЦикла; 
	
	Запрос = Новый Запрос;
	
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СвойстваОбъектовУчета.Ссылка КАК ВидСвойства
	|ИЗ
	|	ПланВидовХарактеристик.бит_СвойстваОбъектовУчета КАК бит_СвойстваОбъектовУчета
	|ГДЕ
	|	бит_СвойстваОбъектовУчета.Предопределенный";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		//++АнисимоваМВ  1бит исправление ошибки восстановление базы  25.10.2024  
			ИмяПВХ = ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета.ПолучитьИмяПредопределенного(Выборка.ВидСвойства);
		Если Элементы.Найти(ИмяПВХ) <> Неопределено Тогда  
			НоваяЗапись = НаборЗаписей.Добавить();
			
			НоваяЗапись.ОбъектУчета = Объект.Ссылка;
			НоваяЗапись.ВидСвойства = Выборка.ВидСвойства;
			НоваяЗапись.Значение    = ЭтаФорма[ИмяПВХ];
		КонецЕсли;
		//НоваяЗапись.Значение    = Значение;  
		//--АнисимоваМВ  1бит исправление ошибки восстановление базы  25.10.2024
	КонецЦикла; 
	
	НаборЗаписей.Записать();
	
	Если Объект.ИмеетТСЖ Тогда
		
		ЗаписатьТСЖ();
		
	КонецЕсли;
	
	КэшИмеетТСЖ = Объект.ИмеетТСЖ;
	
	//Объект.ПочтовыйАдрес = мКэшЗначений.ПочтовыйАдресЗдания;	
	//ПочтовыйАдресЗдания = мКэшЗначений.ПочтовыйАдресЗдания;	
	
КонецПроцедуры

