Функция УбратьНенужныеСимволы(Элемент, Символ="")
	Перем Результат;
	Результат=Строка(Элемент);
	
	Результат = СтрЗаменить(Результат,Символы.Нпп,Символ);
	Результат = СтрЗаменить(Результат,"/",Символ);
	Результат = СтрЗаменить(Результат,"\",Символ);
	Результат = СтрЗаменить(Результат,".",Символ);
	Результат = СтрЗаменить(Результат,",",Символ);
	//Результат = СтрЗаменить(Результат,"+",Символ);
	Результат = СтрЗаменить(Результат,"-",Символ);
	Результат = СтрЗаменить(Результат,"!",Символ);
	Результат = СтрЗаменить(Результат,"@",Символ);
	Результат = СтрЗаменить(Результат,"#",Символ); 
	Результат = СтрЗаменить(Результат,"$",Символ);
	Результат = СтрЗаменить(Результат,"%",Символ);
	Результат = СтрЗаменить(Результат,"^",Символ);
	Результат = СтрЗаменить(Результат,"&",Символ);
	Результат = СтрЗаменить(Результат,"*",Символ);
	Результат = СтрЗаменить(Результат,"(",Символ);
	Результат = СтрЗаменить(Результат,")",Символ);
	Результат = СтрЗаменить(Результат,"№",Символ);
	Результат = СтрЗаменить(Результат,";",Символ);
	Результат = СтрЗаменить(Результат,":",Символ);
	Результат = СтрЗаменить(Результат,"?",Символ);
	Результат = СтрЗаменить(Результат," ",Символ);
	Возврат Результат;
	ТекНомерТелефона="";счетчик=0;ПервоеВхождение=ложь;
	Для Индекс = 1 По СтрДлина(Результат) Цикл
		Символ = Сред(Результат, Индекс, 1); 
		Если КодСимвола(Символ) >= 48 И КодСимвола(Символ) <= 57 Тогда // Код нуля - 48, код 9-ки - 57
			// ТекНомерТелефона = ТекНомерТелефона + Символ;
			Если Символ="9" И ПервоеВхождение=ложь Тогда
				ПервоеВхождение=Истина;
				
			КонецЕсли;
			Если ПервоеВхождение  Тогда
				ТекНомерТелефона = ТекНомерТелефона + Символ;
				Счетчик=Счетчик+1;
			КонецЕсли;
			Если Счетчик=10 Тогда
				ТекНомерТелефона="+7"+ТекНомерТелефона;
				Возврат ТекНомерТелефона;
			КонецЕсли;
			
		ИначеЕсли СтрДлина(ТекНомерТелефона) > 0 Тогда
			// ТекНомерТелефона = "";
		КонецЕсли;
	КонецЦикла;
	
