//HD+
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем только наши пользовательские реквизиты формы, чтобы избежать конфликта
	// со стандартными свойствами управляемой формы (такими как ЗакрыватьПриВыборе)
	СписокСвойств = "ИнициаторФИО,ИнициаторПаспортСерия,ИнициаторПаспортНомер,ИнициаторСНИЛС,ИнициаторДатаРождения,ИнициаторМестоРождения,ИнициаторАдресРегистрации,ИнициаторТелефон,ИнициаторНомерКвартиры,ИнициаторДоляСобственности,ИнициаторПлощадьПомещения,ПравоустанавливающийДокумент,МКД";
	ЗаполнитьЗначенияСвойств(ЭтотОбъект, Параметры, СписокСвойств);
	
КонецПроцедуры //HD-

//HD+
// Обработчик события оповещения.
// Используется для обновления связанных реквизитов при изменении данных проживающего (инициатора).
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьДанныеОФизлице" Тогда
		
		Если ЗначениеЗаполнено(ИнициаторФИО) 
			И ТипЗнч(Параметр) = Тип("СправочникСсылка.бит_Проживающие") 
			И Параметр = ИнициаторФИО Тогда
			
			ОбновитьДанныеИнициатораНаСервере();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Обновляет данные инициатора из справочника на сервере через временный объект документа.
//
&НаСервере
Процедура ОбновитьДанныеИнициатораНаСервере()
	
	// Создаем временный объект документа для использования готового экспортного метода
	ОбъектДокумента = Документы.HD_ОбщееСобраниеСобственников.СоздатьДокумент();
	ОбъектДокумента.ИнициаторФИО = ИнициаторФИО;
	ОбъектДокумента.МКД = МКД;
	
	// Вызываем экспортную процедуру заполнения данных инициатора
	ОбъектДокумента.ЗаполнитьДанныеИнициатора();
	
	// Переносим обновленные значения в реквизиты формы
	ИнициаторПаспортСерия = ОбъектДокумента.ИнициаторПаспортСерия;
	ИнициаторПаспортНомер = ОбъектДокумента.ИнициаторПаспортНомер;
	ИнициаторСНИЛС = ОбъектДокумента.ИнициаторСНИЛС;
	ИнициаторДатаРождения = ОбъектДокумента.ИнициаторДатаРождения;
	ИнициаторМестоРождения = ОбъектДокумента.ИнициаторМестоРождения;
	ИнициаторАдресРегистрации = ОбъектДокумента.ИнициаторАдресРегистрации;
	ИнициаторТелефон = ОбъектДокумента.ИнициаторТелефон;
	ИнициаторНомерКвартиры = ОбъектДокумента.ИнициаторНомерКвартиры;
	ИнициаторДоляСобственности = ОбъектДокумента.ИнициаторДоляСобственности;
	ИнициаторПлощадьПомещения = ОбъектДокумента.ИнициаторПлощадьПомещения;
	ПравоустанавливающийДокумент = ОбъектДокумента.ПравоустанавливающийДокумент;
	
КонецПроцедуры //HD-

//HD+
&НаКлиенте
Процедура ЗаписатьИЗакрыть(Команда)
	
	// Собираем измененные реквизиты в структуру для возврата в вызывающую форму
	Результат = Новый Структура;
	Результат.Вставить("ИнициаторФИО", ИнициаторФИО);
	Результат.Вставить("ИнициаторПаспортСерия", ИнициаторПаспортСерия);
	Результат.Вставить("ИнициаторПаспортНомер", ИнициаторПаспортНомер);
	Результат.Вставить("ИнициаторСНИЛС", ИнициаторСНИЛС);
	Результат.Вставить("ИнициаторДатаРождения", ИнициаторДатаРождения);
	Результат.Вставить("ИнициаторМестоРождения", ИнициаторМестоРождения);
	Результат.Вставить("ИнициаторАдресРегистрации", ИнициаторАдресРегистрации);
	Результат.Вставить("ИнициаторТелефон", ИнициаторТелефон);
	Результат.Вставить("ИнициаторНомерКвартиры", ИнициаторНомерКвартиры);
	Результат.Вставить("ИнициаторДоляСобственности", ИнициаторДоляСобственности);
	Результат.Вставить("ИнициаторПлощадьПомещения", ИнициаторПлощадьПомещения);
	Результат.Вставить("ПравоустанавливающийДокумент", ПравоустанавливающийДокумент);
	
	Закрыть(Результат);
	
КонецПроцедуры //HD-
