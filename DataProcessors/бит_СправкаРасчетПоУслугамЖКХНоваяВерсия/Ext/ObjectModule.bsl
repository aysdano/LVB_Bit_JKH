Функция ПодвалКвитанции(Выборка, Период)
	
	лб_НастройиПечатиКвитанции = Выборка.СпособРасчетаОДН;
	Структура = Новый Структура;
	Структура.Вставить("ХВС", "");
	Структура.Вставить("ГВС", "");
	Структура.Вставить("ЭЭ", "");
	Структура.Вставить("ВО", "");
	Структура.Вставить("ЧислоХВС", "");
	Структура.Вставить("ЧислоГВС", "");
	Структура.Вставить("ЧислоЭЭ", "");
	Структура.Вставить("ЧислоВО", "");
	Структура.Вставить("ПериодОДН", "");
	Структура.Вставить("НормаФакт", Истина);
	ПериодМесяц = Формат(Период, "ДФ=ММ");
	ПериодГод = Формат(Период, "ДФ=гггг"); 
	ПериодГодПред = Формат(ДобавитьМесяц(Период, -12), "ДФ=гггг");
	Ме = "";
	Если ПериодМесяц = "03" тогда 
		Ме = "январе ";
	ИначеЕсли ПериодМесяц = "04" тогда 
		Ме = "феврале ";
	ИначеЕсли ПериодМесяц = "05" тогда 
		Ме = "марте ";
	ИначеЕсли ПериодМесяц = "06" тогда 
		Ме = "апреле ";
	ИначеЕсли ПериодМесяц = "07" тогда 
		Ме = "мае ";
	ИначеЕсли ПериодМесяц = "08" тогда 
		Ме = "июне ";	
	ИначеЕсли ПериодМесяц = "09" тогда 
		Ме = "июле ";
	ИначеЕсли ПериодМесяц = "10" тогда 
		Ме = "августе ";
	ИначеЕсли ПериодМесяц = "11" тогда 
		Ме = "сентябре ";
	ИначеЕсли ПериодМесяц = "12" тогда 
		Ме = "октябре ";
	ИначеЕсли ПериодМесяц = "01" тогда 
		Ме = "ноябре ";
		ПериодГод = ПериодГодПред;	
	ИначеЕсли ПериодМесяц = "02" тогда 
		Ме = "декабре ";
		ПериодГод = ПериодГодПред;	
	КонецЕсли;
	
	Если (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ХВ = Перечисления.лб_СпособРасчетаСОИ.ПоФакту) И (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ГВ = Перечисления.лб_СпособРасчетаСОИ.ПоФакту) И (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ЭЭ = Перечисления.лб_СпособРасчетаСОИ.ПоФакту)  Тогда
		Структура.Вставить("ПериодОДН", "Фактич. потребление и объемы на КР СОИ в " + Ме + ПериодГод + " г. с уч. коррект. за прошл. периоды");
		Структура.Вставить("НормаФакт", Истина);
	ИначеЕсли (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ХВ = Перечисления.лб_СпособРасчетаСОИ.ПоФакту)  Тогда
		Структура.Вставить("ПериодОДН", "Фактич. потребление и объемы на ХВС в " + Ме + ПериодГод + " г. с уч. коррект. за прошл. периоды. Нормативы и объемы потребления на ГВС, Эл/Эн и ВО, ед.изм./м.кв.общ.имущ.");
		Структура.Вставить("НормаФакт", Истина);
	ИначеЕсли (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ХВ = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу) И (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ГВ = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу) И (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ЭЭ = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу) Тогда
		Структура.Вставить("ПериодОДН", "Нормативы и объемы потребления на КР СОИ по нормативу на МКД, ед.изм./м.кв.общ.имущ.");
		Структура.Вставить("НормаФакт", Ложь);
	ИначеЕсли (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ХВ = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему) И (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ГВ = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему) И (лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ЭЭ = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему) Тогда
		Структура.Вставить("ПериодОДН", "Среднемес. потребление на ОДН за прошлый год ед.изм./м.кв.общ.имущ."); 
		Структура.Вставить("НормаФакт", Ложь);
	КонецЕсли;
	
	Если лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ХВ = Перечисления.лб_СпособРасчетаСОИ.ПоФакту Тогда
		Структура.Вставить("ХВС", "ХВС, м3"); 
		Структура.Вставить("ЧислоХВС", Выборка.ОДН_ХВ_М); 
	ИначеЕсли лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ХВ = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу ИЛИ лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ХВ = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему Тогда
		Структура.Вставить("ХВС", "ХВС, м3/м2");  
		Структура.Вставить("ЧислоХВС", Выборка.НормативХВ); 
	КонецЕсли;
	
	Если лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ГВ = Перечисления.лб_СпособРасчетаСОИ.ПоФакту Тогда
		Структура.Вставить("ГВС", "ГВС, м3");
		Структура.Вставить("ЧислоГВС", Выборка.ОДН_ГВ_М);
	ИначеЕсли  лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ГВ = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу ИЛИ лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ГВ = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему Тогда
		Структура.Вставить("ГВС", "ГВС, м3/м2");
		Структура.Вставить("ЧислоГВС", Выборка.НормативГВ);
	КонецЕсли; 	
	
	Если лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ВО = Перечисления.лб_СпособРасчетаСОИ.ПоФакту Тогда
		//Струткруа.Вставить("Стоки", "ВО, м.куб/м.кв");
		Структура.Вставить("ВО", "ВО, м3"); 
		Структура.Вставить("ЧислоВО", Выборка.ОДН_ВО_М);
	ИначеЕсли  лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ВО = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу ИЛИ лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ВО = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему Тогда
		Структура.Вставить("ВО", "ВО, м3/м2");   
		Структура.Вставить("ЧислоВО", Выборка.НормативВО);
	КонецЕсли;
	
	Если лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ЭЭ = Перечисления.лб_СпособРасчетаСОИ.ПоФакту Тогда
		Структура.Вставить("ЭЭ", "Эл/эн, кВт");    
		Структура.Вставить("ЧислоЭЭ", Выборка.ОДН_ЭЭ_КВТ);    
	ИначеЕсли  лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ЭЭ = Перечисления.лб_СпособРасчетаСОИ.ПоНормативу ИЛИ лб_НастройиПечатиКвитанции.СпособРасчетаСОИ_ЭЭ = Перечисления.лб_СпособРасчетаСОИ.ПоСреднему Тогда
		Структура.Вставить("ЭЭ", "Эл/эн, кВт/м2");
		Структура.Вставить("ЧислоЭЭ", Выборка.НормативЭЭ);    
	КонецЕсли;
	
	Возврат Структура
	
КонецФункции



