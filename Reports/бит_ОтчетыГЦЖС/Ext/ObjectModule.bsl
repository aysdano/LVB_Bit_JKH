	|	СУММА(СОДЕРЖ),
	|	СУММА(Норма),
	|	СУММА(КолЛьготников)
	|ПО
	|	ОБЩИЕ";
	
	Макет = ПолучитьМакет(мВидОтчета);
	
	ОбластьШапка  = Макет.ПолучитьОбласть("Шапка");
	ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	ОбластьИтог   = Макет.ПолучитьОбласть("Итого");
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	
	ОбластьШапка.Параметры.Организация  = Организация;
	ОбластьШапка.Параметры.Период       = Формат(КонецПериода, "ДФ=MMММ.yyyy");
	ОбластьШапка.Параметры.ЗаконОЛьготе = Льгота.ПостановлениеОЛьготе;
	
	ДокументРезультат.Вывести(ОбластьШапка);
	
	ВыборкаОбщ = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	СуммаОтчета = 0;
	
	Пока ВыборкаОбщ.Следующий() Цикл
		
		Выборка = ВыборкаОбщ.Выбрать();
		
		СуммаОтчета = ВыборкаОбщ.КАНАЛ + ВыборкаОбщ.ХВ + ВыборкаОбщ.ГВ + ВыборкаОбщ.ЭлЭнергия + ВыборкаОбщ.ОТОПЛ + ВыборкаОбщ.СОДЕРЖ;
		
		НомерСтроки = 0;
		
		Пока Выборка.Следующий() Цикл
			
			Итого = Выборка.КАНАЛ + Выборка.ХВ + Выборка.ГВ + Выборка.ЭлЭнергия + Выборка.ОТОПЛ + Выборка.СОДЕРЖ;
			ОбластьСтрока.Параметры.Заполнить(Выборка);
			НомерСтроки = НомерСтроки + 1;
			ОбластьСтрока.Параметры.НомерСтроки = НомерСтроки;
			ОбластьСтрока.Параметры.ДатаВыдачи  = Формат(Выборка.ДатаВыдачи, "ДФ=dd.MM.yyyy"); 
			ОбластьСтрока.Параметры.Итого       = Итого;
			
			ДокументРезультат.Вывести(ОбластьСтрока);
			
		КонецЦикла;
		
		ОбластьИтог.Параметры.Заполнить(ВыборкаОбщ);
		ОбластьИтог.Параметры.Итого = СуммаОтчета;
		
		ДокументРезультат.Вывести(ОбластьИтог);
		
	КонецЦикла;
	
