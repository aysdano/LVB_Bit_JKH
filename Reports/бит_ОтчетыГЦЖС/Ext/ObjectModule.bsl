		ИтогСуммаКомпенсации   = 0;
		
		Пока ВыборкаЛицевойСчет.Следующий() Цикл
			
			ВыборкаФизЛиц = ВыборкаЛицевойСчет.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаФизЛиц.Следующий() Цикл
				
				// Переменные для посчета сумму по графам ГЦЖС.
				Водопровод            = 0;
				ВывозБытовыхОтходов   = 0;
				Газ                   = 0;
				ГорячееВодоснобжение  = 0;
				ПлатаЗаНайм           = 0;
				Электроэнергия        = 0;
				Техобслуживание       = 0;
				Отопление             = 0;
				ХолодноеВодоснабжение = 0;
				
				// Переменные для расчета долей 
				ОбщТО = 0;
				ДопТО = 0;
				ОснТО = 0;
				
				ОбщОТПЛ = 0;
				ДопОТПЛ = 0;
				ОснОТПЛ = 0;
				
				ИтогоНачислено     = 0;
				СуммаКомпенсации   = 0;
				
				РасчетПлощадь = 0;
				
				НомерПП = НомерПП + 1;
				Адрес ="" + ВыборкаФизЛиц.Улица + ", д. " + ВыборкаФизЛиц.Здание + " кв. " + ВыборкаФизЛиц.Квартира;
				
				СтрокаТаблицы.Параметры.Адрес       = Адрес;
				СтрокаТаблицы.Параметры.НомерЛС     = ВыборкаФизЛиц.ЛицевойСчет;
				
				Выборка = ВыборкаФизЛиц.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					Если ЗначениеЗаполнено(Выборка.ГрафаОтчетаГЦЖС) Тогда
						
						ИтогоНачислено   = ИтогоНачислено + Выборка.Сумма;
						СуммаКомпенсации = СуммаКомпенсации + (Выборка.Сумма - Выборка.СуммаРазовых);
						
					КонецЕсли; 
					
					Если Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Водопровод Тогда
						
						Водопровод               = Водопровод + Выборка.Сумма;
						ИтогВодопровод           = ИтогВодопровод + Выборка.Сумма;
						
					ИначеЕсли Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ВывозБытовыхОтходов Тогда
						
						ВывозБытовыхОтходов     = ВывозБытовыхОтходов + Выборка.Сумма;
						ИтогВывозБытовыхОтходов = ИтогВывозБытовыхОтходов + Выборка.Сумма; 
						
					ИначеЕсли Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ХолодноеВодоснабжение 
						// БИТ_ЖКХ 25.01.2016 10:14:55 Начало правки...
						ИЛИ Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ХВСДляГВС
						// БИТ_ЖКХ 25.01.2016 10:14:57 Конец правки.
						Тогда
						
						ХолодноеВодоснабжение = ХолодноеВодоснабжение + Выборка.Сумма;
						ИтогХолодноеВодоснабжение = ИтогХолодноеВодоснабжение + Выборка.Сумма;
						
					ИначеЕсли Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Газ Тогда
						
						Газ     = Газ + Выборка.Сумма;
						ИтогГаз = ИтогГаз + Выборка.Сумма;
						
					ИначеЕсли Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ГорячееВодоснобжение Тогда
						
						ГорячееВодоснобжение     = ГорячееВодоснобжение + Выборка.Сумма;
						ИтогГорячееВодоснобжение = ИтогГорячееВодоснобжение + Выборка.Сумма;
						
					ИначеЕсли Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ПлатаЗаНайм Тогда
						
						ПлатаЗаНайм     = ПлатаЗаНайм + Выборка.Сумма;
						ИтогПлатаЗаНайм = ИтогПлатаЗаНайм + Выборка.Сумма;
						
					ИначеЕсли Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Электроэнергия Тогда
						
						Электроэнергия     = Электроэнергия + Выборка.Сумма;
						ИтогЭлектроэнергия = ИтогЭлектроэнергия + Выборка.Сумма;
						
					ИначеЕсли Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Техобслуживание Тогда
						
						Техобслуживание     = Техобслуживание + Выборка.Сумма;
						ИтогТехобслуживание = ИтогТехобслуживание + Выборка.Сумма;
						
						РасчетДолей(Выборка, СтруктураНорм, Истина);
						
						// Итог по перемены долей.
						ОснТО = ОснТО + СтруктураНорм.ОснНорма;
						ДопТо = ДопТО + СтруктураНорм.ДопНорма;
						ОбщТО = ОбщТО + СтруктураНорм.ОбщНорма;
						
					ИначеЕсли Выборка.Услуга.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Отопление Тогда
						
						Отопление          = Отопление + Выборка.Сумма;
						ИтогОтопление      = ИтогОтопление + Выборка.Сумма;
						
						РасчетДолей(Выборка, СтруктураНорм, Истина);
						
						// Итог по перемены долей.
						ОснОТПЛ = ОснОТПЛ + СтруктураНорм.ОснНорма;
						ДопОТПЛ = ДопОТПЛ + СтруктураНорм.ДопНорма;
						ОбщОТПЛ = ОбщОТПЛ + СтруктураНорм.ОбщНорма;
						
					КонецЕсли; 
					
				КонецЦикла; 
				
				СтрокаТаблицы.Параметры.НомерПП                    = НомерПП;
				СтрокаТаблицы.Параметры.ФИО                        = ВыборкаФизЛиц.ФизЛицо;
				СтрокаТаблицы.Параметры.КоличествоЧеловекИспЛьготу = ВыборкаФизЛиц.КоличествоПроживающих;
				СтрокаТаблицы.Параметры.ФактПлощадь                = ВыборкаФизЛиц.ОбщаяПлощадь;
				СтрокаТаблицы.Параметры.ОснованиеЛьгот             = "" + ВыборкаФизЛиц.ДокументНаЛьготу + "(№ " + ВыборкаФизЛиц.НомерДокумента + ", " + Формат(ВыборкаФизЛиц.ДатаВыдачи, "ДФ=dd.MM.yyyy") + ", " + ВыборкаФизЛиц.КемВыдан + ")";
				СтрокаТаблицы.Параметры.КолМесяцевДолга            = ВыборкаФизЛиц.КоличествоМесяцевРасчета;
				
				СтрокаТаблицы.Параметры.РасчетнаяПлощадь           = ?(ВыборкаФизЛиц.ОбщаяПлощадь >= ВыборкаФизЛиц.РасчетнаяПлощадь, ВыборкаФизЛиц.РасчетнаяПлощадь,ВыборкаФизЛиц.ОбщаяПлощадь);
				
				СтрокаТаблицы.Параметры.Водоотведение         = Водопровод;
				СтрокаТаблицы.Параметры.Газ                   = Газ;
				СтрокаТаблицы.Параметры.ГорячееВодоснобжение  = ГорячееВодоснобжение;
				СтрокаТаблицы.Параметры.ПлатаЗаНайм           = ПлатаЗаНайм;
				СтрокаТаблицы.Параметры.Электроэнергия        = Электроэнергия;
				СтрокаТаблицы.Параметры.ХолодноеВодоснабжение = ХолодноеВодоснабжение;
				
				СтрокаТаблицы.Параметры.ТехобслуживаниеОСН = ОснТО;
				СтрокаТаблицы.Параметры.ТехобслуживаниеДОП = ДопТО;
				СтрокаТаблицы.Параметры.ТехобслуживаниеИЛЗ = ОбщТО;
				СтрокаТаблицы.Параметры.ОтоплениеОСН       = ОснОТПЛ;
				СтрокаТаблицы.Параметры.ОтоплениеДОП       = ДопОТПЛ;
				СтрокаТаблицы.Параметры.ОтоплениеИЛЗ       = ОбщОТПЛ;
				
				ИтогОснТО   = ИтогОснТО + ОснТО;
				ИтогДопТо   = ИтогДопТО + ДопТО;
				ИтогОбщТО   = ИтогОбщТО + ОбщТО;
				ИтогОснОТПЛ = ИтогОснОТПЛ + ОснОТПЛ;
				ИтогДопОТПЛ = ИтогДопОТПЛ + ДопОТПЛ;
				ИтогОбщОТПЛ = ИтогОбщОТПЛ + ОбщОТПЛ;
				
				СтрокаТаблицы.Параметры.ИтогоНачислено     = ИтогоНачислено;
				СтрокаТаблицы.Параметры.СуммаКомпенсации   = СуммаКомпенсации;
				
				ИтогИтогоНачислено     = ИтогИтогоНачислено + ИтогоНачислено;
				ИтогСуммаКомпенсации   = ИтогСуммаКомпенсации + СуммаКомпенсации;
				
				ДокументРезультат.Вывести(СтрокаТаблицы);
				
			КонецЦикла; 
			
		КонецЦикла; 
		
		Итог.Параметры.Водоотведение         = ИтогВодопровод;
		Итог.Параметры.Газ                   = ИтогГаз;
		Итог.Параметры.ГорячееВодоснобжение  = ИтогГорячееВодоснобжение;
		Итог.Параметры.ПлатаЗаНайм           = ИтогПлатаЗаНайм;
		Итог.Параметры.Электроэнергия        = ИтогЭлектроэнергия;
		Итог.Параметры.ХолодноеВодоснабжение = ИтогХолодноеВодоснабжение;
		
		Итог.Параметры.ТехобслуживаниеОСН = ИтогОснТО;
		Итог.Параметры.ТехобслуживаниеДОП = ИтогДопТО;
		Итог.Параметры.ТехобслуживаниеИЛЗ = ИтогОбщТО;
		Итог.Параметры.ОтоплениеОСН       = ИтогОснОТПЛ;
		Итог.Параметры.ОтоплениеДОП       = ИтогДопОТПЛ;
		Итог.Параметры.ОтоплениеИЛЗ       = ИтогОбщОТПЛ;
		
		Итог.Параметры.ИтогоНачислено     = ИтогИтогоНачислено;
		
		ДокументРезультат.Вывести(Итог);
		
	КонецЦикла; 
	
	ДокументРезультат.Вывести(Подвал);
КонецПроцедуры

Процедура СформироватьОтчетРасшифровкаПоЛьготе(ДокументРезультат,мВидОтчета)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("НачалоПериода" , НачалоМесяца(КонецПериода));
	Запрос.УстановитьПараметр("КонецПериода"  , КонецМесяца(КонецПериода));
	Запрос.УстановитьПараметр("Организация"   , Организация);
	Запрос.УстановитьПараметр("Льгота"        , Льгота);
	
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	|	бит_НачислениеПоЛьготамОбороты.Услуга,
	|	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	|	бит_НачислениеПоЛьготамОбороты.Льгота,
	|	бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу,
	|	бит_ЛьготыПоЛССрезПоследних.НомерДокумента,
	|	бит_ЛьготыПоЛССрезПоследних.ДатаВыдачи,
	|	бит_ЛьготыПоЛССрезПоследних.КемВыдан,
	|	бит_НачислениеПоЛьготамОбороты.Услуга.ГрафаОтчетаГЦЖС КАК ГрафаОтчетаГЦЖС,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Здание КАК Здание,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Квартира КАК Квартира,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.УлицаЛицевогоСчета КАК Улица,
	|	бит_УстановкаЛьготСрезПоследних.Распространение,
	|	СУММА(бит_НачислениеПоЛьготамОбороты.СуммаОборот + бит_НачислениеПоЛьготамОбороты.СуммаСемейнойОборот) КАК Сумма,
	|	бит_ЛьготыПоЛССрезПоследних.СерияДокумента,
	|	СУММА(бит_НачислениеПоЛьготамОбороты.НормаЛьготыОборот) КАК НормаЛьготыОборот
	|ПОМЕСТИТЬ СведенияОЛьготниках
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПоЛьготам.Обороты(
	|			&НачалоПериода,
	|			&КонецПериода,
	|			,
	|			ЛицевойСчет.Организация = &Организация
	|				И Льгота = &Льгота) КАК бит_НачислениеПоЛьготамОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних(
	|				&КонецПериода,
	|				ЛицевойСчет.Организация = &Организация
	|					И Льготы = &Льгота) КАК бит_ЛьготыПоЛССрезПоследних
	|		ПО бит_НачислениеПоЛьготамОбороты.ЛицевойСчет = бит_ЛьготыПоЛССрезПоследних.ЛицевойСчет
	|			И бит_НачислениеПоЛьготамОбороты.Льгота = бит_ЛьготыПоЛССрезПоследних.Льготы
	|			И бит_НачислениеПоЛьготамОбороты.ФизЛицо = бит_ЛьготыПоЛССрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_УстановкаЛьгот.СрезПоследних(&КонецПериода, Льгота = &Льгота) КАК бит_УстановкаЛьготСрезПоследних
	|		ПО бит_НачислениеПоЛьготамОбороты.Услуга = бит_УстановкаЛьготСрезПоследних.Услуга
	|			И бит_НачислениеПоЛьготамОбороты.Льгота = бит_УстановкаЛьготСрезПоследних.Льгота
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	|	бит_НачислениеПоЛьготамОбороты.Услуга,
	|	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	|	бит_НачислениеПоЛьготамОбороты.Льгота,
	|	бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу,
	|	бит_ЛьготыПоЛССрезПоследних.НомерДокумента,
	|	бит_ЛьготыПоЛССрезПоследних.ДатаВыдачи,
	|	бит_ЛьготыПоЛССрезПоследних.КемВыдан,
	|	бит_НачислениеПоЛьготамОбороты.Услуга.ГрафаОтчетаГЦЖС,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Здание,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Квартира,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.УлицаЛицевогоСчета,
	|	бит_УстановкаЛьготСрезПоследних.Распространение,
	|	бит_ЛьготыПоЛССрезПоследних.СерияДокумента
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	СУММА(ВЫБОР
	|			КОГДА (бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &КонецПериода
	|					ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|					И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.НачислятьПоНорме
	|					И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПравоНаЛьготы
	|				ТОГДА 1
	|			ИНАЧЕ 0
	|		КОНЕЦ) КАК КоличествоИмеющихПравоНаЛьготу
	|ПОМЕСТИТЬ ПроживающиеИмеющиеПравоНаЛьготы
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&КонецПериода,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					Таб.ЛицевойСчет КАК ЛицевойСчет
	|				ИЗ
	|					СведенияОЛьготниках КАК Таб)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &КонецПериода
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.НачислятьПоНорме
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПравоНаЛьготы
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СведенияОЛьготниках.ФизЛицо КАК ФизЛицо,
	|	МАКСИМУМ(бит_ФИОПроживающихСрезПоследних.Фамилия) КАК Фамилия,
