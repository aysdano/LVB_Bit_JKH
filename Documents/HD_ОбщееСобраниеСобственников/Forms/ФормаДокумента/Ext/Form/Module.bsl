	ЗаполнитьТЧПовесткаДня();
	//HD+ Заполняем пользовательские параметры по выбранному шаблону повестки (из текста [Параметр] в справочнике)
	ЗаполнитьПользовательскиеПараметрыПоШаблонуПовесткиНаСервере();
	//HD+ Сразу подставляем уже считанные значения параметров в текст повестки
	ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
	//HD-
	// Шаблоны текста сохраняются автоматически в процедуре ЗаполнитьТЧПовесткаДня из исходных значений справочника
	//HD+ Устанавливаем текущую строку на первую строку после перезаполнения, чтобы избежать проблем с индексами
	УстановитьТекущуюСтрокуПовесткиДняПослеПерезаполнения();
	НастроитьВидимостьПредставителяУКНаСервере();
КонецПроцедуры

//HD+
// Устанавливает текущую строку табличной части ПовесткаДня на первую строку после перезаполнения
//
&НаКлиенте
Процедура УстановитьТекущуюСтрокуПовесткиДняПослеПерезаполнения()
	
	// Устанавливаем текущую строку на первую строку (индекс 0) после перезаполнения
	Если Объект.ПовесткаДня.Количество() > 0 Тогда
		Элементы.ПовесткаДня.ТекущаяСтрока = 0;
	Иначе
		Элементы.ПовесткаДня.ТекущаяСтрока = Неопределено;
	КонецЕсли;
	
	НастроитьВидимостьДеталейПовесткиДня(ЭтотОбъект);
	
КонецПроцедуры //HD-

