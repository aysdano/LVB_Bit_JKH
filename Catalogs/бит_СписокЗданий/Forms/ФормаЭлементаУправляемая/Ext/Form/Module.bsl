	// БИТ_ЖКХ 22.06.2015{{
	Попытка
		Элементы.ИформацияОТСЖ.Видимость = Объект.ИмеетТСЖ;
	Исключение
	КонецПопытки;
	// БИТ_ЖКХ 22.06.2015}}
	
	ЗаполнитьОписания();
	
