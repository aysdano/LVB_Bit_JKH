									C_4 = Уровень4.C_;
								Иначе	
									C_4 = "C_"+Уровень0.Кодификатор+Кодификатор+Прав(Уровень4.Кодификатор,1);
								КонецЕсли;	
								ЗаписьXML.ЗаписатьНачалоЭлемента(C_4);
								
