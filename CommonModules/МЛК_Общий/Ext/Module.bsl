			МЛК_Общий.ЗаписатьДанныеВЖурнал("Отправка квитанции","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		КонецПопытки;
		Если ЕстьОтвет Тогда
			Если Ответ.КодСостояния = 200 Тогда
				СтрокаОтвет1 = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				
				СтрокаОтвет1 = Перевод(СтрокаОтвет1);
				
				СтрокаОтвет1 = "Добавление квитанции. ЛС: "+Строка(СТр.ЛС)+". "+ СтрокаОтвет1;
				
				
				Если Не ПустаяСтрока(СтрокаОтвет1) Тогда
					РезультатПроверки1 = СтрокаОтвет1;
					
					НовСТр = ТаблицаДляИзмененияСтатуса.Добавить();
					НовСтр.ИД_События = Стр.ИД_События;
					
					Если СокрЛП(РезультатПроверки1)="false" Тогда
					Иначе
						
					КонецЕсли;
				КонецЕсли;
			ИначеЕсли Ответ.КодСостояния = 500 Тогда
			ИначеЕсли Ответ.КодСостояния = 404 Тогда
			ИначеЕсли Ответ.КодСостояния = 301 Тогда
			Иначе 
				Попытка
					СтрокаОтвет1 = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
				Исключение
					МЛК_Общий.ЗаписатьДанныеВЖурнал("Отправка квитанции","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
				КонецПопытки;	
			КонецЕсли;
		КонецЕсли;
		Попытка
			УдалитьФайлы(ИмяПромежуточногоФайла);
		Исключение
			МЛК_Общий.ЗаписатьДанныеВЖурнал("Удаление файла квитанции","",,,ОписаниеОшибки(),ТекущаяДатаСеанса());	
		КонецПопытки;
	КонецЦикла;
	
	Если ТаблицаДляИзмененияСтатуса.Количество()<>0 Тогда 
		// ИзменитьСтатусыВСобытиях(ТаблицаДляИзмененияСтатуса,Строка(Настройки.СтатусЗакрыто),Настройки);
		ИзменитьСтатусыВСобытиях(ТаблицаДляИзмененияСтатуса,Строка(СтрЗаменить(Настройки.СтатусЗакрыто,Символы.НПП,"")),Настройки);
	КонецЕсли;
	
КонецПроцедуры	
Функция ПечатьПлатежныйДокументРК924(ЛС,Период,Настройки)
	
	ОбработкаОбъект = Обработки.бит_ПечатьСчетИзвещений.Создать();
	
	НоваяСтрока = ОбработкаОбъект.СписокЛС.Добавить();
	НоваяСтрока.ЛицевойСчет = ЛС;
	
	ОбработкаОбъект.МакетКв               = Настройки.ШаблонКвитанции;  // ВОТ ТУТ ШАБЛОН КВИТАНЦИИ ЭТО НЕ МАКЕТ А ЭЛЕМЕНТ СПРАВОЧНИКА
	// ОбработкаОбъект.Период                = ДобавитьМесяц(КонецМесяца(ТекущаяДатаСеанса()), -1);
	ОбработкаОбъект.ШаблонИзвещений       = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
	ОбработкаОбъект.Организация           = ЛС.Организация;
	ОбработкаОбъект.РС                    = ЛС.Организация.ОсновнойБанковскийСчет;
	ОбработкаОбъект.ТекущийПакет          = 1;
	ОбработкаОбъект.РазмерПакетаПечати    = 500;
	ОбработкаОбъект.РазмерПакетаПросмотра = 50;
	ОбработкаОбъект.НеПечататьУслугиБезНачислений = Истина;
	ОбработкаОбъект.Период      = КонецМесяца(Период);
	
	ОбработкаОбъект.ПолучательПлатежа           = ЛС.Организация;
	
	ОбработкаОбъект.ОбновитьНастройкиЖКХ();
	ОбработкаОбъект.ОбновитьКэшОрганизации();
	ОбработкаОбъект.ОбновитьКэшПолучателяПлатежа();
	ОбработкаОбъект.ПолучитьНастройкуМакета();
	
	// Настроййки таб. док. поумолчанию.
	ТабличныйДокумент  = Новый ТабличныйДокумент;
	ТабличныйДокумент.АвтоМасштаб = Истина;
	ТабличныйДокумент.ОриентацияСтраницы = ОриентацияСтраницы.Портрет;
	
	// Формирование данных для макета.
	ТаблицаДанных = ОбработкаОбъект.СформироватьДанныеПечати();
	
	
	Отбор = Новый Структура;
	// Отбор.Вставить("ВладелецЛС", Стр.ЛицевойСчет); // Без иерархии.
	Отбор.Вставить("ЛицевойСчет", ЛС);
	ПоискЛС = ТаблицаДанных.НайтиСтроки(Отбор);
	
	Если ПоискЛС.Количество()<>0 Тогда
		ОбработкаОбъект.ВывестиНаПечатьКвитанцию(ТабличныйДокумент, ПоискЛС[0]);
	КонецЕсли;
	
	Возврат ТабличныйДокумент;
	
КонецФункции // ()
Функция ПолучитьПериодНачисленийПоЛицевомуСчету(ЛС)
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_НачислениеПоЛицевымСчетамЛицевыеСчета.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_НачислениеПоЛицевымСчетамЛицевыеСчета.Ссылка.Дата КАК Дата
	|ИЗ
	|	Документ.бит_НачислениеПоЛицевымСчетам.ЛицевыеСчета КАК бит_НачислениеПоЛицевымСчетамЛицевыеСчета
	|ГДЕ
	|	бит_НачислениеПоЛицевымСчетамЛицевыеСчета.ЛицевойСчет = &ЛицевойСчет
	|	И бит_НачислениеПоЛицевымСчетамЛицевыеСчета.Ссылка.ПометкаУдаления = ЛОЖЬ
	|	И бит_НачислениеПоЛицевымСчетамЛицевыеСчета.Ссылка.Проведен = ИСТИНА
	|
	|УПОРЯДОЧИТЬ ПО
	|	Дата УБЫВ";
	Запрос.УстановитьПараметр("ЛицевойСчет",ЛС);
	РезультатЗапроса = Запрос.Выполнить();
	Выб = РезультатЗапроса.Выбрать();
	Если Выб.Следующий() Тогда
		Возврат Выб.Дата;
	Иначе
		Возврат ТекущаяДатаСеанса();
	КонецЕсли;	
КонецФункции	
