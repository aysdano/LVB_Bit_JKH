		    |;
		    |
		    |////////////////////////////////////////////////////////////////////////////////
		    |ВЫБРАТЬ
		    |	ИСТИНА КАК Активность,
		    |	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
		    |	Благополучие.Ссылка КАК ЛицевойСчетЗависимый,
		    |	бит_ЛицевыеСчета.Здание.Код КАК лвбКодЗдания,
		    |	Благополучие.Ссылка.Здание.Код КАК блгКодЗдания
		    |ИЗ
		    |	Благополучие КАК Благополучие
		    |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		    |		ПО (ПОДСТРОКА(Благополучие.Ссылка.Наименование, 5, 6) = ПОДСТРОКА(бит_ЛицевыеСчета.Наименование, 5, 6))
		    |ГДЕ
		    |	бит_ЛицевыеСчета.Ссылка <> Благополучие.Ссылка";
	Табл = Запрос.Выполнить().Выгрузить();
	
	ЧислоСтрок = Табл.Количество();
	Для СчетВниз=1 по ЧислоСтрок цикл
