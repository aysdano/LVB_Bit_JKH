	ДанныеНадписи = РегистрыСведений.бит_НадписьКвитанции.СрезПоследних(мСтруктураДанных.Дата, Отбор);
	Если ДанныеНадписи.Количество() > 0 Тогда 
		ОбластьКвитанции.Параметры.ОсновнаяНадпись = ДанныеНадписи[0].ОсновнаяНадпись;
		ОбластьКвитанции.Параметры.Надпись2 = ДанныеНадписи[0].Надпись2;
	Иначе
		Отбор = Новый Структура;
		Отбор.Вставить("ШаблонКвитанции", Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговая);
		Отбор.Вставить("Здание"			, Справочники.бит_СписокЗданий.ПустаяСсылка());
		ДанныеНадписи = РегистрыСведений.бит_НадписьКвитанции.СрезПоследних(мСтруктураДанных.Дата, Отбор);
		Если ДанныеНадписи.Количество() > 0 Тогда 
			ОбластьКвитанции.Параметры.ОсновнаяНадпись = ДанныеНадписи[0].ОсновнаяНадпись;  //Период оплаты: погашение задолженности за период оплаты в Региональный фонд капитального ремонта (по данным РФКР)
