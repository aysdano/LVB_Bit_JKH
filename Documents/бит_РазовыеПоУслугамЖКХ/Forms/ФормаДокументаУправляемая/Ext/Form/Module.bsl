	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Объект.ЧекККМ = ВыбранноеЗначение;
		
		Объект.СписокУслуг.Очистить();
		 // БИТ ЖКХ 16.07.2020
        Объект.СписокУслугПеня.Очистить();
		
