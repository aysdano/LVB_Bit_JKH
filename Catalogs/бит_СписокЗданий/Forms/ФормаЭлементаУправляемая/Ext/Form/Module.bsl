// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	КэшированныеЗначения = Новый Структура;
	
	// Запишем переменные формы.
	КэшированныеЗначения.Вставить("мЛСИзменен"                      , Ложь);
	КэшированныеЗначения.Вставить("ЭтоНовый"                        , ?(Параметры.Ключ.Пустая(), Истина, Ложь));
	КэшированныеЗначения.Вставить("Ответ"                           , Ложь);
	КэшированныеЗначения.Вставить("КоличествоКомнат"                , 0);
	КэшированныеЗначения.Вставить("Этаж"                            , 0);
	КэшированныеЗначения.Вставить("КоличествоКомнатНежилыхПомещений", 0);
	КэшированныеЗначения.Вставить("ЭтажНежилыхПомещений"            , 0);
	КэшированныеЗначения.Вставить("ПочтовыйАдресЗдания"             , Неопределено);
	// БИТ_ЖКХ 23.06.2016 16:57:17 Начало правки...
	КэшированныеЗначения.Вставить("Подъезд"							, ПредопределенноеЗначение("Справочник.бит_Подъезды.ПустаяСсылка"));
	КэшированныеЗначения.Вставить("ПодъездНежилыхПомещений"			, ПредопределенноеЗначение("Справочник.бит_Подъезды.ПустаяСсылка"));
	КэшированныеЗначения.Вставить("КадастровыйНомер"				, Неопределено);
	КэшированныеЗначения.Вставить("КадастровыйНомерНежилыхПомещений", Неопределено);
	// БИТ_ЖКХ 23.06.2016 16:57:17 Конец правки.
	// 
	КэшированныеЗначения.Вставить("ПочтовыйАдресЗданияJSON"         , Неопределено);
	
КонецПроцедуры // ЗаполнитьКэшЗначений()

