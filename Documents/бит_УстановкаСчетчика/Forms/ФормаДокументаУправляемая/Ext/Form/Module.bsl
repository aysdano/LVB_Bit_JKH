&НаКлиенте
Процедура УслугиПоставщикНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущаяСтрока = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекущаяСтрока = Неопределено Тогда
		
		Возврат;
		
	КонецЕсли;
	
	Если ТекущаяСтрока.Услуга.Пустая() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните услугу.");
		
		Возврат;
		
	КонецЕсли; 
	
	СтандартнаяОбработка = Ложь; 
	
	СписокПоставщиков = ПолучитьСписокПоставщиковНаСервере(ТекущаяСтрока.Услуга);
	
	Отбор = Новый Структура;
	
	Отбор.Вставить("Ссылка", СписокПоставщиков);
	
	ОткрытьФорму("Справочник.бит_ПоставщикиУслуг.Форма.ФормаВыбораУправляемая", Новый Структура("ОтобратьИзДокументаУстановкаСчетчика", Отбор), Элемент);
	
КонецПроцедуры

&НаСервереБезКонтекста
Процедура ЗаполнитьКэшРеквизитовСчетчика(Ссылка, КэшЗначений)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_Счетчики.ТипСчетчика,
	|	бит_Счетчики.Разрядность
	|ИЗ
	|	Справочник.бит_Счетчики КАК бит_Счетчики
	|ГДЕ
	|	бит_Счетчики.Ссылка = &Ссылка";
	Запрос.УстановитьПараметр("Ссылка", Ссылка);
	
	Выборка = Запрос.Выполнить().Выбрать();
	Выборка.Следующий();
	
	КэшЗначений.Разрядность = Выборка.Разрядность;
	КэшЗначений.ТипСчетчика = Выборка.ТипСчетчика;
	
	// БИТ_ЖКХ 06.11.2014
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СчетчикСЗависимымиУслугами,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Регистратор,
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Период
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|ГДЕ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = &Счетчик";
	
	Запрос.УстановитьПараметр("Счетчик", Ссылка);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		КэшЗначений.СчетчикСЗависимымиУслугами = ВыборкаДетальныеЗаписи.СчетчикСЗависимымиУслугами;
		
	КонецЦикла;
	// БИТ_ЖКХ 06.11.2014
	
КонецПроцедуры

&НаСервере
Процедура ПриИзмененииСчетчикаНаСервере()
	
	Если Объект.ВидОперации = мКэшЗначений.Перечисления.бит_ВидыОпераций.УстановкаСчетчика Тогда
		
		Если Объект.Счетчик.ТипСчетчика = мКэшЗначений.Перечисления.бит_ТипСчетчика.Групповой Тогда
			Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам;
		Иначе
			Объект.СпособРасчета = мКэшЗначений.Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам;
		КонецЕсли;
		ЗаполнитьКэшРеквизитовСчетчика(Объект.Счетчик, мКэшЗначений);
	Иначе
		ОбновитьКэшПоСчетчику();
		
		Если Объект.Счетчик.ТипСчетчика = мКэшЗначений.Перечисления.бит_ТипСчетчика.Групповой Тогда
			ОбновитьДерево();
		КонецЕсли; 
		
	КонецЕсли; 
	
	УправлениеЭлементамиФормы();
	
	ЗаполнитьКэшРеквизитовСчетчика(Объект.Счетчик, мКэшЗначений);
	
	// БИТ_ЖКХ 06.11.2014
	Объект.СчетчикСЗависимымиУслугами = мКэшЗначений.СчетчикСЗависимымиУслугами;
	// БИТ_ЖКХ 06.11.2014
	
КонецПроцедуры

