	КонецЕсли;
	
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если Объект.ОтборЛицевыхСчетов.Количество() > 0 Тогда
		
		ТабЛС    = Объект.ОтборЛицевыхСчетов.Выгрузить();
		Значение = Новый СписокЗначений;
		Значение.ЗагрузитьЗначения(ТабЛС.ВыгрузитьКолонку("ЛицевойСчет"));
		
		ОтборЛС = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
		ОтборЛС.ВидСравнения  = УсловиеОтбора;
		ОтборЛС.Значение      = Значение;
		ОтборЛС.Использование = Истина;
		
	КонецЕсли;
	
	Если Объект.Услуги = "По выбору" и Объект.ВводИнформации = "С разбивкой по услугам" Тогда
		
		Если Объект.ОтборУслуг.Количество() > 0 Тогда
			
			ТабУслуг    = Объект.ОтборУслуг.Выгрузить();
			Значение = Новый СписокЗначений;
			Значение.ЗагрузитьЗначения(ТабУслуг.ВыгрузитьКолонку("Услуга"));
			
			ОтборУс = ПостроительЗапроса.Отбор.Добавить("Услуга");
			ОтборУс.ВидСравнения  = УсловиеОтбораУслуг;
			ОтборУс.Значение      = Значение;
			ОтборУс.Использование = Истина;
			
		КонецЕсли;
		
	КонецЕсли;
	
	ПостроительЗапроса.ВыбранныеПоля.Очистить();
	ПостроительЗапроса.ВыбранныеПоля.Добавить("ЛицевойСчет");
	ПостроительЗапроса.ВыбранныеПоля.Добавить("НаименованиеЛС");
	ПостроительЗапроса.ВыбранныеПоля.Добавить("ИдентификаторЛицевогоСчета");
	
	Если Объект.ВыводИнформации = "С разбивкой по услугам" Тогда
		ПостроительЗапроса.ВыбранныеПоля.Добавить("УслугаПриоритет");
		ПостроительЗапроса.ВыбранныеПоля.Добавить("УслугаСчетчикаПриоритет");
	КонецЕсли;
	
	Для каждого СтрокаТаблицы Из НастройкаПолейСтрокиРеестраСальдо Цикл
		
		Если СтрокаТаблицы.Использовать Тогда
			
			Если СтрокаТаблицы.имяПоля = "НачалоПериода" ИЛИ 
				СтрокаТаблицы.имяПоля = "КонецПериода" ИЛИ 
				СтрокаТаблицы.имяПоля = "КодДополнения" ИЛИ 
				СтрокаТаблицы.имяПоля = "ШтрихКод" ИЛИ 
				СтрокаТаблицы.имяПоля = "НаименованиеЛС" ИЛИ 
				СтрокаТаблицы.имяПоля = "ИдентификаторЛицевогоСчета" Тогда
				Продолжить;
			КонецЕсли; 
			
			Если СтрокаТаблицы.имяПоля = "Адрес" Тогда
				
				ПостроительЗапроса.ВыбранныеПоля.Добавить("Город");
				ПостроительЗапроса.ВыбранныеПоля.Добавить("Улица");
				ПостроительЗапроса.ВыбранныеПоля.Добавить("Здание");
				ПостроительЗапроса.ВыбранныеПоля.Добавить("Корпус");
				ПостроительЗапроса.ВыбранныеПоля.Добавить("Квартира");
				
				Продолжить;
				
			КонецЕсли;
			
			ПостроительЗапроса.ВыбранныеПоля.Добавить(СтрокаТаблицы.ИмяПоля);
			
		КонецЕсли; 
		
	КонецЦикла;
	
	ПостроительЗапроса.Выполнить();
	
	Если ПостроительЗапроса.Результат.Пустой() Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("За данный периода - данные не найдены.");
		
		Возврат;
	КонецЕсли; 
	
	ВыборкаОбщ = ПостроительЗапроса.Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
