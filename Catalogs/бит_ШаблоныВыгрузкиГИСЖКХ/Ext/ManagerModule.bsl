		//НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "ЖилыеДомаОдногоАдреса",  	    4, );
		НСтрШаблона(НШаблон.ПоляШаблона, ТаблицаШаблоновГИСЖКХ, "ОКТМО",						5, );
