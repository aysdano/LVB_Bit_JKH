Функция ПолучитьПериодПоСтроке(ДокСсылка,лб_ПериодНачисления) экспорт
	Отв = ДокСсылка.Дата; 
	ДО = "0000"+ лб_ПериодНачисления;
	ДО=СтрЗаменить(ДО," ","");
	ДО=СтрЗаменить(ДО,символы.нпп,"");    
	попытка
		Если СтрДлина(ДО)>7 тогда
			Если лев(прав(ДО,4),2) = "20" тогда
				ГодЧислом = число(прав(ДО,4));
				МесяцЧислом = число(лев(прав(ДО,6),2));
			иначе                       
				ГодЧислом = число("20"+прав(ДО,2));
				МесяцЧислом = число(лев(прав(ДО,4),2));
			КонецЕсли;
			Если МесяцЧислом>=1 и МесяцЧислом<=12 тогда
				Отв = Дата(ГодЧислом,МесяцЧислом,1);
			КонецЕсли;
		КонецЕсли;
	исключение  
		сообщить(СтрШаблон("В документе %1 некорректный период оплаты %2",ДокСсылка,лб_ПериодНачисления))
	конецпопытки;
	
	Если Отв<=МинимальныйПериодОплаты() тогда
		Возврат НачалоДня(КонецМесяца(МинимальныйПериодОплаты()));
	ИначеЕсли Отв>=МаксимальныйПериодОплаты() тогда   
		Возврат НачалоДня(КонецМесяца(ДокСсылка.Дата));
	иначе
		Возврат НачалоДня(КонецМесяца(Отв));
	КонецЕсли;
	
Конецфункции

Процедура СформироватьДвиженияОплатаХозрасчетный(ТаблицаУслуг, ТаблицаЛицевыхСчетов, Реквизиты, Движения, Отказ) Экспорт
	
	СчетУчетаЖКХ = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.КУ");
	
	СтруктураНастроек = Новый Структура();
	СтруктураНастроек.Вставить("СчетАбонента", Неопределено);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(Реквизиты.Дата, Реквизиты.Организация, СтруктураНастроек);
	
	Если СтруктураНастроек.СчетАбонента = СчетУчетаЖКХ Тогда
		
		Отбор = Новый Структура;
		
		Для каждого СтрокаТЧ Из ТаблицаЛицевыхСчетов Цикл
			
			Если ЗначениеЗаполнено(СтрокаТЧ.СчетАбонента) И ЗначениеЗаполнено( СтрокаТЧ.СчетКУ) Тогда 
				
				Отбор.Очистить();
				
				Отбор.Вставить("ЛицевойСчет"    , СтрокаТЧ.ЛицевойСчет);
				Отбор.Вставить("ШаблонИзвещений", СтрокаТЧ.ШаблонИзвещений);
				
				ПоискСтрок = ТаблицаУслуг.НайтиСтроки(Отбор);
				
				Для каждого СтрокаУслуг Из ПоискСтрок Цикл
					
					Проводка = Движения.Хозрасчетный.Добавить();
					мСумма = СтрокаУслуг.Сумма + СтрокаУслуг.СуммаПени;
					Проводка.Период     = Реквизиты.Дата;
					Проводка.Содержание = "Оплата КУ";
					Проводка.Организация = Реквизиты.Организация;
					
					Проводка.СчетКт = СтрокаТЧ.СчетАбонента;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.Субконто1);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаУслуг.Услуга);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.Субконто3);
					Проводка.СчетДт = СтрокаТЧ.СчетКУ;
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.СубконтоКУ1);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.СубконтоКУ2);
					БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.СубконтоКУ3);
					Проводка.Сумма = мСумма;
					
				КонецЦикла; 
				
				
			КонецЕсли;
			
		КонецЦикла;
		
	Иначе
		
		Для каждого СтрокаТЧ Из ТаблицаЛицевыхСчетов Цикл
			
			Если ЗначениеЗаполнено( СтрокаТЧ.СчетАбонента) И ЗначениеЗаполнено( СтрокаТЧ.СчетКУ) Тогда 
				
				Проводка = Движения.Хозрасчетный.Добавить();
				мСумма = СтрокаТЧ.Сумма;
				Проводка.Период     = Реквизиты.Дата;
				Проводка.Содержание = "Оплата КУ";
				Проводка.Организация = Реквизиты.Организация;
				
				Проводка.СчетКт = СтрокаТЧ.СчетАбонента;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 1, СтрокаТЧ.Субконто1);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 2, СтрокаТЧ.Субконто2);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетКт, Проводка.СубконтоКт, 3, СтрокаТЧ.Субконто3);
				Проводка.СчетДт = СтрокаТЧ.СчетКУ;
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 1, СтрокаТЧ.СубконтоКУ1);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 2, СтрокаТЧ.СубконтоКУ2);
				БухгалтерскийУчет.УстановитьСубконто(Проводка.СчетДт, Проводка.СубконтоДт, 3, СтрокаТЧ.СубконтоКУ3);	
				Проводка.Сумма = мСумма;
				
			КонецЕсли;
			
		КонецЦикла;
	КонецЕсли;
	
	Движения.Хозрасчетный.Записывать = Истина;
	
КонецПроцедуры

