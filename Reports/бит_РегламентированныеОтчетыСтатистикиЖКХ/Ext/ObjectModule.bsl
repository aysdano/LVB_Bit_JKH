КонецФункции  //СборСведенийОбОрганизации()

// Проверяет корректность заполнения реквизитов отчета.
//
// Возвращаемое значение:
//  Булево – корректно ли заполнение.
//
Функция ПроверкаЗаполненияШапки(ВыводитьПредупреждение = Истина)

	Если ПустаяСтрока(ВидФормы) Тогда
		Если ВыводитьПредупреждение Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не указан номер требуемой формы.");
		КонецЕсли;
		Возврат Ложь;

	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Дата) Тогда
		Если ВыводитьПредупреждение Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не указана дата.");
			
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Организация) Тогда
		Если ВыводитьПредупреждение Тогда

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не выбрана организация.");
			
		КонецЕсли;
		Возврат Ложь;
	КонецЕсли;

	Возврат Истина;

КонецФункции 

// БИТ_ЖКХ 20.04.2017 10:55:11 Начало правки... 

// Заполняет указанный табличный документ по форме №22 по данным.
// В указанной структуре параметров.
Процедура ЗаполнитьДокумент_Ф22(ДокументРезультат, СведенияОбОрганизации)
	
	Макет = ПолучитьМакет("Форма22_2017Кв1");
	ДокументРезультат.Вывести(Макет);
	
	// ОсновнаяЧасть1а
	ДокументРезультат.Области.ПериодОтчета.Значение = "за январь - "
		+ НРег(Формат(Дата, "ДФ = 'ММММ гггг'")) + " г.";
															
	// ПолеНомерКорректировки.
	
	// ОсновнаяЧасть1б
	ДокументРезультат.Области.ОргНазв.Значение	  = СведенияОбОрганизации["Наименование"];
	ДокументРезультат.Области.ОргАдрес.Значение	  = СведенияОбОрганизации["Адрес"];
	ДокументРезультат.Области.ОргКодОКПО.Значение = СведенияОбОрганизации["КодПоОКПО"];
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ЛицевыеСчета.Ссылка КАК ЛицевойСчет,
	|	бит_ЛицевыеСчета.Квартира КАК Квартира,
	|	бит_ЛицевыеСчета.Здание КАК Здание
	|ПОМЕСТИТЬ ВТ_ЛицевыеСчета
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Организация В ИЕРАРХИИ(&Организация)
	|	И НЕ бит_ЛицевыеСчета.ПометкаУдаления
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга
	|ПОМЕСТИТЬ ВТ_бит_СведенияПоУслугамЛССрезПоследних
	|ИЗ
	|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	|			&КонецПериода,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					ВТ_ЛицевыеСчета.ЛицевойСчет
	|				ИЗ
	|					ВТ_ЛицевыеСчета КАК ВТ_ЛицевыеСчета)) КАК бит_СведенияПоУслугамЛССрезПоследних
	|ГДЕ
	|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.Квартира,
	|	бит_СведенияОКвартиреСрезПоследних.ТипПлиты КАК ТипПлиты
	|ПОМЕСТИТЬ ВТ_бит_СведенияОКвартиреСрезПоследних
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(
	|			&КонецПериода,
	|			Квартира В
	|				(ВЫБРАТЬ РАЗЛИЧНЫЕ
	|					ВТ_ЛицевыеСчета.Квартира
	|				ИЗ
	|					ВТ_ЛицевыеСчета КАК ВТ_ЛицевыеСчета)) КАК бит_СведенияОКвартиреСрезПоследних
	|
	|ИНДЕКСИРОВАТЬ ПО
	|	бит_СведенияОКвартиреСрезПоследних.Квартира
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВТ_бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
