		Результат = Запрос.Выполнить();
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Объект.Подписант = Выборка.ФИО;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Период",ТекущаяДата());
		Запрос.Текст = "ВЫБРАТЬ
		|	бит_ПредставительскиеРасходыСрезПоследних.Стоимость КАК Стоимость
		|ИЗ
		|	РегистрСведений.бит_ПредставительскиеРасходы.СрезПоследних(&Период, ) КАК бит_ПредставительскиеРасходыСрезПоследних";
		
		Результат = Запрос.Выполнить();
		
		Выборка = Результат.Выбрать();
		
		Если Выборка.Следующий() Тогда
			Объект.ПредставительскиеРасходы = Выборка.Стоимость;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		
		
		Объект.Ответственный = Пользователи.ТекущийПользователь();
		
	КонецЕсли;   
	Если Объект.Ссылка.Пустая() Тогда        
		Объект.Организация = Справочники.Организации.НайтиПоРеквизиту("ИНН", "5503245214");
		Объект.Абзац = Истина;
	КонецЕсли;
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды 
