	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга КАК Услуга,
		|	бит_СведенияПоУслугамЛССрезПоследних.Период КАК Период
		|ИЗ
		|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних КАК бит_СведенияПоУслугамЛССрезПоследних
		|ГДЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет = &ЛицевойСчет";
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
	
	РезультатЗапроса = Запрос.Выполнить();	
	Выборка = РезультатЗапроса.Выгрузить();
	
