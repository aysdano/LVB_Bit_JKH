			ОтборЗданий.Использование = Истина;
			
		КонецЕсли;
		
		Если ИспользоватьОтборСписокЛС Тогда
			
			Если СписокЛС.Количество() > 0 Тогда
				
				Отбор = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
				Отбор.ВидСравнения  = ВидСравнения.ВСписке;
				Отбор.Использование = Истина;
				Отбор.Значение      = СписокЛС;
				
			КонецЕсли;
			
		КонецЕсли;
		
		Если ИспользоватьОтборСтатусКв Тогда
			
			ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("СтатусКвартиры");
			ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
			ОтборЗданий.Значение      = СтатусКвартиры;
			ОтборЗданий.Использование = Истина;
			
		КонецЕсли; 
		
		Если ИспользоватьОтборТипКв Тогда
			
			ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("ТипКвартиры");
			ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
			ОтборЗданий.Значение      = ТипКвартиры;
			ОтборЗданий.Использование = Истина;
			
		КонецЕсли;
		
		ПостроительЗапроса.Выполнить();
		
		Если ТипВыгрузки = "Excel" Тогда
			ВыгрузитьСведенияОЧленахСемьиВExcel(ПостроительЗапроса,ТаблицаОтвЛиц);
		ИначеЕсли ТипВыгрузки = "DBF" Тогда
			ВыгрузитьСведенияОЧленахСемьиВDBF(ПостроительЗапроса,ТаблицаОтвЛиц);
		Иначе	
			ВыгрузитьСведенияОЧленахСемьиВDBF(ПостроительЗапроса,ТаблицаОтвЛиц);
		КонецЕсли;
		
	КонецЕсли;	
КонецПроцедуры

&НаСервере
Процедура ФормированиеФайлаСуммыОплатыУслуг(ТаблицаОтвЛиц)
	
	// Формирование файла Суммы оплаты услуг.
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Параметры.Вставить("Организация"   , Объект.Организация);
	ПостроительЗапроса.Параметры.Вставить("НачалоПериода" , НачалоМесяца(Объект.Период));
	ПостроительЗапроса.Параметры.Вставить("КонецПериода"  , КонецМесяца(Объект.Период));
	ПостроительЗапроса.Текст  = ТекстЗапросаСуммыОплатыУслуг();
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если ИспользоватьОтборСписокЗданий Тогда
		
		тмпСписокЗданий = СписокЗданий.Выгрузить();
		ЗначениеОтбора = Новый СписокЗначений;
		ЗначениеОтбора.ЗагрузитьЗначения(тмпСписокЗданий.ВыгрузитьКолонку("Здание"));
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("Здание");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ЗначениеОтбора;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСписокЛС Тогда
		
		Если СписокЛС.Количество() > 0 Тогда
			
			Отбор = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
			Отбор.ВидСравнения  = ВидСравнения.ВСписке;
			Отбор.Использование = Истина;
			Отбор.Значение      = СписокЛС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСтатусКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("СтатусКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = СтатусКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли; 
	
	Если ИспользоватьОтборТипКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("ТипКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ТипКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если НЕ Объект.ШаблонУслуг = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам 
		И НЕ Объект.ШаблонУслуг.Пустая() Тогда
		
		СписокУслуг = Новый СписокЗначений;
		СписокУслуг.ЗагрузитьЗначения(Объект.ШаблонУслуг.Услуги.ВыгрузитьКолонку("Услуга"));
		
		Отбор = ПостроительЗапроса.Отбор.Добавить("УслугаЖКХ");
		Отбор.ВидСравнения  = ВидСравнения.ВСписке;
		Отбор.Использование = Истина;
		Отбор.Значение      = СписокУслуг;
		
	КонецЕсли;
	
	// Отбор по коду услуг.
	Отбор = ПостроительЗапроса.Отбор.Добавить("КодПоГУГЦЖС");
	Отбор.ВидСравнения  = ВидСравнения.НеРавно;
	Отбор.Использование = Истина;
	Отбор.Значение      = "";
	
	ПостроительЗапроса.Выполнить();
	
	Если ТипВыгрузки = "Excel" Тогда
		ВыгрузитьСуммыОплатыУслугВExcel(ПостроительЗапроса,ТаблицаОтвЛиц);
	ИначеЕсли ТипВыгрузки = "DBF" Тогда
		ВыгрузитьСуммыОплатыУслугВDBF(ПостроительЗапроса,ТаблицаОтвЛиц);
	Иначе	
		ВыгрузитьСуммыОплатыУслугВDBF(ПостроительЗапроса,ТаблицаОтвЛиц);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьДанныеКвартиросъемщикаВExcel(ПостроительЗапроса,ТаблицаОтвЛиц)
	
	ЕстьОшибки = Ложь;
	
	// Создадим приложение Excel.
	Excel = бит_Выгрузка.СоздатьПриложениеExcel();
	
	Если Excel = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		бит_ОбщегоНазначения.бит_Состояние("Создание файла Excel для заполнения...");
		
		Книга          = Excel.Application.WorkBooks.Add(1);
		ExcelЛист	   = Excel.ActiveSheet;
		
		бит_ОбщегоНазначения.бит_Состояние("Установка формата колонок листа Excel...");
		
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 1 , Истина); // Лицевой счет.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 2 , Истина); // Населенный пункт.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 3 , Истина); // Тип улицы.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 4 , Истина); // Улица.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 5 , Истина); // Дом.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 6 , Истина); // Корпус.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 7 , Истина); // Буква дома.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 8 , Истина); // Квартира.
		
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 9 , Истина); // Буква квартиры.
		
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 10, Истина); // Отчетный месяц.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 11, Истина); // Количество челов семьи.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 12, Истина); // Общая площадь.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 13, Истина); // Наличие задолжности.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 14, Истина); // Причина закрытия жилищной субсидии.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 15, Истина); // Главный квартиросъемщик.
		
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 16, Истина); // Сумма долга.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 17, Истина); // Начало периода задолженности.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 18, Истина); // Конец периода задолженности.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 19, Истина); // Наличие соглашения о реструктуризации задолженности.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 20, Истина); // Исполнение условий соглашения.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 21, Истина); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 22, Истина); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 23, Истина); // Идентификатор  дома в ФИАС.
		
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение заголовка листа Excel...");
		
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ID"     , 1 , 1); // Лицевой счет.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PUNKT"  , 2 , 1); // Населенный пункт.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "TIP"    , 3 , 1); // Тип улицы.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UL"     , 4 , 1); // Улица.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DOM"    , 5 , 1); // Дом.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "KOR"    , 6 , 1); // Корпус.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "BDOM"   , 7 , 1); // Буква дома.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "KV"     , 8 , 1); // Квартира.
		
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "BKV"    , 9 , 1); // Буква квартиры.
		// BKV	С 1	А	Буква квартиры.
		
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "OTCH"   , 10 , 1); // Отчетный месяц.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "SEM"    , 11 , 1); // Количество челов семьи.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PL"     , 12 , 1); // Общая площадь.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DOLG"   , 13 , 1); // Наличие задолжности.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "Z"      , 14 , 1); // Причина закрытия жилищной субсидии.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "KVSM"   , 15 , 1); // Главный квартиросъемщик.
		
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "SDOLG"  , 16 , 1); // Сумма долга.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PER_B"  , 17 , 1); // Начало периода задолженности.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PER_E"  , 18 , 1); // Конец периода задолженности.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "SOG"    , 19 , 1); // Наличие соглашения о реструктуризации задолженности.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "IUSOG"  , 20 , 1); // Исполнение условий соглашения.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PLODN"  , 21 , 1); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PLODN_V", 22 , 1); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "FIAS_ID", 23 , 1); // Идентификатор  дома в ФИАС.
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение листа Excel...");
		
		НомерСтроки = 2;
		
		Выборка = ПостроительЗапроса.Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаТаблицыКод = ТаблицаОтвЛиц.Найти(Выборка.ЛицевойСчет, "ЛицевойСчет");
			
			Код = ?(СтрокаТаблицыКод = Неопределено, 0, СтрокаТаблицыКод.Код);
			
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Наименование								, 1 , НомерСтроки); // Лицевой счет.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Район), 30)						, 2 , НомерСтроки); // Населенный пункт.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ТипУлицы), 30)					, 3 , НомерСтроки); // Тип улицы.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Улица), 30)						, 4 , НомерСтроки); // Улица.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Здание), 3)						, 5 , НомерСтроки); // Дом.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Корпус), 2)						, 6 , НомерСтроки); // Корпус.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ПрефиксДома), 1)					, 7 , НомерСтроки); // Буква дома.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(?(Строка(Выборка.Квартира) = "-","", Строка(Выборка.Квартира)), 10), 8 , НомерСтроки); // Квартира.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ПрефиксКвартиры),1)				, 9 , НомерСтроки); // Буква квартиры.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Объект.Период, "ДФ=MM.yyyy")					, 10, НомерСтроки); // Отчетный месяц.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.КоличествоЧленовСемьи						, 11, НомерСтроки); // Количество челов семьи.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Выборка.ОбщаяПлощадь, "ЧЦ=6; ЧДЦ=2; ЧГ=0")	, 12, НомерСтроки); // Общая площадь.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.Сальдо > 0 И Выборка.ДолгНачалоПериода > 0, Истина, Ложь), 13, НомерСтроки); // Наличие задолжности.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ""													, 14, НомерСтроки); // Причина закрытия жилищной субсидии.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Код													, 15, НомерСтроки); // Главный квартиросъемщик.
			
			Если Выборка.ДолгНачалоПериода>0 Тогда
				ДолгНачалоПериода =	Выборка.ДолгНачалоПериода;
			Иначе 
				ДолгНачалоПериода =	0;
			КонецЕсли;
			
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.Сальдо > 0,ДолгНачалоПериода,0)			, 16, НомерСтроки); // Сумма долга.
			
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Ложь												, 19, НомерСтроки); // Наличие соглашения о реструктуризации задолженности.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Ложь												, 20, НомерСтроки); // Исполнение условий соглашения.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Выборка.ПлощадьОДНСОИЭлектроснаб	, "ЧЦ=6; ЧДЦ=2; ЧГ=0")	, 21, НомерСтроки); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Выборка.ПлощадьОДНСОИВодоснаб	, "ЧЦ=6; ЧДЦ=2; ЧГ=0")	, 22, НомерСтроки); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.КодФИАС), 36)								, 23, НомерСтроки); // Идентификатор  дома в ФИАС.
			
			// БИТ ЖКХ 6.03.2020
			если Выборка.Сальдо > 0 И Выборка.ДолгНачалоПериода > 0 тогда
			 бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Выборка.НачалоЗадолженности,"ДФ=дд.MM.yyyy")	, 17, НомерСтроки); // Начало периода задолженности.
			 бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(НачалоМесяца(Объект.Период),"ДФ=дд.MM.yyyy")	, 18, НомерСтроки); // Конец периода задолженности.
			конецесли; 
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла; 
		
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 2);
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 38);
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 39);
		
		
		ПутьВыгрузки = Объект.кр_Каталог;
		
		ИмяФайла = Объект.кр_ИмяФайлаКвартиросъемщики +".xls";
		
		Книга.ConflictResolution = 1;
		Книга.SaveAs(ПутьВыгрузки + "\"+ ИмяФайла);
		Excel.Quit();
		
	Исключение
		ЕстьОшибки = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить лист Excel!
									|%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	Если ЕстьОшибки Тогда
		
		бит_Выгрузка.ЗакрытьПриложениеExcel(Excel);
		
	КонецЕсли; 
	
КонецПроцедуры

