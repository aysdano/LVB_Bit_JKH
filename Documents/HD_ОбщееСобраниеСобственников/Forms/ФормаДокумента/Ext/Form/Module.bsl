	Если ЗначениеЗаполнено(ПараметрСтроки) Тогда
		Если НЕ ПроверитьИПривестиТипЗначенияПользовательскогоПараметраНаСервере(ПараметрСтроки) Тогда
			//HD+ Даже при очистке из-за неверного типа синхронизируем группу падежей
			СинхронизироватьЗначениеПадежнойГруппыПользовательскихПараметровНаСервере(ПараметрСтроки);
			//HD-
			ПоказатьПредупреждение(, "Значение параметра не соответствует ожидаемому типу: " + ПараметрСтроки + ".");
			ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
			Возврат;
		КонецЕсли;
		//HD+ Одно значение на все падежные варианты одного параметра (Арендатор_Дательный / _Творительный и т.п.)
		СинхронизироватьЗначениеПадежнойГруппыПользовательскихПараметровНаСервере(ПараметрСтроки);
		//HD-
	КонецЕсли;
	
	ПрименитьПользовательскиеПараметрыКПовесткеДняНаСервере();
КонецПроцедуры //HD-

//HD+
