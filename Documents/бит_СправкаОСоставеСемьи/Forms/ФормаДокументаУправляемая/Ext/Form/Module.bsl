#Область ПрочиеПроцедурыИФункции

&НаСервере
Функция Сформировать(ИмяМакета)
	Если ИмяМакета = "СправкаОСоставеСемьи" тогда
		
		//ТабДокумент = ПечатьСправкаОСоставеСемьи();
		ТабДокумент = ПечатьСправкаОСоставеСемьиБит(Истина, Ложь);
	ИначеЕсли ИмяМакета = "СправкаОСоставеСемьиБит" Тогда

		ТабДокумент = ПечатьСправкаОСоставеСемьиБит();
	ИначеЕсли ИмяМакета = "СправкаОбОтсутствииПрописанных" Тогда
		// Справка об отсутствии зарегистрированных по  ЛС выдается. 
		// ТОЛЬКО собственнику жилья.
		// Получить полный список когда-либо проживающих по ЛС.
		
		Структура = СписокПроживающих(Объект.ЛицевойСчет, Истина);
		
		НайденнаяСтрока = Структура.НайденнаяСтрока;
		
		Если НайденнаяСтрока = Ложь Тогда
			
			Если ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
				Если ЗначениеЗаполнено(Объект.ФизЛицо.Пол)Тогда
					
					Если Объект.ФизЛицо.Пол = Перечисления.ПолФизическогоЛица.Женский Тогда
						Текст = Строка(Объект.ФизЛицо) + " никогда не была зарегистрирована по ЛС " + Строка(Объект.ЛицевойСчет);
					Иначе
						Текст = Строка(Объект.ФизЛицо) + " никогда не был зарегистрирован по ЛС " + Строка(Объект.ЛицевойСчет);
					КонецЕсли;
					
				Иначе
					Текст = Строка(Объект.ФизЛицо) + " никогда не был(а) зарегистрирован(а) по ЛС " + Строка(Объект.ЛицевойСчет);
				КонецЕсли;
				
			Иначе
				Текст = "Заполните реквизит ""Физ. лицо"""  ;
			КонецЕсли; 
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Текст);
			
		ИначеЕсли НЕ Структура.ВладелецКвартиры = Перечисления.ДаНет.Да	Тогда
			
			Текст = Строка(Объект.ФизЛицо) + " никогда не был(а) зарегистрирован(а) как собственник по ЛС " + Строка(Объект.ЛицевойСчет);

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Текст);
			
		Иначе
			ТабДокумент = ПечатьСправкаОСоставеСемьи(Ложь);
		КонецЕсли;
		
	КонецЕсли;
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
// Функция формирует табличный документ с печатной формой сличительной ведомости.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьСправкаОСоставеСемьи(Флаг = Истина) 
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекущийДокумент"	, Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" 			,Объект.Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет" 	,Объект.ЛицевойСчет);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СправкаОСоставеСемьи.Номер,
	|	СправкаОСоставеСемьи.Дата,
	|	СправкаОСоставеСемьи.Организация,
	|	СправкаОСоставеСемьи.ФизЛицо,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество,
	|	ФИОФизЛицСрезПоследних.Фамилия + "" "" + ФИОФизЛицСрезПоследних.Имя + "" "" + ФИОФизЛицСрезПоследних.Отчество КАК ФИО,
	|	СправкаОСоставеСемьи.ДляПредъявления,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации
	|ИЗ
	|	Документ.бит_СправкаОСоставеСемьи КАК СправкаОСоставеСемьи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК ФИОФизЛицСрезПоследних
	|		ПО СправкаОСоставеСемьи.ФизЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО СправкаОСоставеСемьи.ФизЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|ГДЕ
	|	СправкаОСоставеСемьи.Ссылка = &ТекущийДокумент";
	
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ                              
	|	бит_СправкаОСоставеСемьиФизическиеЛица.ФизическоеЛицо,
	|	бит_СправкаОСоставеСемьиФизическиеЛица.РодственныеОтношения КАК РодственнаяСвязь,
	|	бит_СправкаОСоставеСемьиФизическиеЛица.ДатаРождения,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество,
	|	ВЫБОР
	|		КОГДА (НЕ ФИОФизЛицСрезПоследних.Фамилия ЕСТЬ NULL )
	|			ТОГДА ФИОФизЛицСрезПоследних.Фамилия + "" "" + ФИОФизЛицСрезПоследних.Имя + "" "" + ФИОФизЛицСрезПоследних.Отчество
	|		ИНАЧЕ бит_СправкаОСоставеСемьиФизическиеЛица.ФизическоеЛицо
	|	КОНЕЦ КАК ФИО,
	|	бит_СправкаОСоставеСемьиФизическиеЛица.НомерСтроки
	|ИЗ
	|	Документ.бит_СправкаОСоставеСемьи.ФизическиеЛица КАК бит_СправкаОСоставеСемьиФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК ФИОФизЛицСрезПоследних
	|		ПО бит_СправкаОСоставеСемьиФизическиеЛица.ФизическоеЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО бит_СправкаОСоставеСемьиФизическиеЛица.ФизическоеЛицо = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_СправкаОСоставеСемьиФизическиеЛица.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	
	ТабДокумент   = Новый ТабличныйДокумент();
	
	Если Флаг Тогда
		ТабДокумент.КлючПараметровПечати = "СправкаОСоставеСемьи";
		Макет         = Документы.бит_СправкаОСоставеСемьи.ПолучитьМакет("СправкаОСоставеСемьи");
	Иначе
		ТабДокумент.КлючПараметровПечати = "СправкаОбОтсутствииПрописанных";
		Макет         = Документы.бит_СправкаОСоставеСемьи.ПолучитьМакет("СправкаОбОтсутствииПрописанных");
	КонецЕсли;
	
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	ШапкаОбласть.Параметры.НомерСправки = Шапка.Номер;
	ШапкаОбласть.Параметры.ДатаВыдачи   = Формат(Шапка.Дата,"ДФ='dd.MM.yyyy ""г.""'");
	
	СтруктураДанных = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
	
	
	ШапкаОбласть.Параметры.Организация       = СтруктураДанных.НаименованиеДляПечатныхФорм;
	
	Если Флаг Тогда
		ШапкаОбласть.Параметры.ОрганизацияИННКПП = Строка(СтруктураДанных.ИНН)+"\"+Строка(СтруктураДанных.КПП);
		ШапкаОбласть.Параметры.Факс              = СтруктураДанных.Телефоны;
		ШапкаОбласть.Параметры.РС                = "№"+Строка(СтруктураДанных.НомерСчета)+", "+Строка(СтруктураДанных.Банк)+"\"+Строка(СтруктураДанных.КоррСчет)+"\"+Строка(СтруктураДанных.БИК);
	КонецЕсли;
	
	ШапкаОбласть.Параметры.АдресОрганизации  = СтруктураДанных.ФактическийАдрес;
	ШапкаОбласть.Параметры.Телефон           = СтруктураДанных.Телефоны;
	
	Если Шапка.ФизЛицо <> Неопределено Тогда
		
		Если Шапка.ФИО <> Null Тогда
			ФИО = Шапка.ФИО;
			
		Иначе
			ФИО = Строка(Шапка.ФизЛицо);
		КонецЕсли; 
		
		АдресПрибытия ="";
		АдресПрибытия_1 = "";
		АдресПрибытия_2 = "";
		ДлинаАдреса_1 	= 25;
		
		ФИО_склон = "";
		ИсходСклонения =  бит_ПаспортныйСтолСервер.Просклонять(Строка(ФИО),3,Шапка.ФизЛицо.Пол,ФИО_склон);
		
		Если Флаг Тогда
			ШапкаОбласть.Параметры.ДатаРегистрации = ?(ЗначениеЗаполнено(Шапка.ДатаРегистрации), Формат(Шапка.ДатаРегистрации,"ДФ='dd.MM.yyyy ""г.""'"),"");
			
			ФИО_1 = ФИО_склон;
			ФИО_2 = "";
			бит_ОбщегоНазначенияКлиентСервер.РазбитьСтроку(27,ФИО_1,ФИО_2);
			//бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(ФИО_склон, 20, ФИО_1, ФИО_2);
			ШапкаОбласть.Параметры.ФИО_1 = ФИО_1;
			ШапкаОбласть.Параметры.ФИО_2 = ФИО_2;
			
			ШапкаОбласть.Параметры.ДД   = Шапка.ФизЛицо.ДатаРождения;
			ДатаМесяц 					= Формат(Шапка.ФизЛицо.ДатаРождения,"ДФ='дд.MMMM'");
			ШапкаОбласть.Параметры.ММ 	= Сред(ДатаМесяц, 4, СтрДлина(ДатаМесяц));
			ШапкаОбласть.Параметры.ГГГГ = Шапка.ФизЛицо.ДатаРождения;
			
			АдресПрибытия = бит_ОбщегоНазначения.ПолучитьАдресИзКонтактнойИнформацииФизЛица(Шапка.ФизЛицо, "Юридический");
			Если НЕ ЗначениеЗаполнено(АдресПрибытия) Тогда
				АдресПрибытия =	Объект.ЛицевойСчет.Здание.ПочтовыйАдрес + ?(ЗначениеЗаполнено(Объект.ЛицевойСчет.Квартира), ", кв. " + Строка(Объект.ЛицевойСчет.Квартира),"");
			КонецЕсли;
		Иначе
			
			ШапкаОбласть.Параметры.ФИО = ФИО;
			
			Если ЗначениеЗаполнено(Объект.ЛицевойСчет.Здание.ПочтовыйАдрес) Тогда
				
				АдресПрибытия = Строка(Объект.ЛицевойСчет.Здание.ПочтовыйАдрес) + ?(ЗначениеЗаполнено(Объект.ЛицевойСчет.Квартира), ", кв. " + Объект.ЛицевойСчет.Квартира,"");
				
			Иначе
				ДлинаАдреса_1 = 31;
				ОбновитьНастройкиЖКХ();                                                  
				Квартира = ?(ЗначениеЗаполнено(Объект.ЛицевойСчет.Квартира),", "+ мПрефиксКвартира + Объект.ЛицевойСчет.Квартира,"");		
				Адрес = "" + мПрефиксУлица + " " + Объект.ЛицевойСчет.УлицаЛицевогоСчета + ", " + мПрефиксДом + Объект.ЛицевойСчет.Здание +?(ЗначениеЗаполнено(Объект.ЛицевойСчет.Здание.Корпус),", "+ мПрефиксКорпус + Объект.ЛицевойСчет.Здание.Корпус, "") 
				+ Строка(Квартира);
				АдресПрибытия = Адрес;

				бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Полный адрес по ЛС " + Объект.ЛицевойСчет + " можно получить, заполнив почтовый адрес у здания");
				
			КонецЕсли;
			
		КонецЕсли; 
		
		Если  ЗначениеЗаполнено(АдресПрибытия) Тогда
			
			АдресПрибытия_1 = АдресПрибытия;
			бит_ОбщегоНазначенияКлиентСервер.РазбитьСтроку(32, АдресПрибытия_1, АдресПрибытия_2);
			//бит_ОбщегоНазначения.РазделитьТекстНаДвеСтроки(АдресПрибытия, ДлинаАдреса_1, АдресПрибытия_1 ,АдресПрибытия_2  );

		Иначе

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Для вывода в бланк адреса заполните адрес прописки в справочнике ""Проживающие"" и/или почтовый адрес в справочнике ""Список зданий""");
			
		КонецЕсли;
		
		ШапкаОбласть.Параметры.АдресПрибытия_1 =  АдресПрибытия_1;
		ШапкаОбласть.Параметры.АдресПрибытия_2 =  АдресПрибытия_2;
		
	КонецЕсли; 
	
	Если Флаг Тогда
		Если ЗначениеЗаполнено(ЭтаФорма.мКолЧел) Тогда
			ШапкаОбласть.Параметры.КолЧел          = ЭтаФорма.мКолЧел ;
		Иначе
			ШапкаОбласть.Параметры.КолЧел          = Выборка.Количество();
		КонецЕсли; 
		
	Иначе	
		Если ЭтаФорма.мКолЧел <> Неопределено Тогда
			Если ЭтаФорма.мКолЧел > 0 Тогда
				ШапкаОбласть.Параметры.Собственник = "Собственник - ";
				Если ЭтаФорма.мКолЧел = 1 Тогда
					ШапкаОбласть.Параметры.Регистрированные = "зарегистрирован "+ Строка(ЭтаФорма.мКолЧел) + " чел.";
				Иначе
					ШапкаОбласть.Параметры.Регистрированные = "зарегистрировано "+ Строка(ЭтаФорма.мКолЧел) + " чел.";
				КонецЕсли; 
			Иначе  	
				ШапкаОбласть.Параметры.Регистрированные = "никто не зарегистрирован.";
				ШапкаОбласть.Параметры.Собственник = "Собственник без регистрации - ";
				
			КонецЕсли;
		Иначе

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Справка выведена не полностью! Переформируйте табличную часть документа кнопкой ""Заполнить"".");
			
		КонецЕсли;
	КонецЕсли;
	
	ТабДокумент.Вывести(ШапкаОбласть);
	
	Если Флаг Тогда
		Если Выборка.Количество()>0  Тогда
			
			ШапкаСтрокОбласть  = Макет.ПолучитьОбласть("ШапкаСтрок");
			ТабДокумент.Вывести(ШапкаСтрокОбласть);
			
			ДанныеСтрока = Макет.ПолучитьОбласть("ДанныеСтрока");
			Пока Выборка.Следующий()Цикл
				ДанныеСтрока.Параметры.Заполнить(Выборка);
				ТабДокумент.Вывести(ДанныеСтрока);
			КонецЦикла;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Подвал = Макет.ПолучитьОбласть("Подвал");
	Подвал.Параметры.ДляПредъявления  = Шапка.ДляПредъявления;
	
	ОтветственныеЛица = бит_ОбщегоНазначения.бит_ОтветственныеЛица(Объект.Организация, Объект.Дата);
	Руководитель = ОтветственныеЛица.Руководитель;
	Паспортист   = ОтветственныеЛица.Паспортист;
	Если ЗначениеЗаполнено(Руководитель) Тогда
		//РуководительФИО = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(Руководитель,Объект.Дата,Ложь,Ложь); 
		РуководительФИО = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Руководитель, "ФИО");
		РуководительФИО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(РуководительФИО); 
	КонецЕсли;
	Если ЗначениеЗаполнено(Паспортист) Тогда
		//ПаспортистФИО = бит_ПаспортныйСтолСервер.ПолучитьФИОФизЛица(Паспортист,Объект.Дата,Ложь,Ложь); 
		ПаспортистФИО 	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Паспортист, "ФИО");
		ПаспортистФИО = ФизическиеЛицаКлиентСервер.ФамилияИнициалы(ПаспортистФИО) 
	КонецЕсли;
	
	Если Флаг Тогда
		Подвал.Параметры.Руководитель     = ?(ЗначениеЗаполнено(РуководительФИО),"/ " + РуководительФИО + " /","");
		Подвал.Параметры.ДатаФормирования = Объект.Дата;
	КонецЕсли;
	Подвал.Параметры.Паспортист       = ?(ЗначениеЗаполнено(ПаспортистФИО),"/ " + ПаспортистФИО + " /","");
	
	ТабДокумент.Вывести(Подвал);
	
	Возврат ТабДокумент;
	
КонецФункции

&НаСервере
Процедура ОбновитьНастройкиЖКХ()
	
	ПараметрыЖКХ = Новый Структура;
	ПараметрыЖКХ.Вставить("ПрефиксУлица"                       , "");
	ПараметрыЖКХ.Вставить("ПрефиксДом"                         , "");
	ПараметрыЖКХ.Вставить("ПрефиксКорпус"                      , "");
	ПараметрыЖКХ.Вставить("ПрефиксКвартира"                    , "");
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(ТекущаяДата(), Объект.Организация, ПараметрыЖКХ);
	
	мПрефиксУлица                        = ПараметрыЖКХ.ПрефиксУлица;
	мПрефиксДом                          = ПараметрыЖКХ.ПрефиксДом;
	мПрефиксКорпус                       = ПараметрыЖКХ.ПрефиксКорпус;
	мПрефиксКвартира                     = ПараметрыЖКХ.ПрефиксКвартира;
	
КонецПроцедуры

// Процедура заполняет кэш значений, необходимый при работе на клиенте.
//
// Параметры:
//  КэшированныеЗначения - Структура.
//
&НаСервере
Процедура ЗаполнитьКэшЗначений(КэшированныеЗначения)
	
	Документ       = Метаданные.Документы.бит_СправкаОСоставеСемьи;
	ПравоИзменения = ПравоДоступа("Изменение", Документ);
	
	КэшированныеЗначения = Новый Структура;
	
	// Запишем параметр для формирования заголовка.
	КэшированныеЗначения.Вставить("ПредставлениеОбъекта", Объект.Ссылка.Метаданные().ПредставлениеОбъекта);
	КэшированныеЗначения.Вставить("ПравоИзменения"      , ПравоИзменения);
	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьТабличнуюЧасть()
	
	Объект.ФизическиеЛица.Очистить();
	
	мСписокФизЛиц = ПолучитьИзВременногоХранилища(АдресВоВременномХранилище);
	
	СписокЗначенийФизЛиц = мСписокФизЛиц.Скопировать();
	Если  СписокЗначенийФизЛиц.Количество()>0 И ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		
		// НомерИндекса = СписокЗначенийФизЛиц.Индекс(СписокЗначенийФизЛиц.НайтиПоЗначению(Объект.ФизЛицо));.
		Если СписокЗначенийФизЛиц.Найти(Объект.ФизЛицо,"ФизическоеЛицо")<> Неопределено Тогда
			
			НомерИндекса = СписокЗначенийФизЛиц.Индекс(СписокЗначенийФизЛиц.Найти(Объект.ФизЛицо,"ФизическоеЛицо"));
			СписокЗначенийФизЛиц.Удалить(НомерИндекса);
			
		КонецЕсли;
		
	КонецЕсли;
	Если СписокЗначенийФизЛиц.Количество()>0 Тогда
		
		ЗагрузкаТабЧасти(СписокЗначенийФизЛиц, Объект.Дата);
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		
		Если ТипЗнч(ВыбранноеЗначение) = Тип("СправочникСсылка.бит_Проживающие") Тогда
			
			ЗаполнитьТабличнуюЧастьНаСервере(ВыбранноеЗначение);
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТабличнуюЧасть()
	
	ТабЗначений =  Объект.ФизическиеЛица.Выгрузить();	
	Возврат ТабЗначений;
	
КонецФункции

&НаСервере
Процедура ЗагрузкаТабЧасти(СписокЗначенийФизЛиц, Дата = Неопределено)
	
	Если ЗначениеЗаполнено(Дата) Тогда
		
		мТаблицаФизЛиц.Загрузить(ФормированиеДанныхТабЧасти(СписокЗначенийФизЛиц, Дата));
		Объект.ФизическиеЛица.Загрузить(мТаблицаФизЛиц.Выгрузить());
		
	КонецЕсли; 
	
КонецПроцедуры	

&НаСервере
// Функция формирует список физ лиц, когда-либо прописанных на ЛС (ВесьСписок = Ложь).
// Либо тех, кто прописан на момент даты документа (ВесьСписок = Истина).
Функция  СписокПроживающих(ЛС = Неопределено, ВесьСписок = Ложь)  
	
	Если ВесьСписок Тогда
		
		ТекстЗапроса = 
		"ВЫБРАТЬ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо,
		|	бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних";
		
	Иначе
		
		//ТекстЗапроса =
		//"ВЫБРАТЬ
		//|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо
		//|ИЗ
		//|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Дата, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
		//|ГДЕ
		//|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Дата
		//|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))";
		//
		ТекстЗапроса =
		"ВЫБРАТЬ
		|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
		|			&Дата,
		|			ЛицевойСчет = &ЛицевойСчет
		|				И СтатусПроживания <> ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.НеПроживает)) КАК бит_ПроживающиеПоЛССрезПоследних";
		
		
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапроса;
	
	Если ЗначениеЗаполнено(Объект.Дата) Тогда
		
		Момент = Объект.Дата;
		
	Иначе
		
		Момент = ТекущаяДата();
		
	КонецЕсли;
	
	Запрос.УстановитьПараметр("Дата"       , КонецДня(Момент));
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛС);
	
	СписокФизЛиц = Запрос.Выполнить().Выгрузить();
	
	ЭтаФорма.Элементы.ФизЛицо.СписокВыбора.ЗагрузитьЗначения(СписокФизЛиц.ВыгрузитьКолонку("ФизическоеЛицо"));
	
	АдресВоВременномХранилище = ПоместитьВоВременноеХранилище(СписокФизЛиц);
	мСписокФизЛиц = СписокФизЛиц;
	
	НайденнаяСтрока = СписокФизЛиц.Найти(Объект.ФизЛицо, "ФизическоеЛицо");
	
	Структура = Новый Структура;
	
	Если СписокФизЛиц = Неопределено Тогда
		Структура.Вставить("КоличествоФизЛиц",0);
	Иначе
		Структура.Вставить("КоличествоФизЛиц",СписокФизЛиц.Количество());
	КонецЕсли;
	
	Если НайденнаяСтрока = Неопределено Тогда
		Структура.Вставить("НайденнаяСтрока",Ложь);
		Структура.Вставить("ВладелецКвартиры",Неопределено);	
	Иначе
		Структура.Вставить("НайденнаяСтрока",Истина);
		Попытка
			Структура.Вставить("ВладелецКвартиры",НайденнаяСтрока.ВладелецКвартиры);
		Исключение
			Структура.Вставить("ВладелецКвартиры",Неопределено);
		КонецПопытки;
		
	КонецЕсли;
	
	Возврат Структура;
	
КонецФункции

&НаСервере
// Процедура формирования данных физ лиц.
// Для заполнения таб части документа.
// Параметры:
// СписокЗначенийФизЛиц - <список значений, таблица значений> - список физлиц.
//
Функция ФормированиеДанныхТабЧасти(СписокЗначенийФизЛиц, Момент)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизическоеЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК РодственныеОтношения,
	|	бит_ПроживающиеПоЛССрезПоследних.ОткудаПрибыл,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаПрибытия,
	|	бит_ПроживающиеПоЛССрезПоследних.КудаВыписан,
	|	ВЫБОР
	|		КОГДА бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|			ТОГДА ЛОЖЬ
	|		ИНАЧЕ ИСТИНА
	|	КОНЕЦ КАК Метка,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПравоНаЛьготы КАК ПравоНаЛьготы,
	|	ВЫБОР
	|		КОГДА бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &Момент
	|				ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1)
	|			ТОГДА ИСТИНА
	|		ИНАЧЕ ЛОЖЬ
	|	КОНЕЦ КАК ПрописанНаМомент
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ФизЛицо В (&ФизЛицо)
	|				И ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|
	|УПОРЯДОЧИТЬ ПО
	|	Метка";
	
	Запрос.УстановитьПараметр("Момент"		, Момент);
	Запрос.УстановитьПараметр("ФизЛицо"		, СписокЗначенийФизЛиц);
	Запрос.УстановитьПараметр("ЛицевойСчет"	, Объект.ЛицевойСчет);
	
	Таблица = Запрос.Выполнить().Выгрузить();
	
	Возврат Таблица;
	
КонецФункции

&НаСервере
Функция ЗаписатьДокументНаСервере()
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, ПолучитьТипОбъекта(Объект.Ссылка));
	
	Попытка
		
		ДокументОбъект.Записать();
		
		Записано = Истина;
		
	Исключение
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ОписаниеОшибки());
		
		Записано = Ложь;
		
	КонецПопытки;
	
	Если Записано Тогда
		
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
		
	КонецЕсли;
	
	Возврат Записано;
	
КонецФункции

// Функция получает тип объекта.
//
// Параметры:
//  ОбъектСсылка - ДокументСсылка.
//
// Возвращаемое значение:
//  ТипОбъекта - Тип.
// 
&НаСервереБезКонтекста 
Функция ПолучитьТипОбъекта(ОбъектСсылка)
	
	ИмяОбъекта = ОбъектСсылка.Метаданные().Имя;
	ТипОбъекта = Тип("ДокументОбъект." + ИмяОбъекта);
	
	Возврат ТипОбъекта;
	
КонецФункции

&НаСервере
Процедура ЗаполнитьТабличнуюЧастьНаСервере(Знач ВыбранноеЗначение)
	
	ВременаяТабФизЛиц = ПолучитьТабличнуюЧасть();
	
	СтрокаТабличнойЧасти = ВременаяТабФизЛиц.Найти(ВыбранноеЗначение, "ФизическоеЛицо");
	
	Если СтрокаТабличнойЧасти = Неопределено Тогда
		
		Если мТаблицаФизЛиц.Количество() > 0 Тогда	
			
			Отбор = Новый Структура;
			
			Отбор.Вставить("ФизическоеЛицо", ВыбранноеЗначение);
			
			НайденныйМассив = мТаблицаФизЛиц.НайтиСтроки(Отбор);
			
			Если НайденныйМассив.Количество() > 0 Тогда
				
				НоваяСтрока = Объект.ФизическиеЛица.Добавить();
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, НайденныйМассив[0]);
				
			Иначе
				
				НоваяСтрока = Объект.ФизическиеЛица.Добавить();
				
				НоваяСтрока.ФизическоеЛицо = ВыбранноеЗначение;
				НоваяСтрока.ДатаРождения   = ВыбранноеЗначение.ДатаРождения;
				
			КонецЕсли; 
			
		Иначе
			
			НоваяСтрока = Объект.ФизическиеЛица.Добавить();
			
			НоваяСтрока.ФизическоеЛицо = ВыбранноеЗначение;
			НоваяСтрока.ДатаРождения   = ВыбранноеЗначение.ДатаРождения;
			
		КонецЕсли;	
		
	КонецЕсли;
	
КонецПроцедуры

//Добаляем новый макет справки
&НаКлиенте
Процедура СоздатьСправкуОСоставеСемьиБит(Команда)
	
	Если Объект.Ссылка = ПредопределенноеЗначение("Документ.бит_СправкаОСоставеСемьи.ПустаяСсылка") Или Модифицированность Тогда
		
		Проведен    = Объект.Проведен;
		СтрПроведен = ?(Проведен, " и провести","");
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СоздатьСправкуОСоставеСемьиЗавершение1Бит", ЭтотОбъект), "Документ изменен. Для печати его необходимо записать "+ СтрПроведен +".
		|Записать" + СтрПроведен + "?",
		РежимДиалогаВопрос.ОКОтмена, , 
		КодВозвратаДиалога.Отмена,
		"Документ изменен");
		
	Иначе
		
		Результат = Сформировать("СправкаОСоставеСемьиБит");
		
		АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
		
		бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
		,"бит_СправкаОСоставеСемьи"
		,"СправкаОСоставеСемьиБит"
		,"Справка о составе семьи"
		
		,АдресТабличногоДокументаВоВременномХранилище
		
		,Объект.Ссылка);
		
	КонецЕсли;
КонецПроцедуры

&НаСервере
// Функция формирует табличный документ с печатной формой сличительной ведомости.
//
// Параметры:
//  Нет.
//
// Возвращаемое значение:
//  Табличный документ - печатная форма сличительной ведомости.
//
Функция ПечатьСправкаОСоставеСемьиБит(Флаг = Истина, ЕстьТабличнаяЧасть = Истина) 
	
	Запрос = Новый Запрос();
	Запрос.УстановитьПараметр("ТекущийДокумент"	, Объект.Ссылка);
	Запрос.УстановитьПараметр("Момент" 			,Объект.Дата);
	Запрос.УстановитьПараметр("ЛицевойСчет" 	,Объект.ЛицевойСчет);
	Запрос.Текст =
	"ВЫБРАТЬ
	|	СправкаОСоставеСемьи.Номер,
	|	СправкаОСоставеСемьи.Дата,
	|	СправкаОСоставеСемьи.Организация,
	|	СправкаОСоставеСемьи.ФизЛицо,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество,
	|	ФИОФизЛицСрезПоследних.Фамилия + "" "" + ФИОФизЛицСрезПоследних.Имя + "" "" + ФИОФизЛицСрезПоследних.Отчество КАК ФИО,
	|	СправкаОСоставеСемьи.ДляПредъявления,
	|	бит_ПроживающиеПоЛССрезПоследних.ДатаРегистрации
	|ИЗ
	|	Документ.бит_СправкаОСоставеСемьи КАК СправкаОСоставеСемьи
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК ФИОФизЛицСрезПоследних
	|		ПО СправкаОСоставеСемьи.ФизЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&Момент, ЛицевойСчет = &ЛицевойСчет) КАК бит_ПроживающиеПоЛССрезПоследних
	|		ПО СправкаОСоставеСемьи.ФизЛицо = бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
	|ГДЕ
	|	СправкаОСоставеСемьи.Ссылка = &ТекущийДокумент";
	
	Шапка = Запрос.Выполнить().Выбрать();
	Шапка.Следующий();
	
	Запрос.УстановитьПараметр("Ссылка" ,Объект.Ссылка);
	Запрос.Текст =
	"ВЫБРАТЬ                              
	|	бит_СправкаОСоставеСемьиФизическиеЛица.ФизическоеЛицо,
	|	бит_СправкаОСоставеСемьиФизическиеЛица.РодственныеОтношения КАК РодственнаяСвязь,
	|	бит_СправкаОСоставеСемьиФизическиеЛица.ДатаРождения,
	|	ФИОФизЛицСрезПоследних.Фамилия,
	|	ФИОФизЛицСрезПоследних.Имя,
	|	ФИОФизЛицСрезПоследних.Отчество,
	|	ВЫБОР
	|		КОГДА (НЕ ФИОФизЛицСрезПоследних.Фамилия ЕСТЬ NULL )
	|			ТОГДА ФИОФизЛицСрезПоследних.Фамилия + "" "" + ФИОФизЛицСрезПоследних.Имя + "" "" + ФИОФизЛицСрезПоследних.Отчество
	|		ИНАЧЕ бит_СправкаОСоставеСемьиФизическиеЛица.ФизическоеЛицо
	|	КОНЕЦ КАК ФИО,
	|	бит_СправкаОСоставеСемьиФизическиеЛица.НомерСтроки
	|ИЗ
	|	Документ.бит_СправкаОСоставеСемьи.ФизическиеЛица КАК бит_СправкаОСоставеСемьиФизическиеЛица
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&Момент, ) КАК ФИОФизЛицСрезПоследних
	|		ПО бит_СправкаОСоставеСемьиФизическиеЛица.ФизическоеЛицо = ФИОФизЛицСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&Момент, ) КАК ПаспортныеДанныеФизЛицСрезПоследних
	|		ПО бит_СправкаОСоставеСемьиФизическиеЛица.ФизическоеЛицо = ПаспортныеДанныеФизЛицСрезПоследних.ФизЛицо
	|ГДЕ
	|	бит_СправкаОСоставеСемьиФизическиеЛица.Ссылка = &Ссылка";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	
	ТабДокумент   = Новый ТабличныйДокумент();
	
	Если Флаг Тогда
		ТабДокумент.КлючПараметровПечати = "СправкаОСоставеСемьи";
		Если ЕстьТабличнаяЧасть Тогда
			Макет         = Документы.бит_СправкаОСоставеСемьи.ПолучитьМакет("СправкаОСоставеСемьиБИТ");
		Иначе
			Макет         = Документы.бит_СправкаОСоставеСемьи.ПолучитьМакет("СправкаОСоставеСемьи");
		КонецЕсли;
	Иначе
		ТабДокумент.КлючПараметровПечати = "СправкаОбОтсутствииПрописанных";
		Макет         = Документы.бит_СправкаОСоставеСемьи.ПолучитьМакет("СправкаОбОтсутствииПрописанных");
	КонецЕсли;
	
	ШапкаОбласть  = Макет.ПолучитьОбласть("Шапка");
	
	ШапкаОбласть.Параметры.НомерСправки = Шапка.Номер;
	ШапкаОбласть.Параметры.ДатаВыдачи   = Формат(Шапка.Дата,"ДФ='dd.MM.yyyy ""г.""'");
	ШапкаОбласть.Параметры.НомерЛС   	= Объект.ЛицевойСчет;
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЛицевыеСчета.Здание.Участок.ТелефоныПаспортиста КАК ЗданиеУчастокТелефоныПаспортиста,
		|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК лб_ПредставлениеКвартиры
		|ИЗ
		|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
		|		ПО бит_ЛицевыеСчета.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
		|ГДЕ
		|	бит_ЛицевыеСчета.Ссылка = &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", Объект.ЛицевойСчет);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		ШапкаОбласть.Параметры.ТелефонПС   	= ВыборкаДетальныеЗаписи.ЗданиеУчастокТелефоныПаспортиста;
	КонецЕсли; 
	
	СтруктураДанных = БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(Шапка.Организация, Шапка.Дата);
	
	
	ШапкаОбласть.Параметры.Организация       = СтруктураДанных.НаименованиеДляПечатныхФорм;
	
	Если Флаг Тогда
		ШапкаОбласть.Параметры.ОрганизацияИННКПП = Строка(СтруктураДанных.ИНН)+"\"+Строка(СтруктураДанных.КПП);
		//ШапкаОбласть.Параметры.Факс              = СтруктураДанных.Телефоны;
		ШапкаОбласть.Параметры.РС                = "№"+Строка(СтруктураДанных.НомерСчета)+", "+Строка(СтруктураДанных.Банк)+"\"+Строка(СтруктураДанных.КоррСчет)+"\"+Строка(СтруктураДанных.БИК);
	КонецЕсли;
	
