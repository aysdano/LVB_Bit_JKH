	ПостроительЗапроса.ВыбранныеПоля.Добавить("СуммаОплаты");
	
	
	// ФОРМИРОВАНИЕ ТАБЛИЦЫ Перерасчет.	
	ТЗПерерасчетЛьгот = СформироватьТаблицуПерерасчетЛьготНаСервере();
	
	// ФОРМИРОВАНИЕ ТАБЛИЦЫ Разовые.	
	ТЗРазовые = СформироватьТаблицуРазовыеНаСервере();
	
	// ФОРМИРОВАНИЕ ТАБЛИЦЫ ТАРИФОВ.	
	ТаблицаТарифов = СформироватьТаблицуТарифовНаСервере();
	
	// ФОРМИРОВАНИЕ ТАБЛИЦЫ ЛЬГОТНИКОВ.
	ТаблицаЛьготников = СформироватьТаблицуЛьготниковНаСервере();
	
	// ФОРМИРОВАНИЕ ТАБЛИЦЫ ЛЬГОТНИКОВ.
	ТаблицаЛьгот = СформироватьТаблицуЛьготНаСервере();
	
	// ФОРМИРОВАНИЕ ТАБЛИЦЫ Норм.
	ТЗНорм = СформироватьТаблицуНормНаСервере();
	
	// ВЫПОЛНЕНИЕ ЗАПРОСА.	
	ПостроительЗапроса.Выполнить();
	
	ПостроительЗапросаТаблицаЗначений = ПостроительЗапроса.Результат.Выгрузить();
	
	ПостроительЗапросаТаблицаЗначений.Свернуть("Услуга,ЛицевойСчет","Разовые");
	
	Если ПостроительЗапроса.Результат.Пустой() Тогда

		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("За данный периода - данные не найдены.");
		
		Возврат;
	КонецЕсли; 
	
	ВыборкаОбщ = ПостроительЗапроса.Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	НоваяСтрокаУслуги = Ложь;
	ПредыдущаяСтрокаЛС = "";
	ПредыдущийЛС = ПредопределенноеЗначение("Справочник.бит_ЛицевыеСчета.ПустаяСсылка");
	КолЛьготников = 0;
	КоличествоУслуг = 0;	
	ЕстьЛьготник = Ложь;
	НомерНосителяКатегорииЛьгот = 0;
	КоличествоСтрокПерерасчетов =0;
	КоличествоСтрокЛьгот = 0;
	
	СтруктураДанныхДляЗаголовка = ПолучитьДанныеДляСтрокиЗаголовка();
	
	Дата = СтруктураДанныхДляЗаголовка.Дата;
	Пользователь = СтруктураДанныхДляЗаголовка.Пользователь;
	Телефон = СтруктураДанныхДляЗаголовка.Телефон;
	МесяцГодНачислений = СтруктураДанныхДляЗаголовка.МесяцГодНачислений;
	КоличествоЛС = СтруктураДанныхДляЗаголовка.КоличествоЛС;
	ВерсияФормата = СтруктураДанныхДляЗаголовка.ВерсияФормата;
	
	Текст.ДобавитьСтроку("1" + сг_СимволРазделения + "Параметры поставщика" + сг_СимволРазделения 
	+ Объект.Организация + сг_СимволРазделения + Объект.ПодразделениеОрганизации
	+ сг_СимволРазделения + Объект.НомерФайла + сг_СимволРазделения
	+ Дата + сг_СимволРазделения + Телефон + сг_СимволРазделения + Пользователь
	+ сг_СимволРазделения + МесяцГодНачислений + сг_СимволРазделения + КоличествоЛС
	+ сг_СимволРазделения + ВерсияФормата + сг_СимволРазделения);
	
	// НАЧАЛО ЦИКЛА.	
	Пока ВыборкаОбщ.Следующий() Цикл
		
		Выборка = ВыборкаОбщ.Выбрать();
		
		Итого = 0;
		
		Пока Выборка.Следующий() Цикл
			
			Если Выборка.Лицевойсчет = ПредыдущийЛС Тогда
				
				НоваяСтрокаУслуги = Истина;

			Иначе
				
				НоваяСтрокаУслуги = Ложь;
				КолЛьготников = 0;
				НомерНосителяКатегорииЛьгот =0;
				ЕстьЛьготник = Ложь;
				
			КонецЕсли;
			
			НоваяСтрока = "";
			
			СимволРазделения = сг_СимволРазделения;
			
			Если НЕ Выборка.ЛицевойСчет = ПредыдущийЛС и НЕ НоваяСтрокаУслуги Тогда
				// ФОРМИРОВАНИЕ СТРОКИ ДОМОХОЗЯЙСТВА.
				НоваяСтрока = СформироватьСтрокуДомохозяйстваНаСервере(Выборка,НоваяСтрока,СимволРазделения,ТаблицаЛьготников,КолЛьготников,ПостроительЗапросаТаблицаЗначений,КоличествоУслуг,ПредыдущийЛС);
				
				// ДОБАВЛЕНИЕ СТРОКИ ДОМОХОЗЯЙСТВО В ТЕКСТОВЫЙ ФАЙЛ.				
				Текст.ДобавитьСтроку(НоваяСтрока);
				
				// ФОРМИРОВАНИЕ СТРОК ЛЬГОТНИКА И ДОБАВЛЕНИЕ В ТЕКСТОВЫЙ ФАЙЛ.
				Текст = СформироватьСтрокуЛьготникаНаСервере(Текст,Выборка,НоваяСтрока,СимволРазделения,ТаблицаЛьготников,НомерНосителяКатегорииЛьгот);
				
				// ФОРМИРОВАНИЕ СТРОКИ УСЛУГИ.
				Текст = СформироватьСтрокуУслугиНаСервере(Текст,Выборка,СимволРазделения,ТаблицаТарифов,ТаблицаЛьготников,КолЛьготников,КоличествоУслуг,ТаблицаЛьгот,ТЗПерерасчетЛьгот,ТЗРазовые,КоличествоСтрокПерерасчетов,ПредыдущийЛС,КоличествоСтрокЛьгот);
				
				КоличествоУслуг = 0;
				
				ПредыдущаяСтрокаЛС = НоваяСтрока;
				
				НоваяСтрокаУслуги = Ложь;
				
				ПредыдущийЛС = Выборка.Лицевойсчет;
				
			Иначе
				
				// ФОРМИРОВАНИЕ СТРОКИ УСЛУГИ.
				Текст = СформироватьСтрокуУслугиНаСервере(Текст,Выборка,СимволРазделения,ТаблицаТарифов,ТаблицаЛьготников,КолЛьготников,КоличествоУслуг,ТаблицаЛьгот,ТЗПерерасчетЛьгот,ТЗРазовые,КоличествоСтрокПерерасчетов,ПредыдущийЛС,КоличествоСтрокЛьгот);
				
				ПредыдущийЛС = Выборка.Лицевойсчет;
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция СформироватьТаблицуНормНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияОНормативахНачисленийЗакрытогоПериодаСрезПоследних.Период,
	|	бит_СведенияОНормативахНачисленийЗакрытогоПериодаСрезПоследних.ЛицевойСчет,
	|	бит_СведенияОНормативахНачисленийЗакрытогоПериодаСрезПоследних.Услуга,
	|	бит_СведенияОНормативахНачисленийЗакрытогоПериодаСрезПоследних.Норма,
	|	бит_СведенияОНормативахНачисленийЗакрытогоПериодаСрезПоследних.СверхНорма,
	|	бит_СведенияОНормативахНачисленийЗакрытогоПериодаСрезПоследних.Регистратор
	|ИЗ
	|	РегистрСведений.бит_СведенияОНормативахНачисленийЗакрытогоПериода.СрезПоследних КАК бит_СведенияОНормативахНачисленийЗакрытогоПериодаСрезПоследних";
	
	Результат = Запрос.Выполнить();
	
	ТЗНорм = Результат.Выгрузить();
	
	ТЗНорм.Сортировать("Период Возр");
	
	Возврат ТЗНорм;
	
КонецФункции

&НаСервере
Функция СформироватьТаблицуПерерасчетЛьготНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХ.Регистратор,
	|	бит_НачисленияПоУслугамЖКХ.УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХ.Сумма,
	|	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХ.Регистратор.ВидОперации,
	|	бит_НачисленияПоУслугамЖКХ.ВидДвижения
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ КАК бит_НачисленияПоУслугамЖКХ
	|ГДЕ
	|	(бит_НачисленияПоУслугамЖКХ.Регистратор.ВидОперации = &ПерерасчетЛьгот
	|			ИЛИ бит_НачисленияПоУслугамЖКХ.Регистратор.ВидОперации = &ПерерасчетЛьготПоНедоставкиУслуг
	|			ИЛИ бит_НачисленияПоУслугамЖКХ.Регистратор.ВидОперации = &ПерерасчетЛьготПоОтсутствующим)";
	
	Запрос.УстановитьПараметр("ПерерасчетЛьгот", ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьгот"));
	Запрос.УстановитьПараметр("ПерерасчетЛьготПоНедоставкиУслуг", ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьготПоНедоставкиУслуг"));
	Запрос.УстановитьПараметр("ПерерасчетЛьготПоОтсутствующим", ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетЛьготПоОтсутствующим"));
	
	Результат = Запрос.Выполнить();
	
	ТЗПерерасчетЛьгот = Запрос.Выполнить().выгрузить();
	ТЗПерерасчетЛьгот.Сортировать("ЛицевойСчет Возр");
	
	Возврат ТЗПерерасчетЛьгот;
	
КонецФункции	

&НаСервере
Функция СформироватьТаблицуРазовыеНаСервере()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХ.Регистратор,
	|	бит_НачисленияПоУслугамЖКХ.УслугаЖКХ,
	|	бит_НачисленияПоУслугамЖКХ.Сумма,
	|	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет,
	|	бит_НачисленияПоУслугамЖКХ.Регистратор.ВидОперации,
	|	бит_НачисленияПоУслугамЖКХ.ВидДвижения,
	|	бит_НачисленияПоУслугамЖКХ.Регистратор.Представление,
	|	ВЫБОР
	|		КОГДА бит_НачисленияПоУслугамЖКХ.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|			ТОГДА бит_НачисленияПоУслугамЖКХ.Сумма
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК СуммаРазовых,
	|	бит_НачисленияПоУслугамЖКХ.Период
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ КАК бит_НачисленияПоУслугамЖКХ
	|ГДЕ
	|	бит_НачисленияПоУслугамЖКХ.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ";	
	
	Результат = Запрос.Выполнить();
	
	ТЗРазовые = Запрос.Выполнить().выгрузить();
	ТЗРазовые.Сортировать("Период Возр");
	
	Возврат ТЗРазовые;
	
КонецФункции	

