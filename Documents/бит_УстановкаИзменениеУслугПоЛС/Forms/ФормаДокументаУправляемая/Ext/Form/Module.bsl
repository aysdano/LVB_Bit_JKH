&НаСервереБезКонтекста
Функция ПроверитьУслугуНаЗдании(Знач Дата, Знач Здание, Знач Услуга)
	
	Запрос = Новый Запрос;
	
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_ШаблоныУслугСрезПоследних.Услуга
	|ИЗ
	|	РегистрСведений.бит_ШаблоныУслуг.СрезПоследних(
	|			&Период,
	|			Здание = &Здание
	|				И Услуга = &Услуга) КАК бит_ШаблоныУслугСрезПоследних
	|ГДЕ
	|	бит_ШаблоныУслугСрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Запрос.УстановитьПараметр("Период", Дата);
	Запрос.УстановитьПараметр("Здание", Здание);
	Запрос.УстановитьПараметр("Услуга", Услуга);
	
	Возврат Запрос.Выполнить().Пустой();
	
КонецФункции // ()

