	|	СУММА(ФактОтУменьшения),
	|	СУММА(Разовые),
	|	СУММА(НачисленоНормаОтрицательная)
	|ПО
	|	Услуга,
	|	Счетчик";
	
	Результат = Запрос.Выполнить();
	ВыборкаУС = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	ТаблицаРасчетов.Индексы.Добавить("ЛицевойСчет,Услуга");
	
	Пока ВыборкаУС.Следующий() Цикл
		
		ВыборкаСч = ВыборкаУС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		МассивИсключений = Новый Массив;
		
		Пока ВыборкаСч.Следующий() Цикл
			
			СуммаПоСчетчику = ВыборкаСч.СуммаПоСчетчику; 
			
			Если СуммаПоСчетчику = 0 Тогда
				Продолжить;
			КонецЕсли; 
			
			СуммаИтог = 0;
			СуммаНО   = 0;
			ОбъемИтог = 0;
			
			// Индекс строки содержащей максимальную сумму используется для определения погрешнисти.
			Индкес      = Неопределено;
			
			ОбщийФакт              = ВыборкаСЧ.Факт;
			ОбщийФактОтУменьшения  = ВыборкаСЧ.ФактОтУменьшения;
			ОбщиеНачисления        = ВыборкаСЧ.СуммаНачислений;
			// БИТ_ЖКХ_01082013_начало_изменения
			ОбщийФактСУчетомСтавки = ВыборкаСЧ.ФактСУчетомСтавки;
			// БИТ_ЖКХ_01082013_окончание_изменения
			
			ИспользоватьПравилоУменьшения = ВыборкаСч.ИспользоватьПравилоУменьшения;
			
			// БИТ_ЖКХ 26.06.2015{{
			// СЧНачисленоНорма       = ВыборкаСч.НачисленоНорма; 
			СЧНачисленоНорма       = ВыборкаСч.НачисленоНорма - ВыборкаСч.НачисленоНормаОтрицательная; 
			// БИТ_ЖКХ 26.06.2015}}
			
			СЧНачисленоСчетчик     = ВыборкаСч.НачисленоСчетчик;
			СЧНачисленоУменьшения  = ВыборкаСч.НачисленияПоСпособуУменьшения;
			
			Выборка = ВыборкаСч.Выбрать();
			
			КоличествоЛС = Выборка.Количество();
			
			НачисленоНорма   = 0;
			НачисленоСчетчик = 0;
			Остаток          = 0;
			
			Пока Выборка.Следующий() Цикл
				
				Если МассивИсключений.Найти(Выборка.ЛицевойСчет) = Неопределено Тогда
					
					МассивИсключений.Добавить(Выборка.ЛицевойСчет);
					
					НачисленоНорма   = НачисленоНорма   + Выборка.НачисленоНорма;
					НачисленоСчетчик = НачисленоСчетчик + Выборка.НачисленоСчетчик;
					
				КонецЕсли; 
				
			КонецЦикла;
			
			Остаток = СуммаПоСчетчику - НачисленоНорма - НачисленоСчетчик;
			
			Выборка.Сбросить();
			ЛСОбработано = 0;
			
			Пока Выборка.Следующий() Цикл
				
				ЛСОбработано     = ЛСОбработано + 1;
				
				// Набор показателей по лс.
				СуммаНорматив     = Выборка.НачисленоНорма;
				СуммаСчетчик      = Выборка.НачисленоСчетчик;
				СуммаНачислений   = Выборка.СуммаНачислений;
				СуммаУменьшения   = Выборка.НачисленияПоСпособуУменьшения;
				Факт              = Выборка.Факт;
				ФактОтУменьшения  = Выборка.ФактОтУменьшения;
				// БИТ_ЖКХ_01082013_начало_изменения
				ФактСУчетомСтавки = Выборка.ФактСУчетомСтавки;
				// БИТ_ЖКХ_01082013_окончание_изменения
				
				Показатель      = 0;
				ОбщийПоказатель = 0;
				
				СпособРаспределения =  Выборка.СпособРаспределения;
				
				Если ИспользоватьПравилоУменьшения И Остаток < 0 Тогда
					
					Если ЗначениеЗаполнено(Выборка.СпособРаспределенияУменьшения) Тогда
						СпособРаспределения = Выборка.СпособРаспределенияУменьшения;
					Иначе
						СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаНачисления;
					КонецЕсли; 
					
				КонецЕсли;
				
				Если СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаНачисления Тогда
					
					// Начисления отрицательного отстатка по правилу уменьшения.
					// Репределние ведется на начисления по установленному способу расчета уменьшения.
					Показатель      = СуммаУменьшения;
					ОбщийПоказатель = СЧНачисленоУменьшения;
					
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоСпособуРасчетаФакт Тогда
					
					// Начисления отрицательного отстатка по правилу уменьшения.
					// Репределние ведется на факт по установленному способу расчета уменьшения.
					Показатель      = ФактОтУменьшения;
					ОбщийПоказатель = ОбщийФактОтУменьшения;
					
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоНормативам Тогда
					
					// БИТ_ЖКХ 24.06.2015{{
					//Показатель      = СуммаНорматив;
					Если СуммаНорматив < 0 Тогда
						Показатель      = 0;
						//МинусоваяСумма = МинусоваяСумма + СуммаНорматив;
						//Показатель      = СуммаНорматив;
					Иначе
						Показатель      = СуммаНорматив;
					КонецЕсли;
					// БИТ_ЖКХ 24.06.2015}}
					
					ОбщийПоказатель = СЧНачисленоНорма;
					
				ИначеЕсли  СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоСчетчикам Тогда
					
					Показатель      = СуммаСчетчик;
					ОбщийПоказатель = СЧНачисленоСчетчик;
					
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоОсновномуСпособуРасчета Тогда
					
					Показатель      = Факт;
					ОбщийПоказатель = ОбщийФакт;
					
					// БИТ_ЖКХ_01082013_начало_изменения	
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоОсновномуСпособуРасчетаС_УчетомСтавки Тогда
					
					Показатель      = ФактСУчетомСтавки;
					ОбщийПоказатель = ОбщийФактСУчетомСтавки;
					// БИТ_ЖКХ_01082013_окончание_изменения
					
				ИначеЕсли СпособРаспределения = Перечисления.бит_СпособыРаспределения.ПоНачислениям Тогда
					
					Показатель      = СуммаНачислений;
					ОбщийПоказатель = ОбщиеНачисления;
					
				КонецЕсли;
				
				Отбор = Новый Структура;
				Отбор.Вставить("ЛицевойСчет", Выборка.ЛицевойСчет);
				Отбор.Вставить("Услуга"     , Выборка.Услуга);
				
				ПоискСтроки = ТаблицаРасчетов.НайтиСтроки(Отбор);
				
				СтрокаРасчета = Неопределено;
				
				Если ПоискСтроки.Количество() = 0 Тогда
					СтрокаРасчета = ТаблицаРасчетов.Добавить();
					ЗаполнитьЗначенияСвойств(СтрокаРасчета, Выборка);
				Иначе
					СтрокаРасчета = ПоискСтроки[0];
				КонецЕсли; 
				
				НоваяСтрока = ВыполнитьРасчетПоСтроке(ТаблицаОбщедомовыеНачисления, Выборка, Остаток, Показатель, ОбщийПоказатель, СтрокаРасчета);
				
				Если НЕ НоваяСтрока = Неопределено Тогда
					
					Сумма     = НоваяСтрока.Начислено;
					СуммаИтог = СуммаИтог + НоваяСтрока.Начислено;
					СуммаНО   = СуммаНО   + НоваяСтрока.НераспределенныйОстаток;
					
					Если Индкес = Неопределено Тогда
						Индкес = ТаблицаОбщедомовыеНачисления.Индекс(НоваяСтрока);
					Иначе
						
						СтрокаПоИндексу = ТаблицаОбщедомовыеНачисления.Получить(Индкес);
						
						Если Остаток > 0 Тогда
							Индкес      = ?(СтрокаПоИндексу.Начислено < Сумма И НЕ Сумма = 0, ТаблицаОбщедомовыеНачисления.Индекс(НоваяСтрока), Индкес);
						Иначе
							Индкес      = ?(СтрокаПоИндексу.Начислено > Сумма И НЕ Сумма = 0, ТаблицаОбщедомовыеНачисления.Индекс(НоваяСтрока), Индкес);
						КонецЕсли; 
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если ЛСОбработано = КоличествоЛС И СуммаИтог = 0 Тогда
					ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Нет начислений для распределения суммы : " + Остаток + " по счетчику : " + Выборка.Счетчик + " и услуге :" + Выборка.Услуга);
				КонецЕсли;
				
			КонецЦикла;
			
			Погрешность = Остаток - СуммаИтог - СуммаНО;
			
			Если Погрешность <> 0 И
				НЕ СтрокаПоИндексу = Неопределено И 
				НЕ Индкес = Неопределено Тогда
				
				СтрокаПоИндексу = ТаблицаОбщедомовыеНачисления.Получить(Индкес);
				
				Если Остаток < 0 И НЕ СуммаНО = 0 Тогда
					
					СтрокаПоИндексу.НераспределенныйОстаток = СтрокаПоИндексу.НераспределенныйОстаток + Погрешность;
					
					Отбор = Новый Структура;
					Отбор.Вставить("ЛицевойСчет", СтрокаПоИндексу.ЛицевойСчет);
					Отбор.Вставить("Услуга"     , СтрокаПоИндексу.Услуга);
					
					ПоискСтроки = ТаблицаРасчетов.НайтиСтроки(Отбор);
					Если ПоискСтроки.Количество() > 0 Тогда
						СтрокаРасчета = ПоискСтроки[0];
						СтрокаРасчета.НераспределенныйОстаток = СтрокаРасчета.НераспределенныйОстаток + Погрешность;
					КонецЕсли;
					
				Иначе
					
					СтрокаПоИндексу.Начислено            = СтрокаПоИндексу.Начислено + Погрешность;
					СтрокаПоИндексу.КоличествоЕдиницПоЛС = ОКР(?(СтрокаПоИндексу.Тариф = 0, 0 ,СтрокаПоИндексу.Начислено/СтрокаПоИндексу.Тариф),4);
					
					Отбор = Новый Структура;
					Отбор.Вставить("ЛицевойСчет", СтрокаПоИндексу.ЛицевойСчет);
					Отбор.Вставить("Услуга"     , СтрокаПоИндексу.Услуга);
					
					ПоискСтроки = ТаблицаРасчетов.НайтиСтроки(Отбор);
					Если ПоискСтроки.Количество() > 0 Тогда
						СтрокаРасчета = ПоискСтроки[0];
						СтрокаРасчета.СуммаНачислений = СтрокаРасчета.СуммаНачислений + Погрешность;
					КонецЕсли;
					
				КонецЕсли;
				
			КонецЕсли;
			
		КонецЦикла; 
		
	КонецЦикла;
	
	ТаблицаРасчетов.Очистить();
	
	// Исправлена ошибка в строке (9) задваивался показатель НачисленоНорма бит_akozlov_25072013.
	// БИТ_ЖКХ_01082013_изменен_текст_запроса
	// Добавлено поля начисление с учетом ставки на услугу.
