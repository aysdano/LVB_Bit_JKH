&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	Объект.ЧекККМ   = Неопределено;
	
	Объект.СписокУслуг.Очистить();
	 // БИТ ЖКХ 16.07.2020
	Объект.СписокУслугПеня.Очистить();

	Объект.ЛицевыеСчета.Очистить();
	Объект.ФизЛица.Очистить();
	//Михайлов 05.02.2021 Начало работ
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийРазовыеПоЖКХ.ПерерасчетВСвязиСИзменениемПлощади") Тогда
		
		Объект.ПлощадьДляКапремонта = ПолучитьПощадьКапРемонт();
		
		Массив = ПолучитьПлощадиНаСервере();
		
		Попытка
		Объект.ПлощадьОбщая = Массив[0].ОбщаяПлощадь;
		Объект.ПлощадьЖилая = Массив[0].ЖилаяПлощадь;	
		Исключение
		Объект.ПлощадьОбщая = 0;
		Объект.ПлощадьЖилая = 0;	
		КонецПопытки;
		
		Массив = ПолучитьУслуги(Объект.Дата, Объект.ЛицевойСчет);
		Если Массив.Количество()>0 Тогда
		    Для Индекс = 0 По Массив.Количество() - 1 Цикл
                СтрокаТЧ = Объект.СписокУслуг.Добавить();
			    СтрокаТЧ.Услуга = Массив[Индекс].Услуга;
		        СтрокаТЧ.ЛицевойСчет = объект.ЛицевойСчет;
		     КонецЦикла; 
		КонецЕсли;
	КонецЕсли;
	//конец работ
КонецПроцедуры

