			НоваяСтрока = ДеревоУ.Строки.Добавить();
			НоваяСтрока.Услуга = ВыборкаГруп.ГруппаУслуги;
			
			НоваяСтрока.ГруппаУслугиПриоритет = ВыборкаГруп.ГруппаУслуги.Приоритет;
			
			Пока Выборка.Следующий() Цикл
				
				Строка = ТаблицаУ.Найти(Выборка.Услуга, "Услуга") ;
				// Убираем строки с общией группой под группу.
				Если Строка <> Неопределено Тогда
					
					СтрокаДерева = ДеревоУ.Строки.Найти(Выборка.Услуга, "Услуга");
					Если СтрокаДерева <> Неопределено Тогда
						
						ДеревоУ.Строки.Удалить(СтрокаДерева);	
						
					КонецЕсли; 
					
					ПеренесеннаяСтрока = НоваяСтрока.Строки.Добавить();
					ЗаполнитьЗначенияСвойств(ПеренесеннаяСтрока, Строка);
					
				КонецЕсли;  
			КонецЦикла;
		КонецЕсли; 
		
	КонецЦикла; 
	ДеревоУ.Строки.Сортировать("Приоритет Возр, ГруппаУслугиПриоритет Возр", ИСТИНА);
	ЗначениеВДанныеФормы(ДеревоУ,ДеревоУслуг);
	
	Элементы.ДеревоНачислений.ПодчиненныеЭлементы.ДеревоНачисленийЛьгота.ТекстПодвала         = Формат(ДеревоН.Строки.Итог("Льгота")        , "ЧДЦ=2");
	
	Элементы.ДеревоНачислений.ПодчиненныеЭлементы.ДеревоНачисленийОплата.ТекстПодвала         = Формат(ДеревоН.Строки.Итог("Оплата")        , "ЧДЦ=2");
	
	Элементы.ДеревоНачислений.ПодчиненныеЭлементы.ДеревоНачисленийСальдоНаНачало.ТекстПодвала = Формат(ДеревоН.Строки.Итог("СальдоНаНачало"), "ЧДЦ=2");
	
	Элементы.ДеревоНачислений.ПодчиненныеЭлементы.ДеревоНачисленийНачислено.ТекстПодвала      = Формат(ДеревоН.Строки.Итог("Начислено")     , "ЧДЦ=2");
	
	Элементы.ДеревоНачислений.ПодчиненныеЭлементы.ДеревоНачисленийРазовые.ТекстПодвала        = Формат(ДеревоН.Строки.Итог("Разовые")       , "ЧДЦ=2");
	
	Элементы.ДеревоНачислений.ПодчиненныеЭлементы.ДеревоНачисленийКОплате.ТекстПодвала        = Формат(ДеревоН.Строки.Итог("КОплате")       , "ЧДЦ=2");
	
КонецПроцедуры

// Процедура выполняет заполнение таблицы на печать.
//
&НаСервере
Процедура ЗаполнитьТаблицуПечати()
	
	ТаблицаН = ДанныеФормыВЗначение(ТаблицаНачислений, Тип("ТаблицаЗначений"));
	ДеревоНач = ТаблицаН.СкопироватьКолонки();
	
	Если ДеревоНач.Колонки.Найти("ПриоритетГруп")= Неопределено Тогда
		МассивТипов = Новый Массив;
		МассивТипов.Добавить(Тип("Число"));
		КЧ = Новый КвалификаторыЧисла(10,0);
		ОписаниеЧисло = Новый ОписаниеТипов(МассивТипов,КЧ);
		КолонкиСостава = ДеревоНач.Колонки;
		КолонкиСостава.Добавить("ПриоритетГруп", ОписаниеЧисло, "ПриоритетГруп", 100);
	КонецЕсли;
	
	ДеревоН = ДанныеФормыВЗначение(ДеревоНачислений, Тип("ДеревоЗначений"));
	
	Для каждого Строка Из ДеревоН.Строки Цикл
		
		НовСтрока = ДеревоНач.Добавить();
		ЗаполнитьЗначенияСвойств(НовСтрока, Строка);
		
		Если ТипЗнч(Строка.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг") 
			Тогда НовСтрока.ПриоритетГруп = Строка.Услуга.Приоритет;
		КонецЕсли; 
		
	КонецЦикла;
	
	Если Объект.ОтображатьПоГруппам Тогда
		
		ДеревоНач.Сортировать("ПриоритетГруп Возр");
		ДеревоНач.Сортировать("Приоритет Возр");
		
	КонецЕсли; 
	
	ТаблицаДляПечати = ?(Объект.ОтображатьПоГруппам,ДеревоНач.Скопировать(), ТаблицаН.Скопировать());
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	// Удалены закоментированые участки кода.
	"ВЫБРАТЬ
	|	ТаблицаНачислений.Услуга,
	|	ВЫБОР
	|		КОГДА ТаблицаНачислений.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам)
	|				ИЛИ ТаблицаНачислений.СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам)
	|			ТОГДА ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)
	|		ИНАЧЕ ТаблицаНачислений.СпособРасчета
	|	КОНЕЦ КАК СпособРасчета,
	|	ТаблицаНачислений.Норма,
	|	ТаблицаНачислений.СверхНорма
	|ПОМЕСТИТЬ ТаблицаНачислений
	|ИЗ
	|	&ТаблицаНачислений КАК ТаблицаНачислений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаСчетчикам.Услуга,
	|	ТаблицаСчетчикам.КоличествоЕдиницПоЛС,
	|	ТаблицаСчетчикам.ОтПоказаний,
	|	ТаблицаСчетчикам.ДоПоказаний
	|ПОМЕСТИТЬ ТаблицаСчетчикам
	|ИЗ
	|	&ТаблицаСчетчикам КАК ТаблицаСчетчикам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДляПечати.Услуга,
	|	ТаблицаДляПечати.Приоритет,
	|	ТаблицаДляПечати.Ставка,
	|	ТаблицаДляПечати.СверхномСтавка,
	|	ТаблицаДляПечати.Норма,
	|	ТаблицаДляПечати.СверхНорма,
	|	ТаблицаДляПечати.СальдоНаНачало,
	|	ТаблицаДляПечати.Начислено,
	|	ТаблицаДляПечати.Льгота,
	|	ТаблицаДляПечати.Субсидия,
	|	ТаблицаДляПечати.Оплата,
	|	ТаблицаДляПечати.Разовые,
	|	ТаблицаДляПечати.КОплате,
	|	ТаблицаДляПечати.СпособРасчета,
	|	ТаблицаДляПечати.Норматив,
	|	ТаблицаДляПечати.Факт,
	|	ТаблицаДляПечати.Долг,
	|	ТаблицаДляПечати.ПереплатаНаНачало,
	|	ТаблицаДляПечати.Объем,
	|	ТаблицаДляПечати.Тариф,
	|	ТаблицаДляПечати.КОплатеЗаМесяц,
	|	ТаблицаДляПечати.НормативПоКу
	|ПОМЕСТИТЬ ТаблицаДляПечати
	|ИЗ
	|	&ТаблицаДляПечати КАК ТаблицаДляПечати
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаПени.Услуга,
	|	ТаблицаПени.Пени КАК Пени
	|ПОМЕСТИТЬ ТаблицаПени
	|ИЗ
	|	&ТаблицаПени КАК ТаблицаПени
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ТаблицаДляПечати.Услуга,
	|	ТаблицаДляПечати.Приоритет,
	|	ТаблицаДляПечати.Ставка,
	|	ТаблицаДляПечати.СверхномСтавка,
	|	ТаблицаДляПечати.Норма,
	|	ТаблицаДляПечати.СверхНорма,
	|	ТаблицаДляПечати.СальдоНаНачало,
	|	ТаблицаДляПечати.Начислено,
	|	ТаблицаДляПечати.Льгота,
	|	ТаблицаДляПечати.Субсидия,
	|	ТаблицаДляПечати.Оплата,
	|	ТаблицаДляПечати.Разовые,
	|	ТаблицаДляПечати.КОплате,
	|	ТаблицаДляПечати.СпособРасчета,
	|	ТаблицаДляПечати.Норматив,
	|	ТаблицаДляПечати.Факт,
	|	ТаблицаДляПечати.Объем,
	|	ТаблицаДляПечати.Тариф,
	|	ВложенныйЗапрос.ЕдИзм,
	|	ВложенныйЗапрос.Количество,
	|	ТаблицаДляПечати.Долг,
	|	ТаблицаДляПечати.ПереплатаНаНачало,
	|	ТаблицаДляПечати.КОплатеЗаМесяц КАК КОплатеЗаМесяц,
	|	ВложенныйЗапрос.Пени,
	|	ТаблицаДляПечати.НормативПоКу
	|ИЗ
	|	ТаблицаДляПечати КАК ТаблицаДляПечати
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			ТаблицаНачислений.Услуга КАК Услуга,
	|			бит_УслугиЖКХСпособыРасчета.ЕдИзм КАК ЕдИзм,
	|			ВЫБОР
	|				КОГДА ТаблицаНачислений.СпособРасчета В (&СпособыРасчета)
	|					ТОГДА ЕСТЬNULL(ВЫРАЗИТЬ(ТаблицаСЧ.КоличествоЕдиниц КАК ЧИСЛО(15, 3)), 0)
	|				ИНАЧЕ ЕСТЬNULL(ВЫРАЗИТЬ(ТаблицаНачислений.Норма + ТаблицаНачислений.СверхНорма КАК ЧИСЛО(15, 3)), 0)
	|			КОНЕЦ КАК Количество,
	|			ТаблицаПени.Пени КАК Пени
	|		ИЗ
	|			ТаблицаНачислений КАК ТаблицаНачислений
	|				ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_УслугиЖКХ.СпособыРасчета КАК бит_УслугиЖКХСпособыРасчета
	|				ПО ТаблицаНачислений.Услуга = бит_УслугиЖКХСпособыРасчета.Ссылка
	|					И ТаблицаНачислений.СпособРасчета = бит_УслугиЖКХСпособыРасчета.СпособРасчета
	|				ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаПени КАК ТаблицаПени
	|				ПО ТаблицаНачислений.Услуга = ТаблицаПени.Услуга
	|				ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|					ТаблицаСчетчикам.Услуга КАК Услуга,
	|					СУММА(ТаблицаСчетчикам.КоличествоЕдиницПоЛС) КАК КоличествоЕдиниц,
	|					СУММА(ТаблицаСчетчикам.ОтПоказаний) КАК ОтПоказаний,
	|					СУММА(ТаблицаСчетчикам.ДоПоказаний) КАК ДоПоказаний
	|				ИЗ
	|					ТаблицаСчетчикам КАК ТаблицаСчетчикам
	|				
	|				СГРУППИРОВАТЬ ПО
	|					ТаблицаСчетчикам.Услуга) КАК ТаблицаСЧ
	|				ПО ТаблицаНачислений.Услуга = ТаблицаСЧ.Услуга) КАК ВложенныйЗапрос
	|		ПО ТаблицаДляПечати.Услуга = ВложенныйЗапрос.Услуга
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаНачислений
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаСчетчикам
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаДляПечати
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|УНИЧТОЖИТЬ ТаблицаПени";
	
	МассивСпособов = Новый Массив;
	МассивСпособов.Добавить(Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам);
	МассивСпособов.Добавить(Перечисления.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных);
	МассивСпособов.Добавить(Перечисления.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам);
	МассивСпособов.Добавить(Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам);
	
	Запрос.УстановитьПараметр("ТаблицаДляПечати" , ТаблицаДляПечати);
	Запрос.УстановитьПараметр("ТаблицаНачислений", ?(Объект.ОтображатьПоГруппам, ДеревоНач, ТаблицаН));
	
	ТаблицаС = ДанныеФормыВЗначение(ТаблицаСчетчиков, Тип("ТаблицаЗначений"));
	
	Запрос.УстановитьПараметр("ТаблицаСчетчикам" , ТаблицаС);
	
	ТаблицаПениИзХранилища  = ПолучитьИзВременногоХранилища(АдресТаблицыПениВХранилище);
	
	Запрос.УстановитьПараметр("ТаблицаПени"      , ТаблицаПениИзХранилища);
	
	Запрос.УстановитьПараметр("СпособыРасчета"   , МассивСпособов);
	
	Выгрузка = Запрос.Выполнить().Выгрузить();
	
	мТаблицаПечати = Выгрузка.СкопироватьКолонки();
	
	мТаблицаПечати.Колонки.Добавить("ПриоритетГруп");
	
	Для каждого ТекСтрока Из Выгрузка Цикл
		
		НоваяСтрока = мТаблицаПечати.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрока, ТекСтрока);
		
		НоваяСтрока.Ставка         = Окр(ТекСтрока.Ставка, 2);
		НоваяСтрока.СверхномСтавка = Окр(ТекСтрока.СверхномСтавка, 2);
		
		Если ТипЗнч(ТекСтрока.Услуга) = Тип("СправочникСсылка.бит_ГруппыУслуг") 
			Тогда НоваяСтрока.ПриоритетГруп = ТекСтрока.Услуга.Приоритет;
		КонецЕсли; 
		
	КонецЦикла;
	
	Если НЕ Объект.ОтображатьПоГруппам Тогда
		
		АдресТаблицыПечатиВХранилище = ПоместитьТаблицуПечатиВХранилище(мТаблицаПечати);
		
		ДополнитьТаблицуПоставщиками();
		
		
	КонецЕсли; 
	
	Если Объект.ОтображатьПоГруппам Тогда
		
		мТаблицаПечати.Сортировать("ПриоритетГруп Возр");
		мТаблицаПечати.Сортировать("Приоритет Возр");
		
	Иначе
		мТаблицаПечати.Сортировать("Приоритет Возр");
		
	КонецЕсли; 
	
	АдресТаблицыПечатиВХранилище = ПоместитьТаблицуПечатиВХранилище(мТаблицаПечати);
	ТаблицаПечатиИзХранилища  = ПолучитьИзВременногоХранилища(АдресТаблицыПечатиВХранилище);
	
КонецПроцедуры

// Функция формирования структуры из площадей квартиры>.
//
// Параметры:
//  <НомерКвартиры>  - ссылка на квартиру в регистре сведений.
//
// Возвращаемое значение:
//  <ИскомыйРезультат.Структура> - набор данных по площадям.
//
&НаСервере
Функция ВывестиПлощадиКвартиры()
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.МОП,
	|	бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.СовокупнаяПлощадь,
	|	бит_СведенияОКвартиреСрезПоследних.Квартира
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&ТекущаяДата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	
	Запрос.УстановитьПараметр("Квартира", Объект.Квартира);
	Запрос.УстановитьПараметр("ТекущаяДата", ТекущаяДата());
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Отбор = Новый Структура();
	Отбор.Вставить("Квартира",Объект.Квартира);
	Строки = Результат.НайтиСтроки(Отбор);
	Если Строки.Количество() > 0 Тогда
		ИскомыйРезультат = Новый Массив;
		ИскомыйРезультат.Вставить(0,Строки[0].ОбщаяПлощадь);
		ИскомыйРезультат.Вставить(1,Строки[0].ЖилаяПлощадь);
		ИскомыйРезультат.Вставить(2,Строки[0].МОП);
		ИскомыйРезультат.Вставить(3,Строки[0].ОтапливаемаяПлощадь);
		ИскомыйРезультат.Вставить(4,Строки[0].СовокупнаяПлощадь);
	Иначе
		ИскомыйРезультат = Неопределено;
	КонецЕсли;
	
	Возврат  ИскомыйРезультат;
	
КонецФункции // ()

// Функция формирования списка комнат квартиры на дату.
//
&НаСервере
Функция ПолучитьСписокКомнат(НомерКвартиры)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ
	|	бит_СведенияОКомнатеСрезПоследних.Комната,
	|	бит_СведенияОКомнатеСрезПоследних.Площадь
	|ИЗ
	|	РегистрСведений.бит_СведенияОКомнате.СрезПоследних(&Момент, Комната.Владелец = &Владелец) КАК бит_СведенияОКомнатеСрезПоследних"; 
	
	Запрос.УстановитьПараметр("Владелец", НомерКвартиры);
	Запрос.УстановитьПараметр("Момент", ТекущаяДата());
	
	Результат = Запрос.Выполнить().Выгрузить();
	Возврат Результат;
	
КонецФункции

// Процедура расчета различных типов площадей для сравнения и контроля аналогичных в справочнике Квартиры.
&НаСервере
Процедура ПосчитатьПлощади()
	
	ТабличноеПолеПлощадей.Очистить();
	Массив = Новый Массив;
	Массив.Вставить(0,"Общая площадь");
	Массив.Вставить(1,"Жилая площадь");
	Массив.Вставить(2,"МОП площадь");
	Массив.Вставить(3,"Отапливаемая площадь");
	Массив.Вставить(4,"Совокупная площадь");
	
	Площадь = Новый Массив(5);
	
	Для Счетчик = 0 По 4  Цикл
		Площадь[Счетчик] = 0;
	КонецЦикла; 
	СписокКомнат = ПолучитьСписокКомнат(Объект.Квартира);
	
	Для каждого СтрокаТЧ Из СписокКомнат Цикл
		Строка = СтрокаТЧ.Комната.ЧастьПомещения;
		Если Строка.КоэффициентНачислений <> 0 Тогда 
			// Отапливаемая.
			Площадь[3] = Площадь[3] + СтрокаТЧ.Площадь;
			Если Строка.Принадлежность = Перечисления.бит_ПринадлежностьКомнат.Внутренняя Тогда
				// Общая.
				Площадь[0] = Площадь[0] + СтрокаТЧ.Площадь;
				
				Если Строка.ТипКомнаты = Справочники.бит_ТипыКомнат.Жилая 
					Тогда
					// Жилая.
					Площадь[1] = Площадь[1] + СтрокаТЧ.Площадь;
				КонецЕсли;	
				
			КонецЕсли;	
		КонецЕсли;	
		
		Если Строка.ТипКомнаты = Справочники.бит_ТипыКомнат.МОП Тогда
			// МОП.
			Площадь[2] = Площадь[2] + СтрокаТЧ.Площадь;
		КонецЕсли;	
		// Совокупная.
		Площадь[4] = Площадь[4] + СтрокаТЧ.Площадь;
	КонецЦикла;                                                                    
	
	ПлощадиКвартиры = ВывестиПлощадиКвартиры();
	
	Если ЗначениеЗаполнено(ПлощадиКвартиры) Тогда
		Для Счетчик = 0 По 4 Цикл
			НоваяСтрока = ТабличноеПолеПлощадей.Добавить();// Вставить(Счетчик);.
			НоваяСтрока.ВидыПлощадей = Массив[Счетчик]; 
			НоваяСтрока.ПлощадиКвартиры = ПлощадиКвартиры[Счетчик];
			НоваяСтрока.ПлощадиКомнат = Площадь[Счетчик]; 
		КонецЦикла; 
		
	Иначе
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Нет исходных данных по площадям квартиры! Проверьте регистр сведений ""Сведения о квартире""");
		
	КонецЕсли; 
	
КонецПроцедуры

