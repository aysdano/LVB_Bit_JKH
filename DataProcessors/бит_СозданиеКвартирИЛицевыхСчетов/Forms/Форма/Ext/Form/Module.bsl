
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Объект.НомерПервогоДома = 1;
	Объект.НомерПоследнегоДома = 10;  	
	Объект.НомерПервойКвартиры = 1;
	Объект.ДатаСоздания = ТекущаяДата();
	
	ПравилаНумерацииЖил = "НомерДомаКвартира";

	Элементы.ПравилаНумерацииЖил.СписокВыбора.Очистить();
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Добавить("Квартира","По номеру квартиры",, БиблиотекаКартинок.бит_ОПрограмме);
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Добавить("ПоПорядку","Последовательная нумерация",, БиблиотекаКартинок.бит_Реквизиты);
	Элементы.ПравилаНумерацииЖил.СписокВыбора.Добавить("НомерДомаКвартира","Номер дома + Квартира",, БиблиотекаКартинок.бит_ПодомовойУчет);

КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьСписокЗданий(Команда)
	
	если Объект.НомерПервогоДома >= Объект.НомерПоследнегоДома тогда	
		
	  ЭтаФорма.ТекущийЭлемент = ЭтаФорма.Элементы.НомерПоследнегоДома;
	  Сообщить("Номер последнего дома должен быть больше номера первого дома.");
		
	конецесли;	
	
  //если Объект.Организация <> Справочники.Организации.ПустаяСсылка() тогда	
    Объект.СписокЗданий.Очистить();
	ЗаполнитьСписокЗданийНаСервере();
  //иначе	
  //  Сообщить("Не заполнено поле Организация");
  //конецесли;	
КонецПроцедуры

&НаСервере
Процедура ЗаполнитьСписокЗданийНаСервере()
  
   если Объект.Улица = Справочники.бит_СписокУлиц.ПустаяСсылка() тогда	
	Сообщить("Не заполнено поле Улица");
	возврат;
   конецесли;	

   если Объект.Организация = Справочники.Организации.ПустаяСсылка() тогда	
	Сообщить("Не заполнено поле Организация");
	возврат;
   конецесли;	
   
	текущийНомерДома = Объект.НомерПервогоДома; 
	для НомерДома = Объект.НомерПервогоДома по Объект.НомерПоследнегоДома цикл
		
	  новыйДом = Объект.СписокЗданий.Добавить();	
	  новыйДом.Улица = Объект.Улица;
	  новыйДом.Организация = Объект.Организация;
	  новыйДом.Дом = текущийНомерДома;
	  новыйДом.Ссылка = НайтиОбъектЗдания(Объект.Улица, новыйДом.Дом);
	  	  
	  текущийНомерДома = текущийНомерДома + 1;
		
	конеццикла;	
	
	Объект.СписокЗданий.Сортировать("Улица, Дом, Корпус");
  	
КонецПроцедуры

