		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо
ПОМЕСТИТЬ ПроживающиеПоЛС
ИЗ
	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&amp;КонецПериода {(&amp;КонецПериода)}, ) КАК бит_ПроживающиеПоЛССрезПоследних
ГДЕ
	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица &lt;&gt; ЗНАЧЕНИЕ(Справочник.бит_СтатусФизЛица.ВЫПИСАН)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	НачисленияКасс.Организация,
	НачисленияКасс.ЛицевойСчет,
	НачисленияКасс.Услуга,
	НачисленияКасс.КассаККМ,
	ЕСТЬNULL(НачисленияКасс.Сумма, 0) КАК Сумма,
	НачисленияКасс.ЛицевойСчет.УлицаЛицевогоСчета КАК Улица,
	НачисленияКасс.ЛицевойСчет.Здание КАК Здание,
	НачисленияКасс.ЛицевойСчет.Здание.Корпус КАК Корпус,
	НачисленияКасс.ЛицевойСчет.Квартира КАК Квартира,
	ПроживающиеПоЛС.ФизЛицо КАК ОтветсвенноеЛицо,
	ЕСТЬNULL(НачисленияКасс.СуммаПени, 0) КАК СуммаПени,
	НачисленияКасс.ЛицевойСчет КАК КоличествоЛС,
	НачисленияКасс.Услуга КАК КоличествоУслуг,
	НачисленияКасс.Чек КАК Документ,
	НачисленияКасс.Ответственный,
	НачисленияКасс.ВидОперации КАК ТипОперации,
	НачисленияКасс.Плательщик,
	НачисленияКасс.Чек КАК КоличествоЧеков
ИЗ
	(ВЫБРАТЬ
		бит_НачисленияКассОбороты.ЛицевойСчет КАК ЛицевойСчет,
		бит_НачисленияКассОбороты.Услуга КАК Услуга,
		бит_НачисленияКассОбороты.КассаККМ КАК КассаККМ,
		СУММА(бит_НачисленияКассОбороты.СуммаОплатыОборот) КАК Сумма,
		СУММА(бит_НачисленияКассОбороты.СуммаПениОборот) КАК СуммаПени,
		бит_НачисленияКассОбороты.Регистратор КАК Чек,
		бит_НачисленияКассОбороты.Регистратор.Ответственный КАК Ответственный,
		КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_НачисленияКассОбороты.Регистратор) КАК КоличествоЧеков,
		бит_НачисленияКассОбороты.Регистратор.ВидОперации КАК ВидОперации,
		бит_НачисленияКассОбороты.Регистратор.Плательщик КАК Плательщик,
		бит_НачисленияКассОбороты.ЛицевойСчет.Организация КАК Организация
	ИЗ
		РегистрНакопления.бит_НачисленияКасс.Обороты(
				&amp;НачалоПериода {(&amp;НачалоПериода)},
				&amp;КонецПериода {(&amp;КонецПериода)},
				Регистратор,
				КассаККМ.Владелец В
					(ВЫБРАТЬ
						Организации.Ссылка
					ИЗ
						Справочник.Организации КАК Организации)) КАК бит_НачисленияКассОбороты
	
	СГРУППИРОВАТЬ ПО
		бит_НачисленияКассОбороты.ЛицевойСчет,
		бит_НачисленияКассОбороты.Услуга,
		бит_НачисленияКассОбороты.КассаККМ,
		бит_НачисленияКассОбороты.Регистратор,
		бит_НачисленияКассОбороты.Регистратор.Ответственный,
		бит_НачисленияКассОбороты.Регистратор.ВидОперации,
		бит_НачисленияКассОбороты.Регистратор.Плательщик,
		бит_НачисленияКассОбороты.ЛицевойСчет.Организация) КАК НачисленияКасс
		ЛЕВОЕ СОЕДИНЕНИЕ ПроживающиеПоЛС КАК ПроживающиеПоЛС
		ПО (ВЫБОР
				КОГДА ПроживающиеПоЛС.ЛицевойСчет &lt;&gt; ЗНАЧЕНИЕ(Справочник.бит_ЛицевыеСчета.ПустаяСсылка)
					ТОГДА НачисленияКасс.ЛицевойСчет = ПроживающиеПоЛС.ЛицевойСчет
			КОНЕЦ)</query>
	</dataSet>
