			ТОГДА 90
		КОГДА ВТ_Данные.Услуга.Код = "00-000023"
			ТОГДА 100
		КОГДА ВТ_Данные.Услуга.Код = "00-000013"
			ТОГДА 110
		КОГДА ВТ_Данные.Услуга.Код = "00-000019"
			ТОГДА 120
		КОГДА ВТ_Данные.Услуга.Код = "00-000026"
			ТОГДА 130
		КОГДА ВТ_Данные.Услуга.Код = "00-000021"
			ТОГДА 140
		КОГДА ВТ_Данные.Услуга.Код = "00-000022"
			ТОГДА 150
		КОГДА ВТ_Данные.Услуга.Код = "00-000008"
			ТОГДА 160
	КОНЕЦ КАК порядок,
	СУММА(ВТ_Данные.СуммаПени) КАК СуммаПени,
	ВТ_Данные.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_Данные.ТипКвартиры КАК ТипКвартиры
ПОМЕСТИТЬ вт2
ИЗ
	ВТ_Данные КАК ВТ_Данные
ГДЕ
	ВТ_Данные.VID В(&amp;ВидыОплаты)
	И ВТ_Данные.ТипКвартиры В(&amp;ТипыКвартир)

СГРУППИРОВАТЬ ПО
	ВТ_Данные.VID,
	ВТ_Данные.Период,
	ВТ_Данные.Услуга,
	ВЫБОР
		КОГДА ВТ_Данные.Услуга.Код = "00-000001"
			ТОГДА 10
		КОГДА ВТ_Данные.Услуга.Код = "00-000010"
			ТОГДА 20
		КОГДА ВТ_Данные.Услуга.Код = "00-000011"
