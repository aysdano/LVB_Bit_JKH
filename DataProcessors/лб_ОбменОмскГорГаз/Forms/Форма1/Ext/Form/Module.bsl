//8.2.3(1)
&НаКлиенте
Процедура НачисленияГорГаз(Команда)
	ФайлНачисленияГорГаза = ОткрытьФайл();
	НачисленияГорГазНаСервере()
КонецПроцедуры

&НаСервере
Процедура НачисленияГорГазНаСервере()
	
	Массив = Новый Массив;
	Массив.Добавить("Период");
	Массив.Добавить("Услуга");
	Массив.Добавить("Поставщик");
	Массив.Добавить("Организация");
	Массив.Добавить("РежимДляСчетчиков");
	
	Для Каждого Реквизит ИЗ Массив Цикл
		Если Не ЗначениеЗаполнено(Объект[Реквизит]) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Реквизит);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат
		КонецЕсли;
	КонецЦикла;
	
	ЗаполнитьПолеДокументДанныеГорГаза(Истина);
	
	Если Не ЗначениеЗаполнено(Объект.ДокументКоррекцииСальдо) Тогда
		Возврат
	КонецЕсли;

	НовыйДБФ = СоздатьПустойДБФНачисленияГорГаз();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаНачисленияГорГаз();
	Запрос.УстановитьПараметр("Регистратор", Объект.ДокументКоррекцииСальдо);
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Услуга", Объект.Услуга);
	Запрос.УстановитьПараметр("РежимПоСчетчикамГорГаз", Объект.РежимДляСчетчиков);
	Запрос.УстановитьПараметр("Поставщик", Объект.Поставщик);
	Запрос.УстановитьПараметр("ПериодН", Новый Граница(НачалоМесяца(Объект.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодК", Новый Граница(КонецМесяца(Объект.Период), ВидГраницы.Включая));	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		НовыйДБФ.Добавить();
		
		ЛС = Строка.Ссылка.Наименование;
		Здание = Строка.Ссылка.Здание;
		Адрес = АдресПоЛС(Строка.Ссылка, Здание);
		
		Попытка
			НовыйДБФ.IND = Лев(ЛС, 3);
			НовыйДБФ.LIC = Сред(ЛС, 4);
		Исключение
			Продолжить
		КонецПопытки;
		НовыйДБФ.FIO = Строка.FIO;
		НовыйДБФ.ADR = Адрес;
		НовыйДБФ.KP = Строка.KP;
		НовыйДБФ.NACHSV = Строка.NACHSV;
		НовыйДБФ.SAL = Строка.SAL;
		НовыйДБФ.PERIOD = Месяц(Объект.Период);
		НовыйДБФ.CH = Строка.CH;
		НовыйДБФ.TARIF = Строка.TARIF;
		
		НовыйДБФ.Записать();
	КонецЦикла;
	
	НовыйДБФ.ЗакрытьФайл();
	
	ПереместитьФайл(ФайлНачисленияГорГазаВр, ФайлНачисленияГорГаза);

КонецПроцедуры

