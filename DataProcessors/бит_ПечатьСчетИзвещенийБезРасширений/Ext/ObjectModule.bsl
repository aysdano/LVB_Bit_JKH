КонецФункции


Функция лб_ПроживающиеЛС(ОтборЛС)
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусПроживания = ЗНАЧЕНИЕ(Перечисление.бит_СтатусПроживания.НеПроживает)
	|			ТОГДА 0
	|		ИНАЧЕ 1
	|	КОНЕЦ КАК СтатусПроживания,
	|	ВЫБОР
	|		КОГДА бит_ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ВладелецКвартиры,
	|	ВЫБОР
	|		КОГДА бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПроживаниеВДанныйМомент
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ПроживаниеВДанныйМомент,
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет
	|ПОМЕСТИТЬ бит_ПроживающиеПоЛС_1
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(&КонецПериода, ЛицевойСчет В (&ОтборЛС)) КАК бит_ПроживающиеПоЛССрезПоследних
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	СУММА(бит_ПроживающиеПоЛС_1.СтатусПроживания) КАК ЧислаПроживающих,
	|	СУММА(бит_ПроживающиеПоЛС_1.ВладелецКвартиры) КАК Владелецы,
	|	СУММА(бит_ПроживающиеПоЛС_1.ПроживаниеВДанныйМомент) КАК ПроживанющиеВДанныйМомент,
	|	бит_ПроживающиеПоЛС_1.ЛицевойСчет КАК ЛицевойСчет
	|ПОМЕСТИТЬ бит_ПроживающиеПоЛС_2
	|ИЗ
	|	бит_ПроживающиеПоЛС_1 КАК бит_ПроживающиеПоЛС_1
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПроживающиеПоЛС_1.ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих > бит_ПроживающиеПоЛС_2.Владелецы
	|			ТОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих
	|		КОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих < бит_ПроживающиеПоЛС_2.Владелецы
	|			ТОГДА бит_ПроживающиеПоЛС_2.Владелецы
	|		КОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих = бит_ПроживающиеПоЛС_2.Владелецы
	|			ТОГДА бит_ПроживающиеПоЛС_2.Владелецы
	|		КОГДА бит_ПроживающиеПоЛС_2.ЧислаПроживающих = 0
	|				И бит_ПроживающиеПоЛС_2.Владелецы = 0
	|			ТОГДА бит_ПроживающиеПоЛС_2.ПроживанющиеВДанныйМомент
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК КолВоПроживающих1,
	|	бит_ПроживающиеПоЛС_2.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛС_2.ЧислаПроживающих КАК КолВоПроживающих
	|ИЗ
	|	бит_ПроживающиеПоЛС_2 КАК бит_ПроживающиеПоЛС_2";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Период));
	Запрос.УстановитьПараметр("ОтборЛС", ОтборЛС);
	
	Возврат Запрос.Выполнить().Выбрать();	
	
КонецФункции


Процедура лб_СвернутьЗависимыеЛС(ТаблицаДанных)
	
	//нужно оптимизировать, нужно больше времени
	Для Каждого ЛС из ТаблицаДанных.ВыгрузитьКолонку("ЛицевойСчет") Цикл
		Отбор = Новый Структура("ВладелецЛС", ЛС);
		МассивСтрок = ТаблицаДанных.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() > 1 Тогда
			ГлавнаяСтрока = Неопределено;
			
			Для Каждого СтрокаМассива Из МассивСтрок Цикл
				Если СтрокаМассива.ВладелецЛС = СтрокаМассива.ЛицевойСчет Тогда
					ГлавнаяСтрока = СтрокаМассива;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			ГлавнаяСтрока.Значение.СтруктураДанных.КоличествоЗависимых = МассивСтрок.Количество() - 1;
			
			Для Каждого СтрокаМассива Из МассивСтрок Цикл
				Если СтрокаМассива.ВладелецЛС = СтрокаМассива.ЛицевойСчет Тогда
					Продолжить;
				КонецЕсли;
				
				Для Каждого СтрокаУслуга Из СтрокаМассива.Значение.ТаблицаПечати Цикл
					СтрокаТаблицаПечати = ГлавнаяСтрока.Значение.ТаблицаПечати.Найти(СтрокаУслуга.Услуга, "Услуга");
					Если НЕ СтрокаТаблицаПечати = Неопределено Тогда
						СтрокаТаблицаПечати.Сальдо = СтрокаТаблицаПечати.Сальдо + СтрокаУслуга.Сальдо;
						СтрокаТаблицаПечати.Разовые = СтрокаТаблицаПечати.Разовые + СтрокаУслуга.Разовые;
						СтрокаТаблицаПечати.ПереплатаНаНачало = СтрокаТаблицаПечати.ПереплатаНаНачало + СтрокаУслуга.ПереплатаНаНачало;
						СтрокаТаблицаПечати.Пени = СтрокаТаблицаПечати.Пени + СтрокаУслуга.Пени;
						СтрокаТаблицаПечати.Оплата = СтрокаТаблицаПечати.Оплата + СтрокаУслуга.Оплата;
						СтрокаТаблицаПечати.НачисленоОбщДом = СтрокаТаблицаПечати.НачисленоОбщДом + СтрокаУслуга.НачисленоОбщДом;
						СтрокаТаблицаПечати.НачисленоИНД = СтрокаТаблицаПечати.НачисленоИНД + СтрокаУслуга.НачисленоИНД;
						СтрокаТаблицаПечати.Начислено = СтрокаТаблицаПечати.Начислено + СтрокаУслуга.Начислено;
						СтрокаТаблицаПечати.КОплатеЗаМесяц = СтрокаТаблицаПечати.КОплатеЗаМесяц + СтрокаУслуга.КОплатеЗаМесяц;
						СтрокаТаблицаПечати.КОплате = СтрокаТаблицаПечати.КОплате + СтрокаУслуга.КОплате;
						СтрокаТаблицаПечати.Долг = СтрокаТаблицаПечати.Долг + СтрокаУслуга.Долг;
					Иначе
						ЗаполнитьЗначенияСвойств(ГлавнаяСтрока.Значение.ТаблицаПечати.Добавить(), СтрокаУслуга);	
					КонецЕсли;	
				КонецЦикла;
				
				ОбщегоНазначенияКлиентСервер.ДополнитьТаблицу(СтрокаМассива.Значение.ТаблицаПерерасчетов, ГлавнаяСтрока.Значение.ТаблицаПерерасчетов);
				
				ТаблицаДанных.Удалить(СтрокаМассива);
				
			КонецЦикла;		
		КонецЕсли;		
	КонецЦикла;
	
КонецПроцедуры


Функция лб_ЕПДОсновная(СтарыйМакет)
	
	ДатаПолученияДанных = КонецДня(Период);
	УслугиАнтена = лб_Сервер.УслугиАнтенна();
	нДатаПОлученияДанных = НачалоМесяца(мСтруктураДанных.Дата);
	Если СтарыйМакет Тогда
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ ПЕРВЫЕ 1
		|	ТарифыГазоснабженияСрезПоследних.ТарифПоКг КАК ТарифПоКг,
		|	ТарифыГазоснабженияСрезПоследних.ТарифПоКубМ КАК ТарифПоКубМ
		|ИЗ
		|	РегистрСведений.ТарифыГазоснабжения.СрезПоследних(&ДатаПолученияДанных, ) КАК ТарифыГазоснабженияСрезПоследних";
		
		Запрос.УстановитьПараметр("ДатаПолученияДанных", ДатаПолученияДанных);
		РезультатЗапроса = Запрос.Выполнить();
		Если Не РезультатЗапроса.Пустой() Тогда
			ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
			ВыборкаДетальныеЗаписи.Следующий();
			
			ТарифГазКг = ВыборкаДетальныеЗаписи.ТарифПоКг;
			ТарифГазКуб = ВыборкаДетальныеЗаписи.ТарифПоКубМ;
		Иначе
			ТарифГазКг = 0;
			ТарифГазКуб = 0;	
		КонецЕсли; 
	КонецЕсли;
	ИнфоОргЧасть = "ИНН    "+ мСтруктураДанных.ПолучательИНН + "    БИК    " 
	+ мСтруктураДанных.ПолучательБИК + "    р/сч    " 
	+ мСтруктураДанных.ПолучательРС + "    в " 
	+ мСтруктураДанных.ПолучательБанк + "             к/сч     " 
	+ мСтруктураДанных.ПолучательКоррСчет2 + "    " 
	+ мСтруктураДанных.ПолучательДопИнформация;
	
	мСтруктураДанных.ЛицевойСчетАдрес = лб_сервер.лб_АдресЛС(мСтруктураДанных.ЛицевойСчет, Период);
	
	НаименованиеОрг = мСтруктураДанных.ПолучательПредставление;
	
	УслугаГаза = лб_Сервер.УслугаГазоснабжения(ДатаПолученияДанных);
	
	РежимПотрбленияГазПоСчетчикам = лб_Сервер.РежимПотрбленияГазПоСчетчикам(ДатаПолученияДанных);
	
	
	ЛеваяЧасть = Новый ТабличныйДокумент;
	мМакет = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("лб_МакетЛеваяЧасть");
	ОбластьЧастьЛевСтрока = мМакет.ПолучитьОбласть("Область8|Область1");
	ОбластьчастьЛев10 = мМакет.ПолучитьОбласть("Область10|Область1");
	ОбластьчастьЛев11 = мМакет.ПолучитьОбласть("Область11|Область1");
	ОбластьчастьЛев12 = мМакет.ПолучитьОбласть("Область12|Область1");
	ОбластьчастьЛев13 = мМакет.ПолучитьОбласть("Область13|Область1");
	ОбластьчастьЛев14 = мМакет.ПолучитьОбласть("Область14|Область1");
	Если СтарыйМакет Тогда
		ОбластьЧастьЛев1 = мМакет.ПолучитьОбласть("Область7|Область1");
	Иначе
		ОбластьЧастьЛев1 = мМакет.ПолучитьОбласть("Область7Новый|Область1");
	КонецЕсли;
	ОбластьЧастьЛев2 = мМакет.ПолучитьОбласть("Область9|Область1");
	ОбластьЧастьQRКод = мМакет.ПолучитьОбласть("Область6|Область1");
	
	ПраваяЧасть = Новый ТабличныйДокумент;
	мМакет = Обработки.бит_ПечатьСчетИзвещенийБезРасширений.ПолучитьМакет("лб_МакетПраваяЧасть");
	ОбластьЧастьПрав1 = мМакет.ПолучитьОбласть("Область1|Область3");
