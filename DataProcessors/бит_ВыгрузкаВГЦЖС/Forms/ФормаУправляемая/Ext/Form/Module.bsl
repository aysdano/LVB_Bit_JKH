функция ПолучитьДокументНаЛьготу (ЛицевойСчет, ФизЛицо, Период)

 запрос = новый Запрос;
 
 запрос.Текст ="ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|бит_НачислениеПоЛьготамОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|бит_НачислениеПоЛьготамОбороты.Услуга КАК Услуга,
	|бит_НачислениеПоЛьготамОбороты.Льгота КАК Льгота,
	|бит_НачислениеПоЛьготамОбороты.ФизЛицо КАК ФизЛицо
	|ПОМЕСТИТЬ ТабНачислений
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПоЛьготам.Обороты(&НачалоПериода, &КонецПериода, , ) КАК бит_НачислениеПоЛьготамОбороты
	|ГДЕ
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет = &ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
	|	бит_ЛьготыПоЛССрезПоследних.Регистратор КАК Регистратор
	|ИЗ
	|	ТабНачислений КАК ТабНачислений
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&КонецПериода, ) КАК бит_СведенияПоУслугамЛССрезПоследних
	|		ПО ТабНачислений.ЛицевойСчет = бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет
	|			И ТабНачислений.Услуга = бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПаспортныеДанныеПроживающих.СрезПоследних(&КонецПериода, ) КАК бит_ПаспортныеДанныеПроживающихСрезПоследних
	|		ПО ТабНачислений.ФизЛицо = бит_ПаспортныеДанныеПроживающихСрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних КАК бит_ЛьготыПоЛССрезПоследних
	|		ПО ТабНачислений.ЛицевойСчет = бит_ЛьготыПоЛССрезПоследних.ЛицевойСчет
	|			И ТабНачислений.Льгота = бит_ЛьготыПоЛССрезПоследних.Льготы
	|			И ТабНачислений.ФизЛицо = бит_ЛьготыПоЛССрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&КонецПериода, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО ТабНачислений.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ФИОПроживающих.СрезПоследних(&КонецПериода, ) КАК бит_ФИОПроживающихСрезПоследних
	|		ПО ТабНачислений.ФизЛицо = бит_ФИОПроживающихСрезПоследних.ФизЛицо";
 
 Запрос.УстановитьПараметр("ЛицевойСчет"	, ЛицевойСчет.Ссылка);
 Запрос.УстановитьПараметр("НачалоПериода"	, НачалоМесяца(Период));
 Запрос.УстановитьПараметр("КонецПериода"	, КонецМесяца(Период));

 выборка = запрос.Выполнить().Выбрать();
 
 если выборка.Следующий() тогда
		
	запросПараметровДокументаЛьготы = новый Запрос;
 
    запросПараметровДокументаЛьготы.Текст =
	  "ВЫБРАТЬ
	  |	бит_ЛьготыПоЛССрезПоследних.Регистратор КАК Регистратор,
	  |	бит_ЛьготыПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	  |	бит_ЛьготыПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	  |	бит_ЛьготыПоЛССрезПоследних.Льготы КАК Льготы,
	  |	бит_ЛьготыПоЛССрезПоследних.СрокДействияЛьготы КАК СрокДействияЛьготы,
	  |	бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу КАК ДокументНаЛьготу,
	  |	бит_ЛьготыПоЛССрезПоследних.НомерДокумента КАК НомерДокумента,
	  |	бит_ЛьготыПоЛССрезПоследних.ДатаВыдачи КАК ДатаВыдачи,
	  |	бит_ЛьготыПоЛССрезПоследних.КемВыдан КАК КемВыдан,
	  |	бит_ЛьготыПоЛССрезПоследних.СерияДокумента КАК СерияДокумента
	  |ИЗ
	  |	РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних КАК бит_ЛьготыПоЛССрезПоследних
	  |ГДЕ
	  |	бит_ЛьготыПоЛССрезПоследних.Регистратор = &Регистратор
	  |	И бит_ЛьготыПоЛССрезПоследних.ФизЛицо = &ФизЛицо";

    запросПараметровДокументаЛьготы.УстановитьПараметр("Регистратор"	, выборка.Регистратор);
	запросПараметровДокументаЛьготы.УстановитьПараметр("ФизЛицо"	, ФизЛицо);

	выборкаПараметровДокументаЛьготы = запросПараметровДокументаЛьготы.Выполнить().Выбрать();
	
	если выборкаПараметровДокументаЛьготы.Следующий() тогда
		
	 параметрыДокументаЛьгот = Новый Структура();		
	 параметрыДокументаЛьгот.Вставить("ДатаВыдачи",выборкаПараметровДокументаЛьготы.ДатаВыдачи);
	 параметрыДокументаЛьгот.Вставить("Организация",выборкаПараметровДокументаЛьготы.КемВыдан);
	 параметрыДокументаЛьгот.Вставить("НомерДокумента", выборкаПараметровДокументаЛьготы.НомерДокумента);
