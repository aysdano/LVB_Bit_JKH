&НаСервереБезКонтекста
Процедура жж_СоздатьОтсутствующихЖильцов(Табл);
	Если ложь тогда Табл = новый таблицаЗначений КонецЕсли;
	ОтборБезЖильцов = новый структура("Игнорировать,Жилец",ложь, Справочники.бит_Проживающие.ПустаяСсылка());	
	СтрокиБезЖильцов = Табл.НайтиСтроки(ОтборБезЖильцов);
	
	Если СтрокиБезЖильцов.Количество()=0 тогда
		возврат
	КонецЕсли;
	
	    	
	
	ТаблБезЖильцов = Табл.Скопировать(СтрокиБезЖильцов,"FIO,NAME,OTCH,КлючЖильца,Жилец,ДатаРождения,SNILS,SOGL,PR,FAKT_ADR");
	ТаблБезЖильцов.Индексы.Добавить("КлючЖильца,ДатаРождения");	
		
	//Удаляем строки-дубли
	СписокПолей = "SNILS,SOGL,PR,FAKT_ADR";
	МассивПолей = СтрРазделить(СписокПолей,",");
		
	ТаблБезЖильцов.Сортировать("КлючЖильца,ДатаРождения УБЫВ");
	ЧислоСтрок = ТаблБезЖильцов.Количество();
	Для СчетВниз = 1 по ЧислоСтрок-1 цикл
		ТекСтрока = ТаблБезЖильцов[ЧислоСтрок - СчетВниз];
		ПредСтрока = ТаблБезЖильцов[ЧислоСтрок - СчетВниз-1];
		Если (ТекСтрока.КлючЖильца = ПредСтрока.КлючЖильца)  и (ТекСтрока.ДатаРождения = ПредСтрока.ДатаРождения) тогда
			Для каждого ИмяПоля из МассивПолей цикл
				Если ПустаяСтрока(ПредСтрока[ИмяПоля]) и не ПустаяСтрока(ТекСтрока[ИмяПоля]) тогда 
					ПредСтрока[ИмяПоля]= ТекСтрока[ИмяПоля];
				КонецЕсли;	
			КонецЦикла;	
			ТаблБезЖильцов.Удалить(ЧислоСтрок - СчетВниз);			
		КонецЕсли;	                                      		
	КонецЦикла;	
	
	
	ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Создание жильцов ( "+ СтрокиБезЖильцов.Количество() + " элем.)"); 

	
	//создаем проживающих
	Для каждого СтрокаЖ из ТаблБезЖильцов цикл
		СпрОбъект = Справочники.бит_Проживающие.СоздатьЭлемент();
		СпрОбъект.Наименование = СтрокаЖ.КлючЖильца;
		СпрОбъект.ДатаРождения = СтрокаЖ.ДатаРождения;
		СпрОбъект.СтраховойНомерПФР = СтрокаЖ.SNILS;
		СпрОбъект.Комментарий = СтрокаЖ.PR;
		СпрОбъект.ФактАдресПроживающего = СтрокаЖ.FAKT_ADR;
		Если СтрокаЖ.SOGL=" " тогда
			; //ничего не делаем
		ИначеЕсли СтрНайти("0OoОо",СтрокаЖ.SOGL)>0  тогда   //о - отказ, все похожие символы
			СпрОбъект.лб_СогласиеНаОбработкуПД = Перечисления.лб_ВидСогласияНаОбработкуПД.Отказ			
		ИначеЕсли СтрНайти("Пп",СтрокаЖ.SOGL)>0  тогда      //п - паспортный, все похожие символы
			СпрОбъект.лб_СогласиеНаОбработкуПД = Перечисления.лб_ВидСогласияНаОбработкуПД.ЕстьПаспортныйСтол;
		ИначеЕсли СтрНайти("3зЗЭэАаaA",СтрокаЖ.SOGL)>0  тогда   //з - заявление, а - абонентский, все похожие символы
			СпрОбъект.лб_СогласиеНаОбработкуПД = Перечисления.лб_ВидСогласияНаОбработкуПД.ЕстьАбонентскийОтдел;			
		КонецЕсли;	
		СпрОбъект.Записать();
		
		
		Запись = РегистрыСведений.бит_ФИОПроживающих.СоздатьМенеджерЗаписи();
		Запись.ФизЛицо = СпрОбъект.Ссылка;
		Запись.Период = макс('1900-01-01', СтрокаЖ.ДатаРождения);
		Запись.Фамилия = СтрокаЖ.FIO;
		Запись.имя = СтрокаЖ.NAME;
		Запись.Отчество = СтрокаЖ.OTCH;
		Запись.Записать(истина);   
		
		СтрокаЖ.Жилец = СпрОбъект.Ссылка;
	КонецЦикла;	
	
	//Заполняем проживающих в таблице
	Отбор = Новый структура("КлючЖильца,ДатаРождения");
	Для каждого СтрокаТ из СтрокиБезЖильцов цикл
		ЗаполнитьЗначенияСвойств(Отбор,СтрокаТ);
		НайденныеСтроки = ТаблБезЖильцов.НайтиСтроки(Отбор);
		Если НайденныеСтроки.Количество() > 0  тогда
			СтрокаТ.Жилец = НайденныеСтроки[0].Жилец;
		КонецЕсли;	
	КонецЦикла;	
	
КонецПроцедуры	



&НаКлиенте
Процедура жж_ОбработкаЗагруженныхДанныхРегистра(Команда)
	// Вставить содержимое обработчика.
	
	МассивСоответствияРО = ПолучитьМассивСтруктурСоответствия();
	ПроверитьИСопоставитьДанныеЖильцов(МассивСоответствияРО);

