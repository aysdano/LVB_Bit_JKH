#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	Если Параметры.Свойство("ЗаполнитьИзСправочникаЛицевыеСчета") Тогда
		
		Объект.ЛицевойСчет = Параметры.ЗаполнитьИзСправочникаЛицевыеСчета.ЛицевойСчет;
		
	КонецЕсли;	
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	ЭтоНовый = ?(Параметры.Ключ.Пустая(), Истина, Ложь);
	
	Если ЭтоНовый И НЕ ЗначениеЗаполнено(Параметры.ЗначениеКопирования) Тогда  
		
		Объект.Организация      = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");//глЗначениеПеременной("ОсновнаяОрганизация");
		Объект.Ответственный 	= бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь");//глЗначениеПеременной("глТекущийПользователь");
		
	КонецЕсли;
	
	// БИТ ЖКХ 14.01.2020
	// СтандартныеПодсистемы.ПодключаемыеКоманды
	ПодключаемыеКоманды.ПриСозданииНаСервере(ЭтаФорма);
	// Конец СтандартныеПодсистемы.ПодключаемыеКоманды

	//14.01.2020
	// СтандартныеПодсистемы.Печать.
//	УправлениеПечатью.ПриСозданииНаСервере(ЭтаФорма, Элементы.Печать);
	// Конец СтандартныеПодсистемы.Печать.
	Элементы.Печать.Вид = ВидГруппыФормы.Подменю;
	
КонецПроцедуры

&НаКлиенте
Процедура Подключаемый_ВыполнитьКомандуПечати(Команда)
	
    УправлениеПечатьюКлиент.ВыполнитьПодключаемуюКомандуПечати(Команда, ЭтаФорма, Объект);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если НЕ Объект.ЛицевойСчет.Пустая() Тогда
		
		Структура = СписокПроживающих(Объект.ЛицевойСчет);
		
		КоличествоСписокФизЛиц = Структура.КоличествоФизЛиц; 
		
		ЭтаФорма.мКолЧел = КоличествоСписокФизЛиц;
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура ЗаполнитьПоЛС(Команда)
	Если Не ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Лицевой счет не указан!");
		
		Возврат;
		
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(Объект.ФизЛицо) Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Не заполнено Физ. лицо!");
		
		Возврат;
		
	КонецЕсли;
	
	Если Объект.ФизическиеЛица.Количество() > 0 Тогда
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ЗаполнитьПоЛСЗавершение", ЭтотОбъект), "Табличная часть будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат;      
	КонецЕсли; 
	
	
	ЗаполнитьПоЛСФрагмент();
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЛСЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = РезультатВопроса ;
	Если Ответ = КодВозвратаДиалога.Нет Тогда
		
		Возврат;
		
	КонецЕсли;      
	
	ЗаполнитьПоЛСФрагмент();
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьПоЛСФрагмент()
	
	Перем Структура;
	
	Структура = СписокПроживающих(Объект.ЛицевойСчет);
	
	мСписокФизЛиц = Структура.КоличествоФизЛиц;
	
	ЭтаФорма.мКолЧел = мСписокФизЛиц;
	
	ЗаполнитьТабличнуюЧасть();
	
КонецПроцедуры

