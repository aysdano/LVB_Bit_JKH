&НаКлиенте
Процедура ОткрытьФайл(Команда)
	
	#Если НЕ ВебКлиент Тогда
		Если ЗначениеЗаполнено(ДанныеФайла) Тогда
			ОчиститьСообщения();
			
			//ИмяВрФайла = ПолучитьИмяВременногоФайла("xlsx");
			//ДанныеФайла.Записать(ИмяВрФайла);
			//ЗапуститьПриложение(ИмяВрФайла);
			
			КаталогВФ = КаталогВременныхФайлов();
			ИмяВрФайла = КаталогВФ + "\битГИСЖКХ\" + Строка(Объект.ШаблонВыгрузкиГИСЖКХ) + Формат(ТекущаяДата(), "ДФ='ддММггччммсс'") + ".xlsx";
			Попытка
				УдалитьФайлы(КаталогВФ + "\битГИСЖКХ");
			Исключение
			КонецПопытки;
			
			ТекстСообщения = НСтр("ru = 'Выполняется открытие файла. Подождите...'");
			Состояние(НСтр("ru = 'Запуск Excel.'"), , ТекстСообщения);

			Попытка
				Excel = Новый COMОбъект("Excel.Application");
			Исключение
				ТекстСообщения = НСтр("ru = 'Ошибка загрузки Microsoft Excel.'") + Символы.ПС + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат;
			КонецПопытки;
			
			Если Excel = Неопределено Тогда
				Возврат;
			КонецЕсли;
			
			Попытка
				ДанныеФайла.Записать(ИмяВрФайла);
				Книга			= Excel.Application.WorkBooks.Open(ИмяВрФайла);
				Excel.Visible	= Истина;
				Книга.Activate();
				// Меняем состояние окна Excel (Свернуть/Развернуть), чтобы переключить фокус.
				Excel.WindowState = -4140;
				Excel.WindowState = -4137;
				
			Исключение
				ТекстСообщения = НСтр("ru = 'Не удалось открыть Excel - .'") + Символы.ПС + ОписаниеОшибки();
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				
				Excel.Quit();
				
				Попытка
					УдалитьФайлы(КаталогВФ + "\битГИСЖКХ");
				Исключение
				КонецПопытки;

			КонецПопытки;
			
		КонецЕсли;	
	#Иначе
		Возврат;	
	#КонецЕсли

КонецПроцедуры

&НаКлиенте
Процедура ЗаменитьФайл(Команда)
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	Диалог.Заголовок = "Укажите файл";
	Диалог.Фильтр    = "(*.xlsx;*.xls)|*.xlsx;*.xls";
	ОписаниеОповещения = Новый ОписаниеОповещения("ПолучитьПутьФайлаЗаменыЗавершение", ЭтотОбъект);
	Диалог.Показать(ОписаниеОповещения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПолучитьПутьФайлаЗаменыЗавершение(ВыбранныйФайл, ВходящийКонтекст) Экспорт
	
	Если ТипЗнч(ВыбранныйФайл) = Тип("Массив") И ВыбранныйФайл.Количество() > 0 Тогда 
		Попытка
			ДанныеФайла = Новый ДвоичныеДанные(ВыбранныйФайл[0]);
			Модифицированность = Истина;
		Исключение
		КонецПопытки;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если НЕ ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли; 

	ПоказатьОповещениеПользователя("Чтение и подготовка данных...");
	
	СформироватьФайлСервер();
	
	Если СтруктураДанныхМакета.Количество() = 0 Тогда
		ОчиститьСообщения();
		ТекстСообщения = НСтр("ru = 'Отсутствуют настройки шаблона выгрузки ГИС ЖКХ.'");
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
		Возврат;	
	КонецЕсли;
	
	ПутьФайла = СформироватьФайлExcel();
	Если НЕ ПутьФайла = Неопределено Тогда
		ДанныеФайла = Новый ДвоичныеДанные(ПутьФайла);
		Модифицированность = Истина;
	КонецЕсли;
	НастройкиДоступа();
	Если НЕ ЗначениеЗаполнено(Каталог) Тогда
		Попытка
			УдалитьФайлы(ПутьФайла);
		Исключение
		КонецПопытки;
	КонецЕсли;
	
	Если ПутьФайла = Неопределено Тогда
		ТекстСообщения = НСтр("ru = 'Не удалось сформировать файл.'");
	Иначе	
		ТекстСообщения = НСтр("ru = 'Формирование файла завершено.'");
	КонецЕсли;
	
	ОчиститьСообщения();
	бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(ТекстСообщения);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборЗданий(Команда)
	
	ПарамОтбора = Новый Структура("ПометкаУдаления", Ложь);
	ПараметрыОткрытия = Новый Структура("РежимВыбора, МножественныйВыбор, ЗакрыватьПриВыборе, Отбор", Истина, Истина, Ложь, ПарамОтбора);
	ОткрытьФорму("Справочник.бит_СписокЗданий.ФормаВыбора", ПараметрыОткрытия, Элементы.СписокЗданий, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборУлиц(Команда)
	
	ПарамОтбора = Новый Структура("ПометкаУдаления", Ложь);
	ПараметрыОткрытия = Новый Структура("РежимВыбора, МножественныйВыбор, ЗакрыватьПриВыборе, Отбор", Истина, Истина, Ложь, ПарамОтбора);
	ОткрытьФорму("Справочник.бит_СписокУлиц.ФормаВыбора", ПараметрыОткрытия, Элементы.СписокУлиц, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура ПодборЛС(Команда)
	
	ПарамОтбора = Новый Структура("ПометкаУдаления, Архивный", Ложь, Ложь);
	ПараметрыОткрытия = Новый Структура("РежимВыбора, МножественныйВыбор, ЗакрыватьПриВыборе, Отбор", Истина, Истина, Ложь, ПарамОтбора);
	ОткрытьФорму("Справочник.бит_ЛицевыеСчета.ФормаВыбора", ПараметрыОткрытия, Элементы.СписокЛС, УникальныйИдентификатор);
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

&НаСервере
Процедура НастройкиДоступа()
	
	Если ЗначениеЗаполнено(Объект.Ссылка) И НЕ ПолучитьПрисоединенныйФайл(Объект.Ссылка) = Неопределено Тогда
		Элементы.ФормаОткрытьФайл.Доступность = Истина;
		Элементы.ФормаЗаменитьФайл.Доступность = Истина;
	ИначеЕсли ЗначениеЗаполнено(ДанныеФайла) Тогда
		Элементы.ФормаОткрытьФайл.Доступность = Истина;
		Элементы.ФормаЗаменитьФайл.Доступность = Истина;
	Иначе
		Элементы.ФормаОткрытьФайл.Доступность = Ложь;
		Элементы.ФормаЗаменитьФайл.Доступность = Ложь;
	КонецЕсли;	
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПолучитьПрисоединенныйФайл(Ссылка)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Ссылка, "ПрисоединенныйФайл").Получить();
	
КонецФункции

&НаКлиенте
Функция СформироватьФайлExcel()
	
	#Если НЕ ВебКлиент Тогда
		Если ЗначениеЗаполнено(Объект.ШаблонВыгрузкиГИСЖКХ) Тогда
			
			ДвоичныеДанные = ПолучитьМакетСтраницыСервер(Объект.ШаблонВыгрузкиГИСЖКХ);
			Если ДвоичныеДанные = Неопределено Тогда
				Возврат Неопределено;
			КонецЕсли;
			Если НЕ ЗначениеЗаполнено(Каталог) Тогда
				ПутьФайла = ПолучитьИмяВременногоФайла("xlsx");
			Иначе
				ПутьФайла = Каталог;
			КонецЕсли;
			
			
			Попытка
				ДвоичныеДанные.Записать(ПутьФайла);
			Исключение
				ТекстСообщения = НСтр("ru = 'Ошибка работы с файлом.'") + Символы.ПС + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()) + ".";
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				Возврат Неопределено;
			КонецПопытки;
		Иначе
			
			Возврат Неопределено;
			
		КонецЕсли;
		
		// Создадим приложение Excel.
		ЕстьОшибки = Ложь;
		Excel = бит_ВыгрузкаКлиент.СоздатьПриложениеExcel();
		Excel.DisplayAlerts = False;
		
		Если Excel = Неопределено Тогда
			Возврат Неопределено;
		КонецЕсли;
		
		Попытка
			Книга				= Excel.Application.WorkBooks.Open(ПутьФайла);
			МассивЛистовКниги	= Книга.WorkSheets;
			
			НомерСтраницыExcel	= 1; 										// Номер страницы в шаблоне Excel.
			КолВоСтраницВШаблоне= Дерево.ПолучитьЭлементы().Количество();   // Количество страниц в шаблоне разметки.
			
			// Обход страниц макета.
			Для Каждого ExcelЛист Из МассивЛистовКниги Цикл
				
				Если ExcelЛист.Visible = 0 Тогда
					Продолжить;	
				КонецЕсли;
				
				// ТаблицаШаблона.
				ИнфоТаблицыШаблона	= НайтиТиблицуШаблона(НомерСтраницыExcel);
				ТаблицаШаблона		= ИнфоТаблицыШаблона.ТаблицаШаблона;
				НомерСтраницыШаблона= ИнфоТаблицыШаблона.НомерСтраницыШаблона;
				Если ТаблицаШаблона = Неопределено Тогда
					НомерСтраницыExcel = НомерСтраницыExcel + 1;
					Продолжить; // Переходи к следующей странице Excel.
				КонецЕсли;
				ИмяТаблицыШаблона = ТаблицаШаблона.Поле;
				
				// Получение подготовленной таблицы данных.
				ТаблицаДанных = Новый Массив;
				ТаблицаДанных = СтруктураДанныхМакета.Получить(ИмяТаблицыШаблона);
				Если ТаблицаДанных = Неопределено ИЛИ ТаблицаДанных.Количество() = 0 Тогда
					НомерСтраницыExcel = НомерСтраницыExcel + 1;
					Продолжить;
				КонецЕсли;
				
				НомерНачальнойСтроки= ТаблицаШаблона.НомерНачальнойСтроки;
				НомерСтроки			= ТаблицаШаблона.НомерНачальнойСтроки;
				Если НомерСтроки = 0 Тогда
					НомерСтраницыExcel = НомерСтраницыExcel + 1;
					Продолжить;
				КонецЕсли;
				
				// Обход Данных.
				СтрокиТаблицыШаблона = ТаблицаШаблона.ПолучитьЭлементы();
				
				ВсегоСтрок	= ТаблицаДанных.Количество();
				ВсегоКолонок= НайтиПоследнююКолонку(СтрокиТаблицыШаблона);
				МассивКОМ	= Новый COMSafeArray("VT_VARIANT", ВсегоКолонок, ВсегоСтрок);
				НомерСтрокиМассива = 0;
				
				// Обход строк данных.
				Для Каждого СтрТДанных Из ТаблицаДанных Цикл
					////++Мельник 241121 Отбор по типу квартиры ЛС
					//Если СтрТДанных.Свойство("ЛицевойСчет") Тогда
					//	ПроверкаТипаКвартиры = ПроверитьТипКвартиры(СтрТДанных.ЛицевойСчет);
					//Иначе
					//	ПроверкаТипаКвартиры = Ложь;
					//КонецЕсли;
					//Если ПроверкаТипаКвартиры Тогда
					//	Продолжить;
					//КонецЕсли;
					////--Мельник 241121
					// Работа с индикатором.
					ТекстСообщения = НСтр("ru = 'Заполнение %1 страницы из %2.'");
					ТекстСообщения = СтрШаблон(ТекстСообщения, НомерСтраницыШаблона, КолВоСтраницВШаблоне); 
					ТекущийПроцент = Окр(НомерСтроки/ТаблицаДанных.Количество() * 100);
					Состояние(НСтр("ru = 'Загрузка Microsoft Excel...'"), ТекущийПроцент, ТекстСообщения);
					
					// Обход колонок шаблона.
					Для Каждого Элт Из СтрокиТаблицыШаблона Цикл
						
						Если Элт.СтраницаКолонка = 0 Тогда
							Продолжить;
						КонецЕсли;
						
						МассивКОМ.SetValue(Элт.СтраницаКолонка-1, НомерСтрокиМассива, СтрТДанных[Элт.Поле]);
						
					КонецЦикла; // Обход колонок шаблона.	
					//+! ГВВ пронумеруем строки шаблона оплат  Схема СКД + заполнение не позволяют нормально сделать
					Если  лев(ИмяТаблицыШаблона,14) = "Таблица оплаты" тогда
						МассивКОМ.SetValue(0,НомерСтрокиМассива, НомерСтрокиМассива+1);
					КонецЕсли;
					//-! ГВВ
					
					НомерСтрокиМассива = НомерСтрокиМассива + 1;
					НомерСтроки = НомерСтроки + 1;
					
					
				КонецЦикла; // Обход строк данных.
				
				Если ВсегоКолонок <> 0 Тогда
					ExcelЛист.Range(ExcelЛист.Cells(НомерНачальнойСтроки,1), ExcelЛист.Cells(НомерСтроки - 1,ВсегоКолонок)).Value = МассивКОМ;
				КонецЕсли;
				
				МассивКОМ = Неопределено;
				НомерСтраницыExcel = НомерСтраницыExcel + 1;
			КонецЦикла; // Обход страниц макета.
			
			Книга.ConflictResolution = 1;
			Книга.Save();
			Excel.Quit();
			
			Возврат ПутьФайла;
			
		Исключение
			ТекстСообщения = НСтр("ru = 'Не удалось заполнить лист Excel - .'") + Символы.ПС + ОписаниеОшибки();
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Excel.Quit();
			Возврат Неопределено;
			
		КонецПопытки;
	#Иначе
		Возврат Неопределено;
	#КонецЕсли
	
КонецФункции

&НаСервере
Функция ПроверитьТипКвартиры(ЛицевойСчет) //++ Мельник 241121 Проверяем соответствие типа квартиры с указанным отбором
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	
	Запрос.УстановитьПараметр("Дата", Объект.Дата);
	Запрос.УстановитьПараметр("Квартира", ЛицевойСчет.Квартира);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		
		Нежилое = ВыборкаДетальныеЗаписи.ТипКвартиры = Справочники.бит_ТипыКвартиры.НежилоеПомещение;
		Если Нежилые = Нежилое Тогда 
			Возврат Ложь;
		Иначе                 
			Возврат Истина;
		КонецЕсли;
		
	Иначе
		Возврат Истина;
	КонецЕсли;
		
КонецФункции

&НаКлиенте
Функция НайтиТиблицуШаблона(НомерСтраницы)
	
	Родители = Дерево.ПолучитьЭлементы();
	
	НомерСтраницыШаблона = 1;
	Для Каждого Элт Из Родители Цикл
		Если Элт.СтраницаКолонка = НомерСтраницы Тогда
			Возврат Новый Структура("ТаблицаШаблона, НомерСтраницыШаблона", Элт, НомерСтраницыШаблона);
		КонецЕсли;
		НомерСтраницыШаблона = НомерСтраницыШаблона + 1;
	КонецЦикла;
		
	Возврат Новый Структура("ТаблицаШаблона, НомерСтраницыШаблона", Неопределено, Неопределено);

КонецФункции

&НаСервереБезКонтекста
Функция ПолучитьМакетСтраницыСервер(ШаблонВыгрузкиГИСЖКХ)
	
	Возврат ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ШаблонВыгрузкиГИСЖКХ, "МакетСтраницы").Получить();
	
КонецФункции

&НаСервере
Процедура СформироватьФайлСервер()
	
	Архивный = ОбщегоНазначения.ЗначениеРеквизитаОбъекта(Объект.ШаблонВыгрузкиГИСЖКХ, "Архивный");
	Если ЗначениеЗаполнено(Архивный)
		И Архивный Тогда
		ТекстСообщения = НСтр("ru = 'Данные сформированы по устаревшему (архивному) шаблону!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	СоответствиеДанныхМакета = Новый Соответствие;
	
	ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.бит_ФайлыГИСЖКХ"));
	
	ДанныеМакета = ДокументОбъект.СформироватьДанныеФайла();
	
	ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	
	Для Каждого Таб Из ДанныеМакета Цикл
		Если Таб.Ключ = "Дерево" Тогда
			ЗначениеВРеквизитФормы(Таб.Значение, "Дерево");
			Продолжить;	
		КонецЕсли;
		СоответствиеДанныхМакета.Вставить(Таб.Ключ, ОбщегоНазначения.ТаблицаЗначенийВМассив(Таб.Значение));	
	КонецЦикла;
	СтруктураДанныхМакета = Новый ФиксированноеСоответствие(СоответствиеДанныхМакета);
	
КонецПроцедуры

