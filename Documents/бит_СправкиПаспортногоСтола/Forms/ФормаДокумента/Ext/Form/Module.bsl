&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция СформироватьОтчетНаСервере()
	
	ДокументРезультат = Новый ТабличныйДокумент;
	
	ПараметрыОтчета = ПодготовитьПараметрыОтчета();
	
	Если Объект.СправкаДанаДляПредоставления = Перечисления.бит_ВидСправкиДляПредоставления.ВВоенкомат Тогда
		
		ЗаполнитьСправкуВВоенкомат(ДокументРезультат, ПараметрыОтчета);
		
	ИначеЕсли Объект.СправкаДанаДляПредоставления = Перечисления.бит_ВидСправкиДляПредоставления.ВНотариальнуюКонтору Тогда
		
		ЗаполнитьСправкуВНотариальнуюКонтору(ДокументРезультат, ПараметрыОтчета);
		
	ИначеЕсли Объект.СправкаДанаДляПредоставления = Перечисления.бит_ВидСправкиДляПредоставления.ПоТребованию Тогда
		
		ЗаполнитьСправкуПоТребованию(ДокументРезультат, ПараметрыОтчета);
		
	КонецЕсли;
	
	Возврат ДокументРезультат;
	
КонецФункции // ()

&НаСервере
// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ЗаполнитьИнформациюОбОрганизации(Область, ПараметрыОтчета)
	
	Если НЕ (ЗначениеЗаполнено(ПараметрыОтчета.ЛицевойСчет) И ЗначениеЗаполнено(ПараметрыОтчета.Проживающий)) Тогда
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Заполните поля ЛицевойСчет и Проживающий");
		Возврат;
	КонецЕсли;
	
	Организация				= ПараметрыОтчета.Организация;
	СведенияОбОрганизации	= БухгалтерскийУчетПереопределяемый.СведенияОЮрФизЛице(ПараметрыОтчета.Организация);
	Здание					= ПараметрыОтчета.Здание;
