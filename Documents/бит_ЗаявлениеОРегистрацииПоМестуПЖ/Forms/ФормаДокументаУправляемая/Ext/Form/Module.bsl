&НаСервере
Функция ПроверитьВозраст(РегистрируемоеЛицо)
	ЗапросВозраст = Новый Запрос;
	ЗапросВозраст.Текст = "ВЫБРАТЬ
	|	бит_Проживающие.ДатаРождения КАК ДатаРождения
	|ИЗ
	|	Справочник.бит_Проживающие КАК бит_Проживающие
	|ГДЕ
	|	бит_Проживающие.Ссылка = &Ссылка";
	ЗапросВозраст.УстановитьПараметр("Ссылка", РегистрируемоеЛицо);
	
	Выборка = ЗапросВозраст.Выполнить().Выбрать();
	
	Если Выборка.Следующий() тогда
		
		ДатаРождения = Выборка.ДатаРождения;
		
		Возраст = Год(Объект.Дата) - Год(ДатаРождения);	
		
		ДеньДокумент = День(Текущаядата());
		МесяцДокумент = Месяц(ТекущаяДата());
		
		ДеньРождения = День(ДатаРождения);
		МесяцРождения = Месяц(ДатаРождения);
		
		Если МесяцРождения < МесяцДокумент ИЛИ (МесяцРождения = МесяцДокумент И ДеньРождения > ДеньДокумент) Тогда
			
			Возраст = Возраст - 1;
			
		КонецЕсли;
		
		Возврат (Возраст < 14);
	Иначе 
		Возврат Ложь;
	КонецЕсли;
	
КонецФункции

