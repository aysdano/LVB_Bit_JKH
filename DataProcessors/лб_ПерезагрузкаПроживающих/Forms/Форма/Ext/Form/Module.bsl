				ТаблП = НаборП.Выгрузить();
			КонецЕсли;	
			
						
			//обработка данных ЛС
			
			//СтрокаЛС = ТаблЛС.Найти(Выборка.ЛС,"ЛС");
			
			//Убираем старые записи
			Отбор = новый структура("ЛицевойСчет",Выборка.ЛС);
			СтрокиЛС = ТаблП.НайтиСтроки(Отбор);
			
			//Сообщить("ЛС " + Выборка.ЛС + " НАйдено записей - "+ СтрокиЛС.Количество());
			//Удаляем исходные строки
			Для каждого Строка из СтрокиЛС цикл
				Инд = ТаблП.Индекс(Строка);
				ТаблП.Удалить(Инд);			
			КонецЦикла;	        
			
			
						
			ОтборИсх = новый Структура("ЛС,Игнорировать",Выборка.ЛС,ложь);
			СтрокиИсх = ТаблИсх.НайтиСтроки(ОтборИсх);
