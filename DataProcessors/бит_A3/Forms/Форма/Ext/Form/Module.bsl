								НоваяСтрокаУС.ШаблонИзвещений = НоваяСтрокаЛС.ШаблонИзвещений;
								НоваяСтрокаУС.Услуга          = СтрокаТретьегоУрованя.ДатаОплаты_ЛицевойСчет_Услуга;
								НоваяСтрокаУС.Сумма           = СтрокаТретьегоУрованя.Сумма;
								
								СуммаИтогПоЛС = СуммаИтогПоЛС + СтрокаТретьегоУрованя.Сумма;
								
							КонецЕсли;
							
						КонецЦикла; 
						
						Если НЕ СуммаИтогПоЛС = ИтогПоЛС Тогда
							
							МассивЛС.Добавить(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга);
							
						КонецЕсли; 
						
						СуммаИтогПоДокументу = СуммаИтогПоДокументу + СуммаИтогПоЛС;
						НоваяСтрокаЛС.Сумма  = СуммаИтогПоЛС;
						
					КонецЕсли;
					
				КонецЕсли; 
			КонецЦикла; 
			
			Документ.СуммаДокумента = СуммаИтогПоДокументу;
			
			Документ.ЗапролнитьСчета();
			
