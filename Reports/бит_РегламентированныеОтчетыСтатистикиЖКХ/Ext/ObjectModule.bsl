// Заполняет указанный табличный документ по форме №26 по данным.
// В указанной структуре параметров.
Процедура ЗаполнитьДокумент_Ф26(ДокументРезультат, СведенияОбОрганизации)
	
	Макет = ПолучитьМакет("Форма26");
	
	// Титульный лист.
	ОбластьТитульный = Макет.ПолучитьОбласть("Титульный");
	ОбластьТитульный.Параметры.ТекМесяц = Формат(ТекущаяДата(), "ДФ='ММММ'");
	ОбластьТитульный.Параметры.ТекГод = Формат(ТекущаяДата(), "ДФ='гг'");
	ОбластьТитульный.Параметры.НаименованиеОрганизации  = СведенияОбОрганизации["Наименование"];
	ОбластьТитульный.Параметры.ПочтовыйАдресОрганизации = СведенияОбОрганизации["Адрес"];
	ОбластьТитульный.Параметры.КодПоОКПО                = СведенияОбОрганизации["КодПоОКПО"];
	ДокументРезультат.Вывести(ОбластьТитульный);
	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Раздел 1.
	ОбластьРаздел1_1 = Макет.ПолучитьОбласть("Раздел1_1");
	ДокументРезультат.Вывести(ОбластьРаздел1_1);
	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	ОбластьРаздел1_2 = Макет.ПолучитьОбласть("Раздел1_2");
	ДокументРезультат.Вывести(ОбластьРаздел1_2);
	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	
	// Справка.
	ОбластьСправочно= Макет.ПолучитьОбласть("Справочно");
	ДокументРезультат.Вывести(ОбластьСправочно);
	ДокументРезультат.ВывестиГоризонтальныйРазделительСтраниц();
	
	ДокументРезультат.ОриентацияСтраницы = ОриентацияСтраницы.Ландшафт;
	
Конецпроцедуры  // ЗаполнитьДокумент_Ф26()

#КонецОбласти