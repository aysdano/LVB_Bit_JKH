	Счет60_01   = ПланыСчетов.Хозрасчетный.НайтиПоКоду("60.01");
	
	СтруктураСчетов = Новый Структура;
	СтруктураСчетов.Вставить("Счет76_КУ",Счет76_КУ);
	СтруктураСчетов.Вставить("Счет86_03",Счет86_03);
