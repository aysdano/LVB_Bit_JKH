
Процедура ЗаменитьНаЧисловуюКолонку(ТАблицаЗначений, ИмяКолонки)  
	МасивКолонки = ТАблицаЗначений.ВыгрузитьКолонку(ИмяКолонки);   
	ТАблицаЗначений.Колонки.Удалить(ТАблицаЗначений.Колонки.Найти(ИмяКолонки));
	ТАблицаЗначений.Колонки.Добавить(ИмяКолонки, Новый ОписаниеТипов("Число"));  
	ТАблицаЗначений.ЗагрузитьКолонку(МасивКолонки, ИмяКолонки);
КонецПроцедуры  

&НаСервере
Функция СформироватьНаСервере()
	ТабДок = Новый ТабличныйДокумент;
	ТабДок.АвтоМасштаб = Истина;
	ТабДок.ОтображатьСетку = Ложь;
	
	ТабДок.ПолеСверху = 2;
	ТабДок.ПолеСлева = 2;
	ТабДок.ПолеСправа = 2;
	ТабДок.ПолеСнизу = 2;
	
	Обработка = РеквизитФормыВЗначение("Объект");
	Макет = Обработка.ПолучитьМакет("МакетЗадолжникиПоДому");
	
	ОбластьШапкаТипыУслуг = Макет.ПолучитьОбласть("ШапкаТипыУслуг");
	ОбластьШапкаАдресПериод = Макет.ПолучитьОбласть("ШапкаАдресПериод");
	ОбластьШапкаТЧ = Макет.ПолучитьОбласть("ШапкаТЧ");
	
	Если ПоказыватьЗадолженностьПоКапРемонту Тогда
		ОбластьСтрока = Макет.ПолучитьОбласть("Строка");
	Иначе
		ОбластьСтрока = Макет.ПолучитьОбласть("СтрокаБезКапРемонта");
	КонецЕсли;
	
	ОбластьПодвал = Макет.ПолучитьОбласть("Подвал");
	ОбластьОбъявление = Макет.ПолучитьОбласть("Объявление");
	ОбластьТелефонДляСправок = Макет.ПолучитьОбласть("ТелефонДляСправок");
	СтрокаЗаголовок = "";
		
	Если ЗначениеЗаполнено(УслугаГруппаУслуг) Тогда

		
		Для Каждого Услуга ИЗ УслугаГруппаУслуг Цикл
			
			СтрокаЗаголовок = СтрокаЗаголовок + Услуга.Значение + "; ";
			 
		КонецЦикла;
		
		Если ПоказыватьЗадолженностьПоКапРемонту Тогда
			СтрокаЗаголовок = СтрокаЗаголовок + КапРемонтГруппаУслуг + "; ";
		КонецЕсли;
		
		
	Иначе
		
		СтрокаЗаголовок = " все услуги";
		
	КонецЕсли;
	
	ОбластьШапкаТЧ.Параметры.Период = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy" );	
	Если ПоказыватьЗадолженностьПоКапРемонту Тогда
		ОбластьШапкаТЧ.Параметры.СтрокаКапРемонт = "Кап. ремонт > " + КоличествоМесяцевЗадолженностиПоКапРемонту  + " мес.";
	КонецЕсли;

	Данные = ПолучитьДанные();
	ЗаменитьНаЧисловуюКолонку(Данные, "ПодъездНаименование"); 
	//ТабДок.Вывести(ОбластьШапкаТипыУслуг);     
	Данные.Сортировать("Здание, ПодъездНаименование,НомеКвартиры");
	Подъезд = Неопределено;	
	Здание = Неопределено;
	ПерваяИтерация = Истина;
	
	Для Каждого СтрокаД Из Данные Цикл
		ПоказыватьЗадолженность = ?(ПоказыватьЗадолженностьПоКапРемонту, СтрокаД.ЗадолженностьКапРемонт > 0 ИЛИ СтрокаД.ЗадолженностьОДН > 0, СтрокаД.ЗадолженностьОДН > 0); 
		
		Если НЕ ПоказыватьЗадолженность ТОгда
			Продолжить;
		КонецЕсли;		
		
		Если ПоПодъездам И НЕ Подъезд = СтрокаД.Подъезд Тогда 
			 Если Не ПерваяИтерация Тогда
				ТабДок.Вывести(ОбластьПодвал);
				
				ТабДок.Вывести(ОбластьОбъявление);
				ОбластьТелефонДляСправок.Параметры.ТелефонДляСправок = СтрокаД.ТелефонДляСправок;
				ТабДок.Вывести(ОбластьТелефонДляСправок);
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();

			Иначе
				
				ОбластьОбъявление.Параметры.Объявление = Объявление;

			КонецЕсли;
			
			ПерваяИтерация = Ложь;
			
			ОбластьШапкаАдресПериод.Параметры.АдресДома = "" + СтрокаД.Здание + " подъезд " + СтрокаД.Подъезд;
			
			ТабДок.Вывести(ОбластьШапкаТипыУслуг);
			ТабДок.Вывести(ОбластьШапкаАдресПериод);
			ТабДок.Вывести(ОбластьШапкаТЧ);
			
			Подъезд = СтрокаД.Подъезд;
			Здание = СтрокаД.Здание;	

		ИначеЕсли НЕ Здание = СтрокаД.Здание Тогда
			Если Не ПерваяИтерация Тогда
				ТабДок.Вывести(ОбластьПодвал);
				
				ТабДок.Вывести(ОбластьОбъявление);
				ОбластьТелефонДляСправок.Параметры.ТелефонДляСправок = СтрокаД.ТелефонДляСправок;
				ТабДок.Вывести(ОбластьТелефонДляСправок);
				ТабДок.ВывестиГоризонтальныйРазделительСтраниц();

			Иначе
				
				ОбластьОбъявление.Параметры.Объявление = Объявление;

			КонецЕсли;
			
			ПерваяИтерация = Ложь;
			
			ОбластьШапкаАдресПериод.Параметры.АдресДома = СтрокаД.Здание;
			ТабДок.Вывести(ОбластьШапкаТипыУслуг);
			ТабДок.Вывести(ОбластьШапкаАдресПериод);
			ТабДок.Вывести(ОбластьШапкаТЧ);
			
			Подъезд = СтрокаД.Подъезд;
			Здание = СтрокаД.Здание;	
						
		КонецЕсли;
		
		ОбластьСтрока.Параметры.Квартира = СтрокаД.Квартира;
		Если СтрокаД.ЗадолженностьКапРемонт >= 0
			И ПоказыватьЗадолженностьПоКапРемонту 
			ТОГДА 
			ОбластьСтрока.Параметры.СуммаКапРемонт = СтрокаД.ЗадолженностьКапРемонт;
		КонецЕсли;
	
		ОбластьСтрока.Параметры.СуммаОДН =  ?(СтрокаД.ЗадолженностьОДН>0, СтрокаД.ЗадолженностьОДН, 0);
				
		ТабДок.Вывести(ОбластьСтрока);
		
	КонецЦикла;
	
	Если НЕ (ПерваяИтерация) ТОгда
		
		ТабДок.Вывести(ОбластьПодвал);
		ТабДок.Вывести(ОбластьОбъявление);
		ОбластьТелефонДляСправок.Параметры.ТелефонДляСправок = СтрокаД.ТелефонДляСправок;
		ТабДок.Вывести(ОбластьТелефонДляСправок);
		ТабДок.ВывестиГоризонтальныйРазделительСтраниц();

	КонецЕсли;
	
	Возврат ТабДок;
	
КонецФункции

&НаКлиенте
Процедура Сформировать(Команда)
	
	Если (ЗначениеЗаполнено(Адрес) Или (ЗначениеЗаполнено(Участок) И УчастокПодходит(Участок))) 
	И ЗначениеЗаполнено(Период) Тогда
		ТаблиичныйДокументРез = СформироватьНаСервере();
		ТаблиичныйДокументРез.Показать();
	Иначе
	 	Сообщить("Для формирования отчета необходимо установить отбор на период. И либо отбор на адрес, либо на подходящий участок");
	КонецЕсли;

КонецПроцедуры

Функция ЗависимыеЛС(ЛицевыеСчета)
	ЗапросАрхивные = Новый Запрос;
	ЗапросАрхивные.Текст = "ВЫБРАТЬ
	                       |	бит_ЛицевыеСчета.Ссылка КАК Ссылка
	                       |ИЗ
	                       |	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	                       |ГДЕ
	                       |	бит_ЛицевыеСчета.Ссылка В(&ЛицевыеСчета)
	                       |	И НЕ бит_ЛицевыеСчета.Архивный";
	
	ЗапросАрхивные.УстановитьПараметр("ЛицевыеСчета", ЛицевыеСчета);
	
	ЛСНА = ЗапросАрхивные.Выполнить().выгрузить();
	ЛСНА = ЛСНА.Скопировать(, "Ссылка");
	
	ЗапросЗависимыеЛС = Новый Запрос;
	ЗапросЗависимыеЛС.Текст = "ВЫБРАТЬ
	                          |	бит_ЗависимыеЛС.ЛицевойСчетЗависимый КАК ЛицевойСчетЗависимый
	                          |ИЗ
	                          |	РегистрСведений.бит_ЗависимыеЛС КАК бит_ЗависимыеЛС
	                          |ГДЕ
	                          |	бит_ЗависимыеЛС.ЛицевойСчет В(&ЛицевыеСчета)
	                          |	И НЕ бит_ЗависимыеЛС.ЛицевойСчетЗависимый.Архивный";
	
	ЗапросЗависимыеЛС.УстановитьПараметр("ЛицевыеСчета", ЛСНА);
	 
	ВыборкаЗависимыеЛС = ЗапросЗависимыеЛС.Выполнить().Выбрать();
	
	ЛСРезультат = Новый Массив;
	
	Для Каждого ЛС Из ЛСНА Цикл
		ЛСРезультат.Добавить(ЛС);	
	КонецЦикла;
	 
	Пока ВыборкаЗависимыеЛС.Следующий() Цикл
		
		ЛСРезультат.Добавить(ВыборкаЗависимыеЛС.ЛицевойСчетЗависимый);
		
	КонецЦикла;
	
	Возврат ЛСРезультат; 
	
КонецФункции

Функция ПолучитьДанные()
	
	Адреса = Новый Массив;
	Если ЗначениеЗаполнено(Адрес) Тогда
		
		Адреса.Добавить(Адрес);
	
	КонецЕсли;
	
	Если УчастокПодходит(Участок) Тогда
		ЗапросЗданияПоУчастку = Новый Запрос;
		ЗапросЗданияПоУчастку.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                              |	бит_СписокЗданий.Ссылка КАК Ссылка
	                              |ИЗ
	                              |	Справочник.бит_СписокЗданий КАК бит_СписокЗданий
	                              |ГДЕ
	                              |	бит_СписокЗданий.Участок В(&Участки)";
		ЗапросЗданияПоУчастку.УстановитьПараметр("Участки", Участок);
	
		ВыборкаЗдания = ЗапросЗданияПоУчастку.Выполнить().Выбрать();
	
		Пока ВыборкаЗдания.Следующий() Цикл
		
			Адреса.Добавить(ВыборкаЗдания.Ссылка);
		
		КонецЦикла;
	КонецЕсли;

	УслугиПараметр = Новый Массив;
	
	Для Каждого Услуга ИЗ УслугаГруппаУслуг Цикл
		
		УслугиПараметр.Добавить(Услуга.Значение);
		
	КонецЦикла;
	
	УслугиПараметр.Добавить(КапРемонтГруппаУслуг);

	ЗапросУслуги = Новый Запрос;
	ЗапросУслуги.Текст = "ВЫБРАТЬ
	                     |	бит_УслугиЖКХ.Ссылка КАК Ссылка
	                     |ИЗ
	                     |	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
	                     |ГДЕ
	                     |	(бит_УслугиЖКХ.Ссылка В (&Услуги)
	                     |			ИЛИ бит_УслугиЖКХ.ГруппаУслуги В (&Услуги))";
	
	ЗапросУслуги.УстановитьПараметр("Услуги", УслугиПараметр);
	
	ВыборкаУслуги = ЗапросУслуги.Выполнить().Выбрать();
	
	Услуги = Новый Массив;
	
	Пока ВыборкаУслуги.Следующий() Цикл
		Услуги.Добавить(ВыборкаУслуги.Ссылка);		
	КонецЦикла;
	
	ТипыПомещенийМ = Новый Массив;
	
	Для Каждого Тип Из ТипыПомещений Цикл
		
		ТипыПомещенийМ.Добавить(Тип.Значение);
		
	КонецЦикла;
	
	ЗапросЛицевыеСчета = Новый Запрос;
	ЗапросЛицевыеСчета.Текст = "ВЫБРАТЬ РАЗЛИЧНЫЕ
	                           |	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет
	                           |ИЗ
	                           |	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &ОкончаниеПериода, Месяц, , ЛицевойСчет.Здание В (&Адреса)) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	                           |ГДЕ
	                           |		ВЫБОР
	                           |			КОГДА &УслугиЗаполнены > 0
	                           |				ТОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ В(&Услуги)
	                           |			ИНАЧЕ ИСТИНА
	                           |		КОНЕЦ";
	ЗапросЛицевыеСчета.УстановитьПараметр("НачалоПериода", Период.ДатаНачала);
	ЗапросЛицевыеСчета.УстановитьПараметр("ОкончаниеПериода", Период.ДатаОкончания);
	ЗапросЛицевыеСчета.УстановитьПараметр("Услуги", Услуги);
	ЗапросЛицевыеСчета.УстановитьПараметр("УслугиЗаполнены", Услуги.Количество());
	ЗАпросЛицевыеСчета.УстановитьПараметр("Адреса", Адреса);
	
	ВыборкаЛицевыеСчета = ЗапросЛицевыеСчета.Выполнить().Выбрать();
	
	ЛС = Новый Массив;
	
	Пока ВыборкаЛицевыеСчета.Следующий() Цикл
		
		ЛС.Добавить(ВыборкаЛицевыеСчета.ЛицевойСчет);
		
	КонецЦикла;
	
	РежимПотребленияНеНачислять = Справочники.бит_РежимыПотребленияУслуг.НайтиПоНаименованию("Не начислять");
	ТипКвартирыМуниципальная = Справочники.бит_СтатусыКвартиры.НайтиПоНаименованию("Муниципальная");

	ВсеЛС = ЗависимыеЛС(ЛС);
	ОсновнойЗапрос = Новый Запрос;
	ОсновнойЗапрос.Текст = "ВЫБРАТЬ
	                       |	ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ, 0) КАК УслугаЖКХ,
	                       |	ВЫБОР
	                       |		КОГДА &ОкончаниеПериода <= &ТекДата
	                       |			ТОГДА ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток, 0)
	                       |		ИНАЧЕ ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток, 0)
	                       |	КОНЕЦ КАК СуммаКонечныйОстаток,
	                       |	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаПриход КАК СуммаПриход,
	                       |	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет.Квартира КАК ЛицевойСчетКвартира,
	                       |	ВЫБОР
	                       |		КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ.ГруппаУслуги = &ГруппаКапРемонт
	                       |			ТОГДА ""КапРемонт""
	                       |		КОГДА бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ.ГруппаУслуги = &ГруппаОДН
	                       |			ТОГДА ""ОДН""
	                       |	КОНЕЦ КАК ГруппаУслуг,
	                       |	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет КАК ЛицевойСчет
	                       |ПОМЕСТИТЬ ВТ_КоличествоМесяцевЗадолженности
	                       |ИЗ
	                       |	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(
	                       |			&НачалоПериода,
	                       |			&ОкончаниеПериода,
	                       |			,
	                       |			,
	                       |			ЛицевойСчет В (&ЛицевыеСчета)
	                       |				И ВЫБОР
	                       |					КОГДА &УслугиЗаполнены > 0
	                       |						ТОГДА УслугаЖКХ В (&Услуги)
	                       |					ИНАЧЕ ИСТИНА
	                       |				КОНЕЦ) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
	                       |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(
	                       |				&ТекДата,
	                       |				ЛицевойСчет В (&ЛицевыеСчета)
	                       |					И ВЫБОР
	                       |						КОГДА &УслугиЗаполнены > 0
	                       |							ТОГДА УслугаЖКХ В (&Услуги)
	                       |						ИНАЧЕ ИСТИНА
	                       |					КОНЕЦ) КАК бит_НачисленияПоУслугамЖКХОстатки
	                       |		ПО бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет = бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет
	                       |			И (бит_НачисленияПоУслугамЖКХОстатки.УслугаЖКХ = бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ)
	                       |;
	                       |
	                       |////////////////////////////////////////////////////////////////////////////////
	                       |ВЫБРАТЬ
	                       |	бит_НачисленияПоУслугамЖКХ.ЛицевойСчет КАК ЛицевойСчет,
	                       |	бит_НачисленияПоУслугамЖКХ.УслугаЖКХ КАК УслугаЖКХ,
	                       |	СУММА(ЕСТЬNULL(бит_НачисленияПоУслугамЖКХ.Сумма, 0)) КАК Сумма
	                       |ПОМЕСТИТЬ ВТ_ПоложительныеРазовые
	                       |ИЗ
	                       |	РегистрНакопления.бит_НачисленияПоУслугамЖКХ КАК бит_НачисленияПоУслугамЖКХ
	                       |ГДЕ
	                       |	бит_НачисленияПоУслугамЖКХ.Период МЕЖДУ &НачалоПериода И &ОкончаниеПериода
