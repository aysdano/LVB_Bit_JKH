	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ ВТ_Здания КАК ВТ_Здания
	        |		ПО ВТ_ЛицевыеСчета.Здание = ВТ_Здания.ЗданиеСсылка
	        |
	        |УПОРЯДОЧИТЬ ПО
	        |	Здание,
	        |	Квартира";
			
КонецФункции

Функция ТекстЗапросаДанныеПоЛСДо()
	Возврат "ВЫБРАТЬ
	        |	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	        |	МАКСИМУМ(ВЫБОР
	        |			КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &ХВ
	        |				ТОГДА бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка
	        |			ИНАЧЕ 0
	        |		КОНЕЦ) КАК ТарифХВ,
	        |	МАКСИМУМ(ВЫБОР
	        |			КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &ГВ
	        |				ТОГДА бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка
	        |			ИНАЧЕ 0
	        |		КОНЕЦ) КАК ТарифГВ,
	        |	МАКСИМУМ(ВЫБОР
	        |			КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &ВО
	        |				ТОГДА бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка
	        |			ИНАЧЕ 0
	        |		КОНЕЦ) КАК ТарифВО,
	        |	МАКСИМУМ(ВЫБОР
	        |			КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &ЭЛ
	        |				ТОГДА бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка
	        |			ИНАЧЕ 0
	        |		КОНЕЦ) КАК ТарифЭЛ,
	        |	бит_СтавкиНаУслугиСрезПоследних.РежимПотребления КАК РежимПотребления,
	        |	бит_СтавкиНаУслугиСрезПоследних.СпособРасчета КАК СпособРасчета,
	        |	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
	        |	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
	        |	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь КАК ОбщаяПлощадь,
	        |	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь КАК ЖилаяПлощадь,
	        |	бит_СведенияОКвартиреСрезПоследних.лб_НеВыводитьСтрокуДомофон КАК лб_НеВыводитьСтрокуДомофон,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаХВ КАК СтоимостьКубаХВ,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКВтч КАК СтоимостьКВтч,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаВО КАК СтоимостьКубаВО,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьГКалл КАК СтоимостьГКалл,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаХВнаГВ КАК СтоимостьКубаХВнаГВ,
	        |	лб_НормативыОДНСрезПоследних.НормативХВ КАК НормативХВ,
	        |	лб_НормативыОДНСрезПоследних.НормативГВ КАК НормативГВ,
	        |	лб_НормативыОДНСрезПоследних.НормативВО КАК НормативВО,
	        |	лб_НормативыОДНСрезПоследних.НормативЭЭ КАК НормативЭЭ,
	        |	лб_НормативыОДНСрезПоследних.НормативНаПодогрев КАК НормативНаПодогрев,
	        |	ВЫБОР
	        |		КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &УслугаМинВзнос
	        |			ТОГДА бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка
	        |		ИНАЧЕ 0
	        |	КОНЕЦ КАК ТарифМинВзнос
	        |ИЗ
	        |	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
	        |			&Период,
	        |			ЛицевойСчет = &ЛицевойСчет
	        |				И Услуга В (&Услуга)) КАК бит_СведенияПоУслугамЛССрезПоследних
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(&Период, Услуга В (&Услуга)) КАК бит_СтавкиНаУслугиСрезПоследних
	        |		ПО бит_СведенияПоУслугамЛССрезПоследних.Услуга = бит_СтавкиНаУслугиСрезПоследних.Услуга
	        |			И бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления = бит_СтавкиНаУслугиСрезПоследних.РежимПотребления
	        |			И бит_СведенияПоУслугамЛССрезПоследних.Поставщик = бит_СтавкиНаУслугиСрезПоследних.Поставщик
	        |			И бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета = бит_СтавкиНаУслугиСрезПоследних.СпособРасчета
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Период, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних
	        |		ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.лб_НормативыОДН.СрезПоследних(&Период, Адрес = &Здание) КАК лб_НормативыОДНСрезПоследних
	        |		ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Здание = лб_НормативыОДНСрезПоследних.Адрес
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
	        |	бит_СтавкиНаУслугиСрезПоследних.РежимПотребления,
	        |	бит_СтавкиНаУслугиСрезПоследних.СпособРасчета,
	        |	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	        |	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	        |	бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь,
	        |	бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь,
	        |	бит_СведенияОКвартиреСрезПоследних.лб_НеВыводитьСтрокуДомофон,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаХВ,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКВтч,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаВО,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьГКалл,
	        |	лб_НормативыОДНСрезПоследних.СтоимостьКубаХВнаГВ,
	        |	лб_НормативыОДНСрезПоследних.НормативХВ,
	        |	лб_НормативыОДНСрезПоследних.НормативГВ,
	        |	лб_НормативыОДНСрезПоследних.НормативВО,
	        |	лб_НормативыОДНСрезПоследних.НормативЭЭ,
	        |	лб_НормативыОДНСрезПоследних.НормативНаПодогрев,
	        |	ВЫБОР
	        |		КОГДА бит_СтавкиНаУслугиСрезПоследних.Услуга = &УслугаМинВзнос
	        |			ТОГДА бит_СтавкиНаУслугиСрезПоследних.ОсновнаяСтавка
	        |		ИНАЧЕ 0
	        |	КОНЕЦ";
КонецФункции

Функция ТекстЗапросаНачисленияПоЛС()
	
	Возврат "ВЫБРАТЬ
	        |	бит_НачисленияПоУслугамЖКХОбороты.Регистратор КАК Регистратор,
	        |	бит_НачисленияПоУслугамЖКХОбороты.Регистратор.СуммаДокумента КАК РегистраторСуммаДокумента,
	        |	ВЫБОР
	        |		КОГДА бит_ОплатаКУСписокУслуг.Ссылка ЕСТЬ NULL
	        |				ИЛИ бит_ОплатаКУСписокУслуг.Сумма = 0
	        |			ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаПриход
	        |		ИНАЧЕ бит_ОплатаКУСписокУслуг.Сумма
	        |	КОНЕЦ КАК СуммаПриход,
	        |	ВЫБОР
	        |		КОГДА бит_ОплатаКУСписокУслуг.Ссылка ЕСТЬ NULL
	        |				ИЛИ бит_ОплатаКУСписокУслуг.Сумма = 0
	        |			ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаРасход
	        |		ИНАЧЕ бит_ОплатаКУСписокУслуг.Сумма
	        |	КОНЕЦ КАК СуммаРасход,
	        |	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ КАК УслугаЖКХ,
	        |	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	        |	бит_НачисленияПоУслугамЖКХОбороты.Регистратор.Дата КАК РегистраторДата,
	        |	бит_НачисленияПоУслугамЖКХОбороты.Регистратор.Номер КАК РегистраторНомер,
	        |	ВЫБОР
	        |		КОГДА бит_ОплатаКУСписокУслуг.Ссылка ЕСТЬ NULL
	        |				ИЛИ бит_ОплатаКУСписокУслуг.Сумма = 0
	        |			ТОГДА 0
	        |		ИНАЧЕ бит_ОплатаКУСписокУслуг.НомерСтроки
	        |	КОНЕЦ КАК НомерСтрокиВОплатаКУ
	        |ПОМЕСТИТЬ ВТ_Начисления_Оплаты
	        |ИЗ
	        |	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(
	        |			&ДатаНачала,
	        |			&ДатаОкончания,
	        |			Регистратор,
	        |			УслугаЖКХ В (&Услуга)
	        |				И ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОбороты
	        |		ЛЕВОЕ СОЕДИНЕНИЕ Документ.бит_ОплатаКУ.СписокУслуг КАК бит_ОплатаКУСписокУслуг
	        |		ПО бит_НачисленияПоУслугамЖКХОбороты.Регистратор = бит_ОплатаКУСписокУслуг.Ссылка
	        |			И бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет = бит_ОплатаКУСписокУслуг.ЛицевойСчет
	        |			И бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ = бит_ОплатаКУСписокУслуг.Услуга
	        |			И (бит_ОплатаКУСписокУслуг.Сумма <> 0)
	        |ГДЕ
	        |	ВЫБОР
	        |			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	        |				ТОГДА ЛОЖЬ
	        |			ИНАЧЕ ИСТИНА
	        |		КОНЕЦ
	        |
	        |ИНДЕКСИРОВАТЬ ПО
	        |	ЛицевойСчет
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	ВТ_Начисления_Оплаты.ЛицевойСчет КАК ЛицевойСчет,
	        |	ВТ_Начисления_Оплаты.УслугаЖКХ КАК УслугаЖКХ,
	        |	ВТ_Начисления_Оплаты.Регистратор КАК Регистратор,
	        |	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ ВТ_Начисления_Оплаты.НомерСтрокиВОплатаКУ) КАК НомерСтрокиВОплатаКУ
	        |ПОМЕСТИТЬ ВТ_КоличествоСтрокВОплатаКУ
	        |ИЗ
	        |	ВТ_Начисления_Оплаты КАК ВТ_Начисления_Оплаты
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	ВТ_Начисления_Оплаты.ЛицевойСчет,
	        |	ВТ_Начисления_Оплаты.УслугаЖКХ,
	        |	ВТ_Начисления_Оплаты.Регистратор
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	бит_ПериодыОплатыКУ.Регистратор КАК Регистратор,
	        |	бит_ПериодыОплатыКУ.ДокОплаты КАК ДокОплаты,
	        |	бит_ПериодыОплатыКУ.ЛицевойСчет КАК ЛицевойСчет,
	        |	МАКСИМУМ(бит_ПериодыОплатыКУ.ПериодОплаты) КАК ПериодОплаты
	        |ПОМЕСТИТЬ ВТ_ПериодыОплаты
	        |ИЗ
	        |	ВТ_Начисления_Оплаты КАК ВТ_Начисления_Оплаты
	        |		ВНУТРЕННЕЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПериодыОплатыКУ КАК бит_ПериодыОплатыКУ
	        |		ПО ВТ_Начисления_Оплаты.Регистратор = бит_ПериодыОплатыКУ.ДокОплаты
	        |			И ВТ_Начисления_Оплаты.ЛицевойСчет = бит_ПериодыОплатыКУ.ЛицевойСчет
	        |
	        |СГРУППИРОВАТЬ ПО
	        |	бит_ПериодыОплатыКУ.ДокОплаты,
	        |	бит_ПериодыОплатыКУ.Регистратор,
	        |	бит_ПериодыОплатыКУ.ЛицевойСчет
	        |;
	        |
	        |////////////////////////////////////////////////////////////////////////////////
	        |ВЫБРАТЬ
	        |	СУММА(ВТ_Начисления_Оплаты.СуммаПриход) КАК СуммаНачислено,
	        |	СУММА(ВТ_Начисления_Оплаты.СуммаРасход) КАК СуммаОплачено,
	        |	ВТ_Начисления_Оплаты.УслугаЖКХ КАК УслугаЖКХ,
	        |	ВТ_Начисления_Оплаты.ЛицевойСчет КАК ЛицевойСчет,
	        |	ЕСТЬNULL(ВТ_ПериодыОплаты.ПериодОплаты, НАЧАЛОПЕРИОДА(ВТ_Начисления_Оплаты.Регистратор.Дата, МЕСЯЦ)) КАК ПериодОплаты,
	        |	ВЫБОР
	        |		КОГДА ВТ_Начисления_Оплаты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	        |				И ВТ_Начисления_Оплаты.Регистратор.лб_ВидОплаты = &ВидОплаты
	        |				И ВТ_Начисления_Оплаты.Регистратор.СуммаДокумента = 0
	        |			ТОГДА КОНЕЦПЕРИОДА(&ДатаОкончания, МЕСЯЦ)
	        |		КОГДА ВТ_Начисления_Оплаты.Регистратор ССЫЛКА Документ.бит_НачислениеПоЛицевымСчетам
	        |			ТОГДА &ДатаПроизв
	        |		ИНАЧЕ ВТ_Начисления_Оплаты.Регистратор.Дата
	        |	КОНЕЦ КАК РегистраторДата,
	        |	ВЫБОР
	        |		КОГДА ЕСТЬNULL(ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.СуммаОборот, 0) > 0
	        |				ИЛИ ВТ_Начисления_Оплаты.Регистратор.лб_ВидОплаты.Наименование ПОДОБНО ""%Исполнительные листы%""
	        |			ТОГДА ИСТИНА
	        |		ИНАЧЕ ЛОЖЬ
	        |	КОНЕЦ КАК ЭтоИсполнительныйЛист,
	        |	ВТ_Начисления_Оплаты.РегистраторНомер КАК РегистраторНомер,
	        |	ВЫБОР
	        |		КОГДА ВТ_КоличествоСтрокВОплатаКУ.НомерСтрокиВОплатаКУ > 1
	        |			ТОГДА ВТ_Начисления_Оплаты.НомерСтрокиВОплатаКУ
	        |		ИНАЧЕ 0
	        |	КОНЕЦ КАК НомерСтрокиВОплатаКУ,
	        |	ВЫБОР
	        |		КОГДА НЕ ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.ИсполнительныйЛист ЕСТЬ NULL
	        |			ТОГДА ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.ИсполнительныйЛист.ПериодОбразованияЗадолженностиОт
	        |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	        |	КОНЕЦ КАК ДатаИсполнительногоЛистаОт,
	        |	ВЫБОР
	        |		КОГДА НЕ ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.ИсполнительныйЛист ЕСТЬ NULL
	        |			ТОГДА ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.ИсполнительныйЛист.ПериодОбразованияЗадолженностиПо
	        |		ИНАЧЕ ДАТАВРЕМЯ(1, 1, 1)
	        |	КОНЕЦ КАК ДатаИсполнительногоЛистаПо
	        |ПОМЕСТИТЬ ВТ1
	        |ИЗ
	        |	ВТ_Начисления_Оплаты КАК ВТ_Начисления_Оплаты
	        |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.ВзаиморасчетыПоИсполнительномуПроизводству.Обороты(&ДатаНачала, &ДатаОкончания, Регистратор, ) КАК ВзаиморасчетыПоИсполнительномуПроизводствуОбороты
	        |		ПО ВТ_Начисления_Оплаты.Регистратор = ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.Регистратор
	        |			И ВТ_Начисления_Оплаты.УслугаЖКХ = ВзаиморасчетыПоИсполнительномуПроизводствуОбороты.Услуга
