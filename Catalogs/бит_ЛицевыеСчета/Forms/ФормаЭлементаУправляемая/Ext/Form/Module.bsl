&НаКлиенте
Процедура ТаблицаКомнатЗначенийПередУдалением(Элемент, Отказ)
	
	Отказ = Истина;
	
	ТекущиеДанные = Элементы.ТаблицаКомнатЗначений.ТекущиеДанные;
	
	Если ТекущиеДанные.НомерКартинки = 1 Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ТаблицаКомнатЗначенийПередУдалениемЗавершение1", ЭтотОбъект, Новый Структура("ТекущиеДанные", ТекущиеДанные)), "Пометить элемент на удаление?", РежимДиалогаВопрос.ДаНет);
		
	Иначе
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ТаблицаКомнатЗначенийПередУдалениемЗавершение", ЭтотОбъект, Новый Структура("Ответ, ТекущиеДанные", Ответ, ТекущиеДанные)), "Снять с элемента пометку на удаление?", РежимДиалогаВопрос.ДаНет);
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКомнатЗначенийПередУдалениемЗавершение1(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Результат = ПометитьКомнатуНаУдалениеНаСервере(ТекущиеДанные.Ссылка);
		
		Если Результат Тогда
			
			ТекущиеДанные.НомерКартинки = 2;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКомнатЗначенийПередУдалениемЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Ответ = ДополнительныеПараметры.Ответ;
	ТекущиеДанные = ДополнительныеПараметры.ТекущиеДанные;
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		
		Результат = СнятьКомнатуСПометкиНаУдалениеНаСервере(ТекущиеДанные.Ссылка);
		
		Если Результат Тогда
			
			ТекущиеДанные.НомерКартинки = 1;
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКомнатЗначенийПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Отказ = Истина;
	
	Основание = Новый Структура;
	
	Основание.Вставить("Владелец", Объект.Квартира);
	
	Если Копирование Тогда
		
		ТекДанные = Элементы.ТаблицаКомнатЗначений.ТекущиеДанные;
		
		Если НЕ ТекДанные = Неопределено Тогда
			
			НомерКомнаты    = ПолучитьКвартираНомерКомнатыНаСервере(ТекДанные.Ссылка);
			ЧастьПомещения  = ПолучитьКвартираЧастьПомещенияНаСервере(ТекДанные.Ссылка);
			НаименованиеКом = ПолучитьКвартираНаименованиеНаСервере(ТекДанные.Ссылка);
			
			Основание.Вставить("НомерКомнаты"  , НомерКомнаты);
			Основание.Вставить("ЧастьПомещения", ЧастьПомещения);
			Основание.Вставить("Наименование"  , НаименованиеКом);
			
		КонецЕсли;
		
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура("Основание, Момент", Основание, ТекущаяДата());
	
	ОткрытьФорму("Справочник.бит_Комнаты.Форма.ФормаЭлементаУправляемая", ПараметрыФормы);
	
КонецПроцедуры

&НаКлиенте
Процедура ТаблицаКомнатЗначенийНаименованиеОткрытие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	ТекДанные = Элементы.ТаблицаКомнатЗначений.ТекущиеДанные;
	Элементы.ТаблицаКомнатЗначений.Доступность = Ложь;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Ключ"     , ТекДанные.Ссылка);
	ПараметрыФормы.Вставить("НаДату"   , ТекущаяДата());
	
	ОткрытьФорму("Справочник.бит_Комнаты.Форма.ФормаЭлементаУправляемая", ПараметрыФормы);
	
	Элементы.ТаблицаКомнатЗначений.Доступность = Истина;
	
КонецПроцедуры

