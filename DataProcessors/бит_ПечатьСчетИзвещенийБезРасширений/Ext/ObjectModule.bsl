	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик КАК Счетчик,
	|	бит_ПоказанияСчетчиковОбороты.ПоследниеПоказанияПриход КАК ПоследниеПоказанияПриход
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Период,
	|			Услуга = &Услуга
	|				И Объект = &Объект
	|				И Использовать) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ПоказанияСчетчиков.Обороты(
	|				&ПериодН,
	|				&Период,
	|				Месяц,
	|				Услуга = &Услуга
	|					И Объект = &Объект) КАК бит_ПоказанияСчетчиковОбороты
	|		ПО бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = бит_ПоказанияСчетчиковОбороты.Счетчик";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество() > 0 Тогда
		Возврат Результат[0].ПоследниеПоказанияПриход
	Иначе
		Возврат 0
	КонецЕсли;
	
