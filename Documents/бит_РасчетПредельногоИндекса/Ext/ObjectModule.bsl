#Область ПроцедурыОбработчикиСобытий

Процедура ОбработкаПроведения(Отказ)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	// Сформируем структуру реквизитов шапки документа.
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	// Проверим правильность заполнения шапки документа.
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("ЛицевойСчет"               , "ЛицевойСчет");
	СтруктураПолей.Вставить("ГруппаУслуги"              , "ГруппаУслуги");
	СтруктураПолей.Вставить("Услуга"                    , "Услуга");
	СтруктураПолей.Вставить("Поставщик"                 , "Поставщик");
	СтруктураПолей.Вставить("ЕдИзм"                     , "ЕдИзм");
	СтруктураПолей.Вставить("ПериодСравнения"           , "ПериодСравнения");
	СтруктураПолей.Вставить("Факт"                      , "Факт");
	СтруктураПолей.Вставить("СтавкаДо"                  , "СтавкаДо");
	СтруктураПолей.Вставить("Ставка"                    , "Ставка");
	СтруктураПолей.Вставить("Норма"                     , "Норма");
	СтруктураПолей.Вставить("СверхномСтавкаДо"          , "СверхномСтавкаДо");
	СтруктураПолей.Вставить("СверхномСтавка"            , "СверхномСтавка");
	СтруктураПолей.Вставить("СверхНорма"                , "СверхНорма");
	СтруктураПолей.Вставить("ПлановаяСтавкаДо"          , "ПлановаяСтавкаДо");
	СтруктураПолей.Вставить("ПлановаяСтавка"            , "ПлановаяСтавка");
	СтруктураПолей.Вставить("ТарифДо"                   , "ТарифДо");
	СтруктураПолей.Вставить("Тариф"                     , "Тариф");
	СтруктураПолей.Вставить("ОбъемПоНормативамДо"       , "ОбъемПоНормативамДо");
	СтруктураПолей.Вставить("ОбъемПоНормативам"         , "ОбъемПоНормативам");
	СтруктураПолей.Вставить("ОбъемПоСчетчикам"          , "ОбъемПоСчетчикам");
	СтруктураПолей.Вставить("ПредельныйИндекс"          , "ПредельныйИндекс");
	СтруктураПолей.Вставить("НачисленоДо"               , "НачисленоДо");
	СтруктураПолей.Вставить("Начислено"                 , "Начислено");
	СтруктураПолей.Вставить("Превышение"                , "Превышение");
	СтруктураПолей.Вставить("ПревышениеВПроцентах"      , "ПревышениеВПроцентах");
	СтруктураПолей.Вставить("СуммаНедополученныхДоходов", "СуммаНедополученныхДоходов");
	СтруктураПолей.Вставить("СчетАбонента"              , "СчетАбонента");
	СтруктураПолей.Вставить("Субконто1"                 , "Субконто1");
	СтруктураПолей.Вставить("Субконто2"                 , "Субконто2");
	СтруктураПолей.Вставить("Субконто3"                 , "Субконто3");
	СтруктураПолей.Вставить("СчетКУ"                    , "СчетКУ");
	СтруктураПолей.Вставить("СубконтоКУ1"               , "СубконтоКУ1");
	СтруктураПолей.Вставить("СубконтоКУ2"               , "СубконтоКУ2");
	СтруктураПолей.Вставить("СубконтоКУ3"               , "СубконтоКУ3");
	// БИТ_ЖКХ_10012014_начало_изменений
	СтруктураПолей.Вставить("ПоказанияСчетчика"         , "ПоказанияСчетчика");
	// БИТ_ЖКХ_10012014_окончание_изменений
	
	РезультатЗапросаПоУслугам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Начисления", СтруктураПолей);
	
	ТаблицаПоУслугам          = РезультатЗапросаПоУслугам.Выгрузить();
	
	Если НЕ Отказ Тогда
		
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, Отказ, Заголовок);
		
	КонецЕсли;
	
КонецПроцедуры // ОбработкаПроведения()

