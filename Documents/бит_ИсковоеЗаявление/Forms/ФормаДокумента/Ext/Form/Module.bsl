&НаСервере 
Процедура ПроверитьТипКвартиры()	 
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата",Объект.Дата);
	Запрос.УстановитьПараметр("Квартира", Объект.Квартира);
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_СведенияОКвартиреСрезПоследних.Квартира КАК Квартира,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры
	|ИЗ
	|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних
	|ГДЕ
	|	бит_СведенияОКвартиреСрезПоследних.Квартира = &Квартира";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		Если Выборка.ТипКвартиры = Справочники.бит_ТипыКвартиры.НежилоеПомещение  Тогда  
			Объект.ПредставительскиеРасходы = 0;
			Элементы.Госпошлина.ТолькоПросмотр = Ложь;
		КонецЕсли;
	КонецЕсли;	 
КонецПроцедуры











