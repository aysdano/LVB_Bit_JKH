//HD+
// Возвращает значение реквизита документа по строковому пути вида "Объект.<ИмяРеквизита>".
//
// Поддерживает:
//  - прямые реквизиты: Объект.МКД, Объект.Банк и т.п.;
//  - составной список: Объект.СписокПредложенныхЧленовСовета → «ФИО кв.N, …» по заполненным ролям _1.._5;
//  - составной предложенный председатель: Объект.ПредложенныйПредседатель → «ФИО кв.N» по роли ПредложенныйПредседатель;
//  - пути по роли органов собрания:
//    Объект.ПредседательСекретарьСчетнаяКомиссия.Роль.ПредложенныйЧленСовета_1 → Собственник (ФИО);
//    Объект.ПредседательСекретарьСчетнаяКомиссия.Квартира.ПредложенныйЧленСовета_1 → НомерКвартиры;
//    а также синоним префикса Объект.УчастникиСобрания.... (данные читаются из ТЧ ПредседательСекретарьСчетнаяКомиссия).
//
&НаСервере
Функция ПолучитьЗначениеРеквизитаДокументаПоПути(Путь)
	
	ПутьСтрокой = СокрЛП(Строка(Путь));
	Если НЕ ЗначениеЗаполнено(ПутьСтрокой) Тогда
		Возврат "";
	КонецЕсли;
	
	//HD+ Составной список предложенных членов совета (только заполненные роли _1.._5)
	Если ЭтоИмяИлиПутьСпискаПредложенныхЧленовСовета("", ПутьСтрокой) Тогда
		Возврат СформироватьСписокПредложенныхЧленовСовета();
	КонецЕсли;
	
	//HD+ Составной предложенный председатель (роль ПредложенныйПредседатель)
	Если ЭтоИмяИлиПутьПредложенногоПредседателя("", ПутьСтрокой) Тогда
		Возврат СформироватьПредложенногоПредседателя();
	КонецЕсли;
	//HD-
	
	Префикс = "Объект.";
	Если Лев(ПутьСтрокой, СтрДлина(Префикс)) = Префикс Тогда
		ИмяРеквизита = Сред(ПутьСтрокой, СтрДлина(Префикс) + 1);
	Иначе
		ИмяРеквизита = ПутьСтрокой;
	КонецЕсли;
	
	ИмяРеквизита = СокрЛП(ИмяРеквизита);
	Если НЕ ЗначениеЗаполнено(ИмяРеквизита) Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВРег(ИмяРеквизита) = ВРег("СписокПредложенныхЧленовСовета") Тогда
		Возврат СформироватьСписокПредложенныхЧленовСовета();
	КонецЕсли;
	
	Если ВРег(ИмяРеквизита) = ВРег("ПредложенныйПредседатель") Тогда
		Возврат СформироватьПредложенногоПредседателя();
	КонецЕсли;
	
	//HD+ Путь вида ТЧ.Поле.ИмяРоли (например ПредседательСекретарьСчетнаяКомиссия.Роль.ПредложенныйЧленСовета_1)
	Если СтрНайти(ИмяРеквизита, ".", НаправлениеПоиска.СНачала, 1) > 0 Тогда
		Возврат ПолучитьЗначениеПоПутиРолиОргановСобрания(ИмяРеквизита);
	КонецЕсли;
	
	Результат = Неопределено;
	Попытка
		СтруктураЗначения = Новый Структура;
		СтруктураЗначения.Вставить(ИмяРеквизита, Неопределено);
		ЗаполнитьЗначенияСвойств(СтруктураЗначения, Объект, ИмяРеквизита);
		Результат = СтруктураЗначения[ИмяРеквизита];
	Исключение
		Результат = Неопределено;
	КонецПопытки;
	
	Если Результат = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ИмяРеквизита = "ВладелецСчетаКР" Тогда
		Возврат ПредставлениеВладельцаСчетаКРДляПечати(Результат);
	ИначеЕсли ИмяРеквизита = "Организация" Тогда
		Возврат ПредставлениеОрганизацииДляПечати(Результат);
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Разбирает путь ТЧ.Поле.ИмяРоли и возвращает значение из строки ТЧ ПредседательСекретарьСчетнаяКомиссия.
//
&НаСервере
Функция ПолучитьЗначениеПоПутиРолиОргановСобрания(Знач ИмяРеквизита)
	
	ЧастиПути = СтрРазделить(ИмяРеквизита, ".", Ложь);
	Если ЧастиПути.Количество() <> 3 Тогда
		Возврат "";
	КонецЕсли;
	
	ИмяТЧ = СокрЛП(Строка(ЧастиПути[0]));
	ИмяПоля = СокрЛП(Строка(ЧастиПути[1]));
	ИмяРоли = СокрЛП(Строка(ЧастиПути[2]));
	
	Если НЕ ЭтоПутьКРолиОргановСобрания(ИмяТЧ, ИмяПоля) Тогда
		Возврат "";
	КонецЕсли;
	
	РольУчастника = ПолучитьРольУчастникаПоИмени(ИмяРоли);
	Если НЕ ЗначениеЗаполнено(РольУчастника) Тогда
		Возврат "";
	КонецЕсли;
	
	СтрокаУчастника = НайтиСтрокуОргановСобранияПоРоли(РольУчастника);
	Если СтрокаУчастника = Неопределено Тогда
		Возврат "";
	КонецЕсли;
	
	Если ВРег(ИмяПоля) = ВРег("Роль") ИЛИ ВРег(ИмяПоля) = ВРег("Собственник") Тогда
		Возврат СтрокаУчастника.Собственник;
	ИначеЕсли ВРег(ИмяПоля) = ВРег("Квартира") ИЛИ ВРег(ИмяПоля) = ВРег("НомерКвартиры") Тогда
		Возврат СокрЛП(Строка(СтрокаУчастника.НомерКвартиры));
	КонецЕсли;
	
	Возврат "";
	
КонецФункции //HD-

//HD+
// Признак, что путь относится к разрешению значений органов собрания по роли.
//
&НаСервере
Функция ЭтоПутьКРолиОргановСобрания(Знач ИмяТЧ, Знач ИмяПоля)
	
	ИмяТЧВерх = ВРег(СокрЛП(Строка(ИмяТЧ)));
	Если ИмяТЧВерх <> ВРег("ПредседательСекретарьСчетнаяКомиссия")
		И ИмяТЧВерх <> ВРег("УчастникиСобрания") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПоляВерх = ВРег(СокрЛП(Строка(ИмяПоля)));
	Возврат ИмяПоляВерх = ВРег("Роль")
		ИЛИ ИмяПоляВерх = ВРег("Собственник")
		ИЛИ ИмяПоляВерх = ВРег("Квартира")
		ИЛИ ИмяПоляВерх = ВРег("НомерКвартиры");
	
КонецФункции //HD-

//HD+
// Возвращает значение перечисления HD_РолиУчастников по имени; если имени нет — Неопределено.
//
&НаСервере
Функция ПолучитьРольУчастникаПоИмени(Знач ИмяРоли)
	
	ИмяРоли = СокрЛП(Строка(ИмяРоли));
	Если НЕ ЗначениеЗаполнено(ИмяРоли) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Попытка
		Возврат Перечисления.HD_РолиУчастников[ИмяРоли];
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Ищет первую строку ТЧ ПредседательСекретарьСчетнаяКомиссия с указанной ролью.
//
&НаСервере
Функция НайтиСтрокуОргановСобранияПоРоли(РольУчастника)
	
	Если НЕ ЗначениеЗаполнено(РольУчастника) Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Для Каждого СтрокаУчастника Из Объект.ПредседательСекретарьСчетнаяКомиссия Цикл
		Если СтрокаУчастника.Роль = РольУчастника Тогда
			Возврат СтрокаУчастника;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Неопределено;
	
КонецФункции //HD-

//HD+
// Признак роли с запретом дублей в ТЧ: ПредложенныйЧленСовета_1.._5 и ПредложенныйПредседатель.
//
&НаСервере
Функция ЭтоРольПредложенногоЧленаСовета(РольУчастника)
	
	Если НЕ ЗначениеЗаполнено(РольУчастника) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ТипЗнч(РольУчастника) <> Тип("ПеречислениеСсылка.HD_РолиУчастников") Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Для НомерРоли = 1 По 5 Цикл
		ИмяРоли = "ПредложенныйЧленСовета_" + Формат(НомерРоли, "ЧГ=");
		РольПоИмени = ПолучитьРольУчастникаПоИмени(ИмяРоли);
		Если ЗначениеЗаполнено(РольПоИмени) И РольУчастника = РольПоИмени Тогда
			Возврат Истина;
		КонецЕсли;
	КонецЦикла;
	
	//HD+ ПредложенныйПредседатель — не более одного раза в ТЧ органов собрания
	РольПредложенногоПредседателя = ПолучитьРольУчастникаПоИмени("ПредложенныйПредседатель");
	Если ЗначениеЗаполнено(РольПредложенногоПредседателя)
		И РольУчастника = РольПредложенногоПредседателя Тогда
		Возврат Истина;
	КонецЕсли;
	//HD-
	
	Возврат Ложь;
	
КонецФункции //HD-

