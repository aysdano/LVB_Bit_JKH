КонецПроцедуры

&НаКлиенте
Процедура ДеревоОплатыСуммаПриИзменении(Элемент)
	ТекДанные = Элементы.ДеревоОплаты.ТекущиеДанные;
	
	ТриУровня = Ложь;
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	Для каждого СтрокаКорня Из Корень Цикл
		ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
		Для Каждого СтрокаВторогоУровня Из ВторойУровень Цикл
			ТретийУровень = СтрокаВторогоУровня.ПолучитьЭлементы();
			Если ТретийУровень.Количество() > 0 Тогда
				ТриУровня = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ТриУровня Тогда
		Если ТекДанные.ПолучитьРодителя() <> Неопределено Тогда
			Родитель = ТекДанные.ПолучитьРодителя();
			КореньРодителя = Родитель.ПолучитьЭлементы();
			Итог = 0;
			Для каждого СтрокаКорня Из КореньРодителя Цикл
				Итог = Итог + СтрокаКорня.Сумма;
			КонецЦикла;
			Родитель.Сумма = Итог;
			РодительРодитель = ТекДанные.ПолучитьРодителя().ПолучитьРодителя();
			КореньРодительРодитель = РодительРодитель.ПолучитьЭлементы();
			ИтогРодителя = 0;
			Для каждого СтрокаКорня Из КореньРодительРодитель Цикл
				ИтогРодителя = ИтогРодителя + СтрокаКорня.Сумма;
			КонецЦикла;
			РодительРодитель.Сумма = ИтогРодителя;
		КонецЕсли;
	Иначе
		Если ТекДанные.ПолучитьРодителя() <> Неопределено Тогда
			Родитель = ТекДанные.ПолучитьРодителя();
			КореньРодителя = Родитель.ПолучитьЭлементы();
			Итог = 0;
			Для каждого СтрокаКорня Из КореньРодителя Цикл
				Итог = Итог + СтрокаКорня.Сумма;
			КонецЦикла;
			Родитель.Сумма = Итог;
		КонецЕсли;
	КонецЕсли;
	
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	
	Если Корень.Количество() = 0 Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Таблица платежей не заполнена.");
		
		Возврат;
		
	КонецЕсли; 
	
	Если НЕ ПроверитьЗаполнение() Тогда
		
		Возврат;
		
	КонецЕсли; 
	
	СуммаИтоИтогов = 0;
	
	Для каждого СтрокаКорня Из Корень Цикл
		
		Дата = СтрокаКорня.ДатаОплаты_ЛицевойСчет_Услуга;
		
		Если НЕ ЗначениеЗаполнено(Дата) Тогда
			
			Продолжить;
			
		КонецЕсли;
		
		ИтогПоДокументу      = СтрокаКорня.Сумма;
		СуммаИтогПоДокументу = 0;
		
		ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
		
		МассивЛС = Новый Массив;
		
		ПараметрыЖКХ = ОбновитьПараметрыЖКХ(Дата);
		
		Для каждого СтрокаВторогоУровня Из ВторойУровень Цикл
			
			Если ЗначениеЗаполнено(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаВторогоУровня.Сумма = 0 Тогда
				
				ИтогПоЛС      = СтрокаВторогоУровня.Сумма;
				СуммаИтогПоЛС = 0;
				
				ТретийУровень = СтрокаВторогоУровня.ПолучитьЭлементы();
				
				Если ТретийУровень.Количество() = 0 Тогда
					
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + СтрокаВторогоУровня.Сумма;
					
				Иначе
					
					Для каждого СтрокаТретьегоУрованя Из ТретийУровень Цикл
						
						Если ЗначениеЗаполнено(СтрокаТретьегоУрованя.ДатаОплаты_ЛицевойСчет_Услуга) И НЕ СтрокаТретьегоУрованя.Сумма = 0 Тогда
							
							СуммаИтогПоЛС = СуммаИтогПоЛС + СтрокаТретьегоУрованя.Сумма;
							
						КонецЕсли;
						
					КонецЦикла; 
					
					Если НЕ СуммаИтогПоЛС = ИтогПоЛС Тогда
						
						МассивЛС.Добавить(СтрокаВторогоУровня.ДатаОплаты_ЛицевойСчет_Услуга);
						
					КонецЕсли; 
					
					СуммаИтогПоДокументу = СуммаИтогПоДокументу + СуммаИтогПоЛС;
					
				КонецЕсли;
				
			КонецЕсли; 
		КонецЦикла; 
		СуммаИтоИтогов = СуммаИтоИтогов + СуммаИтогПоДокументу;
	КонецЦикла; 
	Объект.ТекстИтогоДокумент = "Итого по дереву без учета процента: "+Строка(СуммаИтоИтогов);
	Объект.Вручную = Истина;
КонецПроцедуры

&НаКлиенте
Процедура ДеревоОплатыПриАктивизацииЯчейки(Элемент)
	
	ТекДанные = Элементы.ДеревоОплаты.ТекущиеДанные;
	ТекСтрока = Элементы.ДеревоОплаты.ТекущаяСтрока;
	
	ТриУровня = Ложь;
	Корень = ДеревоОплаты.ПолучитьЭлементы();
	Для каждого СтрокаКорня Из Корень Цикл
		ВторойУровень = СтрокаКорня.ПолучитьЭлементы();
		Для Каждого СтрокаВторогоУровня Из ВторойУровень Цикл
			ТретийУровень = СтрокаВторогоУровня.ПолучитьЭлементы();
			Если ТретийУровень.Количество() > 0 Тогда
				ТриУровня = Истина;
				Прервать;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Если ТекДанные <> Неопределено Тогда	
		Если ТриУровня Тогда		
			Если ТекДанные.ПолучитьРодителя() = Неопределено Тогда
				Если Элемент.ТекущийЭлемент.Имя = "ДеревоОплатыСумма" Тогда
					Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
				КонецЕсли;
			Иначе
				Если ТекДанные.ПолучитьРодителя().ПолучитьРодителя() = Неопределено Тогда
					Если Элемент.ТекущийЭлемент.Имя = "ДеревоОплатыСумма" Тогда
						Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
					КонецЕсли;
				Иначе
					Если Элемент.ТекущийЭлемент.Имя = "ДеревоОплатыСумма" Тогда
						Элемент.ТекущийЭлемент.ТолькоПросмотр = Ложь;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		Иначе
			Если ТекДанные.ПолучитьРодителя() = Неопределено Тогда
				Если Элемент.ТекущийЭлемент.Имя = "ДеревоОплатыСумма" Тогда
					Элемент.ТекущийЭлемент.ТолькоПросмотр = Истина;
				КонецЕсли;
			Иначе
				Если Элемент.ТекущийЭлемент.Имя = "ДеревоОплатыСумма" Тогда
					Элемент.ТекущийЭлемент.ТолькоПросмотр = Ложь;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры
&НаКлиенте
Процедура НастроитьСоставШКПриИзменении(Элемент)
	Элементы.СоставШК.Видимость = НастроитьСоставШК;
КонецПроцедуры

&НаКлиенте
Процедура УслугиПриИзменении(Элемент)
	
	Элементы.СтраницыОтборУслуг.Видимость = (Объект.Услуги = "По выбору");
	
КонецПроцедуры

#КонецОбласти

#Область ДействияКомандФормы

&НаКлиенте
Процедура ВыбратьСтандартныйПериод(Команда)
	
	СтандартныйПериод.ДатаНачала         = Объект.сг_НачалоПериода;
	СтандартныйПериод.ДатаОкончания      = Объект.сг_КонецПериода;
	
	Диалог = Новый ДиалогРедактированияСтандартногоПериода();
	Диалог.Период = СтандартныйПериод;
	Диалог.Показать(Новый ОписаниеОповещения("ВыбратьСтандартныйПериодЗавершение", ЭтотОбъект, Новый Структура("Диалог", Диалог)));
	
	
КонецПроцедуры

&НаКлиенте
Процедура ВыбратьСтандартныйПериодЗавершение(Период, ДополнительныеПараметры) Экспорт
	
	Диалог = ДополнительныеПараметры.Диалог;
	
	Если ЗначениеЗаполнено(Период) Тогда
		СтандартныйПериод = Диалог.Период;
		Объект.сг_НачалоПериода    = СтандартныйПериод.ДатаНачала;
		Объект.сг_КонецПериода     = СтандартныйПериод.ДатаОкончания;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыгрузку(Команда)
	
	Если НастройкаПолейСтрокиРеестраСальдо.Количество() = 0 Тогда
		
		Текст = "Формат реестра выгрузки не настроен!";
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(Текст);
		Возврат;
		
	КонецЕсли; 
	
	Текст = Новый ТекстовыйДокумент;
	
	Если Объект.ПлатежнаяСистема = "А-3" Тогда
		сгВыгрузить(Текст);
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.ПутьКАрхиватору7z) Тогда
		
		Если НЕ Объект.ВыводИнформации = "С разбивкой по услугам" Тогда
			ИмяФайлаSA1 = Объект.а3_ИмяФайлаSA1_simp;
			ПутьКФайлуSA17z = Строка(Объект.а3_КаталогВыгрузкиSA1_simp + "\" + Объект.а3_ИмяФайлаSA1_simp + ".7z");
			ПутьКФайлуSA1 = Строка(Объект.а3_КаталогВыгрузкиSA1_simp + "\" + Объект.а3_ИмяФайлаSA1_simp + ".xml");
		Иначе
			ИмяФайлаSA1 = Объект.а3_ИмяФайлаSA1_full;
			ПутьКФайлуSA17z = Строка(Объект.а3_КаталогВыгрузкиSA1_full + "\" + Объект.а3_ИмяФайлаSA1_full + ".7z");
			ПутьКФайлуSA1 = Строка(Объект.а3_КаталогВыгрузкиSA1_full + "\" + Объект.а3_ИмяФайлаSA1_full + ".xml");
		КонецЕсли;	
		
		Если НЕ Объект.ВыводИнформации = "С разбивкой по услугам" Тогда
			ИмяФайлаSL1 = Объект.а3_ИмяФайлаSL1_simp;
			ПутьКФайлуSL17z = Строка(Объект.а3_КаталогВыгрузкиSL1_simp + "\" + Объект.а3_ИмяФайлаSL1_simp + ".7z");
			ПутьКФайлуSL1 = Строка(Объект.а3_КаталогВыгрузкиSL1_simp + "\" + Объект.а3_ИмяФайлаSL1_simp + ".xml");
		Иначе
			ИмяФайлаSL1 = Объект.а3_ИмяФайлаSL1_full;
			ПутьКФайлуSL17z = Строка(Объект.а3_КаталогВыгрузкиSL1_full + "\" + Объект.а3_ИмяФайлаSL1_full + ".7z");
			ПутьКФайлуSL1 = Строка(Объект.а3_КаталогВыгрузкиSL1_full + "\" + Объект.а3_ИмяФайлаSL1_full + ".xml");
		КонецЕсли;
		
		Запаковать7Z(ИмяФайлаSA1,ПутьКФайлуSA1,ПутьКФайлуSA17z,ИмяФайлаSL1,ПутьКФайлуSL1,ПутьКФайлуSL17z);
	Иначе	
		Сообщение = Новый СообщениеПользователю;
		Сообщение.Текст = "Для запаковки в архивы 7z необходимо заполнить путь к архиватору!";
		Сообщение.Сообщить();
	КонецЕсли;
	
КонецПроцедуры                                             

&НаКлиенте
Процедура ПрочитатьФайл(Команда)
	
	МассивОшибок = Новый Массив;
	
	ТекстФайл = Новый ТекстовыйДокумент;
	
	Попытка
		
		ТекстФайл.Прочитать(сг_ФайлЗагрузки, КодировкаТекста["UTF8"]);
		
	Исключение
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Неправильно задан путь к файлу или файл отсутствует!");
		
		Возврат;
	КонецПопытки;
	
	Отказ = Ложь;	
	
	Если Объект.ВводИнформации = "С разбивкой по услугам" Тогда
		сгПрочитатьФайл(МассивОшибок, ТекстФайл, Отказ);
	Иначе
		сгПрочитатьФайлБезРазбивкиПоУслугам(МассивОшибок, ТекстФайл, Отказ);
	КонецЕсли;
	
	Если МассивОшибок.Количество() > 0 Тогда
		
		Для каждого Ошибка Из МассивОшибок Цикл
			
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Ошибка);
			
		КонецЦикла; 
		
	КонецЕсли;
	
	Элементы.ДеревоОплаты.НачальноеОтображениеДерева = НачальноеОтображениеДерева.РаскрыватьВсеУровни;
	
	КоллекцияЭлементовДерева=ДеревоОплаты.ПолучитьЭлементы();
	// Развернуть дерево. 
	Для Каждого СтрокаДерева Из КоллекцияЭлементовДерева Цикл    
		ИдентификаторСтроки=СтрокаДерева.ПолучитьИдентификатор();
		Элементы.ДеревоОплаты.Развернуть(ИдентификаторСтроки);
	КонецЦикла; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьНастройкиФорматаРеестра(Команда)
	
	Если Объект.ПлатежнаяСистема = "А-3" Тогда
		Если Объект.ВыводИнформации = "С разбивкой по услугам" Тогда
			ЗаполнитьНастройкиПолейРеестраСальдо();
		Иначе
			ЗаполнитьНастройкиПолейРеестраСальдоБезУслуг();
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВверх(Команда)
	
	ТекущаяСтрока = Элементы.НастройкаПолейСтрокиРеестраСальдо.ТекущиеДанные;
	
	ТекИндекс = НастройкаПолейСтрокиРеестраСальдо.Индекс(ТекущаяСтрока);
	
	Попытка
		НастройкаПолейСтрокиРеестраСальдо.Сдвинуть(ТекИндекс, -1);
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПереместитьВниз(Команда)
	
	ТекущаяСтрока = Элементы.НастройкаПолейСтрокиРеестраСальдо.ТекущиеДанные;
	
	ТекИндекс = НастройкаПолейСтрокиРеестраСальдо.Индекс(ТекущаяСтрока);
	
	Попытка
		НастройкаПолейСтрокиРеестраСальдо.Сдвинуть(ТекИндекс, 1);
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура Подбор(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Организация"       , Объект.Организация);
	ПараметрыФормы.Вставить("Дата"              , Объект.сг_КонецПериода);
	ПараметрыФормы.Вставить("ОткрытоИзДокумента", Истина);
	
	ОткрытьФорму("Обработка.бит_ПодборЛицевыхСчетов.Форма", ПараметрыФормы, Элементы.ОтборЛицевыхСчетов, УникальныйИдентификатор);
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьОплаты(Команда)
	
	сг_СоздатьОплаты(Ложь);
	
КонецПроцедуры

#КонецОбласти

#Область ПрочиеПроцедурыИФункции

&НаСервере
Процедура сгВыгрузить(Текст)
	
	ИспользоватьНомерПолучателя = Ложь;
	НомерПолучателяПоБанку      = 0;
	
	СтруктураПараметров = Новый Структура;
	СтруктураПараметров.Вставить("ИспользоватьНомерПолучателяВШК", ИспользоватьНомерПолучателя);
	СтруктураПараметров.Вставить("НомерПолучателяПоБанку"        , НомерПолучателяПоБанку);
	
	бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(КонецДня(Объект.сг_КонецПериода), Объект.Организация, СтруктураПараметров);
	
	ИспользоватьНомерПолучателя = СтруктураПараметров.ИспользоватьНомерПолучателяВШК;
	НомерПолучателяПоБанку      = СтруктураПараметров.НомерПолучателяПоБанку;
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	
	ПостроительЗапроса.Параметры.Вставить("НачалоПериода", НачалоДня(Объект.сг_НачалоПериода));
	ПостроительЗапроса.Параметры.Вставить("КонецПериода" , КонецДня(Объект.сг_КонецПериода));
	ПостроительЗапроса.Параметры.Вставить("Организация"  , Объект.Организация);
	
	Если Объект.ВыводИнформации  = "С разбивкой по услугам" Тогда
		ПостроительЗапроса.Текст =
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
		|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаНачальныйОстаток) КАК НачальноеСальдо,
		|	СУММА(бит_НачисленияПоУслугамЖКХОстаткиИОбороты.СуммаКонечныйОстаток) КАК КонечноеСальдо,
		|	СУММА(0) КАК НачальноеСальдоПени,
		|	СУММА(0) КАК КонечноеСальдоПени
		|ПОМЕСТИТЬ Остатки
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет,
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
		|	СУММА(0),
		|	СУММА(0),
		|	СУММА(бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.СуммаПениНачальныйОстаток),
		|	СУММА(бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.СуммаПениКонечныйОстаток)
		|ИЗ
		|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.ОстаткиИОбороты(&НачалоПериода, &КонецПериода, , , ЛицевойСчет.Организация = &Организация) КАК бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.УслугаЖКХ,
		|	бит_НачислениеПениПоУслугамЖКХОстаткиИОбороты.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Остатки.ЛицевойСчет,
		|	Остатки.УслугаЖКХ,
		|	СУММА(Остатки.НачальноеСальдо) КАК НачальноеСальдо,
		|	СУММА(Остатки.КонечноеСальдо) КАК КонечноеСальдо,
		|	СУММА(Остатки.НачальноеСальдоПени) КАК НачальноеСальдоПени,
		|	СУММА(Остатки.КонечноеСальдоПени) КАК КонечноеСальдоПени
		|ПОМЕСТИТЬ ГрупОстатки
		|ИЗ
		|	Остатки КАК Остатки
		|
		|СГРУППИРОВАТЬ ПО
		|	Остатки.ЛицевойСчет,
		|	Остатки.УслугаЖКХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
		|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаНачислений,
		|	СУММА(ВЫБОР
		|			КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
		|				ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
		|			ИНАЧЕ 0
		|		КОНЕЦ) КАК СуммаОплаты,
		|	СУММА(0) КАК СуммаПени
		|ПОМЕСТИТЬ Обороты
		|ИЗ
		|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, Регистратор, ЛицевойСчет.Организация = &Организация) КАК бит_НачисленияПоУслугамЖКХОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
		|	бит_НачисленияПоУслугамЖКХОбороты.УслугаЖКХ
		|
		|ОБЪЕДИНИТЬ ВСЕ
		|
		|ВЫБРАТЬ
		|	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет,
		|	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ,
		|	СУММА(0),
		|	СУММА(0),
		|	СУММА(бит_НачислениеПениПоУслугамЖКХОбороты.СуммаПениОборот)
		|ИЗ
		|	РегистрНакопления.бит_НачислениеПениПоУслугамЖКХ.Обороты(&НачалоПериода, &КонецПериода, , ЛицевойСчет.Организация = &Организация) КАК бит_НачислениеПениПоУслугамЖКХОбороты
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_НачислениеПениПоУслугамЖКХОбороты.ЛицевойСчет,
		|	бит_НачислениеПениПоУслугамЖКХОбороты.УслугаЖКХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Обороты.ЛицевойСчет,
		|	Обороты.УслугаЖКХ,
		|	СУММА(Обороты.СуммаНачислений) КАК СуммаНачислений,
		|	СУММА(Обороты.СуммаОплаты) КАК СуммаОплаты,
		|	СУММА(Обороты.СуммаПени) КАК СуммаПени
		|ПОМЕСТИТЬ ГрупОбороты
		|ИЗ
		|	Обороты КАК Обороты
		|
		|СГРУППИРОВАТЬ ПО
		|	Обороты.ЛицевойСчет,
		|	Обороты.УслугаЖКХ
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга.Приоритет
		|ПОМЕСТИТЬ СведенияПоУслугам
		|ИЗ
