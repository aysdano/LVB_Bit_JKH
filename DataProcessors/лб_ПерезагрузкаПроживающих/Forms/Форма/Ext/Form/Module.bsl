Процедура УдалитьстрокиОбработанныхОстатков()
	Если ложь тогда мУжеОбработанныеОбъекты = новый ТаблицаЗначений КонецЕсли;
	ЧислоСтрок = МассивСтру.Количество();
	Для СчетВниз = 1 по ЧислоСтрок цикл
		Инд = ЧислоСтрок-СчетВниз;
		Стру = МассивСтру[Инд];
		ЛС = неопределено;
		ИмяЛС=неопределено;
		Удалять = ложь;
		Если Стру.Свойство("ЛС",ЛС) и ЗначениеЗаполнено(ЛС) тогда
			Если мУжеОбработанныеОбъекты.Найти(ЛС,"ЛицевойСчет")<>неопределено тогда
				МассивСтру.Удалить(Инд);
			КонецЕсли;	
		иначеЕсли Стру.Свойство("LS",ИмяЛС) и не пустаяСтрока(ИмяЛС) тогда
			ИмяЛС = СокрЛП(ИмяЛС);
			Если мУжеОбработанныеОбъекты.Найти(ЛС,"ИмяЛС")<>неопределено тогда
				МассивСтру.Удалить(Инд);
			КонецЕсли;	                                      			
		КонецЕсли;	                                            	
	КонецЦикла;	                                                
