// Процедура - обработчик события "Нажатие" кнопки "Файлы" коммандной панели "ДействияФормы". 
//
&НаКлиенте
Процедура Файлы(Команда)
	
	Если Объект.Ссылка.Пустая() Тогда
		
		ПоказатьПредупреждение(Новый ОписаниеОповещения("ФайлыЗавершение", ЭтотОбъект), "Сначала запишите документ.");
		
		Возврат;
		
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	
	ПараметрыФормы.Вставить("Объект", Объект.Ссылка);
	
	ОткрытьФорму("Справочник.бит_рз_ХранилищеДополнительнойИнформации.Форма.ФормаСпискаУправляемая", Новый Структура("ЗаполнитьИзДокументаУстановкаСтавокПоУслугам", ПараметрыФормы), ЭтаФорма);
	
КонецПроцедуры

&НаКлиенте
Процедура ФайлыЗавершение(ДополнительныеПараметры) Экспорт
	
	Завершение = Истина;	
	
КонецПроцедуры

// Процедура - Расчитывает  ставки текущей строки. 
//
&НаКлиенте
Процедура РасчитатьСтавки(Команда)
	
	Для каждого Строка Из Объект.СтавкиНаУслуги Цикл
		
		Ставка = Строка.Тариф * Строка.НормативПотребленияПоКу;
		
		Строка.ПлановаяСтавка         = Ставка;
		Строка.ОсновнаяСтавка         = Ставка;
		Строка.СверхНормативнаяСтавка = Ставка;
		
	КонецЦикла;  
	
КонецПроцедуры

