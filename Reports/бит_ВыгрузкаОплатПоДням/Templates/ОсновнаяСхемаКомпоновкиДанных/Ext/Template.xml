		КОГДА ВТ_Данные.Услуга.Код = "00-000007"
			ТОГДА 60
		КОГДА ВТ_Данные.Услуга.Код = "00-000018"
			ТОГДА 70
		КОГДА ВТ_Данные.Услуга.Код = "00-000009"
			ТОГДА 80
		КОГДА ВТ_Данные.Услуга.Код = "00-000014"
			ТОГДА 90
		КОГДА ВТ_Данные.Услуга.Код = "00-000023"
			ТОГДА 100
		КОГДА ВТ_Данные.Услуга.Код = "00-000013"
			ТОГДА 110
		КОГДА ВТ_Данные.Услуга.Код = "00-000019"
			ТОГДА 120
		КОГДА ВТ_Данные.Услуга.Код = "00-000026"
			ТОГДА 130
		КОГДА ВТ_Данные.Услуга.Код = "00-000021"
			ТОГДА 140
		КОГДА ВТ_Данные.Услуга.Код = "00-000022"
			ТОГДА 150
		КОГДА ВТ_Данные.Услуга.Код = "00-000008"
			ТОГДА 160
	КОНЕЦ,
	ВТ_Данные.ЛицевойСчет,
