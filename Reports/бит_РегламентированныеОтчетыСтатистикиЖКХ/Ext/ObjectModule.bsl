
#Область ПеременныеМодуля

Перем мСписокФормОтчета Экспорт; // Хранит список значений форм отчета.

#КонецОбласти

#Область ЭкспортныеПроцедурыИФункции

// Формирует заголовок отчета.
//
// Возвращаемое значение:
//  Строка - заголовок отчета.
//
Функция ЗаголовокОтчета() Экспорт

	ТекОтчет = мСписокФормОтчета.НайтиПоЗначению(ВидФормы);

	Если ТекОтчет = Неопределено Тогда
		Возврат "";
	КонецЕсли;

	Возврат ТекОтчет.Представление;

КонецФункции // ЗаголовокОтчета()

// Формирует и выводит отчет.
//
// Параметры:
//  ДокументРезультатТитульный - ТабличныйДокумент - элемент управления,.
//                 В который будет осуществлен вывод титульного листа.
//  ДокументРезультатРаздел12 - ТабличныйДокумент - элемент управления,.
//                 В который будет осуществлен вывод разделов 1 и 2.
//  ДокументРезультатРаздел3 - ТабличныйДокумент - элемент управления,.
//                 В который будет осуществлен вывод раздела 3.
//
Процедура ОбновитьОтчет(ДокументРезультат) Экспорт
	
	// Проверка на заполнение значений.
	Если Не ПроверкаЗаполненияШапки() Тогда
		Возврат;
	КонецЕсли;
	
	ДокументРезультат.Очистить();
	
	Если ВидФормы = "22" Тогда
		ЗаполнитьДокумент_Ф22(ДокументРезультат, СборСведенийОбОрганизации());
	КонецЕсли;	
	
	//26.08.2019
	Если ВидФормы = "22_Жилище" Тогда
		ЗаполнитьДокумент_Ф22_ЖилищеНовая(ДокументРезультат, СборСведенийОбОрганизации());
	КонецЕсли;	
	
	Если ВидФормы = "26" Тогда
		ЗаполнитьДокумент_Ф26(ДокументРезультат, СборСведенийОбОрганизации());
	КонецЕсли;
	
КонецПроцедуры // ОбновитьОтчет()

#КонецОбласти

#Область ПроцедурыИФункцииОбщегоНазначения

// Собирает сведения об организации.
