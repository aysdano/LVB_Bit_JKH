Функция КонтрольныйРазряд(знач КодЛС, знач ЧислоЦифр=0) Экспорт 
	//Правила расчета контрольного разряда
	//первая цифра умножаем на 1, вторая на 3, третья на 7, четвертая снова на 1 и т.д.
	//стандартная длина без контрольного разряда - 10 цифр, поэтому при расчете для
	//11-тизначного числа последнюю цифру не учитываем
	
	
	
	Если ТипЗнч(КодЛС)=Тип("Число") тогда
		КодЛС = Формат(КодЛС,"ЧЦ=10; ЧВН=; ЧГ=");
	КонецЕсли;	
	
	Если СтрДлина(КодЛС) = 11 тогда
		КодЛС = лев(КодЛС,10);		
		ЧислоЦифр = 10;	
	КонецЕсли;	
	
	Если ЧислоЦифр =0 тогда
		ЧислоЦифр = СтрДлина(КодЛС)
	КонецЕсли;	
	
	Если ЧислоЦифр>СтрДлина(КодЛС) тогда
		КодЛС = прав("0000000000000000000000000000"+КодЛС,ЧислоЦифр);
	КонецЕсли;	
	
	Сумма = 0;
	Для Счетчик = 1 По ЧислоЦифр Цикл
		Цифра = сред(КодЛС,Счетчик,1);		
		Если Счетчик % 3 =1 тогда
			Множитель = 7     //разряды 1,4,7,10 ...
		ИначеЕсли Счетчик %	3 = 2 тогда
			Множитель =1     //разряды 2,5,8 ...
		иначе
			Множитель = 3     //разряды 3,6,9 ....
		КонецЕсли;	
		
		Сумма = Сумма + Цифра * Множитель;
	
	КонецЦикла;
	
	Результат = Сумма * 3;
	КонтрСумма = Результат%10;
	
	Возврат Строка(КонтрСумма);
	
КонецФункции

Функция СвойствоЗдания(Период, Здание, имяСвойства) Экспорт 	
	Свойство = ПланыВидовХарактеристик.бит_СвойстваОбъектовУчета[имяСвойства];
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Период",Период);
	Запрос.УстановитьПараметр("Свойство",Свойство);
	Запрос.УстановитьПараметр("Здание",Здание);
	Запрос.Текст =   "ВЫБРАТЬ
	                |	бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних.Значение КАК Значение
	                |ИЗ
	                |	РегистрСведений.бит_ЗначенияСвойствОбъектовУчетаПериодические.СрезПоследних(
	                |			&Период,
	                |			ВидСвойства = &Свойство
	                |				И ОбъектУчета = &Здание) КАК бит_ЗначенияСвойствОбъектовУчетаПериодическиеСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() тогда
		возврат выборка.Значение
	иначе	
		возврат неопределено
	КонецЕсли;	
		
КонецФункции	

Функция ПолучитьТаблицуКодовПочты(ШаблонИзвещения=Неопределено) Экспорт 
	
	ТаблицаЗначений = Новый ТаблицаЗначений;
	ТаблицаЗначений.Колонки.Добавить("УслугаЖКХ", Новый ОписаниеТипов("СправочникСсылка.бит_УслугиЖКХ"));
	ТаблицаЗначений.Колонки.Добавить("ЭтоПени", Новый ОписаниеТипов("Булево"));
	ТаблицаЗначений.Колонки.Добавить("СтрокаКода", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(1, 0)));
	ТаблицаЗначений.Колонки.Добавить("ПозицияКода", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(2, 0)));
	ТаблицаЗначений.Колонки.Добавить("ИдентификаторПоставщика", Новый ОписаниеТипов("Число", Новый КвалификаторыЧисла(4, 0)));
	
	ЗагрузкаВыгрузка = Новый СписокЗначений;
	ЗагрузкаВыгрузка.Добавить(Перечисления.лб_ИмпортЭкспорт.ВыгрузкаИЗагрузка);
	ЗагрузкаВыгрузка.Добавить(Перечисления.лб_ИмпортЭкспорт.Выгрузка);
	
	СписокУС = Новый СписокЗначений;
	ЕстьОтборУслуг = Ложь;
	
	Если ТипЗнч(ШаблонИзвещения) = Тип("СправочникСсылка.бит_ШаблоныИзвещений") И НЕ ШаблонИзвещения = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам Тогда
		СписокУС.ЗагрузитьЗначения(ШаблонИзвещения.Услуги.ВыгрузитьКолонку("Услуга"));
		ЕстьОтборУслуг = СписокУС.Количество() > 0;
	КонецЕсли;
		
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("СписокУС", СписокУС);
	Запрос.УстановитьПараметр("ЕстьОтборУслуг", ЕстьОтборУслуг);
	Запрос.УстановитьПараметр("НаправлениеОбмена", Справочники.лб_НаправленияОбмена.Почта);
	Запрос.УстановитьПараметр("ЗагрузкаВыгрузка", ЗагрузкаВыгрузка);
	Запрос.Текст = "ВЫБРАТЬ
	               |	лб_НастройкиОбмена.Основная КАК Основная,
	               |	лб_НастройкиОбмена.СтрокаКода КАК СтрокаКода,
	               |	лб_НастройкиОбмена.ПозицияКода КАК ПозицияКода,
	               |	лб_НастройкиОбмена.ИдентификаторПоставщика КАК ИдентификаторПоставщика,
	               |	лб_НастройкиОбмена.УслугаЖКХ КАК УслугаЖКХ,
	               |	лб_НастройкиОбмена.ЭтоПени КАК ЭтоПени
	               |ИЗ
	               |	РегистрСведений.лб_НастройкиОбмена КАК лб_НастройкиОбмена
	               |ГДЕ
	               |	лб_НастройкиОбмена.ЗагрузкаВыгрузка В(&ЗагрузкаВыгрузка)
	               |	И лб_НастройкиОбмена.НаправлениеОбмена = &НаправлениеОбмена
	               |	И ВЫБОР
	               |			КОГДА &ЕстьОтборУслуг
	               |				ТОГДА лб_НастройкиОбмена.УслугаЖКХ В (&СписокУС)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И НЕ лб_НастройкиОбмена.ЭтоПени
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	УслугаЖКХ,
	               |	Основная УБЫВ
	               |ИТОГИ ПО
	               |	УслугаЖКХ
	               |;
	               |
	               |////////////////////////////////////////////////////////////////////////////////
	               |ВЫБРАТЬ
	               |	лб_НастройкиОбмена.СтрокаКода КАК СтрокаКода,
	               |	лб_НастройкиОбмена.ПозицияКода КАК ПозицияКода,
	               |	лб_НастройкиОбмена.ИдентификаторПоставщика КАК ИдентификаторПоставщика,
	               |	лб_НастройкиОбмена.ЭтоПени КАК ЭтоПени,
	               |	лб_НастройкиОбмена.УслугаЖКХ КАК УслугаЖКХ,
	               |	лб_НастройкиОбмена.Основная КАК Основная
	               |ИЗ
	               |	РегистрСведений.лб_НастройкиОбмена КАК лб_НастройкиОбмена
	               |ГДЕ
	               |	лб_НастройкиОбмена.ЗагрузкаВыгрузка В(&ЗагрузкаВыгрузка)
	               |	И лб_НастройкиОбмена.НаправлениеОбмена = &НаправлениеОбмена
	               |	И ВЫБОР
	               |			КОГДА &ЕстьОтборУслуг
	               |				ТОГДА лб_НастройкиОбмена.УслугаЖКХ В (&СписокУС)
	               |			ИНАЧЕ ИСТИНА
	               |		КОНЕЦ
	               |	И лб_НастройкиОбмена.ЭтоПени
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	УслугаЖКХ,
	               |	Основная УБЫВ
	               |ИТОГИ ПО
	               |	УслугаЖКХ";
	
	Выборка = Запрос.ВыполнитьПакет();
	ВыборкаБезПени = Выборка[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаБезПени.Следующий() Цикл
		 Строка = ВыборкаБезПени.Выбрать();
		 Строка.Следующий();
		 ЗаполнитьЗначенияСвойств(ТаблицаЗначений.Добавить(), Строка);		 
    КонецЦикла;    
	
	ВыборкаПени = Выборка[1].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаПени.Следующий() Цикл
		 Строка = ВыборкаПени.Выбрать();
		 Строка.Следующий();
		 ЗаполнитьЗначенияСвойств(ТаблицаЗначений.Добавить(), Строка);	
    КонецЦикла; 

	Возврат ТаблицаЗначений;

КонецФункции

Функция ПолучитьСтрокуКодаПочты(ТаблицаКодовПочты, МассивУслуг, МассивУслугПени) Экспорт 
	
	СтруктураКодов = ПолучитьСтруктуруКодовПочты();
	
	Для Каждого Услуга Из МассивУслуг Цикл
		
		Отбор = Новый Структура();
		Отбор.Вставить("УслугаЖКХ", Услуга);
		Строки = ТаблицаКодовПочты.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Строка = Строки[0];
		
		Если Строка.СтрокаКода < 1 И Строка.СтрокаКода > 2 ИЛИ Строка.ПозицияКода = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НужноеЗначенияКлюча = "";
		
		Если Услуга.лб_ГруппаУслугДляПечати = Справочники.лб_ГруппыУслугДляПечати.Левобережье Тогда
			НужноеЗначенияКлюча = "Код";	
		ИначеЕсли Услуга.лб_ГруппаУслугДляПечати = Справочники.лб_ГруппыУслугДляПечати.КапРемонтЛевобережье Тогда
			НужноеЗначенияКлюча = "КодКР";
		ИначеЕсли Услуга.лб_ГруппаУслугДляПечати = Справочники.лб_ГруппыУслугДляПечати.КапРемонтРФКР Тогда
			НужноеЗначенияКлюча = "КодРФКР";
		ИначеЕсли Услуга.лб_ГруппаУслугДляПечати = Справочники.лб_ГруппыУслугДляПечати.Тепло Тогда
			НужноеЗначенияКлюча = "КодТепло";
		Иначе 
			Продолжить;	
		КонецЕсли;
		
		Если СтрДлина(НужноеЗначенияКлюча) = 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		СтароеЗначение = СтруктураКодов[НужноеЗначенияКлюча + Строка(Строка.СтрокаКода)];
		
		СтруктураКодов.Вставить(НужноеЗначенияКлюча + Строка(Строка.СтрокаКода), Лев(СтароеЗначение, Строка.ПозицияКода-1) + 
																				   Строка(Строка.ИдентификаторПоставщика) + 
																				   Прав(СтароеЗначение, 10-Строка.ПозицияКода));
		
	КонецЦикла;
																			   
	Для Каждого Услуга Из МассивУслугПени Цикл
		
		Отбор = Новый Структура();
		Отбор.Вставить("УслугаЖКХ", Услуга);
		Строки = ТаблицаКодовПочты.НайтиСтроки(Отбор);
		Если Строки.Количество() = 0 Тогда
			Продолжить;
		КонецЕсли;	
		
		Строка = Строки[0];
		
		Если Строка.СтрокаКода < 1 И Строка.СтрокаКода > 2 ИЛИ Строка.ПозицияКода = 0 Тогда
			Продолжить;
		КонецЕсли;
		
		НужноеЗначенияКлюча = "";
		
		Если Услуга.лб_ГруппаУслугДляПечати = Справочники.лб_ГруппыУслугДляПечати.Левобережье Тогда
			НужноеЗначенияКлюча = "Код";	
		ИначеЕсли Услуга.лб_ГруппаУслугДляПечати = Справочники.лб_ГруппыУслугДляПечати.КапРемонтЛевобережье Тогда
			НужноеЗначенияКлюча = "КодКР";
		ИначеЕсли Услуга.лб_ГруппаУслугДляПечати = Справочники.лб_ГруппыУслугДляПечати.КапРемонтРФКР Тогда
			НужноеЗначенияКлюча = "КодРФКР";
		ИначеЕсли Услуга.лб_ГруппаУслугДляПечати = Справочники.лб_ГруппыУслугДляПечати.Тепло Тогда
			НужноеЗначенияКлюча = "КодТепло";
		Иначе 
			Продолжить;	
		КонецЕсли;
		
		Если СтрДлина(НужноеЗначенияКлюча) = 0 Тогда
			Продолжить;	
		КонецЕсли;
		
		СтароеЗначение = СтруктураКодов[НужноеЗначенияКлюча + Строка(Строка.СтрокаКода)];
		
		СтруктураКодов.Вставить(НужноеЗначенияКлюча + Строка(Строка.СтрокаКода), Лев(СтароеЗначение, Строка.ПозицияКода-1) + 
																				   Строка(Строка.ИдентификаторПоставщика) + 
																				   Прав(СтароеЗначение, 10-Строка.ПозицияКода));
		
	КонецЦикла;
	
	Для Каждого КлючИЗначение из СтруктураКодов Цикл
		СтруктураКодов.Вставить(КлючИЗначение.Ключ, КлючИЗначение.Значение + КонтрольныйРазряд(КлючИЗначение.Значение));
	КонецЦикла;	
	
	Возврат СтруктураКодов;
	
КонецФункции

Функция ПолучитьСтруктуруКодовПочты() Экспорт

	СтруктураКодов = Новый Структура;
	СтруктураКодов.Вставить("Код1", "0000000000");
	СтруктураКодов.Вставить("Код2", "0000000000");
	СтруктураКодов.Вставить("КодКР1", "0000000000");
	СтруктураКодов.Вставить("КодКР2", "0000000000");
	СтруктураКодов.Вставить("КодРФКР1", "0000000000");
	СтруктураКодов.Вставить("КодРФКР2", "0000000000");
	СтруктураКодов.Вставить("КодТепло1", "0000000000");
	СтруктураКодов.Вставить("КодТепло2", "0000000000");

	Возврат СтруктураКодов
	
КонецФункции // ПолучитьСтруктуруКодовПочты()

Функция лб_ПолучитьНастройкуРС(ИмяНастройки,Дата = неопределено) Экспорт
	перем Значение;
	
	Отбор = новый структура;
	СтруктураРС = РегистрыСведений.лб_Настройки.ПолучитьПоследнее(Дата,Отбор);	
	Если СтруктураРС.Свойство(ИмяНастройки,Значение) тогда
		возврат Значение
	иначе 		
		возврат неопределено
	КонецЕсли;	
	
КонецФункции	

функция лб_ПолучитьСписокУслугИзШаблонаИзвещения(Шаблон) экспорт
	массив = новый массив;
	Настройка = Шаблон;
	Если Не ЗначениеЗаполнено(Настройка) тогда
		//пустой массив
	ИначеЕсли 	ТипЗнч(Настройка) = Тип("СправочникСсылка.бит_УслугиЖКХ") тогда
		массив.Добавить(Настройка);
	ИначеЕсли Настройка = Справочники.бит_ШаблоныИзвещений.ПоВсемЗаМесяц или
		      Настройка = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам или
			  Настройка = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугамДолговой  тогда
		Выборка = Справочники.бит_УслугиЖКХ.Выбрать();
		Пока Выборка.Следующий() цикл
			массив.Добавить(Выборка.Ссылка);
		КонецЦикла;
	ИначеЕсли Настройка = Справочники.бит_ШаблоныИзвещений.КапитальныйРемонт или 
			      Настройка = Справочники.бит_ШаблоныИзвещений.БезКапитальногоРемонта тогда
		ТекстЗапроса = "ВЫБРАТЬ
		               |	бит_УслугиЖКХ.Ссылка КАК Ссылка
		               |ИЗ
		               |	Справочник.бит_УслугиЖКХ КАК бит_УслугиЖКХ
		               |ГДЕ					   
		               |	бит_УслугиЖКХ.ГрафаОтчетаГЦЖС <> &ГрафаОтчетаГЦЖС";
		
		ТекстЗапроса = СтрЗаменить(ТекстЗапроса,"<>",
						?(Настройка = Справочники.бит_ШаблоныИзвещений.КапитальныйРемонт,"=","<>"));
		
 	    Запрос = новый запрос(ТекстЗапроса);
		Запрос.УстановитьПараметр("ГрафаОтчетаГЦЖС",Перечисления.бит_ГрафыОтчетаПоГЦЖС.КапитальныйРемонт);		
		массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Ссылка");					   
	иначеЕсли  ТипЗнч(Настройка) = Тип("СправочникСсылка.бит_ШаблоныИзвещений") тогда	
		Запрос = новый запрос;
		Запрос.УстановитьПараметр("Ссылка",Настройка);
		Запрос.Текст = "ВЫБРАТЬ
		               |	бит_ШаблоныИзвещенийУслуги.Услуга КАК Услуга
		               |ИЗ
		               |	Справочник.бит_ШаблоныИзвещений.Услуги КАК бит_ШаблоныИзвещенийУслуги
		               |ГДЕ
		               |	бит_ШаблоныИзвещенийУслуги.Ссылка = &Ссылка";
		
		массив = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Услуга");					   		
	иначе 
		//пустой массив		
	КонецЕсли;	
	возврат массив

КонецФункции	

Функция лб_ПолучитьНастройкуМассивУслуг(ИмяНастройки,Дата) Экспорт
	Настройка = лб_ПолучитьНастройкуРС(ИмяНастройки,Дата);
	возврат лб_ПолучитьСписокУслугИзШаблонаИзвещения(Настройка)
КонецФункции	

Функция лб_АдресЛС(СсылкаЛицевойСчет, Дата = неопределено) Экспорт
		
	Если Дата = Неопределено Тогда
		Дата = ТекущаяДата()
	КонецЕсли;
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата", КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Квартира", СсылкаЛицевойСчет.Квартира);
	Запрос.Текст = "ВЫБРАТЬ
				|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК лб_ПредставлениеКвартиры
				|ИЗ
				|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	Результат = Запрос.Выполнить().Выгрузить();
	
	лб_ПредставлениеКвартиры = "";
	Если Результат.Количество() > 0 Тогда
		лб_ПредставлениеКвартиры = Результат[0].лб_ПредставлениеКвартиры;
	КонецЕсли;
		
	С = СсылкаЛицевойСчет.Здание.ссылка;
		
	Запрос = Новый Запрос;
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	лб_Тест_Дома.ADR КАК ADR
		|ИЗ
		|	РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
		|ГДЕ
		|	лб_Тест_Дома.Здание = &С";
	
	Запрос.УстановитьПараметр("С", С);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		// Вставить обработку выборки ВыборкаДетальныеЗаписи
		Адрес1 = ВыборкаДетальныеЗаписи.ADR; 
	КонецЦикла;
			
	//Адрес = Строка(СсылкаЛицевойСчет.УлицаЛицевогоСчета) + ", " + 
	//		" д. " + Строка(СсылкаЛицевойСчет.Здание.НомерДома)
	//			+?(ЗначениеЗаполнено(СсылкаЛицевойСчет.Здание.ПрефиксДома), СсылкаЛицевойСчет.Здание.ПрефиксДома, "")
	//			+?(ЗначениеЗаполнено(СсылкаЛицевойСчет.Здание.Корпус),", к. "+ СсылкаЛицевойСчет.Здание.Корпус, "");
	
	
				
	НомерКвартиры = ?(ЗначениеЗаполнено(лб_ПредставлениеКвартиры), " кв. " + лб_ПредставлениеКвартиры, " кв. " + Строка(СсылкаЛицевойСчет.Квартира));
	
	Если СсылкаЛицевойСчет.Здание.КонтактнаяИнформация.Количество() > 0 Тогда 
		
		АдресПроживания = ?(ЗначениеЗаполнено(СсылкаЛицевойСчет.Здание.ПочтовыйАдрес),Строка(СсылкаЛицевойСчет.Здание.ПочтовыйАдрес), Адрес1); 
		НомерКвартиры = ?(ЗначениеЗаполнено(лб_ПредставлениеКвартиры), " кв. " + Строка(лб_ПредставлениеКвартиры), 
							?(ЗначениеЗаполнено(СсылкаЛицевойСчет.Квартира), " кв. " + Строка(СсылкаЛицевойСчет.Квартира), НомерКвартиры));	
	Иначе	
		АдресПроживания = Адрес1;	
	КонецЕсли;
	
	НомерПозиции = СтрНайти(НомерКвартиры, "=");
	
	Если НомерПозиции <> 0 Тогда
		НомерКвартиры = Лев(НомерКвартиры, НомерПозиции - 1)
	КонецЕсли;

	Адрес = сокрлп(Адрес1) + НомерКвартиры;

	Возврат Адрес
		
КонецФункции


Функция лб_Адрес(Квартира,Дата=неопределено,Сокращенный=истина) экспорт
	Если ложь тогда Квартира = Справочники.бит_Квартиры.Выбрать().Ссылка КонецЕсли;
	Дом = Квартира.Владелец;
	
	Если Сокращенный = истина тогда
		АдресДома = ""+Дом.Улица + ", д."+Дом.НомерДома+Дом.ПрефиксДома;
	Иначе
		ВидКИ = Справочники.бит_ВидыКонтактнойИнформации.ПочтовыйАдресЗдания;
		ТипКИ = Перечисления.бит_ТипыКонтактнойИнформации.Адрес;
		ЗАпрос = новый запрос;
		Запрос.УстановитьПараметр("Вид",ВидКИ);
		Запрос.УстановитьПараметр("Тип",ТипКИ);
		ЗАпрос.УстановитьПараметр("Объект",Дом);
		Запрос.Текст = 
			"ВЫБРАТЬ
			|	бит_КонтактнаяИнформация.Представление
			|ИЗ
			|	РегистрСведений.бит_КонтактнаяИнформация КАК бит_КонтактнаяИнформация
			|ГДЕ
			|	бит_КонтактнаяИнформация.Объект = &Объект
			|	И бит_КонтактнаяИнформация.Тип = &Тип
			|	И бит_КонтактнаяИнформация.Вид = &Вид";
		Выборка = ЗАпрос.Выполнить().Выбрать();
		Если Выборка.Следующий() тогда
			АдресДома = Выборка.Представление;
		иначеЕсли Не ПустаяСтрока(Дом.ПочтовыйАдрес) тогда
			АдресДома = Дом.ПочтовыйАдрес; 
		иначе	
			АдресДома = "*** Почтовый адрес дома "+ Дом.Код + " не заполнен ***";
		КонецЕсли;
	КонецЕсли;
	
	Запрос = новый запрос;
	Запрос.УстановитьПараметр("Квартира",Квартира);
	ЗАпрос.УстановитьПараметр("Дата",Дата);
	Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры КАК ПредставлениеКвартиры
		|ИЗ
		|	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&Дата, Квартира = &Квартира) КАК бит_СведенияОКвартиреСрезПоследних";
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() и НЕ ПустаяСтрока(Выборка.ПредставлениеКвартиры) тогда
		ПервыйСимволПредставления = лев(Выборка.ПредставлениеКвартиры,1);
		пр1 = ?(СтрНайти("0123456789",ПервыйСимволПредставления)>0,"кв.",""); 
		Адрес = АдресДома + ", "+пр1+ Выборка.ПредставлениеКвартиры;
	иначе
		Адрес = АдресДома + ", кв."+Квартира.НомерКвартиры + Квартира.ПрефиксКвартиры
	КонецЕсли;	
		
	возврат Адрес	
КонецФункции


