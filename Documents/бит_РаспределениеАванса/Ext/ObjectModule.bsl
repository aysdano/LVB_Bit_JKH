	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(Дата));
	запрос.УстановитьПараметр("ТаблицаАвансов", ТаблицаАвансов);
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		// Находим аванс по услуге.
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет", Выборка.ЛицевойСчет);
		Отбор.Вставить("УслугаЖКХ",	  Выборка.УслугаЖКХ);
		
		МассивСтрок = ТаблицаАвансов.НайтиСтроки(Отбор);
		
		Если МассивСтрок.Количество() > 0 Тогда
			Если МассивСтрок[0].Аванс > 0 Тогда
				НСтр = СписокУслугПоПериоду.Добавить();
				НСтр.ЛицевойСчет		  = Выборка.ЛицевойСчет;
