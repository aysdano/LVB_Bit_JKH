		|	СУММА(ЕСТЬNULL(ГрупОбороты.СуммаПени, 0)) КАК СуммаПени,
		|	СУММА(ЕСТЬNULL(ГрупОстатки.НачальноеСальдо, 0)) КАК НачальноеСальдо,
