
#Область ПроцедурыИФункцииОбщегоНазначения

&НаКлиенте
Процедура ОчиститьОтбор(Знач ИмяЭлемента = "")
	
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("СписокЛС");
	ЭлементыФормы.Добавить("СписокРайонов");
	ЭлементыФормы.Добавить("СписокУчастков");
	ЭлементыФормы.Добавить("СписокЗданий");
	ЭлементыФормы.Добавить("СписокУлиц");
	
	Если НЕ ПустаяСтрока(ИмяЭлемента) Тогда
		
		ЭлементыФормы.Очистить();
		ЭлементыФормы.Добавить(ИмяЭлемента);
		
	КонецЕсли; 
	
	Для каждого Элемент Из ЭлементыФормы Цикл
		
		ЭтаФорма[Элемент].Очистить();
		
		Если Элемент = "СписокЗданий" Тогда
			Объект.ТипКвартиры = Неопределено;
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

// Процедура отображает текущие отборы.
//
// Параметры:
//  Нет.
//
&НаКлиенте
Процедура ОтобразитьТекущиеОтборы()
	
	УстановленныеОтборы = "";
	
	Если Объект.СписокРайонов.Количество() > 0 Тогда
		УстановленныеОтборы = УстановленныеОтборы + "Районы";
	КонецЕсли;
	
	Если Объект.СписокУчастков.Количество() > 0 Тогда
		Запятая = ?(НЕ УстановленныеОтборы = "", ", ","");
		УстановленныеОтборы = УстановленныеОтборы + Запятая + "Участки";
	КонецЕсли;
	
	Если Объект.СписокУлиц.Количество() > 0 Тогда
		Запятая = ?(НЕ УстановленныеОтборы = "", ", ","");
		УстановленныеОтборы = УстановленныеОтборы + Запятая + "Улицы";
	КонецЕсли;
	
	Если Объект.СписокЗданий.Количество() > 0 Тогда
		Запятая = ?(НЕ УстановленныеОтборы = "", ", ","");
		УстановленныеОтборы = УстановленныеОтборы + Запятая + "Здания";
	КонецЕсли;
	
	Если Объект.СписокЛС.Количество() > 0 Тогда
		Запятая = ?(НЕ УстановленныеОтборы = "", ", ","");
		УстановленныеОтборы = УстановленныеОтборы + Запятая + "Лицевые счета";
	КонецЕсли;
	
	Если НЕ Объект.ТипКвартиры.Пустая() Тогда
		Запятая = ?(НЕ УстановленныеОтборы = "", ", ","");
		УстановленныеОтборы = УстановленныеОтборы + Запятая + "Тип квартиры";
	КонецЕсли;
	
	Если УстановленныеОтборы = "" Тогда
		УстановленныеОтборы = "Отбор не установлен.";
	Иначе
		УстановленныеОтборы = УстановленныеОтборы + ".";
	КонецЕсли; 
	
КонецПроцедуры 

&НаКлиенте
Процедура ЗаполнитьТаблицаРеквизитовQRКода()
	
	Объект.ТаблицаРеквизитовQRКода.Очистить();
	
	Для Каждого Элт Из мКэшРеквизитовQRКода Цикл
		Нстр = Объект.ТаблицаРеквизитовQRКода.Добавить();
		Нстр.Реквизит	   = Элт.Ключ;
		Нстр.Представление = Элт.Значение;
		Нстр.Выводить	   = Истина;
	КонецЦикла;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// БИТ ЖКХ 23.01.2019
	ПредопределенныйМакет = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32_Новый.ПолучитьОбъект();
	ПредопределенныйМакет.ПутьКМакету = "ЕдиныйПлатежныйДокумент761_32_Новый";
	ПредопределенныйМакет.Записать();
	
	// БИТ ЖКХ 14.04.2021
	ПредопределенныйМакет = Справочники.бит_ВариантыСчетовИзвещений.ЕдиныйПлатежныйДокумент761_32_НовыйСПени.ПолучитьОбъект();
	ПредопределенныйМакет.ПутьКМакету = "ЕдиныйПлатежныйДокумент761_32_НовыйСПени";
	ПредопределенныйМакет.Записать();
	
	ЗаполнитьКэшРеквизитовQRКода();
	
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	ПроверитьВерсиюОбработки();
	
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.MXL , "mxl");
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.HTML, "html");
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.XLS , "xls");
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.PDF , "pdf");
	Элементы.ТипФайла.СписокВыбора.Добавить(ТипФайлаТабличногоДокумента.ODS , "ods");
	
	Объект.Период                   = КонецМесяца(ТекущаяДата());
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаНачало", НачалоМесяца(ТекущаяДата()));
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаКонец" , КонецМесяца(ТекущаяДата()));
	ТипФайла                        = ТипФайлаТабличногоДокумента.XLS;
	// БИТ_ЖКХ 20.11.2017 16:09:08 Начало правки...
	Объект.РасскрытьСоставГрупп		= Истина;	
	// БИТ_ЖКХ 20.11.2017 16:09:08 Конец правки.
	Объект.УчетнаяЗапись            = бит_УправлениеЭлектроннойПочтойСервер.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();
	Объект.ОтправительПредставление = бит_УправлениеЭлектроннойПочтойСервер.ПолучитьПредставлениеДляУчетнойЗаписи(Объект.УчетнаяЗапись);
	Объект.МакетКв                  = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение;
	
	Организация = бит_ОбщиеПеременныеСервер.ЗначениеПеременной("ОсновнаяОрганизация");
	
	Если НЕ Параметры.ЛицевойСчет.Пустая() Тогда
		
		Организация = Параметры.ЛицевойСчет.Организация;
		
		НоваяСтрока = Объект.СписокЛС.Добавить();
		НоваяСтрока.ЛицевойСчет        = Параметры.ЛицевойСчет;
		НоваяСтрока.ГруппироватьУслуги = Параметры.ЛицевойСчет.ОтображатьПоГруппам;
		
		Если Не Организация = ПредопределенноеЗначение("Справочник.Организации.ПустаяСсылка") Тогда
			
			Объект.Организация = Организация;
			
			ОбновитьНастройкиЖКХ();
			
			НоваяСтрока.ПечатьЗависимыхЛС = мКэшЗначений.ВыводитьЗависимыеЛС;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Объект.Организация = Организация;
	ОрганизацияПриИзмененииНаСервере();
	
	Объект.ШаблонИзвещений = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам;
	
	Объект.РазмерПакетаПечати    = 500;
	Объект.РазмерПакетаПросмотра = 50;
	
	МакетЦвета = Обработки.бит_ПечатьСчетИзвещений.ПолучитьМакет("МакетЛегенда");
	Цвета = МакетЦвета.ПолучитьТекст();
	
	ПолучитьДоступныеУчетныеЗаписиДляОтправки();
	
	Объект.СписокГЦЖС.ТипЗначения = Новый ОписаниеТипов("ПеречислениеСсылка.бит_ГрафыОтчетаПоГЦЖС");
	
	ПредставлениеПериодаРегистрации = Формат(Объект.Период, "ДФ='ММММ гггг'");
	
	Если ЗначениеЗаполнено(Объект.Организация) Тогда
		Если ЗначениеЗаполнено(мКэшЗначений.КодУслугиВСистемеГород) Тогда
			Объект.сг_КодУслугиВСистемеГород = мКэшЗначений.КодУслугиВСистемеГород;
			Объект.ИспользоватьСокращенноеНаименование = мКэшЗначений.ИспользоватьСокращенноеНаименование;
			Объект.ФорматДаты		 = мКэшЗначений.ФорматДаты;
			Объект.НазначениеПлатежа = мКэшЗначений.НазначениеПлатежа; 
		Иначе
			//23.07.2019
			ЗначениеКодУслугиВСистемеГород = Новый Структура("КодУслугиВСистемеГород,ИспользоватьСокращенноеНаименование,ФорматДаты,НазначениеПлатежа, ИспользоватьSumCПени", "", Ложь, "", ""); 
			бит_ОбщегоНазначения.ПолучитьНастройкиЖКХ(Объект.Период, Объект.Организация, ЗначениеКодУслугиВСистемеГород);
			Объект.сг_КодУслугиВСистемеГород = ЗначениеКодУслугиВСистемеГород.КодУслугиВСистемеГород;
			Объект.ИспользоватьСокращенноеНаименование = ЗначениеКодУслугиВСистемеГород.ИспользоватьСокращенноеНаименование;
			Объект.ФорматДаты = ЗначениеКодУслугиВСистемеГород.ФорматДаты;
			Объект.НазначениеПлатежа = ЗначениеКодУслугиВСистемеГород.НазначениеПлатежа; 
			//23.07.2019
			Объект.ИспользоватьSumCПени = ЗначениеКодУслугиВСистемеГород.ИспользоватьSumCПени;
		КонецЕсли;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПередЗагрузкойДанныхИзНастроекНаСервере(Настройки)
	
	Если НЕ Параметры.ЛицевойСчет.Пустая() Тогда
		
		тмпСохраненыеДанные = ПоместитьВоВременноеХранилище(Настройки, УникальныйИдентификатор);
		
		МакетКв		  = Настройки.Получить("Объект.МакетКв");
		Организация	  = Настройки.Получить("Объект.Организация");
		РасчетныйСчет = Настройки.Получить("Объект.РС");
		Если НЕ МакетКв = Неопределено Тогда
			Объект.МакетКв = МакетКв;
			Если НЕ ПолучитьЗначениеРеквизитаОбъекта(МакетКв, "ОсновнойВариант") = ПредопределенноеЗначение("Справочник.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент")
				И НЕ МакетКв = ПредопределенноеЗначение("Справочник.бит_ВариантыСчетовИзвещений.ПлатежныйДокумент") 
				И НЕ Организация = Неопределено 
				И Организация <>  Объект.Организация Тогда
				
				ОрганизацияПриИзмененииНаСервере();
			Иначе
				Объект.РС = РасчетныйСчет;
			КонецЕсли;		
		КонецЕсли;
		
		Период = Настройки.Получить("Объект.Период");
		Если НЕ Период = Неопределено Тогда
			Объект.Период = Период;
		КонецЕсли;
		
		ПредставлениеПериодаРегистрации = Формат(Объект.Период, "ДФ='ММММ гггг'");
		
		ШаблонИзвещений = Настройки.Получить("Объект.ШаблонИзвещений");
		Если НЕ ШаблонИзвещений = Неопределено Тогда
			Объект.ШаблонИзвещений = ШаблонИзвещений;
		КонецЕсли;
		
		ПолучательПлатежа = Настройки.Получить("Объект.ПолучательПлатежа");
		Если НЕ ПолучательПлатежа = Неопределено Тогда
			Объект.ПолучательПлатежа = ПолучательПлатежа;
		КонецЕсли;
		
		ИспользоватьQR = Настройки.Получить("Объект.ИспользоватьQR");
		Если НЕ ИспользоватьQR = Неопределено Тогда
			Объект.ИспользоватьQR = ИспользоватьQR;
		КонецЕсли;
		
		НатройкаРеквизитовQRКода = Настройки.Получить("ТаблицаРеквизитовQRКода");
		Если НЕ НатройкаРеквизитовQRКода = Неопределено Тогда
			Объект.ТаблицаРеквизитовQRКода.Загрузить(НатройкаРеквизитовQRКода); 
		КонецЕсли; 
		
		БезПрефиксаНежилогоПомещения = Настройки.Получить("Объект.БезПрефиксаНежилогоПомещения");
		Если НЕ БезПрефиксаНежилогоПомещения = Неопределено Тогда
			Объект.БезПрефиксаНежилогоПомещения = БезПрефиксаНежилогоПомещения;
		КонецЕсли;
		
		Настройки.Очистить();
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЗагрузкеДанныхИзНастроекНаСервере(Настройки)
	
	УчетнаяЗапись = Настройки.Получить("Объект.УчетнаяЗапись");
	Если НЕ ЗначениеЗаполнено(УчетнаяЗапись) Тогда
		Объект.УчетнаяЗапись = бит_УправлениеЭлектроннойПочтойСервер.ПолучитьУчетнуюЗаписьДляОтправкиПоУмолчанию();
	КонецЕсли;
	
	Объект.ОтправительПредставление = бит_УправлениеЭлектроннойПочтойСервер.ПолучитьПредставлениеДляУчетнойЗаписи(Объект.УчетнаяЗапись);
	
	Период = Настройки.Получить("Объект.Период");
	Если ЗначениеЗаполнено(Период) Тогда
		Объект.Период = Период;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Настройки.Получить("ТипФайла")) Тогда
		ТипФайла = Настройки.Получить("ТипФайла");
	КонецЕсли; 
	   
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаНачало", НачалоМесяца(Объект.Период));
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаКонец" , КонецМесяца(Объект.Период));
	
	ЭлементыФормы = Новый Массив;
	ЭлементыФормы.Добавить("СписокЛС");
	ЭлементыФормы.Добавить("СписокРайонов");
	ЭлементыФормы.Добавить("СписокУчастков");
	ЭлементыФормы.Добавить("СписокЗданий");
	ЭлементыФормы.Добавить("СписокУлиц");
	ЭлементыФормы.Добавить("ТаблицаРеквизитовQRКода");
	
	Для каждого Элемент Из ЭлементыФормы Цикл
		
		НатройкаОтбора = Настройки.Получить(Элемент);
		
		Если Элемент = "ТаблицаРеквизитовQRКода" И ЗначениеЗаполнено(НатройкаОтбора) Тогда
			Если НатройкаОтбора.Найти("КПППолучателя", "Реквизит") = Неопределено Тогда
				СтрКПППолучателя = НатройкаОтбора.Добавить();
				СтрКПППолучателя.Выводить		= Ложь;
				СтрКПППолучателя.Представление	= "KPP";
				СтрКПППолучателя.Реквизит		= "КПППолучателя";
			КонецЕсли;
		КонецЕсли;
		
		Если НЕ НатройкаОтбора = Неопределено Тогда
			Объект[Элемент].Загрузить(НатройкаОтбора); 
		КонецЕсли; 
		
	КонецЦикла;
	
	Элементы.сг_КодУслугиВСистемеГород.Видимость = Объект.ИспользоватьQR;

КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Объект.СтрокаПериод = бит_РаботаСДиалогами.ПолучитьПредставлениеПериодаРегистрации(Объект.Период);
	
	Если ОчищатьОтборы Тогда
		
		ОчиститьОтбор();
		
	КонецЕсли;
	
	ОтобразитьТекущиеОтборы();
	
	Если Объект.ТаблицаРеквизитовQRКода.Количество() = 0 Тогда
		ЗаполнитьТаблицаРеквизитовQRКода()
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыДействияКомандныхПанелейФормы

&НаКлиенте
Процедура Сформировать(Команда)
	
	ОчиститьСообщения();
	
	Если Не ПроверитьЗаполнение() Тогда
		Возврат;
	КонецЕсли; 
	
	Объект.ТекущийПакет = 1;
	
	ОчиститьНаСервере(Результат);
	
	Результат.АвтоМасштаб = Истина;
	Результат.ПолеСверху  = 0;
	Результат.ПолеСнизу   = 0;
	
	ИзменитьСостояниеТабличногоПоля("ФОРМИРОВАНИЕОТЧЕТА");
	
	Элементы.ГруппаСтраницы.ТекущаяСтраница = Элементы.ГруппаСтраницыОсновные;
	
	ТабличныйДокумент = СформироватьКвитанции();
	
	Если НЕ ТабличныйДокумент = Неопределено Тогда
		Результат.ОриентацияСтраницы = ТабличныйДокумент.ОриентацияСтраницы;
		
		ВывестиНаСервере(ТабличныйДокумент);

	КонецЕсли;
	
	ИзменитьСостояниеТабличногоПоля();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВсеСейчас(Команда)
	
	ТекДанные = Элементы.ТаблицаПисем.ТекущиеДанные;
	
	СтатусПисьма = ПредопределенноеЗначение("Перечисление.бит_СтатусыИсходящегоЭлектронногоПисьма.Отправлено");
	ОчиститьСообщения();
	ОтправитьПисьма(СтатусПисьма);
	
	Элементы.ТаблицаПисем.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОтправитьВсе(Команда)
	
	СтатусПисьма = ПредопределенноеЗначение("Перечисление.бит_СтатусыИсходящегоЭлектронногоПисьма.Исходящее");
	ОтправитьПисьма(СтатусПисьма);
	
	Элементы.ТаблицаПисем.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура ОбновитьТаблицуПисем(Команда)
	
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаНачало", НачалоМесяца(Объект.Период));
	ТаблицаПисем.Параметры.УстановитьЗначениеПараметра("ДатаКонец" , КонецМесяца(Объект.Период));
	
	Элементы.ТаблицаПисем.Обновить();
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИзменитьПолучателей(Команда)
	
	ТекущиеДанные = Элементы.ТаблицаПисем.ТекущиеДанные;
	
	Если ТекущиеДанные.СтатусПисьма = ПредопределенноеЗначение("Перечисление.бит_СтатусыИсходящегоЭлектронногоПисьма.Отправлено") Тогда	
		Возврат;
	КонецЕсли; 
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("Период"     , Объект.Период);
	ПараметрыФормы.Вставить("ЛицевойСчет", ТекущиеДанные.ЛицевойСчет);
	
	Адреса = Неопределено;
	
	ОткрытьФорму("Обработка.бит_ПечатьСчетИзвещений.Форма.АдреснаяКнигаПроживающих", ПараметрыФормы,,,,, Новый ОписаниеОповещения("УстановитьИзменитьПолучателейЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура УстановитьИзменитьПолучателейЗавершение(Результат1, ДополнительныеПараметры) Экспорт
	
	Адреса = Результат1;
	
	Если (ТипЗнч(Адреса) <> Тип("Массив")) И (ТипЗнч(Адреса) <> Тип("Соответствие")) Тогда
		Возврат;
	КонецЕсли;
	
	// Заполним адресатов.
	ЗаполнитьПодобранныхПолучателей(Элементы.ТаблицаПисем.ТекущаяСтрока, Адреса);
	
	Элементы.ТаблицаПисем.Обновить();
	
КонецПроцедуры

