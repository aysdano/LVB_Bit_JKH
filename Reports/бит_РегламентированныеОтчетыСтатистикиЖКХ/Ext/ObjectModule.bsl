	|	УслугиГЦЖС.ТипПлиты
	|ИТОГИ
	|	СУММА(КоличествоПроживающих),
	|	СУММА(ЖилищныйФонд),
	|	СУММА(КомунальнаяПлощадь),
	|	МАКСИМУМ(ОбщаяПлощадьЖилогоЗдания),
	|	МАКСИМУМ(ОбщаяПлощадьМестОбщегоПользования)
	|ПО
	|	ГрафаОтчетаГЦЖС,
	|	ВидБлагоустройстваЗданий,
	|	ТипПлиты";
	// БИТ_ЖКХ 24.11.2015 9:51:23 Конец правки. 
	
	Запрос.УстановитьПараметр("КонецПериода",  КонецМесяца(Дата));
	Запрос.УстановитьПараметр("Организация",   Организация);
	
	ВыборкаГЦЖС = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаГЦЖС.Следующий() Цикл
		Если ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ХолодноеВодоснабжение Тогда
            //Раздел 3
			ОбластьДок["П033910"].Значение = ВыборкаГЦЖС.КомунальнаяПлощадь;
			ОбластьДок["П033911"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ХВСДляГВС Тогда
			// Справочно (Раз в год)
			Если КонецМесяца(Дата) = КонецГода(Дата) Тогда
				ОбластьДок["П045608"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			КонецЕсли;	
		
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Водопровод Тогда	
            //Раздел 3
			ОбластьДок["П034010"].Значение = ВыборкаГЦЖС.КомунальнаяПлощадь;
			ОбластьДок["П034011"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ГорячееВодоснобжение Тогда	
            //Раздел 3
			ОбластьДок["П034110"].Значение = ВыборкаГЦЖС.КомунальнаяПлощадь;
			ОбластьДок["П034111"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Отопление Тогда	
            //Раздел 3
			ОбластьДок["П034210"].Значение = ВыборкаГЦЖС.КомунальнаяПлощадь;
			ОбластьДок["П034211"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			// Справочно (Раз в год)
			Если КонецМесяца(Дата) = КонецГода(Дата) Тогда
				ОбластьДок["П045407"].Значение = ВыборкаГЦЖС.ОбщаяПлощадьЖилогоЗдания;
			КонецЕсли;	
			
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Электроэнергия Тогда	
            //Раздел 3
			ОбластьДок["П034310"].Значение = ВыборкаГЦЖС.КомунальнаяПлощадь;
			ОбластьДок["П034311"].Значение = ВыборкаГЦЖС.КоличествоПроживающих;
			//Суммируем данные по типам плит
			ВыборкаВидБлагоустройстваЗданий = ВыборкаГЦЖС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			Пока ВыборкаВидБлагоустройстваЗданий.Следующий() Цикл
				ВыборкаТипПлиты = ВыборкаВидБлагоустройстваЗданий.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
				Пока ВыборкаТипПлиты.Следующий() Цикл
					Если ВыборкаТипПлиты.ТипПлиты = Справочники.бит_ТипыПлиты.ГазоваяПлита Тогда
						ОбластьДок["П034410"].Значение = ОбластьДок["П034410"].Значение + ВыборкаТипПлиты.КомунальнаяПлощадь;
//						ОбластьДок["П034411"].Значение = ОбластьДок["П034411"].Значение + ВыборкаТипПлиты.КоличествоПроживающих;
					ИначеЕсли ВыборкаТипПлиты.ТипПлиты = Справочники.бит_ТипыПлиты.ЭлектрическаяПлита Тогда
						ОбластьДок["П034510"].Значение = ОбластьДок["П034510"].Значение + ВыборкаТипПлиты.КомунальнаяПлощадь;
//						ОбластьДок["П034511"].Значение = ОбластьДок["П034511"].Значение + ВыборкаТипПлиты.КоличествоПроживающих;
					КонецЕсли;	
				КонецЦикла;
			КонецЦикла;
			// Справочно (Раз в год)
			Если КонецМесяца(Дата) = КонецГода(Дата) Тогда
				ОбластьДок["П045306"].Значение = ВыборкаГЦЖС.ОбщаяПлощадьМестОбщегоПользования;
				ОбластьДок["П045307"].Значение = ВыборкаГЦЖС.ОбщаяПлощадьЖилогоЗдания;
			КонецЕсли;	
	
		ИначеЕсли ВыборкаГЦЖС.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Газ Тогда	
