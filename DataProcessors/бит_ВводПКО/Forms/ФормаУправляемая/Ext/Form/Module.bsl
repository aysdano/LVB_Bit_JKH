&НаСервере
Процедура УстановитьВидОперации()
	
	ВидОперации = Неопределено;
	
	Элементы.ВидОперации.СписокВыбора.Очистить();
	
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
		
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ОплатаПокупателя);
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ПрочиеРасчетыСКонтрагентами);
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ПрочееПоступление);
		ВидОперации =  Элементы.ВидОперации.ОграничениеТипа.ПривестиЗначение(Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ПустаяСсылка());
		Элементы.СчетКасса.Видимость					 = Истина;
		Элементы.СтатьяДвиженияДенежныхСредств.Видимость = Истина;
		Элементы.ВидОплаты.Видимость					 = Ложь;
		
	ИначеЕсли  ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда 
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ВидыОперацийОплатаПлатежнойКартой.ОплатаПокупателя);
		ВидОперации =  Элементы.ВидОперации.ОграничениеТипа.ПривестиЗначение(Перечисления.ВидыОперацийОплатаПлатежнойКартой.ПустаяСсылка());
		Элементы.СчетКасса.Видимость					 = Ложь;
		Элементы.СтатьяДвиженияДенежныхСредств.Видимость = Ложь;
		Элементы.ВидОплаты.Видимость					 = Истина;
		
		// БИТ ЖКХ 06.09.2020
		Элементы.ДатаПоступления.Видимость = истина;
		Элементы.СоздатьПоступление.Видимость = истина;
		// БИТ ЖКХ 22.01.2021
		Элементы.СтатьяДвиженияДенежныхСредств.Видимость = истина;		
		
	Иначе
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ВидыОперацийПКО.ОплатаПокупателя);
		Элементы.ВидОперации.СписокВыбора.Добавить(Перечисления.ВидыОперацийПКО.ПрочийПриход);
		ВидОперации =  Элементы.ВидОперации.ОграничениеТипа.ПривестиЗначение(Перечисления.ВидыОперацийПКО.ПустаяСсылка());
		Элементы.СчетКасса.Видимость					 = Истина;
		Элементы.СтатьяДвиженияДенежныхСредств.Видимость = Истина;
		Элементы.ВидОплаты.Видимость					 = Ложь;
		
				
	КонецЕсли; 
	
КонецПроцедуры

// Получение ответственного на выбранном ЛС.
// Параметры:
//  <ЛицевойСчет> – <Справочник.бит_ЛицевыеСчета> – для получения ответственного по ЛС.
//
// Возвращаемое значение:
//  <ТаблицаЗначений.Строка> – <строка с ответственным по ЛС>.
//
&НаСервере
Функция ОтветственныйНаЛС(ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&Момент,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					ЛицевыеСчета.Ссылка
	|				ИЗ
	|					Справочник.бит_ЛицевыеСчета КАК ЛицевыеСчета
	|				ГДЕ
	|					ЛицевыеСчета.Ссылка = &ЛицевойСчет)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица <> &СтатусФизЛица
	|
	|УПОРЯДОЧИТЬ ПО
	|	ФизЛицо";
	
	Запрос.УстановитьПараметр("Момент", 	 ТекущаяДата());
	Запрос.УстановитьПараметр("ЛицевойСчет", ЛицевойСчет);
	//06.05.2019
	Запрос.УстановитьПараметр("СтатусФизЛица", справочники.бит_СтатусФизЛица.Выписан);
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Если Результат.Количество()> 0 Тогда
		
		РезультатФизЛицо = Результат[0].ФизЛицо
	Иначе
		РезультатФизЛицо = Справочники.бит_Проживающие.ПустаяСсылка();
	КонецЕсли;
	Возврат РезультатФизЛицо;
	
КонецФункции 





// Процедура заполняет документ СчетНаОплатуПокупателю и выполняет его запись.
//
&НаСервере
Процедура ЗаполнитьСчетНаСервере(Счет,ПлатежныйДокумент, Строка, Оплата, СчетЗаписан = Ложь, РабитьПоЛС = Ложь, ТранзитныйСчетОплаты, ПрименениеУСН, СуммаПринимаемых, БанковскийСчет, ИсточникОплаты)
	Счет.Дата = ПлатежныйДокумент.Дата;
	Счет.Организация = ПлатежныйДокумент.Организация;
	Счет.бит_ДокументОснование = Оплата;
	Счет.Ответственный = Оплата.Ответственный;
	Счет.Контрагент = ПлатежныйДокумент.Контрагент;
	Счет.ДоговорКонтрагента = ПлатежныйДокумент.ДоговорКонтрагента;
	Счет.ВалютаДокумента = ПлатежныйДокумент.ВалютаДокумента;
	Счет.Комментарий = ПлатежныйДокумент.Комментарий;
	Счет.СуммаДокумента = ПлатежныйДокумент.СуммаДокумента;
	Счет.СтруктурнаяЕдиница = БанковскийСчет;
	//21.08.2019
	Счет.СуммаВключаетНДС = истина;

	Если РабитьПоЛС Тогда
		
		Счет.бит_ЛицевойСчет = ПлатежныйДокумент.бит_ЛицевойСчет;
		
		Для каждого стр из Оплата.СписокУслуг.НайтиСтроки(Новый Структура ("ЛицевойСчет", Счет.бит_ЛицевойСчет)) Цикл
			
		    если Объект.УчитыватьАванс = истина тогда	
				// БИТ ЖКХ 31.12.2020 РТС
				//Быстрое решение
				Запрос = Новый Запрос("ВЫБРАТЬ ПЕРВЫЕ 1
				                      |	бит_СведенияПоУслугамЛССрезПоследних.Поставщик КАК Поставщик,
				                      |	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета КАК СпособРасчета,
				                      |	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления КАК РежимПотребления
				                      |ПОМЕСТИТЬ втСведения
				                      |ИЗ
				                      |	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
				                      |			&Дата,
				                      |			ЛицевойСчет = &ЛицевойСчет
				                      |				И Услуга = &Услуга) КАК бит_СведенияПоУслугамЛССрезПоследних
				                      |;
				                      |
				                      |////////////////////////////////////////////////////////////////////////////////
				                      |ВЫБРАТЬ ПЕРВЫЕ 1
				                      |	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры КАК ТипКвартиры,
				                      |	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры КАК СтатусКвартиры
				                      |ПОМЕСТИТЬ втКвартира
				                      |ИЗ
				                      |	РегистрСведений.бит_СведенияОКвартире.СрезПоследних(
				                      |			&Дата,
				                      |			Квартира В
				                      |				(ВЫБРАТЬ
				                      |					Справочник.бит_ЛицевыеСчета.Квартира
				                      |				ИЗ
				                      |					Справочник.бит_ЛицевыеСчета
				                      |				ГДЕ
				                      |					Справочник.бит_ЛицевыеСчета.Ссылка = &ЛицевойСчет)) КАК бит_СведенияОКвартиреСрезПоследних
				                      |;
				                      |
				                      |////////////////////////////////////////////////////////////////////////////////
				                      |ВЫБРАТЬ ПЕРВЫЕ 1
				                      |	Ставки.Тариф КАК Тариф,
				                      |	Ставки.ОсновнаяСтавка КАК ОсновнаяСтавка
				                      |ИЗ
				                      |	РегистрСведений.бит_СтавкиНаУслуги.СрезПоследних(
				                      |			&Дата,
				                      |			Услуга = &Услуга
				                      |				И (Поставщик, СпособРасчета, РежимПотребления) В
				                      |					(ВЫБРАТЬ
				                      |						втСведения.Поставщик,
				                      |						втСведения.СпособРасчета,
				                      |						втСведения.РежимПотребления
				                      |					ИЗ
				                      |						втСведения)
				                      |				И (ТипКвартиры, СтатусКвартиры) В
				                      |					(ВЫБРАТЬ
				                      |						втКвартира.ТипКвартиры,
				                      |						втКвартира.СтатусКвартиры
				                      |					ИЗ
				                      |						втКвартира)) КАК Ставки");	
				Запрос.УстановитьПараметр("Дата", НачалоМесяца(Счет.Дата)-1);
				Запрос.УстановитьПараметр("ЛицевойСчет", ПлатежныйДокумент.бит_ЛицевойСчет);
				Запрос.УстановитьПараметр("Услуга", Стр.Услуга);
			конецесли;
			Добавить = Счет.Товары.Добавить();
			Добавить.Номенклатура = стр.Услуга.Номенклатура;
			Добавить.Цена = стр.Сумма + стр.СуммаПени;
			Добавить.Количество = 1;
			Добавить.Сумма = Добавить.Цена * Добавить.Количество;
			//31.07.2019
			если НДСизНоменклатуры = Истина тогда
			 Добавить.СтавкаНДС = бит_ОбщегоНазначения.ПолучитьСтавкуНДСИзВидаСтавки(стр.Услуга.Номенклатура.ВидСтавкиНДС);
			иначе 
			 Добавить.СтавкаНДС = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяСтавкаНДС",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
			конецесли;
			ЗначениеСтавкиНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Добавить.СтавкаНДС);
			Добавить.СуммаНДС = Добавить.Сумма*ЗначениеСтавкиНДС/(100+ЗначениеСтавкиНДС);
			
			если Объект.УчитыватьАванс = истина тогда
			    // БИТ ЖКХ 31.12.2020 РТС
				Выборка = Запрос.Выполнить().Выбрать();
				Если Выборка.Следующий() Тогда
					Тариф = ?(Выборка.Тариф = 0, Выборка.ОсновнаяСтавка, Выборка.Тариф);
					Если Тариф <> 0 Тогда
						Добавить.Цена = Тариф;
						Добавить.Количество = Добавить.Сумма / Тариф;
					КонецЕсли;
				КонецЕсли;
			конецесли;
			
		КонецЦикла;
		
	Иначе
		// БИТ ЖКХ 19.03.2021
		таблицаОплат = Оплата.СписокУслуг.Выгрузить();
		таблицаОплат.Свернуть("Услуга", "Сумма, СуммаПени");
		таблицаОплат.Колонки.Добавить("Номенклатура");
		
		Для каждого стр из таблицаОплат цикл
		  стр.Номенклатура = стр.Услуга.Номенклатура;	
		КонецЦикла;     		
        таблицаОплат.Свернуть("Номенклатура", "Сумма, СуммаПени");

		Для каждого стр из таблицаОплат цикл //Оплата.СписокУслуг Цикл
			
			Добавить = Счет.Товары.Добавить();
			Добавить.Номенклатура = стр.Номенклатура;//стр.Услуга.Номенклатура;
			Добавить.Цена = стр.Сумма + стр.СуммаПени;
			Добавить.Количество = 1;
			Добавить.Сумма = Добавить.Цена * Добавить.Количество;
			////31.07.2019
			если НДСизНоменклатуры = Истина тогда
			 Добавить.СтавкаНДС = бит_ОбщегоНазначения.ПолучитьСтавкуНДСИзВидаСтавки(стр.Услуга.Номенклатура.ВидСтавкиНДС);
			иначе 
			 Добавить.СтавкаНДС = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяСтавкаНДС",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
			конецесли;
            ЗначениеСтавкиНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(Добавить.СтавкаНДС);
			Добавить.СуммаНДС = Добавить.Сумма*ЗначениеСтавкиНДС/(100+ЗначениеСтавкиНДС);
		КонецЦикла;
		
	КонецЕсли;	
	
	Попытка
		
		Счет.Записать();
		
		СчетЗаписан = Истина;
		//РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокумента(Счет.Ссылка, Перечисления.СтатусОплатыСчета.Оплачен);
	Исключение
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'Счет на оплату' не записан по причине: " + ОписаниеОшибки());		
	КонецПопытки;
	
	// БИТ ЖКХ 09.04.2020
	Попытка		
		СтатусыДокумента = РегистрыСведений.СтатусыДокументов.НовыеСтатусыДокумента();
	    СтатусыДокумента.Статус = Перечисления.СтатусОплатыСчета.Оплачен;
		РегистрыСведений.СтатусыДокументов.УстановитьСтатусыДокумента(Счет.Ссылка, СтатусыДокумента);
	Исключение
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка установки статуса документа 'Счет на оплату' по причине: " + ОписаниеОшибки());		
	КонецПопытки;

	
	ЭтоДокумент = Истина;
	Попытка
		Если СтрНайти(Строка(ТипЗнч(ПлатежныйДокумент)),"сылка") > 0  Тогда
			ЭтоДокумент = Ложь;	
			ПлатежныйДокумент = ПлатежныйДокумент.Ссылка.ПолучитьОбъект();
		КонецЕсли;
		
		ПлатежныйДокумент.ДокументОснование = Счет.Ссылка;
		
		Если ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
			ПлатежныйДокумент.СчетКонтрагента = Счет.Ссылка;
		КонецЕсли;
		ПлатежныйДокумент.РасшифровкаПлатежа[0].СчетНаОплату = Счет.Ссылка;
		
		
		ПлатежныйДокумент.Записать();
	Исключение
		Если ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'ПКО' не записан по причине: " + ОписаниеОшибки());
		ИначеЕсли ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'Поступление на расчетный счет' не записан по причине: " + ОписаниеОшибки());
		Иначе
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'Оплата платежной картой' не записан по причине: " + ОписаниеОшибки());
		КонецЕсли;
	КонецПопытки;		
	
	Если Не ЭтоДокумент Тогда
		ПлатежныйДокумент = ПлатежныйДокумент.Ссылка;	
	КонецЕсли;		
	
КонецПроцедуры


// Процедура заполняет документ ПКО и выполняет его запись.
//
&НаСервере
Процедура ЗаполнитьПКО(ПлатежныйДокумент,Строка, Оплата, ДокументЗаписан = Ложь, РабитьПоЛС = Ложь, ТранзитныйСчетОплаты, ПрименениеУСН, СуммаПринимаемых, БанковскийСчет, ИсточникОплаты)
	
	ПлатежныйДокумент.Дата				= Оплата.Дата;
// Первый БИТ + --------------------------	
	//ПлатежныйДокумент.Организация		= Оплата.Организация;
	ПлатежныйДокумент.Организация		= БанковскийСчет.Владелец;
// Первый БИТ - --------------------------	
	ПлатежныйДокумент.ВидОперации		= Объект.ВидОперации;	
	ПлатежныйДокумент.ДокументОснование	= Оплата;	
	ПлатежныйДокумент.Ответственный		= Оплата.Ответственный;	
	
	Если НЕ ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		ПлатежныйДокумент.СчетУчетаРасчетовСКонтрагентом = ТранзитныйСчетОплаты;
	Иначе
		ПлатежныйДокумент.ВидОплаты = Объект.ВидОплаты;
	КонецЕсли;
	
	Если НЕ РабитьПоЛС Тогда
		Контрагент = ?(РабитьПоЛС, ПолучитьКонтрагентаЛицевогоСчета(Оплата.Дата, Строка.ЛицевойСчет), Строка.ИсточникОплаты);
	Иначе
		Контрагент = Строка.СубконтоКУ1;
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.бит_КассыККМ") Тогда
		
		Контрагент = Контрагент.Контрагент;
		
		
	ИначеЕсли ТипЗнч(Контрагент) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		
		Контрагент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		
	Иначе
		
	КонецЕсли;
	
// Первый БИТ + --------------------------	
	Если НЕ ЗначениеЗаполнено(Контрагент) Тогда
		Контрагент = Справочники.Контрагенты.НайтиПоРеквизиту("НаименованиеПолное", "Жильцы");
	КонецЕсли; 
// Первый БИТ - --------------------------	
	
	Если РабитьПоЛС Тогда
		
		ПлатежныйДокумент.бит_ЛицевойСчет = Строка.ЛицевойСчет; 
		
		Ответственный = ОтветственныйНаЛС(Строка.ЛицевойСчет);
		ПлатежныйДокумент.Комментарий		= Строка(Строка.ЛицевойСчет)+ ";" + Строка(Ответственный)+ ";" + "Введен на основании" + Строка(Оплата);
		
		Если  ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
			ПлатежныйДокумент.НазначениеПлатежа = Строка(Строка.ЛицевойСчет)+ ";" + Строка(Ответственный)+ ";" + "Введен на основании" + Строка(Оплата);
		КонецЕсли;
		
		
		Если  ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			ПлатежныйДокумент.Основание = "Оплата по лицевому счету " + Строка(Строка.ЛицевойСчет);
		КонецЕсли;
		
		Если ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
			//ПлатежныйДокумент.Контрагент = Контрагент;
		Иначе	
			ПлатежныйДокумент.СубконтоКт1 = Контрагент;
		КонецЕсли;	
		
		Если ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			
			ПлатежныйДокумент.ПринятоОт	= "" + ПлатежныйДокумент.СубконтоКт1; // БИТ_ЖКХ 18.11.2010 17:05:25
			
		КонецЕсли; 
		
	Иначе
		
		СтрокаСписокЛС = "";
		ТаблицаЛС = Оплата.СписокЛС.Выгрузить(,"ЛицевойСчет");
		ТаблицаЛС.Свернуть("ЛицевойСчет");
		
		Для Каждого СтрокаЛС из ТаблицаЛС Цикл
			СтрокаСписокЛС = СтрокаСписокЛС + СтрокаЛС.ЛицевойСчет + ";";
		КонецЦикла;
		Если  ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			ПлатежныйДокумент.Основание = "Оплата по лицевым счетам " + СтрокаСписокЛС;
		КонецЕсли; 
		
		ПлатежныйДокумент.Комментарий		= СтрокаСписокЛС + "Введен на основании " + Оплата;
		
		Если  ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
			ПлатежныйДокумент.НазначениеПлатежа = СтрокаСписокЛС + "Введен на основании " + Оплата;
		КонецЕсли;
		
		Если ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
			//ПлатежныйДокумент.Контрагент = Контрагент;
		Иначе	
			ПлатежныйДокумент.СубконтоКт1 = Контрагент;
		КонецЕсли;	
		
	КонецЕсли;
	
	Если НЕ ЭтоПоступлениеНаРасчетныйСчет = 2 И ТипЗнч(ПлатежныйДокумент.СубконтоКт1) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(ПлатежныйДокумент.СубконтоКт1) Тогда
		
		ОсновнойДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		МассивВидовДоговоров = Новый Массив;
		МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Прочее);
		РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ОсновнойДоговорКонтрагента,ПлатежныйДокумент.СубконтоКт1,ПлатежныйДокумент.Организация,МассивВидовДоговоров);
		ПлатежныйДокумент.СубконтоКт2 = ОсновнойДоговорКонтрагента;
		
	КонецЕсли; 
	
	СтрокаПлатеж = ПлатежныйДокумент.РасшифровкаПлатежа.Добавить();
	
	СтрокаПлатеж.СуммаПлатежа        = ?(РабитьПоЛС, Строка.Сумма, Строка.СуммаДокумента);
	СтрокаПлатеж.СуммаВзаиморасчетов = ?(РабитьПоЛС, Строка.Сумма, Строка.СуммаДокумента);
	
	ПлатежныйДокумент.Контрагент = Контрагент;
	
	СтрокаПлатеж.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	
	Если ТипЗнч(ПлатежныйДокумент.Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(ПлатежныйДокумент.Контрагент)  Тогда
		
		ОсновнойДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		МассивВидовДоговоров = Новый Массив;
		МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Прочее);
		РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ОсновнойДоговорКонтрагента,Контрагент,ПлатежныйДокумент.Организация,МассивВидовДоговоров);
		СтрокаПлатеж.ДоговорКонтрагента		= ОсновнойДоговорКонтрагента;
		ПлатежныйДокумент.ДоговорКонтрагента= ОсновнойДоговорКонтрагента;
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ПрочиеРасчетыСКонтрагентами 
			И НЕ ОсновнойДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее Тогда
			СтрокаПлатеж.ДоговорКонтрагента		= Неопределено;
			ПлатежныйДокумент.ДоговорКонтрагента= Неопределено;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ПлатежныйДокумент.ДоговорКонтрагента) Тогда
		ТекстСообщения = НСтр("ru = 'Не сформирован платежный документ по оплате ""%1""! Не указан основной договор для плательщика: %2.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Оплата, Контрагент);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	СтруктураКурсаВзаиморасчетов  = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаПлатеж.ДоговорКонтрагента.ВалютаВзаиморасчетов, Оплата.Дата);
	
	ПроверкаКурсовВалют(СтрокаПлатеж,СтруктураКурсаВзаиморасчетов.Курс,СтруктураКурсаВзаиморасчетов.Кратность);
	
	СтрокаПлатеж.КурсВзаиморасчетов      = СтруктураКурсаВзаиморасчетов.Курс;
	СтрокаПлатеж.КратностьВзаиморасчетов = СтруктураКурсаВзаиморасчетов.Кратность;
	
	СчетаУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаРасчетовСКонтрагентом(
	
	ПлатежныйДокумент.Организация, ПлатежныйДокумент.Контрагент, СтрокаПлатеж.ДоговорКонтрагента);
	
	СтрокаПлатеж.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
	СтрокаПлатеж.СчетУчетаРасчетовПоАвансам     = СчетаУчета.СчетАвансовПокупателя;
	
	ПлатежныйДокумент.СуммаДокумента = СтрокаПлатеж.СуммаПлатежа;
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
		
		ПлатежныйДокумент.СчетБанк = Объект.СчетКасса;
		
		Если НЕ (Объект.СчетКасса.Валютный) Тогда
			
			ПлатежныйДокумент.ВалютаДокумента=Константы.ВалютаРегламентированногоУчета.Получить();
			
		КонецЕсли;
		
		ПлатежныйДокумент.СчетОрганизации = ?(ЗначениеЗаполнено(БанковскийСчет), БанковскийСчет
												,ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент.Организация, "ОсновнойБанковскийСчет"));
	ИначеЕсли  ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВидОплаты, "Контрагент, ДоговорКонтрагента, СчетУчетаРасчетов");

		ПлатежныйДокумент.СчетКасса			= СтруктураРеквизитов.СчетУчетаРасчетов;
		ПлатежныйДокумент.Эквайер			= СтруктураРеквизитов.Контрагент;
		ПлатежныйДокумент.ДоговорЭквайринга = СтруктураРеквизитов.ДоговорКонтрагента;
		
		Если ЗначениеЗаполнено(СтруктураРеквизитов.СчетУчетаРасчетов)
			И НЕ (СтруктураРеквизитов.СчетУчетаРасчетов.Валютный) Тогда
			
			ПлатежныйДокумент.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
			
		КонецЕсли;
	Иначе	
		
		ПлатежныйДокумент.СчетКасса = Объект.СчетКасса;
		
		Если НЕ (Объект.СчетКасса.Валютный) Тогда
			
			ПлатежныйДокумент.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НЕ ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда 
		СтрокаПлатеж.СтатьяДвиженияДенежныхСредств		= Объект.СтатьяДвиженияДенежныхСредств;
		ПлатежныйДокумент.СтатьяДвиженияДенежныхСредств = Объект.СтатьяДвиженияДенежныхСредств;
	КонецЕсли;

	СтрокаПлатеж.СтавкаНДС = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяСтавкаНДС",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	ЗначениеСтавкиНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтрокаПлатеж.СтавкаНДС);
	
	СтрокаПлатеж.СуммаНДС = СтрокаПлатеж.СуммаПлатежа*ЗначениеСтавкиНДС/(100+ЗначениеСтавкиНДС);
	
	Если ПрименениеУСН Тогда
		ПлатежныйДокумент.Графа4_УСН	= ПлатежныйДокумент.СуммаДокумента;
		ПлатежныйДокумент.Графа5_УСН	= СуммаПринимаемых;
		ПлатежныйДокумент.Содержание_УСН= Строка(ПлатежныйДокумент.ВидОперации) + ". " + Строка(Объект.СтатьяДвиженияДенежныхСредств) + "."
	КонецЕсли;
	
	// БИТ ЖКХ 21.07.2020
	
	попытка
	 если Строка.СубконтоКУ2 <> неопределено и
		  Строка.СубконтоКУ2 <> справочники.ДоговорыКонтрагентов.ПустаяСсылка() тогда
		  
		  ПлатежныйДокумент.ДоговорКонтрагента = Строка.СубконтоКУ2;
		  если ПлатежныйДокумент.РасшифровкаПлатежа.Количество() > 0 тогда 
		   ПлатежныйДокумент.РасшифровкаПлатежа[0].ДоговорКонтрагента = Строка.СубконтоКУ2; 
		  конецесли; 
	 конецесли;	  
    исключение
	конецпопытки; 
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 0
		И ЗначениеЗаполнено(ИсточникОплаты) Тогда
		Если ТипЗнч(ИсточникОплаты) = Тип("СправочникСсылка.Контрагенты") 
			ИЛИ ТипЗнч(ИсточникОплаты) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
			
			НаименованиеИсточникаОплаты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсточникОплаты,"Наименование, НаименованиеПолное");
			ПлатежныйДокумент.ПринятоОт	= ?(ПустаяСтрока(НаименованиеИсточникаОплаты.НаименованиеПолное),
			НаименованиеИсточникаОплаты.Наименование, НаименованиеИсточникаОплаты.НаименованиеПолное);
		Иначе    
			ПлатежныйДокумент.ПринятоОт	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсточникОплаты,"Наименование"); 
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		
		ПлатежныйДокумент.Записать();
		
		ДокументЗаписан = Истина;
		
	Исключение

		Если ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'ПКО' не записан по причине: " + ОписаниеОшибки());
		ИначеЕсли ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'Поступление на расчетный счет' не записан по причине: " + ОписаниеОшибки());
		Иначе
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'Оплата платежной картой' не записан по причине: " + ОписаниеОшибки());
		КонецЕсли;
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
// БИТ ЖКХ 08.10.2020
Процедура ЗаполнитьПКОПоступлениеПлатежа(ПлатежныйДокумент,Строка, Оплата, ДокументЗаписан = Ложь, РабитьПоЛС = Ложь, ТранзитныйСчетОплаты, ПрименениеУСН, СуммаПринимаемых, БанковскийСчет, ИсточникОплаты)
	
	ПлатежныйДокумент.Дата				= Оплата.Дата;
	ПлатежныйДокумент.Организация		= Оплата.Организация;
	ПлатежныйДокумент.ВидОперации		= Объект.ВидОперации;	
	ПлатежныйДокумент.ДокументОснование	= Оплата;	
	ПлатежныйДокумент.Ответственный		= Оплата.Ответственный;	
	ПлатежныйДокумент.СчетБанк          = Объект.СчетКасса;
	
	
	Если НЕ ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		ПлатежныйДокумент.СчетУчетаРасчетовСКонтрагентом = ТранзитныйСчетОплаты;
	Иначе
		ПлатежныйДокумент.ВидОплаты = Объект.ВидОплаты;
	КонецЕсли;
	
	Если НЕ РабитьПоЛС Тогда
		Контрагент = ?(РабитьПоЛС, ПолучитьКонтрагентаЛицевогоСчета(Оплата.Дата, Строка.ЛицевойСчет), Строка.ИсточникОплаты);
	Иначе
		Контрагент = Строка.СубконтоКУ1;
	КонецЕсли;
	
	Если ТипЗнч(Контрагент) = Тип("СправочникСсылка.бит_КассыККМ") Тогда
		
		Контрагент = Контрагент.Контрагент;
		
		
	ИначеЕсли ТипЗнч(Контрагент) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
		
		Контрагент = ПредопределенноеЗначение("Справочник.Контрагенты.ПустаяСсылка");
		
	Иначе
		
	КонецЕсли;
	
	Если РабитьПоЛС Тогда
		
		ПлатежныйДокумент.бит_ЛицевойСчет = Строка.ЛицевойСчет; 
		
		Ответственный = ОтветственныйНаЛС(Строка.ЛицевойСчет);
		ПлатежныйДокумент.Комментарий		= Строка(Строка.ЛицевойСчет)+ ";" + Строка(Ответственный)+ ";" + "Введен на основании" + Строка(Оплата);
		
		Если  ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
			ПлатежныйДокумент.НазначениеПлатежа = Строка(Строка.ЛицевойСчет)+ ";" + Строка(Ответственный)+ ";" + "Введен на основании" + Строка(Оплата);
		КонецЕсли;
		
		
		Если  ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			ПлатежныйДокумент.Основание = "Оплата по лицевому счету " + Строка(Строка.ЛицевойСчет);
		КонецЕсли;
		
		Если ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
			//ПлатежныйДокумент.Контрагент = Контрагент;
		Иначе	
			ПлатежныйДокумент.СубконтоКт1 = Контрагент;
		КонецЕсли;	
		
		Если ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			
			ПлатежныйДокумент.ПринятоОт	= "" + ПлатежныйДокумент.СубконтоКт1; // БИТ_ЖКХ 18.11.2010 17:05:25
			
		КонецЕсли; 
		
	Иначе
		
		СтрокаСписокЛС = "";
		ТаблицаЛС = Оплата.СписокЛС.Выгрузить(,"ЛицевойСчет");
		ТаблицаЛС.Свернуть("ЛицевойСчет");
		
		Для Каждого СтрокаЛС из ТаблицаЛС Цикл
			СтрокаСписокЛС = СтрокаСписокЛС + СтрокаЛС.ЛицевойСчет + ";";
		КонецЦикла;
		Если  ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			ПлатежныйДокумент.Основание = "Оплата по лицевым счетам " + СтрокаСписокЛС;
		КонецЕсли; 
		
		ПлатежныйДокумент.Комментарий		= СтрокаСписокЛС + "Введен на основании " + Оплата;
		
		Если  ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
			ПлатежныйДокумент.НазначениеПлатежа = СтрокаСписокЛС + "Введен на основании " + Оплата;
		КонецЕсли;
		
		Если ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
			//ПлатежныйДокумент.Контрагент = Контрагент;
		Иначе	
			ПлатежныйДокумент.СубконтоКт1 = Контрагент;
		КонецЕсли;	
		
	КонецЕсли;
	
	Если НЕ ЭтоПоступлениеНаРасчетныйСчет = 2 И ТипЗнч(ПлатежныйДокумент.СубконтоКт1) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(ПлатежныйДокумент.СубконтоКт1) Тогда
		
		ОсновнойДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		МассивВидовДоговоров = Новый Массив;
		МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Прочее);
		РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ОсновнойДоговорКонтрагента,ПлатежныйДокумент.СубконтоКт1,ПлатежныйДокумент.Организация,МассивВидовДоговоров);
		ПлатежныйДокумент.СубконтоКт2 = ОсновнойДоговорКонтрагента;
		
	КонецЕсли; 
	
	СтрокаПлатеж = ПлатежныйДокумент.РасшифровкаПлатежа.Добавить();
	
	СтрокаПлатеж.СуммаПлатежа        = ?(РабитьПоЛС, Строка.Сумма, Строка.СуммаДокумента);
	СтрокаПлатеж.СуммаВзаиморасчетов = ?(РабитьПоЛС, Строка.Сумма, Строка.СуммаДокумента);
	
	ПлатежныйДокумент.Контрагент = Контрагент;
	
	СтрокаПлатеж.СпособПогашенияЗадолженности = Перечисления.СпособыПогашенияЗадолженности.Автоматически;
	
	Если ТипЗнч(ПлатежныйДокумент.Контрагент) = Тип("СправочникСсылка.Контрагенты") И ЗначениеЗаполнено(ПлатежныйДокумент.Контрагент)  Тогда
		
		ОсновнойДоговорКонтрагента = Справочники.ДоговорыКонтрагентов.ПустаяСсылка();
		МассивВидовДоговоров = Новый Массив;
		МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.СПокупателем);
		МассивВидовДоговоров.Добавить(Перечисления.ВидыДоговоровКонтрагентов.Прочее);
		РаботаСДоговорамиКонтрагентовБП.УстановитьДоговорКонтрагента(ОсновнойДоговорКонтрагента,Контрагент,ПлатежныйДокумент.Организация,МассивВидовДоговоров);
		СтрокаПлатеж.ДоговорКонтрагента		= ОсновнойДоговорКонтрагента;
		ПлатежныйДокумент.ДоговорКонтрагента= ОсновнойДоговорКонтрагента;
		
		Если Объект.ВидОперации = Перечисления.ВидыОперацийПоступлениеДенежныхСредств.ПрочиеРасчетыСКонтрагентами 
			И НЕ ОсновнойДоговорКонтрагента.ВидДоговора = Перечисления.ВидыДоговоровКонтрагентов.Прочее Тогда
			СтрокаПлатеж.ДоговорКонтрагента		= Неопределено;
			ПлатежныйДокумент.ДоговорКонтрагента= Неопределено;
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НЕ ЗначениеЗаполнено(ПлатежныйДокумент.ДоговорКонтрагента) Тогда
		ТекстСообщения = НСтр("ru = 'Не сформирован платежный документ по оплате ""%1""! Не указан основной договор для плательщика: %2.'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, Оплата, Контрагент);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	СтруктураКурсаВзаиморасчетов  = РаботаСКурсамиВалют.ПолучитьКурсВалюты(СтрокаПлатеж.ДоговорКонтрагента.ВалютаВзаиморасчетов, Оплата.Дата);
	
	ПроверкаКурсовВалют(СтрокаПлатеж,СтруктураКурсаВзаиморасчетов.Курс,СтруктураКурсаВзаиморасчетов.Кратность);
	
	СтрокаПлатеж.КурсВзаиморасчетов      = СтруктураКурсаВзаиморасчетов.Курс;
	СтрокаПлатеж.КратностьВзаиморасчетов = СтруктураКурсаВзаиморасчетов.Кратность;
	
	СчетаУчета = БухгалтерскийУчетПереопределяемый.ПолучитьСчетаРасчетовСКонтрагентом(
	
	ПлатежныйДокумент.Организация, ПлатежныйДокумент.Контрагент, СтрокаПлатеж.ДоговорКонтрагента);
	
	СтрокаПлатеж.СчетУчетаРасчетовСКонтрагентом = СчетаУчета.СчетРасчетовПокупателя;
	СтрокаПлатеж.СчетУчетаРасчетовПоАвансам     = СчетаУчета.СчетАвансовПокупателя;
	
	ПлатежныйДокумент.СуммаДокумента = СтрокаПлатеж.СуммаПлатежа;
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
		
		ПлатежныйДокумент.СчетБанк = Объект.СчетКасса;
		
		Если НЕ (Объект.СчетКасса.Валютный) Тогда
			
			ПлатежныйДокумент.ВалютаДокумента=Константы.ВалютаРегламентированногоУчета.Получить();
			
		КонецЕсли;
		
		ПлатежныйДокумент.СчетОрганизации = ?(ЗначениеЗаполнено(БанковскийСчет), БанковскийСчет
												,ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ПлатежныйДокумент.Организация, "ОсновнойБанковскийСчет"));
	ИначеЕсли  ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда
		
		СтруктураРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(Объект.ВидОплаты, "Контрагент, ДоговорКонтрагента, СчетУчетаРасчетов");

		ПлатежныйДокумент.СчетКасса			= СтруктураРеквизитов.СчетУчетаРасчетов;
		ПлатежныйДокумент.Эквайер			= СтруктураРеквизитов.Контрагент;
		ПлатежныйДокумент.ДоговорЭквайринга = СтруктураРеквизитов.ДоговорКонтрагента;
		
		Если ЗначениеЗаполнено(СтруктураРеквизитов.СчетУчетаРасчетов)
			И НЕ (СтруктураРеквизитов.СчетУчетаРасчетов.Валютный) Тогда
			
			ПлатежныйДокумент.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
			
		КонецЕсли;
	Иначе	
		
		ПлатежныйДокумент.СчетКасса = Объект.СчетКасса;
		
		Если НЕ (Объект.СчетКасса.Валютный) Тогда
			
			ПлатежныйДокумент.ВалютаДокумента = Константы.ВалютаРегламентированногоУчета.Получить();
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если НЕ ЭтоПоступлениеНаРасчетныйСчет = 2 Тогда 
		СтрокаПлатеж.СтатьяДвиженияДенежныхСредств		= Объект.СтатьяДвиженияДенежныхСредств;
		ПлатежныйДокумент.СтатьяДвиженияДенежныхСредств = Объект.СтатьяДвиженияДенежныхСредств;
	КонецЕсли;

	СтрокаПлатеж.СтавкаНДС = бит_УправлениеПользователямиСервер.ПолучитьЗначениеПоУмолчанию("ОсновнаяСтавкаНДС",бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
	ЗначениеСтавкиНДС = УчетНДСВызовСервераПовтИсп.ПолучитьСтавкуНДС(СтрокаПлатеж.СтавкаНДС);
	
	СтрокаПлатеж.СуммаНДС = СтрокаПлатеж.СуммаПлатежа*ЗначениеСтавкиНДС/(100+ЗначениеСтавкиНДС);
	
	Если ПрименениеУСН Тогда
		ПлатежныйДокумент.Графа4_УСН	= ПлатежныйДокумент.СуммаДокумента;
		ПлатежныйДокумент.Графа5_УСН	= СуммаПринимаемых;
		ПлатежныйДокумент.Содержание_УСН= Строка(ПлатежныйДокумент.ВидОперации) + ". " + Строка(Объект.СтатьяДвиженияДенежныхСредств) + "."
	КонецЕсли;
	
	// БИТ ЖКХ 21.07.2020
	
	попытка
	 если Строка.СубконтоКУ2 <> неопределено и
		  Строка.СубконтоКУ2 <> справочники.ДоговорыКонтрагентов.ПустаяСсылка() тогда
		  
		  ПлатежныйДокумент.ДоговорКонтрагента = Строка.СубконтоКУ2;
		  если ПлатежныйДокумент.РасшифровкаПлатежа.Количество() > 0 тогда 
		   ПлатежныйДокумент.РасшифровкаПлатежа[0].ДоговорКонтрагента = Строка.СубконтоКУ2; 
		  конецесли; 
	 конецесли;	  
    исключение
	конецпопытки; 
	
	Если ЭтоПоступлениеНаРасчетныйСчет = 0
		И ЗначениеЗаполнено(ИсточникОплаты) Тогда
		Если ТипЗнч(ИсточникОплаты) = Тип("СправочникСсылка.Контрагенты") 
			ИЛИ ТипЗнч(ИсточникОплаты) = Тип("СправочникСсылка.ПодразделенияОрганизаций") Тогда
			
			НаименованиеИсточникаОплаты = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(ИсточникОплаты,"Наименование, НаименованиеПолное");
			ПлатежныйДокумент.ПринятоОт	= ?(ПустаяСтрока(НаименованиеИсточникаОплаты.НаименованиеПолное),
			НаименованиеИсточникаОплаты.Наименование, НаименованиеИсточникаОплаты.НаименованиеПолное);
		Иначе    
			ПлатежныйДокумент.ПринятоОт	= ОбщегоНазначения.ЗначениеРеквизитаОбъекта(ИсточникОплаты,"Наименование"); 
		КонецЕсли;
	КонецЕсли;
	
	Попытка
		
		ПлатежныйДокумент.Записать(РежимЗаписиДокумента.Проведение);
		
		ДокументЗаписан = Истина;
		
	Исключение

		Если ЭтоПоступлениеНаРасчетныйСчет = 0 Тогда
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'ПКО' не записан по причине: " + ОписаниеОшибки());
		ИначеЕсли ЭтоПоступлениеНаРасчетныйСчет = 1 Тогда
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'Поступление на расчетный счет' не записан по причине: " + ОписаниеОшибки());
		Иначе
			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Документ 'Оплата платежной картой' не записан по причине: " + ОписаниеОшибки());
		КонецЕсли;
		
	КонецПопытки;
	
КонецПроцедуры

&НаСервере
Функция ПолучитьТаблицуУСН(Оплата)
	
	Запрос = Новый Запрос;
	
	Запрос.УстановитьПараметр("Ссылка", Оплата);
	Запрос.УстановитьПараметр("Дата"  , Оплата.Дата);
	
	Запрос.УстановитьПараметр("Организация"  , Оплата.Организация);
	
	Если НЕ НеПриниматьПениСобственныхУслугВДоход и НЕ НеПриниматьПениСтороннихУслугВДоход Тогда
		
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ОплатаКУСписокУслуг.ЛицевойСчет,
		|	бит_ОплатаКУСписокУслуг.Услуга,
		|	СУММА(бит_ОплатаКУСписокУслуг.Сумма + бит_ОплатаКУСписокУслуг.СуммаПени) КАК Сумма,
		|	СУММА(бит_ОплатаКУСписокУслуг.Сумма) КАК СуммаБезПени,
		|	СУММА(бит_ОплатаКУСписокУслуг.СуммаПени) КАК СуммаПени
		|ПОМЕСТИТЬ Оплата
		|ИЗ
		|	Документ.бит_ОплатаКУ.СписокУслуг КАК бит_ОплатаКУСписокУслуг
		|ГДЕ
		|	бит_ОплатаКУСписокУслуг.Ссылка = &Ссылка
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_ОплатаКУСписокУслуг.Услуга,
		|	бит_ОплатаКУСписокУслуг.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	Поставщики.ЛицевойСчет КАК ЛицевойСчет,
		|	СУММА(ВЫБОР
		|			КОГДА НЕ бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств ССЫЛКА Справочник.Организации
		|				ТОГДА ЕСТЬNULL(Поставщики.СуммаПени, 0)
		|			ИНАЧЕ ВЫБОР
		|					КОГДА Поставщики.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийпоЖКХ.Аренда)
		|							И бит_НастройкаПараметровЖКХСрезПоследних.СчетСУАренды.НалоговыйУчет = ЛОЖЬ
		|							И бит_НастройкаПараметровЖКХСрезПоследних.СчетПениСУ.НалоговыйУчет = ИСТИНА
		|						ТОГДА ЕСТЬNULL(Поставщики.СуммаПени, 0)
		|					КОГДА Поставщики.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийпоЖКХ.Аренда)
		|							И бит_НастройкаПараметровЖКХСрезПоследних.СчетСУАренды.НалоговыйУчет = ИСТИНА
		|						ТОГДА ЕСТЬNULL(Поставщики.Сумма, 0)
		|					ИНАЧЕ ВЫБОР
		|							КОГДА Поставщики.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийпоЖКХ.Коммунальная)
		|									И бит_НастройкаПараметровЖКХСрезПоследних.СчетСУКУ.НалоговыйУчет = ЛОЖЬ
		|									И бит_НастройкаПараметровЖКХСрезПоследних.СчетПениСУ.НалоговыйУчет = ИСТИНА
		|								ТОГДА ЕСТЬNULL(Поставщики.СуммаПени, 0)
		|							КОГДА Поставщики.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийпоЖКХ.Коммунальная)
		|									И бит_НастройкаПараметровЖКХСрезПоследних.СчетСУКУ.НалоговыйУчет = ИСТИНА
		|								ТОГДА ЕСТЬNULL(Поставщики.Сумма, 0)
		|							ИНАЧЕ ВЫБОР
		|									КОГДА Поставщики.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийпоЖКХ.Эксплуатационная)
		|											И бит_НастройкаПараметровЖКХСрезПоследних.СчетСУЦС.НалоговыйУчет = ЛОЖЬ
		|											И бит_НастройкаПараметровЖКХСрезПоследних.СчетПениСУ.НалоговыйУчет = ИСТИНА
		|										ТОГДА ЕСТЬNULL(Поставщики.СуммаПени, 0)
		|									КОГДА Поставщики.Услуга.ТипыНачислений = ЗНАЧЕНИЕ(Перечисление.бит_ТипыНачисленийпоЖКХ.Эксплуатационная)
		|											И бит_НастройкаПараметровЖКХСрезПоследних.СчетСУЦС.НалоговыйУчет = ИСТИНА
		|										ТОГДА ЕСТЬNULL(Поставщики.Сумма, 0)
		|									ИНАЧЕ 0
		|								КОНЕЦ
		|						КОНЕЦ
		|				КОНЕЦ
		|		КОНЕЦ) КАК Сумма,
		|	Поставщики.Услуга,
		|	МАКСИМУМ(бит_ПолучателиДенежныхСредствСрезПоследних.Период) КАК Период,
		|	МАКСИМУМ(бит_ПолучателиДенежныхСредствСрезПоследних.ПолучательДенежныхСредств) КАК ПолучательДенежныхСредств,
		|	Поставщики.Поставщик
		|ИЗ
