#Область Печать

// Заполняет список команд печати.
// 
// Параметры:
//   КомандыПечати - ТаблицаЗначений - состав полей см. в функции УправлениеПечатью.СоздатьКоллекциюКомандПечати.
//
Процедура ДобавитьКомандыПечати(КомандыПечати, ПолноеИмяОбъекта) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ПолноеИмяОбъекта", ПолноеИмяОбъекта);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ПользовательскиеМакетыПечатиНазначение.Ссылка,
	|	бит_ПользовательскиеМакетыПечатиНазначение.Ссылка.Наименование,
	|	бит_ПользовательскиеМакетыПечатиНазначение.Ссылка.Расширение,
	|	бит_ПользовательскиеМакетыПечатиНазначение.Ссылка.ИмяМакета
	|ИЗ
	|	Справочник.бит_ПользовательскиеМакетыПечати.Назначение КАК бит_ПользовательскиеМакетыПечатиНазначение
	|ГДЕ
	|	бит_ПользовательскиеМакетыПечатиНазначение.ПолноеИмяОбъектаМетаданных = &ПолноеИмяОбъекта
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПользовательскиеМакетыПечатиНазначение.Ссылка,
	|	бит_ПользовательскиеМакетыПечатиНазначение.Ссылка.Наименование,
	|	бит_ПользовательскиеМакетыПечатиНазначение.Ссылка.Расширение,
	|	бит_ПользовательскиеМакетыПечатиНазначение.Ссылка.ИмяМакета";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		
		КомандаПечати = КомандыПечати.Добавить();
		КомандаПечати.ПользовательскиеМакетыПечати   = Выборка.Ссылка;
		КомандаПечати.Идентификатор                  = Выборка.Наименование;
		КомандаПечати.Представление                  = Выборка.ИмяМакета;
		КомандаПечати.Картинка                       = КартинкаФайла(Выборка.Расширение);
		КомандаПечати.Расширение                     = Выборка.Расширение;
		КомандаПечати.ВнешнийМакет                   = Истина;
		КомандаПечати.Обработчик                     = "бит_УправлениеПечатьюКлиент.ПечатьВФорматеОфисногоДокумента";
		
	КонецЦикла;
	
КонецПроцедуры

// БИТ_ЖКХ Функция.
//
// Параметры:
//
//
// Возвращаемое значение:
//  Результат – Строка.
//
Функция КартинкаФайла(РасширениеФайла)
	
	Результат = БиблиотекаКартинок.бит_ФорматПустой;
	
	Если РасширениеФайла = "doc" ИЛИ РасширениеФайла = "docx" ИЛИ РасширениеФайла = "rtf" Тогда
		Результат = БиблиотекаКартинок.бит_ФорматWord2007;
	КонецЕсли; 
	
	Возврат Результат;
	
КонецФункции // ()
 
Функция ПолучитьДанныеПечати(знач МассивДокументов, знач СведенияОМакете) Экспорт
	
	ДанныеПоВсемОбъектам = Новый Соответствие;
	
	Для Каждого ОбъектСсылка Из МассивДокументов Цикл
		ДанныеОбъектаПоМакетам = Новый Соответствие;
		ДанныеОбъектаПоМакетам.Вставить(СведенияОМакете.ИмяМакета, бит_УправлениеПечатьюСервер.ПолучитьДанныеОбъекта(ОбъектСсылка));
		ДанныеПоВсемОбъектам.Вставить(ОбъектСсылка, ДанныеОбъектаПоМакетам);
	КонецЦикла;
	
	ОписаниеОбластей = Новый Соответствие;
	ДвоичныеДанныеМакетов = Новый Соответствие;
	ТипыМакетов = Новый Соответствие;
	
	Если СведенияОМакете.ВнешнийМакет Тогда
		
		ДвоичныеДанныеМакетов.Вставить(СведенияОМакете.ИмяМакета, бит_УправлениеПечатьюСервер.ПолучитьПользовательскийМакет(СведенияОМакете.ПользовательскиеМакетыПечати));
		ОписаниеОбластей.Вставить(СведенияОМакете.ИмяМакета     , бит_УправлениеПечатьюСервер.ПолучитьОписаниеОбластейМакета(СведенияОМакете.ПользовательскиеМакетыПечати));
		ТипыМакетов.Вставить(СведенияОМакете.ИмяМакета          , СведенияОМакете.Расширение);
		
	КонецЕсли; 
	
	Возврат Новый Структура("Данные, Макеты",
							ДанныеПоВсемОбъектам,
							Новый Структура("ОписаниеОбластей, ТипыМакетов, ДвоичныеДанныеМакетов",
											ОписаниеОбластей,
											ТипыМакетов,
											ДвоичныеДанныеМакетов));
	
КонецФункции

#КонецОбласти

#КонецЕсли