		Если СтрНайти(СтруктураРезультат.КвартираНомер, "]") Тогда
			Начало = КвартираНомер + 44;
			Конец = СтрНайти(АдресXML, "}", ,Начало, )-3;
			
			СтруктураРезультат.КвартираНомер = Сред(АдресXML, Начало, Конец-Начало);
			
		КонецЕсли;
		
		
	КонецЕсли;
	
	Если Страна Тогда
		Начало = Страна+11;
		Конец = СтрНайти(АдресXML, """,", ,Начало,);
		
		СтруктураРезультат.Страна = Сред(АдресXML, Начало, Конец-Начало);
		
	КонецЕсли;
	
	Если Индекс Тогда
		Начало = Индекс+11;
		Конец = СтрНайти(АдресXML, """,", ,Начало,);
		
		СтруктураРезультат.Индекс = Сред(АдресXML, Начало, Конец-Начало);
		
	КонецЕсли;
	
	Если Регион Тогда
		Начало = Регион +8;
		Конец = СтрНайти(АдресXML, """,", , Начало, );
		
		СтруктураРезультат.Регион = Сред(АдресXML, Начало, Конец-Начало);
	КонецЕсли;
	
	
	Если Город Тогда
		Начало = Город +8;
		Конец = СтрНайти(АдресXML, """,", , Начало, );
		
		СтруктураРезультат.Город = Сред(АдресXML, Начало, Конец-Начало);
	КонецЕсли;	
	
	Если Улица Тогда
		Начало = Улица +10;
		Конец = СтрНайти(АдресXML, """,", , Начало, );
		
		СтруктураРезультат.Улица = Сред(АдресXML, Начало, Конец-Начало);
	КонецЕсли;
	
	
	Если Поселение Тогда
		Начало = Поселение +14;
		Конец = СтрНайти(АдресXML, """,", , Начало, );
		
		СтруктураРезультат.Поселение = Сред(АдресXML, Начало, Конец-Начало);
	КонецЕсли;
	
	
	Если Территория Тогда
		Начало = Территория +13;
		Конец = СтрНайти(АдресXML, """,", , Начало, );
		
		СтруктураРезультат.Территория = Сред(АдресXML, Начало, Конец-Начало);
	КонецЕсли;
	
	
	Если Населенный Тогда
		Начало = Населенный +12;
		Конец = СтрНайти(АдресXML, """,", , Начало, );
		
		СтруктураРезультат.Населенный = Сред(АдресXML, Начало, Конец-Начало);
	КонецЕсли;
	
	
	Если Пункт Тогда
		Начало = Пункт +16;
		Конец = СтрНайти(АдресXML, """,", , Начало, );
		
		СтруктураРезультат.Пункт = Сред(АдресXML, Начало, Конец-Начало);
	КонецЕсли;
	
	
	Если ДомНомер Тогда
		Начало = ДомНомер +15;
		Конец = СтрНайти(АдресXML, """,", , Начало, );
		
		СтруктураРезультат.ДомНомер = Сред(АдресXML, Начало, Конец-Начало);
	КонецЕсли;
	
	
	
	Возврат СтруктураРезультат;							
	
	
	
