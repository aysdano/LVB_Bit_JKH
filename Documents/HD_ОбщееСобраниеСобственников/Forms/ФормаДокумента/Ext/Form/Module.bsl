#Область ПеременныеМодуляФормы

// Переменная для хранения шаблонов текста для полей табличной части ПовесткаДня
// Ключ: "ИндексСтроки_ИмяПоля", Значение: шаблон текста
// Используется для применения логики редактирования с подчеркиваниями
Перем ШаблоныТекста;

// АдресШаблоновОбщихОбластейВоВременномХранилище - это реквизит формы, не нужно объявлять как переменную

#КонецОбласти

#Область ОбработчикиСобытийФормы

//HD+
// Обработчик создания формы
//
&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	ЗаполнитьРеквизитыПоУмолчанию();
	
	УправлениеВидимостьюНаСервере();
	НастроитьВидимостьПредставителяУКНаСервере();
	ПривестиПустыеЗначенияАрендатораКСтрокеНаСервере();
	
	ЕстьДанныеКапремонта = ЗначениеЗаполнено(Объект.СтоимостьПроектныхРабот)
		Или ЗначениеЗаполнено(Объект.ДатаОкончанияРабот)
		Или ЗначениеЗаполнено(Объект.СтоимостьРаботПоКапитальномуРемонту)
		Или ЗначениеЗаполнено(Объект.СтоимостьУслугиПоОрганизацииПроведенияКапитальногоРемонта)
		Или ЗначениеЗаполнено(Объект.ПодряднаяОрганизация)
		Или ЗначениеЗаполнено(Объект.ПроцентСтроительногоКонтроля)
		Или ЗначениеЗаполнено(Объект.ВладелецСчетаКР)
		Или ЗначениеЗаполнено(Объект.ЛицевойСчетКР)
		Или ЗначениеЗаполнено(Объект.Банк);
		
	Если ЕстьДанныеКапремонта Тогда
		Элементы.ГруппаЦентр.Показать();
	Иначе
		Элементы.ГруппаЦентр.Скрыть();
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
&НаСервере
Процедура УправлениеВидимостьюНаСервере()
	
	// Всегда показываем даты очного, заочного и очно-заочного голосования вне зависимости от формы проведения
	Элементы.ГруппаДатаОчногоГолосования.Видимость = Истина;
	Элементы.ГруппаПериодЗаочногоГолосования.Видимость = Истина;
	Элементы.ГруппаПериодОчноЗаочногоГолосования.Видимость = Истина;
	
КонецПроцедуры //HD-

//HD+
// Обработчик открытия формы
//
&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	// Загружаем адрес шаблонов общих областей из объекта документа
	ЗагрузитьАдресШаблоновОбщихОбластейНаСервере();
	
	// Сохраняем шаблоны текста для табличной части ПовесткаДня, если она уже заполнена
	СохранитьШаблоныТекстаПовесткиДняНаСервере();
	НастроитьВидимостьДеталейПовесткиДня(ЭтотОбъект);
	НастроитьПолеЗначенияПользовательскогоПараметра();
	
КонецПроцедуры //HD-

//HD+
// Обработчик события оповещения.
// Используется для обновления связанных реквизитов при изменении данных проживающего (инициатора).
//
&НаКлиенте
Процедура ОбработкаОповещения(ИмяСобытия, Параметр, Источник)
	
	Если ИмяСобытия = "ОбновитьДанныеОФизлице" Тогда
		
		Если ЗначениеЗаполнено(Объект.ИнициаторФИО) 
			И ТипЗнч(Параметр) = Тип("СправочникСсылка.бит_Проживающие") 
			И Параметр = Объект.ИнициаторФИО Тогда
			
			ИнициаторФИОПриИзмененииНаСервере();
			
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
// Загружает адрес шаблонов общих областей из объекта документа
//
&НаСервере
Процедура ЗагрузитьАдресШаблоновОбщихОбластейНаСервере()
	
	// Адрес шаблонов общих областей хранится только в реквизите формы
	// и не сохраняется между сеансами. При первом открытии формы адрес пустой.
	// Адрес заполняется только после сохранения шаблонов через форму редактирования.
	// Это нормальное поведение - при первом открытии используются области из макета.
	
КонецПроцедуры //HD-

#КонецОбласти

#Область ОбработчикиКомандФормы

//HD+
&НаКлиенте
Процедура ОткрытьРеквизитыИнициатора(Команда)
	
	Если Не ЗначениеЗаполнено(Объект.ИнициаторФИО) Тогда
		ПоказатьПредупреждение(, "Сначала выберите инициатора собрания!");
		Возврат;
	КонецЕсли;
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("ИнициаторФИО", Объект.ИнициаторФИО);
	ПараметрыФормы.Вставить("ИнициаторПаспортСерия", Объект.ИнициаторПаспортСерия);
	ПараметрыФормы.Вставить("ИнициаторПаспортНомер", Объект.ИнициаторПаспортНомер);
	ПараметрыФормы.Вставить("ИнициаторСНИЛС", Объект.ИнициаторСНИЛС);
	ПараметрыФормы.Вставить("ИнициаторДатаРождения", Объект.ИнициаторДатаРождения);
	ПараметрыФормы.Вставить("ИнициаторМестоРождения", Объект.ИнициаторМестоРождения);
	ПараметрыФормы.Вставить("ИнициаторАдресРегистрации", Объект.ИнициаторАдресРегистрации);
	ПараметрыФормы.Вставить("ИнициаторТелефон", Объект.ИнициаторТелефон);
	ПараметрыФормы.Вставить("ИнициаторНомерКвартиры", Объект.ИнициаторНомерКвартиры);
	ПараметрыФормы.Вставить("ИнициаторДоляСобственности", Объект.ИнициаторДоляСобственности);
	ПараметрыФормы.Вставить("ИнициаторПлощадьПомещения", Объект.ИнициаторПлощадьПомещения);
	ПараметрыФормы.Вставить("ПравоустанавливающийДокумент", Объект.ПравоустанавливающийДокумент);
	ПараметрыФормы.Вставить("МКД", Объект.МКД);
	
	ОписаниеОповещения = Новый ОписаниеОповещения("ПослеЗакрытияРеквизитовИнициатора", ЭтотОбъект);
	ОткрытьФорму("Документ.HD_ОбщееСобраниеСобственников.Форма.ФормаРедактированияИнициатора", ПараметрыФормы, ЭтотОбъект, , , , ОписаниеОповещения);
	
КонецПроцедуры //HD-

//HD+
&НаКлиенте
Процедура ПослеЗакрытияРеквизитовИнициатора(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		ЗаполнитьРеквизитыИнициатораИзСтруктурыНаСервере(Результат);
		Модифицированность = Истина;
	КонецЕсли;
	
КонецПроцедуры //HD-

//HD+
&НаСервере
Процедура ЗаполнитьРеквизитыИнициатораИзСтруктурыНаСервере(СтруктураРеквизитов)
	
	ЗаполнитьЗначенияСвойств(Объект, СтруктураРеквизитов);
	
КонецПроцедуры //HD-

//HD+
// Обработчик команды печати бланка решения: табличный документ по макету ПФ_MXL_БланкРешения (по одному бланку на участника, разделитель страниц).
// Вывод через общую форму бит_ФормаПечатиУправляемая (как в бит_ПечатьКлиент.ОбработатьКомандуПечати).
//
&НаКлиенте
Процедура ПечатьБланкРешения(Команда)
	
	Перем АдресТабличногоДокументаВоВременномХранилище;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сохраните документ перед печатью бланка решения.");
		Возврат;
	КонецЕсли;
	
	Попытка
		ТабличныйДокументБланка = ПечатьПечатнойФормыНаСервере("ПФ_MXL_БланкРешения");
		Если ТипЗнч(ТабличныйДокументБланка) <> Тип("ТабличныйДокумент") Тогда
			ПоказатьПредупреждение(, "Не удалось сформировать печатную форму бланка решения.");
			Возврат;
		КонецЕсли;
		
		АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(
			ТабличныйДокументБланка,
			АдресТабличногоДокументаВоВременномХранилище);
		
		бит_ПечатьКлиент.ОбработатьКомандуПечати(
			"Документы",
			"HD_ОбщееСобраниеСобственников",
			"ПФ_MXL_БланкРешения",
			"Бланк решения",
			АдресТабличногоДокументаВоВременномХранилище,
			Объект.Ссылка,
			ЭтаФорма);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Обработчик команды печати бланка решения без доверенности: табличный документ по макету ПФ_MXL_БланкРешения без области ОбластьДоверенность.
//
&НаКлиенте
Процедура ПечатьБланкРешенияБезДоверенности(Команда)
	
	Перем АдресТабличногоДокументаВоВременномХранилище;
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сохраните документ перед печатью бланка решения.");
		Возврат;
	КонецЕсли;
	
	Попытка
		ТабличныйДокументБланка = ПечатьПечатнойФормыНаСервере("ПФ_MXL_БланкРешения", Истина);
		Если ТипЗнч(ТабличныйДокументБланка) <> Тип("ТабличныйДокумент") Тогда
			ПоказатьПредупреждение(, "Не удалось сформировать печатную форму бланка решения.");
			Возврат;
		КонецЕсли;
		
		АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(
			ТабличныйДокументБланка,
			АдресТабличногоДокументаВоВременномХранилище);
		
		бит_ПечатьКлиент.ОбработатьКомандуПечати(
			"Документы",
			"HD_ОбщееСобраниеСобственников",
			"ПФ_MXL_БланкРешения",
			"Бланк решения (без доверенности)",
			АдресТабличногоДокументаВоВременномХранилище,
			Объект.Ссылка,
			ЭтаФорма);
	Исключение
		ПоказатьПредупреждение(, КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Обработчик выбора пользователя: открыть в Word или сохранить в папку.
//
&НаКлиенте
Процедура ПечатьБланкРешения_ПослеВыбора(Результат, ДополнительныеПараметры) Экспорт
	Если Результат = Неопределено ИЛИ ДополнительныеПараметры = Неопределено Тогда
		Возврат;
	КонецЕсли;
	РезультатСервера = Неопределено;
	Если ТипЗнч(ДополнительныеПараметры) = Тип("Структура") И ДополнительныеПараметры.Свойство("РезультатСервера") Тогда
		РезультатСервера = ДополнительныеПараметры.РезультатСервера;
	КонецЕсли;
	Если РезультатСервера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Если Результат = "ОткрытьВWord" Тогда
		Для Каждого ДанныеУчастника Из РезультатСервера.МассивДанных Цикл
			СформироватьИПоказатьБланкРешенияЧерезОбщийМодуль(РезультатСервера.ДвоичныеДанныеШаблона, ДанныеУчастника);
		КонецЦикла;
	ИначеЕсли Результат = "СохранитьВПапку" Тогда
		ДиалогВыборКаталога = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
		ДиалогВыборКаталога.Заголовок = "Выберите папку для сохранения бланков решений";
		Если НЕ ДиалогВыборКаталога.Выбрать() Тогда
			Возврат;
		КонецЕсли;
		КаталогСохранения = ДиалогВыборКаталога.Каталог;
		НомерУчастника = 0;
		Для Каждого ДанныеУчастника Из РезультатСервера.МассивДанных Цикл
			НомерУчастника = НомерУчастника + 1;
			ИмяФайла = СформироватьИмяФайлаБланкаРешения(ДанныеУчастника, НомерУчастника);
			СформироватьИСохранитьБланкРешенияВФайл(РезультатСервера.ДвоичныеДанныеШаблона, ДанныеУчастника, КаталогСохранения, ИмяФайла);
		КонецЦикла;
		ПоказатьПредупреждение(, "Бланки решений сохранены в папку: " + КаталогСохранения);
	КонецЕсли;
КонецПроцедуры //HD-

//HD+
// Формирует имя файла для бланка решения: Бланк_кв_25.docx или Бланк_1.docx при отсутствии квартиры.
//
&НаКлиенте
Функция СформироватьИмяФайлаБланкаРешения(ДанныеУчастника, НомерУчастника)
	Квартира = "";
	Если ТипЗнч(ДанныеУчастника) = Тип("Структура") И ДанныеУчастника.Свойство("УчастникиСобранияКвартира") Тогда
		Квартира = СокрЛП(Строка(ДанныеУчастника.УчастникиСобранияКвартира));
	КонецЕсли;
	Если ЗначениеЗаполнено(Квартира) Тогда
		Возврат "Бланк_кв_" + Квартира + ".docx";
	КонецЕсли;
	Возврат "Бланк_" + Формат(НомерУчастника, "ЧГ=0") + ".docx";
КонецФункции //HD-

//HD+
// Закрывает документ шаблона в Word по пути из Макет.ИмяФайла, чтобы файл был освобождён и УдалитьФайлы в ЗакрытьСоединение не вызывала ошибку совместного доступа.
//
&НаКлиенте
Процедура ЗакрытьДокументШаблонаВWord(Макет)
	Если ТипЗнч(Макет) <> Тип("Структура") ИЛИ НЕ Макет.Свойство("COMСоединение") ИЛИ НЕ Макет.Свойство("ИмяФайла") Тогда
		Возврат;
	КонецЕсли;
	Если Макет.COMСоединение = Неопределено ИЛИ НЕ ЗначениеЗаполнено(Макет.ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	Попытка
		ПутьШаблона = ВРег(СтрЗаменить(Макет.ИмяФайла, "/", "\"));
		КолвоДокументов = Макет.COMСоединение.Documents.Count;
		Номер = КолвоДокументов;
		Пока Номер >= 1 Цикл
			Док = Макет.COMСоединение.Documents.Item(Номер);
			ПутьДокумента = ВРег(СтрЗаменить(Док.FullName, "/", "\"));
			Если ПутьДокумента = ПутьШаблона Тогда
				Док.Close(0); // 0 = wdDoNotSaveChanges
				Прервать;
			КонецЕсли;
			Номер = Номер - 1;
		КонецЦикла;
	Исключение
	КонецПопытки;
КонецПроцедуры //HD-

//HD+
// Формирует один бланк решения и выводит в Word через общий модуль УправлениеПечатьюMSWordКлиент: получение макета, заполнение областей ШапкаТаблицы и СтрокаТаблицы, вывод на экран.
//
&НаКлиенте
Процедура СформироватьИПоказатьБланкРешенияЧерезОбщийМодуль(ДвоичныеДанныеШаблона, ДанныеУчастника)
	
	Если ТипЗнч(ДвоичныеДанныеШаблона) <> Тип("ДвоичныеДанные") ИЛИ ТипЗнч(ДанныеУчастника) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВременногоФайла = "HD_Бланк_шаблон_" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах()) + ".docx";
	Макет = УправлениеПечатьюMSWordКлиент.ПолучитьМакетMSWord(ДвоичныеДанныеШаблона, ИмяВременногоФайла);
	Если Макет = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось открыть шаблон бланка решения в Word.");
		Возврат;
	КонецЕсли;
	
	Попытка
		ПечатнаяФорма = УправлениеПечатьюMSWordКлиент.ИнициализироватьПечатнуюФормуMSWord(Макет);
		
		ОбластьТелоБланка = УправлениеПечатьюMSWordКлиент.ПолучитьОбластьМакетаMSWord(Макет, "ТелоБланка");
		Если ОбластьТелоБланка <> Неопределено Тогда
			ОбластьВставки = УправлениеПечатьюMSWordКлиент.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьТелоБланка, Ложь);
			УправлениеПечатьюMSWordКлиент.ЗаполнитьПараметры(ОбластьВставки, ДанныеУчастника);
		КонецЕсли;
		
		ОбластьШапка = УправлениеПечатьюMSWordКлиент.ПолучитьОбластьМакетаMSWord(Макет, "ШапкаТаблицы");
		Если ОбластьШапка <> Неопределено Тогда
			ОбластьВставки = УправлениеПечатьюMSWordКлиент.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьШапка, Ложь);
			УправлениеПечатьюMSWordКлиент.ЗаполнитьПараметры(ОбластьВставки, ДанныеУчастника);
		КонецЕсли;
		
		ОбластьСтрока = УправлениеПечатьюMSWordКлиент.ПолучитьОбластьМакетаMSWord(Макет, "СтрокаТаблицы");
		Если ОбластьСтрока = Неопределено Тогда
			ЗакрытьДокументШаблонаВWord(Макет);
			УправлениеПечатьюMSWordКлиент.ЗакрытьСоединение(Макет, Ложь);
			ПоказатьПредупреждение(, "В шаблоне бланка решения не найдена область СтрокаТаблицы.");
			Возврат;
		КонецЕсли;
		
		//HD+ С сервера приходят массивы: один элемент = один пункт (обход ПовесткаДня, ФормулировкаПредложенияРешенияВопроса)
		МассивНомер = ДанныеУчастника.ПредложенияПовесткиДняНомерСтроки;
		МассивТекст = ДанныеУчастника.ПредложенияПовесткиДня;
		Если ТипЗнч(МассивНомер) <> Тип("Массив") Тогда
			МассивНомер = Новый Массив;
		КонецЕсли;
		Если ТипЗнч(МассивТекст) <> Тип("Массив") Тогда
			МассивТекст = Новый Массив;
		КонецЕсли;
		МассивДанныхСтрок = Новый Массив;
		КолвоПунктов = Мин(МассивНомер.Количество(), МассивТекст.Количество());
		Для Индекс = 0 По КолвоПунктов - 1 Цикл
			МассивДанныхСтрок.Добавить(Новый Структура("ПредложенияПовесткиДняНомерСтроки, ПредложенияПовесткиДня", МассивНомер[Индекс], МассивТекст[Индекс]));
		КонецЦикла;
		
		УправлениеПечатьюMSWordКлиент.ПрисоединитьИЗаполнитьОбластьТаблицы(ПечатнаяФорма, ОбластьСтрока, МассивДанныхСтрок, Ложь);
		
		ОбластьПодвал = УправлениеПечатьюMSWordКлиент.ПолучитьОбластьМакетаMSWord(Макет, "Подвал");
		Если ОбластьПодвал <> Неопределено Тогда
			ОбластьВставки = УправлениеПечатьюMSWordКлиент.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьПодвал, Ложь);
			УправлениеПечатьюMSWordКлиент.ЗаполнитьПараметры(ОбластьВставки, ДанныеУчастника);
		КонецЕсли;
		
		УдалитьТегиОбластейВДокументеWord(ПечатнаяФорма);
		
		УправлениеПечатьюMSWordКлиент.ПоказатьДокументMSWord(ПечатнаяФорма);
		ЗакрытьДокументШаблонаВWord(Макет);
		УправлениеПечатьюMSWordКлиент.ЗакрытьСоединение(Макет, Ложь);
	Исключение
		ЗакрытьДокументШаблонаВWord(Макет);
		УправлениеПечатьюMSWordКлиент.ЗакрытьСоединение(Макет, Ложь);
		ПоказатьПредупреждение(, "Ошибка при формировании бланка решения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Формирует бланк решения и сохраняет его в файл по указанному пути (без открытия в Word).
//
&НаКлиенте
Процедура СформироватьИСохранитьБланкРешенияВФайл(ДвоичныеДанныеШаблона, ДанныеУчастника, КаталогСохранения, ИмяФайла)
	Если ТипЗнч(ДвоичныеДанныеШаблона) <> Тип("ДвоичныеДанные") ИЛИ ТипЗнч(ДанныеУчастника) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	Если НЕ ЗначениеЗаполнено(КаталогСохранения) ИЛИ НЕ ЗначениеЗаполнено(ИмяФайла) Тогда
		Возврат;
	КонецЕсли;
	
	ИмяВременногоФайла = "HD_Бланк_шаблон_" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах()) + ".docx";
	Макет = УправлениеПечатьюMSWordКлиент.ПолучитьМакетMSWord(ДвоичныеДанныеШаблона, ИмяВременногоФайла);
	Если Макет = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось открыть шаблон бланка решения в Word.");
		Возврат;
	КонецЕсли;
	
	Попытка
		ПечатнаяФорма = УправлениеПечатьюMSWordКлиент.ИнициализироватьПечатнуюФормуMSWord(Макет);
		
		ОбластьТелоБланка = УправлениеПечатьюMSWordКлиент.ПолучитьОбластьМакетаMSWord(Макет, "ТелоБланка");
		Если ОбластьТелоБланка <> Неопределено Тогда
			ОбластьВставки = УправлениеПечатьюMSWordКлиент.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьТелоБланка, Ложь);
			УправлениеПечатьюMSWordКлиент.ЗаполнитьПараметры(ОбластьВставки, ДанныеУчастника);
		КонецЕсли;
		
		ОбластьШапка = УправлениеПечатьюMSWordКлиент.ПолучитьОбластьМакетаMSWord(Макет, "ШапкаТаблицы");
		Если ОбластьШапка <> Неопределено Тогда
			ОбластьВставки = УправлениеПечатьюMSWordКлиент.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьШапка, Ложь);
			УправлениеПечатьюMSWordКлиент.ЗаполнитьПараметры(ОбластьВставки, ДанныеУчастника);
		КонецЕсли;
		
		ОбластьСтрока = УправлениеПечатьюMSWordКлиент.ПолучитьОбластьМакетаMSWord(Макет, "СтрокаТаблицы");
		Если ОбластьСтрока = Неопределено Тогда
			ЗакрытьДокументШаблонаВWord(Макет);
			УправлениеПечатьюMSWordКлиент.ЗакрытьСоединение(Макет, Ложь);
			ПоказатьПредупреждение(, "В шаблоне бланка решения не найдена область СтрокаТаблицы.");
			Возврат;
		КонецЕсли;
		
		МассивНомер = ДанныеУчастника.ПредложенияПовесткиДняНомерСтроки;
		МассивТекст = ДанныеУчастника.ПредложенияПовесткиДня;
		Если ТипЗнч(МассивНомер) <> Тип("Массив") Тогда МассивНомер = Новый Массив; КонецЕсли;
		Если ТипЗнч(МассивТекст) <> Тип("Массив") Тогда МассивТекст = Новый Массив; КонецЕсли;
		МассивДанныхСтрок = Новый Массив;
		КолвоПунктов = Мин(МассивНомер.Количество(), МассивТекст.Количество());
		Для Индекс = 0 По КолвоПунктов - 1 Цикл
			МассивДанныхСтрок.Добавить(Новый Структура("ПредложенияПовесткиДняНомерСтроки, ПредложенияПовесткиДня", МассивНомер[Индекс], МассивТекст[Индекс]));
		КонецЦикла;
		УправлениеПечатьюMSWordКлиент.ПрисоединитьИЗаполнитьОбластьТаблицы(ПечатнаяФорма, ОбластьСтрока, МассивДанныхСтрок, Ложь);
		
		ОбластьПодвал = УправлениеПечатьюMSWordКлиент.ПолучитьОбластьМакетаMSWord(Макет, "Подвал");
		Если ОбластьПодвал <> Неопределено Тогда
			ОбластьВставки = УправлениеПечатьюMSWordКлиент.ПрисоединитьОбласть(ПечатнаяФорма, ОбластьПодвал, Ложь);
			УправлениеПечатьюMSWordКлиент.ЗаполнитьПараметры(ОбластьВставки, ДанныеУчастника);
		КонецЕсли;
		
		УдалитьТегиОбластейВДокументеWord(ПечатнаяФорма);
		
		ПутьФайла = ОбщегоНазначенияКлиентСервер.ДобавитьКонечныйРазделительПути(КаталогСохранения) + ИмяФайла;
		ПутьФайла = СтрЗаменить(ПутьФайла, "/", "\");
		ПечатнаяФорма.COMСоединение.ActiveDocument.SaveAs(ПутьФайла);
		
		ПечатнаяФорма.COMСоединение.ActiveDocument.Close(0); // 0 = wdDoNotSaveChanges (уже сохранён через SaveAs)
		ЗакрытьДокументШаблонаВWord(Макет);
		УправлениеПечатьюMSWordКлиент.ЗакрытьСоединение(Макет, Ложь);
		УправлениеПечатьюMSWordКлиент.ЗакрытьСоединение(ПечатнаяФорма, Истина); // закрыть приложение Word печатной формы
	Исключение
		ЗакрытьДокументШаблонаВWord(Макет);
		УправлениеПечатьюMSWordКлиент.ЗакрытьСоединение(Макет, Ложь);
		УправлениеПечатьюMSWordКлиент.ЗакрытьСоединение(ПечатнаяФорма, Истина);
		ПоказатьПредупреждение(, "Ошибка при сохранении бланка решения: " + КраткоеПредставлениеОшибки(ИнформацияОбОшибке()));
	КонецПопытки;
КонецПроцедуры //HD-

//HD+
// Удаляет в документе Word теги областей {v8 Область.XXX} и {/v8 Область.XXX}, чтобы они не отображались в печати.
//
&НаКлиенте
Процедура УдалитьТегиОбластейВДокументеWord(ПечатнаяФорма)
	Если ТипЗнч(ПечатнаяФорма) <> Тип("Структура") ИЛИ НЕ ПечатнаяФорма.Свойство("COMСоединение") Тогда
		Возврат;
	КонецЕсли;
	Если ПечатнаяФорма.COMСоединение = Неопределено Тогда
		Возврат;
	КонецЕсли;
	Попытка
		МассивТегов = Новый Массив;
		МассивТегов.Добавить("{v8 Область.ТелоБланка}");
		МассивТегов.Добавить("{/v8 Область.ТелоБланка}");
		МассивТегов.Добавить("{v8 Область.ШапкаТаблицы}");
		МассивТегов.Добавить("{/v8 Область.ШапкаТаблицы}");
		МассивТегов.Добавить("{v8 Область.СтрокаТаблицы}");
		МассивТегов.Добавить("{/v8 Область.СтрокаТаблицы}");
		МассивТегов.Добавить("{v8 Область.Подвал}");
		МассивТегов.Добавить("{/v8 Область.Подвал}");
		ДокументWord = ПечатнаяФорма.COMСоединение.ActiveDocument;
		Поиск = ПечатнаяФорма.COMСоединение.Selection.Find;
		Поиск.ClearFormatting();
		Поиск.Replacement.ClearFormatting();
		Поиск.Forward = Истина;
		Поиск.Wrap = 1; // wdFindContinue
		Для Каждого ТекстТега Из МассивТегов Цикл
			ДокументWord.Content.Select();
			Поиск.Text = ТекстТега;
			Поиск.Replacement.Text = "";
			Поиск.Execute(ТекстТега, Ложь, Ложь, Ложь, Ложь, Ложь, Истина, 1, Ложь, "", 2); // Replace := 2 (wdReplaceAll)
		КонецЦикла;
	Исключение
		// Игнорируем ошибки COM при очистке тегов
	КонецПопытки;
КонецПроцедуры //HD-

//HD+
// Получает файл с сервера по адресу во временном хранилище (стандартный механизм ПолучитьФайлы).
// Возвращает полный путь к сохранённому файлу или пустую строку при ошибке.
//
&НаКлиенте
Функция ПолучитьЛокальныйФайлПоАдресуХранилища(АдресВХранилище, ИмяФайла)
	ВременныйКаталог = КаталогВременныхФайлов();
	ОписанияФайлов = Новый Массив;
	ОписанияФайлов.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяФайла, АдресВХранилище));
	Если НЕ ПолучитьФайлы(ОписанияФайлов, , ВременныйКаталог, Ложь) Тогда
		Возврат "";
	КонецЕсли;
	ПоследнийСимвол = ?(СтрДлина(ВременныйКаталог) > 0, Прав(ВременныйКаталог, 1), "");
	Если ПоследнийСимвол = "\" ИЛИ ПоследнийСимвол = "/" Тогда
		Возврат ВременныйКаталог + ИмяФайла;
	Иначе
		Возврат ВременныйКаталог + "\" + ИмяФайла;
	КонецЕсли;
КонецФункции //HD-

//HD+
// Обработчик команды печати итогов голосования (вариант А: макет Word через COM на клиенте).
//
&НаКлиенте
Процедура ПечатьИтогиГолосования(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сохраните документ перед печатью по шаблону Word.");
		Возврат;
	КонецЕсли;
	
	РезультатСервера = ПолучитьШаблонИДанныеДляПечатиWord("ПФ_DOC_ИтогиГолосования");
	
	Если РезультатСервера = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось подготовить шаблон или данные для печати.");
		Возврат;
	КонецЕсли;
	
	ОткрытьИЗаполнитьДокументWord(РезультатСервера.АдресШаблона, РезультатСервера.Данные);
	
КонецПроцедуры //HD-

//HD+
// Нормализация текста перед подстановкой в Word: только Символ(13) как перенос; LF и прочие управляющие убираются, чтобы не было квадратиков.
//
&НаКлиенте
Функция НормализоватьПереносыСтрокДляПодстановкиВWord(СтрокаТекст)
	Если НЕ ЗначениеЗаполнено(СтрокаТекст) Тогда
		Возврат СтрокаТекст;
	КонецЕсли;
	СтрокаТекст = СтрЗаменить(СтрокаТекст, Символ(13) + Символ(10), Символ(13));
	СтрокаТекст = СтрЗаменить(СтрокаТекст, Символ(10), Символ(13));
	СтрокаТекст = СтрЗаменить(СтрокаТекст, Символ(11), " ");
	СтрокаТекст = СтрЗаменить(СтрокаТекст, Символ(12), " ");
	СтрокаТекст = СтрЗаменить(СтрокаТекст, Символ(8232), Символ(13));
	СтрокаТекст = СтрЗаменить(СтрокаТекст, Символ(8233), Символ(13));
	Результат = "";
	Для Индекс = 1 По СтрДлина(СтрокаТекст) Цикл
		Сим = Сред(СтрокаТекст, Индекс, 1);
		Код = КодСимвола(Сим);
		Если Код < 32 Тогда
			Если Код = 13 Тогда
				Результат = Результат + Сим;
			ИначеЕсли Код = 9 Тогда
				Результат = Результат + " ";
			КонецЕсли;
		Иначе
			Результат = Результат + Сим;
		КонецЕсли;
	КонецЦикла;
	СтрокаТекст = Результат;
	Пока СтрДлина(СтрокаТекст) > 0 И Лев(СтрокаТекст, 1) = Символ(13) Цикл СтрокаТекст = Сред(СтрокаТекст, 2); КонецЦикла;
	Пока СтрДлина(СтрокаТекст) > 0 И Прав(СтрокаТекст, 1) = Символ(13) Цикл СтрокаТекст = Лев(СтрокаТекст, СтрДлина(СтрокаТекст) - 1); КонецЦикла;
	Возврат СтрокаТекст;
КонецФункции //HD-

//HD+
// Возвращает имена параметров для подстановки в Word, отсортированные по убыванию длины имени.
// Нужно, чтобы [ВидСобрания_Предложный] не повреждался при ранней замене [ВидСобрания].
//
&НаКлиенте
Функция ПолучитьИменаПараметровПечатиWordУпорядоченныеПоДлине(Данные, РазвернулиТаблицуПовестки)
	
	МассивИмен = Новый Массив;
	
	Для Каждого КлючИЗначение Из Данные Цикл
		ИмяПараметра = КлючИЗначение.Ключ;
		Если РазвернулиТаблицуПовестки
			И (ИмяПараметра = "ПредложенияПовесткиДняНомерСтроки" ИЛИ ИмяПараметра = "ПредложенияПовесткиДня") Тогда
			Продолжить;
		КонецЕсли;
		МассивИмен.Добавить(ИмяПараметра);
	КонецЦикла;
	
	Для Индекс1 = 0 По МассивИмен.ВГраница() Цикл
		Для Индекс2 = Индекс1 + 1 По МассивИмен.ВГраница() Цикл
			Если СтрДлина(МассивИмен[Индекс2]) > СтрДлина(МассивИмен[Индекс1]) Тогда
				ИмяВременное = МассивИмен[Индекс1];
				МассивИмен[Индекс1] = МассивИмен[Индекс2];
				МассивИмен[Индекс2] = ИмяВременное;
			КонецЕсли;
		КонецЦикла;
	КонецЦикла;
	
	Возврат МассивИмен;
	
КонецФункции //HD-

//HD+
// Ключи-флаги опциональных блоков [?Имя]…[/?Имя]: в текст документа не подставляются как [Имя].
// Иначе Word воспринимает [ТекстИнициатораУК] как набор букв и вычищает абзац инициатора.
//
&НаКлиенте
Функция ЭтоИмяФлагаОпциональногоБлокаWord(Знач ИмяПараметра)
	
	Возврат ИмяПараметра = "ТекстИнициатораУК"
		ИЛИ ИмяПараметра = "ТекстИнициатораФизЛицо"
		ИЛИ ИмяПараметра = "ТекстПредставителяУК";
	
КонецФункции //HD-

//HD+
// Открывает шаблон Word: двоичные данные из хранилища записываются в локальный файл, затем Word создаёт документ из файла (Add — по референсу).
// Заполнение: замена плейсхолдеров [ИмяПараметра] через Range.Text. Синтаксис 1С {v8 Область.Шапка} в Word не обрабатывается — в шаблоне используйте [МКД_Улица], [ПротоколДата] и т.д.
// Пустые абзацы макета сохраняются (отступы перед подписями). Интервал абзаца плейсхолдера копируется на вставленный текст.
// Оформление: подставляемый текст Times New Roman. Подчёркивание плейсхолдера может теряться — выделяйте весь [ИмяПараметра] одним стилем.
//
&НаКлиенте
Процедура ОткрытьИЗаполнитьДокументWord(АдресШаблона, Данные)
	
	Перем WordApp, WordDoc;
	
	Если НЕ ЗначениеЗаполнено(АдресШаблона) ИЛИ ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	ИмяФайлаШаблона = "HD_OSS_Word_" + Строка(ТекущаяУниверсальнаяДатаВМиллисекундах()) + ".docx";
	ПутьЛокальный = ПолучитьЛокальныйФайлПоАдресуХранилища(АдресШаблона, ИмяФайлаШаблона);
	Если НЕ ЗначениеЗаполнено(ПутьЛокальный) Тогда
		ДвоичныеДанныеШаблона = ПолучитьИзВременногоХранилища(АдресШаблона);
		Если ТипЗнч(ДвоичныеДанныеШаблона) <> Тип("ДвоичныеДанные") Тогда
			ДвоичныеДанныеШаблона = ПолучитьДвоичныеДанныеИзВременногоХранилищаСервер(АдресШаблона);
		КонецЕсли;
		Если ТипЗнч(ДвоичныеДанныеШаблона) <> Тип("ДвоичныеДанные") Тогда
			ПоказатьПредупреждение(, "Не удалось получить шаблон из хранилища.");
			Возврат;
		КонецЕсли;
		ПутьЛокальный = КаталогВременныхФайлов() + ИмяФайлаШаблона;
		ДвоичныеДанныеШаблона.Записать(ПутьЛокальный);
	КонецЕсли;
	
	Попытка
		WordApp = Новый COMОбъект("Word.Application");
	Исключение
		ПоказатьПредупреждение(, "Не удалось запустить Microsoft Word. Установите приложение и повторите попытку.");
		Возврат;
	КонецПопытки;
	
	Попытка
		WordDoc = WordApp.Documents.Add(ПутьЛокальный);
	Исключение
		ПоказатьПредупреждение(, "Не удалось открыть шаблон в Word.");
		Возврат;
	КонецПопытки;
	
	Попытка
		//HD+ Бланк решения: если есть нумерация и формулировки повестки — разворачиваем строки таблицы (одна строка на пункт), затем заполняем по строкам
		МассивНомерСтроки = Неопределено;
		МассивПредложения = Неопределено;
		Если Данные.Свойство("ПредложенияПовесткиДняНомерСтроки") И Данные.Свойство("ПредложенияПовесткиДня") Тогда
			Если ТипЗнч(Данные.ПредложенияПовесткиДняНомерСтроки) = Тип("Массив") И ТипЗнч(Данные.ПредложенияПовесткиДня) = Тип("Массив") Тогда
				МассивНомерСтроки = Данные.ПредложенияПовесткиДняНомерСтроки;
				МассивПредложения = Данные.ПредложенияПовесткиДня;
			Иначе
				СтрокаНомер = НормализоватьПереносыСтрокДляПодстановкиВWord(Строка(Данные.ПредложенияПовесткиДняНомерСтроки));
				СтрокаТекст = НормализоватьПереносыСтрокДляПодстановкиВWord(Строка(Данные.ПредложенияПовесткиДня));
				МассивНомерСтроки = СтрРазделить(СтрокаНомер, Символ(13), Ложь);
				МассивПредложения = СтрРазделить(СтрокаТекст, Символ(13), Ложь);
			КонецЕсли;
		КонецЕсли;
		
		РазвернулиТаблицуПовестки = Ложь;
		Если МассивНомерСтроки <> Неопределено И МассивПредложения <> Неопределено И МассивНомерСтроки.Количество() > 0 И МассивПредложения.Количество() > 0 Тогда
			РазвернулиТаблицуПовестки = РазвернутьСтрокиТаблицыПовесткиВWord(WordDoc, МассивНомерСтроки, МассивПредложения);
		КонецЕсли;
		
		//HD+ Опциональные блоки [?Имя]…[/?Имя]: до подстановки плейсхолдеров, иначе маркеры останутся в документе
		ОбработатьОпциональныеБлокиВДокументеWord(WordDoc, Данные);
		ВыровнятьПустыеАбзацыПоСледующемуWord(WordDoc);
		УдалитьПустыеСтрокиТаблицДокументаWord(WordDoc);
		
		//HD+ Пустые абзацы макета (отступ перед «Председатель собрания» и т.п.) не сжимаем и не удаляем.
		// Подстановка через Range.Text: сохраняется интервал абзаца плейсхолдера (перед/после).
		МассивИменПараметров = ПолучитьИменаПараметровПечатиWordУпорядоченныеПоДлине(Данные, РазвернулиТаблицуПовестки);
		Для Каждого ИмяПараметра Из МассивИменПараметров Цикл
			Если ЭтоИмяФлагаОпциональногоБлокаWord(ИмяПараметра) Тогда
				Продолжить;
			КонецЕсли;
			Если ЭтоПустойПараметрСтрокиПодписиОргановСобранияWord(ИмяПараметра, Данные[ИмяПараметра]) Тогда
				УдалитьАбзацыСПлейсхолдеромВДокументеWord(WordDoc, "[" + ИмяПараметра + "]");
				Продолжить;
			КонецЕсли;
			ЗначениеПараметра = НормализоватьПереносыСтрокДляПодстановкиВWord(Строка(Данные[ИмяПараметра]));
			ПодставитьПлейсхолдерВДокументеWord(WordDoc, "[" + ИмяПараметра + "]", ЗначениеПараметра);
		КонецЦикла;
		
		УдалитьПустыеСтрокиТаблицДокументаWord(WordDoc);
		
		ПрижатьВыравниваниеБлокаИнициатораВДокументеWord(WordDoc);
		ПрименитьШрифтTimesNewRomanКДокументуWord(WordDoc);
		
		// Авто-высота строк во всех таблицах; фиксируем пропорции столбцов (первый — формулировки, остальные — За/Против/Возд.)
		Попытка
			Таблицы = WordDoc.Tables;
			Для НомерТаблицы = 1 По Таблицы.Count Цикл
				Таблица = Таблицы.Item(НомерТаблицы);
				СтрокиТаблицы = Таблица.Rows;
				Для НомерСтроки = 1 По СтрокиТаблицы.Count Цикл
					СтрокаТаблицы = СтрокиТаблицы.Item(НомерСтроки);
					СтрокаТаблицы.HeightRule = 0; // wdRowHeightAuto — высота по содержимому
				КонецЦикла;
				//HD+ Задаём ширины столбцов в пунктах: первый — формулировки (шире), остальные три — узкие (За, Против, Возд.)
				КолонкиТаблицы = Таблица.Columns;
				КолвоКолонок = КолонкиТаблицы.Count;
				Если КолвоКолонок >= 4 Тогда
					КолонкиТаблицы.Item(1).Width = 280;
					КолонкиТаблицы.Item(2).Width = 40;
					КолонкиТаблицы.Item(3).Width = 40;
					КолонкиТаблицы.Item(4).Width = 40;
				ИначеЕсли КолвоКолонок = 2 Тогда
					КолонкиТаблицы.Item(1).Width = 50;
					КолонкиТаблицы.Item(2).Width = 350;
				КонецЕсли;
			КонецЦикла;
		Исключение
		КонецПопытки;
		
		WordDoc.Fields.Update();
		WordApp.Visible = 1;
		WordApp.Activate();
	Исключение
		ПоказатьПредупреждение(, "Ошибка при заполнении шаблона: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Обрабатывает в макете Word фрагменты [?ИмяПараметра]…[/?ИмяПараметра].
// Маркер удаляется вместе со своим Enter; пустые абзацы после блока (отступ перед подписями) не трогаем.
// Параметр пуст — вырезается весь блок до закрывающего маркера включительно.
// MatchWildcards = Ложь: символ «?» в маркере не является подстановочным знаком Word.
//
&НаКлиенте
Процедура ОбработатьОпциональныеБлокиВДокументеWord(WordDoc, Данные)
	
	Если WordDoc = Неопределено ИЛИ ТипЗнч(Данные) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	МассивИменПараметров = ПолучитьИменаПараметровПечатиWordУпорядоченныеПоДлине(Данные, Ложь);
	
	Для Каждого ИмяПараметра Из МассивИменПараметров Цикл
		
		МаркерОткрытия = "[?" + ИмяПараметра + "]";
		МаркерЗакрытия = "[/?" + ИмяПараметра + "]";
		ПараметрЗаполнен = ПараметрЗаполненДляОпциональногоБлокаWord(Данные[ИмяПараметра]);
		
		ЗащитаОтЗацикливания = 0;
		Пока ЗащитаОтЗацикливания < 100 Цикл
			
			ЗащитаОтЗацикливания = ЗащитаОтЗацикливания + 1;
			
			ДиапазонОткрытия = НайтиТекстВДокументеWord(WordDoc, МаркерОткрытия);
			Если ДиапазонОткрытия = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			ДиапазонЗакрытия = НайтиТекстВДокументеWord(WordDoc, МаркерЗакрытия, ДиапазонОткрытия.End);
			Если ДиапазонЗакрытия = Неопределено Тогда
				Прервать;
			КонецЕсли;
			
			Если ПараметрЗаполнен Тогда
				Если ЭтоИмяФлагаОпциональногоБлокаWord(ИмяПараметра) Тогда
					ПрижатьАбзацыДиапазонаВлевоWord(WordDoc, ДиапазонОткрытия.Start, ДиапазонЗакрытия.End);
				Иначе
					СкопироватьВыравниваниеАбзацаСоСледующегоWord(WordDoc, ДиапазонЗакрытия);
					СкопироватьВыравниваниеАбзацаСоСледующегоWord(WordDoc, ДиапазонОткрытия);
				КонецЕсли;
				ВключитьСледующийРазрывАбзацаВДиапазонWord(WordDoc, ДиапазонЗакрытия);
				ВключитьСледующийРазрывАбзацаВДиапазонWord(WordDoc, ДиапазонОткрытия);
				ДиапазонЗакрытия.Text = "";
				ДиапазонОткрытия.Text = "";
			Иначе
				ВключитьСледующийРазрывАбзацаВДиапазонWord(WordDoc, ДиапазонЗакрытия);
				ПозицияБлока = ДиапазонОткрытия.Start;
				ДиапазонБлока = WordDoc.Range(ДиапазонОткрытия.Start, ДиапазонЗакрытия.End);
				ДиапазонБлока.Text = "";
				СкопироватьВыравниваниеАбзацаСоСледующегоWord(WordDoc, WordDoc.Range(ПозицияБлока, ПозицияБлока));
			КонецЕсли;
			
		КонецЦикла;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Признак заполненности значения для опционального блока Word: непустая строка или непустой массив.
//
&НаКлиенте
Функция ПараметрЗаполненДляОпциональногоБлокаWord(ЗначениеПараметра)
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Массив") Тогда
		Возврат ЗначениеПараметра.Количество() > 0;
	КонецЕсли;
	
	Возврат ЗначениеЗаполнено(ЗначениеПараметра);
	
КонецФункции //HD-

//HD+
// Ищет первое вхождение текста в документе Word. MatchWildcards выключен (иначе «?» в [?Имя] — любой символ).
// НачальнаяПозиция — искать начиная с неё (для закрывающего маркера после открывающего).
//
&НаКлиенте
Функция НайтиТекстВДокументеWord(WordDoc, ТекстПоиска, НачальнаяПозиция = Неопределено)
	
	Попытка
		
		Если НачальнаяПозиция = Неопределено Тогда
			Диапазон = WordDoc.Content.Duplicate;
		Иначе
			Диапазон = WordDoc.Range(НачальнаяПозиция, WordDoc.Content.End);
		КонецЕсли;
		
		Поиск = Диапазон.Find;
		Поиск.ClearFormatting();
		Поиск.Text = ТекстПоиска;
		Поиск.Forward = Истина;
		Поиск.Wrap = 0;
		Поиск.MatchWildcards = Ложь;
		
		Найдено = Поиск.Execute(ТекстПоиска, Ложь, Ложь, Ложь, Ложь, Ложь, Истина, 0);
		Если Найдено = Истина ИЛИ Найдено = -1 Тогда
			Возврат Диапазон;
		КонецЕсли;
		
		Если Поиск.Found Тогда
			Возврат Диапазон;
		КонецЕсли;
		
	Исключение
		Возврат Неопределено;
	КонецПопытки;
	
	Возврат Неопределено;
	
КонецФункции //HD-

//HD+
// Пустая строка подписи органа собрания: абзац с плейсхолдером не выводится.
// Председатель, секретарь, представители собственников, счётная комиссия 1–5.
// Квартира (*_Кв) на той же строке уходит вместе с абзацем ФИО.
//
&НаКлиенте
Функция ЭтоПустойПараметрСтрокиПодписиОргановСобранияWord(Знач ИмяПараметра, Знач ЗначениеПараметра)
	
	Если НЕ ЗначениеПодписиОрганаСобранияПустоеWord(ЗначениеПараметра) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяПараметра = СокрЛП(Строка(ИмяПараметра));
	
	Если СтрНайти(ИмяПараметра, "_Кв") > 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Если ИмяПараметра = "Председатель"
		ИЛИ ИмяПараметра = "Секретарь"
		ИЛИ ИмяПараметра = "ПредставительСобственников_1"
		ИЛИ ИмяПараметра = "ПредставительСобственников_2" Тогда
		Возврат Истина;
	КонецЕсли;
	
	Префикс = "СчетнаяКомиссия_";
	Если Лев(ИмяПараметра, СтрДлина(Префикс)) <> Префикс Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Суффикс = Сред(ИмяПараметра, СтрДлина(Префикс) + 1);
	
	Возврат Суффикс = "1"
		ИЛИ Суффикс = "2"
		ИЛИ Суффикс = "3"
		ИЛИ Суффикс = "4"
		ИЛИ Суффикс = "5";
	
КонецФункции //HD-

//HD+
// Пустое ФИО для строки подписи: нет значения или одни прочерки из макета.
//
&НаКлиенте
Функция ЗначениеПодписиОрганаСобранияПустоеWord(Знач ЗначениеПараметра)
	
	Если ТипЗнч(ЗначениеПараметра) = Тип("Массив") Тогда
		Возврат ЗначениеПараметра.Количество() = 0;
	КонецЕсли;
	
	Если НЕ ЗначениеЗаполнено(ЗначениеПараметра) Тогда
		Возврат Истина;
	КонецЕсли;
	
	ТекстЗначения = СокрЛП(Строка(ЗначениеПараметра));
	ТекстЗначения = СтрЗаменить(ТекстЗначения, "_", "");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, "-", "");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, "—", "");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, "–", "");
	ТекстЗначения = СтрЗаменить(ТекстЗначения, " ", "");
	
	Возврат НЕ ЗначениеЗаполнено(ТекстЗначения);
	
КонецФункции //HD-

//HD+
// Удаляет абзац (или строку таблицы), в котором стоит плейсхолдер: вместе с «_______ /» и пустым ФИО.
//
&НаКлиенте
Процедура УдалитьАбзацыСПлейсхолдеромВДокументеWord(WordDoc, СтрокаПоиска)
	
	Если WordDoc = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	ЗащитаОтЗацикливания = 0;
	Пока ЗащитаОтЗацикливания < 20 Цикл
		
		ЗащитаОтЗацикливания = ЗащитаОтЗацикливания + 1;
		
		Диапазон = НайтиТекстВДокументеWord(WordDoc, СтрокаПоиска);
		Если Диапазон = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		Если НЕ УдалитьАбзацИлиСтрокуТаблицыСДиапазономWord(WordDoc, Диапазон) Тогда
			Попытка
				Диапазон.Text = "";
			Исключение
				Прервать;
			КонецПопытки;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Строка таблицы — удаляет строку; иначе затирает абзац вместе со знаком абзаца.
// Возвращает Истина, если диапазон с плейсхолдером убран.
//
&НаКлиенте
Функция УдалитьАбзацИлиСтрокуТаблицыСДиапазономWord(WordDoc, Диапазон)
	
	Если WordDoc = Неопределено ИЛИ Диапазон = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		// 12 = wdWithInTable: строка подписи органа собрания в таблице
		Если Диапазон.Information(12) Тогда
			Диапазон.Rows.Item(1).Delete();
			Возврат Истина;
		КонецЕсли;
	Исключение
	КонецПопытки;
	
	Попытка
		
		ДиапазонАбзаца = Диапазон.Paragraphs.Item(1).Range;
		Если СтрНайти(Строка(ДиапазонАбзаца.Text), Символ(7)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		СкопироватьВыравниваниеАбзацаСоСледующегоWord(WordDoc, ДиапазонАбзаца);
		
		ПозицияНачала = ДиапазонАбзаца.Start;
		ПозицияКонца = ДиапазонАбзаца.End;
		Если ПозицияКонца > WordDoc.Content.End Тогда
			ПозицияКонца = WordDoc.Content.End;
		КонецЕсли;
		
		ДиапазонБлока = WordDoc.Range(ПозицияНачала, ПозицияКонца);
		ДиапазонБлока.Text = "";
		Возврат Истина;
		
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Подставляет значение вместо [ИмяПараметра] через Range.Text (без лимита 255 символов Find.Replace).
// Интервал перед/после и межстрочный интервал копируются с абзаца плейсхолдера на все вставленные абзацы.
//
&НаКлиенте
Процедура ПодставитьПлейсхолдерВДокументеWord(WordDoc, СтрокаПоиска, ЗначениеПараметра)
	
	Если WordDoc = Неопределено ИЛИ НЕ ЗначениеЗаполнено(СтрокаПоиска) Тогда
		Возврат;
	КонецЕсли;
	
	НачальнаяПозиция = Неопределено;
	ЗащитаОтЗацикливания = 0;
	
	Пока ЗащитаОтЗацикливания < 200 Цикл
		
		ЗащитаОтЗацикливания = ЗащитаОтЗацикливания + 1;
		
		Диапазон = НайтиТекстВДокументеWord(WordDoc, СтрокаПоиска, НачальнаяПозиция);
		Если Диапазон = Неопределено Тогда
			Прервать;
		КонецЕсли;
		
		ФорматАбзаца = ПолучитьФорматАбзацаWord(Диапазон);
		ФорматШрифта = ПолучитьФорматШрифтаWord(Диапазон);
		ПозицияНачала = Диапазон.Start;
		Диапазон.Text = Строка(ЗначениеПараметра);
		
		Попытка
			ДиапазонВставки = WordDoc.Range(ПозицияНачала, Диапазон.End);
			ПрименитьФорматАбзацаКДиапазонуWord(ДиапазонВставки, ФорматАбзаца);
			ПрименитьФорматШрифтаКДиапазонуWord(ДиапазонВставки, ФорматШрифта);
			ПрименитьШрифтTimesNewRomanКДиапазонуWord(ДиапазонВставки);
			НачальнаяПозиция = ДиапазонВставки.End;
		Исключение
			НачальнаяПозиция = Диапазон.End;
		КонецПопытки;
		
		Если СтрНайти(Строка(ЗначениеПараметра), СтрокаПоиска) > 0 Тогда
			Прервать;
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Считывает интервалы абзаца Word. 9999999 — wdUndefined (смешанное оформление), такое значение пропускаем.
//
&НаКлиенте
Функция ПолучитьФорматАбзацаWord(Диапазон)
	
	Результат = Новый Структура;
	Результат.Вставить("ИнтервалПеред", Неопределено);
	Результат.Вставить("ИнтервалПосле", Неопределено);
	Результат.Вставить("Межстрочный", Неопределено);
	Результат.Вставить("ПравилоМежстрочного", Неопределено);
	Результат.Вставить("Выравнивание", Неопределено);
	
	Если Диапазон = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		Абзац = Диапазон.Paragraphs.Item(1);
		Результат.ИнтервалПеред = ЧислоФорматаАбзацаWord(Абзац.SpaceBefore);
		Результат.ИнтервалПосле = ЧислоФорматаАбзацаWord(Абзац.SpaceAfter);
		Результат.Межстрочный = ЧислоФорматаАбзацаWord(Абзац.LineSpacing);
		Результат.ПравилоМежстрочного = ЧислоФорматаАбзацаWord(Абзац.LineSpacingRule);
		Результат.Выравнивание = ЧислоФорматаАбзацаWord(Абзац.Alignment);
		
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// wdUndefined в Word COM приходит как 9999999; такие значения в формат абзаца не записываем.
//
&НаКлиенте
Функция ЧислоФорматаАбзацаWord(ЗначениеСвойства)
	
	Если ТипЗнч(ЗначениеСвойства) <> Тип("Число") Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Если ЗначениеСвойства < 0 ИЛИ ЗначениеСвойства >= 10000 Тогда
		Возврат Неопределено;
	КонецЕсли;
	
	Возврат ЗначениеСвойства;
	
КонецФункции //HD-

//HD+
// Размер и начертание шрифта диапазона Word. 9999999 — wdUndefined (смешанное оформление), не сохраняем.
//
&НаКлиенте
Функция ПолучитьФорматШрифтаWord(Диапазон)
	
	Результат = Новый Структура;
	Результат.Вставить("Размер", Неопределено);
	Результат.Вставить("Жирный", Неопределено);
	Результат.Вставить("Курсив", Неопределено);
	Результат.Вставить("Подчёркивание", Неопределено);
	
	Если Диапазон = Неопределено Тогда
		Возврат Результат;
	КонецЕсли;
	
	Попытка
		
		ШрифтДиапазона = Диапазон.Font;
		Результат.Размер = ЧислоФорматаАбзацаWord(ШрифтДиапазона.Size);
		Результат.Жирный = ПризнакШрифтаWord(ШрифтДиапазона.Bold);
		Результат.Курсив = ПризнакШрифтаWord(ШрифтДиапазона.Italic);
		Результат.Подчёркивание = ЧислоФорматаАбзацаWord(ШрифтДиапазона.Underline);
		
	Исключение
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Bold/Italic в Word COM: Булево либо -1/0; 9999999 — смешанное оформление.
//
&НаКлиенте
Функция ПризнакШрифтаWord(ЗначениеСвойства)
	
	Если ТипЗнч(ЗначениеСвойства) = Тип("Булево") Тогда
		Возврат ЗначениеСвойства;
	КонецЕсли;
	
	Если ТипЗнч(ЗначениеСвойства) = Тип("Число") И ЗначениеСвойства > -2 И ЗначениеСвойства < 2 Тогда
		Возврат ЗначениеСвойства <> 0;
	КонецЕсли;
	
	Возврат Неопределено;
	
КонецФункции //HD-

//HD+
// Возвращает размер и начертание после смены стиля/имени шрифта (иначе «Обычный» даёт 12 пт вместо 11).
//
&НаКлиенте
Процедура ПрименитьФорматШрифтаКДиапазонуWord(Диапазон, ФорматШрифта)
	
	Если Диапазон = Неопределено ИЛИ ТипЗнч(ФорматШрифта) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ШрифтДиапазона = Диапазон.Font;
		Если ФорматШрифта.Размер <> Неопределено Тогда
			ШрифтДиапазона.Size = ФорматШрифта.Размер;
		КонецЕсли;
		Если ФорматШрифта.Жирный <> Неопределено Тогда
			ШрифтДиапазона.Bold = ФорматШрифта.Жирный;
		КонецЕсли;
		Если ФорматШрифта.Курсив <> Неопределено Тогда
			ШрифтДиапазона.Italic = ФорматШрифта.Курсив;
		КонецЕсли;
		Если ФорматШрифта.Подчёркивание <> Неопределено Тогда
			ШрифтДиапазона.Underline = ФорматШрифта.Подчёркивание;
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Переносит интервал абзаца плейсхолдера на все абзацы вставленного текста (пункты повестки, итоги голосования).
//
&НаКлиенте
Процедура ПрименитьФорматАбзацаКДиапазонуWord(Диапазон, ФорматАбзаца)
	
	Если Диапазон = Неопределено ИЛИ ТипЗнч(ФорматАбзаца) <> Тип("Структура") Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Абзацы = Диапазон.Paragraphs;
		Для НомерАбзаца = 1 По Абзацы.Count Цикл
			
			Абзац = Абзацы.Item(НомерАбзаца);
			Если ФорматАбзаца.ИнтервалПеред <> Неопределено Тогда
				Абзац.SpaceBefore = ФорматАбзаца.ИнтервалПеред;
			КонецЕсли;
			Если ФорматАбзаца.ИнтервалПосле <> Неопределено Тогда
				Абзац.SpaceAfter = ФорматАбзаца.ИнтервалПосле;
			КонецЕсли;
			Если ФорматАбзаца.ПравилоМежстрочного <> Неопределено Тогда
				Абзац.LineSpacingRule = ФорматАбзаца.ПравилоМежстрочного;
			КонецЕсли;
			Если ФорматАбзаца.Межстрочный <> Неопределено Тогда
				Абзац.LineSpacing = ФорматАбзаца.Межстрочный;
			КонецЕсли;
			Если ФорматАбзаца.Выравнивание <> Неопределено Тогда
				Абзац.Alignment = ФорматАбзаца.Выравнивание;
			КонецЕсли;
			
		КонецЦикла;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// wdAlignParagraphLeft = 0. Прижимает абзацы диапазона влево (не «по ширине»).
//
&НаКлиенте
Процедура ПрижатьАбзацыДиапазонаВлевоWord(WordDoc, Знач НачалоДиапазона, Знач КонецДиапазона)
	
	Если WordDoc = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Если НачалоДиапазона >= КонецДиапазона Тогда
			Возврат;
		КонецЕсли;
		
		Диапазон = WordDoc.Range(НачалоДиапазона, КонецДиапазона);
		АбзацыДиапазона = Диапазон.Paragraphs;
		Для НомерАбзаца = 1 По АбзацыДиапазона.Count Цикл
			СброситьСтильВебИВыровнятьАбзацВлевоWord(АбзацыДиапазона.Item(НомерАбзаца));
		КонецЦикла;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// После подстановки плейсхолдеров блок «По инициативе…» снова прижимается влево:
// стиль «Обычный» в макете часто «по ширине», и склейка маркеров его возвращает.
//
&НаКлиенте
Процедура ПрижатьВыравниваниеБлокаИнициатораВДокументеWord(WordDoc)
	
	Если WordDoc = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	МассивНачалБлока = Новый Массив;
	МассивНачалБлока.Добавить("По инициативе собственника");
	МассивНачалБлока.Добавить("По инициативе управляющей");
	
	Для Каждого ТекстНачала Из МассивНачалБлока Цикл
		
		ДиапазонНачала = НайтиТекстВДокументеWord(WordDoc, ТекстНачала);
		Если ДиапазонНачала = Неопределено Тогда
			Продолжить;
		КонецЕсли;
		
		Попытка
			
			ПозицияАбзаца = ДиапазонНачала.Paragraphs.Item(1).Range.Start;
			Для СчетчикАбзацев = 1 По 12 Цикл
				
				ДиапазонАбзаца = WordDoc.Range(ПозицияАбзаца, ПозицияАбзаца).Paragraphs.Item(1);
				ТекстАбзаца = ТекстБезСлужебныхСимволовРазметкиWord(Строка(ДиапазонАбзаца.Text));
				Если НЕ ЗначениеЗаполнено(ТекстАбзаца) Тогда
					Прервать;
				КонецЕсли;
				Если СчетчикАбзацев > 1 И НЕ ЭтоАбзацБлокаИнициатораWord(ТекстАбзаца) Тогда
					Прервать;
				КонецЕсли;
				
				СброситьСтильВебИВыровнятьАбзацВлевоWord(ДиапазонАбзаца.Paragraphs.Item(1));
				ПозицияАбзаца = ДиапазонАбзаца.End;
				Если ПозицияАбзаца >= WordDoc.Content.End Тогда
					Прервать;
				КонецЕсли;
				
			КонецЦикла;
			
		Исключение
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры //HD-

//HD+
// Прижимает абзац влево. Стиль «Обычный» в макете — 12 пт, повторное назначение затирает 11 пт блока инициатора.
// Стиль меняем только у «Обычный (веб)» / «Normal (Web)» (выравнивание по ширине), кегль и начертание возвращаем.
//
&НаКлиенте
Процедура СброситьСтильВебИВыровнятьАбзацВлевоWord(Абзац)
	
	Если Абзац = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ФорматАбзаца = ПолучитьФорматАбзацаWord(Абзац.Range);
	ФорматШрифта = ПолучитьФорматШрифтаWord(Абзац.Range);
	
	Если ЭтоСтильОбычныйВебWord(Абзац) Тогда
		
		Попытка
			Абзац.Range.Style = "Обычный";
		Исключение
			Попытка
				Абзац.Range.Style = "Normal";
			Исключение
			КонецПопытки;
		КонецПопытки;
		
	КонецЕсли;
	
	ПрименитьФорматАбзацаКДиапазонуWord(Абзац.Range, ФорматАбзаца);
	ПрименитьФорматШрифтаКДиапазонуWord(Абзац.Range, ФорматШрифта);
	
	Попытка
		Абзац.Alignment = 0;
		Абзац.Range.ParagraphFormat.Alignment = 0;
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Истина, если у абзаца стиль «Обычный (веб)» / «Normal (Web)» — он задаёт выравнивание по ширине.
//
&НаКлиенте
Функция ЭтоСтильОбычныйВебWord(Абзац)
	
	Если Абзац = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	ИмяСтиля = "";
	
	Попытка
		СтильАбзаца = Абзац.Style;
		Если ТипЗнч(СтильАбзаца) = Тип("Строка") Тогда
			ИмяСтиля = СтильАбзаца;
		Иначе
			ИмяСтиля = Строка(СтильАбзаца.NameLocal);
		КонецЕсли;
	Исключение
		Попытка
			ИмяСтиля = Строка(Абзац.Range.Style);
		Исключение
			Возврат Ложь;
		КонецПопытки;
	КонецПопытки;
	
	ИмяСтиля = НРег(СокрЛП(ИмяСтиля));
	
	Возврат СтрНайти(ИмяСтиля, "веб") > 0 ИЛИ СтрНайти(ИмяСтиля, "web") > 0;
	
КонецФункции //HD-

//HD+
// Шрифт подставляемого текста: Times New Roman, без сброса оформления плейсхолдера.
// Replacement.ClearFormatting() берёт стиль «Обычный» (в макете это Liberation Serif).
//
&НаКлиенте
Процедура УстановитьШрифтЗаменыПлейсхолдераWord(Замена)
	
	Если Замена = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Замена.Replacement.Font.Name = "Times New Roman";
	Исключение
	КонецПопытки;
	
	Попытка
		Замена.Replacement.Font.NameAscii = "Times New Roman";
		Замена.Replacement.Font.NameOther = "Times New Roman";
		Замена.Replacement.Font.NameFarEast = "Times New Roman";
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Назначает Times New Roman диапазону Word, не меняя размер, жирность и подчёркивание.
//
&НаКлиенте
Процедура ПрименитьШрифтTimesNewRomanКДиапазонуWord(Диапазон)
	
	Если Диапазон = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ФорматШрифта = ПолучитьФорматШрифтаWord(Диапазон);
	
	Попытка
		Диапазон.Font.Name = "Times New Roman";
	Исключение
	КонецПопытки;
	
	Попытка
		Диапазон.Font.NameAscii = "Times New Roman";
		Диапазон.Font.NameOther = "Times New Roman";
		Диапазон.Font.NameFarEast = "Times New Roman";
	Исключение
	КонецПопытки;
	
	ПрименитьФорматШрифтаКДиапазонуWord(Диапазон, ФорматШрифта);
	
КонецПроцедуры //HD-

//HD+
// После подстановки параметров весь документ (включая колонтитулы) приводится к Times New Roman.
// По абзацам: иначе Range всего документа даёт wdUndefined и кегль 11/12 не восстанавливается.
//
&НаКлиенте
Процедура ПрименитьШрифтTimesNewRomanКДокументуWord(WordDoc)
	
	Если WordDoc = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ПрименитьШрифтTimesNewRomanПоАбзацамWord(WordDoc.Content);
	
	Попытка
		Для НомерСекции = 1 По WordDoc.Sections.Count Цикл
			Секция = WordDoc.Sections.Item(НомерСекции);
			Для НомерКолонтитула = 1 По 3 Цикл
				Попытка
					ПрименитьШрифтTimesNewRomanПоАбзацамWord(Секция.Headers.Item(НомерКолонтитула).Range);
				Исключение
				КонецПопытки;
				Попытка
					ПрименитьШрифтTimesNewRomanПоАбзацамWord(Секция.Footers.Item(НомерКолонтитула).Range);
				Исключение
				КонецПопытки;
			КонецЦикла;
		КонецЦикла;
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Times New Roman по абзацам диапазона — размер каждого абзаца сохраняется отдельно.
//
&НаКлиенте
Процедура ПрименитьШрифтTimesNewRomanПоАбзацамWord(Диапазон)
	
	Если Диапазон = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Абзацы = Диапазон.Paragraphs;
		Для НомерАбзаца = 1 По Абзацы.Count Цикл
			ПрименитьШрифтTimesNewRomanКДиапазонуWord(Абзацы.Item(НомерАбзаца).Range);
		КонецЦикла;
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Строка относится к блоку инициатора в ПФ_DOC_СообщениеОСобрании (поля списка, не следующий раздел).
//
&НаКлиенте
Функция ЭтоАбзацБлокаИнициатораWord(Знач ТекстАбзаца)
	
	ТекстПроверки = НРег(СокрЛП(Строка(ТекстАбзаца)));
	Если НЕ ЗначениеЗаполнено(ТекстПроверки) Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Возврат СтрНачинаетсяС(ТекстПроверки, "по инициативе")
		ИЛИ СтрНачинаетсяС(ТекстПроверки, "фио:")
		ИЛИ СтрНачинаетсяС(ТекстПроверки, "паспорт")
		ИЛИ СтрНачинаетсяС(ТекстПроверки, "снилс")
		ИЛИ СтрНачинаетсяС(ТекстПроверки, "адрес")
		ИЛИ СтрНачинаетсяС(ТекстПроверки, "телефон")
		ИЛИ СтрНачинаетсяС(ТекстПроверки, "наименование:")
		ИЛИ СтрНачинаетсяС(ТекстПроверки, "юридический")
		ИЛИ СтрНачинаетсяС(ТекстПроверки, "представитель управляющей");
	
КонецФункции //HD-

//HD+
// Перед склейкой абзацев копирует выравнивание со следующего: иначе Word оставляет формат первого
// (маркер [?…] часто наследует «по центру» у заголовка сообщения).
//
&НаКлиенте
Процедура СкопироватьВыравниваниеАбзацаСоСледующегоWord(WordDoc, Диапазон)
	
	Если WordDoc = Неопределено ИЛИ Диапазон = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Абзац = Диапазон.Paragraphs.Item(1);
		КонецАбзаца = Абзац.Range.End;
		Если КонецАбзаца >= WordDoc.Content.End Тогда
			Возврат;
		КонецЕсли;
		
		СледующийАбзац = WordDoc.Range(КонецАбзаца, КонецАбзаца).Paragraphs.Item(1);
		Абзац.Alignment = СледующийАбзац.Alignment;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Если сразу за маркером стоит разрыв абзаца (Enter) или мягкий перенос (Shift+Enter) — включает его в диапазон,
// чтобы вместе с [?…] / [/?…] удалялась и пустая строка.
//
&НаКлиенте
Процедура ВключитьСледующийРазрывАбзацаВДиапазонWord(WordDoc, Диапазон)
	
	Если WordDoc = Неопределено ИЛИ Диапазон = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ПозицияКонца = Диапазон.End;
		Если ПозицияКонца >= WordDoc.Content.End Тогда
			Возврат;
		КонецЕсли;
		
		СледующийСимвол = Строка(WordDoc.Range(ПозицияКонца, ПозицияКонца + 1).Text);
		Если СледующийСимвол = Символ(13) ИЛИ СледующийСимвол = Символ(11) Тогда
			Диапазон.SetRange(Диапазон.Start, ПозицияКонца + 1);
		КонецЕсли;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// У пустых абзацев (хвосты [?…]) выравнивание как у следующего. Иначе склейка ^p^p переносит «по центру» с маркера на текст.
//
&НаКлиенте
Процедура ВыровнятьПустыеАбзацыПоСледующемуWord(WordDoc)
	
	Если WordDoc = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Абзацы = WordDoc.Paragraphs;
		КоличествоАбзацев = Абзацы.Count;
		Для НомерАбзаца = 1 По КоличествоАбзацев - 1 Цикл
			ДиапазонАбзаца = Абзацы.Item(НомерАбзаца).Range;
			Если АбзацПустойДляУдаленияВWord(ДиапазонАбзаца) Тогда
				СкопироватьВыравниваниеАбзацаСоСледующегоWord(WordDoc, ДиапазонАбзаца);
			КонецЕсли;
		КонецЦикла;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Сжимает подряд идущие пустые абзацы Word: ^p^p → ^p. Так убираются «дыры» после [?…] даже внутри таблицы.
//
&НаКлиенте
Процедура СжатьПовторяющиесяРазрывыАбзацевВДокументеWord(WordDoc)
	
	Если WordDoc = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ЗащитаОтЗацикливания = 0;
		Пока ЗащитаОтЗацикливания < 80 Цикл
			
			ЗащитаОтЗацикливания = ЗащитаОтЗацикливания + 1;
			
			ДиапазонПроверки = WordDoc.Content.Duplicate;
			ПоискПроверки = ДиапазонПроверки.Find;
			ПоискПроверки.ClearFormatting();
			ПоискПроверки.MatchWildcards = Ложь;
			ПоискПроверки.Text = "^p^p";
			ЕстьДвойнойРазрыв = ПоискПроверки.Execute("^p^p", Ложь, Ложь, Ложь, Ложь, Ложь, Истина, 0);
			Если ЕстьДвойнойРазрыв <> Истина И ЕстьДвойнойРазрыв <> -1 И НЕ ПоискПроверки.Found Тогда
				Прервать;
			КонецЕсли;
			
			Поиск = WordDoc.Content.Find;
			Поиск.ClearFormatting();
			Поиск.Replacement.ClearFormatting();
			Поиск.MatchWildcards = Ложь;
			Поиск.Text = "^p^p";
			Поиск.Replacement.Text = "^p";
			Поиск.Execute("^p^p", Ложь, Ложь, Ложь, Ложь, Ложь, Истина, 1, Ложь, "^p", 2);
			
		КонецЦикла;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Удаляет найденный маркер [?Имя] / [/?Имя]. Затем, если абзац пуст — удаляет и знак абзаца (иначе остаётся пустая строка).
// Абзац с маркером конца ячейки таблицы (символ 7) не удаляется целиком.
//
&НаКлиенте
Процедура УдалитьМаркерОпциональногоБлокаВДокументеWord(WordDoc, ДиапазонМаркера)
	
	Если WordDoc = Неопределено ИЛИ ДиапазонМаркера = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		ПозицияАбзаца = ДиапазонМаркера.Paragraphs.Item(1).Range.Start;
		ДиапазонМаркера.Text = "";
		ДиапазонАбзаца = WordDoc.Range(ПозицияАбзаца, ПозицияАбзаца).Paragraphs.Item(1).Range;
		Если АбзацПустойДляУдаленияВWord(ДиапазонАбзаца) Тогда
			УдалитьПустойАбзацВДокументеWord(WordDoc, ДиапазонАбзаца);
		КонецЕсли;
		
	Исключение
		Попытка
			ДиапазонМаркера.Text = "";
		Исключение
		КонецПопытки;
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Истина, если в абзаце кроме переданного маркера нет видимого текста (только разрывы Word).
//
&НаКлиенте
Функция АбзацСодержитТолькоМаркерОпциональногоБлокаWord(ДиапазонМаркера)
	
	Если ДиапазонМаркера = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ТекстАбзаца = Строка(ДиапазонМаркера.Paragraphs.Item(1).Range.Text);
		ТекстМаркера = Строка(ДиапазонМаркера.Text);
		ТекстОстатка = СтрЗаменить(ТекстАбзаца, ТекстМаркера, "");
		Возврат НЕ ЗначениеЗаполнено(ТекстБезСлужебныхСимволовРазметкиWord(ТекстОстатка));
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Убирает из текста служебные символы разметки Word: CR/LF, конец ячейки, мягкий перенос, разрыв страницы.
//
&НаКлиенте
Функция ТекстБезСлужебныхСимволовРазметкиWord(Знач Текст)
	
	Результат = Строка(Текст);
	Результат = СтрЗаменить(Результат, Символ(13), "");
	Результат = СтрЗаменить(Результат, Символ(10), "");
	Результат = СтрЗаменить(Результат, Символ(7), "");
	Результат = СтрЗаменить(Результат, Символ(9), "");
	Результат = СтрЗаменить(Результат, Символ(11), "");
	Результат = СтрЗаменить(Результат, Символ(12), "");
	Результат = СтрЗаменить(Результат, Символ(160), "");
	
	Возврат СокрЛП(Результат);
	
КонецФункции //HD-

//HD+
// Истина, если абзац Word без видимого текста и это не конец ячейки таблицы.
//
&НаКлиенте
Функция АбзацПустойДляУдаленияВWord(ДиапазонАбзаца)
	
	Если ДиапазонАбзаца = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ТекстАбзаца = Строка(ДиапазонАбзаца.Text);
		Если СтрНайти(ТекстАбзаца, Символ(7)) > 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		Возврат НЕ ЗначениеЗаполнено(ТекстБезСлужебныхСимволовРазметкиWord(ТекстАбзаца));
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Удаляет пустой абзац через знак абзаца. Range.Delete() без параметров в Word снимает 1 символ и оставляет «дыру».
//
&НаКлиенте
Процедура УдалитьПустойАбзацВДокументеWord(WordDoc, ДиапазонАбзаца)
	
	Если WordDoc = Неопределено ИЛИ ДиапазонАбзаца = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		Если ДиапазонАбзаца.End >= WordDoc.Content.End Тогда
			Возврат;
		КонецЕсли;
		СкопироватьВыравниваниеАбзацаСоСледующегоWord(WordDoc, ДиапазонАбзаца);
		ДиапазонРазрыва = WordDoc.Range(ДиапазонАбзаца.End - 1, ДиапазонАбзаца.End);
		ДиапазонРазрыва.Delete(1, 1);
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Удаляет пустые абзацы основного текста Word (хвосты после [?…] / [/?…] и лишние Enter в макете между блоками).
//
&НаКлиенте
Процедура УдалитьПустыеАбзацыДокументаWord(WordDoc)
	
	Если WordDoc = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Абзацы = WordDoc.Paragraphs;
		НомерАбзаца = Абзацы.Count;
		Пока НомерАбзаца >= 1 Цикл
			
			ДиапазонАбзаца = Абзацы.Item(НомерАбзаца).Range;
			Если АбзацПустойДляУдаленияВWord(ДиапазонАбзаца) Тогда
				УдалитьПустойАбзацВДокументеWord(WordDoc, ДиапазонАбзаца);
			КонецЕсли;
			
			НомерАбзаца = НомерАбзаца - 1;
			
		КонецЦикла;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Удаляет полностью пустые строки таблиц Word (после вырезания опциональных блоков иначе остаётся высокая пустая строка).
//
&НаКлиенте
Процедура УдалитьПустыеСтрокиТаблицДокументаWord(WordDoc)
	
	Если WordDoc = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		Таблицы = WordDoc.Tables;
		Для НомерТаблицы = 1 По Таблицы.Count Цикл
			
			СтрокиТаблицы = Таблицы.Item(НомерТаблицы).Rows;
			НомерСтроки = СтрокиТаблицы.Count;
			Пока НомерСтроки >= 1 Цикл
				
				ТекстСтроки = "";
				Попытка
					ЯчейкиСтроки = СтрокиТаблицы.Item(НомерСтроки).Cells;
					Для НомерЯчейки = 1 По ЯчейкиСтроки.Count Цикл
						ТекстСтроки = ТекстСтроки + Строка(ЯчейкиСтроки.Item(НомерЯчейки).Range.Text);
					КонецЦикла;
				Исключение
					ТекстСтроки = Строка(СтрокиТаблицы.Item(НомерСтроки).Range.Text);
				КонецПопытки;
				Если НЕ ЗначениеЗаполнено(ТекстБезСлужебныхСимволовРазметкиWord(ТекстСтроки)) Тогда
					СтрокиТаблицы.Item(НомерСтроки).Delete();
				КонецЕсли;
				
				НомерСтроки = НомерСтроки - 1;
				
			КонецЦикла;
			
		КонецЦикла;
		
	Исключение
	КонецПопытки;
	
КонецПроцедуры //HD-

//HD+
// Разворачивает одну строку таблицы с плейсхолдерами [ПредложенияПовесткиДняНомерСтроки] и [ПредложенияПовесткиДня] в N строк (одна строка на пункт), заполняет номер и текст по строкам.
// Сначала ищет строку по маркеру [НачалоОбластиСтрокаПредложения]; если не найдено — по [ПредложенияПовесткиДняНомерСтроки] (старый макет).
// Возвращает Истина, если развернули и заполнили.
//
&НаКлиенте
Функция РазвернутьСтрокиТаблицыПовесткиВWord(WordDoc, МассивНомерСтроки, МассивПредложения)
	
	КолвоПунктов = Мин(МассивНомерСтроки.Количество(), МассивПредложения.Количество());
	Если КолвоПунктов = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		МаркерНачала = "[НачалоОбластиСтрокаПредложения]";
		МаркерКонца = "[КонецОбластиСтрокаПредложения]";
		//HD+ Только CR — разрыв абзаца в Word; LF даёт квадратик при отображении
		СимволАбзацаWord = Символ(13);
		Таблица = Неопределено;
		НомерСтрокиШаблона = 0;
		Таблицы = WordDoc.Tables;
		Для НомерТаблицы = 1 По Таблицы.Count Цикл
			ТекущаяТаблица = Таблицы.Item(НомерТаблицы);
			СтрокиТаблицы = ТекущаяТаблица.Rows;
			Для НомерСтроки = 1 По СтрокиТаблицы.Count Цикл
				ТекстСтроки = Строка(СтрокиТаблицы.Item(НомерСтроки).Range.Text);
				Если СтрНайти(ТекстСтроки, МаркерНачала) > 0 Тогда
					Таблица = ТекущаяТаблица;
					НомерСтрокиШаблона = НомерСтроки;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если Таблица <> Неопределено Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если Таблица = Неопределено Тогда
			Возврат РазвернутьСтрокиТаблицыПовесткиВWordПоСтаромуМакету(WordDoc, МассивНомерСтроки, МассивПредложения);
		КонецЕсли;
		
		СтрокиТаблицы = Таблица.Rows;
		СтрокаШаблон = СтрокиТаблицы.Item(НомерСтрокиШаблона);
		СтрокаШаблон.Range.Copy();
		
		Для Индекс = 1 По КолвоПунктов - 1 Цикл
			ВставленнаяСтрока = Таблица.Rows.Add(СтрокиТаблицы.Item(НомерСтрокиШаблона + 1));
			ВставленнаяСтрока.Range.Select();
			WordDoc.Application.Selection.Paste();
		КонецЦикла;
		
		Выделение = WordDoc.Application.Selection;
		Для Индекс = 0 По КолвоПунктов - 1 Цикл
			НомерСтрокиВТаблице = НомерСтрокиШаблона + Индекс;
			НомерТекст = НормализоватьПереносыСтрокДляПодстановкиВWord(Строка(МассивНомерСтроки[Индекс]));
			ТекстФормулировки = НормализоватьПереносыСтрокДляПодстановкиВWord(Строка(МассивПредложения[Индекс]));
			ТекстФормулировки = СтрЗаменить(ТекстФормулировки, Символ(10), СимволАбзацаWord);
			ДиапазонСтроки = СтрокиТаблицы.Item(НомерСтрокиВТаблице).Range;
			ДиапазонСтроки.Select();
			ПоискВСтроке = Выделение.Find;
			ПоискВСтроке.Text = "[ПредложенияПовесткиДняНомерСтроки]";
			ПоискВСтроке.Replacement.Text = НомерТекст;
			ПоискВСтроке.Execute("[ПредложенияПовесткиДняНомерСтроки]", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Истина, 1, Неопределено, НомерТекст, 2);
			ДиапазонСтроки.Select();
			ПоискВСтроке.Text = "[ПредложенияПовесткиДня]";
			ПоискВСтроке.Replacement.Text = ТекстФормулировки;
			ПоискВСтроке.Execute("[ПредложенияПовесткиДня]", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Истина, 1, Неопределено, ТекстФормулировки, 2);
			ДиапазонСтроки.Select();
			ПоискВСтроке.Text = МаркерНачала;
			ПоискВСтроке.Replacement.Text = "";
			ПоискВСтроке.Execute(МаркерНачала, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Истина, 1, Неопределено, "", 2);
			ДиапазонСтроки.Select();
			ПоискВСтроке.Text = МаркерКонца;
			ПоискВСтроке.Replacement.Text = "";
			ПоискВСтроке.Execute(МаркерКонца, Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Истина, 1, Неопределено, "", 2);
		КонецЦикла;
		
		Возврат Истина;
	Исключение
		Возврат РазвернутьСтрокиТаблицыПовесткиВWordПоСтаромуМакету(WordDoc, МассивНомерСтроки, МассивПредложения);
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Развёртка по старому макету (без маркеров области): поиск строки по [ПредложенияПовесткиДняНомерСтроки], копирование строк, замена по ячейкам.
//
&НаКлиенте
Функция РазвернутьСтрокиТаблицыПовесткиВWordПоСтаромуМакету(WordDoc, МассивНомерСтроки, МассивПредложения)
	
	КолвоПунктов = Мин(МассивНомерСтроки.Количество(), МассивПредложения.Количество());
	Если КолвоПунктов = 0 Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		Таблицы = WordDoc.Tables;
		Если Таблицы.Count = 0 Тогда
			Возврат Ложь;
		КонецЕсли;
		
		НомерСтрокиШаблона = 0;
		НомерТаблицыНайденной = 0;
		НайденоСтроку = Ложь;
		
		Для НомерТаблицы = 1 По Таблицы.Count Цикл
			Таблица = Таблицы.Item(НомерТаблицы);
			СтрокиТаблицы = Таблица.Rows;
			Для НомерСтроки = 1 По СтрокиТаблицы.Count Цикл
				СтрокаТаблицы = СтрокиТаблицы.Item(НомерСтроки);
				ТекстСтроки = Строка(СтрокаТаблицы.Range.Text);
				Если СтрНайти(ТекстСтроки, "[ПредложенияПовесткиДняНомерСтроки]") > 0 Тогда
					НомерСтрокиШаблона = НомерСтроки;
					НомерТаблицыНайденной = НомерТаблицы;
					НайденоСтроку = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			Если НайденоСтроку Тогда
				Прервать;
			КонецЕсли;
		КонецЦикла;
		
		Если НЕ НайденоСтроку Тогда
			Возврат Ложь;
		КонецЕсли;
		
		Таблица = Таблицы.Item(НомерТаблицыНайденной);
		СтрокиТаблицы = Таблица.Rows;
		СтрокаШаблон = СтрокиТаблицы.Item(НомерСтрокиШаблона);
		СтрокаШаблон.Range.Copy();
		
		Для Индекс = 1 По КолвоПунктов - 1 Цикл
			ВставленнаяСтрока = Таблица.Rows.Add(СтрокиТаблицы.Item(НомерСтрокиШаблона + 1));
			ВставленнаяСтрока.Range.Select();
			WordDoc.Application.Selection.Paste();
		КонецЦикла;
		
		КолонкиТаблицы = Таблица.Columns;
		КолвоКолонок = КолонкиТаблицы.Count;
		ТекстПервойЯчейкиШаблона = Строка(СтрокаШаблон.Cells.Item(1).Range.Text);
		ОбаПлейсхолдераВОднойЯчейке = (СтрНайти(ТекстПервойЯчейкиШаблона, "[ПредложенияПовесткиДняНомерСтроки]") > 0) И (СтрНайти(ТекстПервойЯчейкиШаблона, "[ПредложенияПовесткиДня]") > 0);
		ИспользоватьОднуЯчейку = ОбаПлейсхолдераВОднойЯчейке ИЛИ КолвоКолонок < 2;
		Выделение = WordDoc.Application.Selection;
		//HD+ Только CR для разрыва абзаца в Word, без LF (квадратик)
		СимволАбзацаWord = Символ(13);
		
		Для Индекс = 0 По КолвоПунктов - 1 Цикл
			НомерСтрокиВТаблице = НомерСтрокиШаблона + Индекс;
			НомерТекст = НормализоватьПереносыСтрокДляПодстановкиВWord(Строка(МассивНомерСтроки[Индекс]));
			ТекстФормулировки = НормализоватьПереносыСтрокДляПодстановкиВWord(Строка(МассивПредложения[Индекс]));
			ТекстФормулировки = СтрЗаменить(ТекстФормулировки, Символ(10), СимволАбзацаWord);
			
			Если НЕ ИспользоватьОднуЯчейку Тогда
				ЯчейкаНомер = Таблица.Cell(НомерСтрокиВТаблице, 1);
				ЯчейкаТекст = Таблица.Cell(НомерСтрокиВТаблице, 2);
				ЯчейкаНомер.Range.Select();
				ПоискВЯчейке1 = Выделение.Find;
				ПоискВЯчейке1.Text = "[ПредложенияПовесткиДняНомерСтроки]";
				ПоискВЯчейке1.Replacement.Text = НомерТекст;
				ПоискВЯчейке1.Execute("[ПредложенияПовесткиДняНомерСтроки]", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Истина, 1, Неопределено, НомерТекст, 2);
				ЯчейкаТекст.Range.Select();
				ПоискВЯчейке2 = Выделение.Find;
				ПоискВЯчейке2.Text = "[ПредложенияПовесткиДня]";
				ПоискВЯчейке2.Replacement.Text = ТекстФормулировки;
				ПоискВЯчейке2.Execute("[ПредложенияПовесткиДня]", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Истина, 1, Неопределено, ТекстФормулировки, 2);
			Иначе
				ЯчейкаЕдинственная = Таблица.Cell(НомерСтрокиВТаблице, 1);
				ЯчейкаЕдинственная.Range.Select();
				ПоискВЯчейке = Выделение.Find;
				ПоискВЯчейке.Text = "[ПредложенияПовесткиДняНомерСтроки]";
				ПоискВЯчейке.Replacement.Text = НомерТекст + СимволАбзацаWord;
				ПоискВЯчейке.Execute("[ПредложенияПовесткиДняНомерСтроки]", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Истина, 1, Неопределено, НомерТекст + СимволАбзацаWord, 2);
				ЯчейкаЕдинственная.Range.Select();
				ПоискВЯчейке.Text = "[ПредложенияПовесткиДня]";
				ПоискВЯчейке.Replacement.Text = ТекстФормулировки;
				ПоискВЯчейке.Execute("[ПредложенияПовесткиДня]", Неопределено, Неопределено, Неопределено, Неопределено, Неопределено, Истина, 1, Неопределено, ТекстФормулировки, 2);
			КонецЕсли;
		КонецЦикла;
		
		Возврат Истина;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
КонецФункции //HD-

//HD+
// Обработчик команды печати протокола (вариант А: макет Word через COM на клиенте).
//
&НаКлиенте
Процедура ПечатьПротокол(Команда)
	
	Если НЕ ЗначениеЗаполнено(Объект.Ссылка) Тогда
		ПоказатьПредупреждение(, "Сохраните документ перед печатью по шаблону Word.");
		Возврат;
	КонецЕсли;
	
	РезультатСервера = ПолучитьШаблонИДанныеДляПечатиWord("ПФ_DOC_Протокол");
	
	Если РезультатСервера = Неопределено Тогда
		ПоказатьПредупреждение(, "Не удалось подготовить шаблон или данные для печати.");
		Возврат;
	КонецЕсли;
	
	ОткрытьИЗаполнитьДокументWord(РезультатСервера.АдресШаблона, РезультатСервера.Данные);
	
КонецПроцедуры //HD-

