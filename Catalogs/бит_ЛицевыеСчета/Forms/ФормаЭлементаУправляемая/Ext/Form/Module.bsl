// Процедура устанавливает отбор таблицы разовых.
//
&НаСервере
Процедура УстановитьОтборДляРазовых()
	
	Если НЕ Объект.Ссылка.пустая() Тогда
		
		Элементы.СписокВведРазовых.Видимость = Истина;
		
		Эл = СписокВведРазовых.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("ЛицевойСчет");
		Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.Равно;
		Эл.ПравоеЗначение   = Объект.Ссылка;
		Эл.Использование    = Истина;
		Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		Эл = СписокВведРазовых.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Дата");
		Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.БольшеИлиРавно;
		Эл.ПравоеЗначение   = НачалоМесяца(ТекущаяДата());
		Эл.Использование    = Ложь;
		
		Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
		Эл = СписокВведРазовых.Отбор.Элементы.Добавить(Тип("ЭлементОтбораКомпоновкиДанных"));
		
		Эл.ЛевоеЗначение    = Новый ПолеКомпоновкиДанных("Дата");
		Эл.ВидСравнения     = ВидСравненияКомпоновкиДанных.МеньшеИлиРавно;
		Эл.ПравоеЗначение  = КонецМесяца(ТекущаяДата());
		Эл.Использование    = Ложь;
		
		Эл.РежимОтображения = РежимОтображенияЭлементаНастройкиКомпоновкиДанных.Недоступный;
		
	Иначе
		
		Элементы.СписокВведРазовых.Видимость = Ложь;
		
	КонецЕсли;
	
КонецПроцедуры	

// Процедура - обработчик события "ПередНачаломДобавления" табличного поля СписокВведРазовых.
//
&НаКлиенте
Процедура СписокВведРазовыхПередНачаломДобавления(Элемент, Отказ, Копирование, Родитель, Группа)
	
	Если Копирование Тогда
		Отказ = Ложь;
	Иначе
		Отказ = Истина;
	КонецЕсли;	
	
	Если мКэшЗначений.ЭтоНовый Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("СписокВведРазовыхПередНачаломДобавленияЗавершение", ЭтотОбъект, Новый Структура("Копирование, Элемент", Копирование, Элемент)), "Элемент еще не записан. Записать?", РежимДиалогаВопрос.ОКОтмена);
		Возврат;
		
	КонецЕсли;
	
	СписокВведРазовыхПередНачаломДобавленияФрагмент(Копирование, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВведРазовыхПередНачаломДобавленияЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	Копирование = ДополнительныеПараметры.Копирование;
	Элемент = ДополнительныеПараметры.Элемент;
	
	Ответ = РезультатВопроса;
	
	Если Ответ = КодВозвратаДиалога.ОК Тогда
		Попытка
			ЗаписатьОбъект();
			УстановитьОтборДляРазовых();				
		Исключение
			
			Возврат;
			
		КонецПопытки;
		
	Иначе
		
		Возврат;
		
	КонецЕсли;
	
	СписокВведРазовыхПередНачаломДобавленияФрагмент(Копирование, Элемент);
	
КонецПроцедуры

&НаКлиенте
Процедура СписокВведРазовыхПередНачаломДобавленияФрагмент(Знач Копирование, Знач Элемент)
	
	Перем ПараметрыФормы;
	
	Если Не Копирование тогда	
		
		ПараметрыФормы = Новый Структура;
		
		ПараметрыФормы.Вставить("Организация"     , Объект.Организация);
		ПараметрыФормы.Вставить("ЛицевойСчет"     , Объект.Ссылка);
		
		ОткрытьФорму("Документ.бит_РазовыеПоУслугамЖКХ.Форма.ФормаДокументаУправляемая", Новый Структура("ЗаполнитьИзСправочникаЛицевыеСчета", ПараметрыФормы), Элемент);
		
	КонецЕсли;
	
КонецПроцедуры

