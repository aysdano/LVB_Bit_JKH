// БИТ_ЖКХ 27.05.2014
&НаКлиенте
Процедура ПолучательДенежныхСредствНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	ТекущиеДанные = Элементы.Список.ТекущиеДанные;
	
	Если ТекущиеДанные.ПолучательДенежныхСредств <> Неопределено Тогда
		
		СтандартнаяОбработка = Ложь;
		
		ПараметрыФормы = Новый Структура;
		
		Если ТипЗнч(ТекущиеДанные.ПолучательДенежныхСредств) = Тип("СправочникСсылка.Контрагенты") Тогда
			
			ПараметрыФормы.Вставить("Ссылка",ТекущиеДанные.ПолучательДенежныхСредств);
			
			ФормаВыбора = ОткрытьФорму("Справочник.Контрагенты.Форма.ФормаВыбора",ПараметрыФормы,Элемент);	
			
		Иначе
			
			ОткрытьФорму("Справочник.Организации.Форма.ФормаВыбора",,Элемент);	
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры
// БИТ_ЖКХ 27.05.2014

#КонецОбласти

