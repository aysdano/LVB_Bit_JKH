// Процедура. 
//
// Параметры:
//  Параметр1 – Строка.
//
Функция ПолучитьСписокУслуг(ЛицевойСчет, Дата)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"  , КонецДня(Дата));
	Запрос.УстановитьПараметр("Здание", ЛицевойСчет.Здание);
	Запрос.УстановитьПараметр("Улица" , ЛицевойСчет.УлицаЛицевогоСчета);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ШаблоныУслугСрезПоследних.Улица,
	|	бит_ШаблоныУслугСрезПоследних.Здание,
	|	бит_ШаблоныУслугСрезПоследних.Услуга,
	|	бит_ШаблоныУслугСрезПоследних.Поставщик
	|ИЗ
	|	РегистрСведений.бит_ШаблоныУслуг.СрезПоследних(
	|			&Дата,
	|			Здание = &Здание
	|				И Улица = &Улица) КАК бит_ШаблоныУслугСрезПоследних
	|ГДЕ
	|	бит_ШаблоныУслугСрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)";
	
	Результат = Запрос.Выполнить().Выгрузить();
	
	СписокУслуг = Новый СписокЗначений;
	
	СписокУслуг.ЗагрузитьЗначения(Результат.ВыгрузитьКолонку("Услуга"));
	
	Возврат СписокУслуг;
	
КонецФункции // ()

