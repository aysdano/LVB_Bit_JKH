// Процедура устанавливает макет.
//
// Параметры:
//  Нет.
//
Функция УстановитьМакет() Экспорт
	
	Попытка
		
		Если МакетКв.Предопределенный Тогда
			Если (МакетКв = Справочники.бит_ВариантыСчетовИзвещений.лб_ЕПДОсновная) 
				ИЛИ (МакетКв = Справочники.бит_ВариантыСчетовИзвещений.лб_ЕПДОсновная2021)
				ИЛИ (МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонт)
				ИЛИ (МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтМуниципальная)
				ИЛИ (МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтНежилая)
				ИЛИ (МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговаяНежилая)
				ИЛИ (МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговаяМуниципальная)
				ИЛИ (МакетКв = Справочники.бит_ВариантыСчетовИзвещений.КвитанцияКапРемонтДолговая) Тогда
				
				мОсновнойВариантМакета = МакетКВ.ОсновнойВариант;
				мМакет = МакетКв.ШаблонПечатнойФормы.Получить();
				
			Иначе
				мОсновнойВариантМакета = МакетКВ;
				мМакет = ПолучитьМакет(МакетКв.ПутьКМакету);
			КонецЕсли;
		Иначе
			мОсновнойВариантМакета = МакетКВ.ОсновнойВариант;
			мМакет = МакетКв.ШаблонПечатнойФормы.Получить();
		КонецЕсли; 
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(НСтр("ru = 'Не удалось получить макет.'"));
		Возврат Ложь;
	КонецПопытки;
	
	Возврат Истина;
	
КонецФункции 

