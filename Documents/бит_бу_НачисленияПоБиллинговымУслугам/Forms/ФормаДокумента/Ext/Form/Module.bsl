// Процедура выполняет заполнение счетов и субконто табличной части.
//
// БИТ_ЖКХ 18.08.2014
&НаСервере
Процедура ЗапролнитьСчета()
	
	ДокументОбъект = ДанныеФормыВЗначение(объект, Тип("ДокументОбъект.бит_бу_НачисленияПоБиллинговымУслугам"));
	
	Колонки = ЭтаФорма.Элементы.ЛицевыеСчета.ПодчиненныеЭлементы;
	
	ЛССписок = ДокументОбъект.ЛицевыеСчета.ВыгрузитьКолонку("ЛицевойСчет");
	
	бит_ОбщегоНазначения.ЗаполнениеСчетовКУ(ДокументОбъект.ЛицевыеСчета, Колонки, ЛССписок, Объект.Организация, Объект.Дата);
	
	ЛицевыеСчета = ДокументОбъект.ЛицевыеСчета.Выгрузить();
	
	Объект.ЛицевыеСчета.Загрузить(ЛицевыеСчета);
	
КонецПроцедуры
