Функция ПолучитьСписокОборудованияПоКассеККМ(КассаККМ) Экспорт
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	"ВЫБРАТЬ РАЗЛИЧНЫЕ
	|	бит_КассыККМПодключенноеОборудование.Оборудование
	|ИЗ
	|	Справочник.бит_КассыККМ.ПодключенноеОборудование КАК бит_КассыККМПодключенноеОборудование
	|ГДЕ
	|	бит_КассыККМПодключенноеОборудование.Ссылка = &КассаККМ";
	Запрос.УстановитьПараметр("КассаККМ", КассаККМ);
	
	Результат = Запрос.Выполнить().Выгрузить().ВыгрузитьКолонку("Оборудование");
	
	Возврат Результат;
	
КонецФункции
