&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		КассаОрганизации = НайтиКассуОрганизации(ВыбранноеЗначение); 
		Если Объект.Касса  <> КассаОрганизации Тогда
			Объект.Касса = КассаОрганизации;
		КонецЕсли;
	Иначе
		Объект.Касса = ПредопределенноеЗначение("Справочник.бит_КассыККМ.ПустаяСсылка");
	КонецЕсли;
	
	УстановкаОтбораЧекККМ();	
	глКассаККМ = Объект.Касса;
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если Не ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Касса = ПредопределенноеЗначение("Справочник.бит_КассыККМ.ПустаяСсылка");
	КонецЕсли;	
	УстановкаОтбораЧекККМ();	
	глКассаККМ = Объект.Касса;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция НайтиКассуОрганизации(Организация)
	
	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат ПредопределенноеЗначение("Справочник.бит_КассыККМ.ПустаяСсылка");
	КонецЕсли; 
	
	Запрос = Новый Запрос;
	Запрос.Текст = "ВЫБРАТЬ
	               |	бит_КассыККМ.Ссылка КАК КассаККМ
	               |ИЗ
	               |	Справочник.бит_КассыККМ КАК бит_КассыККМ
	               |ГДЕ
	               |	НЕ бит_КассыККМ.ПометкаУдаления
	               |	И бит_КассыККМ.Владелец = &Организация
	               |	И НЕ бит_КассыККМ.ПодразделениеОрганизации = ЗНАЧЕНИЕ(Справочник.бит_ПодразделенияОрганизаций.ПустаяСсылка)
	               |
	               |УПОРЯДОЧИТЬ ПО
	               |	бит_КассыККМ.Код";
	Запрос.УстановитьПараметр("Организация", Организация);
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Возврат Выборка.КассаККМ;
	КонецЕсли;
	
КонецФункции

&НаКлиенте
Процедура КассаОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	ПодразделениеОрганизации = ПодразделениеОрганизацииНаСервере(ВыбранноеЗначение);
	Если НЕ ЗначениеЗаполнено(ПодразделениеОрганизации) Тогда
		ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(НСтр("ru = 'У кассы: %1 не указанно подразделение организации!'"),
							ВыбранноеЗначение);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Элемент.Значение = ПредопределенноеЗначение("Справочник.бит_КассыККМ.ПустаяСсылка");
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервереБезКонтекста
Функция ПодразделениеОрганизацииНаСервере(Организация)
	
