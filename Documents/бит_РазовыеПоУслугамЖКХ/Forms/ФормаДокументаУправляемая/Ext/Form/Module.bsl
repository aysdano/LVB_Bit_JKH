	Запрос.УстановитьПараметр("КонецПериода"	,КонецДня(ДокументОбъект.КонПериода));
	Запрос.УстановитьПараметр("УслугаСписания"	,ДокументОбъект.УслугаСписания);
	Запрос.УстановитьПараметр("УслугаНачисления",ДокументОбъект.УслугаНачисления);
	Запрос.УстановитьПараметр("ЛицевыеСчета"	,МассивЛС);
	
	Выборка = Запрос.Выполнить().Выбрать();
