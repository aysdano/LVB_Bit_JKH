					<dcscor:value xsi:type="xs:decimal">30</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>ОплатаКУ</dataPath>
			<field>ОплатаКУ</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Оплата КУ</v8:content>
				</v8:item>
			</title>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>СуммаПоУслуге</dataPath>
			<field>СуммаПоУслуге</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Сумма по услуге</v8:content>
				</v8:item>
			</title>
			<appearance>
				<dcscor:item xsi:type="dcsset:SettingsParameterValue">
					<dcscor:parameter>Формат</dcscor:parameter>
					<dcscor:value xsi:type="v8:LocalStringType">
						<v8:item>
							<v8:lang>ru</v8:lang>
							<v8:content>ЧДЦ=2</v8:content>
						</v8:item>
					</dcscor:value>
				</dcscor:item>
			</appearance>
		</field>
		<field xsi:type="DataSetFieldField">
			<dataPath>Организация</dataPath>
			<field>Организация</field>
			<title xsi:type="v8:LocalStringType">
				<v8:item>
					<v8:lang>ru</v8:lang>
					<v8:content>Организация</v8:content>
				</v8:item>
			</title>
		</field>
		<dataSource>ИсточникДанных1</dataSource>
		<query>ВЫБРАТЬ
	бит_ОплатаКУСписокЛС.Ссылка.Дата КАК Дата,
	бит_ОплатаКУСписокЛС.Ссылка КАК Ссылка,
	бит_ОплатаКУСписокЛС.ЛицевойСчет КАК ЛицевойСчет,
	бит_ОплатаКУСписокЛС.Сумма КАК Сумма,
	бит_ОплатаКУСписокЛС.лб_ПериодНачисления КАК ПериодНачисления,
	бит_ОплатаКУСписокЛС.лб_КлючСтроки КАК лб_КлючСтроки,
	бит_ОплатаКУСписокЛС.Ссылка.лб_ВидОплаты КАК ВидОплаты
ПОМЕСТИТЬ ВТ_Оплаты
ИЗ
	Документ.бит_ОплатаКУ.СписокЛС КАК бит_ОплатаКУСписокЛС
ГДЕ
	бит_ОплатаКУСписокЛС.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода
	И бит_ОплатаКУСписокЛС.Ссылка.Проведен
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ПроживающиеПоЛС.ЛицевойСчет КАК ЛицевойСчет,
	ПроживающиеПоЛС.Период КАК ПериодНачало,
	ПроживающиеПоЛС.ФизЛицо КАК ФизЛицо
ПОМЕСТИТЬ ВТ_ИсторияСобственников
ИЗ
	РегистрСведений.бит_ПроживающиеПоЛС КАК ПроживающиеПоЛС
ГДЕ
	ПроживающиеПоЛС.СтепеньРодства = ЗНАЧЕНИЕ(Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо)
	И ПроживающиеПоЛС.ЛицевойСчет В
			(ВЫБРАТЬ РАЗЛИЧНЫЕ
				ВТ_Оплаты.ЛицевойСчет
			ИЗ
				ВТ_Оплаты КАК ВТ_Оплаты)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_Оплаты.Дата КАК ДатаОплаты,
	ВТ_Оплаты.Ссылка КАК Ссылка,
	ВТ_Оплаты.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_Оплаты.Сумма КАК Сумма,
	ВТ_Оплаты.ПериодНачисления КАК ПериодНачисления,
	ВТ_Оплаты.лб_КлючСтроки КАК лб_КлючСтроки,
	ВТ_Оплаты.ВидОплаты КАК ВидОплаты,
	МАКСИМУМ(ВТ_ИсторияСобственников.ПериодНачало) КАК ПериодНачало
ПОМЕСТИТЬ ВТ_ОплатыСПериодом
ИЗ
	ВТ_Оплаты КАК ВТ_Оплаты
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсторияСобственников КАК ВТ_ИсторияСобственников
		ПО ВТ_Оплаты.ЛицевойСчет = ВТ_ИсторияСобственников.ЛицевойСчет
			И ВТ_Оплаты.Дата &gt;= ВТ_ИсторияСобственников.ПериодНачало

СГРУППИРОВАТЬ ПО
	ВТ_Оплаты.Дата,
	ВТ_Оплаты.ЛицевойСчет,
	ВТ_Оплаты.Ссылка,
	ВТ_Оплаты.Сумма,
	ВТ_Оплаты.ПериодНачисления,
	ВТ_Оплаты.лб_КлючСтроки,
	ВТ_Оплаты.ВидОплаты
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОплатыСПериодом.ДатаОплаты КАК ДатаОплаты,
	ВТ_ОплатыСПериодом.Ссылка КАК Ссылка,
	ВТ_ОплатыСПериодом.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_ОплатыСПериодом.Сумма КАК Сумма,
	ВТ_ОплатыСПериодом.ПериодНачисления КАК ПериодНачисления,
	ВТ_ОплатыСПериодом.лб_КлючСтроки КАК лб_КлючСтроки,
	ВТ_ОплатыСПериодом.ВидОплаты КАК ВидОплаты,
	ВТ_ИсторияСобственников.ФизЛицо КАК ФизЛицо
ПОМЕСТИТЬ ВТ_ОплатыССобственником
ИЗ
	ВТ_ОплатыСПериодом КАК ВТ_ОплатыСПериодом
		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_ИсторияСобственников КАК ВТ_ИсторияСобственников
		ПО ВТ_ОплатыСПериодом.ЛицевойСчет = ВТ_ИсторияСобственников.ЛицевойСчет
			И ВТ_ОплатыСПериодом.ПериодНачало = ВТ_ИсторияСобственников.ПериодНачало
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОплатыССобственником.ДатаОплаты КАК ДатаОплаты,
	ВТ_ОплатыССобственником.Ссылка КАК Ссылка,
	ВТ_ОплатыССобственником.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_ОплатыССобственником.Сумма КАК Сумма,
	ВТ_ОплатыССобственником.ПериодНачисления КАК ПериодНачисления,
	ВТ_ОплатыССобственником.лб_КлючСтроки КАК лб_КлючСтроки,
	ВТ_ОплатыССобственником.ВидОплаты КАК ВидОплаты,
	ВТ_ОплатыССобственником.ФизЛицо КАК ФизЛицо,
	СчетНаОплатуПокупателю.Ссылка КАК СчетНаОплату
ПОМЕСТИТЬ ВТ_ОплатыСоСчетом
ИЗ
	ВТ_ОплатыССобственником КАК ВТ_ОплатыССобственником
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.СчетНаОплатуПокупателю КАК СчетНаОплатуПокупателю
		ПО ВТ_ОплатыССобственником.Ссылка = СчетНаОплатуПокупателю.бит_ДокументОснование
			И ВТ_ОплатыССобственником.ЛицевойСчет = СчетНаОплатуПокупателю.бит_ЛицевойСчет
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОплатыСоСчетом.ДатаОплаты КАК ДатаОплаты,
	ВТ_ОплатыСоСчетом.Ссылка КАК Ссылка,
	ВТ_ОплатыСоСчетом.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_ОплатыСоСчетом.Сумма КАК Сумма,
	ВТ_ОплатыСоСчетом.ПериодНачисления КАК ПериодНачисления,
	ВТ_ОплатыСоСчетом.лб_КлючСтроки КАК лб_КлючСтроки,
	ВТ_ОплатыСоСчетом.ВидОплаты КАК ВидОплаты,
	ВТ_ОплатыСоСчетом.ФизЛицо КАК ФизЛицо,
	ПоступлениеНаРасчетныйСчет.Ссылка КАК ПоступлениеНаРС
ПОМЕСТИТЬ ВТ_ОплатыСПоступлениемНаРС
ИЗ
	ВТ_ОплатыСоСчетом КАК ВТ_ОплатыСоСчетом
		ЛЕВОЕ СОЕДИНЕНИЕ Документ.ПоступлениеНаРасчетныйСчет КАК ПоступлениеНаРасчетныйСчет
		ПО ВТ_ОплатыСоСчетом.СчетНаОплату = ПоступлениеНаРасчетныйСчет.ДокументОснование
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОплатыСПоступлениемНаРС.ДатаОплаты КАК ДатаОплаты,
	ВТ_ОплатыСПоступлениемНаРС.Ссылка КАК Ссылка,
	ВТ_ОплатыСПоступлениемНаРС.ЛицевойСчет КАК ЛицевойСчет,
	ВЫБОР
		КОГДА НЕ ВТ_ОплатыСПоступлениемНаРС.ЛицевойСчет.Здание.ПочтовыйАдрес = ""
			ТОГДА ВТ_ОплатыСПоступлениемНаРС.ЛицевойСчет.Здание.ПочтовыйАдрес
		ИНАЧЕ ВТ_ОплатыСПоступлениемНаРС.ЛицевойСчет.Здание.Улица.Наименование + " д." + ВТ_ОплатыСПоступлениемНаРС.ЛицевойСчет.Здание.Наименование
	КОНЕЦ + ВЫБОР
		КОГДА НЕ ВТ_ОплатыСПоступлениемНаРС.ЛицевойСчет.Квартира = ЗНАЧЕНИЕ(Справочник.бит_Квартиры.ПустаяСсылка)
			ТОГДА ", кв." + ВТ_ОплатыСПоступлениемНаРС.ЛицевойСчет.Квартира.Наименование
		ИНАЧЕ ""
	КОНЕЦ КАК Адрес,
	ВТ_ОплатыСПоступлениемНаРС.Сумма КАК Сумма,
	ВТ_ОплатыСПоступлениемНаРС.ПериодНачисления КАК ПериодНачисления,
	ВТ_ОплатыСПоступлениемНаРС.лб_КлючСтроки КАК лб_КлючСтроки,
	ВТ_ОплатыСПоступлениемНаРС.ВидОплаты КАК ВидОплаты,
	ВТ_ОплатыСПоступлениемНаРС.ФизЛицо КАК ФизЛицо,
	ВТ_ОплатыСПоступлениемНаРС.ПоступлениеНаРС КАК ПоступлениеНаРС,
	ФискальныеОперации.НомерЧекаККМ КАК НомерЧекаККМ,
	ФискальныеОперации.Дата КАК ДатаЧекаККМ,
	ФискальныеОперации.Сумма КАК СуммаЧекаККМ,
	ВЫБОР
		КОГДА ФискальныеОперации.НомерЧекаККМ ЕСТЬ NULL
			ТОГДА ЛОЖЬ
		ИНАЧЕ ИСТИНА
	КОНЕЦ КАК ОплатаФискализирована
ПОМЕСТИТЬ ВТ_ОплатыСЧеками
ИЗ
	ВТ_ОплатыСПоступлениемНаРС КАК ВТ_ОплатыСПоступлениемНаРС
		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.ФискальныеОперации КАК ФискальныеОперации
		ПО ВТ_ОплатыСПоступлениемНаРС.ПоступлениеНаРС = ФискальныеОперации.ДокументОснование
			И (ФискальныеОперации.НомерЧекаККМ &gt; 0)
;

////////////////////////////////////////////////////////////////////////////////
ВЫБРАТЬ
	ВТ_ОплатыСЧеками.Ссылка.Организация КАК Организация,
	ВТ_ОплатыСЧеками.ДатаОплаты КАК ДатаОплаты,
	ВТ_ОплатыСЧеками.Ссылка КАК ОплатаКУ,
	ВТ_ОплатыСЧеками.ЛицевойСчет КАК ЛицевойСчет,
	ВТ_ОплатыСЧеками.Адрес КАК Адрес,
	ВТ_ОплатыСЧеками.Сумма КАК Сумма,
	ВТ_ОплатыСЧеками.ПериодНачисления КАК ПериодНачисления,
