Процедура Тест_НайтиНомераСуффиксыКвартирНаСервере()
	// Вставить содержимое обработчика.
	д1 = ТекущаяДата();
	
	СоздатьТаблицуДляРазделенныхКвартир();
	
	Набор1 = РегистрыСведений.лб_Тест_ЛС.СоздатьНаборЗаписей();
	Набор1.Прочитать();
	Табл1 = Набор1.Выгрузить();
	Табл1.Индексы.Добавить("Здание,KVARTIRA");
	Табл1.Сортировать("Здание,KVARTIRA");
	Для каждого СтрокаТ из Табл1 цикл
		Если ЗначениеЗаполнено(СтрокаТ.Квартира) или ЗначениеЗаполнено(СтрокаТ.КвНомер) тогда 
			продолжить 
		КонецЕсли;
		ИмяДома = СокрЛП(СТрокаТ.DOM);
		ИмяКвартиры = СокрЛП(СтрокаТ.KVARTIRA);
		
		ЧислоРазделенныхЛС = СтрокаТ.K_LS;
		Если ЧислоРазделенныхЛС>1 тогда
			ИмяКвартиры = ИмяКвартиры+ДополнениеИмениРазделеннойКвартиры(ИмяДома+","+ИмяКвартиры);
		КонецЕсли;	 		
		
		СтруктураНомера   = СтруктураНомераКвартиры(ИмяКвартиры);
		СтрокаТ.КвНомер   = СтруктураНомера.НомерКвартиры;
		СтрокаТ.КвСуффикс = СтруктураНомера.ПрефиксКвартиры;		
		
	КонецЦикла;	
	Набор1.Загрузить(Табл1);
	Набор1.Записать(Истина);
	
	д2 = ТекущаяДата();
	
	Сообщить("Анализ номеров квартир - "+(д2-д1)+ " сек.");		
	
	
КонецПроцедуры




