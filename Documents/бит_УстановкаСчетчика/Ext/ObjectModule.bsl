		Движение.СнятНаПоверку = (ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика);
		
	КонецЕсли; 
	
КонецПроцедуры 

// БИТ_ЖКХ Процедура заполняет регистр Сведения по услугам ЛС.
//
// Параметры:
//  СписокЛС    – Массив - Список лицевых счетов.
//
//  СписокУслуг – Массив - Список услуг.
//
Процедура Движения_СведениямПоУслугам()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Момент" , МоментВремени());
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	
	Если Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный Тогда
		
		СписокУслуг = Услуги.ВыгрузитьКолонку("Услуга");
		
		Запрос.УстановитьПараметр("ЛицевойСчет", Объект);
		Запрос.УстановитьПараметр("СписокУслуг", СписокУслуг);
		
		Текст = 
		"ВЫБРАТЬ
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга
		|ПОМЕСТИТЬ Счетчики
		|ИЗ
		|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
		|			&Момент,
		|			ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
		|				И НЕ Счетчик = &Счетчик
		|				И Объект = &ЛицевойСчет) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
		|ГДЕ
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет,
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга,
		|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления,
		|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик,
		|	бит_СведенияПоУслугамЛССрезПоследних.Использовать,
		|	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления,
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга.ОсновнойСпособРасчета КАК ОсновнойСпособРасчета,
		|	бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет.Наименование КАК Наименование,
		|	ВЫБОР
		|		КОГДА Счетчики.Услуга ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьСчетчик,
		|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета
		|ИЗ
		|	РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(
		|			&Момент,
		|			ЛицевойСчет = &ЛицевойСчет
		|				И Услуга В (&СписокУслуг)) КАК бит_СведенияПоУслугамЛССрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ Счетчики КАК Счетчики
		|		ПО бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет = Счетчики.Объект
		|			И бит_СведенияПоУслугамЛССрезПоследних.Услуга = Счетчики.Услуга
		|ГДЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.ДА)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Счетчики";
		
	Иначе
		
		Запрос.УстановитьПараметр("Ссылка" , Ссылка);
		
		СписокЗданий = ЛицевыеСчета.ВыгрузитьКолонку("Здание");
		Запрос.УстановитьПараметр("СписокЗданий", СписокЗданий);
		
		Текст = 
		"ВЫБРАТЬ
		|	бит_УстановкаСчетчикаЛицевыеСчета.ЛицевойСчет,
		|	бит_УстановкаСчетчикаЛицевыеСчета.Услуга,
		|	бит_УстановкаСчетчикаЛицевыеСчета.ЛицевойСчет.Наименование КАК Наименование,
		|	бит_УстановкаСчетчикаЛицевыеСчета.Здание
		|ПОМЕСТИТЬ СписокЛС
		|ИЗ
		|	Документ.бит_УстановкаСчетчика.ЛицевыеСчета КАК бит_УстановкаСчетчикаЛицевыеСчета
		|ГДЕ
		|	бит_УстановкаСчетчикаЛицевыеСчета.Ссылка = &Ссылка
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
		|	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет
		|ПОМЕСТИТЬ Счетчики
		|ИЗ
		|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
		|			&Момент,
		|			ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Групповой)
		|				И СпособРасчета = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам)
		|				И НЕ Счетчик = &Счетчик
		|				И Объект В (&СписокЗданий)) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ГрупповыеСчетчики.СрезПоследних(&Момент, НЕ ГрупповойСчетчик = &Счетчик) КАК бит_ГрупповыеСчетчикиСрезПоследних
		|		ПО бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = бит_ГрупповыеСчетчикиСрезПоследних.ГрупповойСчетчик
		|			И бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга = бит_ГрупповыеСчетчикиСрезПоследних.Услуга
		|ГДЕ
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
		|	И бит_ГрупповыеСчетчикиСрезПоследних.Использовать
		|
		|СГРУППИРОВАТЬ ПО
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
		|	бит_ГрупповыеСчетчикиСрезПоследних.ЛицевойСчет
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|ВЫБРАТЬ РАЗРЕШЕННЫЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления,
		|	бит_СведенияПоУслугамЛССрезПоследних.Поставщик,
		|	бит_СведенияПоУслугамЛССрезПоследних.Использовать,
		|	бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления,
		|	бит_СведенияПоУслугамЛССрезПоследних.Услуга.ОсновнойСпособРасчета КАК ОсновнойСпособРасчета,
		|	СписокЛС.ЛицевойСчет,
		|	СписокЛС.Услуга,
		|	СписокЛС.Наименование КАК Наименование,
		|	ВЫБОР
		|		КОГДА Счетчики.ЛицевойСчет ЕСТЬ NULL 
		|			ТОГДА ЛОЖЬ
		|		ИНАЧЕ ИСТИНА
		|	КОНЕЦ КАК ЕстьСчетчик,
		|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета
		|ИЗ
		|	СписокЛС КАК СписокЛС
		|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&Момент, ) КАК бит_СведенияПоУслугамЛССрезПоследних
		|		ПО СписокЛС.ЛицевойСчет = бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет
		|			И СписокЛС.Услуга = бит_СведенияПоУслугамЛССрезПоследних.Услуга
		|		ЛЕВОЕ СОЕДИНЕНИЕ Счетчики КАК Счетчики
		|		ПО СписокЛС.Услуга = Счетчики.Услуга
		|			И СписокЛС.Здание = Счетчики.Объект
		|			И СписокЛС.ЛицевойСчет = Счетчики.ЛицевойСчет
		|ГДЕ
		|	бит_СведенияПоУслугамЛССрезПоследних.Использовать = ЗНАЧЕНИЕ(Перечисление.ДаНет.ДА)
		|
		|УПОРЯДОЧИТЬ ПО
		|	Наименование
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ СписокЛС
		|;
		|
		|////////////////////////////////////////////////////////////////////////////////
		|УНИЧТОЖИТЬ Счетчики";
		
	КонецЕсли; 
	
	Запрос.Текст = Текст;
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	СведенияПоУслугам = Движения.бит_СведенияПоУслугамЛС;
	
	Пока Выборка.Следующий() Цикл
		
		НоваяЗапись =  СведенияПоУслугам.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяЗапись, Выборка);
		НоваяЗапись.Период        = Дата;
		
		Если ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика
			ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьЛицевыеСчетаНаСчетчик
			ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьЗданияНаСчетчик // БИТ_ЖКХ 02.12.2015 11:12:18
			ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик Тогда
			НоваяЗапись.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам;
		Иначе	
			
			НоваяЗапись.СпособРасчета = ?(Выборка.ЕстьСчетчик, Выборка.СпособРасчета, Выборка.ОсновнойСпособРасчета);
			
			Если НоваяЗапись.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления Тогда
				
				// БИТ_ЖКХ 28.05.2014
				// НоваяЗапись.КоличествоЕдиницПотребления = 1;.
				// БИТ_ЖКХ 28.05.2014
				
			КонецЕсли; 
			
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры // Движения_СведениямПоУслугам() 

// Процедура выполняет проверку на повторное установку/снятие счетчика с объекта.
//
Процедура ПроцеракаУстановкиСчетчика(Отказ)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"   , МоментВремени());
	Запрос.УстановитьПараметр("Ссылка" , Ссылка);
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	Запрос.УстановитьПараметр("Объект" , Объект);
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
	|	МАКСИМУМ(бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать) КАК Использовать
	|ИЗ
	|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(
	|			&Дата,
	|			Счетчик = &Счетчик
	|				И НЕ Регистратор = &Ссылка
	|				И Объект = &Объект) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Если ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика
			И Выборка.Использовать Тогда
			
			Отказ = Истина;

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Счетчик " + Счетчик + " уже был установлен на объект: " + Объект + ".");
			
		ИначеЕсли ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика
			И НЕ Выборка.Использовать Тогда
			
			Отказ = Истина;

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Счетчик " + Счетчик + " уже был снят с объекта: " + Объект + ".");
			
		КонецЕсли; 
		
	КонецЕсли; 
	
КонецПроцедуры

#КонецОбласти

#Область ПроцедурыОбработчикиСобытий

// Проверяем на заполнение обязательные реквизиты.
//
Процедура ПередЗаписью(Отказ)
	
	Если ОбменДанными.Загрузка Тогда
		Возврат;
	КонецЕсли;
	
	// БИТ_ЖКХ 24.09.2014
	Попытка
		бит_рлс_ОбщегоНазначения.ПроверитьБитыеСсылкиВОбъекте(ЭтотОбъект, Отказ);
	Исключение
	КонецПопытки;
	// БИТ_ЖКХ 24.09.2014
	
КонецПроцедуры

// Обработчик события "ОбработкаПроведения" документа.
//
Процедура ОбработкаПроведения(Отказ, Режим)
	
	Заголовок = бит_ОбщегоНазначения.ПредставлениеДокументаПриПроведении(Ссылка);
	
	СтруктураШапкиДокумента = бит_ОбщегоНазначения.СформироватьСтруктуруШапкиДокумента(ЭтотОбъект);
	
	СтруктураПолей = Новый Структура;
	СтруктураПолей.Вставить("Услуга"             ,"Услуга");
	СтруктураПолей.Вставить("НачальныеПоказания" ,"НачальныеПоказания");
	СтруктураПолей.Вставить("КонечныеПоказания"  ,"КонечныеПоказания");
	
	РезультатЗапросаПоУслугам = бит_ОбщегоНазначения.СформироватьЗапросПоТабличнойЧасти(ЭтотОбъект, "Услуги", СтруктураПолей);
	ТаблицаУслуг              = РезультатЗапросаПоУслугам.Выгрузить();
	
	ПроцеракаУстановкиСчетчика(Отказ);
	
	Если НЕ Отказ Тогда
		
		ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаУслуг, Отказ, Заголовок);
		
	КонецЕсли;
	
КонецПроцедуры

Процедура ОбработкаЗаполнения(ДанныеЗаполнения, СтандартнаяОбработка)
	
	бит_ЗаполнениеДокументов.ЗаполнитьШапкуДокумента(ЭтотОбъект ,бит_ОбщиеПеременныеСервер.ЗначениеПеременной("глТекущийПользователь"));
	
КонецПроцедуры

Процедура ОбработкаПроверкиЗаполнения(Отказ, ПроверяемыеРеквизиты)
	
	// Если ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчикаСДомов.
	//	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчикаНаДома Тогда.
	Если Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
		
		Реквизит = ПроверяемыеРеквизиты.Найти("Объект");
		
		Если НЕ Реквизит = Неопределено Тогда
			
			ПроверяемыеРеквизиты.Удалить(Реквизит);
			
		КонецЕсли;
		
		Если ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьЛицевыеСчетаНаСчетчик
			ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьЗданияНаСчетчик  // БИТ_ЖКХ 27.11.2015 16:32:47 
			ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УдалитьЛицевыеСчетаСоСчетчика Тогда
			
			Реквизит = ПроверяемыеРеквизиты.Найти("СпособРасчета");
			Если НЕ Реквизит = Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(Реквизит);
			КонецЕсли;
			
			Реквизит = ПроверяемыеРеквизиты.Найти("Услуги");
			Если НЕ Реквизит = Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(Реквизит);
			КонецЕсли;
			
			Реквизит = ПроверяемыеРеквизиты.Найти("Услуги.Услуга");
			Если НЕ Реквизит = Неопределено Тогда
				ПроверяемыеРеквизиты.Удалить(Реквизит);
