//HD+
// Тексты пункта справочника HD_ПовесткиСобранийСобственников: Вопрос, формулировка, Приложение, флаг ЭтоПриложение.
// Реквизиты приложения читаются через БСП только если есть в метаданных — иначе поиск параметров не должен падать.
//
&НаСервере
Функция ПолучитьДанныеПунктаПовесткиСправочника(Знач СсылкаПовестки)
	
	Результат = Новый Структура;
	Результат.Вставить("Вопрос", "");
	Результат.Вставить("ФормулировкаПредложенияРешенияВопроса", "");
	Результат.Вставить("Приложение", "");
	Результат.Вставить("ЭтоПриложение", Ложь);
	
	Если НЕ ЗначениеЗаполнено(СсылкаПовестки)
		ИЛИ ТипЗнч(СсылкаПовестки) <> Тип("СправочникСсылка.HD_ПовесткиСобранийСобственников") Тогда
		Возврат Результат;
	КонецЕсли;
	
	ИменаРеквизитов = Новый Массив;
	МетаданныеСправочника = Метаданные.Справочники.HD_ПовесткиСобранийСобственников;
	
	Если МетаданныеСправочника.Реквизиты.Найти("Вопрос") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("Вопрос");
	КонецЕсли;
	Если МетаданныеСправочника.Реквизиты.Найти("ФормулировкаПредложенияРешенияВопроса") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("ФормулировкаПредложенияРешенияВопроса");
	КонецЕсли;
	Если МетаданныеСправочника.Реквизиты.Найти("Приложение") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("Приложение");
	КонецЕсли;
	Если МетаданныеСправочника.Реквизиты.Найти("ЭтоПриложение") <> Неопределено Тогда
		ИменаРеквизитов.Добавить("ЭтоПриложение");
	КонецЕсли;
	
	Если ИменаРеквизитов.Количество() = 0 Тогда
		Возврат Результат;
	КонецЕсли;
	
	ЗначенияРеквизитов = ОбщегоНазначения.ЗначенияРеквизитовОбъекта(СсылкаПовестки, СтрСоединить(ИменаРеквизитов, ","));
	Если ТипЗнч(ЗначенияРеквизитов) <> Тип("Структура") Тогда
		Возврат Результат;
	КонецЕсли;
	
	Если ЗначенияРеквизитов.Свойство("Вопрос") Тогда
		Результат.Вопрос = Строка(ЗначенияРеквизитов.Вопрос);
	КонецЕсли;
	Если ЗначенияРеквизитов.Свойство("ФормулировкаПредложенияРешенияВопроса") Тогда
		Результат.ФормулировкаПредложенияРешенияВопроса = Строка(ЗначенияРеквизитов.ФормулировкаПредложенияРешенияВопроса);
	КонецЕсли;
	Если ЗначенияРеквизитов.Свойство("Приложение") Тогда
		Результат.Приложение = Строка(ЗначенияРеквизитов.Приложение);
	КонецЕсли;
	Если ЗначенияРеквизитов.Свойство("ЭтоПриложение")
		И ТипЗнч(ЗначенияРеквизитов.ЭтоПриложение) = Тип("Булево") Тогда
		Результат.ЭтоПриложение = ЗначенияРеквизитов.ЭтоПриложение;
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции //HD-

//HD+
// Признак строки-приложения в ТЧ ПовесткаДня (реквизит может отсутствовать в выгрузке метаданных).
//
&НаСервере
Функция СтрокаПовесткиЭтоПриложениеНаСервере(СтрокаПовестки)
	
	Если СтрокаПовестки = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	РеквизитЭтоПриложение = Метаданные.Документы.HD_ОбщееСобраниеСобственников.ТабличныеЧасти.ПовесткаДня.Реквизиты.Найти("ЭтоПриложение");
	Если РеквизитЭтоПриложение = Неопределено Тогда
		Возврат Ложь;
	КонецЕсли;
	
	Попытка
		ЗначениеФлага = СтрокаПовестки.ЭтоПриложение;
	Исключение
		Возврат Ложь;
	КонецПопытки;
	
	Возврат ТипЗнч(ЗначениеФлага) = Тип("Булево") И ЗначениеФлага;
	
КонецФункции //HD-

