	|ГДЕ
	|	бит_НастройкаПараметровЖКХСрезПоследних.Организация = &Организация";
	
	СрокОплаты = Запрос.Выполнить().Выгрузить();
	СрокОплаты = СрокОплаты[0].ПоследнийДеньПриемаПлатежей;

	
