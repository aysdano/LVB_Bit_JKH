&НаСервере
Процедура  ЗаполнитьСтрокиДокументаОстаткиКУ(ДокОбъект,НачИндекс, ЧислоСтрокВДокументе,ТекПодучасток);
	Если ложь тогда ДокОбъект = Документы.бит_ВводНачальныхОстатковПоКУ.СоздатьДокумент(); КонецЕсли;
	Если ТипЗнч(МассивСтру)<>Тип("Массив") тогда 
		возврат
	КонецЕсли;	
	Счет76КУ = ПланыСчетов.Хозрасчетный.НайтиПоКоду("76.КУ");
	Счет000  = ПланыСчетов.Хозрасчетный.НайтиПоКоду("000");
	
	
	//Определим загружаемые элементы МассивСтру
	ВГраница = МассивСтру.ВГраница();
	Если ЧислоСтрокВДокументе =0 и НачИндекс<=ВГраница тогда
		ТекПодучасток = МассивСтру[НачИндекс].Подучасток;				
		Для МаксИндекс = НачИндекс+1 по ВГраница цикл
			Если МассивСтру[МаксИндекс].Подучасток<>ТекПодучасток тогда
				прервать;
			КонецЕсли;	
		КонецЦикла;	
		Если (МаксИндекс>ВГраница) или  (МассивСтру[МаксИндекс].Подучасток<>ТекПодучасток) тогда
			МаксИндекс = МаксИндекс-1;
		КонецЕсли;	              		
	иначе		
		МаксИндекс = мин(НачИндекс + ЧислоСтрокВДокументе-1,МассивСтру.ВГраница());			
	КонецЕсли;
	
	Для Инд = НачИндекс по МаксИндекс цикл	  		
		Стру = МассивСтру[Инд]; 
		ЛС = СсылкаЛС(Стру.LS);		
		Услуга = УслугаЖКХ(Стру.YSL);
		Сумма = стру.SALDO;
		Если Сумма = 0 тогда
			продолжить
		КонецЕсли;;	
		Если Не ЗначениеЗаполнено(ЛС) тогда
			Сообщить("Не найден ЛС:" + сокрЛП(Стру.LS));
			Продолжить;
		КонецЕсли;
		
		НовСтрока = ДокОбъект.СписокЛС.Добавить();
		НовСтрока.ЛицевойСчет = ЛС;
		НовСтрока.Услуга = Услуга;
		НовСтрока.СальдоНаЛС = Сумма;
		НовСтрока.СчетКУ = Счет000;
		НовСтрока.СчетАбонента = Счет76КУ;
		НовСтрока.Субконто1 = ЛС;
		НовСтрока.Субконто2 = Услуга;
		НовСтрока.Сумма = Сумма;  		
	КонецЦикла;;	
	
	НачИндекс = МаксИндекс+1;
КонецПроцедуры	

