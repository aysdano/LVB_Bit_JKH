#Если Сервер Или ТолстыйКлиентОбычноеПриложение Или ВнешнееСоединение Тогда

#Область ПеременныеМодуля

Перем мДатаДокумента; // Хранит старую дату документа; 

#КонецОбласти

#Область ОбеспечениеПроведенияДокумента

// <Описание функции>.
//
// Параметры:
//  <Параметр1>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//  <Параметр2>  - <Тип.Вид> - <описание параметра>.
//                 <продолжение описания параметра>.
//
// Возвращаемое значение:
//   <Тип.Вид>   - <описание возвращаемого значения>.
//
Функция ПроверкаИсточникаПоказаний()
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("Дата"   , Дата);
	Запрос.УстановитьПараметр("Счетчик", Счетчик);
	Запрос.УстановитьПараметр("Объект" , Объект);
	Запрос.Текст =
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	СУММА(бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток) КАК ТекущиеПоказанияИнспектораОстаток,
	|	СУММА(бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияНаселенияОстаток) КАК ТекущиеПоказанияНаселенияОстаток,
	|	СУММА(бит_ПоказанияСчетчиковОстатки.ПоказанияПодкруткаОстаток) КАК ПоказанияПодкруткаОстаток,
	|	бит_ПоказанияСчетчиковОстатки.Объект
	|ПОМЕСТИТЬ Показания
	|ИЗ
	|	РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
	|			&Дата,
	|			Объект = &Объект
	|				И Счетчик = &Счетчик) КАК бит_ПоказанияСчетчиковОстатки
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_ПоказанияСчетчиковОстатки.Объект
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ ПЕРВЫЕ 1
	|	ВЫБОР
	|		КОГДА Показания.ПоказанияПодкруткаОстаток <> 0
	|			ТОГДА ""Подкрутка""
	|		ИНАЧЕ ВЫБОР
	|				КОГДА Показания.ТекущиеПоказанияНаселенияОстаток <> 0
	|					ТОГДА ""Население""
	|				ИНАЧЕ ВЫБОР
	|						КОГДА Показания.ТекущиеПоказанияИнспектораОстаток <> 0
	|							ТОГДА ""Инспектор""
	|						ИНАЧЕ ""Ошибка""
	|					КОНЕЦ
	|			КОНЕЦ
	|	КОНЕЦ КАК Метка
	|ИЗ
	|	Показания КАК Показания";
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Метка = Выборка.Метка;
		
	Иначе
		
		Метка = "Ошибка";
	КонецЕсли;
	
	Возврат Метка;
	
КонецФункции // ()

// Процедура проверяет правильность заполнения реквизитов документа.
//
Процедура ПроверкаРеквизитовТЧ(ТаблицаТЧ, СтруктураШапкиДокумента, Отказ, Заголовок) Экспорт
	
	бит_ЗаполнениеДокументов.ПроверитьЗаполнениеТабличнойЧасти(ЭтотОбъект, "Услуги", Новый Структура("Услуга"), Отказ, Заголовок);
	
КонецПроцедуры // ПроверкаРеквизитов()

// Выполняет движения по регистрам.
//
Процедура ДвиженияПоРегистрам(СтруктураШапкиДокумента, ТаблицаПоУслугам, Отказ, Заголовок)
	
	Метка = ПроверкаИсточникаПоказаний();                   
	
	Если Метка = "Ошибка" Тогда
		
		Если Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Групповой Тогда
			Метка = "Инспектор";
		Иначе
			Метка = "Население";
		КонецЕсли; 
		
	КонецЕсли;
	
	// Если ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика.
	//	ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.СнятиеСчетчика Тогда.
	Если Счетчик.ТипСчетчика = Перечисления.бит_ТипСчетчика.Индивидуальный Тогда
		
		Для Каждого СтрокаТЧ Из Услуги Цикл
			
			Движение = Движения.бит_ПоказанияСчетчиков.Добавить();
			Движение.ВидДвижения = ?(ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика
			ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик,
			ВидДвиженияНакопления.Приход,
			ВидДвиженияНакопления.Расход);
			
			Движение.Период      = Дата;
			Движение.Счетчик     = Счетчик;
			Движение.Услуга      = СтрокаТЧ.Услуга;
			Движение.Объект      = Объект;
			Движение.Коэффициент = Счетчик.КоэффициентУмножения;
			
			НачПок = ?(Многотарифный, СтрокаТЧ.НачальныеПоказания, НачальныеПоказания);
			КонПок = ?(Многотарифный, СтрокаТЧ.КонечныеПоказания , КонечныеПоказания);
			
			Движение.ПоследниеПоказания         = НачПок;
			
			Если Метка = "Подкрутка" Тогда
				Движение.ТекущиеПоказанияИнспектора = 0;
				Движение.ТекущиеПоказанияНаселения  = 0;
				Движение.ПоказанияПодкрутка         = КонПок;
			ИначеЕсли Метка = "Инспектор" Тогда
				Движение.ТекущиеПоказанияИнспектора = КонПок;
				Движение.ТекущиеПоказанияНаселения  = 0;
				Движение.ПоказанияПодкрутка         = 0;
			ИначеЕсли Метка = "Население" Тогда
				Движение.ТекущиеПоказанияИнспектора = 0;
				Движение.ТекущиеПоказанияНаселения  = КонПок;
				Движение.ПоказанияПодкрутка         = 0;
			КонецЕсли;
			
			// БИТ_ЖКХ 29.05.2014	
			Движение.Организация   = СтруктураШапкиДокумента.Организация;
			// БИТ_ЖКХ 29.05.2014
			
			НовЗапись = Движения.бит_СчетчикиНаУслугахОбщий.Добавить();
			
			НовЗапись.Период        = Дата;
			НовЗапись.Объект        = Объект;
			НовЗапись.Услуга        = СтрокаТЧ.Услуга;
			НовЗапись.Счетчик       = Счетчик;
			НовЗапись.Использовать  = ?(ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.УстановкаСчетчика
			ИЛИ ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьУслугиНаСчетчик
			,Истина,Ложь);
			НовЗапись.ТипСчетчика   = Счетчик.ТипСчетчика;
			НовЗапись.Многотарифный = Многотарифный;
			НовЗапись.СпособРасчета = СпособРасчета;
			
			НовЗапись.СпособРаспределения           = Перечисления.бит_СпособыРаспределения.НеИспользуется;
			НовЗапись.СпособРаспределенияУменьшения = Перечисления.бит_СпособыРаспределения.НеИспользуется;
			
			НовЗапись.МестоУстановкиСчетчика        = МестоУстановкиСчетчика;
			НовЗапись.Приоритет                     = Приоритет;
			НовЗапись.ИспользоватьСтавкуПоСчетчику  = ИспользоватьСтавкуПоСчетчику;
			НовЗапись.Поставщик                     = СтрокаТЧ.Поставщик;
			НовЗапись.СтатусКвартиры                = СтрокаТЧ.СтатусКвартиры;
			НовЗапись.ТипКвартиры                   = СтрокаТЧ.ТипКвартиры;
			НовЗапись.РежимПотребления              = СтрокаТЧ.РежимПотребления;
			
		КонецЦикла;
		
	Иначе
		
		Запрос = Новый Запрос;
		Запрос.УстановитьПараметр("Ссылка", Ссылка);
		Если ВидОперации = Перечисления.бит_ВидыОперацийУстановкаСчетчика.ДобавитьЗданияНаСчетчик Тогда
			
			Запрос.УстановитьПараметр("Счетчик", Счетчик);
			Запрос.УстановитьПараметр("Организация", СтруктураШапкиДокумента.Организация);
			// БИТ_ЖКХ 09.06.2016 15:10:47 Начало правки... 
			Запрос.Текст = 
			"ВЫБРАТЬ РАЗЛИЧНЫЕ
			|	МАКСИМУМ(бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект) КАК Объект,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга КАК Услуга,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный КАК Многотарифный,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчета КАК СпособРасчета,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРаспределения КАК СпособРаспределения,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРаспределенияУменьшения КАК СпособРаспределенияУменьшения,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.МестоУстановкиСчетчика КАК МестоУстановкиСчетчика,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Приоритет КАК Приоритет,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ИспользоватьСтавкуПоСчетчику КАК ИспользоватьСтавкуПоСчетчику,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Поставщик КАК Поставщик,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СтатусКвартиры КАК СтатусКвартиры,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ТипКвартиры КАК ТипКвартиры,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.РежимПотребления КАК РежимПотребления,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СчетчикСЗависимымиУслугами КАК СчетчикСЗависимымиУслугами,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ОсновнаяУслуга КАК ОсновнаяУслуга,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ИспользоватьПравилоУменьшения КАК ИспользоватьПравилоУменьшения,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчетаУменьшения КАК СпособРасчетаУменьшения,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать КАК Использовать
			|ПОМЕСТИТЬ ТаблицаУслуг
			|ИЗ
			|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних КАК бит_СчетчикиНаУслугахОбщийСрезПоследних
			|ГДЕ
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик = &Счетчик
			|	И бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
			|
			|СГРУППИРОВАТЬ ПО
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Многотарифный,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчета,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРаспределения,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРаспределенияУменьшения,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.МестоУстановкиСчетчика,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Приоритет,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ИспользоватьСтавкуПоСчетчику,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Поставщик,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СтатусКвартиры,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ТипКвартиры,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.РежимПотребления,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СчетчикСЗависимымиУслугами,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ОсновнаяУслуга,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.ИспользоватьПравилоУменьшения,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчетаУменьшения,
			|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Услуга
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	бит_ПоказанияСчетчиковОстатки.Услуга КАК Услуга,
			|	бит_ПоказанияСчетчиковОстатки.ПоследниеПоказанияОстаток КАК ПоследниеПоказанияОстаток,
			|	бит_ПоказанияСчетчиковОстатки.ТекущиеПоказанияИнспектораОстаток КАК ТекущиеПоказанияИнспектораОстаток
			|ПОМЕСТИТЬ ВТ_НачальныеПоказания
			|ИЗ
			|	РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
			|			,
			|			Организация = &Организация
			|				И Счетчик = &Счетчик
			|				И Объект В
			|					(ВЫБРАТЬ
			|						ТаблицаУслуг.Объект
			|					ИЗ
			|						ТаблицаУслуг КАК ТаблицаУслуг)) КАК бит_ПоказанияСчетчиковОстатки
			|
			|ИНДЕКСИРОВАТЬ ПО
			|	Услуга
			|;
			|
			|////////////////////////////////////////////////////////////////////////////////
			|ВЫБРАТЬ
			|	бит_УстановкаСчетчикаЛицевыеСчета.Услуга КАК Услуга,
			|	бит_УстановкаСчетчикаЛицевыеСчета.ЛицевойСчет,
			|	бит_УстановкаСчетчикаЛицевыеСчета.Здание КАК Здание,
			|	ТаблицаУслуг.Многотарифный КАК Многотарифный,
			|	ТаблицаУслуг.СпособРасчета КАК СпособРасчета,
			|	ТаблицаУслуг.СпособРаспределения КАК СпособРаспределения,
			|	ТаблицаУслуг.СпособРаспределенияУменьшения КАК СпособРаспределенияУменьшения,
			|	ТаблицаУслуг.МестоУстановкиСчетчика КАК МестоУстановкиСчетчика,
			|	ТаблицаУслуг.Приоритет КАК Приоритет,
			|	ТаблицаУслуг.ИспользоватьСтавкуПоСчетчику КАК ИспользоватьСтавкуПоСчетчику,
			|	ТаблицаУслуг.Поставщик КАК Поставщик,
			|	ТаблицаУслуг.СтатусКвартиры КАК СтатусКвартиры,
			|	ТаблицаУслуг.ТипКвартиры КАК ТипКвартиры,
			|	ТаблицаУслуг.РежимПотребления КАК РежимПотребления,
			|	ТаблицаУслуг.СчетчикСЗависимымиУслугами КАК СчетчикСЗависимымиУслугами,
			|	ТаблицаУслуг.ОсновнаяУслуга КАК ОсновнаяУслуга,
			|	ТаблицаУслуг.ИспользоватьПравилоУменьшения КАК ИспользоватьПравилоУменьшения,
			|	ТаблицаУслуг.СпособРасчетаУменьшения КАК СпособРасчетаУменьшения,
			|	ТаблицаУслуг.Использовать КАК Использовать,
			|	ЕСТЬNULL(ВТ_НачальныеПоказания.ПоследниеПоказанияОстаток, 0) КАК НачальныеПоказания,
			|	ЕСТЬNULL(ВТ_НачальныеПоказания.ТекущиеПоказанияИнспектораОстаток, 0) КАК КонечныеПоказания
			|ИЗ
			|	Документ.бит_УстановкаСчетчика.ЛицевыеСчета КАК бит_УстановкаСчетчикаЛицевыеСчета
			|		ЛЕВОЕ СОЕДИНЕНИЕ ТаблицаУслуг КАК ТаблицаУслуг
			|		ПО бит_УстановкаСчетчикаЛицевыеСчета.Услуга = ТаблицаУслуг.Услуга
			|		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_НачальныеПоказания КАК ВТ_НачальныеПоказания
			|		ПО бит_УстановкаСчетчикаЛицевыеСчета.Услуга = ВТ_НачальныеПоказания.Услуга
			|ГДЕ
			|	бит_УстановкаСчетчикаЛицевыеСчета.Ссылка = &Ссылка
			|ИТОГИ
			|	МАКСИМУМ(Многотарифный),
			|	МАКСИМУМ(СпособРасчета),
			|	МАКСИМУМ(СпособРаспределения),
			|	МАКСИМУМ(СпособРаспределенияУменьшения),
			|	МАКСИМУМ(МестоУстановкиСчетчика),
			|	МАКСИМУМ(Приоритет),
			|	МАКСИМУМ(ИспользоватьСтавкуПоСчетчику),
			|	МАКСИМУМ(Поставщик),
			|	МАКСИМУМ(СтатусКвартиры),
