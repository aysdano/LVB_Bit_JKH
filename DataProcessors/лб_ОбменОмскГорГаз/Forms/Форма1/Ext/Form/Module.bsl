//8.2.3(2)
&НаКлиенте
Процедура ПроживающиеГорГаз(Команда)
	ФайлПроживающиеГорГаза = ОткрытьФайл();
	ПроживающиеГорГазНаСервере();
КонецПроцедуры

&НаСервере
Процедура ПроживающиеГорГазНаСервере()
	
	Массив = Новый Массив;
	Массив.Добавить("Период");
	Массив.Добавить("Услуга");
	Массив.Добавить("Поставщик");
	Массив.Добавить("Организация");
	Массив.Добавить("РежимДляНормативаПоУмолчанию");
	
	Для Каждого Реквизит ИЗ Массив Цикл
		Если Не ЗначениеЗаполнено(Объект[Реквизит]) Тогда
			ТекстСообщения = НСтр("ru = 'Не заполнен реквизит %1!'");
			ТекстСообщения = СтроковыеФункцииКлиентСервер.ПодставитьПараметрыВСтроку(ТекстСообщения, Реквизит);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Возврат
		КонецЕсли;
	КонецЦикла;
	
	НовыйДБФ = СоздатьПустойДБФПроживающиеГорГаз();
	
	Запрос = Новый Запрос;
	Запрос.Текст = ТекстЗапросаПроживающиеГорГаз();
	Запрос.УстановитьПараметр("Организация", Объект.Организация);
	Запрос.УстановитьПараметр("Услуга", Объект.Услуга);
	Запрос.УстановитьПараметр("НормативГорГаз", Объект.РежимДляНормативаПоУмолчанию);
	Запрос.УстановитьПараметр("Поставщик", Объект.Поставщик);
	Запрос.УстановитьПараметр("ПериодН", Новый Граница(НачалоМесяца(Объект.Период), ВидГраницы.Включая));
	Запрос.УстановитьПараметр("ПериодК", Новый Граница(КонецМесяца(Объект.Период), ВидГраницы.Включая));	
	Результат = Запрос.Выполнить().Выгрузить();
	
	Для Каждого Строка Из Результат Цикл
		НовыйДБФ.Добавить();
		
		ЛС = Строка.Ссылка.Наименование;
		Здание = Строка.Ссылка.Здание;
		Адрес = АдресПоЛСМассив(Строка.Ссылка, Здание);
		ФИО = ФИО(Строка.ФизЛицо);
		
		НовыйДБФ.LS = Строка.Ссылка.Наименование;
		НовыйДБФ.DOM = Адрес[0];
		НовыйДБФ.N_KVART = Адрес[1];
		НовыйДБФ.TAR = Строка.TAR;
		НовыйДБФ.K_CH = Строка.K_CH;
		НовыйДБФ.K_JIL = Строка.K_JIL;
		НовыйДБФ.K_FAKT = Строка.K_FAKT;
		Если Строка.PR_KV = 1 Тогда
			НовыйДБФ.K_SOB = Строка.K_SOB;
		КонецЕсли;
		НовыйДБФ.S = Строка.S;
		НовыйДБФ.NACH_BI = Строка.NACH_BI;
		НовыйДБФ.NACH_I = Строка.NACH_I;
		НовыйДБФ.S_KM = Строка.S_KM;
		НовыйДБФ.FAM = ФИО.Фамилия;
		НовыйДБФ.IM = ФИО.Имя;
		НовыйДБФ.OTCH = ФИО.Отчество;
		Попытка
			НовыйДБФ.D_ROG = Строка.ФизЛицо.ДатаРождения;
		Исключение
		КонецПопытки;
		НовыйДБФ.DAT_REG = Строка.DAT_REG;
		НовыйДБФ.DAT_UNREG = Строка.DAT_UNREG;
		НовыйДБФ.VID_REG = Строка.VID_REG;
		НовыйДБФ.PR_KV = Строка.PR_KV;
		
		РодОтношение = "";
		Если НЕ Строка.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_НеУказано и НЕ Строка.СтепеньРодства = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
			РодОтношение = Строка(Строка.СтепеньРодства);
		КонецЕсли;
		
		Если Строка.K_SOB = 1 и Строка.ВладелецКвартиры = 1 Тогда
			Доля = "Собств., ";
			НовыйДБФ.ROD_OTN = Доля + РодОтношение;
		Иначе
			Доля = "";
			Если Строка.ВладелецКвартиры = 1 И Строка.ДоляПлощади <> 0  Тогда
				Доля = "Собств. " + Дробь(Строка.ДоляПлощади) + ", ";
			КонецЕсли;
			НовыйДБФ.ROD_OTN = Доля + РодОтношение; 
		КонецЕсли;
		НовыйДБФ.PERIOD = Формат(Объект.Период, "ДФ=MM.yyyy");
		
		НовыйДБФ.Записать();
	КонецЦикла;
	
	НовыйДБФ.ЗакрытьФайл();
	
	ПереместитьФайл(ФайлПроживающиеГорГазаВр, ФайлПроживающиеГорГаза);

КонецПроцедуры

