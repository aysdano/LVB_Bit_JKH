		<dataSource>ИнформационнаяБаза</dataSource>
		<query>ВЫБРАТЬ
	бит_ЗаявкаНаВыполнениеРаботРаботы.Работа,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.КатегорияРабот КАК КатегорияРабот,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Количество КАК Количество,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Адрес,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ВремяУдобноеДляЗаказчика КАК ДатаИВремяПоступления,
	ВЫБОР
		КОГДА бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.СтатусВыполнения = ЗНАЧЕНИЕ(Справочник.бит_СтатусыВыполнения.Выполнено)
			ТОГДА бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ВремяФактическогоВыполнения
	КОНЕЦ КАК ДатаИВремяВыполнения,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ОтветственныйЗаВыполнение КАК Мастер,
	ВЫБОР
		КОГДА бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ФлагВыполнения = ИСТИНА
			ТОГДА бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ОценкаВыполнения
		ИНАЧЕ NULL
	КОНЕЦ КАК Оценка,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка КАК Заявка,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ТекстЗаявки КАК ОписаниеЗаявки,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.СтатусВыполнения,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.ОбъектУчета КАК Объект,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Норма,
	бит_ЗаявкаНаВыполнениеРаботРаботы.ЕдиницаИзмерения,
	бит_ЗаявкаНаВыполнениеРаботРаботы.КоэффициентНормы,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Организация,
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Подразделение
ИЗ
	Документ.бит_ЗаявкаНаВыполнениеРабот.Работы КАК бит_ЗаявкаНаВыполнениеРаботРаботы
ГДЕ
	бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Проведен = ИСТИНА
	И бит_ЗаявкаНаВыполнениеРаботРаботы.Ссылка.Дата МЕЖДУ &amp;НачалоПериода И &amp;КонецПериода</query>
	</dataSet>
