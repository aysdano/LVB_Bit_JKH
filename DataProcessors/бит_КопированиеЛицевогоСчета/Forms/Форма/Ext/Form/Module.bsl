			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Копирование лицевого счета завершено успешно.");
			
		Иначе

			бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение(Результат.ТекстОшибки);
			
