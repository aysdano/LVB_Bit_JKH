&НаСервере
Процедура ВыгрузитьДанныеКвартиросъемщикаВDBF(ПостроительЗапроса,ТаблицаОтвЛиц)
	
	АдресФайлКвартиросъемщики = Объект.кр_Каталог +"\"+ Объект.кр_ИмяФайлаКвартиросъемщики +".dbf";
	
	Попытка
		
		ФайлКвартиросъемщики = Новый XBase();
		
		#Если НЕ ВебКлиент Тогда
			
			ФайлКвартиросъемщики.Кодировка = КодировкаXBase[Объект.кр_Кодировка];
			
		#КонецЕсли
		
		ФайлКвартиросъемщики.Поля.Добавить("ID"   , "S", 15);   // Лицевой счет.
		ФайлКвартиросъемщики.Поля.Добавить("PUNKT", "S", 30);   // Населенный пункт.
		ФайлКвартиросъемщики.Поля.Добавить("TIP"  , "S", 20);   // Тип улицы.
		ФайлКвартиросъемщики.Поля.Добавить("UL"   , "S", 30);   // Улица.
		ФайлКвартиросъемщики.Поля.Добавить("DOM"  , "N", 3);    // Дом.
		ФайлКвартиросъемщики.Поля.Добавить("KOR"  , "N", 2);    // Корпус.
		ФайлКвартиросъемщики.Поля.Добавить("BDOM" , "S", 1);    // Буква дома.
		ФайлКвартиросъемщики.Поля.Добавить("KV"   , "S", 10);   // Квартира.
		
		ФайлКвартиросъемщики.Поля.Добавить("BKV"  , "S", 1);    // Буква квартиры.
		
		ФайлКвартиросъемщики.Поля.Добавить("OTCH" , "S", 7);    // Отчетный месяц.
		ФайлКвартиросъемщики.Поля.Добавить("SEM"  , "N", 2);    // Количество челов семьи.
		ФайлКвартиросъемщики.Поля.Добавить("PL"   , "N", 6, 2); // Общая площадь.
		ФайлКвартиросъемщики.Поля.Добавить("DOLG" , "L");       // Наличие задолжности.
		ФайлКвартиросъемщики.Поля.Добавить("Z"    , "S", 60);   // ПричинаЗакртия жилищной субсидии.
		ФайлКвартиросъемщики.Поля.Добавить("KVSM" , "N", 7);    // Главный квартиросъемщик.
		
		ФайлКвартиросъемщики.Поля.Добавить("SDOLG" , "N", 9, 2); // Сумма долга.
		ФайлКвартиросъемщики.Поля.Добавить("PER_B", "S", 10);   // Начало периода задолженности.
		ФайлКвартиросъемщики.Поля.Добавить("PER_E", "S", 10);   // Конец периода задолженности.
		ФайлКвартиросъемщики.Поля.Добавить("SOG"  , "L");       // Наличие соглашения о реструктуризации задолженности.
		ФайлКвартиросъемщики.Поля.Добавить("IUSOG", "L");       // Исполнение условий соглашения.
		ФайлКвартиросъемщики.Поля.Добавить("PLODN"	, "N", 6, 2); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
		ФайлКвартиросъемщики.Поля.Добавить("PLODN_V", "N", 6, 2); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
		ФайлКвартиросъемщики.Поля.Добавить("FIAS_ID", "S", 36);   // Идентификатор  дома в ФИАС.
		
		ФайлКвартиросъемщики.СоздатьФайл(АдресФайлКвартиросъемщики);
		
		ФайлКвартиросъемщики.ОчиститьФайл();
		
		Выборка = ПостроительЗапроса.Результат.Выбрать();
		
		Пока Выборка.Следующий() Цикл
			
			СтрокаТаблицыКод = ТаблицаОтвЛиц.Найти(Выборка.ЛицевойСчет, "ЛицевойСчет");
			
			Код = ?(СтрокаТаблицыКод = Неопределено, 0, СтрокаТаблицыКод.Код);
			
			ФайлКвартиросъемщики.Добавить();
			ФайлКвартиросъемщики.ID    = Выборка.Наименование;
			ФайлКвартиросъемщики.PUNKT = Лев(Строка(Выборка.Район), 30);
			ФайлКвартиросъемщики.TIP   = Лев(Строка(Выборка.ТипУлицы), 30);;
			ФайлКвартиросъемщики.UL    = Лев(Строка(Выборка.Улица), 30);
			ФайлКвартиросъемщики.DOM   = Лев(Строка(Выборка.Здание), 3);
			ФайлКвартиросъемщики.KOR   = Лев(Строка(Выборка.Корпус), 2);  
			ФайлКвартиросъемщики.BDOM  = Лев(Строка(Выборка.ПрефиксДома), 1);
			ФайлКвартиросъемщики.KV    = Лев(?(Строка(Выборка.Квартира) = "-","", Строка(Выборка.Квартира)), 10);
			ФайлКвартиросъемщики.BKV   = Лев(Строка(Выборка.ПрефиксКвартиры), 1);    // Буква квартиры.
			ФайлКвартиросъемщики.OTCH  = Формат(Объект.Период, "ДФ=MM.yyyy");
			ФайлКвартиросъемщики.SEM   = Выборка.КоличествоЧленовСемьи;
			ФайлКвартиросъемщики.PL    = Формат(Выборка.ОбщаяПлощадь, "ЧЦ=6; ЧДЦ=2; ЧГ=0");
			ФайлКвартиросъемщики.DOLG  = ?(Выборка.Сальдо > 0 И Выборка.ДолгНачалоПериода > 0, Истина, Ложь);
			ФайлКвартиросъемщики.Z     = "";
			ФайлКвартиросъемщики.KVSM  = Код;
			
			Если Выборка.ДолгНачалоПериода>0 Тогда
				ДолгНачалоПериода =	Выборка.ДолгНачалоПериода;
			Иначе 
				ДолгНачалоПериода =	0;
			КонецЕсли;
			
			ФайлКвартиросъемщики.SDOLG     = ?(Выборка.Сальдо > 0,ДолгНачалоПериода,0);             // Сумма долга.			
					 
			ФайлКвартиросъемщики.SOG       = Ложь;                                                  // Наличие соглашения о реструктуризации задолженности.
			ФайлКвартиросъемщики.IUSOG     = Ложь;                                                  // Исполнение условий соглашения.
			ФайлКвартиросъемщики.PLODN    = Формат(Выборка.ПлощадьОДНСОИЭлектроснаб	, "ЧЦ=6; ЧДЦ=2; ЧГ=0"); // Площадь на общедомовые нужды (ОДН).
			ФайлКвартиросъемщики.PLODN_V  = Формат(Выборка.ПлощадьОДНСОИВодоснаб	, "ЧЦ=6; ЧДЦ=2; ЧГ=0"); // Площадь на общедомовые нужды (ОДН).
			ФайлКвартиросъемщики.FIAS_ID  = Лев(Строка(Выборка.КодФИАС), 36);					// Идентификатор  дома в ФИАС.
			
			// БИТ ЖКХ 6.03.2020
			если ФайлКвартиросъемщики.SDOLG > 0 и ФайлКвартиросъемщики.DOLG  = истина  тогда
			 ФайлКвартиросъемщики.PER_B     = Формат(Выборка.НачалоЗадолженности,"ДФ=дд.MM.yyyy");   // Начало периода задолженности.
			 ФайлКвартиросъемщики.PER_E     = Формат(НачалоМесяца(Объект.Период),"ДФ=дд.MM.yyyy");    // Конец периода задолженности.
		    конецесли;
			
			ФайлКвартиросъемщики.Записать();
			
		КонецЦикла;
		
		Если ФайлКвартиросъемщики.Открыта() Тогда
			ФайлКвартиросъемщики.ЗакрытьФайл();
		КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла ""Квартиросъемщики"".
		|" + ОписаниеОшибки());
	КонецПопытки;
	
	
	
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьСведенияОЧленахСемьиВExcel(ПостроительЗапроса,ТаблицаОтвЛиц)
	
	ЕстьОшибки = Ложь;
	
	// Создадим приложение Excel.
	Excel = бит_Выгрузка.СоздатьПриложениеExcel();
	
	Если Excel = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		бит_ОбщегоНазначения.бит_Состояние("Создание файла Excel для заполнения...");
		
		Книга          = Excel.Application.WorkBooks.Add(1);
		ExcelЛист	   = Excel.ActiveSheet;
		
		бит_ОбщегоНазначения.бит_Состояние("Установка формата колонок листа Excel...");
		
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 1, Истина);    // Ключевое поле.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 2, Истина);   // Лицевой счет.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 3, Истина);   // ФИО.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 4, Истина);   // Дата рождения.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 5, Истина);    // Пол.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 6, Истина);    // Вид регистрации. 
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 7, Истина);    // Тип Удостоверения.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 8, Истина);   // Серия удостоверения личности. 
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 9, Истина);    // Номер.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 10, Истина);   // Дата выдачи удостоверения личности.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 11, Истина);  // Кем выдан документ.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 12, Истина);    // Код родственного отношения.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 13, Истина);    // Доля дохода учитываемого при расчете. 
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 14, Истина);   // Дата регистрации.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 15, Истина);   // Дата выбытия.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 16, Истина);   // Строк отсутсвия с. 
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 17, Истина);   // Строк отсутсвия по.
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение заголовка листа Excel...");
		
		
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "NN"   , 1, 1);    // Ключевое поле.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ID"   , 2, 1);   // Лицевой счет.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "FIO"  , 3, 1);   // ФИО.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DR"   , 4, 1);   // Дата рождения.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "SX"   , 5, 1);    // Пол.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "VR"   , 6, 1);    // Вид регистрации. 
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UDT"  , 7, 1);    // Тип Удостоверения.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UDS"  , 8, 1);   // Серия. 
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UDN"  , 9, 1);    // Номер.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UDD"  , 10, 1);   // Дата выдачик.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ORGAN", 11, 1);  // Кем выдан.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "RO"   , 12, 1);    // Код родственного отношения.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DD"   , 13, 1);    // Доля.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DREG" , 14, 1);   // Дата регистрации.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DVYB" , 15, 1);   // Дата выбытия.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "POTS" , 16, 1);   // Периоды отсутствия  «с»-«по», разделитель между периодами «;».
		
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение листа Excel...");
		
		НомерСтроки = 2;
		
		Выборка = ПостроительЗапроса.Результат.Выбрать();
		
		
		НомерПоПорядку = 0;
		
		ЛицевойСчетПред = Неопределено;	
		
		Пока Выборка.Следующий() Цикл
			
			НомерПоПорядку = НомерПоПорядку + 1;	
			
			СтрокаТаблицыКод = ТаблицаОтвЛиц.Найти(Выборка.ЛицевойСчет, "ЛицевойСчет");
			
			Код = ?(СтрокаТаблицыКод = Неопределено, 0, СтрокаТаблицыКод.Код);
			
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , НомерПоПорядку                             , 1, НомерСтроки);    // Ключевое поле.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Наименование                       , 2, НомерСтроки);   // Лицевой счет.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ФизЛицо), 60)           , 3, НомерСтроки);   // ФИО.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ДатаРождения), 10)      , 4, НомерСтроки);   // Дата рождения.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской"),1,2), 5, НомерСтроки);    // Пол.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ВидРегистрации), 2)     , 6, НомерСтроки);    // Вид регистрации. 
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.КодДокумента), 2)       , 7, НомерСтроки);    // Тип Удостоверения.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ДокументСерия), 10)     , 8, НомерСтроки);   // Серия. 
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ДокументНомер), 7)      , 9, НомерСтроки);    // Номер.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ДокументДатаВыдачи), 10), 10,НомерСтроки);   // Дата выдачик.
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ДокументКемВыдан), 100) , 11,НомерСтроки);  // Кем выдан.
			
			Если (Выборка.КодПоГУГЦЖС = "91" или  Выборка.КодПоГУГЦЖС = "091") 
				и Выборка.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский") Тогда
				
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , "92"                        , 12,НомерСтроки);    // Код родственного отношения.
				
			ИначеЕсли (Выборка.КодПоГУГЦЖС = "92" или  Выборка.КодПоГУГЦЖС = "092") 
				и Выборка.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской") Тогда
				
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , "91"                        , 12,НомерСтроки);    // Код родственного отношения.
				
			Иначе
				
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.КодПоГУГЦЖС                        , 12,НомерСтроки);    // Код родственного отношения.
				
			КонецЕсли;
			
			
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ДоляПлощади), 2)        , 13,НомерСтроки);    // Доля.
			
			Если ЗначениеЗаполнено(Выборка.ДатаРегистрации) Тогда
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ДатаРегистрации), 10)   , 14, НомерСтроки);   // Дата регистрации.
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.ДатаСнятияСРегистрации), 10) , 15, НомерСтроки);   // Дата выбытия.
			КонецЕсли; 			
			
			бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , "" , 16, НомерСтроки);   // Периоды отсутствия  «с»-«по», разделитель между периодами «;». 
			
			
			Если Выборка.СтепеньРодства = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо") Тогда
				
				НоваяСтрока = ТаблицаОтвЛиц.Добавить();
				НоваяСтрока.ЛицевойСчет = Выборка.ЛицевойСчет;
				НоваяСтрока.ФизЛицо     = Выборка.ФизЛицо;
				НоваяСтрока.Код         = НомерПоПорядку;
				
			КонецЕсли; 
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла; 
		
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 2);
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 38);
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 39);
		
		
		ПутьВыгрузки = Объект.кр_Каталог;
		
		ИмяФайла = Объект.кр_ИмяФайлаСведения +".xls";
		
		Книга.ConflictResolution = 1;
		Книга.SaveAs(ПутьВыгрузки + "\"+ ИмяФайла);
		Excel.Quit();
		
	Исключение
		ЕстьОшибки = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить лист Excel!
									|%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	Если ЕстьОшибки Тогда
		
		бит_Выгрузка.ЗакрытьПриложениеExcel(Excel);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьСведенияОЧленахСемьиВDBF(ПостроительЗапроса,ТаблицаОтвЛиц)
	
	АдресФайлСведения = Объект.кр_Каталог +"\"+ Объект.кр_ИмяФайлаСведения +".dbf";
	
	Попытка
		
		ФайлСведения = Новый XBase();
		
		#Если НЕ ВебКлиент Тогда
			
			ФайлСведения.Кодировка = КодировкаXBase[Объект.кр_Кодировка];
			
		#КонецЕсли
		
		ФайлСведения.Поля.Добавить("NN"   , "N", 7);    // Ключевое поле.
		ФайлСведения.Поля.Добавить("ID"   , "S", 15);   // Лицевой счет.
		ФайлСведения.Поля.Добавить("FIO"  , "S", 60);   // ФИО.
		ФайлСведения.Поля.Добавить("DR"   , "S", 10);   // Дата рождения.
		ФайлСведения.Поля.Добавить("SX"   , "N", 1);    // Пол.
		ФайлСведения.Поля.Добавить("VR"   , "N", 2);    // Вид регистрации. 
		ФайлСведения.Поля.Добавить("UDT"  , "N", 1);    // Тип Удостоверения.
		ФайлСведения.Поля.Добавить("UDS"  , "S", 10);   // Серя. 
		ФайлСведения.Поля.Добавить("UDN"  , "N", 7);    // Номер.
		ФайлСведения.Поля.Добавить("UDD"  , "S", 10);   // Дата выдачик.
		ФайлСведения.Поля.Добавить("ORGAN", "S", 100);  // Кем выдан.
		ФайлСведения.Поля.Добавить("RO"   , "N", 2);    // Код родственного отношения.
		ФайлСведения.Поля.Добавить("DD"   , "N", 2);    // Доля.
		ФайлСведения.Поля.Добавить("DREG" , "C", 10);   // Дата регистрации.
		ФайлСведения.Поля.Добавить("DVYB" , "C", 10);   // Дата выбытия.
		ФайлСведения.Поля.Добавить("POTS" , "C", 250);   // Периоды отсутствия  «с»-«по», разделитель между периодами «;». 
		
		ФайлСведения.СоздатьФайл(АдресФайлСведения);
		
		ФайлСведения.ОчиститьФайл();
		
		Выборка = ПостроительЗапроса.Результат.Выбрать();
		
		НомерПоПорядку = 0;
		
		ЛицевойСчетПред = Неопределено;	
		
		Пока Выборка.Следующий() Цикл
			
			НомерПоПорядку = НомерПоПорядку + 1;	
			
			ФайлСведения.Добавить();
			
			ФайлСведения.NN    = НомерПоПорядку;
			ФайлСведения.ID    = Выборка.Наименование;
			ФайлСведения.FIO   = Лев(Строка(Выборка.ФизЛицо), 60);
			ФайлСведения.DR    = Лев(Строка(Выборка.ДатаРождения), 10);
			ФайлСведения.SX    = ?(Выборка.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской"),1,2);
			ФайлСведения.VR    = Лев(Строка(Выборка.ВидРегистрации), 2);
			ФайлСведения.UDT   = Лев(Строка(Выборка.КодДокумента), 2);
			ФайлСведения.UDS   = Лев(Строка(Выборка.ДокументСерия), 10);
			ФайлСведения.UDN   = Лев(Строка(Выборка.ДокументНомер), 7);
			ФайлСведения.UDD   = Лев(Строка(Выборка.ДокументДатаВыдачи), 10);
			ФайлСведения.ORGAN = Лев(Строка(Выборка.ДокументКемВыдан), 100);
			
			Если (Выборка.КодПоГУГЦЖС = "91" или  Выборка.КодПоГУГЦЖС = "091") 
				и Выборка.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский") Тогда
				
				ФайлСведения.RO    = "92";
				
			ИначеЕсли (Выборка.КодПоГУГЦЖС = "92" или  Выборка.КодПоГУГЦЖС = "092") 
				и Выборка.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской") Тогда
				
				ФайлСведения.RO    = "91";
				
			Иначе
				
				ФайлСведения.RO    = Выборка.КодПоГУГЦЖС;
				
			КонецЕсли;
			
			ФайлСведения.DD    = Лев(Строка(Выборка.ДоляПлощади), 2);
			
			Если ЗначениеЗаполнено(Выборка.ДатаРегистрации) Тогда
				ФайлСведения.DREG  = Лев(Строка(Выборка.ДатаРегистрации), 10);
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.ДатаСнятияСРегистрации) Тогда
				ФайлСведения.DVYB  = Лев(Строка(Выборка.ДатаСнятияСРегистрации), 10);
			КонецЕсли; 
			
			ФайлСведения.POTS  = "";
			
			ФайлСведения.Записать();
			
			Если Выборка.СтепеньРодства = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо") Тогда
				
				НоваяСтрока = ТаблицаОтвЛиц.Добавить();
				НоваяСтрока.ЛицевойСчет = Выборка.ЛицевойСчет;
				НоваяСтрока.ФизЛицо     = Выборка.ФизЛицо;
				НоваяСтрока.Код         = НомерПоПорядку;
				
			КонецЕсли; 
			
		КонецЦикла;
		
		Если ФайлСведения.Открыта() Тогда
			ФайлСведения.ЗакрытьФайл();
		КонецЕсли;
		
	Исключение
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю("Ошибка создания файла ""Сведения о членах семьи"".
		|" + ОписаниеОшибки());
		
	КонецПопытки;	
КонецПроцедуры	

&НаСервере
Процедура ВыгрузитьСуммыОплатыУслугВExcel(ПостроительЗапроса,ТаблицаОтвЛиц)
	
	ЕстьОшибки = Ложь;
	
	// Создадим приложение Excel.
	Excel = бит_Выгрузка.СоздатьПриложениеExcel();
	
	Если Excel = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		бит_ОбщегоНазначения.бит_Состояние("Создание файла Excel для заполнения...");
		
		Книга          = Excel.Application.WorkBooks.Add(1);
		ExcelЛист	   = Excel.ActiveSheet;
		
		
		бит_ОбщегоНазначения.бит_Состояние("Установка формата колонок листа Excel...");
		
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 1 , Истина);   // Ключевое поле.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 2 , Истина);   // Лицевой счет.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 3 , Истина);   // Код услуги.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 4 , Истина);   // К оплате.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 5 , Истина);   // Сумма по социальной норме за услугу USL.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 6 , Истина);   // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 7 , Истина);   // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 8 , Истина);   // Начислено.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 9 , Истина);   // Количество месяцев.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 10, Истина);   // Наличие счетчика.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 11, Истина);   // Месяц начисления.
		бит_Выгрузка.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 12, Истина);   // Признак перерасчета.
		
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение заголовка листа Excel...");
		
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "NN"   , 1 , 1);   // Ключевое поле.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ID"   , 2 , 1);   // Лицевой счет.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "USL"  , 3 , 1);   // Код услуги.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S1"   , 4 , 1);   // К оплате.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S2"   , 5 , 1);   // Сумма по социальной норме за услугу USL.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S3"   , 6 , 1);   // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S4"   , 7 , 1);   // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S5"   , 8 , 1);   // Начислено.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PER"  , 9 , 1);   // Количество месяцев.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "CHET" , 10, 1);   // Наличие счетчика.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "OTCH" , 11, 1);   // Месяц начисления.
		бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ITOG" , 12, 1);   // Признак перерасчета.
		
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение листа Excel...");
		
		НомерСтроки = 2;
		
		Выборка = ПостроительЗапроса.Результат.Выбрать();
		
		НомерСтр = 1;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Регистратор,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчета,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Период
		|ИЗ
		|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&КонецПериода, ) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних";
		
		Запрос.УстановитьПараметр("КонецПериода"  , КонецМесяца(Объект.Период));
		
		Результат = Запрос.Выполнить();
		
		ТЗСпособРасчетаПоСчетчикам = Результат.Выгрузить();
		
		ТЗСпособРасчетаПоСчетчикам.Сортировать("Период Возр");
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		
		КодУслуги = Неопределено;	
		
		
		Пока Выборка.Следующий() Цикл
			
			КодУслуги = Неопределено;	
			
			Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам Тогда
				
				МассивСчетчиков = Новый Массив;
				Для Каждого СтрокаТЗ из ТЗСпособРасчетаПоСчетчикам Цикл
					
					Если СтрокаТЗ.Объект = Выборка.Здание и СтрокаТЗ.Услуга = Выборка.УслугаЖКХ Тогда
						СпособРасчетаПоСчетчикам = СтрокаТЗ.СпособРасчета;
						Если МассивСчетчиков.Найти(СтрокаТЗ.СпособРасчета) = Неопределено Тогда
							МассивСчетчиков.Добавить(СтрокаТЗ.СпособРасчета);
						КонецЕсли;
					КонецЕсли;
					
					Если СтрокаТЗ.Объект = Выборка.ЛицевойСчет и СтрокаТЗ.Услуга = Выборка.УслугаЖКХ Тогда
						СпособРасчетаПоСчетчикам = СтрокаТЗ.СпособРасчета;
						Если МассивСчетчиков.Найти(СтрокаТЗ.СпособРасчета) = Неопределено Тогда
							МассивСчетчиков.Добавить(СтрокаТЗ.СпособРасчета);
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
				Если МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено
					И (МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено 
					ИЛИ МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено) 
					И Выборка.Общедом > 0 Тогда
					
					КодУслуги = Выборка.КодПоГУГЦЖС_КПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено
					И (МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено 
					ИЛИ МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено) 
					И Выборка.Общедом = 0 Тогда
					
					КодУслуги = Выборка.КодПоГУГЦЖС_ДПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено
					И МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено Тогда 
					
					КодУслуги = Выборка.КодПоГУГЦЖС_ДПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено Тогда
					
					КодУслуги = Выборка.КодПоГУГЦЖС_КПУ;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Выборка.ЭтоРазовые Тогда
				
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , НомерСтр											, 1 , НомерСтроки); // Ключевое поле.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Наименование								, 2 , НомерСтроки); // Лицевой счет.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.КодПоГУГЦЖС_Разовые							, 3 , НомерСтроки); // Код услуги.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Разовые										, 4 , НомерСтроки); // К оплате.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Разовые										, 5 , НомерСтроки); // Сумма по социальной норме за услугу USL.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0													, 6 , НомерСтроки); // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0													, 7 , НомерСтроки); // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Разовые										, 8 , НомерСтроки); // Начислено.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 1													, 9 , НомерСтроки); // Количество месяцев.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , (Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")) , 10 , НомерСтроки); // Наличие счетчика.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Объект.Период, "ДФ=MM.yyyy")					, 11 , НомерСтроки); // Месяц начисления.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Истина												, 12 , НомерСтроки); // Признак перерасчета.
				
				НомерСтр = НомерСтр + 1;
				НомерСтроки = НомерСтроки + 1;
				
			ИначеЕсли Не Выборка.ОбщедомовыеНачисления Тогда
				
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , НомерСтр												, 1 , НомерСтроки); // Ключевое поле.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Наименование									, 2 , НомерСтроки); // Лицевой счет.
				Если КодУслуги = Неопределено Тогда
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.КодПоГУГЦЖС									, 3 , НомерСтроки); // Код услуги.
				Иначе
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , КодУслуги											, 3 , НомерСтроки); // Код услуги.
				КонецЕсли;
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Начислено - Выборка.Общедом - Выборка.СуммаПИ	, 4 , НомерСтроки); // К оплате.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0														, 5 , НомерСтроки); // Сумма по социальной норме за услугу USL.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0														, 6 , НомерСтроки); // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
				Если Выборка.КодПоГУГЦЖС = "012" ИЛИ Выборка.КодПоГУГЦЖС = "022" ИЛИ Выборка.КодПоГУГЦЖС = "043"
					ИЛИ Выборка.КодПоГУГЦЖС = "12" ИЛИ Выборка.КодПоГУГЦЖС = "22" ИЛИ Выборка.КодПоГУГЦЖС = "43" Тогда
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Оплата										, 7 , НомерСтроки); // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
				Иначе
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0													, 7 , НомерСтроки); // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
				КонецЕсли;
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Начислено - Выборка.Общедом						, 8 , НомерСтроки); // Начислено.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 1														, 9 , НомерСтроки); // Количество месяцев.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , (Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")) , 10 , НомерСтроки); // Наличие счетчика.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Объект.Период, "ДФ=MM.yyyy")						, 11 , НомерСтроки); // Месяц начисления.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.ОбщеДом = 0,Ложь,Истина)						, 12 , НомерСтроки); // Признак перерасчета.
				
				НомерСтр = НомерСтр + 1;
				НомерСтроки = НомерСтроки + 1;
				
				Если Выборка.Общедом <> 0 Тогда
					
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , НомерСтр											, 1 , НомерСтроки); // Ключевое поле.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Наименование								, 2 , НомерСтроки); // Лицевой счет.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.КодПоГУГЦЖС_ДПУ								, 3 , НомерСтроки); // Код услуги.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Общедом										, 4 , НомерСтроки); // К оплате.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0													, 5 , НомерСтроки); // Сумма по социальной норме за услугу USL.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0													, 6 , НомерСтроки); // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
					Если Выборка.КодПоГУГЦЖС = "012" ИЛИ Выборка.КодПоГУГЦЖС = "022" ИЛИ Выборка.КодПоГУГЦЖС = "043"
						ИЛИ Выборка.КодПоГУГЦЖС = "12" ИЛИ Выборка.КодПоГУГЦЖС = "22" ИЛИ Выборка.КодПоГУГЦЖС = "43" Тогда
						бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Оплата									, 7 , НомерСтроки); // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
					Иначе
						бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0												, 7 , НомерСтроки); // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
					КонецЕсли;
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Общедом										, 8 , НомерСтроки); // Начислено.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 1													, 9 , НомерСтроки); // Количество месяцев.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , (Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")) , 10 , НомерСтроки); // Наличие счетчика.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Объект.Период, "ДФ=MM.yyyy")					, 11 , НомерСтроки); // Месяц начисления.
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.ОбщеДом = 0,Ложь,Истина)					, 12 , НомерСтроки); // Признак перерасчета.
					
					НомерСтр = НомерСтр + 1;
					НомерСтроки = НомерСтроки + 1;
					
				КонецЕсли;
				
			Иначе
				
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , НомерСтр                                          , 1 , НомерСтроки); // Ключевое поле.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Наименование                              , 2 , НомерСтроки); // Лицевой счет.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.КодПоГУГЦЖС_ДПУ                           , 3 , НомерСтроки); // Код услуги.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Начислено - Выборка.СуммаПИ               , 4 , НомерСтроки); // К оплате.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0                                                 , 5 , НомерСтроки); // Сумма по социальной норме за услугу USL .
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0                                                 , 6 , НомерСтроки); // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
				Если Выборка.КодПоГУГЦЖС = "012" ИЛИ Выборка.КодПоГУГЦЖС = "022" ИЛИ Выборка.КодПоГУГЦЖС = "043"
					ИЛИ Выборка.КодПоГУГЦЖС = "12" ИЛИ Выборка.КодПоГУГЦЖС = "22" ИЛИ Выборка.КодПоГУГЦЖС = "43" Тогда
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Оплата                                , 7 , НомерСтроки); // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
				Иначе
					бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0                                             , 7 , НомерСтроки); // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
				КонецЕсли;
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Начислено                                 , 8 , НомерСтроки); // Начислено.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 1                                                 , 9 , НомерСтроки); // Количество месяцев.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , (Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам")) , 10 , НомерСтроки); // Наличие счетчика.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Объект.Период, "ДФ=MM.yyyy")               , 11 , НомерСтроки); // Месяц начисления.
				бит_Выгрузка.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.ОбщеДом = 0,Ложь,Истина)                , 12 , НомерСтроки); // Признак перерасчета.
				
				НомерСтр = НомерСтр + 1;
				НомерСтроки = НомерСтроки + 1;
				
			КонецЕсли;
			
		КонецЦикла;
		
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 2);
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 38);
		бит_Выгрузка.УстановитьШиринуКолонкиExcel(ExcelЛист, 39);
		
		
		ПутьВыгрузки = Объект.кр_Каталог;
		
		ИмяФайла = Объект.кр_ИмяФайлаОплатыУслуг +".xls";
		
		Книга.ConflictResolution = 1;
		Книга.SaveAs(ПутьВыгрузки + "\"+ ИмяФайла);
		Excel.Quit();
		
	Исключение
		ЕстьОшибки = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить лист Excel!
									|%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	Если ЕстьОшибки Тогда
		
		бит_Выгрузка.ЗакрытьПриложениеExcel(Excel);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаСервере
Процедура ВыгрузитьСуммыОплатыУслугВDBF(ПостроительЗапроса,ТаблицаОтвЛиц)
	
	АдресФайлКвартиросъемщики = Объект.кр_Каталог +"\"+ Объект.кр_ИмяФайлаОплатыУслуг +".dbf";
	
	Попытка
		
		ФайлОплаты = Новый XBase();
		
		#Если НЕ ВебКлиент Тогда
			
			ФайлОплаты.Кодировка = КодировкаXBase[Объект.кр_Кодировка];
			
		#КонецЕсли
		
		ФайлОплаты.Поля.Добавить("NN"   , "N", 7);      // Ключевое поле.
		ФайлОплаты.Поля.Добавить("ID"   , "S", 15);     // Лицевой счет.
		ФайлОплаты.Поля.Добавить("USL"  , "N", 5);      // Код услуги.
		ФайлОплаты.Поля.Добавить("S1"   , "N", 9, 2);   // К оплате.
		ФайлОплаты.Поля.Добавить("S2"   , "N", 9, 2);   // Хз.
		ФайлОплаты.Поля.Добавить("S3"   , "N", 9, 2);   // Хз.
		ФайлОплаты.Поля.Добавить("S4"   , "N", 9, 2);   // Льгота.
		ФайлОплаты.Поля.Добавить("S5"   , "N", 9, 2);   // Начислено.
		ФайлОплаты.Поля.Добавить("PER"  , "N", 2);      // Количество месяцев.
		ФайлОплаты.Поля.Добавить("CHET" , "L");         // Наличие счетчика.
		ФайлОплаты.Поля.Добавить("OTCH" , "S", 7);      // Месяц начисления.
		ФайлОплаты.Поля.Добавить("ITOG" , "L");         // Признак перерасчета.
		
		ФайлОплаты.СоздатьФайл(АдресФайлКвартиросъемщики);
		
		ФайлОплаты.ОчиститьФайл();
		
		Выборка = ПостроительЗапроса.Результат.Выбрать();
		
		НомерСтр = 1;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Регистратор,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Объект,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Услуга,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Счетчик,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Использовать,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.СпособРасчета,
		|	бит_СчетчикиНаУслугахОбщийСрезПоследних.Период
		|ИЗ
		|	РегистрСведений.бит_СчетчикиНаУслугахОбщий.СрезПоследних(&КонецПериода, ) КАК бит_СчетчикиНаУслугахОбщийСрезПоследних";
		
		Запрос.УстановитьПараметр("КонецПериода"  , КонецМесяца(Объект.Период));
		
		Результат = Запрос.Выполнить();
		
		ТЗСпособРасчетаПоСчетчикам = Результат.Выгрузить();
		
		ТЗСпособРасчетаПоСчетчикам.Сортировать("Период Возр");
		
		ВыборкаДетальныеЗаписи = Результат.Выбрать();
		
		КодУслуги = Неопределено;	
		
		Пока Выборка.Следующий() Цикл
			
			КодУслуги = Неопределено;	
			
			Если Выборка.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам Тогда
				
				МассивСчетчиков = Новый Массив;
				Для Каждого СтрокаТЗ из ТЗСпособРасчетаПоСчетчикам Цикл
					
					Если СтрокаТЗ.Объект = Выборка.Здание и СтрокаТЗ.Услуга = Выборка.УслугаЖКХ Тогда
						СпособРасчетаПоСчетчикам = СтрокаТЗ.СпособРасчета;
						Если МассивСчетчиков.Найти(СтрокаТЗ.СпособРасчета) = Неопределено Тогда
							МассивСчетчиков.Добавить(СтрокаТЗ.СпособРасчета);
						КонецЕсли;
					КонецЕсли;
					
					Если СтрокаТЗ.Объект = Выборка.ЛицевойСчет и СтрокаТЗ.Услуга = Выборка.УслугаЖКХ Тогда
						СпособРасчетаПоСчетчикам = СтрокаТЗ.СпособРасчета;
						Если МассивСчетчиков.Найти(СтрокаТЗ.СпособРасчета) = Неопределено Тогда
							МассивСчетчиков.Добавить(СтрокаТЗ.СпособРасчета);
						КонецЕсли;
					КонецЕсли;
					
				КонецЦикла;
				
				Если МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено
					И (МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено 
					ИЛИ МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено) 
					И Выборка.Общедом > 0 Тогда
					
					КодУслуги = Выборка.КодПоГУГЦЖС_КПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено
					И (МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено 
					ИЛИ МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено) 
					И Выборка.Общедом = 0 Тогда
					
					КодУслуги = Выборка.КодПоГУГЦЖС_ДПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено
					И МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено Тогда 
					
					КодУслуги = Выборка.КодПоГУГЦЖС_ДПУ;
					
				ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено Тогда
					
					КодУслуги = Выборка.КодПоГУГЦЖС_КПУ;
					
				КонецЕсли;
				
			КонецЕсли;
			
			Если Выборка.ЭтоРазовые Тогда
				
				ФайлОплаты.Добавить();
				
				ФайлОплаты.NN	= НомерСтр;
				ФайлОплаты.ID	= Выборка.Наименование;
				ФайлОплаты.USL	= Выборка.КодПоГУГЦЖС_Разовые;
				ФайлОплаты.S1	= Выборка.Разовые;
				ФайлОплаты.S2	= Выборка.Разовые;
				ФайлОплаты.S3	= "";
				ФайлОплаты.S4	= "";
				ФайлОплаты.S5	= Выборка.Разовые; 
				ФайлОплаты.PER	= 1;
				ФайлОплаты.CHET	= (Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам"));
				ФайлОплаты.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
				ФайлОплаты.ITOG	= Истина;
				
				ФайлОплаты.Записать();
				НомерСтр = НомерСтр + 1;

			ИначеЕсли Не Выборка.ОбщедомовыеНачисления Тогда
				
				ФайлОплаты.Добавить();
				
				ФайлОплаты.NN	= НомерСтр;
				ФайлОплаты.ID	= Выборка.Наименование;
				Если КодУслуги	= Неопределено Тогда
					ФайлОплаты.USL	= Выборка.КодПоГУГЦЖС;
				Иначе
					ФайлОплаты.USL	= КодУслуги;
				КонецЕсли;
				ФайлОплаты.S1	= Выборка.Начислено - Выборка.Общедом - Выборка.СуммаПИ;
				ФайлОплаты.S2	= "";
				ФайлОплаты.S3	= "";
				Если Выборка.КодПоГУГЦЖС = "012" ИЛИ Выборка.КодПоГУГЦЖС = "022" ИЛИ Выборка.КодПоГУГЦЖС = "043"
					ИЛИ Выборка.КодПоГУГЦЖС = "12" ИЛИ Выборка.КодПоГУГЦЖС = "22" ИЛИ Выборка.КодПоГУГЦЖС = "43" Тогда
					ФайлОплаты.S4	= Выборка.Оплата;
				Иначе
					ФайлОплаты.S4	= "";
				КонецЕсли;
				ФайлОплаты.S5	= Выборка.Начислено - Выборка.Общедом; 
				ФайлОплаты.PER	= 1;
				ФайлОплаты.CHET	= (Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам"));
				ФайлОплаты.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
				ФайлОплаты.ITOG	= ?(Выборка.ОбщеДом = 0,Ложь,Истина);
				
				ФайлОплаты.Записать();
				НомерСтр = НомерСтр + 1;
				
				Если Выборка.Общедом <> 0 Тогда
					
					ФайлОплаты.Добавить();
					
					ФайлОплаты.NN	= НомерСтр;
					ФайлОплаты.ID	= Выборка.Наименование;
					ФайлОплаты.USL	= Выборка.КодПоГУГЦЖС_ДПУ;
					ФайлОплаты.S1	= Выборка.Общедом;
					ФайлОплаты.S2	= "";
					ФайлОплаты.S3	= "";
					Если Выборка.КодПоГУГЦЖС = "012" ИЛИ Выборка.КодПоГУГЦЖС = "022" ИЛИ Выборка.КодПоГУГЦЖС = "043"
						ИЛИ Выборка.КодПоГУГЦЖС = "12" ИЛИ Выборка.КодПоГУГЦЖС = "22" ИЛИ Выборка.КодПоГУГЦЖС = "43" Тогда
						ФайлОплаты.S4	= Выборка.Оплата;
					Иначе
						ФайлОплаты.S4	= "";
					КонецЕсли;
					ФайлОплаты.S5	= Выборка.Общедом; 
					ФайлОплаты.PER	= 1;
					ФайлОплаты.CHET	= (Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам"));
					ФайлОплаты.OTCH	= Формат(Объект.Период, "ДФ=MM.yyyy");
					ФайлОплаты.ITOG	= ?(Выборка.ОбщеДом = 0,Ложь,Истина);
					
					ФайлОплаты.Записать();
					НомерСтр = НомерСтр + 1;
					
				КонецЕсли;
				
			Иначе
				
				ФайлОплаты.Добавить();
				
				ФайлОплаты.NN	= НомерСтр;
				ФайлОплаты.ID	= Выборка.Наименование;
				ФайлОплаты.USL	= Выборка.КодПоГУГЦЖС_ДПУ;
				ФайлОплаты.S1	= Выборка.Начислено - Выборка.СуммаПИ;
				ФайлОплаты.S2	= "";
				ФайлОплаты.S3	= "";
				Если Выборка.КодПоГУГЦЖС = "012" ИЛИ Выборка.КодПоГУГЦЖС = "022" ИЛИ Выборка.КодПоГУГЦЖС = "043"
					ИЛИ Выборка.КодПоГУГЦЖС = "12" ИЛИ Выборка.КодПоГУГЦЖС = "22" ИЛИ Выборка.КодПоГУГЦЖС = "43" Тогда
					ФайлОплаты.S4	= Выборка.Оплата;
