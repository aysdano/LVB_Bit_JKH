		ТекстСообщения = НСтр("ru = 'Не выбран владелец банковского счета.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ПараметрыОтбора = Новый Структура("Владелец", ВыбранныйЭлемент);
