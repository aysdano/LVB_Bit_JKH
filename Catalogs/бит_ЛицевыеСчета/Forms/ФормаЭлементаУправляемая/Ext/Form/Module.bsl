&НаСервере
Функция ПолучитьЗаписьРегистраСведений()
	
	Запрос = Новый Запрос(
	"ВЫБРАТЬ
	|	бит_ЗамечанияПоЛС.Номер,
	|	бит_ЗамечанияПоЛС.ЛицевойСчет
	|ИЗ
	|	РегистрСведений.бит_ЗамечанияПоЛС КАК бит_ЗамечанияПоЛС
	|ГДЕ
	|	бит_ЗамечанияПоЛС.ЛицевойСчет = &ЛицевойСчет
	|	И бит_ЗамечанияПоЛС.ДатаЗаписи = &ДатаЗаписи");
	
	Запрос.УстановитьПараметр("ЛицевойСчет", Объект.Ссылка);
	Запрос.УстановитьПараметр("ДатаЗаписи",  НачалоДня(ТекущаяДата()));
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Если Выборка.Следующий() Тогда
		
		Результат = Новый Структура;
		
		Результат.Вставить("ЛицевойСчет", Выборка.ЛицевойСчет);
		Результат.Вставить("Номер"      , Выборка.Номер);
		
	Иначе
		
		Результат = Неопределено;
		
	КонецЕсли;
	
	Возврат Результат;
	
КонецФункции

