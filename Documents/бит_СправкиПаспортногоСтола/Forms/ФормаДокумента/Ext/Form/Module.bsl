// БИТ_ЖКХ Процедура 
//
// Параметры:
//  Параметр1 – Строка.
//
Процедура ОбновитьТаблицуПроживающих()
	
	Если НЕ Объект.ТаблицаПроживающих.Количество() = 0 И Объект.ИспользоватьОтборПроживающих Тогда
		
		Ответ = Неопределено;
		
		ПоказатьВопрос(Новый ОписаниеОповещения("ОбновитьТаблицуПроживающихЗавершение", ЭтотОбъект), "Таблица будет очищена. Продолжить?", РежимДиалогаВопрос.ДаНет);
		Возврат; 
		
	КонецЕсли; 
	
	ОбновитьТаблицуПроживающихФрагмент();
КонецПроцедуры

