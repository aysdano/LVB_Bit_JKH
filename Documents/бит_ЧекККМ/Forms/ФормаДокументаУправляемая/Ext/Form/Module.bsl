
#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	// Заполняем кэш значений.
	ЗаполнитьКэшЗначений(мКэшЗначений);
	
	Если Параметры.Свойство("ЗаполнитьИзДокументаЧекККМ") Тогда
		
		Объект.Касса       = Параметры.ЗаполнитьИзДокументаЧекККМ.Касса;
		Объект.Организация = Параметры.ЗаполнитьИзДокументаЧекККМ.Организация;
		
		ДокументОбъект = ДанныеФормыВЗначение(Объект, Тип("ДокументОбъект.бит_ЧекККМ"));
		ДокументОбъект.УстановитьВремя(РежимАвтоВремя.Последним);
		ЗначениеВДанныеФормы(ДокументОбъект, Объект);
	КонецЕсли;
	
	Если Параметры.Ключ.Пустая() Тогда
		Объект.КодКассы = ЗначениеРеквизитаНаСервере(Объект.Касса, "КодКассы"); 
		Объект.КодПачки = ""+Объект.КодКассы+""+Формат(День(Объект.Дата),"ЧЦ=2; ЧВН=")+""+Формат(Месяц(Объект.Дата),"ЧЦ=2; ЧВН=");
		Объект.Организация = ЗначениеРеквизитаНаСервере(Объект.Касса, "Владелец");
	КонецЕсли;
	
	ОбновитьОкноИнформации();
	
	Если Параметры.Ключ.Пустая() Тогда
		ПодготовитьФормуНаСервере();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ПриОткрытии(Отказ)
	
	Если ИспользуютсяСканерыШтрихкода И НЕ ТолькоПросмотр Тогда
		// Попробуем подключить сканер штрихкода
		ОповещенияПриПодключении = Новый ОписаниеОповещения("ПодключитьСканерШКЗавершение", ЭтотОбъект); 
		МенеджерОборудованияКлиент.НачатьПодключениеОборудованиеПоТипу(ОповещенияПриПодключении, УникальныйИдентификатор, "СканерШтрихкода");
	КонецЕсли;

	Если Параметры.Ключ.Пустая() Тогда
		Объект.ПериодНачислений = ПериодНачислений(Объект.Дата);
	КонецЕсли;
	ПериодНач = бит_РаботаСДиалогами.ДатаКакМесяцПредставление(Объект.ПериодНачислений);
	
	мКэшЗначений.мТекущаяДатаДокумента = Объект.Дата;
	
	УстановитьДоступностьФормыДляРедактированияНаСервере();
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		ПолучитьНачисленияПени();
	КонецЕсли; 
	
	мКэшЗначений.НуженПерерасчет = ?(Параметры.Ключ.Пустая(), Истина, Ложь);
	
	УправлениеЭлементамиФормы();
	
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ПодключитьСканерШКЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт

	СканерШтрихкодаПодключен = РезультатВыполнения.Результат;

КонецПроцедуры

&НаКлиенте
Процедура ПередЗакрытием(Отказ, ЗавершениеРаботы, ТекстПредупреждения, СтандартнаяОбработка)
	
	Если СканерШтрихкодаПодключен И ЗавершениеРаботы Тогда
		Отказ = Истина;
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПриЗакрытии(ЗавершениеРаботы)
	
	// ПодключаемоеОборудование
	Если СканерШтрихкодаПодключен И НЕ ЗавершениеРаботы Тогда
		ТипыПО = ОбщегоНазначенияКлиентСервер.ЗначениеВМассиве("СканерШтрихкода");
		ОповещенияПриОтключении = Новый ОписаниеОповещения("ОтключитьСканерШКЗавершение", ЭтотОбъект); 
		МенеджерОборудованияКлиент.НачатьОтключениеОборудованиеПоТипу(ОповещенияПриОтключении, УникальныйИдентификатор, ТипыПО);
	КонецЕсли;
	//Конец  ПодключаемоеОборудование

КонецПроцедуры

&НаКлиенте
Процедура ОтключитьСканерШКЗавершение(РезультатВыполнения, ДополнительныеПараметры) Экспорт
	
	Если НЕ РезультатВыполнения.Результат Тогда
		ТекстСообщения = НСтр("ru = 'При отключении оборудования произошла ошибка: ""%1"".'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, РезультатВыполнения.ОписаниеОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	Иначе
		СканерШтрихкодаПодключен = Ложь;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриЧтенииНаСервере(ТекущийОбъект)
	
	ПодготовитьФормуНаСервере();
	
КонецПроцедуры

&НаКлиенте
Процедура ПослеЗаписи(ПараметрыЗаписи)
	
	УстановитьЗаголовокФормыДокумента();
	
КонецПроцедуры

&НаКлиенте
Процедура ВнешнееСобытие(Источник, Событие, Данные)
	
	Если Событие = "Штрихкод" Тогда
		
		Попытка
			
			Массив = МенеджерОборудованияВызовСервера.ОборудованиеПоПараметрам(,,МенеджерОборудованияВызовСервера.ПолучитьРабочееМестоКлиента());
			
			Для Каждого Стр из Массив Цикл
				Если Стр.ТипОборудования = ПредопределенноеЗначение("Перечисление.ТипыПодключаемогоОборудования.СканерШтрихкода") Тогда
					
					Результат = бит_ОбработатьСобытиеСШК(Объект, Данные);
					
				КонецЕсли;
			КонецЦикла;
			
		Исключение
			
		КонецПопытки;
		
	КонецЕсли;
	
	Если ЗначениеЗаполнено(Объект.СуммаОплаты) 
		И ЗначениеЗаполнено(Объект.ШаблонИзвещений) 
		И ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		РасчетУслуг();
		
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовШапкиФормы

&НаКлиенте
Процедура ВидОперацииПриИзменении(Элемент)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.ВозвратВнешнийБиллинг") Тогда
		ВыборЧекаККМВозврата();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ДатаПриИзменении(Элемент)
	
	ПроверитьНомерДокументаНаСервере();
	
	мКэшЗначений.мТекущаяДатаДокумента = Объект.Дата; // Запомним текущую дату документа для контроля номера документа.
	
	Объект.КодПачки = "" + Объект.КодКассы + "" + Формат(День(Объект.Дата),"ЧЦ=2; ЧВН=") + "" + Формат(Месяц(Объект.Дата),"ЧЦ=2; ЧВН=");
	
КонецПроцедуры

&НаКлиенте
Процедура ВводВручнуюПриИзменении(Элемент)
	
	мКэшЗначений.НуженПерерасчет = Истина;
	
	ВводВручнуюПриИзмененииСервер();
	
	Если ЗначениеЗаполнено(Объект.СуммаОплаты) Тогда
		ПриИзмененииЛицевогоСчет_Услуги();
	КонецЕсли; 
	
	УстановитьДосутпность();
	УстановитьВидимостьКолонкиПени();
	
КонецПроцедуры

&НаКлиенте
Процедура КассаПриИзменении(Элемент)
	
	ОбработкаКассаПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияПриИзменении(Элемент)
	
	Если НЕ ЗначениеЗаполнено(Объект.Организация) Тогда
		Объект.Касса = ПредопределенноеЗначение("Справочник.бит_КассыККМ.ПустаяСсылка");
	КонецЕсли;	
	
КонецПроцедуры

&НаКлиенте
Процедура ОрганизацияОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		КассаОрганизации = НайтиКассуОрганизации(ВыбранноеЗначение); 
		Если Объект.Касса  <> КассаОрганизации Тогда
			Объект.Касса = КассаОрганизации;
		КонецЕсли;
	Иначе
		Объект.Касса = ПредопределенноеЗначение("Справочник.бит_КассыККМ.ПустаяСсылка");
	КонецЕсли;
	ОбработкаКассаПриИзменении();
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонИзвещенийПриИзменении(Элемент)
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Продажа")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат") Тогда
		ПриИзмененииЛицевогоСчет_Услуги();
	Иначе
		ПриИзмененииЛицевогоСчет_БиллинговыеУслуги();
	КонецЕсли; 
	
	УстановитьВидимость();
	
КонецПроцедуры

&НаКлиенте
Процедура ШаблонИзвещенийОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Объект.ШаблонИзвещений Тогда
		мКэшЗначений.НуженПерерасчет = Ложь;
	Иначе
		мКэшЗначений.НуженПерерасчет = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетПриИзменении(Элемент)
	
	ЗаполнениеСправочнойИнформации(Объект.ЛицевойСчет);
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Продажа")
		ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат") Тогда
		ПриИзмененииЛицевогоСчет_Услуги();
	Иначе
		ПриИзмененииЛицевогоСчет_БиллинговыеУслуги();
	КонецЕсли; 
	
	УстановитьВидимость();
	Объект.Счетчики.Очистить();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛицевойСчетОбработкаВыбора(Элемент, ВыбранноеЗначение, СтандартнаяОбработка)
	
	Если ВыбранноеЗначение = Объект.ЛицевойСчет Тогда
		мКэшЗначений.НуженПерерасчет = Ложь;
	Иначе
		мКэшЗначений.НуженПерерасчет = Истина;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура СуммаОплатыПриИзменении(Элемент)
	
	мКэшЗначений.НуженПерерасчет = Истина;
	Объект.Итого = Объект.СуммаОплаты; 
	
	Если Объект.ВводВручную Тогда
		
		ОбновитьОкноИнформации();
		
	Иначе	
		
		Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Продажа")
			ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат") Тогда
			ПриИзмененииЛицевогоСчет_Услуги();
		Иначе	
			ПриИзмененииЛицевогоСчет_БиллинговыеУслуги();
		КонецЕсли; 
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ИтогоПриИзменении(Элемент)
	
	Объект.Сдача = ?(Объект.Итого > Объект.СуммаОплаты, Объект.Итого - Объект.СуммаОплаты, 0);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыУслуги

&НаКлиенте
Процедура УслугиСуммаПениПриИзменении(Элемент)
	
	ТекСтрокаУС = Элементы.Услуги.ТекущиеДанные;
	
	Если ТекСтрокаУС <> Неопределено И мТаблицаНачисленийПени <> Неопределено Тогда
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет" ,Объект.ЛицевойСчет);
		Отбор.Вставить("Услуга"      ,ТекСтрокаУС.Услуга);
		
		СтрокаПени = мТаблицаНачисленийПени.НайтиСтроки(Отбор);
		
		Если СтрокаПени.Количество() = 1 Тогда
			
			СальдоПени = СтрокаПени[0].СуммаПени;
			СуммаПени  = Число(Элемент.ТекстРедактирования);
			
			Если СуммаПени > СальдоПени Тогда
				
				ТекстСообщения = НСтр("ru='Сумма оплаты пени : %1 не может превышать сальдо пени: %2'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, СуммаПени, СальдоПени);
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
				
				ТекСтрокаУС.СуммаПени = СальдоПени;
				
			КонецЕсли; 
			
		Иначе
			
			ТекстСообщения = НСтр("ru='Начислений ""Пени"" по услуге: %1 не было произведено!'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ТекСтрокаУС.Услуга);
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			ТекСтрокаУС.СуммаПени = 0;
			
		КонецЕсли; 
		
	Иначе
		
		ТекстСообщения = НСтр("ru='Начислений ""Пени"" по услуге: %1 не было произведено!'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ТекСтрокаУС.Услуга);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		ТекСтрокаУС.СуммаПени = 0;
		
	КонецЕсли; 
	
	Если мТаблицаДолга.Количество() > 0  Тогда
		МассивДолгаПоУсл = мТаблицаДолга.НайтиСтроки(Новый Структура("Услуга" ,ТекСтрокаУС.Услуга));
		Если МассивДолгаПоУсл.Количество() > 0 Тогда
			ТекСтрокаУС.Долг      = МассивДолгаПоУсл[0].Долг - ТекСтрокаУС.СуммаПени - ТекСтрокаУС.Сумма;
			МассивДолгаПоУсл[0].СуммаПени = ТекСтрокаУС.СуммаПени;
		КонецЕсли; 	
	КонецЕсли;

	ОбновитьОкноИнформации();
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСуммаПриИзменении(Элемент)
	
	ТекСтрокаУС = Элементы.Услуги.ТекущиеДанные;
	
	Если мТаблицаДолга.Количество() > 0  Тогда
		МассивДолгаПоУсл = мТаблицаДолга.НайтиСтроки(Новый Структура("Услуга" ,ТекСтрокаУС.Услуга));
		Если МассивДолгаПоУсл.Количество() > 0 Тогда
			ТекСтрокаУС.Долг      = МассивДолгаПоУсл[0].Долг - ТекСтрокаУС.СуммаПени - ТекСтрокаУС.Сумма;
			МассивДолгаПоУсл[0].Сумма = ТекСтрокаУС.Сумма;
		КонецЕсли; 	
	КонецЕсли;
	
	ОбновитьОкноИнформации();

	ПриИзмененииСумма("Услуги");
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСтавкаНДСПриИзменении(Элемент)
	
	ПриИзмененииСтавкаНДС("Услуги");
	
КонецПроцедуры

&НаКлиенте
Процедура УслугиСуммаНДСПриИзменении(Элемент)
	
	ПриИзмененииСуммаНДС("Услуги");
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСумма(ИмяТабЧасти)

	СтрокаТаблицы = Элементы[ИмяТабЧасти].ТекущиеДанные;
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	Если Объект.ДокументБезНДС Тогда
		СтрокаТаблицы.СтавкаНДС	= ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
	КонецЕсли;
	
	ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТаблицы, Объект.СуммаВключаетНДС);
	//СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма + ?(Объект.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);
	
КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСуммаНДС(ИмяТабЧасти)

	СтрокаТаблицы = Элементы[ИмяТабЧасти].ТекущиеДанные;
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли; 
	
	//СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма + ?(Объект.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);

КонецПроцедуры

&НаКлиенте
Процедура ПриИзмененииСтавкаНДС(ИмяТабЧасти)

	СтрокаТаблицы = Элементы[ИмяТабЧасти].ТекущиеДанные;
	
	Если СтрокаТаблицы = Неопределено Тогда
		Возврат;
	КонецЕсли; 

	Если Объект.ДокументБезНДС Тогда
		СтрокаТаблицы.СтавкаНДС	= ПредопределенноеЗначение("Перечисление.СтавкиНДС.БезНДС");
		
		ТекстСообщения = НСтр("ru = 'В параметрах настройки ЖКХ установлена настройка ""Вариант расчета НДС"": Документ без НДС!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецЕсли;
	
	ОбработкаТабличныхЧастейКлиентСервер.РассчитатьСуммуНДСТабЧасти(СтрокаТаблицы, Объект.СуммаВключаетНДС);
	//СтрокаТаблицы.Сумма = СтрокаТаблицы.Сумма + ?(Объект.СуммаВключаетНДС, 0, СтрокаТаблицы.СуммаНДС);

КонецПроцедуры


#КонецОбласти

#Область ОбработчикиСобытийЭлементовТаблицыФормыСчетчики

&НаКлиенте
Процедура СчетчикиТекущиеПоказанияПриИзменении(Элемент)
	
	ТекСчетчик = Элементы.Счетчики.ТекущиеДанные.Счетчик;
	
	Многотарифный = МноготарифныйНаСервере(ТекСчетчик);
	
	Для Каждого СтрокаТЧ из Объект.Счетчики Цикл
		
		Если СтрокаТЧ.Счетчик = ТекСчетчик и НЕ Многотарифный Тогда
			ЧислоСтрока	= Элемент.ТекстРедактирования;
			МоеЧисло	= Число(ЧислоСтрока);			
			
			ЭлементЗначение = МоеЧисло;
			
			Если СтрокаТЧ.ТекущиеПоказания < СтрокаТЧ.ПредыдущиеПоказания
				И ЗначениеЗаполнено(СтрокаТЧ.ТекущиеПоказания) Тогда
				
				Разность = СтрокаТЧ.Разрядность - СтрокаТЧ.ПредыдущиеПоказания + 1 + СтрокаТЧ.ТекущиеПоказания;
				
				ТекстВопроса = НСтр("ru='Произойдет переход через 0 на разность: %1. Ввести?'");
				ТекстВопроса = СтрШаблон(ТекстВопроса, Разность);
				ОписаниеОповещения = Новый ОписаниеОповещения("СчетчикиТекущиеПоказанияПриИзмененииЗавершение", ЭтотОбъект
																, Новый Структура("СтрокаТЧ, ЭлементЗначение", СтрокаТЧ, ЭлементЗначение));
				ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
				
			Иначе
				
				СтрокаТЧ.ТекущиеПоказания = ЭлементЗначение;
				
			КонецЕсли;
		КонецЕсли;
	КонецЦикла;
	
КонецПроцедуры

&НаКлиенте
Процедура СчетчикиТекущиеПоказанияПриИзмененииЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
	
	СтрокаТЧ = ДополнительныеПараметры.СтрокаТЧ;
	ЭлементЗначение = ДополнительныеПараметры.ЭлементЗначение;
	
	Если РезультатВопроса = КодВозвратаДиалога.Нет Тогда
		СтрокаТЧ.ТекущиеПоказания = 0;
	Иначе
		СтрокаТЧ.ТекущиеПоказания = ЭлементЗначение;
	КонецЕсли;
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ПечатьТЧ(Команда)
	
	Результат = Печать();
	
	АдресТабличногоДокументаВоВременномХранилище = ПоместитьВоВременноеХранилище(Результат, АдресТабличногоДокументаВоВременномХранилище);
	
	бит_ПечатьКлиент.ОбработатьКомандуПечати("Документы"
	,"бит_ЗаявлениеОРегистрацииПоМестуПЖ"
	,"АЛП_стар"
	,"Ф2:Адресный листок прибытия"
	,АдресТабличногоДокументаВоВременномХранилище
	,Объект.Ссылка);
	
КонецПроцедуры

&НаКлиенте
Процедура Заполнить(Команда)
	
	Если Объект.Счетчики.Количество() >0 Тогда
		ТекстВопроса = НСтр("ru='Табличная часть ""Счетчики"" будет очищена. Продолжить?'");
		ОписаниеОповещения = Новый ОписаниеОповещения("ЗаполнитьЗавершение", ЭтотОбъект);
		ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	Иначе
		ЗаполнениеТаблицыСчетчиков();
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ЗаполнитьЗавершение(Ответ, ДополнительныеПараметры) Экспорт
	
	Если Ответ = КодВозвратаДиалога.Да Тогда
		ЗаполнениеТаблицыСчетчиков();
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаБезСдачи(Команда)
	
	ПараметрыФормы = Новый Структура;
	ПараметрыФормы.Вставить("СуммаОплаты", Объект.СуммаОплаты);
	ВведенноеЗначение = Неопределено;
	ОткрытьФорму("Документ.бит_ЧекККМ.Форма.ФормаСдачиУправляемая", Новый Структура("ОткрытьИзКнопкиОплатаБезСдачи", ПараметрыФормы), ЭтаФорма,,,, Новый ОписаниеОповещения("ОплатаБезСдачиЗавершение", ЭтотОбъект), РежимОткрытияОкнаФормы.БлокироватьВесьИнтерфейс);
	
КонецПроцедуры

&НаКлиенте
Процедура ОплатаБезСдачиЗавершение(Результат, ДополнительныеПараметры) Экспорт
	
	Если ТипЗнч(Результат) = Тип("Структура") Тогда
		
		Объект.Итого = Результат.Итого;
		Объект.Сдача = Результат.Сдача;
		
	КонецЕсли;
	
	Если Объект.Итого >= 15000 Тогда
		
		Элементы.Плательщик.ПропускатьПриВводе        = Ложь;		
		ТекущийЭлемент                                = Элементы.Плательщик;
		Элементы.Плательщик.АвтоОтметкаНезаполненного = Истина;
		
		#Если Клиент Тогда
			
			ПоказатьПредупреждение(, "Платеж 15 тыс.руб. или более, укажите плательщика!", 30);
			
		#КонецЕсли
		
	ИначеЕсли Объект.СуммаОплаты > Объект.Итого Тогда
		
		ТекущийЭлемент = Элементы.ОплатаБезСдачи;
		
	Иначе
		
		ТекущийЭлемент = Элементы.СчетчикиЗаполнить;
		
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура ВвестиПоказания(Команда)
	
	Если Объект.Счетчики.Количество() = 0 Тогда
		ТекстСообщения = НСтр("ru = 'В таблице нет счетчиков для ввода показаний.'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		Возврат;
	КонецЕсли;
	
	ВводПоказанийПоСчетчикам();
	
КонецПроцедуры

&НаКлиенте
Процедура НовыйЧек(Команда)
	
	Попытка
		ЗаписатьНаСервере(РежимЗаписиДокумента.Проведение);	
		Закрыть();
		Оповестить("НовыйЧекПроведен");
		СоздатьНовыйДокумент();
	Исключение
		Возврат;
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ПречекЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
    Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
        ОсновныеДействияФормыКассовыйОттиск();
    КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ПечатьИН(Команда)
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		ПериодНачислений = ПериодНачислений(Объект.Дата);
		
		ФормаОбработка = ОткрытьФорму("Обработка.бит_ПечатьСчетИзвещений.Форма.ФормаУправляемая");	
		Обработка =	ФормаОбработка.Объект;
		
		Обработка.СписокЛС.Очистить();
		НовыйЛС = Обработка.СписокЛС.Добавить();
		НовыйЛС.ЛицевойСчет = Объект.ЛицевойСчет; 
		
		Обработка.ШаблонИзвещений     = ПредопределенноеЗначение("Справочник.бит_ШаблоныИзвещений.ПоВсемУслугам");
		Обработка.Организация         = Объект.Организация;
		Обработка.ДатаПечатиКвитанций = ТекущаяДата();
		Обработка.Период              = ПериодНачислений;
	
		Если ЗначениеЗаполнено(Объект.Организация) Тогда
			Обработка.РС = ЗначениеРеквизитаНаСервере(Объект.Организация, "ОсновнойБанковскийСчет");
			Если НЕ ЗначениеЗаполнено(Обработка.РС) Тогда
				Обработка.РС = РСНаСервере(Объект.Организация);
			КонецЕсли; 
		КонецЕсли;
		
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ПечатьТН(Команда)
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("Ключ",Объект.ЛицевойСчет);
		Форма = ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаЭлементаУправляемая",ПараметрыФормы, ЭтаФорма);
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("АдресСтруктурыВХранилище"           , Форма.АдресСтруктурыВХранилище);
		
		ОткрытьФорму("Справочник.бит_ЛицевыеСчета.Форма.ФормаПечатиТекущихНачислений", ПараметрыФормы, ЭтаФорма);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ДвиженияЛС(Команда)
	
	Если ЗначениеЗаполнено(Объект.ЛицевойСчет) Тогда
		
		ПараметрыФормы = Новый Структура;
		ПараметрыФормы.Вставить("ЛицевойСчет", Объект.ЛицевойСчет);
		
		Форма = ОткрытьФорму("Отчет.бит_ОтчетОДвиженияхНаЛСПомесячно.Форма.ФормаОтчета", ПараметрыФормы);
		Форма.Отчет.НачалоПериода  = НачалоГода(ТекущаяДата());
		Форма.Отчет.КонецПериода   = КонецМесяца(ТекущаяДата());
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура Чек(Команда)
	
	ОчиститьСообщения();
	
	Если Объект.НомерЧекаККМ <> 0 ИЛИ Объект.ЧекПробитНаККМ Тогда
		ТекстСообщения = НСтр("ru = 'Чек уже пробит на фискальном устройстве!'");
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
		Возврат;
	КонецЕсли;
	
	Отказ = Ложь;
	Если Объект.СуммаОплаты >= 15000
		И НЕ ЗначениеЗаполнено(Объект.Плательщик) Тогда
		
		ТекстОшибки = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'Плательщик'"));
		ТекстСообщения = СтрШаблон(НСтр("ru = 'Сумма оплаты больше 15 тыс. руб. %1'"), ТекстОшибки);
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Плательщик", "Объект", Отказ);
	КонецЕсли;
	
	Если Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Продажа") И Объект.Итого = 0 тогда
		ТекстСообщения = ОбщегоНазначенияКлиентСервер.ТекстОшибкиЗаполнения("Поле", "Заполнение", НСтр("ru = 'Получено'"));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения,, "Итого", "Объект", Отказ);
	КонецЕсли;		
	
	Если Отказ Тогда
		Возврат;
	КонецЕсли; 
	
	ТекстВопроса = НСтр("ru='Будет напечатан фискальный чек. Продолжить?'");
	ОписаниеОповещения = Новый ОписаниеОповещения("ЧекЗавершение", ЭтотОбъект);
	ПоказатьВопрос(ОписаниеОповещения, ТекстВопроса, РежимДиалогаВопрос.ДаНет);
	
КонецПроцедуры

&НаКлиенте
Процедура ЧекЗавершение(РезультатВопроса, ДополнительныеПараметры) Экспорт
    
	Если РезультатВопроса = КодВозвратаДиалога.Да Тогда
		
		МассивПустойНдс = Объект.Услуги.НайтиСтроки(Новый Структура("СтавкаНДС", ПредопределенноеЗначение("Перечисление.СтавкиНДС.ПустаяСсылка")));
		Если МассивПустойНдс.Количество() > 0 Тогда
			ОчиститьСообщения();
			ТекстСообщения = НСтр("ru = 'Ошибка при записи чека.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			Для Каждого Элт Из МассивПустойНдс Цикл
				ТекстСообщения = НСтр("ru='Для услуги ""%1"" отсутствует ставка НДС!'");
				ТекстСообщения = СтрШаблон(ТекстСообщения, Строка(Элт.Услуга));
				ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			КонецЦикла;
			Возврат;
		КонецЕсли;
		
		Попытка
			ПараметрыЗаписи = Новый Структура("РежимЗаписи", РежимЗаписиДокумента.Проведение);
			Записать(ПараметрыЗаписи);
			//ЗаписатьНаСервере(РежимЗаписиДокумента.Проведение);
			ОсновныеДействияФормыКассовыйОттиск();
		Исключение
			ТекстСообщения = НСтр("ru = 'Ошибка при записи: ""%1""'");
			ТекстСообщения = СтрШаблон(ТекстСообщения, ОписаниеОшибки()); 
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецПопытки;
		
	КонецЕсли;

	
	// Активировать кнопку "ручного" режима печати чека ККМ.
	Если Объект.ЧекПробитНаККМ Тогда
		Элементы.Чек.Доступность= Ложь;
		ЭтаФорма.ТолькоПросмотр	= Истина;
	Иначе
		ЭтаФорма.ТолькоПросмотр	= Ложь;
	КонецЕсли;

	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

#Область ПечатьЧека

// Процедура - обработчик событя "Нажатие" кнопки "КассовыйОттиск" командной панели "ОсновныеДействия".
//
// Параметры
//   Нет.
//
&НаКлиенте
Процедура ОсновныеДействияФормыКассовыйОттиск()
	
	ТаблицаУслуг = ?(Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Продажа")
					ИЛИ Объект.ВидОперации = ПредопределенноеЗначение("Перечисление.бит_ВидыОперацийЧекККМ.Возврат")
					, Объект.Услуги, Объект.БиллинговыеУслуги);
					
	Если Объект.ВводВручную Тогда
	
		КонтрольнаяСумма = Объект.СуммаОплаты;
		
		ИтогСумма	= ТаблицаУслуг.Итог("Сумма");
		ИтогПени	= ТаблицаУслуг.Итог("СуммаПени");
		Остаток		= КонтрольнаяСумма - ИтогСумма - ИтогПени;
		
		Если Остаток <> 0 Тогда
			ТекстСообщения = НСтр("ru = 'Распределите всю сумму оплаты по услугам.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
			
			Возврат;
		КонецЕсли; 
		
	КонецЕсли; 
	
	Если мКэшЗначений.мПечатьПДС <> 0 Тогда
		
		СписокУслуг = Новый СписокЗначений;
		Для каждого строка из ТаблицаУслуг Цикл
			СписокУслуг.Добавить(строка.Услуга,строка.Услуга);
		КонецЦикла;	
		
		ДополнитьТаблицуПолучателямиДС(СписокУслуг);
		
	КонецЕсли;
	
	НапечататьЧек();
	
КонецПроцедуры

&НаКлиенте
Функция ПроверитьВозможностьПечатиЧека(Форма)
	ПечататьЧек = Истина;
	
	// Если объект не проведен или модифицирован - сообщим пользователю, что печать не возможна.
	Если СтрНачинаетсяС(Форма.ИмяФормы, "Документ.")
		И (НЕ Форма.Объект.Проведен
		ИЛИ Форма.Модифицированность) Тогда
		
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю( , НСтр("ru = 'Операция возможна только после проведения документа'"));
		ПечататьЧек = Ложь;
		
	КонецЕсли;
	
	Возврат ПечататьЧек;
КонецФункции 

&НаКлиенте
Процедура НапечататьЧек()
	
	ОчиститьСообщения();
	
	Если ПроверитьВозможностьПечатиЧека(ЭтотОбъект) Тогда
		
		Если МенеджерОборудованияКлиент.ОбновитьРабочееМестоКлиента() Тогда
			
			ОписаниеОповещения = Новый ОписаниеОповещения("ВыборФискальногоУстройстваЗавершение", ЭтотОбъект);
			ПоддерживаемыеТипыВО = Новый Массив();
			ПоддерживаемыеТипыВО.Добавить("ФискальныйРегистратор");
			ПоддерживаемыеТипыВО.Добавить("ПринтерЧеков");
			ПоддерживаемыеТипыВО.Добавить("ККТ");
			МенеджерОборудованияКлиент.ПредложитьВыбратьУстройство(ОписаниеОповещения, ПоддерживаемыеТипыВО,
			НСтр("ru = 'Выберите фискальное устройство'"), НСтр("ru = 'Фискальное устройство не подключено.'"),,,,Объект.Касса);
			
		Иначе
			
			ТекстСообщения = НСтр("ru = 'Предварительно необходимо выбрать рабочее место внешнего оборудования текущего сеанса.'");
			ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		КонецЕсли;
		
	КонецЕсли;
	
	ОповеститьОбИзменении(Объект.Ссылка);

КонецПроцедуры

