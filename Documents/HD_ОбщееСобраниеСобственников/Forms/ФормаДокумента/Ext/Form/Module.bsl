//HD+
// Сопоставляет части шаблона с новым текстом
// Заполняет колонку "СопоставленныеСимволы" в частях шаблона
// Возвращает массив несопоставленных символов
//
&НаСервере
Функция СопоставитьЧастиШаблонаСНовымТекстом(ЧастиШаблона, ЧастиНовогоТекста)
	
	НесопоставленныеСимволы = Новый Массив;
	
	Если ЧастиНовогоТекста.Количество() = 0 Тогда
		Возврат НесопоставленныеСимволы;
	КонецЕсли;
	
	//HD+ Сохраняем позиции найденных неизменяемых частей в новом тексте
	// Ключ - индекс части в шаблоне, значение - индекс начала в новом тексте
	ПозицииНайденныхЧастей = Новый Соответствие;
	
	ИндексНовогоТекста = 0;
	
	// Проходим по частям шаблона последовательно
	Для ИндексШаблона = 0 По ЧастиШаблона.Количество() - 1 Цикл
		
		ЧастьШаблона = ЧастиШаблона[ИндексШаблона];
		ПорядковыйНомер = ЧастьШаблона.ПорядковыйНомер;
		ЦелаяЧастьНомера = Цел(ПорядковыйНомер);
		ЯвляетсяЦелым = (ПорядковыйНомер = ЦелаяЧастьНомера);
		
		Если ЯвляетсяЦелым Тогда
			//HD+ Это неизменяемая часть - ищем соответствие в новом тексте символ за символом
			ТекстШаблона = ЧастьШаблона.Текст;
			ДлинаТекстаШаблона = СтрДлина(ТекстШаблона);
			Найдено = Ложь;
			
			//HD+ Ищем последовательность символов из шаблона в новом тексте
			// Начинаем поиск с текущей позиции в новом тексте
			Для ИндексНачалаПоиска = ИндексНовогоТекста По ЧастиНовогоТекста.Количество() - ДлинаТекстаШаблона Цикл
				// Проверяем, совпадает ли последовательность символов
				Совпадает = Истина;
				Для ИндексСимвола = 0 По ДлинаТекстаШаблона - 1 Цикл
					Если ИндексНачалаПоиска + ИндексСимвола >= ЧастиНовогоТекста.Количество() Тогда
						Совпадает = Ложь;
						Прервать;
					КонецЕсли;
					СимволШаблона = Сред(ТекстШаблона, ИндексСимвола + 1, 1);
					СимволНовогоТекста = ЧастиНовогоТекста[ИндексНачалаПоиска + ИндексСимвола].Текст;
					Если СимволШаблона <> СимволНовогоТекста Тогда
						Совпадает = Ложь;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				Если Совпадает Тогда
					// Нашли совпадение - заполняем "СопоставленныеСимволы"
					ЧастьШаблона.СопоставленныеСимволы = ТекстШаблона;
					
					//HD+ Сохраняем позицию найденной части в новом тексте
					ПозицииНайденныхЧастей.Вставить(ИндексШаблона, ИндексНачалаПоиска);
					
					//HD+ Текст для подчеркиваний будет собран во втором проходе
					// Здесь только обновляем позицию в новом тексте
					
					ИндексНовогоТекста = ИндексНачалаПоиска + ДлинаТекстаШаблона;
					Найдено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			//HD+ Если не найдено, пропускаем измененные части до следующей найденной неизменяемой части
			// НЕ добавляем их в "НесопоставленныеСимволы" - они только для подчеркиваний
			// Если неизменяемая часть не найдена, "СопоставленныеСимволы" остается пустым,
			// и в результате будет использован текст из шаблона
			Если НЕ Найдено Тогда
				// Ищем следующую неизменяемую часть в шаблоне
				ИндексСледующейНеизменяемой = -1;
				Для ИндексСледующий = ИндексШаблона + 1 По ЧастиШаблона.Количество() - 1 Цикл
					СледующаяЧастьШаблона = ЧастиШаблона[ИндексСледующий];
					СледующийНомер = СледующаяЧастьШаблона.ПорядковыйНомер;
					СледующаяЦелаяЧасть = Цел(СледующийНомер);
					Если СледующийНомер = СледующаяЦелаяЧасть Тогда
						ИндексСледующейНеизменяемой = ИндексСледующий;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				// Если есть следующая неизменяемая часть, ищем её в новом тексте (ищем последовательность символов)
				Если ИндексСледующейНеизменяемой >= 0 Тогда
					СледующаяЧастьШаблона = ЧастиШаблона[ИндексСледующейНеизменяемой];
					ТекстСледующейЧасти = СледующаяЧастьШаблона.Текст;
					ДлинаСледующейЧасти = СтрДлина(ТекстСледующейЧасти);
					НайденаСледующая = Ложь;
					
					Для ИндексНачалаПоискаСледующей = ИндексНовогоТекста По ЧастиНовогоТекста.Количество() - ДлинаСледующейЧасти Цикл
						// Проверяем, совпадает ли последовательность символов
						СовпадаетСледующая = Истина;
						Для ИндексСимвола = 0 По ДлинаСледующейЧасти - 1 Цикл
							Если ИндексНачалаПоискаСледующей + ИндексСимвола >= ЧастиНовогоТекста.Количество() Тогда
								СовпадаетСледующая = Ложь;
								Прервать;
							КонецЕсли;
							СимволСледующей = Сред(ТекстСледующейЧасти, ИндексСимвола + 1, 1);
							СимволНовогоТекста = ЧастиНовогоТекста[ИндексНачалаПоискаСледующей + ИндексСимвола].Текст;
							Если СимволСледующей <> СимволНовогоТекста Тогда
								СовпадаетСледующая = Ложь;
								Прервать;
							КонецЕсли;
						КонецЦикла;
						
						Если СовпадаетСледующая Тогда
							// Нашли следующую неизменяемую часть - пропускаем все до неё
							// Текст между частями будет собран для подчеркиваний
							ИндексНовогоТекста = ИндексНачалаПоискаСледующей + ДлинаСледующейЧасти;
							НайденаСледующая = Истина;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
				// Если следующая неизменяемая часть не найдена, не увеличиваем индекс
			КонецЕсли;
		Иначе
			//HD+ Это подчеркивание - пропускаем на первом проходе
			// Текст для подчеркиваний будет собран на втором проходе
		КонецЕсли;
		
	КонецЦикла;
	
	//HD+ Второй проход - собираем текст для подчеркиваний между найденными неизменяемыми частями
	// Проходим по парам найденных неизменяемых частей и собираем текст между ними один раз
	Для ИндексПредыдущей = 0 По ЧастиШаблона.Количество() - 1 Цикл
		
		ПредыдущаяЧастьШаблона = ЧастиШаблона[ИндексПредыдущей];
		ПредыдущийНомер = ПредыдущаяЧастьШаблона.ПорядковыйНомер;
		ПредыдущаяЦелаяЧасть = Цел(ПредыдущийНомер);
		ПредыдущаяЯвляетсяЦелым = (ПредыдущийНомер = ПредыдущаяЦелаяЧасть);
		
		// Ищем только найденные неизменяемые части
		Если ПредыдущаяЯвляетсяЦелым И НЕ ПустаяСтрока(ПредыдущаяЧастьШаблона.СопоставленныеСимволы) Тогда
			
			// Ищем следующую найденную неизменяемую часть
			ИндексСледующейНайденной = -1;
			Для ИндексСледующий = ИндексПредыдущей + 1 По ЧастиШаблона.Количество() - 1 Цикл
				СледующаяЧастьШаблона = ЧастиШаблона[ИндексСледующий];
				СледующийНомер = СледующаяЧастьШаблона.ПорядковыйНомер;
				СледующаяЦелаяЧасть = Цел(СледующийНомер);
				Если СледующийНомер = СледующаяЦелаяЧасть И НЕ ПустаяСтрока(СледующаяЧастьШаблона.СопоставленныеСимволы) Тогда
					ИндексСледующейНайденной = ИндексСледующий;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Если есть следующая найденная неизменяемая часть, собираем текст между ними
			Если ИндексСледующейНайденной >= 0 Тогда
				//HD+ Используем сохраненные позиции из первого прохода
				ИндексПредыдущейВНовомТексте = ПозицииНайденныхЧастей.Получить(ИндексПредыдущей);
				ИндексСледующейВНовомТексте = ПозицииНайденныхЧастей.Получить(ИндексСледующейНайденной);
				
				Если ИндексПредыдущейВНовомТексте <> Неопределено И ИндексСледующейВНовомТексте <> Неопределено Тогда
					// Вычисляем конец предыдущей части и начало следующей
					ПредыдущаяТекстШаблона = ПредыдущаяЧастьШаблона.СопоставленныеСимволы;
					ДлинаПредыдущейТекста = СтрДлина(ПредыдущаяТекстШаблона);
					СледующаяТекстШаблона = ЧастиШаблона[ИндексСледующейНайденной].СопоставленныеСимволы;
					ДлинаСледующейТекста = СтрДлина(СледующаяТекстШаблона);
					
					// Индекс конца предыдущей части в новом тексте
					ИндексКонецПредыдущей = ИндексПредыдущейВНовомТексте + ДлинаПредыдущейТекста - 1;
					// Индекс начала следующей части в новом тексте
					ИндексНачалоСледующей = ИндексСледующейВНовомТексте;
					
					//HD+ Собираем текст между ними, но учитываем неизменяемые части шаблона между ними
					// которые не были найдены (они должны остаться из шаблона)
					Если ИндексНачалоСледующей > ИндексКонецПредыдущей Тогда
						// Находим все части шаблона между предыдущей и следующей найденной
						ИндексТекстаВНовом = ИндексКонецПредыдущей + 1;
						
						Для ИндексШаблонаМежду = ИндексПредыдущей + 1 По ИндексСледующейНайденной - 1 Цикл
							ЧастьШаблонаМежду = ЧастиШаблона[ИндексШаблонаМежду];
							ПорядковыйНомерМежду = ЧастьШаблонаМежду.ПорядковыйНомер;
							ЦелаяЧастьНомераМежду = Цел(ПорядковыйНомерМежду);
							ЯвляетсяЦелымМежду = (ПорядковыйНомерМежду = ЦелаяЧастьНомераМежду);
							
							Если ЯвляетсяЦелымМежду Тогда
								//HD+ Это неизменяемая часть, которая не была найдена
								// Пропускаем её в новом тексте (она останется из шаблона)
								// Но нужно проверить, есть ли она в новом тексте на текущей позиции
								ТекстЧастиМежду = ЧастьШаблонаМежду.Текст;
								ДлинаЧастиМежду = СтрДлина(ТекстЧастиМежду);
								
								// Проверяем, совпадает ли часть на текущей позиции
								Совпадает = Истина;
								Если ИндексТекстаВНовом + ДлинаЧастиМежду - 1 <= ИндексНачалоСледующей - 1 Тогда
									Для ИндексСимвола = 0 По ДлинаЧастиМежду - 1 Цикл
										Если ИндексТекстаВНовом + ИндексСимвола >= ЧастиНовогоТекста.Количество() Тогда
											Совпадает = Ложь;
											Прервать;
										КонецЕсли;
										СимволЧасти = Сред(ТекстЧастиМежду, ИндексСимвола + 1, 1);
										СимволНовогоТекста = ЧастиНовогоТекста[ИндексТекстаВНовом + ИндексСимвола].Текст;
										Если СимволЧасти <> СимволНовогоТекста Тогда
											Совпадает = Ложь;
											Прервать;
										КонецЕсли;
									КонецЦикла;
									
									Если Совпадает Тогда
										// Пропускаем эту часть в новом тексте
										ИндексТекстаВНовом = ИндексТекстаВНовом + ДлинаЧастиМежду;
									КонецЕсли;
								КонецЕсли;
							Иначе
								//HD+ Это подчеркивание — собираем для него весь текст между предыдущей и следующей неизменяемой частью
								// без ограничения длиной подчеркивания в шаблоне (сохраняем полный ввод пользователя)
								ТекстПодчеркивания = "";
								Для ИндексСбора = ИндексТекстаВНовом По ИндексНачалоСледующей - 1 Цикл
									Если ИндексСбора >= ЧастиНовогоТекста.Количество() Тогда
										Прервать;
									КонецЕсли;
									ТекстПодчеркивания = ТекстПодчеркивания + ЧастиНовогоТекста[ИндексСбора].Текст;
									ИндексТекстаВНовом = ИндексСбора + 1;
								КонецЦикла;
								
								//HD+ Заполняем "СопоставленныеСимволы" для этого подчеркивания напрямую
								// чтобы не добавлять в несопоставленные символы
								Если НЕ ПустаяСтрока(ТекстПодчеркивания) Тогда
									ЧастьШаблонаМежду.СопоставленныеСимволы = ТекстПодчеркивания;
								КонецЕсли;
							КонецЕсли;
						КонецЦикла;
					КонецЕсли;
				КонецЕсли;
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат НесопоставленныеСимволы;
	
КонецФункции //HD-

//HD+
// Находит текст для подчеркиваний из нового текста
// Возвращает соответствие: номер подчеркивания -> текст из нового текста
//
&НаСервере
Функция НайтиТекстПодчеркиваний(ЧастиНовогоТекста, ЧастиШаблона)
	
	ТекстПодчеркиванийПоНомеру = Новый Соответствие;
	
	Если ЧастиНовогоТекста.Количество() = 0 Тогда
		Возврат ТекстПодчеркиванийПоНомеру;
	КонецЕсли;
	
	ИндексНовогоТекста = 0;
	
	// Проходим по частям шаблона последовательно
	Для ИндексШаблона = 0 По ЧастиШаблона.Количество() - 1 Цикл
		
		ЧастьШаблона = ЧастиШаблона[ИндексШаблона];
		ПорядковыйНомерШаблона = ЧастьШаблона.ПорядковыйНомер;
		ЦелаяЧастьНомера = Цел(ПорядковыйНомерШаблона);
		ЯвляетсяЦелым = (ПорядковыйНомерШаблона = ЦелаяЧастьНомера);
		
		Если ЯвляетсяЦелым Тогда
			// Это неизменяемая часть - ищем её в новом тексте
			Найдено = Ложь;
			Для ИндексПоиска = ИндексНовогоТекста По ЧастиНовогоТекста.Количество() - 1 Цикл
				ЧастьНовогоТекста = ЧастиНовогоТекста[ИндексПоиска];
				Если ЧастьНовогоТекста.Текст = ЧастьШаблона.Текст Тогда
					// Нашли совпадающую часть - пропускаем её
					ИндексНовогоТекста = ИндексПоиска + 1;
					Найдено = Истина;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			//HD+ Если не нашли, значит часть была изменена - пропускаем измененные части
			// до следующей найденной неизменяемой части
			Если НЕ Найдено Тогда
				// Ищем следующую неизменяемую часть в шаблоне
				ИндексСледующейНеизменяемой = -1;
				Для ИндексСледующий = ИндексШаблона + 1 По ЧастиШаблона.Количество() - 1 Цикл
					СледующаяЧастьШаблона = ЧастиШаблона[ИндексСледующий];
					СледующийНомерШаблона = СледующаяЧастьШаблона.ПорядковыйНомер;
					СледующаяЦелаяЧасть = Цел(СледующийНомерШаблона);
					СледующаяЯвляетсяЦелым = (СледующийНомерШаблона = СледующаяЦелаяЧасть);
					Если СледующаяЯвляетсяЦелым Тогда
						ИндексСледующейНеизменяемой = ИндексСледующий;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				// Если есть следующая неизменяемая часть, ищем её в новом тексте
				Если ИндексСледующейНеизменяемой >= 0 Тогда
					СледующаяЧастьШаблона = ЧастиШаблона[ИндексСледующейНеизменяемой];
					Для ИндексПоиска = ИндексНовогоТекста По ЧастиНовогоТекста.Количество() - 1 Цикл
						ЧастьНовогоТекста = ЧастиНовогоТекста[ИндексПоиска];
						Если ЧастьНовогоТекста.Текст = СледующаяЧастьШаблона.Текст Тогда
							// Нашли следующую неизменяемую часть - пропускаем все до неё
							ИндексНовогоТекста = ИндексПоиска;
							Прервать;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			КонецЕсли;
		Иначе
			//HD+ Это подчеркивание в шаблоне - собираем текст из нового текста между двумя найденными неизменяемыми частями
			НомерПодчеркивания = ПорядковыйНомерШаблона;
			ТекстПодчеркивания = "";
			НачальныйИндекс = ИндексНовогоТекста;
			
			// Ищем следующую неизменяемую часть в шаблоне (пропуская подчеркивания)
			ИндексСледующейНеизменяемой = -1;
			Для ИндексСледующий = ИндексШаблона + 1 По ЧастиШаблона.Количество() - 1 Цикл
				СледующаяЧастьШаблона = ЧастиШаблона[ИндексСледующий];
				СледующийНомерШаблона = СледующаяЧастьШаблона.ПорядковыйНомер;
				СледующаяЦелаяЧасть = Цел(СледующийНомерШаблона);
				СледующаяЯвляетсяЦелым = (СледующийНомерШаблона = СледующаяЦелаяЧасть);
				Если СледующаяЯвляетсяЦелым Тогда
					ИндексСледующейНеизменяемой = ИндексСледующий;
					Прервать;
				КонецЕсли;
			КонецЦикла;
			
			// Собираем части нового текста до следующей найденной неизменяемой части
			Если ИндексСледующейНеизменяемой >= 0 Тогда
				СледующаяЧастьШаблона = ЧастиШаблона[ИндексСледующейНеизменяемой];
				// Ищем следующую неизменяемую часть в новом тексте
				НайденаСледующая = Ложь;
				Для ИндексПоиска = НачальныйИндекс По ЧастиНовогоТекста.Количество() - 1 Цикл
					ЧастьНовогоТекста = ЧастиНовогоТекста[ИндексПоиска];
					Если ЧастьНовогоТекста.Текст = СледующаяЧастьШаблона.Текст Тогда
						// Нашли следующую неизменяемую часть - собираем все до неё как подчеркивание
						Для ИндексСбора = НачальныйИндекс По ИндексПоиска - 1 Цикл
							ТекстПодчеркивания = ТекстПодчеркивания + ЧастиНовогоТекста[ИндексСбора].Текст;
						КонецЦикла;
						ИндексНовогоТекста = ИндексПоиска;
						НайденаСледующая = Истина;
						Прервать;
					КонецЕсли;
				КонецЦикла;
				
				//HD+ Если следующая неизменяемая часть не найдена, ищем следующую найденную
				Если НЕ НайденаСледующая Тогда
					// Ищем следующую неизменяемую часть после пропущенной, которая будет найдена
					Для ИндексСледующий = ИндексСледующейНеизменяемой + 1 По ЧастиШаблона.Количество() - 1 Цикл
						СледующаяЧастьШаблона = ЧастиШаблона[ИндексСледующий];
						СледующийНомерШаблона = СледующаяЧастьШаблона.ПорядковыйНомер;
						СледующаяЦелаяЧасть = Цел(СледующийНомерШаблона);
						СледующаяЯвляетсяЦелым = (СледующийНомерШаблона = СледующаяЦелаяЧасть);
						Если СледующаяЯвляетсяЦелым Тогда
							// Ищем эту часть в новом тексте
							Для ИндексПоиска = НачальныйИндекс По ЧастиНовогоТекста.Количество() - 1 Цикл
								ЧастьНовогоТекста = ЧастиНовогоТекста[ИндексПоиска];
								Если ЧастьНовогоТекста.Текст = СледующаяЧастьШаблона.Текст Тогда
									// Нашли - собираем все до неё
									Для ИндексСбора = НачальныйИндекс По ИндексПоиска - 1 Цикл
										ТекстПодчеркивания = ТекстПодчеркивания + ЧастиНовогоТекста[ИндексСбора].Текст;
									КонецЦикла;
									ИндексНовогоТекста = ИндексПоиска;
									НайденаСледующая = Истина;
									Прервать;
								КонецЕсли;
							КонецЦикла;
							Если НайденаСледующая Тогда
								Прервать;
							КонецЕсли;
						КонецЕсли;
					КонецЦикла;
				КонецЕсли;
			Иначе
				// Это последнее подчеркивание - собираем все оставшиеся части
				Для ИндексСбора = НачальныйИндекс По ЧастиНовогоТекста.Количество() - 1 Цикл
					ТекстПодчеркивания = ТекстПодчеркивания + ЧастиНовогоТекста[ИндексСбора].Текст;
				КонецЦикла;
				ИндексНовогоТекста = ЧастиНовогоТекста.Количество();
			КонецЕсли;
			
			//HD+ Сохраняем текст подчеркивания в соответствие
			Если ТекстПодчеркивания <> "" Тогда
				ТекстПодчеркиванийПоНомеру.Вставить(НомерПодчеркивания, ТекстПодчеркивания);
			КонецЕсли;
		КонецЕсли;
		
	КонецЦикла;
	
	Возврат ТекстПодчеркиванийПоНомеру;
	
КонецФункции //HD-

//HD+
// Извлекает части текста (обычный текст и подчеркивания) из строки
// Логика аналогична функции из бит_ФормаПечатиУправляемая
//
&НаСервере
Функция ИзвлечьЧастиТекста(Текст)
	
	Части = Новый Массив;
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат Части;
	КонецЕсли;
	
	НачалоПозиция = 1;
	ДлинаТекста = СтрДлина(Текст);
	// Счетчик целых номеров для неизменяемых частей (начинаем с 1)
	НомерНеизменяемойЧасти = 1;
	
	Пока НачалоПозиция <= ДлинаТекста Цикл
		
		// Ищем начало подчеркивания
		ПозицияПодчеркивания = СтрНайти(Текст, "_", НаправлениеПоиска.СНачала, НачалоПозиция);
		
		Если ПозицияПодчеркивания = 0 Тогда
			// Подчеркиваний больше нет — добавляем оставшийся текст одной неизменяемой частью (не посимвольно)
			ОставшийсяТекст = Сред(Текст, НачалоПозиция);
			Если НЕ ПустаяСтрока(ОставшийсяТекст) Тогда
				Часть = Новый Структура;
				Часть.Вставить("Текст", ОставшийсяТекст);
				Часть.Вставить("Подчеркивание", Ложь);
				Часть.Вставить("ПорядковыйНомер", НомерНеизменяемойЧасти);
				Части.Добавить(Часть);
				НомерНеизменяемойЧасти = НомерНеизменяемойЧасти + 1;
			КонецЕсли;
			Прервать;
		КонецЕсли;
		
		// Текст до подчеркивания — добавляем одной неизменяемой частью (не посимвольно),
		// чтобы при сопоставлении искалась целая строка и не терялся текст (напр. «Авиагородок»)
		Если ПозицияПодчеркивания > НачалоПозиция Тогда
			ТекстДоПодчеркивания = Сред(Текст, НачалоПозиция, ПозицияПодчеркивания - НачалоПозиция);
			Если НЕ ПустаяСтрока(ТекстДоПодчеркивания) Тогда
				Часть = Новый Структура;
				Часть.Вставить("Текст", ТекстДоПодчеркивания);
				Часть.Вставить("Подчеркивание", Ложь);
				Часть.Вставить("ПорядковыйНомер", НомерНеизменяемойЧасти);
				Части.Добавить(Часть);
				НомерНеизменяемойЧасти = НомерНеизменяемойЧасти + 1;
			КонецЕсли;
		КонецЕсли;
		
		// Находим конец подчеркивания
		КонецПодчеркивания = ПозицияПодчеркивания;
		Пока КонецПодчеркивания <= ДлинаТекста И Сред(Текст, КонецПодчеркивания, 1) = "_" Цикл
			КонецПодчеркивания = КонецПодчеркивания + 1;
		КонецЦикла;
		
		// Добавляем подчеркивание с дробным номером относительно предыдущей неизменяемой части
		// Номер подчеркивания = предыдущий_целый_номер + 0.1
		НомерПодчеркивания = (НомерНеизменяемойЧасти - 1) + 0.1;
		Часть = Новый Структура;
		Часть.Вставить("Текст", Сред(Текст, ПозицияПодчеркивания, КонецПодчеркивания - ПозицияПодчеркивания));
		Часть.Вставить("Подчеркивание", Истина);
		Часть.Вставить("ПорядковыйНомер", НомерПодчеркивания);
		Части.Добавить(Часть);
		
		НачалоПозиция = КонецПодчеркивания;
		
	КонецЦикла;
	
	Возврат Части;
	
КонецФункции //HD-

//HD+
// Разбивает текст на символы, добавляя каждую часть в массив с целым номером
// Возвращает новый номер неизменяемой части
//
&НаСервере
Функция РазбитьТекстНаСловаИПробелы(Текст, Части, НомерНеизменяемойЧасти)
	
	Если ПустаяСтрока(Текст) Тогда
		Возврат НомерНеизменяемойЧасти;
	КонецЕсли;
	
	ДлинаТекста = СтрДлина(Текст);
	
	//HD+ Разбиваем текст по символам (каждый символ - отдельная часть)
	Для Позиция = 1 По ДлинаТекста Цикл
		ТекущийСимвол = Сред(Текст, Позиция, 1);
		Часть = Новый Структура;
		Часть.Вставить("Текст", ТекущийСимвол);
		Часть.Вставить("Подчеркивание", Ложь);
		Часть.Вставить("ПорядковыйНомер", НомерНеизменяемойЧасти);
		Части.Добавить(Часть);
		НомерНеизменяемойЧасти = НомерНеизменяемойЧасти + 1;
	КонецЦикла;
	
	Возврат НомерНеизменяемойЧасти;
	
КонецФункции //HD-

//HD+
// Обработчик завершения выбора инициатора
//
&НаКлиенте
Процедура ИнициаторФИООбработкаВыбора(Результат, ДополнительныеПараметры) Экспорт
	
	Если Результат = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	ВыбранноеЗначение = Неопределено;
	Если ТипЗнч(Результат) = Тип("СправочникСсылка.бит_Проживающие") Тогда
		ВыбранноеЗначение = Результат;
	ИначеЕсли ТипЗнч(Результат) = Тип("Массив") Тогда
		Если Результат.Количество() > 0 Тогда
			ВыбранноеЗначение = Результат[0];
		КонецЕсли;
	КонецЕсли;
	
	Если ЗначениеЗаполнено(ВыбранноеЗначение) Тогда
		ИнициаторФИООбработкаВыбораНаСервере(ВыбранноеЗначение);
	КонецЕсли;
	
КонецПроцедуры //HD-

