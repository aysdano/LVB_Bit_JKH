// Процедура формирует отчет СведенияОПроживающих.
//
Процедура СформироватьСведенияОПроживающих(ДокументРезультат,мВидОтчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
	|	ПроживающиеПоЛССрезПоследних.ФизЛицо,
	|	ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание КАК Здание,
	|	ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира КАК Квартира,
	|	ПроживающиеПоЛССрезПоследних.ЛицевойСчет.УлицаЛицевогоСчета КАК Улица,
	|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица,
	|	ПроживающиеПоЛССрезПоследних.СтепеньРодства,
	|	ВЫБОР
	|		КОГДА ПроживающиеПоЛССрезПоследних.ВладелецКвартиры = ЗНАЧЕНИЕ(Перечисление.ДаНет.Да)
	|			ТОГДА 1
	|		ИНАЧЕ 0
	|	КОНЕЦ КАК ВладелецКвартиры,
	|	ПроживающиеПоЛССрезПоследних.СтатусПроживания,
	|	ЕСТЬNULL(ПроживающиеПоЛССрезПоследних.ДоляПлощади, 0) КАК ДоляПлощади
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&КонецПериода,
	|			ЛицевойСчет.Организация = &Организация
	|				И ЛицевойСчет.Здание.ТипУправляющейОрганизации = &ТипУО) КАК ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &КонецПериода
	|			ИЛИ ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|ИТОГИ
	|	МАКСИМУМ(Улица)
	|ПО
	|	Здание,
	|	ЛицевойСчет";
	
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(КонецПериода));
	Запрос.УстановитьПараметр("Организация" , Организация);
	Запрос.УстановитьПараметр("ТипУО"       , УправляющаяОрганизация);
	
	Макет = ПолучитьМакет("СведенияОПроживающих");
	
	Шапка    = Макет.ПолучитьОбласть("Шапка");
	Адрес    = Макет.ПолучитьОбласть("Адрес");
	СтрокаТЧ = Макет.ПолучитьОбласть("СтрокаТЧ");
	
	Шапка.Параметры.Период      = Строка(Формат(НачалоМесяца(КонецПериода), "ДЛФ=DD")) +" - "+ Строка(Формат(КонецМесяца(КонецПериода), "ДЛФ=DD"));
	Шапка.Параметры.Организация = Организация;
	Шапка.Параметры.ТипУО       = УправляющаяОрганизация;
	
	ДокументРезультат.Вывести(Шапка);
	
	
	ВыборкаЗдание = Запрос.Выполнить().Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	Пока ВыборкаЗдание.Следующий() Цикл
		
		Адрес.Параметры.Здание     = Строка(ВыборкаЗдание.Улица) + ", д." + Строка(ВыборкаЗдание.Здание);
		
		НомерПП = 0;
		ДокументРезультат.Вывести(Адрес);
		
		ВыборкаЛС = ВыборкаЗдание.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		Пока ВыборкаЛС.Следующий() Цикл
			
			НомерПП = НомерПП + 1;
			СтрокаТЧ.Параметры.НомерПП = НомерПП;
			
			НомерПроживающего = 0;
			
			Выборка = ВыборкаЛС.Выбрать();
			
			Пока Выборка.Следующий() Цикл
				
				НомерПроживающего = НомерПроживающего + 1;
				
				ЗаполнитьЗначенияСвойств(СтрокаТЧ.Параметры,Выборка);
				
				Площадь = ПолучитьОбщуюПлощадь(Выборка.Квартира);
				
				СтрокаТЧ.Параметры.НомерПроживающего = НомерПроживающего;
				СтрокаТЧ.Параметры.ДоляПлощади  = Площадь * Выборка.ДоляПлощади;
				
				ДокументРезультат.Вывести(СтрокаТЧ);
				
			КонецЦикла; 
		КонецЦикла; 
	КонецЦикла; 
	
КонецПроцедуры

// Процедура формирует отчет ОтчетОВыпадающихДоходах.
//
Процедура СформироватьОтчетОВыпадающихДоходах(ДокументРезультат,мВидОтчета)
	
	Запрос = Новый Запрос;
	Запрос.Текст =
	
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	|	бит_НачислениеПоЛьготамОбороты.Услуга,
	|	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	|	бит_НачислениеПоЛьготамОбороты.Льгота,
	|	бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу,
	|	бит_ЛьготыПоЛССрезПоследних.НомерДокумента,
	|	бит_ЛьготыПоЛССрезПоследних.ДатаВыдачи,
	|	бит_ЛьготыПоЛССрезПоследних.КемВыдан,
	|	МАКСИМУМ(бит_НачислениеПоЛьготамОбороты.СуммаОборот) КАК СуммаОборот,
	|	МАКСИМУМ(бит_НачислениеПоЛьготамОбороты.СуммаРазовыхОборот) КАК СуммаРазовыхОборот,
	|	МАКСИМУМ(бит_НачислениеПоЛьготамОбороты.СуммаСемейнойОборот) КАК СуммаСемейнойОборот,
	|	бит_НачислениеПоЛьготамОбороты.Услуга.ГрафаОтчетаГЦЖС КАК ГрафаОтчетаГЦЖС,
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.ОбщаяПлощадь) КАК ОбщаяПлощадь,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Здание КАК Здание,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Квартира КАК Квартира,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.УлицаЛицевогоСчета КАК Улица,
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.ЖилаяПлощадь) КАК ЖилаяПлощадь,
	|	МАКСИМУМ(бит_СведенияОКвартиреСрезПоследних.ОтапливаемаяПлощадь) КАК ОтапливаемаяПлощадь,
	|	МАКСИМУМ(бит_СведенияПоУслугамЛССрезПоследних.КоличествоЕдиницПотребления) КАК КоличествоЕдиницПотребления,
	|	СУММА(бит_КолЕдПоСчетчикамСрезПоследних.КоличествоЕдиницПоЛС) КАК КоличествоЕдиницПоЛС,
	|	бит_УстановкаЛьготСрезПоследних.Распространение
	|ПОМЕСТИТЬ СведенияОЛьготниках
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПоЛьготам.Обороты(&НачалоПериода, &КонецПериода, , ЛицевойСчет.Организация = &Организация) КАК бит_НачислениеПоЛьготамОбороты
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ЛьготыПоЛС.СрезПоследних(&КонецПериода, ЛицевойСчет.Организация = &Организация) КАК бит_ЛьготыПоЛССрезПоследних
	|		ПО бит_НачислениеПоЛьготамОбороты.ЛицевойСчет = бит_ЛьготыПоЛССрезПоследних.ЛицевойСчет
	|			И бит_НачислениеПоЛьготамОбороты.Льгота = бит_ЛьготыПоЛССрезПоследних.Льготы
	|			И бит_НачислениеПоЛьготамОбороты.ФизЛицо = бит_ЛьготыПоЛССрезПоследних.ФизЛицо
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних(&КонецПериода, ) КАК бит_СведенияОКвартиреСрезПоследних
	|		ПО бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияПоУслугамЛС.СрезПоследних(&КонецПериода, ЛицевойСчет.Организация = &Организация) КАК бит_СведенияПоУслугамЛССрезПоследних
	|		ПО бит_НачислениеПоЛьготамОбороты.ЛицевойСчет = бит_СведенияПоУслугамЛССрезПоследних.ЛицевойСчет
	|			И бит_НачислениеПоЛьготамОбороты.Услуга = бит_СведенияПоУслугамЛССрезПоследних.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_КолЕдПоСчетчикам.СрезПоследних(&КонецПериода, ) КАК бит_КолЕдПоСчетчикамСрезПоследних
	|		ПО бит_НачислениеПоЛьготамОбороты.ЛицевойСчет = бит_КолЕдПоСчетчикамСрезПоследних.ЛицевойСчет
	|			И бит_НачислениеПоЛьготамОбороты.Услуга = бит_КолЕдПоСчетчикамСрезПоследних.УслугаЖКХ
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_УстановкаЛьгот.СрезПоследних(&КонецПериода, ) КАК бит_УстановкаЛьготСрезПоследних
	|		ПО бит_НачислениеПоЛьготамОбороты.Услуга = бит_УстановкаЛьготСрезПоследних.Услуга
	|			И бит_НачислениеПоЛьготамОбороты.Льгота = бит_УстановкаЛьготСрезПоследних.Льгота
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СведенияОКвартиреСрезПоследних.ТипКвартиры,
	|	бит_СведенияОКвартиреСрезПоследних.СтатусКвартиры,
	|	бит_СведенияПоУслугамЛССрезПоследних.РежимПотребления,
	|	бит_СведенияПоУслугамЛССрезПоследних.СпособРасчета,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	|	бит_НачислениеПоЛьготамОбороты.Услуга,
	|	бит_НачислениеПоЛьготамОбороты.ФизЛицо,
	|	бит_НачислениеПоЛьготамОбороты.Льгота,
	|	бит_ЛьготыПоЛССрезПоследних.ДокументНаЛьготу,
	|	бит_ЛьготыПоЛССрезПоследних.НомерДокумента,
	|	бит_ЛьготыПоЛССрезПоследних.ДатаВыдачи,
	|	бит_ЛьготыПоЛССрезПоследних.КемВыдан,
	|	бит_НачислениеПоЛьготамОбороты.Услуга.ГрафаОтчетаГЦЖС,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Здание,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.Квартира,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет.УлицаЛицевогоСчета,
	|	бит_УстановкаЛьготСрезПоследних.Распространение
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ЛицевойСчет,
	|	КОЛИЧЕСТВО(РАЗЛИЧНЫЕ бит_ПроживающиеПоЛССрезПоследних.ФизЛицо) КАК КоличествоПроживающих
	|ПОМЕСТИТЬ ПроживающиеИмеющиеПравоНаЛьготы
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			&КонецПериода,
	|			ЛицевойСчет В
	|				(ВЫБРАТЬ
	|					Таб.ЛицевойСчет КАК ЛицевойСчет
	|				ИЗ
	|					СведенияОЛьготниках КАК Таб)) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	(бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации > &КонецПериода
	|			ИЛИ бит_ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации = ДАТАВРЕМЯ(1, 1, 1))
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.НачислятьПоНорме
	|	И бит_ПроживающиеПоЛССрезПоследних.СтатусФизЛица.ПравоНаЛьготы
