	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_ОбщаяПлощадьМестОбщегоПользования КАК вт_ОбщаяПлощадьМестОбщегоПользования
	               |		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание = вт_ОбщаяПлощадьМестОбщегоПользования.ОбъектУчета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_ОбщаяПлощадьПоПомещению КАК вт_ОбщаяПлощадьПоПомещению
	               |		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира = вт_ОбщаяПлощадьПоПомещению.Квартира
	               |		ЛЕВОЕ СОЕДИНЕНИЕ вт_ОбщаяПлощадьЖилогоЗдания КАК вт_ОбщаяПлощадьЖилогоЗдания
	               |		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание = вт_ОбщаяПлощадьЖилогоЗдания.ОбъектУчета
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.лб_Тест_Дома КАК лб_Тест_Дома
	               |		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание = лб_Тест_Дома.Здание
	               |		ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_Квартиры КАК бит_Квартиры
	               |		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира = бит_Квартиры.Ссылка
	               |		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_СведенияОКвартире.СрезПоследних КАК бит_СведенияОКвартиреСрезПоследних
	               |		ПО ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Квартира = бит_СведенияОКвартиреСрезПоследних.Квартира
	               |		ЛЕВОЕ СОЕДИНЕНИЕ ВТ_КоличествоЛицевыхПоРазделенным КАК ВТ_КоличествоЛицевыхПоРазделенным
	               |		ПО (бит_СведенияОКвартиреСрезПоследних.лб_ПредставлениеКвартиры = ВТ_КоличествоЛицевыхПоРазделенным.КвартираНомерКвартиры)
	               |			И ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание = ВТ_КоличествоЛицевыхПоРазделенным.Здание
	               |ГДЕ
	               |	1 = 1" + ЗапросУчастки + ЗапросПоставщикТеплоснабжения + ЗапросПоставщикГазоснабжения + ЗапросГрузитьТолькоИзменения +  
	"";
	
	Если Не МассивАдресов.Количество() = 0 Тогда
		Запрос.Текст = СтрЗаменить(Запрос.Текст, "1 = 1", "ПроживающиеПоЛССрезПоследних.ЛицевойСчет.Здание В (&Адреса)");	
		Запрос.УстановитьПараметр("Адреса", МассивАдресов);	
	КонецЕсли; 
	
	ВыборкаДетальныеЗаписи = Запрос.Выполнить().Выбрать();
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		НоваяСтрокаИтоговойТаблицы = ТаблицаИтог.Добавить();
		ЗаполнитьЗначенияСвойств(НоваяСтрокаИтоговойТаблицы, ВыборкаДетальныеЗаписи);
		
		НоваяСтрокаИтоговойТаблицы.DROG = "" + Формат(ВыборкаДетальныеЗаписи.ДатаРождения, "ДФ=гггг") +  Формат(ВыборкаДетальныеЗаписи.ДатаРождения, "ДФ=ММ") + Формат(ВыборкаДетальныеЗаписи.ДатаРождения, "ДФ=дд");
		НоваяСтрокаИтоговойТаблицы.IN_DATE = "" + Формат(ВыборкаДетальныеЗаписи.IN_DATE, "ДФ=гггг") +  Формат(ВыборкаДетальныеЗаписи.IN_DATE, "ДФ=ММ") + Формат(ВыборкаДетальныеЗаписи.IN_DATE, "ДФ=дд");
		OUT_DATE = СтрокаВДату(ВыборкаДетальныеЗаписи.OUT_DATE);
		НоваяСтрокаИтоговойТаблицы.OUT_DATE = "" + Формат(OUT_DATE, "ДФ=гггг") +  Формат(OUT_DATE, "ДФ=ММ") + Формат(OUT_DATE, "ДФ=дд");
		
		НоваяСтрокаИтоговойТаблицы.IND = Лев(ВыборкаДетальныеЗаписи.ЛицевойСчет,  4);
		НоваяСтрокаИтоговойТаблицы.LIC = Прав(ВыборкаДетальныеЗаписи.ЛицевойСчет, 7);
		
		Если ЗначениеЗаполнено(ВыборкаДетальныеЗаписи.D_DOK) Тогда
			НоваяСтрокаИтоговойТаблицы.D_DOK = Формат(ВыборкаДетальныеЗаписи.D_DOK, "ДЛФ=Д");	
		КонецЕсли; 
		
		Попытка
			ФамилияИмяОтчество = ЧастиИмени(ВыборкаДетальныеЗаписи.ФИО.Наименование);
			
			НоваяСтрокаИтоговойТаблицы.FAMIL = ФамилияИмяОтчество.Фамилия;
			НоваяСтрокаИтоговойТаблицы.IMJA = ФамилияИмяОтчество.Имя;
			НоваяСтрокаИтоговойТаблицы.OTCH = ФамилияИмяОтчество.Отчество;
			
		Исключение
			ФИО = "";
		КонецПопытки;
		
		//НоваяСтрокаИтоговойТаблицы.ROPL = ВыборкаДетальныеЗаписи.ROPL;
		НоваяСтрокаИтоговойТаблицы.ROPL = ВыборкаДетальныеЗаписи.Пл_МОП_1;
		
		НоваяСтрокаИтоговойТаблицы.NKW = "" + ВыборкаДетальныеЗаписи.NKW + ВыборкаДетальныеЗаписи.LKW; 		
		НоваяСтрокаИтоговойТаблицы.LKW = "";
		
		ПравоустанавливающиеДокументы = ПолучитьПравоустанавливающиеДокументы(ВыборкаДетальныеЗаписи.ФИО, ВыборкаДетальныеЗаписи.ЛицевойСчет);
		НоваяСтрокаИтоговойТаблицы.ДокументыНаКвартиру = ПравоустанавливающиеДокументы;
		
		//НоваяСтрокаИтоговойТаблицы.KSOB = МассивСобственников(ВыборкаДетальныеЗаписи.ЛицевойСчет);
		
		Если ВыборкаДетальныеЗаписи.KSS = Справочники.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо Тогда
			НоваяСтрокаИтоговойТаблицы.OKS = "1";
		Иначе 
			НоваяСтрокаИтоговойТаблицы.OKS = "0";
		КонецЕсли; 
		
		Если ПроверитьСобственника(ВыборкаДетальныеЗаписи.ФИО, ВыборкаДетальныеЗаписи.ЛицевойСчет) Тогда
			НоваяСтрокаИтоговойТаблицы.KSOB = МассивСобственников(ВыборкаДетальныеЗаписи.ЛицевойСчет);	
		Иначе
			НоваяСтрокаИтоговойТаблицы.KSOB = "";
		КонецЕсли; 
		
		//НоваяСтрокаИтоговойТаблицы.KSS = "";
		Если ПроверитьСобственника(ВыборкаДетальныеЗаписи.ФИО, ВыборкаДетальныеЗаписи.ЛицевойСчет) Тогда
			ДоляПроживающего = ПолучитьДолюПроживающего(ВыборкаДетальныеЗаписи.ФИО, ВыборкаДетальныеЗаписи.ЛицевойСчет);		
			Если НоваяСтрокаИтоговойТаблицы.OKS = "1" Тогда
				Если ДоляПроживающего = 1 Тогда
					НоваяСтрокаИтоговойТаблицы.KSS = "" + "собственник";
				ИначеЕсли ДоляПроживающего > 0 Тогда 
					ДоляПроживающегоЛитера = ПолучитьДолюПроживающегоЛитера(ВыборкаДетальныеЗаписи.ФИО, ВыборкаДетальныеЗаписи.ЛицевойСчет);
					Если СтрНайти(ДоляПроживающегоЛитера, "с") > 0 ИЛИ Найти(ДоляПроживающегоЛитера, "0") > 0 Тогда
						ДоляПроживающегоЛитера_Вывод = СтрЗаменить(ДоляПроживающегоЛитера, "о", "");
						ДоляПроживающегоЛитера_Вывод = СтрЗаменить(ДоляПроживающегоЛитера, "с", "");
						
						НоваяСтрокаИтоговойТаблицы.KSS = "" + "совм.собс-ть " + ДоляПроживающегоЛитера_Вывод;
					Иначе						
						ДоляПроживающегоЛитера_Вывод = СтрЗаменить(ДоляПроживающегоЛитера, "о", "");
						ДоляПроживающегоЛитера_Вывод = СтрЗаменить(ДоляПроживающегоЛитера, "с", "");
						
						НоваяСтрокаИтоговойТаблицы.KSS = "" + ДоляПроживающегоЛитера_Вывод;
					КонецЕсли; 	
				Иначе				
				КонецЕсли; 
			Иначе
				Если ДоляПроживающего = 1 Тогда
					НоваяСтрокаИтоговойТаблицы.KSS = "" + "собственник " +  "-" + ВыборкаДетальныеЗаписи.KSS;
				ИначеЕсли ДоляПроживающего > 0 Тогда 
					ДоляПроживающегоЛитера = ПолучитьДолюПроживающегоЛитера(ВыборкаДетальныеЗаписи.ФИО, ВыборкаДетальныеЗаписи.ЛицевойСчет);
					Если СтрНайти(ДоляПроживающегоЛитера, "с") > 0 ИЛИ Найти(ДоляПроживающегоЛитера, "0") > 0 Тогда
						
						ДоляПроживающегоЛитера_Вывод = СтрЗаменить(ДоляПроживающегоЛитера, "о", "");
						ДоляПроживающегоЛитера_Вывод = СтрЗаменить(ДоляПроживающегоЛитера, "с", "");
						
						НоваяСтрокаИтоговойТаблицы.KSS = "" + "совм.собс-ть " + ДоляПроживающегоЛитера_Вывод+  "-" + ВыборкаДетальныеЗаписи.KSS;
					Иначе
						ДоляПроживающегоЛитера_Вывод = СтрЗаменить(ДоляПроживающегоЛитера, "о", "");
						ДоляПроживающегоЛитера_Вывод = СтрЗаменить(ДоляПроживающегоЛитера, "с", "");
						
						НоваяСтрокаИтоговойТаблицы.KSS = "" + "собственник " + ДоляПроживающегоЛитера_Вывод + "-" + ВыборкаДетальныеЗаписи.KSS;
					КонецЕсли; 
				Иначе
				КонецЕсли; 
			КонецЕсли; 	
		КонецЕсли; 
		
		//Проверим паспортные данные 
		Если НЕ ЗначениеЗаполнено(НоваяСтрокаИтоговойТаблицы.V_DOK) ИЛИ НЕ ЗначениеЗаполнено(НоваяСтрокаИтоговойТаблицы.S_DOK) Тогда
			
			ПолучитьПаспортныеДанные(ВыборкаДетальныеЗаписи.ФИО, НоваяСтрокаИтоговойТаблицы);
			
			Если ЗначениеЗаполнено(НоваяСтрокаИтоговойТаблицы.D_DOK) Тогда
				НоваяСтрокаИтоговойТаблицы.D_DOK = Формат(НоваяСтрокаИтоговойТаблицы.D_DOK, "ДЛФ=Д");	
			КонецЕсли;
			
		КонецЕсли; 
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Процедура ПолучитьПаспортныеДанные(ФизЛицо, НоваяСтрокаИтоговойТаблицы)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	//Параметр "ДокументВид" (Список значений)
	Параметр = Новый СписокЗначений;
	Параметр.Добавить(Справочники.бит_ДокументыУдостоверяющиеЛичность.ИМНС21);
	Параметр.Добавить(Справочники.бит_ДокументыУдостоверяющиеЛичность.ПолучитьСсылку(Новый УникальныйИдентификатор("d0e846ea-daa6-11e9-ba98-ac1f6b0f1d47")));// Паспорт РФ (Справочник.бит_ДокументыУдостоверяющиеЛичность)
	Запрос.УстановитьПараметр("ДокументВид", Параметр);
	
	Запрос.Текст = "ВЫБРАТЬ ПЕРВЫЕ 1
	|	бит_ПаспортныеДанныеПроживающих.Период КАК Период,
	|	бит_ПаспортныеДанныеПроживающих.ФизЛицо КАК ФизЛицо,
	|	бит_ПаспортныеДанныеПроживающих.ДокументВид КАК V_DOK,
	|	бит_ПаспортныеДанныеПроживающих.ДокументСерия КАК S_DOK,
	|	бит_ПаспортныеДанныеПроживающих.ДокументНомер КАК N_DOK,
	|	бит_ПаспортныеДанныеПроживающих.ДокументДатаВыдачи КАК D_DOK,
	|	бит_ПаспортныеДанныеПроживающих.ДокументКемВыдан КАК KEM_V,
	|	бит_ПаспортныеДанныеПроживающих.ДокументКодПодразделения КАК ДокументКодПодразделения,
	|	бит_ПаспортныеДанныеПроживающих.ДатаРегистрацииПоМестуЖительства КАК ДатаРегистрацииПоМестуЖительства,
	|	бит_ПаспортныеДанныеПроживающих.ДокументПричинаЗамены КАК ДокументПричинаЗамены
	|ИЗ
	|	РегистрСведений.бит_ПаспортныеДанныеПроживающих КАК бит_ПаспортныеДанныеПроживающих
	|ГДЕ
	|	бит_ПаспортныеДанныеПроживающих.ФизЛицо = &ФизЛицо
	|	И бит_ПаспортныеДанныеПроживающих.ДокументВид В (&ДокументВид)
	|
	|УПОРЯДОЧИТЬ ПО
	|	Период УБЫВ";
	
	Выборка = Запрос.Выполнить().Выбрать();
	
	Пока Выборка.Следующий() Цикл
		ЗаполнитьЗначенияСвойств(НоваяСтрокаИтоговойТаблицы, Выборка);	
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция ПолучитьДолюПроживающегоЛитера(ФизЛицо, ЛицевойСчет)
	
	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ФизЛицо", ФизЛицо);
	Запрос.УстановитьПараметр("ЛС", ЛицевойСчет); 
	
	Запрос.Текст = "ВЫБРАТЬ
	|	бит_ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади КАК ДоляПлощади,
	|	бит_ПроживающиеПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК лб_ДоляПлощадиСтрокой
	|ИЗ
	|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
	|			,
	|			ЛицевойСчет = &ЛС                 И
	|			ФизЛицо = &ФизЛицо) КАК бит_ПроживающиеПоЛССрезПоследних
	|ГДЕ
	|	бит_ПроживающиеПоЛССрезПоследних.ДоляПлощади > 0";
	
	Выборка = Запрос.Выполнить().Выбрать();
	Если Выборка.Количество() > 0 Тогда
		Выборка.Следующий();
		Возврат Выборка.лб_ДоляПлощадиСтрокой;
	Иначе
		Возврат 0;
	КонецЕсли; 
	
КонецФункции

