	|			Объект В (&СписокЛС)
	|				И ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
	|				И ВЫБОР
	|					КОГДА &ЕстьОтборУслуг
	|						ТОГДА Услуга В (&СписокУС)
	|					ИНАЧЕ ИСТИНА
	|				КОНЕЦ) КАК бит_СчетчикиНаУслугахСрезПоследних
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ПоказанияСчетчиков.Остатки(
	|				&КонецПериода,
	|				Объект В (&СписокЛС)
	|					И Счетчик.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный)
	|					И ВЫБОР
	|						КОГДА &ЕстьОтборУслуг
	|							ТОГДА Услуга В (&СписокУС)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ) КАК бит_ПоказанияСчетчиковОстатки
	|		ПО (бит_ПоказанияСчетчиковОстатки.Объект = бит_СчетчикиНаУслугахСрезПоследних.Объект)
	|			И (бит_ПоказанияСчетчиковОстатки.Услуга = бит_СчетчикиНаУслугахСрезПоследних.Услуга)
	|			И (бит_ПоказанияСчетчиковОстатки.Счетчик = бит_СчетчикиНаУслугахСрезПоследних.Счетчик)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_ПоверкаСчетчиков.СрезПоследних(&КонецПериода, ) КАК бит_ПоверкаСчетчиковСрезПоследних
	|		ПО (бит_ПоверкаСчетчиковСрезПоследних.Счетчик = бит_СчетчикиНаУслугахСрезПоследних.Счетчик)
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_КолЕдиницПоСчетчикам.Обороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				,
	|				ЛицевойСчет В (&СписокЛС)
	|					И ВЫБОР
	|						КОГДА &ЕстьОтборУслуг
	|							ТОГДА УслугаЖКХ В (&СписокУС)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ) КАК бит_КолЕдиницПоСчетчикамОбороты
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Объект = бит_КолЕдиницПоСчетчикамОбороты.ЛицевойСчет
	|			И бит_СчетчикиНаУслугахСрезПоследних.Услуга = бит_КолЕдиницПоСчетчикамОбороты.УслугаЖКХ
	|			И бит_СчетчикиНаУслугахСрезПоследних.Счетчик = бит_КолЕдиницПоСчетчикамОбороты.Счетчик
	|		ЛЕВОЕ СОЕДИНЕНИЕ СведенияПоЛС КАК СведенияПоЛС
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НормыНаУслуги.СрезПоследних(
	|					&КонецПериода,
	|					ВЫБОР
	|						КОГДА &ЕстьОтборУслуг
	|							ТОГДА Услуга В (&СписокУС)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ) КАК бит_НормыНаУслугиИнд
	|			ПО СведенияПоЛС.Услуга = бит_НормыНаУслугиИнд.Услуга
	|				И СведенияПоЛС.СпособРасчета = бит_НормыНаУслугиИнд.СпособРасчетаПоУслуге
	|				И СведенияПоЛС.РежимПотребления = бит_НормыНаУслугиИнд.РежимПотребления
	|				И СведенияПоЛС.СтатусКвартиры = бит_НормыНаУслугиИнд.СтатусКвартиры
	|				И СведенияПоЛС.ТипКвартиры = бит_НормыНаУслугиИнд.ТипКвартиры
	|			ЛЕВОЕ СОЕДИНЕНИЕ РегистрСведений.бит_НормыНаУслуги.СрезПоследних(
	|					&КонецПериода,
	|					ТипКвартиры = ЗНАЧЕНИЕ(Справочник.бит_ТипыКвартиры.Отдельная)
	|						И СтатусКвартиры = ЗНАЧЕНИЕ(Справочник.бит_СтатусыКвартиры.Приватизированная)
	|						И СпособРасчетаПоУслуге = ЗНАЧЕНИЕ(Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам)
	|						И ВЫБОР
	|							КОГДА &ЕстьОтборУслуг
	|								ТОГДА Услуга В (&СписокУС)
	|							ИНАЧЕ ИСТИНА
	|						КОНЕЦ) КАК бит_НормыНаУслугиОбщДом
	|			ПО СведенияПоЛС.Услуга = бит_НормыНаУслугиОбщДом.Услуга
	|				И СведенияПоЛС.РежимПотребления = бит_НормыНаУслугиОбщДом.РежимПотребления
	|			ЛЕВОЕ СОЕДИНЕНИЕ Справочник.бит_УслугиЖКХ.СпособыРасчета КАК бит_УслугиЖКХСпособыРасчета
	|			ПО СведенияПоЛС.Услуга = бит_УслугиЖКХСпособыРасчета.Ссылка
	|				И СведенияПоЛС.СпособРасчета = бит_УслугиЖКХСпособыРасчета.СпособРасчета
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Объект = СведенияПоЛС.ЛицевойСчет
	|			И бит_СчетчикиНаУслугахСрезПоследних.Услуга = СведенияПоЛС.Услуга
	|		ЛЕВОЕ СОЕДИНЕНИЕ ОбъемПоЗданиям КАК ОбъемПоЗданиям
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Услуга = ОбъемПоЗданиям.Услуга
	|			И бит_СчетчикиНаУслугахСрезПоследних.Объект.Здание = ОбъемПоЗданиям.Здание
	|		ЛЕВОЕ СОЕДИНЕНИЕ РегистрНакопления.бит_ОбъемыПоУслугамЖКХ.Обороты(
	|				&НачалоПериода,
	|				&КонецПериода,
	|				,
	|				ЛицевойСчет В (&СписокЛС)
	|					И ВЫБОР
	|						КОГДА &ЕстьОтборУслуг
	|							ТОГДА Услуга В (&СписокУС)
	|						ИНАЧЕ ИСТИНА
	|					КОНЕЦ) КАК бит_ОбъемыПоУслугамЖКХОбороты
	|		ПО бит_СчетчикиНаУслугахСрезПоследних.Объект = бит_ОбъемыПоУслугамЖКХОбороты.ЛицевойСчет
	|			И бит_СчетчикиНаУслугахСрезПоследних.Услуга = бит_ОбъемыПоУслугамЖКХОбороты.Услуга
	|			И бит_СчетчикиНаУслугахСрезПоследних.Счетчик = бит_ОбъемыПоУслугамЖКХОбороты.Счетчик
	|ГДЕ
	|	бит_СчетчикиНаУслугахСрезПоследних.ТипСчетчика = ЗНАЧЕНИЕ(Перечисление.бит_ТипСчетчика.Индивидуальный) И
	|   бит_СчетчикиНаУслугахСрезПоследних.Использовать = ИСТИНА
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_СчетчикиНаУслугахСрезПоследних.Объект,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга,
	|	ЕСТЬNULL(бит_УслугиЖКХСпособыРасчета.ЕдИзм, ЗНАЧЕНИЕ(Справочник.КлассификаторЕдиницИзмерения.ПустаяССылка)),
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик,
	|	бит_СчетчикиНаУслугахСрезПоследних.Многотарифный,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга.Приоритет,
	|	бит_СчетчикиНаУслугахСрезПоследних.Объект.Наименование,
	|	бит_СчетчикиНаУслугахСрезПоследних.Счетчик.Разрядность,
	|	бит_ПоверкаСчетчиковСрезПоследних.ДатаПоверки,
	|	бит_СчетчикиНаУслугахСрезПоследних.Услуга.НаименованиеСокращенное,
	|	ВЫРАЗИТЬ(бит_СчетчикиНаУслугахСрезПоследних.Услуга.НаименованиеПолное КАК СТРОКА(150))
	|
	|УПОРЯДОЧИТЬ ПО
	|	Наименование,
	|	Многотарифный,
	|	Приоритет
	|ИТОГИ
	|	МАКСИМУМ(ДоПоказаний),
	|	МАКСИМУМ(Многотарифный),
	|	МАКСИМУМ(КоличествоЕдиниц),
	|	МАКСИМУМ(НормативИнд),
	|	МАКСИМУМ(НормативОбщДом),
	|	МАКСИМУМ(ОбъемОбщДом),
	|	МАКСИМУМ(ДоПоказанийИнд),
	|	МАКСИМУМ(ДоПоказанийОбщДом),
	|	МАКСИМУМ(ОбъемИнд)
	|ПО
	|	ЛицевойСчет,
	|	Счетчик
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	ВТ_Перерасчеты.Регистратор КАК Регистратор,
	|	ВТ_Перерасчеты.ЛицевойСчет КАК ЛицевойСчет,
	|	ВТ_Перерасчеты.Сумма КАК Сумма,
	|	ВТ_Перерасчеты.Основание КАК Основание,
	|	ВТ_Перерасчеты.Комментарий КАК Комментарий,
	|	ВТ_Перерасчеты.Услуга КАК Услуга,
	|	ВТ_Перерасчеты.Приоритет КАК Приоритет,
	|	СведенияПоЛС.Поставщик КАК Поставщик
	|ИЗ
	|	ВТ_Перерасчеты КАК ВТ_Перерасчеты
	|		ЛЕВОЕ СОЕДИНЕНИЕ СведенияПоЛС КАК СведенияПоЛС
	|		ПО (СведенияПоЛС.ЛицевойСчет = ВТ_Перерасчеты.ЛицевойСчет)
	|			И (СведенияПоЛС.Услуга = ВТ_Перерасчеты.Услуга)
	|ИТОГИ ПО
	|	ЛицевойСчет
	|;
	|
	|////////////////////////////////////////////////////////////////////////////////
	|ВЫБРАТЬ РАЗРЕШЕННЫЕ
	|	бит_НачислениеПоЛьготамОбороты.Льгота.Наименование КАК Льгота,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет КАК ЛицевойСчет
	|ИЗ
	|	РегистрНакопления.бит_НачислениеПоЛьготам.Обороты(&НачалоПериода, &КонецПериода, , ЛицевойСчет В (&СписокЛС)) КАК бит_НачислениеПоЛьготамОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачислениеПоЛьготамОбороты.Льгота,
	|	бит_НачислениеПоЛьготамОбороты.ЛицевойСчет,
	|	бит_НачислениеПоЛьготамОбороты.Льгота.Наименование";
	
	РезультатЗапроса = Запрос.ВыполнитьПакет();
	
	ТаблицаЛьгот = РезультатЗапроса[3].Выгрузить();
	
	ВыборкаЛС = РезультатЗапроса[0].Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		Район    = ВыборкаЛС.Район;
		Улица    = ВыборкаЛС.Улица;
		Здание   = ВыборкаЛС.Здание;
		Корпус   = ВыборкаЛС.Корпус;
		Квартира = ВыборкаЛС.Квартира;
		
		Если ИспользоватьНастройкиПечатиАдреса Тогда
			
			НеПечататьРайон    = НеПечататьРайон;
			НеПечататьУлицу    = НеПечататьУлицу;
			НеПечататьДом      = НеПечататьДом;
			НеПечататьКорпус   = НеПечататьКорпус;
			НеПечататьКвартиру = НеПечататьКвартиру;
			
			ПрефиксРайон    = ПрефиксРайон;
			ПрефиксУлица    = ПрефиксУлица;
			ПрефиксДом      = ПрефиксДом;
			ПрефиксКорпус   = ПрефиксКорпус;
			ПрефиксКвартира = ПрефиксКвартира;
			
		Иначе
			
			НеПечататьРайон    = мКэшПараметрыЖКХ.НеПечататьРайон;
			НеПечататьУлицу    = мКэшПараметрыЖКХ.НеПечататьУлица;
			НеПечататьДом      = мКэшПараметрыЖКХ.НеПечататьДом;                 
			НеПечататьКорпус   = мКэшПараметрыЖКХ.НеПечататьКорпус;
			НеПечататьКвартиру = мКэшПараметрыЖКХ.НеПечататьКвартира;
			
			ПрефиксРайон    = мКэшПараметрыЖКХ.ПрефиксРайон;
			ПрефиксУлица    = мКэшПараметрыЖКХ.ПрефиксУлица;
			ПрефиксДом      = мКэшПараметрыЖКХ.ПрефиксДом;
			ПрефиксКорпус   = мКэшПараметрыЖКХ.ПрефиксКорпус;
			ПрефиксКвартира = мКэшПараметрыЖКХ.ПрефиксКвартира;
			
		КонецЕсли;
		
		Если ЭтотОбъект.БезПрефиксаНежилогоПомещения И
			ВыборкаЛС.ТипКвартиры = Справочники.бит_ТипыКвартиры.НежилоеПомещение Тогда
			ПрефиксКвартира = "";
		КонецЕсли;
		
		СтрРайон    = ?(НеПечататьРайон   , "", ""+ ПрефиксРайон +" "+ СокрЛП(Строка(Район)) + ",");
		СтрУлица    = ?(НеПечататьУлицу   , "", ""+ ПрефиксУлица +" "+ СокрЛП(Строка(Улица)) + ",");
		СтрДом      = ?(НеПечататьДом     , "", " " + ПрефиксДом +" "+ СокрЛП(Строка(Здание))+",") ;
		СтрКорпус   = ?(НеПечататьКорпус  , "", ?(ЗначениеЗаполнено(Корпус)," "+ПрефиксКорпус+ " " +СокрЛП(Строка(Корпус)) + ",",""));
		СтрКвартира = ?(НеПечататьКвартиру, "", " " + ПрефиксКвартира +" "+ СокрЛП(Строка(Квартира)));
		
		Адрес = "" + СтрРайон + СтрУлица + СтрДом + СтрКорпус + СтрКвартира;
		
		СложнаяЛьгота = Ложь;
		ОписаниеЛьгот = "";
		
		Отбор = Новый Структура;
		Отбор.Вставить("ЛицевойСчет", ВыборкаЛС.ЛицевойСчет);
		ПоискЛьготы = ТаблицаЛьгот.НайтиСтроки(Отбор);
		
		СложнаяЛьгота = ПоискЛьготы.Количество() > 1;
		
		Для каждого СтрокаЛьготы Из ПоискЛьготы Цикл
			ОписаниеЛьгот = ОписаниеЛьгот + "" + ?(ОписаниеЛьгот = "","",", ") + СокрЛП(СтрокаЛьготы.Льгота);
		КонецЦикла; 
		
		СтруктураДанных = ПолучитьСтруктуруДанных();
		ЗаполнитьСтруктураДанных(СтруктураДанных);
		
		#Если НЕ ВнешнееСоединение Тогда
			// Заполнение таблицы значений свойств.
			ЗначенияСвойств = ЗаполнитьТаблицуЗначенийСвойств(ВыборкаЛС.ЛицевойСчет);
		#Иначе
			ЗначенияСвойств = Новый ТаблицаЗначений;
		#КонецЕсли
		
		ПолучательПредставление = ?(мНастройкиМакета.ИспользоватьСокращенноеНаименованиеОрганизации,
		мКэшОрганизации.НаименованиеСокращенное,
		мКэшОрганизации.НаименованиеПолное);
		
		СтруктураДанных.ПолучательПредставление		= ПолучательПредставление;
		СтруктураДанных.ГруппироватьУслуги			= ВыборкаЛС.ГруппироватьУслуги;
		СтруктураДанных.ПечатьЗависимыхЛС			= ВыборкаЛС.ПечатьЗависимыхЛС;
		СтруктураДанных.ЛицевойСчетФио				= ВыборкаЛС.ОтветсвенноеЛицо;
		СтруктураДанных.ЛицевойСчетНомер			= ВыборкаЛС.Наименование;
		СтруктураДанных.ЛицевойСчетАдрес			= Адрес;
		СтруктураДанных.КоличествоПроживающих		= ВыборкаЛС.КоличествоПроживающих;
		СтруктураДанных.КоличествоЗарегистрированных= ВыборкаЛС.КоличествоЗарегистрированных;
		СтруктураДанных.ОписаниеОбщейПлощади		= ВыборкаЛС.ОбщаяПлощадь;
		СтруктураДанных.ОписаниеЖилойПлощади		= ВыборкаЛС.ЖилаяПлощадь;
		СтруктураДанных.ОписаниеОтапливаемойПлощади	= ВыборкаЛС.ОтапливаемаяПлощадь;
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ
		|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета,
		|	бит_ЗначениеСвойствОбъектовУчета.ВидСвойства,
		|	ЕСТЬNULL(бит_ЗначениеСвойствОбъектовУчета.Значение, 0) КАК Значение
		|ИЗ
		|	РегистрСведений.бит_ЗначениеСвойствОбъектовУчета КАК бит_ЗначениеСвойствОбъектовУчета
		|ГДЕ
		|	бит_ЗначениеСвойствОбъектовУчета.ОбъектУчета = &Здание";
		
		Запрос.УстановитьПараметр("Здание", ВыборкаЛС.ЛицевойСчет.Здание);
		
		РезультатЗначениеСвойств = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗначениеСвойств.Выбрать();
		
		ПлощадьЖилыхНежилых = 0;
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилогоЗдания") Тогда
				
				СтруктураДанных.ОбщаяПлощадьЖилогоЗдания             = ВыборкаДетальныеЗаписи.Значение;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилыхПомещений") Тогда
				
				СтруктураДанных.ОбщаяПлощадьЖилыхПомещений             = ВыборкаДетальныеЗаписи.Значение;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьНежилыхПомещений") Тогда
				
				СтруктураДанных.ОбщаяПлощадьНежилыхПомещений             = ВыборкаДетальныеЗаписи.Значение;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьПридомовойТерритории") Тогда
				
				СтруктураДанных.ОбщаяПлощадьПридомовойТерритории             = ВыборкаДетальныеЗаписи.Значение;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьГрунта") Тогда
				
				СтруктураДанных.ОбщаяПлощадьГрунта             = ВыборкаДетальныеЗаписи.Значение;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьМестОбщегоПользования") Тогда
				
				СтруктураДанных.МестОбщегоПользования             = ВыборкаДетальныеЗаписи.Значение;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ПлощадьПринадлежащаяЧленамТСЖ") Тогда
				
				СтруктураДанных.ПлощадьПринадлежащаяЧленамТСЖ             = ВыборкаДетальныеЗаписи.Значение;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.КоличествоПодъездов") Тогда
				
				СтруктураДанных.КоличествоПодъездов             = ВыборкаДетальныеЗаписи.Значение;
				
			ИначеЕсли ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.КоличествоЭтажей") Тогда
				
				СтруктураДанных.КоличествоЭтажей             = ВыборкаДетальныеЗаписи.Значение;
				
			КонецЕсли;
			
			Если ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьНежилыхПомещений")
				Или ВыборкаДетальныеЗаписи.ВидСвойства = ПредопределенноеЗначение("ПланВидовХарактеристик.бит_СвойстваОбъектовУчета.ОбщаяПлощадьЖилыхПомещений") Тогда
				ПлощадьЖилыхНежилых = ПлощадьЖилыхНежилых + ВыборкаДетальныеЗаписи.Значение;
			КонецЕсли;
			
		КонецЦикла;
		
		СтруктураДанных.ПлощадьЖилыхНежилых = ПлощадьЖилыхНежилых;
		
		СтруктураДанных.Сальдо                           = ВыборкаЛС.Сальдо;
		СтруктураДанных.Начислено                        = ВыборкаЛС.Начислено;
		СтруктураДанных.Оплата                           = ВыборкаЛС.Оплата;
		СтруктураДанных.Разовые                          = ВыборкаЛС.Разовые;
		СтруктураДанных.ЛицевойСчет                      = ВыборкаЛС.ЛицевойСчет;
		СтруктураДанных.ИтогПени                         = ВыборкаЛС.СальдоПени;
		СтруктураДанных.КолЛьготников                    = ВыборкаЛС.КоличествоЛьготников;
		СтруктураДанных.СтатусКвартиры                   = ВыборкаЛС.СтатусКвартиры;
		СтруктураДанных.КоличествоКомнат                 = ВыборкаЛС.КоличествоКомнат;
		СтруктураДанных.Оплата                           = ВыборкаЛС.Оплата;
		СтруктураДанных.Начислено                        = ВыборкаЛС.Начислено;
		СтруктураДанных.Сальдо                           = ?(ШаблонИзвещений.Кредит = Перечисления.ДаНет.Нет 
		И ШаблонИзвещений.Сальдо = Перечисления.ДаНет.Нет, 0 ,ВыборкаЛС.Сальдо);
		СтруктураДанных.Разовые                          = ВыборкаЛС.Разовые;
		СтруктураДанных.ТипКвартиры                      = ВыборкаЛС.ТипКвартиры;
		СтруктураДанных.ОписаниеЛьгот                    = ?(СложнаяЛьгота, "Сложная льгота", ОписаниеЛьгот);
		СтруктураДанных.ОписаниеСложнойЛьготы            = ОписаниеЛьгот;
		СтруктураДанных.ГруппироватьУслуги               = ВыборкаЛС.ГруппироватьУслуги;
		СтруктураДанных.ПечатьЗависимыхЛС                = ВыборкаЛС.ПечатьЗависимыхЛС;
		СтруктураДанных.ДатаПоследнейОплаты              = Формат(ВыборкаЛС.ДатаОплаты, "ДФ=dd.MM.yyyy");
		СтруктураДанных.ДатаПоследнейОплатыГИСЖКХ        = ВыборкаЛС.ДатаОплаты;
		СтруктураДанных.СуммаПоследнейОплаты         	 = ВыборкаЛС.СуммаПоследнейОплаты;
		СтруктураДанных.ДатаПоследнейОплатыКапРем	     = Формат(ВыборкаЛС.ДатаОплатыКапРем, "ДФ=dd.MM.yyyy");
		СтруктураДанных.ДатаПоследнейОплатыКапРемГИСЖКХ  = ВыборкаЛС.ДатаОплатыКапРем;
		СтруктураДанных.ДатаПоследнейОплатыНеКапРем      = Формат(ВыборкаЛС.ДатаОплатыНеКапРем, "ДФ=dd.MM.yyyy");
		СтруктураДанных.ДатаПоследнейОплатыНеКапРемГИСЖКХ= ВыборкаЛС.ДатаОплатыНеКапРем;
		СтруктураДанных.РежимРаботы                      = мКэшПараметрыЖКХ.РежимРаботы;
		
		СтруктураДанных.ОплатаСУчетомПени                = ВыборкаЛС.Оплата + ВыборкаЛС.ОплатаПени;
		СтруктураДанных.ОплатаПени                       = ВыборкаЛС.ОплатаПени;
		СтруктураДанных.СубсидияПИ                       = ВыборкаЛС.СубсидияПИ;
	
		
		СтруктураДанных.ВходящееСальдоПени               = ВыборкаЛС.ДолгПени;
		СтруктураДанных.НачисленоПениЗаПериод            = ВыборкаЛС.НачисленоПениЗаПериод;
		
		
		//21.02.2019
		СтруктураДанных.ВходящееСальдоПлюсНачисленоЗаПериодПени = СтруктураДанных.ВходящееСальдоПени + СтруктураДанных.НачисленоПениЗаПериод; 
		
		СтруктураДанных.ЕЛСГИСЖКХ						 = ВыборкаЛС.ЕЛСГИСЖКХ;
		СтруктураДанных.ИдентификаторЖКУ				 = ВыборкаЛС.ИдентификаторЖКУ;
		СтруктураДанных.КапРемЕЛСГИСЖКХ					 = ВыборкаЛС.КапРемЕЛСГИСЖКХ;
		СтруктураДанных.КапРемИдентификаторЖКУ			 = ВыборкаЛС.КапРемИдентификаторЖКУ;
		СтруктураДанных.ИдентификаторПД					 = ВыборкаЛС.ИдентификаторПД;
		
		Если ШаблонИзвещений = Справочники.бит_ШаблоныИзвещений.КапитальныйРемонт Тогда
			СтруктураДанных.ЕЛС = ВыборкаЛС.КапРемЕЛСГИСЖКХ;
		Иначе
			СтруктураДанных.ЕЛС = ВыборкаЛС.ЕЛСГИСЖКХ;
		КонецЕсли;
		
		Если  Строка(ЭтотОбъект.ДатаПечатиКвитанций) <> "01.01.0001 0:00:00"  Тогда
			СтруктураДанных.ДатаПечатиКвитанций          = Формат(ЭтотОбъект.ДатаПечатиКвитанций, "ДФ=dd.MM.yyyy");
		Иначе
			СтруктураДанных.ДатаПечатиКвитанций              = Формат(ТекущаяДата(), "ДФ=dd.MM.yyyy");
		КонецЕсли;
		
		Если  ЗначениеЗаполнено(СтруктураДанных.Дата) Тогда
			МесяцПечатиКвитанций   = Месяц(СтруктураДанных.Дата);
			ГодДатаПечатиКвитанций = Год(СтруктураДанных.Дата);
			ПоследнийДеньМесяца	   = День(КонецМесяца(СтруктураДанных.Дата));
		Иначе
			ТекДата				   = ТекущаяДата(); 
			МесяцПечатиКвитанций   = Месяц(ТекДата);
			ГодДатаПечатиКвитанций = Год(ТекДата);
			ПоследнийДеньМесяца	   = День(КонецМесяца(ТекДата));
		КонецЕсли;
		
		Если мКэшПараметрыЖКХ.ПоследнийДеньПриемаПлатежей = 0 Тогда
			ПоследнийДеньПриемаПлатежей = 1;
		ИначеЕсли мКэшПараметрыЖКХ.ПоследнийДеньПриемаПлатежей > ПоследнийДеньМесяца Тогда
			ПоследнийДеньПриемаПлатежей = ПоследнийДеньМесяца;
		Иначе
			ПоследнийДеньПриемаПлатежей = мКэшПараметрыЖКХ.ПоследнийДеньПриемаПлатежей;
		КонецЕсли;
		
		ОплатитьДо = ДобавитьМесяц(Дата(ГодДатаПечатиКвитанций, МесяцПечатиКвитанций, ПоследнийДеньПриемаПлатежей)
									, (мКэшПараметрыЖКХ.КоличествоМесяцевОтсрочкиНачисленияПени + 1));
		СтруктураДанных.ОплатитьДо = Формат(ОплатитьДо, "ДФ = дд.ММ.гггг");
		
		ВыборкаУС = ВыборкаЛС.Выбрать();
		
		ТаблицаПечати = ПолучитьТаблицуПечати();
		
		ТаблицаОбщедомовыхСчетчиков = ПолучитьТаблицуОбщедомовыхСчетчиков();
		
		ИтогоЛьгота            = 0;
		ИтогоКОплате           = 0;
		ИтогоДолг              = 0;
		ИтогоПереплата         = 0;
		ИтогоПереплатаНаНачало = 0;
		ИтогоКОплатеЗаМесяц    = 0;
		ИтогоТекСальдо         = 0;
		ИтогоЗакрытиеВхДолга   = 0;
		
		ИтогоЗакрытиеВхДолгаБезШаблона = 0;	
		
		ИтогоСубсидияПИ        = 0;
		
		Пока ВыборкаУС.Следующий() Цикл
			
			Количество        = 0;
			Долг              = 0;
			ПереплатаНаНачало = 0;
			Переплата         = 0;
			Коплате           = 0;
			КОплатеЗаМесяц    = 0;
			Льгота            = 0;
			ТекСальдо         = 0;
			ЗакрытиеВхДолга   = 0;
			
			ЗакрытиеВхДолгаБезШаблона = 0;
			
			СубсидияПИ        = 0;
			
			Если 
				
				ВыборкаУС.СальдоПени <> 0 или ПечатьУслРежимНет ИЛИ ВыборкаУС.РежимПотребления <> Справочники.бит_РежимыПотребленияУслуг.Нет И ( 
				
				// Печатаем без начислений но с оплатой, только когда стоит флаг "Печатать услуги с оплатой без начислений".
				ВыборкаУС.Сальдо <> 0 ИЛИ ВыборкаУС.Начислено <> 0 ИЛИ ВыборкаУС.Разовые <> 0 ИЛИ ВыборкаУС.Оплата <> 0 И ПечататьУслугиСОплатой 
				
				// Исключение печати без начисления и оплат.
				ИЛИ (ВыборкаУС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам
				И (мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение6 
				ИЛИ мОсновнойВариантМакета = Справочники.бит_ВариантыСчетовИзвещений.СчетИзвещение5))
				
				// Выводить нулевые услуги с режимомо потребления "Да", на зависимо от начислений.
				ИЛИ (ВыборкаУС.Сальдо = 0 И ВыборкаУС.Начислено = 0 И ВыборкаУС.Разовые = 0			
				И ВыборкаУС.РежимПотребления <> Справочники.бит_РежимыПотребленияУслуг.Нет И ВыводВсехУслугЛС))
				
			Тогда	
				
				Льгота = ВыборкаУС.Льгота;
				
				СубсидияПИ = ВыборкаУС.СубсидияПИ;
				
				Если мКэшПараметрыЖКХ.ЛьготаПерсонифицированная Тогда
					Льгота = 0;
				КонецЕсли;				
							
				Если ВыборкаУС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам Тогда
					Количество = ВыборкаУС.ФактПоСчетчикам;
				ИначеЕсли ВыборкаУС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОбщейПлощади Тогда
					Количество = ВыборкаУС.ОбщаяПлощадь;
				ИначеЕсли ВыборкаУС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЖилойПлощади Тогда
					Количество = ВыборкаУС.ЖилаяПлощадь;
				ИначеЕсли ВыборкаУС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоОтапливаемойПлощади Тогда
					Количество = ВыборкаУС.ОтапливаемаяПлощадь;
				ИначеЕсли ВыборкаУС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоПроживающим  Тогда
					Количество = ВыборкаУС.КоличествоПроживающих;
				ИначеЕсли ВыборкаУС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребления Тогда
					Количество = ВыборкаУС.КоличествоЕдиницПотребления;
				ИначеЕсли ВыборкаУС.СпособРасчета = Перечисления.бит_СпособыРасчетаПоУслугам.ПоЕдиницамПотребленияНаЛицевойСчет Тогда
					Количество = ВыборкаУС.КоличествоЕдиницПотребления;
				КонецЕсли;
				
				// Заполнение таблицы печати.
				НоваяСтрока = ТаблицаПечати.Добавить();
				
				УслугаПредставление = ?(мНастройкиМакета.ИспользоватьСокращенноеНаименованиеУслуги,
				ВыборкаУС.Услуга.НаименованиеСокращенное,
				ВыборкаУС.Услуга.НаименованиеПолное);
				
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаУС);
				НоваяСтрока.УслугаПредставление = УслугаПредставление;
				
				ТекСальдо = ВыборкаУС.Сальдо;
				
				ЗакрытиеВхДолгаБезШаблона = ВыборкаУС.Сальдо - ВыборкаУС.Оплата;
				
				// Учет настроек шаблона извещений.
				Если Сальдо = Перечисления.ДаНет.Да И Кредит = Перечисления.ДаНет.Да Тогда
					
					ЗакрытиеВхДолга = ВыборкаУС.Сальдо - ВыборкаУС.Оплата;
					НоваяСтрока.ЗакрытиеВхДолга = ЗакрытиеВхДолга;  
					
					Долг              = ?(ВыборкаУС.Сальдо > 0,ВыборкаУС.Сальдо,0);
					
					ПереплатаНаНачало = ?(ВыборкаУС.Сальдо < 0,ВыборкаУС.Сальдо * -1,0);
					Переплата         = ВыборкаУС.Сальдо + ВыборкаУС.Начислено +  ВыборкаУС.Разовые - ВыборкаУС.Оплата - Льгота;
					Переплата         = ?(Переплата < 0, Переплата * -1, 0);
					
					Коплате = ?(мНастройкиМакета.СальдоКОплате    ,ВыборкаУС.Сальдо,0) + 
					?(мНастройкиМакета.НачисленияКОплате,ВыборкаУС.Начислено,0)+
					?(мНастройкиМакета.РазовыеКОплате   ,ВыборкаУС.Разовые,0)-
					?(мНастройкиМакета.СубсидияПИКОплате,СубсидияПИ,0)-
					?(мНастройкиМакета.ЛьготаКОплате    ,Льгота,0)-
					?(мНастройкиМакета.ОплатаКОплате    ,ВыборкаУС.Оплата,0);
					
					Если НЕ мНастройкиМакета.СУчетомПереплатыКОплате Тогда
						Коплате = ?(Коплате >= 0, Коплате, 0);
					КонецЕсли; 
					
					Если мНастройкиМакета.СальдоКОплатеБезУчетаДолга Тогда
						Если ЗакрытиеВхДолга > 0 Тогда
							Коплате = ?(Коплате - ЗакрытиеВхДолга > 0, Коплате - ЗакрытиеВхДолга, 0);
						КонецЕсли;
					КонецЕсли;
					
					КОплатеЗаМесяц = ?(мНастройкиМакета.СальдоЗаМесяц    ,ВыборкаУС.Сальдо,0) + 
					?(мНастройкиМакета.НачисленияЗаМесяц,ВыборкаУС.Начислено,0)+
					?(мНастройкиМакета.РазовыеЗаМесяц   ,ВыборкаУС.Разовые,0)-
					?(мНастройкиМакета.СубсидияПИЗаМесяц,СубсидияПИ,0)-
