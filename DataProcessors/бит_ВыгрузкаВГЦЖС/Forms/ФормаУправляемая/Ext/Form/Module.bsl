			ПостроительЗапроса.Отбор.Добавить("Здание");
			ПостроительЗапроса.Отбор["Здание"].ВидСравнения  = ВидСравнения.ВСписке;
			ПостроительЗапроса.Отбор["Здание"].Использование = Истина;
			ПостроительЗапроса.Отбор["Здание"].Значение      = ЗначениеОтбора;
			
		КонецЕсли;
		
	КонецЕсли; 
	
	Если ИспользоватьОтборСписокЛС Тогда
		
		Если СписокЛС.Количество() > 0 Тогда
			
			Отбор = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
			Отбор.ВидСравнения  = ВидСравнения.ВСписке;
			Отбор.Использование = Истина;
			Отбор.Значение      = СписокЛС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСтатусКв Тогда
		
		ПостроительЗапроса.Отбор.Добавить("СтатусКвартиры");
		ПостроительЗапроса.Отбор["СтатусКвартиры"].ВидСравнения  = ВидСравнения.ВСписке;
		ПостроительЗапроса.Отбор["СтатусКвартиры"].Использование = Истина;
		ПостроительЗапроса.Отбор["СтатусКвартиры"].Значение      = СтатусКвартиры;
		
	КонецЕсли;
	
	Если ИспользоватьОтборТипКв Тогда
		
		ПостроительЗапроса.Отбор.Добавить("ТипКвартиры");
		ПостроительЗапроса.Отбор["ТипКвартиры"].ВидСравнения  = ВидСравнения.ВСписке;
		ПостроительЗапроса.Отбор["ТипКвартиры"].Использование = Истина;
		ПостроительЗапроса.Отбор["ТипКвартиры"].Значение      = ТипКвартиры;
		
	КонецЕсли;
	
	Если НЕ Объект.ШаблонУслуг = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам 
		И НЕ Объект.ШаблонУслуг.Пустая() Тогда
		
		СписокУслуг = Новый СписокЗначений;
		СписокУслуг.ЗагрузитьЗначения(Объект.ШаблонУслуг.Услуги.ВыгрузитьКолонку("Услуга"));
		
		Отбор = ПостроительЗапроса.Отбор.Добавить("Услуга");
		Отбор.ВидСравнения  = ВидСравнения.ВСписке;
		Отбор.Использование = Истина;
		Отбор.Значение      = СписокУслуг;
		
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	Результат = ПостроительЗапроса.Результат;
	
	ТаблицаДанных = Новый ТаблицаЗначений;
	ТаблицаДанных.Колонки.Добавить("ЛицевойСчет"               , ОбщегоНазначения.ОписаниеТипаСтрока(12));           // 1.
	ТаблицаДанных.Колонки.Добавить("Фамилия"                   , ОбщегоНазначения.ОписаниеТипаСтрока(50));           // 2.
	ТаблицаДанных.Колонки.Добавить("Имя"                       , ОбщегоНазначения.ОписаниеТипаСтрока(50));           // 3. 
	ТаблицаДанных.Колонки.Добавить("Отчество"                  , ОбщегоНазначения.ОписаниеТипаСтрока(50));           // 4.
	ТаблицаДанных.Колонки.Добавить("Пол"                       , ОбщегоНазначения.ОписаниеТипаСтрока(1));            // 5.
	ТаблицаДанных.Колонки.Добавить("ДатаРождения"              , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата)); // 6.
	ТаблицаДанных.Колонки.Добавить("Адрес"                     , ОбщегоНазначения.ОписаниеТипаСтрока(150));          // 7.
	ТаблицаДанных.Колонки.Добавить("ВидСобственности"          , ОбщегоНазначения.ОписаниеТипаСтрока(50));           // 8.
	ТаблицаДанных.Колонки.Добавить("ОбщаяПлощадь"              , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 9.
	ТаблицаДанных.Колонки.Добавить("Норма"                     , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 10.
	ТаблицаДанных.Колонки.Добавить("КолвоПроживающих"          , ОбщегоНазначения.ОписаниеТипаЧисло(15));            // 11.
	ТаблицаДанных.Колонки.Добавить("КолвоПроживающихНачисление", ОбщегоНазначения.ОписаниеТипаЧисло(15));            // 12.
	ТаблицаДанных.Колонки.Добавить("Примечание"                , ОбщегоНазначения.ОписаниеТипаСтрока(0));            // 13.
	ТаблицаДанных.Колонки.Добавить("КодЛьготы"                 , ОбщегоНазначения.ОписаниеТипаСтрока(4));            // 14.
	ТаблицаДанных.Колонки.Добавить("ДокументНаЛьготу"          , ОбщегоНазначения.ОписаниеТипаСтрока(150));          // 15.
	ТаблицаДанных.Колонки.Добавить("СерияДокумента"            , ОбщегоНазначения.ОписаниеТипаСтрока(8));            // 16.
	ТаблицаДанных.Колонки.Добавить("НомерДокумента"            , ОбщегоНазначения.ОписаниеТипаСтрока(15));           // 17.
	ТаблицаДанных.Колонки.Добавить("ДатаВыдачи"                , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата)); // 18.
	ТаблицаДанных.Колонки.Добавить("КемВыдан"                  , ОбщегоНазначения.ОписаниеТипаСтрока(150));          // 19.
	ТаблицаДанных.Колонки.Добавить("ДатаПриобретения"          , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата)); // 20.
	ТаблицаДанных.Колонки.Добавить("ДатаУтраты"                , ОбщегоНазначения.ОписаниеТипаДата(ЧастиДаты.Дата)); // 21.
	ТаблицаДанных.Колонки.Добавить("СуммаОтОбщейПлощади"       , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 22.
	ТаблицаДанных.Колонки.Добавить("СуммаЭл"                   , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 23.
	ТаблицаДанных.Колонки.Добавить("СуммаГаз"                  , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 24.
	ТаблицаДанных.Колонки.Добавить("СуммаХолВода"              , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 25.
	ТаблицаДанных.Колонки.Добавить("СуммаКанализация"          , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 26.
	ТаблицаДанных.Колонки.Добавить("СуммаГорВода"              , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 27.
	ТаблицаДанных.Колонки.Добавить("СуммаОтопления"            , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 28.
	ТаблицаДанных.Колонки.Добавить("СуммаОчисткаСтоков"        , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 29.
	ТаблицаДанных.Колонки.Добавить("СуммаВывозОтходов"         , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 30.
	ТаблицаДанных.Колонки.Добавить("Итого"                     , ОбщегоНазначения.ОписаниеТипаЧисло(15,2));          // 31.
	ТаблицаДанных.Колонки.Добавить("КолМесяцевЗадолженность"   , ОбщегоНазначения.ОписаниеТипаЧисло(15));            // 32.
	
	ВыборкаЛС = Результат.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
	
	Пока ВыборкаЛС.Следующий() Цикл
		
		ВыборкаЛьгота = ВыборкаЛС.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
		
		Пока ВыборкаЛьгота.Следующий() Цикл
			
			ВыборкаФизЛицо = ВыборкаЛьгота.Выбрать(ОбходРезультатаЗапроса.ПоГруппировкам);
			
			Пока ВыборкаФизЛицо.Следующий() Цикл
				
				СуммаОтОбщейПлощади = 0;
				СуммаЭл             = 0;
				СуммаГаз            = 0;
				СуммаХолВода        = 0;
				СуммаКанализация    = 0;
				СуммаГорВода        = 0;
				СуммаОтопления      = 0;
				СуммаОчисткаСтоков  = 0;
				СуммаВывозОтходов   = 0;
				
				Норма = 0;
				
				Выборка = ВыборкаФизЛицо.Выбрать();
				
				Пока Выборка.Следующий() Цикл
					
					// Техобслуживание.
					Если Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Техобслуживание Тогда
						
						СуммаОтОбщейПлощади = СуммаОтОбщейПлощади + Выборка.Сумма;
						
						Если Норма = 0 Тогда
							
							Если Выборка.КолвоПроживающихНачисление = 0 тогда
								мКоличествоПроживающихДляРасчета = 1;
							иначе
								мКоличествоПроживающихДляРасчета = Выборка.КолвоПроживающихНачисление;
							КонецЕсли;
							
							Если мКоличествоПроживающихДляРасчета = 1 тогда
								Норма  = Выборка.НаОдного + ?(Выборка.ИспользоватьДопНормуНаОдного,Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого,0);
							ИначеЕсли мКоличествоПроживающихДляРасчета = 2 тогда
								Норма  = Выборка.НаДвоих * 2 + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * 2;
							ИначеЕсли мКоличествоПроживающихДляРасчета = 3 тогда
								Норма  = Выборка.НаСемью * мКоличествоПроживающихДляРасчета + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПроживающихДляРасчета;  
							ИначеЕсли мКоличествоПроживающихДляРасчета = 4 тогда
								Норма  = Выборка.НаСемью4 * мКоличествоПроживающихДляРасчета + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПроживающихДляРасчета;  
							ИначеЕсли мКоличествоПроживающихДляРасчета = 5 тогда
								Норма  = Выборка.НаСемью5 * мКоличествоПроживающихДляРасчета + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПроживающихДляРасчета;  
							ИначеЕсли мКоличествоПроживающихДляРасчета > 5 тогда
								Норма  = Выборка.НаСемью6 * мКоличествоПроживающихДляРасчета + Выборка.ДопНормаНаСемью + Выборка.ДопНормаНаКаждого * мКоличествоПроживающихДляРасчета;  
							КонецЕсли; 
							
						КонецЕсли; 
						
						// Электроэнергия.
					ИначеЕсли Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Электроэнергия Тогда
						
						СуммаЭл = СуммаЭл + Выборка.Сумма;
						
						// Газ.
					ИначеЕсли Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Газ Тогда
						
						СуммаГаз = СуммаГаз + Выборка.Сумма;
						
						// ХолодноеВодоснабжение.
					ИначеЕсли Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ХолодноеВодоснабжение
						// БИТ_ЖКХ 25.01.2016 10:23:20 Начало правки...
						ИЛИ Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ХВСДляГВС
						// БИТ_ЖКХ 25.01.2016 10:23:20 Конец правки.
						Тогда
						
						СуммаХолВода = СуммаХолВода + Выборка.Сумма;
						
						// Водопровод (Канализация).
					ИначеЕсли Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Водопровод Тогда
						
						СуммаКанализация = СуммаКанализация + Выборка.Сумма;
						
						// ГорячееВодоснобжение.
					ИначеЕсли Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ГорячееВодоснобжение Тогда
						
						СуммаГорВода = СуммаГорВода + Выборка.Сумма;
						
						// Отопление.
					ИначеЕсли Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.Отопление Тогда
						
						СуммаОтопления = СуммаОтопления + Выборка.Сумма;
						
						// ОчисткаСтоков.
					ИначеЕсли Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ОчисткаСтоков Тогда
						
						СуммаОчисткаСтоков = СуммаОчисткаСтоков + Выборка.Сумма;
						
						// ВывозБытовыхОтходов.
					ИначеЕсли Выборка.ГрафаОтчетаГЦЖС = Перечисления.бит_ГрафыОтчетаПоГЦЖС.ВывозБытовыхОтходов Тогда
						
						СуммаВывозОтходов = СуммаВывозОтходов + Выборка.Сумма;
						
					КонецЕсли; 
					
				КонецЦикла; 
				
				Итого = СуммаОтОбщейПлощади +
				СуммаЭл +            
				СуммаГаз +           
				СуммаХолВода +        
				СуммаКанализация +   
				СуммаГорВода +      
				СуммаОтопления +     
				СуммаОчисткаСтоков +
				СуммаВывозОтходов;
				
				НоваяСтрока = ТаблицаДанных.Добавить();
				НоваяСтрока.ЛицевойСчет                = ВыборкаФизЛицо.Наименование;
				НоваяСтрока.Фамилия                    = ВыборкаФизЛицо.Фамилия;
				НоваяСтрока.Имя                        = ВыборкаФизЛицо.Имя;
				НоваяСтрока.Отчество                   = ВыборкаФизЛицо.Отчество;
				НоваяСтрока.Пол                        = ВыборкаФизЛицо.Пол;
				НоваяСтрока.ДатаРождения               = ВыборкаФизЛицо.ДатаРождения;
				НоваяСтрока.Адрес                      = ""+ ВыборкаФизЛицо.ПочтовыйАдрес+","+ВыборкаФизЛицо.Квартира; 
				НоваяСтрока.ВидСобственности           = ВыборкаФизЛицо.ВидСобственности;
				НоваяСтрока.ОбщаяПлощадь               = ВыборкаФизЛицо.ОбщаяПлощадь;
				НоваяСтрока.Норма                      = Норма;
				НоваяСтрока.КолвоПроживающих           = ВыборкаФизЛицо.КолвоПроживающих;
				НоваяСтрока.КолвоПроживающихНачисление = ВыборкаФизЛицо.КолвоПроживающихНачисление;
				НоваяСтрока.Примечание                 = "";
				НоваяСтрока.КодЛьготы                  = ВыборкаФизЛицо.КодЛьготы;
				НоваяСтрока.ДокументНаЛьготу           = ВыборкаФизЛицо.ДокументНаЛьготу;
				НоваяСтрока.СерияДокумента             = ВыборкаФизЛицо.СерияДокумента;
				НоваяСтрока.НомерДокумента             = ВыборкаФизЛицо.НомерДокумента;
				НоваяСтрока.ДатаВыдачи                 = ВыборкаФизЛицо.ДатаВыдачи;
				НоваяСтрока.КемВыдан                   = ВыборкаФизЛицо.КемВыдан;
				НоваяСтрока.ДатаПриобретения           = ВыборкаФизЛицо.ДатаПриобретения;
				НоваяСтрока.ДатаУтраты                 = ВыборкаФизЛицо.ДатаУтраты;
				НоваяСтрока.СуммаОтОбщейПлощади        = СуммаОтОбщейПлощади;
				НоваяСтрока.СуммаЭл                    = СуммаЭл;
				НоваяСтрока.СуммаГаз                   = СуммаГаз;
				НоваяСтрока.СуммаХолВода               = СуммаХолВода;
				НоваяСтрока.СуммаКанализация           = СуммаКанализация;
				НоваяСтрока.СуммаГорВода               = СуммаГорВода;
				НоваяСтрока.СуммаОтопления             = СуммаОтопления;
				НоваяСтрока.СуммаОчисткаСтоков         = СуммаОчисткаСтоков;
				НоваяСтрока.СуммаВывозОтходов          = СуммаВывозОтходов;
				НоваяСтрока.Итого                      = Итого;
				НоваяСтрока.КолМесяцевЗадолженность    = 0;
				
			КонецЦикла; 
			
		КонецЦикла;
		
	КонецЦикла;
	
	Возврат ТаблицаДанных;
	
КонецФункции

&НаСервере
Процедура ПрочитатьСтруктуруФайлаExcel()
	
	ЕстьОшибки = Ложь;
	
	Excel = Новый COMОбъект("Excel.Application");
	
	Если Excel = Неопределено Тогда
		Возврат ;
	КонецЕсли;
	
	Стр = Объект.НомерСтрокиExcel;
	
	Попытка
		
		ExcelФайл   = Excel.WorkBooks.Open(Объект.ФайлExcel);
		ExcelЛист   = ExcelФайл.Sheets(Объект.ИмяСтраницыExcel);
		
		Для Значение = 1 По Объект.КоличествоКолонокExcel Цикл
			
			ИмяКолонки = ExcelЛист.Cells(Стр, Значение).Value;
			
			Если ЗначениеЗаполнено(ИмяКолонки) Тогда
				
				НоваяСтрока = ТаблицаСоответствий.Добавить();
				НоваяСтрока.НомерКолонки    = Значение;
				НоваяСтрока.ИмяКолонкиExcel = ИмяКолонки;
				
			КонецЕсли; 
			
		КонецЦикла; 
		
		ExcelФайл.Close();
		
		Excel.Quit();
		
	Исключение
		
		ЕстьОшибки = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось прочитать лист Excel!
									|%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
	КонецПопытки;
	
	Если ЕстьОшибки Тогда
		
		бит_Выгрузка.ЗакрытьПриложениеExcel(Excel);
		
	КонецЕсли;
	
КонецПроцедуры 

&НаСервере
Процедура ОбновитьТаблицуДанных()
	
	ТаблицаДанных = ОбновитьДанныеВыгрузкиЛьготыИркутск();
	
	АдресТаблицаДанныхИркутск = ПоместитьВоВременноеХранилище(ТаблицаДанных, УникальныйИдентификатор);
	
КонецПроцедуры

&НаСервере
Функция ЗаполнитьФайлВыгрузкиЛьготыИркутск()
	
	ФайлИзменен = Ложь;
	
	Попытка
		
		ТаблицаДанных = ПолучитьИзВременногоХранилища(АдресТаблицаДанныхИркутск);
		
	Исключение
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Данные для выгрузки не сформированны.");
		Возврат ФайлИзменен;
	КонецПопытки;
	
	Если ТаблицаДанных = Неопределено Тогда
		Возврат ФайлИзменен;
	КонецЕсли; 
	
	ЕстьОшибки = Ложь;
	
	Excel = Новый COMОбъект("Excel.Application");
	
	Если Excel = Неопределено Тогда
		Возврат ФайлИзменен;
	КонецЕсли;
	
	Стр = Объект.НомерСтрокиExcel;
	
	Попытка
		
		ExcelФайл   = Excel.WorkBooks.Open(Объект.ФайлExcel);
		ExcelЛист   = ExcelФайл.Sheets(Объект.ИмяСтраницыExcel);
		
		Для каждого Строка Из ТаблицаСоответствий Цикл
			
			МассивЗначений = ТаблицаДанных.ВыгрузитьКолонку(Строка.ИмяКолонкиТаблицыДанных);
			
			НомерНачальнойСтроки = Объект.НомерСтрокиExcel;
			
			Для каждого Элемент Из МассивЗначений Цикл
				
				НомерНачальнойСтроки = НомерНачальнойСтроки + 1;
				
				Если НЕ ЗначениеЗаполнено(Элемент) И ТипЗнч(Элемент) = Тип("Дата")Тогда
					ExcelЛист.Cells(НомерНачальнойСтроки, Строка.НомерКолонки).Value = "";
				Иначе
					
					ExcelЛист.Cells(НомерНачальнойСтроки, Строка.НомерКолонки).Value = Элемент;
					
				КонецЕсли; 
				
			КонецЦикла; 
			
		КонецЦикла; 
		
		ExcelФайл.ConflictResolution = 1;
		ExcelФайл.Save();
		ExcelФайл.Close();
		
		Excel.Quit();
		
		ФайлИзменен = Истина;
		
	Исключение
		
		ЕстьОшибки  = Истина;
		ФайлИзменен = Ложь;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить файл Excel!
									|%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
		
	КонецПопытки;
	
	Если ЕстьОшибки Тогда
		
		бит_Выгрузка.ЗакрытьПриложениеExcel(Excel);
		
	КонецЕсли;
	
	Возврат ФайлИзменен;
	
КонецФункции

&НаСервере
Функция СформироватьТаблицуПроверки()
	
	Попытка
		
		ТаблицаДанных = ПолучитьИзВременногоХранилища(АдресТаблицаДанныхИркутск);
		
	Исключение
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Данные для выгрузки не сформированны.");
		Возврат Неопределено;
	КонецПопытки;
	
	Если ТаблицаДанных = Неопределено Тогда
		
		Возврат Неопределено;
		
	КонецЕсли; 
	
	ТабличныйДокумент = Новый ТабличныйДокумент;
	
	НомерПервойСтроки = 1;
	
	Для каждого Строка Из ТаблицаСоответствий Цикл
		
		ТМП = Новый ТабличныйДокумент;
		
		ЯчейкаКолонки = ТабличныйДокумент.ПолучитьОбласть("R1C" + Строка.НомерКолонки);
		ЯчейкаКолонки.ТекущаяОбласть.РазмещениеТекста        = ТипРазмещенияТекстаТабличногоДокумента.Переносить;
		ЯчейкаКолонки.ТекущаяОбласть.Текст                   = Строка.ИмяКолонкиExcel;
		ЯчейкаКолонки.ТекущаяОбласть.ГоризонтальноеПоложение = ГоризонтальноеПоложение.Центр;
		ЯчейкаКолонки.ТекущаяОбласть.ВертикальноеПоложение   = ВертикальноеПоложение.Центр;
		
		Линия = Новый Линия(ТипЛинииЯчейкиТабличногоДокумента.Сплошная);
		ЯчейкаКолонки.ТекущаяОбласть.ГраницаСверху = Линия;
		ЯчейкаКолонки.ТекущаяОбласть.ГраницаСлева  = Линия;
		ЯчейкаКолонки.ТекущаяОбласть.ГраницаСнизу  = Линия;
		ЯчейкаКолонки.ТекущаяОбласть.ГраницаСправа = Линия;
		
		ЯчейкаКолонки.ТекущаяОбласть.ШиринаКолонки = 30;
		
		Шрифт = Новый Шрифт(ЯчейкаКолонки.ТекущаяОбласть.Шрифт,,10,Истина); 
		ЯчейкаКолонки.ТекущаяОбласть.Шрифт = Шрифт;
		
		
		ТМП.Вывести(ЯчейкаКолонки);
		
		МассивЗначений = ТаблицаДанных.ВыгрузитьКолонку(Строка.ИмяКолонкиТаблицыДанных);
		
		НомерНачальнойСтроки = 1;
		
		Для каждого Элемент Из МассивЗначений Цикл
			
			НомерНачальнойСтроки = НомерНачальнойСтроки + 1;
			
			ЯчейкаКолонки = ТабличныйДокумент.ПолучитьОбласть("R" + НомерНачальнойСтроки + "C" + Строка.НомерКолонки);
			
			ЯчейкаКолонки.ТекущаяОбласть.ГраницаСверху = Линия;
			ЯчейкаКолонки.ТекущаяОбласть.ГраницаСлева  = Линия;
			ЯчейкаКолонки.ТекущаяОбласть.ГраницаСнизу  = Линия;
			ЯчейкаКолонки.ТекущаяОбласть.ГраницаСправа = Линия;
			
			ЯчейкаКолонки.ТекущаяОбласть.Текст = Элемент;
			Если ТипЗнч(Элемент) = Тип("Дата")Тогда
				
				ЯчейкаКолонки.ТекущаяОбласть.Формат = "ДФ=dd.MM.yyyy"; 
				
			КонецЕсли; 
			
			ТМП.Вывести(ЯчейкаКолонки);
			
		КонецЦикла;
		
		ТабличныйДокумент.Присоединить(ТМП);
		
	КонецЦикла; 
	
	Возврат ТабличныйДокумент;
	
КонецФункции

&НаКлиенте
Процедура кр_КаталогНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.ВыборКаталога);
	Диалог.Каталог   = Объект[Элемент.Имя];
	Диалог.Заголовок = "Укажите каталог...";
	
	Если Не Диалог.Выбрать() Тогда
		Возврат;
	КонецЕсли;
	
	Объект[Элемент.Имя]  = Диалог.Каталог;
	СтандартнаяОбработка = Ложь;
	
КонецПроцедуры

&НаКлиенте
Процедура кр_КаталогОткрытие(Элемент, СтандартнаяОбработка)
	
	ЗапуститьПриложение(Объект[Элемент.Имя]);
	СтандартнаяОбработка = ЛОЖЬ;
	
КонецПроцедуры

&НаКлиенте
Процедура ОбработкаВыбора(ВыбранноеЗначение, ИсточникВыбора)
	
	Если ИсточникВыбора.ИмяФормы = "Обработка.бит_ПодборЛицевыхСчетов.Форма.ФормаУправляемая" Тогда
		
		// ВыбранноеЗначение - Структура.
		// Содержит адрес к данным во временном хранилище.
		ОбработатьВыбранныеЗначения(ВыбранноеЗначение);
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ОбработатьВыбранныеЗначения(ВыбранноеЗначение)
	
	ТаблицаЛС = ПолучитьИзВременногоХранилища(ВыбранноеЗначение.АдресЛСВХранилище);
	
	Если ТаблицаЛС = Неопределено Тогда
		
		бит_ОбщегоНазначенияКлиентСервер.ВывестиСообщение("Ошибка получения данных из временного хранилища. Выполните подбор заново.");
		
		Возврат;
		
	КонецЕсли; 
	
	Для каждого СтрокаТаблицы Из ТаблицаЛС Цикл
		
		Если СписокЛС.НайтиПоЗначению(СтрокаТаблицы.ЛицевойСчет) = Неопределено Тогда
			СписокЛС.Добавить(СтрокаТаблицы.ЛицевойСчет);
		КонецЕсли; 
		
	КонецЦикла; 
	
КонецПроцедуры

&НаСервере
Функция ВывестиСуммуДолгаПоЛС(ВыборкаЛС,КоличествоМесцевЗадолжности,ДатаДолг,Долг) Экспорт
	
	// Определим сумму долга по начислениям для текущего лицевого счета.
	Если КоличествоМесцевЗадолжности = 0 Тогда
		
		ДатаДолга = ПолучитьДатуДолга(ВыборкаЛС.ЛицевойСчет.Организация, объект.период);
		
		ЗапросПоНачислениям = Новый Запрос;
		ЗапросПоНачислениям.УстановитьПараметр("КонецПериода", КонецДня(объект.период));
		ЗапросПоНачислениям.УстановитьПараметр("ЛицевойСчет" , ВыборкаЛС.ЛицевойСчет);
		
		ЗапросПоНачислениям.УстановитьПараметр("ДатаДолга"   , ДатаДолга);
	Иначе
		
		ДатаДолга = ПолучитьДатуДолга(ВыборкаЛС.ЛицевойСчет.Организация, ДатаДолг);
		
		ЗапросПоНачислениям = Новый Запрос;
		ЗапросПоНачислениям.УстановитьПараметр("КонецПериода", КонецМесяца(ДатаДолга));
		ЗапросПоНачислениям.УстановитьПараметр("ЛицевойСчет" , ВыборкаЛС.ЛицевойСчет);
		
		ЗапросПоНачислениям.УстановитьПараметр("ДатаДолга"   , ДатаДолга);
		
	КонецЕсли;
	
	ЗапросПоНачислениям.Текст = 
	
	"ВЫБРАТЬ
	|	ВЫБОР
	|		КОГДА ЕСТЬNULL(Долг.СуммаОстаток, 0) + ЕСТЬNULL(ОплатаСДатыДолга.Разовые, 0) - ЕСТЬNULL(ОплатаСДатыДолга.Оплата, 0) < 0
	|			ТОГДА 0
	|		ИНАЧЕ ЕСТЬNULL(Долг.СуммаОстаток, 0) + ЕСТЬNULL(ОплатаСДатыДолга.Разовые, 0) - ЕСТЬNULL(ОплатаСДатыДолга.Оплата, 0)
	|	КОНЕЦ КАК Долг,
	|	Долг.СуммаОстаток,
	|	ОплатаСДатыДолга.Оплата,
	|	ОплатаСДатыДолга.Разовые
	|ИЗ
	|	(ВЫБРАТЬ
	|		бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет КАК ЛицевойСчет,
	|		СУММА(бит_НачисленияПоУслугамЖКХОстатки.СуммаОстаток) КАК СуммаОстаток
	|	ИЗ
	|		РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Остатки(&ДатаДолга {(&ДатаДолга)}, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОстатки
	|	
	|	СГРУППИРОВАТЬ ПО
	|		бит_НачисленияПоУслугамЖКХОстатки.ЛицевойСчет) КАК Долг
	|		ЛЕВОЕ СОЕДИНЕНИЕ (ВЫБРАТЬ
	|			бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет КАК ЛицевойСчет,
	|			СУММА(ВЫБОР
	|					КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_ОплатаКУ
	|						ТОГДА -бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|				КОНЕЦ) КАК Оплата,
	|			СУММА(ВЫБОР
	|					КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|						ТОГДА бит_НачисленияПоУслугамЖКХОбороты.СуммаОборот
	|				КОНЕЦ) КАК Разовые
	|		ИЗ
	|			РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(НАЧАЛОПЕРИОДА(&ДатаДолга, МЕСЯЦ) {(&ДатаДолга)}, &КонецПериода {(&КонецПериода)}, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОбороты
	|		
	|		СГРУППИРОВАТЬ ПО
	|			бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет) КАК ОплатаСДатыДолга
	|		ПО Долг.ЛицевойСчет = ОплатаСДатыДолга.ЛицевойСчет";
	
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет,
	|	СУММА(ЕСТЬNULL(бит_НачисленияПоУслугамЖКХОбороты.СуммаПриход, 0) + ЕСТЬNULL(ВЫБОР
	|				КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_РазовыеПоУслугамЖКХ
	|					ТОГДА -бит_НачисленияПоУслугамЖКХОбороты.СуммаРасход
	|			КОНЕЦ, 0) + ЕСТЬNULL(ВЫБОР
	|				КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачислениеЛьготПоЛицевымСчетам
	|					ТОГДА -бит_НачисленияПоУслугамЖКХОбороты.СуммаРасход
	|			КОНЕЦ, 0) + ЕСТЬNULL(ВЫБОР
	|				КОГДА бит_НачисленияПоУслугамЖКХОбороты.Регистратор ССЫЛКА Документ.бит_НачисленияПоСчетчикамГрупповыеСИндивидуальными
	|					ТОГДА -бит_НачисленияПоУслугамЖКХОбороты.СуммаРасход
	|			КОНЕЦ, 0)) КАК СуммаПриход
	|ИЗ
	|	РегистрНакопления.бит_НачисленияПоУслугамЖКХ.Обороты(&ДатаДолга, &КонецПериода, Регистратор, ЛицевойСчет = &ЛицевойСчет) КАК бит_НачисленияПоУслугамЖКХОбороты
	|
	|СГРУППИРОВАТЬ ПО
	|	бит_НачисленияПоУслугамЖКХОбороты.ЛицевойСчет";
	
	Запрос.УстановитьПараметр("ДатаДолга", ДатаДолга);
	Запрос.УстановитьПараметр("КонецПериода", КонецМесяца(ДатаДолга));
	Запрос.УстановитьПараметр("ЛицевойСчет", ВыборкаЛС.ЛицевойСчет);
	
	Результат = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = Результат.Выбрать();
	
	Сумма = 0;
	
	Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
		
		Сумма = Сумма + ВыборкаДетальныеЗаписи.СуммаПриход;
		
	КонецЦикла;
	
	тмпДолг = 0;
	
	Выборка = ЗапросПоНачислениям.Выполнить().Выбрать();
	Если Выборка.Следующий() Тогда
		Если КоличествоМесцевЗадолжности > 0 Тогда
			
			Если Сумма < 0 Тогда
				
				Разница = Долг + Сумма;
				
			ИначеЕсли Сумма > 0 Тогда	
				
				Разница = Долг - Сумма;
				
				Если Разница > 0 Тогда
					
					тмпДолг = Разница;
					
				Иначе
					тмпДолг = 0;
					
				КонецЕсли;
				
			Иначе	
				тмпДолг = Долг;
			КонецЕсли;	
			
		ИначеЕсли КоличествоМесцевЗадолжности = 0 Тогда
			
			тмпДолг = Выборка.Долг;
			
		Иначе
			тмпДолг = Долг;
			
		КонецЕсли;
	КонецЕсли;
	
	СтруктураВозврата = Новый Структура;
	СтруктураВозврата.Вставить("СтрокаДолга", тмпДолг);
	СтруктураВозврата.Вставить("ДатаДолга", КонецМесяца(ДатаДолга-1));
	
	Возврат СтруктураВозврата;
	
КонецФункции

// Функция фозвращает дату долга.
//
// Параметры:
//  Организация  - СправочникСсылка - фильтр к запросу.
//
//  Дата         - Дата             - фильтр к запросу.
//
// Возвращаемое значение:
//   Дата   - текущая дата долга.
//
&НаСервере
Функция ПолучитьДатуДолга(Организация, Дата)
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ РАЗРЕШЕННЫЕ ПЕРВЫЕ 1
	|	НАЧАЛОПЕРИОДА(ДОБАВИТЬКДАТЕ(&Дата, МЕСЯЦ, -(ВЫБОР
	|				КОГДА ДЕНЬ(&Дата) > бит_НастройкаПараметровЖКХСрезПоследних.ПоследнийДеньПриемаПлатежей
	|					ТОГДА 0
	|				ИНАЧЕ 1
	|			КОНЕЦ + бит_НастройкаПараметровЖКХСрезПоследних.КоличествоМесяцевОтсрочкиНачисленияПени)), МЕСЯЦ) КАК Дата
	|ИЗ
	|	РегистрСведений.бит_НастройкаПараметровЖКХ.СрезПоследних(&Дата, Организация = &Организация) КАК бит_НастройкаПараметровЖКХСрезПоследних";
	
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("Дата"       , Дата);
	
	Возврат ?(Запрос.Выполнить().Пустой(), ТекущаяДата(),Запрос.Выполнить().Выгрузить()[0].Дата);
	
КонецФункции

&НаСервере
Функция ОпределитьИБНаСервере()
	
	Возврат ОбщегоНазначения.ИнформационнаяБазаФайловая();
	
КонецФункции

// Для Клиент-Серверного варианта.
&НаКлиенте
Процедура ВыгрузкаЛьготыКрасноярскийКрайНаКлиенте()
	
	СтруктураОтвЛиц = Новый Структура;
	
	// Формирование Файла сведений о членах семьи.
	ФормированиеФайлаСведенияОЧленахСемьиНаКлиенте(СтруктураОтвЛиц);
	
	// Формирование файла квартиросъемщика.
	ФормированиеФайлаКвартиросъемщикаНаКлиенте(СтруктураОтвЛиц);
	
	// Формирование файла суммы оплаты услуг.
	ФормированиеФайлаСуммыОплатыУслугНаКлиенте();	
	
КонецПроцедуры

&НаКлиенте
Процедура ФормированиеФайлаСведенияОЧленахСемьиНаКлиенте(СтруктураОтвЛиц)
	
	Если НЕ кр_НеВыгружатьФайлСведений Тогда
		
		СтруктураРезультатаСведенияОЧленахСемьи = ПостроительЗапросаСведенияОЧленахСемьиНаСервере();
		
		Если ТипВыгрузки = "Excel" Тогда
			ВыгрузитьСведенияОЧленахСемьиВExcelНаКлиенте(СтруктураРезультатаСведенияОЧленахСемьи,СтруктураОтвЛиц);
		ИначеЕсли ТипВыгрузки = "DBF" Тогда
			ВыгрузитьСведенияОЧленахСемьиВDBFНаКлиенте(СтруктураРезультатаСведенияОЧленахСемьи,СтруктураОтвЛиц);
		Иначе	
			ВыгрузитьСведенияОЧленахСемьиВDBFНаКлиенте(СтруктураРезультатаСведенияОЧленахСемьи,СтруктураОтвЛиц);
		КонецЕсли;
		
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПостроительЗапросаСведенияОЧленахСемьиНаСервере()
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Параметры.Вставить("Организация" , Объект.Организация);
	ПостроительЗапроса.Параметры.Вставить("КонецПериода", КонецМесяца(Объект.Период));
	ПостроительЗапроса.Текст = ТекстЗапросаСведенияОЧленахСемьи();
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если ИспользоватьОтборСписокЗданий Тогда
		
		тмпСписокЗданий = СписокЗданий.Выгрузить();
		ЗначениеОтбора = Новый СписокЗначений;
		ЗначениеОтбора.ЗагрузитьЗначения(тмпСписокЗданий.ВыгрузитьКолонку("Здание"));
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("Здание");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ЗначениеОтбора;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСписокЛС Тогда
		
		Если СписокЛС.Количество() > 0 Тогда
			
			Отбор = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
			Отбор.ВидСравнения  = ВидСравнения.ВСписке;
			Отбор.Использование = Истина;
			Отбор.Значение      = СписокЛС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСтатусКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("СтатусКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = СтатусКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли; 
	
	Если ИспользоватьОтборТипКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("ТипКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ТипКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	
	ВыборкаПостроительЗапроса = ПостроительЗапроса.Результат.Выбрать();	
	
	СтруктураРезультата = Новый Структура;
	
	Идентификатор =0;
	
	Пока ВыборкаПостроительЗапроса.Следующий() Цикл
		
		Идентификатор = Идентификатор + 1;
		
		//21.10.2019
		ИдентификаторСтрока = Формат(Идентификатор, "ЧГ=0");							
									
		Структура = Новый Структура;
		
		СтруктураРезультата.Вставить("Структура" + ИдентификаторСтрока, Структура);	
		
		Для каждого Колонка из ПостроительЗапроса.Результат.Колонки Цикл
			
			СтруктураРезультата["Структура" + ИдентификаторСтрока].Вставить(Колонка.Имя,ВыборкаПостроительЗапроса[Колонка.Имя]);
			
		КонецЦикла;
		
	КонецЦикла;	
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьСведенияОЧленахСемьиВExcelНаКлиенте(СтруктураРезультатаСведенияОЧленахСемьи,СтруктураОтвЛиц)
	
	ЕстьОшибки = Ложь;
	
	// Создадим приложение Excel.
	Excel = бит_ВыгрузкаКлиент.СоздатьПриложениеExcel();
	
	Если Excel = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		бит_ОбщегоНазначения.бит_Состояние("Создание файла Excel для заполнения...");
		
		Книга          = Excel.Application.WorkBooks.Add(1);
		ExcelЛист	   = Excel.ActiveSheet;
		
		бит_ОбщегоНазначения.бит_Состояние("Установка формата колонок листа Excel...");
		
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 1, Истина);    // Ключевое поле.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 2, Истина);   // Лицевой счет.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 3, Истина);   // ФИО.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 4, Истина);   // Дата рождения.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 5, Истина);    // Пол.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 6, Истина);    // Вид регистрации. 
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 7, Истина);    // Тип Удостоверения.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 8, Истина);   // Серия удостоверения личности. 
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 9, Истина);    // Номер.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 10, Истина);   // Дата выдачи удостоверения личности.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 11, Истина);  // Кем выдан документ.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 12, Истина);    // Код родственного отношения.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0", 13, Истина);    // Доля дохода учитываемого при расчете. 
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 14, Истина);   // Дата регистрации.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 15, Истина);   // Дата выбытия.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 16, Истина);   // Строк отсутсвия с. 
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@", 17, Истина);   // Строк отсутсвия по.
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение заголовка листа Excel...");
		
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "NN"   , 1, 1);    // Ключевое поле.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ID"   , 2, 1);   // Лицевой счет.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "FIO"  , 3, 1);   // ФИО.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DR"   , 4, 1);   // Дата рождения.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "SX"   , 5, 1);    // Пол.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "VR"   , 6, 1);    // Вид регистрации. 
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UDT"  , 7, 1);    // Тип Удостоверения.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UDS"  , 8, 1);   // Серия. 
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UDN"  , 9, 1);    // Номер.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UDD"  , 10, 1);   // Дата выдачик.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ORGAN", 11, 1);  // Кем выдан.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "RO"   , 12, 1);    // Код родственного отношения.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DD"   , 13, 1);    // Доля.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DREG" , 14, 1);   // Дата регистрации.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DVYB" , 15, 1);   // Дата выбытия.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "POTS" , 16, 1);   // Периоды отсутствия  «с»-«по», разделитель между периодами «;».
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение листа Excel...");
		
		НомерСтроки = 2;
		
		НомерПоПорядку = 0;
		
		ЛицевойСчетПред = Неопределено;	
		
		Идентификатор =0;
		
		Для каждого Выборка из СтруктураРезультатаСведенияОЧленахСемьи Цикл
			
			НомерПоПорядку = НомерПоПорядку + 1;	
			
			СтрокаТаблицыКод = Неопределено;
			
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , НомерПоПорядку                            		  , 1, НомерСтроки); // Ключевое поле.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Значение.Наименование                       , 2, НомерСтроки); // Лицевой счет.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ФизЛицо), 60)           , 3, НомерСтроки); // ФИО.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ДатаРождения), 10)      , 4, НомерСтроки); // Дата рождения.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.Значение.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской"),1,2), 5, НомерСтроки); // Пол.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ВидРегистрации), 2)     , 6, НомерСтроки); // Вид регистрации. 
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.КодДокумента), 2)       , 7, НомерСтроки); // Тип Удостоверения.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ДокументСерия), 10)     , 8, НомерСтроки); // Серия.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ДокументНомер), 7)      , 9, НомерСтроки); // Номер.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ДокументДатаВыдачи), 10), 10,НомерСтроки); // Дата выдачик.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ДокументКемВыдан), 100) , 11,НомерСтроки); // Кем выдан.
			
			Если (Выборка.Значение.КодПоГУГЦЖС = "91" или  Выборка.Значение.КодПоГУГЦЖС = "091") 
				и Выборка.Значение.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Женский") Тогда
				
				бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , "92"                        , 12,НомерСтроки);    // Код родственного отношения.
				
			ИначеЕсли (Выборка.Значение.КодПоГУГЦЖС = "92" или  Выборка.Значение.КодПоГУГЦЖС = "092") 
				и Выборка.Значение.Пол = ПредопределенноеЗначение("Перечисление.ПолФизическогоЛица.Мужской") Тогда
				
				бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , "91"                        , 12,НомерСтроки);    // Код родственного отношения.
				
			Иначе
				
				бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Значение.КодПоГУГЦЖС                        , 12,НомерСтроки);    // Код родственного отношения.
				
			КонецЕсли;
			
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ДоляПлощади), 2)        , 13,НомерСтроки);    // Доля.
			
			Если ЗначениеЗаполнено(Выборка.Значение.ДатаРегистрации) Тогда
				бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ДатаРегистрации), 10)   , 14, НомерСтроки);   // Дата регистрации.
			КонецЕсли; 
			
			Если ЗначениеЗаполнено(Выборка.Значение.ДатаСнятияСРегистрации) Тогда
				бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ДатаСнятияСРегистрации), 10) , 15, НомерСтроки);   // Дата выбытия.
			КонецЕсли; 			
			
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , "" , 16, НомерСтроки);   // Периоды отсутствия  «с»-«по», разделитель между периодами «;». 
			
			Если Выборка.Значение.СтепеньРодства = ПредопределенноеЗначение("Справочник.бит_СтепениРодстваФизЛиц.бит_ОтветственноеЛицо") Тогда
				
				Идентификатор = Идентификатор +1;
				
				//21.10.2019
	         	ИдентификаторСтрока = Формат(Идентификатор, "ЧГ=0");							
									
		        Структура = Новый Структура;				
				
				СтруктураОтвЛиц.Вставить("Структура"+ИдентификаторСтрока,Структура);						
				
				СтруктураОтвЛиц["Структура"+ИдентификаторСтрока].Вставить("ЛицевойСчет",Выборка.Значение.ЛицевойСчет);
				СтруктураОтвЛиц["Структура"+ИдентификаторСтрока].Вставить("ФизЛицо",Выборка.Значение.ФизЛицо);
				СтруктураОтвЛиц["Структура"+ИдентификаторСтрока].Вставить("Код",НомерПоПорядку);
				
			КонецЕсли; 
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла; 
		
		бит_ВыгрузкаКлиент.УстановитьШиринуКолонкиExcel(ExcelЛист, 2);
		бит_ВыгрузкаКлиент.УстановитьШиринуКолонкиExcel(ExcelЛист, 38);
		бит_ВыгрузкаКлиент.УстановитьШиринуКолонкиExcel(ExcelЛист, 39);
		
		ПутьВыгрузки = Объект.кр_Каталог;
		
		ИмяФайла = Объект.кр_ИмяФайлаСведения +".xls";
		
		Книга.ConflictResolution = 1;
		Книга.SaveAs(ПутьВыгрузки + "\"+ ИмяФайла);
		Excel.Quit();
		
	Исключение
		ЕстьОшибки = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить лист Excel!
									|%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	Если ЕстьОшибки Тогда
		
		бит_ВыгрузкаКлиент.ЗакрытьПриложениеExcel(Excel);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ФормированиеФайлаКвартиросъемщикаНаКлиенте(СтруктураОтвЛиц)
	
	СтруктураРезультатаКвартиросъемщика = ПостроительЗапросаНаСервереКвартиросъемщика();
	
	Если ТипВыгрузки = "Excel" Тогда
		ВыгрузитьДанныеКвартиросъемщикаВExcelНаКлиенте(СтруктураРезультатаКвартиросъемщика,СтруктураОтвЛиц);
	ИначеЕсли ТипВыгрузки = "DBF" Тогда
		ВыгрузитьДанныеКвартиросъемщикаВDBFНаКлиенте(СтруктураРезультатаКвартиросъемщика,СтруктураОтвЛиц);
	Иначе
		ВыгрузитьДанныеКвартиросъемщикаВDBFНаКлиенте(СтруктураРезультатаКвартиросъемщика,СтруктураОтвЛиц);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПостроительЗапросаНаСервереКвартиросъемщика()
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Параметры.Вставить("Организация"   , Объект.Организация);
	ПостроительЗапроса.Параметры.Вставить("КонецПериода"  , КонецМесяца(Объект.Период));
	ПостроительЗапроса.Параметры.Вставить("НачалоПериода"  , НачалоМесяца(Объект.Период));
	
	Если НЕ Объект.ШаблонУслуг = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам 
		И НЕ Объект.ШаблонУслуг.Пустая() Тогда
		
		ЕстьШаблон = Истина;
		ПостроительЗапроса.Параметры.Вставить("УслугаЖКХ" 	, Объект.ШаблонУслуг.Услуги.ВыгрузитьКолонку("Услуга"));
		ПостроительЗапроса.Параметры.Вставить("ЕстьШаблон"	, Истина);
	Иначе
		ПостроительЗапроса.Параметры.Вставить("УслугаЖКХ"	, Справочники.бит_УслугиЖКХ.ПустаяСсылка());
		ПостроительЗапроса.Параметры.Вставить("ЕстьШаблон"	, Ложь);
	КонецЕсли;
	
	ПостроительЗапроса.Текст = ТекстЗапросаКвартиросъемщика();
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если ИспользоватьОтборСписокЗданий Тогда
		
		тмпСписокЗданий = СписокЗданий.Выгрузить();
		ЗначениеОтбора = Новый СписокЗначений;
		ЗначениеОтбора.ЗагрузитьЗначения(тмпСписокЗданий.ВыгрузитьКолонку("Здание"));
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("ЗданиеСсылка");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ЗначениеОтбора;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСписокЛС Тогда
		
		Если СписокЛС.Количество() > 0 Тогда
			
			Отбор = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
			Отбор.ВидСравнения  = ВидСравнения.ВСписке;
			Отбор.Использование = Истина;
			Отбор.Значение      = СписокЛС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСтатусКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("СтатусКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = СтатусКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли; 
	
	Если ИспользоватьОтборТипКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("ТипКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ТипКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если кр_НеВыгружатьЛицевыеСчетаБезПроживающих Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("КоличествоЧленовСемьи");
		ОтборЗданий.ВидСравнения  = ВидСравнения.Больше;
		ОтборЗданий.Значение      = 0;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	ПостроительЗапроса.Выполнить();
	
	ВыборкаПостроительЗапроса = ПостроительЗапроса.Результат.Выбрать();	
	
	СтруктураРезультата = Новый Структура;
	
	Идентификатор =0;
	
	Пока ВыборкаПостроительЗапроса.Следующий() Цикл
		
		Идентификатор = Идентификатор +1;
		
		//21.10.2019
		ИдентификаторСтрока = Формат(Идентификатор, "ЧГ=0");							
									
		Структура = Новый Структура;
		
		СтруктураРезультата.Вставить("Структура" + ИдентификаторСтрока, Структура);	

		Для каждого Колонка из ПостроительЗапроса.Результат.Колонки Цикл
			
			СтруктураРезультата["Структура" + ИдентификаторСтрока].Вставить(Колонка.Имя,ВыборкаПостроительЗапроса[Колонка.Имя]);
			
		КонецЦикла;
		
	КонецЦикла;	
	
	Возврат СтруктураРезультата;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьДанныеКвартиросъемщикаВExcelНаКлиенте(СтруктураРезультатаКвартиросъемщика,СтруктураОтвЛиц)
	
	ЕстьОшибки = Ложь;
	
	// Создадим приложение Excel.
	Excel = бит_ВыгрузкаКлиент.СоздатьПриложениеExcel();
	
	Если Excel = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		бит_ОбщегоНазначения.бит_Состояние("Создание файла Excel для заполнения...");
		
		Книга          = Excel.Application.WorkBooks.Add(1);
		ExcelЛист	   = Excel.ActiveSheet;
		
		бит_ОбщегоНазначения.бит_Состояние("Установка формата колонок листа Excel...");
		
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 1 , Истина); // Лицевой счет.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 2 , Истина); // Населенный пункт.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 3 , Истина); // Тип улицы.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 4 , Истина); // Улица.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 5 , Истина); // Дом.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 6 , Истина); // Корпус.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 7 , Истина); // Буква дома.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 8 , Истина); // Квартира.
		
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 9 , Истина); // Буква квартиры.
		
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 10, Истина); // Отчетный месяц.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 11, Истина); // Количество челов семьи.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 12, Истина); // Общая площадь.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 13, Истина); // Наличие задолжности.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 14, Истина); // Причина закрытия жилищной субсидии.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 15, Истина); // Главный квартиросъемщик.
		
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 16, Истина); // Сумма долга.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 17, Истина); // Начало периода задолженности.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 18, Истина); // Конец периода задолженности.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 19, Истина); // Наличие соглашения о реструктуризации задолженности.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 20, Истина); // Исполнение условий соглашения.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 21, Истина); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 22, Истина); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 23, Истина); // Идентификатор  дома в ФИАС.
		
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение заголовка листа Excel...");
		
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ID"     , 1 , 1); // Лицевой счет.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PUNKT"  , 2 , 1); // Населенный пункт.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "TIP"    , 3 , 1); // Тип улицы.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "UL"     , 4 , 1); // Улица.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DOM"    , 5 , 1); // Дом.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "KOR"    , 6 , 1); // Корпус.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "BDOM"   , 7 , 1); // Буква дома.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "KV"     , 8 , 1); // Квартира.
		
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "BKV"    , 9 , 1); // Буква квартиры.
		// BKV	С 1	А	Буква квартиры.
		
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "OTCH"   , 10 , 1); // Отчетный месяц.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "SEM"    , 11 , 1); // Количество челов семьи.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PL"     , 12 , 1); // Общая площадь.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "DOLG"   , 13 , 1); // Наличие задолжности.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "Z"      , 14 , 1); // Причина закрытия жилищной субсидии.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "KVSM"   , 15 , 1); // Главный квартиросъемщик.
		
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "SDOLG"  , 16 , 1); // Сумма долга.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PER_B"  , 17 , 1); // Начало периода задолженности.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PER_E"  , 18 , 1); // Конец периода задолженности.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "SOG"    , 19 , 1); // Наличие соглашения о реструктуризации задолженности.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "IUSOG"  , 20 , 1); // Исполнение условий соглашения.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PLODN"  , 21 , 1); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PLODN_V", 22 , 1); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "FIAS_ID", 23 , 1); // Идентификатор  дома в ФИАС.
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение листа Excel...");
		
		НомерСтроки = 2;
		
		Для каждого Выборка из СтруктураРезультатаКвартиросъемщика Цикл
			
			СтрокаТаблицыКод = Неопределено;
			
			Для каждого ВыборкаОтвЛиц из СтруктураОтвЛиц Цикл
				
				Если ВыборкаОтвЛиц.Значение.ЛицевойСчет = Выборка.Значение.ЛицевойСчет Тогда
					
					СтрокаТаблицыКод = ВыборкаОтвЛиц.Значение.Код;
					
				КонецЕсли;
				
			КонецЦикла;
			
			
			Код = ?(СтрокаТаблицыКод = Неопределено, 0, СтрокаТаблицыКод);
			
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Значение.Наименование									, 1 , НомерСтроки); // Лицевой счет.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.Район), 30)						, 2 , НомерСтроки); // Населенный пункт.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ТипУлицы), 30)					, 3 , НомерСтроки); // Тип улицы.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.Улица), 30)						, 4 , НомерСтроки); // Улица.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.Здание), 3)						, 5 , НомерСтроки); // Дом.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.Корпус), 2)						, 6 , НомерСтроки); // Корпус.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ПрефиксДома), 1)					, 7 , НомерСтроки); // Буква дома.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(?(Строка(Выборка.Значение.Квартира) = "-", "", Строка(Выборка.Значение.Квартира)), 10), 8 , НомерСтроки); // Квартира.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.ПрефиксКвартиры),1)				, 9 , НомерСтроки); // Буква квартиры.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Объект.Период, "ДФ=MM.yyyy")							, 10, НомерСтроки); // Отчетный месяц.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Значение.КоличествоЧленовСемьи						, 11, НомерСтроки); // Количество челов семьи.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Выборка.Значение.ОбщаяПлощадь, "ЧЦ=6; ЧДЦ=2; ЧГ=0")	, 12, НомерСтроки); // Общая площадь.
			
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.Значение.Сальдо > 0 И  Выборка.Значение.ДолгНачалоПериода > 0, Истина, Ложь), 13, НомерСтроки);// Наличие задолжности.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ""															, 14, НомерСтроки); // Причина закрытия жилищной субсидии.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Код															, 15, НомерСтроки); // Главный квартиросъемщик.
			
			Если Выборка.Значение.ДолгНачалоПериода>0 Тогда
				ДолгНачалоПериода =	Выборка.Значение.ДолгНачалоПериода;
			Иначе 
				ДолгНачалоПериода =	0;
			КонецЕсли;
			
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , ?(Выборка.Значение.Сальдо > 0,ДолгНачалоПериода,0)			, 16, НомерСтроки); // Сумма долга.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Выборка.Значение.НачалоЗадолженности,"ДФ=дд.MM.yyyy")	, 17, НомерСтроки); // Начало периода задолженности.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(НачалоМесяца(Объект.Период),"ДФ=дд.MM.yyyy")			, 18, НомерСтроки); // Конец периода задолженности.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Ложь															, 19, НомерСтроки); // Наличие соглашения о реструктуризации задолженности.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Ложь															, 20, НомерСтроки); // Исполнение условий соглашения.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Выборка.Значение.ПлощадьОДНСОИЭлектроснаб	, "ЧЦ=6; ЧДЦ=2; ЧГ=0") , 21, НомерСтроки); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по электроснабжению.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Формат(Выборка.Значение.ПлощадьОДНСОИВодоснаб		, "ЧЦ=6; ЧДЦ=2; ЧГ=0") , 22, НомерСтроки); // Площадь на общедомовые нужды (ОДН), содержание общего имущества  (CОИ), приходящаяся на квартиру, по водоснабжению.
			бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Лев(Строка(Выборка.Значение.КодФИАС), 36)						, 23 , НомерСтроки); // Идентификатор  дома в ФИАС.
			
			НомерСтроки = НомерСтроки + 1;
			
		КонецЦикла; 
		
		бит_ВыгрузкаКлиент.УстановитьШиринуКолонкиExcel(ExcelЛист, 2);
		бит_ВыгрузкаКлиент.УстановитьШиринуКолонкиExcel(ExcelЛист, 38);
		бит_ВыгрузкаКлиент.УстановитьШиринуКолонкиExcel(ExcelЛист, 39);
		
		
		ПутьВыгрузки = Объект.кр_Каталог;
		
		ИмяФайла = Объект.кр_ИмяФайлаКвартиросъемщики +".xls";
		
		Книга.ConflictResolution = 1;
		Книга.SaveAs(ПутьВыгрузки + "\"+ ИмяФайла);
		Excel.Quit();
		
	Исключение
		ЕстьОшибки = Истина;
		ИнформацияОбОшибке = ИнформацияОбОшибке();
		ТекстСообщения = НСтр("ru = 'Не удалось заполнить лист Excel!
									|%1'");
		ТекстСообщения = СтрШаблон(ТекстСообщения, ПодробноеПредставлениеОшибки(ИнформацияОбОшибке));
		ОбщегоНазначенияКлиентСервер.СообщитьПользователю(ТекстСообщения);
	КонецПопытки;
	
	Если ЕстьОшибки Тогда
		
		бит_ВыгрузкаКлиент.ЗакрытьПриложениеExcel(Excel);
		
	КонецЕсли; 
	
КонецПроцедуры

&НаКлиенте
Процедура ФормированиеФайлаСуммыОплатыУслугНаКлиенте()
	
	// Формирование файла Суммы оплаты услуг.
	МассивРезультатаСуммыОплатыУслуг = ПостроительЗапросаСуммыОплатыУслугНаСервере();
	
	Если ТипВыгрузки = "Excel" Тогда
		ВыгрузитьСуммыОплатыУслугВExcelНаКлиенте(МассивРезультатаСуммыОплатыУслуг);
	ИначеЕсли ТипВыгрузки = "DBF" Тогда
		ВыгрузитьСуммыОплатыУслугВDBFНаКлиенте(МассивРезультатаСуммыОплатыУслуг);
	Иначе	
		ВыгрузитьСуммыОплатыУслугВDBFНаКлиенте(МассивРезультатаСуммыОплатыУслуг);
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Функция ПостроительЗапросаСуммыОплатыУслугНаСервере()
	
	ПостроительЗапроса = Новый ПостроительЗапроса;
	ПостроительЗапроса.Параметры.Вставить("Организация"   , Объект.Организация);
	ПостроительЗапроса.Параметры.Вставить("НачалоПериода" , НачалоМесяца(Объект.Период));
	ПостроительЗапроса.Параметры.Вставить("КонецПериода"  , КонецМесяца(Объект.Период));
	ПостроительЗапроса.Текст  = ТекстЗапросаСуммыОплатыУслуг();
	ПостроительЗапроса.ЗаполнитьНастройки();
	
	Если ИспользоватьОтборСписокЗданий Тогда
		
		тмпСписокЗданий = СписокЗданий.Выгрузить();
		ЗначениеОтбора = Новый СписокЗначений;
		ЗначениеОтбора.ЗагрузитьЗначения(тмпСписокЗданий.ВыгрузитьКолонку("Здание"));
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("Здание");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ЗначениеОтбора;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСписокЛС Тогда
		
		Если СписокЛС.Количество() > 0 Тогда
			
			Отбор = ПостроительЗапроса.Отбор.Добавить("ЛицевойСчет");
			Отбор.ВидСравнения  = ВидСравнения.ВСписке;
			Отбор.Использование = Истина;
			Отбор.Значение      = СписокЛС;
			
		КонецЕсли;
		
	КонецЕсли;
	
	Если ИспользоватьОтборСтатусКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("СтатусКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = СтатусКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли; 
	
	Если ИспользоватьОтборТипКв Тогда
		
		ОтборЗданий = ПостроительЗапроса.Отбор.Добавить("ТипКвартиры");
		ОтборЗданий.ВидСравнения  = ВидСравнения.ВСписке;
		ОтборЗданий.Значение      = ТипКвартиры;
		ОтборЗданий.Использование = Истина;
		
	КонецЕсли;
	
	Если НЕ Объект.ШаблонУслуг = Справочники.бит_ШаблоныИзвещений.ПоВсемУслугам 
		И НЕ Объект.ШаблонУслуг.Пустая() Тогда
		
		СписокУслуг = Новый СписокЗначений;
		СписокУслуг.ЗагрузитьЗначения(Объект.ШаблонУслуг.Услуги.ВыгрузитьКолонку("Услуга"));
		
		Отбор = ПостроительЗапроса.Отбор.Добавить("УслугаЖКХ");
		Отбор.ВидСравнения  = ВидСравнения.ВСписке;
		Отбор.Использование = Истина;
		Отбор.Значение      = СписокУслуг;
		
	КонецЕсли;
	
	// Отбор по коду услуг.
	Отбор = ПостроительЗапроса.Отбор.Добавить("КодПоГУГЦЖС");
	Отбор.ВидСравнения  = ВидСравнения.НеРавно;
	Отбор.Использование = Истина;
	Отбор.Значение      = "";
	
	ПостроительЗапроса.Выполнить();
	
	ВыборкаПостроительЗапроса = ПостроительЗапроса.Результат.Выбрать();	
	
	
	МассивРезультата = Новый Массив;
	
	Идентификатор =-1;
	
		
	Пока ВыборкаПостроительЗапроса.Следующий() Цикл
		
		Идентификатор = Идентификатор +1;
		
		//21.10.2019
		ИдентификаторСтрока = Формат(Идентификатор, "ЧГ=0");							
		
		если ИдентификаторСтрока = "" тогда 
		  ИдентификаторСтрока = 0;	
		конецесли;

		Структура = Новый Структура;		
		
		МассивРезультата.Вставить(Число(ИдентификаторСтрока),Структура);	
		
		Для каждого Колонка из ПостроительЗапроса.Результат.Колонки Цикл
			
			МассивРезультата[Число(ИдентификаторСтрока)].Вставить(Колонка.Имя,ВыборкаПостроительЗапроса[Колонка.Имя]);
			
		КонецЦикла;
		
	КонецЦикла;	
	
	Возврат МассивРезультата;
	
КонецФункции

&НаКлиенте
Процедура ВыгрузитьСуммыОплатыУслугВExcelНаКлиенте(МассивРезультатаСуммыОплатыУслуг)
	
	ЕстьОшибки = Ложь;
	
	// Создадим приложение Excel.
	Excel = бит_ВыгрузкаКлиент.СоздатьПриложениеExcel();
	
	Если Excel = Неопределено Тогда
		Возврат;
	КонецЕсли;
	
	Попытка
		
		бит_ОбщегоНазначения.бит_Состояние("Создание файла Excel для заполнения...");
		
		Книга          = Excel.Application.WorkBooks.Add(1);
		ExcelЛист	   = Excel.ActiveSheet;
		
		
		бит_ОбщегоНазначения.бит_Состояние("Установка формата колонок листа Excel...");
		
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 1 , Истина);   // Ключевое поле.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 2 , Истина);   // Лицевой счет.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 3 , Истина);   // Код услуги.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 4 , Истина);   // К оплате.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 5 , Истина);   // Сумма по социальной норме за услугу USL.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 6 , Истина);   // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 7 , Истина);   // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0,00", 8 , Истина);   // Начислено.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "0"   , 9 , Истина);   // Количество месяцев.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 10, Истина);   // Наличие счетчика.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 11, Истина);   // Месяц начисления.
		бит_ВыгрузкаКлиент.УстановитьФорматКолонкиExcel(ExcelЛист, "@"   , 12, Истина);   // Признак перерасчета.
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение заголовка листа Excel...");
		
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "NN"   , 1 , 1);   // Ключевое поле.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ID"   , 2 , 1);   // Лицевой счет.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "USL"  , 3 , 1);   // Код услуги.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S1"   , 4 , 1);   // К оплате.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S2"   , 5 , 1);   // Сумма по социальной норме за услугу USL.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S3"   , 6 , 1);   // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S4"   , 7 , 1);   // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "S5"   , 8 , 1);   // Начислено.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "PER"  , 9 , 1);   // Количество месяцев.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "CHET" , 10, 1);   // Наличие счетчика.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "OTCH" , 11, 1);   // Месяц начисления.
		бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, "@", "ITOG" , 12, 1);   // Признак перерасчета.
		
		бит_ОбщегоНазначения.бит_Состояние("Заполнение листа Excel...");
		
		НомерСтроки = 2;
		
		НомерСтр = 1;
		
		МассивРезультатаСпособРасчетаПоСчетчикам = СпособРасчетаПоСчетчикамНаСервере();
		
		КодУслуги = Неопределено;	
		
		Для каждого Выборка из МассивРезультатаСуммыОплатыУслуг Цикл
			
			КодУслуги = Неопределено;	
			
			Если НЕ Выборка = Неопределено Тогда 
				
				Если Выборка.СпособРасчета = ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.РасчетПоСчетчикам") Тогда
					
					МассивСчетчиков = Новый Массив;
					Для каждого ВыборкаДетальныеЗаписи из МассивРезультатаСпособРасчетаПоСчетчикам Цикл
						
						Если ВыборкаДетальныеЗаписи.Объект = Выборка.Здание и ВыборкаДетальныеЗаписи.Услуга = Выборка.УслугаЖКХ Тогда
							СпособРасчетаПоСчетчикам = ВыборкаДетальныеЗаписи.СпособРасчета;
							Если МассивСчетчиков.Найти(ВыборкаДетальныеЗаписи.СпособРасчета) = Неопределено Тогда
								МассивСчетчиков.Добавить(ВыборкаДетальныеЗаписи.СпособРасчета);
							КонецЕсли;
						КонецЕсли;
						
						Если ВыборкаДетальныеЗаписи.Объект = Выборка.ЛицевойСчет и ВыборкаДетальныеЗаписи.Услуга = Выборка.УслугаЖКХ Тогда
							СпособРасчетаПоСчетчикам = ВыборкаДетальныеЗаписи.СпособРасчета;
							Если МассивСчетчиков.Найти(ВыборкаДетальныеЗаписи.СпособРасчета) = Неопределено Тогда
								МассивСчетчиков.Добавить(ВыборкаДетальныеЗаписи.СпособРасчета);
							КонецЕсли;
						КонецЕсли;
						
					КонецЦикла;
					
					Если МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено
						И (МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено 
						ИЛИ МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено) 
						И Выборка.Общедом > 0 Тогда
						
						КодУслуги = Выборка.КодПоГУГЦЖС_КПУ;
						
					ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено
						И (МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено 
						ИЛИ МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено) 
						И Выборка.Общедом = 0 Тогда
						
						КодУслуги = Выборка.КодПоГУГЦЖС_ДПУ;
						
					ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикамСНаличиемИндивидуальных")) <> Неопределено
						И МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоГрупповымСчетчикам")) <> Неопределено Тогда 
						
						КодУслуги = Выборка.КодПоГУГЦЖС_ДПУ;
						
					ИначеЕсли МассивСчетчиков.Найти(ПредопределенноеЗначение("Перечисление.бит_СпособыРасчетаПоУслугам.ПоИндивидуальнымСчетчикам")) <> Неопределено Тогда
						
						КодУслуги = Выборка.КодПоГУГЦЖС_КПУ;
						
					КонецЕсли;
					
				КонецЕсли;
				
				Если Выборка.ЭтоРазовые Тогда
					
					бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , НомерСтр											, 1 , НомерСтроки); // Ключевое поле.
					бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Наименование								, 2 , НомерСтроки); // Лицевой счет.
					бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.КодПоГУГЦЖС_Разовые						, 3 , НомерСтроки); // Код услуги.
					бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Разовые									, 4 , НомерСтроки); // К оплате.
					бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Разовые									, 5 , НомерСтроки); // Сумма по социальной норме за услугу USL.
					бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0													, 6 , НомерСтроки); // Организациями – поставщиками ЖКУ не заполняется (по всем услугам).
					бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , 0													, 7 , НомерСтроки); // Фактически оплаченная сумма за месяц по электроснабжению. (Заполняется только для услуг 012, 022, 043, по остальным услугам  НЕ ЗАПОЛНЯЕТСЯ).
					бит_ВыгрузкаКлиент.УстановитьЗначениеЯчейкиExcel(ExcelЛист, , Выборка.Разовые									, 8 , НомерСтроки); // Начислено.
