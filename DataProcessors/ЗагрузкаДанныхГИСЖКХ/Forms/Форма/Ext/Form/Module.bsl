
&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)
	ДиалогВыбора = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Открытие);
	ДиалогВыбора.Заголовок = "Выберите файл для загрузки";
	Текст = "ru = ""Текст""; en = ""Text""";
	Фильтр = "(*.xls)(*.xlsx)|*.xls;*.xlsx";
	ДиалогВыбора.Фильтр = Фильтр;
	Если ДиалогВыбора.Выбрать() Тогда
		ПутьКФайлу = ДиалогВыбора.ПолноеИмяФайла;
		//Элементы.ПутьНадпись.Заголовок = ДиалогВыбора.ПолноеИмяФайла;
	КонецЕсли;
	
КонецПроцедуры

&НаКлиенте
Процедура Загрузить()
	
	Объект.ЛСНеИзменен.Очистить();
	Объект.ЛСНеНайден.Очистить();
	
	Excel = Новый COMОбъект("Excel.Application");
	Book = Excel.WorkBooks.Open(ПутьКФайлу);
	Sheet = Book.WorkSheets(1);
	КоличествоСтрок = Sheet.usedrange.Rows.Count;
	МассивСтрок = Новый Массив;
	//Сч = 2;
	//Индикатор = 0;
	Для Сч = 2 По КоличествоСтрок Цикл
		МассивСтроки = Новый Массив;
		МассивСтроки.Добавить(Sheet.Cells(Сч,1).Value);		
		МассивСтроки.Добавить(Sheet.Cells(Сч,2).Value);		
		МассивСтроки.Добавить(Sheet.Cells(Сч,3).Value);		
		МассивСтроки.Добавить(Sheet.Cells(Сч,4).Value);		
		МассивСтроки.Добавить(Sheet.Cells(Сч,5).Value);	
		МассивСтрок.Добавить(МассивСтроки);
		//Индикатор = (сч-1) / (КоличествоСтрок-1)*100;
	КонецЦикла; 
	//Сообщить(КоличествоСтрок);
	//а=0;
	Excel.DisplayAlerts = 0;
	Book.Close();
	Excel.Quit();
	Excel.DisplayAlerts = 1;
	
	ИзменитьЛС(МассивСтрок);
	Если Объект.ЛСНеИзменен.Количество() > 0 Тогда
		Элементы.Группа3.Видимость = Истина;
	КонецЕсли;
	
	Если Объект.ЛСНеНайден.Количество() > 0 Тогда
		Элементы.НеНайденЛС.Видимость = Истина;
	КонецЕсли;
	
	Сообщить("Данные загружены!");
КонецПроцедуры

&НаСервере
Процедура ИзменитьЛС(Массив)
	
	Для Каждого Строка Из Массив Цикл
		
		ЛС = НайтиЛС(Строка[0]);
		Если НЕ ЗначениеЗаполнено(ЛС) Тогда
			нСтрока = Объект.ЛСНеНайден.Добавить();
			нСтрока.ЛицевойСчет 		= Строка[0];
			нСтрока.НомерЕЛС 			= Строка[1];
			нСтрока.ИдентификаторЖКУ 	= Строка[2];
			Продолжить;
		КонецЕсли;
		
		Если Объект.Режим Тогда
			Если ЛС.КапРемЕЛСГИСЖКХ = Строка[1] И ЛС.КапРемИдентификаторЖКУ = Строка[2] И (ЗначениеЗаполнено(ЛС.Квартира) И ЛС.Квартира.УникальныйНомерГИСЖКХ = Строка[3]) Тогда
				нСтрока = Объект.ЛСНеИзменен.Добавить();
				нСтрока.ЛицевойСчет 		= Строка[0];
				нСтрока.НомерЕЛС 			= Строка[1];
				нСтрока.ИдентификаторЖКУ 	= Строка[2];
				нСтрока.УникальныйНомер 	= Строка[3];
				Продолжить;
			КонецЕсли;
			ЛСОбъект 								= ЛС.ПолучитьОбъект();
			ЛСОбъект.КапРемЕЛСГИСЖКХ 				= Строка[1];
			ЛСОбъект.КапРемИдентификаторЖКУ 		= Строка[2];
			Если ЗначениеЗаполнено(ЛС.Квартира) Тогда
				ЛСКвартираОбъект = ЛС.Квартира.ПолучитьОбъект();
				ЛСКвартираОбъект.УникальныйНомерГИСЖКХ = Строка[3];
				ЛСКвартираОбъект.Записать();
			КонецЕсли;
			ЛСОбъект.Записать();
		Иначе	
			Если ЛС.ЕЛСГИСЖКХ = Строка[1] И ЛС.ИдентификаторЖКУ = Строка[2] И (ЗначениеЗаполнено(ЛС.Квартира) И ЛС.Квартира.УникальныйНомерГИСЖКХ = Строка[3]) Тогда
				нСтрока = Объект.ЛСНеИзменен.Добавить();
				нСтрока.ЛицевойСчет 		= Строка[0];
				нСтрока.НомерЕЛС 			= Строка[1];
				нСтрока.ИдентификаторЖКУ 	= Строка[2];
				нСтрока.УникальныйНомер 	= Строка[3];
				Продолжить;
			КонецЕсли;
			ЛСОбъект 							= ЛС.ПолучитьОбъект();
			ЛСОбъект.ЕЛСГИСЖКХ 					= Строка[1];
			ЛСОбъект.ИдентификаторЖКУ 			= Строка[2];
			Если ЗначениеЗаполнено(ЛС.Квартира) Тогда
				ЛСКвартираОбъект = ЛС.Квартира.ПолучитьОбъект();
				ЛСКвартираОбъект.УникальныйНомерГИСЖКХ = Строка[3];
				ЛСКвартираОбъект.Записать();
			КонецЕсли;
			
			ЛСОбъект.Записать();
		КонецЕсли;
		
	КонецЦикла;
	
КонецПроцедуры

&НаСервере
Функция НайтиЛС(ЛССтрока)
	
	//{{КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
	// Данный фрагмент построен конструктором.
	// При повторном использовании конструктора, внесенные вручную изменения будут утеряны!!!
	
	Запрос = Новый Запрос;
	Запрос.Текст = 
	"ВЫБРАТЬ
	|	бит_ЛицевыеСчета.Ссылка КАК Ссылка
	|ИЗ
	|	Справочник.бит_ЛицевыеСчета КАК бит_ЛицевыеСчета
	|ГДЕ
	|	бит_ЛицевыеСчета.Наименование ПОДОБНО &Ссылка";
	
	Запрос.УстановитьПараметр("Ссылка", ЛССтрока);
	
	РезультатЗапроса = Запрос.Выполнить();
	
	ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
	
	Если ВыборкаДетальныеЗаписи.Следующий() Тогда
		Возврат ВыборкаДетальныеЗаписи.Ссылка;
	Иначе
		Возврат Справочники.бит_ЛицевыеСчета.ПустаяСсылка();
	КонецЕсли;
	
	//}}КОНСТРУКТОР_ЗАПРОСА_С_ОБРАБОТКОЙ_РЕЗУЛЬТАТА
КонецФункции

