&НаСервере
Процедура бит_ПодборПроживающихПоКвартиреНаСервере()
	
		Объект.СписокПроживающих.Очистить();
		
		Запрос = Новый Запрос;
		Запрос.Текст = 
		"ВЫБРАТЬ РАЗРЕШЕННЫЕ РАЗЛИЧНЫЕ
		|	ПроживающиеПоЛССрезПоследних.ФизЛицо.ДатаРождения КАК ДатаРождения,
		|	ПроживающиеПоЛССрезПоследних.ЛицевойСчет КАК ЛицевойСчет,
		|	ПроживающиеПоЛССрезПоследних.ФизЛицо КАК ФизЛицо,
		|	ПроживающиеПоЛССрезПоследних.СтатусФизЛица КАК СтатусФизЛица,
		|	ПроживающиеПоЛССрезПоследних.СтепеньРодства КАК СтепеньРодства,
		|	ПроживающиеПоЛССрезПоследних.СтатусПроживания КАК СтатусПроживания,
		|	ПроживающиеПоЛССрезПоследних.ДатаРегистрации КАК ДатаРегистрации,
		|	ПроживающиеПоЛССрезПоследних.ДатаСнятияСРегистрации КАК ДатаСнятияСРегистрации,
		|	ПроживающиеПоЛССрезПоследних.ДатаЗаписи КАК ДатаЗаписи,
		|	ПроживающиеПоЛССрезПоследних.ВладелецКвартиры КАК ВладелецКвартиры,
		|	ПроживающиеПоЛССрезПоследних.ПричинаВыписки КАК ПричинаВыписки,
		|	ПроживающиеПоЛССрезПоследних.ПричинаПрописки КАК ПричинаПрописки,
		|	ПроживающиеПоЛССрезПоследних.КудаВыписан КАК КудаВыписан,
		|	ПроживающиеПоЛССрезПоследних.ОткудаПрибыл КАК ОткудаПрибыл,
		|	ПроживающиеПоЛССрезПоследних.ДоляПлощади КАК ДоляПлощади,
		//|	ПроживающиеПоЛССрезПоследних.ПравоустанавливающиеДокументы КАК ПравоустанавливающиеДокументы,
		|	ПроживающиеПоЛССрезПоследних.СтатусФизЛицаДляИзменения КАК СтатусФизЛицаДляИзменения,
		|	ПроживающиеПоЛССрезПоследних.ДатаПрибытия КАК ДатаПрибытия,
		|	ПроживающиеПоЛССрезПоследних.лб_ДоляПлощадиСтрокой КАК лб_ДоляПлощадиСтрокой,
		|	ПроживающиеПоЛССрезПоследних.лб_СтрокаРодствДляФЛС КАК лб_СтрокаРодствДляФЛС,
		|	ПроживающиеПоЛССрезПоследних.лб_ИгнорироватьПериодВКопииФЛС КАК лб_ИгнорироватьПериодВКопииФЛС,
		|	ПроживающиеПоЛССрезПоследних.лб_ДатаРегистрацииДляФЛС КАК лб_ДатаРегистрацииДляФЛС,
		|	ПроживающиеПоЛССрезПоследних.лб_ДатаВыпискиДляФЛС КАК лб_ДатаВыпискиДляФЛС,
		|	ПроживающиеПоЛССрезПоследних.бит_ПомещенВАрхив КАК ПомещенВАрхив,
		|	ПроживающиеПоЛССрезПоследних.ДатаПраваСобственности КАК ДатаПраваСобственности,
		|	ПроживающиеПоЛССрезПоследних.бит_ВПечать КАК бит_ВПечать
		|ИЗ
		|	РегистрСведений.бит_ПроживающиеПоЛС.СрезПоследних(
		|			&Момент,
		|			ЛицевойСчет = &ЛицевойСчет
		|				И НЕ лб_ИгнорироватьПериодВКопииФЛС) КАК ПроживающиеПоЛССрезПоследних";
		
		Запрос.УстановитьПараметр("ЛицевойСчет", Объект.ЛицевойСчет);
		Запрос.УстановитьПараметр("Момент", ТекущаяДата());
		Запрос.УстановитьПараметр("СтатусФизЛица", Справочники.бит_СтатусФизЛица.НайтиПоКоду("000000003"));
		
		РезультатЗапроса = Запрос.Выполнить();
		
		ВыборкаДетальныеЗаписи = РезультатЗапроса.Выбрать();
		
		Пока ВыборкаДетальныеЗаписи.Следующий() Цикл
			
			Если Не ВыборкаДетальныеЗаписи.ПомещенВАрхив Тогда
				НоваяСтрока = Объект.СписокПроживающих.Добавить();
				ЗаполнитьЗначенияСвойств(НоваяСтрока, ВыборкаДетальныеЗаписи);	
			КонецЕсли; 
			
		КонецЦикла;
		
КонецПроцедуры
